// ABSCHNITT 2 GESTALTUNG RECHTSGESCHÄFTLICHER SCHULDVERHÄLTNISSE DURCH
// ALLGEMEINE GESCHÄFTSBEDINGUNGEN, §§ 305–310
//
// DREI SCHRITTE DES TEXTES: Einbeziehung (§§ 305, 305a, 305c Abs. 1),
// Auslegung (§ 305b, § 305c Abs. 2) und Inhaltskontrolle (§§ 307–309); die
// Rechtsfolgen stehen in § 306, der Anwendungsbereich in § 310.
//
// ZWEI ARTEN VON KLAUSELVERBOTEN, ZWEI KANÄLE (DECISION-0194). § 309 verbietet
// OHNE Wertungsmöglichkeit: jede Nummer ist eine Regel, deren Voraussetzung
// eine Beschreibung des Klauselinhalts ist (Tatsache des Falls), und deren
// Folge „unwirksam“ ist. § 308 verbietet MIT Wertungsmöglichkeit
// („unangemessen lang“, „zumutbar“, „unangemessen hoch“): die Bewertung
// trifft das Gericht (Kanal §47.3, `klausel_verstoesst_gegen_308`), die
// Nummer benennt der Aufzählungswert. Die Generalklausel des § 307 Abs. 1
// („unangemessen benachteiligen entgegen den Geboten von Treu und Glauben“)
// ist ebenfalls Wertung des Gerichts; die Zweifelsregeln des Absatzes 2
// tragen eigene Köpfe.
//
// ZAHLEN AUS DEM TEXT: vier Monate (§ 309 Nr. 1), zwei Jahre und ein Monat
// (§ 309 Nr. 9), ein Jahr (§ 309 Nr. 8 Buchstabe b Doppelbuchstabe ff),
// 30 und 15 Tage (§ 308 Nr. 1a, 1b), 250 Arbeitnehmer, 50 und 43 Millionen
// Euro (§ 310 Abs. 1a Satz 3). Keine Zahl ist erfunden.

language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";

// --- § 305 Einbeziehung ----------------------------------------------------------------------------

pub relation vorformulierte_vertragsbedingung_fuer_eine_vielzahl_von_vertraegen(k: Klausel, verwender: Person) kind empirical {
    label de official "Für eine Vielzahl von Verträgen vorformulierte Vertragsbedingung, die eine Vertragspartei (Verwender) der anderen bei Abschluss eines Vertrags stellt (§ 305 Abs. 1 Satz 1)";
    label en unofficial "contract term pre-formulated for a multitude of contracts which one party (the user) presents to the other on conclusion (§ 305 (1) sentence 1)";
}
pub relation klausel_des_vertrags(k: Klausel, v: Vertrag) kind empirical {
    key(k);
    label de official "Vertrag, für den die Bestimmung gestellt wird";
    label en unofficial "contract for which the term is presented";
}
pub relation im_einzelnen_ausgehandelt(k: Klausel) kind empirical {
    label de official "Die Vertragsbedingung ist zwischen den Vertragsparteien im Einzelnen ausgehandelt (§ 305 Abs. 1 Satz 3)";
    label en unofficial "the term was individually negotiated between the parties (§ 305 (1) sentence 3)";
}
pub relation nicht_im_einzelnen_ausgehandelt(k: Klausel) kind empirical {
    label de official "Die Vertragsbedingung ist nicht im Einzelnen ausgehandelt (§ 305 Abs. 1 Satz 3) — ausdrückliche Angabe des Falls";
    label en unofficial "the term was not individually negotiated (§ 305 (1) sentence 3) — explicit case input";
}
pub relation allgemeine_geschaeftsbedingung(k: Klausel, verwender: Person) kind institutional {
    label de official "Die Bestimmung ist eine Allgemeine Geschäftsbedingung (§ 305 Abs. 1)";
    label en unofficial "the term is a standard business term (§ 305 (1))";
}
pub relation ausdruecklicher_hinweis_oder_aushang(k: Klausel) kind empirical {
    label de official "Der Verwender hat bei Vertragsschluss ausdrücklich oder durch deutlich sichtbaren Aushang am Orte des Vertragsschlusses auf die Bedingungen hingewiesen (§ 305 Abs. 2 Nr. 1)";
    label en unofficial "on conclusion the user referred to the terms expressly or by a clearly visible notice at the place of conclusion (§ 305 (2) no. 1)";
}
pub relation zumutbare_moeglichkeit_der_kenntnisnahme(k: Klausel) kind empirical {
    label de official "Der Verwender hat der anderen Vertragspartei die Möglichkeit verschafft, in zumutbarer Weise — auch unter angemessener Berücksichtigung einer erkennbaren körperlichen Behinderung — von dem Inhalt Kenntnis zu nehmen (§ 305 Abs. 2 Nr. 2)";
    label en unofficial "the user gave the other party a reasonable opportunity to take notice of the content, with due regard to a recognisable physical disability (§ 305 (2) no. 2)";
}
pub relation einverstanden_mit_der_geltung(k: Klausel) kind empirical {
    label de official "Die andere Vertragspartei ist mit der Geltung der Bedingungen einverstanden (§ 305 Abs. 2 letzter Halbsatz, § 305a)";
    label en unofficial "the other party agrees to the terms applying (§ 305 (2), § 305a)";
}
pub relation rahmenvereinbarung_im_voraus(k: Klausel) kind empirical {
    label de official "Die Vertragsparteien haben für eine bestimmte Art von Rechtsgeschäften die Geltung bestimmter Allgemeiner Geschäftsbedingungen unter Beachtung der Erfordernisse des Absatzes 2 im Voraus vereinbart (§ 305 Abs. 3)";
    label en unofficial "the parties agreed in advance on the application of certain standard terms for a particular type of transaction, observing the requirements of (2) (§ 305 (3))";
}
pub relation vertragsbestandteil(k: Klausel, v: Vertrag) kind institutional {
    label de official "Die Allgemeine Geschäftsbedingung ist Bestandteil des Vertrags geworden (§ 305 Abs. 2, 3, § 305a)";
    label en unofficial "the standard business term has become part of the contract (§ 305 (2), (3), § 305a)";
}
pub relation nicht_vertragsbestandteil(k: Klausel, v: Vertrag) kind institutional {
    label de official "Die Bestimmung wird nicht Vertragsbestandteil (§ 305c Abs. 1)";
    label en unofficial "the term does not become part of the contract (§ 305c (1))";
}

@source(BGB_P305)
rule AllgemeineGeschaeftsbedingungLiegtVor(k: Klausel, verwender: Person) strict {
    label de official "Allgemeine Geschäftsbedingungen sind alle für eine Vielzahl von Verträgen vorformulierten Vertragsbedingungen, die eine Vertragspartei (Verwender) der anderen Vertragspartei bei Abschluss eines Vertrags stellt (§ 305 Abs. 1 Satz 1); gleichgültig sind äußere Gestalt, Umfang, Schriftart und Form des Vertrags (Satz 2); Allgemeine Geschäftsbedingungen liegen nicht vor, soweit die Bedingungen im Einzelnen ausgehandelt sind (Satz 3)";
    label en unofficial "Standard business terms are all terms pre-formulated for a multitude of contracts which one party presents to the other on conclusion (§ 305 (1) sentence 1); not so far as they were individually negotiated (sentence 3)";
    when vorformulierte_vertragsbedingung_fuer_eine_vielzahl_von_vertraegen(k, verwender);
    when nicht_im_einzelnen_ausgehandelt(k);
    then allgemeine_geschaeftsbedingung(k, verwender);
}

@source(BGB_P305)
rule EinbeziehungNachHinweisUndKenntnisnahme(k: Klausel, v: Vertrag, verwender: Person) strict {
    label de official "Allgemeine Geschäftsbedingungen werden nur dann Bestandteil eines Vertrags, wenn der Verwender bei Vertragsschluss auf sie hinweist (Nr. 1), der anderen Vertragspartei die Möglichkeit zumutbarer Kenntnisnahme verschafft (Nr. 2) und die andere Vertragspartei mit ihrer Geltung einverstanden ist (§ 305 Abs. 2)";
    label en unofficial "Standard business terms become part of a contract only if the user refers to them, gives a reasonable opportunity to take notice, and the other party agrees to their application (§ 305 (2))";
    when allgemeine_geschaeftsbedingung(k, verwender);
    when klausel_des_vertrags(k, v);
    when ausdruecklicher_hinweis_oder_aushang(k);
    when zumutbare_moeglichkeit_der_kenntnisnahme(k);
    when einverstanden_mit_der_geltung(k);
    then vertragsbestandteil(k, v);
}

@source(BGB_P305)
rule EinbeziehungNachRahmenvereinbarung(k: Klausel, v: Vertrag, verwender: Person) strict {
    label de official "Die Vertragsparteien können für eine bestimmte Art von Rechtsgeschäften die Geltung bestimmter Allgemeiner Geschäftsbedingungen unter Beachtung der in Absatz 2 bezeichneten Erfordernisse im Voraus vereinbaren (§ 305 Abs. 3)";
    label en unofficial "The parties may agree in advance on the application of certain standard terms for a particular type of transaction, observing the requirements of (2) (§ 305 (3))";
    when allgemeine_geschaeftsbedingung(k, verwender);
    when klausel_des_vertrags(k, v);
    when rahmenvereinbarung_im_voraus(k);
    when einverstanden_mit_der_geltung(k);
    then vertragsbestandteil(k, v);
}

pub enum Sonderfall305a {
    label de official "Fall der Einbeziehung ohne die Erfordernisse des § 305 Abs. 2 Nr. 1 und 2 (§ 305a)";
    label en unofficial "case of incorporation without the requirements of § 305 (2) nos. 1 and 2 (§ 305a)";
    TarifeDerEisenbahnUndBefoerderungsbedingungen,
    AmtsblattBedingungenDerBundesnetzagentur,
    AnlagebedingungenVonKapitalverwaltungsgesellschaften
}
pub relation sonderfall_der_einbeziehung(k: Klausel, fall: Sonderfall305a) kind empirical {
    label de official "Die Bedingungen gehören zu einer der in § 305a genannten Gruppen (Tarife und Beförderungsbedingungen; im Amtsblatt der Bundesnetzagentur veröffentlichte Bedingungen; genehmigte Anlagebedingungen)";
    label en unofficial "the terms belong to one of the groups named in § 305a";
}

@source(BGB_P305a)
rule EinbeziehungInBesonderenFaellen(k: Klausel, v: Vertrag, fall: Sonderfall305a) strict {
    label de official "Auch ohne Einhaltung der in § 305 Abs. 2 Nr. 1 und 2 bezeichneten Erfordernisse werden die in § 305a Nummern 1 bis 3 genannten Bedingungen einbezogen, wenn die andere Vertragspartei mit ihrer Geltung einverstanden ist (§ 305a)";
    label en unofficial "Even without the requirements of § 305 (2) nos. 1 and 2 the terms named in § 305a nos. 1 to 3 are incorporated if the other party agrees to their application (§ 305a)";
    when sonderfall_der_einbeziehung(k, fall);
    when klausel_des_vertrags(k, v);
    when einverstanden_mit_der_geltung(k);
    then vertragsbestandteil(k, v);
}

pub relation individuelle_vertragsabrede(k: Klausel, v: Vertrag) kind empirical {
    label de official "Individuelle Vertragsabrede zu demselben Gegenstand (§ 305b)";
    label en unofficial "individually agreed term on the same subject (§ 305b)";
}
pub relation vorrang_der_individualabrede(k: Klausel, individuell: Klausel) kind institutional {
    label de official "Individuelle Vertragsabreden haben Vorrang vor Allgemeinen Geschäftsbedingungen (§ 305b)";
    label en unofficial "individually agreed terms take precedence over standard business terms (§ 305b)";
}

@source(BGB_P305b)
rule IndividualabredeGehtVor(k: Klausel, individuell: Klausel, v: Vertrag, verwender: Person) strict {
    label de official "Individuelle Vertragsabreden haben Vorrang vor Allgemeinen Geschäftsbedingungen (§ 305b)";
    label en unofficial "Individually agreed terms take precedence over standard business terms (§ 305b)";
    when allgemeine_geschaeftsbedingung(k, verwender);
    when klausel_des_vertrags(k, v);
    when individuelle_vertragsabrede(individuell, v);
    then vorrang_der_individualabrede(k, individuell);
}

@source(BGB_P305c)
pub external judgment relation klausel_ist_ueberraschend(k: Klausel) {
    authority Court;
    label de official "§ 305c Abs. 1. Das Gericht hat festgestellt, dass die Bestimmung nach den Umständen, insbesondere nach dem äußeren Erscheinungsbild des Vertrags, so ungewöhnlich ist, dass der Vertragspartner des Verwenders mit ihr nicht zu rechnen braucht";
    label en unofficial "§ 305c (1). The court found the term so unusual in the circumstances that the user's contractual partner need not expect it";
}
pub relation auslegungszweifel(k: Klausel) kind empirical {
    label de official "Bei der Auslegung der Allgemeinen Geschäftsbedingung bestehen Zweifel (§ 305c Abs. 2)";
    label en unofficial "there are doubts in interpreting the standard term (§ 305c (2))";
}
pub relation zweifel_gehen_zu_lasten_des_verwenders(k: Klausel, verwender: Person) kind institutional {
    label de official "Zweifel bei der Auslegung Allgemeiner Geschäftsbedingungen gehen zu Lasten des Verwenders (§ 305c Abs. 2)";
    label en unofficial "doubts in interpreting standard business terms are at the expense of the user (§ 305c (2))";
}

@source(BGB_P305c)
rule UeberraschendeKlauselWirdNichtVertragsbestandteil(k: Klausel, v: Vertrag) strict {
    label de official "Bestimmungen in Allgemeinen Geschäftsbedingungen, die so ungewöhnlich sind, dass der Vertragspartner des Verwenders mit ihnen nicht zu rechnen braucht, werden nicht Vertragsbestandteil (§ 305c Abs. 1)";
    label en unofficial "Terms so unusual that the user's partner need not expect them do not become part of the contract (§ 305c (1))";
    when klausel_des_vertrags(k, v);
    when klausel_ist_ueberraschend(k);
    then nicht_vertragsbestandteil(k, v);
}

@source(BGB_P305c)
rule ZweifelZuLastenDesVerwenders(k: Klausel, verwender: Person) strict {
    label de official "Zweifel bei der Auslegung Allgemeiner Geschäftsbedingungen gehen zu Lasten des Verwenders (§ 305c Abs. 2)";
    label en unofficial "Doubts in interpreting standard business terms are at the expense of the user (§ 305c (2))";
    when allgemeine_geschaeftsbedingung(k, verwender);
    when auslegungszweifel(k);
    then zweifel_gehen_zu_lasten_des_verwenders(k, verwender);
}

// --- § 306 Rechtsfolgen, § 306a Umgehungsverbot -------------------------------------------------------

pub relation klausel_unwirksam(k: Klausel) kind institutional {
    label de official "Die Bestimmung in Allgemeinen Geschäftsbedingungen ist unwirksam (§§ 307, 308, 309)";
    label en unofficial "the standard business term is ineffective (§§ 307, 308, 309)";
}
pub relation vertrag_im_uebrigen_wirksam_agb(v: Vertrag) kind institutional {
    label de official "Sind Allgemeine Geschäftsbedingungen ganz oder teilweise nicht Vertragsbestandteil geworden oder unwirksam, so bleibt der Vertrag im Übrigen wirksam (§ 306 Abs. 1)";
    label en unofficial "where standard terms have not become part of the contract or are ineffective, the contract remains effective in other respects (§ 306 (1))";
}
pub relation inhalt_richtet_sich_nach_den_gesetzlichen_vorschriften(v: Vertrag, k: Klausel) kind institutional {
    label de official "Soweit die Bestimmungen nicht Vertragsbestandteil geworden oder unwirksam sind, richtet sich der Inhalt des Vertrags nach den gesetzlichen Vorschriften (§ 306 Abs. 2)";
    label en unofficial "so far as terms have not become part of the contract or are ineffective, the content of the contract follows the statutory provisions (§ 306 (2))";
}
@source(BGB_P306)
pub external judgment relation festhalten_am_vertrag_unzumutbare_haerte(v: Vertrag) {
    authority Court;
    label de official "§ 306 Abs. 3. Das Gericht hat festgestellt, dass das Festhalten an dem Vertrag auch unter Berücksichtigung der nach Absatz 2 vorgesehenen Änderung eine unzumutbare Härte für eine Vertragspartei darstellen würde";
    label en unofficial "§ 306 (3). The court found that adhering to the contract, even with the modification under (2), would be an unreasonable hardship for a party";
}
pub relation vertrag_unwirksam(v: Vertrag) kind institutional {
    label de official "Der Vertrag ist unwirksam (§ 306 Abs. 3)";
    label en unofficial "the contract is ineffective (§ 306 (3))";
}
pub relation umgehung_der_vorschriften_ueber_agb(k: Klausel) kind empirical {
    label de official "Die Vorschriften dieses Abschnitts werden durch anderweitige Gestaltungen umgangen (§ 306a)";
    label en unofficial "the provisions of this division are circumvented by other arrangements (§ 306a)";
}
pub relation vorschriften_finden_gleichwohl_anwendung(k: Klausel) kind institutional {
    label de official "Die Vorschriften dieses Abschnitts finden auch dann Anwendung, wenn sie durch anderweitige Gestaltungen umgangen werden (§ 306a)";
    label en unofficial "the provisions of this division also apply where they are circumvented by other arrangements (§ 306a)";
}

@source(BGB_P306)
rule VertragBleibtTrotzUnwirksamerKlauselWirksam(k: Klausel, v: Vertrag) strict {
    label de official "Sind Allgemeine Geschäftsbedingungen ganz oder teilweise nicht Vertragsbestandteil geworden oder unwirksam, so bleibt der Vertrag im Übrigen wirksam (§ 306 Abs. 1)";
    label en unofficial "Where standard terms are not incorporated or are ineffective, the contract remains effective in other respects (§ 306 (1))";
    when klausel_des_vertrags(k, v);
    when klausel_unwirksam(k);
    then vertrag_im_uebrigen_wirksam_agb(v);
}

@source(BGB_P306)
rule LueckeWirdDurchGesetzesrechtGefuellt(k: Klausel, v: Vertrag) strict {
    label de official "Soweit die Bestimmungen nicht Vertragsbestandteil geworden oder unwirksam sind, richtet sich der Inhalt des Vertrags nach den gesetzlichen Vorschriften (§ 306 Abs. 2)";
    label en unofficial "So far as terms are not incorporated or are ineffective, the content of the contract follows the statutory provisions (§ 306 (2))";
    when klausel_des_vertrags(k, v);
    when klausel_unwirksam(k);
    then inhalt_richtet_sich_nach_den_gesetzlichen_vorschriften(v, k);
}

@source(BGB_P306)
rule VertragUnwirksamBeiUnzumutbarerHaerte(v: Vertrag) strict {
    label de official "Der Vertrag ist unwirksam, wenn das Festhalten an ihm auch unter Berücksichtigung der nach Absatz 2 vorgesehenen Änderung eine unzumutbare Härte für eine Vertragspartei darstellen würde (§ 306 Abs. 3)";
    label en unofficial "The contract is ineffective if adhering to it would be an unreasonable hardship for a party even with the modification under (2) (§ 306 (3))";
    when festhalten_am_vertrag_unzumutbare_haerte(v);
    then vertrag_unwirksam(v);
}

@source(BGB_P306a)
rule UmgehungsverbotDerAgbVorschriften(k: Klausel) strict {
    label de official "Die Vorschriften dieses Abschnitts finden auch Anwendung, wenn sie durch anderweitige Gestaltungen umgangen werden (§ 306a)";
    label en unofficial "The provisions of this division also apply where they are circumvented by other arrangements (§ 306a)";
    when umgehung_der_vorschriften_ueber_agb(k);
    then vorschriften_finden_gleichwohl_anwendung(k);
}

// --- § 307 Inhaltskontrolle -----------------------------------------------------------------------------

@source(BGB_P307)
pub external judgment relation unangemessene_benachteiligung(k: Klausel) {
    authority Court;
    label de official "§ 307 Abs. 1. Das Gericht hat festgestellt, dass die Bestimmung den Vertragspartner des Verwenders entgegen den Geboten von Treu und Glauben unangemessen benachteiligt; die Benachteiligung kann sich auch daraus ergeben, dass die Bestimmung nicht klar und verständlich ist (Satz 2)";
    label en unofficial "§ 307 (1). The court found that the term unreasonably disadvantages the user's partner contrary to the requirement of good faith; the disadvantage may also result from the term not being clear and comprehensible (sentence 2)";
}
pub relation abweichung_von_wesentlichen_grundgedanken(k: Klausel) kind empirical {
    label de official "Die Bestimmung ist mit wesentlichen Grundgedanken der gesetzlichen Regelung, von der abgewichen wird, nicht zu vereinbaren (§ 307 Abs. 2 Nr. 1)";
    label en unofficial "the term is incompatible with essential principles of the statutory rule from which it departs (§ 307 (2) no. 1)";
}
pub relation gefaehrdung_des_vertragszwecks(k: Klausel) kind empirical {
    label de official "Die Bestimmung schränkt wesentliche Rechte oder Pflichten, die sich aus der Natur des Vertrags ergeben, so ein, dass die Erreichung des Vertragszwecks gefährdet ist (§ 307 Abs. 2 Nr. 2)";
    label en unofficial "the term limits essential rights or duties inherent in the nature of the contract so that attainment of its purpose is jeopardised (§ 307 (2) no. 2)";
}
pub relation abweichende_oder_ergaenzende_regelung(k: Klausel) kind empirical {
    label de official "Durch die Bestimmung werden von Rechtsvorschriften abweichende oder diese ergänzende Regelungen vereinbart (§ 307 Abs. 3 Satz 1)";
    label en unofficial "the term agrees rules departing from or supplementing statutory provisions (§ 307 (3) sentence 1)";
}

@source(BGB_P307)
rule InhaltskontrolleUnangemesseneBenachteiligung(k: Klausel) strict {
    label de official "Bestimmungen in Allgemeinen Geschäftsbedingungen sind unwirksam, wenn sie den Vertragspartner des Verwenders entgegen den Geboten von Treu und Glauben unangemessen benachteiligen (§ 307 Abs. 1 Satz 1)";
    label en unofficial "Terms in standard business terms are ineffective if they unreasonably disadvantage the user's partner contrary to good faith (§ 307 (1) sentence 1)";
    when unangemessene_benachteiligung(k);
    then klausel_unwirksam(k);
}

@source(BGB_P307)
rule ZweifelsregelAbweichungVonGrundgedanken(k: Klausel) strict {
    label de official "Eine unangemessene Benachteiligung ist im Zweifel anzunehmen, wenn eine Bestimmung mit wesentlichen Grundgedanken der gesetzlichen Regelung, von der abgewichen wird, nicht zu vereinbaren ist (§ 307 Abs. 2 Nr. 1); die Absätze 1 und 2 gelten nur für abweichende oder ergänzende Regelungen (Abs. 3 Satz 1)";
    label en unofficial "An unreasonable disadvantage is presumed where a term is incompatible with essential principles of the statutory rule from which it departs (§ 307 (2) no. 1); (1) and (2) apply only to departing or supplementing rules ((3) sentence 1)";
    when abweichende_oder_ergaenzende_regelung(k);
    when abweichung_von_wesentlichen_grundgedanken(k);
    then klausel_unwirksam(k);
}

@source(BGB_P307)
rule ZweifelsregelGefaehrdungDesVertragszwecks(k: Klausel) strict {
    label de official "Eine unangemessene Benachteiligung ist im Zweifel anzunehmen, wenn eine Bestimmung wesentliche Rechte oder Pflichten, die sich aus der Natur des Vertrags ergeben, so einschränkt, dass die Erreichung des Vertragszwecks gefährdet ist (§ 307 Abs. 2 Nr. 2)";
    label en unofficial "An unreasonable disadvantage is presumed where a term limits essential rights or duties so that the contract's purpose is jeopardised (§ 307 (2) no. 2)";
    when abweichende_oder_ergaenzende_regelung(k);
    when gefaehrdung_des_vertragszwecks(k);
    then klausel_unwirksam(k);
}

// --- § 308 Klauselverbote mit Wertungsmöglichkeit --------------------------------------------------------

pub enum Klauselverbot308 {
    label de official "Nummer des Klauselverbots mit Wertungsmöglichkeit (§ 308)";
    label en unofficial "number of the prohibited clause with the possibility of evaluation (§ 308)";
    AnnahmeUndLeistungsfrist,
    Zahlungsfrist,
    UeberpruefungsUndAbnahmefrist,
    Nachfrist,
    Ruecktrittsvorbehalt,
    Aenderungsvorbehalt,
    FingierteErklaerungen,
    FiktionDesZugangs,
    AbwicklungVonVertraegen,
    NichtverfuegbarkeitDerLeistung,
    Abtretungsausschluss
}

@source(BGB_P308)
pub external judgment relation klausel_verstoesst_gegen_308(k: Klausel, nummer: Klauselverbot308) {
    authority Court;
    label de official "§ 308. Das Gericht hat die Wertung getroffen, die die genannte Nummer verlangt („unangemessen lang“, „nicht hinreichend bestimmt“, „ohne sachlich gerechtfertigten Grund“, „zumutbar“, „unangemessen hoch“, „schützenswertes Interesse“), und die Bestimmung fällt unter dieses Klauselverbot";
    label en unofficial "§ 308. The court made the evaluation required by the number in question and the term falls under that prohibition";
}
pub relation verwender_ist_kein_verbraucher(k: Klausel) kind empirical {
    label de official "Der Verwender ist kein Verbraucher (§ 308 Nr. 1a Halbsatz 2, Nr. 1b Halbsatz 2)";
    label en unofficial "the user is not a consumer (§ 308 no. 1a, no. 1b)";
}
pub relation vorbehaltene_zahlungszeit_tage(k: Klausel, tage: Integer) kind empirical {
    key(k);
    label de official "Zeit in Tagen nach Empfang der Gegenleistung oder nach Zugang der Rechnung, die sich der Verwender für die Erfüllung einer Entgeltforderung vorbehält (§ 308 Nr. 1a)";
    label en unofficial "time in days after receipt of the counter-performance or of the invoice which the user reserves for paying remuneration (§ 308 no. 1a)";
}
pub relation vorbehaltene_ueberpruefungszeit_tage(k: Klausel, tage: Integer) kind empirical {
    key(k);
    label de official "Zeit in Tagen nach Empfang der Gegenleistung, die sich der Verwender für die Überprüfung oder Abnahme vorbehält (§ 308 Nr. 1b)";
    label en unofficial "time in days after receipt reserved by the user for inspection or acceptance (§ 308 no. 1b)";
}

@source(BGB_P308)
rule KlauselverbotMitWertungsmoeglichkeit(k: Klausel, nummer: Klauselverbot308) strict {
    label de official "In Allgemeinen Geschäftsbedingungen ist insbesondere unwirksam eine Bestimmung, die unter eine der Nummern des § 308 fällt — die Wertung, die jede Nummer verlangt, trifft das Gericht (§ 308)";
    label en unofficial "A term falling under one of the numbers of § 308 is in particular ineffective in standard business terms — the evaluation each number requires is made by the court (§ 308)";
    when klausel_verstoesst_gegen_308(k, nummer);
    then klausel_unwirksam(k);
}

@source(BGB_P308)
rule ZahlungsfristUeberDreissigTagenIstImZweifelUnangemessenLang(k: Klausel, tage: Integer) strict {
    label de official "Ist der Verwender kein Verbraucher, ist im Zweifel anzunehmen, dass eine Zeit von mehr als 30 Tagen nach Empfang der Gegenleistung oder nach Zugang der Rechnung unangemessen lang ist (§ 308 Nr. 1a Halbsatz 2)";
    label en unofficial "Where the user is not a consumer, a period of more than 30 days after receipt of the counter-performance or of the invoice is presumed unreasonably long (§ 308 no. 1a)";
    when verwender_ist_kein_verbraucher(k);
    when vorbehaltene_zahlungszeit_tage(k, tage);
    when tage > 30;
    then klausel_unwirksam(k);
}

@source(BGB_P308)
rule UeberpruefungszeitUeberFuenfzehnTagenIstImZweifelUnangemessenLang(k: Klausel, tage: Integer) strict {
    label de official "Ist der Verwender kein Verbraucher, ist im Zweifel anzunehmen, dass eine Zeit von mehr als 15 Tagen nach Empfang der Gegenleistung für die Überprüfung oder Abnahme unangemessen lang ist (§ 308 Nr. 1b Halbsatz 2)";
    label en unofficial "Where the user is not a consumer, a period of more than 15 days after receipt for inspection or acceptance is presumed unreasonably long (§ 308 no. 1b)";
    when verwender_ist_kein_verbraucher(k);
    when vorbehaltene_ueberpruefungszeit_tage(k, tage);
    when tage > 15;
    then klausel_unwirksam(k);
}

// --- § 309 Klauselverbote ohne Wertungsmöglichkeit -------------------------------------------------------
//
// Eine Regel je Nummer; die Voraussetzung beschreibt den INHALT der Klausel
// (Tatsache des Falls), nicht ihre Bewertung. Kein `or` im Rumpf: die
// Disjunktion senkt sich in Regeln `Name/alt/N` ab, und `applied(Name)` träfe
// dann nie zu.

pub relation preiserhoehung_innerhalb_von_vier_monaten(k: Klausel) kind empirical {
    label de official "Die Bestimmung sieht die Erhöhung des Entgelts für Waren oder Leistungen vor, die innerhalb von vier Monaten nach Vertragsschluss geliefert oder erbracht werden sollen, und es handelt sich nicht um ein Dauerschuldverhältnis (§ 309 Nr. 1)";
    label en unofficial "the term provides for an increase in the price of goods or services to be delivered within four months of conclusion, outside a continuing obligation (§ 309 no. 1)";
}
pub relation ausschluss_des_leistungsverweigerungsrechts(k: Klausel) kind empirical {
    label de official "Die Bestimmung schließt das Leistungsverweigerungsrecht nach § 320 oder ein Zurückbehaltungsrecht aus demselben Vertragsverhältnis aus oder schränkt es ein (§ 309 Nr. 2)";
    label en unofficial "the term excludes or limits the right to refuse performance under § 320 or a right of retention from the same contract (§ 309 no. 2)";
}
pub relation aufrechnungsverbot(k: Klausel) kind empirical {
    label de official "Die Bestimmung nimmt dem Vertragspartner die Befugnis, mit einer unbestrittenen oder rechtskräftig festgestellten Forderung aufzurechnen (§ 309 Nr. 3)";
    label en unofficial "the term deprives the partner of the power to set off an undisputed or judicially established claim (§ 309 no. 3)";
}
pub relation freistellung_von_mahnung_oder_fristsetzung(k: Klausel) kind empirical {
    label de official "Die Bestimmung stellt den Verwender von der gesetzlichen Obliegenheit frei, zu mahnen oder eine Frist für die Leistung oder Nacherfüllung zu setzen (§ 309 Nr. 4)";
    label en unofficial "the term releases the user from the duty to give a reminder or to fix a period for performance or cure (§ 309 no. 4)";
}
pub relation unzulaessige_schadenspauschale(k: Klausel) kind empirical {
    label de official "Vereinbarung eines pauschalierten Anspruchs des Verwenders auf Schadensersatz oder Ersatz einer Wertminderung, die den gewöhnlich zu erwartenden Schaden übersteigt oder dem anderen Teil den Nachweis eines geringeren Schadens nicht ausdrücklich gestattet (§ 309 Nr. 5)";
    label en unofficial "agreement of a lump-sum claim of the user for damages exceeding the usual damage, or without expressly allowing proof of lesser damage (§ 309 no. 5)";
}
pub relation vertragsstrafe_zugunsten_des_verwenders(k: Klausel) kind empirical {
    label de official "Die Bestimmung verspricht dem Verwender für den Fall der Nichtabnahme oder verspäteten Abnahme, des Zahlungsverzugs oder der Lösung vom Vertrag eine Vertragsstrafe (§ 309 Nr. 6)";
    label en unofficial "the term promises the user a contractual penalty for non-acceptance, late acceptance, default in payment or release from the contract (§ 309 no. 6)";
}
pub relation haftungsausschluss_bei_leben_koerper_gesundheit(k: Klausel) kind empirical {
    label de official "Ausschluss oder Begrenzung der Haftung für Schäden aus der Verletzung des Lebens, des Körpers oder der Gesundheit, die auf einer fahrlässigen Pflichtverletzung des Verwenders oder einer Pflichtverletzung eines gesetzlichen Vertreters oder Erfüllungsgehilfen beruhen (§ 309 Nr. 7 Buchstabe a)";
    label en unofficial "exclusion or limitation of liability for injury to life, body or health based on negligent breach by the user or breach by his representative or agent (§ 309 no. 7 (a))";
}
pub relation haftungsausschluss_bei_grobem_verschulden(k: Klausel) kind empirical {
    label de official "Ausschluss oder Begrenzung der Haftung für sonstige Schäden, die auf einer grob fahrlässigen Pflichtverletzung des Verwenders oder einer vorsätzlichen oder grob fahrlässigen Pflichtverletzung eines gesetzlichen Vertreters oder Erfüllungsgehilfen beruhen (§ 309 Nr. 7 Buchstabe b)";
    label en unofficial "exclusion or limitation of liability for other damage based on gross negligence of the user or intent or gross negligence of his representative or agent (§ 309 no. 7 (b))";
}
pub relation befoerderungsbedingungen_nach_personenbefoerderungsgesetz(k: Klausel) kind empirical {
    label de official "Es handelt sich um genehmigte Beförderungsbedingungen und Tarifvorschriften des Linienverkehrs im Sinne des § 309 Nr. 7 letzter Halbsatz oder um einen staatlich genehmigten Lotterie- oder Ausspielvertrag";
    label en unofficial "the term belongs to approved conditions of carriage in scheduled transport or to a state-approved lottery contract (§ 309 no. 7)";
}
pub relation keine_befoerderungsbedingungen_nach_personenbefoerderungsgesetz(k: Klausel) kind empirical {
    label de official "Es handelt sich nicht um solche Beförderungsbedingungen oder Lotterieverträge (§ 309 Nr. 7) — ausdrückliche Angabe des Falls";
    label en unofficial "the term does not belong to such conditions of carriage or lottery contracts (§ 309 no. 7) — explicit case input";
}
pub relation ausschluss_des_loesungsrechts_bei_pflichtverletzung(k: Klausel) kind empirical {
    label de official "Die Bestimmung schließt bei einer vom Verwender zu vertretenden, nicht in einem Mangel bestehenden Pflichtverletzung das Recht des anderen Teils aus, sich vom Vertrag zu lösen, oder schränkt es ein (§ 309 Nr. 8 Buchstabe a)";
    label en unofficial "the term excludes or limits the partner's right to release himself from the contract upon a breach for which the user is responsible (§ 309 no. 8 (a))";
}
pub relation unzulaessige_maengelklausel(k: Klausel) kind empirical {
    label de official "Bestimmung bei Verträgen über Lieferungen neu hergestellter Sachen und über Werkleistungen, die Mängelansprüche ausschließt, auf Nacherfüllung beschränkt, Aufwendungen der Nacherfüllung abwälzt, die Nacherfüllung von voller Zahlung abhängig macht, eine zu kurze Anzeigefrist setzt oder die Verjährung erleichtert (§ 309 Nr. 8 Buchstabe b)";
    label en unofficial "term on newly produced things or work excluding, restricting or hampering remedies for defects (§ 309 no. 8 (b))";
}
pub relation verjaehrungserleichterung_unter_einem_jahr(k: Klausel, monate: Integer) kind empirical {
    key(k);
    label de official "Die Bestimmung erreicht in den sonstigen Fällen eine Verjährungsfrist von weniger als einem Jahr ab dem gesetzlichen Verjährungsbeginn, gemessen in Monaten (§ 309 Nr. 8 Buchstabe b Doppelbuchstabe ff)";
    label en unofficial "the term results in a limitation period of less than one year from the statutory start, measured in months (§ 309 no. 8 (b) (ff))";
}
pub relation laufzeit_ueber_zwei_jahre(k: Klausel, monate: Integer) kind empirical {
    key(k);
    label de official "Bei einem Vertragsverhältnis über die regelmäßige Lieferung von Waren oder Erbringung von Dienst- oder Werkleistungen bindet die Laufzeit den anderen Vertragsteil länger als zwei Jahre, gemessen in Monaten (§ 309 Nr. 9 Buchstabe a)";
    label en unofficial "in a contract for regular supply the term binds the other party for more than two years, measured in months (§ 309 no. 9 (a))";
}
pub relation kuendigungsfrist_laenger_als_ein_monat(k: Klausel, monate: Integer) kind empirical {
    key(k);
    label de official "Zu Lasten des anderen Vertragsteils längere Kündigungsfrist als einen Monat vor Ablauf der zunächst vorgesehenen Vertragsdauer, gemessen in Monaten (§ 309 Nr. 9 Buchstabe c)";
    label en unofficial "notice period longer than one month before the end of the initially agreed term, measured in months (§ 309 no. 9 (c))";
}
pub relation stillschweigende_verlaengerung_ohne_kuendigungsrecht(k: Klausel) kind empirical {
    label de official "Bindende stillschweigende Verlängerung des Vertragsverhältnisses ohne Verlängerung nur auf unbestimmte Zeit mit monatlichem Kündigungsrecht (§ 309 Nr. 9 Buchstabe b)";
    label en unofficial "binding tacit extension of the contract without an indefinite extension with a monthly right of termination (§ 309 no. 9 (b))";
}
pub relation wechsel_des_vertragspartners_ohne_namen_und_loesungsrecht(k: Klausel) kind empirical {
    label de official "Bestimmung, wonach bei Kauf-, Darlehens-, Dienst- oder Werkverträgen ein Dritter anstelle des Verwenders eintritt, ohne dass der Dritte namentlich bezeichnet oder dem anderen Teil ein Lösungsrecht eingeräumt ist (§ 309 Nr. 10)";
    label en unofficial "term providing that a third party takes the user's place without naming him or granting the partner a right of release (§ 309 no. 10)";
}
pub relation haftung_des_abschlussvertreters(k: Klausel) kind empirical {
    label de official "Bestimmung, die einem Vertreter, der den Vertrag für den anderen Teil abschließt, ohne ausdrückliche gesonderte Erklärung eine eigene Haftung oder im Falle vollmachtsloser Vertretung eine über § 179 hinausgehende Haftung auferlegt (§ 309 Nr. 11)";
    label en unofficial "term imposing personal liability on the agent concluding the contract, or liability beyond § 179 (§ 309 no. 11)";
}
pub relation aenderung_der_beweislast(k: Klausel) kind empirical {
    label de official "Bestimmung, durch die der Verwender die Beweislast zum Nachteil des anderen Teils ändert, insbesondere ihm die Beweislast für Umstände aus dem Verantwortungsbereich des Verwenders auferlegt oder ihn Tatsachen bestätigen lässt (§ 309 Nr. 12)";
    label en unofficial "term changing the burden of proof to the partner's disadvantage (§ 309 no. 12)";
}
pub relation strengere_form_fuer_anzeigen(k: Klausel) kind empirical {
    label de official "Bestimmung, durch die Anzeigen oder Erklärungen an eine strengere Form als die schriftliche oder die Textform oder an besondere Zugangserfordernisse gebunden werden (§ 309 Nr. 13)";
    label en unofficial "term binding notices or declarations to a stricter form or special requirements of receipt (§ 309 no. 13)";
}
pub relation klageverzicht_vor_streitbeilegung(k: Klausel) kind empirical {
    label de official "Bestimmung, wonach der andere Vertragsteil seine Ansprüche gerichtlich nur nach einem Versuch gütlicher Einigung in einem Verfahren zur außergerichtlichen Streitbeilegung geltend machen darf (§ 309 Nr. 14)";
    label en unofficial "term allowing court action only after an attempt at out-of-court settlement (§ 309 no. 14)";
}
pub relation ueberhoehte_abschlagszahlung_oder_fehlende_sicherheit(k: Klausel) kind empirical {
    label de official "Bestimmung, nach der der Verwender bei einem Werkvertrag wesentlich höhere Abschlagszahlungen verlangen kann als nach § 632a Abs. 1 und § 650m Abs. 1 oder die Sicherheitsleistung nach § 650m Abs. 2 nicht oder nur geringer leisten muss (§ 309 Nr. 15)";
    label en unofficial "term allowing substantially higher instalments than §§ 632a (1), 650m (1) or reducing the security under § 650m (2) (§ 309 no. 15)";
}

@source(BGB_P309)
rule Klauselverbot309Nr1KurzfristigePreiserhoehung(k: Klausel) strict {
    label de official "§ 309 Nr. 1 (Kurzfristige Preiserhöhungen): unwirksam ist eine Bestimmung, welche die Erhöhung des Entgelts für Waren oder Leistungen vorsieht, die innerhalb von vier Monaten nach Vertragsschluss geliefert oder erbracht werden sollen; dies gilt nicht bei Dauerschuldverhältnissen";
    label en unofficial "§ 309 no. 1: a term providing for a price increase for goods to be delivered within four months of conclusion is ineffective; not in continuing obligations";
    when preiserhoehung_innerhalb_von_vier_monaten(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr2Leistungsverweigerungsrechte(k: Klausel) strict {
    label de official "§ 309 Nr. 2 (Leistungsverweigerungsrechte): unwirksam ist eine Bestimmung, durch die das Leistungsverweigerungsrecht nach § 320 oder ein Zurückbehaltungsrecht aus demselben Vertragsverhältnis ausgeschlossen oder eingeschränkt wird";
    label en unofficial "§ 309 no. 2: a term excluding or limiting the right to refuse performance under § 320 or a right of retention is ineffective";
    when ausschluss_des_leistungsverweigerungsrechts(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr3Aufrechnungsverbot(k: Klausel) strict {
    label de official "§ 309 Nr. 3 (Aufrechnungsverbot): unwirksam ist eine Bestimmung, durch die dem Vertragspartner die Befugnis genommen wird, mit einer unbestrittenen oder rechtskräftig festgestellten Forderung aufzurechnen";
    label en unofficial "§ 309 no. 3: a term depriving the partner of set-off with an undisputed or established claim is ineffective";
    when aufrechnungsverbot(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr4MahnungUndFristsetzung(k: Klausel) strict {
    label de official "§ 309 Nr. 4 (Mahnung, Fristsetzung): unwirksam ist eine Bestimmung, durch die der Verwender von der gesetzlichen Obliegenheit freigestellt wird, zu mahnen oder eine Frist zu setzen";
    label en unofficial "§ 309 no. 4: a term releasing the user from giving a reminder or fixing a period is ineffective";
    when freistellung_von_mahnung_oder_fristsetzung(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr5Schadenspauschale(k: Klausel) strict {
    label de official "§ 309 Nr. 5 (Pauschalierung von Schadensersatzansprüchen): unwirksam ist die Vereinbarung einer Pauschale, die den gewöhnlich zu erwartenden Schaden übersteigt oder den Nachweis eines geringeren Schadens nicht ausdrücklich gestattet";
    label en unofficial "§ 309 no. 5: a lump sum exceeding the usual damage or barring proof of lesser damage is ineffective";
    when unzulaessige_schadenspauschale(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr6Vertragsstrafe(k: Klausel) strict {
    label de official "§ 309 Nr. 6 (Vertragsstrafe): unwirksam ist eine Bestimmung, durch die dem Verwender für Nichtabnahme, verspätete Abnahme, Zahlungsverzug oder Lösung vom Vertrag eine Vertragsstrafe versprochen wird";
    label en unofficial "§ 309 no. 6: a term promising the user a contractual penalty is ineffective";
    when vertragsstrafe_zugunsten_des_verwenders(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr7aLebenKoerperGesundheit(k: Klausel) strict {
    label de official "§ 309 Nr. 7 Buchstabe a: unwirksam ist ein Ausschluss oder eine Begrenzung der Haftung für Schäden aus der Verletzung des Lebens, des Körpers oder der Gesundheit; die Ausnahme der genehmigten Beförderungsbedingungen greift hier nicht";
    label en unofficial "§ 309 no. 7 (a): exclusion or limitation of liability for injury to life, body or health is ineffective";
    when haftungsausschluss_bei_leben_koerper_gesundheit(k);
    when keine_befoerderungsbedingungen_nach_personenbefoerderungsgesetz(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr7bGrobesVerschulden(k: Klausel) strict {
    label de official "§ 309 Nr. 7 Buchstabe b: unwirksam ist ein Ausschluss oder eine Begrenzung der Haftung für sonstige Schäden aus grob fahrlässiger Pflichtverletzung des Verwenders oder vorsätzlicher oder grob fahrlässiger Pflichtverletzung seiner Vertreter und Erfüllungsgehilfen";
    label en unofficial "§ 309 no. 7 (b): exclusion or limitation of liability for gross negligence is ineffective";
    when haftungsausschluss_bei_grobem_verschulden(k);
    when keine_befoerderungsbedingungen_nach_personenbefoerderungsgesetz(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr8aLoesungsrecht(k: Klausel) strict {
    label de official "§ 309 Nr. 8 Buchstabe a: unwirksam ist eine Bestimmung, die bei einer vom Verwender zu vertretenden Pflichtverletzung das Recht des anderen Teils, sich vom Vertrag zu lösen, ausschließt oder einschränkt";
    label en unofficial "§ 309 no. 8 (a): a term excluding the partner's right of release upon the user's breach is ineffective";
    when ausschluss_des_loesungsrechts_bei_pflichtverletzung(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr8bMaengel(k: Klausel) strict {
    label de official "§ 309 Nr. 8 Buchstabe b: unwirksam ist eine Bestimmung, die bei Lieferungen neu hergestellter Sachen und Werkleistungen Mängelansprüche ausschließt, auf Nacherfüllung beschränkt, die Aufwendungen der Nacherfüllung abwälzt, die Nacherfüllung von voller Zahlung abhängig macht oder eine zu kurze Anzeigefrist setzt";
    label en unofficial "§ 309 no. 8 (b): terms hampering remedies for defects in newly produced things or work are ineffective";
    when unzulaessige_maengelklausel(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr8bffVerjaehrungUnterEinemJahr(k: Klausel, monate: Integer) strict {
    label de official "§ 309 Nr. 8 Buchstabe b Doppelbuchstabe ff: unwirksam ist eine Bestimmung, durch die in den sonstigen Fällen eine weniger als ein Jahr betragende Verjährungsfrist ab dem gesetzlichen Verjährungsbeginn erreicht wird";
    label en unofficial "§ 309 no. 8 (b) (ff): a term achieving a limitation period of less than one year from the statutory start is ineffective";
    when verjaehrungserleichterung_unter_einem_jahr(k, monate);
    when monate < 12;
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr9aLaufzeitUeberZweiJahre(k: Klausel, monate: Integer) strict {
    label de official "§ 309 Nr. 9 Buchstabe a: bei einem Vertragsverhältnis über regelmäßige Lieferungen oder Leistungen ist eine den anderen Vertragsteil länger als zwei Jahre bindende Laufzeit unwirksam";
    label en unofficial "§ 309 no. 9 (a): in contracts for regular supply a term binding the partner for more than two years is ineffective";
    when laufzeit_ueber_zwei_jahre(k, monate);
    when monate > 24;
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr9bStillschweigendeVerlaengerung(k: Klausel) strict {
    label de official "§ 309 Nr. 9 Buchstabe b: unwirksam ist eine den anderen Vertragsteil bindende stillschweigende Verlängerung des Vertragsverhältnisses, es sei denn, es wird nur auf unbestimmte Zeit verlängert und der andere Teil kann jederzeit mit einer Frist von höchstens einem Monat kündigen";
    label en unofficial "§ 309 no. 9 (b): a binding tacit extension is ineffective unless the contract is extended indefinitely with a monthly right of termination";
    when stillschweigende_verlaengerung_ohne_kuendigungsrecht(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr9cKuendigungsfristUeberEinemMonat(k: Klausel, monate: Integer) strict {
    label de official "§ 309 Nr. 9 Buchstabe c: unwirksam ist eine zu Lasten des anderen Vertragsteils längere Kündigungsfrist als ein Monat vor Ablauf der zunächst vorgesehenen Vertragsdauer";
    label en unofficial "§ 309 no. 9 (c): a notice period longer than one month before the end of the initial term is ineffective";
    when kuendigungsfrist_laenger_als_ein_monat(k, monate);
    when monate > 1;
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr10WechselDesVertragspartners(k: Klausel) strict {
    label de official "§ 309 Nr. 10 (Wechsel des Vertragspartners): unwirksam ist eine Bestimmung, wonach ein Dritter anstelle des Verwenders eintritt, ohne dass er namentlich bezeichnet oder dem anderen Teil ein Lösungsrecht eingeräumt ist";
    label en unofficial "§ 309 no. 10: a term substituting an unnamed third party for the user without a right of release is ineffective";
    when wechsel_des_vertragspartners_ohne_namen_und_loesungsrecht(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr11HaftungDesAbschlussvertreters(k: Klausel) strict {
    label de official "§ 309 Nr. 11 (Haftung des Abschlussvertreters): unwirksam ist eine Bestimmung, die dem Vertreter ohne ausdrückliche gesonderte Erklärung eine eigene Haftung oder bei vollmachtsloser Vertretung eine über § 179 hinausgehende Haftung auferlegt";
    label en unofficial "§ 309 no. 11: a term imposing personal liability on the concluding agent is ineffective";
    when haftung_des_abschlussvertreters(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr12Beweislast(k: Klausel) strict {
    label de official "§ 309 Nr. 12 (Beweislast): unwirksam ist eine Bestimmung, durch die der Verwender die Beweislast zum Nachteil des anderen Teils ändert";
    label en unofficial "§ 309 no. 12: a term shifting the burden of proof to the partner's disadvantage is ineffective";
    when aenderung_der_beweislast(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr13FormVonAnzeigen(k: Klausel) strict {
    label de official "§ 309 Nr. 13 (Form von Anzeigen und Erklärungen): unwirksam ist eine Bestimmung, die Anzeigen oder Erklärungen an eine strengere Form oder an besondere Zugangserfordernisse bindet";
    label en unofficial "§ 309 no. 13: a term binding notices to a stricter form or special receipt requirements is ineffective";
    when strengere_form_fuer_anzeigen(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr14Klageverzicht(k: Klausel) strict {
    label de official "§ 309 Nr. 14 (Klageverzicht): unwirksam ist eine Bestimmung, wonach der andere Vertragsteil seine Ansprüche gerichtlich erst nach einem Verfahren zur außergerichtlichen Streitbeilegung geltend machen darf";
    label en unofficial "§ 309 no. 14: a term requiring an out-of-court attempt before court action is ineffective";
    when klageverzicht_vor_streitbeilegung(k);
    then klausel_unwirksam(k);
}

@source(BGB_P309)
rule Klauselverbot309Nr15AbschlagszahlungenUndSicherheit(k: Klausel) strict {
    label de official "§ 309 Nr. 15 (Abschlagszahlungen und Sicherheitsleistung): unwirksam ist eine Bestimmung, nach der der Verwender bei einem Werkvertrag wesentlich höhere Abschlagszahlungen verlangen kann oder die Sicherheitsleistung nach § 650m Abs. 2 nicht leisten muss";
    label en unofficial "§ 309 no. 15: a term allowing substantially higher instalments or dispensing with the security is ineffective";
    when ueberhoehte_abschlagszahlung_oder_fehlende_sicherheit(k);
    then klausel_unwirksam(k);
}

// --- § 310 Anwendungsbereich -------------------------------------------------------------------------------

pub relation verwendet_gegenueber_unternehmer_oder_oeffentlicher_hand(k: Klausel) kind empirical {
    label de official "Die Allgemeinen Geschäftsbedingungen werden gegenüber einem Unternehmer, einer juristischen Person des öffentlichen Rechts oder einem öffentlich-rechtlichen Sondervermögen verwendet (§ 310 Abs. 1 Satz 1)";
    label en unofficial "the standard terms are used towards a trader, a legal person under public law or a special public fund (§ 310 (1) sentence 1)";
}
pub relation klauselverbote_und_einbeziehungsregeln_nicht_anwendbar(k: Klausel) kind institutional {
    label de official "§ 305 Absatz 2 und 3, § 308 Nummer 1, 2 bis 9 und § 309 finden keine Anwendung (§ 310 Abs. 1 Satz 1); § 307 Abs. 1 und 2 bleibt anwendbar, auch soweit dies zur Unwirksamkeit der dort genannten Bestimmungen führt (Satz 2)";
    label en unofficial "§ 305 (2), (3), § 308 nos. 1, 2 to 9 and § 309 do not apply (§ 310 (1) sentence 1); § 307 (1), (2) remains applicable (sentence 2)";
}
pub relation versorgungsvertrag_mit_sonderabnehmer(k: Klausel) kind empirical {
    label de official "Vertrag eines Elektrizitäts-, Gas-, Fernwärme- oder Wasserversorgungsunternehmens über die Versorgung von Sonderabnehmern aus dem Versorgungsnetz oder über die Entsorgung von Abwasser, dessen Bedingungen nicht zum Nachteil der Abnehmer von den Verordnungen über Allgemeine Versorgungsbedingungen abweichen (§ 310 Abs. 2)";
    label en unofficial "supply contract with special customers under § 310 (2)";
}
pub relation klauselverbote_der_308_und_309_nicht_anwendbar(k: Klausel) kind institutional {
    label de official "Die §§ 308 und 309 finden keine Anwendung (§ 310 Abs. 2)";
    label en unofficial "§§ 308 and 309 do not apply (§ 310 (2))";
}
pub relation verbrauchervertrag(v: Vertrag) kind institutional {
    label de official "Vertrag zwischen einem Unternehmer und einem Verbraucher (Verbrauchervertrag, § 310 Abs. 3, § 312 Abs. 1)";
    label en unofficial "contract between a trader and a consumer (consumer contract, § 310 (3), § 312 (1))";
}
pub relation vom_verbraucher_in_den_vertrag_eingefuehrt(k: Klausel) kind empirical {
    label de official "Die Allgemeinen Geschäftsbedingungen wurden durch den Verbraucher in den Vertrag eingeführt (§ 310 Abs. 3 Nr. 1)";
    label en unofficial "the standard terms were introduced into the contract by the consumer (§ 310 (3) no. 1)";
}
pub relation nicht_vom_verbraucher_eingefuehrt(k: Klausel) kind empirical {
    label de official "Die Allgemeinen Geschäftsbedingungen wurden nicht durch den Verbraucher in den Vertrag eingeführt (§ 310 Abs. 3 Nr. 1) — ausdrückliche Angabe des Falls";
    label en unofficial "the standard terms were not introduced by the consumer (§ 310 (3) no. 1) — explicit case input";
}
pub relation gilt_als_vom_unternehmer_gestellt(k: Klausel) kind institutional {
    label de official "Allgemeine Geschäftsbedingungen gelten bei Verbraucherverträgen als vom Unternehmer gestellt (§ 310 Abs. 3 Nr. 1)";
    label en unofficial "in consumer contracts standard terms are deemed to have been presented by the trader (§ 310 (3) no. 1)";
}
pub relation nur_zur_einmaligen_verwendung_vorformuliert(k: Klausel) kind empirical {
    label de official "Die vorformulierte Vertragsbedingung ist nur zur einmaligen Verwendung bestimmt und der Verbraucher konnte auf ihren Inhalt keinen Einfluss nehmen (§ 310 Abs. 3 Nr. 2)";
    label en unofficial "the pre-formulated term is intended for single use and the consumer could not influence its content (§ 310 (3) no. 2)";
}
pub relation inhaltskontrolle_auch_bei_einmaliger_verwendung(k: Klausel) kind institutional {
    label de official "§ 305c Abs. 2 und die §§ 306 und 307 bis 309 finden auch auf nur zur einmaligen Verwendung bestimmte vorformulierte Vertragsbedingungen Anwendung (§ 310 Abs. 3 Nr. 2)";
    label en unofficial "§ 305c (2) and §§ 306, 307 to 309 also apply to terms intended for single use (§ 310 (3) no. 2)";
}
pub relation vertrag_des_erb_familien_oder_gesellschaftsrechts(v: Vertrag) kind empirical {
    label de official "Vertrag auf dem Gebiet des Erb-, Familien- und Gesellschaftsrechts oder Tarifvertrag, Betriebs- oder Dienstvereinbarung (§ 310 Abs. 4 Satz 1)";
    label en unofficial "contract in the field of succession, family or company law, or a collective agreement (§ 310 (4) sentence 1)";
}
pub relation abschnitt_ueber_agb_nicht_anwendbar(v: Vertrag) kind institutional {
    label de official "Dieser Abschnitt findet keine Anwendung (§ 310 Abs. 4 Satz 1)";
    label en unofficial "this division does not apply (§ 310 (4) sentence 1)";
}

@source(BGB_P310)
rule KeineKlauselverboteGegenueberUnternehmern(k: Klausel) strict {
    label de official "§ 305 Absatz 2 und 3, § 308 Nummer 1, 2 bis 9 und § 309 finden keine Anwendung auf Allgemeine Geschäftsbedingungen, die gegenüber einem Unternehmer, einer juristischen Person des öffentlichen Rechts oder einem öffentlich-rechtlichen Sondervermögen verwendet werden (§ 310 Abs. 1 Satz 1)";
    label en unofficial "§ 305 (2), (3), § 308 nos. 1, 2 to 9 and § 309 do not apply to standard terms used towards traders or public bodies (§ 310 (1) sentence 1)";
    when verwendet_gegenueber_unternehmer_oder_oeffentlicher_hand(k);
    then klauselverbote_und_einbeziehungsregeln_nicht_anwendbar(k);
}

@source(BGB_P310)
rule KeineKlauselverboteBeiVersorgungsvertraegen(k: Klausel) strict {
    label de official "Die §§ 308 und 309 finden keine Anwendung auf Verträge der Elektrizitäts-, Gas-, Fernwärme- und Wasserversorgungsunternehmen über die Versorgung von Sonderabnehmern, soweit die Versorgungsbedingungen nicht zum Nachteil der Abnehmer abweichen; das Gleiche gilt für die Entsorgung von Abwasser (§ 310 Abs. 2)";
    label en unofficial "§§ 308 and 309 do not apply to supply contracts with special customers (§ 310 (2))";
    when versorgungsvertrag_mit_sonderabnehmer(k);
    then klauselverbote_der_308_und_309_nicht_anwendbar(k);
}

@source(BGB_P310)
rule VerbrauchervertragLiegtVor(v: Vertrag, unternehmerpartei: Person, verbraucherpartei: Person) strict {
    label de official "Verträge zwischen einem Unternehmer und einem Verbraucher sind Verbraucherverträge (§ 310 Abs. 3, § 312 Abs. 1)";
    label en unofficial "Contracts between a trader and a consumer are consumer contracts (§ 310 (3), § 312 (1))";
    when vertragspartei(v, unternehmerpartei);
    when vertragspartei(v, verbraucherpartei);
    when unternehmer(unternehmerpartei);
    when verbraucher(verbraucherpartei);
    then verbrauchervertrag(v);
}

@source(BGB_P310)
rule AgbGeltenAlsVomUnternehmerGestellt(k: Klausel, v: Vertrag) strict {
    label de official "Bei Verbraucherverträgen gelten Allgemeine Geschäftsbedingungen als vom Unternehmer gestellt, es sei denn, dass sie durch den Verbraucher in den Vertrag eingeführt wurden (§ 310 Abs. 3 Nr. 1)";
    label en unofficial "In consumer contracts standard terms are deemed presented by the trader unless the consumer introduced them (§ 310 (3) no. 1)";
    when klausel_des_vertrags(k, v);
    when verbrauchervertrag(v);
    when nicht_vom_verbraucher_eingefuehrt(k);
    then gilt_als_vom_unternehmer_gestellt(k);
}

@source(BGB_P310)
rule InhaltskontrolleBeiEinmaligerVerwendung(k: Klausel, v: Vertrag) strict {
    label de official "§ 305c Abs. 2 und die §§ 306 und 307 bis 309 finden auf vorformulierte Vertragsbedingungen auch dann Anwendung, wenn diese nur zur einmaligen Verwendung bestimmt sind und soweit der Verbraucher auf ihren Inhalt keinen Einfluss nehmen konnte (§ 310 Abs. 3 Nr. 2)";
    label en unofficial "§ 305c (2) and §§ 306, 307 to 309 apply to pre-formulated terms intended for single use where the consumer could not influence their content (§ 310 (3) no. 2)";
    when klausel_des_vertrags(k, v);
    when verbrauchervertrag(v);
    when nur_zur_einmaligen_verwendung_vorformuliert(k);
    then inhaltskontrolle_auch_bei_einmaliger_verwendung(k);
}

@source(BGB_P310)
rule AgbRechtGiltNichtImErbFamilienUndGesellschaftsrecht(v: Vertrag) strict {
    label de official "Dieser Abschnitt findet keine Anwendung bei Verträgen auf dem Gebiet des Erb-, Familien- und Gesellschaftsrechts sowie auf Tarifverträge, Betriebs- und Dienstvereinbarungen (§ 310 Abs. 4 Satz 1)";
    label en unofficial "This division does not apply to contracts in succession, family or company law, nor to collective agreements (§ 310 (4) sentence 1)";
    when vertrag_des_erb_familien_oder_gesellschaftsrechts(v);
    then abschnitt_ueber_agb_nicht_anwendbar(v);
}
