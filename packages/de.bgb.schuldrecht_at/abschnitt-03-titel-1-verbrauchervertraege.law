// ABSCHNITT 3 TITEL 1 UNTERTITEL 2: GRUNDSÄTZE BEI VERBRAUCHERVERTRÄGEN UND
// BESONDERE VERTRIEBSFORMEN, §§ 312–312m
//
// DREI SCHRITTE: der Anwendungsbereich (§ 312), die allgemeinen Pflichten und
// Entgeltgrenzen (§ 312a), die Begriffe der besonderen Vertriebsformen
// (§§ 312b, 312c) mit Informations-, Bestätigungs- und Gestaltungspflichten
// (§§ 312d–312f, 312i–312l) und das Widerrufsrecht (§ 312g), das in § 355
// weitergeführt wird.
//
// DIE INHALTE DER INFORMATIONSPFLICHTEN STEHEN IM EGBGB (Artikel 246, 246a,
// 246b, 246c, 246d) und sind NICHT Gegenstand dieses Pakets
// (SOURCES.json.external, disposition `case_input`): der Fall sagt, ob der
// Unternehmer unterrichtet hat; was er zu sagen hatte, sagt das EGBGB. Die
// Rechtsfolge der Unterlassung — § 312e (keine Fracht-, Liefer- und
// Versandkosten), § 356 Abs. 3 (die Widerrufsfrist beginnt nicht) und § 312m
// Abs. 2 (Beweislast) — steht hier und ist Regel.
//
// ZAHLEN AUS DEM TEXT: 40 Euro (§ 312 Abs. 2 Nr. 12), 30 Tage (§ 312g Abs. 2
// Nr. 5), ein Jahr (§ 312 Abs. 5 Satz 4).

language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";

// --- § 312 Anwendungsbereich ----------------------------------------------------------------------

pub relation verbraucher_zur_zahlung_eines_preises_verpflichtet(v: Vertrag) kind empirical {
    label de official "Der Verbraucher verpflichtet sich zu der Zahlung eines Preises (§ 312 Abs. 1)";
    label en unofficial "the consumer undertakes to pay a price (§ 312 (1))";
}
pub relation verbraucher_stellt_personenbezogene_daten_bereit(v: Vertrag) kind empirical {
    label de official "Der Verbraucher stellt dem Unternehmer personenbezogene Daten bereit oder verpflichtet sich hierzu (§ 312 Abs. 1a Satz 1)";
    label en unofficial "the consumer provides the trader with personal data or undertakes to do so (§ 312 (1a) sentence 1)";
}
pub relation daten_ausschliesslich_zur_erfuellung_verarbeitet(v: Vertrag) kind empirical {
    label de official "Der Unternehmer verarbeitet die bereitgestellten personenbezogenen Daten ausschließlich, um seine Leistungspflicht oder rechtliche Anforderungen zu erfüllen, und zu keinem anderen Zweck (§ 312 Abs. 1a Satz 2)";
    label en unofficial "the trader processes the personal data exclusively to perform his obligation or legal requirements and for no other purpose (§ 312 (1a) sentence 2)";
}
pub relation daten_nicht_ausschliesslich_zur_erfuellung_verarbeitet(v: Vertrag) kind empirical {
    label de official "Die Daten werden nicht ausschließlich zur Erfüllung der Leistungspflicht verarbeitet (§ 312 Abs. 1a Satz 2) — ausdrückliche Angabe des Falls";
    label en unofficial "the data are not processed exclusively to perform the obligation (§ 312 (1a) sentence 2) — explicit case input";
}
pub enum AusgenommenerVertrag {
    label de official "Vertragsart, auf die von den Kapiteln 1 und 2 nur § 312a Absatz 1, 3, 4 und 6 anzuwenden ist (§ 312 Abs. 2 Nummern 1 bis 14)";
    label en unofficial "type of contract to which only § 312a (1), (3), (4), (6) applies (§ 312 (2) nos. 1 to 14)";
    NotariellBeurkundeterVertrag,
    GrundstuecksvertragUndAehnliche,
    Verbraucherbauvertrag,
    SozialeDienstleistungen,
    VermietungVonWohnraum,
    TeilzeitWohnrechteUndUrlaubsprodukte,
    Behandlungsvertrag,
    LebensmittelDurchRegelmaessigeFahrten,
    WarenautomatenUndAutomatisierteGeschaeftsraeume,
    OeffentlicheMuenzUndKartentelefone,
    EinzelneTelekommunikationsverbindung,
    KleinbetragAusserhalbVonGeschaeftsraeumen,
    VerkaufAufGrundVonZwangsvollstreckung,
    BefoerderungVonPersonen
}
pub relation ausgenommener_vertrag(v: Vertrag, art: AusgenommenerVertrag) kind empirical {
    label de official "Der Vertrag gehört zu einer der in § 312 Abs. 2 genannten Arten";
    label en unofficial "the contract belongs to one of the types named in § 312 (2)";
}
pub relation entgelt_des_verbrauchers(v: Vertrag, betrag: Money) kind empirical {
    key(v);
    label de official "Vom Verbraucher zu zahlendes Entgelt (§ 312 Abs. 2 Nr. 12: Grenze von 40 Euro)";
    label en unofficial "remuneration payable by the consumer (§ 312 (2) no. 12: the 40-euro limit)";
}
pub relation leistung_sofort_erbracht_und_bezahlt(v: Vertrag) kind empirical {
    label de official "Bei dem außerhalb von Geschäftsräumen geschlossenen Vertrag wird die Leistung bei Abschluss der Verhandlungen sofort erbracht und bezahlt (§ 312 Abs. 2 Nr. 12)";
    label en unofficial "the performance is rendered and paid for immediately on conclusion of the negotiations (§ 312 (2) no. 12)";
}
pub relation untertitel_anwendbar(v: Vertrag) kind institutional {
    label de official "Die Vorschriften der Kapitel 1 und 2 dieses Untertitels sind auf den Vertrag anzuwenden (§ 312 Abs. 1, 1a)";
    label en unofficial "the provisions of Chapters 1 and 2 of this sub-title apply to the contract (§ 312 (1), (1a))";
}
pub relation nur_312a_teilweise_anwendbar(v: Vertrag) kind institutional {
    label de official "Von den Vorschriften der Kapitel 1 und 2 ist nur § 312a Absatz 1, 3, 4 und 6 anzuwenden (§ 312 Abs. 2)";
    label en unofficial "of Chapters 1 and 2 only § 312a (1), (3), (4) and (6) applies (§ 312 (2))";
}

@source(BGB_P312)
rule UntertitelGiltFuerEntgeltlicheVerbrauchervertraege(v: Vertrag) strict {
    label de official "Die Vorschriften der Kapitel 1 und 2 dieses Untertitels sind auf Verbraucherverträge anzuwenden, bei denen sich der Verbraucher zu der Zahlung eines Preises verpflichtet (§ 312 Abs. 1)";
    label en unofficial "Chapters 1 and 2 of this sub-title apply to consumer contracts under which the consumer undertakes to pay a price (§ 312 (1))";
    when verbrauchervertrag(v);
    when verbraucher_zur_zahlung_eines_preises_verpflichtet(v);
    then untertitel_anwendbar(v);
}

@source(BGB_P312)
rule UntertitelGiltAuchBeiBereitstellungPersonenbezogenerDaten(v: Vertrag) strict {
    label de official "Die Vorschriften sind auch auf Verbraucherverträge anzuwenden, bei denen der Verbraucher dem Unternehmer personenbezogene Daten bereitstellt oder sich hierzu verpflichtet; dies gilt nicht, wenn der Unternehmer die Daten ausschließlich zur Erfüllung seiner Leistungspflicht oder rechtlicher Anforderungen verarbeitet (§ 312 Abs. 1a)";
    label en unofficial "They also apply where the consumer provides personal data, unless the trader processes them exclusively to perform his obligation or legal requirements (§ 312 (1a))";
    when verbrauchervertrag(v);
    when verbraucher_stellt_personenbezogene_daten_bereit(v);
    when daten_nicht_ausschliesslich_zur_erfuellung_verarbeitet(v);
    then untertitel_anwendbar(v);
}

@source(BGB_P312)
rule AusgenommeneVertraegeNachAbsatz2(v: Vertrag, art: AusgenommenerVertrag) strict {
    label de official "Von den Vorschriften der Kapitel 1 und 2 dieses Untertitels ist nur § 312a Absatz 1, 3, 4 und 6 auf die in Absatz 2 Nummern 1 bis 14 genannten Verträge anzuwenden (§ 312 Abs. 2)";
    label en unofficial "Of Chapters 1 and 2 only § 312a (1), (3), (4) and (6) applies to the contracts listed in (2) nos. 1 to 14 (§ 312 (2))";
    when verbrauchervertrag(v);
    when ausgenommener_vertrag(v, art);
    then nur_312a_teilweise_anwendbar(v);
}

@source(BGB_P312)
rule KleinbetragsvertragAusserhalbVonGeschaeftsraeumen(v: Vertrag, betrag: Money) strict {
    label de official "Zu den ausgenommenen Verträgen gehören außerhalb von Geschäftsräumen geschlossene Verträge, bei denen die Leistung bei Abschluss der Verhandlungen sofort erbracht und bezahlt wird und das vom Verbraucher zu zahlende Entgelt 40 Euro nicht überschreitet (§ 312 Abs. 2 Nr. 12)";
    label en unofficial "Among the excluded contracts are off-premises contracts performed and paid immediately where the remuneration does not exceed 40 euros (§ 312 (2) no. 12)";
    when verbrauchervertrag(v);
    when ausserhalb_von_geschaeftsraeumen_geschlossen(v);
    when leistung_sofort_erbracht_und_bezahlt(v);
    when entgelt_des_verbrauchers(v, betrag);
    when betrag <= 40.00 EUR;
    then nur_312a_teilweise_anwendbar(v);
}

// --- § 312a Allgemeine Pflichten und Entgeltgrenzen -------------------------------------------------

pub relation unternehmer_ruft_den_verbraucher_an(v: Vertrag, anrufer: Person) kind empirical {
    label de official "Der Unternehmer oder eine in seinem Namen oder Auftrag handelnde Person ruft den Verbraucher an, um mit ihm einen Vertrag zu schließen (§ 312a Abs. 1 Satz 1)";
    label en unofficial "the trader or a person acting for him calls the consumer in order to conclude a contract (§ 312a (1) sentence 1)";
}
pub relation identitaet_und_zweck_offengelegt(v: Vertrag) kind empirical {
    label de official "Der Anrufer hat zu Beginn des Gesprächs seine Identität und den geschäftlichen Zweck des Anrufs offengelegt (§ 312a Abs. 1 Satz 1)";
    label en unofficial "the caller disclosed his identity and the commercial purpose of the call at the outset (§ 312a (1) sentence 1)";
}
pub relation offenlegungspflicht_verletzt(v: Vertrag, anrufer: Person) kind institutional {
    label de official "Der Anrufer hat die Pflicht, zu Beginn des Gesprächs Identität und geschäftlichen Zweck offenzulegen, nicht erfüllt (§ 312a Abs. 1)";
    label en unofficial "the caller did not comply with the duty to disclose identity and commercial purpose at the outset (§ 312a (1))";
}
pub relation identitaet_nicht_offengelegt(v: Vertrag) kind empirical {
    label de official "Der Anrufer hat Identität und geschäftlichen Zweck nicht offengelegt (§ 312a Abs. 1) — ausdrückliche Angabe des Falls";
    label en unofficial "the caller did not disclose identity and commercial purpose (§ 312a (1)) — explicit case input";
}
pub relation zusatzentgelt_vereinbart(vb: Vereinbarung, v: Vertrag) kind empirical {
    label de official "Eine Vereinbarung ist auf eine über das vereinbarte Entgelt für die Hauptleistung hinausgehende Zahlung des Verbrauchers gerichtet (§ 312a Abs. 3 Satz 1)";
    label en unofficial "an agreement is directed at a payment of the consumer beyond the agreed price for the main performance (§ 312a (3) sentence 1)";
}
pub relation zusatzentgelt_nicht_ausdruecklich_vereinbart(vb: Vereinbarung) kind empirical {
    label de official "Die Vereinbarung ist nicht ausdrücklich getroffen oder im elektronischen Geschäftsverkehr durch eine Voreinstellung herbeigeführt (§ 312a Abs. 3)";
    label en unofficial "the agreement was not made expressly or was brought about by a default setting in electronic commerce (§ 312a (3))";
}
pub relation entgelt_fuer_zahlungsmittel_vereinbart(vb: Vereinbarung, v: Vertrag) kind empirical {
    label de official "Eine Vereinbarung verpflichtet den Verbraucher, ein Entgelt dafür zu zahlen, dass er für die Erfüllung seiner vertraglichen Pflichten ein bestimmtes Zahlungsmittel nutzt (§ 312a Abs. 4)";
    label en unofficial "an agreement obliges the consumer to pay a charge for using a particular means of payment (§ 312a (4))";
}
pub relation keine_unentgeltliche_zahlungsmoeglichkeit(vb: Vereinbarung) kind empirical {
    label de official "Für den Verbraucher besteht keine gängige und zumutbare unentgeltliche Zahlungsmöglichkeit (§ 312a Abs. 4 Nr. 1)";
    label en unofficial "the consumer has no common and reasonable free means of payment (§ 312a (4) no. 1)";
}
pub relation entgelt_ueber_den_kosten_des_zahlungsmittels(vb: Vereinbarung) kind empirical {
    label de official "Das vereinbarte Entgelt geht über die Kosten hinaus, die dem Unternehmer durch die Nutzung des Zahlungsmittels entstehen (§ 312a Abs. 4 Nr. 2)";
    label en unofficial "the charge exceeds the costs incurred by the trader from using the means of payment (§ 312a (4) no. 2)";
}
pub relation entgelt_fuer_kundenhotline_vereinbart(vb: Vereinbarung, v: Vertrag) kind empirical {
    label de official "Eine Vereinbarung verpflichtet den Verbraucher, ein Entgelt für den Anruf über eine vom Unternehmer für Fragen oder Erklärungen zum Vertrag bereitgehaltene Rufnummer zu zahlen (§ 312a Abs. 5 Satz 1)";
    label en unofficial "an agreement obliges the consumer to pay a charge for calling a number kept by the trader for questions about the contract (§ 312a (5) sentence 1)";
}
pub relation entgelt_ueber_dem_reinen_telekommunikationsentgelt(vb: Vereinbarung) kind empirical {
    label de official "Das vereinbarte Entgelt übersteigt das Entgelt für die bloße Nutzung des Telekommunikationsdienstes (§ 312a Abs. 5 Satz 1)";
    label en unofficial "the charge exceeds the charge for the mere use of the telecommunications service (§ 312a (5) sentence 1)";
}
pub relation verbraucher_gegenueber_dem_anbieter_nicht_verpflichtet(vb: Vereinbarung) kind institutional {
    label de official "Ist die Vereinbarung unwirksam, ist der Verbraucher auch gegenüber dem Anbieter des Telekommunikationsdienstes nicht verpflichtet, ein Entgelt für den Anruf zu zahlen (§ 312a Abs. 5 Satz 2)";
    label en unofficial "where the agreement is ineffective the consumer owes no charge for the call to the provider either (§ 312a (5) sentence 2)";
}

@source(BGB_P312a)
rule OffenlegungspflichtBeimAnruf(v: Vertrag, anrufer: Person) strict {
    label de official "Ruft der Unternehmer oder eine Person, die in seinem Namen oder Auftrag handelt, den Verbraucher an, um mit diesem einen Vertrag zu schließen, hat der Anrufer zu Beginn des Gesprächs seine Identität und den geschäftlichen Zweck des Anrufs offenzulegen (§ 312a Abs. 1 Satz 1)";
    label en unofficial "Where the trader calls the consumer to conclude a contract, the caller must disclose his identity and the commercial purpose at the outset (§ 312a (1) sentence 1)";
    when unternehmer_ruft_den_verbraucher_an(v, anrufer);
    when identitaet_nicht_offengelegt(v);
    then offenlegungspflicht_verletzt(v, anrufer);
}

@source(BGB_P312a)
rule ZusatzentgeltNurAusdruecklich(vb: Vereinbarung, v: Vertrag) strict {
    label de official "Eine Vereinbarung, die auf eine über das vereinbarte Entgelt für die Hauptleistung hinausgehende Zahlung des Verbrauchers gerichtet ist, kann ein Unternehmer mit einem Verbraucher nur ausdrücklich treffen; im elektronischen Geschäftsverkehr wird sie nur Vertragsbestandteil, wenn der Unternehmer sie nicht durch eine Voreinstellung herbeiführt (§ 312a Abs. 3)";
    label en unofficial "An agreement on payments beyond the main price may be made only expressly; in electronic commerce not by a default setting (§ 312a (3))";
    when zusatzentgelt_vereinbart(vb, v);
    when zusatzentgelt_nicht_ausdruecklich_vereinbart(vb);
    then unwirksam(vb);
}

@source(BGB_P312a)
rule EntgeltFuerZahlungsmittelOhneUnentgeltlicheAlternativeUnwirksam(vb: Vereinbarung, v: Vertrag) strict {
    label de official "Eine Vereinbarung über ein Entgelt für die Nutzung eines bestimmten Zahlungsmittels ist unwirksam, wenn für den Verbraucher keine gängige und zumutbare unentgeltliche Zahlungsmöglichkeit besteht (§ 312a Abs. 4 Nr. 1)";
    label en unofficial "An agreement on a charge for a means of payment is ineffective where the consumer has no common and reasonable free alternative (§ 312a (4) no. 1)";
    when entgelt_fuer_zahlungsmittel_vereinbart(vb, v);
    when keine_unentgeltliche_zahlungsmoeglichkeit(vb);
    then unwirksam(vb);
}

@source(BGB_P312a)
rule EntgeltUeberDenKostenDesZahlungsmittelsUnwirksam(vb: Vereinbarung, v: Vertrag) strict {
    label de official "Eine solche Vereinbarung ist auch unwirksam, wenn das vereinbarte Entgelt über die Kosten hinausgeht, die dem Unternehmer durch die Nutzung des Zahlungsmittels entstehen (§ 312a Abs. 4 Nr. 2)";
    label en unofficial "Such an agreement is also ineffective where the charge exceeds the trader's costs of that means of payment (§ 312a (4) no. 2)";
    when entgelt_fuer_zahlungsmittel_vereinbart(vb, v);
    when entgelt_ueber_den_kosten_des_zahlungsmittels(vb);
    then unwirksam(vb);
}

@source(BGB_P312a)
rule EntgeltFuerKundenhotlineUnwirksam(vb: Vereinbarung, v: Vertrag) strict {
    label de official "Eine Vereinbarung über ein Entgelt für den Anruf bei einer Kundenrufnummer ist unwirksam, wenn das vereinbarte Entgelt das Entgelt für die bloße Nutzung des Telekommunikationsdienstes übersteigt (§ 312a Abs. 5 Satz 1)";
    label en unofficial "An agreement on a charge for calling the trader's customer line is ineffective where it exceeds the mere telecommunications charge (§ 312a (5) sentence 1)";
    when entgelt_fuer_kundenhotline_vereinbart(vb, v);
    when entgelt_ueber_dem_reinen_telekommunikationsentgelt(vb);
    then unwirksam(vb);
}

@source(BGB_P312a)
rule KeinEntgeltGegenueberDemTelekommunikationsanbieter(vb: Vereinbarung, v: Vertrag) strict {
    label de official "Ist eine Vereinbarung nach Satz 1 unwirksam, ist der Verbraucher auch gegenüber dem Anbieter des Telekommunikationsdienstes nicht verpflichtet, ein Entgelt für den Anruf zu zahlen (§ 312a Abs. 5 Satz 2)";
    label en unofficial "Where such an agreement is ineffective the consumer owes no call charge to the provider either (§ 312a (5) sentence 2)";
    when entgelt_fuer_kundenhotline_vereinbart(vb, v);
    when unwirksam(vb);
    then verbraucher_gegenueber_dem_anbieter_nicht_verpflichtet(vb);
}

// --- §§ 312b, 312c Begriffe der besonderen Vertriebsformen -------------------------------------------

pub enum AusserhalbTatbestand {
    label de official "Tatbestand des außerhalb von Geschäftsräumen geschlossenen Vertrags (§ 312b Abs. 1 Satz 1 Nummern 1 bis 4)";
    label en unofficial "case of an off-premises contract (§ 312b (1) sentence 1 nos. 1 to 4)";
    KoerperlicheAnwesenheitAussserhalbDerGeschaeftsraeume,
    AngebotDesVerbrauchersUnterDiesenUmstaenden,
    AbschlussNachPersoenlicherAnspracheAussserhalb,
    AbschlussAufEinemOrganisiertenAusflug
}
pub relation ausserhalb_tatbestand(v: Vertrag, tatbestand: AusserhalbTatbestand) kind empirical {
    label de official "Einer der Tatbestände des § 312b Abs. 1 Satz 1 liegt vor; dem Unternehmer stehen Personen gleich, die in seinem Namen oder Auftrag handeln (Satz 2)";
    label en unofficial "one of the cases of § 312b (1) sentence 1 applies; persons acting for the trader are equivalent to him (sentence 2)";
}
pub relation ausserhalb_von_geschaeftsraeumen_geschlossen(v: Vertrag) kind institutional {
    label de official "Der Vertrag ist ein außerhalb von Geschäftsräumen geschlossener Vertrag (§ 312b Abs. 1)";
    label en unofficial "the contract is an off-premises contract (§ 312b (1))";
}
pub relation ausschliesslich_fernkommunikationsmittel_verwendet(v: Vertrag) kind empirical {
    label de official "Der Unternehmer und der Verbraucher haben für die Vertragsverhandlungen und den Vertragsschluss ausschließlich Fernkommunikationsmittel verwendet (§ 312c Abs. 1)";
    label en unofficial "trader and consumer used exclusively means of distance communication for negotiation and conclusion (§ 312c (1))";
}
pub relation kein_fuer_den_fernabsatz_organisiertes_system(v: Vertrag) kind empirical {
    label de official "Der Vertragsschluss erfolgt nicht im Rahmen eines für den Fernabsatz organisierten Vertriebs- oder Dienstleistungssystems (§ 312c Abs. 1 Halbsatz 2)";
    label en unofficial "the contract is not concluded within a distance selling system organised for that purpose (§ 312c (1))";
}
pub relation fuer_den_fernabsatz_organisiertes_system(v: Vertrag) kind empirical {
    label de official "Der Vertragsschluss erfolgt im Rahmen eines für den Fernabsatz organisierten Vertriebs- oder Dienstleistungssystems (§ 312c Abs. 1) — ausdrückliche Angabe des Falls";
    label en unofficial "the contract is concluded within an organised distance selling system (§ 312c (1)) — explicit case input";
}
pub relation fernabsatzvertrag(v: Vertrag) kind institutional {
    label de official "Der Vertrag ist ein Fernabsatzvertrag (§ 312c Abs. 1)";
    label en unofficial "the contract is a distance contract (§ 312c (1))";
}

@source(BGB_P312b)
rule AusserhalbVonGeschaeftsraeumenGeschlossenerVertrag(v: Vertrag, tatbestand: AusserhalbTatbestand) strict {
    label de official "Außerhalb von Geschäftsräumen geschlossene Verträge sind Verträge, die unter einem der in § 312b Abs. 1 Satz 1 genannten Umstände geschlossen werden; Geschäftsräume sind unbewegliche und bewegliche Gewerberäume im Sinne des Absatzes 2";
    label en unofficial "Off-premises contracts are contracts concluded in one of the circumstances of § 312b (1) sentence 1; business premises are defined in (2)";
    when verbrauchervertrag(v);
    when ausserhalb_tatbestand(v, tatbestand);
    then ausserhalb_von_geschaeftsraeumen_geschlossen(v);
}

@source(BGB_P312c)
rule Fernabsatzvertrag(v: Vertrag) strict {
    label de official "Fernabsatzverträge sind Verträge, bei denen die Parteien für die Vertragsverhandlungen und den Vertragsschluss ausschließlich Fernkommunikationsmittel verwenden, es sei denn, dass der Vertragsschluss nicht im Rahmen eines für den Fernabsatz organisierten Vertriebs- oder Dienstleistungssystems erfolgt (§ 312c Abs. 1); Fernkommunikationsmittel sind alle in Absatz 2 genannten Mittel";
    label en unofficial "Distance contracts are contracts concluded using exclusively means of distance communication, unless outside an organised distance selling system (§ 312c (1), (2))";
    when verbrauchervertrag(v);
    when ausschliesslich_fernkommunikationsmittel_verwendet(v);
    when fuer_den_fernabsatz_organisiertes_system(v);
    then fernabsatzvertrag(v);
}

// --- §§ 312d–312f Informations-, Kosten- und Bestätigungspflichten ------------------------------------

pub relation informationspflicht_nach_246a_erfuellt(v: Vertrag) kind empirical {
    label de official "Der Unternehmer hat den Verbraucher nach Maßgabe des Artikels 246a EGBGB informiert (§ 312d Abs. 1 Satz 1) — Eingang des Falls; der Inhalt der Pflicht steht im EGBGB";
    label en unofficial "the trader informed the consumer as required by Article 246a EGBGB (§ 312d (1) sentence 1) — case input";
}
pub relation informationspflicht_nach_246a_nicht_erfuellt(v: Vertrag) kind empirical {
    label de official "Der Unternehmer hat den Verbraucher nicht nach Maßgabe des Artikels 246a EGBGB informiert (§ 312d Abs. 1, § 312e) — ausdrückliche Angabe des Falls";
    label en unofficial "the trader did not inform the consumer as required by Article 246a EGBGB (§ 312d (1), § 312e) — explicit case input";
}
pub relation angaben_werden_vertragsinhalt(v: Vertrag) kind institutional {
    label de official "Die in Erfüllung der Informationspflicht gemachten Angaben des Unternehmers werden Inhalt des Vertrags, es sei denn, die Vertragsparteien haben ausdrücklich etwas anderes vereinbart (§ 312d Abs. 1 Satz 2)";
    label en unofficial "the information given in performance of that duty becomes part of the contract unless expressly agreed otherwise (§ 312d (1) sentence 2)";
}
pub relation keine_fracht_liefer_und_versandkosten_verlangbar(v: Vertrag) kind institutional {
    label de official "Der Unternehmer kann Fracht-, Liefer- oder Versandkosten und sonstige Kosten nicht verlangen, weil er den Verbraucher darüber nicht entsprechend Artikel 246a § 1 Absatz 1 Satz 1 Nummer 7 EGBGB informiert hat (§ 312e, § 312a Abs. 2 Satz 2)";
    label en unofficial "the trader may not claim freight, delivery, postage or other costs because he did not inform the consumer of them (§ 312e, § 312a (2) sentence 2)";
}
pub relation abschrift_oder_bestaetigung_auf_papier(v: Vertrag) kind empirical {
    label de official "Der Unternehmer hat dem Verbraucher alsbald auf Papier eine unterzeichnete Abschrift des Vertragsdokuments oder eine Bestätigung des Vertrags zur Verfügung gestellt; mit Zustimmung des Verbrauchers genügt ein anderer dauerhafter Datenträger (§ 312f Abs. 1)";
    label en unofficial "the trader provided a signed copy or a confirmation of the contract on paper, or with the consumer's consent on another durable medium (§ 312f (1))";
}
pub relation bestaetigung_des_vertrags_geschuldet(v: Vertrag, unternehmerpartei: Person) kind institutional {
    label de official "Der Unternehmer ist verpflichtet, dem Verbraucher eine Abschrift oder Bestätigung des Vertrags zur Verfügung zu stellen (§ 312f Abs. 1, Abs. 2); bei digitalen Inhalten sind die Zustimmung und die Kenntnisbestätigung festzuhalten (Abs. 3); die Vorschrift gilt nicht für Finanzdienstleistungen (Abs. 4)";
    label en unofficial "the trader must provide a copy or confirmation of the contract (§ 312f (1), (2)); for digital content the consent and confirmation must be recorded ((3)); it does not apply to financial services ((4))";
}

@source(BGB_P312d)
rule AngabenDerInformationspflichtWerdenVertragsinhalt(v: Vertrag) strict {
    label de official "Bei außerhalb von Geschäftsräumen geschlossenen Verträgen und bei Fernabsatzverträgen ist der Unternehmer verpflichtet, den Verbraucher nach Maßgabe des Artikels 246a EGBGB zu informieren; die in Erfüllung dieser Pflicht gemachten Angaben werden Inhalt des Vertrags (§ 312d Abs. 1)";
    label en unofficial "For off-premises and distance contracts the trader must inform the consumer under Article 246a EGBGB; the information given becomes part of the contract (§ 312d (1))";
    when untertitel_anwendbar(v);
    when informationspflicht_nach_246a_erfuellt(v);
    then angaben_werden_vertragsinhalt(v);
}

@source(BGB_P312e)
rule KeineKostenOhneInformation(v: Vertrag) strict {
    label de official "Der Unternehmer kann von dem Verbraucher Fracht-, Liefer- oder Versandkosten und sonstige Kosten nur verlangen, soweit er den Verbraucher über diese Kosten entsprechend den Anforderungen aus § 312d Absatz 1 in Verbindung mit Artikel 246a § 1 Absatz 1 Satz 1 Nummer 7 EGBGB informiert hat (§ 312e)";
    label en unofficial "The trader may claim freight, delivery, postage and other costs only so far as he informed the consumer of them (§ 312e)";
    when untertitel_anwendbar(v);
    when informationspflicht_nach_246a_nicht_erfuellt(v);
    then keine_fracht_liefer_und_versandkosten_verlangbar(v);
}

@source(BGB_P312f)
rule AbschriftUndBestaetigungDesVertrags(v: Vertrag, unternehmerpartei: Person) strict {
    label de official "Bei außerhalb von Geschäftsräumen geschlossenen Verträgen ist der Unternehmer verpflichtet, dem Verbraucher alsbald auf Papier eine Abschrift oder Bestätigung zur Verfügung zu stellen (§ 312f Abs. 1); bei Fernabsatzverträgen eine Bestätigung innerhalb angemessener Frist, spätestens bei der Lieferung (Abs. 2)";
    label en unofficial "For off-premises contracts the trader must promptly provide a paper copy or confirmation (§ 312f (1)); for distance contracts a confirmation within a reasonable period ((2))";
    when untertitel_anwendbar(v);
    when ausserhalb_von_geschaeftsraeumen_geschlossen(v);
    when vertragspartei(v, unternehmerpartei);
    when unternehmer(unternehmerpartei);
    then bestaetigung_des_vertrags_geschuldet(v, unternehmerpartei);
}

// --- § 312g Widerrufsrecht --------------------------------------------------------------------------

pub enum AusnahmeVomWiderrufsrecht {
    label de official "Vertrag, bei dem das Widerrufsrecht nicht besteht (§ 312g Abs. 2 Nummern 1 bis 13, Abs. 3)";
    label en unofficial "contract without a right of withdrawal (§ 312g (2) nos. 1 to 13, (3))";
    NachKundenspezifikationAngefertigteWaren,
    SchnellVerderblicheWaren,
    VersiegelteWarenAusHygienegruenden,
    UntrennbarVermischteWaren,
    AlkoholischeGetraenkeMitMarktabhaengigemWert,
    VersiegelteTonVideoUndSoftware,
    ZeitungenZeitschriftenUndIllustrierte,
    FinanzmarktabhaengigePreise,
    BeherbergungBefoerderungMietwagenFreizeit,
    OeffentlichZugaenglicheVersteigerung,
    DringendeReparaturAufAusdrueckenWunsch,
    WettUndLotteriedienstleistungen,
    NotariellBeurkundeteVertraege,
    WiderrufsrechtBereitsNach495Oder506Bis513,
    WiderrufsrechtNachKapitalanlagegesetzbuch
}
pub relation ausnahme_vom_widerrufsrecht(v: Vertrag, ausnahme: AusnahmeVomWiderrufsrecht) kind empirical {
    label de official "Der Vertrag gehört zu den in § 312g Abs. 2 oder Abs. 3 genannten Verträgen, bei denen das Widerrufsrecht nicht besteht, und die Parteien haben nichts anderes vereinbart";
    label en unofficial "the contract belongs to those in § 312g (2) or (3) without a right of withdrawal, and the parties agreed nothing else";
}
pub relation keine_ausnahme_vom_widerrufsrecht(v: Vertrag) kind empirical {
    label de official "Keine der Ausnahmen des § 312g Abs. 2 und 3 liegt vor — ausdrückliche Angabe des Falls";
    label en unofficial "none of the exceptions of § 312g (2), (3) applies — explicit case input";
}
pub relation kein_widerrufsrecht(v: Vertrag) kind institutional {
    label de official "Das Widerrufsrecht besteht nicht (§ 312g Abs. 2, 3)";
    label en unofficial "there is no right of withdrawal (§ 312g (2), (3))";
}

@source(BGB_P312g)
rule WiderrufsrechtBeiAusserhalbGeschlossenenVertraegen(v: Vertrag, verbraucherpartei: Person) strict {
    label de official "Dem Verbraucher steht bei außerhalb von Geschäftsräumen geschlossenen Verträgen ein Widerrufsrecht gemäß § 355 zu (§ 312g Abs. 1)";
    label en unofficial "For off-premises contracts the consumer has a right of withdrawal under § 355 (§ 312g (1))";
    when untertitel_anwendbar(v);
    when ausserhalb_von_geschaeftsraeumen_geschlossen(v);
    when vertragspartei(v, verbraucherpartei);
    when verbraucher(verbraucherpartei);
    when keine_ausnahme_vom_widerrufsrecht(v);
    then widerrufsrecht_eingeraeumt(v, verbraucherpartei);
}

@source(BGB_P312g)
rule WiderrufsrechtBeiFernabsatzvertraegen(v: Vertrag, verbraucherpartei: Person) strict {
    label de official "Dem Verbraucher steht bei Fernabsatzverträgen ein Widerrufsrecht gemäß § 355 zu (§ 312g Abs. 1)";
    label en unofficial "For distance contracts the consumer has a right of withdrawal under § 355 (§ 312g (1))";
    when untertitel_anwendbar(v);
    when fernabsatzvertrag(v);
    when vertragspartei(v, verbraucherpartei);
    when verbraucher(verbraucherpartei);
    when keine_ausnahme_vom_widerrufsrecht(v);
    then widerrufsrecht_eingeraeumt(v, verbraucherpartei);
}

@source(BGB_P312g)
rule KeinWiderrufsrechtInDenAusnahmefaellen(v: Vertrag, ausnahme: AusnahmeVomWiderrufsrecht) strict {
    label de official "Das Widerrufsrecht besteht, soweit die Parteien nichts anderes vereinbart haben, nicht bei den in § 312g Abs. 2 Nummern 1 bis 13 genannten Verträgen; es besteht ferner nicht in den Fällen des Absatzes 3";
    label en unofficial "Unless otherwise agreed there is no right of withdrawal for the contracts listed in § 312g (2) nos. 1 to 13, nor in the cases of (3)";
    when ausnahme_vom_widerrufsrecht(v, ausnahme);
    then kein_widerrufsrecht(v);
}

// --- §§ 312h–312l Form, elektronischer Geschäftsverkehr, Online-Marktplätze ---------------------------

pub relation ersetzendes_dauerschuldverhaeltnis_mit_kuendigungsauftrag(v: Vertrag, verbraucherpartei: Person) kind empirical {
    label de official "Es wird ein Dauerschuldverhältnis begründet, das ein bestehendes ersetzen soll, und der Verbraucher erklärt die Kündigung des bestehenden Verhältnisses oder bevollmächtigt den Unternehmer dazu (§ 312h)";
    label en unofficial "a continuing obligation replacing an existing one is created and the consumer terminates the old one or authorises the trader to do so (§ 312h)";
}
pub relation kuendigung_oder_vollmacht_bedarf_der_textform(v: Vertrag) kind institutional {
    label de official "Die Kündigung des Verbrauchers oder die Vollmacht zur Kündigung bedarf der Textform (§ 312h)";
    label en unofficial "the consumer's termination or the authority to terminate requires text form (§ 312h)";
}
pub relation vertrag_im_elektronischen_geschaeftsverkehr(v: Vertrag) kind empirical {
    label de official "Der Unternehmer bedient sich zum Zwecke des Vertragsschlusses digitaler Dienste (Vertrag im elektronischen Geschäftsverkehr, § 312i Abs. 1 Satz 1)";
    label en unofficial "the trader uses digital services to conclude the contract (contract in electronic commerce, § 312i (1) sentence 1)";
}
pub relation nur_individuelle_kommunikation(v: Vertrag) kind empirical {
    label de official "Der Vertrag wird ausschließlich durch individuelle Kommunikation geschlossen (§ 312i Abs. 2 Satz 1, § 312j Abs. 5 Satz 1)";
    label en unofficial "the contract is concluded exclusively by individual communication (§ 312i (2), § 312j (5))";
}
pub relation nicht_nur_individuelle_kommunikation(v: Vertrag) kind empirical {
    label de official "Der Vertrag wird nicht ausschließlich durch individuelle Kommunikation geschlossen (§ 312i Abs. 2, § 312j Abs. 5) — ausdrückliche Angabe des Falls";
    label en unofficial "the contract is not concluded exclusively by individual communication (§ 312i (2), § 312j (5)) — explicit case input";
}
pub relation pflichten_im_elektronischen_geschaeftsverkehr(v: Vertrag, unternehmerpartei: Person) kind institutional {
    label de official "Der Unternehmer hat dem Kunden technische Mittel zur Fehlerkorrektur zur Verfügung zu stellen, die Informationen nach Artikel 246c EGBGB mitzuteilen, den Zugang der Bestellung unverzüglich elektronisch zu bestätigen und die Vertragsbestimmungen abrufbar und speicherbar zu machen (§ 312i Abs. 1)";
    label en unofficial "the trader must provide means to correct input errors, give the information under Article 246c EGBGB, acknowledge the order electronically without delay and make the terms retrievable and storable (§ 312i (1))";
}
pub relation bestellschaltflaeche_korrekt_beschriftet(v: Vertrag) kind empirical {
    label de official "Die Bestellung erfolgt über eine Schaltfläche, die gut lesbar mit nichts anderem als den Wörtern „zahlungspflichtig bestellen“ oder einer entsprechenden eindeutigen Formulierung beschriftet ist (§ 312j Abs. 3 Satz 2)";
    label en unofficial "the order button is legibly labelled with nothing other than the words „zahlungspflichtig bestellen“ or an equivalent unambiguous wording (§ 312j (3) sentence 2)";
}
pub relation bestellschaltflaeche_nicht_korrekt_beschriftet(v: Vertrag) kind empirical {
    label de official "Die Bestellschaltfläche ist nicht entsprechend § 312j Abs. 3 Satz 2 beschriftet — ausdrückliche Angabe des Falls";
    label en unofficial "the order button is not labelled as required by § 312j (3) sentence 2 — explicit case input";
}
pub relation vertrag_kommt_nicht_zustande(v: Vertrag) kind institutional {
    label de official "Ein Vertrag nach § 312j Abs. 2 kommt nur zustande, wenn der Unternehmer seine Pflicht aus Absatz 3 erfüllt (§ 312j Abs. 4)";
    label en unofficial "a contract under § 312j (2) comes into existence only if the trader complies with (3) (§ 312j (4))";
}
pub relation vertrag_kommt_zustande(v: Vertrag) kind institutional {
    label de official "Der Vertrag kommt zustande, weil der Unternehmer die Pflicht aus § 312j Abs. 3 erfüllt hat (§ 312j Abs. 4)";
    label en unofficial "the contract comes into existence because the trader complied with § 312j (3) (§ 312j (4))";
}
pub relation dauerschuldverhaeltnis_auf_der_webseite_abschliessbar(v: Vertrag) kind empirical {
    label de official "Verbrauchern wird über eine Webseite ermöglicht, einen Vertrag im elektronischen Geschäftsverkehr zu schließen, der auf die Begründung eines Dauerschuldverhältnisses gerichtet ist, das einen Unternehmer zu einer entgeltlichen Leistung verpflichtet (§ 312k Abs. 1 Satz 1)";
    label en unofficial "consumers can conclude on a website a contract creating a continuing obligation obliging a trader to a performance for consideration (§ 312k (1) sentence 1)";
}
pub relation kuendigungsschaltflaeche_vorhanden_und_beschriftet(v: Vertrag) kind empirical {
    label de official "Der Unternehmer stellt die Kündigungsschaltfläche mit der Beschriftung „Verträge hier kündigen“, die Bestätigungsseite und die Bestätigungsschaltfläche „jetzt kündigen“ ständig verfügbar und leicht zugänglich zur Verfügung (§ 312k Abs. 2)";
    label en unofficial "the trader provides the termination button, the confirmation page and the confirmation button as required (§ 312k (2))";
}
pub relation kuendigungsschaltflaeche_fehlt(v: Vertrag) kind empirical {
    label de official "Die Schaltflächen und die Bestätigungsseite werden nicht entsprechend § 312k Abs. 1 und 2 zur Verfügung gestellt (§ 312k Abs. 6 Satz 1) — ausdrückliche Angabe des Falls";
    label en unofficial "the buttons and the confirmation page are not provided as required (§ 312k (6) sentence 1) — explicit case input";
}
pub relation jederzeit_ohne_frist_kuendbar(v: Vertrag, verbraucherpartei: Person) kind institutional {
    label de official "Der Verbraucher kann den Vertrag jederzeit und ohne Einhaltung einer Kündigungsfrist kündigen; die Möglichkeit zur außerordentlichen Kündigung bleibt unberührt (§ 312k Abs. 6)";
    label en unofficial "the consumer may terminate the contract at any time without a notice period; extraordinary termination remains unaffected (§ 312k (6))";
}
pub relation kuendigungsbestaetigung_geschuldet(v: Vertrag, unternehmerpartei: Person) kind institutional {
    label de official "Der Unternehmer hat dem Verbraucher den Inhalt sowie Datum und Uhrzeit des Zugangs der Kündigungserklärung und den Beendigungszeitpunkt sofort auf elektronischem Wege in Textform zu bestätigen (§ 312k Abs. 4 Satz 1)";
    label en unofficial "the trader must immediately confirm electronically in text form the content, date and time of receipt of the termination and the end date (§ 312k (4) sentence 1)";
}
pub relation kuendigung_ueber_schaltflaeche_abgegeben(v: Vertrag, verbraucherpartei: Person) kind empirical {
    label de official "Der Verbraucher hat die Kündigungserklärung durch Betätigen der Bestätigungsschaltfläche abgegeben (§ 312k Abs. 3, Abs. 4 Satz 2)";
    label en unofficial "the consumer submitted the termination by activating the confirmation button (§ 312k (3), (4) sentence 2)";
}
pub relation kein_beendigungszeitpunkt_angegeben(v: Vertrag) kind empirical {
    label de official "Der Verbraucher gibt bei der Abgabe der Kündigungserklärung keinen Zeitpunkt an, zu dem die Kündigung das Vertragsverhältnis beenden soll (§ 312k Abs. 5)";
    label en unofficial "the consumer does not state a date on which the termination is to end the contract (§ 312k (5))";
}
pub relation kuendigung_wirkt_zum_fruehestmoeglichen_zeitpunkt(v: Vertrag) kind institutional {
    label de official "Die Kündigung wirkt im Zweifel zum frühestmöglichen Zeitpunkt (§ 312k Abs. 5)";
    label en unofficial "in case of doubt the termination takes effect at the earliest possible date (§ 312k (5))";
}
pub relation betreiber_eines_online_marktplatzes(v: Vertrag, betreiber: Person) kind empirical {
    label de official "Der Unternehmer stellt einen Online-Marktplatz für Verbraucher zur Verfügung (§ 312l Abs. 2, 3)";
    label en unofficial "the trader provides an online marketplace for consumers (§ 312l (2), (3))";
}
pub relation informationspflicht_des_marktplatzbetreibers(v: Vertrag, betreiber: Person) kind institutional {
    label de official "Der Betreiber eines Online-Marktplatzes ist verpflichtet, den Verbraucher nach Maßgabe des Artikels 246d EGBGB zu informieren (§ 312l Abs. 1)";
    label en unofficial "the operator of an online marketplace must inform the consumer under Article 246d EGBGB (§ 312l (1))";
}
pub relation abweichung_zum_nachteil_des_verbrauchers_im_untertitel(v: Vertrag) kind empirical {
    label de official "Von den Vorschriften dieses Untertitels wird zum Nachteil des Verbrauchers oder Kunden abgewichen oder sie werden durch anderweitige Gestaltungen umgangen (§ 312m Abs. 1)";
    label en unofficial "the provisions of this sub-title are departed from to the consumer's disadvantage or circumvented (§ 312m (1))";
}
pub relation beweislast_des_unternehmers_fuer_informationspflichten(v: Vertrag, unternehmerpartei: Person) kind institutional {
    label de official "Der Unternehmer trägt gegenüber dem Verbraucher die Beweislast für die Erfüllung der in diesem Untertitel geregelten Informationspflichten (§ 312m Abs. 2)";
    label en unofficial "the trader bears the burden of proving compliance with the information duties of this sub-title (§ 312m (2))";
}

@source(BGB_P312h)
rule TextformFuerKuendigungUndVollmacht(v: Vertrag, verbraucherpartei: Person) strict {
    label de official "Wird ein Dauerschuldverhältnis begründet, das ein bestehendes ersetzen soll, und erklärt der Verbraucher dabei die Kündigung des bestehenden Verhältnisses oder bevollmächtigt er den Unternehmer dazu, so bedarf die Kündigung oder die Vollmacht der Textform (§ 312h)";
    label en unofficial "Where a replacing continuing obligation is created and the consumer terminates the old one or grants authority to do so, text form is required (§ 312h)";
    when ersetzendes_dauerschuldverhaeltnis_mit_kuendigungsauftrag(v, verbraucherpartei);
    then kuendigung_oder_vollmacht_bedarf_der_textform(v);
}

@source(BGB_P312i)
rule AllgemeinePflichtenImElektronischenGeschaeftsverkehr(v: Vertrag, unternehmerpartei: Person) strict {
    label de official "Bedient sich ein Unternehmer zum Zwecke des Abschlusses eines Vertrags digitaler Dienste, hat er dem Kunden die in § 312i Abs. 1 Satz 1 Nummern 1 bis 4 genannten Mittel, Informationen und Möglichkeiten zu verschaffen; Nummern 1 bis 3 gelten nicht bei ausschließlich individueller Kommunikation (Abs. 2)";
    label en unofficial "Where a trader uses digital services to conclude a contract he must provide the means, information and possibilities of § 312i (1); nos. 1 to 3 do not apply to purely individual communication ((2))";
    when vertrag_im_elektronischen_geschaeftsverkehr(v);
    when nicht_nur_individuelle_kommunikation(v);
    when vertragspartei(v, unternehmerpartei);
    when unternehmer(unternehmerpartei);
    then pflichten_im_elektronischen_geschaeftsverkehr(v, unternehmerpartei);
}

@source(BGB_P312j)
rule VertragKommtOhneKorrekteBestellschaltflaecheNichtZustande(v: Vertrag) strict {
    label de official "Der Unternehmer hat die Bestellsituation so zu gestalten, dass der Verbraucher mit seiner Bestellung ausdrücklich bestätigt, dass er sich zu einer Zahlung verpflichtet; erfolgt die Bestellung über eine Schaltfläche, ist die Pflicht nur erfüllt, wenn diese gut lesbar mit nichts anderem als den Wörtern „zahlungspflichtig bestellen“ beschriftet ist (§ 312j Abs. 3); ein Vertrag nach Absatz 2 kommt nur zustande, wenn der Unternehmer diese Pflicht erfüllt (Abs. 4)";
    label en unofficial "The order situation must make the consumer expressly confirm his payment obligation; an order button must be labelled „zahlungspflichtig bestellen“ (§ 312j (3)); otherwise the contract does not come into existence ((4))";
    when vertrag_im_elektronischen_geschaeftsverkehr(v);
    when verbraucher_zur_zahlung_eines_preises_verpflichtet(v);
    when nicht_nur_individuelle_kommunikation(v);
    when bestellschaltflaeche_nicht_korrekt_beschriftet(v);
    then vertrag_kommt_nicht_zustande(v);
}

@source(BGB_P312j)
rule VertragKommtMitKorrekterBestellschaltflaecheZustande(v: Vertrag) strict {
    label de official "Ein Vertrag nach § 312j Abs. 2 kommt zustande, wenn der Unternehmer seine Pflicht aus Absatz 3 erfüllt (Abs. 4)";
    label en unofficial "A contract under § 312j (2) comes into existence where the trader complies with (3) ((4))";
    when vertrag_im_elektronischen_geschaeftsverkehr(v);
    when verbraucher_zur_zahlung_eines_preises_verpflichtet(v);
    when nicht_nur_individuelle_kommunikation(v);
    when bestellschaltflaeche_korrekt_beschriftet(v);
    then vertrag_kommt_zustande(v);
}

@source(BGB_P312k)
rule KuendigungsschaltflaechenpflichtUndFolgeIhresFehlens(v: Vertrag, verbraucherpartei: Person) strict {
    label de official "Werden die Schaltflächen und die Bestätigungsseite nicht entsprechend den Absätzen 1 und 2 zur Verfügung gestellt, kann ein Verbraucher den Vertrag jederzeit und ohne Einhaltung einer Kündigungsfrist kündigen (§ 312k Abs. 6 Satz 1)";
    label en unofficial "Where the buttons and confirmation page are not provided as required, the consumer may terminate at any time without a notice period (§ 312k (6) sentence 1)";
    when dauerschuldverhaeltnis_auf_der_webseite_abschliessbar(v);
    when kuendigungsschaltflaeche_fehlt(v);
    when vertragspartei(v, verbraucherpartei);
    when verbraucher(verbraucherpartei);
    then jederzeit_ohne_frist_kuendbar(v, verbraucherpartei);
}

@source(BGB_P312k)
rule BestaetigungDerKuendigung(v: Vertrag, verbraucherpartei: Person, unternehmerpartei: Person) strict {
    label de official "Der Unternehmer hat dem Verbraucher den Inhalt sowie Datum und Uhrzeit des Zugangs der Kündigungserklärung sowie den Beendigungszeitpunkt sofort auf elektronischem Wege in Textform zu bestätigen; es wird vermutet, dass die Kündigungserklärung unmittelbar nach ihrer Abgabe zugegangen ist (§ 312k Abs. 4)";
    label en unofficial "The trader must immediately confirm the content, date and time of receipt and the end date electronically in text form; receipt immediately after submission is presumed (§ 312k (4))";
    when dauerschuldverhaeltnis_auf_der_webseite_abschliessbar(v);
    when kuendigung_ueber_schaltflaeche_abgegeben(v, verbraucherpartei);
    when vertragspartei(v, unternehmerpartei);
    when unternehmer(unternehmerpartei);
    then kuendigungsbestaetigung_geschuldet(v, unternehmerpartei);
}

@source(BGB_P312k)
rule KuendigungOhneZeitpunktWirktZumFruehestmoeglichenZeitpunkt(v: Vertrag, verbraucherpartei: Person) strict {
    label de official "Wenn der Verbraucher bei der Abgabe der Kündigungserklärung keinen Zeitpunkt angibt, zu dem die Kündigung das Vertragsverhältnis beenden soll, wirkt die Kündigung im Zweifel zum frühestmöglichen Zeitpunkt (§ 312k Abs. 5)";
    label en unofficial "Where the consumer states no end date, the termination takes effect in case of doubt at the earliest possible date (§ 312k (5))";
    when kuendigung_ueber_schaltflaeche_abgegeben(v, verbraucherpartei);
    when kein_beendigungszeitpunkt_angegeben(v);
    then kuendigung_wirkt_zum_fruehestmoeglichen_zeitpunkt(v);
}

@source(BGB_P312l)
rule InformationspflichtDesMarktplatzbetreibers(v: Vertrag, betreiber: Person) strict {
    label de official "Der Betreiber eines Online-Marktplatzes ist verpflichtet, den Verbraucher nach Maßgabe des Artikels 246d EGBGB zu informieren (§ 312l Abs. 1); Online-Marktplatz und Betreiber sind in den Absätzen 2 und 3 bestimmt";
    label en unofficial "The operator of an online marketplace must inform the consumer under Article 246d EGBGB (§ 312l (1)); (2) and (3) define marketplace and operator";
    when betreiber_eines_online_marktplatzes(v, betreiber);
    then informationspflicht_des_marktplatzbetreibers(v, betreiber);
}

@source(BGB_P312m)
rule AbweichungZumNachteilDesVerbrauchersUnzulaessig(v: Vertrag) strict {
    label de official "Von den Vorschriften dieses Untertitels darf, soweit nichts anderes bestimmt ist, nicht zum Nachteil des Verbrauchers oder Kunden abgewichen werden; sie finden auch Anwendung, wenn sie durch anderweitige Gestaltungen umgangen werden (§ 312m Abs. 1)";
    label en unofficial "No departure from this sub-title to the disadvantage of the consumer is permitted; it also applies in case of circumvention (§ 312m (1))";
    when abweichung_zum_nachteil_des_verbrauchers_im_untertitel(v);
    then abweichung_unwirksam(v);
}

@source(BGB_P312m)
rule BeweislastDesUnternehmersFuerInformationspflichten(v: Vertrag, unternehmerpartei: Person) strict {
    label de official "Der Unternehmer trägt gegenüber dem Verbraucher die Beweislast für die Erfüllung der in diesem Untertitel geregelten Informationspflichten (§ 312m Abs. 2)";
    label en unofficial "The trader bears the burden of proving compliance with the information duties of this sub-title (§ 312m (2))";
    when untertitel_anwendbar(v);
    when vertragspartei(v, unternehmerpartei);
    when unternehmer(unternehmerpartei);
    then beweislast_des_unternehmers_fuer_informationspflichten(v, unternehmerpartei);
}
