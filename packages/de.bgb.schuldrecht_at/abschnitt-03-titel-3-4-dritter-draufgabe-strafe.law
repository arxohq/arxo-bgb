// ABSCHNITT 3 TITEL 3 VERSPRECHEN DER LEISTUNG AN EINEN DRITTEN (§§ 328–335)
// UND TITEL 4 DRAUFGABE, VERTRAGSSTRAFE (§§ 336–345)
//
// ZWEIFELSREGELN DES TEXTES sind Regeln mit ausdrücklicher Verneinung: § 329
// („im Zweifel nicht anzunehmen“), § 330, § 331 Abs. 1, § 335, § 336 Abs. 2,
// § 337 Abs. 1, § 338 Satz 2. Der Fall sagt, dass kein anderer Wille bestimmt
// ist; das Schweigen des Falls sagt es nicht.
//
// WERTUNG DES GERICHTS: die unverhältnismäßig hohe Strafe und der angemessene
// Betrag der Herabsetzung (§ 343 Abs. 1) — Kanal §47.3; der Betrag kommt vom
// Gericht, nicht aus einer Formel des Pakets.

language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";

// --- §§ 328–335 Vertrag zugunsten Dritter -----------------------------------------------------------

pub relation leistung_an_einen_dritten_bedungen(v: Vertrag, dritter: Person) kind empirical {
    label de official "Durch Vertrag ist eine Leistung an einen Dritten bedungen (§ 328 Abs. 1)";
    label en unofficial "a performance to a third party is stipulated by contract (§ 328 (1))";
}
pub relation recht_des_dritten_bestimmt(v: Vertrag, dritter: Person) kind empirical {
    label de official "Nach besonderer Bestimmung oder nach den Umständen, insbesondere dem Zwecke des Vertrags, soll der Dritte das Recht erwerben (§ 328 Abs. 1, 2)";
    label en unofficial "by special stipulation or from the circumstances the third party is to acquire the right (§ 328 (1), (2))";
}
pub relation dritter_erwirbt_das_recht(v: Vertrag, dritter: Person) kind institutional {
    label de official "Der Dritte erwirbt unmittelbar das Recht, die Leistung zu fordern (§ 328 Abs. 1)";
    label en unofficial "the third party directly acquires the right to demand performance (§ 328 (1))";
}
pub relation erfuellungsuebernahme_ohne_schulduebernahme(v: Vertrag, glaeubiger: Person) kind empirical {
    label de official "Ein Teil verpflichtet sich zur Befriedigung eines Gläubigers des anderen Teils, ohne die Schuld zu übernehmen (§ 329)";
    label en unofficial "one party undertakes to satisfy a creditor of the other without assuming the debt (§ 329)";
}
pub relation kein_unmittelbares_recht_des_glaeubigers(v: Vertrag, glaeubiger: Person) kind institutional {
    label de official "Im Zweifel ist nicht anzunehmen, dass der Gläubiger unmittelbar das Recht erwerben soll, die Befriedigung zu fordern (§ 329)";
    label en unofficial "in case of doubt the creditor is not to acquire a direct right to demand satisfaction (§ 329)";
}
pub relation leibrentenvertrag_mit_zahlung_an_dritten(v: Vertrag, dritter: Person) kind empirical {
    label de official "In einem Leibrentenvertrag ist die Zahlung der Leibrente an einen Dritten vereinbart, oder bei einer unentgeltlichen Zuwendung beziehungsweise Vermögensübernahme ist eine Leistung an einen Dritten auferlegt oder versprochen (§ 330)";
    label en unofficial "payment of a life annuity to a third party is agreed, or a performance to a third party is imposed or promised under § 330";
}
pub relation leistung_nach_dem_tode_des_versprechensempfaengers(v: Vertrag, dritter: Person) kind empirical {
    label de official "Die Leistung an den Dritten soll nach dem Tode desjenigen erfolgen, welchem sie versprochen wird (§ 331 Abs. 1)";
    label en unofficial "the performance to the third party is to be made after the death of the promisee (§ 331 (1))";
}
pub relation tod_des_versprechensempfaengers_am(v: Vertrag, tag: Date) kind empirical {
    key(v);
    label de official "Tag des Todes des Versprechensempfängers (§ 331 Abs. 1)";
    label en unofficial "day of the promisee's death (§ 331 (1))";
}
pub relation recht_erworben_am(v: Vertrag, dritter: Person, tag: Date) kind institutional {
    key(v, dritter);
    label de official "Tag, mit dem der Dritte das Recht auf die Leistung erwirbt (§ 331 Abs. 1)";
    label en unofficial "day on which the third party acquires the right to the performance (§ 331 (1))";
}
pub relation aenderungsbefugnis_vorbehalten(v: Vertrag) kind empirical {
    label de official "Dem Versprechensempfänger ist die Befugnis vorbehalten, ohne Zustimmung des Versprechenden an die Stelle des bezeichneten Dritten einen anderen zu setzen oder das Recht aufzuheben oder zu ändern (§ 328 Abs. 2, § 331 Abs. 2, § 332)";
    label en unofficial "the promisee reserved the power to substitute another third party or to revoke or alter the right (§ 328 (2), § 331 (2), § 332)";
}
pub relation aenderung_durch_verfuegung_von_todes_wegen_moeglich(v: Vertrag) kind institutional {
    label de official "Hat sich der Versprechensempfänger diese Befugnis vorbehalten, so kann die Ersetzung im Zweifel auch in einer Verfügung von Todes wegen geschehen (§ 332)";
    label en unofficial "where the promisee reserved that power, the substitution may in case of doubt also be made by a disposition mortis causa (§ 332)";
}
pub relation recht_vom_dritten_zurueckgewiesen(v: Vertrag, dritter: Person) kind empirical {
    label de official "Der Dritte weist das aus dem Vertrag erworbene Recht dem Versprechenden gegenüber zurück (§ 333)";
    label en unofficial "the third party rejects the right acquired under the contract towards the promisor (§ 333)";
}
pub relation recht_gilt_als_nicht_erworben(v: Vertrag, dritter: Person) kind institutional {
    label de official "Das Recht gilt als nicht erworben (§ 333)";
    label en unofficial "the right is deemed not to have been acquired (§ 333)";
}
pub relation einwendung_aus_dem_vertrag(v: Vertrag) kind empirical {
    label de official "Dem Versprechenden stehen Einwendungen aus dem Vertrag zu (§ 334)";
    label en unofficial "the promisor has defences arising from the contract (§ 334)";
}
pub relation einwendung_auch_gegen_den_dritten(v: Vertrag, dritter: Person) kind institutional {
    label de official "Einwendungen aus dem Vertrag stehen dem Versprechenden auch gegenüber dem Dritten zu (§ 334)";
    label en unofficial "the promisor may raise the contractual defences also against the third party (§ 334)";
}
pub relation kein_abweichender_wille_der_vertragschliessenden(v: Vertrag) kind empirical {
    label de official "Ein anderer Wille der Vertragschließenden ist nicht anzunehmen (§ 335, § 329, § 330, § 331 Abs. 1) — ausdrückliche Angabe des Falls";
    label en unofficial "no different intention of the contracting parties is to be assumed (§ 335, § 329, § 330, § 331 (1)) — explicit case input";
}
pub relation versprechensempfaenger_kann_leistung_an_den_dritten_fordern(v: Vertrag, empfaenger: Person) kind institutional {
    label de official "Der Versprechensempfänger kann die Leistung an den Dritten auch dann fordern, wenn diesem das Recht auf die Leistung zusteht (§ 335)";
    label en unofficial "the promisee may demand performance to the third party even where the latter is entitled to it (§ 335)";
}

@source(BGB_P328)
rule DritterErwirbtDasRechtUnmittelbar(v: Vertrag, dritter: Person) strict {
    label de official "Durch Vertrag kann eine Leistung an einen Dritten mit der Wirkung bedungen werden, dass der Dritte unmittelbar das Recht erwirbt, die Leistung zu fordern (§ 328 Abs. 1); in Ermangelung einer besonderen Bestimmung ist aus den Umständen, insbesondere aus dem Zwecke des Vertrags, zu entnehmen, ob der Dritte das Recht erwerben soll (Abs. 2)";
    label en unofficial "A contract may stipulate performance to a third party such that he directly acquires the right to demand it (§ 328 (1)); absent a special stipulation the circumstances decide ((2))";
    when leistung_an_einen_dritten_bedungen(v, dritter);
    when recht_des_dritten_bestimmt(v, dritter);
    then dritter_erwirbt_das_recht(v, dritter);
}

@source(BGB_P329)
rule ErfuellungsuebernahmeGibtKeinUnmittelbaresRecht(v: Vertrag, glaeubiger: Person) strict {
    label de official "Verpflichtet sich in einem Vertrag der eine Teil zur Befriedigung eines Gläubigers des anderen Teils, ohne die Schuld zu übernehmen, so ist im Zweifel nicht anzunehmen, dass der Gläubiger unmittelbar das Recht erwerben soll, die Befriedigung von ihm zu fordern (§ 329)";
    label en unofficial "Where a party undertakes to satisfy a creditor of the other without assuming the debt, in case of doubt the creditor acquires no direct right (§ 329)";
    when erfuellungsuebernahme_ohne_schulduebernahme(v, glaeubiger);
    when kein_abweichender_wille_der_vertragschliessenden(v);
    then kein_unmittelbares_recht_des_glaeubigers(v, glaeubiger);
}

@source(BGB_P330)
rule AuslegungsregelBeimLeibrentenvertrag(v: Vertrag, dritter: Person) strict {
    label de official "Wird in einem Leibrentenvertrag die Zahlung der Leibrente an einen Dritten vereinbart, ist im Zweifel anzunehmen, dass der Dritte unmittelbar das Recht erwerben soll, die Leistung zu fordern; das Gleiche gilt bei unentgeltlicher Zuwendung und Vermögensübernahme (§ 330)";
    label en unofficial "Where a life annuity is to be paid to a third party, in case of doubt he directly acquires the right to demand it; the same applies under § 330 sentence 2";
    when leibrentenvertrag_mit_zahlung_an_dritten(v, dritter);
    when kein_abweichender_wille_der_vertragschliessenden(v);
    then dritter_erwirbt_das_recht(v, dritter);
}

@source(BGB_P331)
rule RechtserwerbMitDemTodeDesVersprechensempfaengers(v: Vertrag, dritter: Person, tag: Date) strict {
    label de official "Soll die Leistung an den Dritten nach dem Tode desjenigen erfolgen, welchem sie versprochen wird, so erwirbt der Dritte das Recht auf die Leistung im Zweifel mit dem Tode des Versprechensempfängers (§ 331 Abs. 1)";
    label en unofficial "Where performance to the third party is to be made after the promisee's death, he acquires the right in case of doubt upon that death (§ 331 (1))";
    when leistung_nach_dem_tode_des_versprechensempfaengers(v, dritter);
    when tod_des_versprechensempfaengers_am(v, tag);
    when kein_abweichender_wille_der_vertragschliessenden(v);
    then recht_erworben_am(v, dritter, tag);
}

@source(BGB_P332)
rule ErsetzungDesDrittenDurchVerfuegungVonTodesWegen(v: Vertrag) strict {
    label de official "Hat sich der Versprechensempfänger die Befugnis vorbehalten, ohne Zustimmung des Versprechenden an die Stelle des bezeichneten Dritten einen anderen zu setzen, so kann dies im Zweifel auch in einer Verfügung von Todes wegen geschehen (§ 332)";
    label en unofficial "Where the promisee reserved the power to substitute another third party, this may in case of doubt also be done by disposition mortis causa (§ 332)";
    when aenderungsbefugnis_vorbehalten(v);
    then aenderung_durch_verfuegung_von_todes_wegen_moeglich(v);
}

@source(BGB_P333)
rule ZurueckweisungDesRechtsDurchDenDritten(v: Vertrag, dritter: Person) strict {
    label de official "Weist der Dritte das aus dem Vertrag erworbene Recht dem Versprechenden gegenüber zurück, so gilt das Recht als nicht erworben (§ 333)";
    label en unofficial "If the third party rejects the right towards the promisor, it is deemed not to have been acquired (§ 333)";
    when recht_vom_dritten_zurueckgewiesen(v, dritter);
    then recht_gilt_als_nicht_erworben(v, dritter);
}

@source(BGB_P334)
rule EinwendungenAuchGegenDenDritten(v: Vertrag, dritter: Person) strict {
    label de official "Einwendungen aus dem Vertrag stehen dem Versprechenden auch gegenüber dem Dritten zu (§ 334)";
    label en unofficial "The promisor may raise the contractual defences also against the third party (§ 334)";
    when dritter_erwirbt_das_recht(v, dritter);
    when einwendung_aus_dem_vertrag(v);
    then einwendung_auch_gegen_den_dritten(v, dritter);
}

@source(BGB_P335)
rule ForderungsrechtDesVersprechensempfaengers(v: Vertrag, dritter: Person, empfaenger: Person) strict {
    label de official "Der Versprechensempfänger kann, sofern nicht ein anderer Wille der Vertragschließenden anzunehmen ist, die Leistung an den Dritten auch dann fordern, wenn diesem das Recht auf die Leistung zusteht (§ 335)";
    label en unofficial "The promisee may, unless a different intention is to be assumed, demand performance to the third party even where the latter is entitled (§ 335)";
    when dritter_erwirbt_das_recht(v, dritter);
    when vertragspartei(v, empfaenger);
    when kein_abweichender_wille_der_vertragschliessenden(v);
    then versprechensempfaenger_kann_leistung_an_den_dritten_fordern(v, empfaenger);
}

// --- §§ 336–338 Draufgabe -----------------------------------------------------------------------------

pub relation draufgabe_gegeben(v: Vertrag, geber: Person, betrag: Money) kind empirical {
    key(v);
    label de official "Bei der Eingehung eines Vertrags ist etwas als Draufgabe gegeben worden (§ 336 Abs. 1)";
    label en unofficial "something was given as earnest on conclusion of the contract (§ 336 (1))";
}
pub relation zeichen_des_abschlusses_des_vertrags(v: Vertrag) kind institutional {
    label de official "Die Draufgabe gilt als Zeichen des Abschlusses des Vertrags (§ 336 Abs. 1); im Zweifel nicht als Reugeld (Abs. 2)";
    label en unofficial "the earnest counts as a sign of the conclusion of the contract (§ 336 (1)); in case of doubt not as forfeit money ((2))";
}
pub relation draufgabe_gilt_nicht_als_reugeld(v: Vertrag) kind institutional {
    label de official "Die Draufgabe gilt im Zweifel nicht als Reugeld (§ 336 Abs. 2)";
    label en unofficial "in case of doubt the earnest does not count as forfeit money (§ 336 (2))";
}
pub relation anrechnung_der_draufgabe(v: Vertrag, betrag: Money) kind institutional {
    key(v);
    label de official "Die Draufgabe ist im Zweifel auf die von dem Geber geschuldete Leistung anzurechnen oder, wenn dies nicht geschehen kann, bei der Erfüllung des Vertrags zurückzugeben (§ 337 Abs. 1)";
    label en unofficial "in case of doubt the earnest is credited against the giver's performance or returned on performance of the contract (§ 337 (1))";
}
pub relation vertrag_wieder_aufgehoben(v: Vertrag) kind empirical {
    label de official "Der Vertrag ist wieder aufgehoben worden (§ 337 Abs. 2)";
    label en unofficial "the contract has been rescinded (§ 337 (2))";
}
pub relation draufgabe_zurueckzugeben(v: Vertrag, betrag: Money) kind institutional {
    key(v);
    label de official "Die Draufgabe ist zurückzugeben (§ 337 Abs. 2)";
    label en unofficial "the earnest must be returned (§ 337 (2))";
}
pub relation unmoeglichkeit_oder_aufhebung_vom_geber_zu_vertreten(v: Vertrag, geber: Person) kind empirical {
    label de official "Die von dem Geber geschuldete Leistung wird infolge eines von ihm zu vertretenden Umstands unmöglich oder der Geber verschuldet die Wiederaufhebung des Vertrags (§ 338 Satz 1)";
    label en unofficial "the giver's performance becomes impossible through a circumstance for which he is responsible, or he causes the rescission (§ 338 sentence 1)";
}
pub relation draufgabe_darf_behalten_werden(v: Vertrag, empfaenger: Person) kind institutional {
    label de official "Der Empfänger ist berechtigt, die Draufgabe zu behalten (§ 338 Satz 1)";
    label en unofficial "the recipient is entitled to keep the earnest (§ 338 sentence 1)";
}

@source(BGB_P336)
rule DraufgabeIstZeichenDesVertragsschlusses(v: Vertrag, geber: Person, betrag: Money) strict {
    label de official "Wird bei der Eingehung eines Vertrags etwas als Draufgabe gegeben, so gilt dies als Zeichen des Abschlusses des Vertrags (§ 336 Abs. 1)";
    label en unofficial "Where something is given as earnest on conclusion of a contract, this counts as a sign of its conclusion (§ 336 (1))";
    when draufgabe_gegeben(v, geber, betrag);
    then zeichen_des_abschlusses_des_vertrags(v);
}

@source(BGB_P336)
rule DraufgabeIstKeinReugeld(v: Vertrag, geber: Person, betrag: Money) strict {
    label de official "Die Draufgabe gilt im Zweifel nicht als Reugeld (§ 336 Abs. 2)";
    label en unofficial "In case of doubt the earnest does not count as forfeit money (§ 336 (2))";
    when draufgabe_gegeben(v, geber, betrag);
    when kein_abweichender_wille_der_vertragschliessenden(v);
    then draufgabe_gilt_nicht_als_reugeld(v);
}

@source(BGB_P337)
rule AnrechnungDerDraufgabe(v: Vertrag, geber: Person, betrag: Money) strict {
    label de official "Die Draufgabe ist im Zweifel auf die von dem Geber geschuldete Leistung anzurechnen oder, wenn dies nicht geschehen kann, bei der Erfüllung des Vertrags zurückzugeben (§ 337 Abs. 1)";
    label en unofficial "In case of doubt the earnest is credited against the giver's performance or returned upon performance (§ 337 (1))";
    when draufgabe_gegeben(v, geber, betrag);
    when kein_abweichender_wille_der_vertragschliessenden(v);
    then anrechnung_der_draufgabe(v, betrag);
}

@source(BGB_P337)
rule RueckgabeDerDraufgabeNachAufhebung(v: Vertrag, geber: Person, betrag: Money) strict {
    label de official "Wird der Vertrag wieder aufgehoben, so ist die Draufgabe zurückzugeben (§ 337 Abs. 2)";
    label en unofficial "If the contract is rescinded the earnest must be returned (§ 337 (2))";
    when draufgabe_gegeben(v, geber, betrag);
    when vertrag_wieder_aufgehoben(v);
    then draufgabe_zurueckzugeben(v, betrag);
}

@source(BGB_P338)
rule EmpfaengerDarfDieDraufgabeBehalten(v: Vertrag, geber: Person, empfaenger: Person, betrag: Money) strict {
    label de official "Wird die von dem Geber geschuldete Leistung infolge eines Umstands, den er zu vertreten hat, unmöglich oder verschuldet der Geber die Wiederaufhebung des Vertrags, so ist der Empfänger berechtigt, die Draufgabe zu behalten (§ 338 Satz 1)";
    label en unofficial "Where the giver's performance becomes impossible through his fault or he causes the rescission, the recipient may keep the earnest (§ 338 sentence 1)";
    when draufgabe_gegeben(v, geber, betrag);
    when unmoeglichkeit_oder_aufhebung_vom_geber_zu_vertreten(v, geber);
    when vertragspartei(v, empfaenger);
    then draufgabe_darf_behalten_werden(v, empfaenger);
}

// --- §§ 339–345 Vertragsstrafe ---------------------------------------------------------------------------

pub relation strafversprechen_fuer_nichterfuellung(s: Schuldverhaeltnis, betrag: Money) kind empirical {
    key(s);
    label de official "Der Schuldner verspricht dem Gläubiger für den Fall, dass er seine Verbindlichkeit nicht erfüllt, die Zahlung einer Geldsumme als Strafe (§ 339 Satz 1, § 340 Abs. 1)";
    label en unofficial "the debtor promises a sum of money as a penalty for non-performance (§ 339 sentence 1, § 340 (1))";
}
pub relation strafversprechen_fuer_nicht_gehoerige_erfuellung(s: Schuldverhaeltnis, betrag: Money) kind empirical {
    key(s);
    label de official "Der Schuldner verspricht die Strafe für den Fall, dass er seine Verbindlichkeit nicht in gehöriger Weise, insbesondere nicht zu der bestimmten Zeit, erfüllt (§ 341 Abs. 1)";
    label en unofficial "the debtor promises the penalty for performance not rendered properly, in particular not on time (§ 341 (1))";
}
pub relation geschuldete_leistung_ist_ein_unterlassen(s: Schuldverhaeltnis) kind empirical {
    label de official "Die geschuldete Leistung besteht in einem Unterlassen (§ 339 Satz 2, § 345)";
    label en unofficial "the performance owed consists in forbearance (§ 339 sentence 2, § 345)";
}
pub relation zuwiderhandlung(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Schuldner hat der Unterlassungspflicht zuwidergehandelt (§ 339 Satz 2)";
    label en unofficial "the debtor acted contrary to the duty of forbearance (§ 339 sentence 2)";
}
pub relation strafe_verwirkt(s: Schuldverhaeltnis, betrag: Money) kind institutional {
    key(s);
    label de official "Die Strafe ist verwirkt (§ 339)";
    label en unofficial "the penalty is forfeited (§ 339)";
}
pub relation strafe_statt_der_erfuellung_verlangt(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Gläubiger erklärt dem Schuldner, dass er die Strafe verlange (§ 340 Abs. 1 Satz 2)";
    label en unofficial "the creditor declares that he demands the penalty (§ 340 (1) sentence 2)";
}
pub relation erfuellungsanspruch_ausgeschlossen(s: Schuldverhaeltnis) kind institutional {
    label de official "Der Anspruch auf Erfüllung ist ausgeschlossen (§ 340 Abs. 1 Satz 2)";
    label en unofficial "the claim to performance is excluded (§ 340 (1) sentence 2)";
}
pub relation strafe_als_mindestbetrag_des_schadens(s: Schuldverhaeltnis, betrag: Money) kind institutional {
    key(s);
    label de official "Steht dem Gläubiger ein Anspruch auf Schadensersatz wegen Nichterfüllung zu, so kann er die verwirkte Strafe als Mindestbetrag des Schadens verlangen; die Geltendmachung eines weiteren Schadens ist nicht ausgeschlossen (§ 340 Abs. 2)";
    label en unofficial "where the creditor has a claim for damages for non-performance he may claim the forfeited penalty as the minimum damage; further damage may still be asserted (§ 340 (2))";
}
pub relation strafe_neben_der_erfuellung_verlangbar(s: Schuldverhaeltnis, betrag: Money) kind institutional {
    key(s);
    label de official "Der Gläubiger kann die verwirkte Strafe neben der Erfüllung verlangen (§ 341 Abs. 1)";
    label en unofficial "the creditor may claim the forfeited penalty in addition to performance (§ 341 (1))";
}
pub relation erfuellung_angenommen_mit_vorbehalt(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Gläubiger hat sich bei der Annahme der Erfüllung das Recht vorbehalten, die Strafe zu verlangen (§ 341 Abs. 3)";
    label en unofficial "on accepting performance the creditor reserved the right to claim the penalty (§ 341 (3))";
}
pub relation andere_strafleistung_als_geld(s: Schuldverhaeltnis) kind empirical {
    label de official "Als Strafe ist eine andere Leistung als die Zahlung einer Geldsumme versprochen (§ 342)";
    label en unofficial "a performance other than a sum of money is promised as a penalty (§ 342)";
}
pub relation schadensersatzanspruch_ausgeschlossen(s: Schuldverhaeltnis) kind institutional {
    label de official "Der Anspruch auf Schadensersatz ist ausgeschlossen, wenn der Gläubiger die Strafe verlangt (§ 342)";
    label en unofficial "the claim for damages is excluded where the creditor demands the penalty (§ 342)";
}
@source(BGB_P343)
pub external judgment relation angemessener_betrag_der_strafe(s: Schuldverhaeltnis, betrag: Money) {
    authority Court;
    label de official "§ 343 Abs. 1. Das Gericht hat festgestellt, dass die verwirkte Strafe unverhältnismäßig hoch ist, und sie auf Antrag des Schuldners durch Urteil auf diesen angemessenen Betrag herabgesetzt; bei der Beurteilung ist jedes berechtigte Interesse des Gläubigers, nicht bloß das Vermögensinteresse, zu berücksichtigen (Satz 2)";
    label en unofficial "§ 343 (1). The court found the forfeited penalty disproportionately high and reduced it by judgment to this reasonable amount, taking into account every legitimate interest of the creditor (sentence 2)";
}
pub relation strafe_entrichtet(s: Schuldverhaeltnis) kind empirical {
    label de official "Die Strafe ist entrichtet worden; nach der Entrichtung ist die Herabsetzung ausgeschlossen (§ 343 Abs. 1 Satz 3)";
    label en unofficial "the penalty has been paid; after payment a reduction is excluded (§ 343 (1) sentence 3)";
}
pub relation strafe_nicht_entrichtet(s: Schuldverhaeltnis) kind empirical {
    label de official "Die Strafe ist noch nicht entrichtet (§ 343 Abs. 1 Satz 3) — ausdrückliche Angabe des Falls";
    label en unofficial "the penalty has not yet been paid (§ 343 (1) sentence 3) — explicit case input";
}
pub relation herabgesetzte_strafe(s: Schuldverhaeltnis, betrag: Money) kind institutional {
    key(s);
    label de official "Auf den angemessenen Betrag herabgesetzte Strafe (§ 343 Abs. 1)";
    label en unofficial "penalty reduced to the reasonable amount (§ 343 (1))";
}
pub relation versprechen_der_hauptleistung_unwirksam(s: Schuldverhaeltnis) kind empirical {
    label de official "Das Gesetz erklärt das Versprechen der Leistung für unwirksam (§ 344)";
    label en unofficial "the law declares the promise of the performance ineffective (§ 344)";
}
pub relation strafvereinbarung_unwirksam(s: Schuldverhaeltnis) kind institutional {
    label de official "Auch die für den Fall der Nichterfüllung des Versprechens getroffene Vereinbarung einer Strafe ist unwirksam, selbst wenn die Parteien die Unwirksamkeit des Versprechens gekannt haben (§ 344)";
    label en unofficial "the penalty agreement for non-performance of that promise is likewise ineffective, even if the parties knew of the ineffectiveness (§ 344)";
}
pub relation verwirkung_bestritten_wegen_erfuellung(s: Schuldverhaeltnis, schuldner: Person) kind empirical {
    label de official "Der Schuldner bestreitet die Verwirkung der Strafe, weil er seine Verbindlichkeit erfüllt habe (§ 345)";
    label en unofficial "the debtor denies forfeiture of the penalty because he performed his obligation (§ 345)";
}
pub relation schuldner_muss_erfuellung_beweisen(s: Schuldverhaeltnis, schuldner: Person) kind institutional {
    label de official "Der Schuldner hat die Erfüllung zu beweisen, sofern nicht die geschuldete Leistung in einem Unterlassen besteht (§ 345)";
    label en unofficial "the debtor must prove performance unless the performance owed consists in forbearance (§ 345)";
}

@source(BGB_P339)
rule StrafeIstMitDemVerzugVerwirkt(s: Schuldverhaeltnis, l: Leistung, betrag: Money, tag: Date) strict {
    label de official "Verspricht der Schuldner dem Gläubiger für den Fall, dass er seine Verbindlichkeit nicht oder nicht in gehöriger Weise erfüllt, die Zahlung einer Geldsumme als Strafe, so ist die Strafe verwirkt, wenn er in Verzug kommt (§ 339 Satz 1)";
    label en unofficial "Where the debtor promises a sum as a penalty for non- or improper performance, the penalty is forfeited when he comes into default (§ 339 sentence 1)";
    when strafversprechen_fuer_nichterfuellung(s, betrag);
    when leistung_aus_schuldverhaeltnis(l, s);
    when verzug_seit(l, tag);
    then strafe_verwirkt(s, betrag);
}

@source(BGB_P339)
rule StrafeBeiUnterlassungspflichtMitDerZuwiderhandlungVerwirkt(s: Schuldverhaeltnis, betrag: Money) strict {
    label de official "Besteht die geschuldete Leistung in einem Unterlassen, so tritt die Verwirkung mit der Zuwiderhandlung ein (§ 339 Satz 2)";
    label en unofficial "Where the performance owed consists in forbearance, forfeiture occurs upon the contravention (§ 339 sentence 2)";
    when strafversprechen_fuer_nichterfuellung(s, betrag);
    when geschuldete_leistung_ist_ein_unterlassen(s);
    when zuwiderhandlung(s);
    then strafe_verwirkt(s, betrag);
}

@source(BGB_P340)
rule VerlangenDerStrafeSchliesstDenErfuellungsanspruchAus(s: Schuldverhaeltnis, betrag: Money) strict {
    label de official "Hat der Schuldner die Strafe für den Fall versprochen, dass er seine Verbindlichkeit nicht erfüllt, so kann der Gläubiger die verwirkte Strafe statt der Erfüllung verlangen; erklärt der Gläubiger, dass er die Strafe verlange, so ist der Anspruch auf Erfüllung ausgeschlossen (§ 340 Abs. 1)";
    label en unofficial "Where the penalty was promised for non-performance, the creditor may claim it instead of performance; upon his declaration the claim to performance is excluded (§ 340 (1))";
    when strafe_verwirkt(s, betrag);
    when strafversprechen_fuer_nichterfuellung(s, betrag);
    when strafe_statt_der_erfuellung_verlangt(s);
    then erfuellungsanspruch_ausgeschlossen(s);
}

@source(BGB_P340)
rule StrafeAlsMindestbetragDesSchadens(s: Schuldverhaeltnis, sch: Schaden, p: Person, betrag: Money) strict {
    label de official "Steht dem Gläubiger ein Anspruch auf Schadensersatz wegen Nichterfüllung zu, so kann er die verwirkte Strafe als Mindestbetrag des Schadens verlangen; die Geltendmachung eines weiteren Schadens ist nicht ausgeschlossen (§ 340 Abs. 2)";
    label en unofficial "Where the creditor has a claim for damages for non-performance he may claim the penalty as the minimum damage; further damage may be asserted (§ 340 (2))";
    when strafe_verwirkt(s, betrag);
    when schadensersatz_statt_der_leistung(s, sch, p);
    then strafe_als_mindestbetrag_des_schadens(s, betrag);
}

@source(BGB_P341)
rule StrafeNebenDerErfuellung(s: Schuldverhaeltnis, l: Leistung, betrag: Money, tag: Date) strict {
    label de official "Hat der Schuldner die Strafe für den Fall versprochen, dass er seine Verbindlichkeit nicht in gehöriger Weise, insbesondere nicht zu der bestimmten Zeit, erfüllt, so kann der Gläubiger die verwirkte Strafe neben der Erfüllung verlangen (§ 341 Abs. 1)";
    label en unofficial "Where the penalty was promised for improper performance the creditor may claim it in addition to performance (§ 341 (1))";
    when strafversprechen_fuer_nicht_gehoerige_erfuellung(s, betrag);
    when leistung_aus_schuldverhaeltnis(l, s);
    when verzug_seit(l, tag);
    then strafe_neben_der_erfuellung_verlangbar(s, betrag);
}

@source(BGB_P341)
rule StrafeNachAnnahmeDerErfuellungNurMitVorbehalt(s: Schuldverhaeltnis, betrag: Money) strict {
    label de official "Nimmt der Gläubiger die Erfüllung an, so kann er die Strafe nur verlangen, wenn er sich das Recht dazu bei der Annahme vorbehält (§ 341 Abs. 3)";
    label en unofficial "If the creditor accepts performance he may claim the penalty only if he reserved that right on acceptance (§ 341 (3))";
    when strafversprechen_fuer_nicht_gehoerige_erfuellung(s, betrag);
    when erfuellung_angenommen_mit_vorbehalt(s);
    then strafe_neben_der_erfuellung_verlangbar(s, betrag);
}

@source(BGB_P342)
rule AndereStrafleistungSchliesstDenSchadensersatzAus(s: Schuldverhaeltnis) strict {
    label de official "Wird als Strafe eine andere Leistung als die Zahlung einer Geldsumme versprochen, so finden die §§ 339 bis 341 Anwendung; der Anspruch auf Schadensersatz ist ausgeschlossen, wenn der Gläubiger die Strafe verlangt (§ 342)";
    label en unofficial "Where a performance other than money is promised as a penalty, §§ 339 to 341 apply; the claim for damages is excluded where the creditor demands the penalty (§ 342)";
    when andere_strafleistung_als_geld(s);
    when strafe_statt_der_erfuellung_verlangt(s);
    then schadensersatzanspruch_ausgeschlossen(s);
}

@source(BGB_P343)
rule HerabsetzungDerUnverhaeltnismaessigHohenStrafe(s: Schuldverhaeltnis, verwirkt: Money, angemessen: Money) strict {
    label de official "Ist eine verwirkte Strafe unverhältnismäßig hoch, so kann sie auf Antrag des Schuldners durch Urteil auf den angemessenen Betrag herabgesetzt werden; nach der Entrichtung der Strafe ist die Herabsetzung ausgeschlossen (§ 343 Abs. 1)";
    label en unofficial "A disproportionately high forfeited penalty may be reduced by judgment on the debtor's application to a reasonable amount; after payment reduction is excluded (§ 343 (1))";
    when strafe_verwirkt(s, verwirkt);
    when strafe_nicht_entrichtet(s);
    when angemessener_betrag_der_strafe(s, angemessen);
    then herabgesetzte_strafe(s, angemessen);
}

@source(BGB_P344)
rule UnwirksamesStrafversprechen(s: Schuldverhaeltnis) strict {
    label de official "Erklärt das Gesetz das Versprechen einer Leistung für unwirksam, so ist auch die für den Fall der Nichterfüllung des Versprechens getroffene Vereinbarung einer Strafe unwirksam, selbst wenn die Parteien die Unwirksamkeit des Versprechens gekannt haben (§ 344)";
    label en unofficial "Where the law declares the promise of a performance ineffective, the penalty agreement for its non-performance is likewise ineffective (§ 344)";
    when versprechen_der_hauptleistung_unwirksam(s);
    then strafvereinbarung_unwirksam(s);
}

@source(BGB_P345)
rule BeweislastDesSchuldnersFuerDieErfuellung(s: Schuldverhaeltnis, schuldner: Person) strict {
    label de official "Bestreitet der Schuldner die Verwirkung der Strafe, weil er seine Verbindlichkeit erfüllt habe, so hat er die Erfüllung zu beweisen, sofern nicht die geschuldete Leistung in einem Unterlassen besteht (§ 345)";
    label en unofficial "Where the debtor denies forfeiture because he performed, he must prove performance unless the performance owed consists in forbearance (§ 345)";
    when verwirkung_bestritten_wegen_erfuellung(s, schuldner);
    when leistung_ist_kein_unterlassen(s);
    then schuldner_muss_erfuellung_beweisen(s, schuldner);
}

@source(BGB_P345)
pub relation leistung_ist_kein_unterlassen(s: Schuldverhaeltnis) kind empirical {
    label de official "Die geschuldete Leistung besteht nicht in einem Unterlassen (§ 345) — ausdrückliche Angabe des Falls";
    label en unofficial "the performance owed does not consist in forbearance (§ 345) — explicit case input";
}
