// ABSCHNITT 1 TITEL 2 VERZUG DES GLÄUBIGERS, §§ 293–304
//
// Der Annahmeverzug hat keinen eigenen Zeitpunkt im Text: er tritt ein, wenn
// der Gläubiger die ihm angebotene Leistung nicht annimmt (§ 293), und endet
// nicht durch Fristablauf. Deshalb trägt der Kopf `annahmeverzug_des_glaeubigers`
// (erklärt bei § 274) keinen Tag. Was das Angebot ist, sagen §§ 294–296; wann
// es entbehrlich ist, § 296; wann trotz Angebots kein Verzug eintritt, §§ 297
// und 299.


language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";

pub relation leistung_tatsaechlich_angeboten(s: Schuldverhaeltnis, l: Leistung) kind institutional {
    label de official "Die Leistung ist dem Gläubiger so, wie sie zu bewirken ist, tatsächlich angeboten worden (§ 294)";
    label en unofficial "the performance was actually offered to the creditor as it is to be rendered (§ 294)";
}
pub relation leistung_nicht_angenommen(s: Schuldverhaeltnis, l: Leistung) kind empirical {
    label de official "Der Gläubiger nimmt die ihm angebotene Leistung nicht an (§ 293)";
    label en unofficial "the creditor does not accept the performance offered to him (§ 293)";
}
pub relation woertliches_angebot(s: Schuldverhaeltnis, l: Leistung) kind empirical {
    label de official "Ein wörtliches Angebot des Schuldners oder die Aufforderung an den Gläubiger, die erforderliche Handlung vorzunehmen (§ 295)";
    label en unofficial "a verbal offer by the debtor or a request to the creditor to take the necessary action (§ 295)";
}
pub relation annahme_verweigert_erklaert(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Gläubiger hat erklärt, dass er die Leistung nicht annehmen werde (§ 295 Satz 1 Alt. 1)";
    label en unofficial "the creditor declared that he will not accept the performance (§ 295 sentence 1)";
}
pub relation handlung_des_glaeubigers_erforderlich(s: Schuldverhaeltnis) kind empirical {
    label de official "Zur Bewirkung der Leistung ist eine Handlung des Gläubigers erforderlich, insbesondere hat er die geschuldete Sache abzuholen (§ 295 Satz 1 Alt. 2)";
    label en unofficial "an act of the creditor is necessary for performance, in particular he must collect the thing owed (§ 295 sentence 1)";
}
pub relation zeit_der_glaeubigerhandlung_nach_dem_kalender_bestimmt(s: Schuldverhaeltnis, tag: Date) kind empirical {
    key(s);
    label de official "Für die von dem Gläubiger vorzunehmende Handlung ist eine Zeit nach dem Kalender bestimmt oder von einem vorauszugehenden Ereignis an kalendermäßig berechenbar (§ 296)";
    label en unofficial "a time for the creditor's act is fixed by the calendar or calculable from a preceding event (§ 296)";
}
pub relation glaeubiger_nimmt_handlung_rechtzeitig_vor(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Gläubiger nimmt die Handlung rechtzeitig vor (§ 296 Satz 1 Halbsatz 2)";
    label en unofficial "the creditor takes the act in good time (§ 296 sentence 1)";
}
pub relation glaeubiger_nimmt_handlung_nicht_rechtzeitig_vor(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Gläubiger nimmt die Handlung nicht rechtzeitig vor (§ 296) — ausdrückliche Angabe des Falls";
    label en unofficial "the creditor does not take the act in good time (§ 296) — explicit case input";
}
pub relation schuldner_ausserstande_zu_leisten(s: Schuldverhaeltnis, l: Leistung) kind empirical {
    label de official "Der Schuldner ist zur Zeit des Angebots oder im Falle des § 296 zu der für die Handlung des Gläubigers bestimmten Zeit außerstande, die Leistung zu bewirken (§ 297)";
    label en unofficial "the debtor is unable to render the performance at the time of the offer or of the creditor's act (§ 297)";
}
pub relation schuldner_imstande_zu_leisten(s: Schuldverhaeltnis, l: Leistung) kind empirical {
    label de official "Der Schuldner ist imstande, die Leistung zu bewirken (§ 297) — ausdrückliche Angabe des Falls";
    label en unofficial "the debtor is able to render the performance (§ 297) — explicit case input";
}
pub relation nur_zug_um_zug_zu_leisten(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Schuldner ist nur gegen eine Leistung des Gläubigers zu leisten verpflichtet (§ 298)";
    label en unofficial "the debtor is bound to perform only in return for a performance by the creditor (§ 298)";
}
pub relation gegenleistung_nicht_angeboten(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Gläubiger ist zwar bereit, die angebotene Leistung anzunehmen, bietet aber die verlangte Gegenleistung nicht an (§ 298)";
    label en unofficial "the creditor is willing to accept but does not offer the counter-performance demanded (§ 298)";
}
pub relation leistungszeit_nicht_bestimmt_oder_vorzeitige_leistung(s: Schuldverhaeltnis, l: Leistung) kind empirical {
    label de official "Die Leistungszeit ist nicht bestimmt oder der Schuldner ist berechtigt, vor der bestimmten Zeit zu leisten (§ 299)";
    label en unofficial "the time for performance is not fixed or the debtor may perform before the fixed time (§ 299)";
}
pub relation voruebergehend_an_der_annahme_verhindert(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Gläubiger ist vorübergehend an der Annahme der angebotenen Leistung verhindert (§ 299)";
    label en unofficial "the creditor is temporarily prevented from accepting the performance offered (§ 299)";
}
pub relation leistung_angemessene_zeit_vorher_angekuendigt(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Schuldner hat dem Gläubiger die Leistung eine angemessene Zeit vorher angekündigt (§ 299 Halbsatz 2)";
    label en unofficial "the debtor announced the performance a reasonable time in advance (§ 299)";
}
pub relation kein_annahmeverzug(s: Schuldverhaeltnis) kind institutional {
    label de official "Der Gläubiger kommt nicht in Verzug (§§ 297, 299)";
    label en unofficial "the creditor does not come into default (§§ 297, 299)";
}

@source(BGB_P293)
rule AnnahmeverzugDurchNichtannahmeDesTatsaechlichenAngebots(s: Schuldverhaeltnis, l: Leistung) strict {
    label de official "Der Gläubiger kommt in Verzug, wenn er die ihm angebotene Leistung nicht annimmt (§ 293); die Leistung muss ihm so, wie sie zu bewirken ist, tatsächlich angeboten werden (§ 294)";
    label en unofficial "The creditor is in default if he does not accept the performance offered (§ 293); it must actually be offered as it is to be rendered (§ 294)";
    when leistung_tatsaechlich_angeboten(s, l);
    when leistung_nicht_angenommen(s, l);
    when schuldner_imstande_zu_leisten(s, l);
    then annahmeverzug_des_glaeubigers(s);
}

@source(BGB_P295)
rule AnnahmeverzugNachWoertlichemAngebotBeiVerweigerung(s: Schuldverhaeltnis, l: Leistung) strict {
    label de official "Ein wörtliches Angebot des Schuldners genügt, wenn der Gläubiger ihm erklärt hat, dass er die Leistung nicht annehmen werde (§ 295 Satz 1 Alt. 1)";
    label en unofficial "A verbal offer suffices where the creditor declared that he will not accept the performance (§ 295 sentence 1)";
    when woertliches_angebot(s, l);
    when annahme_verweigert_erklaert(s);
    when schuldner_imstande_zu_leisten(s, l);
    then annahmeverzug_des_glaeubigers(s);
}

@source(BGB_P295)
rule AnnahmeverzugNachWoertlichemAngebotBeiErforderlicherHandlung(s: Schuldverhaeltnis, l: Leistung) strict {
    label de official "Ein wörtliches Angebot genügt, wenn zur Bewirkung der Leistung eine Handlung des Gläubigers erforderlich ist, insbesondere wenn der Gläubiger die geschuldete Sache abzuholen hat; dem Angebot steht die Aufforderung an den Gläubiger gleich, die erforderliche Handlung vorzunehmen (§ 295)";
    label en unofficial "A verbal offer suffices where an act of the creditor is necessary, in particular collection of the thing owed; a request to take that act is equivalent to the offer (§ 295)";
    when woertliches_angebot(s, l);
    when handlung_des_glaeubigers_erforderlich(s);
    when schuldner_imstande_zu_leisten(s, l);
    then annahmeverzug_des_glaeubigers(s);
}

@source(BGB_P296)
rule AnnahmeverzugOhneAngebotBeiKalendermaessigBestimmterHandlung(s: Schuldverhaeltnis, l: Leistung, tag: Date) strict {
    label de official "Ist für die von dem Gläubiger vorzunehmende Handlung eine Zeit nach dem Kalender bestimmt, so bedarf es des Angebots nur, wenn der Gläubiger die Handlung rechtzeitig vornimmt; das Gleiche gilt, wenn der Handlung ein Ereignis vorauszugehen hat und eine angemessene Zeit kalendermäßig berechenbar bestimmt ist (§ 296)";
    label en unofficial "Where a time for the creditor's act is fixed by the calendar, an offer is needed only if he takes the act in good time; the same applies to a time calculable from a preceding event (§ 296)";
    when zeit_der_glaeubigerhandlung_nach_dem_kalender_bestimmt(s, tag);
    when glaeubiger_nimmt_handlung_nicht_rechtzeitig_vor(s);
    when schuldner_imstande_zu_leisten(s, l);
    then annahmeverzug_des_glaeubigers(s);
}

@source(BGB_P297)
rule KeinAnnahmeverzugBeiUnvermoegenDesSchuldners(s: Schuldverhaeltnis, l: Leistung) strict {
    label de official "Der Gläubiger kommt nicht in Verzug, wenn der Schuldner zur Zeit des Angebots oder im Falle des § 296 zu der für die Handlung des Gläubigers bestimmten Zeit außerstande ist, die Leistung zu bewirken (§ 297)";
    label en unofficial "The creditor is not in default where the debtor is unable to render the performance at the relevant time (§ 297)";
    when schuldner_ausserstande_zu_leisten(s, l);
    then kein_annahmeverzug(s);
}

@source(BGB_P298)
rule AnnahmeverzugBeiZugUmZugOhneAngebotDerGegenleistung(s: Schuldverhaeltnis, l: Leistung) strict {
    label de official "Ist der Schuldner nur gegen eine Leistung des Gläubigers zu leisten verpflichtet, so kommt der Gläubiger in Verzug, wenn er zwar die angebotene Leistung anzunehmen bereit ist, die verlangte Gegenleistung aber nicht anbietet (§ 298)";
    label en unofficial "Where the debtor must perform only against a performance by the creditor, the creditor is in default if he is willing to accept but does not offer the counter-performance (§ 298)";
    when nur_zug_um_zug_zu_leisten(s);
    when leistung_tatsaechlich_angeboten(s, l);
    when gegenleistung_nicht_angeboten(s);
    when schuldner_imstande_zu_leisten(s, l);
    then annahmeverzug_des_glaeubigers(s);
}

@source(BGB_P299)
rule KeinAnnahmeverzugBeiVoruebergehenderVerhinderung(s: Schuldverhaeltnis, l: Leistung) strict {
    label de official "Ist die Leistungszeit nicht bestimmt oder ist der Schuldner berechtigt, vor der bestimmten Zeit zu leisten, so kommt der Gläubiger nicht dadurch in Verzug, dass er vorübergehend an der Annahme der angebotenen Leistung verhindert ist, es sei denn, dass der Schuldner ihm die Leistung eine angemessene Zeit vorher angekündigt hat (§ 299)";
    label en unofficial "Where the time for performance is not fixed or the debtor may perform earlier, the creditor is not in default merely because he is temporarily prevented from accepting, unless the debtor announced the performance a reasonable time in advance (§ 299)";
    when leistungszeit_nicht_bestimmt_oder_vorzeitige_leistung(s, l);
    when voruebergehend_an_der_annahme_verhindert(s);
    when keine_ankuendigung_der_leistung(s);
    then kein_annahmeverzug(s);
}

@source(BGB_P299)
pub relation keine_ankuendigung_der_leistung(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Schuldner hat die Leistung nicht eine angemessene Zeit vorher angekündigt (§ 299 Halbsatz 2) — ausdrückliche Angabe des Falls";
    label en unofficial "the debtor did not announce the performance a reasonable time in advance (§ 299) — explicit case input";
}

// --- §§ 300–304 Wirkungen des Gläubigerverzugs ---------------------------------------------------------

pub relation haftung_nur_fuer_vorsatz_und_grobe_fahrlaessigkeit(s: Schuldverhaeltnis) kind institutional {
    label de official "Der Schuldner hat während des Verzugs des Gläubigers nur Vorsatz und grobe Fahrlässigkeit zu vertreten (§ 300 Abs. 1)";
    label en unofficial "during the creditor's default the debtor is responsible only for intent and gross negligence (§ 300 (1))";
}
pub relation gattungssache_nicht_angenommen(s: Schuldverhaeltnis, l: Leistung) kind empirical {
    label de official "Der Gläubiger nimmt die angebotene, nur der Gattung nach bestimmte Sache nicht an (§ 300 Abs. 2)";
    label en unofficial "the creditor does not accept the thing owed, defined only by class (§ 300 (2))";
}
pub relation gefahr_geht_auf_den_glaeubiger_ueber(s: Schuldverhaeltnis, l: Leistung) kind institutional {
    label de official "Die Gefahr geht mit dem Zeitpunkt auf den Gläubiger über, in welchem er dadurch in Verzug kommt, dass er die angebotene Sache nicht annimmt (§ 300 Abs. 2)";
    label en unofficial "the risk passes to the creditor at the time he comes into default by not accepting the thing offered (§ 300 (2))";
}
pub relation verzinsliche_geldschuld(a: Anspruch) kind empirical {
    label de official "Es handelt sich um eine verzinsliche Geldschuld (§ 301)";
    label en unofficial "the debt is a monetary debt bearing interest (§ 301)";
}
pub relation geldschuld_des_schuldverhaeltnisses(s: Schuldverhaeltnis, a: Anspruch) kind empirical {
    label de official "Geldschuld aus diesem Schuldverhältnis";
    label en unofficial "monetary debt arising from this obligation";
}
pub relation keine_zinsen_waehrend_des_glaeubigerverzugs(a: Anspruch) kind institutional {
    label de official "Von einer verzinslichen Geldschuld hat der Schuldner während des Verzugs des Gläubigers Zinsen nicht zu entrichten (§ 301)";
    label en unofficial "during the creditor's default the debtor pays no interest on an interest-bearing monetary debt (§ 301)";
}
pub relation nutzungen_herauszugeben_oder_zu_ersetzen(s: Schuldverhaeltnis, l: Leistung) kind empirical {
    label de official "Der Schuldner hat die Nutzungen eines Gegenstands herauszugeben oder zu ersetzen (§ 302)";
    label en unofficial "the debtor must surrender or compensate the emoluments of an object (§ 302)";
}
pub relation verpflichtung_auf_gezogene_nutzungen_beschraenkt(s: Schuldverhaeltnis, l: Leistung) kind institutional {
    label de official "Die Verpflichtung beschränkt sich während des Verzugs des Gläubigers auf die Nutzungen, welche der Schuldner zieht (§ 302)";
    label en unofficial "during the creditor's default the duty is limited to the emoluments actually taken (§ 302)";
}
pub relation herausgabe_eines_grundstuecks_oder_schiffs_geschuldet(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Schuldner ist zur Herausgabe eines Grundstücks oder eines eingetragenen Schiffs oder Schiffsbauwerks verpflichtet (§ 303 Satz 1)";
    label en unofficial "the debtor must deliver up a plot of land or a registered ship or ship under construction (§ 303 sentence 1)";
}
pub relation aufgabe_des_besitzes_angedroht(s: Schuldverhaeltnis) kind empirical {
    label de official "Das Aufgeben des Besitzes ist dem Gläubiger vorher angedroht worden oder die Androhung ist untunlich (§ 303 Satz 2)";
    label en unofficial "abandonment of possession was announced to the creditor in advance, or the announcement is impracticable (§ 303 sentence 2)";
}
pub relation besitz_darf_aufgegeben_werden(s: Schuldverhaeltnis) kind institutional {
    label de official "Der Schuldner kann nach dem Eintritt des Verzugs des Gläubigers den Besitz aufgeben (§ 303)";
    label en unofficial "after the creditor's default the debtor may abandon possession (§ 303)";
}
pub relation mehraufwendungen_fuer_angebot_und_aufbewahrung(s: Schuldverhaeltnis, betrag: Money) kind empirical {
    key(s);
    label de official "Mehraufwendungen, die der Schuldner für das erfolglose Angebot sowie für die Aufbewahrung und Erhaltung des geschuldeten Gegenstands machen musste (§ 304)";
    label en unofficial "additional expenses the debtor had to incur for the unsuccessful offer and for keeping and preserving the object owed (§ 304)";
}
pub relation ersatz_der_mehraufwendungen(s: Schuldverhaeltnis, betrag: Money) kind institutional {
    key(s);
    label de official "Der Schuldner kann im Falle des Verzugs des Gläubigers Ersatz dieser Mehraufwendungen verlangen (§ 304)";
    label en unofficial "in the case of the creditor's default the debtor may claim reimbursement of those expenses (§ 304)";
}

@source(BGB_P300)
rule HaftungsmilderungImGlaeubigerverzug(s: Schuldverhaeltnis) strict {
    label de official "Der Schuldner hat während des Verzugs des Gläubigers nur Vorsatz und grobe Fahrlässigkeit zu vertreten (§ 300 Abs. 1)";
    label en unofficial "During the creditor's default the debtor is responsible only for intent and gross negligence (§ 300 (1))";
    when annahmeverzug_des_glaeubigers(s);
    then haftung_nur_fuer_vorsatz_und_grobe_fahrlaessigkeit(s);
}

@source(BGB_P300)
rule GefahruebergangBeiGattungsschuld(s: Schuldverhaeltnis, l: Leistung) strict {
    label de official "Wird eine nur der Gattung nach bestimmte Sache geschuldet, so geht die Gefahr mit dem Zeitpunkt auf den Gläubiger über, in welchem er dadurch in Verzug kommt, dass er die angebotene Sache nicht annimmt (§ 300 Abs. 2)";
    label en unofficial "Where a thing defined only by class is owed, the risk passes to the creditor when he comes into default by not accepting it (§ 300 (2))";
    when annahmeverzug_des_glaeubigers(s);
    when gattungsschuld(l);
    when gattungssache_nicht_angenommen(s, l);
    then gefahr_geht_auf_den_glaeubiger_ueber(s, l);
}

@source(BGB_P301)
rule WegfallDerVerzinsungImGlaeubigerverzug(s: Schuldverhaeltnis, a: Anspruch) strict {
    label de official "Von einer verzinslichen Geldschuld hat der Schuldner während des Verzugs des Gläubigers Zinsen nicht zu entrichten (§ 301)";
    label en unofficial "During the creditor's default the debtor pays no interest on an interest-bearing monetary debt (§ 301)";
    when annahmeverzug_des_glaeubigers(s);
    when geldschuld_des_schuldverhaeltnisses(s, a);
    when verzinsliche_geldschuld(a);
    then keine_zinsen_waehrend_des_glaeubigerverzugs(a);
}

@source(BGB_P302)
rule NutzungenImGlaeubigerverzug(s: Schuldverhaeltnis, l: Leistung) strict {
    label de official "Hat der Schuldner die Nutzungen eines Gegenstands herauszugeben oder zu ersetzen, so beschränkt sich seine Verpflichtung während des Verzugs des Gläubigers auf die Nutzungen, welche er zieht (§ 302)";
    label en unofficial "Where the debtor must surrender or compensate emoluments, during the creditor's default his duty is limited to those he actually takes (§ 302)";
    when annahmeverzug_des_glaeubigers(s);
    when nutzungen_herauszugeben_oder_zu_ersetzen(s, l);
    then verpflichtung_auf_gezogene_nutzungen_beschraenkt(s, l);
}

@source(BGB_P303)
rule RechtZurBesitzaufgabe(s: Schuldverhaeltnis) strict {
    label de official "Ist der Schuldner zur Herausgabe eines Grundstücks oder eines eingetragenen Schiffs oder Schiffsbauwerks verpflichtet, so kann er nach dem Eintritt des Verzugs des Gläubigers den Besitz aufgeben; das Aufgeben muss dem Gläubiger vorher angedroht werden, es sei denn, dass die Androhung untunlich ist (§ 303)";
    label en unofficial "Where the debtor must deliver up land or a registered ship, after the creditor's default he may abandon possession; abandonment must be announced in advance unless that is impracticable (§ 303)";
    when annahmeverzug_des_glaeubigers(s);
    when herausgabe_eines_grundstuecks_oder_schiffs_geschuldet(s);
    when aufgabe_des_besitzes_angedroht(s);
    then besitz_darf_aufgegeben_werden(s);
}

@source(BGB_P304)
rule ErsatzVonMehraufwendungenImGlaeubigerverzug(s: Schuldverhaeltnis, betrag: Money) strict {
    label de official "Der Schuldner kann im Falle des Verzugs des Gläubigers Ersatz der Mehraufwendungen verlangen, die er für das erfolglose Angebot sowie für die Aufbewahrung und Erhaltung des geschuldeten Gegenstands machen musste (§ 304)";
    label en unofficial "In the case of the creditor's default the debtor may claim the additional expenses for the unsuccessful offer and for keeping and preserving the object (§ 304)";
    when annahmeverzug_des_glaeubigers(s);
    when mehraufwendungen_fuer_angebot_und_aufbewahrung(s, betrag);
    then ersatz_der_mehraufwendungen(s, betrag);
}

// --- § 294 Tatsächliches Angebot: eigener Kopf ---------------------------------------------------------
//
// § 293 sagt, dass der Gläubiger in Verzug kommt, wenn er die ihm angebotene
// Leistung nicht annimmt; § 294 sagt, WAS ein Angebot ist: die Leistung muss
// dem Gläubiger so, wie sie zu bewirken ist, tatsächlich angeboten werden.
// Deshalb ist `leistung_tatsaechlich_angeboten` eine institutionelle Folge
// dieses Paragraphen und nicht eine flache Tatsache des Falls.

pub relation leistung_angeboten(s: Schuldverhaeltnis, l: Leistung) kind empirical {
    label de official "Der Schuldner hat dem Gläubiger die Leistung angeboten (§ 294)";
    label en unofficial "the debtor offered the performance to the creditor (§ 294)";
}
pub relation angebot_so_wie_zu_bewirken(s: Schuldverhaeltnis, l: Leistung) kind empirical {
    label de official "Das Angebot entspricht der Leistung so, wie sie zu bewirken ist (§ 294)";
    label en unofficial "the offer corresponds to the performance as it is to be rendered (§ 294)";
}

@source(BGB_P294)
rule TatsaechlichesAngebot(s: Schuldverhaeltnis, l: Leistung) strict {
    label de official "Die Leistung muss dem Gläubiger so, wie sie zu bewirken ist, tatsächlich angeboten werden (§ 294)";
    label en unofficial "The performance must actually be offered to the creditor as it is to be rendered (§ 294)";
    when leistung_angeboten(s, l);
    when angebot_so_wie_zu_bewirken(s, l);
    then leistung_tatsaechlich_angeboten(s, l);
}
