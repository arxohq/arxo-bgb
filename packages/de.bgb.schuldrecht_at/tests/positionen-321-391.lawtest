language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";

test "§§ 321, 324, 326, 391: letzte Positionen aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "v": gegenseitiger_vertrag(entity_ref("urn:de:bgb:sr-at:last:v")) { origin case_input; }
        assert "p": vorleistungspflichtig(entity_ref("urn:de:bgb:sr-at:last:v"), entity_ref("urn:de:bgb:sr-at:last:p")) { origin case_input; }
        assert "u": unsicherheitseinrede(entity_ref("urn:de:bgb:sr-at:last:v"), entity_ref("urn:de:bgb:sr-at:last:p")) { origin case_input; }
        assert "d": vertrag_geschlossen_am(entity_ref("urn:de:bgb:sr-at:last:v"), @2026-01-01) { origin case_input; }
        assert "r": ruecktrittsrecht(entity_ref("urn:de:bgb:sr-at:last:v"), entity_ref("urn:de:bgb:sr-at:last:p")) { origin case_input; }
        assert "z": festhalten_am_vertrag_nicht_mehr_zumutbar(entity_ref("urn:de:bgb:sr-at:last:v"), entity_ref("urn:de:bgb:sr-at:last:p")) { origin case_input; }
        assert "e": anspruch_auf_die_gegenleistung_entfaellt(entity_ref("urn:de:bgb:sr-at:last:v"), entity_ref("urn:de:bgb:sr-at:last:l")) { origin case_input; }
        assert "a": aufrechnung_nicht_wegen_der_leistungsorte_ausgeschlossen(entity_ref("urn:de:bgb:sr-at:last:a"), entity_ref("urn:de:bgb:sr-at:last:b")) { origin case_input; }
    }
    evaluate positions();
    expect position(Unsicherheitseinrede321, ACTIVE);
    expect position(Ruecktritt324, ACTIVE);
    expect position(AufrechnungLeistungsorte391, ACTIVE);
}

test "§§ 321, 324, 326, 391: ohne Grundlagen nicht vorhanden" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(Unsicherheitseinrede321, ACTIVE);
    expect not position(Ruecktritt324, ACTIVE);
    expect not position(GegenleistungEntfall326, ACTIVE);
    expect not position(AufrechnungLeistungsorte391, ACTIVE);
}
