language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// Andere Seite derselben Schwelle: derselbe Sachverhalt, der Widerruf wird
// einen Tag nach dem Ende der Frist abgesandt (21. März 2026). Der Widerruf ist
// nicht fristgerecht, und die Bindung an die Willenserklärung entfällt nicht —
// das Recht schweigt (NEITHER), es verneint nicht.
test "§ 355 Abs. 1: Widerruf einen Tag nach Fristende ist nicht fristgerecht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_SCHULDRECHT_AT_TAG; }
        assert "a1": widerrufsrecht_eingeraeumt(entity_ref("urn:de:bgb:sr-at:w02:v1"), entity_ref("urn:de:bgb:sr-at:w02:p1")) { origin case_input; }
        assert "a2": verbraucher(entity_ref("urn:de:bgb:sr-at:w02:p1")) { origin case_input; }
        assert "a3": widerrufsfrist_des_vertrags(entity_ref("urn:de:bgb:sr-at:w02:v1"), entity_ref("urn:de:bgb:sr-at:w02:f1")) { origin case_input; }
        assert "a4": erhalt_der_ware(entity_ref("urn:de:bgb:sr-at:w02:v1"), @2026-03-06) { origin case_input; }
        assert "a5": keine_spaetere_unterrichtung(entity_ref("urn:de:bgb:sr-at:w02:v1")) { origin case_input; }
        assert "a6": widerruf_erklaert_am(entity_ref("urn:de:bgb:sr-at:w02:v1"), @2026-03-21) { origin case_input; }
    }
    evaluate truth(widerruf_fristgerecht(entity_ref("urn:de:bgb:sr-at:w02:v1")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(nicht_mehr_an_die_willenserklaerung_gebunden(entity_ref("urn:de:bgb:sr-at:w02:v1"), entity_ref("urn:de:bgb:sr-at:w02:p1")));
    expect truth_status == NEITHER;
}
