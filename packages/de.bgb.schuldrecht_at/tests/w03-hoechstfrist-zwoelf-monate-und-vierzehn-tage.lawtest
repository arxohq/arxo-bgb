language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// § 356 Abs. 4 Satz 1 mit §§ 188 Abs. 2, 193: Zeitpunkt nach Absatz 2 ist der
// 6. März 2026 (Erhalt der Ware). Zwölf Monate führen auf den 6. März 2027
// (Sonnabend), weitere 14 Tage auf den 20. März 2027 — ebenfalls ein
// Sonnabend. An die Stelle dieses Tages tritt der nächste Werktag, Montag der
// 22. März 2027. Ein Widerruf am 23. März 2027 ist verspätet: das
// Widerrufsrecht ist erloschen. Eigener Fall wegen der Kalenderpolitik
// (eine Politik je Fall, §168.2).
test "§ 356 Abs. 4: Höchstfrist endet am 22. März 2027 (Verlegung nach § 193)" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_SCHULDRECHT_AT_KALENDER; }
        assert "a1": widerrufsrecht_eingeraeumt(entity_ref("urn:de:bgb:sr-at:w03:v1"), entity_ref("urn:de:bgb:sr-at:w03:p1")) { origin case_input; }
        assert "a2": verbraucher(entity_ref("urn:de:bgb:sr-at:w03:p1")) { origin case_input; }
        assert "a3": hoechstfrist_des_vertrags(entity_ref("urn:de:bgb:sr-at:w03:v1"), entity_ref("urn:de:bgb:sr-at:w03:h1")) { origin case_input; }
        assert "a4": fristbeginn_des_widerrufs(entity_ref("urn:de:bgb:sr-at:w03:v1"), @2026-03-06) { origin case_input; }
        assert "a5": widerruf_erklaert_am(entity_ref("urn:de:bgb:sr-at:w03:v1"), @2027-03-23) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende_kalender(entity_ref("urn:de:bgb:sr-at:w03:h1"), @2027-03-20));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sr-at:w03:h1"), @2027-03-22));
    expect truth_status == TRUE_ONLY;
    evaluate truth(widerrufsrecht_erloschen(entity_ref("urn:de:bgb:sr-at:w03:v1")));
    expect truth_status == TRUE_ONLY;
}
