language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// Kanarienvogel zu br01: dieselben Fakten aus de.bgb.allgemeiner_teil, aber
// OHNE das Korrelat `rechtsgeschaeft_des_vertrags` — die Brücke darf nicht
// „durchgreifen“, ohne dass der Fall das Rechtsgeschäft mit dem Vertrag
// verknüpft. Verbraucher bleibt unbewiesen: Entfernen einer einzigen
// Eingabe muss das Ergebnis kippen.
test "Brücke §§ 13/14, Kanarie: ohne Korrelat bleibt Verbraucher unbewiesen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "a1": de.bgb.allgemeiner_teil::rechtssubjektart(entity_ref("urn:de:bgb:sr-at:br03:p1"), de.bgb.allgemeiner_teil::Mensch) { origin case_input; }
        assert "a2": de.bgb.allgemeiner_teil::zweck_ueberwiegend_nicht_gewerblich(entity_ref("urn:de:bgb:sr-at:br03:p1"), entity_ref("urn:de:bgb:sr-at:br03:r1")) { origin adjudicated; }
    }
    evaluate truth(verbraucher(entity_ref("urn:de:bgb:sr-at:br03:p1")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
