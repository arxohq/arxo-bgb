language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";

test "§§ 320, 323, 387: Einrede, Rücktritt und Aufrechnung" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "v": vertragspartei(entity_ref("urn:de:bgb:sr-at:320:v"), entity_ref("urn:de:bgb:sr-at:320:p")) { origin case_input; }
        assert "d": vertrag_geschlossen_am(entity_ref("urn:de:bgb:sr-at:320:v"), @2026-01-01) { origin case_input; }
        assert "e": einrede_des_nicht_erfuellten_vertrags(entity_ref("urn:de:bgb:sr-at:320:v"), entity_ref("urn:de:bgb:sr-at:320:p")) { origin case_input; }
        assert "r": ruecktrittsrecht(entity_ref("urn:de:bgb:sr-at:320:v"), entity_ref("urn:de:bgb:sr-at:320:p")) { origin case_input; }
        assert "a": aufrechnungslage(entity_ref("urn:de:bgb:sr-at:320:a"), entity_ref("urn:de:bgb:sr-at:320:b")) { origin case_input; }
    }
    evaluate positions();
    expect position(EinredeNichtErfuellterVertrag320, ACTIVE);
    expect position(Ruecktritt323, ACTIVE);
    expect position(Aufrechnung387, ACTIVE);
}

test "§§ 320, 323, 387: ohne Rechtsgrund keine Position" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(EinredeNichtErfuellterVertrag320, ACTIVE);
    expect not position(Ruecktritt323, ACTIVE);
    expect not position(Aufrechnung387, ACTIVE);
}
