language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// § 426 Abs. 1 Satz 2 bei VIER Gesamtschuldnern: zwei fallen aus. Der Ausfall
// beider ist von den zwei übrigen zu tragen — Anteile von je 1/2 statt 1/4.
// Die Formel des Pakets zählt Gesamtschuldner minus Ausgefallene in EINEM
// Schritt (`count all ... where ausgefallener_schuldner`); bei gleichen
// Anteilen ist das dasselbe Ergebnis wie eine schrittweise Umlegung erster
// dann zweiter Ausfall, weil 1/n bei Gleichverteilung ordnungsunabhängig ist.
test "§ 426 Abs. 1 Satz 2: Ausfall zweier von vier Schuldnern führt auf Anteile von je 1/2" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "a1": gesamtschuld_vereinbart_oder_bestimmt(entity_ref("urn:de:bgb:sr-at:m03:s1")) { origin case_input; }
        assert "a2": de.bgb.core::schuldverhaeltnis_glaeubiger(entity_ref("urn:de:bgb:sr-at:m03:s1"), entity_ref("urn:de:bgb:sr-at:m03:g1")) { origin case_input; }
        assert "a3": de.bgb.core::schuldverhaeltnis_schuldner(entity_ref("urn:de:bgb:sr-at:m03:s1"), entity_ref("urn:de:bgb:sr-at:m03:p1")) { origin case_input; }
        assert "a4": de.bgb.core::schuldverhaeltnis_schuldner(entity_ref("urn:de:bgb:sr-at:m03:s1"), entity_ref("urn:de:bgb:sr-at:m03:p2")) { origin case_input; }
        assert "a5": de.bgb.core::schuldverhaeltnis_schuldner(entity_ref("urn:de:bgb:sr-at:m03:s1"), entity_ref("urn:de:bgb:sr-at:m03:p3")) { origin case_input; }
        assert "a6": de.bgb.core::schuldverhaeltnis_schuldner(entity_ref("urn:de:bgb:sr-at:m03:s1"), entity_ref("urn:de:bgb:sr-at:m03:p4")) { origin case_input; }
        assert "a7": keine_abweichende_bestimmung_der_ausgleichung(entity_ref("urn:de:bgb:sr-at:m03:s1")) { origin case_input; }
        assert "a8": ausgefallener_schuldner(entity_ref("urn:de:bgb:sr-at:m03:s1"), entity_ref("urn:de:bgb:sr-at:m03:p3")) { origin case_input; }
        assert "a9": ausgefallener_schuldner(entity_ref("urn:de:bgb:sr-at:m03:s1"), entity_ref("urn:de:bgb:sr-at:m03:p4")) { origin case_input; }
    }
    evaluate truth(zahl_der_ausgleichspflichtigen_schuldner(entity_ref("urn:de:bgb:sr-at:m03:s1"), 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ausgleichsanteil_nach_ausfall(entity_ref("urn:de:bgb:sr-at:m03:s1"), entity_ref("urn:de:bgb:sr-at:m03:p1"), 1 / 2));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ausgleichsanteil_nach_ausfall(entity_ref("urn:de:bgb:sr-at:m03:s1"), entity_ref("urn:de:bgb:sr-at:m03:p2"), 1 / 2));
    expect truth_status == TRUE_ONLY;
}
