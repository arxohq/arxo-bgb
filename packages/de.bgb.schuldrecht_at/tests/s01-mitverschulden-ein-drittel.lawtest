language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// §§ 249 Abs. 2, 252, 254 Abs. 1: Schaden 9 000,00 EUR, kein entgangener
// Gewinn geltend gemacht. Das Gericht hat ein Mitverschulden von einem Drittel
// festgestellt (Zähler 1, Nenner 3, Ledger D-04-05). Der Ersatz mindert sich
// um diesen Anteil: 9 000,00 × 2/3 = 6 000,00 EUR (eine Rundung auf den Cent).
test "§ 254 Abs. 1: Mitverschulden von einem Drittel mindert den Ersatz auf 6 000,00 EUR" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "a1": geschaedigter(entity_ref("urn:de:bgb:sr-at:s01:sch1"), entity_ref("urn:de:bgb:sr-at:s01:p1")) { origin case_input; }
        assert "a2": schadensbetrag(entity_ref("urn:de:bgb:sr-at:s01:sch1"), 9000.00 EUR) { origin case_input; }
        assert "a3": kein_entgangener_gewinn_geltend_gemacht(entity_ref("urn:de:bgb:sr-at:s01:sch1")) { origin case_input; }
        assert "j1": mitverschulden_anteil(entity_ref("urn:de:bgb:sr-at:s01:sch1"), entity_ref("urn:de:bgb:sr-at:s01:p1"), 1, 3) { origin adjudicated; }
    }
    evaluate truth(zu_ersetzender_schaden(entity_ref("urn:de:bgb:sr-at:s01:sch1"), 9000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ersatzbetrag_nach_mitverschulden(entity_ref("urn:de:bgb:sr-at:s01:sch1"), 6000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect judgment_requests(0);
}
