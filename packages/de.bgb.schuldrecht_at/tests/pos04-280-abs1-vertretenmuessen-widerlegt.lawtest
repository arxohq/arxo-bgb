language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// § 280 Abs. 1 Satz 2, andere Seite von pos03: dieselbe festgestellte
// Pflichtverletzung, aber der Schuldner hat gezeigt, dass er sie nicht zu
// vertreten hat (etwa höhere Gewalt) — ausdrücklich festgestellt. Die
// Vermutung greift nicht; ohne Vorsatz oder Fahrlässigkeit bleibt das
// Vertretenmüssen unbewiesen, und der Schadensersatzanspruch entfällt.
test "§ 280 Abs. 1 Satz 2: Vermutung widerlegt, kein Schadensersatz" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "f1": pflichtverletzung_festgestellt(entity_ref("urn:de:bgb:sr-at:pos04:s1"), entity_ref("urn:de:bgb:sr-at:pos04:p1")) { origin adjudicated; }
        assert "f2": schaden_aus_pflichtverletzung(entity_ref("urn:de:bgb:sr-at:pos04:s1"), entity_ref("urn:de:bgb:sr-at:pos04:sch1")) { origin case_input; }
        assert "f3": schuldner_hat_pflichtverletzung_nicht_zu_vertreten(entity_ref("urn:de:bgb:sr-at:pos04:s1"), entity_ref("urn:de:bgb:sr-at:pos04:p1")) { origin adjudicated; }
    }
    evaluate truth(hat_zu_vertreten_vermutet(entity_ref("urn:de:bgb:sr-at:pos04:p1"), entity_ref("urn:de:bgb:sr-at:pos04:s1")));
    expect truth_status == NEITHER;
    evaluate truth(schadensersatz_wegen_pflichtverletzung_vermutet(entity_ref("urn:de:bgb:sr-at:pos04:s1"), entity_ref("urn:de:bgb:sr-at:pos04:sch1"), entity_ref("urn:de:bgb:sr-at:pos04:p1")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
