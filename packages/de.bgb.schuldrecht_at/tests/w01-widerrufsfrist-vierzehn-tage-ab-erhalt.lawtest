language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// § 356 Abs. 2 Nr. 1 Buchstabe a mit § 355 Abs. 2 und §§ 187 Abs. 1, 188 Abs. 1:
// Der Verbraucher erhält die Ware am Freitag, dem 6. März 2026; der Tag des
// Erhalts zählt nicht mit, die 14 Tage laufen vom 7. bis zum 20. März 2026.
// Der 20. März ist ein Freitag und Werktag — keine Verlegung nach § 193.
// Der am letzten Tag abgesandte Widerruf ist fristgerecht (§ 355 Abs. 1 Satz 5).
test "§§ 355 Abs. 2, 356 Abs. 2: Widerrufsfrist endet am 20. März 2026, Widerruf am letzten Tag ist fristgerecht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_SCHULDRECHT_AT_TAG; }
        assert "a1": widerrufsrecht_eingeraeumt(entity_ref("urn:de:bgb:sr-at:w01:v1"), entity_ref("urn:de:bgb:sr-at:w01:p1")) { origin case_input; }
        assert "a2": verbraucher(entity_ref("urn:de:bgb:sr-at:w01:p1")) { origin case_input; }
        assert "a3": widerrufsfrist_des_vertrags(entity_ref("urn:de:bgb:sr-at:w01:v1"), entity_ref("urn:de:bgb:sr-at:w01:f1")) { origin case_input; }
        assert "a4": erhalt_der_ware(entity_ref("urn:de:bgb:sr-at:w01:v1"), @2026-03-06) { origin case_input; }
        assert "a5": keine_spaetere_unterrichtung(entity_ref("urn:de:bgb:sr-at:w01:v1")) { origin case_input; }
        assert "a6": widerruf_erklaert_am(entity_ref("urn:de:bgb:sr-at:w01:v1"), @2026-03-20) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sr-at:w01:f1"), @2026-03-20));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(widerruf_fristgerecht(entity_ref("urn:de:bgb:sr-at:w01:v1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(nicht_mehr_an_die_willenserklaerung_gebunden(entity_ref("urn:de:bgb:sr-at:w01:v1"), entity_ref("urn:de:bgb:sr-at:w01:p1")));
    expect truth_status == TRUE_ONLY;
}
