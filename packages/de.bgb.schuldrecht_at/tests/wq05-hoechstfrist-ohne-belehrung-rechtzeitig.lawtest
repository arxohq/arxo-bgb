language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// Querschnitt Widerruf/Fristen, § 356 Abs. 3 Satz 2: OHNE jede Unterrichtung
// nach Artikel 246a EGBGB läuft die Höchstfrist von zwölf Monaten und
// 14 Tagen dennoch ab dem in Absatz 2 genannten Zeitpunkt — kein Eingang zur
// Belehrung wird hier überhaupt gesetzt, und die Regel KalendarischesEnde-
// DerHoechstfrist liest nur `fristbeginn_des_widerrufs`, nicht die
// Unterrichtung. Zeitpunkt 6. März 2026; zwölf Monate führen auf den
// 6. März 2027, weitere 14 Tage auf Samstag, 20. März 2027 — von Hand
// geprüft, ebenso wie 21. März 2027 (Sonntag); der nächste Werktag ist
// Montag, 22. März 2027 (§ 193). Ein Widerruf am letzten Tag ist rechtzeitig:
// das Widerrufsrecht ist NICHT erloschen (NEITHER — das Recht verneint
// das Erlöschen nicht ausdrücklich, es schweigt mangels Verspätung).
// Verbraucher über die Brücke §§ 13/14; eigener Fall wegen der
// Kalenderpolitik (eine Politik je Fall, §168.2).
test "Querschnitt § 356 Abs. 3 Satz 2: Höchstfrist ohne jede Belehrung, rechtzeitiger Widerruf am letzten Tag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_SCHULDRECHT_AT_KALENDER; }
        assert "a1": widerrufsrecht_eingeraeumt(entity_ref("urn:de:bgb:sr-at:wq05:v1"), entity_ref("urn:de:bgb:sr-at:wq05:p1")) { origin case_input; }
        assert "a2": de.bgb.allgemeiner_teil::rechtssubjektart(entity_ref("urn:de:bgb:sr-at:wq05:p1"), de.bgb.allgemeiner_teil::Mensch) { origin case_input; }
        assert "a3": de.bgb.allgemeiner_teil::zweck_ueberwiegend_nicht_gewerblich(entity_ref("urn:de:bgb:sr-at:wq05:p1"), entity_ref("urn:de:bgb:sr-at:wq05:r1")) { origin adjudicated; }
        assert "a4": rechtsgeschaeft_des_vertrags(entity_ref("urn:de:bgb:sr-at:wq05:v1"), entity_ref("urn:de:bgb:sr-at:wq05:r1")) { origin case_input; }
        assert "a5": hoechstfrist_des_vertrags(entity_ref("urn:de:bgb:sr-at:wq05:v1"), entity_ref("urn:de:bgb:sr-at:wq05:h1")) { origin case_input; }
        assert "a6": fristbeginn_des_widerrufs(entity_ref("urn:de:bgb:sr-at:wq05:v1"), @2026-03-06) { origin case_input; }
        assert "a7": widerruf_erklaert_am(entity_ref("urn:de:bgb:sr-at:wq05:v1"), @2027-03-22) { origin case_input; }
    }
    evaluate truth(verbraucher(entity_ref("urn:de:bgb:sr-at:wq05:p1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(de.bgb.fristen::frist_ende_kalender(entity_ref("urn:de:bgb:sr-at:wq05:h1"), @2027-03-20));
    expect truth_status == TRUE_ONLY;
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sr-at:wq05:h1"), @2027-03-22));
    expect truth_status == TRUE_ONLY;
    evaluate truth(widerrufsrecht_erloschen(entity_ref("urn:de:bgb:sr-at:wq05:v1")));
    expect truth_status == NEITHER;
}
