language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// § 280 Abs. 1 Satz 2, Unvollständigkeit: dieselbe festgestellte
// Pflichtverletzung, aber KEINE Antwort dazu, ob der Schuldner sie zu
// vertreten hat oder nicht (§ 47.3, D-05-07: eine unbeantwortete `unless`
// einer `presumption`-Deklaration stellt die Urteilsfrage). Ohne Antwort
// bleibt das Vertretenmüssen offen.
test "§ 280 Abs. 1 Satz 2, Unvollständigkeit: ohne Antwort zur Ausnahme bleibt das Vertretenmüssen offen" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "f1": pflichtverletzung_festgestellt(entity_ref("urn:de:bgb:sr-at:pos05:s1"), entity_ref("urn:de:bgb:sr-at:pos05:p1")) { origin adjudicated; }
        assert "f2": schaden_aus_pflichtverletzung(entity_ref("urn:de:bgb:sr-at:pos05:s1"), entity_ref("urn:de:bgb:sr-at:pos05:sch1")) { origin case_input; }
    }
    evaluate truth(hat_zu_vertreten_vermutet(entity_ref("urn:de:bgb:sr-at:pos05:p1"), entity_ref("urn:de:bgb:sr-at:pos05:s1")));
    expect evaluation_status == REQUIRES_JUDGMENT;
}
