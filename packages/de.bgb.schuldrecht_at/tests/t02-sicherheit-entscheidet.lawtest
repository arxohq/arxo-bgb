language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// § 366 Abs. 2 Satz 1, Stufe 1: unter mehreren fälligen Schulden wird
// diejenige getilgt, welche dem Gläubiger geringere Sicherheit bietet.
// Die Wertung liegt als festgestellte Tatsache vor (origin adjudicated).
test "§ 366 Abs. 2 Stufe 1: die weniger gesicherte Schuld wird getilgt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "a1": mehrere_gleichartige_schulden(entity_ref("urn:de:bgb:sr-at:t02:schuldner"), entity_ref("urn:de:bgb:sr-at:t02:glaeubiger")) { origin case_input; }
        assert "a2": keine_tilgungsbestimmung(entity_ref("urn:de:bgb:sr-at:t02:schuldner"), entity_ref("urn:de:bgb:sr-at:t02:glaeubiger")) { origin case_input; }
        assert "a3": faellige_schuld(entity_ref("urn:de:bgb:sr-at:t02:a1")) { origin case_input; }
        assert "a4": faellige_schuld(entity_ref("urn:de:bgb:sr-at:t02:a2")) { origin case_input; }
        assert "a5": geringere_sicherheit_bietet(entity_ref("urn:de:bgb:sr-at:t02:a1"), entity_ref("urn:de:bgb:sr-at:t02:a2")) { origin adjudicated; }
    }
    evaluate truth(getilgte_schuld(entity_ref("urn:de:bgb:sr-at:t02:a1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(getilgte_schuld(entity_ref("urn:de:bgb:sr-at:t02:a2")));
    expect truth_status == NEITHER;
}
