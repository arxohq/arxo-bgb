language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// § 241 Abs. 1 mit § 362 Abs. 1: die Leistung ist am 10. Juni 2026 bewirkt
// worden — innerhalb des Pflichtfensters (Fälligkeit 1. Juni 2026 bis
// unbestimmt). Die Leistungspflicht ist SATISFIED (§ 136), und das
// Schuldverhältnis erlischt (§ 362 Abs. 1).
test "§ 241 Abs. 1 mit § 362 Abs. 1: bewirkte Leistung erfüllt die Pflicht" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "f1": leistung_aus_schuldverhaeltnis(entity_ref("urn:de:bgb:sr-at:pos02:l1"), entity_ref("urn:de:bgb:sr-at:pos02:s1")) { origin case_input; }
        assert "f2": de.bgb.core::schuldverhaeltnis_glaeubiger(entity_ref("urn:de:bgb:sr-at:pos02:s1"), entity_ref("urn:de:bgb:sr-at:pos02:g1")) { origin case_input; }
        assert "f3": de.bgb.core::schuldverhaeltnis_schuldner(entity_ref("urn:de:bgb:sr-at:pos02:s1"), entity_ref("urn:de:bgb:sr-at:pos02:sch1")) { origin case_input; }
        assert "f4": faelligkeit(entity_ref("urn:de:bgb:sr-at:pos02:l1"), @2026-06-01) { origin case_input; }
        assert "f5": leistung_bewirkt(entity_ref("urn:de:bgb:sr-at:pos02:l1"), @2026-06-10) { origin case_input; }
    }
    evaluate positions();
    expect position(LeistungAnDenGlaeubigerBewirken, SATISFIED);
    expect not position(LeistungAnDenGlaeubigerBewirken, VIOLATED);
    evaluate truth(erfuellt(entity_ref("urn:de:bgb:sr-at:pos02:l1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
