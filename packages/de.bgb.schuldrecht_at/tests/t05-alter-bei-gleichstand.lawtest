language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// § 366 Abs. 2 Satz 1, Stufe 3: bei gleicher Sicherheit und gleicher
// Lästigkeit wird die ältere Schuld getilgt. Das Alter ist keine Wertung,
// sondern der Tag der Entstehung — die Regel vergleicht die Daten direkt.
// a1 entstand am 1.3.2024, a2 am 1.3.2025: a1 ist älter und wird getilgt.
test "§ 366 Abs. 2 Stufe 3: bei Gleichstand entscheidet das Alter" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "a1": mehrere_gleichartige_schulden(entity_ref("urn:de:bgb:sr-at:t05:schuldner"), entity_ref("urn:de:bgb:sr-at:t05:glaeubiger")) { origin case_input; }
        assert "a2": keine_tilgungsbestimmung(entity_ref("urn:de:bgb:sr-at:t05:schuldner"), entity_ref("urn:de:bgb:sr-at:t05:glaeubiger")) { origin case_input; }
        assert "a3": faellige_schuld(entity_ref("urn:de:bgb:sr-at:t05:a1")) { origin case_input; }
        assert "a4": faellige_schuld(entity_ref("urn:de:bgb:sr-at:t05:a2")) { origin case_input; }
        assert "a5": gleiche_sicherheit(entity_ref("urn:de:bgb:sr-at:t05:a1"), entity_ref("urn:de:bgb:sr-at:t05:a2")) { origin case_input; }
        assert "a6": gleiche_laestigkeit(entity_ref("urn:de:bgb:sr-at:t05:a1"), entity_ref("urn:de:bgb:sr-at:t05:a2")) { origin case_input; }
        assert "a7": schuld_entstanden_am(entity_ref("urn:de:bgb:sr-at:t05:a1"), @2024-03-01) { origin case_input; }
        assert "a8": schuld_entstanden_am(entity_ref("urn:de:bgb:sr-at:t05:a2"), @2025-03-01) { origin case_input; }
    }
    evaluate truth(getilgte_schuld(entity_ref("urn:de:bgb:sr-at:t05:a1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(getilgte_schuld(entity_ref("urn:de:bgb:sr-at:t05:a2")));
    expect truth_status == NEITHER;
}
