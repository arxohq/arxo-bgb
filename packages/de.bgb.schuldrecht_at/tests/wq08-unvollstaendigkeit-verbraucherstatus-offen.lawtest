language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";
// Querschnitt Widerruf/Fristen, Unvollständigkeit: dieselben Fakten wie
// wq01, aber OHNE die Wertung `zweck_ueberwiegend_nicht_gewerblich` (Kanal
// § 47.3, external judgment relation) — das Gericht wurde nicht gefragt.
// Der Verbraucherstatus bleibt unbewiesen (NEITHER, wie br03); die 14-Tage-
// Rechnung selbst ist von dieser Wertung unabhängig (die Regeln der §§ 355,
// 356 lesen `widerrufsrecht_eingeraeumt`/`widerrufsfrist_des_vertrags`, nicht
// `verbraucher(p)`) und bleibt unverändert richtig — die Unvollständigkeit
// betrifft NUR die Querschnitts-Aussage „Verbraucher“, nicht die Frist.
test "Querschnitt, Unvollständigkeit: ohne Urteil über den Zweck bleibt der Verbraucherstatus offen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_SCHULDRECHT_AT_TAG; }
        assert "a1": widerrufsrecht_eingeraeumt(entity_ref("urn:de:bgb:sr-at:wq08:v1"), entity_ref("urn:de:bgb:sr-at:wq08:p1")) { origin case_input; }
        assert "a2": de.bgb.allgemeiner_teil::rechtssubjektart(entity_ref("urn:de:bgb:sr-at:wq08:p1"), de.bgb.allgemeiner_teil::Mensch) { origin case_input; }
        assert "a3": rechtsgeschaeft_des_vertrags(entity_ref("urn:de:bgb:sr-at:wq08:v1"), entity_ref("urn:de:bgb:sr-at:wq08:r1")) { origin case_input; }
        assert "a4": widerrufsfrist_des_vertrags(entity_ref("urn:de:bgb:sr-at:wq08:v1"), entity_ref("urn:de:bgb:sr-at:wq08:f1")) { origin case_input; }
        assert "a5": erhalt_der_ware(entity_ref("urn:de:bgb:sr-at:wq08:v1"), @2026-03-06) { origin case_input; }
        assert "a6": keine_spaetere_unterrichtung(entity_ref("urn:de:bgb:sr-at:wq08:v1")) { origin case_input; }
        assert "a7": widerruf_erklaert_am(entity_ref("urn:de:bgb:sr-at:wq08:v1"), @2026-03-20) { origin case_input; }
    }
    evaluate truth(verbraucher(entity_ref("urn:de:bgb:sr-at:wq08:p1")));
    expect truth_status == NEITHER;
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sr-at:wq08:f1"), @2026-03-20));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(widerruf_fristgerecht(entity_ref("urn:de:bgb:sr-at:wq08:v1")));
    expect truth_status == TRUE_ONLY;
}
