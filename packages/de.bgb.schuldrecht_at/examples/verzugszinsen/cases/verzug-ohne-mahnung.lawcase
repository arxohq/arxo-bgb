language "law.core" version "0.2";
package examples.de.bgb.verzugszinsen version "0.1.0";
namespace "urn:law:examples:de:bgb:verzugszinsen";

case VerzugOhneMahnung {
    context {
        deadline_policy examples.de.bgb.verzugszinsen::BGB_VERZUG_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-17;
        knowledge_time @2026-09-17T09:00:00Z;
        decision_time @2026-09-17T09:00:00Z;
        timezone "Europe/Berlin";
    }
    const a: de.bgb.core::Anspruch = entity_ref("urn:de:bgb:example:verzugszinsen:v05:a1");
    const l: de.bgb.schuldrecht_at::Leistung = entity_ref("urn:de:bgb:example:verzugszinsen:v05:l1");
    assert "kalenderzeit": de.bgb.schuldrecht_at::leistungszeit_nach_dem_kalender_bestimmt(l, @2026-08-01) { origin case_input; }
    assert "vertretbar": de.bgb.schuldrecht_at::leistung_unterbleibt_aus_zu_vertretendem_umstand(l) { origin case_input; }
    assert "geld": de.bgb.core::anspruch_geldbetrag(a, 10000.00 EUR) { origin case_input; }
    assert "verzug": de.bgb.schuldrecht_at::geldschuld_im_verzug(a, @2026-08-01) { origin case_input; }
    assert "verbraucher": de.bgb.schuldrecht_at::verbraucher_am_rechtsgeschaeft_beteiligt(a) { origin case_input; }
}
