language "law.core" version "0.2";
package examples.de.bgb.verzugszinsen version "0.1.0";
namespace "urn:law:examples:de:bgb:verzugszinsen";

case VerbraucherFuenfPunkte {
    context {
        deadline_policy examples.de.bgb.verzugszinsen::BGB_VERZUG_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-17;
        knowledge_time @2026-09-17T09:00:00Z;
        decision_time @2026-09-17T09:00:00Z;
        timezone "Europe/Berlin";
    }
    const a: de.bgb.core::Anspruch = entity_ref("urn:de:bgb:example:verzugszinsen:v01:a1");
    assert "betrag": de.bgb.core::anspruch_geldbetrag(a, 10000.00 EUR) { origin case_input; }
    assert "verzug": de.bgb.schuldrecht_at::geldschuld_im_verzug(a, @2026-06-01) { origin case_input; }
    assert "verbraucher": de.bgb.schuldrecht_at::verbraucher_am_rechtsgeschaeft_beteiligt(a) { origin case_input; }
}
