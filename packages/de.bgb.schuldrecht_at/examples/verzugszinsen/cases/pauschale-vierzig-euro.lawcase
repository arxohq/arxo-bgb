language "law.core" version "0.2";
package examples.de.bgb.verzugszinsen version "0.1.0";
namespace "urn:law:examples:de:bgb:verzugszinsen";

case PauschaleVierzigEuro {
    context {
        deadline_policy examples.de.bgb.verzugszinsen::BGB_VERZUG_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-17;
        knowledge_time @2026-09-17T09:00:00Z;
        decision_time @2026-09-17T09:00:00Z;
        timezone "Europe/Berlin";
    }
    const a: de.bgb.core::Anspruch = entity_ref("urn:de:bgb:example:verzugszinsen:v03:a1");
    const s: de.bgb.core::Schuldverhaeltnis = entity_ref("urn:de:bgb:example:verzugszinsen:v03:s1");
    const p: de.bgb.core::Person = entity_ref("urn:de:bgb:example:verzugszinsen:v03:p1");
    assert "entgelt": de.bgb.schuldrecht_at::entgeltforderung(a) { origin case_input; }
    assert "verzug": de.bgb.schuldrecht_at::geldschuld_im_verzug(a, @2026-08-01) { origin case_input; }
    assert "schuldverhaeltnis": de.bgb.core::anspruch_aus_schuldverhaeltnis(a, s) { origin case_input; }
    assert "schuldner": de.bgb.core::schuldverhaeltnis_schuldner(s, p) { origin case_input; }
    assert "unternehmer": de.bgb.schuldrecht_at::unternehmer(p) { origin case_input; }
    assert "betrag": de.bgb.core::anspruch_geldbetrag(a, 5000.00 EUR) { origin case_input; }
    assert "kosten": de.bgb.schuldrecht_at::schaden_in_kosten_der_rechtsverfolgung(a, 150.00 EUR) { origin case_input; }
}
