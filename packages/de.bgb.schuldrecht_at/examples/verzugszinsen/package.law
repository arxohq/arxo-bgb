language "law.core" version "0.2";
package examples.de.bgb.verzugszinsen version "0.1.0";
namespace "urn:law:examples:de:bgb:verzugszinsen";

import de.bgb.schuldrecht_at version "0.1.0";
import de.bgb.core version "0.1.0";

// §168.4: the collection owns its deadline policy; it does not extend the
// imported canon. The live calculator uses the same policy and calendar.
deadline policy BGB_VERZUG_KALENDER {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}
