language "law.core" version "0.2";
package examples.de.bgb.widerruf version "0.1.0";
namespace "urn:law:examples:de:bgb:widerruf";

case WiderrufNachSpaeterUnterrichtung {
    context {
        deadline_policy examples.de.bgb.widerruf::BGB_WIDERRUF_TAG;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-17;
        knowledge_time @2026-09-17T09:00:00Z;
        decision_time @2026-09-17T09:00:00Z;
        timezone "Europe/Berlin";
    }
    const v: de.bgb.schuldrecht_at::Vertrag = entity_ref("urn:de:bgb:example:widerruf:v05:v1");
    const p: de.bgb.core::Person = entity_ref("urn:de:bgb:example:widerruf:v05:p1");
    const f: de.bgb.schuldrecht_at::Widerrufsfrist = entity_ref("urn:de:bgb:example:widerruf:v05:f1");
    assert "recht": de.bgb.schuldrecht_at::widerrufsrecht_eingeraeumt(v, p) { origin case_input; }
    assert "verbraucher": de.bgb.schuldrecht_at::verbraucher(p) { origin case_input; }
    assert "frist": de.bgb.schuldrecht_at::widerrufsfrist_des_vertrags(v, f) { origin case_input; }
    assert "erhalt": de.bgb.schuldrecht_at::erhalt_der_ware(v, @2026-04-01) { origin case_input; }
        assert "spaetere-unterrichtung": de.bgb.schuldrecht_at::spaetere_unterrichtung(v) { origin case_input; }
        assert "unterrichtung": de.bgb.schuldrecht_at::unterrichtung_ueber_das_widerrufsrecht_am(v, @2026-04-10) { origin case_input; }
        assert "widerruf": de.bgb.schuldrecht_at::widerruf_erklaert_am(v, @2026-04-24) { origin case_input; }
}
