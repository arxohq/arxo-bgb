language "law.core" version "0.2";
package examples.de.bgb.widerruf version "0.1.0";
namespace "urn:law:examples:de:bgb:widerruf";

import de.bgb.schuldrecht_at version "0.1.0";
import de.bgb.core version "0.1.0";

// §168.4: the collection owns the one live policy used by the calculator.
deadline policy BGB_WIDERRUF_TAG {
    start_count next_day;
    include_end true;
    roll next_working_day;
}
