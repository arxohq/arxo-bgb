language "law.core" version "0.2";
package examples.de.bgb.rechtsbehelfe version "0.1.0";
namespace "urn:law:examples:de:bgb:rechtsbehelfe";

case Fristsetzung {
    context {
        deadline_policy examples.de.bgb.rechtsbehelfe::BGB_RECHTSBEHELFE_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-20;
        knowledge_time @2026-09-20T09:00:00Z;
        decision_time @2026-09-20T09:00:00Z;
        timezone "Europe/Berlin";
    }
    const v: de.bgb.schuldrecht_at::Vertrag = entity_ref("urn:de:bgb:example:rechtsbehelfe:frist:v");
    const l: de.bgb.schuldrecht_at::Leistung = entity_ref("urn:de:bgb:example:rechtsbehelfe:frist:l");
    const p: de.bgb.core::Person = entity_ref("urn:de:bgb:example:rechtsbehelfe:frist:p");
    assert "vertrag": de.bgb.schuldrecht_at::gegenseitiger_vertrag(v) { origin case_input; }
    assert "partei": de.bgb.schuldrecht_at::vertragspartei(v, p) { origin case_input; }
    assert "leistung": de.bgb.schuldrecht_at::leistung_aus_schuldverhaeltnis(l, v) { origin case_input; }
    assert "faellig": de.bgb.schuldrecht_at::faellige_leistung_nicht_oder_nicht_vertragsgemaess(v, l) { origin case_input; }
    assert "frist": de.bgb.schuldrecht_at::frist_zur_leistung_angemessen(l, @2026-09-10) { origin adjudicated; }
    assert "erfolglos": de.bgb.schuldrecht_at::frist_erfolglos_abgelaufen(l) { origin case_input; }
}
