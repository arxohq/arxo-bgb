language "law.core" version "0.2";
package examples.de.bgb.rechtsbehelfe version "0.1.0";
namespace "urn:law:examples:de:bgb:rechtsbehelfe";

case RuecktrittRueckgewaehr {
    context {
        deadline_policy examples.de.bgb.rechtsbehelfe::BGB_RECHTSBEHELFE_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-20;
        knowledge_time @2026-09-20T09:00:00Z;
        decision_time @2026-09-20T09:00:00Z;
        timezone "Europe/Berlin";
    }
    const v: de.bgb.schuldrecht_at::Vertrag = entity_ref("urn:de:bgb:example:rechtsbehelfe:rueck:v");
    const p: de.bgb.core::Person = entity_ref("urn:de:bgb:example:rechtsbehelfe:rueck:p");
    assert "vorbehalt": de.bgb.schuldrecht_at::vertragliches_ruecktrittsrecht_vorbehalten(v, p) { origin case_input; }
    assert "erklaerung": de.bgb.schuldrecht_at::ruecktritt_erklaert(v, p, @2026-09-20) { origin case_input; }
}
