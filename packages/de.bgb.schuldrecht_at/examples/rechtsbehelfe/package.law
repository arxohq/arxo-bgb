language "law.core" version "0.2";
package examples.de.bgb.rechtsbehelfe version "0.1.0";
namespace "urn:law:examples:de:bgb:rechtsbehelfe";

import de.bgb.schuldrecht_at version "0.1.0";

// §168.4: deadline policy belongs to this case collection.
deadline policy BGB_RECHTSBEHELFE_KALENDER {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}
