// ABSCHNITT 4 ERLÖSCHEN DER SCHULDVERHÄLTNISSE, §§ 362–397
//
// Erfüllung (§§ 362–371), Hinterlegung (§§ 372–386), Aufrechnung (§§ 387–396)
// und Erlass (§ 397).
//
// DIE DREISSIG JAHRE DES § 382 sind eine Jahresfrist vom Empfang der Anzeige
// von der Hinterlegung (§ 188 Abs. 2, Politik `BGB_SCHULDRECHT_AT_KALENDER`;
// Zeile in DEADLINES.json). Es ist die einzige Frist dieses Abschnitts.
//
// DIE EINREDE DER VERJÄHRUNG (§ 390) kommt aus dem Eigentümer der
// Fristenberechnung: `de.bgb.fristen::verjaehrung_eingetreten_am` sagt, ob und
// wann die Verjährung eingetreten ist; dieses Paket liest sie und schließt die
// Aufrechnung mit der einredebehafteten Forderung aus. § 215 (Aufrechnung trotz
// Verjährung, wenn die Forderungen sich unverjährt gegenüberstanden) gehört
// `de.bgb.fristen` und ist hier Grenze: der Fall gibt den Tag, an dem sich die
// Forderungen aufrechenbar gegenüberstanden, nicht dieses Paket.
//
// WERTUNGEN DES GERICHTS: die Unverzüglichkeit der Anzeige (§ 374 Abs. 2),
// der Benachrichtigung (§ 384 Abs. 2) und des Widerspruchs (§ 396 Abs. 1
// Satz 2) sowie die Untunlichkeit von Anzeige und Androhung (§ 374 Abs. 2
// Satz 2, § 384 Abs. 3).

language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";

// --- §§ 362–371 Erfüllung ------------------------------------------------------------------------

pub relation schuldverhaeltnis_erloschen(s: Schuldverhaeltnis) kind institutional {
    label de official "Das Schuldverhältnis ist erloschen (§ 362 Abs. 1, § 364 Abs. 1, § 378, § 389, § 397)";
    label en unofficial "the obligation is extinguished (§ 362 (1), § 364 (1), § 378, § 389, § 397)";
}
pub relation leistung_an_dritten_zum_zwecke_der_erfuellung(l: Leistung, dritter: Person) kind empirical {
    label de official "Es wird an einen Dritten zum Zwecke der Erfüllung geleistet; § 185 findet Anwendung (§ 362 Abs. 2)";
    label en unofficial "performance is rendered to a third party for the purpose of discharge; § 185 applies (§ 362 (2))";
}
pub relation als_erfuellung_angenommen(l: Leistung, glaeubiger: Person) kind empirical {
    label de official "Der Gläubiger hat eine ihm als Erfüllung angebotene Leistung als Erfüllung angenommen (§ 363)";
    label en unofficial "the creditor accepted as performance a performance offered as such (§ 363)";
}
pub relation beweislast_beim_glaeubiger(l: Leistung, glaeubiger: Person) kind institutional {
    label de official "Den Gläubiger trifft die Beweislast, wenn er die Leistung deshalb nicht als Erfüllung gelten lassen will, weil sie eine andere als die geschuldete oder unvollständig gewesen sei (§ 363)";
    label en unofficial "the creditor bears the burden of proof if he refuses to treat the performance as discharge (§ 363)";
}
pub relation andere_leistung_an_erfuellungs_statt_angenommen(s: Schuldverhaeltnis, l: Leistung) kind empirical {
    label de official "Der Gläubiger nimmt eine andere als die geschuldete Leistung an Erfüllungs statt an (§ 364 Abs. 1)";
    label en unofficial "the creditor accepts a performance other than that owed in lieu of performance (§ 364 (1))";
}
pub relation neue_verbindlichkeit_uebernommen(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Schuldner übernimmt zum Zwecke der Befriedigung des Gläubigers diesem gegenüber eine neue Verbindlichkeit (§ 364 Abs. 2)";
    label en unofficial "the debtor assumes a new obligation towards the creditor for the purpose of satisfying him (§ 364 (2))";
}
pub relation im_zweifel_nicht_an_erfuellungs_statt(s: Schuldverhaeltnis) kind institutional {
    label de official "Im Zweifel ist nicht anzunehmen, dass der Schuldner die neue Verbindlichkeit an Erfüllungs statt übernimmt (§ 364 Abs. 2)";
    label en unofficial "in case of doubt the new obligation is not assumed in lieu of performance (§ 364 (2))";
}
pub relation an_erfuellungs_statt_gegeben(s: Schuldverhaeltnis, sache: Sache) kind empirical {
    label de official "Eine Sache, eine Forderung gegen einen Dritten oder ein anderes Recht ist an Erfüllungs statt gegeben worden (§ 365)";
    label en unofficial "a thing, a claim against a third party or another right was given in lieu of performance (§ 365)";
}
pub relation gewaehrleistung_wie_ein_verkaeufer(s: Schuldverhaeltnis, sache: Sache) kind institutional {
    label de official "Der Schuldner hat wegen eines Mangels im Recht oder eines Mangels der Sache in gleicher Weise wie ein Verkäufer Gewähr zu leisten (§ 365)";
    label en unofficial "the debtor is liable for defects in title or in the thing in the same way as a seller (§ 365)";
}
pub relation mehrere_gleichartige_schulden(schuldner: Person, glaeubiger: Person) kind empirical {
    label de official "Der Schuldner ist dem Gläubiger aus mehreren Schuldverhältnissen zu gleichartigen Leistungen verpflichtet und das Geleistete reicht nicht zur Tilgung sämtlicher Schulden aus (§ 366 Abs. 1)";
    label en unofficial "the debtor owes the creditor similar performances under several obligations and what he rendered does not discharge all debts (§ 366 (1))";
}
pub relation tilgungsbestimmung_getroffen(schuldner: Person, a: Anspruch) kind empirical {
    label de official "Der Schuldner hat bei der Leistung bestimmt, welche Schuld getilgt werden soll (§ 366 Abs. 1)";
    label en unofficial "on performing, the debtor determined which debt is to be discharged (§ 366 (1))";
}
pub relation getilgte_schuld(a: Anspruch) kind institutional {
    label de official "Diese Schuld wird getilgt (§ 366 Abs. 1, 2)";
    label en unofficial "this debt is discharged (§ 366 (1), (2))";
}
pub relation keine_tilgungsbestimmung(schuldner: Person, glaeubiger: Person) kind empirical {
    label de official "Der Schuldner trifft keine Bestimmung (§ 366 Abs. 2) — ausdrückliche Angabe des Falls";
    label en unofficial "the debtor makes no determination (§ 366 (2)) — explicit case input";
}
pub relation faellige_schuld(a: Anspruch) kind empirical {
    label de official "Die Schuld ist fällig (§ 366 Abs. 2)";
    label en unofficial "the debt is due (§ 366 (2))";
}

// --- § 366 Abs. 2: Rangfolge unter MEHREREN fälligen Schulden --------------------------------------
//
// Ohne Bestimmung des Schuldners wird zunächst die fällige Schuld getilgt;
// stehen mehrere fällige Schulden nebeneinander, entscheidet die Stufenfolge
// des Satzes 1: geringere Sicherheit → größere Lästigkeit für den Schuldner →
// höheres Alter → bei Gleichstand in allen drei Merkmalen verhältnismäßige
// Tilgung. Sicherheit und Lästigkeit sind WERTUNGEN (§47.3-Kanal DECISION-0194,
// hier als festgestellte Tatsache `origin adjudicated` im Fall); eine Stufe,
// die NICHT unterscheidet, ist ein EIGENER positiver Fall-Eingang
// (`gleiche_sicherheit`, `gleiche_laestigkeit`), nicht das Schweigen der Akte
// (Grenzinvariante „Abwesenheit eines Fakts ≠ Verneinung“). Das Alter ist
// dagegen keine Wertung, sondern der Tag der Entstehung der Schuld — die
// Regeln vergleichen `Date`-Werte direkt (wie `de.bgb.schuldrecht_at`
// anderswo Fristenden vergleicht), keine Wertung, kein Eingriff in die Garde
// über ein berechnetes Prädikat. Die verhältnismäßige Tilgung folgt D-12-10
// (`de.bgb.ehe`): §58 kennt kein Produkt zweier Geldbeträge, wohl aber das
// Produkt von Geld mit einem `Integer` — Zähler und Nenner der Quote sind
// eigene Centbeträge des Falls, nicht die `Money`-Forderungsbeträge selbst.
//
// GRENZE DES SCHNITTS: die Stufenfolge ist für GENAU ZWEI konkurrierende
// fällige Schulden ausgeführt (Zeugen `t01`–`t05`); mit drei oder mehr
// konkurrierenden Schulden bräuchte jede Stufe ein Turnier über eine
// unbeschränkte Menge, das dieses Paket nicht modelliert (Muster D-04-05:
// „bis zu vier Schuldner“ bei § 426 — hier zwei Schulden als der Fall, der
// alle vier Stufen zeigt). `keine_konkurrierende_faellige_schuld` bleibt der
// eigene, positive Eingang für den Ein-Schuld-Fall.
pub relation keine_konkurrierende_faellige_schuld(a: Anspruch) kind empirical {
    label de official "Unter den fälligen Schulden nach § 366 Abs. 2 ist dies die einzige — ausdrückliche Angabe des Falls, keine Schlussfolgerung aus dem Schweigen der Akte";
    label en unofficial "among the debts due under § 366 (2) this is the only one — explicit case input, not an inference from the silence of the record";
}
pub relation geringere_sicherheit_bietet(a1: Anspruch, a2: Anspruch) kind empirical {
    label de official "Die Schuld a1 bietet dem Gläubiger geringere Sicherheit als die Schuld a2 (§ 366 Abs. 2) — Wertung, im Fall festgestellte Tatsache (origin adjudicated)";
    label en unofficial "debt a1 offers the creditor less security than debt a2 (§ 366 (2)) — evaluative, an adjudicated fact of the case";
}
pub relation gleiche_sicherheit(a1: Anspruch, a2: Anspruch) kind empirical {
    label de official "Die Schulden a1 und a2 bieten dem Gläubiger gleiche Sicherheit (§ 366 Abs. 2) — ausdrückliche Angabe, dass diese Stufe nicht unterscheidet";
    label en unofficial "debts a1 and a2 offer the creditor equal security (§ 366 (2)) — explicit input that this stage does not distinguish";
}
pub relation laestigere_fuer_den_schuldner(a1: Anspruch, a2: Anspruch) kind empirical {
    label de official "Die Schuld a1 ist für den Schuldner lästiger als die Schuld a2 (§ 366 Abs. 2) — Wertung, im Fall festgestellte Tatsache (origin adjudicated)";
    label en unofficial "debt a1 is more onerous for the debtor than debt a2 (§ 366 (2)) — evaluative, an adjudicated fact of the case";
}
pub relation gleiche_laestigkeit(a1: Anspruch, a2: Anspruch) kind empirical {
    label de official "Die Schulden a1 und a2 sind für den Schuldner gleich lästig (§ 366 Abs. 2) — ausdrückliche Angabe, dass diese Stufe nicht unterscheidet";
    label en unofficial "debts a1 and a2 are equally onerous for the debtor (§ 366 (2)) — explicit input that this stage does not distinguish";
}
pub relation schuld_entstanden_am(a: Anspruch, tag: Date) kind empirical {
    key(a);
    label de official "Tag, an dem diese Schuld entstanden ist — das Alter der Schuld im Sinne des § 366 Abs. 2";
    label en unofficial "day on which this debt arose — the age of the debt within the meaning of § 366 (2)";
}
pub relation schuldbetrag_in_cent(a: Anspruch, cent: Integer) kind empirical {
    label de official "Betrag dieser Schuld in Cent — Zähler bzw. Summand des Nenners der Quote der verhältnismäßigen Tilgung (§ 366 Abs. 2 letzter Halbsatz); §58 kennt kein Produkt zweier Geldbeträge, wohl aber das Produkt von Geld mit einem Integer (Muster D-12-10)";
    label en unofficial "amount of this debt in cents — numerator resp. summand of the denominator of the proportion (§ 366 (2)); §58 knows no product of two money amounts but does know money times an integer (pattern D-12-10)";
}
pub relation gezahlter_betrag_zur_verteilung(schuldner: Person, glaeubiger: Person, betrag: Money) kind empirical {
    label de official "Betrag der Leistung, die bei gleichem Alter nach § 366 Abs. 2 letzter Halbsatz verhältnismäßig zu verteilen ist";
    label en unofficial "amount of the performance to be apportioned proportionally under § 366 (2) where the debts are of equal age";
}
pub relation verhaeltnismaessige_tilgung(a: Anspruch, betrag: Money) kind institutional {
    label de official "Bei gleichem Alter wird jede Schuld verhältnismäßig getilgt (§ 366 Abs. 2 letzter Halbsatz) — der auf diese Schuld entfallende Anteil der Leistung";
    label en unofficial "at equal age each debt is discharged proportionally (§ 366 (2)) — the share of the performance credited to this debt";
}
pub relation zinsen_und_kosten_geschuldet(a: Anspruch, kosten: Money, zinsen: Money) kind empirical {
    key(a);
    label de official "Der Schuldner hat außer der Hauptleistung Zinsen und Kosten zu entrichten (§ 367 Abs. 1)";
    label en unofficial "besides the principal the debtor owes interest and costs (§ 367 (1))";
}
pub relation geleisteter_betrag(a: Anspruch, betrag: Money) kind empirical {
    key(a);
    label de official "Betrag der zur Tilgung der ganzen Schuld nicht ausreichenden Leistung (§ 367 Abs. 1)";
    label en unofficial "amount rendered which does not discharge the whole debt (§ 367 (1))";
}
pub relation anrechnung_zuerst_auf_kosten_dann_zinsen(a: Anspruch, aufHauptleistung: Money) kind institutional {
    key(a);
    label de official "Eine zur Tilgung der ganzen Schuld nicht ausreichende Leistung wird zunächst auf die Kosten, dann auf die Zinsen und zuletzt auf die Hauptleistung angerechnet (§ 367 Abs. 1) — der auf die Hauptleistung entfallende Rest";
    label en unofficial "a partial payment is credited first to costs, then interest, lastly the principal (§ 367 (1)) — the remainder credited to the principal";
}
pub relation andere_anrechnung_bestimmt(a: Anspruch) kind empirical {
    label de official "Der Schuldner bestimmt eine andere Anrechnung (§ 367 Abs. 2)";
    label en unofficial "the debtor determines a different application (§ 367 (2))";
}
pub relation annahme_der_leistung_ablehnbar(a: Anspruch, glaeubiger: Person) kind institutional {
    label de official "Der Gläubiger kann die Annahme der Leistung ablehnen (§ 367 Abs. 2)";
    label en unofficial "the creditor may refuse to accept the performance (§ 367 (2))";
}
pub relation quittung_verlangt(l: Leistung, schuldner: Person) kind empirical {
    label de official "Der Schuldner verlangt gegen Empfang der Leistung ein schriftliches Empfangsbekenntnis (§ 368 Satz 1)";
    label en unofficial "the debtor demands a written receipt upon performance (§ 368 sentence 1)";
}
pub relation quittung_zu_erteilen(l: Leistung, glaeubiger: Person) kind institutional {
    label de official "Der Gläubiger hat gegen Empfang der Leistung auf Verlangen eine Quittung zu erteilen; bei rechtlichem Interesse in anderer Form (§ 368)";
    label en unofficial "the creditor must give a receipt on demand; in another form where the debtor has a legal interest (§ 368)";
}
pub relation kosten_der_quittung_traegt_der_schuldner(l: Leistung, schuldner: Person) kind institutional {
    label de official "Die Kosten der Quittung hat der Schuldner zu tragen und vorzuschießen, sofern nicht aus dem Rechtsverhältnis sich ein anderes ergibt (§ 369 Abs. 1)";
    label en unofficial "the debtor bears and advances the costs of the receipt unless the relationship provides otherwise (§ 369 (1))";
}
pub relation mehrere_glaeubiger_nach_uebertragung_oder_erbfolge(l: Leistung) kind empirical {
    label de official "Infolge einer Übertragung der Forderung oder im Wege der Erbfolge treten an die Stelle des ursprünglichen Gläubigers mehrere Gläubiger (§ 369 Abs. 2)";
    label en unofficial "several creditors replace the original creditor by assignment or succession (§ 369 (2))";
}
pub relation mehrkosten_fallen_den_glaeubigern_zur_last(l: Leistung) kind institutional {
    label de official "Die Mehrkosten fallen den Gläubigern zur Last (§ 369 Abs. 2)";
    label en unofficial "the additional costs are borne by the creditors (§ 369 (2))";
}
pub relation ueberbringer_einer_quittung(l: Leistung, ueberbringer: Person) kind empirical {
    label de official "Diese Person ist Überbringer einer Quittung (§ 370)";
    label en unofficial "this person is the bearer of a receipt (§ 370)";
}
pub relation umstaende_stehen_der_ermaechtigung_entgegen(l: Leistung) kind empirical {
    label de official "Die dem Leistenden bekannten Umstände stehen der Annahme einer Ermächtigung entgegen (§ 370 Halbsatz 2)";
    label en unofficial "circumstances known to the performing party preclude assuming authorisation (§ 370)";
}
pub relation keine_entgegenstehenden_umstaende(l: Leistung) kind empirical {
    label de official "Der Annahme einer Ermächtigung stehen keine dem Leistenden bekannten Umstände entgegen (§ 370) — ausdrückliche Angabe des Falls";
    label en unofficial "no circumstances known to the performing party preclude the authorisation (§ 370) — explicit case input";
}
pub relation gilt_als_zum_empfang_ermaechtigt(l: Leistung, ueberbringer: Person) kind institutional {
    label de official "Der Überbringer einer Quittung gilt als ermächtigt, die Leistung zu empfangen (§ 370)";
    label en unofficial "the bearer of a receipt is deemed authorised to receive the performance (§ 370)";
}
pub relation schuldschein_ausgestellt(a: Anspruch) kind empirical {
    label de official "Über die Forderung ist ein Schuldschein ausgestellt worden (§ 371 Satz 1)";
    label en unofficial "a certificate of indebtedness was issued for the claim (§ 371 sentence 1)";
}
pub relation rueckgabe_des_schuldscheins_verlangbar(a: Anspruch, schuldner: Person) kind institutional {
    label de official "Der Schuldner kann neben der Quittung Rückgabe des Schuldscheins verlangen; bei behaupteter Unmöglichkeit das öffentlich beglaubigte Anerkenntnis des Erlöschens (§ 371)";
    label en unofficial "the debtor may demand return of the certificate besides the receipt; if return is impossible, a publicly certified acknowledgement (§ 371)";
}

@source(BGB_P362)
rule ErloeschenDurchLeistung(s: Schuldverhaeltnis, l: Leistung, tag: Date) strict {
    label de official "Das Schuldverhältnis erlischt, wenn die geschuldete Leistung an den Gläubiger bewirkt wird (§ 362 Abs. 1)";
    label en unofficial "The obligation is extinguished when the performance owed is rendered to the creditor (§ 362 (1))";
    when leistung_aus_schuldverhaeltnis(l, s);
    when leistung_bewirkt(l, tag);
    then schuldverhaeltnis_erloschen(s);
}

@source(BGB_P363)
rule BeweislastNachAnnahmeAlsErfuellung(l: Leistung, glaeubiger: Person) strict {
    label de official "Hat der Gläubiger eine ihm als Erfüllung angebotene Leistung als Erfüllung angenommen, so trifft ihn die Beweislast, wenn er die Leistung deshalb nicht als Erfüllung gelten lassen will, weil sie eine andere als die geschuldete oder unvollständig gewesen sei (§ 363)";
    label en unofficial "Where the creditor accepted a performance as discharge, he bears the burden of proof if he later denies it (§ 363)";
    when als_erfuellung_angenommen(l, glaeubiger);
    then beweislast_beim_glaeubiger(l, glaeubiger);
}

@source(BGB_P364)
rule AnnahmeAnErfuellungsStatt(s: Schuldverhaeltnis, l: Leistung) strict {
    label de official "Das Schuldverhältnis erlischt, wenn der Gläubiger eine andere als die geschuldete Leistung an Erfüllungs statt annimmt (§ 364 Abs. 1)";
    label en unofficial "The obligation is extinguished if the creditor accepts a performance other than that owed in lieu of performance (§ 364 (1))";
    when andere_leistung_an_erfuellungs_statt_angenommen(s, l);
    then schuldverhaeltnis_erloschen(s);
}

@source(BGB_P364)
rule NeueVerbindlichkeitImZweifelNichtAnErfuellungsStatt(s: Schuldverhaeltnis) strict {
    label de official "Übernimmt der Schuldner zum Zwecke der Befriedigung des Gläubigers diesem gegenüber eine neue Verbindlichkeit, so ist im Zweifel nicht anzunehmen, dass er die Verbindlichkeit an Erfüllungs statt übernimmt (§ 364 Abs. 2)";
    label en unofficial "Where the debtor assumes a new obligation to satisfy the creditor, it is presumed not to be in lieu of performance (§ 364 (2))";
    when neue_verbindlichkeit_uebernommen(s);
    then im_zweifel_nicht_an_erfuellungs_statt(s);
}

@source(BGB_P365)
rule GewaehrleistungBeiHingabeAnErfuellungsStatt(s: Schuldverhaeltnis, sache: Sache) strict {
    label de official "Wird eine Sache, eine Forderung gegen einen Dritten oder ein anderes Recht an Erfüllungs statt gegeben, so hat der Schuldner wegen eines Mangels im Recht oder wegen eines Mangels der Sache in gleicher Weise wie ein Verkäufer Gewähr zu leisten (§ 365)";
    label en unofficial "Where a thing or right is given in lieu of performance, the debtor is liable for defects like a seller (§ 365)";
    when an_erfuellungs_statt_gegeben(s, sache);
    then gewaehrleistung_wie_ein_verkaeufer(s, sache);
}

@source(BGB_P366)
rule TilgungNachBestimmungDesSchuldners(schuldner: Person, glaeubiger: Person, a: Anspruch) strict {
    label de official "Ist der Schuldner dem Gläubiger aus mehreren Schuldverhältnissen zu gleichartigen Leistungen verpflichtet und reicht das Geleistete nicht zur Tilgung sämtlicher Schulden aus, so wird diejenige Schuld getilgt, welche er bei der Leistung bestimmt (§ 366 Abs. 1)";
    label en unofficial "Where several similar debts exist and the payment does not cover all, the debt the debtor designates is discharged (§ 366 (1))";
    when mehrere_gleichartige_schulden(schuldner, glaeubiger);
    when tilgungsbestimmung_getroffen(schuldner, a);
    then getilgte_schuld(a);
}

@source(BGB_P366)
rule TilgungDerEinzigenFaelligenSchuld(schuldner: Person, glaeubiger: Person, a: Anspruch) strict {
    label de official "Trifft der Schuldner keine Bestimmung, so wird zunächst die fällige Schuld getilgt (§ 366 Abs. 2 Satz 1) — hier die einzige fällige Schuld, ohne Konkurrenz einer zweiten";
    label en unofficial "Without a designation the debt due is discharged first (§ 366 (2) sentence 1) — here the only debt due, without a competing second one";
    when mehrere_gleichartige_schulden(schuldner, glaeubiger);
    when keine_tilgungsbestimmung(schuldner, glaeubiger);
    when faellige_schuld(a);
    when keine_konkurrierende_faellige_schuld(a);
    then getilgte_schuld(a);
}

@source(BGB_P366)
rule TilgungNachGeringererSicherheit(schuldner: Person, glaeubiger: Person, a1: Anspruch, a2: Anspruch) strict {
    label de official "Unter mehreren fälligen Schulden wird diejenige getilgt, welche dem Gläubiger geringere Sicherheit bietet (§ 366 Abs. 2 Satz 1, Stufe 1)";
    label en unofficial "Among several debts due, the one offering the creditor less security is discharged (§ 366 (2) sentence 1, stage 1)";
    when mehrere_gleichartige_schulden(schuldner, glaeubiger);
    when keine_tilgungsbestimmung(schuldner, glaeubiger);
    when faellige_schuld(a1);
    when faellige_schuld(a2);
    when geringere_sicherheit_bietet(a1, a2);
    then getilgte_schuld(a1);
}

@source(BGB_P366)
rule TilgungNachLaestigkeitBeiGleicherSicherheit(schuldner: Person, glaeubiger: Person, a1: Anspruch, a2: Anspruch) strict {
    label de official "Unter mehreren gleich sicheren Schulden wird die für den Schuldner lästigere getilgt (§ 366 Abs. 2 Satz 1, Stufe 2)";
    label en unofficial "Among equally secured debts, the more onerous one for the debtor is discharged (§ 366 (2) sentence 1, stage 2)";
    when mehrere_gleichartige_schulden(schuldner, glaeubiger);
    when keine_tilgungsbestimmung(schuldner, glaeubiger);
    when faellige_schuld(a1);
    when faellige_schuld(a2);
    when gleiche_sicherheit(a1, a2);
    when laestigere_fuer_den_schuldner(a1, a2);
    then getilgte_schuld(a1);
}

@source(BGB_P366)
rule TilgungNachAlterBeiGleicherSicherheitUndLaestigkeit(schuldner: Person, glaeubiger: Person, a1: Anspruch, a2: Anspruch, tag1: Date, tag2: Date) strict {
    label de official "Unter mehreren gleich sicheren und gleich lästigen Schulden wird die ältere getilgt (§ 366 Abs. 2 Satz 1, Stufe 3)";
    label en unofficial "Among equally secured and equally onerous debts, the older one is discharged (§ 366 (2) sentence 1, stage 3)";
    when mehrere_gleichartige_schulden(schuldner, glaeubiger);
    when keine_tilgungsbestimmung(schuldner, glaeubiger);
    when faellige_schuld(a1);
    when faellige_schuld(a2);
    when gleiche_sicherheit(a1, a2);
    when gleiche_laestigkeit(a1, a2);
    when schuld_entstanden_am(a1, tag1);
    when schuld_entstanden_am(a2, tag2);
    when tag1 < tag2;
    then getilgte_schuld(a1);
}

@source(BGB_P366)
rule VerhaeltnismaessigeTilgungBeiGleichemAlter(schuldner: Person, glaeubiger: Person, a1: Anspruch, a2: Anspruch, tag: Date, cent1: Integer, cent2: Integer, zahlung: Money) strict {
    label de official "Bei gleichem Alter wird jede Schuld verhältnismäßig getilgt (§ 366 Abs. 2 Satz 1, Stufe 4) — Anteil dieser Schuld an der zu verteilenden Leistung";
    label en unofficial "At equal age each debt is discharged proportionally (§ 366 (2) sentence 1, stage 4) — the share of this debt in the performance to be apportioned";
    when mehrere_gleichartige_schulden(schuldner, glaeubiger);
    when keine_tilgungsbestimmung(schuldner, glaeubiger);
    when faellige_schuld(a1);
    when faellige_schuld(a2);
    when gleiche_sicherheit(a1, a2);
    when gleiche_laestigkeit(a1, a2);
    when schuld_entstanden_am(a1, tag);
    when schuld_entstanden_am(a2, tag);
    when schuldbetrag_in_cent(a1, cent1);
    when schuldbetrag_in_cent(a2, cent2);
    when gezahlter_betrag_zur_verteilung(schuldner, glaeubiger, zahlung);
    then verhaeltnismaessige_tilgung(a1, div_round(zahlung * cent1, (cent1 + cent2) * 1.0, 2, "HALF_UP"));
}

@source(BGB_P367)
rule AnrechnungAufKostenZinsenUndHauptleistung(a: Anspruch, betrag: Money, kosten: Money, zinsen: Money) strict {
    label de official "Hat der Schuldner außer der Hauptleistung Zinsen und Kosten zu entrichten, so wird eine zur Tilgung der ganzen Schuld nicht ausreichende Leistung zunächst auf die Kosten, dann auf die Zinsen und zuletzt auf die Hauptleistung angerechnet (§ 367 Abs. 1)";
    label en unofficial "Where interest and costs are owed besides the principal, a partial payment is credited first to costs, then interest, lastly the principal (§ 367 (1))";
    when zinsen_und_kosten_geschuldet(a, kosten, zinsen);
    when geleisteter_betrag(a, betrag);
    then anrechnung_zuerst_auf_kosten_dann_zinsen(a, betrag - kosten - zinsen);
}

@source(BGB_P367)
rule AblehnungBeiAbweichenderAnrechnung(a: Anspruch, s: Schuldverhaeltnis, glaeubiger: Person) strict {
    label de official "Bestimmt der Schuldner eine andere Anrechnung, so kann der Gläubiger die Annahme der Leistung ablehnen (§ 367 Abs. 2)";
    label en unofficial "If the debtor determines a different application, the creditor may refuse to accept the performance (§ 367 (2))";
    when andere_anrechnung_bestimmt(a);
    when de.bgb.core::anspruch_aus_schuldverhaeltnis(a, s);
    when de.bgb.core::schuldverhaeltnis_glaeubiger(s, glaeubiger);
    then annahme_der_leistung_ablehnbar(a, glaeubiger);
}

@source(BGB_P368)
rule QuittungAufVerlangen(l: Leistung, s: Schuldverhaeltnis, schuldner: Person, glaeubiger: Person, tag: Date) strict {
    label de official "Der Gläubiger hat gegen Empfang der Leistung auf Verlangen ein schriftliches Empfangsbekenntnis (Quittung) zu erteilen (§ 368 Satz 1)";
    label en unofficial "The creditor must give a written receipt on demand upon receiving performance (§ 368 sentence 1)";
    when leistung_aus_schuldverhaeltnis(l, s);
    when leistung_bewirkt(l, tag);
    when quittung_verlangt(l, schuldner);
    when de.bgb.core::schuldverhaeltnis_glaeubiger(s, glaeubiger);
    then quittung_zu_erteilen(l, glaeubiger);
}

@source(BGB_P369)
rule KostenDerQuittung(l: Leistung, s: Schuldverhaeltnis, schuldner: Person, glaeubiger: Person) strict {
    label de official "Die Kosten der Quittung hat der Schuldner zu tragen und vorzuschießen, sofern nicht aus dem zwischen ihm und dem Gläubiger bestehenden Rechtsverhältnis sich ein anderes ergibt (§ 369 Abs. 1)";
    label en unofficial "The debtor bears and advances the costs of the receipt unless the relationship provides otherwise (§ 369 (1))";
    when quittung_zu_erteilen(l, glaeubiger);
    when leistung_aus_schuldverhaeltnis(l, s);
    when de.bgb.core::schuldverhaeltnis_schuldner(s, schuldner);
    then kosten_der_quittung_traegt_der_schuldner(l, schuldner);
}

@source(BGB_P369)
rule MehrkostenBeiMehrerenGlaeubigern(l: Leistung, glaeubiger: Person) strict {
    label de official "Treten infolge einer Übertragung der Forderung oder im Wege der Erbfolge an die Stelle des ursprünglichen Gläubigers mehrere Gläubiger, so fallen die Mehrkosten den Gläubigern zur Last (§ 369 Abs. 2)";
    label en unofficial "Where several creditors replace the original creditor, the additional costs fall on them (§ 369 (2))";
    when quittung_zu_erteilen(l, glaeubiger);
    when mehrere_glaeubiger_nach_uebertragung_oder_erbfolge(l);
    then mehrkosten_fallen_den_glaeubigern_zur_last(l);
}

@source(BGB_P370)
rule UeberbringerDerQuittungGiltAlsErmaechtigt(l: Leistung, ueberbringer: Person) strict {
    label de official "Der Überbringer einer Quittung gilt als ermächtigt, die Leistung zu empfangen, sofern nicht die dem Leistenden bekannten Umstände der Annahme einer solchen Ermächtigung entgegenstehen (§ 370)";
    label en unofficial "The bearer of a receipt is deemed authorised to receive the performance unless known circumstances preclude it (§ 370)";
    when ueberbringer_einer_quittung(l, ueberbringer);
    when keine_entgegenstehenden_umstaende(l);
    then gilt_als_zum_empfang_ermaechtigt(l, ueberbringer);
}

@source(BGB_P371)
rule RueckgabeDesSchuldscheins(a: Anspruch, s: Schuldverhaeltnis, schuldner: Person) strict {
    label de official "Ist über die Forderung ein Schuldschein ausgestellt worden, so kann der Schuldner neben der Quittung Rückgabe des Schuldscheins verlangen (§ 371 Satz 1)";
    label en unofficial "Where a certificate of indebtedness was issued, the debtor may demand its return besides the receipt (§ 371 sentence 1)";
    when schuldschein_ausgestellt(a);
    when de.bgb.core::anspruch_aus_schuldverhaeltnis(a, s);
    when de.bgb.core::schuldverhaeltnis_schuldner(s, schuldner);
    then rueckgabe_des_schuldscheins_verlangbar(a, schuldner);
}

// --- §§ 372–386 Hinterlegung ---------------------------------------------------------------------------

pub entity Hinterlegung {
    label de official "Hinterlegung bei einer dazu bestimmten öffentlichen Stelle (§ 372)";
    label en unofficial "deposit with a public body designated for the purpose (§ 372)";
}
pub relation hinterlegungsfaehiger_gegenstand(s: Schuldverhaeltnis) kind empirical {
    label de official "Geschuldet sind Geld, Wertpapiere, sonstige Urkunden oder Kostbarkeiten (§ 372 Satz 1)";
    label en unofficial "money, securities, other documents or valuables are owed (§ 372 sentence 1)";
}
pub relation ungewissheit_ueber_die_person_des_glaeubigers(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Schuldner kann aus einem anderen in der Person des Gläubigers liegenden Grund oder infolge einer nicht auf Fahrlässigkeit beruhenden Ungewissheit über die Person des Gläubigers seine Verbindlichkeit nicht oder nicht mit Sicherheit erfüllen (§ 372 Satz 2)";
    label en unofficial "the debtor cannot perform with certainty for a reason in the creditor's person or through non-negligent uncertainty about who the creditor is (§ 372 sentence 2)";
}
pub relation hinterlegung_zulaessig(s: Schuldverhaeltnis) kind institutional {
    label de official "Der Schuldner kann für den Gläubiger hinterlegen (§ 372)";
    label en unofficial "the debtor may deposit for the creditor (§ 372)";
}
pub relation hinterlegung_des_schuldverhaeltnisses(s: Schuldverhaeltnis, h: Hinterlegung) kind empirical {
    key(s);
    label de official "Hinterlegung, die für dieses Schuldverhältnis vorgenommen worden ist";
    label en unofficial "deposit made for this obligation";
}
pub relation empfang_der_hinterlegungsanzeige(h: Hinterlegung, tag: Date) kind empirical {
    key(h);
    label de official "Tag des Empfangs der Anzeige von der Hinterlegung (§ 382)";
    label en unofficial "day of receipt of the notice of deposit (§ 382)";
}
pub relation glaeubiger_meldet_sich_am(h: Hinterlegung, tag: Date) kind empirical {
    key(h);
    label de official "Tag, an dem der Gläubiger sich bei der Hinterlegungsstelle meldet (§ 382)";
    label en unofficial "day on which the creditor contacts the depositary (§ 382)";
}
pub relation recht_des_glaeubigers_auf_den_hinterlegten_betrag_erloschen(h: Hinterlegung) kind institutional {
    label de official "Das Recht des Gläubigers auf den hinterlegten Betrag erlischt mit dem Ablauf von 30 Jahren nach dem Empfang der Anzeige von der Hinterlegung, wenn der Gläubiger sich nicht vorher meldet (§ 382)";
    label en unofficial "the creditor's right to the deposited amount lapses 30 years after receipt of the notice unless he contacts the depositary earlier (§ 382)";
}
pub relation hinterlegung_am_leistungsort(h: Hinterlegung) kind empirical {
    label de official "Die Hinterlegung ist bei der Hinterlegungsstelle des Leistungsorts erfolgt (§ 374 Abs. 1 Satz 1)";
    label en unofficial "the deposit was made with the depositary of the place of performance (§ 374 (1) sentence 1)";
}
pub relation hinterlegung_bei_anderer_stelle(h: Hinterlegung) kind empirical {
    label de official "Der Schuldner hat bei einer anderen Stelle hinterlegt (§ 374 Abs. 1 Halbsatz 2)";
    label en unofficial "the debtor deposited with another body (§ 374 (1))";
}
pub relation schadensersatz_wegen_hinterlegungsortes(h: Hinterlegung) kind institutional {
    label de official "Der Schuldner hat dem Gläubiger den daraus entstehenden Schaden zu ersetzen (§ 374 Abs. 1 Halbsatz 2)";
    label en unofficial "the debtor must compensate the resulting damage (§ 374 (1))";
}
@source(BGB_P374)
pub external judgment relation anzeige_der_hinterlegung_unterlassen_und_tunlich(h: Hinterlegung) {
    authority Court;
    label de official "§ 374 Abs. 2. Das Gericht hat festgestellt, dass der Schuldner die unverzügliche Anzeige der Hinterlegung unterlassen hat, obwohl sie nicht untunlich war";
    label en unofficial "§ 374 (2). The court found that the debtor omitted the prompt notice of deposit although it was not impracticable";
}
pub relation schadensersatz_wegen_unterlassener_anzeige(h: Hinterlegung) kind institutional {
    label de official "Im Falle der Unterlassung der Anzeige ist der Schuldner zum Schadensersatz verpflichtet (§ 374 Abs. 2 Satz 1)";
    label en unofficial "if the notice is omitted the debtor is liable in damages (§ 374 (2) sentence 1)";
}
pub relation sache_durch_die_post_uebersendet_am(h: Hinterlegung, tag: Date) kind empirical {
    key(h);
    label de official "Tag der Aufgabe der hinterlegten Sache zur Post (§ 375)";
    label en unofficial "day on which the deposited thing was posted (§ 375)";
}
pub relation hinterlegung_wirkt_zurueck_auf(h: Hinterlegung, tag: Date) kind institutional {
    key(h);
    label de official "Die Hinterlegung wirkt auf die Zeit der Aufgabe der Sache zur Post zurück (§ 375)";
    label en unofficial "the deposit takes effect retroactively from the time of posting (§ 375)";
}
pub enum RuecknahmeAusschlussgrund {
    label de official "Grund, aus dem die Rücknahme ausgeschlossen ist (§ 376 Abs. 2)";
    label en unofficial "ground excluding the right to reclaim (§ 376 (2))";
    VerzichtDesSchuldners,
    AnnahmeerklaerungDesGlaeubigers,
    RechtskraeftigesUrteil
}
pub relation ruecknahmeausschluss(h: Hinterlegung, grund: RuecknahmeAusschlussgrund) kind empirical {
    label de official "Einer der Gründe des § 376 Abs. 2 liegt vor";
    label en unofficial "one of the grounds of § 376 (2) exists";
}
pub relation ruecknahme_ausgeschlossen(h: Hinterlegung) kind institutional {
    label de official "Die Rücknahme der hinterlegten Sache ist ausgeschlossen (§ 376 Abs. 2)";
    label en unofficial "reclaiming the deposited thing is excluded (§ 376 (2))";
}
pub relation ruecknahmerecht(h: Hinterlegung, schuldner: Person) kind institutional {
    label de official "Der Schuldner hat das Recht, die hinterlegte Sache zurückzunehmen (§ 376 Abs. 1); das Recht ist der Pfändung nicht unterworfen und kann im Insolvenzverfahren nicht ausgeübt werden (§ 377)";
    label en unofficial "the debtor may reclaim the deposited thing (§ 376 (1)); the right is not attachable and cannot be exercised in insolvency proceedings (§ 377)";
}
pub relation insolvenzverfahren_eroeffnet(schuldner: Person) kind empirical {
    label de official "Über das Vermögen des Schuldners ist das Insolvenzverfahren eröffnet (§ 377 Abs. 2)";
    label en unofficial "insolvency proceedings have been opened over the debtor's assets (§ 377 (2))";
}
pub relation kein_insolvenzverfahren(schuldner: Person) kind empirical {
    label de official "Über das Vermögen des Schuldners ist kein Insolvenzverfahren eröffnet (§ 377 Abs. 2) — ausdrückliche Angabe des Falls";
    label en unofficial "no insolvency proceedings have been opened over the debtor's assets (§ 377 (2)) — explicit case input";
}
pub relation befreiung_durch_hinterlegung(s: Schuldverhaeltnis, h: Hinterlegung) kind institutional {
    label de official "Ist die Rücknahme ausgeschlossen, so wird der Schuldner durch die Hinterlegung von seiner Verbindlichkeit in gleicher Weise befreit, wie wenn er zur Zeit der Hinterlegung geleistet hätte (§ 378)";
    label en unofficial "where reclaiming is excluded, the deposit discharges the debtor as if he had performed at the time of deposit (§ 378)";
}
pub relation verweisung_auf_die_hinterlegte_sache(s: Schuldverhaeltnis, h: Hinterlegung) kind institutional {
    label de official "Ist die Rücknahme nicht ausgeschlossen, so kann der Schuldner den Gläubiger auf die hinterlegte Sache verweisen; solange die Sache hinterlegt ist, trägt der Gläubiger die Gefahr und der Schuldner schuldet keine Zinsen (§ 379 Abs. 1, 2)";
    label en unofficial "where reclaiming is not excluded the debtor may refer the creditor to the deposited thing; the creditor bears the risk and no interest is owed (§ 379 (1), (2))";
}
pub relation sache_zurueckgenommen(h: Hinterlegung) kind empirical {
    label de official "Der Schuldner hat die hinterlegte Sache zurückgenommen (§ 379 Abs. 3, § 381, § 386)";
    label en unofficial "the debtor has reclaimed the deposited thing (§ 379 (3), § 381, § 386)";
}
pub relation hinterlegung_gilt_als_nicht_erfolgt(h: Hinterlegung) kind institutional {
    label de official "Nimmt der Schuldner die hinterlegte Sache zurück, so gilt die Hinterlegung als nicht erfolgt (§ 379 Abs. 3)";
    label en unofficial "if the debtor reclaims the thing, the deposit is deemed not to have occurred (§ 379 (3))";
}
pub relation anerkennende_erklaerung_verlangbar(h: Hinterlegung, glaeubiger: Person) kind institutional {
    label de official "Der Gläubiger kann vom Schuldner die Abgabe der die Empfangsberechtigung anerkennenden Erklärung verlangen, soweit sie zum Nachweis erforderlich oder genügend ist (§ 380)";
    label en unofficial "the creditor may demand the debtor's declaration acknowledging his entitlement where it is required or sufficient as proof (§ 380)";
}
pub relation kosten_der_hinterlegung_traegt_der_glaeubiger(h: Hinterlegung) kind institutional {
    label de official "Die Kosten der Hinterlegung fallen dem Gläubiger zur Last, sofern nicht der Schuldner die hinterlegte Sache zurücknimmt (§ 381)";
    label en unofficial "the costs of the deposit fall on the creditor unless the debtor reclaims the thing (§ 381)";
}
pub relation sache_nicht_zurueckgenommen(h: Hinterlegung) kind empirical {
    label de official "Der Schuldner hat die hinterlegte Sache nicht zurückgenommen (§ 381, § 386) — ausdrückliche Angabe des Falls";
    label en unofficial "the debtor has not reclaimed the deposited thing (§ 381, § 386) — explicit case input";
}
pub relation zur_hinterlegung_ungeeignete_bewegliche_sache(s: Schuldverhaeltnis, sache: Sache) kind empirical {
    label de official "Die geschuldete bewegliche Sache ist zur Hinterlegung nicht geeignet (§ 383 Abs. 1 Satz 1)";
    label en unofficial "the movable thing owed is not suitable for deposit (§ 383 (1) sentence 1)";
}
pub relation versteigerung_zulaessig(s: Schuldverhaeltnis, sache: Sache) kind institutional {
    label de official "Der Schuldner kann die Sache im Falle des Verzugs des Gläubigers versteigern lassen und den Erlös hinterlegen; die Versteigerung hat öffentlich zu erfolgen (§ 383 Abs. 1, 2)";
    label en unofficial "the debtor may have the thing auctioned and deposit the proceeds; the auction must be public (§ 383 (1), (2))";
}
pub relation versteigerung_angedroht(s: Schuldverhaeltnis, sache: Sache) kind empirical {
    label de official "Die Versteigerung ist dem Gläubiger angedroht worden oder die Androhung durfte wegen Verderbs und Gefahr unterbleiben (§ 384 Abs. 1, Abs. 3)";
    label en unofficial "the auction was announced to the creditor, or the announcement could be omitted (§ 384 (1), (3))";
}
pub relation boersen_oder_marktpreis(sache: Sache) kind empirical {
    label de official "Die Sache hat einen Börsen- oder Marktpreis (§ 385)";
    label en unofficial "the thing has a stock exchange or market price (§ 385)";
}
pub relation freihaendiger_verkauf_zulaessig(s: Schuldverhaeltnis, sache: Sache) kind institutional {
    label de official "Der Schuldner kann den Verkauf aus freier Hand durch einen öffentlich ermächtigten Handelsmakler oder eine zur öffentlichen Versteigerung befugte Person zum laufenden Preis bewirken (§ 385)";
    label en unofficial "the debtor may sell by private agreement through an authorised broker at the current price (§ 385)";
}
pub relation kosten_der_versteigerung_traegt_der_glaeubiger(s: Schuldverhaeltnis) kind institutional {
    label de official "Die Kosten der Versteigerung oder des Verkaufs fallen dem Gläubiger zur Last, sofern nicht der Schuldner den hinterlegten Erlös zurücknimmt (§ 386)";
    label en unofficial "the costs of the auction or sale fall on the creditor unless the debtor reclaims the deposited proceeds (§ 386)";
}

@source(BGB_P372)
rule HinterlegungBeiAnnahmeverzug(s: Schuldverhaeltnis) strict {
    label de official "Geld, Wertpapiere und sonstige Urkunden sowie Kostbarkeiten kann der Schuldner bei einer dazu bestimmten öffentlichen Stelle für den Gläubiger hinterlegen, wenn der Gläubiger im Verzug der Annahme ist (§ 372 Satz 1)";
    label en unofficial "The debtor may deposit money, securities, documents and valuables with a public body where the creditor is in default of acceptance (§ 372 sentence 1)";
    when hinterlegungsfaehiger_gegenstand(s);
    when annahmeverzug_des_glaeubigers(s);
    then hinterlegung_zulaessig(s);
}

@source(BGB_P372)
rule HinterlegungBeiUngewissheitUeberDenGlaeubiger(s: Schuldverhaeltnis) strict {
    label de official "Das Gleiche gilt, wenn der Schuldner aus einem anderen in der Person des Gläubigers liegenden Grund oder infolge einer nicht auf Fahrlässigkeit beruhenden Ungewissheit über die Person des Gläubigers seine Verbindlichkeit nicht oder nicht mit Sicherheit erfüllen kann (§ 372 Satz 2)";
    label en unofficial "The same applies where the debtor cannot perform with certainty for a reason in the creditor's person or through non-negligent uncertainty (§ 372 sentence 2)";
    when hinterlegungsfaehiger_gegenstand(s);
    when ungewissheit_ueber_die_person_des_glaeubigers(s);
    then hinterlegung_zulaessig(s);
}

@source(BGB_P374)
rule SchadensersatzBeiHinterlegungAnAndererStelle(s: Schuldverhaeltnis, h: Hinterlegung) strict {
    label de official "Die Hinterlegung hat bei der Hinterlegungsstelle des Leistungsorts zu erfolgen; hinterlegt der Schuldner bei einer anderen Stelle, so hat er dem Gläubiger den daraus entstehenden Schaden zu ersetzen (§ 374 Abs. 1)";
    label en unofficial "The deposit must be made with the depositary of the place of performance; otherwise the debtor must compensate the resulting damage (§ 374 (1))";
    when hinterlegung_des_schuldverhaeltnisses(s, h);
    when hinterlegung_bei_anderer_stelle(h);
    then schadensersatz_wegen_hinterlegungsortes(h);
}

@source(BGB_P374)
rule SchadensersatzBeiUnterlasseneAnzeige(s: Schuldverhaeltnis, h: Hinterlegung) strict {
    label de official "Der Schuldner hat dem Gläubiger die Hinterlegung unverzüglich anzuzeigen; im Falle der Unterlassung ist er zum Schadensersatz verpflichtet; die Anzeige darf unterbleiben, wenn sie untunlich ist (§ 374 Abs. 2)";
    label en unofficial "The debtor must notify the creditor of the deposit without undue delay; if he omits it he is liable in damages, unless notice is impracticable (§ 374 (2))";
    when hinterlegung_des_schuldverhaeltnisses(s, h);
    when anzeige_der_hinterlegung_unterlassen_und_tunlich(h);
    then schadensersatz_wegen_unterlassener_anzeige(h);
}

@source(BGB_P375)
rule RueckwirkungBeiPostuebersendung(h: Hinterlegung, tag: Date) strict {
    label de official "Ist die hinterlegte Sache der Hinterlegungsstelle durch die Post übersendet worden, so wirkt die Hinterlegung auf die Zeit der Aufgabe der Sache zur Post zurück (§ 375)";
    label en unofficial "Where the deposited thing was sent by post, the deposit takes effect retroactively from the time of posting (§ 375)";
    when sache_durch_die_post_uebersendet_am(h, tag);
    then hinterlegung_wirkt_zurueck_auf(h, tag);
}

@source(BGB_P376)
rule RuecknahmerechtDesSchuldners(s: Schuldverhaeltnis, h: Hinterlegung, schuldner: Person) strict {
    label de official "Der Schuldner hat das Recht, die hinterlegte Sache zurückzunehmen (§ 376 Abs. 1); im Insolvenzverfahren kann er es nicht ausüben (§ 377 Abs. 2)";
    label en unofficial "The debtor may reclaim the deposited thing (§ 376 (1)); he cannot exercise the right in insolvency proceedings (§ 377 (2))";
    when hinterlegung_des_schuldverhaeltnisses(s, h);
    when de.bgb.core::schuldverhaeltnis_schuldner(s, schuldner);
    when kein_insolvenzverfahren(schuldner);
    then ruecknahmerecht(h, schuldner);
}

@source(BGB_P376)
rule RuecknahmeAusgeschlossen(h: Hinterlegung, grund: RuecknahmeAusschlussgrund) strict {
    label de official "Die Rücknahme ist ausgeschlossen, wenn der Schuldner auf das Recht zur Rücknahme verzichtet, der Gläubiger der Hinterlegungsstelle die Annahme erklärt oder ein rechtskräftiges Urteil die Hinterlegung für rechtmäßig erklärt (§ 376 Abs. 2)";
    label en unofficial "Reclaiming is excluded upon the debtor's waiver, the creditor's declaration of acceptance or a final judgment declaring the deposit lawful (§ 376 (2))";
    when ruecknahmeausschluss(h, grund);
    then ruecknahme_ausgeschlossen(h);
}

@source(BGB_P378)
rule BefreiungDurchHinterlegungBeiAusgeschlossenerRuecknahme(s: Schuldverhaeltnis, h: Hinterlegung) strict {
    label de official "Ist die Rücknahme der hinterlegten Sache ausgeschlossen, so wird der Schuldner durch die Hinterlegung von seiner Verbindlichkeit in gleicher Weise befreit, wie wenn er zur Zeit der Hinterlegung an den Gläubiger geleistet hätte (§ 378)";
    label en unofficial "Where reclaiming is excluded, the deposit discharges the debtor as if he had performed at the time of the deposit (§ 378)";
    when hinterlegung_des_schuldverhaeltnisses(s, h);
    when ruecknahme_ausgeschlossen(h);
    then befreiung_durch_hinterlegung(s, h);
}

@source(BGB_P379)
rule VerweisungAufDieHinterlegteSache(s: Schuldverhaeltnis, h: Hinterlegung, schuldner: Person) strict {
    label de official "Ist die Rücknahme der hinterlegten Sache nicht ausgeschlossen, so kann der Schuldner den Gläubiger auf die hinterlegte Sache verweisen (§ 379 Abs. 1); solange die Sache hinterlegt ist, trägt der Gläubiger die Gefahr und der Schuldner ist nicht verpflichtet, Zinsen zu zahlen (Abs. 2)";
    label en unofficial "Where reclaiming is not excluded the debtor may refer the creditor to the deposited thing (§ 379 (1)); meanwhile the creditor bears the risk and no interest is owed ((2))";
    when hinterlegung_des_schuldverhaeltnisses(s, h);
    when ruecknahmerecht(h, schuldner);
    then verweisung_auf_die_hinterlegte_sache(s, h);
}

@source(BGB_P379)
rule RuecknahmeMachtDieHinterlegungUngeschehen(h: Hinterlegung) strict {
    label de official "Nimmt der Schuldner die hinterlegte Sache zurück, so gilt die Hinterlegung als nicht erfolgt (§ 379 Abs. 3)";
    label en unofficial "If the debtor reclaims the deposited thing, the deposit is deemed not to have occurred (§ 379 (3))";
    when sache_zurueckgenommen(h);
    then hinterlegung_gilt_als_nicht_erfolgt(h);
}

@source(BGB_P380)
rule NachweisDerEmpfangsberechtigung(s: Schuldverhaeltnis, h: Hinterlegung, glaeubiger: Person) strict {
    label de official "Soweit zum Nachweis der Empfangsberechtigung eine anerkennende Erklärung des Schuldners erforderlich oder genügend ist, kann der Gläubiger deren Abgabe unter denselben Voraussetzungen verlangen, unter denen er die Leistung zu fordern berechtigt wäre (§ 380)";
    label en unofficial "Where a declaration of the debtor is required or sufficient as proof of entitlement, the creditor may demand it under the same conditions as the performance (§ 380)";
    when hinterlegung_des_schuldverhaeltnisses(s, h);
    when de.bgb.core::schuldverhaeltnis_glaeubiger(s, glaeubiger);
    then anerkennende_erklaerung_verlangbar(h, glaeubiger);
}

@source(BGB_P381)
rule KostenDerHinterlegung(h: Hinterlegung) strict {
    label de official "Die Kosten der Hinterlegung fallen dem Gläubiger zur Last, sofern nicht der Schuldner die hinterlegte Sache zurücknimmt (§ 381)";
    label en unofficial "The costs of the deposit fall on the creditor unless the debtor reclaims the thing (§ 381)";
    when sache_nicht_zurueckgenommen(h);
    then kosten_der_hinterlegung_traegt_der_glaeubiger(h);
}

@source(BGB_P382)
rule ErloeschenDesGlaeubigerrechtsNachDreissigJahren(h: Hinterlegung, anzeige: Date, meldung: Date) strict {
    label de official "Das Recht des Gläubigers auf den hinterlegten Betrag erlischt mit dem Ablauf von 30 Jahren nach dem Empfang der Anzeige von der Hinterlegung, wenn nicht der Gläubiger sich vorher bei der Hinterlegungsstelle meldet (§ 382) — Jahresfrist nach § 188 Abs. 2, Politik BGB_SCHULDRECHT_AT_KALENDER";
    label en unofficial "The creditor's right to the deposited amount lapses 30 years after receipt of the notice unless he contacts the depositary earlier (§ 382)";
    when empfang_der_hinterlegungsanzeige(h, anzeige);
    when glaeubiger_meldet_sich_am(h, meldung);
    when meldung > add_calendar_period(anzeige, 30 calendar_year);
    then recht_des_glaeubigers_auf_den_hinterlegten_betrag_erloschen(h);
}

@source(BGB_P383)
rule VersteigerungHinterlegungsunfaehigerSachen(s: Schuldverhaeltnis, sache: Sache) strict {
    label de official "Ist die geschuldete bewegliche Sache zur Hinterlegung nicht geeignet, so kann der Schuldner sie im Falle des Verzugs des Gläubigers versteigern lassen und den Erlös hinterlegen (§ 383 Abs. 1 Satz 1); die Versteigerung hat öffentlich, virtuell oder hybrid zu erfolgen (Abs. 2), unter öffentlicher Bekanntmachung von Zeitpunkt, Ort und Zugangsdaten (Abs. 3); für eingetragene Schiffe gilt dies nicht (Abs. 4)";
    label en unofficial "Where the movable thing owed is unsuitable for deposit, the debtor may have it auctioned in the creditor's default and deposit the proceeds (§ 383)";
    when zur_hinterlegung_ungeeignete_bewegliche_sache(s, sache);
    when annahmeverzug_des_glaeubigers(s);
    when versteigerung_angedroht(s, sache);
    then versteigerung_zulaessig(s, sache);
}

@source(BGB_P384)
rule AndrohungDerVersteigerung(s: Schuldverhaeltnis, sache: Sache) strict {
    label de official "Die Versteigerung ist erst zulässig, nachdem sie dem Gläubiger angedroht worden ist; die Androhung darf unterbleiben, wenn die Sache dem Verderb ausgesetzt und mit dem Aufschub Gefahr verbunden ist (§ 384 Abs. 1); Androhung und Benachrichtigung dürfen unterbleiben, wenn sie untunlich sind (Abs. 3)";
    label en unofficial "The auction is admissible only after announcement to the creditor, which may be omitted where the thing is perishable and delay is risky (§ 384 (1), (3))";
    when zur_hinterlegung_ungeeignete_bewegliche_sache(s, sache);
    when versteigerung_angedroht(s, sache);
    then versteigerung_zulaessig(s, sache);
}

@source(BGB_P385)
rule FreihaendigerVerkaufBeiBoersenOderMarktpreis(s: Schuldverhaeltnis, sache: Sache) strict {
    label de official "Hat die Sache einen Börsen- oder Marktpreis, so kann der Schuldner den Verkauf aus freier Hand durch einen öffentlich ermächtigten Handelsmakler oder eine zur öffentlichen Versteigerung befugte Person zum laufenden Preis bewirken (§ 385)";
    label en unofficial "Where the thing has a stock exchange or market price, the debtor may sell it by private agreement at the current price (§ 385)";
    when zur_hinterlegung_ungeeignete_bewegliche_sache(s, sache);
    when annahmeverzug_des_glaeubigers(s);
    when boersen_oder_marktpreis(sache);
    then freihaendiger_verkauf_zulaessig(s, sache);
}

@source(BGB_P386)
rule KostenDerVersteigerung(s: Schuldverhaeltnis, sache: Sache, h: Hinterlegung) strict {
    label de official "Die Kosten der Versteigerung oder des nach § 385 erfolgten Verkaufs fallen dem Gläubiger zur Last, sofern nicht der Schuldner den hinterlegten Erlös zurücknimmt (§ 386)";
    label en unofficial "The costs of the auction or of the sale under § 385 fall on the creditor unless the debtor reclaims the deposited proceeds (§ 386)";
    when versteigerung_zulaessig(s, sache);
    when hinterlegung_des_schuldverhaeltnisses(s, h);
    when sache_nicht_zurueckgenommen(h);
    then kosten_der_versteigerung_traegt_der_glaeubiger(s);
}

// --- §§ 387–396 Aufrechnung ------------------------------------------------------------------------------

pub relation gegenseitige_gleichartige_forderungen(a: Anspruch, gegenforderung: Anspruch) kind empirical {
    label de official "Zwei Personen schulden einander Leistungen, die ihrem Gegenstand nach gleichartig sind (§ 387)";
    label en unofficial "two persons owe each other performances of the same kind (§ 387)";
}
pub relation eigene_leistung_bewirkbar_und_gegenleistung_forderbar(a: Anspruch, gegenforderung: Anspruch) kind empirical {
    label de official "Der aufrechnende Teil kann die ihm gebührende Leistung fordern und die ihm obliegende Leistung bewirken (§ 387)";
    label en unofficial "the party setting off may demand the performance due to him and render his own (§ 387)";
}
pub relation aufrechnungslage(a: Anspruch, gegenforderung: Anspruch) kind institutional {
    label de official "Die Forderungen stehen sich zur Aufrechnung geeignet gegenüber (§ 387)";
    label en unofficial "the claims stand opposed in a manner suitable for set-off (§ 387)";
}
pub relation aufrechnung_erklaert(a: Anspruch, gegenforderung: Anspruch) kind empirical {
    label de official "Die Aufrechnung ist durch Erklärung gegenüber dem anderen Teil erfolgt (§ 388 Satz 1)";
    label en unofficial "the set-off was declared to the other party (§ 388 sentence 1)";
}
pub relation erklaerung_unter_bedingung_oder_zeitbestimmung(a: Anspruch) kind empirical {
    label de official "Die Erklärung ist unter einer Bedingung oder einer Zeitbestimmung abgegeben worden (§ 388 Satz 2)";
    label en unofficial "the declaration was made subject to a condition or a time stipulation (§ 388 sentence 2)";
}
pub relation aufrechnungserklaerung_unwirksam(a: Anspruch) kind institutional {
    label de official "Die Erklärung ist unwirksam (§ 388 Satz 2)";
    label en unofficial "the declaration is ineffective (§ 388 sentence 2)";
}
pub relation forderungen_gelten_als_erloschen_am(a: Anspruch, gegenforderung: Anspruch, tag: Date) kind institutional {
    label de official "Die Aufrechnung bewirkt, dass die Forderungen, soweit sie sich decken, als in dem Zeitpunkt erloschen gelten, in welchem sie zur Aufrechnung geeignet einander gegenübergetreten sind (§ 389)";
    label en unofficial "the set-off causes the claims, so far as they correspond, to be deemed extinguished at the time they became suitable for set-off (§ 389)";
}
pub relation aufrechnungslage_seit(a: Anspruch, gegenforderung: Anspruch, tag: Date) kind empirical {
    label de official "Tag, an dem die Forderungen zur Aufrechnung geeignet einander gegenübergetreten sind (§ 389) — Eingang des Falls";
    label en unofficial "day on which the claims became suitable for set-off (§ 389) — case input";
}
pub relation einrede_entgegenstehend(a: Anspruch) kind institutional {
    label de official "Der Forderung steht eine Einrede entgegen (§ 390); die Verjährung ist eine solche Einrede (§ 214 Abs. 1, gerechnet in de.bgb.fristen)";
    label en unofficial "the claim is subject to a defence (§ 390); limitation is such a defence (§ 214 (1), computed in de.bgb.fristen)";
}
pub relation aufrechnung_ausgeschlossen(a: Anspruch) kind institutional {
    label de official "Die Aufrechnung ist ausgeschlossen beziehungsweise nicht zulässig (§§ 390, 392, 393, 394, 395)";
    label en unofficial "set-off is excluded or inadmissible (§§ 390, 392, 393, 394, 395)";
}
pub relation verschiedene_leistungsorte(a: Anspruch, gegenforderung: Anspruch) kind empirical {
    label de official "Für die Forderungen bestehen verschiedene Leistungs- oder Ablieferungsorte (§ 391 Abs. 1 Satz 1)";
    label en unofficial "the claims have different places of performance or delivery (§ 391 (1) sentence 1)";
}
pub relation aufrechnung_nicht_wegen_der_leistungsorte_ausgeschlossen(a: Anspruch, gegenforderung: Anspruch) kind institutional {
    label de official "Die Aufrechnung wird nicht dadurch ausgeschlossen, dass für die Forderungen verschiedene Leistungs- oder Ablieferungsorte bestehen; der aufrechnende Teil hat jedoch den daraus entstehenden Schaden zu ersetzen (§ 391 Abs. 1)";
    label en unofficial "Set-off is not excluded by different places of performance; the party setting off must compensate the resulting damage (§ 391 (1))";
}
pub relation forderung_beschlagnahmt_am(a: Anspruch, tag: Date) kind empirical {
    key(a);
    label de official "Tag der Beschlagnahme der Forderung (§ 392)";
    label en unofficial "day on which the claim was attached (§ 392)";
}
pub relation gegenforderung_erworben_am(gegenforderung: Anspruch, tag: Date) kind empirical {
    key(gegenforderung);
    label de official "Tag, an dem der Schuldner seine Forderung erworben hat (§ 392)";
    label en unofficial "day on which the debtor acquired his claim (§ 392)";
}
pub relation forderung_aus_vorsaetzlicher_unerlaubter_handlung(a: Anspruch) kind empirical {
    label de official "Die Forderung stammt aus einer vorsätzlich begangenen unerlaubten Handlung (§ 393)";
    label en unofficial "the claim arises from an intentional tort (§ 393)";
}
pub relation forderung_unpfaendbar(a: Anspruch) kind empirical {
    label de official "Die Forderung ist der Pfändung nicht unterworfen (§ 394 Satz 1)";
    label en unofficial "the claim is not subject to attachment (§ 394 sentence 1)";
}
pub relation forderung_einer_oeffentlich_rechtlichen_koerperschaft(a: Anspruch) kind empirical {
    label de official "Die Forderung steht dem Bund, einem Land, einer Gemeinde oder einem anderen Kommunalverband zu (§ 395)";
    label en unofficial "the claim belongs to the Federation, a Land, a municipality or another local authority (§ 395)";
}
pub relation leistung_an_dieselbe_kasse(a: Anspruch) kind empirical {
    label de official "Die Leistung hat an dieselbe Kasse zu erfolgen, aus der die Forderung des Aufrechnenden zu berichtigen ist (§ 395)";
    label en unofficial "performance is to be made to the same fund from which the claim of the party setting off is to be satisfied (§ 395)";
}
pub relation leistung_nicht_an_dieselbe_kasse(a: Anspruch) kind empirical {
    label de official "Die Leistung hat nicht an dieselbe Kasse zu erfolgen (§ 395) — ausdrückliche Angabe des Falls";
    label en unofficial "performance is not to be made to the same fund (§ 395) — explicit case input";
}
pub relation mehrere_zur_aufrechnung_geeignete_forderungen(p: Person) kind empirical {
    label de official "Der eine oder der andere Teil hat mehrere zur Aufrechnung geeignete Forderungen (§ 396 Abs. 1 Satz 1)";
    label en unofficial "one party has several claims suitable for set-off (§ 396 (1) sentence 1)";
}
pub relation aufrechnungsbestimmung_getroffen(p: Person, a: Anspruch) kind empirical {
    label de official "Der aufrechnende Teil hat die Forderungen bestimmt, die gegeneinander aufgerechnet werden sollen (§ 396 Abs. 1 Satz 1)";
    label en unofficial "the party setting off designated the claims to be set off (§ 396 (1) sentence 1)";
}
pub relation aufgerechnete_forderung(a: Anspruch) kind institutional {
    label de official "Diese Forderung wird aufgerechnet (§ 396 Abs. 1)";
    label en unofficial "this claim is set off (§ 396 (1))";
}
pub relation erlassvertrag_geschlossen(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Gläubiger erlässt dem Schuldner durch Vertrag die Schuld (§ 397 Abs. 1)";
    label en unofficial "the creditor releases the debtor from the debt by contract (§ 397 (1))";
}
pub relation negatives_schuldanerkenntnis(s: Schuldverhaeltnis) kind empirical {
    label de official "Der Gläubiger erkennt durch Vertrag mit dem Schuldner an, dass das Schuldverhältnis nicht bestehe (§ 397 Abs. 2)";
    label en unofficial "the creditor acknowledges by contract that the obligation does not exist (§ 397 (2))";
}

@source(BGB_P387)
rule AufrechnungslageBeiGleichartigenForderungen(a: Anspruch, gegenforderung: Anspruch) strict {
    label de official "Schulden zwei Personen einander Leistungen, die ihrem Gegenstand nach gleichartig sind, so kann jeder Teil seine Forderung gegen die Forderung des anderen Teils aufrechnen, sobald er die ihm gebührende Leistung fordern und die ihm obliegende Leistung bewirken kann (§ 387)";
    label en unofficial "Where two persons owe each other performances of the same kind, either may set off once he may demand the performance due to him and render his own (§ 387)";
    when gegenseitige_gleichartige_forderungen(a, gegenforderung);
    when eigene_leistung_bewirkbar_und_gegenleistung_forderbar(a, gegenforderung);
    then aufrechnungslage(a, gegenforderung);
}

@source(BGB_P388)
rule AufrechnungserklaerungUnterBedingungUnwirksam(a: Anspruch) strict {
    label de official "Die Aufrechnung erfolgt durch Erklärung gegenüber dem anderen Teil; die Erklärung ist unwirksam, wenn sie unter einer Bedingung oder einer Zeitbestimmung abgegeben wird (§ 388)";
    label en unofficial "Set-off is declared to the other party; the declaration is ineffective if made subject to a condition or time stipulation (§ 388)";
    when erklaerung_unter_bedingung_oder_zeitbestimmung(a);
    then aufrechnungserklaerung_unwirksam(a);
}

@source(BGB_P389)
rule WirkungDerAufrechnungAufDenZeitpunktDerAufrechnungslage(a: Anspruch, gegenforderung: Anspruch, tag: Date) strict {
    label de official "Die Aufrechnung bewirkt, dass die Forderungen, soweit sie sich decken, als in dem Zeitpunkt erloschen gelten, in welchem sie zur Aufrechnung geeignet einander gegenübergetreten sind (§ 389)";
    label en unofficial "Set-off causes the claims, so far as they correspond, to be deemed extinguished when they became suitable for set-off (§ 389)";
    when aufrechnung_erklaert(a, gegenforderung);
    when aufrechnungslage(a, gegenforderung);
    when aufrechnungslage_seit(a, gegenforderung, tag);
    then forderungen_gelten_als_erloschen_am(a, gegenforderung, tag);
}

@source(BGB_P390)
rule VerjaehrteForderungIstEinredebehaftet(a: Anspruch, tag: Date) strict {
    label de official "Die Verjährung gibt dem Schuldner das Recht, die Leistung zu verweigern (§ 214 Abs. 1); der so einredebehafteten Forderung steht eine Einrede im Sinne des § 390 entgegen — der Tag des Eintritts der Verjährung kommt aus de.bgb.fristen";
    label en unofficial "Limitation entitles the debtor to refuse performance (§ 214 (1)); such a claim is subject to a defence within § 390 — the day limitation occurred comes from de.bgb.fristen";
    when de.bgb.fristen::verjaehrung_eingetreten_am(a, tag);
    then einrede_entgegenstehend(a);
}

@source(BGB_P390)
rule KeineAufrechnungMitEinredebehafteterForderung(a: Anspruch) strict {
    label de official "Eine Forderung, der eine Einrede entgegensteht, kann nicht aufgerechnet werden (§ 390)";
    label en unofficial "A claim subject to a defence may not be set off (§ 390)";
    when einrede_entgegenstehend(a);
    then aufrechnung_ausgeschlossen(a);
}

@source(BGB_P391)
rule VerschiedeneLeistungsorteSchliessenDieAufrechnungNichtAus(a: Anspruch, gegenforderung: Anspruch) strict {
    label de official "Die Aufrechnung wird nicht dadurch ausgeschlossen, dass für die Forderungen verschiedene Leistungs- oder Ablieferungsorte bestehen; der aufrechnende Teil hat jedoch den Schaden zu ersetzen (§ 391 Abs. 1)";
    label en unofficial "Set-off is not excluded by different places of performance; the party setting off must compensate the damage (§ 391 (1))";
    when aufrechnungslage(a, gegenforderung);
    when verschiedene_leistungsorte(a, gegenforderung);
    then aufrechnung_nicht_wegen_der_leistungsorte_ausgeschlossen(a, gegenforderung);
}

@source(BGB_P392)
rule KeineAufrechnungGegenBeschlagnahmteForderungBeiSpaeteremErwerb(a: Anspruch, gegenforderung: Anspruch, beschlagnahme: Date, erwerb: Date) strict {
    label de official "Durch die Beschlagnahme einer Forderung wird die Aufrechnung einer dem Schuldner gegen den Gläubiger zustehenden Forderung ausgeschlossen, wenn der Schuldner seine Forderung nach der Beschlagnahme erworben hat (§ 392)";
    label en unofficial "Attachment of a claim excludes set-off with a claim of the debtor acquired after the attachment (§ 392)";
    when forderung_beschlagnahmt_am(a, beschlagnahme);
    when gegenforderung_erworben_am(gegenforderung, erwerb);
    when erwerb > beschlagnahme;
    then aufrechnung_ausgeschlossen(gegenforderung);
}

@source(BGB_P393)
rule KeineAufrechnungGegenForderungAusVorsaetzlicherUnerlaubterHandlung(a: Anspruch) strict {
    label de official "Gegen eine Forderung aus einer vorsätzlich begangenen unerlaubten Handlung ist die Aufrechnung nicht zulässig (§ 393)";
    label en unofficial "Set-off against a claim arising from an intentional tort is inadmissible (§ 393)";
    when forderung_aus_vorsaetzlicher_unerlaubter_handlung(a);
    then aufrechnung_ausgeschlossen(a);
}

@source(BGB_P394)
rule KeineAufrechnungGegenUnpfaendbareForderung(a: Anspruch) strict {
    label de official "Soweit eine Forderung der Pfändung nicht unterworfen ist, findet die Aufrechnung gegen die Forderung nicht statt (§ 394 Satz 1)";
    label en unofficial "So far as a claim is not attachable, set-off against it does not take place (§ 394 sentence 1)";
    when forderung_unpfaendbar(a);
    then aufrechnung_ausgeschlossen(a);
}

@source(BGB_P395)
rule AufrechnungGegenOeffentlicheKoerperschaftNurBeiDerselbenKasse(a: Anspruch) strict {
    label de official "Gegen eine Forderung des Bundes oder eines Landes sowie einer Gemeinde oder eines anderen Kommunalverbands ist die Aufrechnung nur zulässig, wenn die Leistung an dieselbe Kasse zu erfolgen hat, aus der die Forderung des Aufrechnenden zu berichtigen ist (§ 395)";
    label en unofficial "Set-off against a claim of a public body is admissible only where performance is to the same fund from which the claim of the party setting off is satisfied (§ 395)";
    when forderung_einer_oeffentlich_rechtlichen_koerperschaft(a);
    when leistung_nicht_an_dieselbe_kasse(a);
    then aufrechnung_ausgeschlossen(a);
}

@source(BGB_P396)
rule AufrechnungNachBestimmungDesAufrechnenden(p: Person, a: Anspruch) strict {
    label de official "Hat der eine oder der andere Teil mehrere zur Aufrechnung geeignete Forderungen, so kann der aufrechnende Teil die Forderungen bestimmen, die gegeneinander aufgerechnet werden sollen (§ 396 Abs. 1 Satz 1); ohne Bestimmung gilt § 366 Abs. 2 entsprechend (Satz 2), bei Zinsen und Kosten § 367 (Abs. 2)";
    label en unofficial "Where a party has several claims suitable for set-off he may designate which are to be set off (§ 396 (1) sentence 1); otherwise § 366 (2) applies (sentence 2), and § 367 for interest and costs ((2))";
    when mehrere_zur_aufrechnung_geeignete_forderungen(p);
    when aufrechnungsbestimmung_getroffen(p, a);
    then aufgerechnete_forderung(a);
}

@source(BGB_P397)
rule ErlassvertragLaesstDasSchuldverhaeltnisErloeschen(s: Schuldverhaeltnis) strict {
    label de official "Das Schuldverhältnis erlischt, wenn der Gläubiger dem Schuldner durch Vertrag die Schuld erlässt (§ 397 Abs. 1)";
    label en unofficial "The obligation is extinguished if the creditor releases the debtor from the debt by contract (§ 397 (1))";
    when erlassvertrag_geschlossen(s);
    then schuldverhaeltnis_erloschen(s);
}

@source(BGB_P397)
rule NegativesSchuldanerkenntnis(s: Schuldverhaeltnis) strict {
    label de official "Das Gleiche gilt, wenn der Gläubiger durch Vertrag mit dem Schuldner anerkennt, dass das Schuldverhältnis nicht bestehe (§ 397 Abs. 2)";
    label en unofficial "The same applies where the creditor acknowledges by contract that the obligation does not exist (§ 397 (2))";
    when negatives_schuldanerkenntnis(s);
    then schuldverhaeltnis_erloschen(s);
}

// --- §§ 373, 377: Zug-um-Zug-Leistung und Unpfändbarkeit des Rücknahmerechts --------------------------

pub relation empfangsrecht_von_der_gegenleistung_abhaengig(h: Hinterlegung, glaeubiger: Person) kind institutional {
    label de official "Ist der Schuldner nur gegen eine Leistung des Gläubigers zu leisten verpflichtet, so kann er das Recht des Gläubigers zum Empfang der hinterlegten Sache von der Bewirkung der Gegenleistung abhängig machen (§ 373)";
    label en unofficial "where the debtor owes performance only against a performance by the creditor, he may make the creditor's right to receive the deposited thing dependent on that counter-performance (§ 373)";
}
pub relation ruecknahmerecht_nicht_pfaendbar(h: Hinterlegung, schuldner: Person) kind institutional {
    label de official "Das Recht zur Rücknahme ist der Pfändung nicht unterworfen (§ 377 Abs. 1)";
    label en unofficial "the right to reclaim is not subject to attachment (§ 377 (1))";
}
pub relation ruecknahmerecht_im_insolvenzverfahren_gesperrt(h: Hinterlegung, schuldner: Person) kind institutional {
    label de official "Wird über das Vermögen des Schuldners das Insolvenzverfahren eröffnet, so kann während des Insolvenzverfahrens das Recht zur Rücknahme auch nicht von dem Schuldner ausgeübt werden (§ 377 Abs. 2)";
    label en unofficial "where insolvency proceedings are opened, the debtor may not exercise the right to reclaim during those proceedings (§ 377 (2))";
}

@source(BGB_P373)
rule EmpfangDerHinterlegtenSacheNurGegenGegenleistung(s: Schuldverhaeltnis, h: Hinterlegung, glaeubiger: Person) strict {
    label de official "Ist der Schuldner nur gegen eine Leistung des Gläubigers zu leisten verpflichtet, so kann er das Recht des Gläubigers zum Empfang der hinterlegten Sache von der Bewirkung der Gegenleistung abhängig machen (§ 373)";
    label en unofficial "Where the debtor owes performance only against a counter-performance, he may make the creditor's right to receive the deposited thing dependent on it (§ 373)";
    when hinterlegung_des_schuldverhaeltnisses(s, h);
    when nur_zug_um_zug_zu_leisten(s);
    when de.bgb.core::schuldverhaeltnis_glaeubiger(s, glaeubiger);
    then empfangsrecht_von_der_gegenleistung_abhaengig(h, glaeubiger);
}

@source(BGB_P377)
rule RuecknahmerechtIstUnpfaendbar(s: Schuldverhaeltnis, h: Hinterlegung, schuldner: Person) strict {
    label de official "Das Recht zur Rücknahme ist der Pfändung nicht unterworfen (§ 377 Abs. 1)";
    label en unofficial "The right to reclaim is not subject to attachment (§ 377 (1))";
    when hinterlegung_des_schuldverhaeltnisses(s, h);
    when de.bgb.core::schuldverhaeltnis_schuldner(s, schuldner);
    then ruecknahmerecht_nicht_pfaendbar(h, schuldner);
}

@source(BGB_P377)
rule RuecknahmerechtImInsolvenzverfahrenNichtAusuebbar(s: Schuldverhaeltnis, h: Hinterlegung, schuldner: Person) strict {
    label de official "Wird über das Vermögen des Schuldners das Insolvenzverfahren eröffnet, so kann während des Insolvenzverfahrens das Recht zur Rücknahme auch nicht von dem Schuldner ausgeübt werden (§ 377 Abs. 2)";
    label en unofficial "Where insolvency proceedings are opened over the debtor's assets, he may not exercise the right to reclaim during them (§ 377 (2))";
    when hinterlegung_des_schuldverhaeltnisses(s, h);
    when de.bgb.core::schuldverhaeltnis_schuldner(s, schuldner);
    when insolvenzverfahren_eroeffnet(schuldner);
    then ruecknahmerecht_im_insolvenzverfahren_gesperrt(h, schuldner);
}
