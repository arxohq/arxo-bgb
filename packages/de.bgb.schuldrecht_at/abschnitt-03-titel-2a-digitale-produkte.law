// ABSCHNITT 3 TITEL 2a VERTRÄGE ÜBER DIGITALE PRODUKTE, §§ 327–327u
//
// Untertitel 1 Verbraucherverträge (§§ 327–327s) und Untertitel 2 Verträge
// zwischen Unternehmern (§§ 327t, 327u).
//
// DIE FRISTEN DIESES TITELS (Zeilen in DEADLINES.json, BG-04):
// § 327j Abs. 1 zwei Jahre ab der Bereitstellung (Verjährung; Jahresschritt
// § 188 Abs. 2, Politik `BGB_SCHULDRECHT_AT_KALENDER`), Abs. 2 und Abs. 3
// zwölf Monate nach dem Ende des Bereitstellungs- beziehungsweise
// Aktualisierungszeitraums, Abs. 4 vier Monate nach dem ersten Zeigen des
// Mangels; § 327k Abs. 1 ein Jahr seit der Bereitstellung
// (Beweislastumkehr); § 327n Abs. 4 und § 327o Abs. 5 vierzehn Tage;
// § 327r Abs. 3 dreißig Tage ab dem Zugang der Information oder ab der
// Änderung; § 327u Abs. 2 sechs Monate. Der Tagesschritt (14 und 30 Tage)
// und der Kalenderschritt (Monate, Jahre) gehören in getrennte Fälle — eine
// Politik je Fall (§168.2).
//
// WERTUNGEN DES GERICHTS: die Schwere des Mangels (§ 327m Abs. 1 Nr. 4), die
// Unerheblichkeit (§ 327m Abs. 2, § 327r Abs. 2 Satz 3, Abs. 4 Nr. 1), die
// angemessene Frist der Nacherfüllung und der Information (§ 327l Abs. 1
// Satz 2, § 327r Abs. 2 Satz 1), die unverhältnismäßigen Kosten (§ 327l
// Abs. 2), die Unzumutbarkeit der Fortsetzung nach Widerruf der
// datenschutzrechtlichen Einwilligung (§ 327q Abs. 2), der erwartbare
// Aktualisierungszeitraum (§ 327f Abs. 1 Satz 3 Nr. 2) und die Schätzung der
// Minderung (§ 327n Abs. 3).

language "law.core" version "0.2";
package de.bgb.schuldrecht_at version "0.1.0";
namespace "urn:de:corpus:clir:bgb-schuldrecht-at";

// --- §§ 327, 327a Anwendungsbereich ---------------------------------------------------------------

pub entity DigitalesProdukt {
    label de official "Digitales Produkt: digitale Inhalte oder digitale Dienstleistungen (§ 327 Abs. 1, 2)";
    label en unofficial "digital product: digital content or digital services (§ 327 (1), (2))";
}
pub relation digitales_produkt_des_vertrags(v: Vertrag, d: DigitalesProdukt) kind empirical {
    key(d);
    label de official "Der Verbrauchervertrag hat die Bereitstellung dieses digitalen Produkts zum Gegenstand (§ 327 Abs. 1)";
    label en unofficial "the consumer contract concerns the supply of this digital product (§ 327 (1))";
}
pub relation bereitstellung_gegen_zahlung_eines_preises(v: Vertrag) kind empirical {
    label de official "Die Bereitstellung erfolgt gegen Zahlung eines Preises; Preis ist auch eine digitale Darstellung eines Werts (§ 327 Abs. 1)";
    label en unofficial "the supply is against payment of a price; a digital representation of value also counts as a price (§ 327 (1))";
}
pub relation nach_spezifikationen_des_verbrauchers_entwickelt(d: DigitalesProdukt) kind empirical {
    label de official "Das digitale Produkt wird nach den Spezifikationen des Verbrauchers entwickelt (§ 327 Abs. 4)";
    label en unofficial "the digital product is developed to the consumer's specifications (§ 327 (4))";
}
pub relation koerperlicher_datentraeger_nur_als_traeger(d: DigitalesProdukt) kind empirical {
    label de official "Gegenstand ist die Bereitstellung körperlicher Datenträger, die ausschließlich als Träger digitaler Inhalte dienen (§ 327 Abs. 5)";
    label en unofficial "the subject is the supply of tangible media serving exclusively as carriers of digital content (§ 327 (5))";
}
pub enum AusnahmeDigitaleProdukte {
    label de official "Vertrag, auf den die Vorschriften des Untertitels nicht anzuwenden sind (§ 327 Abs. 6 Nummern 1 bis 8)";
    label en unofficial "contract to which this sub-title does not apply (§ 327 (6) nos. 1 to 8)";
    AndereDienstleistungenAlsDigitale,
    Telekommunikationsdienste,
    Behandlungsvertrag,
    Gluecksspieldienstleistungen,
    Finanzdienstleistungen,
    FreieUndQuelloffeneSoftwareOhnePreis,
    DigitaleInhalteAlsTeilEinerDarbietung,
    InformationenNachInformationsweiterverwendungsgesetz
}
pub relation ausnahme_digitale_produkte(v: Vertrag, ausnahme: AusnahmeDigitaleProdukte) kind empirical {
    label de official "Der Vertrag gehört zu den in § 327 Abs. 6 genannten Verträgen";
    label en unofficial "the contract belongs to those named in § 327 (6)";
}
pub relation keine_ausnahme_digitale_produkte(v: Vertrag) kind empirical {
    label de official "Keine der Ausnahmen des § 327 Abs. 6 liegt vor — ausdrückliche Angabe des Falls";
    label en unofficial "none of the exceptions of § 327 (6) applies — explicit case input";
}
pub relation untertitel_digitale_produkte_anwendbar(v: Vertrag) kind institutional {
    label de official "Die Vorschriften dieses Untertitels sind auf den Vertrag anzuwenden (§ 327 Abs. 1, 3, 4, 5)";
    label en unofficial "the provisions of this sub-title apply to the contract (§ 327 (1), (3), (4), (5))";
}
pub relation untertitel_digitale_produkte_nicht_anwendbar(v: Vertrag) kind institutional {
    label de official "Die Vorschriften dieses Untertitels sind nicht anzuwenden (§ 327 Abs. 6)";
    label en unofficial "the provisions of this sub-title do not apply (§ 327 (6))";
}
pub relation paketvertrag(v: Vertrag, d: DigitalesProdukt) kind empirical {
    label de official "Der Vertrag hat neben der Bereitstellung digitaler Produkte die Bereitstellung anderer Sachen oder Dienstleistungen zum Gegenstand (Paketvertrag, § 327a Abs. 1)";
    label en unofficial "besides digital products the contract covers other goods or services (package contract, § 327a (1))";
}
pub relation sache_mit_digitalem_produkt(v: Vertrag, d: DigitalesProdukt, s: Sache) kind empirical {
    label de official "Der Vertrag betrifft eine Sache, die digitale Produkte enthält oder mit ihnen verbunden ist (§ 327a Abs. 2)";
    label en unofficial "the contract concerns a thing containing or connected with digital products (§ 327a (2))";
}
pub relation ware_mit_digitalen_elementen(v: Vertrag, s: Sache) kind empirical {
    label de official "Die Ware kann ihre Funktionen ohne die digitalen Produkte nicht erfüllen (Ware mit digitalen Elementen, § 327a Abs. 3 Satz 1)";
    label en unofficial "the goods cannot perform their functions without the digital products (goods with digital elements, § 327a (3) sentence 1)";
}
pub relation bereitstellungspflicht_des_verkaeufers_umfasst_digitale_inhalte(v: Vertrag, s: Sache) kind institutional {
    label de official "Beim Kauf einer Ware mit digitalen Elementen ist im Zweifel anzunehmen, dass die Verpflichtung des Verkäufers die Bereitstellung der digitalen Inhalte oder Dienstleistungen umfasst (§ 327a Abs. 3 Satz 2)";
    label en unofficial "on the purchase of goods with digital elements the seller's obligation is presumed to include supplying the digital content or services (§ 327a (3) sentence 2)";
}

@source(BGB_P327)
rule UntertitelDigitaleProdukteBeiEntgeltlicherBereitstellung(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Die Vorschriften dieses Untertitels sind auf Verbraucherverträge anzuwenden, welche die Bereitstellung digitaler Inhalte oder digitaler Dienstleistungen durch den Unternehmer gegen Zahlung eines Preises zum Gegenstand haben (§ 327 Abs. 1)";
    label en unofficial "This sub-title applies to consumer contracts on the supply of digital content or digital services against payment of a price (§ 327 (1))";
    when verbrauchervertrag(v);
    when digitales_produkt_des_vertrags(v, d);
    when bereitstellung_gegen_zahlung_eines_preises(v);
    when keine_ausnahme_digitale_produkte(v);
    then untertitel_digitale_produkte_anwendbar(v);
}

@source(BGB_P327)
rule UntertitelDigitaleProdukteBeiDatenbereitstellung(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Die Vorschriften dieses Untertitels sind auch auf Verbraucherverträge über die Bereitstellung digitaler Produkte anzuwenden, bei denen der Verbraucher dem Unternehmer personenbezogene Daten bereitstellt, es sei denn, die Voraussetzungen des § 312 Absatz 1a Satz 2 liegen vor (§ 327 Abs. 3)";
    label en unofficial "This sub-title also applies where the consumer provides personal data, unless § 312 (1a) sentence 2 applies (§ 327 (3))";
    when verbrauchervertrag(v);
    when digitales_produkt_des_vertrags(v, d);
    when verbraucher_stellt_personenbezogene_daten_bereit(v);
    when daten_nicht_ausschliesslich_zur_erfuellung_verarbeitet(v);
    when keine_ausnahme_digitale_produkte(v);
    then untertitel_digitale_produkte_anwendbar(v);
}

@source(BGB_P327)
rule UntertitelDigitaleProdukteBeiIndividuellerEntwicklung(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Die Vorschriften dieses Untertitels sind auch auf Verbraucherverträge anzuwenden, die digitale Produkte zum Gegenstand haben, welche nach den Spezifikationen des Verbrauchers entwickelt werden (§ 327 Abs. 4)";
    label en unofficial "This sub-title also applies to digital products developed to the consumer's specifications (§ 327 (4))";
    when verbrauchervertrag(v);
    when digitales_produkt_des_vertrags(v, d);
    when nach_spezifikationen_des_verbrauchers_entwickelt(d);
    when keine_ausnahme_digitale_produkte(v);
    then untertitel_digitale_produkte_anwendbar(v);
}

@source(BGB_P327)
rule UntertitelNichtAnwendbarInDenAusnahmefaellen(v: Vertrag, ausnahme: AusnahmeDigitaleProdukte) strict {
    label de official "Die Vorschriften dieses Untertitels sind auf die in § 327 Abs. 6 Nummern 1 bis 8 genannten Verträge nicht anzuwenden";
    label en unofficial "This sub-title does not apply to the contracts listed in § 327 (6) nos. 1 to 8";
    when ausnahme_digitale_produkte(v, ausnahme);
    then untertitel_digitale_produkte_nicht_anwendbar(v);
}

@source(BGB_P327a)
rule PaketvertragUndSachenMitDigitalenProdukten(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Die Vorschriften dieses Untertitels sind auch auf Paketverträge anzuwenden; sie gelten jedoch nur für diejenigen Bestandteile, welche die digitalen Produkte betreffen (§ 327a Abs. 1)";
    label en unofficial "This sub-title also applies to package contracts, but only to those parts concerning the digital products (§ 327a (1))";
    when verbrauchervertrag(v);
    when paketvertrag(v, d);
    when keine_ausnahme_digitale_produkte(v);
    then untertitel_digitale_produkte_anwendbar(v);
}

@source(BGB_P327a)
rule WareMitDigitalenElementen(v: Vertrag, s: Sache) strict {
    label de official "Beim Kauf einer Ware mit digitalen Elementen ist im Zweifel anzunehmen, dass die Verpflichtung des Verkäufers die Bereitstellung der digitalen Inhalte oder digitalen Dienstleistungen umfasst (§ 327a Abs. 3)";
    label en unofficial "On the purchase of goods with digital elements the seller's obligation is presumed to include the digital content or services (§ 327a (3))";
    when ware_mit_digitalen_elementen(v, s);
    then bereitstellungspflicht_des_verkaeufers_umfasst_digitale_inhalte(v, s);
}

// --- § 327b Bereitstellung ---------------------------------------------------------------------------

pub relation zeit_der_bereitstellung_vereinbart(v: Vertrag, d: DigitalesProdukt, tag: Date) kind empirical {
    key(d);
    label de official "Die Vertragsparteien haben eine Zeit für die Bereitstellung des digitalen Produkts vereinbart (§ 327b Abs. 2)";
    label en unofficial "the parties agreed a time for supplying the digital product (§ 327b (2))";
}
pub relation keine_zeit_der_bereitstellung_vereinbart(v: Vertrag, d: DigitalesProdukt) kind empirical {
    label de official "Die Vertragsparteien haben keine Zeit für die Bereitstellung vereinbart (§ 327b Abs. 2) — ausdrückliche Angabe des Falls";
    label en unofficial "the parties agreed no time for the supply (§ 327b (2)) — explicit case input";
}
pub relation bereitstellung_unverzueglich_verlangbar(v: Vertrag, d: DigitalesProdukt) kind institutional {
    label de official "Der Verbraucher kann die Bereitstellung unverzüglich nach Vertragsschluss verlangen, der Unternehmer sie sofort bewirken (§ 327b Abs. 2)";
    label en unofficial "the consumer may demand the supply without undue delay after conclusion, and the trader may effect it at once (§ 327b (2))";
}
pub relation bereitgestellt_am(d: DigitalesProdukt, tag: Date) kind empirical {
    key(d);
    label de official "Tag, an dem das digitale Produkt oder die Mittel für den Zugang dem Verbraucher zur Verfügung gestellt oder zugänglich gemacht worden ist (§ 327b Abs. 3, 4)";
    label en unofficial "day on which the digital product or the means of access was made available to the consumer (§ 327b (3), (4))";
}
pub relation beweislast_der_bereitstellung_beim_unternehmer(d: DigitalesProdukt, unternehmerpartei: Person) kind institutional {
    label de official "Die Beweislast für die erfolgte Bereitstellung trifft abweichend von § 363 den Unternehmer (§ 327b Abs. 6)";
    label en unofficial "contrary to § 363 the trader bears the burden of proving the supply (§ 327b (6))";
}
pub relation dauerhafte_bereitstellung(d: DigitalesProdukt, beginn: Date, ende: Date) kind empirical {
    key(d);
    label de official "Der Unternehmer ist zu einer fortlaufenden Bereitstellung über einen Zeitraum verpflichtet (dauerhafte Bereitstellung, § 327e Abs. 1 Satz 3): Anfang und Ende des Bereitstellungszeitraums";
    label en unofficial "the trader owes continuous supply over a period (continuous supply, § 327e (1) sentence 3): start and end of the supply period";
}

@source(BGB_P327b)
rule BereitstellungUnverzueglichOhneVereinbarteZeit(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Sofern die Vertragsparteien keine Zeit für die Bereitstellung vereinbart haben, kann der Verbraucher die Bereitstellung unverzüglich nach Vertragsschluss verlangen, der Unternehmer sie sofort bewirken (§ 327b Abs. 2)";
    label en unofficial "Absent an agreed time the consumer may demand the supply without undue delay after conclusion (§ 327b (2))";
    when untertitel_digitale_produkte_anwendbar(v);
    when digitales_produkt_des_vertrags(v, d);
    when keine_zeit_der_bereitstellung_vereinbart(v, d);
    then bereitstellung_unverzueglich_verlangbar(v, d);
}

@source(BGB_P327b)
rule BeweislastDerBereitstellung(v: Vertrag, d: DigitalesProdukt, unternehmerpartei: Person) strict {
    label de official "Die Beweislast für die nach den Absätzen 1 bis 4 erfolgte Bereitstellung trifft abweichend von § 363 den Unternehmer (§ 327b Abs. 6)";
    label en unofficial "Contrary to § 363 the trader bears the burden of proving the supply (§ 327b (6))";
    when untertitel_digitale_produkte_anwendbar(v);
    when digitales_produkt_des_vertrags(v, d);
    when vertragspartei(v, unternehmerpartei);
    when unternehmer(unternehmerpartei);
    then beweislast_der_bereitstellung_beim_unternehmer(d, unternehmerpartei);
}

// --- § 327c Rechte bei unterbliebener Bereitstellung ---------------------------------------------------

pub relation aufforderung_zur_bereitstellung(v: Vertrag, d: DigitalesProdukt) kind empirical {
    label de official "Der Verbraucher hat den Unternehmer zur Bereitstellung aufgefordert (§ 327c Abs. 1 Satz 1)";
    label en unofficial "the consumer requested the trader to supply (§ 327c (1) sentence 1)";
}
pub relation bereitstellung_nach_aufforderung_unterblieben(v: Vertrag, d: DigitalesProdukt) kind empirical {
    label de official "Der Unternehmer kommt seiner fälligen Verpflichtung zur Bereitstellung auf Aufforderung nicht unverzüglich nach (§ 327c Abs. 1 Satz 1)";
    label en unofficial "the trader does not comply with his due obligation to supply without undue delay upon request (§ 327c (1) sentence 1)";
}
pub enum EntbehrlichkeitDerAufforderung {
    label de official "Grund, aus dem die Aufforderung entbehrlich ist (§ 327c Abs. 3 Satz 1 Nummern 1 bis 3)";
    label en unofficial "ground making the request dispensable (§ 327c (3) sentence 1 nos. 1 to 3)";
    UnternehmerVerweigertDieBereitstellung,
    EindeutigErkennbarKeineBereitstellung,
    WesentlicheTerminOderFristVersaeumt
}
pub relation aufforderung_entbehrlich(v: Vertrag, d: DigitalesProdukt, grund: EntbehrlichkeitDerAufforderung) kind empirical {
    label de official "Einer der Gründe des § 327c Abs. 3 Satz 1 liegt vor; in diesen Fällen ist die Mahnung gemäß § 286 stets entbehrlich (Satz 2)";
    label en unofficial "one of the grounds of § 327c (3) sentence 1 applies; in these cases the reminder under § 286 is always dispensable (sentence 2)";
}
pub relation vertragsbeendigung_moeglich(v: Vertrag, d: DigitalesProdukt) kind institutional {
    label de official "Der Verbraucher kann den Vertrag beenden (§ 327c Abs. 1 Satz 1, § 327m Abs. 1)";
    label en unofficial "the consumer may terminate the contract (§ 327c (1) sentence 1, § 327m (1))";
}
pub relation schadensersatz_wegen_unterbliebener_bereitstellung(v: Vertrag, d: DigitalesProdukt) kind institutional {
    label de official "Der Verbraucher kann nach den §§ 280 und 281 Absatz 1 Satz 1 Schadensersatz oder nach § 284 Ersatz vergeblicher Aufwendungen verlangen; an die Stelle der Fristsetzung tritt die Aufforderung (§ 327c Abs. 2)";
    label en unofficial "the consumer may claim damages under §§ 280, 281 (1) or expenses under § 284; the request replaces fixing a period (§ 327c (2))";
}
pub relation kein_interesse_am_anderen_teil_des_paketvertrags(v: Vertrag) kind empirical {
    label de official "Der Verbraucher hat an dem anderen Teil des Paketvertrags ohne das digitale Produkt kein Interesse (§ 327c Abs. 6 Satz 1, § 327m Abs. 4 Satz 1)";
    label en unofficial "the consumer has no interest in the other part of the package contract without the digital product (§ 327c (6), § 327m (4))";
}
pub relation loesung_vom_ganzen_paketvertrag(v: Vertrag) kind institutional {
    label de official "Der Verbraucher kann sich im Hinblick auf alle Bestandteile des Paketvertrags vom Vertrag lösen (§ 327c Abs. 6 Satz 1, § 327m Abs. 4 Satz 1)";
    label en unofficial "the consumer may release himself from all parts of the package contract (§ 327c (6), § 327m (4))";
}

@source(BGB_P327c)
rule VertragsbeendigungNachAufforderung(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Kommt der Unternehmer seiner fälligen Verpflichtung zur Bereitstellung des digitalen Produkts auf Aufforderung des Verbrauchers nicht unverzüglich nach, so kann der Verbraucher den Vertrag beenden (§ 327c Abs. 1 Satz 1)";
    label en unofficial "Where the trader fails to supply without undue delay upon the consumer's request, the consumer may terminate the contract (§ 327c (1) sentence 1)";
    when untertitel_digitale_produkte_anwendbar(v);
    when digitales_produkt_des_vertrags(v, d);
    when aufforderung_zur_bereitstellung(v, d);
    when bereitstellung_nach_aufforderung_unterblieben(v, d);
    then vertragsbeendigung_moeglich(v, d);
}

@source(BGB_P327c)
rule VertragsbeendigungOhneAufforderung(v: Vertrag, d: DigitalesProdukt, grund: EntbehrlichkeitDerAufforderung) strict {
    label de official "Die Aufforderung ist entbehrlich, wenn der Unternehmer die Bereitstellung verweigert, es eindeutig zu erkennen ist, dass er nicht bereitstellen wird, oder er einen wesentlichen Termin versäumt (§ 327c Abs. 3)";
    label en unofficial "The request is dispensable where the trader refuses, clearly will not supply, or misses an essential date (§ 327c (3))";
    when untertitel_digitale_produkte_anwendbar(v);
    when digitales_produkt_des_vertrags(v, d);
    when aufforderung_entbehrlich(v, d, grund);
    then vertragsbeendigung_moeglich(v, d);
}

@source(BGB_P327c)
rule SchadensersatzWegenUnterbliebenerBereitstellung(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Liegen die Voraussetzungen für eine Beendigung des Vertrags vor, so kann der Verbraucher nach den §§ 280 und 281 Absatz 1 Satz 1 Schadensersatz oder nach § 284 Ersatz vergeblicher Aufwendungen verlangen (§ 327c Abs. 2)";
    label en unofficial "Where the requirements for termination are met, the consumer may claim damages under §§ 280, 281 (1) or expenses under § 284 (§ 327c (2))";
    when vertragsbeendigung_moeglich(v, d);
    then schadensersatz_wegen_unterbliebener_bereitstellung(v, d);
}

@source(BGB_P327c)
rule LoesungVomGanzenPaketvertrag(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Sofern der Verbraucher den Vertrag beenden kann, kann er sich im Hinblick auf alle Bestandteile des Paketvertrags vom Vertrag lösen, wenn er an dem anderen Teil ohne das nicht bereitgestellte digitale Produkt kein Interesse hat (§ 327c Abs. 6 Satz 1)";
    label en unofficial "Where the consumer may terminate, he may release himself from all parts of the package contract if he has no interest in the other part (§ 327c (6) sentence 1)";
    when vertragsbeendigung_moeglich(v, d);
    when paketvertrag(v, d);
    when kein_interesse_am_anderen_teil_des_paketvertrags(v);
    then loesung_vom_ganzen_paketvertrag(v);
}

// --- §§ 327d–327h Vertragsmäßigkeit, Mangel, Aktualisierungen -------------------------------------------

pub relation subjektive_anforderungen_erfuellt(d: DigitalesProdukt) kind empirical {
    label de official "Das digitale Produkt entspricht den subjektiven Anforderungen: vereinbarte Beschaffenheit einschließlich Menge, Funktionalität, Kompatibilität und Interoperabilität, Eignung für die vorausgesetzte Verwendung, vereinbartes Zubehör und vereinbarte Aktualisierungen (§ 327e Abs. 2)";
    label en unofficial "the digital product meets the subjective requirements of § 327e (2)";
}
pub relation objektive_anforderungen_erfuellt(d: DigitalesProdukt) kind empirical {
    label de official "Das digitale Produkt entspricht den objektiven Anforderungen des § 327e Abs. 3 (gewöhnliche Verwendung, übliche Beschaffenheit, Testversion, Zubehör und Anleitungen, Aktualisierungen nach § 327f, neueste Version)";
    label en unofficial "the digital product meets the objective requirements of § 327e (3)";
}
pub relation anforderungen_an_die_integration_erfuellt(d: DigitalesProdukt) kind empirical {
    label de official "Das digitale Produkt entspricht den Anforderungen an die Integration (§ 327e Abs. 4)";
    label en unofficial "the digital product meets the integration requirements (§ 327e (4))";
}
pub relation subjektive_anforderungen_nicht_erfuellt(d: DigitalesProdukt) kind empirical {
    label de official "Das digitale Produkt entspricht den subjektiven Anforderungen nicht (§ 327e Abs. 2) — ausdrückliche Angabe des Falls";
    label en unofficial "the digital product does not meet the subjective requirements (§ 327e (2)) — explicit case input";
}
pub relation objektive_anforderungen_nicht_erfuellt(d: DigitalesProdukt) kind empirical {
    label de official "Das digitale Produkt entspricht den objektiven Anforderungen nicht (§ 327e Abs. 3) — ausdrückliche Angabe des Falls";
    label en unofficial "the digital product does not meet the objective requirements (§ 327e (3)) — explicit case input";
}
pub relation anderes_produkt_bereitgestellt(d: DigitalesProdukt) kind empirical {
    label de official "Der Unternehmer stellt ein anderes digitales Produkt als das vertraglich geschuldete bereit; dies steht einem Produktmangel gleich (§ 327e Abs. 5)";
    label en unofficial "the trader supplies a digital product other than the one owed; this is equivalent to a product defect (§ 327e (5))";
}
pub relation produktmangel(d: DigitalesProdukt) kind institutional {
    label de official "Das digitale Produkt hat einen Produktmangel (§ 327e)";
    label en unofficial "the digital product has a product defect (§ 327e)";
}
pub relation nutzung_ohne_verletzung_von_rechten_dritter_moeglich(d: DigitalesProdukt) kind empirical {
    label de official "Der Verbraucher kann das digitale Produkt gemäß den subjektiven oder objektiven Anforderungen nutzen, ohne Rechte Dritter zu verletzen (§ 327g)";
    label en unofficial "the consumer may use the digital product without infringing third-party rights (§ 327g)";
}
pub relation nutzung_verletzt_rechte_dritter(d: DigitalesProdukt) kind empirical {
    label de official "Die Nutzung verletzt Rechte Dritter (§ 327g) — ausdrückliche Angabe des Falls";
    label en unofficial "the use infringes third-party rights (§ 327g) — explicit case input";
}
pub relation rechtsmangel(d: DigitalesProdukt) kind institutional {
    label de official "Das digitale Produkt hat einen Rechtsmangel (§ 327g)";
    label en unofficial "the digital product has a defect in title (§ 327g)";
}
pub relation mangelhaft(d: DigitalesProdukt) kind institutional {
    label de official "Das digitale Produkt ist mangelhaft (§§ 327d bis 327g)";
    label en unofficial "the digital product is defective (§§ 327d to 327g)";
}
pub relation erforderliche_aktualisierung_bereitgestellt(d: DigitalesProdukt) kind empirical {
    label de official "Dem Verbraucher sind während des maßgeblichen Zeitraums die für den Erhalt der Vertragsmäßigkeit erforderlichen Aktualisierungen einschließlich der Sicherheitsaktualisierungen bereitgestellt worden und er ist darüber informiert worden (§ 327f Abs. 1)";
    label en unofficial "the updates necessary to maintain conformity, including security updates, were supplied and the consumer informed (§ 327f (1))";
}
pub relation erforderliche_aktualisierung_nicht_bereitgestellt(d: DigitalesProdukt) kind empirical {
    label de official "Die erforderlichen Aktualisierungen sind nicht bereitgestellt oder der Verbraucher ist nicht informiert worden (§ 327f Abs. 1) — ausdrückliche Angabe des Falls";
    label en unofficial "the necessary updates were not supplied or the consumer not informed (§ 327f (1)) — explicit case input";
}
pub relation aktualisierungspflicht_verletzt(d: DigitalesProdukt) kind institutional {
    label de official "Die Aktualisierungspflicht ist verletzt (§ 327f Abs. 1)";
    label en unofficial "the duty to provide updates has been breached (§ 327f (1))";
}
pub relation installation_der_aktualisierung_unterlassen(d: DigitalesProdukt) kind empirical {
    label de official "Der Verbraucher hat eine bereitgestellte Aktualisierung nicht innerhalb einer angemessenen Frist installiert, obwohl er über die Verfügbarkeit und die Folgen informiert war und die Installationsanleitung nicht mangelhaft war (§ 327f Abs. 2)";
    label en unofficial "the consumer failed to install a supplied update within a reasonable period although informed and with adequate instructions (§ 327f (2))";
}
pub relation keine_haftung_fuer_fehlende_aktualisierung(d: DigitalesProdukt) kind institutional {
    label de official "Der Unternehmer haftet nicht für einen Produktmangel, der allein auf das Fehlen dieser Aktualisierung zurückzuführen ist (§ 327f Abs. 2)";
    label en unofficial "the trader is not liable for a defect due solely to the missing update (§ 327f (2))";
}
pub relation abweichung_von_objektiven_anforderungen_vereinbart(d: DigitalesProdukt) kind empirical {
    label de official "Der Verbraucher wurde vor Abgabe seiner Vertragserklärung eigens in Kenntnis gesetzt, dass ein bestimmtes Merkmal von den objektiven Anforderungen abweicht, und die Abweichung wurde im Vertrag ausdrücklich und gesondert vereinbart (§ 327h)";
    label en unofficial "the consumer was specifically informed before his declaration that a feature deviates from the objective requirements and the deviation was expressly and separately agreed (§ 327h)";
}
pub relation abweichung_von_objektiven_anforderungen_wirksam(d: DigitalesProdukt) kind institutional {
    label de official "Von den objektiven Anforderungen kann abgewichen werden (§ 327h)";
    label en unofficial "deviation from the objective requirements is permitted (§ 327h)";
}

@source(BGB_P327d)
rule PflichtZurMangelfreienBereitstellung(v: Vertrag, d: DigitalesProdukt, tag: Date) strict {
    label de official "Ist der Unternehmer durch einen Verbrauchervertrag gemäß § 327 oder § 327a zur Bereitstellung eines digitalen Produkts verpflichtet, so hat er das digitale Produkt frei von Produkt- und Rechtsmängeln bereitzustellen (§ 327d)";
    label en unofficial "Where the trader owes the supply of a digital product he must supply it free from defects in product and title (§ 327d)";
    when untertitel_digitale_produkte_anwendbar(v);
    when digitales_produkt_des_vertrags(v, d);
    when bereitgestellt_am(d, tag);
    when subjektive_anforderungen_erfuellt(d);
    when objektive_anforderungen_erfuellt(d);
    when anforderungen_an_die_integration_erfuellt(d);
    when nutzung_ohne_verletzung_von_rechten_dritter_moeglich(d);
    then vertragsgemaess(d);
}

@source(BGB_P327d)
pub relation vertragsgemaess(d: DigitalesProdukt) kind institutional {
    label de official "Das digitale Produkt ist frei von Produkt- und Rechtsmängeln (§ 327d, § 327e Abs. 1, § 327g)";
    label en unofficial "the digital product is free from defects in product and title (§ 327d, § 327e (1), § 327g)";
}

@source(BGB_P327e)
rule ProduktmangelWegenSubjektiverAnforderungen(d: DigitalesProdukt, tag: Date) strict {
    label de official "Das digitale Produkt ist frei von Produktmängeln, wenn es zur maßgeblichen Zeit den subjektiven, den objektiven und den Integrationsanforderungen entspricht (§ 327e Abs. 1); maßgeblich ist der Zeitpunkt der Bereitstellung — hier fehlen die subjektiven Anforderungen (Abs. 2)";
    label en unofficial "The product is free from defects if at the relevant time it meets the subjective, objective and integration requirements (§ 327e (1)); here the subjective requirements are not met ((2))";
    when bereitgestellt_am(d, tag);
    when subjektive_anforderungen_nicht_erfuellt(d);
    then produktmangel(d);
}

@source(BGB_P327e)
rule ProduktmangelWegenObjektiverAnforderungen(d: DigitalesProdukt, tag: Date) strict {
    label de official "Das digitale Produkt entspricht den objektiven Anforderungen nicht (§ 327e Abs. 3): es hat einen Produktmangel";
    label en unofficial "The digital product does not meet the objective requirements (§ 327e (3)): it has a product defect";
    when bereitgestellt_am(d, tag);
    when objektive_anforderungen_nicht_erfuellt(d);
    then produktmangel(d);
}

@source(BGB_P327e)
rule AnderesProduktStehtDemMangelGleich(d: DigitalesProdukt) strict {
    label de official "Einem Produktmangel steht es gleich, wenn der Unternehmer ein anderes digitales Produkt als das vertraglich geschuldete bereitstellt (§ 327e Abs. 5)";
    label en unofficial "Supplying a digital product other than the one owed is equivalent to a product defect (§ 327e (5))";
    when anderes_produkt_bereitgestellt(d);
    then produktmangel(d);
}

@source(BGB_P327f)
rule VerletzungDerAktualisierungspflicht(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Der Unternehmer hat sicherzustellen, dass dem Verbraucher während des maßgeblichen Zeitraums die erforderlichen Aktualisierungen einschließlich der Sicherheitsaktualisierungen bereitgestellt werden und der Verbraucher darüber informiert wird (§ 327f Abs. 1)";
    label en unofficial "The trader must ensure that the necessary updates, including security updates, are supplied during the relevant period and that the consumer is informed (§ 327f (1))";
    when untertitel_digitale_produkte_anwendbar(v);
    when digitales_produkt_des_vertrags(v, d);
    when erforderliche_aktualisierung_nicht_bereitgestellt(d);
    then aktualisierungspflicht_verletzt(d);
}

@source(BGB_P327f)
rule KeineHaftungBeiUnterlasseneInstallation(d: DigitalesProdukt) strict {
    label de official "Unterlässt es der Verbraucher, eine bereitgestellte Aktualisierung innerhalb einer angemessenen Frist zu installieren, so haftet der Unternehmer nicht für einen Produktmangel, der allein auf das Fehlen dieser Aktualisierung zurückzuführen ist (§ 327f Abs. 2)";
    label en unofficial "Where the consumer fails to install a supplied update within a reasonable period, the trader is not liable for a defect due solely to its absence (§ 327f (2))";
    when installation_der_aktualisierung_unterlassen(d);
    then keine_haftung_fuer_fehlende_aktualisierung(d);
}

@source(BGB_P327g)
rule RechtsmangelDesDigitalenProdukts(d: DigitalesProdukt, tag: Date) strict {
    label de official "Das digitale Produkt ist frei von Rechtsmängeln, wenn der Verbraucher es gemäß den subjektiven oder objektiven Anforderungen nutzen kann, ohne Rechte Dritter zu verletzen (§ 327g) — hier verletzt die Nutzung Rechte Dritter";
    label en unofficial "The product is free from defects in title if the consumer can use it without infringing third-party rights (§ 327g) — here such rights are infringed";
    when bereitgestellt_am(d, tag);
    when nutzung_verletzt_rechte_dritter(d);
    then rechtsmangel(d);
}

@source(BGB_P327i)
rule ProduktmangelMachtDasProduktMangelhaft(d: DigitalesProdukt) strict {
    label de official "Ist das digitale Produkt mangelhaft, kann der Verbraucher Nacherfüllung verlangen, den Vertrag beenden oder den Preis mindern und Schadensersatz oder Ersatz vergeblicher Aufwendungen verlangen (§ 327i) — der Produktmangel macht es mangelhaft";
    label en unofficial "Where the digital product is defective the consumer has the rights of § 327i — a product defect makes it defective";
    when produktmangel(d);
    then mangelhaft(d);
}

@source(BGB_P327i)
rule RechtsmangelMachtDasProduktMangelhaft(d: DigitalesProdukt) strict {
    label de official "Auch der Rechtsmangel macht das digitale Produkt mangelhaft (§ 327i mit § 327g)";
    label en unofficial "A defect in title likewise makes the digital product defective (§ 327i with § 327g)";
    when rechtsmangel(d);
    then mangelhaft(d);
}

@source(BGB_P327h)
rule WirksameAbweichungVonObjektivenAnforderungen(d: DigitalesProdukt) strict {
    label de official "Von den objektiven Anforderungen nach § 327e Abs. 3 Satz 1 Nummer 1 bis 5 und Satz 2, § 327f Abs. 1 und § 327g kann nur abgewichen werden, wenn der Verbraucher vorher eigens in Kenntnis gesetzt wurde und die Abweichung ausdrücklich und gesondert vereinbart wurde (§ 327h)";
    label en unofficial "Deviation from the objective requirements is possible only with specific prior information and an express, separate agreement (§ 327h)";
    when abweichung_von_objektiven_anforderungen_vereinbart(d);
    then abweichung_von_objektiven_anforderungen_wirksam(d);
}

// --- §§ 327j, 327k Verjährung und Beweislastumkehr -------------------------------------------------------

pub relation mangel_erstmals_gezeigt_am(d: DigitalesProdukt, tag: Date) kind empirical {
    key(d);
    label de official "Tag, an dem sich der Mangel erstmals gezeigt hat (§ 327j Abs. 4, § 327k Abs. 1)";
    label en unofficial "day on which the defect first appeared (§ 327j (4), § 327k (1))";
}
pub relation verjaehrung_der_maengelansprueche_ende(d: DigitalesProdukt, tag: Date) kind institutional {
    key(d);
    label de official "Tag, mit dessen Ablauf die Ansprüche nach § 327i Nummer 1 und 3 verjähren: zwei Jahre ab der Bereitstellung (§ 327j Abs. 1)";
    label en unofficial "day at whose end the claims under § 327i nos. 1 and 3 become time-barred: two years from the supply (§ 327j (1))";
}
pub relation verjaehrung_nicht_vor(d: DigitalesProdukt, tag: Date) kind institutional {
    label de official "Tag, vor dessen Ablauf die Verjährung nicht eintritt (§ 327j Abs. 2, 3, 4)";
    label en unofficial "day before whose end limitation does not occur (§ 327j (2), (3), (4))";
}
pub relation aktualisierungszeitraum_ende(d: DigitalesProdukt, tag: Date) kind empirical {
    key(d);
    label de official "Ende des für die Aktualisierungspflicht maßgeblichen Zeitraums (§ 327f Abs. 1 Satz 3, § 327j Abs. 3)";
    label en unofficial "end of the period relevant for the update obligation (§ 327f (1) sentence 3, § 327j (3))";
}
pub relation vermutung_der_mangelhaftigkeit_bei_bereitstellung(d: DigitalesProdukt) kind institutional {
    label de official "Es wird vermutet, dass das digitale Produkt bereits bei Bereitstellung mangelhaft war (§ 327k Abs. 1)";
    label en unofficial "the digital product is presumed to have been defective already at the time of supply (§ 327k (1))";
}
pub relation digitale_umgebung_nicht_kompatibel(d: DigitalesProdukt) kind empirical {
    label de official "Die digitale Umgebung des Verbrauchers war mit den technischen Anforderungen des digitalen Produkts zur maßgeblichen Zeit nicht kompatibel (§ 327k Abs. 3 Nr. 1)";
    label en unofficial "the consumer's digital environment was not compatible with the technical requirements at the relevant time (§ 327k (3) no. 1)";
}
pub relation umgebung_kompatibel_oder_kein_ausschluss(d: DigitalesProdukt) kind empirical {
    label de official "Die digitale Umgebung war kompatibel oder der Unternehmer hat nicht klar und verständlich über die technischen Anforderungen informiert (§ 327k Abs. 3, 4) — ausdrückliche Angabe des Falls";
    label en unofficial "the digital environment was compatible, or the trader did not inform clearly about the technical requirements (§ 327k (3), (4)) — explicit case input";
}

@source(BGB_P327j)
rule VerjaehrungZweiJahreAbBereitstellung(d: DigitalesProdukt, bereitstellung: Date) strict {
    label de official "Die in § 327i Nummer 1 und 3 bezeichneten Ansprüche verjähren in zwei Jahren; die Verjährung beginnt mit der Bereitstellung (§ 327j Abs. 1) — Jahresschritt nach § 188 Abs. 2, Politik BGB_SCHULDRECHT_AT_KALENDER";
    label en unofficial "The claims under § 327i nos. 1 and 3 are time-barred after two years, running from the supply (§ 327j (1))";
    when bereitgestellt_am(d, bereitstellung);
    then verjaehrung_der_maengelansprueche_ende(d, add_calendar_period(bereitstellung, 2 calendar_year));
}

@source(BGB_P327j)
rule VerjaehrungNichtVorZwoelfMonatenNachDemBereitstellungszeitraum(d: DigitalesProdukt, beginn: Date, ende: Date) strict {
    label de official "Im Fall der dauerhaften Bereitstellung verjähren die Ansprüche nicht vor Ablauf von zwölf Monaten nach dem Ende des Bereitstellungszeitraums (§ 327j Abs. 2)";
    label en unofficial "In the case of continuous supply the claims are not time-barred before twelve months after the end of the supply period (§ 327j (2))";
    when dauerhafte_bereitstellung(d, beginn, ende);
    then verjaehrung_nicht_vor(d, add_calendar_period(ende, 12 calendar_month));
}

@source(BGB_P327j)
rule VerjaehrungNichtVorZwoelfMonatenNachDemAktualisierungszeitraum(d: DigitalesProdukt, ende: Date) strict {
    label de official "Ansprüche wegen einer Verletzung der Aktualisierungspflicht verjähren nicht vor Ablauf von zwölf Monaten nach dem Ende des für die Aktualisierungspflicht maßgeblichen Zeitraums (§ 327j Abs. 3)";
    label en unofficial "Claims for breach of the update obligation are not time-barred before twelve months after the end of the relevant period (§ 327j (3))";
    when aktualisierungspflicht_verletzt(d);
    when aktualisierungszeitraum_ende(d, ende);
    then verjaehrung_nicht_vor(d, add_calendar_period(ende, 12 calendar_month));
}

@source(BGB_P327j)
rule VerjaehrungNichtVorVierMonatenNachDemZeigenDesMangels(d: DigitalesProdukt, gezeigt: Date, verjaehrung: Date) strict {
    label de official "Hat sich ein Mangel innerhalb der Verjährungsfrist gezeigt, so tritt die Verjährung nicht vor dem Ablauf von vier Monaten nach dem Zeitpunkt ein, in dem sich der Mangel erstmals gezeigt hat (§ 327j Abs. 4)";
    label en unofficial "Where a defect appeared within the limitation period, limitation does not occur before four months after it first appeared (§ 327j (4))";
    when mangel_erstmals_gezeigt_am(d, gezeigt);
    when verjaehrung_der_maengelansprueche_ende(d, verjaehrung);
    when gezeigt <= verjaehrung;
    then verjaehrung_nicht_vor(d, add_calendar_period(gezeigt, 4 calendar_month));
}

@source(BGB_P327k)
rule BeweislastumkehrImErstenJahr(d: DigitalesProdukt, bereitstellung: Date, gezeigt: Date) strict {
    label de official "Zeigt sich bei einem digitalen Produkt innerhalb eines Jahres seit seiner Bereitstellung ein von den Anforderungen nach § 327e oder § 327g abweichender Zustand, so wird vermutet, dass das digitale Produkt bereits bei Bereitstellung mangelhaft war (§ 327k Abs. 1)";
    label en unofficial "Where a state deviating from §§ 327e or 327g appears within one year of the supply, the product is presumed to have been defective at supply (§ 327k (1))";
    when bereitgestellt_am(d, bereitstellung);
    when mangel_erstmals_gezeigt_am(d, gezeigt);
    when gezeigt <= add_calendar_period(bereitstellung, 1 calendar_year);
    when umgebung_kompatibel_oder_kein_ausschluss(d);
    then vermutung_der_mangelhaftigkeit_bei_bereitstellung(d);
}

@source(BGB_P327k)
rule BeweislastumkehrBeiDauerhafterBereitstellung(d: DigitalesProdukt, beginn: Date, ende: Date, gezeigt: Date) strict {
    label de official "Zeigt sich bei einem dauerhaft bereitgestellten digitalen Produkt während der Dauer der Bereitstellung ein abweichender Zustand, so wird vermutet, dass das digitale Produkt während der bisherigen Dauer der Bereitstellung mangelhaft war (§ 327k Abs. 2)";
    label en unofficial "Where such a state appears during continuous supply, the product is presumed to have been defective throughout the supply so far (§ 327k (2))";
    when dauerhafte_bereitstellung(d, beginn, ende);
    when mangel_erstmals_gezeigt_am(d, gezeigt);
    when gezeigt >= beginn;
    when gezeigt <= ende;
    when umgebung_kompatibel_oder_kein_ausschluss(d);
    then vermutung_der_mangelhaftigkeit_bei_bereitstellung(d);
}

// --- §§ 327l–327p Nacherfüllung, Beendigung, Minderung ----------------------------------------------------

pub relation nacherfuellung_verlangt(d: DigitalesProdukt, tag: Date) kind empirical {
    key(d);
    label de official "Tag, an dem der Verbraucher den Unternehmer über den Mangel informiert und Nacherfüllung verlangt hat (§ 327l Abs. 1)";
    label en unofficial "day on which the consumer informed the trader of the defect and demanded cure (§ 327l (1))";
}
pub relation nacherfuellung_geschuldet(d: DigitalesProdukt) kind institutional {
    label de official "Der Unternehmer hat den vertragsgemäßen Zustand herzustellen und die zum Zwecke der Nacherfüllung erforderlichen Aufwendungen zu tragen; die Nacherfüllung ist innerhalb einer angemessenen Frist und ohne erhebliche Unannehmlichkeiten durchzuführen (§ 327l Abs. 1)";
    label en unofficial "the trader must restore conformity and bear the costs of cure, within a reasonable period and without significant inconvenience (§ 327l (1))";
}
@source(BGB_P327l)
pub external judgment relation nacherfuellung_unmoeglich_oder_unverhaeltnismaessig(d: DigitalesProdukt) {
    authority Court;
    label de official "§ 327l Abs. 2. Das Gericht hat festgestellt, dass die Nacherfüllung unmöglich oder für den Unternehmer nur mit unverhältnismäßigen Kosten möglich ist; dabei sind der Wert des digitalen Produkts in mangelfreiem Zustand und die Bedeutung des Mangels zu berücksichtigen";
    label en unofficial "§ 327l (2). The court found cure impossible or possible only at disproportionate cost, considering the value of the conforming product and the significance of the defect";
}
pub relation nacherfuellungsanspruch_ausgeschlossen(d: DigitalesProdukt) kind institutional {
    label de official "Der Anspruch auf Nacherfüllung ist ausgeschlossen; § 275 Absatz 2 und 3 findet keine Anwendung (§ 327l Abs. 2)";
    label en unofficial "the claim to cure is excluded; § 275 (2), (3) does not apply (§ 327l (2))";
}
pub relation nacherfuellung_nicht_erfolgt(d: DigitalesProdukt) kind empirical {
    label de official "Der Nacherfüllungsanspruch ist nicht gemäß § 327l Abs. 1 erfüllt worden, es zeigt sich trotz versuchter Nacherfüllung ein Mangel, der Unternehmer hat die ordnungsgemäße Nacherfüllung verweigert oder es ist offensichtlich, dass er nicht ordnungsgemäß nacherfüllen wird (§ 327m Abs. 1 Nummern 2, 3, 5, 6)";
    label en unofficial "cure was not performed, a defect persists, the trader refused proper cure, or it is obvious he will not cure properly (§ 327m (1) nos. 2, 3, 5, 6)";
}
@source(BGB_P327m)
pub external judgment relation mangel_derart_schwerwiegend(d: DigitalesProdukt) {
    authority Court;
    label de official "§ 327m Abs. 1 Nr. 4. Das Gericht hat festgestellt, dass der Mangel derart schwerwiegend ist, dass die sofortige Vertragsbeendigung gerechtfertigt ist";
    label en unofficial "§ 327m (1) no. 4. The court found the defect so serious that immediate termination is justified";
}
@source(BGB_P327m)
pub external judgment relation mangel_unerheblich(d: DigitalesProdukt) {
    authority Court;
    label de official "§ 327m Abs. 2 Satz 1. Das Gericht hat festgestellt, dass der Mangel unerheblich ist; die Beendigung des Vertrags ist dann ausgeschlossen — nicht bei Verbraucherverträgen im Sinne des § 327 Abs. 3 (Satz 2)";
    label en unofficial "§ 327m (2) sentence 1. The court found the defect trivial; termination is then excluded — not for contracts under § 327 (3) (sentence 2)";
}
pub relation mangel_nicht_unerheblich(d: DigitalesProdukt) kind empirical {
    label de official "Der Mangel ist nicht unerheblich (§ 327m Abs. 2 Satz 1) — ausdrückliche Angabe des Falls";
    label en unofficial "the defect is not trivial (§ 327m (2) sentence 1) — explicit case input";
}
pub relation beendigung_ausgeschlossen(d: DigitalesProdukt) kind institutional {
    label de official "Eine Beendigung des Vertrags nach § 327m Abs. 1 ist ausgeschlossen, weil der Mangel unerheblich ist (§ 327m Abs. 2 Satz 1)";
    label en unofficial "termination under § 327m (1) is excluded because the defect is trivial (§ 327m (2) sentence 1)";
}
pub relation schadensersatz_statt_der_leistung_digitale_produkte(v: Vertrag, d: DigitalesProdukt) kind institutional {
    label de official "In den Fällen des § 327m Abs. 1 Nummer 1 bis 6 kann der Verbraucher unter den Voraussetzungen des § 280 Abs. 1 Schadensersatz statt der Leistung verlangen (§ 327m Abs. 3)";
    label en unofficial "in the cases of § 327m (1) the consumer may claim damages in lieu of performance under § 280 (1) (§ 327m (3))";
}
pub relation minderung_erklaert(v: Vertrag, d: DigitalesProdukt, tag: Date) kind empirical {
    key(d);
    label de official "Tag des Zugangs der Minderungserklärung beim Unternehmer (§ 327n Abs. 1, Abs. 4 Satz 3)";
    label en unofficial "day on which the declaration of price reduction reached the trader (§ 327n (1), (4) sentence 3)";
}
@source(BGB_P327n)
pub external judgment relation geminderter_preis(d: DigitalesProdukt, betrag: Money) {
    authority Court;
    label de official "§ 327n Abs. 2, 3. Das Gericht hat den geminderten Preis bestimmt: der Preis ist in dem Verhältnis herabzusetzen, in welchem zum Zeitpunkt der Bereitstellung der Wert des digitalen Produkts in mangelfreiem Zustand zu dem wirklichen Wert gestanden haben würde; bei dauerhafter Bereitstellung nur anteilig für die Dauer der Mangelhaftigkeit; die Minderung ist, soweit erforderlich, durch Schätzung zu ermitteln";
    label en unofficial "§ 327n (2), (3). The court determined the reduced price in the ratio of the value in conforming state to the actual value, pro rata for the period of non-conformity, by estimate where necessary";
}
pub relation gezahlter_preis(d: DigitalesProdukt, betrag: Money) kind empirical {
    key(d);
    label de official "Vom Verbraucher gezahlter Preis (§ 327n Abs. 4 Satz 1)";
    label en unofficial "price paid by the consumer (§ 327n (4) sentence 1)";
}
pub relation zu_erstattender_mehrbetrag(d: DigitalesProdukt, betrag: Money) kind institutional {
    key(d);
    label de official "Hat der Verbraucher mehr als den geminderten Preis gezahlt, so hat der Unternehmer den Mehrbetrag zu erstatten (§ 327n Abs. 4 Satz 1)";
    label en unofficial "where the consumer paid more than the reduced price the trader must refund the excess (§ 327n (4) sentence 1)";
}
pub entity Erstattungsfrist : Frist {
    label de official "Frist von 14 Tagen für die Erstattung des Mehrbetrags und der Zahlungen (§ 327n Abs. 4 Satz 2, § 327o Abs. 4)";
    label en unofficial "period of 14 days for refunding the excess and the payments (§ 327n (4) sentence 2, § 327o (4))";
}
pub relation erstattungsfrist_des_produkts(d: DigitalesProdukt, f: Erstattungsfrist) kind empirical {
    key(d);
    label de official "Erstattungsfrist dieses digitalen Produkts (§ 327n Abs. 4)";
    label en unofficial "refund period for this digital product (§ 327n (4))";
}
pub relation vertragsbeendigung_erklaert(v: Vertrag, d: DigitalesProdukt, tag: Date) kind empirical {
    key(d);
    label de official "Die Beendigung des Vertrags ist durch Erklärung gegenüber dem Unternehmer erfolgt, in welcher der Entschluss des Verbrauchers zum Ausdruck kommt; § 351 ist entsprechend anzuwenden (§ 327o Abs. 1)";
    label en unofficial "termination was declared to the trader expressing the consumer's decision; § 351 applies accordingly (§ 327o (1))";
}
pub relation zahlungen_zu_erstatten(v: Vertrag, d: DigitalesProdukt, betrag: Money) kind institutional {
    key(d);
    label de official "Im Fall der Vertragsbeendigung hat der Unternehmer dem Verbraucher die zur Erfüllung des Vertrags geleisteten Zahlungen zu erstatten; für Leistungen, die er nicht mehr zu erbringen hat, erlischt sein Anspruch auf den Preis (§ 327o Abs. 2)";
    label en unofficial "upon termination the trader must refund the payments made; his claim to the price lapses for performances no longer owed (§ 327o (2))";
}
pub relation datentraeger_zurueckzusenden(v: Vertrag, d: DigitalesProdukt) kind institutional {
    label de official "Der Verbraucher ist verpflichtet, einen vom Unternehmer bereitgestellten körperlichen Datenträger unverzüglich zurückzusenden, wenn der Unternehmer dies spätestens 14 Tage nach Vertragsbeendigung verlangt; der Unternehmer trägt die Kosten (§ 327o Abs. 5)";
    label en unofficial "the consumer must promptly return a tangible medium if the trader so demands within 14 days of termination; the trader bears the costs (§ 327o (5))";
}
pub relation rueckgabe_verlangt_am(d: DigitalesProdukt, tag: Date) kind empirical {
    key(d);
    label de official "Tag, an dem der Unternehmer die Rücksendung des körperlichen Datenträgers verlangt hat (§ 327o Abs. 5)";
    label en unofficial "day on which the trader demanded the return of the tangible medium (§ 327o (5))";
}
pub relation weitere_nutzung_untersagt(v: Vertrag, d: DigitalesProdukt) kind institutional {
    label de official "Der Verbraucher darf das digitale Produkt nach Vertragsbeendigung weder weiter nutzen noch Dritten zur Verfügung stellen; der Unternehmer ist berechtigt, die weitere Nutzung zu unterbinden (§ 327p Abs. 1)";
    label en unofficial "after termination the consumer may neither continue using the product nor make it available to third parties; the trader may prevent further use (§ 327p (1))";
}
pub relation inhalte_des_verbrauchers_bereitzustellen(v: Vertrag, d: DigitalesProdukt) kind institutional {
    label de official "Der Unternehmer hat dem Verbraucher auf dessen Verlangen die von ihm bereitgestellten oder erstellten Inhalte unentgeltlich, ohne Behinderung, innerhalb einer angemessenen Frist und in einem gängigen und maschinenlesbaren Format bereitzustellen (§ 327p Abs. 3)";
    label en unofficial "on request the trader must provide the consumer's content free of charge, without hindrance, within a reasonable period and in a common machine-readable format (§ 327p (3))";
}
pub relation verlangen_der_inhalte(d: DigitalesProdukt) kind empirical {
    label de official "Der Verbraucher verlangt die Bereitstellung der Inhalte nach § 327p Abs. 2 Satz 1 (§ 327p Abs. 3 Satz 1)";
    label en unofficial "the consumer demands the provision of the content under § 327p (2) sentence 1 (§ 327p (3) sentence 1)";
}

@source(BGB_P327l)
rule NacherfuellungBeiMangel(v: Vertrag, d: DigitalesProdukt, tag: Date) strict {
    label de official "Verlangt der Verbraucher vom Unternehmer Nacherfüllung, so hat dieser den vertragsgemäßen Zustand herzustellen und die erforderlichen Aufwendungen zu tragen; die Nacherfüllung ist innerhalb einer angemessenen Frist ab der Information über den Mangel und ohne erhebliche Unannehmlichkeiten durchzuführen (§ 327l Abs. 1)";
    label en unofficial "Where the consumer demands cure the trader must restore conformity and bear the necessary costs, within a reasonable period and without significant inconvenience (§ 327l (1))";
    when mangelhaft(d);
    when digitales_produkt_des_vertrags(v, d);
    when nacherfuellung_verlangt(d, tag);
    then nacherfuellung_geschuldet(d);
}

@source(BGB_P327l)
rule NacherfuellungAusgeschlossen(d: DigitalesProdukt) strict {
    label de official "Der Anspruch auf Nacherfüllung ist ausgeschlossen, wenn die Nacherfüllung unmöglich oder für den Unternehmer nur mit unverhältnismäßigen Kosten möglich ist; § 275 Absatz 2 und 3 findet keine Anwendung (§ 327l Abs. 2)";
    label en unofficial "The claim to cure is excluded where cure is impossible or possible only at disproportionate cost; § 275 (2), (3) does not apply (§ 327l (2))";
    when mangelhaft(d);
    when nacherfuellung_unmoeglich_oder_unverhaeltnismaessig(d);
    then nacherfuellungsanspruch_ausgeschlossen(d);
}

@source(BGB_P327m)
rule VertragsbeendigungWegenAusgeschlossenerNacherfuellung(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Ist das digitale Produkt mangelhaft, so kann der Verbraucher den Vertrag beenden, wenn der Nacherfüllungsanspruch gemäß § 327l Abs. 2 ausgeschlossen ist (§ 327m Abs. 1 Nr. 1)";
    label en unofficial "Where the product is defective the consumer may terminate if the claim to cure is excluded under § 327l (2) (§ 327m (1) no. 1)";
    when mangelhaft(d);
    when digitales_produkt_des_vertrags(v, d);
    when nacherfuellungsanspruch_ausgeschlossen(d);
    when mangel_nicht_unerheblich(d);
    then vertragsbeendigung_moeglich(v, d);
}

@source(BGB_P327m)
rule VertragsbeendigungWegenGescheiterterNacherfuellung(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Der Verbraucher kann den Vertrag beenden, wenn der Nacherfüllungsanspruch nicht gemäß § 327l Abs. 1 erfüllt wurde, sich trotz versuchter Nacherfüllung ein Mangel zeigt, der Unternehmer die ordnungsgemäße Nacherfüllung verweigert hat oder offensichtlich nicht ordnungsgemäß nacherfüllen wird (§ 327m Abs. 1 Nummern 2, 3, 5, 6)";
    label en unofficial "The consumer may terminate where cure failed, was refused or obviously will not be performed properly (§ 327m (1) nos. 2, 3, 5, 6)";
    when mangelhaft(d);
    when digitales_produkt_des_vertrags(v, d);
    when nacherfuellung_nicht_erfolgt(d);
    when mangel_nicht_unerheblich(d);
    then vertragsbeendigung_moeglich(v, d);
}

@source(BGB_P327m)
rule VertragsbeendigungWegenSchwerenMangels(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Der Verbraucher kann den Vertrag beenden, wenn der Mangel derart schwerwiegend ist, dass die sofortige Vertragsbeendigung gerechtfertigt ist (§ 327m Abs. 1 Nr. 4)";
    label en unofficial "The consumer may terminate where the defect is so serious that immediate termination is justified (§ 327m (1) no. 4)";
    when mangelhaft(d);
    when digitales_produkt_des_vertrags(v, d);
    when mangel_derart_schwerwiegend(d);
    then vertragsbeendigung_moeglich(v, d);
}

@source(BGB_P327m)
rule BeendigungBeiUnerheblichemMangelAusgeschlossen(d: DigitalesProdukt) strict {
    label de official "Eine Beendigung des Vertrags nach Absatz 1 ist ausgeschlossen, wenn der Mangel unerheblich ist; dies gilt nicht für Verbraucherverträge im Sinne des § 327 Absatz 3 (§ 327m Abs. 2)";
    label en unofficial "Termination under (1) is excluded where the defect is trivial; not for contracts under § 327 (3) (§ 327m (2))";
    when mangelhaft(d);
    when mangel_unerheblich(d);
    then beendigung_ausgeschlossen(d);
}

@source(BGB_P327m)
rule SchadensersatzStattDerLeistungBeiDigitalenProdukten(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "In den Fällen des Absatzes 1 Nummer 1 bis 6 kann der Verbraucher unter den Voraussetzungen des § 280 Absatz 1 Schadensersatz statt der Leistung verlangen (§ 327m Abs. 3)";
    label en unofficial "In the cases of (1) nos. 1 to 6 the consumer may claim damages in lieu of performance under § 280 (1) (§ 327m (3))";
    when vertragsbeendigung_moeglich(v, d);
    then schadensersatz_statt_der_leistung_digitale_produkte(v, d);
}

@source(BGB_P327n)
rule MinderungDesPreises(v: Vertrag, d: DigitalesProdukt, tag: Date, gemindert: Money, gezahlt: Money) strict {
    label de official "Statt den Vertrag zu beenden, kann der Verbraucher den Preis durch Erklärung gegenüber dem Unternehmer mindern (§ 327n Abs. 1); hat der Verbraucher mehr als den geminderten Preis gezahlt, so hat der Unternehmer den Mehrbetrag zu erstatten (Abs. 4 Satz 1)";
    label en unofficial "Instead of terminating, the consumer may reduce the price by declaration (§ 327n (1)); the trader must refund any excess paid ((4) sentence 1)";
    when mangelhaft(d);
    when digitales_produkt_des_vertrags(v, d);
    when minderung_erklaert(v, d, tag);
    when geminderter_preis(d, gemindert);
    when gezahlter_preis(d, gezahlt);
    then zu_erstattender_mehrbetrag(d, gezahlt - gemindert);
}

@source(BGB_P327n)
rule EreignisDerErstattungsfrist(d: DigitalesProdukt, f: Erstattungsfrist, v: Vertrag, tag: Date) strict {
    label de official "Der Mehrbetrag ist unverzüglich, auf jeden Fall aber innerhalb von 14 Tagen zu erstatten; die Frist beginnt mit dem Zugang der Minderungserklärung beim Unternehmer (§ 327n Abs. 4 Sätze 2, 3)";
    label en unofficial "The excess must be refunded without undue delay, in any case within 14 days, running from receipt of the declaration (§ 327n (4) sentences 2, 3)";
    when erstattungsfrist_des_produkts(d, f);
    when minderung_erklaert(v, d, tag);
    then de.bgb.fristen::frist_ereignis(f, tag);
}

@source(BGB_P327n)
rule DauerDerErstattungsfrist(d: DigitalesProdukt, f: Erstattungsfrist, tag: Date) strict {
    label de official "Die Erstattungsfrist beträgt 14 Tage (§ 327n Abs. 4 Satz 2) — Tagesfrist nach §§ 187 Abs. 1, 188 Abs. 1";
    label en unofficial "The refund period is 14 days (§ 327n (4) sentence 2) — a period fixed by days";
    when erstattungsfrist_des_produkts(d, f);
    when de.bgb.fristen::frist_ereignis(f, tag);
    then de.bgb.fristen::frist_dauer_tage(f, 14 calendar_day);
}

@source(BGB_P327o)
rule RechtsfolgenDerVertragsbeendigung(v: Vertrag, d: DigitalesProdukt, tag: Date, betrag: Money) strict {
    label de official "Im Fall der Vertragsbeendigung hat der Unternehmer dem Verbraucher die Zahlungen zu erstatten, die der Verbraucher zur Erfüllung des Vertrags geleistet hat; für Leistungen, die der Unternehmer nicht mehr zu erbringen hat, erlischt sein Anspruch auf Zahlung des vereinbarten Preises (§ 327o Abs. 2)";
    label en unofficial "Upon termination the trader must refund the payments made; his claim to the price lapses for performances no longer owed (§ 327o (2))";
    when vertragsbeendigung_erklaert(v, d, tag);
    when gezahlter_preis(d, betrag);
    then zahlungen_zu_erstatten(v, d, betrag);
}

@source(BGB_P327o)
rule RuecksendungDesDatentraegersNachVerlangen(v: Vertrag, d: DigitalesProdukt, beendigung: Date, verlangen: Date) strict {
    label de official "Der Verbraucher ist verpflichtet, einen vom Unternehmer bereitgestellten körperlichen Datenträger unverzüglich zurückzusenden, wenn der Unternehmer dies spätestens 14 Tage nach Vertragsbeendigung verlangt; der Unternehmer trägt die Kosten der Rücksendung (§ 327o Abs. 5)";
    label en unofficial "The consumer must promptly return a tangible medium if the trader demands it within 14 days of termination; the trader bears the return costs (§ 327o (5))";
    when vertragsbeendigung_erklaert(v, d, beendigung);
    when koerperlicher_datentraeger_nur_als_traeger(d);
    when rueckgabe_verlangt_am(d, verlangen);
    when verlangen <= add_calendar_period(beendigung, 14 calendar_day);
    then datentraeger_zurueckzusenden(v, d);
}

@source(BGB_P327p)
rule WeitereNutzungNachVertragsbeendigungUntersagt(v: Vertrag, d: DigitalesProdukt, tag: Date) strict {
    label de official "Der Verbraucher darf das digitale Produkt nach Vertragsbeendigung weder weiter nutzen noch Dritten zur Verfügung stellen; der Unternehmer ist berechtigt, die weitere Nutzung zu unterbinden (§ 327p Abs. 1)";
    label en unofficial "After termination the consumer may not continue using the product or make it available to third parties; the trader may prevent further use (§ 327p (1))";
    when vertragsbeendigung_erklaert(v, d, tag);
    then weitere_nutzung_untersagt(v, d);
}

@source(BGB_P327p)
rule InhalteDesVerbrauchersSindBereitzustellen(v: Vertrag, d: DigitalesProdukt, tag: Date) strict {
    label de official "Der Unternehmer hat dem Verbraucher auf dessen Verlangen die Inhalte gemäß Absatz 2 Satz 1 unentgeltlich, ohne Behinderung, innerhalb einer angemessenen Frist und in einem gängigen und maschinenlesbaren Format bereitzustellen (§ 327p Abs. 3)";
    label en unofficial "On request the trader must provide the consumer's content free of charge, without hindrance, within a reasonable period and in a common machine-readable format (§ 327p (3))";
    when vertragsbeendigung_erklaert(v, d, tag);
    when verlangen_der_inhalte(d);
    then inhalte_des_verbrauchers_bereitzustellen(v, d);
}

// --- §§ 327q–327s Datenschutzerklärungen, Änderungen, abweichende Vereinbarungen ---------------------------

pub relation datenschutzrechtliche_einwilligung_widerrufen(v: Vertrag, d: DigitalesProdukt) kind empirical {
    label de official "Der Verbraucher widerruft eine datenschutzrechtliche Einwilligung oder widerspricht einer weiteren Verarbeitung seiner personenbezogenen Daten (§ 327q Abs. 2)";
    label en unofficial "the consumer withdraws data protection consent or objects to further processing of his personal data (§ 327q (2))";
}
pub relation wirksamkeit_des_vertrags_unberuehrt(v: Vertrag) kind institutional {
    label de official "Die Ausübung von datenschutzrechtlichen Betroffenenrechten und die Abgabe datenschutzrechtlicher Erklärungen nach Vertragsschluss lassen die Wirksamkeit des Vertrags unberührt (§ 327q Abs. 1); Ersatzansprüche des Unternehmers sind ausgeschlossen (Abs. 3)";
    label en unofficial "exercising data protection rights after conclusion does not affect the validity of the contract (§ 327q (1)); the trader's claims for compensation are excluded ((3))";
}
@source(BGB_P327q)
pub external judgment relation fortsetzung_nach_widerruf_nicht_zumutbar(v: Vertrag) {
    authority Court;
    label de official "§ 327q Abs. 2. Das Gericht hat festgestellt, dass dem Unternehmer unter Berücksichtigung des weiterhin zulässigen Umfangs der Datenverarbeitung und unter Abwägung der beiderseitigen Interessen die Fortsetzung des Vertragsverhältnisses nicht zugemutet werden kann";
    label en unofficial "§ 327q (2). The court found that continuation of the contract cannot be required of the trader, considering the permissible extent of data processing and both parties' interests";
}
pub relation kuendigung_ohne_frist_nach_datenschutzwiderruf(v: Vertrag, unternehmerpartei: Person) kind institutional {
    label de official "Der Unternehmer kann einen Vertrag, der ihn zu einer Reihe einzelner Bereitstellungen oder zur dauerhaften Bereitstellung verpflichtet, ohne Einhaltung einer Kündigungsfrist kündigen (§ 327q Abs. 2)";
    label en unofficial "the trader may terminate a contract on a series of supplies or continuous supply without a notice period (§ 327q (2))";
}
pub relation aenderung_ueber_das_erforderliche_mass_hinaus(d: DigitalesProdukt) kind empirical {
    label de official "Der Unternehmer nimmt bei dauerhafter Bereitstellung Änderungen vor, die über das zur Aufrechterhaltung der Vertragsmäßigkeit erforderliche Maß hinausgehen (§ 327r Abs. 1)";
    label en unofficial "in continuous supply the trader makes changes beyond what is necessary to maintain conformity (§ 327r (1))";
}
pub relation aenderung_vertraglich_vorgesehen_und_triftig(d: DigitalesProdukt) kind empirical {
    label de official "Der Vertrag sieht die Möglichkeit der Änderung vor und enthält einen triftigen Grund dafür, dem Verbraucher entstehen keine zusätzlichen Kosten und er wird klar und verständlich über die Änderung informiert (§ 327r Abs. 1 Nummern 1 bis 3)";
    label en unofficial "the contract provides for the change with a valid reason, the consumer incurs no additional costs and is informed clearly (§ 327r (1) nos. 1 to 3)";
}
pub relation aenderung_zulaessig(d: DigitalesProdukt) kind institutional {
    label de official "Die Änderung des digitalen Produkts ist zulässig (§ 327r Abs. 1)";
    label en unofficial "the change to the digital product is permitted (§ 327r (1))";
}
pub relation zugriff_oder_nutzbarkeit_beeintraechtigt(d: DigitalesProdukt) kind empirical {
    label de official "Die Änderung beeinträchtigt die Zugriffsmöglichkeit oder die Nutzbarkeit des digitalen Produkts für den Verbraucher und die Beeinträchtigung ist nicht nur unerheblich (§ 327r Abs. 2, Abs. 4 Nr. 1)";
    label en unofficial "the change impairs access to or usability of the digital product and the impairment is not merely trivial (§ 327r (2), (4) no. 1)";
}
pub relation information_ueber_die_aenderung_zugegangen_am(d: DigitalesProdukt, tag: Date) kind empirical {
    key(d);
    label de official "Tag des Zugangs der Information über die Änderung auf einem dauerhaften Datenträger (§ 327r Abs. 2, Abs. 3 Satz 2)";
    label en unofficial "day of receipt of the information about the change on a durable medium (§ 327r (2), (3) sentence 2)";
}
pub entity Beendigungsfrist : Frist {
    label de official "Frist von 30 Tagen für die unentgeltliche Beendigung des Vertrags nach einer beeinträchtigenden Änderung (§ 327r Abs. 3)";
    label en unofficial "period of 30 days to terminate the contract free of charge after an impairing change (§ 327r (3))";
}
pub relation beendigungsfrist_des_produkts(d: DigitalesProdukt, f: Beendigungsfrist) kind empirical {
    key(d);
    label de official "Beendigungsfrist dieses digitalen Produkts (§ 327r Abs. 3)";
    label en unofficial "termination period for this digital product (§ 327r (3))";
}
pub relation zugriff_auf_unveraendertes_produkt_bleibt(d: DigitalesProdukt) kind empirical {
    label de official "Dem Verbraucher bleiben die Zugriffsmöglichkeit auf das unveränderte digitale Produkt und dessen Nutzbarkeit ohne zusätzliche Kosten erhalten (§ 327r Abs. 4 Nr. 2)";
    label en unofficial "the consumer retains access to and usability of the unchanged product without additional costs (§ 327r (4) no. 2)";
}
pub relation unentgeltliche_beendigung_moeglich(v: Vertrag, d: DigitalesProdukt) kind institutional {
    label de official "Der Verbraucher kann den Vertrag innerhalb von 30 Tagen unentgeltlich beenden (§ 327r Abs. 3 Satz 1)";
    label en unofficial "the consumer may terminate the contract free of charge within 30 days (§ 327r (3) sentence 1)";
}
pub relation vereinbarung_zum_nachteil_des_verbrauchers_digital(v: Vertrag) kind empirical {
    label de official "Eine Vereinbarung mit dem Verbraucher weicht zum Nachteil des Verbrauchers von den Vorschriften dieses Untertitels ab und wurde vor der Mitteilung über die unterbliebene Bereitstellung oder den Mangel getroffen (§ 327s Abs. 1)";
    label en unofficial "an agreement deviates to the consumer's disadvantage and was made before the notice of non-supply or defect (§ 327s (1))";
}
pub relation unternehmer_kann_sich_nicht_berufen(v: Vertrag) kind institutional {
    label de official "Auf die Vereinbarung kann sich der Unternehmer nicht berufen (§ 327s Abs. 1, 2); die Vorschriften sind auch bei Umgehung anzuwenden (Abs. 3); die Absätze 1 und 2 gelten nicht für den Ausschluss des Schadensersatzanspruchs (Abs. 4) und § 327h bleibt unberührt (Abs. 5)";
    label en unofficial "the trader may not rely on the agreement (§ 327s (1), (2)); the provisions also apply in case of circumvention ((3)); (1) and (2) do not apply to damages ((4)) and § 327h remains unaffected ((5))";
}

@source(BGB_P327q)
rule DatenschutzerklaerungenLassenDenVertragUnberuehrt(v: Vertrag, d: DigitalesProdukt) strict {
    label de official "Die Ausübung von datenschutzrechtlichen Betroffenenrechten und die Abgabe datenschutzrechtlicher Erklärungen des Verbrauchers nach Vertragsschluss lassen die Wirksamkeit des Vertrags unberührt (§ 327q Abs. 1)";
    label en unofficial "Exercising data protection rights after conclusion does not affect the validity of the contract (§ 327q (1))";
    when untertitel_digitale_produkte_anwendbar(v);
    when datenschutzrechtliche_einwilligung_widerrufen(v, d);
    then wirksamkeit_des_vertrags_unberuehrt(v);
}

@source(BGB_P327q)
rule KuendigungsrechtDesUnternehmersNachDatenschutzwiderruf(v: Vertrag, d: DigitalesProdukt, unternehmerpartei: Person) strict {
    label de official "Widerruft der Verbraucher eine datenschutzrechtliche Einwilligung oder widerspricht er einer weiteren Verarbeitung, so kann der Unternehmer den Vertrag über eine Reihe einzelner Bereitstellungen oder über die dauerhafte Bereitstellung ohne Einhaltung einer Kündigungsfrist kündigen, wenn ihm die Fortsetzung nicht zugemutet werden kann (§ 327q Abs. 2)";
    label en unofficial "Where the consumer withdraws data protection consent, the trader may terminate without notice if continuation cannot be required of him (§ 327q (2))";
    when datenschutzrechtliche_einwilligung_widerrufen(v, d);
    when fortsetzung_nach_widerruf_nicht_zumutbar(v);
    when vertragspartei(v, unternehmerpartei);
    when unternehmer(unternehmerpartei);
    then kuendigung_ohne_frist_nach_datenschutzwiderruf(v, unternehmerpartei);
}

@source(BGB_P327r)
rule ZulaessigeAenderungDesDigitalenProdukts(d: DigitalesProdukt, beginn: Date, ende: Date) strict {
    label de official "Bei einer dauerhaften Bereitstellung darf der Unternehmer Änderungen, die über das zur Aufrechterhaltung der Vertragsmäßigkeit erforderliche Maß hinausgehen, nur vornehmen, wenn der Vertrag diese Möglichkeit mit triftigem Grund vorsieht, dem Verbraucher keine zusätzlichen Kosten entstehen und er klar und verständlich informiert wird (§ 327r Abs. 1)";
    label en unofficial "In continuous supply the trader may make changes beyond maintaining conformity only under the conditions of § 327r (1)";
    when dauerhafte_bereitstellung(d, beginn, ende);
    when aenderung_ueber_das_erforderliche_mass_hinaus(d);
    when aenderung_vertraglich_vorgesehen_und_triftig(d);
    then aenderung_zulaessig(d);
}

@source(BGB_P327r)
rule EreignisDerBeendigungsfristNachAenderung(d: DigitalesProdukt, f: Beendigungsfrist, tag: Date) strict {
    label de official "Die Frist von 30 Tagen beginnt mit dem Zugang der Information nach Absatz 2 zu laufen; erfolgt die Änderung nach dem Zugang der Information, so tritt an die Stelle des Zugangs der Zeitpunkt der Änderung (§ 327r Abs. 3 Sätze 2, 3)";
    label en unofficial "The 30-day period runs from receipt of the information under (2); if the change occurs later, from the change (§ 327r (3) sentences 2, 3)";
    when beendigungsfrist_des_produkts(d, f);
    when information_ueber_die_aenderung_zugegangen_am(d, tag);
    then de.bgb.fristen::frist_ereignis(f, tag);
}

@source(BGB_P327r)
rule DauerDerBeendigungsfrist(d: DigitalesProdukt, f: Beendigungsfrist, tag: Date) strict {
    label de official "Der Verbraucher kann den Vertrag innerhalb von 30 Tagen unentgeltlich beenden (§ 327r Abs. 3 Satz 1) — Tagesfrist nach §§ 187 Abs. 1, 188 Abs. 1";
    label en unofficial "The consumer may terminate free of charge within 30 days (§ 327r (3) sentence 1) — a period fixed by days";
    when beendigungsfrist_des_produkts(d, f);
    when de.bgb.fristen::frist_ereignis(f, tag);
    then de.bgb.fristen::frist_dauer_tage(f, 30 calendar_day);
}

@source(BGB_P327r)
rule UnentgeltlicheBeendigungNachBeeintraechtigenderAenderung(v: Vertrag, d: DigitalesProdukt, f: Beendigungsfrist, ende: Date) strict {
    label de official "Beeinträchtigt eine Änderung des digitalen Produkts die Zugriffsmöglichkeit oder die Nutzbarkeit, so kann der Verbraucher den Vertrag innerhalb von 30 Tagen unentgeltlich beenden; die Beendigung ist ausgeschlossen, wenn die Beeinträchtigung nur unerheblich ist oder dem Verbraucher das unveränderte Produkt ohne zusätzliche Kosten erhalten bleibt (§ 327r Abs. 3, 4)";
    label en unofficial "Where a change impairs access or usability the consumer may terminate free of charge within 30 days, unless the impairment is trivial or the unchanged product remains available (§ 327r (3), (4))";
    when digitales_produkt_des_vertrags(v, d);
    when zugriff_oder_nutzbarkeit_beeintraechtigt(d);
    when beendigungsfrist_des_produkts(d, f);
    when de.bgb.fristen::frist_ende(f, ende);
    then unentgeltliche_beendigung_moeglich(v, d);
}

@source(BGB_P327s)
rule AbweichendeVereinbarungOhneWirkungFuerDenUnternehmer(v: Vertrag) strict {
    label de official "Auf eine Vereinbarung mit dem Verbraucher, die zum Nachteil des Verbrauchers von den Vorschriften dieses Untertitels abweicht, kann der Unternehmer sich nicht berufen, es sei denn, die Vereinbarung wurde erst nach der Mitteilung über die unterbliebene Bereitstellung oder über den Mangel getroffen (§ 327s Abs. 1)";
    label en unofficial "The trader may not rely on an agreement deviating to the consumer's disadvantage unless made after the notice of non-supply or defect (§ 327s (1))";
    when vereinbarung_zum_nachteil_des_verbrauchers_digital(v);
    then unternehmer_kann_sich_nicht_berufen(v);
}

// --- §§ 327t, 327u Verträge zwischen Unternehmern und Rückgriff -------------------------------------------

pub relation vertriebspartner(v: Vertrag, unternehmerpartei: Person, partner: Person) kind empirical {
    label de official "Der Vertriebspartner hat sich dem Unternehmer gegenüber zur Bereitstellung eines digitalen Produkts verpflichtet (§ 327u Abs. 1 Satz 1)";
    label en unofficial "the distribution partner undertook towards the trader to supply a digital product (§ 327u (1) sentence 1)";
}
pub relation aufwendungen_wegen_verbraucherrechts(v: Vertrag, betrag: Money) kind empirical {
    key(v);
    label de official "Aufwendungen, die dem Unternehmer im Verhältnis zu einem Verbraucher wegen einer durch den Vertriebspartner verursachten unterbliebenen Bereitstellung oder wegen der Nacherfüllung entstanden sind (§ 327u Abs. 1)";
    label en unofficial "expenses incurred by the trader towards a consumer because of the partner's failure to supply or of cure (§ 327u (1))";
}
pub relation aufwendungsersatz_gegen_den_vertriebspartner(v: Vertrag, partner: Person, betrag: Money) kind institutional {
    key(v);
    label de official "Der Unternehmer kann von dem Vertriebspartner Ersatz dieser Aufwendungen verlangen (§ 327u Abs. 1)";
    label en unofficial "the trader may claim reimbursement of those expenses from the distribution partner (§ 327u (1))";
}
pub relation recht_des_verbrauchers_ausgeuebt_am(v: Vertrag, tag: Date) kind empirical {
    key(v);
    label de official "Tag, zu dem der Verbraucher sein Recht nach § 327c Absatz 1 Satz 1 ausgeübt hat (§ 327u Abs. 2 Nr. 1)";
    label en unofficial "day on which the consumer exercised his right under § 327c (1) sentence 1 (§ 327u (2) no. 1)";
}
pub relation verjaehrung_des_rueckgriffs_ende(v: Vertrag, tag: Date) kind institutional {
    key(v);
    label de official "Die Aufwendungsersatzansprüche verjähren in sechs Monaten; die Verjährung beginnt mit der Ausübung des Verbraucherrechts beziehungsweise mit der Erfüllung der Verbraucheransprüche (§ 327u Abs. 2)";
    label en unofficial "the claims for reimbursement are time-barred after six months, running from the exercise of the consumer's right or the performance of his claims (§ 327u (2))";
}
pub relation vertrag_zwischen_unternehmern_zur_bereitstellung(v: Vertrag) kind empirical {
    label de official "Der Vertrag zwischen Unternehmern dient der Bereitstellung digitaler Produkte gemäß der vom Anwendungsbereich des Untertitels 1 erfassten Verbraucherverträge (§ 327t)";
    label en unofficial "the contract between traders serves the supply of digital products for consumer contracts within sub-title 1 (§ 327t)";
}
pub relation vorschriften_des_untertitels_2_anwendbar(v: Vertrag) kind institutional {
    label de official "Auf Verträge zwischen Unternehmern sind ergänzend die Vorschriften dieses Untertitels anzuwenden (§ 327t)";
    label en unofficial "the provisions of this sub-title apply in addition to contracts between traders (§ 327t)";
}

@source(BGB_P327t)
rule VorschriftenFuerVertraegeZwischenUnternehmern(v: Vertrag) strict {
    label de official "Auf Verträge zwischen Unternehmern, die der Bereitstellung digitaler Produkte gemäß der nach den §§ 327 und 327a vom Anwendungsbereich des Untertitels 1 erfassten Verbraucherverträge dienen, sind ergänzend die Vorschriften dieses Untertitels anzuwenden (§ 327t)";
    label en unofficial "The provisions of this sub-title apply in addition to contracts between traders serving the supply of digital products for such consumer contracts (§ 327t)";
    when vertrag_zwischen_unternehmern_zur_bereitstellung(v);
    then vorschriften_des_untertitels_2_anwendbar(v);
}

@source(BGB_P327u)
rule RueckgriffGegenDenVertriebspartner(v: Vertrag, unternehmerpartei: Person, partner: Person, betrag: Money) strict {
    label de official "Der Unternehmer kann von dem Vertriebspartner Ersatz der Aufwendungen verlangen, die ihm im Verhältnis zu einem Verbraucher wegen einer durch den Vertriebspartner verursachten unterbliebenen Bereitstellung oder wegen der Nacherfüllung entstanden sind (§ 327u Abs. 1)";
    label en unofficial "The trader may claim from the distribution partner the expenses incurred towards a consumer because of the partner's failure to supply or of cure (§ 327u (1))";
    when vertriebspartner(v, unternehmerpartei, partner);
    when aufwendungen_wegen_verbraucherrechts(v, betrag);
    then aufwendungsersatz_gegen_den_vertriebspartner(v, partner, betrag);
}

@source(BGB_P327u)
rule VerjaehrungDesRueckgriffsInSechsMonaten(v: Vertrag, tag: Date) strict {
    label de official "Die Aufwendungsersatzansprüche nach Absatz 1 verjähren in sechs Monaten; die Verjährung beginnt im Fall des Absatzes 1 Satz 1 mit dem Zeitpunkt, zu dem der Verbraucher sein Recht ausgeübt hat (§ 327u Abs. 2) — Monatsschritt nach § 188 Abs. 2";
    label en unofficial "The claims for reimbursement are time-barred after six months, running from the exercise of the consumer's right (§ 327u (2))";
    when recht_des_verbrauchers_ausgeuebt_am(v, tag);
    then verjaehrung_des_rueckgriffs_ende(v, add_calendar_period(tag, 6 calendar_month));
}
