language "law.core" version "0.2";
package de.bgb.core version "0.1.0";
namespace "urn:de:corpus:clir:bgb-core";

// Die Nabe pinnt keinen Paragraphen. Dieser Fall zeigt nur, dass der
// gemeinsame Träger des Anspruchs (§ 194 Abs. 1) geladen wird und die
// empirische Tatsache des Entstehungstags beantwortet.
test "nabe: Anspruchsträger nimmt den Entstehungstag auf" {
    given {
        context {
            legal_time @2026-03-15;
            decision_time @2026-03-15T12:00:00Z;
            knowledge_time @2026-03-15T12:00:00Z;
            timezone "Europe/Berlin";
        }
        assert "e": anspruch_entstanden_am(entity_ref("urn:de:bgb:core:nabe:a"), @2020-03-15) { origin case_input; }
        assert "g": anspruchsinhaber(entity_ref("urn:de:bgb:core:nabe:a"), entity_ref("urn:de:bgb:core:nabe:g")) { origin case_input; }
        assert "s": anspruchsgegner(entity_ref("urn:de:bgb:core:nabe:a"), entity_ref("urn:de:bgb:core:nabe:s")) { origin case_input; }
    }
    evaluate truth(anspruch_entstanden_am(entity_ref("urn:de:bgb:core:nabe:a"), @2020-03-15));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    evaluate truth(anspruchsinhaber(entity_ref("urn:de:bgb:core:nabe:a"), entity_ref("urn:de:bgb:core:nabe:g")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    evaluate truth(anspruchsgegner(entity_ref("urn:de:bgb:core:nabe:a"), entity_ref("urn:de:bgb:core:nabe:s")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
