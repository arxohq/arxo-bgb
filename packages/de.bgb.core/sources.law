// Source declaration of the hub. HAND-WRITTEN (the generator
// sync_de_bgb_packages.py does not materialize BG-01): the hub holds no
// paragraph of the Code — every § is pinned exactly once, in the subject
// package that owns its range (docs/foundations/de-bgb/PACKAGES.json). The
// edition here is therefore ABSTRACT_ONLY: it dates the hub's declarations,
// it does not pin bytes. Pinned bytes and fragments: see sources.law of the
// subject packages (e.g. corpus/laws/de/bgb/fristen/sources.law).

language "law.core" version "0.2";
package de.bgb.core version "0.1.0";
namespace "urn:de:corpus:clir:bgb-core";

@id("urn:de:source:bgb-core")
source BGB {
    kind code;
    jurisdiction DE;
    number "RGBl. 1896 S. 195; Neufassung BGBl. I 2002 S. 42, 2909; 2003 S. 738";
    label de official "Bürgerliches Gesetzbuch";
    label en unofficial "German Civil Code";
}

edition BGB_KONSOLIDIERT of BGB {
    language de;
    officiality official;
    materialization_status ABSTRACT_ONLY;
    adopted @1896-08-18;
    in_force [@1900-01-01, infinity);
    label de official "Bürgerliches Gesetzbuch, konsolidierte Fassung (gesetze-im-internet.de) — die Nabe pinnt keinen Paragraphen; Bytes liegen in den Fachpaketen";
    label en unofficial "German Civil Code, consolidated text — the hub pins no paragraph; bytes live in the subject packages";
}
