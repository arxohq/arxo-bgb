language "law.core" version "0.2";
package examples.de.bgb.uebergang_vor_und_nach_2002 version "0.1.0";
namespace "urn:law:examples:de:bgb:uebergang:vor-und-nach-2002";

import de.bgb.uebergang version "0.1.0";
import de.bgb.core version "0.1.0";

// Fallpaket nach § 168.4: Die Sachnormen und die alte Fassung bleiben im
// Kanon; die Fälle liefern nur ihre Eingaben und Fragen.
deadline policy BGB_UEBERGANG_KALENDER {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}
