language "law.core" version "0.2";
package examples.de.bgb.uebergang_vor_und_nach_2002 version "0.1.0";
namespace "urn:law:examples:de:bgb:uebergang:vor-und-nach-2002";

case AlteFristFrueher {
    context {
        deadline_policy examples.de.bgb.uebergang_vor_und_nach_2002::BGB_UEBERGANG_KALENDER;
        legal_time @2026-09-17;
        knowledge_time @2026-09-17T09:00:00Z;
        decision_time @2026-09-17T09:00:00Z;
        timezone "Europe/Berlin";
    }
    assert "entstanden": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:p4:a02"), @1999-06-01) { origin case_input; }
    assert "beginn": de.bgb.uebergang::alte_verjaehrung_begann_am(entity_ref("urn:de:bgb:p4:a02"), @1999-06-01) { origin case_input; }
    assert "alt": de.bgb.uebergang::alte_verjaehrungsfrist(entity_ref("urn:de:bgb:p4:a02"), 4 calendar_year) { origin case_input; }
    assert "neu": de.bgb.uebergang::neue_verjaehrungsfrist(entity_ref("urn:de:bgb:p4:a02"), 3 calendar_year) { origin case_input; }
}
