language "law.core" version "0.2";
package de.bgb.uebergang version "0.1.0";
namespace "urn:de:corpus:clir:bgb-uebergang";
// Anspruch entstanden am 15.2.2003 — kein am 1.1.2002 bestehender Anspruch: der Korridor ist nicht anwendbar, keine Vollendung nach Art. 229 § 6.
test "Art. 229 § 6: Anspruch nach dem Stichtag — kein Korridor" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_UEBERGANG_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:uebergang:pilot:a03"), @2003-02-15) { origin case_input; }
        assert "b": alte_verjaehrung_begann_am(entity_ref("urn:de:bgb:uebergang:pilot:a03"), @2003-02-15) { origin case_input; }
        assert "alt": alte_verjaehrungsfrist(entity_ref("urn:de:bgb:uebergang:pilot:a03"), 30 calendar_year) { origin case_input; }
        assert "neu": neue_verjaehrungsfrist(entity_ref("urn:de:bgb:uebergang:pilot:a03"), 3 calendar_year) { origin case_input; }
    }
    evaluate truth(anspruch_am_stichtag_bestehend(entity_ref("urn:de:bgb:uebergang:pilot:a03")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(korridor_2002_anwendbar(entity_ref("urn:de:bgb:uebergang:pilot:a03")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_vollendet_am(entity_ref("urn:de:bgb:uebergang:pilot:a03"), @2004-12-31));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
