language "law.core" version "0.2";
package de.bgb.uebergang version "0.1.0";
namespace "urn:de:corpus:clir:bgb-uebergang";
// Art. 229 § 6 Abs. 3: alte Frist 2 Jahre (§ 196 Abs. 1 a.F.) vom Schluss des Jahres 2001 (§ 201 a.F.) endet 31.12.2003; neue Frist 3 Jahre ist länger — vollendet mit Ablauf der alten Frist am 31.12.2003.
test "Art. 229 § 6 Abs. 3: längere neue Frist — alte Frist maßgeblich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_UEBERGANG_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:uebergang:pilot:a04"), @2001-06-01) { origin case_input; }
        assert "b": alte_verjaehrung_begann_am(entity_ref("urn:de:bgb:uebergang:pilot:a04"), @2001-12-31) { origin case_input; }
        assert "alt": alte_verjaehrungsfrist(entity_ref("urn:de:bgb:uebergang:pilot:a04"), 2 calendar_year) { origin case_input; }
        assert "neu": neue_verjaehrungsfrist(entity_ref("urn:de:bgb:uebergang:pilot:a04"), 3 calendar_year) { origin case_input; }
    }
    evaluate truth(neue_frist_laenger(entity_ref("urn:de:bgb:uebergang:pilot:a04")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_vollendet_am(entity_ref("urn:de:bgb:uebergang:pilot:a04"), @2003-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(neue_frist_kuerzer(entity_ref("urn:de:bgb:uebergang:pilot:a04")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
