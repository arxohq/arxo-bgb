language "law.core" version "0.2";
package de.bgb.uebergang version "0.1.0";
namespace "urn:de:corpus:clir:bgb-uebergang";
// § 5 Satz 1: ein nicht dauerndes Schuldverhältnis, entstanden vor dem 1.1.2002 (1.6.2001) — es gilt das alte Recht.
test "§ 5 Satz 1: einmaliges Schuldverhältnis vor dem Stichtag folgt altem Recht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_UEBERGANG_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:uebergang:pilot:v04"), @2001-06-01) { origin case_input; }
        assert "k": kein_dauerschuldverhaeltnis(entity_ref("urn:de:bgb:uebergang:pilot:v04")) { origin case_input; }
    }
    evaluate truth(anwendbare_fassung_para5(entity_ref("urn:de:bgb:uebergang:pilot:v04"), AlteFassung));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
