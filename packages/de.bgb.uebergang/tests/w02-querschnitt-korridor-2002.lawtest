language "law.core" version "0.2";
package de.bgb.uebergang version "0.1.0";
namespace "urn:de:corpus:clir:bgb-uebergang";
// Fortsetzung der Sequenz aus w01 für einen vor dem 1.1.2002 entstandenen Anspruch: Entstehung und Beginn nach altem Recht am 10.3.1995, alte Frist 30 Jahre (Ende 10.3.2025), neue Frist 3 Jahre — kürzer, vom 1.1.2002 an gerechnet, Ablauf mit dem 31.12.2004 (wie u01, hier als Abschluss der Kette „Entstehung vor dem Stichtag → Korridor 2002" gezeigt).
test "Querschnitt: ein vor dem Stichtag entstandener Anspruch durchläuft den Korridor 2002" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_UEBERGANG_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:uebergang:pilot:w02"), @1995-03-10) { origin case_input; }
        assert "b": alte_verjaehrung_begann_am(entity_ref("urn:de:bgb:uebergang:pilot:w02"), @1995-03-10) { origin case_input; }
        assert "alt": alte_verjaehrungsfrist(entity_ref("urn:de:bgb:uebergang:pilot:w02"), 30 calendar_year) { origin case_input; }
        assert "neu": neue_verjaehrungsfrist(entity_ref("urn:de:bgb:uebergang:pilot:w02"), 3 calendar_year) { origin case_input; }
    }
    evaluate truth(korridor_2002_anwendbar(entity_ref("urn:de:bgb:uebergang:pilot:w02")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(neue_frist_kuerzer(entity_ref("urn:de:bgb:uebergang:pilot:w02")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_vollendet_am(entity_ref("urn:de:bgb:uebergang:pilot:w02"), @2004-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
