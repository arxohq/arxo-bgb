language "law.core" version "0.2";
package de.bgb.uebergang version "0.1.0";
namespace "urn:de:corpus:clir:bgb-uebergang";
// Art. 229 § 6 Abs. 4: Kenntnis erst am 10.3.2005 (nach dem Stichtag) erlangt — die wörtliche Lesart bleibt beim 1.1.2002, die BGH-Lesart verschiebt den Beginn auf die spätere Kenntnis.
test "Art. 229 § 6 Abs. 4: beide Lesarten des Fristbeginns bei später erlangter Kenntnis" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_UEBERGANG_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:uebergang:pilot:v03"), @1995-01-01) { origin case_input; }
        assert "b": alte_verjaehrung_begann_am(entity_ref("urn:de:bgb:uebergang:pilot:v03"), @1995-01-01) { origin case_input; }
        assert "alt": alte_verjaehrungsfrist(entity_ref("urn:de:bgb:uebergang:pilot:v03"), 30 calendar_year) { origin case_input; }
        assert "neu": neue_verjaehrungsfrist(entity_ref("urn:de:bgb:uebergang:pilot:v03"), 3 calendar_year) { origin case_input; }
        assert "k": kenntnis_erlangt_uebergang_am(entity_ref("urn:de:bgb:uebergang:pilot:v03"), @2005-03-10) { origin adjudicated; }
    }
    evaluate truth(neue_frist_beginn_lesart_stur_ab_stichtag(entity_ref("urn:de:bgb:uebergang:pilot:v03"), @2002-01-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(neue_frist_beginn_lesart_mit_kenntniserfordernis(entity_ref("urn:de:bgb:uebergang:pilot:v03"), @2005-03-10));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
