language "law.core" version "0.2";
package de.bgb.uebergang version "0.1.0";
namespace "urn:de:corpus:clir:bgb-uebergang";
// § 23 Abs. 4 Satz 1: Erbfall am 1.6.2009 (vor dem 1.1.2010) — es gilt die alte Fassung des Erbrechts.
test "§ 23 Abs. 4: Erbfall vor dem 1. Januar 2010 folgt alter Fassung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_UEBERGANG_KALENDER; }
        assert "e": erbfall_am(entity_ref("urn:de:bgb:uebergang:pilot:v08"), @2009-06-01) { origin case_input; }
    }
    evaluate truth(anwendbare_erbrechtsfassung(entity_ref("urn:de:bgb:uebergang:pilot:v08"), AlteFassungErbrecht));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
