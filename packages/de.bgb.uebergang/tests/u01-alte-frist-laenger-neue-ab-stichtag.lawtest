language "law.core" version "0.2";
package de.bgb.uebergang version "0.1.0";
namespace "urn:de:corpus:clir:bgb-uebergang";
// Art. 229 § 6 Abs. 4 Satz 1: Anspruch entstanden 10.3.1995, alte Frist 30 Jahre (§ 195 a.F.) endet 10.3.2025; neue Frist 3 Jahre ist kürzer und wird vom 1.1.2002 an gerechnet — vollendet mit Ablauf des 31.12.2004.
test "Art. 229 § 6 Abs. 4 Satz 1: kürzere neue Frist vom 1. Januar 2002 an" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_UEBERGANG_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:uebergang:pilot:a01"), @1995-03-10) { origin case_input; }
        assert "b": alte_verjaehrung_begann_am(entity_ref("urn:de:bgb:uebergang:pilot:a01"), @1995-03-10) { origin case_input; }
        assert "alt": alte_verjaehrungsfrist(entity_ref("urn:de:bgb:uebergang:pilot:a01"), 30 calendar_year) { origin case_input; }
        assert "neu": neue_verjaehrungsfrist(entity_ref("urn:de:bgb:uebergang:pilot:a01"), 3 calendar_year) { origin case_input; }
    }
    evaluate truth(korridor_2002_anwendbar(entity_ref("urn:de:bgb:uebergang:pilot:a01")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(alte_frist_ende(entity_ref("urn:de:bgb:uebergang:pilot:a01"), @2025-03-10));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(neue_frist_kuerzer(entity_ref("urn:de:bgb:uebergang:pilot:a01")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(neue_frist_ende_ab_stichtag(entity_ref("urn:de:bgb:uebergang:pilot:a01"), @2004-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_vollendet_am(entity_ref("urn:de:bgb:uebergang:pilot:a01"), @2004-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
