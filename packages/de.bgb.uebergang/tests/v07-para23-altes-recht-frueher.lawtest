language "law.core" version "0.2";
package de.bgb.uebergang version "0.1.0";
namespace "urn:de:corpus:clir:bgb-uebergang";
// § 23 Abs. 1 Satz 2, Abs. 2 Satz 2: alter Beginn 1.1.2005, alte Frist 10 Jahre (Ende 1.1.2015); neue Frist 3 Jahre ab 1.1.2010 (Ende 1.1.2013) — die früher endende neue Frist ist maßgeblich.
test "§ 23: die früher endende neue Frist ist maßgeblich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_UEBERGANG_KALENDER; }
        assert "b": alter_beginn_2010(entity_ref("urn:de:bgb:uebergang:pilot:v07"), @2005-01-01) { origin case_input; }
        assert "alt": alte_verjaehrungsfrist_2010(entity_ref("urn:de:bgb:uebergang:pilot:v07"), 10 calendar_year) { origin case_input; }
        assert "neu": neue_verjaehrungsfrist_2010(entity_ref("urn:de:bgb:uebergang:pilot:v07"), 3 calendar_year) { origin case_input; }
    }
    evaluate truth(alte_frist_ende_2010(entity_ref("urn:de:bgb:uebergang:pilot:v07"), @2015-01-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(neue_frist_beginn_2010(entity_ref("urn:de:bgb:uebergang:pilot:v07"), @2010-01-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(neue_frist_ende_2010(entity_ref("urn:de:bgb:uebergang:pilot:v07"), @2013-01-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_vollendet_am_2010(entity_ref("urn:de:bgb:uebergang:pilot:v07"), @2013-01-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
