language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 434 Abs. 3 Satz 1 Nr. 2: ob die Beschaffenheit bei Sachen derselben Art üblich und vom Käufer erwartbar ist, entscheidet das Gericht (§47.3). Ohne seine Antwort bleibt die Frage offen — das Paket erfindet die Wertung nicht.
test "§ 434 Abs. 3 Nr. 2: ohne Antwort des Gerichts bleibt die Mangelfreiheit offen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:s04"), entity_ref("urn:de:bgb:kauf:s04:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:s04"), entity_ref("urn:de:bgb:kauf:s04:K")) { origin case_input; }
        assert "f3": vereinbarte_beschaffenheit_vorhanden(entity_ref("urn:de:bgb:kauf:s04")) { origin case_input; }
        assert "f4": eignung_fuer_vertraglich_vorausgesetzte_verwendung(entity_ref("urn:de:bgb:kauf:s04")) { origin case_input; }
        assert "f5": vereinbartes_zubehoer_uebergeben(entity_ref("urn:de:bgb:kauf:s04")) { origin case_input; }
        assert "f6": keine_abweichende_vereinbarung_ueber_objektive_anforderungen(entity_ref("urn:de:bgb:kauf:s04")) { origin case_input; }
        assert "f7": eignung_fuer_gewoehnliche_verwendung(entity_ref("urn:de:bgb:kauf:s04")) { origin case_input; }
        assert "f8": entspricht_probe_oder_muster(entity_ref("urn:de:bgb:kauf:s04")) { origin case_input; }
        assert "f9": erhalt_des_zubehoers_erwartbar(entity_ref("urn:de:bgb:kauf:s04")) { origin adjudicated; }
        assert "f10": keine_montage_geschuldet(entity_ref("urn:de:bgb:kauf:s04")) { origin case_input; }
    }
    evaluate truth(objektive_anforderungen_erfuellt(entity_ref("urn:de:bgb:kauf:s04")));
    expect truth_status == NEITHER;
    evaluate truth(sachmangel(entity_ref("urn:de:bgb:kauf:s04")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(beschaffenheit_ueblich_und_erwartbar, Court);
}
