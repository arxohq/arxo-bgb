language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";

test "urn:query:bgb-kauf-position-433-uebergabe-active" {
    given {
        context { legal_time @2026-01-15; decision_time @2026-01-15T09:00:00Z; knowledge_time @2026-01-15T09:00:00Z; timezone "Europe/Berlin"; }
        assert "v": verkaeufer(entity_ref("urn:kauf:p1"), entity_ref("urn:kauf:V")) { origin case_input; }
        assert "k": kaeufer(entity_ref("urn:kauf:p1"), entity_ref("urn:kauf:K")) { origin case_input; }
        assert "d": vertragsschluss_am(entity_ref("urn:kauf:p1"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(Position433UebergabeEigentum, ACTIVE);
}

test "urn:query:bgb-kauf-position-433-uebergabe-satisfied" {
    given {
        context { legal_time @2026-01-15; decision_time @2026-01-15T09:00:00Z; knowledge_time @2026-01-15T09:00:00Z; timezone "Europe/Berlin"; }
        assert "v": verkaeufer(entity_ref("urn:kauf:p2"), entity_ref("urn:kauf:V")) { origin case_input; }
        assert "k": kaeufer(entity_ref("urn:kauf:p2"), entity_ref("urn:kauf:K")) { origin case_input; }
        assert "d": vertragsschluss_am(entity_ref("urn:kauf:p2"), @2026-01-01) { origin case_input; }
        assert "e": sache_uebergeben_und_eigentum_verschafft_am(entity_ref("urn:kauf:p2"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(Position433UebergabeEigentum, SATISFIED);
}

