language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 434 Abs. 1: alle drei Anforderungsgruppen sind erfüllt — die Sache ist frei von Sachmängeln, und der Katalog des § 437 bleibt geschlossen. Der negative Fall der Familie.
test "§ 434 Abs. 1: erfüllte Anforderungen — die Sache ist mangelfrei" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:s02"), entity_ref("urn:de:bgb:kauf:s02:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:s02"), entity_ref("urn:de:bgb:kauf:s02:K")) { origin case_input; }
        assert "f3": vereinbarte_beschaffenheit_vorhanden(entity_ref("urn:de:bgb:kauf:s02")) { origin case_input; }
        assert "f4": eignung_fuer_vertraglich_vorausgesetzte_verwendung(entity_ref("urn:de:bgb:kauf:s02")) { origin case_input; }
        assert "f5": vereinbartes_zubehoer_uebergeben(entity_ref("urn:de:bgb:kauf:s02")) { origin case_input; }
        assert "f6": keine_abweichende_vereinbarung_ueber_objektive_anforderungen(entity_ref("urn:de:bgb:kauf:s02")) { origin case_input; }
        assert "f7": eignung_fuer_gewoehnliche_verwendung(entity_ref("urn:de:bgb:kauf:s02")) { origin case_input; }
        assert "f8": beschaffenheit_ueblich_und_erwartbar(entity_ref("urn:de:bgb:kauf:s02")) { origin adjudicated; }
        assert "f9": entspricht_probe_oder_muster(entity_ref("urn:de:bgb:kauf:s02")) { origin case_input; }
        assert "f10": erhalt_des_zubehoers_erwartbar(entity_ref("urn:de:bgb:kauf:s02")) { origin adjudicated; }
        assert "f11": keine_montage_geschuldet(entity_ref("urn:de:bgb:kauf:s02")) { origin case_input; }
        assert "f12": not andere_als_geschuldete_sache_geliefert(entity_ref("urn:de:bgb:kauf:s02")) { origin case_input; }
        assert "f13": not dritte_rechte_geltend_machbar(entity_ref("urn:de:bgb:kauf:s02")) { origin case_input; }
        assert "f14": not nicht_bestehendes_recht_im_grundbuch(entity_ref("urn:de:bgb:kauf:s02")) { origin case_input; }
    }
    evaluate truth(frei_von_sachmaengeln(entity_ref("urn:de:bgb:kauf:s02")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(frei_von_rechtsmaengeln(entity_ref("urn:de:bgb:kauf:s02")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(sachmangel(entity_ref("urn:de:bgb:kauf:s02")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
