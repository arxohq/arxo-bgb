language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 434 Abs. 3 Satz 1 Nr. 1: die verkaufte Maschine eignet sich nicht für die gewöhnliche Verwendung. Über die objektiven Anforderungen ist nichts anderes vereinbart, also ist die Sache mangelhaft und dem Käufer stehen die Rechte des § 437 zu.
test "§ 434 Abs. 3 Nr. 1: Untauglichkeit für die gewöhnliche Verwendung ist ein Sachmangel" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:s01"), entity_ref("urn:de:bgb:kauf:s01:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:s01"), entity_ref("urn:de:bgb:kauf:s01:K")) { origin case_input; }
        assert "f3": keine_abweichende_vereinbarung_ueber_objektive_anforderungen(entity_ref("urn:de:bgb:kauf:s01")) { origin case_input; }
        assert "f4": not eignung_fuer_gewoehnliche_verwendung(entity_ref("urn:de:bgb:kauf:s01")) { origin case_input; }
        assert "f5": not kenntnis_des_mangels_bei_vertragsschluss(entity_ref("urn:de:bgb:kauf:s01")) { origin adjudicated; }
        assert "f6": not unkenntnis_infolge_grober_fahrlaessigkeit(entity_ref("urn:de:bgb:kauf:s01")) { origin adjudicated; }
        assert "f7": not pfandverkauf_in_oeffentlicher_versteigerung(entity_ref("urn:de:bgb:kauf:s01")) { origin case_input; }
    }
    evaluate truth(sachmangel(entity_ref("urn:de:bgb:kauf:s01")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(recht_auf_nacherfuellung(entity_ref("urn:de:bgb:kauf:s01"), entity_ref("urn:de:bgb:kauf:s01:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
