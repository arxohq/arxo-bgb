language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 462 mit § 193: der Vorbehalt ist am 10. Mai 2022 vereinbart, das kalendarische Ende der Dreijahresfrist fällt auf Sonnabend, den 10. Mai 2025. Weil das Wiederkaufsrecht durch Erklärung ausgeübt wird, tritt an die Stelle dieses Tages der nächste Werktag: Montag, der 12. Mai 2025. Die Erklärung an diesem Montag ist rechtzeitig.
test "§ 462 mit § 193: das Ende am Sonnabend wird auf Montag verlegt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:w02"), entity_ref("urn:de:bgb:kauf:w02:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:w02"), entity_ref("urn:de:bgb:kauf:w02:K")) { origin case_input; }
        assert "f3": kaufpreis(entity_ref("urn:de:bgb:kauf:w02"), 5000.00 EUR) { origin case_input; }
        assert "f4": not grundstueckskauf(entity_ref("urn:de:bgb:kauf:w02")) { origin case_input; }
        assert "f5": wiederkaufsvorbehalt(entity_ref("urn:de:bgb:kauf:w02:W"), entity_ref("urn:de:bgb:kauf:w02")) { origin case_input; }
        assert "f6": vorbehalt_vereinbart_am(entity_ref("urn:de:bgb:kauf:w02:W"), @2022-05-10) { origin case_input; }
        assert "f7": not ausuebungsfrist_wiederkauf_bestimmt(entity_ref("urn:de:bgb:kauf:w02:W")) { origin case_input; }
        assert "f8": wiederkauf_ausgeuebt_am(entity_ref("urn:de:bgb:kauf:w02:W"), @2025-05-12) { origin case_input; }
        assert "f9": not mehrere_wiederkaufsberechtigte(entity_ref("urn:de:bgb:kauf:w02:W")) { origin case_input; }
        assert "f10": not abweichender_wiederkaufpreis(entity_ref("urn:de:bgb:kauf:w02:W")) { origin case_input; }
    }
    evaluate truth(wiederkaufsfrist_ende(entity_ref("urn:de:bgb:kauf:w02:W"), @2025-05-12));
    expect truth_status == TRUE_ONLY;
    evaluate truth(wiederkaufsfrist_ende(entity_ref("urn:de:bgb:kauf:w02:W"), @2025-05-10));
    expect truth_status == NEITHER;
    evaluate truth(wiederkauf_zustande_gekommen(entity_ref("urn:de:bgb:kauf:w02:W"), entity_ref("urn:de:bgb:kauf:w02")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
