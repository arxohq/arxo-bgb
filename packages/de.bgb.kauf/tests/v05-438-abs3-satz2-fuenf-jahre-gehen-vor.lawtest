language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 438 Abs. 3 Satz 2: im Falle des Absatzes 1 Nr. 2 tritt die Verjährung nicht vor Ablauf der dort bestimmten Frist ein. Bauwerk, abgeliefert am 5. März 2020: die fünfjährige Frist endet am 5. März 2025, die regelmäßige (Ultimo 2020 plus drei Jahre) schon am 31. Dezember 2023. Maßgebend ist die spätere fünfjährige Frist.
test "§ 438 Abs. 3 Satz 2: die fünfjährige Frist geht der früher endenden regelmäßigen vor" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:v05"), entity_ref("urn:de:bgb:kauf:v05:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:v05"), entity_ref("urn:de:bgb:kauf:v05:K")) { origin case_input; }
        assert "f3": maengelanspruch(entity_ref("urn:de:bgb:kauf:v05:A"), entity_ref("urn:de:bgb:kauf:v05")) { origin case_input; }
        assert "f4": bauwerk(entity_ref("urn:de:bgb:kauf:v05")) { origin case_input; }
        assert "f5": ablieferung_am(entity_ref("urn:de:bgb:kauf:v05"), @2020-03-05) { origin adjudicated; }
        assert "f6": not grundstueckskauf(entity_ref("urn:de:bgb:kauf:v05")) { origin case_input; }
        assert "f7": not mangel_in_dinglichem_herausgaberecht(entity_ref("urn:de:bgb:kauf:v05")) { origin case_input; }
        assert "f8": not mangel_in_eingetragenem_recht(entity_ref("urn:de:bgb:kauf:v05")) { origin case_input; }
        assert "f9": mangel_arglistig_verschwiegen(entity_ref("urn:de:bgb:kauf:v05")) { origin adjudicated; }
        assert "f10": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:kauf:v05:A"), @2020-03-05) { origin case_input; }
        assert "f11": de.bgb.fristen::kenntnis_erlangt_am(entity_ref("urn:de:bgb:kauf:v05:A"), @2020-03-05) { origin adjudicated; }
    }
    evaluate truth(fuenfjahresende_438(entity_ref("urn:de:bgb:kauf:v05:A"), @2025-03-05));
    expect truth_status == TRUE_ONLY;
    evaluate truth(frist_ende_438(entity_ref("urn:de:bgb:kauf:v05:A"), @2025-03-05));
    expect truth_status == TRUE_ONLY;
    evaluate truth(frist_ende_438(entity_ref("urn:de:bgb:kauf:v05:A"), @2023-12-31));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
