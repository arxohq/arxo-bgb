language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 475 Abs. 1 Satz 2: ist eine Leistungszeit weder bestimmt noch aus den Umständen zu entnehmen, muss der Unternehmer die Ware spätestens 30 Tage nach Vertragsschluss übergeben. Vertragsschluss am 2. März 2026; der Tag des Vertragsschlusses wird nicht mitgerechnet (§ 187 Abs. 1), der letzte Tag ist der 1. April 2026.
test "§ 475 Abs. 1 Satz 2: dreißig Tage nach Vertragsschluss enden am 1. April 2026" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:b05"), entity_ref("urn:de:bgb:kauf:b05:U")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:b05"), entity_ref("urn:de:bgb:kauf:b05:V")) { origin case_input; }
        assert "f3": verbraucher(entity_ref("urn:de:bgb:kauf:b05"), entity_ref("urn:de:bgb:kauf:b05:V")) { origin case_input; }
        assert "f4": unternehmer_im_kauf(entity_ref("urn:de:bgb:kauf:b05"), entity_ref("urn:de:bgb:kauf:b05:U")) { origin case_input; }
        assert "f5": ware(entity_ref("urn:de:bgb:kauf:b05")) { origin case_input; }
        assert "f6": vertragsschluss_am(entity_ref("urn:de:bgb:kauf:b05"), @2026-03-02) { origin case_input; }
        assert "f7": uebergabe_am(entity_ref("urn:de:bgb:kauf:b05"), @2026-03-20) { origin adjudicated; }
        assert "f8": not gebrauchte_ware_in_oeffentlicher_versteigerung(entity_ref("urn:de:bgb:kauf:b05")) { origin case_input; }
        assert "f9": not lebendes_tier(entity_ref("urn:de:bgb:kauf:b05")) { origin case_input; }
        assert "f10": leistungszeit_weder_bestimmt_noch_zu_entnehmen(entity_ref("urn:de:bgb:kauf:b05")) { origin case_input; }
    }
    evaluate truth(spaetester_uebergabetag(entity_ref("urn:de:bgb:kauf:b05"), @2026-04-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
