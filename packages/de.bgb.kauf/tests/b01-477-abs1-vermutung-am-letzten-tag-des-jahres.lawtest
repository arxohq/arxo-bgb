language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 477 Abs. 1 Satz 1: die Ware wurde am 10. April 2025 übergeben, damit ging an diesem Tag die Gefahr über (§ 446 Satz 1). Der abweichende Zustand zeigt sich am 10. April 2026 — dem letzten Tag der Jahresfrist (§ 188 Abs. 2). Es wird vermutet, dass die Ware schon bei Gefahrübergang mangelhaft war.
test "§ 477 Abs. 1: der abweichende Zustand am letzten Tag des Jahres trägt die Vermutung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:b01"), entity_ref("urn:de:bgb:kauf:b01:U")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:b01"), entity_ref("urn:de:bgb:kauf:b01:V")) { origin case_input; }
        assert "f3": verbraucher(entity_ref("urn:de:bgb:kauf:b01"), entity_ref("urn:de:bgb:kauf:b01:V")) { origin case_input; }
        assert "f4": unternehmer_im_kauf(entity_ref("urn:de:bgb:kauf:b01"), entity_ref("urn:de:bgb:kauf:b01:U")) { origin case_input; }
        assert "f5": ware(entity_ref("urn:de:bgb:kauf:b01")) { origin case_input; }
        assert "f6": vertragsschluss_am(entity_ref("urn:de:bgb:kauf:b01"), @2025-03-01) { origin case_input; }
        assert "f7": uebergabe_am(entity_ref("urn:de:bgb:kauf:b01"), @2025-04-10) { origin adjudicated; }
        assert "f8": not gebrauchte_ware_in_oeffentlicher_versteigerung(entity_ref("urn:de:bgb:kauf:b01")) { origin case_input; }
        assert "f9": not lebendes_tier(entity_ref("urn:de:bgb:kauf:b01")) { origin case_input; }
        assert "f10": abweichender_zustand_gezeigt_am(entity_ref("urn:de:bgb:kauf:b01"), @2026-04-10) { origin case_input; }
        assert "f11": not vermutung_mit_art_der_ware_unvereinbar(entity_ref("urn:de:bgb:kauf:b01")) { origin adjudicated; }
    }
    evaluate truth(gefahruebergang_am(entity_ref("urn:de:bgb:kauf:b01"), @2025-04-10));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vorschriften_des_untertitels_anwendbar(entity_ref("urn:de:bgb:kauf:b01")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(mangel_bei_gefahruebergang_vorhanden(entity_ref("urn:de:bgb:kauf:b01")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
