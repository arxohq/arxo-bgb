language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// Kanarienvogel zu br01: dieselben Fakten aus de.bgb.allgemeiner_teil, aber
// OHNE das Korrelat `rechtsgeschaeft_des_kaufvertrags`.
test "Brücke § 474, Kanarie: ohne Korrelat bleibt Verbraucher unbewiesen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "a1": de.bgb.allgemeiner_teil::rechtssubjektart(entity_ref("urn:de:bgb:kauf:br03:p1"), de.bgb.allgemeiner_teil::Mensch) { origin case_input; }
        assert "a2": de.bgb.allgemeiner_teil::zweck_ueberwiegend_nicht_gewerblich(entity_ref("urn:de:bgb:kauf:br03:p1"), entity_ref("urn:de:bgb:kauf:br03:r1")) { origin adjudicated; }
    }
    evaluate truth(verbraucher(entity_ref("urn:de:bgb:kauf:br03"), entity_ref("urn:de:bgb:kauf:br03:p1")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
