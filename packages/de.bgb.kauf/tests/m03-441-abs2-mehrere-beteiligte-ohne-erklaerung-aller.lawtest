language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 441 Abs. 2: auf der Seite des Käufers sind mehrere beteiligt, die Minderung ist aber nicht von allen erklärt worden. Sie ist deshalb nicht wirksam, und ein geminderter Kaufpreis wird nicht berechnet — die andere Seite der Schwelle zu m01.
test "§ 441 Abs. 2: ohne Erklärung aller Beteiligten keine wirksame Minderung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:m03"), entity_ref("urn:de:bgb:kauf:m03:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:m03"), entity_ref("urn:de:bgb:kauf:m03:K")) { origin case_input; }
        assert "f3": keine_abweichende_vereinbarung_ueber_objektive_anforderungen(entity_ref("urn:de:bgb:kauf:m03")) { origin case_input; }
        assert "f4": not eignung_fuer_gewoehnliche_verwendung(entity_ref("urn:de:bgb:kauf:m03")) { origin case_input; }
        assert "f5": not kenntnis_des_mangels_bei_vertragsschluss(entity_ref("urn:de:bgb:kauf:m03")) { origin adjudicated; }
        assert "f6": not unkenntnis_infolge_grober_fahrlaessigkeit(entity_ref("urn:de:bgb:kauf:m03")) { origin adjudicated; }
        assert "f7": not pfandverkauf_in_oeffentlicher_versteigerung(entity_ref("urn:de:bgb:kauf:m03")) { origin case_input; }
        assert "f8": erwartbarer_aktualisierungszeitraum_eingehalten(entity_ref("urn:de:bgb:kauf:m03")) { origin adjudicated; }
        assert "f9": kaufpreis(entity_ref("urn:de:bgb:kauf:m03"), 1000.00 EUR) { origin case_input; }
        assert "f10": minderung_erklaert(entity_ref("urn:de:bgb:kauf:m03")) { origin case_input; }
        assert "f11": mehrere_beteiligte(entity_ref("urn:de:bgb:kauf:m03")) { origin case_input; }
        assert "f12": wert_ohne_mangel_in_cent(entity_ref("urn:de:bgb:kauf:m03"), 300000) { origin case_input; }
        assert "f13": wirklicher_wert_in_cent(entity_ref("urn:de:bgb:kauf:m03"), 200000) { origin case_input; }
    }
    evaluate truth(recht_auf_minderung(entity_ref("urn:de:bgb:kauf:m03"), entity_ref("urn:de:bgb:kauf:m03:K")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(minderung_wirksam(entity_ref("urn:de:bgb:kauf:m03")));
    expect truth_status == NEITHER;
    evaluate truth(geminderter_kaufpreis(entity_ref("urn:de:bgb:kauf:m03"), 666.67 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
