language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// Querschnitt Kauf/Rücktritt/Verjährung, Unvollständigkeit: derselbe
// Sachverhalt wie kq01, aber OHNE das Urteil zur Angemessenheit der
// Nacherfüllungsfrist (§ 323 Abs. 1, external judgment relation, Kanal
// § 47.3) — das Gericht wurde nicht gefragt. Ohne `frist_zur_leistung_
// angemessen` leitet keine der sechs Regeln des § 323 ein Rücktrittsrecht
// her; die Brücke bleibt ohne Prämisse und das konkrete Rücktrittsrecht
// bleibt offen (NEITHER), obwohl der Mangel selbst feststeht.
test "Querschnitt, Unvollständigkeit: ohne Urteil über die Angemessenheit der Frist bleibt das Rücktrittsrecht offen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:kq05"), entity_ref("urn:de:bgb:kauf:kq05:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:kq05"), entity_ref("urn:de:bgb:kauf:kq05:K")) { origin case_input; }
        assert "f3": keine_abweichende_vereinbarung_ueber_objektive_anforderungen(entity_ref("urn:de:bgb:kauf:kq05")) { origin case_input; }
        assert "f4": not eignung_fuer_gewoehnliche_verwendung(entity_ref("urn:de:bgb:kauf:kq05")) { origin case_input; }
        assert "f5": not kenntnis_des_mangels_bei_vertragsschluss(entity_ref("urn:de:bgb:kauf:kq05")) { origin adjudicated; }
        assert "f6": not unkenntnis_infolge_grober_fahrlaessigkeit(entity_ref("urn:de:bgb:kauf:kq05")) { origin adjudicated; }
        assert "f7": not pfandverkauf_in_oeffentlicher_versteigerung(entity_ref("urn:de:bgb:kauf:kq05")) { origin case_input; }
        assert "f8": vertrag_des_kaufvertrags(entity_ref("urn:de:bgb:kauf:kq05"), entity_ref("urn:de:bgb:kauf:kq05:V1")) { origin case_input; }
        assert "f9": de.bgb.schuldrecht_at::gegenseitiger_vertrag(entity_ref("urn:de:bgb:kauf:kq05:V1")) { origin case_input; }
        assert "f10": de.bgb.schuldrecht_at::faellige_leistung_nicht_oder_nicht_vertragsgemaess(entity_ref("urn:de:bgb:kauf:kq05:V1"), entity_ref("urn:de:bgb:kauf:kq05:L1")) { origin case_input; }
        assert "f11": de.bgb.schuldrecht_at::vertragspartei(entity_ref("urn:de:bgb:kauf:kq05:V1"), entity_ref("urn:de:bgb:kauf:kq05:K")) { origin case_input; }
    }
    evaluate truth(mangel(entity_ref("urn:de:bgb:kauf:kq05")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(de.bgb.schuldrecht_at::ruecktrittsrecht(entity_ref("urn:de:bgb:kauf:kq05:V1"), entity_ref("urn:de:bgb:kauf:kq05:K")));
    expect truth_status == NEITHER;
    evaluate truth(ruecktrittsrecht_des_kaeufers(entity_ref("urn:de:bgb:kauf:kq05"), entity_ref("urn:de:bgb:kauf:kq05:K")));
    expect truth_status == NEITHER;
}
