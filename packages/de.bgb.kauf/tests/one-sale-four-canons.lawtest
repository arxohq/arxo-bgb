language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";

test "urn:query:one-sale-four-canons-bgb" {
    given {
        context { legal_time @2026-09-20; decision_time @2026-09-20T09:00:00Z; knowledge_time @2026-09-20T09:00:00Z; timezone "Europe/Berlin"; }
        assert "seller": verkaeufer(entity_ref("urn:case:one-sale-2026"), entity_ref("urn:case:one-sale-2026:seller")) { origin case_input; }
        assert "buyer": kaeufer(entity_ref("urn:case:one-sale-2026"), entity_ref("urn:case:one-sale-2026:buyer")) { origin case_input; }
        assert "concluded": vertragsschluss_am(entity_ref("urn:case:one-sale-2026"), @2026-09-01) { origin case_input; }
    }
    evaluate positions();
    expect position(Position433UebergabeEigentum, ACTIVE);
    expect position(Position433ZahlungAbnahme, ACTIVE);
}
