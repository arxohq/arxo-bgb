language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// Kanarienvogel „minus eine Angabe“: derselbe Sachverhalt wie s01, aber der Fall sagt nicht, dass über die objektiven Anforderungen nichts anderes vereinbart wurde. § 434 Abs. 3 beginnt mit „Soweit nicht wirksam etwas anderes vereinbart wurde“ — ohne diese Angabe schweigt die Norm. Abwesenheit ist keine Verneinung.
test "§ 434 Abs. 3: ohne die Angabe zur abweichenden Vereinbarung schweigt die Norm" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:s08"), entity_ref("urn:de:bgb:kauf:s08:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:s08"), entity_ref("urn:de:bgb:kauf:s08:K")) { origin case_input; }
        assert "f3": not eignung_fuer_gewoehnliche_verwendung(entity_ref("urn:de:bgb:kauf:s08")) { origin case_input; }
    }
    evaluate truth(sachmangel(entity_ref("urn:de:bgb:kauf:s08")));
    expect truth_status == NEITHER;
    evaluate truth(objektive_anforderungen_erfuellt(entity_ref("urn:de:bgb:kauf:s08")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
