language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// Querschnitt Kauf/Rücktritt/Verjährung, Kanarienvogel zu kq01: dieselben
// Fakten, aber OHNE `frist_erfolglos_abgelaufen` (§ 323 Abs. 1 verlangt den
// erfolglosen ABLAUF der angemessenen Frist, nicht nur ihre Angemessenheit).
// Entfernen dieser einen Eingabe muss das konkrete Rücktrittsrecht kippen.
test "Querschnitt, Kanarie: ohne erfolglosen Fristablauf kein konkretes Rücktrittsrecht trotz Mangels" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:kq06"), entity_ref("urn:de:bgb:kauf:kq06:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:kq06"), entity_ref("urn:de:bgb:kauf:kq06:K")) { origin case_input; }
        assert "f3": keine_abweichende_vereinbarung_ueber_objektive_anforderungen(entity_ref("urn:de:bgb:kauf:kq06")) { origin case_input; }
        assert "f4": not eignung_fuer_gewoehnliche_verwendung(entity_ref("urn:de:bgb:kauf:kq06")) { origin case_input; }
        assert "f5": not kenntnis_des_mangels_bei_vertragsschluss(entity_ref("urn:de:bgb:kauf:kq06")) { origin adjudicated; }
        assert "f6": not unkenntnis_infolge_grober_fahrlaessigkeit(entity_ref("urn:de:bgb:kauf:kq06")) { origin adjudicated; }
        assert "f7": not pfandverkauf_in_oeffentlicher_versteigerung(entity_ref("urn:de:bgb:kauf:kq06")) { origin case_input; }
        assert "f8": vertrag_des_kaufvertrags(entity_ref("urn:de:bgb:kauf:kq06"), entity_ref("urn:de:bgb:kauf:kq06:V1")) { origin case_input; }
        assert "f9": de.bgb.schuldrecht_at::gegenseitiger_vertrag(entity_ref("urn:de:bgb:kauf:kq06:V1")) { origin case_input; }
        assert "f10": de.bgb.schuldrecht_at::faellige_leistung_nicht_oder_nicht_vertragsgemaess(entity_ref("urn:de:bgb:kauf:kq06:V1"), entity_ref("urn:de:bgb:kauf:kq06:L1")) { origin case_input; }
        assert "f11": de.bgb.schuldrecht_at::vertragspartei(entity_ref("urn:de:bgb:kauf:kq06:V1"), entity_ref("urn:de:bgb:kauf:kq06:K")) { origin case_input; }
        assert "f12": de.bgb.schuldrecht_at::frist_zur_leistung_angemessen(entity_ref("urn:de:bgb:kauf:kq06:L1"), @2026-06-01) { origin adjudicated; }
    }
    evaluate truth(mangel(entity_ref("urn:de:bgb:kauf:kq06")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(de.bgb.schuldrecht_at::ruecktrittsrecht(entity_ref("urn:de:bgb:kauf:kq06:V1"), entity_ref("urn:de:bgb:kauf:kq06:K")));
    expect truth_status == NEITHER;
    evaluate truth(ruecktrittsrecht_des_kaeufers(entity_ref("urn:de:bgb:kauf:kq06"), entity_ref("urn:de:bgb:kauf:kq06:K")));
    expect truth_status == NEITHER;
}
