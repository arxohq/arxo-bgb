language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 438 Abs. 1 Nr. 1 Buchst. a und Abs. 2: der Mangel besteht in einem dinglichen Herausgaberecht eines Dritten an einem Grundstück — dreißig Jahre, gerechnet von der Übergabe (nicht von der Ablieferung). Übergeben am 10. Mai 2000, Ablauf mit dem 10. Mai 2030.
test "§ 438 Abs. 1 Nr. 1: dreißig Jahre ab Übergabe des Grundstücks" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:v03"), entity_ref("urn:de:bgb:kauf:v03:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:v03"), entity_ref("urn:de:bgb:kauf:v03:K")) { origin case_input; }
        assert "f3": maengelanspruch(entity_ref("urn:de:bgb:kauf:v03:A"), entity_ref("urn:de:bgb:kauf:v03")) { origin case_input; }
        assert "f4": grundstueckskauf(entity_ref("urn:de:bgb:kauf:v03")) { origin case_input; }
        assert "f5": mangel_in_dinglichem_herausgaberecht(entity_ref("urn:de:bgb:kauf:v03")) { origin case_input; }
        assert "f6": uebergabe_am(entity_ref("urn:de:bgb:kauf:v03"), @2000-05-10) { origin adjudicated; }
        assert "f7": not mangel_arglistig_verschwiegen(entity_ref("urn:de:bgb:kauf:v03")) { origin adjudicated; }
    }
    evaluate truth(frist_ende_438(entity_ref("urn:de:bgb:kauf:v03:A"), @2030-05-10));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
