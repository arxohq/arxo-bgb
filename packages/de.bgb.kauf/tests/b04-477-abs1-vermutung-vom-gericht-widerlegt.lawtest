language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 477 Abs. 1 Satz 1 letzter Halbsatz: das Gericht hat entschieden, dass die Vermutung mit der Art der Ware unvereinbar ist. Der Zeitraum ist offen wie in b01, die Vermutung greift gleichwohl nicht.
test "§ 477 Abs. 1: die vom Gericht für unvereinbar erklärte Vermutung greift nicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:b04"), entity_ref("urn:de:bgb:kauf:b04:U")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:b04"), entity_ref("urn:de:bgb:kauf:b04:V")) { origin case_input; }
        assert "f3": verbraucher(entity_ref("urn:de:bgb:kauf:b04"), entity_ref("urn:de:bgb:kauf:b04:V")) { origin case_input; }
        assert "f4": unternehmer_im_kauf(entity_ref("urn:de:bgb:kauf:b04"), entity_ref("urn:de:bgb:kauf:b04:U")) { origin case_input; }
        assert "f5": ware(entity_ref("urn:de:bgb:kauf:b04")) { origin case_input; }
        assert "f6": vertragsschluss_am(entity_ref("urn:de:bgb:kauf:b04"), @2025-03-01) { origin case_input; }
        assert "f7": uebergabe_am(entity_ref("urn:de:bgb:kauf:b04"), @2025-04-10) { origin adjudicated; }
        assert "f8": not gebrauchte_ware_in_oeffentlicher_versteigerung(entity_ref("urn:de:bgb:kauf:b04")) { origin case_input; }
        assert "f9": not lebendes_tier(entity_ref("urn:de:bgb:kauf:b04")) { origin case_input; }
        assert "f10": abweichender_zustand_gezeigt_am(entity_ref("urn:de:bgb:kauf:b04"), @2026-04-10) { origin case_input; }
        assert "f11": vermutung_mit_art_der_ware_unvereinbar(entity_ref("urn:de:bgb:kauf:b04")) { origin adjudicated; }
    }
    evaluate truth(mangel_bei_gefahruebergang_vorhanden(entity_ref("urn:de:bgb:kauf:b04")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
