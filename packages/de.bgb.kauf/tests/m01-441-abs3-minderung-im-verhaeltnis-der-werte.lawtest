language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 441 Abs. 3 Satz 1: der Kaufpreis beträgt 1 000,00 €, der Wert der Sache in mangelfreiem Zustand 3 000,00 € und ihr wirklicher Wert 2 000,00 €. Das Verhältnis 2/3 ist nicht dezimal; der geminderte Preis 666,666… € wird EINMAL je Anspruch kaufmännisch auf den Cent gerundet: 666,67 €.
test "§ 441 Abs. 3: nicht dezimales Wertverhältnis — eine Rundung auf 666,67 €" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:m01"), entity_ref("urn:de:bgb:kauf:m01:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:m01"), entity_ref("urn:de:bgb:kauf:m01:K")) { origin case_input; }
        assert "f3": keine_abweichende_vereinbarung_ueber_objektive_anforderungen(entity_ref("urn:de:bgb:kauf:m01")) { origin case_input; }
        assert "f4": not eignung_fuer_gewoehnliche_verwendung(entity_ref("urn:de:bgb:kauf:m01")) { origin case_input; }
        assert "f5": not kenntnis_des_mangels_bei_vertragsschluss(entity_ref("urn:de:bgb:kauf:m01")) { origin adjudicated; }
        assert "f6": not unkenntnis_infolge_grober_fahrlaessigkeit(entity_ref("urn:de:bgb:kauf:m01")) { origin adjudicated; }
        assert "f7": not pfandverkauf_in_oeffentlicher_versteigerung(entity_ref("urn:de:bgb:kauf:m01")) { origin case_input; }
        assert "f8": erwartbarer_aktualisierungszeitraum_eingehalten(entity_ref("urn:de:bgb:kauf:m01")) { origin adjudicated; }
        assert "f9": kaufpreis(entity_ref("urn:de:bgb:kauf:m01"), 1000.00 EUR) { origin case_input; }
        assert "f10": minderung_erklaert(entity_ref("urn:de:bgb:kauf:m01")) { origin case_input; }
        assert "f11": not mehrere_beteiligte(entity_ref("urn:de:bgb:kauf:m01")) { origin case_input; }
        assert "f12": wert_ohne_mangel_in_cent(entity_ref("urn:de:bgb:kauf:m01"), 300000) { origin case_input; }
        assert "f13": wirklicher_wert_in_cent(entity_ref("urn:de:bgb:kauf:m01"), 200000) { origin case_input; }
    }
    evaluate truth(minderung_wirksam(entity_ref("urn:de:bgb:kauf:m01")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(geminderter_kaufpreis(entity_ref("urn:de:bgb:kauf:m01"), 666.67 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(geminderter_kaufpreis(entity_ref("urn:de:bgb:kauf:m01"), 666.66 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
