language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// Querschnitt Kauf/Rücktritt/Verjährung: derselbe Sachverhalt wie kq01
// (Mangel, erfolglose Nacherfüllungsfrist, konkretes Rücktrittsrecht), aber
// der Vertrag wurde am 15. Dezember 2021 geschlossen — VOR dem Korridor des
// Art. 229 § 58 EGBGB (D-05-06). `neues_kaufrecht_anwendbar` bleibt NEITHER;
// das Rücktrittsrecht selbst (§§ 437 Nr. 2, 323 — Untertitel 1, nicht vom
// Korridor betroffen, D-05-06: der Korridor gilt nur für §§ 434, 475b–475e,
// 477 in Untertitel 3) besteht unverändert. Der Fall zeigt beide Mechaniken
// nebeneinander im selben Dokument, ohne dass eine die andere kausal steuert.
test "Querschnitt: Vertragsschluss vor dem Korridor 2022, Rücktrittsrecht nach §§ 437, 323 unberührt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:kq04"), entity_ref("urn:de:bgb:kauf:kq04:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:kq04"), entity_ref("urn:de:bgb:kauf:kq04:K")) { origin case_input; }
        assert "f3": keine_abweichende_vereinbarung_ueber_objektive_anforderungen(entity_ref("urn:de:bgb:kauf:kq04")) { origin case_input; }
        assert "f4": not eignung_fuer_gewoehnliche_verwendung(entity_ref("urn:de:bgb:kauf:kq04")) { origin case_input; }
        assert "f5": not kenntnis_des_mangels_bei_vertragsschluss(entity_ref("urn:de:bgb:kauf:kq04")) { origin adjudicated; }
        assert "f6": not unkenntnis_infolge_grober_fahrlaessigkeit(entity_ref("urn:de:bgb:kauf:kq04")) { origin adjudicated; }
        assert "f7": not pfandverkauf_in_oeffentlicher_versteigerung(entity_ref("urn:de:bgb:kauf:kq04")) { origin case_input; }
        assert "f8": vertrag_des_kaufvertrags(entity_ref("urn:de:bgb:kauf:kq04"), entity_ref("urn:de:bgb:kauf:kq04:V1")) { origin case_input; }
        assert "f9": de.bgb.schuldrecht_at::gegenseitiger_vertrag(entity_ref("urn:de:bgb:kauf:kq04:V1")) { origin case_input; }
        assert "f10": de.bgb.schuldrecht_at::faellige_leistung_nicht_oder_nicht_vertragsgemaess(entity_ref("urn:de:bgb:kauf:kq04:V1"), entity_ref("urn:de:bgb:kauf:kq04:L1")) { origin case_input; }
        assert "f11": de.bgb.schuldrecht_at::vertragspartei(entity_ref("urn:de:bgb:kauf:kq04:V1"), entity_ref("urn:de:bgb:kauf:kq04:K")) { origin case_input; }
        assert "f12": de.bgb.schuldrecht_at::frist_zur_leistung_angemessen(entity_ref("urn:de:bgb:kauf:kq04:L1"), @2022-01-15) { origin adjudicated; }
        assert "f13": de.bgb.schuldrecht_at::frist_erfolglos_abgelaufen(entity_ref("urn:de:bgb:kauf:kq04:L1")) { origin case_input; }
        assert "f14": vertragsschluss_am(entity_ref("urn:de:bgb:kauf:kq04"), @2021-12-15) { origin case_input; }
    }
    evaluate truth(neues_kaufrecht_anwendbar(entity_ref("urn:de:bgb:kauf:kq04")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(ruecktrittsrecht_des_kaeufers(entity_ref("urn:de:bgb:kauf:kq04"), entity_ref("urn:de:bgb:kauf:kq04:K")));
    expect truth_status == TRUE_ONLY;
}
