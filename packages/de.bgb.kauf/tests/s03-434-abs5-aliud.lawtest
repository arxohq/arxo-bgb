language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 434 Abs. 5: geliefert wird eine andere Sache als die vertraglich geschuldete. Das steht einem Sachmangel gleich, ohne dass es auf die Anforderungen der Absätze 2 bis 4 ankommt.
test "§ 434 Abs. 5: die Lieferung einer anderen Sache steht dem Sachmangel gleich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:s03"), entity_ref("urn:de:bgb:kauf:s03:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:s03"), entity_ref("urn:de:bgb:kauf:s03:K")) { origin case_input; }
        assert "f3": andere_als_geschuldete_sache_geliefert(entity_ref("urn:de:bgb:kauf:s03")) { origin case_input; }
        assert "f4": not kenntnis_des_mangels_bei_vertragsschluss(entity_ref("urn:de:bgb:kauf:s03")) { origin adjudicated; }
        assert "f5": not unkenntnis_infolge_grober_fahrlaessigkeit(entity_ref("urn:de:bgb:kauf:s03")) { origin adjudicated; }
        assert "f6": not pfandverkauf_in_oeffentlicher_versteigerung(entity_ref("urn:de:bgb:kauf:s03")) { origin case_input; }
    }
    evaluate truth(sachmangel(entity_ref("urn:de:bgb:kauf:s03")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(recht_auf_minderung(entity_ref("urn:de:bgb:kauf:s03"), entity_ref("urn:de:bgb:kauf:s03:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
