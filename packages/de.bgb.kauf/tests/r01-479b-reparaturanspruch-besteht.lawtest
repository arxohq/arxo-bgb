language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// §§ 479a, 479b: die Ware gehört einer Produktgruppe des Anhangs II der Richtlinie (EU) 2024/1799 an, ein Verbraucher hat sie gekauft, und Mängelrechte nach § 437 stehen ihm nicht zu — die Sache ist mangelfrei. Der Hersteller muss die Reparierbarkeit unionsrechtlich gewährleisten und die Reparatur ist möglich: der Anspruch aus § 479b Abs. 1 besteht.
test "§ 479b: der Reparaturanspruch des Verbrauchers gegen den Hersteller besteht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:r01"), entity_ref("urn:de:bgb:kauf:r01:H")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:r01"), entity_ref("urn:de:bgb:kauf:r01:K")) { origin case_input; }
        assert "f3": vereinbarte_beschaffenheit_vorhanden(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f4": eignung_fuer_vertraglich_vorausgesetzte_verwendung(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f5": vereinbartes_zubehoer_uebergeben(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f6": keine_abweichende_vereinbarung_ueber_objektive_anforderungen(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f7": eignung_fuer_gewoehnliche_verwendung(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f8": beschaffenheit_ueblich_und_erwartbar(entity_ref("urn:de:bgb:kauf:r01")) { origin adjudicated; }
        assert "f9": entspricht_probe_oder_muster(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f10": erhalt_des_zubehoers_erwartbar(entity_ref("urn:de:bgb:kauf:r01")) { origin adjudicated; }
        assert "f11": keine_montage_geschuldet(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f12": not andere_als_geschuldete_sache_geliefert(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f13": not dritte_rechte_geltend_machbar(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f14": not nicht_bestehendes_recht_im_grundbuch(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f15": erwartbarer_aktualisierungszeitraum_eingehalten(entity_ref("urn:de:bgb:kauf:r01")) { origin adjudicated; }
        assert "f16": not ware_mit_digitalen_elementen(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f17": produktgruppe_des_anhangs_ii(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f18": von_einem_verbraucher_gekauft(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f19": hersteller(entity_ref("urn:de:bgb:kauf:r01"), entity_ref("urn:de:bgb:kauf:r01:H")) { origin case_input; }
        assert "f20": reparierbarkeit_unionsrechtlich_zu_gewaehrleisten(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f21": not reparatur_tatsaechlich_oder_rechtlich_unmoeglich(entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
        assert "f22": reparaturverlangen_des_verbrauchers(entity_ref("urn:de:bgb:kauf:r01:R"), entity_ref("urn:de:bgb:kauf:r01")) { origin case_input; }
    }
    evaluate truth(anwendungsbereich_untertitel4(entity_ref("urn:de:bgb:kauf:r01")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(reparaturverpflichtung(entity_ref("urn:de:bgb:kauf:r01"), entity_ref("urn:de:bgb:kauf:r01:H")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(reparaturanspruch_besteht(entity_ref("urn:de:bgb:kauf:r01:R")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
