language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// Der eigentliche Gewinn der Brücke: die Hemmung (§ 204 Abs. 1 Nr. 1,
// Klageerhebung) wirkt jetzt auch auf die Sonderfrist des § 438 — vorher war
// sie für diese Frist überhaupt nicht erreichbar. Vom 1. März bis zum 30. April
// 2024 ist die Verjährung gehemmt: 61 Tage werden nicht eingerechnet (§ 209),
// das Ende verschiebt sich vom 10. April 2025 auf den 10. Juni 2025. Derselbe
// Rücktritt vom 11. April 2025, der in kq07 zu spät war, ist damit rechtzeitig.
test "§§ 438 Abs. 1 Nr. 3, 204, 209: 61 Hemmungstage verschieben die Verjährung auf den 10. Juni 2025" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:kq09"), entity_ref("urn:de:bgb:kauf:kq09:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:kq09"), entity_ref("urn:de:bgb:kauf:kq09:K")) { origin case_input; }
        assert "f3": maengelanspruch(entity_ref("urn:de:bgb:kauf:kq09:A"), entity_ref("urn:de:bgb:kauf:kq09")) { origin case_input; }
        assert "f4": ablieferung_am(entity_ref("urn:de:bgb:kauf:kq09"), @2023-04-10) { origin adjudicated; }
        assert "f5": not grundstueckskauf(entity_ref("urn:de:bgb:kauf:kq09")) { origin case_input; }
        assert "f6": not mangel_in_dinglichem_herausgaberecht(entity_ref("urn:de:bgb:kauf:kq09")) { origin case_input; }
        assert "f7": not mangel_in_eingetragenem_recht(entity_ref("urn:de:bgb:kauf:kq09")) { origin case_input; }
        assert "f8": not bauwerk(entity_ref("urn:de:bgb:kauf:kq09")) { origin case_input; }
        assert "f9": not baustoff_mit_verursachter_mangelhaftigkeit(entity_ref("urn:de:bgb:kauf:kq09")) { origin case_input; }
        assert "f10": not mangel_arglistig_verschwiegen(entity_ref("urn:de:bgb:kauf:kq09")) { origin adjudicated; }
        assert "f11": de.bgb.fristen::hemmung(entity_ref("urn:de:bgb:kauf:kq09:A"), @2024-03-01, @2024-04-30) { origin case_input; }
        assert "f12": de.bgb.fristen::hemmungsgrund(entity_ref("urn:de:bgb:kauf:kq09:A"), de.bgb.fristen::Rechtsverfolgung) { origin case_input; }
        assert "f13": de.bgb.fristen::ruecktritt_erklaert_am(entity_ref("urn:de:bgb:kauf:kq09:A"), @2025-04-11) { origin case_input; }
        assert "f14": de.bgb.fristen::schuldner_beruft_sich_auf_verjaehrung(entity_ref("urn:de:bgb:kauf:kq09:A")) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::verjaehrung_eingetreten_am(entity_ref("urn:de:bgb:kauf:kq09:A"), @2025-06-10));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(de.bgb.fristen::ruecktritt_unwirksam_wegen_verjaehrung(entity_ref("urn:de:bgb:kauf:kq09:A")));
    expect truth_status == NEITHER;
    evaluate truth(ruecktritt_nach_218_unwirksam(entity_ref("urn:de:bgb:kauf:kq09")));
    expect truth_status == NEITHER;
}
