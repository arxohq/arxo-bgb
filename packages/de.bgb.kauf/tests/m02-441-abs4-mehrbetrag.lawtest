language "law.core" version "0.2";
package de.bgb.kauf version "0.1.0";
namespace "urn:de:corpus:clir:bgb-kauf";
// § 441 Abs. 4 Satz 1: der Käufer hat den vollen Kaufpreis von 1 000,00 € gezahlt, der geminderte Preis beträgt 666,67 €. Der Mehrbetrag von 333,33 € ist vom Verkäufer zu erstatten.
test "§ 441 Abs. 4: der Mehrbetrag von 333,33 € ist zu erstatten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_KAUF_KALENDER; }
        assert "f1": verkaeufer(entity_ref("urn:de:bgb:kauf:m02"), entity_ref("urn:de:bgb:kauf:m02:V")) { origin case_input; }
        assert "f2": kaeufer(entity_ref("urn:de:bgb:kauf:m02"), entity_ref("urn:de:bgb:kauf:m02:K")) { origin case_input; }
        assert "f3": keine_abweichende_vereinbarung_ueber_objektive_anforderungen(entity_ref("urn:de:bgb:kauf:m02")) { origin case_input; }
        assert "f4": not eignung_fuer_gewoehnliche_verwendung(entity_ref("urn:de:bgb:kauf:m02")) { origin case_input; }
        assert "f5": not kenntnis_des_mangels_bei_vertragsschluss(entity_ref("urn:de:bgb:kauf:m02")) { origin adjudicated; }
        assert "f6": not unkenntnis_infolge_grober_fahrlaessigkeit(entity_ref("urn:de:bgb:kauf:m02")) { origin adjudicated; }
        assert "f7": not pfandverkauf_in_oeffentlicher_versteigerung(entity_ref("urn:de:bgb:kauf:m02")) { origin case_input; }
        assert "f8": erwartbarer_aktualisierungszeitraum_eingehalten(entity_ref("urn:de:bgb:kauf:m02")) { origin adjudicated; }
        assert "f9": kaufpreis(entity_ref("urn:de:bgb:kauf:m02"), 1000.00 EUR) { origin case_input; }
        assert "f10": minderung_erklaert(entity_ref("urn:de:bgb:kauf:m02")) { origin case_input; }
        assert "f11": not mehrere_beteiligte(entity_ref("urn:de:bgb:kauf:m02")) { origin case_input; }
        assert "f12": wert_ohne_mangel_in_cent(entity_ref("urn:de:bgb:kauf:m02"), 300000) { origin case_input; }
        assert "f13": wirklicher_wert_in_cent(entity_ref("urn:de:bgb:kauf:m02"), 200000) { origin case_input; }
        assert "f14": gezahlter_kaufpreis(entity_ref("urn:de:bgb:kauf:m02"), 1000.00 EUR) { origin case_input; }
    }
    evaluate truth(mehrbetrag_zu_erstatten(entity_ref("urn:de:bgb:kauf:m02"), 333.33 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
