// --- Untertitel 4 Reparaturverpflichtung des Herstellers (§§ 479a–479g)
//
// Dieser Untertitel setzt die Richtlinie (EU) 2024/1799 um. Er bindet nicht
// den Verkäufer, sondern den HERSTELLER, und greift gerade dann ein, wenn dem
// Verbraucher die Rechte des § 437 NICHT (mehr) zustehen (§ 479a Nr. 3).
//
// FREMDE RECHTSAKTE. Welche Produktgruppen in Anhang II der Richtlinie stehen,
// was „Reparatur“ nach Artikel 2 Nummer 20 der Verordnung (EU) 2024/1781
// bedeutet und wie lange die Reparierbarkeit unionsrechtlich zu gewährleisten
// ist, sagt nicht das BGB. Diese drei Punkte sind typisierte EINGABEN des
// Falls (SOURCES.json, external); das Paket erfindet sie nicht.

pub relation hersteller(k: Kaufvertrag, p: Person) kind empirical {
    label de official "Hersteller der Ware (§ 479b Abs. 1, § 479f)";
    label en unofficial "manufacturer of the goods (§ 479b (1), § 479f)";
}
pub relation produktgruppe_des_anhangs_ii(k: Kaufvertrag) kind empirical {
    label de official "die Ware gehört einer Produktgruppe an, die in Anhang II der Richtlinie (EU) 2024/1799 aufgeführt ist (§ 479a Nr. 1) — Eingabe des Falls, der Rechtsakt der Union wird hier nicht formalisiert";
    label en unofficial "the goods belong to a product group listed in Annex II to Directive (EU) 2024/1799 (§ 479a no. 1) — input of the case; the Union act is not formalised here";
}
pub relation von_einem_verbraucher_gekauft(k: Kaufvertrag) kind empirical {
    label de official "die Ware hat ein Verbraucher gekauft (§ 479a Nr. 2)";
    label en unofficial "the goods were bought by a consumer (§ 479a no. 2)";
}
pub relation reparierbarkeit_unionsrechtlich_zu_gewaehrleisten(k: Kaufvertrag) kind empirical {
    label de official "der Hersteller muss die Reparierbarkeit der Ware, einschließlich der Verfügbarkeit von Ersatzteilen, nach den in Anhang II aufgeführten Rechtsakten der Union gewährleisten (§ 479b Abs. 2 Satz 1)";
    label en unofficial "the manufacturer must ensure the repairability of the goods, including the availability of spare parts, under the Union acts listed in Annex II (§ 479b (2) sentence 1)";
}
pub relation reparatur_tatsaechlich_oder_rechtlich_unmoeglich(k: Kaufvertrag) kind empirical {
    label de official "die Reparatur ist tatsächlich oder rechtlich unmöglich (§ 479b Abs. 2 Satz 2)";
    label en unofficial "the repair is factually or legally impossible (§ 479b (2) sentence 2)";
}
pub relation fruehere_reparatur_durch_andere(k: Kaufvertrag) kind empirical {
    label de official "eine frühere Reparatur wurde von anderen Reparaturbetrieben oder anderen Personen vorgenommen (§ 479b Abs. 2 Satz 3)";
    label en unofficial "an earlier repair was carried out by other repairers or other persons (§ 479b (2) sentence 3)";
}
pub relation reparaturverlangen_des_verbrauchers(r: Reparaturverlangen, k: Kaufvertrag) kind empirical {
    key(r);
    label de official "Verlangen eines Verbrauchers, die Ware zu reparieren (§ 479b Abs. 1 Satz 1)";
    label en unofficial "a consumer's request to repair the goods (§ 479b (1) sentence 1)";
}
pub relation reparatur_entgeltlich(r: Reparaturverlangen) kind empirical {
    label de official "die Reparatur erfolgt gegen Entgelt (§ 479b Abs. 3 Satz 1)";
    label en unofficial "the repair is carried out for consideration (§ 479b (3) sentence 1)";
}
pub relation verwendungszweck_nach_reparatur_nicht_erfuellt(r: Reparaturverlangen) kind empirical {
    label de official "die Ware ist nach Erbringung der Reparaturleistung nicht in einen Zustand zurückversetzt, in dem der vorgesehene Verwendungszweck erfüllt wird (§ 479b Abs. 4 Satz 1)";
    label en unofficial "after the repair the goods have not been restored to a condition in which the intended purpose is fulfilled (§ 479b (4) sentence 1)";
}
pub relation ware_im_besitz_des_herstellers_oder_zugaenglich(r: Reparaturverlangen) kind empirical {
    label de official "die Ware befindet sich im Besitz des Herstellers oder er hat Zugang zu ihr (§ 479b Abs. 1 Satz 2)";
    label en unofficial "the goods are in the manufacturer's possession or he has access to them (§ 479b (1) sentence 2)";
}
pub relation hersteller_sitz_ausserhalb_der_union(k: Kaufvertrag) kind empirical {
    label de official "der zur Reparatur verpflichtete Hersteller hat seinen Sitz außerhalb der Europäischen Union (§ 479f Satz 1)";
    label en unofficial "the manufacturer obliged to repair has his seat outside the European Union (§ 479f sentence 1)";
}
pub relation beauftragter_in_der_union(k: Kaufvertrag, p: Person) kind empirical {
    label de official "Beauftragter des Herstellers in der Europäischen Union (§ 479f Satz 1)";
    label en unofficial "the manufacturer's authorised representative in the European Union (§ 479f sentence 1)";
}
pub relation importeur(k: Kaufvertrag, p: Person) kind empirical {
    label de official "Importeur der betreffenden Ware (§ 479f Satz 2)";
    label en unofficial "importer of the goods concerned (§ 479f sentence 2)";
}
pub relation vertreiber(k: Kaufvertrag, p: Person) kind empirical {
    label de official "Vertreiber der betreffenden Ware (§ 479f Satz 3)";
    label en unofficial "distributor of the goods concerned (§ 479f sentence 3)";
}
pub relation kein_beauftragter_in_der_union(k: Kaufvertrag) kind empirical {
    label de official "der Hersteller hat in der Europäischen Union keinen Beauftragten (§ 479f Satz 2) — ausdrückliche Angabe des Falls";
    label en unofficial "the manufacturer has no authorised representative in the European Union (§ 479f sentence 2) — express statement of the case";
}
pub relation kein_importeur(k: Kaufvertrag) kind empirical {
    label de official "es gibt keinen Importeur der betreffenden Ware (§ 479f Satz 3) — ausdrückliche Angabe des Falls";
    label en unofficial "there is no importer of the goods concerned (§ 479f sentence 3) — express statement of the case";
}
pub relation hardware_oder_softwaretechnik_behindert_reparatur(k: Kaufvertrag) kind empirical {
    label de official "der Hersteller setzt Hardware- oder Softwaretechniken ein, die die Reparatur der Ware behindern (§ 479e Satz 1)";
    label en unofficial "the manufacturer uses hardware or software techniques which impede the repair of the goods (§ 479e sentence 1)";
}
pub relation behinderung_durch_legitime_faktoren_gerechtfertigt(k: Kaufvertrag) kind empirical {
    label de official "der Einsatz ist durch legitime und objektive Faktoren wie den Schutz der Rechte des geistigen Eigentums gerechtfertigt (§ 479e Satz 1)";
    label en unofficial "the use is justified by legitimate and objective factors such as the protection of intellectual property rights (§ 479e sentence 1)";
}
pub relation vereinbarung_zum_nachteil_des_verbrauchers_untertitel4(k: Kaufvertrag) kind empirical {
    label de official "eine Vereinbarung, die zum Nachteil des Verbrauchers von den Vorschriften dieses Untertitels abweicht (§ 479g Satz 1)";
    label en unofficial "an agreement derogating to the consumer's detriment from the provisions of this sub-title (§ 479g sentence 1)";
}

@source(BGB_P479b)
pub external judgment relation reparatur_in_angemessenem_zeitraum(r: Reparaturverlangen) {
    authority Court;
    label de official "§ 479b Abs. 1 Satz 2. Der Hersteller hat die Reparatur innerhalb eines angemessenen Zeitraums durchgeführt, sobald sich die Ware in seinem Besitz befand oder er Zugang zu ihr hatte";
    label en unofficial "§ 479b (1) sentence 2. The manufacturer carried out the repair within a reasonable period once the goods were in his possession or he had access to them";
}

@source(BGB_P479b)
pub external judgment relation entgelt_fuer_die_reparatur_angemessen(r: Reparaturverlangen) {
    authority Court;
    label de official "§ 479b Abs. 3 Satz 1. Das für die Reparatur verlangte Entgelt ist angemessen";
    label en unofficial "§ 479b (3) sentence 1. The consideration demanded for the repair is appropriate";
}

@source(BGB_P479c)
pub external judgment relation ersatzteilpreis_angemessen_und_nicht_abschreckend(k: Kaufvertrag) {
    authority Court;
    label de official "§ 479c. Der Hersteller bietet die Ersatzteile und reparaturbezogenen Werkzeuge zu einem angemessenen Preis an, der nicht von der Reparatur abschreckt";
    label en unofficial "§ 479c. The manufacturer offers the spare parts and repair-related tools at a reasonable price which does not deter repair";
}

pub relation anwendungsbereich_untertitel4(k: Kaufvertrag) kind institutional {
    label de official "die Vorschriften dieses Untertitels gelten für die Ware (§ 479a)";
    label en unofficial "the provisions of this sub-title apply to the goods (§ 479a)";
}
pub relation reparaturverpflichtung(k: Kaufvertrag, h: Person) kind institutional {
    label de official "Pflicht des Herstellers, die Ware auf Verlangen eines Verbrauchers zu reparieren (§ 479b Abs. 1 Satz 1)";
    label en unofficial "manufacturer's duty to repair the goods at a consumer's request (§ 479b (1) sentence 1)";
}
pub relation reparaturanspruch_besteht(r: Reparaturverlangen) kind institutional {
    label de official "der Anspruch auf Reparatur besteht (§ 479b Abs. 2 Satz 1)";
    label en unofficial "the claim to repair exists (§ 479b (2) sentence 1)";
}
pub relation ablehnung_wegen_fremdreparatur_unzulaessig(k: Kaufvertrag) kind institutional {
    label de official "der Hersteller darf die Reparatur nicht allein deshalb ablehnen, weil eine frühere Reparatur von anderen vorgenommen wurde (§ 479b Abs. 2 Satz 3)";
    label en unofficial "the manufacturer may not refuse the repair merely because an earlier repair was carried out by others (§ 479b (2) sentence 3)";
}
pub relation abnahmepflicht_des_verbrauchers(r: Reparaturverlangen) kind institutional {
    label de official "bei entgeltlicher Reparatur ist der Verbraucher verpflichtet, die reparierte Ware abzunehmen; die §§ 640 bis 642, 644 und 645 sind entsprechend anzuwenden (§ 479b Abs. 3 Satz 2)";
    label en unofficial "where the repair is for consideration the consumer must accept the repaired goods; §§ 640 to 642, 644 and 645 apply accordingly (§ 479b (3) sentence 2)";
}
pub relation recht_nacherfuellung_479b(r: Reparaturverlangen) kind institutional {
    label de official "Recht, entsprechend § 635 Nacherfüllung zu verlangen (§ 479b Abs. 4 Satz 1 Nr. 1)";
    label en unofficial "right to demand cure under § 635 applied accordingly (§ 479b (4) sentence 1 no. 1)";
}
pub relation recht_selbstvornahme_479b(r: Reparaturverlangen) kind institutional {
    label de official "Recht, entsprechend § 637 die Reparatur selbst durchzuführen und Ersatz der erforderlichen Aufwendungen zu verlangen (§ 479b Abs. 4 Satz 1 Nr. 2)";
    label en unofficial "right to carry out the repair oneself under § 637 applied accordingly and to claim the necessary expenses (§ 479b (4) sentence 1 no. 2)";
}
pub relation recht_entgeltminderung_479b(r: Reparaturverlangen) kind institutional {
    label de official "Recht, entsprechend § 638 das Entgelt zu mindern (§ 479b Abs. 4 Satz 1 Nr. 3)";
    label en unofficial "right to reduce the consideration under § 638 applied accordingly (§ 479b (4) sentence 1 no. 3)";
}
pub relation recht_schadensersatz_479b(r: Reparaturverlangen) kind institutional {
    label de official "Recht, nach den §§ 280 und 281 Schadensersatz oder nach § 284 Ersatz vergeblicher Aufwendungen zu verlangen; § 636 findet entsprechende Anwendung (§ 479b Abs. 4 Satz 1 Nr. 4, Satz 2)";
    label en unofficial "right to claim damages under §§ 280 and 281 or futile expenditure under § 284; § 636 applies accordingly (§ 479b (4) sentence 1 no. 4, sentence 2)";
}
pub relation pflicht_ersatzteile_und_werkzeuge_anzubieten(k: Kaufvertrag, h: Person) kind institutional {
    label de official "Pflicht des Herstellers, die Ersatzteile und reparaturbezogenen Werkzeuge für die Reparatur seiner Waren zu einem angemessenen, nicht abschreckenden Preis anzubieten (§ 479c)";
    label en unofficial "manufacturer's duty to offer the spare parts and repair-related tools for the repair of his goods at a reasonable price which does not deter repair (§ 479c)";
}
pub relation reparatur_durchgefuehrt_am(r: Reparaturverlangen, tag: Date) kind empirical {
    label de official "der Hersteller hat die Reparatur durchgeführt (§ 479b Abs. 1)";
    label en unofficial "the manufacturer carried out the repair (§ 479b (1))";
}
pub relation ersatzteile_angeboten_am(k: Kaufvertrag, tag: Date) kind empirical {
    label de official "der Hersteller hat Ersatzteile und Werkzeuge angeboten (§ 479c)";
    label en unofficial "the manufacturer offered spare parts and tools (§ 479c)";
}
pub relation informationspflicht_ueber_reparaturleistungen(k: Kaufvertrag, h: Person) kind institutional {
    label de official "Pflicht des Herstellers, Informationen über die Reparaturleistungen in leicht zugänglicher, klarer und verständlicher Weise kostenlos bereitzustellen (§ 479d Abs. 1)";
    label en unofficial "manufacturer's duty to provide information on the repair services free of charge in an easily accessible, clear and intelligible manner (§ 479d (1))";
}
pub relation pflicht_richtpreise_zu_veroeffentlichen(k: Kaufvertrag, h: Person) kind institutional {
    label de official "Pflicht des Herstellers, Verbrauchern auf einer frei zugänglichen Webseite Informationen über die Richtpreise typischer Reparaturen zur Verfügung zu stellen (§ 479d Abs. 2)";
    label en unofficial "manufacturer's duty to make available to consumers, on a freely accessible website, information on indicative prices of typical repairs (§ 479d (2))";
}
pub relation unzulaessige_handlung_479e(k: Kaufvertrag, h: Person) kind institutional {
    label de official "der Einsatz der Technik ist eine unzulässige Handlung (§ 479e Satz 1)";
    label en unofficial "the use of the technique is an impermissible act (§ 479e sentence 1)";
}
pub relation pflichten_treffen_den_vertreter(k: Kaufvertrag, p: Person) kind institutional {
    label de official "die Pflichten des Herstellers nach diesem Untertitel treffen den Beauftragten, den Importeur oder den Vertreiber (§ 479f)";
    label en unofficial "the manufacturer's duties under this sub-title are borne by the authorised representative, the importer or the distributor (§ 479f)";
}
pub relation berufung_auf_abweichende_vereinbarung_ausgeschlossen_479g(k: Kaufvertrag) kind institutional {
    label de official "der Hersteller oder der nach § 479f Verpflichtete kann sich auf die abweichende Vereinbarung nicht berufen (§ 479g Satz 1)";
    label en unofficial "the manufacturer or the person obliged under § 479f cannot rely on the derogating agreement (§ 479g sentence 1)";
}

@source(BGB_P479a)
rule Anwendungsbereich479a(k: Kaufvertrag, kp: Person) strict {
    label de official "Die Vorschriften dieses Untertitels gelten für Waren, die Produktgruppen des Anhangs II der Richtlinie (EU) 2024/1799 angehören, die ein Verbraucher gekauft hat und für die dem Verbraucher die in § 437 genannten Rechte nicht zustehen (§ 479a)";
    label en unofficial "The provisions of this sub-title apply to goods belonging to product groups listed in Annex II to Directive (EU) 2024/1799, bought by a consumer, and for which the consumer does not have the rights named in § 437 (§ 479a)";
    when produktgruppe_des_anhangs_ii(k) and von_einem_verbraucher_gekauft(k) and kaeufer(k, kp)
     and not_known(recht_auf_nacherfuellung(k, kp));
    then anwendungsbereich_untertitel4(k);
}

@source(BGB_P479b)
rule Reparaturverpflichtung479bAbs1(k: Kaufvertrag, h: Person) strict {
    label de official "Der Hersteller einer Ware, die in den Anwendungsbereich des § 479a fällt, ist verpflichtet, die Ware auf Verlangen eines Verbrauchers zu reparieren (§ 479b Abs. 1 Satz 1)";
    label en unofficial "The manufacturer of goods falling within the scope of § 479a is obliged to repair the goods at a consumer's request (§ 479b (1) sentence 1)";
    when anwendungsbereich_untertitel4(k) and hersteller(k, h);
    then reparaturverpflichtung(k, h);
}

@source(BGB_P479b)
rule Position479bReparatur(k: Kaufvertrag, r: Reparaturverlangen, h: Person, kp: Person, beginn: Date) strict {
    label de official "Der Hersteller ist verpflichtet, die Ware auf Verlangen des Verbrauchers zu reparieren (§ 479b Abs. 1 Satz 1)";
    label en unofficial "The manufacturer is obliged to repair the goods at a consumer's request (§ 479b (1) sentence 1)";
    when reparaturverpflichtung(k, h) and reparaturverlangen_des_verbrauchers(r, k)
     and kaeufer(k, kp) and vertragsschluss_am(k, beginn);
    then duty Duty479bReparatur {
        bearer h;
        beneficiary kp;
        achieve reparatur_durchgefuehrt_am(r, beginn) during [beginn, infinity);
    };
}

@source(BGB_P479b)
rule Reparaturanspruch479bAbs2(r: Reparaturverlangen, k: Kaufvertrag, h: Person) strict {
    label de official "Der Anspruch besteht, solange und soweit der Hersteller die Reparierbarkeit der Waren einschließlich der Verfügbarkeit von Ersatzteilen nach den Rechtsakten der Union gewährleisten muss; er besteht nicht, wenn die Reparatur tatsächlich oder rechtlich unmöglich ist (§ 479b Abs. 2 Sätze 1, 2)";
    label en unofficial "The claim exists as long as and in so far as the manufacturer must ensure repairability, including the availability of spare parts, under the Union acts; it does not exist where the repair is factually or legally impossible (§ 479b (2) sentences 1, 2)";
    when reparaturverlangen_des_verbrauchers(r, k) and reparaturverpflichtung(k, h)
     and reparierbarkeit_unionsrechtlich_zu_gewaehrleisten(k)
     and not reparatur_tatsaechlich_oder_rechtlich_unmoeglich(k);
    then reparaturanspruch_besteht(r);
}

@source(BGB_P479b)
rule Fremdreparatur479bAbs2Satz3(k: Kaufvertrag, h: Person) strict {
    label de official "Der Hersteller darf die Reparatur nicht allein deshalb ablehnen, weil eine frühere Reparatur von anderen Reparaturbetrieben oder anderen Personen vorgenommen wurde (§ 479b Abs. 2 Satz 3)";
    label en unofficial "The manufacturer may not refuse the repair merely because an earlier repair was carried out by other repairers or other persons (§ 479b (2) sentence 3)";
    when reparaturverpflichtung(k, h) and fruehere_reparatur_durch_andere(k);
    then ablehnung_wegen_fremdreparatur_unzulaessig(k);
}

@source(BGB_P479b)
rule Abnahmepflicht479bAbs3(r: Reparaturverlangen) strict {
    label de official "Erfolgt die Reparatur entgeltlich, ist der Verbraucher verpflichtet, die reparierte Ware abzunehmen; die §§ 640 bis 642, 644 und 645 sind entsprechend anzuwenden (§ 479b Abs. 3 Satz 2)";
    label en unofficial "Where the repair is for consideration the consumer must accept the repaired goods; §§ 640 to 642, 644 and 645 apply accordingly (§ 479b (3) sentence 2)";
    when reparaturanspruch_besteht(r) and reparatur_entgeltlich(r);
    then abnahmepflicht_des_verbrauchers(r);
}

@source(BGB_P479b)
rule Rechte479bAbs4Nr1(r: Reparaturverlangen) strict {
    label de official "Ist die Ware bei einer entgeltlichen Reparatur nicht in einen Zustand zurückversetzt, in dem der vorgesehene Verwendungszweck erfüllt wird, kann der Verbraucher entsprechend § 635 Nacherfüllung verlangen (§ 479b Abs. 4 Satz 1 Nr. 1)";
    label en unofficial "Where after a repair for consideration the goods are not restored to a condition fulfilling the intended purpose, the consumer may demand cure under § 635 applied accordingly (§ 479b (4) sentence 1 no. 1)";
    when reparatur_entgeltlich(r) and verwendungszweck_nach_reparatur_nicht_erfuellt(r);
    then recht_nacherfuellung_479b(r);
}

@source(BGB_P479b)
rule Rechte479bAbs4Nr2(r: Reparaturverlangen) strict {
    label de official "Der Verbraucher kann entsprechend § 637 die Reparatur selbst durchführen und Ersatz der erforderlichen Aufwendungen verlangen (§ 479b Abs. 4 Satz 1 Nr. 2)";
    label en unofficial "The consumer may carry out the repair himself under § 637 applied accordingly and claim the necessary expenses (§ 479b (4) sentence 1 no. 2)";
    when reparatur_entgeltlich(r) and verwendungszweck_nach_reparatur_nicht_erfuellt(r);
    then recht_selbstvornahme_479b(r);
}

@source(BGB_P479b)
rule Rechte479bAbs4Nr3(r: Reparaturverlangen) strict {
    label de official "Der Verbraucher kann entsprechend § 638 das Entgelt mindern (§ 479b Abs. 4 Satz 1 Nr. 3)";
    label en unofficial "The consumer may reduce the consideration under § 638 applied accordingly (§ 479b (4) sentence 1 no. 3)";
    when reparatur_entgeltlich(r) and verwendungszweck_nach_reparatur_nicht_erfuellt(r);
    then recht_entgeltminderung_479b(r);
}

@source(BGB_P479b)
rule Rechte479bAbs4Nr4(r: Reparaturverlangen) strict {
    label de official "Der Verbraucher kann nach den §§ 280 und 281 Schadensersatz oder nach § 284 Ersatz vergeblicher Aufwendungen verlangen; § 636 findet entsprechende Anwendung (§ 479b Abs. 4 Satz 1 Nr. 4, Satz 2)";
    label en unofficial "The consumer may claim damages under §§ 280 and 281 or futile expenditure under § 284; § 636 applies accordingly (§ 479b (4) sentence 1 no. 4, sentence 2)";
    when reparatur_entgeltlich(r) and verwendungszweck_nach_reparatur_nicht_erfuellt(r);
    then recht_schadensersatz_479b(r);
}

@source(BGB_P479c)
rule Ersatzteile479c(k: Kaufvertrag, h: Person) strict {
    label de official "Der Hersteller hat die Ersatzteile und reparaturbezogenen Werkzeuge für die Reparatur seiner Waren zu einem angemessenen Preis anzubieten, der nicht von der Reparatur abschreckt (§ 479c); ob der Preis angemessen ist, entscheidet das Gericht";
    label en unofficial "The manufacturer must offer the spare parts and repair-related tools for the repair of his goods at a reasonable price which does not deter repair (§ 479c); whether the price is reasonable is for the court to decide";
    when reparaturverpflichtung(k, h);
    then pflicht_ersatzteile_und_werkzeuge_anzubieten(k, h);
}

@source(BGB_P479c)
rule Position479cErsatzteile(k: Kaufvertrag, h: Person, kp: Person, beginn: Date) strict {
    label de official "Der Hersteller ist verpflichtet, Ersatzteile und reparaturbezogene Werkzeuge zu einem angemessenen Preis anzubieten (§ 479c)";
    label en unofficial "The manufacturer is obliged to offer spare parts and repair-related tools at a reasonable price (§ 479c)";
    when reparaturverpflichtung(k, h) and kaeufer(k, kp) and vertragsschluss_am(k, beginn);
    then duty Duty479cErsatzteile {
        bearer h;
        beneficiary kp;
        achieve ersatzteile_angeboten_am(k, beginn) during [beginn, infinity);
    };
}

@source(BGB_P479d)
rule Information479dAbs1(k: Kaufvertrag, h: Person) strict {
    label de official "Solange Hersteller nach § 479b Abs. 1 zur Reparatur verpflichtet sind, haben sie Informationen über diese Reparaturleistungen in leicht zugänglicher, klarer und verständlicher Weise kostenlos bereitzustellen (§ 479d Abs. 1)";
    label en unofficial "As long as manufacturers are obliged to repair under § 479b (1) they must provide information on those repair services free of charge in an easily accessible, clear and intelligible manner (§ 479d (1))";
    when reparaturverpflichtung(k, h);
    then informationspflicht_ueber_reparaturleistungen(k, h);
}

@source(BGB_P479d)
rule Richtpreise479dAbs2(k: Kaufvertrag, h: Person) strict {
    label de official "Hersteller sind verpflichtet, Verbrauchern auf einer frei zugänglichen Webseite Informationen über die Richtpreise zur Verfügung zu stellen, die für typische Reparaturen kalkuliert wurden (§ 479d Abs. 2)";
    label en unofficial "Manufacturers must make available to consumers on a freely accessible website information on the indicative prices calculated for typical repairs (§ 479d (2))";
    when anwendungsbereich_untertitel4(k) and hersteller(k, h);
    then pflicht_richtpreise_zu_veroeffentlichen(k, h);
}

@source(BGB_P479e)
rule UnzulaessigeHandlung479e(k: Kaufvertrag, h: Person) strict {
    label de official "Die Hersteller dürfen keine Hardware- oder Softwaretechniken einsetzen, die die Reparatur behindern, es sei denn, dies ist durch legitime und objektive Faktoren wie den Schutz der Rechte des geistigen Eigentums gerechtfertigt (§ 479e Satz 1)";
    label en unofficial "Manufacturers may not use hardware or software techniques which impede repair unless this is justified by legitimate and objective factors such as the protection of intellectual property rights (§ 479e sentence 1)";
    when anwendungsbereich_untertitel4(k) and hersteller(k, h)
     and hardware_oder_softwaretechnik_behindert_reparatur(k)
     and not behinderung_durch_legitime_faktoren_gerechtfertigt(k);
    then unzulaessige_handlung_479e(k, h);
}

@source(BGB_P479f)
rule Vertreter479fBeauftragter(k: Kaufvertrag, p: Person) strict {
    label de official "Hat der zur Reparatur verpflichtete Hersteller seinen Sitz außerhalb der Europäischen Union, so treffen seinen Beauftragten in der Europäischen Union die Pflichten des Herstellers nach diesem Untertitel (§ 479f Satz 1)";
    label en unofficial "Where the manufacturer obliged to repair has his seat outside the European Union, his authorised representative in the Union bears the manufacturer's duties under this sub-title (§ 479f sentence 1)";
    when anwendungsbereich_untertitel4(k) and hersteller_sitz_ausserhalb_der_union(k) and beauftragter_in_der_union(k, p);
    then pflichten_treffen_den_vertreter(k, p);
}

@source(BGB_P479f)
rule Vertreter479fImporteur(k: Kaufvertrag, p: Person) strict {
    label de official "Hat der Hersteller in der Europäischen Union keinen Beauftragten, so treffen den Importeur der betreffenden Ware diese Pflichten (§ 479f Satz 2)";
    label en unofficial "Where the manufacturer has no authorised representative in the Union, the importer of the goods concerned bears those duties (§ 479f sentence 2)";
    when anwendungsbereich_untertitel4(k) and hersteller_sitz_ausserhalb_der_union(k)
     and kein_beauftragter_in_der_union(k) and importeur(k, p);
    then pflichten_treffen_den_vertreter(k, p);
}

@source(BGB_P479f)
rule Vertreter479fVertreiber(k: Kaufvertrag, p: Person) strict {
    label de official "Gibt es keinen Importeur, so treffen den Vertreiber der betreffenden Ware die Pflichten des Herstellers nach diesem Untertitel (§ 479f Satz 3)";
    label en unofficial "Where there is no importer, the distributor of the goods concerned bears the manufacturer's duties under this sub-title (§ 479f sentence 3)";
    when anwendungsbereich_untertitel4(k) and hersteller_sitz_ausserhalb_der_union(k)
     and kein_beauftragter_in_der_union(k) and kein_importeur(k) and vertreiber(k, p);
    then pflichten_treffen_den_vertreter(k, p);
}

@source(BGB_P479g)
rule AbweichendeVereinbarung479g(k: Kaufvertrag) strict {
    label de official "Auf eine Vereinbarung, die zum Nachteil des Verbrauchers von den Vorschriften dieses Untertitels abweicht, kann sich der Hersteller oder der nach § 479f Verpflichtete nicht berufen (§ 479g Satz 1)";
    label en unofficial "The manufacturer or the person obliged under § 479f cannot rely on an agreement derogating to the consumer's detriment from the provisions of this sub-title (§ 479g sentence 1)";
    when anwendungsbereich_untertitel4(k) and vereinbarung_zum_nachteil_des_verbrauchers_untertitel4(k);
    then berufung_auf_abweichende_vereinbarung_ausgeschlossen_479g(k);
}
