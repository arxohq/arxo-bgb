// BÜRGERLICHES GESETZBUCH, BUCH 5 ABSCHNITT 3 TITEL 4 — VERMÄCHTNIS,
// ZWEITE RATE (§§ 2164–2191, ohne §§ 2166–2168a Rechenanteile — siehe
// unten). Fortsetzung von abschnitt-03-titel-04-vermaechtnis.law.
//
// §§ 2166–2168a (Belastung mit Hypothek/Grundschuld, Gesamthypothek,
// Gesamtgrundschuld, Schiffe): DIESE Runde formalisiert nur die
// QUALITATIVE Pflicht des Vermächtnisnehmers zur Befriedigung des
// Gläubigers, OHNE die anteilige Wertberechnung nachzubilden — die
// Koordinatoranweisung 18.09.2026 verlangt ausdrücklich keine Rechnung, wo
// der Text keine verlangt, und hier verlangt der Text eine Bruchrechnung
// über Grundstückswerte, die als eigenes Rechenmodell für Grundpfandrechte
// aussteht (Ledger-Eintrag unten). Die Deckung selbst ist Fallangabe.
//
// § 2182 Abs. 1, 2 und § 2183 verweisen auf Kaufrecht (§§ 433, 435 f., 444,
// 452 f. — de.bgb.kauf, nicht importiert): auch hier nur die QUALITATIVE
// Aussage (gleiche Pflichten wie ein Verkäufer; Nacherfüllung bzw.
// Schadensersatz ohne Fristsetzung bei Arglist), ohne die
// Sachmängelgewährleistung von `de.bgb.kauf` nachzubauen oder zu
// importieren — ein Bruecke waere ein neuer Fund, keine Wiederholung.

language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// --- Deklarationen §§ 2164–2165 --------------------------------------------

pub relation bestimmter_gegenstand_vermacht_2164(t: Testament) kind empirical {
    label de official "Das Vermächtnis eines bestimmten Gegenstands ist angeordnet (§ 2164 Abs. 1)";
    label en unofficial "the legacy of a specific object is ordered (§ 2164 (1))";
}
pub relation zubehoer_gilt_als_mitvermacht_vermutet_2164(t: Testament) kind derived {
    label de official "Das Vermächtnis erstreckt sich im Zweifel auf das beim Erbfall vorhandene Zubehör (§ 2164 Abs. 1)";
    label en unofficial "the legacy extends in case of doubt to the accessories existing at devolution (§ 2164 (1))";
}
pub relation ersatzanspruch_wegen_beschaedigung_nach_anordnung_2164(t: Testament) kind empirical {
    label de official "Dem Erblasser steht wegen einer nach der Anordnung erfolgten Beschädigung der Sache ein Anspruch auf Ersatz der Minderung zu (§ 2164 Abs. 2)";
    label en unofficial "the testator holds a claim to compensation for a value reduction from damage occurring after the order (§ 2164 (2))";
}
pub relation ersatzanspruch_gilt_als_mitvermacht_vermutet_2164(t: Testament) kind derived {
    label de official "Das Vermächtnis erstreckt sich im Zweifel auf diesen Ersatzanspruch (§ 2164 Abs. 2)";
    label en unofficial "the legacy extends in case of doubt to that compensation claim (§ 2164 (2))";
}
pub relation vermachter_gegenstand_mit_recht_belastet_2165(t: Testament) kind empirical {
    label de official "Der vermachte, zur Erbschaft gehörende Gegenstand ist mit einem Recht belastet (§ 2165 Abs. 1)";
    label en unofficial "the bequeathed object belonging to the estate is encumbered with a right (§ 2165 (1))";
}
pub relation beseitigung_der_belastung_nicht_verlangbar_vermutet_2165(t: Testament) kind derived {
    label de official "Der Vermächtnisnehmer kann im Zweifel nicht die Beseitigung der Belastung verlangen (§ 2165 Abs. 1 Satz 1)";
    label en unofficial "the legatee cannot in case of doubt demand removal of the encumbrance (§ 2165 (1) sentence 1)";
}
pub relation erblasser_hat_anspruch_auf_beseitigung_der_belastung_2165(t: Testament) kind empirical {
    label de official "Dem Erblasser steht ein Anspruch auf Beseitigung der Belastung zu (§ 2165 Abs. 1 Satz 2)";
    label en unofficial "the testator holds a claim to removal of the encumbrance (§ 2165 (1) sentence 2)";
}
pub relation beseitigungsanspruch_gilt_als_mitvermacht_vermutet_2165(t: Testament) kind derived {
    label de official "Das Vermächtnis erstreckt sich im Zweifel auf diesen Beseitigungsanspruch (§ 2165 Abs. 1 Satz 2)";
    label en unofficial "the legacy extends in case of doubt to that removal claim (§ 2165 (1) sentence 2)";
}

// --- Deklarationen §§ 2166–2168a (qualitativ, ohne Anteilsrechnung) --------

pub relation vermachtes_grundstueck_mit_hypothek_fuer_erblasserschuld_belastet_2166(t: Testament) kind empirical {
    label de official "Das vermachte, zur Erbschaft gehörende Grundstück ist mit einer Hypothek für eine Schuld des Erblassers belastet (§ 2166 Abs. 1)";
    label en unofficial "the bequeathed estate land is encumbered with a mortgage for a debt of the testator (§ 2166 (1))";
}
pub relation vermaechtnisnehmer_zur_befriedigung_soweit_wert_deckt_verpflichtet_vermutet_2166(t: Testament) kind derived {
    label de official "Der Vermächtnisnehmer ist im Zweifel dem Erben gegenüber zur rechtzeitigen Befriedigung des Gläubigers insoweit verpflichtet, als die Schuld durch den Wert des Grundstücks gedeckt wird (§ 2166 Abs. 1)";
    label en unofficial "the legatee is in case of doubt obliged to the heir to satisfy the creditor in time, to the extent the debt is covered by the land's value (§ 2166 (1))";
}
pub relation dritter_erblasser_gegenueber_zur_berichtigung_verpflichtet_2166(t: Testament) kind empirical {
    label de official "Ein Dritter ist dem Erblasser gegenüber zur Berichtigung der Schuld verpflichtet (§ 2166 Abs. 2)";
    label en unofficial "a third party is obliged to the testator to discharge the debt (§ 2166 (2))";
}
pub relation erbe_kann_berichtigung_nicht_vom_dritten_erlangen_2166(t: Testament) kind empirical {
    label de official "Der Erbe kann die Berichtigung nicht von dem Dritten erlangen (§ 2166 Abs. 2, Gegenausnahme)";
    label en unofficial "the heir cannot obtain discharge from the third party (§ 2166 (2), counter-exception)";
}
pub relation vermaechtnisnehmerpflicht_nur_bei_erfolgloser_drittinanspruchnahme_vermutet_2166(t: Testament) kind derived {
    label de official "Die Verpflichtung des Vermächtnisnehmers besteht im Zweifel nur, soweit der Erbe die Berichtigung nicht vom Dritten erlangen kann (§ 2166 Abs. 2)";
    label en unofficial "the legatee's duty exists in case of doubt only to the extent the heir cannot obtain discharge from the third party (§ 2166 (2))";
}
pub relation hypothek_der_in_1190_bezeichneten_art_2166(t: Testament) kind empirical {
    label de official "Die Hypothek ist eine solche der in § 1190 bezeichneten Art (Höchstbetragshypothek) (§ 2166 Abs. 3)";
    label en unofficial "the mortgage is of the kind specified in § 1190 (maximum-amount mortgage) (§ 2166 (3))";
}
pub relation p2166_auf_1190_hypothek_nicht_anwendbar_2166(t: Testament) kind derived {
    label de official "Auf eine Hypothek der in § 1190 bezeichneten Art findet § 2166 keine Anwendung (§ 2166 Abs. 3)";
    label en unofficial "§ 2166 does not apply to a mortgage of the § 1190 kind (§ 2166 (3))";
}
pub relation neben_vermachtem_grundstueck_weitere_erbschaftsgrundstuecke_mit_gleicher_hypothek_belastet_2167(t: Testament) kind empirical {
    label de official "Neben dem vermachten Grundstück sind andere zur Erbschaft gehörende Grundstücke mit derselben Hypothek belastet (§ 2167)";
    label en unofficial "besides the bequeathed land, other estate land is encumbered with the same mortgage (§ 2167)";
}
pub relation p2166_pflicht_auf_anteiligen_teil_beschraenkt_vermutet_2167(t: Testament) kind derived {
    label de official "Die Pflicht nach § 2166 beschränkt sich im Zweifel auf den Teil, der dem Verhältnis der Grundstückswerte entspricht (§ 2167) — die Anteilsrechnung selbst ist Fallangabe";
    label en unofficial "the § 2166 duty is in case of doubt limited to the part proportionate to the land values (§ 2167) — the apportionment itself is a case input";
}
pub relation mehrere_erbschaftsgrundstuecke_mit_gesamtgrundschuld_belastet_und_eines_vermacht_2168(t: Testament) kind empirical {
    label de official "An mehreren zur Erbschaft gehörenden Grundstücken besteht eine Gesamtgrundschuld oder Gesamtrentenschuld, und eines dieser Grundstücke ist vermacht (§ 2168 Abs. 1)";
    label en unofficial "several estate lands are encumbered with a joint land charge or annuity charge, and one of them is bequeathed (§ 2168 (1))";
}
pub relation vermaechtnisnehmer_zur_gesamtgrundschuldbefriedigung_anteilig_verpflichtet_vermutet_2168(t: Testament) kind derived {
    label de official "Der Vermächtnisnehmer ist im Zweifel dem Erben gegenüber zur Befriedigung des Gläubigers in Höhe des Anteils verpflichtet, der dem Verhältnis der Grundstückswerte entspricht (§ 2168 Abs. 1) — die Anteilsrechnung selbst ist Fallangabe";
    label en unofficial "the legatee is in case of doubt obliged to satisfy the creditor for the share proportionate to the land values (§ 2168 (1)) — the apportionment itself is a case input";
}
pub relation nicht_erbschaftliches_grundstueck_mit_gesamtgrundschuld_neben_vermachtem_belastet_und_erblasser_verpflichtet_2168(t: Testament) kind empirical {
    label de official "Neben dem vermachten Grundstück ist ein nicht zur Erbschaft gehörendes Grundstück mit derselben Gesamtgrundschuld belastet, und der Erblasser war dem Eigentümer oder dessen Rechtsvorgänger gegenüber zur Befriedigung des Gläubigers verpflichtet (§ 2168 Abs. 2)";
    label en unofficial "besides the bequeathed land, non-estate land is encumbered with the same joint charge, and the testator was obliged to that owner or a predecessor to satisfy the creditor (§ 2168 (2))";
}
pub relation p2166_und_p2167_auf_2168_abs2_fall_entsprechend_anwendbar_2168(t: Testament) kind derived {
    label de official "In diesem Fall finden die Vorschriften des § 2166 Abs. 1 und des § 2167 entsprechende Anwendung (§ 2168 Abs. 2)";
    label en unofficial "in that case §§ 2166 (1) and 2167 apply mutatis mutandis (§ 2168 (2))";
}
pub relation vermaechtnis_betrifft_eingetragenes_schiff_oder_schiffsbauwerk_oder_schiffshypothek_2168a(t: Testament) kind empirical {
    label de official "Das Vermächtnis betrifft ein eingetragenes Schiff, ein Schiffsbauwerk oder eine Schiffshypothek (§ 2168a)";
    label en unofficial "the legacy concerns a registered vessel, a vessel under construction, or a vessel mortgage (§ 2168a)";
}
pub relation p2165_abs2_p2166_p2167_auf_schiffe_sinngemaess_anwendbar_2168a(t: Testament) kind derived {
    label de official "§ 2165 Abs. 2, §§ 2166, 2167 gelten sinngemäß für eingetragene Schiffe, Schiffsbauwerke und Schiffshypotheken (§ 2168a)";
    label en unofficial "§ 2165 (2), §§ 2166, 2167 apply correspondingly to registered vessels, vessels under construction and vessel mortgages (§ 2168a)";
}

// --- Deklarationen §§ 2172–2191 --------------------------------------------

pub relation vermachte_sache_mit_anderer_verbunden_vermischt_vermengt_2172(t: Testament) kind empirical {
    label de official "Die vermachte Sache ist mit einer anderen Sache so verbunden, vermischt oder vermengt worden, dass nach §§ 946–948 Eigentum oder Miteigentum an ihr entstanden ist, oder nach § 950 verarbeitet/umgebildet (§ 2172 Abs. 1)";
    label en unofficial "the bequeathed thing has been combined, mixed or blended with another under §§ 946-948, or processed under § 950 (§ 2172 (1))";
}
pub relation leistung_der_vermachten_sache_gilt_als_unmoeglich_2172(t: Testament) kind derived {
    label de official "Die Leistung der vermachten Sache gilt als unmöglich (§ 2172 Abs. 1)";
    label en unofficial "performance of the bequeathed thing is deemed impossible (§ 2172 (1))";
}
pub relation verbindung_vermischung_vermengung_durch_anderen_als_erblasser_und_miteigentum_erworben_2172(t: Testament) kind empirical {
    label de official "Die Verbindung, Vermischung oder Vermengung ist durch einen anderen als den Erblasser erfolgt, und der Erblasser hat dadurch Miteigentum erworben (§ 2172 Abs. 2 Satz 1)";
    label en unofficial "the combination, mixing or blending was done by someone other than the testator, who thereby acquired co-ownership (§ 2172 (2) sentence 1)";
}
pub relation miteigentum_gilt_als_vermacht_vermutet_2172(t: Testament) kind derived {
    label de official "Das Miteigentum gilt im Zweifel als vermacht (§ 2172 Abs. 2 Satz 1)";
    label en unofficial "the co-ownership is deemed bequeathed in case of doubt (§ 2172 (2) sentence 1)";
}
pub relation erblasser_hat_wegnahmerecht_an_verbundener_sache_2172(t: Testament) kind empirical {
    label de official "Dem Erblasser steht ein Recht zur Wegnahme der verbundenen Sache zu (§ 2172 Abs. 2 Satz 1)";
    label en unofficial "the testator holds a right to remove the combined thing (§ 2172 (2) sentence 1)";
}
pub relation wegnahmerecht_gilt_als_vermacht_vermutet_2172(t: Testament) kind derived {
    label de official "Das Wegnahmerecht gilt im Zweifel als vermacht (§ 2172 Abs. 2 Satz 1)";
    label en unofficial "the removal right is deemed bequeathed in case of doubt (§ 2172 (2) sentence 1)";
}
pub relation forderung_des_erblassers_vermacht_2173(t: Testament) kind empirical {
    label de official "Der Erblasser hat eine ihm zustehende Forderung vermacht (§ 2173)";
    label en unofficial "the testator bequeathed a claim owed to them (§ 2173)";
}
pub relation vor_erbfall_geleistet_und_gegenstand_noch_in_erbschaft_2173(t: Testament) kind empirical {
    label de official "Vor dem Erbfall ist die Leistung erfolgt, und der geleistete Gegenstand ist noch in der Erbschaft vorhanden (§ 2173 Satz 1)";
    label en unofficial "performance occurred before devolution and the delivered object is still part of the estate (§ 2173 sentence 1)";
}
pub relation geleisteter_gegenstand_gilt_als_zugewendet_vermutet_2173(t: Testament) kind derived {
    label de official "Im Zweifel ist anzunehmen, dass dem Bedachten der geleistete Gegenstand zugewendet sein soll (§ 2173 Satz 1)";
    label en unofficial "in case of doubt it is assumed that the delivered object is intended for the beneficiary (§ 2173 sentence 1)";
}
pub relation forderung_auf_geldsumme_gerichtet_2173(t: Testament) kind empirical {
    label de official "Die vermachte Forderung war auf die Zahlung einer Geldsumme gerichtet (§ 2173 Satz 2)";
    label en unofficial "the bequeathed claim was directed at payment of a sum of money (§ 2173 sentence 2)";
}
pub relation entsprechende_geldsumme_gilt_als_vermacht_vermutet_2173(t: Testament) kind derived {
    label de official "Die entsprechende Geldsumme gilt im Zweifel als vermacht, auch wenn sie in der Erbschaft nicht vorhanden ist (§ 2173 Satz 2)";
    label en unofficial "the corresponding sum is deemed bequeathed in case of doubt, even if not found in the estate (§ 2173 sentence 2)";
}
pub relation vermaechtnis_angeordnet_2174(t: Testament, bedachter: Person) kind empirical {
    label de official "Ein Vermächtnis ist zugunsten des Bedachten angeordnet (§ 2174)";
    label en unofficial "a legacy is ordered in favour of the beneficiary (§ 2174)";
}
pub relation vermaechtnisanspruch_begruendet_2174(t: Testament, bedachter: Person) kind derived {
    label de official "Durch das Vermächtnis wird für den Bedachten das Recht begründet, vom Beschwerten die Leistung zu fordern (§ 2174)";
    label en unofficial "the legacy establishes the beneficiary's right to demand performance from the burdened person (§ 2174)";
}
pub relation forderung_oder_belastetes_recht_des_erblassers_gegen_erben_vermacht_2175(t: Testament) kind empirical {
    label de official "Der Erblasser hat eine ihm gegen den Erben zustehende Forderung oder ein Recht vermacht, mit dem eine Sache oder ein Recht des Erben belastet ist (§ 2175)";
    label en unofficial "the testator bequeathed a claim against the heir, or a right encumbering the heir's thing or right (§ 2175)";
}
pub relation durch_vereinigung_erloschenes_rechtsverhaeltnis_gilt_als_nicht_erloschen_2175(t: Testament) kind derived {
    label de official "Das durch Vereinigung von Recht und Verbindlichkeit oder Belastung erloschene Rechtsverhältnis gilt in Ansehung des Vermächtnisses als nicht erloschen (§ 2175)";
    label en unofficial "a legal relationship extinguished by merger of right and duty or encumbrance is deemed not extinguished as regards the legacy (§ 2175)";
}
pub relation vermaechtnisforderung_entsteht_mit_erbfall_2176(t: Testament, bedachter: Person) kind derived {
    label de official "Die Forderung des Vermächtnisnehmers entsteht (Anfall) mit dem Erbfall, unbeschadet des Ausschlagungsrechts (§ 2176)";
    label en unofficial "the legatee's claim arises (devolution of the legacy) with the devolution, without prejudice to the right to disclaim (§ 2176)";
}
pub relation vermaechtnis_bedingt_oder_befristet_und_eintritt_nach_erbfall_2177(t: Testament) kind empirical {
    label de official "Das Vermächtnis ist unter aufschiebender Bedingung oder Anfangstermin angeordnet, und Bedingung oder Termin treten erst nach dem Erbfall ein (§ 2177)";
    label en unofficial "the legacy is ordered under a suspensive condition or initial term, occurring only after devolution (§ 2177)";
}
pub relation vermaechtnisanfall_mit_bedingungs_oder_termineintritt_2177(t: Testament) kind derived {
    label de official "Der Anfall des Vermächtnisses erfolgt mit dem Eintritt der Bedingung oder des Termins (§ 2177)";
    label en unofficial "devolution of the legacy occurs with occurrence of the condition or term (§ 2177)";
}
pub relation bedachter_beim_erbfall_noch_nicht_gezeugt_2178(t: Testament, bedachter: Person) kind empirical {
    label de official "Der Bedachte ist zur Zeit des Erbfalls noch nicht gezeugt (§ 2178 Fall 1)";
    label en unofficial "the beneficiary was not yet conceived at devolution (§ 2178 case 1)";
}
pub relation vermaechtnisanfall_mit_geburt_2178(t: Testament, bedachter: Person) kind derived {
    label de official "Der Anfall des Vermächtnisses erfolgt mit der Geburt des Bedachten (§ 2178 Fall 1)";
    label en unofficial "devolution of the legacy occurs with the beneficiary's birth (§ 2178 case 1)";
}
pub relation bedachtenpersoenlichkeit_durch_spaeteres_ereignis_bestimmt_2178(t: Testament, bedachter: Person) kind empirical {
    label de official "Die Persönlichkeit des Bedachten wird erst durch ein nach dem Erbfall eintretendes Ereignis bestimmt (§ 2178 Fall 2)";
    label en unofficial "the beneficiary's identity is determined only by an event occurring after devolution (§ 2178 case 2)";
}
pub relation vermaechtnisanfall_mit_ereigniseintritt_2178(t: Testament, bedachter: Person) kind derived {
    label de official "Der Anfall des Vermächtnisses erfolgt mit dem Eintritt des Ereignisses (§ 2178 Fall 2)";
    label en unofficial "devolution of the legacy occurs with occurrence of the event (§ 2178 case 2)";
}
pub relation schwebezeit_2177_oder_2178_2179(t: Testament) kind empirical {
    label de official "Es liegt eine Schwebezeit zwischen Erbfall und Anfall des Vermächtnisses nach §§ 2177, 2178 vor (§ 2179)";
    label en unofficial "there is a pending period between devolution and the legacy's devolution under §§ 2177, 2178 (§ 2179)";
}
pub relation vorschriften_fuer_aufschiebend_bedingte_leistung_in_schwebezeit_anwendbar_2179(t: Testament) kind derived {
    label de official "Für die Schwebezeit finden die Vorschriften Anwendung, die für eine unter aufschiebender Bedingung geschuldete Leistung gelten (§ 2179)";
    label en unofficial "the rules governing performance owed under a suspensive condition apply during the pending period (§ 2179)";
}
pub relation vermaechtnis_angenommen_2180(t: Testament, bedachter: Person) kind empirical {
    label de official "Der Vermächtnisnehmer hat das Vermächtnis angenommen (§ 2180 Abs. 1)";
    label en unofficial "the legatee has accepted the legacy (§ 2180 (1))";
}
pub relation ausschlagung_nach_annahme_ausgeschlossen_2180(t: Testament, bedachter: Person) kind derived {
    label de official "Der Vermächtnisnehmer kann das Vermächtnis nach der Annahme nicht mehr ausschlagen (§ 2180 Abs. 1)";
    label en unofficial "the legatee can no longer disclaim the legacy after acceptance (§ 2180 (1))";
}
pub relation annahme_oder_ausschlagung_gegenueber_beschwertem_erklaert_nach_erbfall_und_unbedingt_2180(t: Testament, bedachter: Person) kind empirical {
    label de official "Annahme oder Ausschlagung sind durch Erklärung gegenüber dem Beschwerten, erst nach dem Erbfall und ohne Bedingung oder Zeitbestimmung abgegeben (§ 2180 Abs. 2)";
    label en unofficial "acceptance or disclaimer are declared to the burdened person, only after devolution, without condition or time clause (§ 2180 (2))";
}
pub relation annahme_oder_ausschlagung_wirksam_2180(t: Testament, bedachter: Person) kind derived {
    label de official "Annahme oder Ausschlagung sind wirksam (§ 2180 Abs. 2)";
    label en unofficial "acceptance or disclaimer are effective (§ 2180 (2))";
}
pub relation p1950_p1952_abs1_3_p1953_abs1_2_auf_vermaechtnisannahme_entsprechend_anwendbar_2180(t: Testament) kind derived {
    label de official "Die für Annahme und Ausschlagung einer Erbschaft geltenden §§ 1950, 1952 Abs. 1, 3, 1953 Abs. 1, 2 finden entsprechende Anwendung (§ 2180 Abs. 3)";
    label en unofficial "§§ 1950, 1952 (1), (3), 1953 (1), (2) governing acceptance and disclaimer of an inheritance apply mutatis mutandis (§ 2180 (3))";
}
pub relation erfuellungszeit_dem_belieben_des_beschwerten_ueberlassen_2181(t: Testament, beschwerter: Person) kind empirical {
    label de official "Die Zeit der Erfüllung eines Vermächtnisses ist dem freien Belieben des Beschwerten überlassen (§ 2181)";
    label en unofficial "the time of performance of a legacy is left to the burdened person's free discretion (§ 2181)";
}
pub relation leistung_faellig_mit_tod_des_beschwerten_vermutet_2181(t: Testament, beschwerter: Person) kind derived {
    label de official "Die Leistung wird im Zweifel mit dem Tode des Beschwerten fällig (§ 2181)";
    label en unofficial "performance falls due in case of doubt on the burdened person's death (§ 2181)";
}
pub relation nur_der_gattung_nach_bestimmter_gegenstand_vermacht_2182(t: Testament) kind empirical {
    label de official "Ein nur der Gattung nach bestimmter Gegenstand ist vermacht (§ 2182 Abs. 1)";
    label en unofficial "an object determined only by kind is bequeathed (§ 2182 (1))";
}
pub relation beschwerter_hat_verkaeuferpflichten_gegen_rechtsmaengel_2182(t: Testament) kind derived {
    label de official "Der Beschwerte hat gleiche Verpflichtungen wie ein Verkäufer nach § 433 Abs. 1 Satz 1, §§ 436, 452, 453 und hat den Gegenstand frei von Rechtsmängeln im Sinne des § 435 zu verschaffen (§ 2182 Abs. 1)";
    label en unofficial "the burdened person has the same duties as a seller under § 433 (1) sentence 1, §§ 436, 452, 453 and must convey the object free of defects of title under § 435 (§ 2182 (1))";
}
pub relation bestimmter_nicht_zur_erbschaft_gehoerender_gegenstand_vermacht_2182(t: Testament) kind empirical {
    label de official "Ein bestimmter, nicht zur Erbschaft gehörender Gegenstand ist vermacht (§ 2182 Abs. 2)";
    label en unofficial "a specific object not belonging to the estate is bequeathed (§ 2182 (2))";
}
pub relation dieselben_verkaeuferpflichten_vermutet_2182(t: Testament) kind derived {
    label de official "Dasselbe gilt im Zweifel, unbeschadet der Haftungsbeschränkung aus § 2170 (§ 2182 Abs. 2)";
    label en unofficial "the same applies in case of doubt, without prejudice to the liability limit of § 2170 (§ 2182 (2))";
}
pub relation grundstueck_gegenstand_des_vermaechtnisses_2182(t: Testament) kind empirical {
    label de official "Ein Grundstück ist Gegenstand des Vermächtnisses (§ 2182 Abs. 3)";
    label en unofficial "land is the object of the legacy (§ 2182 (3))";
}
pub relation keine_haftung_fuer_dienstbarkeiten_und_reallasten_vermutet_2182(t: Testament) kind derived {
    label de official "Der Beschwerte haftet im Zweifel nicht für die Freiheit des Grundstücks von Grunddienstbarkeiten, beschränkten persönlichen Dienstbarkeiten und Reallasten (§ 2182 Abs. 3)";
    label en unofficial "the burdened person is in case of doubt not liable for the land's freedom from easements, limited personal servitudes and land charges (§ 2182 (3))";
}
pub relation nur_der_gattung_nach_bestimmte_sache_mangelhaft_geleistet_2183(t: Testament) kind empirical {
    label de official "Eine nur der Gattung nach bestimmte vermachte Sache ist mangelhaft geleistet worden (§ 2183 Satz 1)";
    label en unofficial "a generically determined bequeathed thing was delivered defective (§ 2183 sentence 1)";
}
pub relation nacherfuellung_durch_mangelfreie_sache_verlangbar_2183(t: Testament) kind derived {
    label de official "Der Vermächtnisnehmer kann verlangen, dass ihm anstelle der mangelhaften eine mangelfreie Sache geliefert wird (§ 2183 Satz 1)";
    label en unofficial "the legatee may demand delivery of a defect-free thing instead of the defective one (§ 2183 sentence 1)";
}
pub relation beschwerter_hat_sachmangel_arglistig_verschwiegen_2183(t: Testament) kind empirical {
    label de official "Der Beschwerte hat einen Sachmangel arglistig verschwiegen (§ 2183 Satz 2)";
    label en unofficial "the burdened person fraudulently concealed a defect (§ 2183 sentence 2)";
}
pub relation schadensersatz_statt_leistung_ohne_fristsetzung_verlangbar_2183(t: Testament) kind derived {
    label de official "Der Vermächtnisnehmer kann anstelle der Nacherfüllung Schadensersatz statt der Leistung verlangen, ohne Frist zur Nacherfüllung setzen zu müssen (§ 2183 Satz 2)";
    label en unofficial "the legatee may demand damages in lieu of performance instead of cure, without first having to set a period for cure (§ 2183 sentence 2)";
}
pub relation bestimmter_zur_erbschaft_gehoerender_gegenstand_vermacht_2184(t: Testament) kind empirical {
    label de official "Ein bestimmter, zur Erbschaft gehörender Gegenstand ist vermacht (§ 2184)";
    label en unofficial "a specific object belonging to the estate is bequeathed (§ 2184)";
}
pub relation herausgabe_der_seit_anfall_gezogenen_fruechte_geschuldet_2184(t: Testament) kind derived {
    label de official "Der Beschwerte hat dem Vermächtnisnehmer die seit dem Anfall gezogenen Früchte sowie das sonst aufgrund des Rechts Erlangte herauszugeben (§ 2184 Satz 1)";
    label en unofficial "the burdened person must surrender to the legatee the fruits drawn since devolution and anything else obtained under the right (§ 2184 sentence 1)";
}
pub relation kein_ersatz_fuer_sonstige_nutzungen_2184(t: Testament) kind derived {
    label de official "Für Nutzungen, die nicht zu den Früchten gehören, hat der Beschwerte keinen Ersatz zu leisten (§ 2184 Satz 2)";
    label en unofficial "the burdened person owes no compensation for uses that are not fruits (§ 2184 sentence 2)";
}
pub relation bestimmte_zur_erbschaft_gehoerende_sache_vermacht_und_verwendungen_gemacht_2185(t: Testament) kind empirical {
    label de official "Eine bestimmte, zur Erbschaft gehörende Sache ist vermacht, und der Beschwerte hat nach dem Erbfall Verwendungen oder Aufwendungen gemacht (§ 2185)";
    label en unofficial "a specific estate thing is bequeathed, and the burdened person made improvements or expenses after devolution (§ 2185)";
}
pub relation ersatz_nach_besitzer_eigentuemer_vorschriften_verlangbar_2185(t: Testament) kind derived {
    label de official "Der Beschwerte kann Ersatz nach den für das Verhältnis zwischen Besitzer und Eigentümer geltenden Vorschriften verlangen (§ 2185)";
    label en unofficial "the burdened person may demand compensation under the rules governing the relationship between possessor and owner (§ 2185)";
}
pub relation vermaechtnisnehmer_mit_untervermaechtnis_oder_auflage_beschwert_2186(t: Testament, vermaechtnisnehmer: Person) kind empirical {
    label de official "Ein Vermächtnisnehmer ist mit einem Vermächtnis oder einer Auflage beschwert (§ 2186)";
    label en unofficial "a legatee is burdened with a sub-legacy or a charge (§ 2186)";
}
pub relation erfuellung_erst_bei_eigener_verlangbarkeit_verpflichtet_2186(t: Testament, vermaechtnisnehmer: Person) kind derived {
    label de official "Er ist zur Erfüllung erst verpflichtet, wenn er die Erfüllung des ihm zugewendeten Vermächtnisses zu verlangen berechtigt ist (§ 2186)";
    label en unofficial "he is obliged to perform only once entitled to demand performance of the legacy granted to him (§ 2186)";
}
pub relation vermaechtnisnehmer_mit_vermaechtnis_oder_auflage_beschwert_und_eigenes_reicht_nicht_2187(t: Testament, vermaechtnisnehmer: Person) kind empirical {
    label de official "Ein mit Vermächtnis oder Auflage beschwerter Vermächtnisnehmer erhält aus seinem eigenen Vermächtnis nicht genug zur Erfüllung (§ 2187 Abs. 1)";
    label en unofficial "a legatee burdened with a legacy or charge receives from their own legacy not enough to perform it (§ 2187 (1))";
}
pub relation erfuellung_auch_nach_annahme_insoweit_verweigerbar_2187(t: Testament, vermaechtnisnehmer: Person) kind derived {
    label de official "Er kann die Erfüllung auch nach der Annahme insoweit verweigern, als das Erhaltene zur Erfüllung nicht ausreicht (§ 2187 Abs. 1)";
    label en unofficial "he may refuse performance even after acceptance to the extent what he received is insufficient (§ 2187 (1))";
}
pub relation nach_2161_anderer_an_stelle_des_beschwerten_vermaechtnisnehmers_getreten_2187(t: Testament, nachfolger: Person, vermaechtnisnehmer: Person) kind empirical {
    label de official "Nach § 2161 ist ein anderer an die Stelle des beschwerten Vermächtnisnehmers getreten (§ 2187 Abs. 2)";
    label en unofficial "under § 2161 another has taken the place of the burdened legatee (§ 2187 (2))";
}
pub relation nachfolger_haftet_nicht_weiter_als_vermaechtnisnehmer_gehaftet_haette_2187(t: Testament, nachfolger: Person) kind derived {
    label de official "Der Nachfolger haftet nicht weiter, als der Vermächtnisnehmer haften würde (§ 2187 Abs. 2)";
    label en unofficial "the successor is not liable beyond what the legatee would have been liable for (§ 2187 (2))";
}
pub relation p1992_auf_vermaechtnisnehmerhaftung_entsprechend_anwendbar_2187(t: Testament) kind derived {
    label de official "Die für die Erbenhaftung geltenden Vorschriften des § 1992 finden entsprechende Anwendung (§ 2187 Abs. 3)";
    label en unofficial "§ 1992, governing the heir's liability, applies mutatis mutandis (§ 2187 (3))";
}
pub relation vermaechtnisleistung_wegen_haftungsbeschraenkung_pflichtteil_oder_2187_gekuerzt_2188(t: Testament, vermaechtnisnehmer: Person) kind empirical {
    label de official "Die dem Vermächtnisnehmer gebührende Leistung ist aufgrund von Haftungsbeschränkung, Pflichtteilsanspruch oder § 2187 gekürzt (§ 2188)";
    label en unofficial "the performance owed to the legatee is reduced owing to liability limitation, a compulsory-portion claim, or § 2187 (§ 2188)";
}
pub relation eigene_beschwerungen_verhaeltnismaessig_kuerzbar_vermutet_2188(t: Testament, vermaechtnisnehmer: Person) kind derived {
    label de official "Der Vermächtnisnehmer kann im Zweifel die ihm auferlegten Beschwerungen verhältnismäßig kürzen (§ 2188)";
    label en unofficial "the legatee may in case of doubt reduce their own imposed charges proportionately (§ 2188)";
}
pub relation anderer_wille_des_erblassers_bei_2188_anzunehmen(t: Testament, vermaechtnisnehmer: Person) kind empirical {
    label de official "Bei der Kürzung nach § 2188 ist ein anderer Wille des Erblassers anzunehmen (§ 2188, Gegenausnahme)";
    label en unofficial "a different testamentary intention must be assumed for the § 2188 reduction (§ 2188, counter-exception)";
}
pub relation vorrang_fuer_kuerzungsfall_angeordnet_2189(t: Testament) kind empirical {
    label de official "Der Erblasser hat für den Kürzungsfall nach §§ 2187, 2188 angeordnet, dass ein Vermächtnis oder eine Auflage den Vorrang vor den übrigen Beschwerungen haben soll (§ 2189)";
    label en unofficial "the testator ordered, for a § 2187/2188 reduction case, that a legacy or charge take priority over the other burdens (§ 2189)";
}
pub relation vorrangsanordnung_zulaessig_2189(t: Testament) kind derived {
    label de official "Die Vorrangsanordnung ist zulässig (§ 2189)";
    label en unofficial "the priority order is permitted (§ 2189)";
}
pub relation ersatzvermaechtnisnehmer_fuer_nichterwerb_eingesetzt_2190(t: Testament, ersatz: Person, zuerst: Person) kind empirical {
    label de official "Der Erblasser hat für den Fall, dass der zunächst Bedachte das Vermächtnis nicht erwirbt, den Gegenstand einem anderen zugewendet (§ 2190)";
    label en unofficial "the testator, for the case the first beneficiary does not acquire the legacy, granted the object to another (§ 2190)";
}
pub relation p2097_bis_2099_auf_ersatzvermaechtnisnehmer_entsprechend_anwendbar_2190(t: Testament) kind derived {
    label de official "Die für die Einsetzung eines Ersatzerben geltenden §§ 2097 bis 2099 finden entsprechende Anwendung (§ 2190)";
    label en unofficial "§§ 2097 to 2099, governing appointment of a substitute heir, apply mutatis mutandis (§ 2190)";
}
pub relation vermachter_gegenstand_ab_spaeterem_zeitpunkt_oder_ereignis_drittem_zugewendet_2191(t: Testament, erster: Person, dritter: Person) kind empirical {
    label de official "Der Erblasser hat den vermachten Gegenstand von einem nach dem Anfall eintretenden Zeitpunkt oder Ereignis an einem Dritten zugewendet (§ 2191 Abs. 1)";
    label en unofficial "the testator granted the bequeathed object to a third party from a point or event occurring after devolution (§ 2191 (1))";
}
pub relation erster_vermaechtnisnehmer_gilt_als_beschwert_2191(t: Testament, erster: Person) kind derived {
    label de official "Der erste Vermächtnisnehmer gilt als beschwert (§ 2191 Abs. 1)";
    label en unofficial "the first legatee is deemed burdened (§ 2191 (1))";
}
pub relation p2102_p2106abs1_p2107_p2110abs1_auf_nachvermaechtnis_entsprechend_anwendbar_2191(t: Testament) kind derived {
    label de official "Die für die Einsetzung eines Nacherben geltenden § 2102, § 2106 Abs. 1, § 2107 und § 2110 Abs. 1 finden entsprechende Anwendung (§ 2191 Abs. 2)";
    label en unofficial "§ 2102, § 2106 (1), § 2107 and § 2110 (1), governing appointment of a subsequent heir, apply mutatis mutandis (§ 2191 (2))";
}

// --- Regeln §§ 2164–2165 ----------------------------------------------------

@source(BGB_P2164) {
    presumption ZubehoerMitvermacht(t: Testament) {
        label de official "Das Vermächtnis erstreckt sich im Zweifel auf das beim Erbfall vorhandene Zubehör (§ 2164 Abs. 1)"; label en unofficial "The legacy extends in case of doubt to the accessories existing at devolution (§ 2164 (1))";
        when bestimmter_gegenstand_vermacht_2164(t); presume zubehoer_gilt_als_mitvermacht_vermutet_2164(t);
    }
    presumption ErsatzanspruchMitvermacht(t: Testament) {
        label de official "Der Anspruch auf Ersatz der Minderung des Wertes gilt im Zweifel als mitvermacht (§ 2164 Abs. 2)"; label en unofficial "The claim to compensation for the reduction in value is deemed bequeathed in case of doubt (§ 2164 (2))";
        when ersatzanspruch_wegen_beschaedigung_nach_anordnung_2164(t); presume ersatzanspruch_gilt_als_mitvermacht_vermutet_2164(t);
    }
}
@source(BGB_P2165) {
    presumption BeseitigungNichtVerlangbar(t: Testament) {
        label de official "Der Vermächtnisnehmer kann im Zweifel nicht die Beseitigung der Belastung verlangen (§ 2165 Abs. 1 Satz 1)"; label en unofficial "The legatee cannot in case of doubt demand removal of the encumbrance (§ 2165 (1) sentence 1)";
        when vermachter_gegenstand_mit_recht_belastet_2165(t); presume beseitigung_der_belastung_nicht_verlangbar_vermutet_2165(t);
    }
    presumption BeseitigungsanspruchMitvermacht(t: Testament) {
        label de official "Steht dem Erblasser ein Anspruch auf Beseitigung zu, erstreckt sich das Vermächtnis im Zweifel auf diesen Anspruch (§ 2165 Abs. 1 Satz 2)"; label en unofficial "Where the testator holds a removal claim, the legacy extends to it in case of doubt (§ 2165 (1) sentence 2)";
        when erblasser_hat_anspruch_auf_beseitigung_der_belastung_2165(t); presume beseitigungsanspruch_gilt_als_mitvermacht_vermutet_2165(t);
    }
}

// --- Regeln §§ 2166–2168a (qualitativ) -------------------------------------

@source(BGB_P2166) {
    presumption BefriedigungSoweitWertDeckt(t: Testament) {
        label de official "Der Vermächtnisnehmer ist im Zweifel dem Erben gegenüber zur rechtzeitigen Befriedigung des Gläubigers insoweit verpflichtet, als die Schuld durch den Wert des Grundstücks gedeckt wird (§ 2166 Abs. 1)"; label en unofficial "The legatee is in case of doubt obliged to satisfy the creditor in time, to the extent the debt is covered by the land's value (§ 2166 (1))";
        when vermachtes_grundstueck_mit_hypothek_fuer_erblasserschuld_belastet_2166(t); presume vermaechtnisnehmer_zur_befriedigung_soweit_wert_deckt_verpflichtet_vermutet_2166(t);
    }
    presumption PflichtNurBeiErfolgloserDrittinanspruchnahme(t: Testament) {
        label de official "Ist ein Dritter zur Berichtigung verpflichtet, besteht die Pflicht des Vermächtnisnehmers im Zweifel nur, soweit der Erbe vom Dritten keine Berichtigung erlangen kann (§ 2166 Abs. 2)"; label en unofficial "Where a third party is obliged to discharge the debt, the legatee's duty exists in case of doubt only insofar as the heir cannot obtain discharge from the third party (§ 2166 (2))";
        when dritter_erblasser_gegenueber_zur_berichtigung_verpflichtet_2166(t) and erbe_kann_berichtigung_nicht_vom_dritten_erlangen_2166(t); presume vermaechtnisnehmerpflicht_nur_bei_erfolgloser_drittinanspruchnahme_vermutet_2166(t);
    }
    rule Keine1190HypothekAnwendung(t: Testament) strict {
        label de official "Auf eine Hypothek der in § 1190 bezeichneten Art finden diese Vorschriften keine Anwendung (§ 2166 Abs. 3)"; label en unofficial "These provisions do not apply to a mortgage of the § 1190 kind (§ 2166 (3))";
        when hypothek_der_in_1190_bezeichneten_art_2166(t); then p2166_auf_1190_hypothek_nicht_anwendbar_2166(t);
    }
}
@source(BGB_P2167)
presumption PflichtAufAnteilBeschraenkt(t: Testament) {
    label de official "Die Verpflichtung nach § 2166 beschränkt sich im Zweifel auf den dem Wertverhältnis entsprechenden Teil der Schuld (§ 2167)"; label en unofficial "The § 2166 duty is in case of doubt limited to the part of the debt proportionate to the value ratio (§ 2167)";
    when neben_vermachtem_grundstueck_weitere_erbschaftsgrundstuecke_mit_gleicher_hypothek_belastet_2167(t); presume p2166_pflicht_auf_anteiligen_teil_beschraenkt_vermutet_2167(t);
}
@source(BGB_P2168) {
    presumption GesamtgrundschuldBefriedigungAnteilig(t: Testament) {
        label de official "Der Vermächtnisnehmer ist im Zweifel dem Erben gegenüber zur Befriedigung des Gläubigers in Höhe des dem Wertverhältnis entsprechenden Teils verpflichtet (§ 2168 Abs. 1)"; label en unofficial "The legatee is in case of doubt obliged to satisfy the creditor for the part proportionate to the value ratio (§ 2168 (1))";
        when mehrere_erbschaftsgrundstuecke_mit_gesamtgrundschuld_belastet_und_eines_vermacht_2168(t); presume vermaechtnisnehmer_zur_gesamtgrundschuldbefriedigung_anteilig_verpflichtet_vermutet_2168(t);
    }
    rule EntsprechendeAnwendungBeiFremdemGrundstueck(t: Testament) strict {
        label de official "Finden §§ 2166 Abs. 1, 2167 entsprechende Anwendung, wenn neben dem vermachten ein nicht erbschaftliches Grundstück belastet ist und der Erblasser zur Befriedigung verpflichtet war (§ 2168 Abs. 2)"; label en unofficial "§§ 2166 (1), 2167 apply mutatis mutandis where non-estate land is encumbered alongside the bequeathed land and the testator was obliged to satisfy the creditor (§ 2168 (2))";
        when nicht_erbschaftliches_grundstueck_mit_gesamtgrundschuld_neben_vermachtem_belastet_und_erblasser_verpflichtet_2168(t); then p2166_und_p2167_auf_2168_abs2_fall_entsprechend_anwendbar_2168(t);
    }
}
@source(BGB_P2168a)
rule SchiffeUndSchiffshypothekenSinngemaess(t: Testament) strict {
    label de official "§ 2165 Abs. 2, §§ 2166, 2167 gelten sinngemäß für eingetragene Schiffe, Schiffsbauwerke und Schiffshypotheken (§ 2168a)"; label en unofficial "§ 2165 (2), §§ 2166, 2167 apply correspondingly to registered vessels, vessels under construction and vessel mortgages (§ 2168a)";
    when vermaechtnis_betrifft_eingetragenes_schiff_oder_schiffsbauwerk_oder_schiffshypothek_2168a(t); then p2165_abs2_p2166_p2167_auf_schiffe_sinngemaess_anwendbar_2168a(t);
}

// --- Regeln §§ 2172–2191 ----------------------------------------------------

@source(BGB_P2172) {
    rule LeistungGiltAlsUnmoeglich(t: Testament) strict {
        label de official "Die Leistung einer vermachten Sache gilt auch dann als unmöglich, wenn sie mit anderer Sache verbunden, vermischt, vermengt, verarbeitet oder umgebildet worden ist (§ 2172 Abs. 1)"; label en unofficial "Performance is deemed impossible also where the thing has been combined, mixed, blended, processed or reshaped (§ 2172 (1))";
        when vermachte_sache_mit_anderer_verbunden_vermischt_vermengt_2172(t); then leistung_der_vermachten_sache_gilt_als_unmoeglich_2172(t);
    }
    presumption MiteigentumMitvermacht(t: Testament) {
        label de official "Hat der Erblasser durch die Verbindung Miteigentum erworben, gilt dieses im Zweifel als vermacht (§ 2172 Abs. 2 Satz 1)"; label en unofficial "Where the testator acquired co-ownership through the combination, it is deemed bequeathed in case of doubt (§ 2172 (2) sentence 1)";
        when verbindung_vermischung_vermengung_durch_anderen_als_erblasser_und_miteigentum_erworben_2172(t); presume miteigentum_gilt_als_vermacht_vermutet_2172(t);
    }
    presumption WegnahmerechtMitvermacht(t: Testament) {
        label de official "Steht dem Erblasser ein Wegnahmerecht zu, gilt dieses im Zweifel als vermacht (§ 2172 Abs. 2 Satz 1)"; label en unofficial "Where the testator holds a right of removal, it is deemed bequeathed in case of doubt (§ 2172 (2) sentence 1)";
        when erblasser_hat_wegnahmerecht_an_verbundener_sache_2172(t); presume wegnahmerecht_gilt_als_vermacht_vermutet_2172(t);
    }
}
@source(BGB_P2173) {
    presumption GeleisteterGegenstandZugewendet(t: Testament) {
        label de official "Erfolgt vor dem Erbfall die Leistung und ist der Gegenstand noch in der Erbschaft, gilt im Zweifel dieser als zugewendet (§ 2173 Satz 1)"; label en unofficial "Where performance occurred before devolution and the object is still in the estate, it is deemed granted in case of doubt (§ 2173 sentence 1)";
        when forderung_des_erblassers_vermacht_2173(t) and vor_erbfall_geleistet_und_gegenstand_noch_in_erbschaft_2173(t); presume geleisteter_gegenstand_gilt_als_zugewendet_vermutet_2173(t);
    }
    presumption GeldsummeVermacht(t: Testament) {
        label de official "War die Forderung auf Geldzahlung gerichtet, gilt im Zweifel die entsprechende Geldsumme als vermacht (§ 2173 Satz 2)"; label en unofficial "Where the claim was for payment of money, the corresponding sum is deemed bequeathed in case of doubt (§ 2173 sentence 2)";
        when forderung_des_erblassers_vermacht_2173(t) and forderung_auf_geldsumme_gerichtet_2173(t); presume entsprechende_geldsumme_gilt_als_vermacht_vermutet_2173(t);
    }
}
@source(BGB_P2174)
rule VermaechtnisBegruendetRecht(t: Testament, bedachter: Person) strict {
    label de official "Durch das Vermächtnis wird für den Bedachten das Recht begründet, vom Beschwerten die Leistung zu fordern (§ 2174)"; label en unofficial "The legacy establishes the beneficiary's right to demand performance from the burdened person (§ 2174)";
    when vermaechtnis_angeordnet_2174(t, bedachter); then vermaechtnisanspruch_begruendet_2174(t, bedachter);
}
@source(BGB_P2175)
rule WiederauflebenErloschenerRechtsverhaeltnisse(t: Testament) strict {
    label de official "Durch Vereinigung erloschene Rechtsverhältnisse gelten in Ansehung des Vermächtnisses als nicht erloschen (§ 2175)"; label en unofficial "Legal relationships extinguished by merger are deemed not extinguished as regards the legacy (§ 2175)";
    when forderung_oder_belastetes_recht_des_erblassers_gegen_erben_vermacht_2175(t); then durch_vereinigung_erloschenes_rechtsverhaeltnis_gilt_als_nicht_erloschen_2175(t);
}
@source(BGB_P2176)
rule AnfallMitErbfall(t: Testament, bedachter: Person) strict {
    label de official "Die Forderung des Vermächtnisnehmers entsteht mit dem Erbfall (§ 2176)"; label en unofficial "The legatee's claim arises with devolution (§ 2176)";
    when vermaechtnis_angeordnet_2174(t, bedachter); then vermaechtnisforderung_entsteht_mit_erbfall_2176(t, bedachter);
}
@source(BGB_P2177)
rule AnfallBeiBedingungOderBefristung(t: Testament) strict {
    label de official "Ist das Vermächtnis bedingt oder befristet und tritt Bedingung oder Termin erst nach dem Erbfall ein, erfolgt der Anfall mit deren Eintritt (§ 2177)"; label en unofficial "Where the legacy is conditional and the condition or term occurs only after devolution, devolution occurs with that occurrence (§ 2177)";
    when vermaechtnis_bedingt_oder_befristet_und_eintritt_nach_erbfall_2177(t); then vermaechtnisanfall_mit_bedingungs_oder_termineintritt_2177(t);
}
@source(BGB_P2178) {
    rule AnfallMitGeburt(t: Testament, bedachter: Person) strict {
        label de official "Ist der Bedachte beim Erbfall noch nicht gezeugt, erfolgt der Anfall mit der Geburt (§ 2178 Fall 1)"; label en unofficial "Where the beneficiary was not yet conceived at devolution, devolution occurs at birth (§ 2178 case 1)";
        when bedachter_beim_erbfall_noch_nicht_gezeugt_2178(t, bedachter); then vermaechtnisanfall_mit_geburt_2178(t, bedachter);
    }
    rule AnfallMitEreigniseintritt(t: Testament, bedachter: Person) strict {
        label de official "Wird die Persönlichkeit des Bedachten erst durch ein späteres Ereignis bestimmt, erfolgt der Anfall mit dessen Eintritt (§ 2178 Fall 2)"; label en unofficial "Where the beneficiary's identity is determined only by a later event, devolution occurs with its occurrence (§ 2178 case 2)";
        when bedachtenpersoenlichkeit_durch_spaeteres_ereignis_bestimmt_2178(t, bedachter); then vermaechtnisanfall_mit_ereigniseintritt_2178(t, bedachter);
    }
}
@source(BGB_P2179)
rule SchwebezeitVorschriftenAnwendbar(t: Testament) strict {
    label de official "Für die Schwebezeit finden die Vorschriften für aufschiebend bedingte Leistungen Anwendung (§ 2179)"; label en unofficial "The rules for a suspensively conditional performance apply during the pending period (§ 2179)";
    when schwebezeit_2177_oder_2178_2179(t); then vorschriften_fuer_aufschiebend_bedingte_leistung_in_schwebezeit_anwendbar_2179(t);
}
@source(BGB_P2180) {
    rule KeineAusschlagungNachAnnahme(t: Testament, bedachter: Person) strict {
        label de official "Der Vermächtnisnehmer kann das Vermächtnis nach der Annahme nicht mehr ausschlagen (§ 2180 Abs. 1)"; label en unofficial "The legatee can no longer disclaim after acceptance (§ 2180 (1))";
        when vermaechtnis_angenommen_2180(t, bedachter); then ausschlagung_nach_annahme_ausgeschlossen_2180(t, bedachter);
    }
    rule ErklaerungGegenueberBeschwertemNachErbfallUnbedingt(t: Testament, bedachter: Person) strict {
        label de official "Annahme und Ausschlagung erfolgen durch Erklärung gegenüber dem Beschwerten, erst nach dem Erbfall und ohne Bedingung oder Zeitbestimmung (§ 2180 Abs. 2)"; label en unofficial "Acceptance and disclaimer are declared to the burdened person, only after devolution and without condition or time clause (§ 2180 (2))";
        when annahme_oder_ausschlagung_gegenueber_beschwertem_erklaert_nach_erbfall_und_unbedingt_2180(t, bedachter); then annahme_oder_ausschlagung_wirksam_2180(t, bedachter);
    }
    rule ErbschaftsvorschriftenEntsprechendAnwendbar(t: Testament, bedachter: Person) strict {
        label de official "Die für Annahme und Ausschlagung einer Erbschaft geltenden §§ 1950, 1952 Abs. 1, 3, 1953 Abs. 1, 2 finden entsprechende Anwendung (§ 2180 Abs. 3)"; label en unofficial "§§ 1950, 1952 (1), (3), 1953 (1), (2) apply mutatis mutandis (§ 2180 (3))";
        when vermaechtnis_angeordnet_2174(t, bedachter); then p1950_p1952_abs1_3_p1953_abs1_2_auf_vermaechtnisannahme_entsprechend_anwendbar_2180(t);
    }
}
@source(BGB_P2181)
presumption FaelligkeitMitTodDesBeschwerten(t: Testament, beschwerter: Person) {
    label de official "Ist die Erfüllungszeit dem freien Belieben des Beschwerten überlassen, wird die Leistung im Zweifel mit dessen Tod fällig (§ 2181)"; label en unofficial "Where the time of performance is left to the burdened person's free discretion, performance falls due on their death in case of doubt (§ 2181)";
    when erfuellungszeit_dem_belieben_des_beschwerten_ueberlassen_2181(t, beschwerter); presume leistung_faellig_mit_tod_des_beschwerten_vermutet_2181(t, beschwerter);
}
@source(BGB_P2182) {
    rule VerkaeuferpflichtenBeiGattungsvermaechtnis(t: Testament) strict {
        label de official "Bei nur der Gattung nach bestimmtem Gegenstand hat der Beschwerte gleiche Pflichten wie ein Verkäufer und muss frei von Rechtsmängeln verschaffen (§ 2182 Abs. 1)"; label en unofficial "For an object determined only by kind, the burdened person has the same duties as a seller and must convey free of defects of title (§ 2182 (1))";
        when nur_der_gattung_nach_bestimmter_gegenstand_vermacht_2182(t); then beschwerter_hat_verkaeuferpflichten_gegen_rechtsmaengel_2182(t);
    }
    presumption DieselbenPflichtenBeiFremdemGegenstand(t: Testament) {
        label de official "Dasselbe gilt im Zweifel bei einem bestimmten, nicht zur Erbschaft gehörenden Gegenstand, unbeschadet des § 2170 (§ 2182 Abs. 2)"; label en unofficial "The same applies in case of doubt to a specific object not belonging to the estate, without prejudice to § 2170 (§ 2182 (2))";
        when bestimmter_nicht_zur_erbschaft_gehoerender_gegenstand_vermacht_2182(t); presume dieselben_verkaeuferpflichten_vermutet_2182(t);
    }
    presumption KeineHaftungFuerDienstbarkeiten(t: Testament) {
        label de official "Ist ein Grundstück Gegenstand, haftet der Beschwerte im Zweifel nicht für Freiheit von Dienstbarkeiten und Reallasten (§ 2182 Abs. 3)"; label en unofficial "Where land is the object, the burdened person is in case of doubt not liable for freedom from servitudes and land charges (§ 2182 (3))";
        when grundstueck_gegenstand_des_vermaechtnisses_2182(t); presume keine_haftung_fuer_dienstbarkeiten_und_reallasten_vermutet_2182(t);
    }
}
@source(BGB_P2183) {
    rule NacherfuellungBeiSachmangel(t: Testament) strict {
        label de official "Bei mangelhafter Gattungsleistung kann der Vermächtnisnehmer eine mangelfreie Sache verlangen (§ 2183 Satz 1)"; label en unofficial "For a defective generic performance, the legatee may demand a defect-free thing (§ 2183 sentence 1)";
        when nur_der_gattung_nach_bestimmte_sache_mangelhaft_geleistet_2183(t); then nacherfuellung_durch_mangelfreie_sache_verlangbar_2183(t);
    }
    rule SchadensersatzBeiArglist(t: Testament) strict {
        label de official "Hat der Beschwerte den Mangel arglistig verschwiegen, kann der Vermächtnisnehmer Schadensersatz statt der Leistung ohne Fristsetzung verlangen (§ 2183 Satz 2)"; label en unofficial "Where the burdened person fraudulently concealed the defect, the legatee may demand damages in lieu of performance without setting a period (§ 2183 sentence 2)";
        when nur_der_gattung_nach_bestimmte_sache_mangelhaft_geleistet_2183(t) and beschwerter_hat_sachmangel_arglistig_verschwiegen_2183(t); then schadensersatz_statt_leistung_ohne_fristsetzung_verlangbar_2183(t);
    }
}
@source(BGB_P2184) {
    rule HerausgabeDerFruechte(t: Testament) strict {
        label de official "Der Beschwerte hat dem Vermächtnisnehmer die seit dem Anfall gezogenen Früchte herauszugeben (§ 2184 Satz 1)"; label en unofficial "The burdened person must surrender the fruits drawn since devolution (§ 2184 sentence 1)";
        when bestimmter_zur_erbschaft_gehoerender_gegenstand_vermacht_2184(t); then herausgabe_der_seit_anfall_gezogenen_fruechte_geschuldet_2184(t);
    }
    rule KeinErsatzFuerSonstigeNutzungen(t: Testament) strict {
        label de official "Für Nutzungen, die nicht zu den Früchten gehören, hat der Beschwerte keinen Ersatz zu leisten (§ 2184 Satz 2)"; label en unofficial "The burdened person owes no compensation for uses that are not fruits (§ 2184 sentence 2)";
        when bestimmter_zur_erbschaft_gehoerender_gegenstand_vermacht_2184(t); then kein_ersatz_fuer_sonstige_nutzungen_2184(t);
    }
}
@source(BGB_P2185)
rule ErsatzVonVerwendungenUndAufwendungen(t: Testament) strict {
    label de official "Der Beschwerte kann für Verwendungen und Aufwendungen Ersatz nach Besitzer-Eigentümer-Vorschriften verlangen (§ 2185)"; label en unofficial "The burdened person may demand compensation for improvements and expenses under the possessor-owner rules (§ 2185)";
    when bestimmte_zur_erbschaft_gehoerende_sache_vermacht_und_verwendungen_gemacht_2185(t); then ersatz_nach_besitzer_eigentuemer_vorschriften_verlangbar_2185(t);
}
@source(BGB_P2186)
rule FaelligkeitDesUntervermaechtnisses(t: Testament, vermaechtnisnehmer: Person) strict {
    label de official "Der mit Vermächtnis oder Auflage beschwerte Vermächtnisnehmer ist zur Erfüllung erst verpflichtet, wenn er sein eigenes Vermächtnis verlangen kann (§ 2186)"; label en unofficial "A legatee burdened with a sub-legacy or charge must perform only once entitled to demand their own legacy (§ 2186)";
    when vermaechtnisnehmer_mit_untervermaechtnis_oder_auflage_beschwert_2186(t, vermaechtnisnehmer); then erfuellung_erst_bei_eigener_verlangbarkeit_verpflichtet_2186(t, vermaechtnisnehmer);
}
@source(BGB_P2187) {
    rule VerweigerungBeiUnzureichendemEigenenVermaechtnis(t: Testament, vermaechtnisnehmer: Person) strict {
        label de official "Reicht das eigene Vermächtnis zur Erfüllung der Beschwerung nicht aus, kann der Vermächtnisnehmer auch nach Annahme insoweit verweigern (§ 2187 Abs. 1)"; label en unofficial "Where the legatee's own legacy is insufficient to satisfy the burden, they may refuse performance even after acceptance to that extent (§ 2187 (1))";
        when vermaechtnisnehmer_mit_vermaechtnis_oder_auflage_beschwert_und_eigenes_reicht_nicht_2187(t, vermaechtnisnehmer); then erfuellung_auch_nach_annahme_insoweit_verweigerbar_2187(t, vermaechtnisnehmer);
    }
    rule NachfolgerhaftungBegrenzt(t: Testament, nachfolger: Person, vermaechtnisnehmer: Person) strict {
        label de official "Tritt nach § 2161 ein anderer an die Stelle, haftet er nicht weiter, als der Vermächtnisnehmer haften würde (§ 2187 Abs. 2)"; label en unofficial "Where under § 2161 another takes the place of the legatee, they are not liable beyond what the legatee would have been (§ 2187 (2))";
        when nach_2161_anderer_an_stelle_des_beschwerten_vermaechtnisnehmers_getreten_2187(t, nachfolger, vermaechtnisnehmer); then nachfolger_haftet_nicht_weiter_als_vermaechtnisnehmer_gehaftet_haette_2187(t, nachfolger);
    }
    rule ErbenhaftungsvorschriftEntsprechendAnwendbar(t: Testament, vermaechtnisnehmer: Person) strict {
        label de official "Die für die Erbenhaftung geltenden Vorschriften des § 1992 finden entsprechende Anwendung (§ 2187 Abs. 3)"; label en unofficial "§ 1992, governing the heir's liability, applies mutatis mutandis (§ 2187 (3))";
        when vermaechtnisnehmer_mit_vermaechtnis_oder_auflage_beschwert_und_eigenes_reicht_nicht_2187(t, vermaechtnisnehmer); then p1992_auf_vermaechtnisnehmerhaftung_entsprechend_anwendbar_2187(t);
    }
}
@source(BGB_P2188)
presumption VerhaeltnismaessigeKuerzungDerBeschwerungen(t: Testament, vermaechtnisnehmer: Person) {
    label de official "Wird die Leistung aufgrund Haftungsbeschränkung, Pflichtteilsanspruch oder § 2187 gekürzt, kann der Vermächtnisnehmer im Zweifel die eigenen Beschwerungen verhältnismäßig kürzen (§ 2188)"; label en unofficial "Where the performance is reduced owing to liability limitation, a compulsory-portion claim, or § 2187, the legatee may in case of doubt proportionately reduce their own charges (§ 2188)";
    when vermaechtnisleistung_wegen_haftungsbeschraenkung_pflichtteil_oder_2187_gekuerzt_2188(t, vermaechtnisnehmer); presume eigene_beschwerungen_verhaeltnismaessig_kuerzbar_vermutet_2188(t, vermaechtnisnehmer); unless anderer_wille_des_erblassers_bei_2188_anzunehmen(t, vermaechtnisnehmer);
}
@source(BGB_P2189)
rule VorrangsanordnungZulaessig(t: Testament) strict {
    label de official "Der Erblasser kann für den Kürzungsfall anordnen, dass ein Vermächtnis oder eine Auflage Vorrang vor den übrigen Beschwerungen haben soll (§ 2189)"; label en unofficial "The testator may order, for a reduction case, that a legacy or charge take priority over the other burdens (§ 2189)";
    when vorrang_fuer_kuerzungsfall_angeordnet_2189(t); then vorrangsanordnung_zulaessig_2189(t);
}
@source(BGB_P2190)
rule ErsatzvermaechtnisnehmerVorschriftenEntsprechend(t: Testament, ersatz: Person, zuerst: Person) strict {
    label de official "Für den Ersatzvermächtnisnehmer finden die für die Einsetzung eines Ersatzerben geltenden §§ 2097 bis 2099 entsprechende Anwendung (§ 2190)"; label en unofficial "§§ 2097 to 2099, governing appointment of a substitute heir, apply mutatis mutandis to a substitute legatee (§ 2190)";
    when ersatzvermaechtnisnehmer_fuer_nichterwerb_eingesetzt_2190(t, ersatz, zuerst); then p2097_bis_2099_auf_ersatzvermaechtnisnehmer_entsprechend_anwendbar_2190(t);
}
@source(BGB_P2191) {
    rule ErsterVermaechtnisnehmerGiltAlsBeschwert(t: Testament, erster: Person, dritter: Person) strict {
        label de official "Bei Zuwendung an einen Dritten ab späterem Zeitpunkt oder Ereignis gilt der erste Vermächtnisnehmer als beschwert (§ 2191 Abs. 1)"; label en unofficial "Where a grant to a third party takes effect from a later point or event, the first legatee is deemed burdened (§ 2191 (1))";
        when vermachter_gegenstand_ab_spaeterem_zeitpunkt_oder_ereignis_drittem_zugewendet_2191(t, erster, dritter); then erster_vermaechtnisnehmer_gilt_als_beschwert_2191(t, erster);
    }
    rule NacherbenvorschriftenEntsprechendAnwendbar(t: Testament, erster: Person, dritter: Person) strict {
        label de official "Auf das Nachvermächtnis finden § 2102, § 2106 Abs. 1, § 2107, § 2110 Abs. 1 entsprechende Anwendung (§ 2191 Abs. 2)"; label en unofficial "§ 2102, § 2106 (1), § 2107, § 2110 (1) apply mutatis mutandis to the follow-on legacy (§ 2191 (2))";
        when vermachter_gegenstand_ab_spaeterem_zeitpunkt_oder_ereignis_drittem_zugewendet_2191(t, erster, dritter); then p2102_p2106abs1_p2107_p2110abs1_auf_nachvermaechtnis_entsprechend_anwendbar_2191(t);
    }
}
