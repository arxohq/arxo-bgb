language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

pub relation position_trigger_2162(t: Person, p: Person, e: Person, tag: Date) kind empirical { label de official "Aufgeschobenes Vermächtnis nach § 2162"; label en unofficial "deferred legacy under § 2162"; }

@source(BGB_P2162)
rule PositionGrenze2162(t: Person, p: Person, e: Person, tag: Date) strict { label de official "Das aufgeschobene Vermächtnis wird nach dreißig Jahren unwirksam (§ 2162)"; label en unofficial "The deferred legacy becomes ineffective after thirty years (§ 2162)"; when position_trigger_2162(t, p, e, tag); then liberty Grenze2162 { holder p; action position_trigger_2162(t, p, e, tag); window [tag, infinity); }; }
