// BÜRGERLICHES GESETZBUCH, BUCH 5 ABSCHNITT 3 TITEL 4 — VERMÄCHTNIS
// (§§ 2157–2171, erste Rate). Fortsetzung von package.law §§ 2147–2156
// (Beschwerung, Wahl- und Gattungsvermächtnis); dieselbe Konvention: der
// Testament-Anchor `t: Testament` trägt das einzelne Vermächtnis, keine
// eigene Vermaechtnis-Entität (wie schon bei §§ 2147–2156).
//
// § 2157 verweist entsprechend auf §§ 2089–2093 (bereits in package.law für
// die Erbeinsetzung formalisiert); die Norm hier formalisiert NUR die
// Verweisung selbst, nicht die Wiederholung der Anwachsungslogik — dieselbe
// Konvention wie § 2093 (gemeinschaftlicher Erbteil) und § 2168a (Schiffe).
//
// § 2162 DREISSIGJÄHRIGE FRIST: anders als § 2109 (package.law, dort als
// bloße Eingabe `..._dreissig_jahre_ohne_eintritt_...`) wird hier über
// `add_calendar_period` und die Politik `BGB_VERFUEGUNGEN_JAHR` (§ 188
// Abs. 2, Jahresschritt, bereits für § 2325 Abs. 3 im Paket erklärt)
// tatsächlich gerechnet — das Kalenderfenster reicht bis 2028-01-01
// (KALENDER_BUNDESWEIT), ein Erbfall vor 1998 fällt daher außerhalb des
// belegbaren Fensters; das ist eine Dateneigenschaft des Kalenders, keine
// Norm-Grenze.

language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// --- Deklarationen §§ 2157–2163, 2169–2171 ---------------------------------

pub relation mehreren_derselbe_gegenstand_vermacht_2157(t: Testament) kind empirical {
    label de official "Derselbe Gegenstand ist mehreren vermacht (§ 2157)";
    label en unofficial "the same object is bequeathed to several persons (§ 2157)";
}
pub relation regeln_2089_bis_2093_auf_vermaechtnis_entsprechend_anwendbar_2157(t: Testament) kind derived {
    label de official "§§ 2089 bis 2093 finden auf das gemeinschaftliche Vermächtnis entsprechende Anwendung (§ 2157)";
    label en unofficial "§§ 2089 to 2093 apply mutatis mutandis to the joint legacy (§ 2157)";
}
pub relation mitbedachter_weggefallen_2158(t: Testament, p: Person) kind empirical {
    label de official "Einer der gemeinsam Bedachten fällt vor oder nach dem Erbfall weg (§ 2158 Abs. 1)";
    label en unofficial "one of the joint beneficiaries falls away before or after devolution (§ 2158 (1))";
}
pub relation uebriger_mitbedachter_anwachsungsberechtigt_2158(t: Testament, p: Person, weggefallen: Person) kind empirical {
    label de official "Der übrige Mitbedachte ist zur Anwachsung nach dem Verhältnis der Anteile berechtigt (§ 2158 Abs. 1 Satz 1)";
    label en unofficial "the remaining joint beneficiary is entitled to accretion in proportion to shares (§ 2158 (1) sentence 1)";
}
pub relation vermaechtnisanteil_wachst_an_2158(t: Testament, p: Person, weggefallen: Person) kind derived {
    label de official "Der Anteil des Weggefallenen wächst dem übrigen Bedachten an (§ 2158 Abs. 1)";
    label en unofficial "the share of the person who fell away accrues to the remaining beneficiary (§ 2158 (1))";
}
pub relation anwachsung_durch_erblasser_ausgeschlossen_2158(t: Testament) kind empirical {
    label de official "Der Erblasser hat die Anwachsung ausgeschlossen (§ 2158 Abs. 2)";
    label en unofficial "the testator excluded accretion (§ 2158 (2))";
}
pub relation anwachsung_ausgeschlossen_2158(t: Testament) kind derived {
    label de official "Die Anwachsung ist ausgeschlossen (§ 2158 Abs. 2)";
    label en unofficial "accretion is excluded (§ 2158 (2))";
}
pub relation angewachsener_anteil_besonderes_vermaechtnis_2159(t: Testament, p: Person) kind derived {
    label de official "Der angewachsene Anteil gilt als besonderes Vermächtnis (§ 2159)";
    label en unofficial "the accrued share counts as a separate legacy (§ 2159)";
}
pub relation vermaechtnisbedachter_2160(t: Testament, p: Person) kind empirical {
    label de official "Die Person ist mit einem Vermächtnis bedacht (§ 2160)";
    label en unofficial "the person is named as legacy beneficiary (§ 2160)";
}
pub relation bedachter_beim_erbfall_nicht_mehr_lebend_2160(t: Testament, p: Person) kind empirical {
    label de official "Der Bedachte lebt zur Zeit des Erbfalls nicht mehr (§ 2160)";
    label en unofficial "the beneficiary is no longer alive at devolution (§ 2160)";
}
pub relation vermaechtnis_unwirksam_wegen_vorversterbens_2160(t: Testament, p: Person) kind derived {
    label de official "Das Vermächtnis ist wegen Vorversterbens des Bedachten unwirksam (§ 2160)";
    label en unofficial "the legacy is ineffective because the beneficiary predeceased (§ 2160)";
}
pub relation zunaechst_beschwerter_wird_nicht_erbe_oder_vermaechtnisnehmer_2161(t: Testament, p: Person) kind empirical {
    label de official "Der zunächst Beschwerte wird nicht Erbe oder Vermächtnisnehmer (§ 2161 Satz 1)";
    label en unofficial "the initially burdened person does not become heir or legatee (§ 2161 sentence 1)";
}
pub relation vermaechtnis_bleibt_wirksam_vermutet_2161(t: Testament) kind derived {
    label de official "Das Vermächtnis bleibt im Zweifel wirksam (§ 2161 Satz 1)";
    label en unofficial "the legacy remains valid in case of doubt (§ 2161 sentence 1)";
}
pub relation anderer_wille_des_erblassers_anzunehmen_2161(t: Testament) kind empirical {
    label de official "Ein anderer Wille des Erblassers ist anzunehmen (§ 2161 Satz 1, Gegenausnahme)";
    label en unofficial "a different intention of the testator must be assumed (§ 2161 sentence 1, counter-exception)";
}
pub relation vermaechtnis_aufschiebend_bedingt_oder_befristet_2162(t: Testament, e: Erbfall) kind empirical {
    label de official "Das Vermächtnis ist unter aufschiebender Bedingung oder Bestimmung eines Anfangstermins angeordnet (§ 2162 Abs. 1)";
    label en unofficial "the legacy is ordered under a suspensive condition or an initial term (§ 2162 (1))";
}
pub relation dreissig_jahre_grenze_2162(t: Testament, tag: Date) kind derived {
    label de official "Kalendarische Grenze der dreißig Jahre seit dem Erbfall, § 188 Abs. 2 (§ 2162)";
    label en unofficial "calendar boundary of the thirty years since devolution, § 188 (2) (§ 2162)";
}
pub relation dreissig_jahre_ohne_bedingungseintritt_2162(t: Testament) kind empirical {
    label de official "Die dreißig Jahre sind verstrichen, ohne dass Bedingung oder Termin eingetreten sind (§ 2162 Abs. 1)";
    label en unofficial "the thirty years have elapsed without the condition or term occurring (§ 2162 (1))";
}
pub relation bedingung_oder_termin_vor_grenze_eingetreten_2162(t: Testament) kind empirical {
    label de official "Bedingung oder Termin sind vor Ablauf der dreißig Jahre eingetreten (§ 2162 Abs. 1, Gegenausnahme)";
    label en unofficial "the condition or term occurred before the thirty years elapsed (§ 2162 (1), counter-exception)";
}
pub relation aufgeschobenes_vermaechtnis_dreissig_jahre_unwirksam_2162(t: Testament, grenze: Date) kind derived {
    label de official "Das aufgeschobene Vermächtnis wird mit Ablauf von dreißig Jahren nach dem Erbfall unwirksam (§ 2162)";
    label en unofficial "the deferred legacy becomes ineffective on the lapse of thirty years after devolution (§ 2162)";
}
pub relation bedachter_beim_erbfall_noch_nicht_gezeugt_oder_ereignisabhaengig_2162(t: Testament, e: Erbfall) kind empirical {
    label de official "Der Bedachte ist beim Erbfall noch nicht gezeugt oder seine Persönlichkeit wird erst durch ein späteres Ereignis bestimmt (§ 2162 Abs. 2)";
    label en unofficial "the beneficiary was not yet conceived at devolution or their identity depends on a later event (§ 2162 (2))";
}
pub relation dreissig_jahre_ohne_zeugung_oder_ereignis_2162(t: Testament) kind empirical {
    label de official "Die dreißig Jahre sind verstrichen, ohne dass Zeugung oder das bestimmende Ereignis eingetreten sind (§ 2162 Abs. 2)";
    label en unofficial "the thirty years have elapsed without conception or the determining event occurring (§ 2162 (2))";
}
pub relation zeugung_oder_ereignis_vor_grenze_eingetreten_2162(t: Testament) kind empirical {
    label de official "Zeugung oder das bestimmende Ereignis sind vor Ablauf der dreißig Jahre eingetreten (§ 2162 Abs. 2, Gegenausnahme)";
    label en unofficial "conception or the determining event occurred before the thirty years elapsed (§ 2162 (2), counter-exception)";
}
pub relation vermaechtnis_fuer_ereignis_in_person_angeordnet_2163(t: Testament) kind empirical {
    label de official "Das Vermächtnis ist für ein Ereignis in der Person des Beschwerten oder des Bedachten angeordnet (§ 2163 Abs. 1 Nr. 1, Abs. 2)";
    label en unofficial "the legacy is ordered for an event in the person of the burdened party or the beneficiary (§ 2163 (1) no. 1, (2))";
}
pub relation person_beim_erbfall_lebend_2163(t: Testament) kind empirical {
    label de official "Die Person, in deren Person das Ereignis eintreten soll, lebt zur Zeit des Erbfalls (§ 2163 Abs. 1 Nr. 1)";
    label en unofficial "the person in whom the event must occur is alive at devolution (§ 2163 (1) no. 1)";
}
pub relation ausnahme_von_dreissig_jahre_frist_2163(t: Testament) kind derived {
    label de official "Das Vermächtnis bleibt trotz Ablaufs der dreißig Jahre wirksam (§ 2163 Abs. 1)";
    label en unofficial "the legacy remains valid despite the thirty-year lapse (§ 2163 (1))";
}
pub relation erbe_nacherbe_oder_vermaechtnisnehmer_bei_geschwistergeburt_beschwert_2163(t: Testament) kind empirical {
    label de official "Ein Erbe, Nacherbe oder Vermächtnisnehmer ist für den Fall der Geburt eines Bruders oder einer Schwester mit einem Vermächtnis beschwert (§ 2163 Abs. 1 Nr. 2)";
    label en unofficial "an heir, subsequent heir or legatee is burdened with a legacy for the birth of a sibling (§ 2163 (1) no. 2)";
}
pub relation person_ist_juristische_person_2163(t: Testament) kind empirical {
    label de official "Der Beschwerte oder der Bedachte, in dessen Person das Ereignis eintreten soll, ist eine juristische Person (§ 2163 Abs. 2)";
    label en unofficial "the burdened party or the beneficiary in whose person the event must occur is a legal person (§ 2163 (2))";
}
pub relation keine_ausnahme_von_dreissig_jahre_frist_2163(t: Testament) kind derived {
    label de official "Es bleibt bei der dreißigjährigen Frist ohne Ausnahme (§ 2163 Abs. 2)";
    label en unofficial "the thirty-year limit applies without exception (§ 2163 (2))";
}
pub relation vermachter_gegenstand_gehoert_beim_erbfall_nicht_zur_erbschaft_2169(t: Testament) kind empirical {
    label de official "Der vermachte bestimmte Gegenstand gehört zur Zeit des Erbfalls nicht zur Erbschaft (§ 2169 Abs. 1)";
    label en unofficial "the specific bequeathed object does not belong to the estate at devolution (§ 2169 (1))";
}
pub relation gegenstand_auch_fuer_diesen_fall_zugewendet_2169(t: Testament) kind empirical {
    label de official "Der Gegenstand ist dem Bedachten auch für den Fall zugewendet, dass er nicht zur Erbschaft gehört (§ 2169 Abs. 1, Gegenausnahme)";
    label en unofficial "the object is granted to the beneficiary even for the case that it does not belong to the estate (§ 2169 (1), counter-exception)";
}
pub relation vermaechtnis_fremden_gegenstands_unwirksam_2169(t: Testament) kind derived {
    label de official "Das Vermächtnis des fremden Gegenstands ist unwirksam (§ 2169 Abs. 1)";
    label en unofficial "the legacy of the object belonging to another is ineffective (§ 2169 (1))";
}
pub relation erblasser_hat_nur_besitz_der_vermachten_sache_2169(t: Testament) kind empirical {
    label de official "Der Erblasser hat nur den Besitz der vermachten Sache (§ 2169 Abs. 2)";
    label en unofficial "the testator only possessed the bequeathed thing (§ 2169 (2))";
}
pub relation besitz_gilt_als_vermacht_vermutet_2169(t: Testament) kind derived {
    label de official "Der Besitz gilt im Zweifel als vermacht (§ 2169 Abs. 2)";
    label en unofficial "the possession is deemed bequeathed in case of doubt (§ 2169 (2))";
}
pub relation besitz_gewaehrt_bedachtem_keinen_rechtlichen_vorteil_2169(t: Testament) kind empirical {
    label de official "Der Besitz gewährt dem Bedachten keinen rechtlichen Vorteil (§ 2169 Abs. 2, Gegenausnahme)";
    label en unofficial "the possession grants the beneficiary no legal advantage (§ 2169 (2), counter-exception)";
}
pub relation erblasser_hat_anspruch_auf_leistung_oder_ersatz_des_gegenstands_2169(t: Testament) kind empirical {
    label de official "Dem Erblasser steht ein Anspruch auf Leistung des Gegenstands oder auf Ersatz seines Wertes zu (§ 2169 Abs. 3)";
    label en unofficial "the testator holds a claim to performance of the object or to compensation for its value (§ 2169 (3))";
}
pub relation anspruch_gilt_als_vermacht_vermutet_2169(t: Testament) kind derived {
    label de official "Der Anspruch gilt im Zweifel als vermacht (§ 2169 Abs. 3)";
    label en unofficial "the claim is deemed bequeathed in case of doubt (§ 2169 (3))";
}
pub relation vermaechtnis_fremden_gegenstands_wirksam_nach_2169_abs1_2170(t: Testament, beschwerter: Person) kind empirical {
    label de official "Das Vermächtnis des fremden Gegenstands ist nach § 2169 Abs. 1 wirksam (§ 2170 Abs. 1)";
    label en unofficial "the legacy of the object belonging to another is effective under § 2169 (1) (§ 2170 (1))";
}
pub relation beschwerter_muss_gegenstand_verschaffen_2170(t: Testament, beschwerter: Person) kind derived {
    label de official "Der Beschwerte hat den Gegenstand dem Bedachten zu verschaffen (§ 2170 Abs. 1)";
    label en unofficial "the burdened person must procure the object for the beneficiary (§ 2170 (1))";
}
pub relation beschwerter_zur_verschaffung_ausserstande_oder_unverhaeltnismaessig_2170(t: Testament, beschwerter: Person) kind empirical {
    label de official "Der Beschwerte ist zur Verschaffung außerstande, oder sie ist nur mit unverhältnismäßigen Aufwendungen möglich (§ 2170 Abs. 2)";
    label en unofficial "the burdened person is unable to procure the object, or procurement is possible only with disproportionate expense (§ 2170 (2))";
}
pub relation beschwerter_kann_durch_wertentrichtung_befreien_2170(t: Testament, beschwerter: Person) kind derived {
    label de official "Der Beschwerte kann sich durch Entrichtung des Wertes befreien (§ 2170 Abs. 2)";
    label en unofficial "the burdened person may discharge the duty by paying its value (§ 2170 (2))";
}
pub relation vermaechtnis_fuer_jedermann_unmoeglich_oder_gesetzeswidrig_2171(t: Testament) kind empirical {
    label de official "Das Vermächtnis ist auf eine bei Erbfall für jedermann unmögliche Leistung gerichtet oder verstößt gegen ein damals bestehendes gesetzliches Verbot (§ 2171 Abs. 1)";
    label en unofficial "the legacy is directed at a performance impossible for everyone at devolution, or violates a legal prohibition then in force (§ 2171 (1))";
}
pub relation vermaechtnis_unmoeglichkeit_oder_verbot_unwirksam_2171(t: Testament) kind derived {
    label de official "Das Vermächtnis ist wegen Unmöglichkeit oder Verbots unwirksam (§ 2171 Abs. 1)";
    label en unofficial "the legacy is ineffective for impossibility or prohibition (§ 2171 (1))";
}
pub relation unmoeglichkeit_behebbar_und_fuer_moeglichwerden_zugewendet_2171(t: Testament) kind empirical {
    label de official "Die Unmöglichkeit kann behoben werden, und das Vermächtnis ist für den Fall zugewendet, dass die Leistung möglich wird (§ 2171 Abs. 2)";
    label en unofficial "the impossibility can be remedied, and the legacy is granted for the case that performance becomes possible (§ 2171 (2))";
}
pub relation vermaechtnis_trotz_unmoeglichkeit_gueltig_2171(t: Testament) kind derived {
    label de official "Das Vermächtnis ist trotz der Unmöglichkeit gültig (§ 2171 Abs. 2)";
    label en unofficial "the legacy is valid despite the impossibility (§ 2171 (2))";
}
pub relation unmoegliches_vermaechtnis_unter_anderer_bedingung_zugewendet_2171(t: Testament) kind empirical {
    label de official "Ein auf unmögliche Leistung gerichtetes Vermächtnis ist unter einer anderen aufschiebenden Bedingung oder Befristung zugewendet (§ 2171 Abs. 3)";
    label en unofficial "a legacy directed at impossible performance is granted under another suspensive condition or term (§ 2171 (3))";
}
pub relation unmoeglichkeit_vor_bedingungseintritt_behoben_2171(t: Testament) kind empirical {
    label de official "Die Unmöglichkeit ist vor dem Eintritt der Bedingung oder des Termins behoben (§ 2171 Abs. 3)";
    label en unofficial "the impossibility is remedied before the condition or term occurs (§ 2171 (3))";
}
pub relation vermaechtnis_gueltig_bei_vorheriger_behebung_2171(t: Testament) kind derived {
    label de official "Das Vermächtnis ist gültig, weil die Unmöglichkeit vorher behoben wurde (§ 2171 Abs. 3)";
    label en unofficial "the legacy is valid because the impossibility was remedied beforehand (§ 2171 (3))";
}

// --- Deklarationen §§ 2192–2196 (Auflage) ----------------------------------

pub relation auflage_angeordnet_2192(t: Testament) kind empirical {
    label de official "Der Erblasser hat eine Auflage angeordnet (§ 2192)";
    label en unofficial "the testator ordered a charge (§ 2192)";
}
pub relation regeln_2065_2147_2148_2154_bis_2156_2161_2171_2181_auf_auflage_entsprechend_anwendbar_2192(t: Testament) kind derived {
    label de official "Auf die Auflage finden die §§ 2065, 2147, 2148, 2154 bis 2156, 2161, 2171, 2181 entsprechende Anwendung (§ 2192)";
    label en unofficial "§§ 2065, 2147, 2148, 2154 to 2156, 2161, 2171, 2181 apply mutatis mutandis to the charge (§ 2192)";
}
pub relation auflage_zweck_bestimmt_beguenstigtenbestimmung_ueberlassen_2193(t: Testament) kind empirical {
    label de official "Der Erblasser hat bei einer Auflage mit bestimmtem Zweck die Bestimmung des Begünstigten dem Beschwerten oder einem Dritten überlassen (§ 2193 Abs. 1)";
    label en unofficial "the testator left determination of the beneficiary to the burdened person or a third party for a charge with a specified purpose (§ 2193 (1))";
}
pub relation beguenstigtenbestimmung_zulaessig_2193(t: Testament) kind derived {
    label de official "Die Bestimmung des Begünstigten durch den Beschwerten oder Dritten ist zulässig (§ 2193 Abs. 1)";
    label en unofficial "determination of the beneficiary by the burdened person or third party is permitted (§ 2193 (1))";
}
pub relation beschwerter_zur_vollziehung_rechtskraeftig_verurteilt_2193(t: Testament, beschwerter: Person) kind empirical {
    label de official "Der Beschwerte ist zur Vollziehung der Auflage rechtskräftig verurteilt (§ 2193 Abs. 2)";
    label en unofficial "the burdened person is finally adjudged to perform the charge (§ 2193 (2))";
}
pub relation frist_zur_vollziehung_abgelaufen_ohne_erfuellung_2193(t: Testament, beschwerter: Person) kind empirical {
    label de official "Die vom Kläger gesetzte Frist zur Vollziehung ist abgelaufen, ohne dass rechtzeitig vollzogen wurde (§ 2193 Abs. 2)";
    label en unofficial "the period for performance set by the claimant has lapsed without timely performance (§ 2193 (2))";
}
pub relation klaeger_darf_bestimmung_treffen_2193(t: Testament, beschwerter: Person) kind derived {
    label de official "Der Kläger ist berechtigt, die Bestimmung zu treffen (§ 2193 Abs. 2)";
    label en unofficial "the claimant is entitled to make the determination (§ 2193 (2))";
}
pub relation vollziehung_kann_verlangt_werden_von_2194(t: Testament, berechtigter: Person) kind empirical {
    label de official "Erbe, Miterbe oder derjenige, dem der Wegfall des zunächst Beschwerten unmittelbar zustatten käme, verlangt die Vollziehung (§ 2194 Satz 1)";
    label en unofficial "the heir, co-heir, or the person who would directly benefit from the burdened person's falling away, demands performance (§ 2194 sentence 1)";
}
pub relation vollziehung_verlangbar_2194(t: Testament, berechtigter: Person) kind derived {
    label de official "Die Vollziehung der Auflage ist verlangbar (§ 2194 Satz 1)";
    label en unofficial "performance of the charge may be demanded (§ 2194 sentence 1)";
}
pub relation vollziehung_im_oeffentlichen_interesse_2194(t: Testament) kind empirical {
    label de official "Die Vollziehung der Auflage liegt im öffentlichen Interesse (§ 2194 Satz 2)";
    label en unofficial "performance of the charge is in the public interest (§ 2194 sentence 2)";
}
pub relation zustaendige_behoerde_kann_vollziehung_verlangen_2194(t: Testament) kind derived {
    label de official "Auch die zuständige Behörde kann die Vollziehung verlangen (§ 2194 Satz 2)";
    label en unofficial "the competent authority may also demand performance (§ 2194 sentence 2)";
}
pub relation auflage_unwirksam_2195(t: Testament) kind empirical {
    label de official "Die Auflage ist unwirksam (§ 2195)";
    label en unofficial "the charge is ineffective (§ 2195)";
}
pub relation zuwendung_ohne_auflage_nicht_gemacht_worden_waere_2195(t: Testament) kind empirical {
    label de official "Es ist anzunehmen, dass der Erblasser die Zuwendung ohne die Auflage nicht gemacht haben würde (§ 2195)";
    label en unofficial "it must be assumed that the testator would not have made the grant without the charge (§ 2195)";
}
pub relation zuwendung_unter_auflage_ebenfalls_unwirksam_2195(t: Testament) kind derived {
    label de official "Die unter der Auflage gemachte Zuwendung ist ebenfalls unwirksam (§ 2195)";
    label en unofficial "the grant made subject to the charge is likewise ineffective (§ 2195)";
}
pub relation vollziehung_unmoeglich_durch_beschwerten_zu_vertreten_2196(t: Testament, beschwerter: Person) kind empirical {
    label de official "Die Vollziehung der Auflage wird infolge eines vom Beschwerten zu vertretenden Umstands unmöglich (§ 2196 Abs. 1)";
    label en unofficial "performance of the charge becomes impossible owing to a circumstance for which the burdened person is responsible (§ 2196 (1))";
}
pub relation herausgabe_der_zuwendung_nach_bereicherungsrecht_forderbar_2196(t: Testament, berechtigter: Person) kind derived {
    label de official "Der Anwachsungsberechtigte kann die Herausgabe der Zuwendung nach den Vorschriften über ungerechtfertigte Bereicherung fordern, soweit sie zur Vollziehung hätte verwendet werden müssen (§ 2196 Abs. 1)";
    label en unofficial "the person who would benefit from the falling away may demand return of the grant under unjust-enrichment rules, to the extent it should have been used for performance (§ 2196 (1))";
}
pub relation beschwerter_zur_unvertretbaren_vollziehung_verurteilt_und_zwangsmittel_erfolglos_2196(t: Testament, beschwerter: Person) kind empirical {
    label de official "Der Beschwerte ist zur Vollziehung einer nicht durch Dritte vollziehbaren Auflage rechtskräftig verurteilt, und die zulässigen Zwangsmittel blieben erfolglos (§ 2196 Abs. 2)";
    label en unofficial "the burdened person is finally adjudged to perform a charge not performable by a third party, and permitted coercive measures have failed (§ 2196 (2))";
}

@source(BGB_P2192)
rule AuflageVerweistAufVermaechtnisVorschriften(t: Testament) strict {
    label de official "Auf eine Auflage finden die §§ 2065, 2147, 2148, 2154 bis 2156, 2161, 2171, 2181 entsprechende Anwendung (§ 2192)"; label en unofficial "§§ 2065, 2147, 2148, 2154 to 2156, 2161, 2171, 2181 apply mutatis mutandis to a charge (§ 2192)";
    when auflage_angeordnet_2192(t); then regeln_2065_2147_2148_2154_bis_2156_2161_2171_2181_auf_auflage_entsprechend_anwendbar_2192(t);
}
@source(BGB_P2193) {
    rule BestimmungDesBeguenstigtenZulaessig(t: Testament) strict {
        label de official "Der Erblasser kann die Bestimmung des Begünstigten dem Beschwerten oder einem Dritten überlassen (§ 2193 Abs. 1)"; label en unofficial "The testator may leave determination of the beneficiary to the burdened person or a third party (§ 2193 (1))";
        when auflage_zweck_bestimmt_beguenstigtenbestimmung_ueberlassen_2193(t); then beguenstigtenbestimmung_zulaessig_2193(t);
    }
    rule KlaegerDarfNachFristablaufBestimmen(t: Testament, beschwerter: Person) strict {
        label de official "Nach Ablauf der dem verurteilten Beschwerten gesetzten Frist ist der Kläger berechtigt, die Bestimmung zu treffen, wenn nicht rechtzeitig vollzogen wurde (§ 2193 Abs. 2)"; label en unofficial "After the period set for the adjudged burdened person lapses without timely performance, the claimant is entitled to make the determination (§ 2193 (2))";
        when beschwerter_zur_vollziehung_rechtskraeftig_verurteilt_2193(t, beschwerter) and frist_zur_vollziehung_abgelaufen_ohne_erfuellung_2193(t, beschwerter); then klaeger_darf_bestimmung_treffen_2193(t, beschwerter);
    }
}
@source(BGB_P2194) {
    rule ErbeMiterbeOderNachrueckerVerlangenVollziehung(t: Testament, berechtigter: Person) strict {
        label de official "Die Vollziehung einer Auflage können der Erbe, der Miterbe und derjenige verlangen, welchem der Wegfall des Beschwerten unmittelbar zustatten käme (§ 2194 Satz 1)"; label en unofficial "Performance of a charge may be demanded by the heir, the co-heir, and the person who would directly benefit from the burdened person's falling away (§ 2194 sentence 1)";
        when vollziehung_kann_verlangt_werden_von_2194(t, berechtigter); then vollziehung_verlangbar_2194(t, berechtigter);
    }
    rule BehoerdeVerlangtVollziehungBeiOeffentlichemInteresse(t: Testament) strict {
        label de official "Liegt die Vollziehung im öffentlichen Interesse, kann auch die zuständige Behörde die Vollziehung verlangen (§ 2194 Satz 2)"; label en unofficial "Where performance is in the public interest, the competent authority may also demand performance (§ 2194 sentence 2)";
        when vollziehung_im_oeffentlichen_interesse_2194(t); then zustaendige_behoerde_kann_vollziehung_verlangen_2194(t);
    }
}
@source(BGB_P2195)
rule UnwirksamkeitDerAuflageErstrecktSichAufZuwendung(t: Testament) strict {
    label de official "Die Unwirksamkeit der Auflage hat die Unwirksamkeit der unter ihr gemachten Zuwendung nur zur Folge, wenn anzunehmen ist, dass der Erblasser die Zuwendung ohne die Auflage nicht gemacht haben würde (§ 2195)"; label en unofficial "Ineffectiveness of the charge renders the grant made under it ineffective only if it must be assumed the testator would not have made the grant without the charge (§ 2195)";
    when auflage_unwirksam_2195(t) and zuwendung_ohne_auflage_nicht_gemacht_worden_waere_2195(t); then zuwendung_unter_auflage_ebenfalls_unwirksam_2195(t);
}
@source(BGB_P2196) {
    rule HerausgabeNachBereicherungsrechtBeiVerantworteterUnmoeglichkeit(t: Testament, beschwerter: Person, berechtigter: Person) strict {
        label de official "Wird die Vollziehung infolge eines vom Beschwerten zu vertretenden Umstands unmöglich, kann der Anwachsungsberechtigte die Herausgabe der Zuwendung nach Bereicherungsrecht fordern, soweit sie zur Vollziehung hätte verwendet werden müssen (§ 2196 Abs. 1)"; label en unofficial "Where performance becomes impossible for a reason attributable to the burdened person, the person who would benefit from the falling away may demand return under unjust-enrichment rules, to the extent it should have served performance (§ 2196 (1))";
        when vollziehung_unmoeglich_durch_beschwerten_zu_vertreten_2196(t, beschwerter) and vollziehung_kann_verlangt_werden_von_2194(t, berechtigter); then herausgabe_der_zuwendung_nach_bereicherungsrecht_forderbar_2196(t, berechtigter);
    }
    rule HerausgabeBeiErfolglosenZwangsmitteln(t: Testament, beschwerter: Person, berechtigter: Person) strict {
        label de official "Dasselbe gilt, wenn der Beschwerte zur Vollziehung einer nicht durch Dritte vollziehbaren Auflage rechtskräftig verurteilt ist und die zulässigen Zwangsmittel erfolglos angewendet wurden (§ 2196 Abs. 2)"; label en unofficial "The same applies where the burdened person is finally adjudged to perform a charge not performable by a third party, and the permitted coercive measures were applied without success (§ 2196 (2))";
        when beschwerter_zur_unvertretbaren_vollziehung_verurteilt_und_zwangsmittel_erfolglos_2196(t, beschwerter) and vollziehung_kann_verlangt_werden_von_2194(t, berechtigter); then herausgabe_der_zuwendung_nach_bereicherungsrecht_forderbar_2196(t, berechtigter);
    }
}

@source(BGB_P2157)
rule GemeinschaftlichesVermaechtnisAnwachsungEntsprechend(t: Testament) strict {
    label de official "Ist mehreren derselbe Gegenstand vermacht, finden die Vorschriften der §§ 2089 bis 2093 entsprechende Anwendung (§ 2157)"; label en unofficial "Where the same object is bequeathed to several persons, §§ 2089 to 2093 apply mutatis mutandis (§ 2157)";
    when mehreren_derselbe_gegenstand_vermacht_2157(t); then regeln_2089_bis_2093_auf_vermaechtnis_entsprechend_anwendbar_2157(t);
}

@source(BGB_P2158) {
    rule AnwachsungUnterMitbedachten(t: Testament, weggefallen: Person, bedachter: Person) strict {
        label de official "Fällt einer von mehreren derselbe Gegenstand vermachten Bedachten vor oder nach dem Erbfall weg, wächst sein Anteil den übrigen Bedachten nach dem Verhältnis ihrer Anteile an (§ 2158 Abs. 1 Satz 1, 2)"; label en unofficial "Where one of several beneficiaries of the same legacy falls away before or after devolution, their share accrues to the remaining beneficiaries in proportion to their shares (§ 2158 (1) sentences 1, 2)";
        when mehreren_derselbe_gegenstand_vermacht_2157(t) and mitbedachter_weggefallen_2158(t, weggefallen) and uebriger_mitbedachter_anwachsungsberechtigt_2158(t, bedachter, weggefallen);
        then vermaechtnisanteil_wachst_an_2158(t, bedachter, weggefallen);
    }
    rule ErblasserKannAnwachsungAusschliessen(t: Testament) strict {
        label de official "Der Erblasser kann die Anwachsung ausschließen (§ 2158 Abs. 2)"; label en unofficial "The testator may exclude accretion (§ 2158 (2))";
        when anwachsung_durch_erblasser_ausgeschlossen_2158(t); then anwachsung_ausgeschlossen_2158(t);
    }
}

@source(BGB_P2159)
rule AngewachsenerAnteilBesonderesVermaechtnis(t: Testament, bedachter: Person, weggefallen: Person) strict {
    label de official "Der durch Anwachsung anfallende Anteil gilt hinsichtlich der Vermächtnisse und Auflagen, mit denen der Bedachte oder der Weggefallene beschwert ist, als besonderes Vermächtnis (§ 2159)"; label en unofficial "A share accrued by accretion counts, for legacies and charges burdening the beneficiary or the person who fell away, as a separate legacy (§ 2159)";
    when vermaechtnisanteil_wachst_an_2158(t, bedachter, weggefallen); then angewachsener_anteil_besonderes_vermaechtnis_2159(t, bedachter);
}

@source(BGB_P2160)
rule VermaechtnisUnwirksamBeiVorversterben(t: Testament, bedachter: Person) strict {
    label de official "Ein Vermächtnis ist unwirksam, wenn der Bedachte zur Zeit des Erbfalls nicht mehr lebt (§ 2160)"; label en unofficial "A legacy is ineffective if the beneficiary is no longer alive at devolution (§ 2160)";
    when vermaechtnisbedachter_2160(t, bedachter) and bedachter_beim_erbfall_nicht_mehr_lebend_2160(t, bedachter);
    then vermaechtnis_unwirksam_wegen_vorversterbens_2160(t, bedachter);
}

@source(BGB_P2161)
presumption VermaechtnisBleibtWirksamBeiWegfallDesBeschwerten(t: Testament, beschwerter: Person) {
    label de official "Ein Vermächtnis bleibt im Zweifel wirksam, wenn der Beschwerte nicht Erbe oder Vermächtnisnehmer wird (§ 2161 Satz 1)"; label en unofficial "A legacy remains valid in case of doubt if the burdened person does not become heir or legatee (§ 2161 sentence 1)";
    when zunaechst_beschwerter_wird_nicht_erbe_oder_vermaechtnisnehmer_2161(t, beschwerter);
    presume vermaechtnis_bleibt_wirksam_vermutet_2161(t);
    unless anderer_wille_des_erblassers_anzunehmen_2161(t);
}

@source(BGB_P2162) {
    rule DreissigJahreGrenzeAbErbfall(t: Testament, e: Erbfall, erbfall_am: Date) strict {
        label de official "Kalendarische Grenze der dreißig Jahre seit dem Erbfall (§ 2162 Abs. 1, 2, § 188 Abs. 2)"; label en unofficial "calendar boundary of the thirty years since devolution (§ 2162 (1), (2), § 188 (2))";
        when vermaechtnis_aufschiebend_bedingt_oder_befristet_2162(t, e) and de.bgb.erbfolge::erbfall_am(e, erbfall_am);
        then dreissig_jahre_grenze_2162(t, add_calendar_period(erbfall_am, 30 calendar_year));
    }
    rule AufgeschobenesVermaechtnisDreissigJahreBedingung(t: Testament, e: Erbfall, grenze: Date) strict {
        label de official "Ein unter aufschiebender Bedingung oder Anfangstermin angeordnetes Vermächtnis wird mit Ablauf von 30 Jahren nach dem Erbfall unwirksam, wenn die Bedingung oder der Termin vorher nicht eingetreten ist (§ 2162 Abs. 1)"; label en unofficial "A legacy ordered under a suspensive condition or initial term becomes ineffective on the lapse of 30 years after devolution unless the condition or term occurred before then (§ 2162 (1))";
        when vermaechtnis_aufschiebend_bedingt_oder_befristet_2162(t, e) and dreissig_jahre_grenze_2162(t, grenze) and dreissig_jahre_ohne_bedingungseintritt_2162(t) and not_known(bedingung_oder_termin_vor_grenze_eingetreten_2162(t));
        then aufgeschobenes_vermaechtnis_dreissig_jahre_unwirksam_2162(t, grenze);
    }
    rule NochNichtGezeugterBedachterDreissigJahre(t: Testament, e: Erbfall, grenze: Date) strict {
        label de official "Ist der Bedachte beim Erbfall noch nicht gezeugt oder wird seine Persönlichkeit erst durch ein späteres Ereignis bestimmt, wird das Vermächtnis mit Ablauf von 30 Jahren nach dem Erbfall unwirksam, wenn Zeugung oder Ereignis vorher nicht eingetreten sind (§ 2162 Abs. 2)"; label en unofficial "Where the beneficiary was not yet conceived at devolution or their identity depends on a later event, the legacy becomes ineffective on the lapse of 30 years unless conception or the event occurred before then (§ 2162 (2))";
        when bedachter_beim_erbfall_noch_nicht_gezeugt_oder_ereignisabhaengig_2162(t, e) and dreissig_jahre_grenze_2162(t, grenze) and dreissig_jahre_ohne_zeugung_oder_ereignis_2162(t) and not_known(zeugung_oder_ereignis_vor_grenze_eingetreten_2162(t));
        then aufgeschobenes_vermaechtnis_dreissig_jahre_unwirksam_2162(t, grenze);
    }
}

@source(BGB_P2163) {
    rule AusnahmeEreignisInPersonDesLebendenBeimErbfall(t: Testament) strict {
        label de official "Das Vermächtnis bleibt trotz Ablaufs der 30 Jahre wirksam, wenn es für ein Ereignis in der Person des Beschwerten oder des Bedachten angeordnet ist und diese Person beim Erbfall lebt (§ 2163 Abs. 1 Nr. 1)"; label en unofficial "The legacy remains valid despite the 30-year lapse where it is ordered for an event in the person of the burdened party or the beneficiary and that person is alive at devolution (§ 2163 (1) no. 1)";
        when vermaechtnis_fuer_ereignis_in_person_angeordnet_2163(t) and person_beim_erbfall_lebend_2163(t);
        then ausnahme_von_dreissig_jahre_frist_2163(t);
    }
    rule AusnahmeGeschwisterVermaechtnis(t: Testament) strict {
        label de official "Das Vermächtnis bleibt trotz Ablaufs der 30 Jahre wirksam, wenn ein Erbe, Nacherbe oder Vermächtnisnehmer für den Fall der Geburt eines Bruders oder einer Schwester mit einem Vermächtnis zu dessen Gunsten beschwert ist (§ 2163 Abs. 1 Nr. 2)"; label en unofficial "The legacy remains valid despite the 30-year lapse where an heir, subsequent heir or legatee is burdened with a legacy in favour of a sibling to be born (§ 2163 (1) no. 2)";
        when erbe_nacherbe_oder_vermaechtnisnehmer_bei_geschwistergeburt_beschwert_2163(t);
        then ausnahme_von_dreissig_jahre_frist_2163(t);
    }
    rule KeineAusnahmeBeiJuristischerPerson(t: Testament) strict {
        label de official "Ist der Beschwerte oder der Bedachte, in dessen Person das Ereignis eintreten soll, eine juristische Person, bleibt es bei der dreißigjährigen Frist (§ 2163 Abs. 2)"; label en unofficial "Where the burdened party or the beneficiary in whose person the event must occur is a legal person, the thirty-year limit applies without exception (§ 2163 (2))";
        when person_ist_juristische_person_2163(t) and vermaechtnis_fuer_ereignis_in_person_angeordnet_2163(t);
        then keine_ausnahme_von_dreissig_jahre_frist_2163(t);
    }
}

@source(BGB_P2169) {
    rule VermaechtnisFremderGegenstandUnwirksam(t: Testament) strict {
        label de official "Das Vermächtnis eines bestimmten Gegenstands ist unwirksam, soweit dieser bei Erbfall nicht zur Erbschaft gehört, es sei denn, er ist auch für diesen Fall zugewendet (§ 2169 Abs. 1)"; label en unofficial "The legacy of a specific object is ineffective to the extent the object does not belong to the estate at devolution, unless it is also granted for that case (§ 2169 (1))";
        when vermachter_gegenstand_gehoert_beim_erbfall_nicht_zur_erbschaft_2169(t) and not_known(gegenstand_auch_fuer_diesen_fall_zugewendet_2169(t));
        then vermaechtnis_fremden_gegenstands_unwirksam_2169(t);
    }
    presumption ErblasserbesitzGiltAlsVermacht(t: Testament) {
        label de official "Hat der Erblasser nur den Besitz der vermachten Sache, gilt im Zweifel der Besitz als vermacht (§ 2169 Abs. 2)"; label en unofficial "Where the testator only possessed the bequeathed thing, the possession is in case of doubt deemed bequeathed (§ 2169 (2))";
        when erblasser_hat_nur_besitz_der_vermachten_sache_2169(t);
        presume besitz_gilt_als_vermacht_vermutet_2169(t);
        unless besitz_gewaehrt_bedachtem_keinen_rechtlichen_vorteil_2169(t);
    }
    presumption ErsatzanspruchGiltAlsVermacht(t: Testament) {
        label de official "Steht dem Erblasser ein Anspruch auf Leistung des Gegenstands oder auf Ersatz seines Wertes zu, gilt im Zweifel dieser Anspruch als vermacht (§ 2169 Abs. 3)"; label en unofficial "Where the testator holds a claim to performance of the object or to compensation for its value, that claim is in case of doubt deemed bequeathed (§ 2169 (3))";
        when erblasser_hat_anspruch_auf_leistung_oder_ersatz_des_gegenstands_2169(t);
        presume anspruch_gilt_als_vermacht_vermutet_2169(t);
    }
}

@source(BGB_P2170) {
    rule VerschaffungsvermaechtnisBeschwerterMussVerschaffen(t: Testament, beschwerter: Person) strict {
        label de official "Ist das Vermächtnis eines fremden Gegenstands nach § 2169 Abs. 1 wirksam, hat der Beschwerte den Gegenstand dem Bedachten zu verschaffen (§ 2170 Abs. 1)"; label en unofficial "Where the legacy of an object not belonging to the estate is effective under § 2169 (1), the burdened person must procure the object for the beneficiary (§ 2170 (1))";
        when vermaechtnis_fremden_gegenstands_wirksam_nach_2169_abs1_2170(t, beschwerter);
        then beschwerter_muss_gegenstand_verschaffen_2170(t, beschwerter);
    }
    rule WertentrichtungBeiUnvermoegenOderUnverhaeltnismaessigkeit(t: Testament, beschwerter: Person) strict {
        label de official "Ist der Beschwerte zur Verschaffung außerstande oder nur mit unverhältnismäßigen Aufwendungen möglich, kann er sich durch Entrichtung des Wertes befreien (§ 2170 Abs. 2)"; label en unofficial "Where the burdened person is unable to procure the object, or procurement is possible only with disproportionate expense, they may discharge the duty by paying its value (§ 2170 (2))";
        when beschwerter_zur_verschaffung_ausserstande_oder_unverhaeltnismaessig_2170(t, beschwerter);
        then beschwerter_kann_durch_wertentrichtung_befreien_2170(t, beschwerter);
    }
}

@source(BGB_P2171) {
    rule VermaechtnisUnmoeglicheLeistungOderGesetzlichesVerbotUnwirksam(t: Testament) strict {
        label de official "Ein Vermächtnis, das auf eine bei Erbfall für jedermann unmögliche Leistung gerichtet ist oder gegen ein damals bestehendes gesetzliches Verbot verstößt, ist unwirksam (§ 2171 Abs. 1)"; label en unofficial "A legacy directed at a performance impossible for everyone at devolution, or that violates a legal prohibition then in force, is ineffective (§ 2171 (1))";
        when vermaechtnis_fuer_jedermann_unmoeglich_oder_gesetzeswidrig_2171(t);
        then vermaechtnis_unmoeglichkeit_oder_verbot_unwirksam_2171(t);
    }
    rule BehebbareUnmoeglichkeitFuerBedingtenFallGueltig(t: Testament) strict {
        label de official "Die Unmöglichkeit steht der Gültigkeit nicht entgegen, wenn sie behoben werden kann und das Vermächtnis für den Fall zugewendet ist, dass die Leistung möglich wird (§ 2171 Abs. 2)"; label en unofficial "Impossibility does not affect validity where it can be remedied and the legacy is granted for the case that performance becomes possible (§ 2171 (2))";
        when unmoeglichkeit_behebbar_und_fuer_moeglichwerden_zugewendet_2171(t);
        then vermaechtnis_trotz_unmoeglichkeit_gueltig_2171(t);
    }
    rule UnmoeglicheLeistungUnterAndererBedingungGueltigBeiVorherigerBehebung(t: Testament) strict {
        label de official "Wird ein auf unmögliche Leistung gerichtetes Vermächtnis unter einer anderen aufschiebenden Bedingung oder Befristung zugewendet, ist es gültig, wenn die Unmöglichkeit vor Bedingungs- oder Termineintritt behoben wird (§ 2171 Abs. 3)"; label en unofficial "Where a legacy directed at impossible performance is granted under another suspensive condition or term, it is valid if the impossibility is remedied before the condition or term occurs (§ 2171 (3))";
        when unmoegliches_vermaechtnis_unter_anderer_bedingung_zugewendet_2171(t) and unmoeglichkeit_vor_bedingungseintritt_behoben_2171(t);
        then vermaechtnis_gueltig_bei_vorheriger_behebung_2171(t);
    }
}
