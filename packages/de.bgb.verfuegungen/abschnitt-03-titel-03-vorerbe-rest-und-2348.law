// BÜRGERLICHES GESETZBUCH — VERSTREUTE LÜCKEN: § 2133 (ordnungswidrige/
// übermäßige Fruchtziehung des Vorerben), § 2135 (Miet-/Pachtverhältnis
// bei Eintritt der Nacherbfolge, entsprechende Anwendung § 1056), und
// § 2348 (Form des Erbverzichtsvertrags — eigener @source-Zeuge; der Fakt
// selbst wird bereits in package.law als `erbverzicht_notariell_beurkundet`
// im Kopf der § 2346-Regel gelesen, aber § 2348 hatte noch keinen eigenen
// anzitierenden Regel-Zeugen — Modul 5/6 des Fortsetzungsauftrags 18.09.2026).
//
// § 2135 „entsprechende Anwendung des § 1056“: § 1056 selbst (Vermieter-
// wechsel bei Eigentumsübertragung, Sachenrecht Buch 3) ist außerhalb
// dieses Pakets nicht formalisiert (Buch 3 ist nicht Gegenstand von BG-16).
// Die Norm wird daher NUR in ihrem inhaltlichen Kern nachgebildet — der
// Nacherbe tritt anstelle des Vorerben in das bestehende Miet-/
// Pachtverhältnis ein — ohne die Detailregeln des § 1056 (Kündigungsrecht
// des Mieters bei verspäteter Anzeige usw.) zu reproduzieren.

language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// ---- § 2133 Ordnungswidrige oder übermäßige Fruchtziehung ------------------

pub relation vorerbe_zieht_fruechte_ordnungswidrig_oder_uebermaessig_2133(t: Testament, vorerbe: Person) kind empirical {
    label de official "Der Vorerbe zieht Früchte den Regeln einer ordnungsmäßigen Wirtschaft zuwider oder im Übermaß infolge eines besonderen Ereignisses (§ 2133)";
    label en unofficial "the prior heir takes fruits contrary to the rules of proper management, or excessively because of a special event (§ 2133)";
}
pub relation eigene_nutzungen_des_vorerben_beeintraechtigt_2133(t: Testament, vorerbe: Person) kind empirical {
    label de official "Die dem Vorerben gebührenden Nutzungen werden durch den ordnungswidrigen oder übermäßigen Fruchtbezug beeinträchtigt (§ 2133)";
    label en unofficial "the benefits due to the prior heir are impaired by the irregular or excessive taking of fruits (§ 2133)";
}
pub relation wert_der_fruechte_zur_wiederherstellung_zu_verwenden_2133(t: Testament, vorerbe: Person) kind empirical {
    label de official "Der Wert der Früchte ist nach den Regeln einer ordnungsmäßigen Wirtschaft zur Wiederherstellung der Sache zu verwenden (§ 2133, Gegenausnahme)";
    label en unofficial "the value of the fruits is, under proper-management rules, to be applied to restoring the thing (§ 2133, counter-exception)";
}
pub relation wert_der_fruechte_gebuehrt_vorerben_beschraenkt_2133(t: Testament, vorerbe: Person) kind derived {
    label de official "Der Wert der Früchte gebührt dem Vorerben nur, soweit die ihm gebührenden Nutzungen beeinträchtigt werden und der Wert nicht zur Wiederherstellung zu verwenden ist (§ 2133)";
    label en unofficial "the value of the fruits belongs to the prior heir only to the extent his due benefits are impaired and the value need not be applied to restoration (§ 2133)";
}

// ---- § 2135 Miet- und Pachtverhältnis bei der Nacherbfolge -----------------

pub relation vorerbe_vermietet_oder_verpachtet_grundstueck_oder_schiff_2135(t: Testament, vorerbe: Person, mieter: Person) kind empirical {
    label de official "Der Vorerbe hat ein zur Erbschaft gehörendes Grundstück oder eingetragenes Schiff vermietet oder verpachtet (§ 2135)";
    label en unofficial "the prior heir has let or leased an estate parcel or a registered ship (§ 2135)";
}
pub relation mietverhaeltnis_besteht_bei_eintritt_der_nacherbfolge_2135(t: Testament, vorerbe: Person, mieter: Person) kind empirical {
    label de official "Das Miet- oder Pachtverhältnis besteht bei dem Eintritt der Nacherbfolge noch (§ 2135)";
    label en unofficial "the lease or tenancy still exists when the subsequent succession occurs (§ 2135)";
}
pub relation nacherbe_bei_eintritt_2135(t: Testament, nacherbe: Person) kind empirical {
    label de official "Die Person ist der bei Eintritt der Nacherbfolge berufene Nacherbe (§ 2135)";
    label en unofficial "the person is the subsequent heir called upon the subsequent succession occurring (§ 2135)";
}
pub relation nacherbe_tritt_entsprechend_1056_in_mietverhaeltnis_ein_2135(t: Testament, nacherbe: Person, mieter: Person) kind derived {
    label de official "Der Nacherbe tritt entsprechend § 1056 an die Stelle des Vorerben in das Miet- oder Pachtverhältnis ein (§ 2135)";
    label en unofficial "the subsequent heir, correspondingly to § 1056, takes the prior heir's place in the lease or tenancy (§ 2135)";
}

// ---- § 2348 Form des Erbverzichtsvertrags (eigener Zeuge) ------------------

pub relation erbverzichtsvertrag_form_gewahrt_2348(e: Erbfall, p: Person) kind derived {
    label de official "Der Vertrag nach § 2346 bedarf der notariellen Beurkundung — die Form ist gewahrt (§ 2348)";
    label en unofficial "the § 2346 contract requires notarisation — the form is satisfied (§ 2348)";
}

// ============================================================================

@source(BGB_P2133)
rule WertDerFruechteBeschraenktBeiOrdnungswidrigkeit(t: Testament, vorerbe: Person) strict {
    label de official "Zieht der Vorerbe Früchte ordnungswidrig oder im Übermaß, gebührt ihm ihr Wert nur, soweit seine Nutzungen beeinträchtigt werden und der Wert nicht zur Wiederherstellung zu verwenden ist (§ 2133)";
    label en unofficial "where the prior heir takes fruits irregularly or excessively, their value belongs to him only insofar as his benefits are impaired and the value need not be applied to restoration (§ 2133)";
    when vorerbe_zieht_fruechte_ordnungswidrig_oder_uebermaessig_2133(t, vorerbe) and eigene_nutzungen_des_vorerben_beeintraechtigt_2133(t, vorerbe) and not_known(wert_der_fruechte_zur_wiederherstellung_zu_verwenden_2133(t, vorerbe));
    then wert_der_fruechte_gebuehrt_vorerben_beschraenkt_2133(t, vorerbe);
}

@source(BGB_P2135)
rule NacherbeTrittInMietverhaeltnisEin(t: Testament, vorerbe: Person, mieter: Person, nacherbe: Person) strict {
    label de official "Besteht ein vom Vorerben eingegangenes Miet- oder Pachtverhältnis bei Eintritt der Nacherbfolge noch, tritt der Nacherbe entsprechend § 1056 an dessen Stelle ein (§ 2135)";
    label en unofficial "where a lease or tenancy entered into by the prior heir still exists when subsequent succession occurs, the subsequent heir takes his place, correspondingly to § 1056 (§ 2135)";
    when vorerbe_vermietet_oder_verpachtet_grundstueck_oder_schiff_2135(t, vorerbe, mieter) and mietverhaeltnis_besteht_bei_eintritt_der_nacherbfolge_2135(t, vorerbe, mieter) and nacherbe_bei_eintritt_2135(t, nacherbe);
    then nacherbe_tritt_entsprechend_1056_in_mietverhaeltnis_ein_2135(t, nacherbe, mieter);
}

@source(BGB_P2348)
rule ErbverzichtsvertragBedarfNotariellerBeurkundung(e: Erbfall, p: Person) strict {
    label de official "Der Vertrag nach § 2346 bedarf der notariellen Beurkundung (§ 2348)";
    label en unofficial "the § 2346 contract requires notarisation (§ 2348)";
    when erbverzicht_notariell_beurkundet(e, p);
    then erbverzichtsvertrag_form_gewahrt_2348(e, p);
}
