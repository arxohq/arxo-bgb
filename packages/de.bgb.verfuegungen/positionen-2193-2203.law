language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

pub relation position_trigger_2193(t: Person, beschwerter: Person, tag: Date) kind empirical { label de official "Bestimmung des Begünstigten bei einer Auflage nach § 2193"; label en unofficial "designation of the beneficiary under a charge (§ 2193)"; }
pub relation position_trigger_2203(t: Person, vollstrecker: Person, tag: Date) kind empirical { label de official "Amtsantritt des Testamentsvollstreckers nach § 2203"; label en unofficial "executor's office under § 2203"; }

@source(BGB_P2193)
rule PositionBestimmung2193(t: Person, beschwerter: Person, tag: Date) strict { label de official "Der Kläger darf die Bestimmung des Begünstigten treffen (§ 2193)"; label en unofficial "The claimant may designate the beneficiary (§ 2193)"; when position_trigger_2193(t, beschwerter, tag); then liberty Bestimmung2193 { holder beschwerter; action position_trigger_2193(t, beschwerter, tag); window [tag, infinity); }; }
@source(BGB_P2203)
rule PositionAusfuehrung2203(t: Person, vollstrecker: Person, tag: Date) strict { label de official "Der Testamentsvollstrecker darf die letztwilligen Verfügungen ausführen (§ 2203)"; label en unofficial "The executor may execute the testamentary dispositions (§ 2203)"; when position_trigger_2203(t, vollstrecker, tag); then liberty Ausfuehrung2203 { holder vollstrecker; action position_trigger_2203(t, vollstrecker, tag); window [tag, infinity); }; }
