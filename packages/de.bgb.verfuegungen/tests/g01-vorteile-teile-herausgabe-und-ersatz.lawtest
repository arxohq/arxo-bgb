language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2372 (Vorteile), § 2373 (ausgeschlossene Teile — beide Seiten der drei
// Vermutungen), § 2374 (Herausgabepflicht — beide Alternativen), § 2375
// (Ersatzpflicht — beide Seiten der Kenntnis-Gegenausnahme, Abs. 2), § 2376
// (Rechtsmangel- und Sachmangelhaftung), § 2377 (Wiederaufleben), § 2378
// (Nachlassverbindlichkeiten — beide Seiten der § 2376-Ausnahme).
test "§§ 2372–2378: Vorteile, ausgeschlossene Teile, Herausgabe, Ersatz, Haftung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }

        // § 2372
        assert "g1": vorteil_aus_wegfall_entstanden_2372(entity_ref("urn:de:bgb:pilot:g01:K1"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER1")) { origin case_input; }

        // § 2373 Satz 1 (Erbteil): mit und ohne Gegenausnahme
        assert "g2": spaeter_anfallender_erbteil_entstanden_2373(entity_ref("urn:de:bgb:pilot:g01:K2"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER2")) { origin case_input; }
        assert "g3": spaeter_anfallender_erbteil_entstanden_2373(entity_ref("urn:de:bgb:pilot:g01:K3"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER3")) { origin case_input; }
        assert "g4": erbteil_ausdruecklich_mitverkauft_2373(entity_ref("urn:de:bgb:pilot:g01:K3"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER3")) { origin case_input; }

        // § 2373 Satz 1 (Vorausvermächtnis)
        assert "g5": vorausvermaechtnis_dem_verkaeufer_zugewendet_2373(entity_ref("urn:de:bgb:pilot:g01:K4"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER4")) { origin case_input; }

        // § 2373 Satz 2 (Familienpapiere) mit Gegenausnahme
        assert "g6": familienpapiere_oder_familienbilder_vorhanden_2373(entity_ref("urn:de:bgb:pilot:g01:K5")) { origin case_input; }
        assert "g7": familienpapiere_oder_familienbilder_vorhanden_2373(entity_ref("urn:de:bgb:pilot:g01:K6")) { origin case_input; }
        assert "g8": familienpapiere_ausdruecklich_mitverkauft_2373(entity_ref("urn:de:bgb:pilot:g01:K6")) { origin case_input; }

        // § 2374 beide Alternativen
        assert "g9": erbschaftsgegenstand_zur_zeit_des_verkaufs_vorhanden_2374(entity_ref("urn:de:bgb:pilot:g01:K7"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER7"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER7")) { origin case_input; }
        assert "g10": vor_verkauf_aufgrund_erbschaftsrechts_oder_als_ersatz_erlangt_2374(entity_ref("urn:de:bgb:pilot:g01:K8"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER8"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER8")) { origin case_input; }

        // § 2375 Abs. 1: mit und ohne Kenntnis des Käufers
        assert "g11": gegenstand_vor_verkauf_verbraucht_veraeussert_oder_belastet_2375(entity_ref("urn:de:bgb:pilot:g01:K9"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER9"), 5000.00 EUR) { origin case_input; }
        assert "g12": gegenstand_vor_verkauf_verbraucht_veraeussert_oder_belastet_2375(entity_ref("urn:de:bgb:pilot:g01:K10"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER10"), 3000.00 EUR) { origin case_input; }
        assert "g13": kaeufer_kennt_verbrauch_oder_veraeusserung_bei_abschluss_2375(entity_ref("urn:de:bgb:pilot:g01:K10"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER10")) { origin case_input; }
        // § 2375 Abs. 2
        assert "g14": verschlechterung_untergang_oder_unmoeglichkeit_ohne_verbrauch_veraeusserung_2375(entity_ref("urn:de:bgb:pilot:g01:K11"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER11")) { origin case_input; }

        // § 2376 Abs. 1 (vier Fallgruppen — hier je eine bezeugt)
        assert "g15": erbrecht_steht_verkaeufer_tatsaechlich_nicht_zu_2376(entity_ref("urn:de:bgb:pilot:g01:K12"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER12")) { origin case_input; }
        assert "g16": vermaechtnisse_auflagen_oder_lasten_bestehen_tatsaechlich_2376(entity_ref("urn:de:bgb:pilot:g01:K13"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER13")) { origin case_input; }
        // § 2376 Abs. 2 (arglistiges Verschweigen)
        assert "g17": mangel_arglistig_verschwiegen_2376(entity_ref("urn:de:bgb:pilot:g01:K14"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER14")) { origin case_input; }

        // § 2377
        assert "g18": recht_und_verbindlichkeit_oder_belastung_durch_erbfall_vereinigt_2377(entity_ref("urn:de:bgb:pilot:g01:K15"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER15"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER15")) { origin case_input; }

        // § 2378 Abs. 1: mit und ohne § 2376-Ausnahme; Abs. 2
        assert "g19": nachlassverbindlichkeit_besteht_2378(entity_ref("urn:de:bgb:pilot:g01:K16"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER16"), 1200.00 EUR) { origin case_input; }
        assert "g20": nachlassverbindlichkeit_besteht_2378(entity_ref("urn:de:bgb:pilot:g01:K17"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER17"), 800.00 EUR) { origin case_input; }
        assert "g21": verkaeufer_haftet_nach_2376_fuer_nichtbestehen_dieser_verbindlichkeit_2378(entity_ref("urn:de:bgb:pilot:g01:K17"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER17"), 800.00 EUR) { origin case_input; }
        assert "g22": verkaeufer_hat_verbindlichkeit_vor_verkauf_erfuellt_2378(entity_ref("urn:de:bgb:pilot:g01:K18"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER18"), 600.00 EUR) { origin case_input; }
    }

    evaluate truth(vorteil_gebuehrt_kaeufer_2372(entity_ref("urn:de:bgb:pilot:g01:K1"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER1")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(erbteil_nicht_mitverkauft_vermutet_2373(entity_ref("urn:de:bgb:pilot:g01:K2"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbteil_nicht_mitverkauft_vermutet_2373(entity_ref("urn:de:bgb:pilot:g01:K3"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER3")));
    expect truth_status == NEITHER;

    evaluate truth(vorausvermaechtnis_nicht_mitverkauft_vermutet_2373(entity_ref("urn:de:bgb:pilot:g01:K4"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER4")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(familienpapiere_nicht_mitverkauft_vermutet_2373(entity_ref("urn:de:bgb:pilot:g01:K5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(familienpapiere_nicht_mitverkauft_vermutet_2373(entity_ref("urn:de:bgb:pilot:g01:K6")));
    expect truth_status == NEITHER;

    evaluate truth(herausgabepflicht_besteht_2374(entity_ref("urn:de:bgb:pilot:g01:K7"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER7"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(herausgabepflicht_besteht_2374(entity_ref("urn:de:bgb:pilot:g01:K8"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER8"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER8")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(ersatzpflicht_besteht_2375(entity_ref("urn:de:bgb:pilot:g01:K9"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER9"), 5000.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ersatzpflicht_besteht_2375(entity_ref("urn:de:bgb:pilot:g01:K10"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER10"), 3000.00 EUR));
    expect truth_status == NEITHER;
    evaluate truth(kein_ersatzanspruch_2375(entity_ref("urn:de:bgb:pilot:g01:K11"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER11")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(rechtsmangelhaftung_ausgeloest_2376(entity_ref("urn:de:bgb:pilot:g01:K12"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER12")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(rechtsmangelhaftung_ausgeloest_2376(entity_ref("urn:de:bgb:pilot:g01:K13"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER13")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(sachmangelhaftung_ausgeloest_2376(entity_ref("urn:de:bgb:pilot:g01:K14"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER14")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(rechtsverhaeltnis_gilt_im_verhaeltnis_kaeufer_verkaeufer_als_nicht_erloschen_2377(entity_ref("urn:de:bgb:pilot:g01:K15"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER15"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER15")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(kaeufer_verpflichtet_verbindlichkeit_zu_erfuellen_2378(entity_ref("urn:de:bgb:pilot:g01:K16"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER16"), 1200.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kaeufer_verpflichtet_verbindlichkeit_zu_erfuellen_2378(entity_ref("urn:de:bgb:pilot:g01:K17"), entity_ref("urn:de:bgb:pilot:g01:KAEUFER17"), 800.00 EUR));
    expect truth_status == NEITHER;
    evaluate truth(verkaeufer_kann_ersatz_von_kaeufer_verlangen_2378(entity_ref("urn:de:bgb:pilot:g01:K18"), entity_ref("urn:de:bgb:pilot:g01:VERKAEUFER18"), 600.00 EUR));
    expect truth_status == TRUE_ONLY;
}
