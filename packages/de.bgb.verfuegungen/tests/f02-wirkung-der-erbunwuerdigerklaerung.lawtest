language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2344 Abs. 1, 2 (Wirkung der Erbunwürdigerklärung), § 2345 Abs. 1, 2
// (Vermächtnisunwürdigkeit, Pflichtteilsunwürdigkeit).
test "§§ 2344–2345: Wirkung der Erklärung, Vermächtnis- und Pflichtteilsunwürdigkeit" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erbe_fuer_erbunwuerdig_erklaert_2344(entity_ref("urn:de:bgb:pilot:f02:E1"), entity_ref("urn:de:bgb:pilot:f02:EU1")) { origin case_input; }
        assert "f2": ersatzberufener_ohne_erbunwuerdigen_2344(entity_ref("urn:de:bgb:pilot:f02:E1"), entity_ref("urn:de:bgb:pilot:f02:EU1"), entity_ref("urn:de:bgb:pilot:f02:ER1")) { origin case_input; }
        assert "f3": vermaechtnisnehmer_verfehlung_nach_2339_abs1_2345(entity_ref("urn:de:bgb:pilot:f02:E2"), entity_ref("urn:de:bgb:pilot:f02:VN2")) { origin case_input; }
        assert "f4": pflichtteilsberechtigter_verfehlung_nach_2339_abs1_2345(entity_ref("urn:de:bgb:pilot:f02:E3"), entity_ref("urn:de:bgb:pilot:f02:P3")) { origin case_input; }
    }
    evaluate truth(anfall_an_erbunwuerdigen_gilt_als_nicht_erfolgt_2344(entity_ref("urn:de:bgb:pilot:f02:E1"), entity_ref("urn:de:bgb:pilot:f02:EU1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbschaft_faellt_ersatzberufenem_rueckwirkend_an_2344(entity_ref("urn:de:bgb:pilot:f02:E1"), entity_ref("urn:de:bgb:pilot:f02:ER1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisanspruch_anfechtbar_2345(entity_ref("urn:de:bgb:pilot:f02:E2"), entity_ref("urn:de:bgb:pilot:f02:VN2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(pflichtteilsanspruch_anfechtbar_2345(entity_ref("urn:de:bgb:pilot:f02:E3"), entity_ref("urn:de:bgb:pilot:f02:P3")));
    expect truth_status == TRUE_ONLY;
}
