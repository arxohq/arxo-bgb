language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2333 Abs. 1 Nr. 1 (Kanal §47.3): ohne Antwort des Gerichts zum
// Nachdemlebentrachten bleibt die Entziehbarkeit offen — die Frage ist an
// das Gericht gerichtet, kein stilles Schweigen.
test "§ 2333 Abs. 1 Nr. 1: ohne Antwort des Gerichts bleibt die Entziehbarkeit offen" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": entziehung_durch_verfuegung_2336(entity_ref("urn:de:bgb:pilot:e02:E"), entity_ref("urn:de:bgb:pilot:e02:P")) { origin case_input; }
    }
    evaluate truth(pflichtteil_entziehbar_2333(entity_ref("urn:de:bgb:pilot:e02:E"), entity_ref("urn:de:bgb:pilot:e02:P")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(trachtet_nach_dem_leben_2333, Court);
    expect judgment_request(schwere_vorsaetzliche_straftat_2333, Court);
    expect judgment_request(unterhaltspflicht_boesswillig_verletzt_2333, Court);
}
