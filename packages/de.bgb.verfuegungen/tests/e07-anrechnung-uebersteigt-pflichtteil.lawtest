language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2315 Abs. 1, 2: übersteigen die anzurechnenden Zuwendungen den so
// bestimmten Pflichtteil, verbleibt kein Zahlungsanspruch — die andere
// Seite der bereits bezeugten positiven Anrechnung (p10).
test "§ 2315: übersteigende Anrechnung lässt keinen Zahlungsanspruch übrig" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": nachlasswert(entity_ref("urn:de:bgb:pilot:e07:E"), 40000.00 EUR) { origin case_input; }
        assert "f2": pflichtteilsquote_bruch(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:P"), 1, 4) { origin case_input; }
        assert "f3": zuwendung_unter_leben_2315(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:P"), entity_ref("urn:de:bgb:pilot:e07:Z")) { origin case_input; }
        assert "f4": anrechnung_auf_pflichtteil_bestimmt_2315(entity_ref("urn:de:bgb:pilot:e07:Z")) { origin case_input; }
        assert "f5": wert_zuwendung_zeit_leistung_2315(entity_ref("urn:de:bgb:pilot:e07:Z"), 20000.00 EUR) { origin case_input; }
    }
    evaluate truth(pflichtteil_nach_anrechnung_2315(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:P"), 0.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
