language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§ 2338: Pflichtteilsbeschränkung und Wegfall ihres Grundes" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": abkoemmling_ueberschuldung_gefaehrdet_erwerb_2338(entity_ref("urn:de:bgb:pilot:v21:E"), entity_ref("urn:de:bgb:pilot:v21:P")) { origin case_input; }
        assert "f2": pflichtteilsbeschraenkung_angeordnet_2338(entity_ref("urn:de:bgb:pilot:v21:E"), entity_ref("urn:de:bgb:pilot:v21:P")) { origin case_input; }
        assert "f3": verwaltung_testamentsvollstrecker_lebenszeit_2338(entity_ref("urn:de:bgb:pilot:v21:E"), entity_ref("urn:de:bgb:pilot:v21:P")) { origin case_input; }
        assert "f4": ueberschuldungsgrund_entfallen_2338(entity_ref("urn:de:bgb:pilot:v21:E"), entity_ref("urn:de:bgb:pilot:v21:P")) { origin case_input; }
    }
    evaluate truth(pflichtteilsbeschraenkung_zulaessig_2338(entity_ref("urn:de:bgb:pilot:v21:E"), entity_ref("urn:de:bgb:pilot:v21:P")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(abkoemmling_anspruch_jaehrlicher_reinertrag_2338(entity_ref("urn:de:bgb:pilot:v21:E"), entity_ref("urn:de:bgb:pilot:v21:P")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(pflichtteilsbeschraenkung_unwirksam_2338(entity_ref("urn:de:bgb:pilot:v21:E"), entity_ref("urn:de:bgb:pilot:v21:P")));
    expect truth_status == TRUE_ONLY;
}
