language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2339 Abs. 1 Nr. 1 (Tötung, Kanal §47.3), Nr. 3 (Täuschung/Drohung) mit
// Abs. 2 Gegenausnahme (beide Seiten), Nr. 4 (Straftat), § 2340 Abs. 1, 2,
// 3 (Anfechtung, Frist), § 2341 (Anfechtungsberechtigte), § 2342 Abs. 1, 2
// (Klage, Rechtskraft), § 2343 (Verzeihung).
test "§§ 2339–2343: Erbunwürdigkeitsgründe, Anfechtung, Rechtskraft, Verzeihung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erblasser_vorsaetzlich_widerrechtlich_getoetet_oder_testierunfaehig_gemacht_2339(entity_ref("urn:de:bgb:pilot:f01:E1"), entity_ref("urn:de:bgb:pilot:f01:P1")) { origin adjudicated; }
        assert "f2": erblasser_durch_taeuschung_oder_drohung_zu_verfuegung_bestimmt_2339(entity_ref("urn:de:bgb:pilot:f01:E2"), entity_ref("urn:de:bgb:pilot:f01:P2")) { origin adjudicated; }
        assert "f3": erblasser_durch_taeuschung_oder_drohung_zu_verfuegung_bestimmt_2339(entity_ref("urn:de:bgb:pilot:f01:E3"), entity_ref("urn:de:bgb:pilot:f01:P3")) { origin adjudicated; }
        assert "f4": verfuegung_zu_der_3_oder_4_bestimmt_vor_erbfall_unwirksam_geworden_2339(entity_ref("urn:de:bgb:pilot:f01:E3"), entity_ref("urn:de:bgb:pilot:f01:P3")) { origin case_input; }
        assert "f5": straftat_nach_267_271_274_stgb_2339(entity_ref("urn:de:bgb:pilot:f01:E4"), entity_ref("urn:de:bgb:pilot:f01:P4")) { origin case_input; }
        assert "f6": erbschaft_dem_erbunwuerdigen_angefallen_2340(entity_ref("urn:de:bgb:pilot:f01:E5"), entity_ref("urn:de:bgb:pilot:f01:P5")) { origin case_input; }
        assert "f7": wegfall_des_erbunwuerdigen_kommt_person_zustatten_2341(entity_ref("urn:de:bgb:pilot:f01:E6"), entity_ref("urn:de:bgb:pilot:f01:BER6"), entity_ref("urn:de:bgb:pilot:f01:EU6")) { origin case_input; }
        assert "f8": anfechtungsklage_erhoben_2342(entity_ref("urn:de:bgb:pilot:f01:E7"), entity_ref("urn:de:bgb:pilot:f01:P7")) { origin case_input; }
        assert "f9": urteil_rechtskraeftig_2342(entity_ref("urn:de:bgb:pilot:f01:E8"), entity_ref("urn:de:bgb:pilot:f01:P8")) { origin case_input; }
        assert "f10": erblasser_hat_erbunwuerdigem_verziehen_2343(entity_ref("urn:de:bgb:pilot:f01:E9"), entity_ref("urn:de:bgb:pilot:f01:P9")) { origin case_input; }
    }
    evaluate truth(erbunwuerdig_2339(entity_ref("urn:de:bgb:pilot:f01:E1"), entity_ref("urn:de:bgb:pilot:f01:P1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbunwuerdig_2339(entity_ref("urn:de:bgb:pilot:f01:E2"), entity_ref("urn:de:bgb:pilot:f01:P2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbunwuerdig_2339(entity_ref("urn:de:bgb:pilot:f01:E3"), entity_ref("urn:de:bgb:pilot:f01:P3")));
    expect truth_status == NEITHER;
    evaluate truth(erbunwuerdigkeit_nach_abs2_ausgeschlossen_2339(entity_ref("urn:de:bgb:pilot:f01:E3"), entity_ref("urn:de:bgb:pilot:f01:P3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbunwuerdig_2339(entity_ref("urn:de:bgb:pilot:f01:E4"), entity_ref("urn:de:bgb:pilot:f01:P4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtung_des_erbschaftserwerbs_geltend_gemacht_2340(entity_ref("urn:de:bgb:pilot:f01:E5"), entity_ref("urn:de:bgb:pilot:f01:P5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtungsfrist_des_2082_massgeblich_2340(entity_ref("urn:de:bgb:pilot:f01:E5"), entity_ref("urn:de:bgb:pilot:f01:P5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtungsberechtigt_2341(entity_ref("urn:de:bgb:pilot:f01:E6"), entity_ref("urn:de:bgb:pilot:f01:BER6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(klage_auf_erbunwuerdigerklaerung_gerichtet_2342(entity_ref("urn:de:bgb:pilot:f01:E7"), entity_ref("urn:de:bgb:pilot:f01:P7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtungswirkung_eingetreten_2342(entity_ref("urn:de:bgb:pilot:f01:E8"), entity_ref("urn:de:bgb:pilot:f01:P8")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtung_wegen_verzeihung_ausgeschlossen_2343(entity_ref("urn:de:bgb:pilot:f01:E9"), entity_ref("urn:de:bgb:pilot:f01:P9")));
    expect truth_status == TRUE_ONLY;
}
