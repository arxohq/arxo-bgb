language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2104–2110: gesetzliche Vor- und Nacherben, Eintritt und Umfang" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erbe_nur_bis_zeitpunkt_oder_ereignis_2104(entity_ref("urn:de:bgb:pilot:v27:T1")) { origin case_input; }
        assert "f2": gesetzlicher_erbe_beim_spaeteren_ereignis_2104(entity_ref("urn:de:bgb:pilot:v27:T1"), entity_ref("urn:de:bgb:pilot:v27:A")) { origin case_input; }
        assert "f3": eingesetzter_erbe_erhaelt_nur_spaeter_2105(entity_ref("urn:de:bgb:pilot:v27:T2")) { origin case_input; }
        assert "f4": gesetzlicher_erbe_bis_dahin_2105(entity_ref("urn:de:bgb:pilot:v27:T2"), entity_ref("urn:de:bgb:pilot:v27:B")) { origin case_input; }
        assert "f5": nacherbe_ohne_eintrittszeitpunkt_2106(entity_ref("urn:de:bgb:pilot:v27:T3"), entity_ref("urn:de:bgb:pilot:v27:C"), entity_ref("urn:de:bgb:pilot:v27:D")) { origin case_input; }
        assert "f6": kinderloser_abkoemmling_vorerbe_nacherbe_bestimmt_2107(entity_ref("urn:de:bgb:pilot:v27:T4"), entity_ref("urn:de:bgb:pilot:v27:E"), entity_ref("urn:de:bgb:pilot:v27:F")) { origin case_input; }
        assert "f7": nacherbe_vor_eintritt_nach_erbfall_verstorben_2108(entity_ref("urn:de:bgb:pilot:v27:T5"), entity_ref("urn:de:bgb:pilot:v27:G")) { origin case_input; }
        assert "f8": nacherbschaft_dreissig_jahre_ohne_eintritt_2109(entity_ref("urn:de:bgb:pilot:v27:T6")) { origin case_input; }
        assert "f9": vorerbe_miterbenwegfall_erbteil_erhalten_2110(entity_ref("urn:de:bgb:pilot:v27:T7")) { origin case_input; }
        assert "f10": vorerbe_vorausvermaechtnis_zugewendet_2110(entity_ref("urn:de:bgb:pilot:v27:T8")) { origin case_input; }
    }
    evaluate truth(gesetzlicher_erbe_als_nacherbe_vermutet_2104(entity_ref("urn:de:bgb:pilot:v27:T1"), entity_ref("urn:de:bgb:pilot:v27:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(gesetzlicher_erbe_als_vorerbe_2105(entity_ref("urn:de:bgb:pilot:v27:T2"), entity_ref("urn:de:bgb:pilot:v27:B"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbschaft_mit_tod_des_vorerben_2106(entity_ref("urn:de:bgb:pilot:v27:T3"), entity_ref("urn:de:bgb:pilot:v27:C"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbe_nur_bei_nachkommenschaftslosem_tod_vermutet_2107(entity_ref("urn:de:bgb:pilot:v27:T4"), entity_ref("urn:de:bgb:pilot:v27:F"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbrecht_geht_auf_erben_ueber_2108(entity_ref("urn:de:bgb:pilot:v27:T5"), entity_ref("urn:de:bgb:pilot:v27:G"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbeinsetzung_unwirksam_2109(entity_ref("urn:de:bgb:pilot:v27:T6"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbrecht_erstreckt_sich_auf_angewachsenen_erbteil_2110(entity_ref("urn:de:bgb:pilot:v27:T7"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbrecht_erstreckt_sich_nicht_auf_vorausvermaechtnis_2110(entity_ref("urn:de:bgb:pilot:v27:T8"))); expect truth_status == TRUE_ONLY;
}
