language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2209 (Dauervollstreckung, Vermutung erweiterter Ermächtigung), § 2210
// (dreißigjährige Frist und Ausnahme bei angeordneter Fortdauer — beide
// Seiten), § 2211 Abs. 1 (Verfügungsbeschränkung des Erben), § 2212 (nur
// Vollstrecker klagebefugt), § 2213 Abs. 1 Sätze 1-3 (Anspruch gegen Erbe
// und Vollstrecker, nur Erbe bei fehlender Verwaltung, Pflichtteil nur
// gegen Erben), § 2214 (kein Zugriff der Erbengläubiger).
test "§§ 2209–2214: Dauervollstreckung, dreißig Jahre (beide Seiten), Verfügungsbeschränkung, gerichtliche Geltendmachung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erblasser_uebertraegt_dauervollstreckung_2209(entity_ref("urn:de:bgb:pilot:x03:T1"), entity_ref("urn:de:bgb:pilot:x03:V1")) { origin case_input; }
        assert "f2": dauervollstreckung_dreissig_jahre_ohne_anderweitige_anordnung_2210(entity_ref("urn:de:bgb:pilot:x03:T2"), entity_ref("urn:de:bgb:pilot:x03:V2")) { origin case_input; }
        assert "f3": erblasser_ordnet_fortdauer_bis_tod_oder_ereignis_an_2210(entity_ref("urn:de:bgb:pilot:x03:T3"), entity_ref("urn:de:bgb:pilot:x03:V3")) { origin case_input; }
        assert "f4": nachlassgegenstand_unterliegt_verwaltung_des_vollstreckers_2211(entity_ref("urn:de:bgb:pilot:x03:T4"), entity_ref("urn:de:bgb:pilot:x03:V4"), entity_ref("urn:de:bgb:pilot:x03:E4")) { origin case_input; }
        assert "f5": der_verwaltung_unterliegendes_recht_gerichtlich_geltend_zu_machen_2212(entity_ref("urn:de:bgb:pilot:x03:T5"), entity_ref("urn:de:bgb:pilot:x03:V5")) { origin case_input; }
        assert "f6": anspruch_gegen_nachlass_gerichtet_2213(entity_ref("urn:de:bgb:pilot:x03:T6"), entity_ref("urn:de:bgb:pilot:x03:E6"), entity_ref("urn:de:bgb:pilot:x03:V6")) { origin case_input; }
        assert "f7": vollstrecker_hat_nicht_die_nachlassverwaltung_2213(entity_ref("urn:de:bgb:pilot:x03:T7"), entity_ref("urn:de:bgb:pilot:x03:V7")) { origin case_input; }
        assert "f8": anspruch_gegen_nachlass_gerichtet_2213(entity_ref("urn:de:bgb:pilot:x03:T7"), entity_ref("urn:de:bgb:pilot:x03:E7"), entity_ref("urn:de:bgb:pilot:x03:V7")) { origin case_input; }
        assert "f9": pflichtteilsanspruch_betroffen_2213(entity_ref("urn:de:bgb:pilot:x03:T8"), entity_ref("urn:de:bgb:pilot:x03:E8")) { origin case_input; }
        assert "f10": glaeubiger_des_erben_kein_nachlassglaeubiger_2214(entity_ref("urn:de:bgb:pilot:x03:T9"), entity_ref("urn:de:bgb:pilot:x03:E9")) { origin case_input; }
    }
    evaluate truth(dauervollstreckung_angeordnet_2209(entity_ref("urn:de:bgb:pilot:x03:T1"), entity_ref("urn:de:bgb:pilot:x03:V1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erweiterte_ermaechtigung_bei_dauervollstreckung_vermutet_2209(entity_ref("urn:de:bgb:pilot:x03:T1"), entity_ref("urn:de:bgb:pilot:x03:V1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(dauervollstreckungsanordnung_unwirksam_2210(entity_ref("urn:de:bgb:pilot:x03:T2"), entity_ref("urn:de:bgb:pilot:x03:V2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(fortdauer_ueber_dreissig_jahre_zulaessig_2210(entity_ref("urn:de:bgb:pilot:x03:T3"), entity_ref("urn:de:bgb:pilot:x03:V3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbe_kann_nicht_verfuegen_2211(entity_ref("urn:de:bgb:pilot:x03:T4"), entity_ref("urn:de:bgb:pilot:x03:E4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(nur_vollstrecker_kann_geltend_machen_2212(entity_ref("urn:de:bgb:pilot:x03:T5"), entity_ref("urn:de:bgb:pilot:x03:V5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anspruch_gegen_erben_und_vollstrecker_geltend_machbar_2213(entity_ref("urn:de:bgb:pilot:x03:T6"), entity_ref("urn:de:bgb:pilot:x03:E6"), entity_ref("urn:de:bgb:pilot:x03:V6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(nur_gegen_erben_geltend_machbar_2213(entity_ref("urn:de:bgb:pilot:x03:T7"), entity_ref("urn:de:bgb:pilot:x03:E7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(pflichtteilsanspruch_nur_gegen_erben_2213(entity_ref("urn:de:bgb:pilot:x03:T8"), entity_ref("urn:de:bgb:pilot:x03:E8")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kein_zugriff_auf_verwaltete_gegenstaende_2214(entity_ref("urn:de:bgb:pilot:x03:T9"), entity_ref("urn:de:bgb:pilot:x03:E9")));
    expect truth_status == TRUE_ONLY;
}
