language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§ 2331: Zuwendung aus Gesamtgut" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": zuwendung_aus_gesamtgut_2331(entity_ref("urn:de:bgb:pilot:v18:E"), entity_ref("urn:de:bgb:pilot:v18:S"), entity_ref("urn:de:bgb:pilot:v18:A"), entity_ref("urn:de:bgb:pilot:v18:B")) { origin case_input; }
        assert "f2": beschenkter_nur_von_einem_ehegatten_abkoemmling_2331(entity_ref("urn:de:bgb:pilot:v18:E"), entity_ref("urn:de:bgb:pilot:v18:S"), entity_ref("urn:de:bgb:pilot:v18:A")) { origin case_input; }
        assert "f3": zuwendung_aus_fortgesetztem_gesamtgut_2331(entity_ref("urn:de:bgb:pilot:v18:E"), entity_ref("urn:de:bgb:pilot:v18:F")) { origin case_input; }
    }
    evaluate truth(zuwendung_aus_gesamtgut_haelftig_gemacht_2331(entity_ref("urn:de:bgb:pilot:v18:E"), entity_ref("urn:de:bgb:pilot:v18:S"), entity_ref("urn:de:bgb:pilot:v18:A")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zuwendung_aus_gesamtgut_haelftig_gemacht_2331(entity_ref("urn:de:bgb:pilot:v18:E"), entity_ref("urn:de:bgb:pilot:v18:S"), entity_ref("urn:de:bgb:pilot:v18:B")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zuwendung_als_von_einem_ehegatten_gemacht_2331(entity_ref("urn:de:bgb:pilot:v18:E"), entity_ref("urn:de:bgb:pilot:v18:S"), entity_ref("urn:de:bgb:pilot:v18:A")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(regeln_gesamtgutzuwendung_entsprechend_anwendbar_2331(entity_ref("urn:de:bgb:pilot:v18:E"), entity_ref("urn:de:bgb:pilot:v18:F")));
    expect truth_status == TRUE_ONLY;
}
