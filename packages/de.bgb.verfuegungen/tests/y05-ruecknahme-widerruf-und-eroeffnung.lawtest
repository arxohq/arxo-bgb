language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2256 Abs. 1, 2, 3 (Rücknahme aus Verwahrung), § 2257 (Widerruf des
// Widerrufs), § 2258 Abs. 1, 2 (späteres Testament), § 2259 Abs. 1, 2
// (Ablieferungspflicht), § 2263 (Eröffnungsverbot nichtig).
test "§§ 2256–2259, 2263: Rücknahme, Widerruf des Widerrufs, späteres Testament, Ablieferung, Eröffnungsverbot" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": notariell_oder_nach_2249_errichtetes_testament_aus_verwahrung_zurueckgegeben_2256(entity_ref("urn:de:bgb:pilot:y05:T1"), entity_ref("urn:de:bgb:pilot:y05:E1")) { origin case_input; }
        assert "f2": erblasser_verlangt_ruecknahme_2256(entity_ref("urn:de:bgb:pilot:y05:T2"), entity_ref("urn:de:bgb:pilot:y05:E2")) { origin case_input; }
        assert "f3": nach_2248_hinterlegtes_testament_zurueckgegeben_2256(entity_ref("urn:de:bgb:pilot:y05:T3"), entity_ref("urn:de:bgb:pilot:y05:E3")) { origin case_input; }
        assert "f4": widerruf_einer_verfuegung_durch_testament_widerrufen_2257(entity_ref("urn:de:bgb:pilot:y05:T4"), entity_ref("urn:de:bgb:pilot:y05:WT4")) { origin case_input; }
        assert "f5": spaeteres_testament_errichtet_im_widerspruch_zum_frueheren_2258(entity_ref("urn:de:bgb:pilot:y05:S5"), entity_ref("urn:de:bgb:pilot:y05:F5")) { origin case_input; }
        assert "f6": spaeteres_testament_widerrufen_2258(entity_ref("urn:de:bgb:pilot:y05:S6"), entity_ref("urn:de:bgb:pilot:y05:F6")) { origin case_input; }
        assert "f7": besitzer_erlangt_kenntnis_vom_tod_und_testament_nicht_in_verwahrung_2259(entity_ref("urn:de:bgb:pilot:y05:T7"), entity_ref("urn:de:bgb:pilot:y05:B7")) { origin case_input; }
        assert "f8": testament_bei_anderer_behoerde_als_gericht_verwahrt_nach_tod_2259(entity_ref("urn:de:bgb:pilot:y05:T8")) { origin case_input; }
        assert "f9": erblasser_verbietet_alsbaldige_eroeffnung_2263(entity_ref("urn:de:bgb:pilot:y05:T9")) { origin case_input; }
        assert "f10": erblasser_hat_testamentsurkunde_vernichtet_oder_veraendert_2255(entity_ref("urn:de:bgb:pilot:y05:T10"), entity_ref("urn:de:bgb:pilot:y05:E10")) { origin case_input; }
        assert "f11": erblasser_hat_testamentsurkunde_vernichtet_oder_veraendert_2255(entity_ref("urn:de:bgb:pilot:y05:T11"), entity_ref("urn:de:bgb:pilot:y05:E11")) { origin case_input; }
        assert "f12": gegenbeweis_gegen_aufhebungsabsicht_2255(entity_ref("urn:de:bgb:pilot:y05:T11"), entity_ref("urn:de:bgb:pilot:y05:E11")) { origin case_input; }
    }
    evaluate truth(testament_gilt_als_widerrufen_durch_ruecknahme_2256(entity_ref("urn:de:bgb:pilot:y05:T1"), entity_ref("urn:de:bgb:pilot:y05:E1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ruecknahme_jederzeit_verlangbar_2256(entity_ref("urn:de:bgb:pilot:y05:T2"), entity_ref("urn:de:bgb:pilot:y05:E2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ruecknahme_ohne_einfluss_auf_wirksamkeit_2256(entity_ref("urn:de:bgb:pilot:y05:T3"), entity_ref("urn:de:bgb:pilot:y05:E3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(urspruengliche_verfuegung_wieder_wirksam_vermutet_2257(entity_ref("urn:de:bgb:pilot:y05:T4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(frueheres_testament_insoweit_aufgehoben_2258(entity_ref("urn:de:bgb:pilot:y05:S5"), entity_ref("urn:de:bgb:pilot:y05:F5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(frueheres_testament_wieder_wirksam_vermutet_2258(entity_ref("urn:de:bgb:pilot:y05:S6"), entity_ref("urn:de:bgb:pilot:y05:F6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ablieferungspflicht_ans_nachlassgericht_2259(entity_ref("urn:de:bgb:pilot:y05:T7"), entity_ref("urn:de:bgb:pilot:y05:B7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ablieferung_an_nachlassgericht_geschuldet_2259(entity_ref("urn:de:bgb:pilot:y05:T8")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(eroeffnungsverbot_nichtig_2263(entity_ref("urn:de:bgb:pilot:y05:T9")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(aufhebungsabsicht_vermutet_2255(entity_ref("urn:de:bgb:pilot:y05:T10"), entity_ref("urn:de:bgb:pilot:y05:E10")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(aufhebungsabsicht_vermutet_2255(entity_ref("urn:de:bgb:pilot:y05:T11"), entity_ref("urn:de:bgb:pilot:y05:E11")));
    expect truth_status == NEITHER;
}
