language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2123–2129: Verwaltungskosten und Schutz des Nacherben" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": wald_oder_bodenabbauanlage_in_erbschaft_2123(entity_ref("urn:de:bgb:pilot:v30:T1")) { origin case_input; }
        assert "f2": wirtschaftsplan_verlangt_2123(entity_ref("urn:de:bgb:pilot:v30:T1")) { origin case_input; }
        assert "f3": gewoehnliche_erhaltungskosten_2124(entity_ref("urn:de:bgb:pilot:v30:T2"), entity_ref("urn:de:bgb:pilot:v30:A")) { origin case_input; }
        assert "f4": nicht_2124_verwendung_gemacht_2125(entity_ref("urn:de:bgb:pilot:v30:T3"), entity_ref("urn:de:bgb:pilot:v30:B")) { origin case_input; }
        assert "f5": ausserordentliche_stammwertlast_2126(entity_ref("urn:de:bgb:pilot:v30:T4"), entity_ref("urn:de:bgb:pilot:v30:C")) { origin case_input; }
        assert "f6": verwaltung_gefaehrdet_nacherbrecht_2127(entity_ref("urn:de:bgb:pilot:v30:T5"), entity_ref("urn:de:bgb:pilot:v30:D")) { origin case_input; }
        assert "f7": verhalten_oder_vermoegenslage_besorgnis_2128(entity_ref("urn:de:bgb:pilot:v30:T6"), entity_ref("urn:de:bgb:pilot:v30:E")) { origin case_input; }
        assert "f8": vorerbe_verwaltung_entzogen_2129(entity_ref("urn:de:bgb:pilot:v30:T7"), entity_ref("urn:de:bgb:pilot:v30:F")) { origin case_input; }
    }
    evaluate truth(wirtschaftsplan_festzustellen_2123(entity_ref("urn:de:bgb:pilot:v30:T1"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_traegt_gewoehnliche_erhaltungskosten_2124(entity_ref("urn:de:bgb:pilot:v30:T2"), entity_ref("urn:de:bgb:pilot:v30:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbe_muss_verwendung_ersetzen_2125(entity_ref("urn:de:bgb:pilot:v30:T3"), entity_ref("urn:de:bgb:pilot:v30:B"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_traegt_ausserordentliche_last_nicht_2126(entity_ref("urn:de:bgb:pilot:v30:T4"), entity_ref("urn:de:bgb:pilot:v30:C"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbe_darf_auskunft_verlangen_2127(entity_ref("urn:de:bgb:pilot:v30:T5"), entity_ref("urn:de:bgb:pilot:v30:D"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbe_darf_sicherheit_verlangen_2128(entity_ref("urn:de:bgb:pilot:v30:T6"), entity_ref("urn:de:bgb:pilot:v30:E"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_verliert_verfuegungsrecht_2129(entity_ref("urn:de:bgb:pilot:v30:T7"), entity_ref("urn:de:bgb:pilot:v30:F"))); expect truth_status == TRUE_ONLY;
}
