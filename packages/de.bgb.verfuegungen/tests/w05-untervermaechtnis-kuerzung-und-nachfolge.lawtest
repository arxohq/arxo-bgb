language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2186 (Fälligkeit des Untervermächtnisses), § 2187 Abs. 1 (Verweigerung
// bei unzureichendem eigenen Vermächtnis), Abs. 2 (Nachfolgerhaftung
// begrenzt), § 2188 (verhältnismäßige Kürzung — Vermutung greift und
// Gegenausnahme greift, beide Seiten), § 2189 (Vorrangsanordnung), § 2190
// (Ersatzvermächtnisnehmer), § 2191 Abs. 1, 2 (Nachvermächtnisnehmer).
test "§§ 2186–2191: Untervermächtnis, Kürzung (beide Seiten), Vorrang, Ersatz- und Nachvermächtnisnehmer" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": vermaechtnisnehmer_mit_untervermaechtnis_oder_auflage_beschwert_2186(entity_ref("urn:de:bgb:pilot:w05:T1"), entity_ref("urn:de:bgb:pilot:w05:VN")) { origin case_input; }
        assert "f2": vermaechtnisnehmer_mit_vermaechtnis_oder_auflage_beschwert_und_eigenes_reicht_nicht_2187(entity_ref("urn:de:bgb:pilot:w05:T2"), entity_ref("urn:de:bgb:pilot:w05:VN2")) { origin case_input; }
        assert "f3": nach_2161_anderer_an_stelle_des_beschwerten_vermaechtnisnehmers_getreten_2187(entity_ref("urn:de:bgb:pilot:w05:T3"), entity_ref("urn:de:bgb:pilot:w05:NF"), entity_ref("urn:de:bgb:pilot:w05:VN3")) { origin case_input; }
        assert "f4": vermaechtnisleistung_wegen_haftungsbeschraenkung_pflichtteil_oder_2187_gekuerzt_2188(entity_ref("urn:de:bgb:pilot:w05:T4"), entity_ref("urn:de:bgb:pilot:w05:VN4")) { origin case_input; }
        assert "f5": vermaechtnisleistung_wegen_haftungsbeschraenkung_pflichtteil_oder_2187_gekuerzt_2188(entity_ref("urn:de:bgb:pilot:w05:T5"), entity_ref("urn:de:bgb:pilot:w05:VN5")) { origin case_input; }
        assert "f6": anderer_wille_des_erblassers_bei_2188_anzunehmen(entity_ref("urn:de:bgb:pilot:w05:T5"), entity_ref("urn:de:bgb:pilot:w05:VN5")) { origin case_input; }
        assert "f7": vorrang_fuer_kuerzungsfall_angeordnet_2189(entity_ref("urn:de:bgb:pilot:w05:T6")) { origin case_input; }
        assert "f8": ersatzvermaechtnisnehmer_fuer_nichterwerb_eingesetzt_2190(entity_ref("urn:de:bgb:pilot:w05:T7"), entity_ref("urn:de:bgb:pilot:w05:ER"), entity_ref("urn:de:bgb:pilot:w05:ZU")) { origin case_input; }
        assert "f9": vermachter_gegenstand_ab_spaeterem_zeitpunkt_oder_ereignis_drittem_zugewendet_2191(entity_ref("urn:de:bgb:pilot:w05:T8"), entity_ref("urn:de:bgb:pilot:w05:ERSTER"), entity_ref("urn:de:bgb:pilot:w05:DRITTER")) { origin case_input; }
    }
    evaluate truth(erfuellung_erst_bei_eigener_verlangbarkeit_verpflichtet_2186(entity_ref("urn:de:bgb:pilot:w05:T1"), entity_ref("urn:de:bgb:pilot:w05:VN")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erfuellung_auch_nach_annahme_insoweit_verweigerbar_2187(entity_ref("urn:de:bgb:pilot:w05:T2"), entity_ref("urn:de:bgb:pilot:w05:VN2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(nachfolger_haftet_nicht_weiter_als_vermaechtnisnehmer_gehaftet_haette_2187(entity_ref("urn:de:bgb:pilot:w05:T3"), entity_ref("urn:de:bgb:pilot:w05:NF")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(eigene_beschwerungen_verhaeltnismaessig_kuerzbar_vermutet_2188(entity_ref("urn:de:bgb:pilot:w05:T4"), entity_ref("urn:de:bgb:pilot:w05:VN4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(eigene_beschwerungen_verhaeltnismaessig_kuerzbar_vermutet_2188(entity_ref("urn:de:bgb:pilot:w05:T5"), entity_ref("urn:de:bgb:pilot:w05:VN5")));
    expect truth_status == NEITHER;
    evaluate truth(vorrangsanordnung_zulaessig_2189(entity_ref("urn:de:bgb:pilot:w05:T6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(p2097_bis_2099_auf_ersatzvermaechtnisnehmer_entsprechend_anwendbar_2190(entity_ref("urn:de:bgb:pilot:w05:T7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erster_vermaechtnisnehmer_gilt_als_beschwert_2191(entity_ref("urn:de:bgb:pilot:w05:T8"), entity_ref("urn:de:bgb:pilot:w05:ERSTER")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(p2102_p2106abs1_p2107_p2110abs1_auf_nachvermaechtnis_entsprechend_anwendbar_2191(entity_ref("urn:de:bgb:pilot:w05:T8")));
    expect truth_status == TRUE_ONLY;
}
