language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2269 Abs. 1, 2 (gegenseitige Einsetzung, Vermächtnisanfall), § 2270
// Abs. 1, 2 (wechselbezüglich, Vermutung), Abs. 3 (Ausnahme), § 2271
// Abs. 1, 2, 3 (Widerrufsgrenzen).
test "§§ 2269–2271: gegenseitige Einsetzung, Wechselbezüglichkeit, Widerruf" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": gegenseitige_erbeinsetzung_mit_drittzuwendung_nach_ueberlebendem_2269(entity_ref("urn:de:bgb:pilot:z02:T1"), entity_ref("urn:de:bgb:pilot:z02:D1")) { origin case_input; }
        assert "f2": vermaechtnis_nach_tod_des_ueberlebenden_zu_erfuellen_angeordnet_2269(entity_ref("urn:de:bgb:pilot:z02:T2"), entity_ref("urn:de:bgb:pilot:z02:B2")) { origin case_input; }
        assert "f3": verfuegung_des_einen_ehegatten_nicht_ohne_verfuegung_des_anderen_2270(entity_ref("urn:de:bgb:pilot:z02:T3"), entity_ref("urn:de:bgb:pilot:z02:V3A"), entity_ref("urn:de:bgb:pilot:z02:V3B")) { origin case_input; }
        assert "f4": eine_wechselbezuegliche_verfuegung_nichtig_oder_widerrufen_2270(entity_ref("urn:de:bgb:pilot:z02:T4"), entity_ref("urn:de:bgb:pilot:z02:N4"), entity_ref("urn:de:bgb:pilot:z02:A4")) { origin case_input; }
        assert "f5": ehegatten_bedenken_sich_gegenseitig_oder_zuwendung_mit_verfuegung_fuer_nahestehenden_2270(entity_ref("urn:de:bgb:pilot:z02:T5"), entity_ref("urn:de:bgb:pilot:z02:EG5"), entity_ref("urn:de:bgb:pilot:z02:V5")) { origin case_input; }
        assert "f6": verfuegung_ist_weder_erbeinsetzung_noch_vermaechtnis_noch_auflage_noch_rechtswahl_2270(entity_ref("urn:de:bgb:pilot:z02:T6"), entity_ref("urn:de:bgb:pilot:z02:EG6")) { origin case_input; }
        assert "f7": widerruf_wechselbezueglicher_verfuegung_bei_lebzeiten_beider_2271(entity_ref("urn:de:bgb:pilot:z02:T7"), entity_ref("urn:de:bgb:pilot:z02:EG7")) { origin case_input; }
        assert "f8": ehegatte_versucht_einseitige_aufhebung_durch_neue_verfuegung_bei_lebzeiten_2271(entity_ref("urn:de:bgb:pilot:z02:T8"), entity_ref("urn:de:bgb:pilot:z02:EG8")) { origin case_input; }
        assert "f9": anderer_ehegatte_verstorben_2271(entity_ref("urn:de:bgb:pilot:z02:T9"), entity_ref("urn:de:bgb:pilot:z02:UEB9")) { origin case_input; }
        assert "f10": ueberlebender_schlaegt_zuwendung_aus_2271(entity_ref("urn:de:bgb:pilot:z02:T10"), entity_ref("urn:de:bgb:pilot:z02:UEB10")) { origin case_input; }
        assert "f11": pflichtteilsberechtigter_abkoemmling_bedacht_2271(entity_ref("urn:de:bgb:pilot:z02:T11"), entity_ref("urn:de:bgb:pilot:z02:AB11")) { origin case_input; }
    }
    evaluate truth(dritter_als_erbe_des_letztversterbenden_fuer_gesamten_nachlass_vermutet_2269(entity_ref("urn:de:bgb:pilot:z02:T1"), entity_ref("urn:de:bgb:pilot:z02:D1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisanfall_erst_mit_tod_des_ueberlebenden_vermutet_2269(entity_ref("urn:de:bgb:pilot:z02:T2"), entity_ref("urn:de:bgb:pilot:z02:B2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verfuegungen_wechselbezueglich_2270(entity_ref("urn:de:bgb:pilot:z02:T3"), entity_ref("urn:de:bgb:pilot:z02:V3A"), entity_ref("urn:de:bgb:pilot:z02:V3B")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(andere_wechselbezuegliche_verfuegung_unwirksam_2270(entity_ref("urn:de:bgb:pilot:z02:T4"), entity_ref("urn:de:bgb:pilot:z02:A4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(wechselbezueglichkeit_vermutet_2270(entity_ref("urn:de:bgb:pilot:z02:T5"), entity_ref("urn:de:bgb:pilot:z02:EG5"), entity_ref("urn:de:bgb:pilot:z02:V5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(abs1_nicht_anwendbar_2270(entity_ref("urn:de:bgb:pilot:z02:T6"), entity_ref("urn:de:bgb:pilot:z02:EG6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(widerruf_nach_2296_form_2271(entity_ref("urn:de:bgb:pilot:z02:T7"), entity_ref("urn:de:bgb:pilot:z02:EG7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(einseitige_aufhebung_unwirksam_2271(entity_ref("urn:de:bgb:pilot:z02:T8"), entity_ref("urn:de:bgb:pilot:z02:EG8")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(widerrufsrecht_erloschen_2271(entity_ref("urn:de:bgb:pilot:z02:T9"), entity_ref("urn:de:bgb:pilot:z02:UEB9")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ueberlebender_kann_verfuegung_aufheben_2271(entity_ref("urn:de:bgb:pilot:z02:T10"), entity_ref("urn:de:bgb:pilot:z02:UEB10")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(p2289_abs2_entsprechend_anwendbar_2271(entity_ref("urn:de:bgb:pilot:z02:T11"), entity_ref("urn:de:bgb:pilot:z02:AB11")));
    expect truth_status == TRUE_ONLY;
}
