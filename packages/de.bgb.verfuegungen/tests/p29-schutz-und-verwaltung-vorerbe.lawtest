language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2116–2122: Schutz und Verwaltung der Vorerbschaft" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": nacherbe_verlangt_hinterlegung_inhaberpapiere_2116(entity_ref("urn:de:bgb:pilot:v29:T1"), entity_ref("urn:de:bgb:pilot:v29:A")) { origin case_input; }
        assert "f2": vorerbe_ueber_hinterlegte_papiere_verfuegt_2116(entity_ref("urn:de:bgb:pilot:v29:T1"), entity_ref("urn:de:bgb:pilot:v29:A")) { origin case_input; }
        assert "f3": vorerbe_waehlt_umschreibung_oder_umwandlung_2117(entity_ref("urn:de:bgb:pilot:v29:T2"), entity_ref("urn:de:bgb:pilot:v29:B")) { origin case_input; }
        assert "f4": nacherbe_verlangt_sperrvermerk_2118(entity_ref("urn:de:bgb:pilot:v29:T3"), entity_ref("urn:de:bgb:pilot:v29:C")) { origin case_input; }
        assert "f5": dauerhaft_anzulegendes_geld_2119(entity_ref("urn:de:bgb:pilot:v29:T4"), entity_ref("urn:de:bgb:pilot:v29:D")) { origin case_input; }
        assert "f6": ordnungsmaessige_verwaltung_braucht_nacherben_einwilligung_2120(entity_ref("urn:de:bgb:pilot:v29:T5"), entity_ref("urn:de:bgb:pilot:v29:E")) { origin case_input; }
        assert "f7": nacherbe_verlangt_verzeichnis_2121(entity_ref("urn:de:bgb:pilot:v29:T6"), entity_ref("urn:de:bgb:pilot:v29:F")) { origin case_input; }
        assert "f8": zustand_durch_sachverstaendige_feststellen_2122(entity_ref("urn:de:bgb:pilot:v29:T7"), entity_ref("urn:de:bgb:pilot:v29:G")) { origin case_input; }
    }
    evaluate truth(vorerbe_muss_papiere_mit_zustimmungsvorbehalt_hinterlegen_2116(entity_ref("urn:de:bgb:pilot:v29:T1"), entity_ref("urn:de:bgb:pilot:v29:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(verfuegung_hinterlegte_papiere_nur_mit_zustimmung_2116(entity_ref("urn:de:bgb:pilot:v29:T1"), entity_ref("urn:de:bgb:pilot:v29:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(umschreibung_oder_umwandlung_zulaessig_2117(entity_ref("urn:de:bgb:pilot:v29:T2"), entity_ref("urn:de:bgb:pilot:v29:B"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_muss_sperrvermerk_eintragen_2118(entity_ref("urn:de:bgb:pilot:v29:T3"), entity_ref("urn:de:bgb:pilot:v29:C"))); expect truth_status == TRUE_ONLY;
    evaluate truth(geldanlage_nach_240a_erforderlich_2119(entity_ref("urn:de:bgb:pilot:v29:T4"), entity_ref("urn:de:bgb:pilot:v29:D"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbe_muss_einwilligen_2120(entity_ref("urn:de:bgb:pilot:v29:T5"), entity_ref("urn:de:bgb:pilot:v29:E"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_muss_verzeichnis_mitteilen_2121(entity_ref("urn:de:bgb:pilot:v29:T6"), entity_ref("urn:de:bgb:pilot:v29:F"))); expect truth_status == TRUE_ONLY;
    evaluate truth(zustandsfeststellung_zulaessig_2122(entity_ref("urn:de:bgb:pilot:v29:T7"), entity_ref("urn:de:bgb:pilot:v29:G"))); expect truth_status == TRUE_ONLY;
}
