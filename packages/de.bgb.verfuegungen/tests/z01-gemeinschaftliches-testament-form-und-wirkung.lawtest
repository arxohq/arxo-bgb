language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2266 (gemeinschaftliches Nottestament), § 2267 (eigenhändige Form mit
// Mitunterzeichnung), § 2268 Abs. 1 (Unwirksamkeit ganzem Inhalt nach), Abs. 2
// (insoweit wirksam), § 2272 (Rücknahme nur durch beide).
test "§§ 2266–2268, 2272: gemeinschaftliches Testament — Nottestament, Form, Ehenichtigkeit, Rücknahme" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": gemeinschaftliches_testament_voraussetzungen_nur_bei_einem_ehegatten_2266(entity_ref("urn:de:bgb:pilot:z01:T1"), entity_ref("urn:de:bgb:pilot:z01:EG1")) { origin case_input; }
        assert "f2": ein_ehegatte_errichtet_nach_2247_anderer_unterzeichnet_eigenhaendig_mit_2267(entity_ref("urn:de:bgb:pilot:z01:T2"), entity_ref("urn:de:bgb:pilot:z01:E2"), entity_ref("urn:de:bgb:pilot:z01:M2")) { origin case_input; }
        assert "f3": gemeinschaftliches_testament_faellt_unter_2077_2268(entity_ref("urn:de:bgb:pilot:z01:T3"), entity_ref("urn:de:bgb:pilot:z01:EG3")) { origin case_input; }
        assert "f4": ehe_vor_tod_aufgeloest_oder_2077_abs1_satz2_3_fall_2268(entity_ref("urn:de:bgb:pilot:z01:T4"), entity_ref("urn:de:bgb:pilot:z01:EG4")) { origin case_input; }
        assert "f5": anzunehmen_dass_verfuegung_auch_fuer_diesen_fall_getroffen_2268(entity_ref("urn:de:bgb:pilot:z01:T4"), entity_ref("urn:de:bgb:pilot:z01:EG4")) { origin case_input; }
        assert "f6": gemeinschaftliches_testament_aus_verwahrung_zurueckgenommen_2272(entity_ref("urn:de:bgb:pilot:z01:T5"), entity_ref("urn:de:bgb:pilot:z01:EG5A"), entity_ref("urn:de:bgb:pilot:z01:EG5B")) { origin case_input; }
    }
    evaluate truth(gemeinschaftliches_nottestament_zulaessig_2266(entity_ref("urn:de:bgb:pilot:z01:T1"), entity_ref("urn:de:bgb:pilot:z01:EG1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(gemeinschaftliches_eigenhaendiges_testament_formwirksam_2267(entity_ref("urn:de:bgb:pilot:z01:T2"), entity_ref("urn:de:bgb:pilot:z01:E2"), entity_ref("urn:de:bgb:pilot:z01:M2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(gemeinschaftliches_testament_ganzem_inhalt_nach_unwirksam_2268(entity_ref("urn:de:bgb:pilot:z01:T3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verfuegung_insoweit_wirksam_2268(entity_ref("urn:de:bgb:pilot:z01:T4"), entity_ref("urn:de:bgb:pilot:z01:EG4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ruecknahme_nur_durch_beide_ehegatten_2272(entity_ref("urn:de:bgb:pilot:z01:T5"), entity_ref("urn:de:bgb:pilot:z01:EG5A"), entity_ref("urn:de:bgb:pilot:z01:EG5B")));
    expect truth_status == TRUE_ONLY;
}
