language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// BMJ „Erben und Vererben“ (Stand Juli 2025), S. 20, Beispiel: Erblasserin D, Ehemann S (Zugewinngemeinschaft) als Alleinerbe eingesetzt, Tochter T; Nachlasswert 100.000 € — gesetzlicher Erbteil der Tochter 1/2, Pflichtteilsquote 1/4, Pflichtteil 25.000 € (§ 2303 Abs. 1, § 2311 Abs. 1).
test "§ 2303: Pflichtteil der Tochter neben dem als Alleinerben eingesetzten Ehemann (BMJ-Beispiel)" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": de.bgb.erbfolge::erblasser(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:D")) { origin case_input; }
        assert "f2": de.bgb.erbfolge::erbfall_am(entity_ref("urn:de:bgb:pilot:v01:E"), @2026-03-01) { origin case_input; }
        assert "f3": de.bgb.erbfolge::familie(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:F")) { origin case_input; }
        assert "f4": de.bgb.erbfolge::ehe_beim_erbfall(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:EHE")) { origin case_input; }
        assert "f5": de.bgb.ehe::ehegatten(entity_ref("urn:de:bgb:pilot:v01:EHE"), entity_ref("urn:de:bgb:pilot:v01:D"), entity_ref("urn:de:bgb:pilot:v01:S")) { origin case_input; }
        assert "f6": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:S")) { origin case_input; }
        assert "f7": de.bgb.ehe::kein_ehevertrag(entity_ref("urn:de:bgb:pilot:v01:EHE")) { origin case_input; }
        assert "f10": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:pilot:v01:F"), entity_ref("urn:de:bgb:pilot:v01:D"), entity_ref("urn:de:bgb:pilot:v01:T")) { origin case_input; }
        assert "f11": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:T")) { origin case_input; }
        assert "f12": durch_verfuegung_von_todes_wegen_ausgeschlossen(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:T")) { origin case_input; }
        assert "f13": nachlasswert(entity_ref("urn:de:bgb:pilot:v01:E"), 100000.00 EUR) { origin case_input; }
    }
    evaluate truth(pflichtteilsberechtigt(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:T")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pflichtteilsquote(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:T"), 1 / 4));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pflichtteil(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:T"), 25000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pflichtteilsanspruch_entstanden(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:T")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pflichtteilsanspruch_vererblich_und_uebertragbar(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:T")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pflichtteilsberechtigt(entity_ref("urn:de:bgb:pilot:v01:E"), entity_ref("urn:de:bgb:pilot:v01:S")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
