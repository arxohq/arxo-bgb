language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2326 Satz 2: ist dem Pflichtteilsberechtigten mehr als die Hälfte
// hinterlassen, ist der Ergänzungsanspruch ausgeschlossen, soweit der Wert
// des Mehrhinterlassenen reicht — Rest bleibt verlangbar, wenn die
// Ergänzung den Mehrwert übersteigt.
test "§ 2326 Satz 2: Ergänzung nur soweit der Mehrwert nicht reicht" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": pflichtteilsberechtigter_mit_erbteil_2326(entity_ref("urn:de:bgb:pilot:e06:E"), entity_ref("urn:de:bgb:pilot:e06:P")) { origin case_input; }
        assert "f2": hinterlassener_erbteil_mehr_als_haelfte_gesetzlich_2326(entity_ref("urn:de:bgb:pilot:e06:E"), entity_ref("urn:de:bgb:pilot:e06:P"), 1000.00 EUR) { origin case_input; }
        assert "f3": pflichtteilsergaenzung(entity_ref("urn:de:bgb:pilot:e06:E"), entity_ref("urn:de:bgb:pilot:e06:P"), 4000.00 EUR) { origin case_input; }
    }
    evaluate truth(pflichtteilsergaenzung_soweit_mehrwert_nicht_ausgeschlossen_2326(entity_ref("urn:de:bgb:pilot:e06:E"), entity_ref("urn:de:bgb:pilot:e06:P"), 3000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
