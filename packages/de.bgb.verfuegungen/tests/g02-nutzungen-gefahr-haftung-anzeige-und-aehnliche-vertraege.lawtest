language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2379 (Nutzungen/Lasten vor Verkauf), § 2380 (Gefahrübergang), § 2381
// (Verwendungs-/Aufwendungsersatz), § 2382 (Gläubigerhaftung, nicht
// abdingbar), § 2383 (Umfang der Haftung, Inventar), § 2384 (Anzeigepflicht
// — unverzüglich als Wertungskanal §47.3, Einsicht bei glaubhaftem
// Interesse), § 2385 (entsprechende Anwendung, Schenkung — beide Seiten
// der Arglist-Gegenausnahme).
test "§§ 2379–2385: Nutzungen, Gefahr, Haftung, Anzeige, ähnliche Verträge" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }

        // § 2379
        assert "h1": nutzung_vor_verkauf_entstanden_2379(entity_ref("urn:de:bgb:pilot:g02:K1"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER1")) { origin case_input; }
        assert "h2": laufende_last_vor_verkauf_entstanden_2379(entity_ref("urn:de:bgb:pilot:g02:K1"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER1")) { origin case_input; }
        assert "h3": abgabe_von_der_erbschaft_zu_entrichten_2379(entity_ref("urn:de:bgb:pilot:g02:K1"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER1")) { origin case_input; }
        assert "h4": ausserordentliche_auf_stammwert_gelegte_last_2379(entity_ref("urn:de:bgb:pilot:g02:K1"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER1")) { origin case_input; }

        // § 2380
        assert "h5": kauf_abgeschlossen_2380(entity_ref("urn:de:bgb:pilot:g02:K2"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER2")) { origin case_input; }

        // § 2381
        assert "h6": notwendige_verwendung_vor_verkauf_gemacht_2381(entity_ref("urn:de:bgb:pilot:g02:K3"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER3"), 400.00 EUR) { origin case_input; }
        assert "h7": andere_aufwendung_vor_verkauf_gemacht_2381(entity_ref("urn:de:bgb:pilot:g02:K3"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER3"), 150.00 EUR) { origin case_input; }

        // § 2382: Haftung entsteht mit Kauf; Ausschlussvereinbarung bleibt wirkungslos
        assert "h8": vereinbarung_zwischen_kaeufer_und_verkaeufer_ueber_ausschluss_der_glaeubigerhaftung_2382(entity_ref("urn:de:bgb:pilot:g02:K2")) { origin case_input; }

        // § 2383 Abs. 1
        assert "h9": verkaeufer_haftet_zur_zeit_des_verkaufs_unbeschraenkt_2383(entity_ref("urn:de:bgb:pilot:g02:K4"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER4"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER4")) { origin case_input; }
        assert "h10": kaeufer_haftung_auf_erbschaft_beschraenkt_2383(entity_ref("urn:de:bgb:pilot:g02:K5"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER5")) { origin case_input; }
        // § 2383 Abs. 2: mit und ohne Ausnahme
        assert "h11": inventar_errichtet_2383(entity_ref("urn:de:bgb:pilot:g02:K6"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER6")) { origin case_input; }
        assert "h12": anderer_teil_ist_2383(entity_ref("urn:de:bgb:pilot:g02:K6"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER6"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER6")) { origin case_input; }
        assert "h13": inventar_errichtet_2383(entity_ref("urn:de:bgb:pilot:g02:K7"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER7")) { origin case_input; }
        assert "h14": anderer_teil_ist_2383(entity_ref("urn:de:bgb:pilot:g02:K7"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER7"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER7")) { origin case_input; }
        assert "h15": anderer_teil_haftet_unbeschraenkt_2383(entity_ref("urn:de:bgb:pilot:g02:K7"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER7")) { origin case_input; }

        // § 2384 Abs. 1: unverzüglich erfolgt (Kanal §47.3) vs. Ersetzung durch Käufer-Anzeige
        assert "h16": verkauf_und_name_des_kaeufers_angezeigt_2384(entity_ref("urn:de:bgb:pilot:g02:K8")) { origin case_input; }
        assert "h17": anzeige_unverzueglich_erfolgt_2384(entity_ref("urn:de:bgb:pilot:g02:K8")) { origin adjudicated; }
        assert "h18": anzeige_durch_kaeufer_erfolgt_2384(entity_ref("urn:de:bgb:pilot:g02:K9")) { origin case_input; }
        // § 2384 Abs. 2
        assert "h19": dritter_begehrt_einsicht_der_anzeige_2384(entity_ref("urn:de:bgb:pilot:g02:K8"), entity_ref("urn:de:bgb:pilot:g02:DRITTER8")) { origin case_input; }
        assert "h20": rechtliches_interesse_glaubhaft_gemacht_2384(entity_ref("urn:de:bgb:pilot:g02:K8"), entity_ref("urn:de:bgb:pilot:g02:DRITTER8")) { origin adjudicated; }

        // § 2385 Abs. 1
        assert "h21": vertrag_auf_veraeusserung_erworbener_erbschaft_gerichtet_2385(entity_ref("urn:de:bgb:pilot:g02:K10")) { origin case_input; }
        // § 2385 Abs. 2: Schenkung mit und ohne Arglist
        assert "h22": erbschaftskauf_ist_schenkung_2385(entity_ref("urn:de:bgb:pilot:g02:K11"), entity_ref("urn:de:bgb:pilot:g02:SCHENKER11"), entity_ref("urn:de:bgb:pilot:g02:BESCHENKTER11")) { origin case_input; }
        assert "h23": erbschaftskauf_ist_schenkung_2385(entity_ref("urn:de:bgb:pilot:g02:K12"), entity_ref("urn:de:bgb:pilot:g02:SCHENKER12"), entity_ref("urn:de:bgb:pilot:g02:BESCHENKTER12")) { origin case_input; }
        assert "h24": schenker_mangel_arglistig_verschwiegen_2385(entity_ref("urn:de:bgb:pilot:g02:K12"), entity_ref("urn:de:bgb:pilot:g02:SCHENKER12")) { origin case_input; }
    }

    evaluate truth(nutzung_verbleibt_verkaeufer_2379(entity_ref("urn:de:bgb:pilot:g02:K1"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(last_traegt_verkaeufer_2379(entity_ref("urn:de:bgb:pilot:g02:K1"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(abgabe_traegt_kaeufer_2379(entity_ref("urn:de:bgb:pilot:g02:K1"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ausserordentliche_last_traegt_kaeufer_2379(entity_ref("urn:de:bgb:pilot:g02:K1"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER1")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(kaeufer_traegt_gefahr_ab_abschluss_2380(entity_ref("urn:de:bgb:pilot:g02:K2"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(nutzungen_und_lasten_ab_abschluss_beim_kaeufer_2380(entity_ref("urn:de:bgb:pilot:g02:K2"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER2")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(verkaeufer_kann_verwendungsersatz_verlangen_2381(entity_ref("urn:de:bgb:pilot:g02:K3"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER3"), 400.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verkaeufer_kann_aufwendungsersatz_verlangen_2381(entity_ref("urn:de:bgb:pilot:g02:K3"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER3"), 150.00 EUR));
    expect truth_status == TRUE_ONLY;

    evaluate truth(kaeufer_haftet_nachlassglaeubigern_2382(entity_ref("urn:de:bgb:pilot:g02:K2"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vereinbarung_ohne_wirkung_gegenueber_glaeubigern_2382(entity_ref("urn:de:bgb:pilot:g02:K2")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(kaeufer_haftet_unbeschraenkt_2383(entity_ref("urn:de:bgb:pilot:g02:K4"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anspruch_aus_kauf_gilt_als_zur_erbschaft_gehoerend_2383(entity_ref("urn:de:bgb:pilot:g02:K5"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(inventarerrichtung_kommt_anderem_teil_zugute_2383(entity_ref("urn:de:bgb:pilot:g02:K6"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER6"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(inventarerrichtung_kommt_anderem_teil_zugute_2383(entity_ref("urn:de:bgb:pilot:g02:K7"), entity_ref("urn:de:bgb:pilot:g02:VERKAEUFER7"), entity_ref("urn:de:bgb:pilot:g02:KAEUFER7")));
    expect truth_status == NEITHER;

    evaluate truth(anzeigepflicht_erfuellt_2384(entity_ref("urn:de:bgb:pilot:g02:K8")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anzeigepflicht_erfuellt_2384(entity_ref("urn:de:bgb:pilot:g02:K9")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(einsicht_zu_gestatten_2384(entity_ref("urn:de:bgb:pilot:g02:K8"), entity_ref("urn:de:bgb:pilot:g02:DRITTER8")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(vorschriften_ueber_erbschaftskauf_entsprechend_anwendbar_2385(entity_ref("urn:de:bgb:pilot:g02:K10")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(schenker_zu_ersatz_nach_2375_nicht_verpflichtet_2385(entity_ref("urn:de:bgb:pilot:g02:K11"), entity_ref("urn:de:bgb:pilot:g02:SCHENKER11")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(gewaehrleistung_nach_2376_trifft_schenker_nicht_2385(entity_ref("urn:de:bgb:pilot:g02:K11"), entity_ref("urn:de:bgb:pilot:g02:SCHENKER11")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(schenker_muss_schaden_ersetzen_2385(entity_ref("urn:de:bgb:pilot:g02:K12"), entity_ref("urn:de:bgb:pilot:g02:SCHENKER12"), entity_ref("urn:de:bgb:pilot:g02:BESCHENKTER12")));
    expect truth_status == TRUE_ONLY;
}
