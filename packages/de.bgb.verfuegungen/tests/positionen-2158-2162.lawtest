language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2162, 2193, 2203: Vermächtnispositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.verfuegungen::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_2162(entity_ref("urn:test:t2162"), entity_ref("urn:test:p2162"), entity_ref("urn:test:e2162"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_2193(entity_ref("urn:test:t2193"), entity_ref("urn:test:p2193"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_2203(entity_ref("urn:test:t2203"), entity_ref("urn:test:p2203"), @2026-01-01) { origin case_input; }
 assert "cg": position_trigger_2203(entity_ref("urn:test:t2203"), entity_ref("urn:test:p2203"), @2026-01-01) { origin case_input; } }
 
 evaluate positions();
 expect position(Grenze2162, ACTIVE); expect position(Bestimmung2193, ACTIVE); expect position(Ausfuehrung2203, ACTIVE);
}

test "§§ 2162, 2193, 2203: Vermächtnispositionen mit Rechtsgrund" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.verfuegungen::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_2162(entity_ref("urn:test:t2162"), entity_ref("urn:test:p2162"), entity_ref("urn:test:e2162"), @2026-01-01) { origin case_input; }
 assert "ag": position_trigger_2162(entity_ref("urn:test:t2162"), entity_ref("urn:test:p2162"), entity_ref("urn:test:e2162"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_2193(entity_ref("urn:test:t2193"), entity_ref("urn:test:p2193"), @2026-01-01) { origin case_input; }
 assert "bg": position_trigger_2193(entity_ref("urn:test:t2193"), entity_ref("urn:test:p2193"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_2203(entity_ref("urn:test:t2203"), entity_ref("urn:test:p2203"), @2026-01-01) { origin case_input; }
 assert "cg": position_trigger_2203(entity_ref("urn:test:t2203"), entity_ref("urn:test:p2203"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Grenze2162, ACTIVE); expect position(Bestimmung2193, ACTIVE); expect position(Ausfuehrung2203, ACTIVE);
}
