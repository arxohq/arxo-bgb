language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2327, 2328: eigenes Geschenk und Schutz des selbst berechtigten Erben" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": pflichtteilsberechtigter_selbst_beschenkt_2327(entity_ref("urn:de:bgb:pilot:v16:E"), entity_ref("urn:de:bgb:pilot:v16:P"), entity_ref("urn:de:bgb:pilot:v16:G")) { origin case_input; }
        assert "f2": eigenes_geschenk_nach_2315_anzurechnen_2327(entity_ref("urn:de:bgb:pilot:v16:E"), entity_ref("urn:de:bgb:pilot:v16:P"), entity_ref("urn:de:bgb:pilot:v16:G")) { origin case_input; }
        assert "f3": pflichtteilsberechtigter_abkoemmling_2327(entity_ref("urn:de:bgb:pilot:v16:E"), entity_ref("urn:de:bgb:pilot:v16:P")) { origin case_input; }
        assert "f4": erbe_selbst_pflichtteilsberechtigt_2328(entity_ref("urn:de:bgb:pilot:v16:E"), entity_ref("urn:de:bgb:pilot:v16:H")) { origin case_input; }
        assert "f5": verweigerung_laesst_eigenen_pflichtteil_und_ergaenzung_2328(entity_ref("urn:de:bgb:pilot:v16:E"), entity_ref("urn:de:bgb:pilot:v16:H")) { origin case_input; }
    }
    evaluate truth(eigenes_geschenk_dem_nachlass_hinzuzurechnen_2327(entity_ref("urn:de:bgb:pilot:v16:E"), entity_ref("urn:de:bgb:pilot:v16:P"), entity_ref("urn:de:bgb:pilot:v16:G")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(eigenes_geschenk_auf_ergaenzung_anzurechnen_2327(entity_ref("urn:de:bgb:pilot:v16:E"), entity_ref("urn:de:bgb:pilot:v16:P"), entity_ref("urn:de:bgb:pilot:v16:G")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(eigenes_geschenk_2315_auf_gesamtbetrag_anzurechnen_2327(entity_ref("urn:de:bgb:pilot:v16:E"), entity_ref("urn:de:bgb:pilot:v16:P"), entity_ref("urn:de:bgb:pilot:v16:G")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ersatzabkoemmling_2051_auf_2327_anwendbar(entity_ref("urn:de:bgb:pilot:v16:E"), entity_ref("urn:de:bgb:pilot:v16:P")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbe_kann_ergaenzung_soweit_verweigern_2328(entity_ref("urn:de:bgb:pilot:v16:E"), entity_ref("urn:de:bgb:pilot:v16:H")));
    expect truth_status == TRUE_ONLY;
}
