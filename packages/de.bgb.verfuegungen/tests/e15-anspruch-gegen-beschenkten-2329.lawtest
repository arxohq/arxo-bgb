language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2329 Abs. 1 Satz 1, 2 (Herausgabe, gleiches Recht als Alleinerbe),
// Abs. 2 (Abwendung durch Zahlung), Abs. 3 (subsidiäre Haftung des früher
// Beschenkten — Vermutung greift und Gegenausnahme greift, beide Seiten).
test "§ 2329: Anspruch gegen den Beschenkten — Herausgabe, Abwendung, Rangfolge" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erbe_zur_ergaenzung_nicht_verpflichtet_2329(entity_ref("urn:de:bgb:pilot:e15:E1"), entity_ref("urn:de:bgb:pilot:e15:P1")) { origin case_input; }
        assert "f2": schenkung_beschenkter_fuer_2329(entity_ref("urn:de:bgb:pilot:e15:E1"), entity_ref("urn:de:bgb:pilot:e15:S1"), entity_ref("urn:de:bgb:pilot:e15:B1")) { origin case_input; }
        assert "f3": pflichtteilsberechtigter_alleiniger_erbe_2329(entity_ref("urn:de:bgb:pilot:e15:E2"), entity_ref("urn:de:bgb:pilot:e15:P2")) { origin case_input; }
        assert "f4": schenkung_beschenkter_fuer_2329(entity_ref("urn:de:bgb:pilot:e15:E2"), entity_ref("urn:de:bgb:pilot:e15:S2"), entity_ref("urn:de:bgb:pilot:e15:B2")) { origin case_input; }
        assert "f5": beschenkter_zahlt_fehlenden_betrag_2329(entity_ref("urn:de:bgb:pilot:e15:E3"), entity_ref("urn:de:bgb:pilot:e15:S3"), entity_ref("urn:de:bgb:pilot:e15:B3")) { origin case_input; }
        assert "f6": mehrere_beschenkte_frueher_und_spaeter_2329(entity_ref("urn:de:bgb:pilot:e15:E4"), entity_ref("urn:de:bgb:pilot:e15:F4"), entity_ref("urn:de:bgb:pilot:e15:SP4")) { origin case_input; }
        assert "f7": mehrere_beschenkte_frueher_und_spaeter_2329(entity_ref("urn:de:bgb:pilot:e15:E5"), entity_ref("urn:de:bgb:pilot:e15:F5"), entity_ref("urn:de:bgb:pilot:e15:SP5")) { origin case_input; }
        assert "f8": spaeter_beschenkter_verpflichtet_2329(entity_ref("urn:de:bgb:pilot:e15:E5"), entity_ref("urn:de:bgb:pilot:e15:F5"), entity_ref("urn:de:bgb:pilot:e15:SP5")) { origin case_input; }
    }
    evaluate truth(herausgabe_zum_zwecke_der_befriedigung_forderbar_2329(entity_ref("urn:de:bgb:pilot:e15:E1"), entity_ref("urn:de:bgb:pilot:e15:P1"), entity_ref("urn:de:bgb:pilot:e15:S1"), entity_ref("urn:de:bgb:pilot:e15:B1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(gleiches_recht_als_alleiniger_erbe_2329(entity_ref("urn:de:bgb:pilot:e15:E2"), entity_ref("urn:de:bgb:pilot:e15:P2"), entity_ref("urn:de:bgb:pilot:e15:S2"), entity_ref("urn:de:bgb:pilot:e15:B2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(herausgabe_durch_zahlung_abgewendet_2329(entity_ref("urn:de:bgb:pilot:e15:E3"), entity_ref("urn:de:bgb:pilot:e15:S3"), entity_ref("urn:de:bgb:pilot:e15:B3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(fruehere_beschenkte_haftung_subsidiaer_vermutet_2329(entity_ref("urn:de:bgb:pilot:e15:E4"), entity_ref("urn:de:bgb:pilot:e15:F4"), entity_ref("urn:de:bgb:pilot:e15:SP4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(fruehere_beschenkte_haftung_subsidiaer_vermutet_2329(entity_ref("urn:de:bgb:pilot:e15:E5"), entity_ref("urn:de:bgb:pilot:e15:F5"), entity_ref("urn:de:bgb:pilot:e15:SP5")));
    expect truth_status == NEITHER;
}
