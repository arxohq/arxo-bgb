language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2173 (Forderungsvermächtnis, beide Sätze), § 2174 (Vermächtnisanspruch),
// § 2176 (Anfall mit Erbfall), § 2177 (Anfall bei Bedingung), § 2178 (Anfall
// bei Geburt und bei Ereigniseintritt — beide Fälle).
test "§§ 2173, 2174, 2176–2178: Forderungsvermächtnis, Anspruch, Anfall" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": forderung_des_erblassers_vermacht_2173(entity_ref("urn:de:bgb:pilot:w02:T1")) { origin case_input; }
        assert "f2": vor_erbfall_geleistet_und_gegenstand_noch_in_erbschaft_2173(entity_ref("urn:de:bgb:pilot:w02:T1")) { origin case_input; }
        assert "f3": forderung_des_erblassers_vermacht_2173(entity_ref("urn:de:bgb:pilot:w02:T2")) { origin case_input; }
        assert "f4": forderung_auf_geldsumme_gerichtet_2173(entity_ref("urn:de:bgb:pilot:w02:T2")) { origin case_input; }
        assert "f5": vermaechtnis_angeordnet_2174(entity_ref("urn:de:bgb:pilot:w02:T3"), entity_ref("urn:de:bgb:pilot:w02:B")) { origin case_input; }
        assert "f6": vermaechtnis_bedingt_oder_befristet_und_eintritt_nach_erbfall_2177(entity_ref("urn:de:bgb:pilot:w02:T4")) { origin case_input; }
        assert "f7": bedachter_beim_erbfall_noch_nicht_gezeugt_2178(entity_ref("urn:de:bgb:pilot:w02:T5"), entity_ref("urn:de:bgb:pilot:w02:K")) { origin case_input; }
        assert "f8": bedachtenpersoenlichkeit_durch_spaeteres_ereignis_bestimmt_2178(entity_ref("urn:de:bgb:pilot:w02:T6"), entity_ref("urn:de:bgb:pilot:w02:J")) { origin case_input; }
    }
    evaluate truth(geleisteter_gegenstand_gilt_als_zugewendet_vermutet_2173(entity_ref("urn:de:bgb:pilot:w02:T1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(entsprechende_geldsumme_gilt_als_vermacht_vermutet_2173(entity_ref("urn:de:bgb:pilot:w02:T2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisanspruch_begruendet_2174(entity_ref("urn:de:bgb:pilot:w02:T3"), entity_ref("urn:de:bgb:pilot:w02:B")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisforderung_entsteht_mit_erbfall_2176(entity_ref("urn:de:bgb:pilot:w02:T3"), entity_ref("urn:de:bgb:pilot:w02:B")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisanfall_mit_bedingungs_oder_termineintritt_2177(entity_ref("urn:de:bgb:pilot:w02:T4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisanfall_mit_geburt_2178(entity_ref("urn:de:bgb:pilot:w02:T5"), entity_ref("urn:de:bgb:pilot:w02:K")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisanfall_mit_ereigniseintritt_2178(entity_ref("urn:de:bgb:pilot:w02:T6"), entity_ref("urn:de:bgb:pilot:w02:J")));
    expect truth_status == TRUE_ONLY;
}
