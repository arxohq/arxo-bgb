language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2167 (Gesamthypothek, anteilige Pflicht qualitativ), § 2168 Abs. 1, 2
// (Gesamtgrundschuld, eigenes und fremdes Grundstück), § 2172 Abs. 1
// (Leistung gilt als unmöglich bei Verbindung/Vermischung/Vermengung),
// Abs. 2 (Miteigentum und Wegnahmerecht im Zweifel mitvermacht).
test "§§ 2167, 2168, 2172: Gesamthypothek, Gesamtgrundschuld, Verbindung/Vermischung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": neben_vermachtem_grundstueck_weitere_erbschaftsgrundstuecke_mit_gleicher_hypothek_belastet_2167(entity_ref("urn:de:bgb:pilot:w06:T1")) { origin case_input; }
        assert "f2": mehrere_erbschaftsgrundstuecke_mit_gesamtgrundschuld_belastet_und_eines_vermacht_2168(entity_ref("urn:de:bgb:pilot:w06:T2")) { origin case_input; }
        assert "f3": nicht_erbschaftliches_grundstueck_mit_gesamtgrundschuld_neben_vermachtem_belastet_und_erblasser_verpflichtet_2168(entity_ref("urn:de:bgb:pilot:w06:T3")) { origin case_input; }
        assert "f4": vermachte_sache_mit_anderer_verbunden_vermischt_vermengt_2172(entity_ref("urn:de:bgb:pilot:w06:T4")) { origin case_input; }
        assert "f5": verbindung_vermischung_vermengung_durch_anderen_als_erblasser_und_miteigentum_erworben_2172(entity_ref("urn:de:bgb:pilot:w06:T5")) { origin case_input; }
        assert "f6": erblasser_hat_wegnahmerecht_an_verbundener_sache_2172(entity_ref("urn:de:bgb:pilot:w06:T6")) { origin case_input; }
    }
    evaluate truth(p2166_pflicht_auf_anteiligen_teil_beschraenkt_vermutet_2167(entity_ref("urn:de:bgb:pilot:w06:T1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisnehmer_zur_gesamtgrundschuldbefriedigung_anteilig_verpflichtet_vermutet_2168(entity_ref("urn:de:bgb:pilot:w06:T2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(p2166_und_p2167_auf_2168_abs2_fall_entsprechend_anwendbar_2168(entity_ref("urn:de:bgb:pilot:w06:T3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(leistung_der_vermachten_sache_gilt_als_unmoeglich_2172(entity_ref("urn:de:bgb:pilot:w06:T4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(miteigentum_gilt_als_vermacht_vermutet_2172(entity_ref("urn:de:bgb:pilot:w06:T5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(wegnahmerecht_gilt_als_vermacht_vermutet_2172(entity_ref("urn:de:bgb:pilot:w06:T6")));
    expect truth_status == TRUE_ONLY;
}
