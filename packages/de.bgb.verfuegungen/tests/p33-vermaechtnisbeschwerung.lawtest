language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2147–2150: Beschwerter und Vorausvermächtnis" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erbe_oder_vermaechtnisnehmer_mit_vermaechtnis_beschwert_2147(entity_ref("urn:de:bgb:pilot:v33:T1"), entity_ref("urn:de:bgb:pilot:v33:A")) { origin case_input; }
        assert "f2": mehrere_erben_oder_vermaechtnisnehmer_beschwert_2148(entity_ref("urn:de:bgb:pilot:v33:T2")) { origin case_input; }
        assert "f3": eingesetzter_erbe_gegenstand_nicht_erhalten_soll_2149(entity_ref("urn:de:bgb:pilot:v33:T3")) { origin case_input; }
        assert "f4": erbe_erhaelt_vorausvermaechtnis_2150(entity_ref("urn:de:bgb:pilot:v33:T4"), entity_ref("urn:de:bgb:pilot:v33:B")) { origin case_input; }
    }
    evaluate truth(beschwerung_mit_vermaechtnis_zulaessig_2147(entity_ref("urn:de:bgb:pilot:v33:T1"), entity_ref("urn:de:bgb:pilot:v33:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(beschwerung_nach_erbteil_oder_vermaechtniswert_vermutet_2148(entity_ref("urn:de:bgb:pilot:v33:T2"))); expect truth_status == TRUE_ONLY;
    evaluate truth(gegenstand_gesetzlichen_erben_vermacht_2149(entity_ref("urn:de:bgb:pilot:v33:T3"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorausvermaechtnis_gilt_auch_bei_eigener_beschwerung_2150(entity_ref("urn:de:bgb:pilot:v33:T4"), entity_ref("urn:de:bgb:pilot:v33:B"))); expect truth_status == TRUE_ONLY;
}
