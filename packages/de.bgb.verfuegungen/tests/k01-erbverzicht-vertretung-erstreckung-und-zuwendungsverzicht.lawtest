language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2347 (persönliche Anforderungen, Vertretung — beide Alternativen),
// § 2349 (Erstreckung auf Abkömmlinge — beide Seiten der Vermutung),
// § 2350 Abs. 1, 2 (Verzicht zugunsten eines anderen — je beide Seiten),
// § 2352 (Verzicht auf Zuwendungen — beide Alternativen).
test "§§ 2347, 2349, 2350, 2352: Erbverzicht-Rest" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }

        // § 2347
        assert "k1": erblasser_beschraenkt_geschaeftsfaehig_2347(entity_ref("urn:de:bgb:pilot:k01:E1"), entity_ref("urn:de:bgb:pilot:k01:ERBLASSER1")) { origin case_input; }
        assert "k2": erblasser_geschaeftsunfaehig_2347(entity_ref("urn:de:bgb:pilot:k01:E2"), entity_ref("urn:de:bgb:pilot:k01:ERBLASSER2")) { origin case_input; }
        assert "k3": vertrag_durch_gesetzlichen_vertreter_geschlossen_2347(entity_ref("urn:de:bgb:pilot:k01:E2"), entity_ref("urn:de:bgb:pilot:k01:ERBLASSER2"), entity_ref("urn:de:bgb:pilot:k01:VERTRETER2")) { origin case_input; }

        // § 2349: mit und ohne Gegenausnahme
        assert "k4": abkoemmling_oder_seitenverwandter_verzichtet_2349(entity_ref("urn:de:bgb:pilot:k01:E3"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER3")) { origin case_input; }
        assert "k5": abkoemmling_oder_seitenverwandter_verzichtet_2349(entity_ref("urn:de:bgb:pilot:k01:E4"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER4")) { origin case_input; }
        assert "k6": anderes_zur_erstreckung_bestimmt_2349(entity_ref("urn:de:bgb:pilot:k01:E4"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER4")) { origin case_input; }

        // § 2350 Abs. 1: mit und ohne Gegenausnahme
        assert "k7": verzicht_zugunsten_eines_anderen_2350(entity_ref("urn:de:bgb:pilot:k01:E5"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER5"), entity_ref("urn:de:bgb:pilot:k01:ANDERER5")) { origin case_input; }
        assert "k8": verzicht_zugunsten_eines_anderen_2350(entity_ref("urn:de:bgb:pilot:k01:E6"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER6"), entity_ref("urn:de:bgb:pilot:k01:ANDERER6")) { origin case_input; }
        assert "k9": verzicht_ausdruecklich_auch_ohne_erbwerden_des_anderen_2350(entity_ref("urn:de:bgb:pilot:k01:E6"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER6"), entity_ref("urn:de:bgb:pilot:k01:ANDERER6")) { origin case_input; }

        // § 2350 Abs. 2: mit und ohne Gegenausnahme
        assert "k10": abkoemmling_des_erblassers_verzichtet_2350(entity_ref("urn:de:bgb:pilot:k01:E7"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER7")) { origin case_input; }
        assert "k11": abkoemmling_des_erblassers_verzichtet_2350(entity_ref("urn:de:bgb:pilot:k01:E8"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER8")) { origin case_input; }
        assert "k12": verzicht_ausdruecklich_auch_zugunsten_anderer_personen_2350(entity_ref("urn:de:bgb:pilot:k01:E8"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER8")) { origin case_input; }

        // § 2352: beide Alternativen
        assert "k13": als_erbe_eingesetzt_oder_vermaechtnisnehmer_2352(entity_ref("urn:de:bgb:pilot:k01:E9"), entity_ref("urn:de:bgb:pilot:k01:BEDACHTER9")) { origin case_input; }
        assert "k14": verzicht_auf_zuwendung_durch_vertrag_mit_erblasser_2352(entity_ref("urn:de:bgb:pilot:k01:E9"), entity_ref("urn:de:bgb:pilot:k01:BEDACHTER9"), entity_ref("urn:de:bgb:pilot:k01:ERBLASSER9")) { origin case_input; }
        assert "k15": zuwendung_an_dritten_in_erbvertrag_gemacht_2352(entity_ref("urn:de:bgb:pilot:k01:E10"), entity_ref("urn:de:bgb:pilot:k01:DRITTER10")) { origin case_input; }
        assert "k16": dritter_verzichtet_auf_zuwendung_durch_vertrag_mit_erblasser_2352(entity_ref("urn:de:bgb:pilot:k01:E10"), entity_ref("urn:de:bgb:pilot:k01:DRITTER10"), entity_ref("urn:de:bgb:pilot:k01:ERBLASSER10")) { origin case_input; }
    }

    evaluate truth(keine_zustimmung_des_gesetzlichen_vertreters_erforderlich_2347(entity_ref("urn:de:bgb:pilot:k01:E1"), entity_ref("urn:de:bgb:pilot:k01:ERBLASSER1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vertragsschluss_durch_vertreter_zulaessig_2347(entity_ref("urn:de:bgb:pilot:k01:E2"), entity_ref("urn:de:bgb:pilot:k01:ERBLASSER2"), entity_ref("urn:de:bgb:pilot:k01:VERTRETER2")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(verzicht_erstreckt_sich_auf_abkoemmlinge_2349(entity_ref("urn:de:bgb:pilot:k01:E3"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verzicht_erstreckt_sich_auf_abkoemmlinge_2349(entity_ref("urn:de:bgb:pilot:k01:E4"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER4")));
    expect truth_status == NEITHER;

    evaluate truth(verzicht_gilt_nur_fuer_fall_dass_anderer_erbe_wird_2350(entity_ref("urn:de:bgb:pilot:k01:E5"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER5"), entity_ref("urn:de:bgb:pilot:k01:ANDERER5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verzicht_gilt_nur_fuer_fall_dass_anderer_erbe_wird_2350(entity_ref("urn:de:bgb:pilot:k01:E6"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER6"), entity_ref("urn:de:bgb:pilot:k01:ANDERER6")));
    expect truth_status == NEITHER;

    evaluate truth(verzicht_gilt_nur_zugunsten_anderer_abkoemmlinge_und_ehegatten_2350(entity_ref("urn:de:bgb:pilot:k01:E7"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verzicht_gilt_nur_zugunsten_anderer_abkoemmlinge_und_ehegatten_2350(entity_ref("urn:de:bgb:pilot:k01:E8"), entity_ref("urn:de:bgb:pilot:k01:VERZICHTENDER8")));
    expect truth_status == NEITHER;

    evaluate truth(verzicht_auf_zuwendung_wirksam_2352(entity_ref("urn:de:bgb:pilot:k01:E9"), entity_ref("urn:de:bgb:pilot:k01:BEDACHTER9")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verzicht_auf_zuwendung_wirksam_2352(entity_ref("urn:de:bgb:pilot:k01:E10"), entity_ref("urn:de:bgb:pilot:k01:DRITTER10")));
    expect truth_status == TRUE_ONLY;
}
