language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2275 (Geschäftsfähigkeit), § 2276 Abs. 2 (Form durch Ehevertragsform —
// Mostbezug zu de.bgb.ehe), § 2278 Abs. 1, 2 (zulässige/unzulässige
// vertragsmäßige Verfügungen), § 2279 Abs. 1, 2 (Verweisung, § 2077 bei
// Drittbedachtem), § 2280 (§ 2269 entsprechend).
test "§§ 2275, 2276 Abs. 2, 2278–2280: Voraussetzungen, Form, zulässige Verfügungen" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erblasser_unbeschraenkt_geschaeftsfaehig_2275(entity_ref("urn:de:bgb:pilot:e10:V1"), entity_ref("urn:de:bgb:pilot:e10:E1")) { origin case_input; }
        assert "f2": erbvertrag_zwischen_ehegatten_oder_verlobten_mit_ehevertrag_verbunden_2276(entity_ref("urn:de:bgb:pilot:e10:V2"), entity_ref("urn:de:bgb:pilot:e10:EV2")) { origin case_input; }
        assert "f3": de.bgb.ehe::notarielle_niederschrift_bei_gleichzeitiger_anwesenheit(entity_ref("urn:de:bgb:pilot:e10:EV2")) { origin case_input; }
        assert "f4": vertragschliessender_trifft_vertragsmaessige_verfuegung_2278(entity_ref("urn:de:bgb:pilot:e10:V3"), entity_ref("urn:de:bgb:pilot:e10:P3")) { origin case_input; }
        assert "f5": verfuegung_weder_erbeinsetzung_noch_vermaechtnis_noch_auflage_noch_rechtswahl_2278(entity_ref("urn:de:bgb:pilot:e10:V4"), entity_ref("urn:de:bgb:pilot:e10:P4")) { origin case_input; }
        assert "f6": vertragsmaessige_zuwendung_oder_auflage_angeordnet_2279(entity_ref("urn:de:bgb:pilot:e10:V5"), entity_ref("urn:de:bgb:pilot:e10:P5")) { origin case_input; }
        assert "f7": erbvertrag_zwischen_ehegatten_lebenspartnern_verlobten_dritter_bedacht_2279(entity_ref("urn:de:bgb:pilot:e10:V6"), entity_ref("urn:de:bgb:pilot:e10:D6")) { origin case_input; }
        assert "f8": ehegatten_oder_lebenspartner_gegenseitige_einsetzung_mit_drittzuwendung_im_erbvertrag_2280(entity_ref("urn:de:bgb:pilot:e10:V7"), entity_ref("urn:de:bgb:pilot:e10:D7")) { origin case_input; }
    }
    evaluate truth(erbvertrag_voraussetzung_geschaeftsfaehigkeit_erfuellt_2275(entity_ref("urn:de:bgb:pilot:e10:V1"), entity_ref("urn:de:bgb:pilot:e10:E1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbvertragsform_durch_ehevertragsform_gewahrt_2276(entity_ref("urn:de:bgb:pilot:e10:V2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vertragsmaessige_verfuegung_zulaessig_2278(entity_ref("urn:de:bgb:pilot:e10:V3"), entity_ref("urn:de:bgb:pilot:e10:P3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vertragsmaessige_verfuegung_unzulaessig_2278(entity_ref("urn:de:bgb:pilot:e10:V4"), entity_ref("urn:de:bgb:pilot:e10:P4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(letztwillige_vorschriften_auf_vertragsmaessige_zuwendung_entsprechend_anwendbar_2279(entity_ref("urn:de:bgb:pilot:e10:V5"), entity_ref("urn:de:bgb:pilot:e10:P5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(p2077_auch_fuer_drittbedachten_anwendbar_2279(entity_ref("urn:de:bgb:pilot:e10:V6"), entity_ref("urn:de:bgb:pilot:e10:D6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(p2269_auf_erbvertrag_entsprechend_anwendbar_2280(entity_ref("urn:de:bgb:pilot:e10:V7"), entity_ref("urn:de:bgb:pilot:e10:D7")));
    expect truth_status == TRUE_ONLY;
}
