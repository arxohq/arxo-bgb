language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 1931 Abs. 4, § 2303: Gütertrennung, Ehegatte und zwei Kinder zu je 1/3; C1 durch Testament ausgeschlossen — Quote 1/6 von 100.000 € = 16.666,67 € (einmal auf den Cent gerundet, Politik des Pakets).
test "§ 2303: Pflichtteil bei Drittelquote — Rundung auf den Cent" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": de.bgb.erbfolge::erblasser(entity_ref("urn:de:bgb:pilot:v02:E"), entity_ref("urn:de:bgb:pilot:v02:D")) { origin case_input; }
        assert "f2": de.bgb.erbfolge::erbfall_am(entity_ref("urn:de:bgb:pilot:v02:E"), @2026-03-01) { origin case_input; }
        assert "f3": de.bgb.erbfolge::familie(entity_ref("urn:de:bgb:pilot:v02:E"), entity_ref("urn:de:bgb:pilot:v02:F")) { origin case_input; }
        assert "f4": de.bgb.erbfolge::ehe_beim_erbfall(entity_ref("urn:de:bgb:pilot:v02:E"), entity_ref("urn:de:bgb:pilot:v02:EHE")) { origin case_input; }
        assert "f5": de.bgb.ehe::ehegatten(entity_ref("urn:de:bgb:pilot:v02:EHE"), entity_ref("urn:de:bgb:pilot:v02:D"), entity_ref("urn:de:bgb:pilot:v02:S")) { origin case_input; }
        assert "f6": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:v02:E"), entity_ref("urn:de:bgb:pilot:v02:S")) { origin case_input; }
        assert "f7": de.bgb.ehe::ehevertrag_gueterstand(entity_ref("urn:de:bgb:pilot:v02:EHE"), de.bgb.ehe::Guetertrennung) { origin case_input; }
        assert "f10": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:pilot:v02:F"), entity_ref("urn:de:bgb:pilot:v02:D"), entity_ref("urn:de:bgb:pilot:v02:C1")) { origin case_input; }
        assert "f11": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:pilot:v02:F"), entity_ref("urn:de:bgb:pilot:v02:D"), entity_ref("urn:de:bgb:pilot:v02:C2")) { origin case_input; }
        assert "f12": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:v02:E"), entity_ref("urn:de:bgb:pilot:v02:C1")) { origin case_input; }
        assert "f13": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:v02:E"), entity_ref("urn:de:bgb:pilot:v02:C2")) { origin case_input; }
        assert "f14": durch_verfuegung_von_todes_wegen_ausgeschlossen(entity_ref("urn:de:bgb:pilot:v02:E"), entity_ref("urn:de:bgb:pilot:v02:C1")) { origin case_input; }
        assert "f15": nachlasswert(entity_ref("urn:de:bgb:pilot:v02:E"), 100000.00 EUR) { origin case_input; }
    }
    evaluate truth(pflichtteilsquote(entity_ref("urn:de:bgb:pilot:v02:E"), entity_ref("urn:de:bgb:pilot:v02:C1"), 1 / 6));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pflichtteil(entity_ref("urn:de:bgb:pilot:v02:E"), entity_ref("urn:de:bgb:pilot:v02:C1"), 16666.67 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pflichtteil(entity_ref("urn:de:bgb:pilot:v02:E"), entity_ref("urn:de:bgb:pilot:v02:C2"), 16666.67 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
