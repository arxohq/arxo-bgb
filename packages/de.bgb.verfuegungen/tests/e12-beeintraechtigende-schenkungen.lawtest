language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2287 Abs. 1, 2 (Herausgabe nach Bereicherungsrecht, Verjährungsbeginn
// mit Erbfall), § 2288 Abs. 1, 2 (Wertersatz, Verschaffung/Beseitigung,
// Anspruch gegen Beschenkten), § 2289 Abs. 1, 2 (frühere Verfügung
// aufgehoben, spätere unwirksam, § 2338-Anordnung bei Abkömmling).
test "§§ 2287–2289: beeinträchtigende Schenkungen und Wirkung auf letztwillige Verfügungen" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erblasser_beeintraechtigt_vertragserben_durch_schenkung_2287(entity_ref("urn:de:bgb:pilot:e12:V1"), entity_ref("urn:de:bgb:pilot:e12:VE1"), entity_ref("urn:de:bgb:pilot:e12:S1"), entity_ref("urn:de:bgb:pilot:e12:B1")) { origin case_input; }
        assert "f2": erbfall_am_fuer_2287_anspruch_2287(entity_ref("urn:de:bgb:pilot:e12:V2"), entity_ref("urn:de:bgb:pilot:e12:E2"), @2026-03-01) { origin case_input; }
        assert "f3": erblasser_zerstoert_beschaedigt_vermaechtnisgegenstand_beeintraechtigungsabsicht_erbe_ausserstande_2288(entity_ref("urn:de:bgb:pilot:e12:V3"), entity_ref("urn:de:bgb:pilot:e12:ER3"), entity_ref("urn:de:bgb:pilot:e12:BD3")) { origin case_input; }
        assert "f4": erblasser_veraeussert_oder_belastet_vermaechtnisgegenstand_beeintraechtigungsabsicht_2288(entity_ref("urn:de:bgb:pilot:e12:V4"), entity_ref("urn:de:bgb:pilot:e12:ER4"), entity_ref("urn:de:bgb:pilot:e12:BD4")) { origin case_input; }
        assert "f5": veraeusserung_oder_belastung_schenkweise_erblasser_ersatz_von_erben_nicht_erlangbar_2288(entity_ref("urn:de:bgb:pilot:e12:V5"), entity_ref("urn:de:bgb:pilot:e12:BD5"), entity_ref("urn:de:bgb:pilot:e12:BS5")) { origin case_input; }
        assert "f6": vertragsmaessige_zuwendung_beeintraechtigt_fruehere_letztwillige_verfuegung_2289(entity_ref("urn:de:bgb:pilot:e12:V6"), entity_ref("urn:de:bgb:pilot:e12:BD6")) { origin case_input; }
        assert "f7": spaetere_verfuegung_von_todes_wegen_beeintraechtigt_ohne_2297_2289(entity_ref("urn:de:bgb:pilot:e12:V7"), entity_ref("urn:de:bgb:pilot:e12:BD7")) { origin case_input; }
        assert "f8": bedachter_pflichtteilsberechtigter_abkoemmling_2289(entity_ref("urn:de:bgb:pilot:e12:V8"), entity_ref("urn:de:bgb:pilot:e12:BD8")) { origin case_input; }
    }
    evaluate truth(herausgabe_nach_bereicherungsrecht_forderbar_2287(entity_ref("urn:de:bgb:pilot:e12:V1"), entity_ref("urn:de:bgb:pilot:e12:VE1"), entity_ref("urn:de:bgb:pilot:e12:B1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verjaehrungsbeginn_2287_anspruch(entity_ref("urn:de:bgb:pilot:e12:V2"), @2026-03-01));
    expect truth_status == TRUE_ONLY;
    evaluate truth(wert_tritt_an_stelle_des_gegenstands_2288(entity_ref("urn:de:bgb:pilot:e12:V3"), entity_ref("urn:de:bgb:pilot:e12:BD3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbe_zur_verschaffung_oder_beseitigung_verpflichtet_2288(entity_ref("urn:de:bgb:pilot:e12:V4"), entity_ref("urn:de:bgb:pilot:e12:ER4"), entity_ref("urn:de:bgb:pilot:e12:BD4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anspruch_gegen_beschenkten_wie_2287_2288(entity_ref("urn:de:bgb:pilot:e12:V5"), entity_ref("urn:de:bgb:pilot:e12:BD5"), entity_ref("urn:de:bgb:pilot:e12:BS5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(fruehere_letztwillige_verfuegung_insoweit_aufgehoben_2289(entity_ref("urn:de:bgb:pilot:e12:V6"), entity_ref("urn:de:bgb:pilot:e12:BD6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(spaetere_verfuegung_unwirksam_2289(entity_ref("urn:de:bgb:pilot:e12:V7"), entity_ref("urn:de:bgb:pilot:e12:BD7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(p2338_anordnungen_durch_spaetere_letztwillige_verfuegung_zulaessig_2289(entity_ref("urn:de:bgb:pilot:e12:V8"), entity_ref("urn:de:bgb:pilot:e12:BD8")));
    expect truth_status == TRUE_ONLY;
}
