language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2323, 2324: nicht belasteter Erbe und abweichende Anordnung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erbe_traegt_pflichtteilslast_nicht_2323(entity_ref("urn:de:bgb:pilot:v14:E"), entity_ref("urn:de:bgb:pilot:v14:H"), entity_ref("urn:de:bgb:pilot:v14:L")) { origin case_input; }
        assert "f2": abweichende_anordnung_pflichtteilslast_2324(entity_ref("urn:de:bgb:pilot:v14:E"), entity_ref("urn:de:bgb:pilot:v14:A"), entity_ref("urn:de:bgb:pilot:v14:L")) { origin case_input; }
    }
    evaluate truth(erfuellung_nicht_wegen_2318_verweigerbar_2323(entity_ref("urn:de:bgb:pilot:v14:E"), entity_ref("urn:de:bgb:pilot:v14:H"), entity_ref("urn:de:bgb:pilot:v14:L")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(abweichende_anordnung_pflichtteilslast_zulaessig_2324(entity_ref("urn:de:bgb:pilot:v14:E"), entity_ref("urn:de:bgb:pilot:v14:A"), entity_ref("urn:de:bgb:pilot:v14:L")));
    expect truth_status == TRUE_ONLY;
}
