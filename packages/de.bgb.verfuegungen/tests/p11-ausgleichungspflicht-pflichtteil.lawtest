language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§ 2316: Ausgleichung, Mehrbetrag und halber Anrechnungswert" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": abkoemmling_mehrere_2316(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:P")) { origin case_input; }
        assert "f2": ausgleichung_bei_teilung_2316_zu_beruecksichtigen(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:P")) { origin case_input; }
        assert "f3": gesetzlicher_erbteilwert_nach_ausgleichung_2316(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:P"), 60000.00 EUR) { origin case_input; }
        assert "f4": pflichtteilsberechtigter_ist_erbe_2316(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:P")) { origin case_input; }
        assert "f5": hinterlassener_erbteil_wert_2316(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:P"), 25000.00 EUR) { origin case_input; }
        assert "f6": abkoemmling_durch_erbverzicht_ausgeschlossen_2316(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:V")) { origin case_input; }
        assert "f7": zuwendung_unter_leben_2315(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:P"), entity_ref("urn:de:bgb:pilot:v11:Z")) { origin case_input; }
        assert "f8": anrechnung_auf_pflichtteil_bestimmt_2315(entity_ref("urn:de:bgb:pilot:v11:Z")) { origin case_input; }
        assert "f9": wert_zuwendung_zeit_leistung_2315(entity_ref("urn:de:bgb:pilot:v11:Z"), 10000.00 EUR) { origin case_input; }
        assert "f10": zuwendung_2050_abs1_2316(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:P"), entity_ref("urn:de:bgb:pilot:v11:Z")) { origin case_input; }
        assert "f11": beruecksichtigung_ausgeschlossen_2316(entity_ref("urn:de:bgb:pilot:v11:Z")) { origin case_input; }
    }
    evaluate truth(pflichtteil_nach_ausgleichung_2316(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:P"), 30000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(mehrbetrag_als_pflichtteil_verlangbar_2316(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:P"), 5000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(abkoemmling_bei_ausgleichungsberechnung_ausser_betracht_2316(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(beruecksichtigungsausschluss_unwirksam_gegen_pflichtteilsberechtigten_2316(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:P"), entity_ref("urn:de:bgb:pilot:v11:Z")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anrechnungswert_haelfte_2316(entity_ref("urn:de:bgb:pilot:v11:E"), entity_ref("urn:de:bgb:pilot:v11:P"), entity_ref("urn:de:bgb:pilot:v11:Z"), 5000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
