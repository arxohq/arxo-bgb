language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2133 (Fruchtziehung — beide Seiten der Wiederherstellungs-Gegenausnahme),
// § 2135 (Eintritt des Nacherben in Miet-/Pachtverhältnis), § 2348 (Form —
// eigener Zeuge).
test "§§ 2133, 2135, 2348: Fruchtziehung, Mietverhältnis, Erbverzichtsform" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }

        // § 2133: mit und ohne Wiederherstellungs-Gegenausnahme
        assert "n1": vorerbe_zieht_fruechte_ordnungswidrig_oder_uebermaessig_2133(entity_ref("urn:de:bgb:pilot:n01:T1"), entity_ref("urn:de:bgb:pilot:n01:VORERBE1")) { origin case_input; }
        assert "n2": eigene_nutzungen_des_vorerben_beeintraechtigt_2133(entity_ref("urn:de:bgb:pilot:n01:T1"), entity_ref("urn:de:bgb:pilot:n01:VORERBE1")) { origin case_input; }

        assert "n3": vorerbe_zieht_fruechte_ordnungswidrig_oder_uebermaessig_2133(entity_ref("urn:de:bgb:pilot:n01:T2"), entity_ref("urn:de:bgb:pilot:n01:VORERBE2")) { origin case_input; }
        assert "n4": eigene_nutzungen_des_vorerben_beeintraechtigt_2133(entity_ref("urn:de:bgb:pilot:n01:T2"), entity_ref("urn:de:bgb:pilot:n01:VORERBE2")) { origin case_input; }
        assert "n5": wert_der_fruechte_zur_wiederherstellung_zu_verwenden_2133(entity_ref("urn:de:bgb:pilot:n01:T2"), entity_ref("urn:de:bgb:pilot:n01:VORERBE2")) { origin case_input; }

        // § 2135
        assert "n6": vorerbe_vermietet_oder_verpachtet_grundstueck_oder_schiff_2135(entity_ref("urn:de:bgb:pilot:n01:T3"), entity_ref("urn:de:bgb:pilot:n01:VORERBE3"), entity_ref("urn:de:bgb:pilot:n01:MIETER3")) { origin case_input; }
        assert "n7": mietverhaeltnis_besteht_bei_eintritt_der_nacherbfolge_2135(entity_ref("urn:de:bgb:pilot:n01:T3"), entity_ref("urn:de:bgb:pilot:n01:VORERBE3"), entity_ref("urn:de:bgb:pilot:n01:MIETER3")) { origin case_input; }
        assert "n8": nacherbe_bei_eintritt_2135(entity_ref("urn:de:bgb:pilot:n01:T3"), entity_ref("urn:de:bgb:pilot:n01:NACHERBE3")) { origin case_input; }

        // § 2348
        assert "n9": erbverzicht_notariell_beurkundet(entity_ref("urn:de:bgb:pilot:n01:E4"), entity_ref("urn:de:bgb:pilot:n01:P4")) { origin case_input; }
    }

    evaluate truth(wert_der_fruechte_gebuehrt_vorerben_beschraenkt_2133(entity_ref("urn:de:bgb:pilot:n01:T1"), entity_ref("urn:de:bgb:pilot:n01:VORERBE1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(wert_der_fruechte_gebuehrt_vorerben_beschraenkt_2133(entity_ref("urn:de:bgb:pilot:n01:T2"), entity_ref("urn:de:bgb:pilot:n01:VORERBE2")));
    expect truth_status == NEITHER;

    evaluate truth(nacherbe_tritt_entsprechend_1056_in_mietverhaeltnis_ein_2135(entity_ref("urn:de:bgb:pilot:n01:T3"), entity_ref("urn:de:bgb:pilot:n01:NACHERBE3"), entity_ref("urn:de:bgb:pilot:n01:MIETER3")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(erbverzichtsvertrag_form_gewahrt_2348(entity_ref("urn:de:bgb:pilot:n01:E4"), entity_ref("urn:de:bgb:pilot:n01:P4")));
    expect truth_status == TRUE_ONLY;
}
