language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2366 (öffentlicher Glaube — beide Gegenausnahmen, jede einzeln
// bezeugt), § 2367 (entsprechende Anwendung — beide Alternativen), § 2368
// (Testamentsvollstreckerzeugnis — Erteilung und Kraftloswerden), § 2370
// (Todeserklärung — Abs. 1 mit Gegenausnahme, Abs. 2 beide Sätze).
test "§§ 2366–2368, 2370: öffentlicher Glaube, Zeugnis, Todeserklärung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }

        // § 2366: gutgläubig / kennt Unrichtigkeit / weiß von Rückgabeverlangen
        assert "j1": im_erbschein_als_erbe_bezeichnet(entity_ref("urn:de:bgb:pilot:i02:S1"), entity_ref("urn:de:bgb:pilot:i02:ERBSCHEINSERBE1")) { origin case_input; }
        assert "j2": dritter_erwirbt_durch_rechtsgeschaeft_von_erbscheinserben_2366(entity_ref("urn:de:bgb:pilot:i02:S1"), entity_ref("urn:de:bgb:pilot:i02:DRITTER1"), entity_ref("urn:de:bgb:pilot:i02:ERBSCHEINSERBE1")) { origin case_input; }

        assert "j3": im_erbschein_als_erbe_bezeichnet(entity_ref("urn:de:bgb:pilot:i02:S2"), entity_ref("urn:de:bgb:pilot:i02:ERBSCHEINSERBE2")) { origin case_input; }
        assert "j4": dritter_erwirbt_durch_rechtsgeschaeft_von_erbscheinserben_2366(entity_ref("urn:de:bgb:pilot:i02:S2"), entity_ref("urn:de:bgb:pilot:i02:DRITTER2"), entity_ref("urn:de:bgb:pilot:i02:ERBSCHEINSERBE2")) { origin case_input; }
        assert "j5": dritter_kennt_unrichtigkeit_2366(entity_ref("urn:de:bgb:pilot:i02:S2"), entity_ref("urn:de:bgb:pilot:i02:DRITTER2")) { origin case_input; }

        assert "j6": im_erbschein_als_erbe_bezeichnet(entity_ref("urn:de:bgb:pilot:i02:S3"), entity_ref("urn:de:bgb:pilot:i02:ERBSCHEINSERBE3")) { origin case_input; }
        assert "j7": dritter_erwirbt_durch_rechtsgeschaeft_von_erbscheinserben_2366(entity_ref("urn:de:bgb:pilot:i02:S3"), entity_ref("urn:de:bgb:pilot:i02:DRITTER3"), entity_ref("urn:de:bgb:pilot:i02:ERBSCHEINSERBE3")) { origin case_input; }
        assert "j8": dritter_weiss_von_rueckgabeverlangen_des_nachlassgerichts_2366(entity_ref("urn:de:bgb:pilot:i02:S3"), entity_ref("urn:de:bgb:pilot:i02:DRITTER3")) { origin case_input; }

        // § 2367: beide Alternativen (Leistung / Verfügungsgeschäft)
        assert "j9": im_erbschein_als_erbe_bezeichnet(entity_ref("urn:de:bgb:pilot:i02:S4"), entity_ref("urn:de:bgb:pilot:i02:ERBSCHEINSERBE4")) { origin case_input; }
        assert "j10": leistung_an_erbscheinserben_bewirkt_2367(entity_ref("urn:de:bgb:pilot:i02:S4"), entity_ref("urn:de:bgb:pilot:i02:ERBSCHEINSERBE4"), entity_ref("urn:de:bgb:pilot:i02:LEISTENDER4")) { origin case_input; }

        assert "j11": im_erbschein_als_erbe_bezeichnet(entity_ref("urn:de:bgb:pilot:i02:S5"), entity_ref("urn:de:bgb:pilot:i02:ERBSCHEINSERBE5")) { origin case_input; }
        assert "j12": rechtsgeschaeft_mit_verfuegung_zwischen_erbscheinserbe_und_anderem_2367(entity_ref("urn:de:bgb:pilot:i02:S5"), entity_ref("urn:de:bgb:pilot:i02:ERBSCHEINSERBE5"), entity_ref("urn:de:bgb:pilot:i02:ANDERER5")) { origin case_input; }

        // § 2368
        assert "j13": tv_beantragt_zeugnis_2368(entity_ref("urn:de:bgb:pilot:i02:E1"), entity_ref("urn:de:bgb:pilot:i02:TV1")) { origin case_input; }
        assert "j14": amt_des_tv_beendet_2368(entity_ref("urn:de:bgb:pilot:i02:E2"), entity_ref("urn:de:bgb:pilot:i02:TV2")) { origin case_input; }

        // § 2370 Abs. 1: gutgläubig / Kenntnis der Unrichtigkeit
        assert "j15": person_fuer_tot_erklaert_oder_todeszeit_festgestellt_2370(entity_ref("urn:de:bgb:pilot:i02:E3"), entity_ref("urn:de:bgb:pilot:i02:P3")) { origin case_input; }
        assert "j16": person_hat_massgeblichen_zeitpunkt_ueberlebt_oder_ist_vorher_gestorben_2370(entity_ref("urn:de:bgb:pilot:i02:E3"), entity_ref("urn:de:bgb:pilot:i02:P3")) { origin case_input; }
        assert "j17": erbe_kraft_todeserklaerung_2370(entity_ref("urn:de:bgb:pilot:i02:E3"), entity_ref("urn:de:bgb:pilot:i02:P3")) { origin case_input; }
        assert "j18": dritter_bei_todeserklaerung_2370(entity_ref("urn:de:bgb:pilot:i02:E3"), entity_ref("urn:de:bgb:pilot:i02:DRITTER6")) { origin case_input; }

        assert "j19": person_fuer_tot_erklaert_oder_todeszeit_festgestellt_2370(entity_ref("urn:de:bgb:pilot:i02:E4"), entity_ref("urn:de:bgb:pilot:i02:P4")) { origin case_input; }
        assert "j20": person_hat_massgeblichen_zeitpunkt_ueberlebt_oder_ist_vorher_gestorben_2370(entity_ref("urn:de:bgb:pilot:i02:E4"), entity_ref("urn:de:bgb:pilot:i02:P4")) { origin case_input; }
        assert "j21": erbe_kraft_todeserklaerung_2370(entity_ref("urn:de:bgb:pilot:i02:E4"), entity_ref("urn:de:bgb:pilot:i02:P4")) { origin case_input; }
        assert "j22": dritter_bei_todeserklaerung_2370(entity_ref("urn:de:bgb:pilot:i02:E4"), entity_ref("urn:de:bgb:pilot:i02:DRITTER7")) { origin case_input; }
        assert "j23": dritter_kennt_unrichtigkeit_der_todeserklaerung_2370(entity_ref("urn:de:bgb:pilot:i02:E4"), entity_ref("urn:de:bgb:pilot:i02:DRITTER7")) { origin case_input; }

        // § 2370 Abs. 2: beide Sätze
        assert "j24": erbschein_erteilt_2370(entity_ref("urn:de:bgb:pilot:i02:S6")) { origin case_input; }
        assert "j25": fuer_tot_erklaerter_lebt_noch_2370(entity_ref("urn:de:bgb:pilot:i02:E5"), entity_ref("urn:de:bgb:pilot:i02:P5")) { origin case_input; }
        assert "j26": tod_ohne_todeserklaerung_mit_unrecht_angenommen_2370(entity_ref("urn:de:bgb:pilot:i02:E6"), entity_ref("urn:de:bgb:pilot:i02:P6")) { origin case_input; }
    }

    evaluate truth(erbscheinsinhalt_gilt_zugunsten_dritten_als_richtig_2366(entity_ref("urn:de:bgb:pilot:i02:S1"), entity_ref("urn:de:bgb:pilot:i02:DRITTER1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbscheinsinhalt_gilt_zugunsten_dritten_als_richtig_2366(entity_ref("urn:de:bgb:pilot:i02:S2"), entity_ref("urn:de:bgb:pilot:i02:DRITTER2")));
    expect truth_status == NEITHER;
    evaluate truth(erbscheinsinhalt_gilt_zugunsten_dritten_als_richtig_2366(entity_ref("urn:de:bgb:pilot:i02:S3"), entity_ref("urn:de:bgb:pilot:i02:DRITTER3")));
    expect truth_status == NEITHER;

    evaluate truth(erbscheinsinhalt_gilt_zugunsten_dritten_als_richtig_2366(entity_ref("urn:de:bgb:pilot:i02:S4"), entity_ref("urn:de:bgb:pilot:i02:LEISTENDER4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbscheinsinhalt_gilt_zugunsten_dritten_als_richtig_2366(entity_ref("urn:de:bgb:pilot:i02:S5"), entity_ref("urn:de:bgb:pilot:i02:ANDERER5")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(zeugnis_ueber_ernennung_zu_erteilen_2368(entity_ref("urn:de:bgb:pilot:i02:E1"), entity_ref("urn:de:bgb:pilot:i02:TV1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zeugnis_mit_amtsbeendigung_kraftlos_2368(entity_ref("urn:de:bgb:pilot:i02:E2"), entity_ref("urn:de:bgb:pilot:i02:TV2")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(gilt_ohne_erbschein_als_erbe_zugunsten_dritten_2370(entity_ref("urn:de:bgb:pilot:i02:E3"), entity_ref("urn:de:bgb:pilot:i02:P3"), entity_ref("urn:de:bgb:pilot:i02:DRITTER6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(gilt_ohne_erbschein_als_erbe_zugunsten_dritten_2370(entity_ref("urn:de:bgb:pilot:i02:E4"), entity_ref("urn:de:bgb:pilot:i02:P4"), entity_ref("urn:de:bgb:pilot:i02:DRITTER7")));
    expect truth_status == NEITHER;

    evaluate truth(hat_die_rechte_des_2362_2370(entity_ref("urn:de:bgb:pilot:i02:E5"), entity_ref("urn:de:bgb:pilot:i02:P5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(hat_die_rechte_des_2362_2370(entity_ref("urn:de:bgb:pilot:i02:E6"), entity_ref("urn:de:bgb:pilot:i02:P6")));
    expect truth_status == TRUE_ONLY;
}
