language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§ 2337: Verzeihung beendet Entziehungsrecht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": entziehungsberechtigter_verzeiht_2337(entity_ref("urn:de:bgb:pilot:v20:E"), entity_ref("urn:de:bgb:pilot:v20:P")) { origin case_input; }
        assert "f2": entziehung_durch_verfuegung_2336(entity_ref("urn:de:bgb:pilot:v20:E"), entity_ref("urn:de:bgb:pilot:v20:P")) { origin case_input; }
    }
    evaluate truth(recht_zur_entziehung_erloschen_2337(entity_ref("urn:de:bgb:pilot:v20:E"), entity_ref("urn:de:bgb:pilot:v20:P")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(entziehungsverfuegung_unwirksam_durch_verzeihung_2337(entity_ref("urn:de:bgb:pilot:v20:E"), entity_ref("urn:de:bgb:pilot:v20:P")));
    expect truth_status == TRUE_ONLY;
}
