language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2087–2093: Erbeinsetzung und Bruchteile" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": vermoegen_oder_vermoegensbruchteil_zugewendet_2087(entity_ref("urn:de:bgb:pilot:v25:T1"), entity_ref("urn:de:bgb:pilot:v25:A")) { origin case_input; }
        assert "f2": einzelne_gegenstaende_zugewendet_2087(entity_ref("urn:de:bgb:pilot:v25:T2"), entity_ref("urn:de:bgb:pilot:v25:B")) { origin case_input; }
        assert "f3": einzelner_erbe_auf_bruchteil_eingesetzt_2088(entity_ref("urn:de:bgb:pilot:v25:T3"), entity_ref("urn:de:bgb:pilot:v25:C"), 1, 2) { origin case_input; }
        assert "f4": eingesetzte_sollen_alleinige_erben_sein_2089(entity_ref("urn:de:bgb:pilot:v25:T4")) { origin case_input; }
        assert "f5": bruchteile_erschoepfen_nicht_2089(entity_ref("urn:de:bgb:pilot:v25:T4")) { origin case_input; }
        assert "f6": eingesetzte_bruchteile_uebersteigen_ganzes_2090(entity_ref("urn:de:bgb:pilot:v25:T5")) { origin case_input; }
        assert "f7": mehrere_erben_ohne_erbteilbestimmung_2091(entity_ref("urn:de:bgb:pilot:v25:T6")) { origin case_input; }
        assert "f8": erbe_ohne_erbteilbestimmung_eingesetzt_2091(entity_ref("urn:de:bgb:pilot:v25:T6"), entity_ref("urn:de:bgb:pilot:v25:D")) { origin case_input; }
        assert "f9": bruchteilserben_und_unbestimmte_erben_2092(entity_ref("urn:de:bgb:pilot:v25:T7")) { origin case_input; }
        assert "f10": erbe_ohne_bruchteil_eingesetzt_2092(entity_ref("urn:de:bgb:pilot:v25:T7"), entity_ref("urn:de:bgb:pilot:v25:E")) { origin case_input; }
        assert "f11": gemeinschaftlicher_erbteil_eingesetzt_2093(entity_ref("urn:de:bgb:pilot:v25:T8")) { origin case_input; }
    }
    evaluate truth(zuwendung_als_erbeinsetzung_anzusehen_2087(entity_ref("urn:de:bgb:pilot:v25:T1"), entity_ref("urn:de:bgb:pilot:v25:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(gegenstandszuwendung_nicht_als_erbeinsetzung_vermutet_2087(entity_ref("urn:de:bgb:pilot:v25:T2"), entity_ref("urn:de:bgb:pilot:v25:B"))); expect truth_status == TRUE_ONLY;
    evaluate truth(rest_erbschaft_gesetzliche_erbfolge_2088(entity_ref("urn:de:bgb:pilot:v25:T3"))); expect truth_status == TRUE_ONLY;
    evaluate truth(bruchteile_verhaeltnismaessig_erhoeht_2089(entity_ref("urn:de:bgb:pilot:v25:T4"))); expect truth_status == TRUE_ONLY;
    evaluate truth(bruchteile_verhaeltnismaessig_gemindert_2090(entity_ref("urn:de:bgb:pilot:v25:T5"))); expect truth_status == TRUE_ONLY;
    evaluate truth(erbe_zu_gleichen_teilen_eingesetzt_2091(entity_ref("urn:de:bgb:pilot:v25:T6"), entity_ref("urn:de:bgb:pilot:v25:D"))); expect truth_status == TRUE_ONLY;
    evaluate truth(unbestimmter_erbe_erhaelt_freigebliebenen_teil_2092(entity_ref("urn:de:bgb:pilot:v25:T7"), entity_ref("urn:de:bgb:pilot:v25:E"))); expect truth_status == TRUE_ONLY;
    evaluate truth(regeln_2089_bis_2092_auf_gemeinschaftlichen_erbteil_anwendbar_2093(entity_ref("urn:de:bgb:pilot:v25:T8"))); expect truth_status == TRUE_ONLY;
}
