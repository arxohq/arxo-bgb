language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2213 Abs. 3 (Duldung der Zwangsvollstreckung), § 2215 Abs. 1, 4, 5
// (Verzeichnis, amtliche Aufnahme, Kosten), § 2216 Abs. 1, 2 (ordnungsmäßige
// Verwaltung, Anordnungen), § 2217 Abs. 1, 2 (Überlassung), § 2218 Abs. 2
// (jährliche Rechnungslegung), § 2219 Abs. 1, 2 (Haftung gegenüber Erbe und
// Vermächtnisnehmer, Gesamtschuld), § 2220 (zwingendes Recht).
test "§§ 2213 Abs. 3, 2215–2220: Verzeichnis, Verwaltung, Rechnungslegung, Haftung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": glaeubiger_macht_anspruch_gegen_erben_geltend_2213(entity_ref("urn:de:bgb:pilot:x04:T1"), entity_ref("urn:de:bgb:pilot:x04:E1"), entity_ref("urn:de:bgb:pilot:x04:V1")) { origin case_input; }
        assert "f2": vollstrecker_hat_amt_angenommen_2215(entity_ref("urn:de:bgb:pilot:x04:T2"), entity_ref("urn:de:bgb:pilot:x04:V2"), entity_ref("urn:de:bgb:pilot:x04:E2")) { origin case_input; }
        assert "f3": erbe_verlangt_amtliche_aufnahme_des_verzeichnisses_2215(entity_ref("urn:de:bgb:pilot:x04:T2"), entity_ref("urn:de:bgb:pilot:x04:V2"), entity_ref("urn:de:bgb:pilot:x04:E2")) { origin case_input; }
        assert "f4": vollstrecker_verwaltet_nachlass_2216(entity_ref("urn:de:bgb:pilot:x04:T3"), entity_ref("urn:de:bgb:pilot:x04:V3")) { origin case_input; }
        assert "f5": erblasser_hat_verwaltungsanordnungen_getroffen_2216(entity_ref("urn:de:bgb:pilot:x04:T3"), entity_ref("urn:de:bgb:pilot:x04:V3")) { origin case_input; }
        assert "f6": gegenstand_offenbar_nicht_zur_erfuellung_der_obliegenheiten_benoetigt_und_erbe_verlangt_2217(entity_ref("urn:de:bgb:pilot:x04:T4"), entity_ref("urn:de:bgb:pilot:x04:V4"), entity_ref("urn:de:bgb:pilot:x04:E4")) { origin case_input; }
        assert "f7": laenger_dauernde_verwaltung_2218(entity_ref("urn:de:bgb:pilot:x04:T5"), entity_ref("urn:de:bgb:pilot:x04:V5"), entity_ref("urn:de:bgb:pilot:x04:E5")) { origin case_input; }
        assert "f8": vollstrecker_verletzt_pflicht_schuldhaft_2219(entity_ref("urn:de:bgb:pilot:x04:T6"), entity_ref("urn:de:bgb:pilot:x04:V6")) { origin case_input; }
        assert "f9": erbe_des_nachlasses_2206(entity_ref("urn:de:bgb:pilot:x04:T6"), entity_ref("urn:de:bgb:pilot:x04:V6"), entity_ref("urn:de:bgb:pilot:x04:E6")) { origin case_input; }
        assert "f10": vermaechtnis_zu_vollziehen_2219(entity_ref("urn:de:bgb:pilot:x04:T6"), entity_ref("urn:de:bgb:pilot:x04:V6"), entity_ref("urn:de:bgb:pilot:x04:VN6")) { origin case_input; }
        assert "f11": mehrere_vollstrecker_schuldhaft_2219(entity_ref("urn:de:bgb:pilot:x04:T7")) { origin case_input; }
        assert "f12": erblasser_versucht_befreiung_von_2215_2216_2218_2219_pflichten_2220(entity_ref("urn:de:bgb:pilot:x04:T8"), entity_ref("urn:de:bgb:pilot:x04:V8")) { origin case_input; }
    }
    evaluate truth(duldung_der_zwangsvollstreckung_vom_vollstrecker_verlangbar_2213(entity_ref("urn:de:bgb:pilot:x04:T1"), entity_ref("urn:de:bgb:pilot:x04:V1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(nachlassverzeichnis_geschuldet_2215(entity_ref("urn:de:bgb:pilot:x04:T2"), entity_ref("urn:de:bgb:pilot:x04:V2"), entity_ref("urn:de:bgb:pilot:x04:E2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(amtliche_aufnahme_geschuldet_2215(entity_ref("urn:de:bgb:pilot:x04:T2"), entity_ref("urn:de:bgb:pilot:x04:V2"), entity_ref("urn:de:bgb:pilot:x04:E2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kosten_der_aufnahme_treffen_nachlass_2215(entity_ref("urn:de:bgb:pilot:x04:T2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ordnungsmaessige_verwaltung_geschuldet_2216(entity_ref("urn:de:bgb:pilot:x04:T3"), entity_ref("urn:de:bgb:pilot:x04:V3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anordnungen_zu_befolgen_2216(entity_ref("urn:de:bgb:pilot:x04:T3"), entity_ref("urn:de:bgb:pilot:x04:V3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ueberlassung_geschuldet_und_verwaltungsrecht_erlischt_2217(entity_ref("urn:de:bgb:pilot:x04:T4"), entity_ref("urn:de:bgb:pilot:x04:V4"), entity_ref("urn:de:bgb:pilot:x04:E4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(jaehrliche_rechnungslegung_verlangbar_2218(entity_ref("urn:de:bgb:pilot:x04:T5"), entity_ref("urn:de:bgb:pilot:x04:V5"), entity_ref("urn:de:bgb:pilot:x04:E5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vollstrecker_haftet_erben_2219(entity_ref("urn:de:bgb:pilot:x04:T6"), entity_ref("urn:de:bgb:pilot:x04:V6"), entity_ref("urn:de:bgb:pilot:x04:E6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vollstrecker_haftet_auch_vermaechtnisnehmer_2219(entity_ref("urn:de:bgb:pilot:x04:T6"), entity_ref("urn:de:bgb:pilot:x04:V6"), entity_ref("urn:de:bgb:pilot:x04:VN6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(gesamtschuldnerische_haftung_2219(entity_ref("urn:de:bgb:pilot:x04:T7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(befreiung_unwirksam_2220(entity_ref("urn:de:bgb:pilot:x04:T8"), entity_ref("urn:de:bgb:pilot:x04:V8")));
    expect truth_status == TRUE_ONLY;
}
