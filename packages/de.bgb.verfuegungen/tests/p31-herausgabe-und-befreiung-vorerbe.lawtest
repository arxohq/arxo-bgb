language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2130–2140: Herausgabe, Befreiung und Eintritt der Nacherbfolge" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": nacherbfolge_eingetreten_2130(entity_ref("urn:de:bgb:pilot:v31:T1"), entity_ref("urn:de:bgb:pilot:v31:A")) { origin case_input; }
        assert "f2": nacherbe_verlangt_rechenschaft_2130(entity_ref("urn:de:bgb:pilot:v31:T1"), entity_ref("urn:de:bgb:pilot:v31:A")) { origin case_input; }
        assert "f3": vorerbe_wendet_eigene_sorgfalt_an_2131(entity_ref("urn:de:bgb:pilot:v31:T2"), entity_ref("urn:de:bgb:pilot:v31:B")) { origin case_input; }
        assert "f4": ordnungsmaessige_nutzung_verursacht_abnutzung_2132(entity_ref("urn:de:bgb:pilot:v31:T3"), entity_ref("urn:de:bgb:pilot:v31:C")) { origin case_input; }
        assert "f5": vorerbe_verwendet_erbschaftsgegenstand_fuer_sich_2134(entity_ref("urn:de:bgb:pilot:v31:T4"), entity_ref("urn:de:bgb:pilot:v31:D")) { origin case_input; }
        assert "f6": erblasser_befreit_vorerbe_2136(entity_ref("urn:de:bgb:pilot:v31:T5"), entity_ref("urn:de:bgb:pilot:v31:E")) { origin case_input; }
        assert "f7": nacherbe_auf_restbestand_eingesetzt_2137(entity_ref("urn:de:bgb:pilot:v31:T6"), entity_ref("urn:de:bgb:pilot:v31:F")) { origin case_input; }
        assert "f8": nacherbfolge_eingetreten_2139(entity_ref("urn:de:bgb:pilot:v31:T7"), entity_ref("urn:de:bgb:pilot:v31:G")) { origin case_input; }
        assert "f9": vorerbe_nacherbfolge_noch_nicht_bekannt_2140(entity_ref("urn:de:bgb:pilot:v31:T8"), entity_ref("urn:de:bgb:pilot:v31:H")) { origin case_input; }
    }
    evaluate truth(vorerbe_muss_ordentlich_verwaltete_erbschaft_herausgeben_2130(entity_ref("urn:de:bgb:pilot:v31:T1"), entity_ref("urn:de:bgb:pilot:v31:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_muss_rechenschaft_ablegen_2130(entity_ref("urn:de:bgb:pilot:v31:T1"), entity_ref("urn:de:bgb:pilot:v31:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_sorgfaltspflicht_erfuellt_2131(entity_ref("urn:de:bgb:pilot:v31:T2"), entity_ref("urn:de:bgb:pilot:v31:B"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_nicht_haftbar_gewoehnliche_abnutzung_2132(entity_ref("urn:de:bgb:pilot:v31:T3"), entity_ref("urn:de:bgb:pilot:v31:C"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_muss_wert_ersetzen_2134(entity_ref("urn:de:bgb:pilot:v31:T4"), entity_ref("urn:de:bgb:pilot:v31:D"))); expect truth_status == TRUE_ONLY;
    evaluate truth(befreiung_vorerbe_wirksam_2136(entity_ref("urn:de:bgb:pilot:v31:T5"), entity_ref("urn:de:bgb:pilot:v31:E"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vollbefreiung_vorerbe_vermutet_2137(entity_ref("urn:de:bgb:pilot:v31:T6"), entity_ref("urn:de:bgb:pilot:v31:F"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_hoert_auf_erbe_zu_sein_2139(entity_ref("urn:de:bgb:pilot:v31:T7"), entity_ref("urn:de:bgb:pilot:v31:G"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_darf_bis_kenntnis_wie_bisher_verfuegen_2140(entity_ref("urn:de:bgb:pilot:v31:T8"), entity_ref("urn:de:bgb:pilot:v31:H"))); expect truth_status == TRUE_ONLY;
}
