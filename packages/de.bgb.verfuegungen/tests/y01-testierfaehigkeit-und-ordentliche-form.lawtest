language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2229 Abs. 2 (keine Zustimmung des Vertreters), Abs. 4 (Testierunfähigkeit
// wegen Geistesstörung, Kanal §47.3 — adjudicated), § 2231 Nr. 1, 2
// (ordentliche Formen), § 2232 (öffentliches Testament), § 2233 Abs. 1, 2
// (Minderjährige, Nichtlesefähige).
test "§§ 2229 Abs. 2, 4, 2231–2233: Testierfähigkeit und ordentliche Form" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": minderjaehriger_errichtet_testament_2229(entity_ref("urn:de:bgb:pilot:y01:T1"), entity_ref("urn:de:bgb:pilot:y01:M1")) { origin case_input; }
        assert "f2": verfuegung_von_todes_wegen_persoenlich_2064(entity_ref("urn:de:bgb:pilot:y01:T2"), entity_ref("urn:de:bgb:pilot:y01:E2")) { origin case_input; }
        assert "f3": testament_errichtet_am(entity_ref("urn:de:bgb:pilot:y01:E2"), @2026-01-10) { origin case_input; }
        assert "f4": geistestoerung_testierunfaehig_2229(entity_ref("urn:de:bgb:pilot:y01:E2"), @2026-01-10) { origin adjudicated; }
        assert "f5": notarielle_niederschrift_2231(entity_ref("urn:de:bgb:pilot:y01:T3")) { origin case_input; }
        assert "f6": erblasser_erklaert_letzten_willen_dem_notar_oder_uebergibt_schrift_2232(entity_ref("urn:de:bgb:pilot:y01:T3"), entity_ref("urn:de:bgb:pilot:y01:E3")) { origin case_input; }
        assert "f7": erblasser_minderjaehrig_2233(entity_ref("urn:de:bgb:pilot:y01:T4"), entity_ref("urn:de:bgb:pilot:y01:E4")) { origin case_input; }
        assert "f8": errichtung_nur_durch_erklaerung_oder_offene_schrift_2233(entity_ref("urn:de:bgb:pilot:y01:T4"), entity_ref("urn:de:bgb:pilot:y01:E4")) { origin case_input; }
        assert "f9": erblasser_nicht_lesefaehig_2233(entity_ref("urn:de:bgb:pilot:y01:T5"), entity_ref("urn:de:bgb:pilot:y01:E5")) { origin case_input; }
        assert "f10": errichtung_nur_durch_erklaerung_ggue_notar_2233(entity_ref("urn:de:bgb:pilot:y01:T5"), entity_ref("urn:de:bgb:pilot:y01:E5")) { origin case_input; }
    }
    evaluate truth(keine_zustimmung_des_vertreters_erforderlich_2229(entity_ref("urn:de:bgb:pilot:y01:T1"), entity_ref("urn:de:bgb:pilot:y01:M1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(testament_unwirksam_wegen_testierunfaehigkeit_2229(entity_ref("urn:de:bgb:pilot:y01:T2"), entity_ref("urn:de:bgb:pilot:y01:E2"), @2026-01-10));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ordentliche_form_notariell_2231(entity_ref("urn:de:bgb:pilot:y01:T3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(oeffentliches_testament_formwirksam_2232(entity_ref("urn:de:bgb:pilot:y01:T3"), entity_ref("urn:de:bgb:pilot:y01:E3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(errichtung_minderjaehriger_formwirksam_2233(entity_ref("urn:de:bgb:pilot:y01:T4"), entity_ref("urn:de:bgb:pilot:y01:E4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(errichtung_nicht_lesefaehiger_formwirksam_2233(entity_ref("urn:de:bgb:pilot:y01:T5"), entity_ref("urn:de:bgb:pilot:y01:E5")));
    expect truth_status == TRUE_ONLY;
}
