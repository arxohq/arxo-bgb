language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§ 2330: Anstandsschenkung ist von Pflichtteilsergänzung ausgenommen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": schenkung_sittliche_pflicht_oder_anstand_2330(entity_ref("urn:de:bgb:pilot:v17:E"), entity_ref("urn:de:bgb:pilot:v17:S")) { origin case_input; }
    }
    evaluate truth(pflichtteilsergaenzungsregeln_nicht_anwendbar_2330(entity_ref("urn:de:bgb:pilot:v17:E"), entity_ref("urn:de:bgb:pilot:v17:S")));
    expect truth_status == TRUE_ONLY;
}
