language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2290 Abs. 1, 2, 3 (Aufhebung durch Vertrag), § 2291 Abs. 1, 2 (Aufhebung
// durch Testament mit Zustimmung), § 2292 (gemeinschaftliches Testament),
// § 2293–2295 (Rücktrittsgründe), § 2296 Abs. 1, 2 (Form des Rücktritts),
// § 2297 (Rücktritt durch Testament nach Tod, § 2336-Verweisung).
test "§§ 2290–2297: Aufhebung durch Vertrag/Testament, Rücktrittsgründe und -form" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": vertragschliessende_heben_erbvertrag_oder_verfuegung_durch_vertrag_auf_bei_lebzeiten_2290(entity_ref("urn:de:bgb:pilot:e13:V1"), entity_ref("urn:de:bgb:pilot:e13:AV1")) { origin case_input; }
        assert "f2": aufhebungsvertrag_persoenlich_geschlossen_2290(entity_ref("urn:de:bgb:pilot:e13:V2"), entity_ref("urn:de:bgb:pilot:e13:AV2"), entity_ref("urn:de:bgb:pilot:e13:E2")) { origin case_input; }
        assert "f3": aufhebungsvertrag_notarielle_form_nach_2276_gewahrt_2290(entity_ref("urn:de:bgb:pilot:e13:V2"), entity_ref("urn:de:bgb:pilot:e13:AV2")) { origin case_input; }
        assert "f4": vermaechtnis_auflage_oder_rechtswahl_durch_testament_aufgehoben_mit_zustimmung_2291(entity_ref("urn:de:bgb:pilot:e13:V3"), entity_ref("urn:de:bgb:pilot:e13:AT3"), entity_ref("urn:de:bgb:pilot:e13:E3")) { origin case_input; }
        assert "f5": zustimmungserklaerung_notariell_beurkundet_2291(entity_ref("urn:de:bgb:pilot:e13:V4"), entity_ref("urn:de:bgb:pilot:e13:Z4")) { origin case_input; }
        assert "f6": zwischen_ehegatten_oder_lebenspartnern_geschlossener_erbvertrag_durch_gemeinschaftliches_testament_aufgehoben_2292(entity_ref("urn:de:bgb:pilot:e13:V5"), entity_ref("urn:de:bgb:pilot:e13:T5")) { origin case_input; }
        assert "f7": ruecktritt_im_erbvertrag_vorbehalten_2293(entity_ref("urn:de:bgb:pilot:e13:V6"), entity_ref("urn:de:bgb:pilot:e13:E6")) { origin case_input; }
        assert "f8": bedachter_verfehlung_die_zur_pflichtteilsentziehung_berechtigen_wuerde_2294(entity_ref("urn:de:bgb:pilot:e13:V7"), entity_ref("urn:de:bgb:pilot:e13:BD7")) { origin case_input; }
        assert "f9": gegenverpflichtung_wiederkehrender_leistungen_vor_tod_aufgehoben_2295(entity_ref("urn:de:bgb:pilot:e13:V8"), entity_ref("urn:de:bgb:pilot:e13:BD8")) { origin case_input; }
        assert "f10": ruecktritt_durch_vertreter_versucht_2296(entity_ref("urn:de:bgb:pilot:e13:V9"), entity_ref("urn:de:bgb:pilot:e13:VT9")) { origin case_input; }
        assert "f11": ruecktrittserklaerung_ggue_anderem_vertragschliessenden_notariell_beurkundet_2296(entity_ref("urn:de:bgb:pilot:e13:V10"), entity_ref("urn:de:bgb:pilot:e13:R10"), entity_ref("urn:de:bgb:pilot:e13:A10")) { origin case_input; }
        assert "f12": erblasser_ruecktrittsberechtigt_nach_tod_des_anderen_hebt_durch_testament_auf_2297(entity_ref("urn:de:bgb:pilot:e13:V11"), entity_ref("urn:de:bgb:pilot:e13:E11")) { origin case_input; }
        assert "f13": ruecktrittsfall_des_2294_2297(entity_ref("urn:de:bgb:pilot:e13:V12"), entity_ref("urn:de:bgb:pilot:e13:E12")) { origin case_input; }
    }
    evaluate truth(aufhebung_durch_vertrag_wirksam_2290(entity_ref("urn:de:bgb:pilot:e13:V1"), entity_ref("urn:de:bgb:pilot:e13:AV1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(aufhebungsvertrag_formwirksam_2290(entity_ref("urn:de:bgb:pilot:e13:V2"), entity_ref("urn:de:bgb:pilot:e13:AV2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(aufhebung_durch_testament_wirksam_2291(entity_ref("urn:de:bgb:pilot:e13:V3"), entity_ref("urn:de:bgb:pilot:e13:AT3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zustimmung_formwirksam_und_unwiderruflich_2291(entity_ref("urn:de:bgb:pilot:e13:V4"), entity_ref("urn:de:bgb:pilot:e13:Z4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(aufhebung_durch_gemeinschaftliches_testament_zulaessig_2292(entity_ref("urn:de:bgb:pilot:e13:V5"), entity_ref("urn:de:bgb:pilot:e13:T5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ruecktritt_bei_vorbehalt_zulaessig_2293(entity_ref("urn:de:bgb:pilot:e13:V6"), entity_ref("urn:de:bgb:pilot:e13:E6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ruecktritt_bei_verfehlung_zulaessig_2294(entity_ref("urn:de:bgb:pilot:e13:V7"), entity_ref("urn:de:bgb:pilot:e13:BD7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ruecktritt_bei_aufhebung_gegenverpflichtung_zulaessig_2295(entity_ref("urn:de:bgb:pilot:e13:V8"), entity_ref("urn:de:bgb:pilot:e13:BD8")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ruecktritt_durch_vertreter_unwirksam_2296(entity_ref("urn:de:bgb:pilot:e13:V9"), entity_ref("urn:de:bgb:pilot:e13:VT9")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ruecktritt_formwirksam_2296(entity_ref("urn:de:bgb:pilot:e13:V10"), entity_ref("urn:de:bgb:pilot:e13:R10")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(aufhebung_durch_testament_nach_ruecktrittsrecht_wirksam_2297(entity_ref("urn:de:bgb:pilot:e13:V11"), entity_ref("urn:de:bgb:pilot:e13:E11")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(p2336_abs2_3_entsprechend_anwendbar_2297(entity_ref("urn:de:bgb:pilot:e13:V12"), entity_ref("urn:de:bgb:pilot:e13:E12")));
    expect truth_status == TRUE_ONLY;
}
