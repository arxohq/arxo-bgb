language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2308 (Anfechtung der Ausschlagung — Abs. 1 und Abs. 2), § 2310 Satz 2
// (Erbverzichtsausgeschlossener nicht mitgezählt), § 2312 (Wert eines
// Landguts — alle drei Absätze), § 2316 Abs. 1 Satz 1 Brücke zur
// Ausgleichung aus de.bgb.erbfolge § 2055 Abs. 1 (`rechnerischer_erbteil_2055`).
test "§§ 2308, 2310 S. 2, 2312, Brücke § 2316: Anfechtung, Nichtmitzählung, Landgut, Ausgleichung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }

        // § 2308 Abs. 1
        assert "l1": pflichtteilsberechtigter_beschraenkt_oder_beschwert_2306_art_2308(entity_ref("urn:de:bgb:pilot:l01:E1"), entity_ref("urn:de:bgb:pilot:l01:P1")) { origin case_input; }
        assert "l2": erbschaft_oder_vermaechtnis_ausgeschlagen_2308(entity_ref("urn:de:bgb:pilot:l01:E1"), entity_ref("urn:de:bgb:pilot:l01:P1")) { origin case_input; }
        assert "l3": beschraenkung_oder_beschwerung_zur_zeit_der_ausschlagung_weggefallen_2308(entity_ref("urn:de:bgb:pilot:l01:E1"), entity_ref("urn:de:bgb:pilot:l01:P1")) { origin case_input; }
        assert "l4": wegfall_war_dem_pflichtteilsberechtigten_nicht_bekannt_2308(entity_ref("urn:de:bgb:pilot:l01:E1"), entity_ref("urn:de:bgb:pilot:l01:P1")) { origin case_input; }
        // § 2308 Abs. 2
        assert "l5": anfechtung_durch_erklaerung_gegenueber_beschwertem_erfolgt_2308(entity_ref("urn:de:bgb:pilot:l01:E1"), entity_ref("urn:de:bgb:pilot:l01:P1"), entity_ref("urn:de:bgb:pilot:l01:BESCHWERTER1")) { origin case_input; }

        // § 2310 Satz 2
        assert "l6": abkoemmling_durch_erbverzicht_ausgeschlossen_2316(entity_ref("urn:de:bgb:pilot:l01:E2"), entity_ref("urn:de:bgb:pilot:l01:P2")) { origin case_input; }

        // § 2312 Abs. 1 Satz 1 (Übernahmerecht ausgeübt)
        assert "l7": uebernahmerecht_zum_ertragswert_angeordnet_oder_2049_2312(entity_ref("urn:de:bgb:pilot:l01:E3"), entity_ref("urn:de:bgb:pilot:l01:ERBE3")) { origin case_input; }
        assert "l8": vom_uebernahmerecht_gebrauch_gemacht_2312(entity_ref("urn:de:bgb:pilot:l01:E3"), entity_ref("urn:de:bgb:pilot:l01:ERBE3")) { origin case_input; }
        assert "l9": ertragswert_des_landguts_2312(entity_ref("urn:de:bgb:pilot:l01:E3"), entity_ref("urn:de:bgb:pilot:l01:ERBE3"), 80000.00 EUR) { origin case_input; }
        assert "l10": erbe_gehoert_zu_pflichtteilsberechtigten_des_2303_2312(entity_ref("urn:de:bgb:pilot:l01:E3"), entity_ref("urn:de:bgb:pilot:l01:ERBE3")) { origin case_input; }

        // § 2312 Abs. 1 Satz 2 (anderer Übernahmepreis)
        assert "l11": anderer_uebernahmepreis_bestimmt_2312(entity_ref("urn:de:bgb:pilot:l01:E4"), entity_ref("urn:de:bgb:pilot:l01:ERBE4"), 85000.00 EUR) { origin case_input; }
        assert "l12": uebernahmepreis_erreicht_ertragswert_und_uebersteigt_schaetzungswert_nicht_2312(entity_ref("urn:de:bgb:pilot:l01:E4"), entity_ref("urn:de:bgb:pilot:l01:ERBE4")) { origin case_input; }
        assert "l13": erbe_gehoert_zu_pflichtteilsberechtigten_des_2303_2312(entity_ref("urn:de:bgb:pilot:l01:E4"), entity_ref("urn:de:bgb:pilot:l01:ERBE4")) { origin case_input; }

        // § 2312 Abs. 2 (nur ein Erbe, Anordnung)
        assert "l14": erblasser_hinterlaesst_nur_einen_erben_2312(entity_ref("urn:de:bgb:pilot:l01:E5"), entity_ref("urn:de:bgb:pilot:l01:ERBE5")) { origin case_input; }
        assert "l15": erblasser_ordnet_ertragswert_oder_bestimmten_wert_an_2312(entity_ref("urn:de:bgb:pilot:l01:E5"), entity_ref("urn:de:bgb:pilot:l01:ERBE5"), 70000.00 EUR) { origin case_input; }
        assert "l16": erbe_gehoert_zu_pflichtteilsberechtigten_des_2303_2312(entity_ref("urn:de:bgb:pilot:l01:E5"), entity_ref("urn:de:bgb:pilot:l01:ERBE5")) { origin case_input; }

        // Brücke § 2316 Abs. 1 Satz 1: rechnerischer_erbteil_2055 aus de.bgb.erbfolge
        assert "l17": abkoemmling_mehrere_2316(entity_ref("urn:de:bgb:pilot:l01:E6"), entity_ref("urn:de:bgb:pilot:l01:P6")) { origin case_input; }
        assert "l18": ausgleichung_bei_teilung_2316_zu_beruecksichtigen(entity_ref("urn:de:bgb:pilot:l01:E6"), entity_ref("urn:de:bgb:pilot:l01:P6")) { origin case_input; }
        assert "l19": de.bgb.erbfolge::rechnerischer_erbteil_2055(entity_ref("urn:de:bgb:pilot:l01:E6"), entity_ref("urn:de:bgb:pilot:l01:P6"), 40000.00 EUR) { origin case_input; }
    }

    evaluate truth(ausschlagung_anfechtbar_2308(entity_ref("urn:de:bgb:pilot:l01:E1"), entity_ref("urn:de:bgb:pilot:l01:P1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisausschlagung_wirksam_angefochten_2308(entity_ref("urn:de:bgb:pilot:l01:E1"), entity_ref("urn:de:bgb:pilot:l01:P1"), entity_ref("urn:de:bgb:pilot:l01:BESCHWERTER1")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(erbverzichtsausgeschlossener_nicht_bei_pflichtteilserbteil_mitzuzaehlen_2310(entity_ref("urn:de:bgb:pilot:l01:E2"), entity_ref("urn:de:bgb:pilot:l01:P2")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(ertragswert_fuer_pflichtteil_massgebend_2312(entity_ref("urn:de:bgb:pilot:l01:E3"), entity_ref("urn:de:bgb:pilot:l01:ERBE3"), 80000.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ertragswert_fuer_pflichtteil_massgebend_2312(entity_ref("urn:de:bgb:pilot:l01:E4"), entity_ref("urn:de:bgb:pilot:l01:ERBE4"), 85000.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ertragswert_fuer_pflichtteil_massgebend_2312(entity_ref("urn:de:bgb:pilot:l01:E5"), entity_ref("urn:de:bgb:pilot:l01:ERBE5"), 70000.00 EUR));
    expect truth_status == TRUE_ONLY;

    evaluate truth(pflichtteil_nach_ausgleichung_2316(entity_ref("urn:de:bgb:pilot:l01:E6"), entity_ref("urn:de:bgb:pilot:l01:P6"), 20000.00 EUR));
    expect truth_status == TRUE_ONLY;
}
