language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2333 Abs. 1 Nr. 1: das Nachdemlebentrachten ist eine Wertung des Gerichts
// (Kanal §47.3); hier liegt die Antwort des Gerichts vor (origin adjudicated).
test "§ 2333 Abs. 1 Nr. 1: Entziehung wegen Nachdemlebentrachtens — Gericht bejaht" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": entziehung_durch_verfuegung_2336(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:P")) { origin case_input; }
        assert "f2": trachtet_nach_dem_leben_2333(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:P")) { origin adjudicated; }
    }
    evaluate truth(pflichtteil_entziehbar_2333(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
