language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2111–2115: Ersetzung und Verfügungen des Vorerben" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": vorerbe_erwirbt_ersatz_aus_erbschaftsrecht_2111(entity_ref("urn:de:bgb:pilot:v28:T1"), entity_ref("urn:de:bgb:pilot:v28:A")) { origin case_input; }
        assert "f2": vorerbe_inventar_grundstueck_einverleibt_2111(entity_ref("urn:de:bgb:pilot:v28:T1"), entity_ref("urn:de:bgb:pilot:v28:A")) { origin case_input; }
        assert "f3": vorerbe_verfuegt_ueber_erbschaftsgegenstand_2112(entity_ref("urn:de:bgb:pilot:v28:T2"), entity_ref("urn:de:bgb:pilot:v28:B")) { origin case_input; }
        assert "f4": vorerbe_verfuegung_grundstueck_schiff_oder_unentgeltlich_2113(entity_ref("urn:de:bgb:pilot:v28:T3"), entity_ref("urn:de:bgb:pilot:v28:C")) { origin case_input; }
        assert "f5": verfuegung_beeintraechtigt_nacherbrecht_2113(entity_ref("urn:de:bgb:pilot:v28:T3")) { origin case_input; }
        assert "f6": vorerbe_hypothekenforderung_kuendigt_oder_zieht_ein_2114(entity_ref("urn:de:bgb:pilot:v28:T4"), entity_ref("urn:de:bgb:pilot:v28:D")) { origin case_input; }
        assert "f7": zwangsverfuegung_beeintraechtigt_nacherbrecht_2115(entity_ref("urn:de:bgb:pilot:v28:T5")) { origin case_input; }
    }
    evaluate truth(ersatz_gehoert_zur_erbschaft_2111(entity_ref("urn:de:bgb:pilot:v28:T1"), entity_ref("urn:de:bgb:pilot:v28:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(einverleibung_gehoert_zur_erbschaft_2111(entity_ref("urn:de:bgb:pilot:v28:T1"), entity_ref("urn:de:bgb:pilot:v28:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(verfuegung_vorerbe_zulaessig_2112(entity_ref("urn:de:bgb:pilot:v28:T2"), entity_ref("urn:de:bgb:pilot:v28:B"))); expect truth_status == TRUE_ONLY;
    evaluate truth(verfuegung_bei_nacherbfolge_unwirksam_2113(entity_ref("urn:de:bgb:pilot:v28:T3"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_kuendigung_einziehung_zulaessig_2114(entity_ref("urn:de:bgb:pilot:v28:T4"), entity_ref("urn:de:bgb:pilot:v28:D"))); expect truth_status == TRUE_ONLY;
    evaluate truth(zwangsverfuegung_bei_nacherbfolge_unwirksam_2115(entity_ref("urn:de:bgb:pilot:v28:T5"))); expect truth_status == TRUE_ONLY;
}
