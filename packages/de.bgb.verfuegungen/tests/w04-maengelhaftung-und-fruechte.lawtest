language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2182 Abs. 1 (Verkäuferpflichten bei Gattungsvermächtnis), Abs. 3 (keine
// Haftung für Dienstbarkeiten bei Grundstück), § 2183 Satz 1, 2
// (Nacherfüllung, Schadensersatz bei Arglist), § 2184 (Früchte und sonstige
// Nutzungen — beide Sätze), § 2185 (Verwendungsersatz).
test "§§ 2182–2185: Mängelhaftung, Früchte, Nutzungen, Verwendungsersatz" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": nur_der_gattung_nach_bestimmter_gegenstand_vermacht_2182(entity_ref("urn:de:bgb:pilot:w04:T1")) { origin case_input; }
        assert "f2": grundstueck_gegenstand_des_vermaechtnisses_2182(entity_ref("urn:de:bgb:pilot:w04:T2")) { origin case_input; }
        assert "f3": nur_der_gattung_nach_bestimmte_sache_mangelhaft_geleistet_2183(entity_ref("urn:de:bgb:pilot:w04:T3")) { origin case_input; }
        assert "f4": nur_der_gattung_nach_bestimmte_sache_mangelhaft_geleistet_2183(entity_ref("urn:de:bgb:pilot:w04:T4")) { origin case_input; }
        assert "f5": beschwerter_hat_sachmangel_arglistig_verschwiegen_2183(entity_ref("urn:de:bgb:pilot:w04:T4")) { origin case_input; }
        assert "f6": bestimmter_zur_erbschaft_gehoerender_gegenstand_vermacht_2184(entity_ref("urn:de:bgb:pilot:w04:T5")) { origin case_input; }
        assert "f7": bestimmte_zur_erbschaft_gehoerende_sache_vermacht_und_verwendungen_gemacht_2185(entity_ref("urn:de:bgb:pilot:w04:T6")) { origin case_input; }
    }
    evaluate truth(beschwerter_hat_verkaeuferpflichten_gegen_rechtsmaengel_2182(entity_ref("urn:de:bgb:pilot:w04:T1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(keine_haftung_fuer_dienstbarkeiten_und_reallasten_vermutet_2182(entity_ref("urn:de:bgb:pilot:w04:T2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(nacherfuellung_durch_mangelfreie_sache_verlangbar_2183(entity_ref("urn:de:bgb:pilot:w04:T3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(schadensersatz_statt_leistung_ohne_fristsetzung_verlangbar_2183(entity_ref("urn:de:bgb:pilot:w04:T4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(herausgabe_der_seit_anfall_gezogenen_fruechte_geschuldet_2184(entity_ref("urn:de:bgb:pilot:w04:T5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kein_ersatz_fuer_sonstige_nutzungen_2184(entity_ref("urn:de:bgb:pilot:w04:T5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ersatz_nach_besitzer_eigentuemer_vorschriften_verlangbar_2185(entity_ref("urn:de:bgb:pilot:w04:T6")));
    expect truth_status == TRUE_ONLY;
}
