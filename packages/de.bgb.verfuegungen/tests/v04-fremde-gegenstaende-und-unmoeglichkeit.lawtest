language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2169 Abs. 1 (Vermächtnis fremder Gegenstände unwirksam, mit
// Gegenausnahme), Abs. 2 (Besitz gilt im Zweifel als vermacht), Abs. 3
// (Ersatzanspruch gilt im Zweifel als vermacht); § 2170 Abs. 1, 2
// (Verschaffungsvermächtnis); § 2171 Abs. 1, 2 (Unmöglichkeit, gesetzliches
// Verbot, und die behebbare Ausnahme).
test "§§ 2169–2171: fremde Gegenstände, Verschaffungsvermächtnis, Unmöglichkeit" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": vermachter_gegenstand_gehoert_beim_erbfall_nicht_zur_erbschaft_2169(entity_ref("urn:de:bgb:pilot:v04:T1")) { origin case_input; }
        assert "f2": erblasser_hat_nur_besitz_der_vermachten_sache_2169(entity_ref("urn:de:bgb:pilot:v04:T2")) { origin case_input; }
        assert "f3": erblasser_hat_anspruch_auf_leistung_oder_ersatz_des_gegenstands_2169(entity_ref("urn:de:bgb:pilot:v04:T3")) { origin case_input; }
        assert "f4": vermaechtnis_fremden_gegenstands_wirksam_nach_2169_abs1_2170(entity_ref("urn:de:bgb:pilot:v04:T4"), entity_ref("urn:de:bgb:pilot:v04:B")) { origin case_input; }
        assert "f5": beschwerter_zur_verschaffung_ausserstande_oder_unverhaeltnismaessig_2170(entity_ref("urn:de:bgb:pilot:v04:T5"), entity_ref("urn:de:bgb:pilot:v04:B2")) { origin case_input; }
        assert "f6": vermaechtnis_fuer_jedermann_unmoeglich_oder_gesetzeswidrig_2171(entity_ref("urn:de:bgb:pilot:v04:T6")) { origin case_input; }
        assert "f7": unmoeglichkeit_behebbar_und_fuer_moeglichwerden_zugewendet_2171(entity_ref("urn:de:bgb:pilot:v04:T7")) { origin case_input; }
    }
    evaluate truth(vermaechtnis_fremden_gegenstands_unwirksam_2169(entity_ref("urn:de:bgb:pilot:v04:T1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(besitz_gilt_als_vermacht_vermutet_2169(entity_ref("urn:de:bgb:pilot:v04:T2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anspruch_gilt_als_vermacht_vermutet_2169(entity_ref("urn:de:bgb:pilot:v04:T3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(beschwerter_muss_gegenstand_verschaffen_2170(entity_ref("urn:de:bgb:pilot:v04:T4"), entity_ref("urn:de:bgb:pilot:v04:B")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(beschwerter_kann_durch_wertentrichtung_befreien_2170(entity_ref("urn:de:bgb:pilot:v04:T5"), entity_ref("urn:de:bgb:pilot:v04:B2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnis_unmoeglichkeit_oder_verbot_unwirksam_2171(entity_ref("urn:de:bgb:pilot:v04:T6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnis_trotz_unmoeglichkeit_gueltig_2171(entity_ref("urn:de:bgb:pilot:v04:T7")));
    expect truth_status == TRUE_ONLY;
}
