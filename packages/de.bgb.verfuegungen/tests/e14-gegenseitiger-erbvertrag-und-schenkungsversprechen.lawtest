language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2298 Abs. 1, 2, 3 (gegenseitiger Erbvertrag — Vermutung mit
// Gegenausnahme, beide Seiten), § 2299 Abs. 1, 3 (einseitige Verfügungen —
// Vermutung mit Gegenausnahme, beide Seiten), § 2300 Abs. 2 (Rücknahme),
// § 2301 Abs. 1, 2 (Schenkungsversprechen von Todes wegen), § 2302
// (unbeschränkbare Testierfreiheit).
test "§§ 2298–2302: gegenseitiger Erbvertrag (beide Seiten), einseitige Verfügungen (beide Seiten), Schenkungsversprechen" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": gegenseitiger_erbvertrag_eine_verfuegung_nichtig_2298(entity_ref("urn:de:bgb:pilot:e14:V1"), entity_ref("urn:de:bgb:pilot:e14:N1")) { origin case_input; }
        assert "f2": gegenseitiger_erbvertrag_ruecktritt_vorbehalten_ausgeuebt_2298(entity_ref("urn:de:bgb:pilot:e14:V2"), entity_ref("urn:de:bgb:pilot:e14:R2")) { origin case_input; }
        assert "f3": gegenseitiger_erbvertrag_ruecktritt_vorbehalten_ausgeuebt_2298(entity_ref("urn:de:bgb:pilot:e14:V3"), entity_ref("urn:de:bgb:pilot:e14:R3")) { origin case_input; }
        assert "f4": anderer_wille_der_vertragschliessenden_bei_2298_anzunehmen(entity_ref("urn:de:bgb:pilot:e14:V3")) { origin case_input; }
        assert "f5": ueberlebender_schlaegt_zuwendung_aus_erbvertrag_aus_2298(entity_ref("urn:de:bgb:pilot:e14:V4"), entity_ref("urn:de:bgb:pilot:e14:UEB4")) { origin case_input; }
        assert "f6": vertragschliessender_trifft_einseitige_letztwillensfaehige_verfuegung_im_erbvertrag_2299(entity_ref("urn:de:bgb:pilot:e14:V5"), entity_ref("urn:de:bgb:pilot:e14:P5")) { origin case_input; }
        assert "f7": erbvertrag_durch_ruecktritt_oder_vertrag_aufgehoben_2299(entity_ref("urn:de:bgb:pilot:e14:V6"), entity_ref("urn:de:bgb:pilot:e14:P6")) { origin case_input; }
        assert "f8": erbvertrag_durch_ruecktritt_oder_vertrag_aufgehoben_2299(entity_ref("urn:de:bgb:pilot:e14:V7"), entity_ref("urn:de:bgb:pilot:e14:P7")) { origin case_input; }
        assert "f9": anderer_wille_des_erblassers_bei_2299_anzunehmen(entity_ref("urn:de:bgb:pilot:e14:V7"), entity_ref("urn:de:bgb:pilot:e14:P7")) { origin case_input; }
        assert "f10": erbvertrag_enthaelt_nur_verfuegungen_von_todes_wegen_aus_verwahrung_zurueckgenommen_2300(entity_ref("urn:de:bgb:pilot:e14:V8")) { origin case_input; }
        assert "f11": schenkungsversprechen_unter_ueberlebensbedingung_erteilt_2301(entity_ref("urn:de:bgb:pilot:e14:V9"), entity_ref("urn:de:bgb:pilot:e14:SCH9"), entity_ref("urn:de:bgb:pilot:e14:BES9")) { origin case_input; }
        assert "f12": schenker_vollzieht_schenkung_durch_leistung_2301(entity_ref("urn:de:bgb:pilot:e14:V10"), entity_ref("urn:de:bgb:pilot:e14:SCH10"), entity_ref("urn:de:bgb:pilot:e14:BES10")) { origin case_input; }
        assert "f13": vertrag_ueber_errichtung_nichterrichtung_aufhebung_oder_nichtaufhebung_einer_verfuegung_2302(entity_ref("urn:de:bgb:pilot:e14:V11")) { origin case_input; }
    }
    evaluate truth(ganzer_vertrag_unwirksam_2298(entity_ref("urn:de:bgb:pilot:e14:V1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ganzer_vertrag_durch_ruecktritt_aufgehoben_2298(entity_ref("urn:de:bgb:pilot:e14:V2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ganzer_vertrag_durch_ruecktritt_aufgehoben_2298(entity_ref("urn:de:bgb:pilot:e14:V3")));
    expect truth_status == NEITHER;
    evaluate truth(ueberlebender_kann_verfuegung_durch_testament_aufheben_2298(entity_ref("urn:de:bgb:pilot:e14:V4"), entity_ref("urn:de:bgb:pilot:e14:UEB4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(einseitige_verfuegung_zulaessig_2299(entity_ref("urn:de:bgb:pilot:e14:V5"), entity_ref("urn:de:bgb:pilot:e14:P5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(einseitige_verfuegung_ausser_kraft_vermutet_2299(entity_ref("urn:de:bgb:pilot:e14:V6"), entity_ref("urn:de:bgb:pilot:e14:P6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(einseitige_verfuegung_ausser_kraft_vermutet_2299(entity_ref("urn:de:bgb:pilot:e14:V7"), entity_ref("urn:de:bgb:pilot:e14:P7")));
    expect truth_status == NEITHER;
    evaluate truth(ruecknahme_wie_2256_abs1_gilt_als_widerrufen_2300(entity_ref("urn:de:bgb:pilot:e14:V8")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vorschriften_ueber_verfuegungen_von_todes_wegen_anwendbar_2301(entity_ref("urn:de:bgb:pilot:e14:V9"), entity_ref("urn:de:bgb:pilot:e14:SCH9"), entity_ref("urn:de:bgb:pilot:e14:BES9")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vorschriften_ueber_schenkungen_unter_lebenden_anwendbar_2301(entity_ref("urn:de:bgb:pilot:e14:V10"), entity_ref("urn:de:bgb:pilot:e14:SCH10"), entity_ref("urn:de:bgb:pilot:e14:BES10")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(solcher_vertrag_nichtig_2302(entity_ref("urn:de:bgb:pilot:e14:V11")));
    expect truth_status == TRUE_ONLY;
}
