language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2094–2103: Anwachsung, Ersatzerbe und Nacherbe" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": mehrere_eingesetzte_erben_schliessen_gesetzliche_erbfolge_aus_2094(entity_ref("urn:de:bgb:pilot:v26:T1")) { origin case_input; }
        assert "f2": eingesetzter_erbe_weggefallen_2094(entity_ref("urn:de:bgb:pilot:v26:T1"), entity_ref("urn:de:bgb:pilot:v26:A")) { origin case_input; }
        assert "f3": uebriger_erbe_anwachsungsberechtigt_2094(entity_ref("urn:de:bgb:pilot:v26:T1"), entity_ref("urn:de:bgb:pilot:v26:B"), entity_ref("urn:de:bgb:pilot:v26:A")) { origin case_input; }
        assert "f4": ersatzerbe_fuer_wegfall_eingesetzt_2096(entity_ref("urn:de:bgb:pilot:v26:T2"), entity_ref("urn:de:bgb:pilot:v26:C"), entity_ref("urn:de:bgb:pilot:v26:D")) { origin case_input; }
        assert "f5": ersatzerbe_nur_unfaehigkeit_oder_unwille_2097(entity_ref("urn:de:bgb:pilot:v26:T3"), entity_ref("urn:de:bgb:pilot:v26:E"), entity_ref("urn:de:bgb:pilot:v26:F")) { origin case_input; }
        assert "f6": vorerbe_und_nacherbe_nacheinander_eingesetzt_2100(entity_ref("urn:de:bgb:pilot:v26:T4"), entity_ref("urn:de:bgb:pilot:v26:G"), entity_ref("urn:de:bgb:pilot:v26:H")) { origin case_input; }
        assert "f7": beim_erbfall_noch_nicht_gezeugter_als_erbe_eingesetzt_2101(entity_ref("urn:de:bgb:pilot:v26:T5"), entity_ref("urn:de:bgb:pilot:v26:I")) { origin case_input; }
        assert "f8": als_nacherbe_eingesetzt_2102(entity_ref("urn:de:bgb:pilot:v26:T6"), entity_ref("urn:de:bgb:pilot:v26:J")) { origin case_input; }
        assert "f9": zweifel_ersatz_oder_nacherbe_2102(entity_ref("urn:de:bgb:pilot:v26:T7"), entity_ref("urn:de:bgb:pilot:v26:K")) { origin case_input; }
        assert "f10": herausgabe_an_anderen_bei_zeitpunkt_oder_ereignis_2103(entity_ref("urn:de:bgb:pilot:v26:T8"), entity_ref("urn:de:bgb:pilot:v26:L")) { origin case_input; }
    }
    evaluate truth(erbteil_wachst_an_2094(entity_ref("urn:de:bgb:pilot:v26:T1"), entity_ref("urn:de:bgb:pilot:v26:B"), entity_ref("urn:de:bgb:pilot:v26:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(angewachsener_erbteil_besonderer_erbteil_2095(entity_ref("urn:de:bgb:pilot:v26:T1"), entity_ref("urn:de:bgb:pilot:v26:B"))); expect truth_status == TRUE_ONLY;
    evaluate truth(ersatzerbeneinsetzung_zulaessig_2096(entity_ref("urn:de:bgb:pilot:v26:T2"), entity_ref("urn:de:bgb:pilot:v26:C"), entity_ref("urn:de:bgb:pilot:v26:D"))); expect truth_status == TRUE_ONLY;
    evaluate truth(ersatzerbe_fuer_beide_wegfallsfaelle_vermutet_2097(entity_ref("urn:de:bgb:pilot:v26:T3"), entity_ref("urn:de:bgb:pilot:v26:E"), entity_ref("urn:de:bgb:pilot:v26:F"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbeinsetzung_zulaessig_2100(entity_ref("urn:de:bgb:pilot:v26:T4"), entity_ref("urn:de:bgb:pilot:v26:H"))); expect truth_status == TRUE_ONLY;
    evaluate truth(noch_nicht_gezeugter_oder_juristische_person_als_nacherbe_vermutet_2101(entity_ref("urn:de:bgb:pilot:v26:T5"), entity_ref("urn:de:bgb:pilot:v26:I"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbe_auch_ersatzerbe_vermutet_2102(entity_ref("urn:de:bgb:pilot:v26:T6"), entity_ref("urn:de:bgb:pilot:v26:J"))); expect truth_status == TRUE_ONLY;
    evaluate truth(im_zweifel_ersatzerbe_2102(entity_ref("urn:de:bgb:pilot:v26:T7"), entity_ref("urn:de:bgb:pilot:v26:K"))); expect truth_status == TRUE_ONLY;
    evaluate truth(anderer_als_nacherbe_vermutet_2103(entity_ref("urn:de:bgb:pilot:v26:T8"), entity_ref("urn:de:bgb:pilot:v26:L"))); expect truth_status == TRUE_ONLY;
}
