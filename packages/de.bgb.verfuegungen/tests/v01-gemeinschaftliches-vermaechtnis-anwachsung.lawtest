language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2157 (Verweisung auf §§ 2089-2093), § 2158 Abs. 1 (Anwachsung), Abs. 2
// (Ausschluss), § 2159 (angewachsener Anteil als besonderes Vermächtnis).
test "§§ 2157–2159: gemeinschaftliches Vermächtnis, Anwachsung und ihr Ausschluss" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": mehreren_derselbe_gegenstand_vermacht_2157(entity_ref("urn:de:bgb:pilot:v01:T1")) { origin case_input; }
        assert "f2": mitbedachter_weggefallen_2158(entity_ref("urn:de:bgb:pilot:v01:T1"), entity_ref("urn:de:bgb:pilot:v01:W")) { origin case_input; }
        assert "f3": uebriger_mitbedachter_anwachsungsberechtigt_2158(entity_ref("urn:de:bgb:pilot:v01:T1"), entity_ref("urn:de:bgb:pilot:v01:B"), entity_ref("urn:de:bgb:pilot:v01:W")) { origin case_input; }
        assert "f4": anwachsung_durch_erblasser_ausgeschlossen_2158(entity_ref("urn:de:bgb:pilot:v01:T2")) { origin case_input; }
    }
    evaluate truth(regeln_2089_bis_2093_auf_vermaechtnis_entsprechend_anwendbar_2157(entity_ref("urn:de:bgb:pilot:v01:T1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisanteil_wachst_an_2158(entity_ref("urn:de:bgb:pilot:v01:T1"), entity_ref("urn:de:bgb:pilot:v01:B"), entity_ref("urn:de:bgb:pilot:v01:W")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(angewachsener_anteil_besonderes_vermaechtnis_2159(entity_ref("urn:de:bgb:pilot:v01:T1"), entity_ref("urn:de:bgb:pilot:v01:B")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anwachsung_ausgeschlossen_2158(entity_ref("urn:de:bgb:pilot:v01:T2")));
    expect truth_status == TRUE_ONLY;
}
