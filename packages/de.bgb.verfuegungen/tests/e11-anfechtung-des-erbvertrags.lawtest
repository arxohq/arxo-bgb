language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2281 Abs. 1, 2 (Anfechtung durch Erblasser, ggü. Nachlassgericht),
// § 2282 Abs. 1, 2, 3 (keine Vertretung, Betreuer, notarielle Form),
// § 2283 Abs. 1 Jahresfrist — beide Fristbeginne (Drohung/Kenntnis) und
// Abs. 3 (Wiederaufleben), § 2284 (Bestätigung persönlich), § 2285 (Dritte
// nicht mehr anfechtungsberechtigt).
test "§§ 2281–2285: Anfechtung des Erbvertrags — Berechtigung, Form, Frist, Bestätigung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erblasser_ficht_erbvertrag_wegen_2078_oder_2079_an_2281(entity_ref("urn:de:bgb:pilot:e11:V1"), entity_ref("urn:de:bgb:pilot:e11:E1")) { origin case_input; }
        assert "f2": pflichtteilsberechtigter_zur_zeit_der_2079_anfechtung_vorhanden_2281(entity_ref("urn:de:bgb:pilot:e11:V1"), entity_ref("urn:de:bgb:pilot:e11:E1")) { origin case_input; }
        assert "f3": anfechtung_gegen_drittbeguenstigung_nach_tod_des_anderen_2281(entity_ref("urn:de:bgb:pilot:e11:V2"), entity_ref("urn:de:bgb:pilot:e11:E2"), entity_ref("urn:de:bgb:pilot:e11:D2")) { origin case_input; }
        assert "f4": anfechtung_durch_vertreter_versucht_2282(entity_ref("urn:de:bgb:pilot:e11:V3"), entity_ref("urn:de:bgb:pilot:e11:VT3")) { origin case_input; }
        assert "f5": erblasser_geschaeftsunfaehig_und_betreuer_ficht_an_2282(entity_ref("urn:de:bgb:pilot:e11:V4"), entity_ref("urn:de:bgb:pilot:e11:E4"), entity_ref("urn:de:bgb:pilot:e11:BT4")) { origin case_input; }
        assert "f6": anfechtungserklaerung_notariell_beurkundet_2282(entity_ref("urn:de:bgb:pilot:e11:V5"), entity_ref("urn:de:bgb:pilot:e11:E5")) { origin case_input; }
        assert "f7": anfechtbarkeit_wegen_drohung_2283(entity_ref("urn:de:bgb:pilot:e11:V6"), entity_ref("urn:de:bgb:pilot:e11:E6")) { origin case_input; }
        assert "f8": anfechtungsgrund_zwangslage_endete_am_2283(entity_ref("urn:de:bgb:pilot:e11:V6"), entity_ref("urn:de:bgb:pilot:e11:E6"), @2026-02-01) { origin case_input; }
        assert "f9": kenntnis_vom_anfechtungsgrund_am_2283(entity_ref("urn:de:bgb:pilot:e11:V7"), entity_ref("urn:de:bgb:pilot:e11:E7"), @2026-03-01) { origin case_input; }
        assert "f10": gesetzlicher_vertreter_hat_nicht_rechtzeitig_angefochten_und_geschaeftsunfaehigkeit_weggefallen_2283(entity_ref("urn:de:bgb:pilot:e11:V8"), entity_ref("urn:de:bgb:pilot:e11:E8")) { origin case_input; }
        assert "f11": erblasser_bestaetigt_anfechtbaren_erbvertrag_persoenlich_2284(entity_ref("urn:de:bgb:pilot:e11:V9"), entity_ref("urn:de:bgb:pilot:e11:E9")) { origin case_input; }
        assert "f12": anfechtungsrecht_des_erblassers_zur_zeit_des_erbfalls_erloschen_2285(entity_ref("urn:de:bgb:pilot:e11:V10"), entity_ref("urn:de:bgb:pilot:e11:E10")) { origin case_input; }
    }
    evaluate truth(anfechtung_durch_erblasser_zulaessig_2281(entity_ref("urn:de:bgb:pilot:e11:V1"), entity_ref("urn:de:bgb:pilot:e11:E1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtung_ggue_nachlassgericht_zu_erklaeren_2281(entity_ref("urn:de:bgb:pilot:e11:V2"), entity_ref("urn:de:bgb:pilot:e11:E2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtung_durch_vertreter_unwirksam_2282(entity_ref("urn:de:bgb:pilot:e11:V3"), entity_ref("urn:de:bgb:pilot:e11:VT3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtung_durch_betreuer_zulaessig_2282(entity_ref("urn:de:bgb:pilot:e11:V4"), entity_ref("urn:de:bgb:pilot:e11:BT4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtungserklaerung_formwirksam_2282(entity_ref("urn:de:bgb:pilot:e11:V5"), entity_ref("urn:de:bgb:pilot:e11:E5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtungsfrist_beginn_drohung_2283(entity_ref("urn:de:bgb:pilot:e11:V6"), entity_ref("urn:de:bgb:pilot:e11:E6"), @2026-02-01));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtungsfrist_beginn_kenntnis_2283(entity_ref("urn:de:bgb:pilot:e11:V7"), entity_ref("urn:de:bgb:pilot:e11:E7"), @2026-03-01));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erblasser_selbst_anfechtungsberechtigt_2283(entity_ref("urn:de:bgb:pilot:e11:V8"), entity_ref("urn:de:bgb:pilot:e11:E8")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(bestaetigung_wirksam_2284(entity_ref("urn:de:bgb:pilot:e11:V9"), entity_ref("urn:de:bgb:pilot:e11:E9")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(dritte_koennen_nicht_mehr_anfechten_2285(entity_ref("urn:de:bgb:pilot:e11:V10")));
    expect truth_status == TRUE_ONLY;
}
