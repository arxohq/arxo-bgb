language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2203 (Aufgabe), § 2204 Abs. 1 (Auseinandersetzung), § 2205 Sätze 1-3
// (Verwaltung, Verfügungsbefugnis, unentgeltliche Verfügung), § 2206
// Abs. 1, 2 (Verbindlichkeiten, Einwilligungspflicht), § 2207 (erweiterte
// Befugnis), § 2208 Abs. 1, 2 (Beschränkung, Ausführung durch Erben).
test "§§ 2203–2208: Aufgabe, Verwaltung, Verbindlichkeiten, Beschränkung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": vollstrecker_hat_amt_angetreten_2203(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:V")) { origin case_input; }
        assert "f2": mehrere_erben_vorhanden_2204(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:V")) { origin case_input; }
        assert "f3": vollstrecker_hat_nachlass_zu_verwalten_2205(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:V")) { origin case_input; }
        assert "f4": unentgeltliche_verfuegung_sittlicher_pflicht_oder_anstand_entsprechend_2205(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:V")) { origin case_input; }
        assert "f5": verbindlichkeit_zur_ordnungsmaessigen_verwaltung_erforderlich_2206(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:V")) { origin case_input; }
        assert "f6": erbe_des_nachlasses_2206(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:V"), entity_ref("urn:de:bgb:pilot:x02:E")) { origin case_input; }
        assert "f7": erblasser_ordnet_unbeschraenkte_verpflichtungsbefugnis_an_2207(entity_ref("urn:de:bgb:pilot:x02:T2"), entity_ref("urn:de:bgb:pilot:x02:V2")) { origin case_input; }
        assert "f8": anzunehmen_dass_recht_nach_erblasserwillen_nicht_zusteht_2208(entity_ref("urn:de:bgb:pilot:x02:T3"), entity_ref("urn:de:bgb:pilot:x02:V3")) { origin case_input; }
        assert "f9": vollstrecker_muss_verfuegungen_nicht_selbst_ausfuehren_2208(entity_ref("urn:de:bgb:pilot:x02:T4"), entity_ref("urn:de:bgb:pilot:x02:V4"), entity_ref("urn:de:bgb:pilot:x02:E4")) { origin case_input; }
    }
    evaluate truth(aufgabe_letztwillige_verfuegungen_auszufuehren_2203(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:V")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vollstrecker_hat_auseinandersetzung_zu_bewirken_2204(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:V")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verwaltungs_und_verfuegungsbefugnis_2205(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:V")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(unentgeltliche_verfuegung_zulaessig_2205(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:V")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vollstrecker_darf_verbindlichkeit_eingehen_2206(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:V")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erbe_zur_einwilligung_verpflichtet_2206(entity_ref("urn:de:bgb:pilot:x02:T1"), entity_ref("urn:de:bgb:pilot:x02:E")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(erweiterte_verpflichtungsbefugnis_2207(entity_ref("urn:de:bgb:pilot:x02:T2"), entity_ref("urn:de:bgb:pilot:x02:V2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(recht_besteht_nicht_2208(entity_ref("urn:de:bgb:pilot:x02:T3"), entity_ref("urn:de:bgb:pilot:x02:V3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ausfuehrung_vom_erben_verlangbar_vermutet_2208(entity_ref("urn:de:bgb:pilot:x02:T4"), entity_ref("urn:de:bgb:pilot:x02:V4"), entity_ref("urn:de:bgb:pilot:x02:E4")));
    expect truth_status == TRUE_ONLY;
}
