language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2221 (Vergütung — Vermutung greift und Gegenausnahme greift, beide
// Seiten), § 2222 (Nacherbenvollstrecker), § 2223 (Vermächtnisvollstrecker),
// § 2224 Abs. 1, 2 (mehrere Vollstrecker), § 2225 (Erlöschen), § 2226
// (Kündigung), § 2227 (Entlassung).
test "§§ 2221–2227: Vergütung (beide Seiten), Sonderformen, mehrere Vollstrecker, Amtsende" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": vollstrecker_fuehrt_amt_2221(entity_ref("urn:de:bgb:pilot:x05:T1"), entity_ref("urn:de:bgb:pilot:x05:V1")) { origin case_input; }
        assert "f2": vollstrecker_fuehrt_amt_2221(entity_ref("urn:de:bgb:pilot:x05:T2"), entity_ref("urn:de:bgb:pilot:x05:V2")) { origin case_input; }
        assert "f3": erblasser_hat_anderes_zur_verguetung_bestimmt_2221(entity_ref("urn:de:bgb:pilot:x05:T2"), entity_ref("urn:de:bgb:pilot:x05:V2")) { origin case_input; }
        assert "f4": erblasser_ernennt_nacherbenvollstrecker_2222(entity_ref("urn:de:bgb:pilot:x05:T3"), entity_ref("urn:de:bgb:pilot:x05:V3")) { origin case_input; }
        assert "f5": erblasser_ernennt_vermaechtnisvollstrecker_2223(entity_ref("urn:de:bgb:pilot:x05:T4"), entity_ref("urn:de:bgb:pilot:x05:V4")) { origin case_input; }
        assert "f6": mehrere_testamentsvollstrecker_ernannt_2224(entity_ref("urn:de:bgb:pilot:x05:T5")) { origin case_input; }
        assert "f7": einer_von_mehreren_vollstreckern_weggefallen_2224(entity_ref("urn:de:bgb:pilot:x05:T5"), entity_ref("urn:de:bgb:pilot:x05:V5a"), entity_ref("urn:de:bgb:pilot:x05:V5b")) { origin case_input; }
        assert "f8": massregel_zur_erhaltung_eines_gemeinschaftlich_verwalteten_gegenstands_notwendig_2224(entity_ref("urn:de:bgb:pilot:x05:T5"), entity_ref("urn:de:bgb:pilot:x05:V5a")) { origin case_input; }
        assert "f9": vollstrecker_stirbt_oder_faellt_wie_2201_weg_2225(entity_ref("urn:de:bgb:pilot:x05:T6"), entity_ref("urn:de:bgb:pilot:x05:V6")) { origin case_input; }
        assert "f10": vollstrecker_erklaert_kuendigung_ggue_nachlassgericht_2226(entity_ref("urn:de:bgb:pilot:x05:T7"), entity_ref("urn:de:bgb:pilot:x05:V7")) { origin case_input; }
        assert "f11": wichtiger_grund_fuer_entlassung_vorliegt_2227(entity_ref("urn:de:bgb:pilot:x05:T8"), entity_ref("urn:de:bgb:pilot:x05:V8")) { origin case_input; }
    }
    evaluate truth(angemessene_verguetung_verlangbar_2221(entity_ref("urn:de:bgb:pilot:x05:T1"), entity_ref("urn:de:bgb:pilot:x05:V1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(angemessene_verguetung_verlangbar_2221(entity_ref("urn:de:bgb:pilot:x05:T2"), entity_ref("urn:de:bgb:pilot:x05:V2")));
    expect truth_status == NEITHER;
    evaluate truth(nacherbenvollstreckung_zulaessig_2222(entity_ref("urn:de:bgb:pilot:x05:T3"), entity_ref("urn:de:bgb:pilot:x05:V3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisvollstreckung_zulaessig_2223(entity_ref("urn:de:bgb:pilot:x05:T4"), entity_ref("urn:de:bgb:pilot:x05:V4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(gemeinschaftliche_amtsfuehrung_2224(entity_ref("urn:de:bgb:pilot:x05:T5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(uebrige_fuehren_amt_allein_2224(entity_ref("urn:de:bgb:pilot:x05:T5"), entity_ref("urn:de:bgb:pilot:x05:V5a")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(einzelner_vollstrecker_darf_ohne_zustimmung_handeln_2224(entity_ref("urn:de:bgb:pilot:x05:T5"), entity_ref("urn:de:bgb:pilot:x05:V5a")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(amt_erlischt_2225(entity_ref("urn:de:bgb:pilot:x05:T6"), entity_ref("urn:de:bgb:pilot:x05:V6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kuendigung_wirksam_2226(entity_ref("urn:de:bgb:pilot:x05:T7"), entity_ref("urn:de:bgb:pilot:x05:V7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(entlassung_zulaessig_2227(entity_ref("urn:de:bgb:pilot:x05:T8"), entity_ref("urn:de:bgb:pilot:x05:V8")));
    expect truth_status == TRUE_ONLY;
}
