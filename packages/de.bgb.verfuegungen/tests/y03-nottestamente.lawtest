language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2249 Abs. 1 (Bürgermeistertestament), Abs. 2 Satz 2 (unbegründete
// Besorgnis unschädlich), Abs. 6 (Formverstoß unschädlich bei sicherer
// Wiedergabe), § 2250 Abs. 1, 2 (abgesperrter Ort, nahe Todesgefahr),
// § 2251 (Seetestament).
test "§§ 2249–2251: Nottestamente vor Bürgermeister, drei Zeugen, auf See" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": besorgnis_frueheren_todes_vor_notartestament_2249(entity_ref("urn:de:bgb:pilot:y03:T1"), entity_ref("urn:de:bgb:pilot:y03:E1")) { origin case_input; }
        assert "f2": buergermeister_niederschrift_mit_zwei_zeugen_2249(entity_ref("urn:de:bgb:pilot:y03:T1"), entity_ref("urn:de:bgb:pilot:y03:E1")) { origin case_input; }
        assert "f3": besorgnis_unbegruendet_2249(entity_ref("urn:de:bgb:pilot:y03:T2")) { origin case_input; }
        assert "f4": formfehler_bei_niederschrift_aber_sichere_wiedergabe_2249(entity_ref("urn:de:bgb:pilot:y03:T3")) { origin case_input; }
        assert "f5": ort_infolge_ausserordentlicher_umstaende_abgesperrt_2250(entity_ref("urn:de:bgb:pilot:y03:T4"), entity_ref("urn:de:bgb:pilot:y03:E4")) { origin case_input; }
        assert "f6": nottestament_2249_form_oder_drei_zeugen_2250(entity_ref("urn:de:bgb:pilot:y03:T4"), entity_ref("urn:de:bgb:pilot:y03:E4")) { origin case_input; }
        assert "f7": nahe_todesgefahr_notartestament_und_2249_nicht_mehr_moeglich_2250(entity_ref("urn:de:bgb:pilot:y03:T5"), entity_ref("urn:de:bgb:pilot:y03:E5")) { origin case_input; }
        assert "f8": muendliche_erklaerung_vor_drei_zeugen_2250(entity_ref("urn:de:bgb:pilot:y03:T5"), entity_ref("urn:de:bgb:pilot:y03:E5")) { origin case_input; }
        assert "f9": seereise_deutsches_schiff_ausserhalb_inlaendischen_hafens_2251(entity_ref("urn:de:bgb:pilot:y03:T6"), entity_ref("urn:de:bgb:pilot:y03:E6")) { origin case_input; }
        assert "f10": seetestament_vor_drei_zeugen_2251(entity_ref("urn:de:bgb:pilot:y03:T6"), entity_ref("urn:de:bgb:pilot:y03:E6")) { origin case_input; }
    }
    evaluate truth(buergermeistertestament_formwirksam_2249(entity_ref("urn:de:bgb:pilot:y03:T1"), entity_ref("urn:de:bgb:pilot:y03:E1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(unbegruendete_besorgnis_steht_gueltigkeit_nicht_entgegen_2249(entity_ref("urn:de:bgb:pilot:y03:T2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(formverstoss_steht_wirksamkeit_nicht_entgegen_2249(entity_ref("urn:de:bgb:pilot:y03:T3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(abgesperrter_ort_nottestament_formwirksam_2250(entity_ref("urn:de:bgb:pilot:y03:T4"), entity_ref("urn:de:bgb:pilot:y03:E4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(todesgefahr_nottestament_formwirksam_2250(entity_ref("urn:de:bgb:pilot:y03:T5"), entity_ref("urn:de:bgb:pilot:y03:E5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(seetestament_formwirksam_2251(entity_ref("urn:de:bgb:pilot:y03:T6"), entity_ref("urn:de:bgb:pilot:y03:E6")));
    expect truth_status == TRUE_ONLY;
}
