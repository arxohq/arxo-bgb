language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2197 Abs. 1, 2 (Ernennung, Ersatzernennung), § 2198 Abs. 1 (Bestimmung
// durch Dritten), § 2199 Abs. 1, 2 (Mitvollstrecker, Nachfolger),
// § 2201 (Unwirksamkeit bei Geschäftsunfähigkeit), § 2202 Abs. 1, 3 (Beginn
// mit Annahme; Amt gilt als abgelehnt nach Fristablauf).
test "§§ 2197–2202: Ernennung, Bestimmung, Mitvollstrecker, Unwirksamkeit, Amtsbeginn" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erblasser_ernennt_testamentsvollstrecker_2197(entity_ref("urn:de:bgb:pilot:x01:T1"), entity_ref("urn:de:bgb:pilot:x01:V1")) { origin case_input; }
        assert "f2": ernennung_fuer_wegfallsfall_eines_anderen_2197(entity_ref("urn:de:bgb:pilot:x01:T2"), entity_ref("urn:de:bgb:pilot:x01:V2"), entity_ref("urn:de:bgb:pilot:x01:V1")) { origin case_input; }
        assert "f3": erblasser_ueberlaesst_bestimmung_einem_dritten_2198(entity_ref("urn:de:bgb:pilot:x01:T3"), entity_ref("urn:de:bgb:pilot:x01:D")) { origin case_input; }
        assert "f4": dritter_erklaert_bestimmung_ggue_nachlassgericht_oeffentlich_beglaubigt_2198(entity_ref("urn:de:bgb:pilot:x01:T3"), entity_ref("urn:de:bgb:pilot:x01:D"), entity_ref("urn:de:bgb:pilot:x01:V3")) { origin case_input; }
        assert "f5": erblasser_ermaechtigt_zur_ernennung_von_mitvollstreckern_2199(entity_ref("urn:de:bgb:pilot:x01:T4"), entity_ref("urn:de:bgb:pilot:x01:V4")) { origin case_input; }
        assert "f6": erblasser_ermaechtigt_zur_ernennung_eines_nachfolgers_2199(entity_ref("urn:de:bgb:pilot:x01:T4"), entity_ref("urn:de:bgb:pilot:x01:V4")) { origin case_input; }
        assert "f7": vollstrecker_bei_amtsantritt_geschaeftsunfaehig_oder_beschraenkt_oder_betreut_2201(entity_ref("urn:de:bgb:pilot:x01:T5"), entity_ref("urn:de:bgb:pilot:x01:V5")) { origin case_input; }
        assert "f8": ernannter_nimmt_amt_an_2202(entity_ref("urn:de:bgb:pilot:x01:T6"), entity_ref("urn:de:bgb:pilot:x01:V6"), @2026-04-01) { origin case_input; }
        assert "f9": annahme_frist_abgelaufen_ohne_erklaerung_2202(entity_ref("urn:de:bgb:pilot:x01:T7"), entity_ref("urn:de:bgb:pilot:x01:V7")) { origin case_input; }
    }
    evaluate truth(ernennung_wirksam_2197(entity_ref("urn:de:bgb:pilot:x01:T1"), entity_ref("urn:de:bgb:pilot:x01:V1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ersatzernennung_wirksam_2197(entity_ref("urn:de:bgb:pilot:x01:T2"), entity_ref("urn:de:bgb:pilot:x01:V2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(bestimmung_durch_dritten_wirksam_2198(entity_ref("urn:de:bgb:pilot:x01:T3"), entity_ref("urn:de:bgb:pilot:x01:V3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ermaechtigung_zu_mitvollstreckern_wirksam_2199(entity_ref("urn:de:bgb:pilot:x01:T4"), entity_ref("urn:de:bgb:pilot:x01:V4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ermaechtigung_zu_nachfolger_wirksam_2199(entity_ref("urn:de:bgb:pilot:x01:T4"), entity_ref("urn:de:bgb:pilot:x01:V4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ernennung_unwirksam_2201(entity_ref("urn:de:bgb:pilot:x01:T5"), entity_ref("urn:de:bgb:pilot:x01:V5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(amt_beginnt_mit_annahme_2202(entity_ref("urn:de:bgb:pilot:x01:T6"), entity_ref("urn:de:bgb:pilot:x01:V6"), @2026-04-01));
    expect truth_status == TRUE_ONLY;
    evaluate truth(amt_gilt_als_abgelehnt_2202(entity_ref("urn:de:bgb:pilot:x01:T7"), entity_ref("urn:de:bgb:pilot:x01:V7")));
    expect truth_status == TRUE_ONLY;
}
