language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§ 2326: Ergänzung bleibt bei genau der Hälfte des gesetzlichen Erbteils verlangbar" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": pflichtteilsberechtigter_mit_erbteil_2326(entity_ref("urn:de:bgb:pilot:v15:E"), entity_ref("urn:de:bgb:pilot:v15:P")) { origin case_input; }
        assert "f2": hinterlassener_erbteil_genau_haelfte_gesetzlich_2326(entity_ref("urn:de:bgb:pilot:v15:E"), entity_ref("urn:de:bgb:pilot:v15:P")) { origin case_input; }
    }
    evaluate truth(pflichtteilsergaenzung_auch_bei_haelfte_verlangbar_2326(entity_ref("urn:de:bgb:pilot:v15:E"), entity_ref("urn:de:bgb:pilot:v15:P")));
    expect truth_status == TRUE_ONLY;
}
