language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2320–2322: Nachrücker und Ausschlagungsbegünstigter tragen die Pflichtteilslast" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": anstelle_pflichtteilsberechtigten_gesetzlicher_erbe_2320(entity_ref("urn:de:bgb:pilot:v13:E"), entity_ref("urn:de:bgb:pilot:v13:H"), entity_ref("urn:de:bgb:pilot:v13:L")) { origin case_input; }
        assert "f2": erlangter_vorteil_2320(entity_ref("urn:de:bgb:pilot:v13:E"), entity_ref("urn:de:bgb:pilot:v13:H"), entity_ref("urn:de:bgb:pilot:v13:L"), 7000.00 EUR) { origin case_input; }
        assert "f3": pflichtteilsberechtigter_schlaegt_vermaechtnis_aus_2321(entity_ref("urn:de:bgb:pilot:v13:E"), entity_ref("urn:de:bgb:pilot:v13:L")) { origin case_input; }
        assert "f4": ausschlagung_kommt_zugute_2321(entity_ref("urn:de:bgb:pilot:v13:E"), entity_ref("urn:de:bgb:pilot:v13:B"), entity_ref("urn:de:bgb:pilot:v13:L"), 4000.00 EUR) { origin case_input; }
        assert "f5": ausgeschlagene_erbschaft_oder_vermaechtnis_beschwert_2322(entity_ref("urn:de:bgb:pilot:v13:E"), entity_ref("urn:de:bgb:pilot:v13:B"), entity_ref("urn:de:bgb:pilot:v13:L")) { origin case_input; }
        assert "f6": betrag_zur_deckung_pflichtteilslast_verbleibt_2322(entity_ref("urn:de:bgb:pilot:v13:E"), entity_ref("urn:de:bgb:pilot:v13:B"), entity_ref("urn:de:bgb:pilot:v13:L")) { origin case_input; }
    }
    evaluate truth(pflichtteilslast_bis_vorteil_zu_tragen_2320(entity_ref("urn:de:bgb:pilot:v13:E"), entity_ref("urn:de:bgb:pilot:v13:H"), entity_ref("urn:de:bgb:pilot:v13:L"), 7000.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(pflichtteilslast_bis_vorteil_zu_tragen_2321(entity_ref("urn:de:bgb:pilot:v13:E"), entity_ref("urn:de:bgb:pilot:v13:B"), entity_ref("urn:de:bgb:pilot:v13:L"), 4000.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnis_oder_auflage_kuerzbar_2322(entity_ref("urn:de:bgb:pilot:v13:E"), entity_ref("urn:de:bgb:pilot:v13:B"), entity_ref("urn:de:bgb:pilot:v13:L")));
    expect truth_status == TRUE_ONLY;
}
