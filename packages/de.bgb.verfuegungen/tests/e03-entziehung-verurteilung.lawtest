language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2333 Abs. 1 Nr. 4: rechtskräftige Verurteilung (Tatsache) UND
// Unzumutbarkeit der Teilhabe (Wertung des Gerichts, Kanal §47.3) —
// beides vorliegend.
test "§ 2333 Abs. 1 Nr. 4: Entziehung nach Verurteilung — Gericht bejaht Unzumutbarkeit" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": entziehung_durch_verfuegung_2336(entity_ref("urn:de:bgb:pilot:e03:E"), entity_ref("urn:de:bgb:pilot:e03:P")) { origin case_input; }
        assert "f2": wegen_vorsaetzlicher_straftat_einjahr_verurteilt_2333(entity_ref("urn:de:bgb:pilot:e03:E"), entity_ref("urn:de:bgb:pilot:e03:P")) { origin case_input; }
        assert "f3": teilhabe_am_nachlass_unzumutbar_2333(entity_ref("urn:de:bgb:pilot:e03:E"), entity_ref("urn:de:bgb:pilot:e03:P")) { origin adjudicated; }
    }
    evaluate truth(pflichtteil_entziehbar_2333(entity_ref("urn:de:bgb:pilot:e03:E"), entity_ref("urn:de:bgb:pilot:e03:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
