language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2180 Abs. 1 (keine Ausschlagung nach Annahme), Abs. 2 (Wirksamkeit von
// Annahme/Ausschlagung), Abs. 3 (Verweisung auf Erbschaftsvorschriften),
// § 2181 (Fälligkeit bei Beliebigkeit des Beschwerten), § 2179 (Schwebezeit
// — Verweisung).
test "§§ 2179–2181: Schwebezeit, Annahme/Ausschlagung, Fälligkeit bei Beliebigkeit" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": schwebezeit_2177_oder_2178_2179(entity_ref("urn:de:bgb:pilot:w03:T1")) { origin case_input; }
        assert "f2": vermaechtnis_angenommen_2180(entity_ref("urn:de:bgb:pilot:w03:T2"), entity_ref("urn:de:bgb:pilot:w03:B")) { origin case_input; }
        assert "f3": annahme_oder_ausschlagung_gegenueber_beschwertem_erklaert_nach_erbfall_und_unbedingt_2180(entity_ref("urn:de:bgb:pilot:w03:T3"), entity_ref("urn:de:bgb:pilot:w03:B2")) { origin case_input; }
        assert "f4": vermaechtnis_angeordnet_2174(entity_ref("urn:de:bgb:pilot:w03:T4"), entity_ref("urn:de:bgb:pilot:w03:B3")) { origin case_input; }
        assert "f5": erfuellungszeit_dem_belieben_des_beschwerten_ueberlassen_2181(entity_ref("urn:de:bgb:pilot:w03:T5"), entity_ref("urn:de:bgb:pilot:w03:BE")) { origin case_input; }
    }
    evaluate truth(vorschriften_fuer_aufschiebend_bedingte_leistung_in_schwebezeit_anwendbar_2179(entity_ref("urn:de:bgb:pilot:w03:T1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ausschlagung_nach_annahme_ausgeschlossen_2180(entity_ref("urn:de:bgb:pilot:w03:T2"), entity_ref("urn:de:bgb:pilot:w03:B")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(annahme_oder_ausschlagung_wirksam_2180(entity_ref("urn:de:bgb:pilot:w03:T3"), entity_ref("urn:de:bgb:pilot:w03:B2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(p1950_p1952_abs1_3_p1953_abs1_2_auf_vermaechtnisannahme_entsprechend_anwendbar_2180(entity_ref("urn:de:bgb:pilot:w03:T4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(leistung_faellig_mit_tod_des_beschwerten_vermutet_2181(entity_ref("urn:de:bgb:pilot:w03:T5"), entity_ref("urn:de:bgb:pilot:w03:BE")));
    expect truth_status == TRUE_ONLY;
}
