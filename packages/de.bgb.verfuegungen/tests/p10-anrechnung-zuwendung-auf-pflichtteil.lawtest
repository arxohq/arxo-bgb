language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// Die Familienkonstellation entspricht dem BMJ-Beispiel der p01: gesetzlicher
// Erbteil der Tochter 1/2, Pflichtteilsquote 1/4. Hinzu tritt eine nach § 2315
// ausdrücklich auf den Pflichtteil anzurechnende Zuwendung von 10.000 EUR.
test "§ 2315: Zuwendung wird dem Nachlass hinzugerechnet und auf den Pflichtteil angerechnet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": de.bgb.erbfolge::erblasser(entity_ref("urn:de:bgb:pilot:v10:E"), entity_ref("urn:de:bgb:pilot:v10:D")) { origin case_input; }
        assert "f2": de.bgb.erbfolge::erbfall_am(entity_ref("urn:de:bgb:pilot:v10:E"), @2026-03-01) { origin case_input; }
        assert "f3": de.bgb.erbfolge::familie(entity_ref("urn:de:bgb:pilot:v10:E"), entity_ref("urn:de:bgb:pilot:v10:F")) { origin case_input; }
        assert "f4": de.bgb.erbfolge::ehe_beim_erbfall(entity_ref("urn:de:bgb:pilot:v10:E"), entity_ref("urn:de:bgb:pilot:v10:EHE")) { origin case_input; }
        assert "f5": de.bgb.ehe::ehegatten(entity_ref("urn:de:bgb:pilot:v10:EHE"), entity_ref("urn:de:bgb:pilot:v10:D"), entity_ref("urn:de:bgb:pilot:v10:S")) { origin case_input; }
        assert "f6": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:v10:E"), entity_ref("urn:de:bgb:pilot:v10:S")) { origin case_input; }
        assert "f7": de.bgb.ehe::kein_ehevertrag(entity_ref("urn:de:bgb:pilot:v10:EHE")) { origin case_input; }
        assert "f8": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:pilot:v10:F"), entity_ref("urn:de:bgb:pilot:v10:D"), entity_ref("urn:de:bgb:pilot:v10:T")) { origin case_input; }
        assert "f9": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:v10:E"), entity_ref("urn:de:bgb:pilot:v10:T")) { origin case_input; }
        assert "f10": durch_verfuegung_von_todes_wegen_ausgeschlossen(entity_ref("urn:de:bgb:pilot:v10:E"), entity_ref("urn:de:bgb:pilot:v10:T")) { origin case_input; }
        assert "f11": nachlasswert(entity_ref("urn:de:bgb:pilot:v10:E"), 100000.00 EUR) { origin case_input; }
        assert "f12": zuwendung_unter_leben_2315(entity_ref("urn:de:bgb:pilot:v10:E"), entity_ref("urn:de:bgb:pilot:v10:T"), entity_ref("urn:de:bgb:pilot:v10:Z")) { origin case_input; }
        assert "f13": anrechnung_auf_pflichtteil_bestimmt_2315(entity_ref("urn:de:bgb:pilot:v10:Z")) { origin case_input; }
        assert "f14": wert_zuwendung_zeit_leistung_2315(entity_ref("urn:de:bgb:pilot:v10:Z"), 10000.00 EUR) { origin case_input; }
    }
    evaluate truth(zuwendung_auf_pflichtteil_anzurechnen_2315(entity_ref("urn:de:bgb:pilot:v10:E"), entity_ref("urn:de:bgb:pilot:v10:T"), entity_ref("urn:de:bgb:pilot:v10:Z"), 10000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(nachlasswert_mit_zuwendungen_2315(entity_ref("urn:de:bgb:pilot:v10:E"), entity_ref("urn:de:bgb:pilot:v10:T"), 110000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pflichtteil_vor_anrechnung_2315(entity_ref("urn:de:bgb:pilot:v10:E"), entity_ref("urn:de:bgb:pilot:v10:T"), 27500.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(pflichtteil_nach_anrechnung_2315(entity_ref("urn:de:bgb:pilot:v10:E"), entity_ref("urn:de:bgb:pilot:v10:T"), 17500.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
