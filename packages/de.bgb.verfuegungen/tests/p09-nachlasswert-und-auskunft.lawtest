language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2313, 2314: bedingte Positionen und Auskunft des Erben" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": aufschiebend_bedingtes_recht_2313(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:R1")) { origin case_input; }
        assert "f2": aufloesend_bedingte_verbindlichkeit_2313(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:V1")) { origin case_input; }
        assert "f3": bedingung_eingetreten_2313(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:R1")) { origin case_input; }
        assert "f4": ungewisses_recht_2313(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:R2")) { origin case_input; }
        assert "j1": ordnungsmaessige_verwaltung_erfordert_feststellung_2313(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:H"), entity_ref("urn:de:bgb:pilot:v09:R2")) { origin adjudicated; }
        assert "f5": unsicheres_recht_2313(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:R3")) { origin case_input; }
        assert "j2": ordnungsmaessige_verwaltung_erfordert_verfolgung_2313(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:H"), entity_ref("urn:de:bgb:pilot:v09:R3")) { origin adjudicated; }
        assert "f6": pflichtteilsberechtigter_nicht_erbe_2314(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:P")) { origin case_input; }
        assert "f7": nachlassauskunft_verlangt_2314(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:P"), entity_ref("urn:de:bgb:pilot:v09:H")) { origin case_input; }
        assert "f8": beiziehung_zum_verzeichnis_verlangt_2314(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:P")) { origin case_input; }
        assert "f9": wertermittlung_nachlassgegenstaende_verlangt_2314(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:P")) { origin case_input; }
        assert "f10": amtliches_oder_notarielles_verzeichnis_verlangt_2314(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:P")) { origin case_input; }
        assert "f11": kosten_nachlassauskunft_2314_entstanden(entity_ref("urn:de:bgb:pilot:v09:E")) { origin case_input; }
    }
    evaluate truth(nachlassposition_ausser_ansatz_2313(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:R1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(nachlassposition_als_unbedingt_anzusetzen_2313(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:V1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ausgleichung_nach_veraenderter_rechtslage_2313_erforderlich(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:R1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(erbe_muss_ungewisses_recht_feststellen_2313(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:H"), entity_ref("urn:de:bgb:pilot:v09:R2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(erbe_muss_unsicheres_recht_verfolgen_2313(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:H"), entity_ref("urn:de:bgb:pilot:v09:R3")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(erbe_muss_nachlassauskunft_erteilen_2314(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:H"), entity_ref("urn:de:bgb:pilot:v09:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(beiziehung_zum_verzeichnis_verlangbar_2314(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wertermittlung_nachlassgegenstaende_verlangbar_2314(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(amtliches_oder_notarielles_verzeichnis_verlangbar_2314(entity_ref("urn:de:bgb:pilot:v09:E"), entity_ref("urn:de:bgb:pilot:v09:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(kosten_nachlassauskunft_traegt_nachlass_2314(entity_ref("urn:de:bgb:pilot:v09:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
