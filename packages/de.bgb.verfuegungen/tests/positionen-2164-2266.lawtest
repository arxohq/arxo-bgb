language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2164, 2174, 2231, 2266: Verfügungspositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.verfuegungen::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_2164(entity_ref("urn:test:t2164"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_2174(entity_ref("urn:test:t2174"), entity_ref("urn:test:p2174"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_2231(entity_ref("urn:test:t2231"), entity_ref("urn:test:p2231"), @2026-01-01) { origin case_input; }
 assert "d": position_trigger_2266(entity_ref("urn:test:t2266"), entity_ref("urn:test:p2266"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Zubehoer2164, ACTIVE); expect position(Anspruch2174, ACTIVE); expect position(Form2231, ACTIVE); expect position(Nottestament2266, ACTIVE);
}

test "§§ 2164, 2174, 2231, 2266: Verfügungspositionen bestätigt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.verfuegungen::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_2164(entity_ref("urn:test:t2164"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_2174(entity_ref("urn:test:t2174"), entity_ref("urn:test:p2174"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_2231(entity_ref("urn:test:t2231"), entity_ref("urn:test:p2231"), @2026-01-01) { origin case_input; }
 assert "d": position_trigger_2266(entity_ref("urn:test:t2266"), entity_ref("urn:test:p2266"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Zubehoer2164, ACTIVE); expect position(Anspruch2174, ACTIVE); expect position(Form2231, ACTIVE); expect position(Nottestament2266, ACTIVE);
}
