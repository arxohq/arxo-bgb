language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2192 (Verweisung auf Vermächtnisvorschriften), § 2193 Abs. 1
// (Begünstigtenbestimmung zulässig) und Abs. 2 (Kläger darf nach
// Fristablauf bestimmen), § 2194 Satz 1, 2 (Vollziehungsberechtigte und
// Behörde), § 2195 (Unwirksamkeit erstreckt sich nur bei Kausalität), § 2196
// Abs. 1, 2 (Herausgabe nach Bereicherungsrecht).
test "§§ 2192–2196: Auflage — Verweisung, Bestimmung, Vollziehung, Unwirksamkeit" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": auflage_angeordnet_2192(entity_ref("urn:de:bgb:pilot:v05:T1")) { origin case_input; }
        assert "f2": auflage_zweck_bestimmt_beguenstigtenbestimmung_ueberlassen_2193(entity_ref("urn:de:bgb:pilot:v05:T2")) { origin case_input; }
        assert "f3": beschwerter_zur_vollziehung_rechtskraeftig_verurteilt_2193(entity_ref("urn:de:bgb:pilot:v05:T3"), entity_ref("urn:de:bgb:pilot:v05:B1")) { origin case_input; }
        assert "f4": frist_zur_vollziehung_abgelaufen_ohne_erfuellung_2193(entity_ref("urn:de:bgb:pilot:v05:T3"), entity_ref("urn:de:bgb:pilot:v05:B1")) { origin case_input; }
        assert "f5": vollziehung_kann_verlangt_werden_von_2194(entity_ref("urn:de:bgb:pilot:v05:T4"), entity_ref("urn:de:bgb:pilot:v05:R")) { origin case_input; }
        assert "f6": vollziehung_im_oeffentlichen_interesse_2194(entity_ref("urn:de:bgb:pilot:v05:T5")) { origin case_input; }
        assert "f7": auflage_unwirksam_2195(entity_ref("urn:de:bgb:pilot:v05:T6")) { origin case_input; }
        assert "f8": zuwendung_ohne_auflage_nicht_gemacht_worden_waere_2195(entity_ref("urn:de:bgb:pilot:v05:T6")) { origin case_input; }
        assert "f9": auflage_unwirksam_2195(entity_ref("urn:de:bgb:pilot:v05:T7")) { origin case_input; }
        assert "f10": vollziehung_unmoeglich_durch_beschwerten_zu_vertreten_2196(entity_ref("urn:de:bgb:pilot:v05:T8"), entity_ref("urn:de:bgb:pilot:v05:B2")) { origin case_input; }
        assert "f11": vollziehung_kann_verlangt_werden_von_2194(entity_ref("urn:de:bgb:pilot:v05:T8"), entity_ref("urn:de:bgb:pilot:v05:R2")) { origin case_input; }
    }
    evaluate truth(regeln_2065_2147_2148_2154_bis_2156_2161_2171_2181_auf_auflage_entsprechend_anwendbar_2192(entity_ref("urn:de:bgb:pilot:v05:T1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(beguenstigtenbestimmung_zulaessig_2193(entity_ref("urn:de:bgb:pilot:v05:T2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(klaeger_darf_bestimmung_treffen_2193(entity_ref("urn:de:bgb:pilot:v05:T3"), entity_ref("urn:de:bgb:pilot:v05:B1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vollziehung_verlangbar_2194(entity_ref("urn:de:bgb:pilot:v05:T4"), entity_ref("urn:de:bgb:pilot:v05:R")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zustaendige_behoerde_kann_vollziehung_verlangen_2194(entity_ref("urn:de:bgb:pilot:v05:T5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zuwendung_unter_auflage_ebenfalls_unwirksam_2195(entity_ref("urn:de:bgb:pilot:v05:T6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zuwendung_unter_auflage_ebenfalls_unwirksam_2195(entity_ref("urn:de:bgb:pilot:v05:T7")));
    expect truth_status == NEITHER;
    evaluate truth(herausgabe_der_zuwendung_nach_bereicherungsrecht_forderbar_2196(entity_ref("urn:de:bgb:pilot:v05:T8"), entity_ref("urn:de:bgb:pilot:v05:R2")));
    expect truth_status == TRUE_ONLY;
}
