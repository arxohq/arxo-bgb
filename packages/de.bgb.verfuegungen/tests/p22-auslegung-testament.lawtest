language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2066–2073: Auslegung unbestimmter Bedachtenbezeichnungen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": gesetzliche_erben_ohne_naehere_bestimmung_bedacht_2066(entity_ref("urn:de:bgb:pilot:v22:T1"), entity_ref("urn:de:bgb:pilot:v22:E")) { origin case_input; }
        assert "f2": zuwendung_unbedingt_oder_bis_erbfall_eingetreten_2066(entity_ref("urn:de:bgb:pilot:v22:T1")) { origin case_input; }
        assert "f3": gesetzlicher_erbteil_am_erbfall_2066(entity_ref("urn:de:bgb:pilot:v22:T1"), entity_ref("urn:de:bgb:pilot:v22:A"), 1, 2) { origin case_input; }
        assert "f4": zuwendung_bedingt_und_nach_erbfall_eingetreten_2066(entity_ref("urn:de:bgb:pilot:v22:T1")) { origin case_input; }
        assert "f5": gesetzlicher_erbteil_bei_spaeterem_eintritt_2066(entity_ref("urn:de:bgb:pilot:v22:T1"), entity_ref("urn:de:bgb:pilot:v22:B"), 1, 1) { origin case_input; }
        assert "f6": verwandte_ohne_naehere_bestimmung_bedacht_2067(entity_ref("urn:de:bgb:pilot:v22:T2"), entity_ref("urn:de:bgb:pilot:v22:E")) { origin case_input; }
        assert "f7": verwandter_gesetzlicher_erbteil_am_erbfall_2067(entity_ref("urn:de:bgb:pilot:v22:T2"), entity_ref("urn:de:bgb:pilot:v22:C"), 1, 1) { origin case_input; }
        assert "f8": kind_ohne_naehere_bestimmung_bedacht_2068(entity_ref("urn:de:bgb:pilot:v22:T3"), entity_ref("urn:de:bgb:pilot:v22:K")) { origin case_input; }
        assert "f9": kind_vor_testament_mit_abkoemmlingen_verstorben_2068(entity_ref("urn:de:bgb:pilot:v22:T3"), entity_ref("urn:de:bgb:pilot:v22:K")) { origin case_input; }
        assert "f10": abkoemmling_tritt_gesetzlich_an_stelle_des_kindes_2068(entity_ref("urn:de:bgb:pilot:v22:T3"), entity_ref("urn:de:bgb:pilot:v22:EK"), entity_ref("urn:de:bgb:pilot:v22:K")) { origin case_input; }
        assert "f11": abkoemmling_bedacht_2069(entity_ref("urn:de:bgb:pilot:v22:T4"), entity_ref("urn:de:bgb:pilot:v22:D")) { origin case_input; }
        assert "f12": bedachter_abkoemmling_nach_testament_weggefallen_2069(entity_ref("urn:de:bgb:pilot:v22:T4"), entity_ref("urn:de:bgb:pilot:v22:D")) { origin case_input; }
        assert "f13": abkoemmling_tritt_gesetzlich_an_stelle_bedachten_2069(entity_ref("urn:de:bgb:pilot:v22:T4"), entity_ref("urn:de:bgb:pilot:v22:ED"), entity_ref("urn:de:bgb:pilot:v22:D")) { origin case_input; }
        assert "f14": abkoemmlinge_eines_dritten_ohne_naehere_bestimmung_bedacht_2070(entity_ref("urn:de:bgb:pilot:v22:T5")) { origin case_input; }
        assert "f15": abkoemmling_zum_massgeblichen_zeitpunkt_noch_nicht_gezeugt_2070(entity_ref("urn:de:bgb:pilot:v22:T5"), entity_ref("urn:de:bgb:pilot:v22:U")) { origin case_input; }
        assert "f16": personengruppe_oder_dienstverhaeltnis_ohne_naehere_bestimmung_bedacht_2071(entity_ref("urn:de:bgb:pilot:v22:T6")) { origin case_input; }
        assert "f17": person_zum_erbfall_in_bezeichneter_gruppe_oder_verhaeltnis_2071(entity_ref("urn:de:bgb:pilot:v22:T6"), entity_ref("urn:de:bgb:pilot:v22:G")) { origin case_input; }
        assert "f18": arme_ohne_naehere_bestimmung_bedacht_2072(entity_ref("urn:de:bgb:pilot:v22:T7")) { origin case_input; }
        assert "f19": oeffentliche_armenkasse_letzter_wohnsitzgemeinde_2072(entity_ref("urn:de:bgb:pilot:v22:T7"), entity_ref("urn:de:bgb:pilot:v22:F")) { origin case_input; }
        assert "f20": mehrdeutige_bezeichnung_trifft_zu_2073(entity_ref("urn:de:bgb:pilot:v22:T8"), entity_ref("urn:de:bgb:pilot:v22:M1")) { origin case_input; }
        assert "f21": mehrdeutige_bezeichnung_trifft_zu_2073(entity_ref("urn:de:bgb:pilot:v22:T8"), entity_ref("urn:de:bgb:pilot:v22:M2")) { origin case_input; }
        assert "f22": bedachter_nicht_ermittelbar_2073(entity_ref("urn:de:bgb:pilot:v22:T8")) { origin case_input; }
    }
    evaluate truth(als_gesetzlicher_erbe_bedacht_2066(entity_ref("urn:de:bgb:pilot:v22:T1"), entity_ref("urn:de:bgb:pilot:v22:A"), 1, 2));
    expect truth_status == TRUE_ONLY;
    evaluate truth(als_gesetzlicher_erbe_beim_spaeteren_eintritt_bedacht_2066(entity_ref("urn:de:bgb:pilot:v22:T1"), entity_ref("urn:de:bgb:pilot:v22:B"), 1, 1));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verwandter_als_gesetzlicher_erbe_bedacht_2067(entity_ref("urn:de:bgb:pilot:v22:T2"), entity_ref("urn:de:bgb:pilot:v22:C"), 1, 1));
    expect truth_status == TRUE_ONLY;
    evaluate truth(abkoemmling_als_ersatz_bedacht_vermutet_2068(entity_ref("urn:de:bgb:pilot:v22:T3"), entity_ref("urn:de:bgb:pilot:v22:EK"), entity_ref("urn:de:bgb:pilot:v22:K")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(abkoemmling_als_ersatz_bedacht_vermutet_2069(entity_ref("urn:de:bgb:pilot:v22:T4"), entity_ref("urn:de:bgb:pilot:v22:ED"), entity_ref("urn:de:bgb:pilot:v22:D")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(abkoemmling_nicht_bedacht_vermutet_2070(entity_ref("urn:de:bgb:pilot:v22:T5"), entity_ref("urn:de:bgb:pilot:v22:U")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(person_als_gruppenmitglied_bedacht_vermutet_2071(entity_ref("urn:de:bgb:pilot:v22:T6"), entity_ref("urn:de:bgb:pilot:v22:G")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(armenkasse_unter_verteilungsauflage_bedacht_vermutet_2072(entity_ref("urn:de:bgb:pilot:v22:T7"), entity_ref("urn:de:bgb:pilot:v22:F")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(person_zu_gleichen_teilen_bedacht_2073(entity_ref("urn:de:bgb:pilot:v22:T8"), entity_ref("urn:de:bgb:pilot:v22:M1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(person_zu_gleichen_teilen_bedacht_2073(entity_ref("urn:de:bgb:pilot:v22:T8"), entity_ref("urn:de:bgb:pilot:v22:M2")));
    expect truth_status == TRUE_ONLY;
}
