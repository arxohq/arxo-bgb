language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§ 2332: Anspruch gegen Beschenkten beginnt mit Erbfall und Ausschlagung hemmt nicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": anspruch_gegen_beschenkten_2329(entity_ref("urn:de:bgb:pilot:v19:A"), entity_ref("urn:de:bgb:pilot:v19:E"), entity_ref("urn:de:bgb:pilot:v19:P")) { origin case_input; }
        assert "f2": de.bgb.erbfolge::erbfall_am(entity_ref("urn:de:bgb:pilot:v19:E"), @2024-04-12) { origin case_input; }
        assert "f3": pflichtteil_oder_2329_nach_ausschlagung_geltendmachbar_2332(entity_ref("urn:de:bgb:pilot:v19:A"), entity_ref("urn:de:bgb:pilot:v19:E")) { origin case_input; }
    }
    evaluate truth(verjaehrungsbeginn_anspruch_2329_2332(entity_ref("urn:de:bgb:pilot:v19:A"), @2024-04-12));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verjaehrung_nicht_durch_ausschlagung_gehemmt_2332(entity_ref("urn:de:bgb:pilot:v19:A"), entity_ref("urn:de:bgb:pilot:v19:E")));
    expect truth_status == TRUE_ONLY;
}
