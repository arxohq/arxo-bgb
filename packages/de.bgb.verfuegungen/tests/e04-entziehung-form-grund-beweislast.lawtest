language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2336 Abs. 1, 2: Form (letztwillige Verfügung) und Grund (bestand bei
// Errichtung, in der Verfügung angegeben); Abs. 3: Beweislast trägt, wer
// die Entziehung geltend macht.
test "§ 2336: Formwirksamkeit der Entziehung und Beweislast" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": entziehung_durch_verfuegung_2336(entity_ref("urn:de:bgb:pilot:e04:E"), entity_ref("urn:de:bgb:pilot:e04:P")) { origin case_input; }
        assert "f2": entziehungsgrund_zur_errichtung_bestehend_2336(entity_ref("urn:de:bgb:pilot:e04:E"), entity_ref("urn:de:bgb:pilot:e04:P")) { origin case_input; }
        assert "f3": entziehungsgrund_in_verfuegung_angegeben_2336(entity_ref("urn:de:bgb:pilot:e04:E"), entity_ref("urn:de:bgb:pilot:e04:P")) { origin case_input; }
    }
    evaluate truth(entziehung_formwirksam_2336(entity_ref("urn:de:bgb:pilot:e04:E"), entity_ref("urn:de:bgb:pilot:e04:P")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(beweislast_entziehung_beim_geltendmachenden(entity_ref("urn:de:bgb:pilot:e04:E"), entity_ref("urn:de:bgb:pilot:e04:P")));
    expect truth_status == TRUE_ONLY;
}
