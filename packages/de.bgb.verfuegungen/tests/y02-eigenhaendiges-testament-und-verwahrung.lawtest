language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2247 Abs. 3 Satz 2 (abweichende Unterzeichnung genügt), Abs. 4
// (Minderjährige/Nichtlesefähige ausgeschlossen), Abs. 5 (Heilung bei
// fehlender Angabe), § 2248 (amtliche Verwahrung auf Verlangen).
test "§ 2247 Abs. 3–5, § 2248: eigenhändiges Testament und Verwahrung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": unterschrift_alternative_stellt_urheberschaft_und_ernstlichkeit_fest_2247(entity_ref("urn:de:bgb:pilot:y02:T1"), entity_ref("urn:de:bgb:pilot:y02:E1")) { origin case_input; }
        assert "f2": errichter_minderjaehrig_oder_nicht_lesefaehig_2247(entity_ref("urn:de:bgb:pilot:y02:T2"), entity_ref("urn:de:bgb:pilot:y02:E2")) { origin case_input; }
        assert "f3": zeit_oder_ortsangabe_fehlt_und_zweifel_2247(entity_ref("urn:de:bgb:pilot:y02:T3")) { origin case_input; }
        assert "f4": feststellungen_anderweit_treffbar_2247(entity_ref("urn:de:bgb:pilot:y02:T3")) { origin case_input; }
        assert "f5": nach_2247_errichtetes_testament_2248(entity_ref("urn:de:bgb:pilot:y02:T4"), entity_ref("urn:de:bgb:pilot:y02:E4")) { origin case_input; }
        assert "f6": erblasser_verlangt_amtliche_verwahrung_2248(entity_ref("urn:de:bgb:pilot:y02:T4"), entity_ref("urn:de:bgb:pilot:y02:E4")) { origin case_input; }
    }
    evaluate truth(abweichende_unterzeichnung_steht_gueltigkeit_nicht_entgegen_2247(entity_ref("urn:de:bgb:pilot:y02:T1"), entity_ref("urn:de:bgb:pilot:y02:E1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(eigenhaendige_errichtung_ausgeschlossen_2247(entity_ref("urn:de:bgb:pilot:y02:T2"), entity_ref("urn:de:bgb:pilot:y02:E2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(trotz_fehlender_angabe_gueltig_2247(entity_ref("urn:de:bgb:pilot:y02:T3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(amtliche_verwahrung_geschuldet_2248(entity_ref("urn:de:bgb:pilot:y02:T4"), entity_ref("urn:de:bgb:pilot:y02:E4")));
    expect truth_status == TRUE_ONLY;
}
