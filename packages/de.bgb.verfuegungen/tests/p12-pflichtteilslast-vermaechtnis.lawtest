language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2318, 2319: Pflichtteilslast schützt Pflichtteilsberechtigte" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": erbe_mit_vermaechtnis_beschwert_2318(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:H"), entity_ref("urn:de:bgb:pilot:v12:L")) { origin case_input; }
        assert "f2": vermaechtnisnehmer_pflichtteilsberechtigt_2318(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:V"), entity_ref("urn:de:bgb:pilot:v12:L")) { origin case_input; }
        assert "f3": kuerzung_laesst_pflichtteil_vermaechtnisnehmer_2318(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:V"), entity_ref("urn:de:bgb:pilot:v12:L")) { origin case_input; }
        assert "f4": erbe_selbst_pflichtteilsberechtigt_2318(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:H"), entity_ref("urn:de:bgb:pilot:v12:L")) { origin case_input; }
        assert "f5": kuerzung_laesst_eigenen_pflichtteil_2318(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:H"), entity_ref("urn:de:bgb:pilot:v12:L")) { origin case_input; }
        assert "f6": miterbe_selbst_pflichtteilsberechtigt_2319(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:H"), entity_ref("urn:de:bgb:pilot:v12:L")) { origin case_input; }
        assert "f7": teilung_erfolgt_2319(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:L")) { origin case_input; }
    }
    evaluate truth(pflichtteilslast_verhaeltnismaessig_zu_tragen_2318(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:H"), entity_ref("urn:de:bgb:pilot:v12:L")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kuerzung_gegen_pflichtteilsberechtigten_vermaechtnisnehmer_zulaessig_2318(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:V"), entity_ref("urn:de:bgb:pilot:v12:L")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kuerzung_zur_wahrung_eigenen_pflichtteils_zulaessig_2318(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:H"), entity_ref("urn:de:bgb:pilot:v12:L")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(befriedigung_anderer_berechtigter_soweit_verweigerbar_2319(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:H"), entity_ref("urn:de:bgb:pilot:v12:L")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(uebrige_miterben_haften_fuer_ausfall_2319(entity_ref("urn:de:bgb:pilot:v12:E"), entity_ref("urn:de:bgb:pilot:v12:L")));
    expect truth_status == TRUE_ONLY;
}
