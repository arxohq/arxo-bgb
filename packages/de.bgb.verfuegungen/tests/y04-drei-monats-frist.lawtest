language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2252 Abs. 1 (dreißig — richtig drei Monate, kalendarisch), Abs. 2
// (Hemmung), Abs. 3 (Unterbrechung bei neuer Seereise), Abs. 4 (Fortbestand
// bei Todeserklärung).
test "§ 2252: Gültigkeitsdauer der Nottestamente — drei Monate kalendarisch, Hemmung, Unterbrechung, Fortbestand" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": nottestament_errichtet_am_2252(entity_ref("urn:de:bgb:pilot:y04:T1"), entity_ref("urn:de:bgb:pilot:y04:E1"), @2026-01-10) { origin case_input; }
        assert "f2": drei_monate_verstrichen_und_erblasser_lebt_noch_2252(entity_ref("urn:de:bgb:pilot:y04:T1"), entity_ref("urn:de:bgb:pilot:y04:E1")) { origin case_input; }
        assert "f3": erblasser_ausserstande_notartestament_zu_errichten_2252(entity_ref("urn:de:bgb:pilot:y04:T2"), entity_ref("urn:de:bgb:pilot:y04:E2"), 10 calendar_day) { origin case_input; }
        assert "f4": erblasser_tritt_vor_fristablauf_neue_seereise_an_2252(entity_ref("urn:de:bgb:pilot:y04:T3"), entity_ref("urn:de:bgb:pilot:y04:E3")) { origin case_input; }
        assert "f5": erblasser_nach_fristablauf_fuer_tot_erklaert_und_frist_beim_letzten_lebenszeichen_nicht_verstrichen_2252(entity_ref("urn:de:bgb:pilot:y04:T4"), entity_ref("urn:de:bgb:pilot:y04:E4")) { origin case_input; }
    }
    evaluate truth(drei_monate_grenze_2252(entity_ref("urn:de:bgb:pilot:y04:T1"), @2026-04-10));
    expect truth_status == TRUE_ONLY;
    evaluate truth(nottestament_gilt_als_nicht_errichtet_2252(entity_ref("urn:de:bgb:pilot:y04:T1"), entity_ref("urn:de:bgb:pilot:y04:E1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(drei_monats_frist_um_hemmungstage_verlaengert_2252(entity_ref("urn:de:bgb:pilot:y04:T2"), entity_ref("urn:de:bgb:pilot:y04:E2"), 10 calendar_day));
    expect truth_status == TRUE_ONLY;
    evaluate truth(frist_unterbrochen_neu_beginnend_2252(entity_ref("urn:de:bgb:pilot:y04:T3"), entity_ref("urn:de:bgb:pilot:y04:E3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(testament_behaelt_kraft_2252(entity_ref("urn:de:bgb:pilot:y04:T4"), entity_ref("urn:de:bgb:pilot:y04:E4")));
    expect truth_status == TRUE_ONLY;
}
