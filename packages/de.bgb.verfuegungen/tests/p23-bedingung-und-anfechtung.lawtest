language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2074–2079: Bedingungen, Auflösung und Anfechtung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": letztwillige_zuwendung_aufschiebend_bedingt_2074(entity_ref("urn:de:bgb:pilot:v23:T1"), entity_ref("urn:de:bgb:pilot:v23:A")) { origin case_input; }
        assert "f2": bedachter_erlebt_bedingungseintritt_2074(entity_ref("urn:de:bgb:pilot:v23:T1"), entity_ref("urn:de:bgb:pilot:v23:A")) { origin case_input; }
        assert "f3": unbestimmtes_unterlassen_oder_fortgesetztes_tun_bedingt_2075(entity_ref("urn:de:bgb:pilot:v23:T2"), entity_ref("urn:de:bgb:pilot:v23:B")) { origin case_input; }
        assert "f4": unterlassen_oder_tun_steht_in_willkuer_des_bedachten_2075(entity_ref("urn:de:bgb:pilot:v23:T2"), entity_ref("urn:de:bgb:pilot:v23:B")) { origin case_input; }
        assert "f5": bedingung_bezweckt_vorteil_dritten_2076(entity_ref("urn:de:bgb:pilot:v23:T3"), entity_ref("urn:de:bgb:pilot:v23:C")) { origin case_input; }
        assert "f6": dritter_verweigert_erforderliche_mitwirkung_2076(entity_ref("urn:de:bgb:pilot:v23:T3"), entity_ref("urn:de:bgb:pilot:v23:C")) { origin case_input; }
        assert "f7": ehegatte_durch_letztwillige_verfuegung_bedacht_2077(entity_ref("urn:de:bgb:pilot:v23:T4"), entity_ref("urn:de:bgb:pilot:v23:D")) { origin case_input; }
        assert "f8": ehe_vor_tod_aufgeloest_2077(entity_ref("urn:de:bgb:pilot:v23:T4")) { origin case_input; }
        assert "f9": testator_wollte_verfuegung_trotz_aufloesung_2077(entity_ref("urn:de:bgb:pilot:v23:T5")) { origin case_input; }
        assert "f10": erklaerungsinhalt_geirrt_oder_nicht_gewollt_2078(entity_ref("urn:de:bgb:pilot:v23:T6")) { origin case_input; }
        assert "f11": bei_kenntnis_nicht_abgegeben_2078(entity_ref("urn:de:bgb:pilot:v23:T6")) { origin case_input; }
        assert "f12": irrige_annahme_erwartung_oder_drohung_bestimmt_2078(entity_ref("urn:de:bgb:pilot:v23:T7")) { origin case_input; }
        assert "f13": pflichtteilsberechtigter_beim_erbfall_uebergangen_2079(entity_ref("urn:de:bgb:pilot:v23:T8"), entity_ref("urn:de:bgb:pilot:v23:P")) { origin case_input; }
        assert "f14": pflichtteilsberechtigter_unbekannt_oder_spaeter_entstanden_2079(entity_ref("urn:de:bgb:pilot:v23:T8"), entity_ref("urn:de:bgb:pilot:v23:P")) { origin case_input; }
    }
    evaluate truth(zuwendung_nur_bei_erleben_bedingungseintritt_vermutet_2074(entity_ref("urn:de:bgb:pilot:v23:T1"), entity_ref("urn:de:bgb:pilot:v23:A")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(aufloesende_bedingung_fuer_handlung_oder_unterlassen_vermutet_2075(entity_ref("urn:de:bgb:pilot:v23:T2"), entity_ref("urn:de:bgb:pilot:v23:B")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(bedingung_als_eingetreten_vermutet_2076(entity_ref("urn:de:bgb:pilot:v23:T3"), entity_ref("urn:de:bgb:pilot:v23:C")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verfuegung_unwirksam_wegen_aufloesung_2077(entity_ref("urn:de:bgb:pilot:v23:T4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verfuegung_trotz_aufloesung_nicht_unwirksam_2077(entity_ref("urn:de:bgb:pilot:v23:T5")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(letztwillige_verfuegung_anfechtbar_2078(entity_ref("urn:de:bgb:pilot:v23:T6")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(letztwillige_verfuegung_anfechtbar_2078(entity_ref("urn:de:bgb:pilot:v23:T7")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(letztwillige_verfuegung_anfechtbar_2079(entity_ref("urn:de:bgb:pilot:v23:T8"), entity_ref("urn:de:bgb:pilot:v23:P")));
    expect truth_status == TRUE_ONLY;
}
