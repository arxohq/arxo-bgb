language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2141–2146: Nacherbe, Ausschlagung und Haftung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": geburt_nacherbe_beim_eintritt_zu_erwarten_2141(entity_ref("urn:de:bgb:pilot:v32:T1")) { origin case_input; }
        assert "f2": erbfall_eingetreten_nacherbe_2142(entity_ref("urn:de:bgb:pilot:v32:T2"), entity_ref("urn:de:bgb:pilot:v32:A")) { origin case_input; }
        assert "f3": nacherbe_hat_ausgeschlagen_2142(entity_ref("urn:de:bgb:pilot:v32:T3"), entity_ref("urn:de:bgb:pilot:v32:B")) { origin case_input; }
        assert "f4": nacherbfolge_eingetreten_2143(entity_ref("urn:de:bgb:pilot:v32:T4")) { origin case_input; }
        assert "f5": nacherbe_hat_erbschaft_erlangt_2144(entity_ref("urn:de:bgb:pilot:v32:T5"), entity_ref("urn:de:bgb:pilot:v32:C")) { origin case_input; }
        assert "f6": nacherbe_haftet_nicht_fuer_verbindlichkeit_2145(entity_ref("urn:de:bgb:pilot:v32:T6"), entity_ref("urn:de:bgb:pilot:v32:D"), entity_ref("urn:de:bgb:pilot:v32:E")) { origin case_input; }
        assert "f7": nacherbfolge_nachlassgericht_angezeigt_2146(entity_ref("urn:de:bgb:pilot:v32:T7"), entity_ref("urn:de:bgb:pilot:v32:F")) { origin case_input; }
    }
    evaluate truth(mutterunterhalt_nach_1963_anwendbar_2141(entity_ref("urn:de:bgb:pilot:v32:T1"))); expect truth_status == TRUE_ONLY;
    evaluate truth(nacherbe_darf_ausschlagen_2142(entity_ref("urn:de:bgb:pilot:v32:T2"), entity_ref("urn:de:bgb:pilot:v32:A"))); expect truth_status == TRUE_ONLY;
    evaluate truth(erbschaft_verbleibt_vorerben_2142(entity_ref("urn:de:bgb:pilot:v32:T3"), entity_ref("urn:de:bgb:pilot:v32:B"))); expect truth_status == TRUE_ONLY;
    evaluate truth(erloschene_rechtsverhaeltnisse_leben_wieder_2143(entity_ref("urn:de:bgb:pilot:v32:T4"))); expect truth_status == TRUE_ONLY;
    evaluate truth(haftungsbeschraenkung_fuer_nacherbe_2144(entity_ref("urn:de:bgb:pilot:v32:T5"), entity_ref("urn:de:bgb:pilot:v32:C"))); expect truth_status == TRUE_ONLY;
    evaluate truth(vorerbe_haftet_weiter_2145(entity_ref("urn:de:bgb:pilot:v32:T6"), entity_ref("urn:de:bgb:pilot:v32:E"))); expect truth_status == TRUE_ONLY;
    evaluate truth(anzeigepflicht_erfuellt_2146(entity_ref("urn:de:bgb:pilot:v32:T7"), entity_ref("urn:de:bgb:pilot:v32:F"))); expect truth_status == TRUE_ONLY;
}
