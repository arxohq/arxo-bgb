language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// § 2164 Abs. 1, 2 (Zubehör, Ersatzanspruch mitvermacht), § 2165 Abs. 1
// (keine Beseitigung verlangbar / Beseitigungsanspruch mitvermacht),
// § 2166 Abs. 1, 2 (Befriedigungspflicht soweit Wert deckt, und nur soweit
// Dritter nicht in Anspruch genommen werden kann — qualitativ, ohne
// Anteilsrechnung), § 2166 Abs. 3 (Ausnahme § 1190-Hypothek), § 2168a
// (Schiffe sinngemäß).
test "§§ 2164–2166, 2168a: Zubehör, Belastungen, Hypothekenpflicht (qualitativ)" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": bestimmter_gegenstand_vermacht_2164(entity_ref("urn:de:bgb:pilot:w01:T1")) { origin case_input; }
        assert "f2": ersatzanspruch_wegen_beschaedigung_nach_anordnung_2164(entity_ref("urn:de:bgb:pilot:w01:T1")) { origin case_input; }
        assert "f3": vermachter_gegenstand_mit_recht_belastet_2165(entity_ref("urn:de:bgb:pilot:w01:T2")) { origin case_input; }
        assert "f4": erblasser_hat_anspruch_auf_beseitigung_der_belastung_2165(entity_ref("urn:de:bgb:pilot:w01:T2")) { origin case_input; }
        assert "f5": vermachtes_grundstueck_mit_hypothek_fuer_erblasserschuld_belastet_2166(entity_ref("urn:de:bgb:pilot:w01:T3")) { origin case_input; }
        assert "f6": dritter_erblasser_gegenueber_zur_berichtigung_verpflichtet_2166(entity_ref("urn:de:bgb:pilot:w01:T3")) { origin case_input; }
        assert "f7": erbe_kann_berichtigung_nicht_vom_dritten_erlangen_2166(entity_ref("urn:de:bgb:pilot:w01:T3")) { origin case_input; }
        assert "f8": hypothek_der_in_1190_bezeichneten_art_2166(entity_ref("urn:de:bgb:pilot:w01:T4")) { origin case_input; }
        assert "f9": vermaechtnis_betrifft_eingetragenes_schiff_oder_schiffsbauwerk_oder_schiffshypothek_2168a(entity_ref("urn:de:bgb:pilot:w01:T5")) { origin case_input; }
    }
    evaluate truth(zubehoer_gilt_als_mitvermacht_vermutet_2164(entity_ref("urn:de:bgb:pilot:w01:T1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ersatzanspruch_gilt_als_mitvermacht_vermutet_2164(entity_ref("urn:de:bgb:pilot:w01:T1")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(beseitigung_der_belastung_nicht_verlangbar_vermutet_2165(entity_ref("urn:de:bgb:pilot:w01:T2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(beseitigungsanspruch_gilt_als_mitvermacht_vermutet_2165(entity_ref("urn:de:bgb:pilot:w01:T2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisnehmer_zur_befriedigung_soweit_wert_deckt_verpflichtet_vermutet_2166(entity_ref("urn:de:bgb:pilot:w01:T3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vermaechtnisnehmerpflicht_nur_bei_erfolgloser_drittinanspruchnahme_vermutet_2166(entity_ref("urn:de:bgb:pilot:w01:T3")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(p2166_auf_1190_hypothek_nicht_anwendbar_2166(entity_ref("urn:de:bgb:pilot:w01:T4")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(p2165_abs2_p2166_p2167_auf_schiffe_sinngemaess_anwendbar_2168a(entity_ref("urn:de:bgb:pilot:w01:T5")));
    expect truth_status == TRUE_ONLY;
}
