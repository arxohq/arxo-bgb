language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

test "§§ 2080–2086: Berechtigung, Frist und Auslegung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERFUEGUNGEN_JAHR; calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT"; }
        assert "f1": aufhebung_kommt_unmittelbar_zustatten_2080(entity_ref("urn:de:bgb:pilot:v24:A"), entity_ref("urn:de:bgb:pilot:v24:P")) { origin case_input; }
        assert "f2": anfechtungserklaerung_nachlassgericht_2081(entity_ref("urn:de:bgb:pilot:v24:A")) { origin case_input; }
        assert "f3": anfechtungsgrund_kenntnis_am_2082(entity_ref("urn:de:bgb:pilot:v24:A"), entity_ref("urn:de:bgb:pilot:v24:P"), @2026-09-01) { origin case_input; }
        assert "f4": anfechtung_binnen_jahresfrist_2082(entity_ref("urn:de:bgb:pilot:v24:A")) { origin case_input; }
        assert "f5": seit_erbfall_dreissig_jahre_verstrichen_2082(entity_ref("urn:de:bgb:pilot:v24:B")) { origin case_input; }
        assert "f6": leistungsverpflichtung_durch_anfechtbare_verfuegung_2083(entity_ref("urn:de:bgb:pilot:v24:T"), entity_ref("urn:de:bgb:pilot:v24:Q")) { origin case_input; }
        assert "f7": mehrere_auslegungen_eine_erfolgreich_2084(entity_ref("urn:de:bgb:pilot:v24:T")) { origin case_input; }
        assert "f8": eine_von_mehreren_verfuegungen_unwirksam_2085(entity_ref("urn:de:bgb:pilot:v24:U")) { origin case_input; }
        assert "f9": testator_haette_uebrige_ohne_unwirksame_nicht_getroffen_2085(entity_ref("urn:de:bgb:pilot:v24:U")) { origin case_input; }
        assert "f10": ergaenzungsvorbehalt_ohne_ergaenzung_2086(entity_ref("urn:de:bgb:pilot:v24:V")) { origin case_input; }
    }
    evaluate truth(person_anfechtungsberechtigt_2080(entity_ref("urn:de:bgb:pilot:v24:A"), entity_ref("urn:de:bgb:pilot:v24:P")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtungserklaerung_formgerecht_2081(entity_ref("urn:de:bgb:pilot:v24:A")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtungsfrist_beginnt_2082(entity_ref("urn:de:bgb:pilot:v24:A"), entity_ref("urn:de:bgb:pilot:v24:P"), @2026-09-01));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtung_fristgerecht_2082(entity_ref("urn:de:bgb:pilot:v24:A")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anfechtung_wegen_dreissig_jahren_ausgeschlossen_2082(entity_ref("urn:de:bgb:pilot:v24:B")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(beschwerter_darf_leistung_verweigern_2083(entity_ref("urn:de:bgb:pilot:v24:T"), entity_ref("urn:de:bgb:pilot:v24:Q")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(wirksame_auslegung_vorzuziehen_vermutet_2084(entity_ref("urn:de:bgb:pilot:v24:T")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(uebrige_verfuegungen_ebenfalls_unwirksam_2085(entity_ref("urn:de:bgb:pilot:v24:U")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verfuegung_trotz_fehlender_ergaenzung_wirksam_2086(entity_ref("urn:de:bgb:pilot:v24:V")));
    expect truth_status == TRUE_ONLY;
}
