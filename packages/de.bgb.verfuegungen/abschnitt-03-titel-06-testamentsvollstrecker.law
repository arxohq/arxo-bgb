// BÜRGERLICHES GESETZBUCH, BUCH 5 ABSCHNITT 3 TITEL 6 — TESTAMENTSVOLLSTRECKER
// (§§ 2197–2228). Konvention wie Titel 4: `t: Testament` trägt den
// Vollstreckungsfall, `Person` für den Vollstrecker/Erben/Vermächtnisnehmer.
//
// Gerichtliche/verfahrensrechtliche Teile (Anhörung der Beteiligten § 2200
// Abs. 2, Fristbestimmung durch das Nachlassgericht § 2202 Abs. 3, § 2198
// Abs. 2, gerichtliche Außerkraftsetzung § 2216 Abs. 2 Sätze 2–3,
// Akteneinsicht § 2228) formalisiert diese Runde NICHT als eigene Regeln —
// das sind FamFG-Verfahrensschritte des Nachlassgerichts, kein Schluss des
// Pakets; die materielle Wirkung (z. B. „Amt gilt als abgelehnt“) IST
// formalisiert. § 2221 (Vergütung): „angemessen“ ist Wertung, hier als
// Anspruchsgrund ohne Betragsberechnung (Kanal/Betrag bleibt Fallangabe).

language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// --- Deklarationen ----------------------------------------------------------

pub relation erblasser_ernennt_testamentsvollstrecker_2197(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Erblasser ernennt durch Testament einen Testamentsvollstrecker (§ 2197 Abs. 1)";
    label en unofficial "the testator appoints an executor by will (§ 2197 (1))";
}
pub relation ernennung_wirksam_2197(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Ernennung des Testamentsvollstreckers ist wirksam vorgenommen (§ 2197 Abs. 1)";
    label en unofficial "the appointment of the executor is validly made (§ 2197 (1))";
}
pub relation ernennung_fuer_wegfallsfall_eines_anderen_2197(t: Testament, vollstrecker: Person, ersterernannter: Person) kind empirical {
    label de official "Der Erblasser ernennt für den Fall des Wegfalls des zuerst ernannten Testamentsvollstreckers einen anderen (§ 2197 Abs. 2)";
    label en unofficial "the testator appoints another executor for the case the first appointee falls away (§ 2197 (2))";
}
pub relation ersatzernennung_wirksam_2197(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Ersatzernennung ist wirksam (§ 2197 Abs. 2)";
    label en unofficial "the substitute appointment is valid (§ 2197 (2))";
}
pub relation erblasser_ueberlaesst_bestimmung_einem_dritten_2198(t: Testament, dritter: Person) kind empirical {
    label de official "Der Erblasser überlässt die Bestimmung der Person des Testamentsvollstreckers einem Dritten (§ 2198 Abs. 1)";
    label en unofficial "the testator leaves the choice of executor to a third party (§ 2198 (1))";
}
pub relation dritter_erklaert_bestimmung_ggue_nachlassgericht_oeffentlich_beglaubigt_2198(t: Testament, dritter: Person, vollstrecker: Person) kind empirical {
    label de official "Der Dritte erklärt die Bestimmung gegenüber dem Nachlassgericht in öffentlich beglaubigter Form (§ 2198 Abs. 1 Satz 2)";
    label en unofficial "the third party declares the choice to the probate court in publicly certified form (§ 2198 (1) sentence 2)";
}
pub relation bestimmung_durch_dritten_wirksam_2198(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Bestimmung durch den Dritten ist wirksam (§ 2198 Abs. 1)";
    label en unofficial "the third party's determination is valid (§ 2198 (1))";
}
pub relation erblasser_ermaechtigt_zur_ernennung_von_mitvollstreckern_2199(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Erblasser ermächtigt den Testamentsvollstrecker, Mitvollstrecker zu ernennen (§ 2199 Abs. 1)";
    label en unofficial "the testator authorises the executor to appoint co-executors (§ 2199 (1))";
}
pub relation ermaechtigung_zu_mitvollstreckern_wirksam_2199(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Ermächtigung zur Ernennung von Mitvollstreckern ist wirksam (§ 2199 Abs. 1)";
    label en unofficial "the authorisation to appoint co-executors is valid (§ 2199 (1))";
}
pub relation erblasser_ermaechtigt_zur_ernennung_eines_nachfolgers_2199(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Erblasser ermächtigt den Testamentsvollstrecker, einen Nachfolger zu ernennen (§ 2199 Abs. 2)";
    label en unofficial "the testator authorises the executor to appoint a successor (§ 2199 (2))";
}
pub relation ermaechtigung_zu_nachfolger_wirksam_2199(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Ermächtigung zur Ernennung eines Nachfolgers ist wirksam (§ 2199 Abs. 2)";
    label en unofficial "the authorisation to appoint a successor is valid (§ 2199 (2))";
}
pub relation vollstrecker_bei_amtsantritt_geschaeftsunfaehig_oder_beschraenkt_oder_betreut_2201(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Ernannte ist zur Zeit des Amtsantritts geschäftsunfähig, in der Geschäftsfähigkeit beschränkt, oder hat nach § 1814 einen Vermögensbetreuer (§ 2201)";
    label en unofficial "the appointee is, at the time of taking office, without or with limited capacity, or has an asset-affairs custodian under § 1814 (§ 2201)";
}
pub relation ernennung_unwirksam_2201(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Ernennung des Testamentsvollstreckers ist unwirksam (§ 2201)";
    label en unofficial "the appointment of the executor is ineffective (§ 2201)";
}
pub relation ernannter_nimmt_amt_an_2202(t: Testament, vollstrecker: Person, zeitpunkt: Date) kind empirical {
    label de official "Der Ernannte nimmt das Amt an (§ 2202 Abs. 1)";
    label en unofficial "the appointee accepts the office (§ 2202 (1))";
}
pub relation amt_beginnt_mit_annahme_2202(t: Testament, vollstrecker: Person, zeitpunkt: Date) kind derived {
    label de official "Das Amt des Testamentsvollstreckers beginnt mit der Annahme (§ 2202 Abs. 1)";
    label en unofficial "the executor's office begins with acceptance (§ 2202 (1))";
}
pub relation annahme_frist_abgelaufen_ohne_erklaerung_2202(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Die vom Nachlassgericht gesetzte Erklärungsfrist ist abgelaufen, ohne dass die Annahme vorher erklärt wurde (§ 2202 Abs. 3)";
    label en unofficial "the period set by the probate court for declaration has lapsed without prior acceptance (§ 2202 (3))";
}
pub relation amt_gilt_als_abgelehnt_2202(t: Testament, vollstrecker: Person) kind derived {
    label de official "Das Amt gilt als abgelehnt (§ 2202 Abs. 3)";
    label en unofficial "the office is deemed declined (§ 2202 (3))";
}
pub relation vollstrecker_hat_amt_angetreten_2203(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Testamentsvollstrecker hat das Amt angetreten (§ 2203)";
    label en unofficial "the executor has taken office (§ 2203)";
}
pub relation aufgabe_letztwillige_verfuegungen_auszufuehren_2203(t: Testament, vollstrecker: Person) kind derived {
    label de official "Der Testamentsvollstrecker hat die letztwilligen Verfügungen des Erblassers zur Ausführung zu bringen (§ 2203)";
    label en unofficial "the executor must bring the testator's testamentary dispositions to execution (§ 2203)";
}
pub relation mehrere_erben_vorhanden_2204(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Mehrere Erben sind vorhanden (§ 2204 Abs. 1)";
    label en unofficial "there are multiple heirs (§ 2204 (1))";
}
pub relation vollstrecker_hat_auseinandersetzung_zu_bewirken_2204(t: Testament, vollstrecker: Person) kind derived {
    label de official "Der Testamentsvollstrecker hat die Auseinandersetzung unter den Erben nach Maßgabe der §§ 2042 bis 2057a zu bewirken (§ 2204 Abs. 1)";
    label en unofficial "the executor must effect the partition among the heirs under §§ 2042 to 2057a (§ 2204 (1))";
}
pub relation vollstrecker_hat_nachlass_zu_verwalten_2205(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Dem Testamentsvollstrecker obliegt die Verwaltung des Nachlasses (§ 2205 Satz 1)";
    label en unofficial "the executor is charged with administering the estate (§ 2205 sentence 1)";
}
pub relation verwaltungs_und_verfuegungsbefugnis_2205(t: Testament, vollstrecker: Person) kind derived {
    label de official "Der Testamentsvollstrecker ist berechtigt, den Nachlass in Besitz zu nehmen und über Nachlassgegenstände zu verfügen (§ 2205 Sätze 1, 2)";
    label en unofficial "the executor is entitled to take possession of the estate and to dispose of estate assets (§ 2205 sentences 1, 2)";
}
pub relation unentgeltliche_verfuegung_sittlicher_pflicht_oder_anstand_entsprechend_2205(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Die unentgeltliche Verfügung entspricht einer sittlichen Pflicht oder einer Anstandsrücksicht (§ 2205 Satz 3)";
    label en unofficial "the gratuitous disposition corresponds to a moral duty or a consideration of propriety (§ 2205 sentence 3)";
}
pub relation unentgeltliche_verfuegung_zulaessig_2205(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die unentgeltliche Verfügung ist zulässig (§ 2205 Satz 3)";
    label en unofficial "the gratuitous disposition is permitted (§ 2205 sentence 3)";
}
pub relation verbindlichkeit_zur_ordnungsmaessigen_verwaltung_erforderlich_2206(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Die Eingehung der Verbindlichkeit ist zur ordnungsmäßigen Verwaltung erforderlich (§ 2206 Abs. 1 Satz 1)";
    label en unofficial "incurring the liability is necessary for proper administration (§ 2206 (1) sentence 1)";
}
pub relation vollstrecker_darf_verbindlichkeit_eingehen_2206(t: Testament, vollstrecker: Person) kind derived {
    label de official "Der Testamentsvollstrecker ist berechtigt, die Verbindlichkeit für den Nachlass einzugehen (§ 2206 Abs. 1)";
    label en unofficial "the executor is entitled to incur the liability for the estate (§ 2206 (1))";
}
pub relation erbe_zur_einwilligung_verpflichtet_2206(t: Testament, erbe: Person) kind derived {
    label de official "Der Erbe ist verpflichtet, zur Eingehung solcher Verbindlichkeiten seine Einwilligung zu erteilen, unbeschadet der Haftungsbeschränkung (§ 2206 Abs. 2)";
    label en unofficial "the heir is obliged to consent to incurring such liabilities, without prejudice to their liability limitation (§ 2206 (2))";
}
pub relation erbe_des_nachlasses_2206(t: Testament, vollstrecker: Person, erbe: Person) kind empirical {
    label de official "Der Erbe ist Erbe des vom Testamentsvollstrecker verwalteten Nachlasses (§ 2206 Abs. 2)";
    label en unofficial "the heir is heir of the estate administered by the executor (§ 2206 (2))";
}
pub relation erblasser_ordnet_unbeschraenkte_verpflichtungsbefugnis_an_2207(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Erblasser ordnet an, dass der Testamentsvollstrecker in der Eingehung von Verbindlichkeiten nicht beschränkt sein soll (§ 2207 Satz 1)";
    label en unofficial "the testator orders that the executor not be limited in incurring liabilities (§ 2207 sentence 1)";
}
pub relation erweiterte_verpflichtungsbefugnis_2207(t: Testament, vollstrecker: Person) kind derived {
    label de official "Der Testamentsvollstrecker hat erweiterte Verpflichtungsbefugnis (§ 2207 Satz 1)";
    label en unofficial "the executor has extended power to incur liabilities (§ 2207 sentence 1)";
}
pub relation anzunehmen_dass_recht_nach_erblasserwillen_nicht_zusteht_2208(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Es ist anzunehmen, dass dem Testamentsvollstrecker das Recht nach dem Willen des Erblassers nicht zustehen soll (§ 2208 Abs. 1 Satz 1)";
    label en unofficial "it must be assumed that the testator did not intend the executor to have the right (§ 2208 (1) sentence 1)";
}
pub relation recht_besteht_nicht_2208(t: Testament, vollstrecker: Person) kind derived {
    label de official "Das betreffende Recht aus §§ 2203 bis 2206 besteht insoweit nicht (§ 2208 Abs. 1 Satz 1)";
    label en unofficial "the corresponding right under §§ 2203 to 2206 does not exist to that extent (§ 2208 (1) sentence 1)";
}
pub relation vollstrecker_muss_verfuegungen_nicht_selbst_ausfuehren_2208(t: Testament, vollstrecker: Person, erbe: Person) kind empirical {
    label de official "Der Testamentsvollstrecker hat Verfügungen des Erblassers nicht selbst zur Ausführung zu bringen (§ 2208 Abs. 2)";
    label en unofficial "the executor need not himself bring the testator's dispositions to execution (§ 2208 (2))";
}
pub relation anderer_wille_des_erblassers_bei_2208_anzunehmen(t: Testament, vollstrecker: Person, erbe: Person) kind empirical {
    label de official "Ein anderer Wille des Erblassers ist anzunehmen (§ 2208 Abs. 2, Gegenausnahme)";
    label en unofficial "a different testamentary intention must be assumed (§ 2208 (2), counter-exception)";
}
pub relation ausfuehrung_vom_erben_verlangbar_vermutet_2208(t: Testament, vollstrecker: Person, erbe: Person) kind derived {
    label de official "Der Testamentsvollstrecker kann im Zweifel die Ausführung vom Erben verlangen (§ 2208 Abs. 2)";
    label en unofficial "the executor may in case of doubt demand execution from the heir (§ 2208 (2))";
}
pub relation erblasser_uebertraegt_dauervollstreckung_2209(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Erblasser überträgt dem Testamentsvollstrecker die Verwaltung des Nachlasses ohne andere Aufgaben, oder ordnet Fortführung nach Erledigung an (§ 2209 Satz 1)";
    label en unofficial "the testator entrusts the executor with mere administration, or orders continuation after other tasks are done (§ 2209 sentence 1)";
}
pub relation dauervollstreckung_angeordnet_2209(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Dauervollstreckung ist angeordnet (§ 2209 Satz 1)";
    label en unofficial "continuing administration is ordered (§ 2209 sentence 1)";
}
pub relation erweiterte_ermaechtigung_bei_dauervollstreckung_vermutet_2209(t: Testament, vollstrecker: Person) kind derived {
    label de official "Im Zweifel ist die Ermächtigung des § 2207 einem solchen Testamentsvollstrecker erteilt (§ 2209 Satz 2)";
    label en unofficial "in case of doubt, § 2207 authorisation is granted to such an executor (§ 2209 sentence 2)";
}
pub relation dauervollstreckung_dreissig_jahre_ohne_anderweitige_anordnung_2210(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Seit dem Erbfall sind dreißig Jahre verstrichen, ohne dass eine Fortdauer bis zum Tod oder Ereignis nach § 2210 Satz 2 angeordnet ist (§ 2210 Satz 1)";
    label en unofficial "thirty years have elapsed since devolution without an ordered continuation until death or event under § 2210 sentence 2 (§ 2210 sentence 1)";
}
pub relation dauervollstreckungsanordnung_unwirksam_2210(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Anordnung der Dauervollstreckung wird unwirksam (§ 2210 Satz 1)";
    label en unofficial "the order for continuing administration becomes ineffective (§ 2210 sentence 1)";
}
pub relation erblasser_ordnet_fortdauer_bis_tod_oder_ereignis_an_2210(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Erblasser ordnet Fortdauer der Verwaltung bis zum Tode des Erben oder Testamentsvollstreckers oder bis zu einem anderen Ereignis in deren Person an (§ 2210 Satz 2)";
    label en unofficial "the testator orders continuation until the heir's or executor's death or another event affecting either (§ 2210 sentence 2)";
}
pub relation fortdauer_ueber_dreissig_jahre_zulaessig_2210(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Fortdauer über dreißig Jahre hinaus ist zulässig (§ 2210 Satz 2, § 2163 Abs. 2 entsprechend)";
    label en unofficial "continuation beyond thirty years is permitted (§ 2210 sentence 2, § 2163 (2) mutatis mutandis)";
}
pub relation nachlassgegenstand_unterliegt_verwaltung_des_vollstreckers_2211(t: Testament, vollstrecker: Person, erbe: Person) kind empirical {
    label de official "Ein Nachlassgegenstand unterliegt der Verwaltung des Testamentsvollstreckers (§ 2211 Abs. 1)";
    label en unofficial "an estate asset is subject to the executor's administration (§ 2211 (1))";
}
pub relation erbe_kann_nicht_verfuegen_2211(t: Testament, erbe: Person) kind derived {
    label de official "Der Erbe kann über den Gegenstand nicht verfügen (§ 2211 Abs. 1)";
    label en unofficial "the heir cannot dispose of the asset (§ 2211 (1))";
}
pub relation der_verwaltung_unterliegendes_recht_gerichtlich_geltend_zu_machen_2212(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Ein der Verwaltung des Testamentsvollstreckers unterliegendes Recht soll gerichtlich geltend gemacht werden (§ 2212)";
    label en unofficial "a right subject to the executor's administration is to be asserted judicially (§ 2212)";
}
pub relation nur_vollstrecker_kann_geltend_machen_2212(t: Testament, vollstrecker: Person) kind derived {
    label de official "Nur der Testamentsvollstrecker kann das Recht gerichtlich geltend machen (§ 2212)";
    label en unofficial "only the executor may assert the right judicially (§ 2212)";
}
pub relation anspruch_gegen_nachlass_gerichtet_2213(t: Testament, erbe: Person, vollstrecker: Person) kind empirical {
    label de official "Ein Anspruch richtet sich gegen den Nachlass (§ 2213 Abs. 1 Satz 1)";
    label en unofficial "a claim is directed against the estate (§ 2213 (1) sentence 1)";
}
pub relation anspruch_gegen_erben_und_vollstrecker_geltend_machbar_2213(t: Testament, erbe: Person, vollstrecker: Person) kind derived {
    label de official "Der Anspruch kann sowohl gegen den Erben als auch gegen den Testamentsvollstrecker gerichtlich geltend gemacht werden (§ 2213 Abs. 1 Satz 1)";
    label en unofficial "the claim may be asserted judicially against either the heir or the executor (§ 2213 (1) sentence 1)";
}
pub relation vollstrecker_hat_nicht_die_nachlassverwaltung_2213(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Dem Testamentsvollstrecker steht nicht die Verwaltung des Nachlasses zu (§ 2213 Abs. 1 Satz 2)";
    label en unofficial "the executor does not have administration of the estate (§ 2213 (1) sentence 2)";
}
pub relation nur_gegen_erben_geltend_machbar_2213(t: Testament, erbe: Person) kind derived {
    label de official "Die Geltendmachung ist nur gegen den Erben zulässig (§ 2213 Abs. 1 Satz 2)";
    label en unofficial "assertion is permitted only against the heir (§ 2213 (1) sentence 2)";
}
pub relation pflichtteilsanspruch_betroffen_2213(t: Testament, erbe: Person) kind empirical {
    label de official "Es handelt sich um einen Pflichtteilsanspruch (§ 2213 Abs. 1 Satz 3)";
    label en unofficial "the claim is a compulsory-portion claim (§ 2213 (1) sentence 3)";
}
pub relation pflichtteilsanspruch_nur_gegen_erben_2213(t: Testament, erbe: Person) kind derived {
    label de official "Der Pflichtteilsanspruch kann nur gegen den Erben geltend gemacht werden, auch wenn der Testamentsvollstrecker die Verwaltung hat (§ 2213 Abs. 1 Satz 3)";
    label en unofficial "the compulsory-portion claim may be asserted only against the heir, even if the executor administers the estate (§ 2213 (1) sentence 3)";
}
pub relation glaeubiger_macht_anspruch_gegen_erben_geltend_2213(t: Testament, erbe: Person, vollstrecker: Person) kind empirical {
    label de official "Ein Nachlassgläubiger macht seinen Anspruch gegen den Erben geltend (§ 2213 Abs. 3)";
    label en unofficial "an estate creditor asserts their claim against the heir (§ 2213 (3))";
}
pub relation duldung_der_zwangsvollstreckung_vom_vollstrecker_verlangbar_2213(t: Testament, vollstrecker: Person) kind derived {
    label de official "Der Gläubiger kann vom Testamentsvollstrecker die Duldung der Zwangsvollstreckung in die seiner Verwaltung unterliegenden Gegenstände verlangen (§ 2213 Abs. 3)";
    label en unofficial "the creditor may demand the executor tolerate enforcement against assets under their administration (§ 2213 (3))";
}
pub relation glaeubiger_des_erben_kein_nachlassglaeubiger_2214(t: Testament, erbe: Person) kind empirical {
    label de official "Ein Gläubiger des Erben gehört nicht zu den Nachlassgläubigern (§ 2214)";
    label en unofficial "a creditor of the heir is not among the estate creditors (§ 2214)";
}
pub relation kein_zugriff_auf_verwaltete_gegenstaende_2214(t: Testament, erbe: Person) kind derived {
    label de official "Dieser Gläubiger kann sich nicht an die der Verwaltung des Testamentsvollstreckers unterliegenden Gegenstände halten (§ 2214)";
    label en unofficial "that creditor cannot resort to assets under the executor's administration (§ 2214)";
}
pub relation vollstrecker_hat_amt_angenommen_2215(t: Testament, vollstrecker: Person, erbe: Person) kind empirical {
    label de official "Der Testamentsvollstrecker hat das Amt angenommen (§ 2215 Abs. 1)";
    label en unofficial "the executor has accepted the office (§ 2215 (1))";
}
pub relation nachlassverzeichnis_geschuldet_2215(t: Testament, vollstrecker: Person, erbe: Person) kind derived {
    label de official "Der Testamentsvollstrecker hat dem Erben unverzüglich ein Verzeichnis der verwalteten Gegenstände und bekannten Verbindlichkeiten mitzuteilen (§ 2215 Abs. 1)";
    label en unofficial "the executor must promptly communicate to the heir an inventory of administered assets and known liabilities (§ 2215 (1))";
}
pub relation erbe_verlangt_amtliche_aufnahme_des_verzeichnisses_2215(t: Testament, vollstrecker: Person, erbe: Person) kind empirical {
    label de official "Der Erbe verlangt, dass das Verzeichnis durch Behörde, Beamten oder Notar aufgenommen wird (§ 2215 Abs. 4)";
    label en unofficial "the heir demands that the inventory be prepared by an authority, official or notary (§ 2215 (4))";
}
pub relation amtliche_aufnahme_geschuldet_2215(t: Testament, vollstrecker: Person, erbe: Person) kind derived {
    label de official "Der Testamentsvollstrecker ist zur amtlichen Aufnahme des Verzeichnisses verpflichtet (§ 2215 Abs. 4)";
    label en unofficial "the executor is obliged to have the inventory prepared officially (§ 2215 (4))";
}
pub relation kosten_der_aufnahme_treffen_nachlass_2215(t: Testament) kind derived {
    label de official "Die Kosten der Aufnahme und Beglaubigung fallen dem Nachlass zur Last (§ 2215 Abs. 5)";
    label en unofficial "the costs of preparation and certification are borne by the estate (§ 2215 (5))";
}
pub relation vollstrecker_verwaltet_nachlass_2216(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Testamentsvollstrecker verwaltet den Nachlass (§ 2216 Abs. 1)";
    label en unofficial "the executor administers the estate (§ 2216 (1))";
}
pub relation ordnungsmaessige_verwaltung_geschuldet_2216(t: Testament, vollstrecker: Person) kind derived {
    label de official "Der Testamentsvollstrecker ist zur ordnungsmäßigen Verwaltung verpflichtet (§ 2216 Abs. 1)";
    label en unofficial "the executor is obliged to administer the estate properly (§ 2216 (1))";
}
pub relation erblasser_hat_verwaltungsanordnungen_getroffen_2216(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Erblasser hat für die Verwaltung durch letztwillige Verfügung Anordnungen getroffen (§ 2216 Abs. 2 Satz 1)";
    label en unofficial "the testator made instructions for the administration by testamentary disposition (§ 2216 (2) sentence 1)";
}
pub relation anordnungen_zu_befolgen_2216(t: Testament, vollstrecker: Person) kind derived {
    label de official "Der Testamentsvollstrecker hat die Anordnungen zu befolgen (§ 2216 Abs. 2 Satz 1)";
    label en unofficial "the executor must follow the instructions (§ 2216 (2) sentence 1)";
}
pub relation gegenstand_offenbar_nicht_zur_erfuellung_der_obliegenheiten_benoetigt_und_erbe_verlangt_2217(t: Testament, vollstrecker: Person, erbe: Person) kind empirical {
    label de official "Der Testamentsvollstrecker bedarf eines Nachlassgegenstands offenbar nicht mehr, und der Erbe verlangt Überlassung (§ 2217 Abs. 1 Satz 1)";
    label en unofficial "the executor evidently no longer needs an estate asset, and the heir demands its release (§ 2217 (1) sentence 1)";
}
pub relation ueberlassung_geschuldet_und_verwaltungsrecht_erlischt_2217(t: Testament, vollstrecker: Person, erbe: Person) kind derived {
    label de official "Der Gegenstand ist dem Erben zur freien Verfügung zu überlassen; mit der Überlassung erlischt das Verwaltungsrecht (§ 2217 Abs. 1)";
    label en unofficial "the asset must be released to the heir for free disposal; the administration right ends upon release (§ 2217 (1))";
}
pub relation erbe_leistet_sicherheit_fuer_verbindlichkeiten_oder_vermaechtnisse_2217(t: Testament, vollstrecker: Person, erbe: Person) kind empirical {
    label de official "Der Erbe leistet Sicherheit für die Berichtigung nicht-vermächtnisbezogener Verbindlichkeiten oder für bedingte/betagte Vermächtnisse (§ 2217 Abs. 2)";
    label en unofficial "the heir provides security for non-legacy debts or for conditional/deferred legacies (§ 2217 (2))";
}
pub relation ueberlassung_nicht_verweigerbar_2217(t: Testament, vollstrecker: Person, erbe: Person) kind derived {
    label de official "Der Testamentsvollstrecker kann die Überlassung insoweit nicht verweigern (§ 2217 Abs. 2)";
    label en unofficial "the executor may not refuse release to that extent (§ 2217 (2))";
}
pub relation laenger_dauernde_verwaltung_2218(t: Testament, vollstrecker: Person, erbe: Person) kind empirical {
    label de official "Es liegt eine länger dauernde Verwaltung vor (§ 2218 Abs. 2)";
    label en unofficial "administration lasts an extended period (§ 2218 (2))";
}
pub relation jaehrliche_rechnungslegung_verlangbar_2218(t: Testament, vollstrecker: Person, erbe: Person) kind derived {
    label de official "Der Erbe kann jährlich Rechnungslegung verlangen (§ 2218 Abs. 2)";
    label en unofficial "the heir may demand an annual accounting (§ 2218 (2))";
}
pub relation vollstrecker_verletzt_pflicht_schuldhaft_2219(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Testamentsvollstrecker verletzt schuldhaft eine ihm obliegende Verpflichtung (§ 2219 Abs. 1)";
    label en unofficial "the executor culpably breaches an incumbent obligation (§ 2219 (1))";
}
pub relation vollstrecker_haftet_erben_2219(t: Testament, vollstrecker: Person, erbe: Person) kind derived {
    label de official "Der Testamentsvollstrecker ist dem Erben für den daraus entstehenden Schaden verantwortlich (§ 2219 Abs. 1)";
    label en unofficial "the executor is liable to the heir for the resulting damage (§ 2219 (1))";
}
pub relation vermaechtnis_zu_vollziehen_2219(t: Testament, vollstrecker: Person, vermaechtnisnehmer: Person) kind empirical {
    label de official "Ein Vermächtnis ist zu vollziehen (§ 2219 Abs. 1)";
    label en unofficial "a legacy is to be performed (§ 2219 (1))";
}
pub relation vollstrecker_haftet_auch_vermaechtnisnehmer_2219(t: Testament, vollstrecker: Person, vermaechtnisnehmer: Person) kind derived {
    label de official "Der Testamentsvollstrecker ist auch dem Vermächtnisnehmer verantwortlich (§ 2219 Abs. 1)";
    label en unofficial "the executor is also liable to the legatee (§ 2219 (1))";
}
pub relation mehrere_vollstrecker_schuldhaft_2219(t: Testament) kind empirical {
    label de official "Mehreren Testamentsvollstreckern fällt ein Verschulden zur Last (§ 2219 Abs. 2)";
    label en unofficial "several executors are at fault (§ 2219 (2))";
}
pub relation gesamtschuldnerische_haftung_2219(t: Testament) kind derived {
    label de official "Sie haften als Gesamtschuldner (§ 2219 Abs. 2)";
    label en unofficial "they are jointly and severally liable (§ 2219 (2))";
}
pub relation erblasser_versucht_befreiung_von_2215_2216_2218_2219_pflichten_2220(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Erblasser versucht, den Testamentsvollstrecker von den Pflichten aus §§ 2215, 2216, 2218, 2219 zu befreien (§ 2220)";
    label en unofficial "the testator attempts to release the executor from the duties under §§ 2215, 2216, 2218, 2219 (§ 2220)";
}
pub relation befreiung_unwirksam_2220(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Befreiung ist unwirksam; die Pflichten bestehen zwingend (§ 2220)";
    label en unofficial "the release is ineffective; the duties are mandatory (§ 2220)";
}
pub relation vollstrecker_fuehrt_amt_2221(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Testamentsvollstrecker führt sein Amt (§ 2221)";
    label en unofficial "the executor performs the office (§ 2221)";
}
pub relation erblasser_hat_anderes_zur_verguetung_bestimmt_2221(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Erblasser hat zur Vergütung ein anderes bestimmt (§ 2221, Defeater)";
    label en unofficial "the testator determined otherwise as to remuneration (§ 2221, defeater)";
}
pub relation angemessene_verguetung_verlangbar_2221(t: Testament, vollstrecker: Person) kind derived {
    label de official "Der Testamentsvollstrecker kann eine angemessene Vergütung verlangen (§ 2221)";
    label en unofficial "the executor may demand reasonable remuneration (§ 2221)";
}
pub relation erblasser_ernennt_nacherbenvollstrecker_2222(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Erblasser ernennt einen Testamentsvollstrecker, damit dieser bis zum Eintritt der Nacherbfolge die Rechte des Nacherben ausübt (§ 2222)";
    label en unofficial "the testator appoints an executor to exercise the subsequent heir's rights until succession occurs (§ 2222)";
}
pub relation nacherbenvollstreckung_zulaessig_2222(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Ernennung zum Nacherbenvollstrecker ist zulässig (§ 2222)";
    label en unofficial "appointment as subsequent-heir executor is permitted (§ 2222)";
}
pub relation erblasser_ernennt_vermaechtnisvollstrecker_2223(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Erblasser ernennt einen Testamentsvollstrecker, damit dieser für die Ausführung der einem Vermächtnisnehmer auferlegten Beschwerungen sorgt (§ 2223)";
    label en unofficial "the testator appoints an executor to see to the execution of burdens imposed on a legatee (§ 2223)";
}
pub relation vermaechtnisvollstreckung_zulaessig_2223(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Ernennung zum Vermächtnisvollstrecker ist zulässig (§ 2223)";
    label en unofficial "appointment as legacy executor is permitted (§ 2223)";
}
pub relation mehrere_testamentsvollstrecker_ernannt_2224(t: Testament) kind empirical {
    label de official "Mehrere Testamentsvollstrecker sind ernannt (§ 2224 Abs. 1 Satz 1)";
    label en unofficial "several executors are appointed (§ 2224 (1) sentence 1)";
}
pub relation gemeinschaftliche_amtsfuehrung_2224(t: Testament) kind derived {
    label de official "Die Testamentsvollstrecker führen das Amt gemeinschaftlich (§ 2224 Abs. 1 Satz 1)";
    label en unofficial "the executors conduct the office jointly (§ 2224 (1) sentence 1)";
}
pub relation einer_von_mehreren_vollstreckern_weggefallen_2224(t: Testament, verbleibender: Person, weggefallener: Person) kind empirical {
    label de official "Einer von mehreren Testamentsvollstreckern fällt weg (§ 2224 Abs. 1 Satz 2)";
    label en unofficial "one of several executors falls away (§ 2224 (1) sentence 2)";
}
pub relation uebrige_fuehren_amt_allein_2224(t: Testament, verbleibender: Person) kind derived {
    label de official "Die übrigen Testamentsvollstrecker führen das Amt allein (§ 2224 Abs. 1 Satz 2)";
    label en unofficial "the remaining executors conduct the office alone (§ 2224 (1) sentence 2)";
}
pub relation massregel_zur_erhaltung_eines_gemeinschaftlich_verwalteten_gegenstands_notwendig_2224(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Eine Maßregel ist zur Erhaltung eines der gemeinschaftlichen Verwaltung unterliegenden Nachlassgegenstands notwendig (§ 2224 Abs. 2)";
    label en unofficial "a measure is necessary to preserve an asset under joint administration (§ 2224 (2))";
}
pub relation einzelner_vollstrecker_darf_ohne_zustimmung_handeln_2224(t: Testament, vollstrecker: Person) kind derived {
    label de official "Jeder Testamentsvollstrecker ist berechtigt, diese Maßregel ohne Zustimmung der anderen zu treffen (§ 2224 Abs. 2)";
    label en unofficial "each executor is entitled to take this measure without the others' consent (§ 2224 (2))";
}
pub relation vollstrecker_stirbt_oder_faellt_wie_2201_weg_2225(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Testamentsvollstrecker stirbt, oder ein Fall des § 2201 tritt ein (§ 2225)";
    label en unofficial "the executor dies, or a § 2201 case occurs (§ 2225)";
}
pub relation amt_erlischt_2225(t: Testament, vollstrecker: Person) kind derived {
    label de official "Das Amt des Testamentsvollstreckers erlischt (§ 2225)";
    label en unofficial "the executor's office ends (§ 2225)";
}
pub relation vollstrecker_erklaert_kuendigung_ggue_nachlassgericht_2226(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Der Testamentsvollstrecker erklärt die Kündigung des Amts gegenüber dem Nachlassgericht (§ 2226 Sätze 1, 2)";
    label en unofficial "the executor declares resignation from office to the probate court (§ 2226 sentences 1, 2)";
}
pub relation kuendigung_wirksam_2226(t: Testament, vollstrecker: Person) kind derived {
    label de official "Die Kündigung des Amts ist wirksam; der Testamentsvollstrecker kann jederzeit kündigen (§ 2226 Satz 1)";
    label en unofficial "the resignation is valid; the executor may resign at any time (§ 2226 sentence 1)";
}
pub relation wichtiger_grund_fuer_entlassung_vorliegt_2227(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Ein wichtiger Grund, insbesondere grobe Pflichtverletzung oder Unfähigkeit zur ordnungsmäßigen Geschäftsführung, liegt vor (§ 2227)";
    label en unofficial "a serious ground, in particular gross breach of duty or incapacity for proper management, exists (§ 2227)";
}
pub relation entlassung_zulaessig_2227(t: Testament, vollstrecker: Person) kind derived {
    label de official "Das Nachlassgericht kann den Testamentsvollstrecker auf Antrag entlassen (§ 2227)";
    label en unofficial "the probate court may remove the executor on application (§ 2227)";
}

// --- Regeln ------------------------------------------------------------

@source(BGB_P2197) {
    rule ErnennungDurchErblasserWirksam(t: Testament, vollstrecker: Person) strict {
        label de official "Der Erblasser kann durch Testament einen Testamentsvollstrecker ernennen (§ 2197 Abs. 1)"; label en unofficial "The testator may appoint an executor by will (§ 2197 (1))";
        when erblasser_ernennt_testamentsvollstrecker_2197(t, vollstrecker); then ernennung_wirksam_2197(t, vollstrecker);
    }
    rule ErsatzernennungFuerWegfallsfall(t: Testament, vollstrecker: Person, ersterernannter: Person) strict {
        label de official "Der Erblasser kann für den Fall des Wegfalls einen anderen Testamentsvollstrecker ernennen (§ 2197 Abs. 2)"; label en unofficial "The testator may appoint another executor for the event the first falls away (§ 2197 (2))";
        when ernennung_fuer_wegfallsfall_eines_anderen_2197(t, vollstrecker, ersterernannter); then ersatzernennung_wirksam_2197(t, vollstrecker);
    }
}
@source(BGB_P2198)
rule BestimmungDurchDrittenWirksam(t: Testament, dritter: Person, vollstrecker: Person) strict {
    label de official "Überlässt der Erblasser die Bestimmung einem Dritten und erklärt dieser sie öffentlich beglaubigt gegenüber dem Nachlassgericht, ist die Bestimmung wirksam (§ 2198 Abs. 1)"; label en unofficial "Where the testator leaves the choice to a third party who declares it to the probate court in certified form, the determination is valid (§ 2198 (1))";
    when erblasser_ueberlaesst_bestimmung_einem_dritten_2198(t, dritter) and dritter_erklaert_bestimmung_ggue_nachlassgericht_oeffentlich_beglaubigt_2198(t, dritter, vollstrecker); then bestimmung_durch_dritten_wirksam_2198(t, vollstrecker);
}
@source(BGB_P2199) {
    rule ErmaechtigungZuMitvollstreckern(t: Testament, vollstrecker: Person) strict {
        label de official "Der Erblasser kann den Testamentsvollstrecker ermächtigen, Mitvollstrecker zu ernennen (§ 2199 Abs. 1)"; label en unofficial "The testator may authorise the executor to appoint co-executors (§ 2199 (1))";
        when erblasser_ermaechtigt_zur_ernennung_von_mitvollstreckern_2199(t, vollstrecker); then ermaechtigung_zu_mitvollstreckern_wirksam_2199(t, vollstrecker);
    }
    rule ErmaechtigungZuNachfolger(t: Testament, vollstrecker: Person) strict {
        label de official "Der Erblasser kann den Testamentsvollstrecker ermächtigen, einen Nachfolger zu ernennen (§ 2199 Abs. 2)"; label en unofficial "The testator may authorise the executor to appoint a successor (§ 2199 (2))";
        when erblasser_ermaechtigt_zur_ernennung_eines_nachfolgers_2199(t, vollstrecker); then ermaechtigung_zu_nachfolger_wirksam_2199(t, vollstrecker);
    }
}
@source(BGB_P2201)
rule ErnennungUnwirksamBeiUnfaehigkeit(t: Testament, vollstrecker: Person) strict {
    label de official "Die Ernennung ist unwirksam, wenn der Ernannte zum Amtsantritt geschäftsunfähig, beschränkt geschäftsfähig ist, oder einen Vermögensbetreuer hat (§ 2201)"; label en unofficial "The appointment is ineffective where the appointee lacks or has limited capacity, or has an asset custodian, at the time of taking office (§ 2201)";
    when vollstrecker_bei_amtsantritt_geschaeftsunfaehig_oder_beschraenkt_oder_betreut_2201(t, vollstrecker); then ernennung_unwirksam_2201(t, vollstrecker);
}
@source(BGB_P2202) {
    rule AmtBeginntMitAnnahme(t: Testament, vollstrecker: Person, zeitpunkt: Date) strict {
        label de official "Das Amt des Testamentsvollstreckers beginnt mit dem Zeitpunkt der Annahme (§ 2202 Abs. 1)"; label en unofficial "The executor's office begins at the moment of acceptance (§ 2202 (1))";
        when ernannter_nimmt_amt_an_2202(t, vollstrecker, zeitpunkt); then amt_beginnt_mit_annahme_2202(t, vollstrecker, zeitpunkt);
    }
    rule AmtGiltAlsAbgelehntNachFristablauf(t: Testament, vollstrecker: Person) strict {
        label de official "Mit Ablauf der vom Nachlassgericht gesetzten Frist gilt das Amt als abgelehnt, wenn nicht vorher die Annahme erklärt wird (§ 2202 Abs. 3)"; label en unofficial "On lapse of the period set by the probate court, the office is deemed declined unless acceptance was declared before (§ 2202 (3))";
        when annahme_frist_abgelaufen_ohne_erklaerung_2202(t, vollstrecker); then amt_gilt_als_abgelehnt_2202(t, vollstrecker);
    }
}
@source(BGB_P2203)
rule AufgabeDesTestamentsvollstreckers(t: Testament, vollstrecker: Person) strict {
    label de official "Der Testamentsvollstrecker hat die letztwilligen Verfügungen des Erblassers zur Ausführung zu bringen (§ 2203)"; label en unofficial "The executor must bring the testator's testamentary dispositions to execution (§ 2203)";
    when vollstrecker_hat_amt_angetreten_2203(t, vollstrecker); then aufgabe_letztwillige_verfuegungen_auszufuehren_2203(t, vollstrecker);
}
@source(BGB_P2204)
rule AuseinandersetzungUnterMiterben(t: Testament, vollstrecker: Person) strict {
    label de official "Der Testamentsvollstrecker hat bei mehreren Erben die Auseinandersetzung nach §§ 2042 bis 2057a zu bewirken (§ 2204 Abs. 1)"; label en unofficial "Where there are several heirs, the executor must effect the partition under §§ 2042 to 2057a (§ 2204 (1))";
    when mehrere_erben_vorhanden_2204(t, vollstrecker); then vollstrecker_hat_auseinandersetzung_zu_bewirken_2204(t, vollstrecker);
}
@source(BGB_P2205) {
    rule VerwaltungsUndVerfuegungsbefugnis(t: Testament, vollstrecker: Person) strict {
        label de official "Der Testamentsvollstrecker hat den Nachlass zu verwalten und ist berechtigt, ihn in Besitz zu nehmen und über Gegenstände zu verfügen (§ 2205 Sätze 1, 2)"; label en unofficial "The executor must administer the estate and is entitled to take possession and dispose of estate assets (§ 2205 sentences 1, 2)";
        when vollstrecker_hat_nachlass_zu_verwalten_2205(t, vollstrecker); then verwaltungs_und_verfuegungsbefugnis_2205(t, vollstrecker);
    }
    rule UnentgeltlicheVerfuegungBeiSittlicherPflicht(t: Testament, vollstrecker: Person) strict {
        label de official "Zu unentgeltlichen Verfügungen ist der Testamentsvollstrecker nur berechtigt, soweit sie sittlicher Pflicht oder Anstandsrücksicht entsprechen (§ 2205 Satz 3)"; label en unofficial "The executor may make gratuitous dispositions only to the extent they correspond to a moral duty or propriety (§ 2205 sentence 3)";
        when unentgeltliche_verfuegung_sittlicher_pflicht_oder_anstand_entsprechend_2205(t, vollstrecker); then unentgeltliche_verfuegung_zulaessig_2205(t, vollstrecker);
    }
}
@source(BGB_P2206) {
    rule VerbindlichkeitEingehenBeiErforderlichkeit(t: Testament, vollstrecker: Person) strict {
        label de official "Der Testamentsvollstrecker ist berechtigt, Verbindlichkeiten einzugehen, soweit zur ordnungsmäßigen Verwaltung erforderlich (§ 2206 Abs. 1 Satz 1)"; label en unofficial "The executor may incur liabilities to the extent necessary for proper administration (§ 2206 (1) sentence 1)";
        when verbindlichkeit_zur_ordnungsmaessigen_verwaltung_erforderlich_2206(t, vollstrecker); then vollstrecker_darf_verbindlichkeit_eingehen_2206(t, vollstrecker);
    }
    rule ErbeEinwilligungspflicht(t: Testament, vollstrecker: Person, erbe: Person) strict {
        label de official "Der Erbe ist verpflichtet, zur Eingehung solcher Verbindlichkeiten seine Einwilligung zu erteilen (§ 2206 Abs. 2)"; label en unofficial "The heir is obliged to consent to the incurring of such liabilities (§ 2206 (2))";
        when vollstrecker_darf_verbindlichkeit_eingehen_2206(t, vollstrecker) and erbe_des_nachlasses_2206(t, vollstrecker, erbe); then erbe_zur_einwilligung_verpflichtet_2206(t, erbe);
    }
}
@source(BGB_P2207)
rule ErweiterteVerpflichtungsbefugnis(t: Testament, vollstrecker: Person) strict {
    label de official "Ordnet der Erblasser an, dass der Testamentsvollstrecker in der Eingehung von Verbindlichkeiten nicht beschränkt sein soll, hat er erweiterte Verpflichtungsbefugnis (§ 2207 Satz 1)"; label en unofficial "Where the testator orders the executor not be limited in incurring liabilities, the executor has extended power (§ 2207 sentence 1)";
    when erblasser_ordnet_unbeschraenkte_verpflichtungsbefugnis_an_2207(t, vollstrecker); then erweiterte_verpflichtungsbefugnis_2207(t, vollstrecker);
}
@source(BGB_P2208) {
    rule RechtBestehtNichtBeiAbweichendemErblasserwillen(t: Testament, vollstrecker: Person) strict {
        label de official "Ist anzunehmen, dass ein Recht aus §§ 2203 bis 2206 dem Testamentsvollstrecker nach dem Erblasserwillen nicht zustehen soll, besteht es nicht (§ 2208 Abs. 1 Satz 1)"; label en unofficial "Where it must be assumed the testator did not intend the executor to have a § 2203-2206 right, it does not exist (§ 2208 (1) sentence 1)";
        when anzunehmen_dass_recht_nach_erblasserwillen_nicht_zusteht_2208(t, vollstrecker); then recht_besteht_nicht_2208(t, vollstrecker);
    }
    presumption AusfuehrungVomErbenVerlangbar(t: Testament, vollstrecker: Person, erbe: Person) {
        label de official "Muss der Testamentsvollstrecker Verfügungen nicht selbst ausführen, kann er im Zweifel die Ausführung vom Erben verlangen (§ 2208 Abs. 2)"; label en unofficial "Where the executor need not himself execute dispositions, they may in case of doubt demand execution from the heir (§ 2208 (2))";
        when vollstrecker_muss_verfuegungen_nicht_selbst_ausfuehren_2208(t, vollstrecker, erbe); presume ausfuehrung_vom_erben_verlangbar_vermutet_2208(t, vollstrecker, erbe); unless anderer_wille_des_erblassers_bei_2208_anzunehmen(t, vollstrecker, erbe);
    }
}
@source(BGB_P2209) {
    rule DauervollstreckungAngeordnet(t: Testament, vollstrecker: Person) strict {
        label de official "Der Erblasser kann einem Testamentsvollstrecker die bloße Verwaltung übertragen oder ihre Fortführung nach Erledigung anordnen (§ 2209 Satz 1)"; label en unofficial "The testator may entrust the executor with mere administration or order its continuation after other tasks (§ 2209 sentence 1)";
        when erblasser_uebertraegt_dauervollstreckung_2209(t, vollstrecker); then dauervollstreckung_angeordnet_2209(t, vollstrecker);
    }
    presumption ErweiterteErmaechtigungBeiDauervollstreckung(t: Testament, vollstrecker: Person) {
        label de official "Im Zweifel ist einem solchen Testamentsvollstrecker die Ermächtigung des § 2207 erteilt (§ 2209 Satz 2)"; label en unofficial "In case of doubt, such an executor holds the § 2207 authorisation (§ 2209 sentence 2)";
        when dauervollstreckung_angeordnet_2209(t, vollstrecker); presume erweiterte_ermaechtigung_bei_dauervollstreckung_vermutet_2209(t, vollstrecker);
    }
}
@source(BGB_P2210) {
    rule DauervollstreckungWirdNachDreissigJahrenUnwirksam(t: Testament, vollstrecker: Person) strict {
        label de official "Eine Dauervollstreckungsanordnung wird unwirksam, wenn seit dem Erbfall 30 Jahre verstrichen sind (§ 2210 Satz 1)"; label en unofficial "A continuing-administration order becomes ineffective once thirty years have elapsed since devolution (§ 2210 sentence 1)";
        when dauervollstreckung_dreissig_jahre_ohne_anderweitige_anordnung_2210(t, vollstrecker); then dauervollstreckungsanordnung_unwirksam_2210(t, vollstrecker);
    }
    rule FortdauerBisTodOderEreignisZulaessig(t: Testament, vollstrecker: Person) strict {
        label de official "Der Erblasser kann Fortdauer bis zum Tode des Erben oder Testamentsvollstreckers oder bis zu einem anderen Ereignis anordnen; § 2163 Abs. 2 findet entsprechende Anwendung (§ 2210 Sätze 2, 3)"; label en unofficial "The testator may order continuation until the heir's or executor's death or another event; § 2163 (2) applies mutatis mutandis (§ 2210 sentences 2, 3)";
        when erblasser_ordnet_fortdauer_bis_tod_oder_ereignis_an_2210(t, vollstrecker); then fortdauer_ueber_dreissig_jahre_zulaessig_2210(t, vollstrecker);
    }
}
@source(BGB_P2211)
rule ErbeKannNichtVerfuegen(t: Testament, vollstrecker: Person, erbe: Person) strict {
    label de official "Über einen der Verwaltung des Testamentsvollstreckers unterliegenden Gegenstand kann der Erbe nicht verfügen (§ 2211 Abs. 1)"; label en unofficial "The heir cannot dispose of an asset under the executor's administration (§ 2211 (1))";
    when nachlassgegenstand_unterliegt_verwaltung_des_vollstreckers_2211(t, vollstrecker, erbe); then erbe_kann_nicht_verfuegen_2211(t, erbe);
}
@source(BGB_P2212)
rule NurVollstreckerKannGeltendMachen(t: Testament, vollstrecker: Person) strict {
    label de official "Ein der Verwaltung des Testamentsvollstreckers unterliegendes Recht kann nur von ihm gerichtlich geltend gemacht werden (§ 2212)"; label en unofficial "A right under the executor's administration may be asserted judicially only by the executor (§ 2212)";
    when der_verwaltung_unterliegendes_recht_gerichtlich_geltend_zu_machen_2212(t, vollstrecker); then nur_vollstrecker_kann_geltend_machen_2212(t, vollstrecker);
}
@source(BGB_P2213) {
    rule AnspruchGegenErbenUndVollstrecker(t: Testament, erbe: Person, vollstrecker: Person) strict {
        label de official "Ein gegen den Nachlass gerichteter Anspruch kann sowohl gegen den Erben als auch gegen den Testamentsvollstrecker geltend gemacht werden (§ 2213 Abs. 1 Satz 1)"; label en unofficial "A claim against the estate may be asserted against the heir or the executor (§ 2213 (1) sentence 1)";
        when anspruch_gegen_nachlass_gerichtet_2213(t, erbe, vollstrecker); then anspruch_gegen_erben_und_vollstrecker_geltend_machbar_2213(t, erbe, vollstrecker);
    }
    rule NurGegenErbenBeiFehlenderVerwaltung(t: Testament, erbe: Person, vollstrecker: Person) strict {
        label de official "Steht dem Testamentsvollstrecker die Verwaltung nicht zu, ist die Geltendmachung nur gegen den Erben zulässig (§ 2213 Abs. 1 Satz 2)"; label en unofficial "Where the executor lacks administration, assertion is permitted only against the heir (§ 2213 (1) sentence 2)";
        when vollstrecker_hat_nicht_die_nachlassverwaltung_2213(t, vollstrecker) and anspruch_gegen_nachlass_gerichtet_2213(t, erbe, vollstrecker); then nur_gegen_erben_geltend_machbar_2213(t, erbe);
    }
    rule PflichtteilsanspruchNurGegenErben(t: Testament, erbe: Person) strict {
        label de official "Ein Pflichtteilsanspruch kann nur gegen den Erben geltend gemacht werden, auch bei Verwaltung durch den Testamentsvollstrecker (§ 2213 Abs. 1 Satz 3)"; label en unofficial "A compulsory-portion claim may be asserted only against the heir, even where the executor administers the estate (§ 2213 (1) sentence 3)";
        when pflichtteilsanspruch_betroffen_2213(t, erbe); then pflichtteilsanspruch_nur_gegen_erben_2213(t, erbe);
    }
    rule DuldungDerZwangsvollstreckung(t: Testament, erbe: Person, vollstrecker: Person) strict {
        label de official "Ein Nachlassgläubiger kann vom Testamentsvollstrecker Duldung der Zwangsvollstreckung in die verwalteten Gegenstände verlangen (§ 2213 Abs. 3)"; label en unofficial "An estate creditor may demand the executor tolerate enforcement against administered assets (§ 2213 (3))";
        when glaeubiger_macht_anspruch_gegen_erben_geltend_2213(t, erbe, vollstrecker); then duldung_der_zwangsvollstreckung_vom_vollstrecker_verlangbar_2213(t, vollstrecker);
    }
}
@source(BGB_P2214)
rule KeinZugriffFuerErbenglaeubiger(t: Testament, erbe: Person) strict {
    label de official "Gläubiger des Erben, die nicht Nachlassgläubiger sind, können sich nicht an die verwalteten Gegenstände halten (§ 2214)"; label en unofficial "Creditors of the heir who are not estate creditors cannot resort to the administered assets (§ 2214)";
    when glaeubiger_des_erben_kein_nachlassglaeubiger_2214(t, erbe); then kein_zugriff_auf_verwaltete_gegenstaende_2214(t, erbe);
}
@source(BGB_P2215) {
    rule NachlassverzeichnisNachAnnahmeGeschuldet(t: Testament, vollstrecker: Person, erbe: Person) strict {
        label de official "Der Testamentsvollstrecker hat dem Erben unverzüglich nach der Annahme ein Nachlassverzeichnis mitzuteilen (§ 2215 Abs. 1)"; label en unofficial "The executor must promptly notify the heir of an inventory after accepting the office (§ 2215 (1))";
        when vollstrecker_hat_amt_angenommen_2215(t, vollstrecker, erbe); then nachlassverzeichnis_geschuldet_2215(t, vollstrecker, erbe);
    }
    rule AmtlicheAufnahmeAufVerlangen(t: Testament, vollstrecker: Person, erbe: Person) strict {
        label de official "Auf Verlangen des Erben ist das Verzeichnis durch Behörde, Beamten oder Notar aufzunehmen (§ 2215 Abs. 4)"; label en unofficial "At the heir's request, the inventory must be prepared by an authority, official or notary (§ 2215 (4))";
        when erbe_verlangt_amtliche_aufnahme_des_verzeichnisses_2215(t, vollstrecker, erbe); then amtliche_aufnahme_geschuldet_2215(t, vollstrecker, erbe);
    }
    rule KostenTreffenNachlass(t: Testament, vollstrecker: Person, erbe: Person) strict {
        label de official "Die Kosten der Aufnahme und Beglaubigung fallen dem Nachlass zur Last (§ 2215 Abs. 5)"; label en unofficial "The costs of preparation and certification are borne by the estate (§ 2215 (5))";
        when vollstrecker_hat_amt_angenommen_2215(t, vollstrecker, erbe); then kosten_der_aufnahme_treffen_nachlass_2215(t);
    }
}
@source(BGB_P2216) {
    rule OrdnungsmaessigeVerwaltungGeschuldet(t: Testament, vollstrecker: Person) strict {
        label de official "Der Testamentsvollstrecker ist zur ordnungsmäßigen Verwaltung des Nachlasses verpflichtet (§ 2216 Abs. 1)"; label en unofficial "The executor is obliged to administer the estate properly (§ 2216 (1))";
        when vollstrecker_verwaltet_nachlass_2216(t, vollstrecker); then ordnungsmaessige_verwaltung_geschuldet_2216(t, vollstrecker);
    }
    rule AnordnungenZuBefolgen(t: Testament, vollstrecker: Person) strict {
        label de official "Vom Erblasser für die Verwaltung getroffene Anordnungen sind vom Testamentsvollstrecker zu befolgen (§ 2216 Abs. 2 Satz 1)"; label en unofficial "The executor must follow the testator's instructions for administration (§ 2216 (2) sentence 1)";
        when erblasser_hat_verwaltungsanordnungen_getroffen_2216(t, vollstrecker); then anordnungen_zu_befolgen_2216(t, vollstrecker);
    }
}
@source(BGB_P2217) {
    rule UeberlassungAufVerlangen(t: Testament, vollstrecker: Person, erbe: Person) strict {
        label de official "Nicht mehr benötigte Nachlassgegenstände sind dem Erben auf Verlangen zur freien Verfügung zu überlassen; mit Überlassung erlischt das Verwaltungsrecht (§ 2217 Abs. 1)"; label en unofficial "Assets no longer needed must be released to the heir on demand; the administration right ends with release (§ 2217 (1))";
        when gegenstand_offenbar_nicht_zur_erfuellung_der_obliegenheiten_benoetigt_und_erbe_verlangt_2217(t, vollstrecker, erbe); then ueberlassung_geschuldet_und_verwaltungsrecht_erlischt_2217(t, vollstrecker, erbe);
    }
    rule UeberlassungNichtVerweigerbarBeiSicherheit(t: Testament, vollstrecker: Person, erbe: Person) strict {
        label de official "Leistet der Erbe Sicherheit für Verbindlichkeiten oder Vermächtnisse, kann der Testamentsvollstrecker die Überlassung insoweit nicht verweigern (§ 2217 Abs. 2)"; label en unofficial "Where the heir provides security for debts or legacies, the executor may not refuse release to that extent (§ 2217 (2))";
        when erbe_leistet_sicherheit_fuer_verbindlichkeiten_oder_vermaechtnisse_2217(t, vollstrecker, erbe); then ueberlassung_nicht_verweigerbar_2217(t, vollstrecker, erbe);
    }
}
@source(BGB_P2218)
rule JaehrlicheRechnungslegung(t: Testament, vollstrecker: Person, erbe: Person) strict {
    label de official "Bei länger dauernder Verwaltung kann der Erbe jährlich Rechnungslegung verlangen (§ 2218 Abs. 2)"; label en unofficial "Where administration lasts an extended period, the heir may demand an annual accounting (§ 2218 (2))";
    when laenger_dauernde_verwaltung_2218(t, vollstrecker, erbe); then jaehrliche_rechnungslegung_verlangbar_2218(t, vollstrecker, erbe);
}
@source(BGB_P2219) {
    rule HaftungGegenueberErben(t: Testament, vollstrecker: Person, erbe: Person) strict {
        label de official "Verletzt der Testamentsvollstrecker schuldhaft seine Pflichten, haftet er dem Erben für den Schaden (§ 2219 Abs. 1)"; label en unofficial "Where the executor culpably breaches their duties, they are liable to the heir for the damage (§ 2219 (1))";
        when vollstrecker_verletzt_pflicht_schuldhaft_2219(t, vollstrecker) and erbe_des_nachlasses_2206(t, vollstrecker, erbe); then vollstrecker_haftet_erben_2219(t, vollstrecker, erbe);
    }
    rule HaftungGegenueberVermaechtnisnehmer(t: Testament, vollstrecker: Person, vermaechtnisnehmer: Person) strict {
        label de official "Ist ein Vermächtnis zu vollziehen, haftet der Testamentsvollstrecker auch dem Vermächtnisnehmer (§ 2219 Abs. 1)"; label en unofficial "Where a legacy is to be performed, the executor is also liable to the legatee (§ 2219 (1))";
        when vollstrecker_verletzt_pflicht_schuldhaft_2219(t, vollstrecker) and vermaechtnis_zu_vollziehen_2219(t, vollstrecker, vermaechtnisnehmer); then vollstrecker_haftet_auch_vermaechtnisnehmer_2219(t, vollstrecker, vermaechtnisnehmer);
    }
    rule GesamtschuldnerischeHaftungMehrererVollstrecker(t: Testament) strict {
        label de official "Mehrere schuldhaft handelnde Testamentsvollstrecker haften als Gesamtschuldner (§ 2219 Abs. 2)"; label en unofficial "Several executors at fault are jointly and severally liable (§ 2219 (2))";
        when mehrere_vollstrecker_schuldhaft_2219(t); then gesamtschuldnerische_haftung_2219(t);
    }
}
@source(BGB_P2220)
rule BefreiungUnwirksamZwingendesRecht(t: Testament, vollstrecker: Person) strict {
    label de official "Der Erblasser kann den Testamentsvollstrecker nicht von den Pflichten aus §§ 2215, 2216, 2218, 2219 befreien (§ 2220)"; label en unofficial "The testator cannot release the executor from the duties under §§ 2215, 2216, 2218, 2219 (§ 2220)";
    when erblasser_versucht_befreiung_von_2215_2216_2218_2219_pflichten_2220(t, vollstrecker); then befreiung_unwirksam_2220(t, vollstrecker);
}
@source(BGB_P2221)
presumption AngemesseneVerguetungVerlangbar(t: Testament, vollstrecker: Person) {
    label de official "Der Testamentsvollstrecker kann im Zweifel eine angemessene Vergütung verlangen, sofern der Erblasser kein anderes bestimmt hat (§ 2221)"; label en unofficial "The executor may in case of doubt demand reasonable remuneration, unless the testator determined otherwise (§ 2221)";
    when vollstrecker_fuehrt_amt_2221(t, vollstrecker); presume angemessene_verguetung_verlangbar_2221(t, vollstrecker); unless erblasser_hat_anderes_zur_verguetung_bestimmt_2221(t, vollstrecker);
}
@source(BGB_P2222)
rule NacherbenvollstreckungZulaessig(t: Testament, vollstrecker: Person) strict {
    label de official "Der Erblasser kann einen Testamentsvollstrecker ernennen, damit dieser bis zur Nacherbfolge die Rechte des Nacherben ausübt (§ 2222)"; label en unofficial "The testator may appoint an executor to exercise the subsequent heir's rights until succession (§ 2222)";
    when erblasser_ernennt_nacherbenvollstrecker_2222(t, vollstrecker); then nacherbenvollstreckung_zulaessig_2222(t, vollstrecker);
}
@source(BGB_P2223)
rule VermaechtnisvollstreckungZulaessig(t: Testament, vollstrecker: Person) strict {
    label de official "Der Erblasser kann einen Testamentsvollstrecker ernennen, damit dieser für die Ausführung der Vermächtnisbeschwerungen sorgt (§ 2223)"; label en unofficial "The testator may appoint an executor to see to the execution of legacy burdens (§ 2223)";
    when erblasser_ernennt_vermaechtnisvollstrecker_2223(t, vollstrecker); then vermaechtnisvollstreckung_zulaessig_2223(t, vollstrecker);
}
@source(BGB_P2224) {
    rule GemeinschaftlicheAmtsfuehrung(t: Testament) strict {
        label de official "Mehrere Testamentsvollstrecker führen das Amt gemeinschaftlich (§ 2224 Abs. 1 Satz 1)"; label en unofficial "Several executors conduct the office jointly (§ 2224 (1) sentence 1)";
        when mehrere_testamentsvollstrecker_ernannt_2224(t); then gemeinschaftliche_amtsfuehrung_2224(t);
    }
    rule UebrigeFuehrenAmtAlleinBeiWegfall(t: Testament, verbleibender: Person, weggefallener: Person) strict {
        label de official "Fällt einer von mehreren Testamentsvollstreckern weg, führen die übrigen das Amt allein (§ 2224 Abs. 1 Satz 2)"; label en unofficial "Where one of several executors falls away, the rest conduct the office alone (§ 2224 (1) sentence 2)";
        when einer_von_mehreren_vollstreckern_weggefallen_2224(t, verbleibender, weggefallener); then uebrige_fuehren_amt_allein_2224(t, verbleibender);
    }
    rule MassregelOhneZustimmungZulaessig(t: Testament, vollstrecker: Person) strict {
        label de official "Jeder Testamentsvollstrecker darf zur Erhaltung eines gemeinschaftlich verwalteten Gegenstands notwendige Maßregeln ohne Zustimmung der anderen treffen (§ 2224 Abs. 2)"; label en unofficial "Each executor may take measures necessary to preserve a jointly administered asset without the others' consent (§ 2224 (2))";
        when massregel_zur_erhaltung_eines_gemeinschaftlich_verwalteten_gegenstands_notwendig_2224(t, vollstrecker); then einzelner_vollstrecker_darf_ohne_zustimmung_handeln_2224(t, vollstrecker);
    }
}
@source(BGB_P2225)
rule AmtErlischtBeiTodOderUnfaehigkeit(t: Testament, vollstrecker: Person) strict {
    label de official "Das Amt des Testamentsvollstreckers erlischt, wenn er stirbt oder ein Fall des § 2201 eintritt (§ 2225)"; label en unofficial "The executor's office ends on death or when a § 2201 case occurs (§ 2225)";
    when vollstrecker_stirbt_oder_faellt_wie_2201_weg_2225(t, vollstrecker); then amt_erlischt_2225(t, vollstrecker);
}
@source(BGB_P2226)
rule KuendigungJederzeitMoeglich(t: Testament, vollstrecker: Person) strict {
    label de official "Der Testamentsvollstrecker kann das Amt jederzeit durch Erklärung gegenüber dem Nachlassgericht kündigen (§ 2226 Sätze 1, 2)"; label en unofficial "The executor may resign from office at any time by declaration to the probate court (§ 2226 sentences 1, 2)";
    when vollstrecker_erklaert_kuendigung_ggue_nachlassgericht_2226(t, vollstrecker); then kuendigung_wirksam_2226(t, vollstrecker);
}
@source(BGB_P2227)
rule EntlassungBeiWichtigemGrund(t: Testament, vollstrecker: Person) strict {
    label de official "Das Nachlassgericht kann den Testamentsvollstrecker bei wichtigem Grund, insbesondere grober Pflichtverletzung oder Unfähigkeit, entlassen (§ 2227)"; label en unofficial "The probate court may remove the executor for good cause, in particular gross breach of duty or incapacity (§ 2227)";
    when wichtiger_grund_fuer_entlassung_vorliegt_2227(t, vollstrecker); then entlassung_zulaessig_2227(t, vollstrecker);
}
