// BÜRGERLICHES GESETZBUCH — VERFÜGUNGEN VON TODES WEGEN, PFLICHTTEIL (BG-16)
//
// Buch 5 Abschnitte 3–9 (§§ 2064–2385). Quellen: sources.law (generiert aus
// dem Register DOKNR). STAND: PILOT B1 — der Pflichtteil als GELDANSPRUCH
// in Höhe der Hälfte des Wertes des gesetzlichen Erbteils (§ 2303) auf den
// Nachlasswert zur Zeit des Erbfalls (§ 2311 Abs. 1) und der
// Pflichtteilsergänzungsanspruch bei Schenkungen mit der Abschmelzung um
// ein Zehntel je Jahr (§ 2325 Abs. 3). Die vollständige Formalisierung der
// Abschnitte folgt in Welle B5 (README, Aufgabenkarte).
//
// PFLICHTTEIL IST GELD, NICHT ERBQUOTE. § 2303 Abs. 1 Satz 2: „Der
// Pflichtteil besteht in der Hälfte des Wertes des gesetzlichen Erbteils.“
// Der gesetzliche Erbteil kommt als exakter Bruch aus `de.bgb.erbfolge`
// (Zähler, Nenner); die Quote ist die Hälfte davon (z, 2n); der Betrag ist
// Nachlasswert × Quote. § 2310: bei der Feststellung des Erbteils werden
// die durch Verfügung Ausgeschlossenen mitgezählt — die Erbfolge rechnet
// die Quote ohne Rücksicht auf die Verfügung, daher liest der Pilot sie
// unverändert.
//
// RUNDUNG — POLITIK DES PAKETS, KEINE NORM (README „Rundung“; Ledger D-07).
// Das Gesetz nennt keine Rundung; `Money × Rational` ist nur bei
// 10-glattem Ergebnis exakt (E-0085). Das Paket rundet EINMAL je Anspruch,
// auf den Cent, kaufmännisch, über den exakten Quotienten:
// `div_round(Wert × Zähler, Nenner als Decimal, 2, "HALF_UP")`. Pflichtteil und
// Ergänzung sind getrennte Ansprüche und werden getrennt gerundet.
//
// ABSCHMELZUNG § 2325 ABS. 3 als Jahresschritt vom Tag der Leistung
// (`add_calendar_period`, Politik `BGB_VERFUEGUNGEN_JAHR`, § 188 Abs. 2):
// innerhalb des ersten Jahres vor dem Erbfall zehn Zehntel, jedes weitere
// Jahr ein Zehntel weniger, nach zehn Jahren nichts. Der Tag genau an der
// Jahresgrenze ist im Pilot nicht belegt (README). Satz 3 (Schenkung an
// den Ehegatten: Frist ab Auflösung der Ehe) und Abs. 2 (Niederstwert
// verbrauchbarer und anderer Gegenstände) sind Welle B5: der anzusetzende
// Wert ist im Pilot Eingabe des Falls.

language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";
import de.bgb.core version "0.1.0";
import de.bgb.ehe version "0.1.0";
import de.bgb.erbfolge version "0.1.0";
import de.bgb.fristen version "0.1.0";
import calc.kinship version "0.1.0";

type Person = de.bgb.core::Person;
type Erbfall = de.bgb.erbfolge::Erbfall;
type Anspruch = de.bgb.core::Anspruch;

source FEIERTAGE_BUND {
    kind statute;
    jurisdiction DE;
    number "Feiertagsgesetze der Länder (bundesweit anerkannte Feiertage)";
    label de official "Gesetzliche Feiertage, die in allen Ländern anerkannt sind (Feiertagsgesetze der Länder)";
    label en unofficial "Public holidays recognised in every Land (Länder public-holiday acts)";
}
edition FEIERTAGE_BUND_1991_2070 of FEIERTAGE_BUND {
    language de;
    officiality official;
    materialization_status ABSTRACT_ONLY;
    in_force [@1991-01-01, @2071-01-01);
    label de official "Bundesweit anerkannte Feiertage 1991–2070";
    label en unofficial "Nationwide public holidays 1991–2070";
}
calendar KALENDER_BUNDESWEIT {
    timezone "Europe/Berlin";
    timezone_db "iana-tzdb@2026a";
    period [@1991-01-01, @2071-01-01);
    source FEIERTAGE_BUND;
    resource "artifact:corpus/clir/de-feiertage-bundesweit.calendar.json";
    format "law.calendar/0.1";
    content_hash "sha256:aa310583279c7f05aa491307648663f4a7c9f8f90910541876118bfb6d6e3204";
}

// Jahresschritt § 2325 Abs. 3 (§ 188 Abs. 2): Tag, der durch seine Zahl dem
// Tag der Leistung entspricht; fehlt er, der letzte Tag des Monats (Abs. 3).
deadline policy BGB_VERFUEGUNGEN_JAHR {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

pub entity Schenkung {
    label de official "Schenkung des Erblassers an einen Dritten (§ 2325 Abs. 1)";
    label en unofficial "gift of the decedent to a third party (§ 2325 (1))";
}

pub entity Nachlassposition {
    label de official "Recht oder Verbindlichkeit bei der Feststellung des Nachlasswerts (§ 2313)";
    label en unofficial "right or liability in determining the estate value (§ 2313)";
}

pub entity Pflichtteilszuwendung {
    label de official "Zuwendung des Erblassers unter Lebenden an einen Pflichtteilsberechtigten (§ 2315)";
    label en unofficial "inter vivos grant by the decedent to a compulsory-portion beneficiary (§ 2315)";
}

// --- Eingaben des Falls ------------------------------------------------------------------------

pub relation durch_verfuegung_von_todes_wegen_ausgeschlossen(e: Erbfall, p: Person) kind empirical {
    label de official "Die Person ist durch Verfügung von Todes wegen von der Erbfolge ausgeschlossen (§ 2303 Abs. 1 Satz 1, Abs. 2)";
    label en unofficial "The person is excluded from succession by a disposition mortis causa (§ 2303 (1) sentence 1, (2))";
}
pub relation nachlasswert(e: Erbfall, wert: Money) kind empirical {
    key(e);
    label de official "Bestand und Wert des Nachlasses zur Zeit des Erbfalls (§ 2311 Abs. 1 Satz 1) — Schätzung nach Abs. 2 ist Welle B5";
    label en unofficial "composition and value of the estate at the time of the devolution (§ 2311 (1) sentence 1) — valuation under (2) is wave B5";
}
pub relation schenkung_des_erblassers(e: Erbfall, s: Schenkung, beschenkter: Person) kind empirical {
    key(s);
    label de official "Schenkung des Erblassers an einen Dritten (§ 2325 Abs. 1)";
    label en unofficial "gift of the decedent to a third party (§ 2325 (1))";
}
pub relation anzusetzender_wert(s: Schenkung, wert: Money) kind empirical {
    key(s);
    label de official "Wert, mit dem der verschenkte Gegenstand in Ansatz kommt (§ 2325 Abs. 2) — im Pilot Eingabe des Falls";
    label en unofficial "value at which the gift is taken into account (§ 2325 (2)) — case input in the pilot";
}
pub relation wert_zur_zeit_der_leistung(s: Schenkung, wert: Money) kind empirical {
    key(s);
    label de official "Wert des verschenkten Gegenstandes zur Zeit der Leistung (§ 2325 Abs. 2 Satz 1)";
    label en unofficial "value of the gifted object at the time of performance (§ 2325 (2) sentence 1)";
}
pub relation wert_zur_zeit_des_erbfalls(s: Schenkung, wert: Money) kind empirical {
    key(s);
    label de official "Wert des verschenkten Gegenstandes zur Zeit des Erbfalls (§ 2325 Abs. 2 Satz 2)";
    label en unofficial "value of the gifted object at the time of the devolution (§ 2325 (2) sentence 2)";
}
pub relation schenkung_verbrauchbare_sache(s: Schenkung) kind empirical {
    label de official "Der verschenkte Gegenstand ist eine verbrauchbare Sache (§ 2325 Abs. 2 Satz 1)";
    label en unofficial "the gifted object is a consumable item (§ 2325 (2) sentence 1)";
}
pub relation schenkung_nicht_verbrauchbare_sache(s: Schenkung) kind empirical {
    label de official "Der verschenkte Gegenstand ist keine verbrauchbare Sache (§ 2325 Abs. 2 Satz 2; ausdrückliche Fallangabe)";
    label en unofficial "the gifted object is not a consumable item (§ 2325 (2) sentence 2; explicit case input)";
}
pub relation wert_nach_niederstwertprinzip(s: Schenkung, wert: Money) kind derived {
    key(s);
    label de official "Nach § 2325 Abs. 2 anzusetzender Wert: Wert zur Zeit der Leistung, bei niedrigerem Wert zur Zeit des Erbfalls dieser niedrigere Wert";
    label en unofficial "value to be taken into account under § 2325 (2): value at performance, or the lower value at devolution";
}
pub relation geleistet_am(s: Schenkung, tag: Date) kind empirical {
    key(s);
    label de official "Tag der Leistung des verschenkten Gegenstandes (§ 2325 Abs. 3 Satz 2)";
    label en unofficial "day of performance of the gift (§ 2325 (3) sentence 2)";
}
pub relation schenkung_nicht_an_ehegatten(s: Schenkung) kind empirical {
    label de official "Die Schenkung wurde nicht an den Ehegatten des Erblassers geleistet (§ 2325 Abs. 3 Satz 3: ausdrückliche Fallangabe)";
    label en unofficial "the gift was not made to the decedent's spouse (§ 2325 (3) sentence 3: explicit case input)";
}
pub relation schenkung_an_ehegatten(s: Schenkung, ehe: de.bgb.ehe::Ehe) kind empirical {
    key(s);
    label de official "Die Schenkung wurde an den Ehegatten des Erblassers geleistet (§ 2325 Abs. 3 Satz 3)";
    label en unofficial "the gift was made to the decedent's spouse (§ 2325 (3) sentence 3)";
}
pub relation ehe_aufgeloest_am(ehe: de.bgb.ehe::Ehe, tag: Date) kind empirical {
    key(ehe);
    label de official "Tag der Auflösung der Ehe (§ 2325 Abs. 3 Satz 3; die Auflösung selbst ist bis zum Brückenschluss BG-12 Fallangabe)";
    label en unofficial "day on which the marriage was dissolved (§ 2325 (3) sentence 3; dissolution is a case input pending the BG-12 bridge)";
}
pub relation abschmelzungsbeginn(s: Schenkung, tag: Date) kind derived {
    key(s);
    label de official "Beginn der Zehnjahresfrist des § 2325 Abs. 3: Leistung, bei Schenkung an den Ehegatten jedoch nicht vor Auflösung der Ehe";
    label en unofficial "start of the ten-year period in § 2325 (3): performance, but for a gift to the spouse not before dissolution of the marriage";
}

@source(BGB_P2325)
rule NiederstwertLeistungswert(s: Schenkung, leistung: Money, erbfall: Money) strict {
    label de official "Der Wert wird zur Zeit der Leistung bestimmt; ist der Wert zur Zeit des Erbfalls geringer, so ist dieser Wert maßgebend (§ 2325 Abs. 2 Sätze 1 und 2): der Leistungswert gilt, wenn er nicht höher ist";
    label en unofficial "The value is determined at performance; if it is lower at devolution, that value is decisive (§ 2325 (2) sentences 1 and 2): the performance value applies where it is not higher";
    when schenkung_nicht_verbrauchbare_sache(s) and wert_zur_zeit_der_leistung(s, leistung) and wert_zur_zeit_des_erbfalls(s, erbfall) and leistung <= erbfall;
    then wert_nach_niederstwertprinzip(s, leistung);
}
@source(BGB_P2325)
rule NiederstwertErbfallwert(s: Schenkung, leistung: Money, erbfall: Money) strict {
    label de official "Ist der Wert zur Zeit des Erbfalls geringer, so ist dieser Wert maßgebend (§ 2325 Abs. 2 Satz 2)";
    label en unofficial "If the value at devolution is lower, that value is decisive (§ 2325 (2) sentence 2)";
    when schenkung_nicht_verbrauchbare_sache(s) and wert_zur_zeit_der_leistung(s, leistung) and wert_zur_zeit_des_erbfalls(s, erbfall) and erbfall < leistung;
    then wert_nach_niederstwertprinzip(s, erbfall);
}
@source(BGB_P2325)
rule VerbrauchbareSacheLeistungswert(s: Schenkung, leistung: Money) strict {
    label de official "Eine verbrauchbare Sache kommt mit dem Werte in Ansatz, den sie zur Zeit der Schenkung hatte (§ 2325 Abs. 2 Satz 1)";
    label en unofficial "A consumable item is taken into account at the value it had at the time of the gift (§ 2325 (2) sentence 1)";
    when schenkung_verbrauchbare_sache(s) and wert_zur_zeit_der_leistung(s, leistung);
    then wert_nach_niederstwertprinzip(s, leistung);
}
@source(BGB_P2325)
rule AbschmelzungsbeginnLeistung(s: Schenkung, tag: Date) strict {
    label de official "Bei einer nicht an den Ehegatten geleisteten Schenkung beginnt die Frist mit der Leistung (§ 2325 Abs. 3 Sätze 1 und 2)";
    label en unofficial "For a gift not made to the spouse, the period begins with performance (§ 2325 (3) sentences 1 and 2)";
    when geleistet_am(s, tag) and schenkung_nicht_an_ehegatten(s);
    then abschmelzungsbeginn(s, tag);
}
@source(BGB_P2325)
rule AbschmelzungsbeginnEhegatteLeistungSpaeter(s: Schenkung, ehe: de.bgb.ehe::Ehe, leistung: Date, aufloesung: Date) strict {
    label de official "Bei einer Schenkung an den Ehegatten beginnt die Frist nicht vor der Auflösung der Ehe (§ 2325 Abs. 3 Satz 3): liegt die Leistung später, beginnt sie mit der Leistung";
    label en unofficial "For a gift to the spouse, the period does not begin before dissolution (§ 2325 (3) sentence 3): where performance is later, it begins on performance";
    when schenkung_an_ehegatten(s, ehe) and geleistet_am(s, leistung) and ehe_aufgeloest_am(ehe, aufloesung) and leistung >= aufloesung;
    then abschmelzungsbeginn(s, leistung);
}
@source(BGB_P2325)
rule AbschmelzungsbeginnEhegatteAufloesungSpaeter(s: Schenkung, ehe: de.bgb.ehe::Ehe, leistung: Date, aufloesung: Date) strict {
    label de official "Bei einer Schenkung an den Ehegatten beginnt die Frist nicht vor der Auflösung der Ehe (§ 2325 Abs. 3 Satz 3): liegt die Auflösung später, beginnt sie mit der Auflösung";
    label en unofficial "For a gift to the spouse, the period does not begin before dissolution (§ 2325 (3) sentence 3): where dissolution is later, it begins on dissolution";
    when schenkung_an_ehegatten(s, ehe) and geleistet_am(s, leistung) and ehe_aufgeloest_am(ehe, aufloesung) and aufloesung > leistung;
    then abschmelzungsbeginn(s, aufloesung);
}

// --- Pflichtteil (§§ 2303, 2310, 2311) --------------------------------------------------------------

pub relation pflichtteilsberechtigt(e: Erbfall, p: Person) kind derived {
    label de official "Pflichtteilsberechtigter: Abkömmling, Elternteil oder Ehegatte des Erblassers, durch Verfügung von Todes wegen von der Erbfolge ausgeschlossen (§ 2303 Abs. 1, 2)";
    label en unofficial "person entitled to a compulsory portion: descendant, parent or spouse excluded by disposition mortis causa (§ 2303 (1), (2))";
}
pub relation pflichtteilsquote_bruch(e: Erbfall, p: Person, zaehler: Integer, nenner: Integer) kind derived {
    key(e, p);
    label de official "Pflichtteilsquote als Bruch: die Hälfte des gesetzlichen Erbteils (§ 2303 Abs. 1 Satz 2)";
    label en unofficial "compulsory-portion quota as a fraction: half of the statutory share (§ 2303 (1) sentence 2)";
}
pub relation pflichtteilsquote(e: Erbfall, p: Person, x: Rational) kind derived {
    key(e, p);
    label de official "Pflichtteilsquote als exakter Bruch";
    label en unofficial "compulsory-portion quota as an exact fraction";
}
pub relation pflichtteil(e: Erbfall, p: Person, betrag: Money) kind derived {
    key(e, p);
    label de official "Pflichtteil: Geldanspruch gegen den Erben in Höhe der Hälfte des Wertes des gesetzlichen Erbteils (§ 2303 Abs. 1), berechnet auf den Nachlasswert (§ 2311), einmal auf den Cent gerundet (Politik des Pakets)";
    label en unofficial "compulsory portion: monetary claim against the heir in the amount of half the value of the statutory share (§ 2303 (1)), computed on the estate value (§ 2311), rounded once to the cent (package policy)";
}
pub relation als_erbe_hinterlassener_pflichtteilsberechtigter(e: Erbfall, p: Person) kind empirical {
    label de official "Ein Pflichtteilsberechtigter ist mit einem Erbteil hinterlassen (§ 2305)";
    label en unofficial "a person entitled to a compulsory portion was left a share as heir (§ 2305)";
}
pub relation hinterlassener_erbteil_wert(e: Erbfall, p: Person, betrag: Money) kind empirical {
    key(e, p);
    label de official "Wert des dem Pflichtteilsberechtigten hinterlassenen Erbteils ohne Beschränkungen und Beschwerungen der in § 2306 bezeichneten Art (§ 2305 Satz 2)";
    label en unofficial "value of the share left to the compulsory-portion beneficiary, disregarding restrictions and encumbrances listed in § 2306 (§ 2305 sentence 2)";
}
pub relation zusatzpflichtteilsquote_bruch(e: Erbfall, p: Person, zaehler: Integer, nenner: Integer) kind derived {
    key(e, p);
    label de official "Hälfte des gesetzlichen Erbteils als Vergleichsquote für den Zusatzpflichtteil (§ 2305)";
    label en unofficial "half of the statutory share as the comparison quota for the additional compulsory portion (§ 2305)";
}
pub relation zusatzpflichtteil(e: Erbfall, p: Person, betrag: Money) kind derived {
    key(e, p);
    label de official "Zusatzpflichtteil: Wert des an der Hälfte des gesetzlichen Erbteils fehlenden Teils (§ 2305), einmal auf den Cent gerundet";
    label en unofficial "additional compulsory portion: value of the part missing from half of the statutory share (§ 2305), rounded once to the cent";
}
pub relation zuwendung_des_pflichtteils_2304(e: Erbfall, p: Person) kind empirical {
    label de official "Dem Berechtigten ist der Pflichtteil zugewendet (§ 2304)";
    label en unofficial "the compulsory portion was granted to the beneficiary (§ 2304)";
}
pub relation zuwendung_nicht_als_erbeinsetzung_2304(e: Erbfall, p: Person) kind derived {
    label de official "Die Zuwendung des Pflichtteils ist im Zweifel nicht als Erbeinsetzung anzusehen (§ 2304)";
    label en unofficial "in case of doubt, a grant of the compulsory portion is not an appointment as heir (§ 2304)";
}
pub relation erbteil_beschraenkt_oder_beschwert_2306(e: Erbfall, p: Person) kind empirical {
    label de official "Der als Erbe berufene Pflichtteilsberechtigte ist durch Nacherbeneinsetzung, Testamentsvollstreckung oder Teilungsanordnung beschränkt oder mit Vermächtnis oder Auflage beschwert (§ 2306 Abs. 1)";
    label en unofficial "the compulsory-portion beneficiary called as heir is restricted by subsequent heirship, execution or a division order, or encumbered by a legacy or charge (§ 2306 (1))";
}
pub relation erbteil_ausgeschlagen_2306(e: Erbfall, p: Person) kind empirical {
    label de official "Der beschränkte oder beschwerte Pflichtteilsberechtigte hat den Erbteil ausgeschlagen (§ 2306 Abs. 1)";
    label en unofficial "the restricted or encumbered compulsory-portion beneficiary has disclaimed the share (§ 2306 (1))";
}
pub relation vermaechtnis_bedacht_2307(e: Erbfall, p: Person) kind empirical {
    label de official "Der Pflichtteilsberechtigte ist mit einem Vermächtnis bedacht (§ 2307 Abs. 1)";
    label en unofficial "the compulsory-portion beneficiary is provided for by a legacy (§ 2307 (1))";
}
pub relation vermaechtnis_ausgeschlagen_2307(e: Erbfall, p: Person) kind empirical {
    label de official "Der mit einem Vermächtnis bedachte Pflichtteilsberechtigte hat das Vermächtnis ausgeschlagen (§ 2307 Abs. 1)";
    label en unofficial "the compulsory-portion beneficiary provided for by a legacy has disclaimed it (§ 2307 (1))";
}
pub relation pflichtteil_nach_ausschlagung_verlangbar(e: Erbfall, p: Person) kind derived {
    label de official "Der Pflichtteilsberechtigte kann nach Ausschlagung des beschränkten Erbteils oder Vermächtnisses den Pflichtteil verlangen (§§ 2306 Abs. 1, 2307 Abs. 1)";
    label en unofficial "following disclaimer of the restricted share or legacy, the beneficiary may demand the compulsory portion (§§ 2306 (1), 2307 (1))";
}
pub relation pflichtteilsanspruch_entstanden(e: Erbfall, p: Person) kind derived {
    label de official "Der Anspruch auf den Pflichtteil ist mit dem Erbfall entstanden (§ 2317 Abs. 1)";
    label en unofficial "the compulsory-portion claim arose with the devolution (§ 2317 (1))";
}
pub relation pflichtteilsanspruch_vererblich_und_uebertragbar(e: Erbfall, p: Person) kind derived {
    label de official "Der entstandene Pflichtteilsanspruch ist vererblich und übertragbar (§ 2317 Abs. 2)";
    label en unofficial "the arisen compulsory-portion claim is inheritable and assignable (§ 2317 (2))";
}
pub relation aufschiebend_bedingtes_recht_2313(e: Erbfall, position: Nachlassposition) kind empirical {
    label de official "Ein Recht des Nachlasses hängt von einer aufschiebenden Bedingung ab (§ 2313 Abs. 1 Satz 1)";
    label en unofficial "an estate right depends on a suspensive condition (§ 2313 (1) sentence 1)";
}
pub relation aufschiebend_bedingte_verbindlichkeit_2313(e: Erbfall, position: Nachlassposition) kind empirical {
    label de official "Eine Nachlassverbindlichkeit hängt von einer aufschiebenden Bedingung ab (§ 2313 Abs. 1 Satz 1)";
    label en unofficial "an estate liability depends on a suspensive condition (§ 2313 (1) sentence 1)";
}
pub relation aufloesend_bedingtes_recht_2313(e: Erbfall, position: Nachlassposition) kind empirical {
    label de official "Ein Recht des Nachlasses hängt von einer auflösenden Bedingung ab (§ 2313 Abs. 1 Satz 2)";
    label en unofficial "an estate right depends on a resolutory condition (§ 2313 (1) sentence 2)";
}
pub relation aufloesend_bedingte_verbindlichkeit_2313(e: Erbfall, position: Nachlassposition) kind empirical {
    label de official "Eine Nachlassverbindlichkeit hängt von einer auflösenden Bedingung ab (§ 2313 Abs. 1 Satz 2)";
    label en unofficial "an estate liability depends on a resolutory condition (§ 2313 (1) sentence 2)";
}
pub relation ungewisses_recht_2313(e: Erbfall, position: Nachlassposition) kind empirical {
    label de official "Ein Recht des Nachlasses ist ungewiss (§ 2313 Abs. 2 Satz 1)";
    label en unofficial "an estate right is uncertain (§ 2313 (2) sentence 1)";
}
pub relation unsicheres_recht_2313(e: Erbfall, position: Nachlassposition) kind empirical {
    label de official "Ein Recht des Nachlasses ist unsicher (§ 2313 Abs. 2 Satz 1)";
    label en unofficial "an estate right is insecure (§ 2313 (2) sentence 1)";
}
pub relation zweifelhafte_verbindlichkeit_2313(e: Erbfall, position: Nachlassposition) kind empirical {
    label de official "Eine Nachlassverbindlichkeit ist zweifelhaft (§ 2313 Abs. 2 Satz 1)";
    label en unofficial "an estate liability is doubtful (§ 2313 (2) sentence 1)";
}
pub relation nachlassposition_ausser_ansatz_2313(e: Erbfall, position: Nachlassposition) kind derived {
    label de official "Die Position bleibt bei der Feststellung des Nachlasswerts außer Ansatz (§ 2313 Abs. 1 Satz 1, Abs. 2 Satz 1)";
    label en unofficial "the item is excluded when determining the estate value (§ 2313 (1) sentence 1, (2) sentence 1)";
}
pub relation nachlassposition_als_unbedingt_anzusetzen_2313(e: Erbfall, position: Nachlassposition) kind derived {
    label de official "Die Position kommt als unbedingte in Ansatz (§ 2313 Abs. 1 Satz 2)";
    label en unofficial "the item is taken into account as unconditional (§ 2313 (1) sentence 2)";
}
pub relation bedingung_eingetreten_2313(e: Erbfall, position: Nachlassposition) kind empirical {
    label de official "Die für die Nachlassposition maßgebliche Bedingung ist eingetreten (§ 2313 Abs. 1 Satz 3)";
    label en unofficial "the condition relevant to the estate item has occurred (§ 2313 (1) sentence 3)";
}
pub relation ausgleichung_nach_veraenderter_rechtslage_2313_erforderlich(e: Erbfall, position: Nachlassposition) kind derived {
    label de official "Nach Eintritt der Bedingung ist die der veränderten Rechtslage entsprechende Ausgleichung vorzunehmen (§ 2313 Abs. 1 Satz 3)";
    label en unofficial "after occurrence of the condition, adjustment corresponding to the changed legal situation is required (§ 2313 (1) sentence 3)";
}
@source(BGB_P2313)
pub external judgment relation ordnungsmaessige_verwaltung_erfordert_feststellung_2313(e: Erbfall, erbe: Person, position: Nachlassposition) {
    authority Court;
    label de official "Die Feststellung des ungewissen Rechts entspricht einer ordnungsmäßigen Verwaltung (§ 2313 Abs. 2 Satz 2)";
    label en unofficial "determining the uncertain right accords with proper administration (§ 2313 (2) sentence 2)";
}
@source(BGB_P2313)
pub external judgment relation ordnungsmaessige_verwaltung_erfordert_verfolgung_2313(e: Erbfall, erbe: Person, position: Nachlassposition) {
    authority Court;
    label de official "Die Verfolgung des unsicheren Rechts entspricht einer ordnungsmäßigen Verwaltung (§ 2313 Abs. 2 Satz 2)";
    label en unofficial "pursuing the insecure right accords with proper administration (§ 2313 (2) sentence 2)";
}
pub relation erbe_muss_ungewisses_recht_feststellen_2313(e: Erbfall, erbe: Person, position: Nachlassposition) kind derived {
    label de official "Der Erbe ist dem Pflichtteilsberechtigten gegenüber zur Feststellung eines ungewissen Rechts verpflichtet (§ 2313 Abs. 2 Satz 2)";
    label en unofficial "the heir owes the compulsory-portion beneficiary determination of an uncertain right (§ 2313 (2) sentence 2)";
}
pub relation erbe_muss_unsicheres_recht_verfolgen_2313(e: Erbfall, erbe: Person, position: Nachlassposition) kind derived {
    label de official "Der Erbe ist dem Pflichtteilsberechtigten gegenüber zur Verfolgung eines unsicheren Rechts verpflichtet (§ 2313 Abs. 2 Satz 2)";
    label en unofficial "the heir owes the compulsory-portion beneficiary pursuit of an insecure right (§ 2313 (2) sentence 2)";
}
pub relation pflichtteilsberechtigter_nicht_erbe_2314(e: Erbfall, p: Person) kind empirical {
    label de official "Der Pflichtteilsberechtigte ist nicht Erbe (§ 2314 Abs. 1 Satz 1; qualifizierte Fallangabe)";
    label en unofficial "the compulsory-portion beneficiary is not an heir (§ 2314 (1) sentence 1; qualified case input)";
}
pub relation nachlassauskunft_verlangt_2314(e: Erbfall, p: Person, erbe: Person) kind empirical {
    label de official "Der Pflichtteilsberechtigte verlangt vom Erben Auskunft über den Bestand des Nachlasses (§ 2314 Abs. 1 Satz 1)";
    label en unofficial "the beneficiary demands estate information from the heir (§ 2314 (1) sentence 1)";
}
pub relation erbe_muss_nachlassauskunft_erteilen_2314(e: Erbfall, erbe: Person, p: Person) kind derived {
    label de official "Der Erbe muss dem nicht als Erben berufenen Pflichtteilsberechtigten auf Verlangen Auskunft über den Bestand des Nachlasses erteilen (§ 2314 Abs. 1 Satz 1)";
    label en unofficial "the heir must on demand provide estate information to the beneficiary who is not an heir (§ 2314 (1) sentence 1)";
}
pub relation beiziehung_zum_verzeichnis_verlangt_2314(e: Erbfall, p: Person) kind empirical {
    label de official "Der Pflichtteilsberechtigte verlangt die Zuziehung bei Aufnahme des Nachlassverzeichnisses (§ 2314 Abs. 1 Satz 2)";
    label en unofficial "the beneficiary demands attendance at preparation of the estate inventory (§ 2314 (1) sentence 2)";
}
pub relation wertermittlung_nachlassgegenstaende_verlangt_2314(e: Erbfall, p: Person) kind empirical {
    label de official "Der Pflichtteilsberechtigte verlangt die Wertermittlung der Nachlassgegenstände (§ 2314 Abs. 1 Satz 2)";
    label en unofficial "the beneficiary demands valuation of estate assets (§ 2314 (1) sentence 2)";
}
pub relation amtliches_oder_notarielles_verzeichnis_verlangt_2314(e: Erbfall, p: Person) kind empirical {
    label de official "Der Pflichtteilsberechtigte verlangt die Aufnahme des Verzeichnisses durch Behörde, Beamten oder Notar (§ 2314 Abs. 1 Satz 3)";
    label en unofficial "the beneficiary demands an inventory prepared by the authority, official, or notary (§ 2314 (1) sentence 3)";
}
pub relation beiziehung_zum_verzeichnis_verlangbar_2314(e: Erbfall, p: Person) kind derived {
    label de official "Der Pflichtteilsberechtigte kann die Zuziehung bei Aufnahme des Verzeichnisses verlangen (§ 2314 Abs. 1 Satz 2)";
    label en unofficial "the beneficiary may demand attendance at preparation of the inventory (§ 2314 (1) sentence 2)";
}
pub relation wertermittlung_nachlassgegenstaende_verlangbar_2314(e: Erbfall, p: Person) kind derived {
    label de official "Der Pflichtteilsberechtigte kann die Wertermittlung der Nachlassgegenstände verlangen (§ 2314 Abs. 1 Satz 2)";
    label en unofficial "the beneficiary may demand valuation of estate assets (§ 2314 (1) sentence 2)";
}
pub relation amtliches_oder_notarielles_verzeichnis_verlangbar_2314(e: Erbfall, p: Person) kind derived {
    label de official "Der Pflichtteilsberechtigte kann die Aufnahme des Verzeichnisses durch Behörde, Beamten oder Notar verlangen (§ 2314 Abs. 1 Satz 3)";
    label en unofficial "the beneficiary may demand an inventory prepared by authority, official, or notary (§ 2314 (1) sentence 3)";
}
pub relation kosten_nachlassauskunft_2314_entstanden(e: Erbfall) kind empirical {
    label de official "Kosten der nach § 2314 geschuldeten Auskunft und Verzeichniserteilung sind entstanden (§ 2314 Abs. 2)";
    label en unofficial "costs of information and inventory under § 2314 have arisen (§ 2314 (2))";
}
pub relation kosten_nachlassauskunft_traegt_nachlass_2314(e: Erbfall) kind derived {
    label de official "Die Kosten der Auskunft und des Verzeichnisses fallen dem Nachlass zur Last (§ 2314 Abs. 2)";
    label en unofficial "the estate bears the costs of information and the inventory (§ 2314 (2))";
}
pub relation zuwendung_unter_leben_2315(e: Erbfall, p: Person, z: Pflichtteilszuwendung) kind empirical {
    key(z);
    label de official "Der Erblasser hat dem Pflichtteilsberechtigten durch Rechtsgeschäft unter Lebenden eine Zuwendung gemacht (§ 2315 Abs. 1)";
    label en unofficial "the decedent granted the beneficiary something by an inter vivos transaction (§ 2315 (1))";
}
pub relation anrechnung_auf_pflichtteil_bestimmt_2315(z: Pflichtteilszuwendung) kind empirical {
    label de official "Der Erblasser hat bei der Zuwendung bestimmt, dass sie auf den Pflichtteil angerechnet werden soll (§ 2315 Abs. 1)";
    label en unofficial "the decedent specified at the grant that it is to be credited against the compulsory portion (§ 2315 (1))";
}
pub relation wert_zuwendung_zeit_leistung_2315(z: Pflichtteilszuwendung, wert: Money) kind empirical {
    key(z);
    label de official "Wert der Zuwendung zur Zeit ihrer Leistung (§ 2315 Abs. 2 Satz 2)";
    label en unofficial "value of the grant at the time it was made (§ 2315 (2) sentence 2)";
}
pub relation zuwendung_auf_pflichtteil_anzurechnen_2315(e: Erbfall, p: Person, z: Pflichtteilszuwendung, wert: Money) kind derived {
    key(e, p, z);
    label de official "Die Zuwendung ist mit ihrem Leistungszeitwert auf den Pflichtteil anzurechnen (§ 2315 Abs. 1, Abs. 2 Satz 2)";
    label en unofficial "the grant is credited against the compulsory portion at its value when made (§ 2315 (1), (2) sentence 2)";
}
pub relation nachlasswert_mit_zuwendungen_2315(e: Erbfall, p: Person, wert: Money) kind derived {
    key(e, p);
    label de official "Nachlasswert für die Bestimmung des Pflichtteils einschließlich der anzurechnenden Zuwendungen (§ 2315 Abs. 2 Satz 1)";
    label en unofficial "estate value for determining the compulsory portion including grants to be credited (§ 2315 (2) sentence 1)";
}
pub relation pflichtteil_vor_anrechnung_2315(e: Erbfall, p: Person, betrag: Money) kind derived {
    key(e, p);
    label de official "Pflichtteil aus dem um anzurechnende Zuwendungen erhöhten Nachlasswert vor deren Abzug (§ 2315 Abs. 1, 2)";
    label en unofficial "compulsory portion from estate value increased by creditable grants, before their deduction (§ 2315 (1), (2))";
}
pub relation pflichtteil_nach_anrechnung_2315(e: Erbfall, p: Person, betrag: Money) kind derived {
    key(e, p);
    label de official "Nach Anrechnung verbleibender Pflichtteilsanspruch (§ 2315 Abs. 1, 2; unter null kein Zahlungsanspruch)";
    label en unofficial "compulsory-portion claim remaining after crediting (§ 2315 (1), (2); no monetary claim below zero)";
}
pub relation abkoemmling_mehrere_2316(e: Erbfall, p: Person) kind empirical {
    label de official "Der Pflichtteilsberechtigte ist einer von mehreren Abkömmlingen des Erblassers (§ 2316 Abs. 1)";
    label en unofficial "the beneficiary is one of multiple descendants of the decedent (§ 2316 (1))";
}
pub relation ausgleichung_bei_teilung_2316_zu_beruecksichtigen(e: Erbfall, p: Person) kind empirical {
    label de official "Unter den Abkömmlingen wäre bei gesetzlicher Erbfolge eine Zuwendung oder Leistung nach § 2057a zur Ausgleichung zu bringen (§ 2316 Abs. 1)";
    label en unofficial "among the descendants, a grant or a § 2057a service would be equalised in intestacy (§ 2316 (1))";
}
pub relation gesetzlicher_erbteilwert_nach_ausgleichung_2316(e: Erbfall, p: Person, wert: Money) kind empirical {
    key(e, p);
    label de official "Wert dessen, was auf den gesetzlichen Erbteil unter Berücksichtigung der Ausgleichungspflichten bei Teilung entfiele (§ 2316 Abs. 1; Ergebnis des § 2050/§ 2057a-Kanals)";
    label en unofficial "value falling to the statutory share after taking equalisation duties on partition into account (§ 2316 (1); result of the § 2050/§ 2057a channel)";
}
pub relation pflichtteil_nach_ausgleichung_2316(e: Erbfall, p: Person, betrag: Money) kind derived {
    key(e, p);
    label de official "Pflichtteil des Abkömmlings als Hälfte dessen, was nach Ausgleichung auf den gesetzlichen Erbteil entfiele (§ 2316 Abs. 1)";
    label en unofficial "descendant's compulsory portion as half of what would fall to the statutory share after equalisation (§ 2316 (1))";
}
pub relation abkoemmling_durch_erbverzicht_ausgeschlossen_2316(e: Erbfall, p: Person) kind empirical {
    label de official "Ein Abkömmling ist durch Erbverzicht von der gesetzlichen Erbfolge ausgeschlossen (§ 2316 Abs. 1 Satz 2)";
    label en unofficial "a descendant is excluded from intestacy by a succession renunciation (§ 2316 (1) sentence 2)";
}
pub relation abkoemmling_bei_ausgleichungsberechnung_ausser_betracht_2316(e: Erbfall, p: Person) kind derived {
    label de official "Der durch Erbverzicht ausgeschlossene Abkömmling bleibt bei der Berechnung außer Betracht (§ 2316 Abs. 1 Satz 2)";
    label en unofficial "the descendant excluded by succession renunciation is left out of the calculation (§ 2316 (1) sentence 2)";
}
pub relation pflichtteilsberechtigter_ist_erbe_2316(e: Erbfall, p: Person) kind empirical {
    label de official "Der Pflichtteilsberechtigte ist selbst Erbe (§ 2316 Abs. 2)";
    label en unofficial "the compulsory-portion beneficiary is himself an heir (§ 2316 (2))";
}
pub relation hinterlassener_erbteil_wert_2316(e: Erbfall, p: Person, wert: Money) kind empirical {
    key(e, p);
    label de official "Wert des dem pflichtteilsberechtigten Erben hinterlassenen Erbteils (§ 2316 Abs. 2)";
    label en unofficial "value of the share left to the beneficiary who is an heir (§ 2316 (2))";
}
pub relation mehrbetrag_als_pflichtteil_verlangbar_2316(e: Erbfall, p: Person, betrag: Money) kind derived {
    key(e, p);
    label de official "Der pflichtteilsberechtigte Erbe kann von den Miterben den über den hinterlassenen Erbteil hinausgehenden Mehrbetrag verlangen (§ 2316 Abs. 2)";
    label en unofficial "the beneficiary who is an heir may demand from co-heirs the amount exceeding the share left (§ 2316 (2))";
}
pub relation zuwendung_2050_abs1_2316(e: Erbfall, p: Person, z: Pflichtteilszuwendung) kind empirical {
    label de official "Die Zuwendung ist eine in § 2050 Abs. 1 bezeichnete Zuwendung (§ 2316 Abs. 3)";
    label en unofficial "the grant is of the kind specified in § 2050 (1) (§ 2316 (3))";
}
pub relation beruecksichtigung_ausgeschlossen_2316(z: Pflichtteilszuwendung) kind empirical {
    label de official "Der Erblasser hat die Berücksichtigung der Zuwendung ausgeschlossen (§ 2316 Abs. 3)";
    label en unofficial "the decedent excluded taking the grant into account (§ 2316 (3))";
}
pub relation beruecksichtigungsausschluss_unwirksam_gegen_pflichtteilsberechtigten_2316(e: Erbfall, p: Person, z: Pflichtteilszuwendung) kind derived {
    label de official "Der Ausschluss der Berücksichtigung ist zum Nachteil des Pflichtteilsberechtigten unwirksam (§ 2316 Abs. 3)";
    label en unofficial "the exclusion of taking the grant into account is ineffective to the beneficiary's detriment (§ 2316 (3))";
}
pub relation zuwendung_nach_abs1_und_2315_anzurechnen_2316(e: Erbfall, p: Person, z: Pflichtteilszuwendung, wert: Money) kind derived {
    key(e, p, z);
    label de official "Eine nach § 2316 Abs. 1 zu berücksichtigende Zuwendung ist zugleich nach § 2315 auf den Pflichtteil anzurechnen (§ 2316 Abs. 4)";
    label en unofficial "a grant taken into account under § 2316 (1) is also creditable under § 2315 (§ 2316 (4))";
}
pub relation anrechnungswert_haelfte_2316(e: Erbfall, p: Person, z: Pflichtteilszuwendung, wert: Money) kind derived {
    key(e, p, z);
    label de official "Die zugleich nach § 2315 anzurechnende Zuwendung wird nur mit der Hälfte ihres Wertes angerechnet (§ 2316 Abs. 4)";
    label en unofficial "a grant also creditable under § 2315 is credited at only half of its value (§ 2316 (4))";
}
pub entity Pflichtteilslast {
    label de official "Pflichtteilslast eines Erben im Verhältnis zu Vermächtnisnehmern und Miterben (§§ 2318–2324)";
    label en unofficial "compulsory-portion burden of an heir vis-à-vis legatees and co-heirs (§§ 2318–2324)";
}
pub relation erbe_mit_vermaechtnis_beschwert_2318(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind empirical {
    label de official "Dem Erben ist ein Vermächtnis auferlegt und er trägt eine Pflichtteilslast (§ 2318 Abs. 1)";
    label en unofficial "a legacy is imposed on the heir and he bears a compulsory-portion burden (§ 2318 (1))";
}
pub relation erbe_mit_auflage_beschwert_2318(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind empirical {
    label de official "Dem Erben ist eine Auflage auferlegt und er trägt eine Pflichtteilslast (§ 2318 Abs. 1)";
    label en unofficial "a charge is imposed on the heir and he bears a compulsory-portion burden (§ 2318 (1))";
}
pub relation pflichtteilslast_verhaeltnismaessig_zu_tragen_2318(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind derived {
    label de official "Erbe und Vermächtnisnehmer tragen die Pflichtteilslast verhältnismäßig (§ 2318 Abs. 1)";
    label en unofficial "heir and legatee bear the compulsory-portion burden proportionately (§ 2318 (1))";
}
pub relation vermaechtnisnehmer_pflichtteilsberechtigt_2318(e: Erbfall, p: Person, last: Pflichtteilslast) kind empirical {
    label de official "Der Vermächtnisnehmer ist pflichtteilsberechtigt (§ 2318 Abs. 2)";
    label en unofficial "the legatee is entitled to a compulsory portion (§ 2318 (2))";
}
pub relation kuerzung_laesst_pflichtteil_vermaechtnisnehmer_2318(e: Erbfall, p: Person, last: Pflichtteilslast) kind empirical {
    label de official "Die beabsichtigte Kürzung lässt dem pflichtteilsberechtigten Vermächtnisnehmer seinen Pflichtteil (§ 2318 Abs. 2)";
    label en unofficial "the intended reduction leaves the beneficiary legatee his compulsory portion (§ 2318 (2))";
}
pub relation kuerzung_gegen_pflichtteilsberechtigten_vermaechtnisnehmer_zulaessig_2318(e: Erbfall, p: Person, last: Pflichtteilslast) kind derived {
    label de official "Gegenüber dem pflichtteilsberechtigten Vermächtnisnehmer ist die Kürzung nur zulässig, soweit sein Pflichtteil verbleibt (§ 2318 Abs. 2)";
    label en unofficial "A reduction against a beneficiary legatee is permitted only insofar as his compulsory portion remains (§ 2318 (2))";
}
pub relation erbe_selbst_pflichtteilsberechtigt_2318(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind empirical {
    label de official "Der mit Vermächtnis oder Auflage beschwerte Erbe ist selbst pflichtteilsberechtigt (§ 2318 Abs. 3)";
    label en unofficial "the heir burdened with a legacy or charge is himself a compulsory-portion beneficiary (§ 2318 (3))";
}
pub relation kuerzung_laesst_eigenen_pflichtteil_2318(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind empirical {
    label de official "Die Kürzung lässt dem selbst pflichtteilsberechtigten Erben seinen eigenen Pflichtteil (§ 2318 Abs. 3)";
    label en unofficial "the reduction leaves the beneficiary heir his own compulsory portion (§ 2318 (3))";
}
pub relation kuerzung_zur_wahrung_eigenen_pflichtteils_zulaessig_2318(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind derived {
    label de official "Der selbst pflichtteilsberechtigte Erbe kann Vermächtnis oder Auflage soweit kürzen, dass ihm sein eigener Pflichtteil verbleibt (§ 2318 Abs. 3)";
    label en unofficial "the beneficiary heir may reduce legacy or charge so that his own compulsory portion remains (§ 2318 (3))";
}
pub relation miterbe_selbst_pflichtteilsberechtigt_2319(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind empirical {
    label de official "Einer von mehreren Erben ist selbst pflichtteilsberechtigt (§ 2319)";
    label en unofficial "one of several heirs is himself a compulsory-portion beneficiary (§ 2319)";
}
pub relation teilung_erfolgt_2319(e: Erbfall, last: Pflichtteilslast) kind empirical {
    label de official "Die Teilung zwischen mehreren Erben ist erfolgt (§ 2319)";
    label en unofficial "partition among several heirs has occurred (§ 2319)";
}
pub relation befriedigung_anderer_berechtigter_soweit_verweigerbar_2319(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind derived {
    label de official "Der pflichtteilsberechtigte Miterbe kann nach der Teilung die Befriedigung eines anderen Berechtigten soweit verweigern, dass ihm sein eigener Pflichtteil verbleibt (§ 2319 Satz 1)";
    label en unofficial "after partition, the beneficiary co-heir may refuse satisfaction of another beneficiary to preserve his own portion (§ 2319 sentence 1)";
}
pub relation uebrige_miterben_haften_fuer_ausfall_2319(e: Erbfall, last: Pflichtteilslast) kind derived {
    label de official "Für den Ausfall haften die übrigen Erben (§ 2319 Satz 2)";
    label en unofficial "the remaining heirs are liable for the shortfall (§ 2319 sentence 2)";
}
pub relation anstelle_pflichtteilsberechtigten_gesetzlicher_erbe_2320(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind empirical {
    label de official "Eine Person wird anstelle des Pflichtteilsberechtigten gesetzlicher Erbe (§ 2320 Abs. 1)";
    label en unofficial "a person becomes statutory heir in place of the compulsory-portion beneficiary (§ 2320 (1))";
}
pub relation pflichtteilsberechtigter_nimmt_vermaechtnis_an_2320(e: Erbfall, last: Pflichtteilslast) kind empirical {
    label de official "Der Pflichtteilsberechtigte nimmt ein ihm zugewendetes Vermächtnis an (§ 2320 Abs. 1)";
    label en unofficial "the beneficiary accepts a legacy granted to him (§ 2320 (1))";
}
pub relation erlangter_vorteil_2320(e: Erbfall, erbe: Person, last: Pflichtteilslast, betrag: Money) kind empirical {
    key(e, erbe, last);
    label de official "Wert des durch Eintritt anstelle des Pflichtteilsberechtigten erlangten Vorteils (§ 2320 Abs. 1)";
    label en unofficial "value of the advantage gained by stepping in for the beneficiary (§ 2320 (1))";
}
pub relation pflichtteilslast_bis_vorteil_zu_tragen_2320(e: Erbfall, erbe: Person, last: Pflichtteilslast, betrag: Money) kind derived {
    key(e, erbe, last);
    label de official "Der an die Stelle getretene gesetzliche Erbe trägt im Verhältnis zu Miterben Pflichtteilslast und angenommenes Vermächtnis bis zur Höhe seines Vorteils (§ 2320 Abs. 1)";
    label en unofficial "the statutory heir stepping in bears the burden and accepted legacy vis-à-vis co-heirs up to the advantage gained (§ 2320 (1))";
}
pub relation erbteil_pflichtteilsberechtigten_durch_verfuegung_zugewendet_2320(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind empirical {
    label de official "Der Erblasser hat einer Person den Erbteil des Pflichtteilsberechtigten durch Verfügung von Todes wegen zugewendet (§ 2320 Abs. 2)";
    label en unofficial "the decedent granted a person the beneficiary's inheritance share by disposition mortis causa (§ 2320 (2))";
}
pub relation abweichender_wille_2320(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind empirical {
    label de official "Der Erblasser hat einen abweichenden Willen zur Pflichtteilslast erklärt (§ 2320 Abs. 2, im Zweifel)";
    label en unofficial "the decedent expressed a divergent intention on the compulsory-portion burden (§ 2320 (2), in case of doubt)";
}
pub relation verfuegungsnachruecker_traegt_last_vermutet_2320(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind derived {
    label de official "Im Zweifel trägt der durch Verfügung berufene Nachrücker die Pflichtteilslast (§ 2320 Abs. 2)";
    label en unofficial "in case of doubt, the successor appointed by disposition bears the compulsory-portion burden (§ 2320 (2))";
}
pub relation pflichtteilsberechtigter_schlaegt_vermaechtnis_aus_2321(e: Erbfall, last: Pflichtteilslast) kind empirical {
    label de official "Der Pflichtteilsberechtigte schlägt ein ihm zugewendetes Vermächtnis aus (§ 2321)";
    label en unofficial "the beneficiary disclaims a legacy granted to him (§ 2321)";
}
pub relation ausschlagung_kommt_zugute_2321(e: Erbfall, beguenstigter: Person, last: Pflichtteilslast, betrag: Money) kind empirical {
    key(e, beguenstigter, last);
    label de official "Einer Person kommt die Ausschlagung in Höhe eines Vorteils zugute (§ 2321)";
    label en unofficial "a person benefits from the disclaimer by a stated advantage (§ 2321)";
}
pub relation pflichtteilslast_bis_vorteil_zu_tragen_2321(e: Erbfall, beguenstigter: Person, last: Pflichtteilslast, betrag: Money) kind derived {
    key(e, beguenstigter, last);
    label de official "Der durch die Ausschlagung Begünstigte trägt Pflichtteilslast bis zur Höhe seines Vorteils (§ 2321)";
    label en unofficial "the person benefiting from the disclaimer bears the burden up to his advantage (§ 2321)";
}
pub relation ausgeschlagene_erbschaft_oder_vermaechtnis_beschwert_2322(e: Erbfall, beguenstigter: Person, last: Pflichtteilslast) kind empirical {
    label de official "Die ausgeschlagene Erbschaft oder das ausgeschlagene Vermächtnis ist mit Vermächtnis oder Auflage beschwert (§ 2322)";
    label en unofficial "the disclaimed inheritance or legacy is encumbered with a legacy or charge (§ 2322)";
}
pub relation betrag_zur_deckung_pflichtteilslast_verbleibt_2322(e: Erbfall, beguenstigter: Person, last: Pflichtteilslast) kind empirical {
    label de official "Nach der Kürzung verbleibt dem durch Ausschlagung Begünstigten der zur Deckung der Pflichtteilslast erforderliche Betrag (§ 2322)";
    label en unofficial "after reduction, the beneficiary of the disclaimer retains the amount needed to cover the burden (§ 2322)";
}
pub relation vermaechtnis_oder_auflage_kuerzbar_2322(e: Erbfall, beguenstigter: Person, last: Pflichtteilslast) kind derived {
    label de official "Der durch die Ausschlagung Begünstigte kann Vermächtnis oder Auflage soweit kürzen, dass der erforderliche Betrag zur Deckung der Pflichtteilslast verbleibt (§ 2322)";
    label en unofficial "the person benefiting from the disclaimer may reduce legacy or charge to retain the amount needed to cover the burden (§ 2322)";
}
pub relation erbe_traegt_pflichtteilslast_nicht_2323(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind empirical {
    label de official "Der Erbe trägt die Pflichtteilslast nach §§ 2320 bis 2322 nicht (§ 2323)";
    label en unofficial "the heir does not bear the compulsory-portion burden under §§ 2320 to 2322 (§ 2323)";
}
pub relation erfuellung_nicht_wegen_2318_verweigerbar_2323(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind derived {
    label de official "Der nicht pflichtteilsbelastete Erbe kann die Erfüllung eines Vermächtnisses oder einer Auflage nicht nach § 2318 Abs. 1 verweigern (§ 2323)";
    label en unofficial "the heir not bearing the burden may not refuse performance of legacy or charge under § 2318 (1) (§ 2323)";
}
pub relation abweichende_anordnung_pflichtteilslast_2324(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind empirical {
    label de official "Der Erblasser hat durch Verfügung von Todes wegen die Pflichtteilslast im Verhältnis der Erben abweichend angeordnet (§ 2324)";
    label en unofficial "the decedent made a divergent mortis-causa order on the burden as between heirs (§ 2324)";
}
pub relation abweichende_anordnung_pflichtteilslast_zulaessig_2324(e: Erbfall, erbe: Person, last: Pflichtteilslast) kind derived {
    label de official "Der Erblasser darf einzelnen Erben die Pflichtteilslast auferlegen und von § 2318 Abs. 1 sowie §§ 2320 bis 2323 abweichen (§ 2324)";
    label en unofficial "the decedent may impose the burden on individual heirs and derogate from § 2318 (1) and §§ 2320 to 2323 (§ 2324)";
}
pub relation pflichtteilsberechtigter_mit_erbteil_2326(e: Erbfall, p: Person) kind empirical {
    label de official "Dem Pflichtteilsberechtigten ist ein Erbteil hinterlassen (§ 2326)";
    label en unofficial "an inheritance share was left to the compulsory-portion beneficiary (§ 2326)";
}
pub relation hinterlassener_erbteil_genau_haelfte_gesetzlich_2326(e: Erbfall, p: Person) kind empirical {
    label de official "Der hinterlassene Erbteil entspricht genau der Hälfte des gesetzlichen Erbteils (§ 2326 Satz 1)";
    label en unofficial "the share left equals exactly half the statutory share (§ 2326 sentence 1)";
}
pub relation hinterlassener_erbteil_mehr_als_haelfte_gesetzlich_2326(e: Erbfall, p: Person, mehrwert: Money) kind empirical {
    key(e, p);
    label de official "Der hinterlassene Erbteil übersteigt die Hälfte des gesetzlichen Erbteils um den angegebenen Wert (§ 2326 Satz 2)";
    label en unofficial "the share left exceeds half the statutory share by the stated value (§ 2326 sentence 2)";
}
pub relation pflichtteilsergaenzung_auch_bei_haelfte_verlangbar_2326(e: Erbfall, p: Person) kind derived {
    label de official "Der Pflichtteilsberechtigte kann die Ergänzung auch verlangen, wenn ihm die Hälfte des gesetzlichen Erbteils hinterlassen ist (§ 2326 Satz 1)";
    label en unofficial "the beneficiary may claim the supplement even if half the statutory share was left (§ 2326 sentence 1)";
}
pub relation pflichtteilsergaenzung_soweit_mehrwert_nicht_ausgeschlossen_2326(e: Erbfall, p: Person, betrag: Money) kind derived {
    key(e, p);
    label de official "Bei einem größeren hinterlassenen Erbteil ist der Ergänzungsanspruch nur ausgeschlossen, soweit der Mehrwert reicht (§ 2326 Satz 2)";
    label en unofficial "where a larger share was left, the supplement is excluded only to the extent of the excess value (§ 2326 sentence 2)";
}
pub relation pflichtteilsberechtigter_selbst_beschenkt_2327(e: Erbfall, p: Person, s: Schenkung) kind empirical {
    label de official "Der Pflichtteilsberechtigte hat selbst ein Geschenk vom Erblasser erhalten (§ 2327 Abs. 1 Satz 1)";
    label en unofficial "the compulsory-portion beneficiary himself received a gift from the decedent (§ 2327 (1) sentence 1)";
}
pub relation eigenes_geschenk_dem_nachlass_hinzuzurechnen_2327(e: Erbfall, p: Person, s: Schenkung) kind derived {
    label de official "Das eigene Geschenk wird wie ein Geschenk an einen Dritten dem Nachlass hinzugerechnet (§ 2327 Abs. 1 Satz 1)";
    label en unofficial "the beneficiary's own gift is added to the estate in the same way as a third-party gift (§ 2327 (1) sentence 1)";
}
pub relation eigenes_geschenk_auf_ergaenzung_anzurechnen_2327(e: Erbfall, p: Person, s: Schenkung) kind derived {
    label de official "Das eigene Geschenk wird dem Pflichtteilsberechtigten auf die Ergänzung angerechnet (§ 2327 Abs. 1 Satz 1)";
    label en unofficial "the beneficiary's own gift is credited against the supplement (§ 2327 (1) sentence 1)";
}
pub relation eigenes_geschenk_nach_2315_anzurechnen_2327(e: Erbfall, p: Person, s: Schenkung) kind empirical {
    label de official "Das eigene Geschenk ist nach § 2315 auf den Pflichtteil anzurechnen (§ 2327 Abs. 1 Satz 2)";
    label en unofficial "the beneficiary's own gift is creditable under § 2315 (§ 2327 (1) sentence 2)";
}
pub relation eigenes_geschenk_2315_auf_gesamtbetrag_anzurechnen_2327(e: Erbfall, p: Person, s: Schenkung) kind derived {
    label de official "Ein nach § 2315 anzurechnendes Geschenk wird auf den Gesamtbetrag von Pflichtteil und Ergänzung angerechnet (§ 2327 Abs. 1 Satz 2)";
    label en unofficial "a gift creditable under § 2315 is credited against the aggregate of compulsory portion and supplement (§ 2327 (1) sentence 2)";
}
pub relation pflichtteilsberechtigter_abkoemmling_2327(e: Erbfall, p: Person) kind empirical {
    label de official "Der beschenkte Pflichtteilsberechtigte ist Abkömmling des Erblassers (§ 2327 Abs. 2)";
    label en unofficial "the beneficiary who received the gift is a descendant of the decedent (§ 2327 (2))";
}
pub relation ersatzabkoemmling_2051_auf_2327_anwendbar(e: Erbfall, p: Person) kind derived {
    label de official "Auf den beschenkten pflichtteilsberechtigten Abkömmling findet § 2051 Abs. 1 entsprechende Anwendung (§ 2327 Abs. 2)";
    label en unofficial "§ 2051 (1) applies mutatis mutandis to the beneficiary descendant who received the gift (§ 2327 (2))";
}
pub relation erbe_selbst_pflichtteilsberechtigt_2328(e: Erbfall, erbe: Person) kind empirical {
    label de official "Der Erbe ist selbst pflichtteilsberechtigt (§ 2328)";
    label en unofficial "the heir is himself a compulsory-portion beneficiary (§ 2328)";
}
pub relation verweigerung_laesst_eigenen_pflichtteil_und_ergaenzung_2328(e: Erbfall, erbe: Person) kind empirical {
    label de official "Die beabsichtigte Verweigerung lässt dem Erben eigenen Pflichtteil einschließlich seiner Ergänzung (§ 2328)";
    label en unofficial "the intended refusal leaves the heir his own portion including his supplement (§ 2328)";
}
pub relation erbe_kann_ergaenzung_soweit_verweigern_2328(e: Erbfall, erbe: Person) kind derived {
    label de official "Der selbst pflichtteilsberechtigte Erbe kann Ergänzung soweit verweigern, dass eigener Pflichtteil einschließlich eigener Ergänzung verbleibt (§ 2328)";
    label en unofficial "the beneficiary heir may refuse the supplement to preserve his own portion including his own supplement (§ 2328)";
}
pub relation schenkung_sittliche_pflicht_oder_anstand_2330(e: Erbfall, s: Schenkung) kind empirical {
    label de official "Die Schenkung entspricht einer sittlichen Pflicht oder einer auf den Anstand zu nehmenden Rücksicht (§ 2330)";
    label en unofficial "the gift fulfils a moral duty or consideration of propriety (§ 2330)";
}
pub relation pflichtteilsergaenzungsregeln_nicht_anwendbar_2330(e: Erbfall, s: Schenkung) kind derived {
    label de official "Die Vorschriften über Pflichtteilsergänzung §§ 2325 bis 2329 sind auf die Anstandsschenkung nicht anwendbar (§ 2330)";
    label en unofficial "the supplementary-portion provisions §§ 2325 to 2329 do not apply to the propriety gift (§ 2330)";
}
pub relation zuwendung_aus_gesamtgut_2331(e: Erbfall, s: Schenkung, erster: Person, zweiter: Person) kind empirical {
    label de official "Eine Zuwendung erfolgt aus dem Gesamtgut der Gütergemeinschaft (§ 2331 Abs. 1)";
    label en unofficial "a grant is made out of the joint property of a community of accrued gains (§ 2331 (1))";
}
pub relation zuwendung_aus_gesamtgut_haelftig_gemacht_2331(e: Erbfall, s: Schenkung, ehegatte: Person) kind derived {
    label de official "Die Zuwendung aus Gesamtgut gilt als vom Ehegatten zur Hälfte gemacht (§ 2331 Abs. 1 Satz 1)";
    label en unofficial "the grant from joint property is deemed made by the spouse as to one half (§ 2331 (1) sentence 1)";
}
pub relation beschenkter_nur_von_einem_ehegatten_abkoemmling_2331(e: Erbfall, s: Schenkung, ehegatte: Person) kind empirical {
    label de official "Der Beschenkte ist Abkömmling nur eines Ehegatten (§ 2331 Abs. 1 Satz 2)";
    label en unofficial "the recipient is a descendant of only one spouse (§ 2331 (1) sentence 2)";
}
pub relation ehegatte_leistet_ersatz_an_gesamtgut_2331(e: Erbfall, s: Schenkung, ehegatte: Person) kind empirical {
    label de official "Ein Ehegatte muss wegen der Zuwendung dem Gesamtgut Ersatz leisten (§ 2331 Abs. 1 Satz 2)";
    label en unofficial "a spouse must compensate the joint property because of the grant (§ 2331 (1) sentence 2)";
}
pub relation zuwendung_als_von_einem_ehegatten_gemacht_2331(e: Erbfall, s: Schenkung, ehegatte: Person) kind derived {
    label de official "Die Zuwendung gilt als von diesem einen Ehegatten gemacht (§ 2331 Abs. 1 Satz 2)";
    label en unofficial "the grant is deemed made by that one spouse (§ 2331 (1) sentence 2)";
}
pub relation zuwendung_aus_fortgesetztem_gesamtgut_2331(e: Erbfall, s: Schenkung) kind empirical {
    label de official "Eine Zuwendung erfolgt aus dem Gesamtgut der fortgesetzten Gütergemeinschaft (§ 2331 Abs. 2)";
    label en unofficial "a grant is made out of joint property of a continued community (§ 2331 (2))";
}
pub relation regeln_gesamtgutzuwendung_entsprechend_anwendbar_2331(e: Erbfall, s: Schenkung) kind derived {
    label de official "Die Regeln des § 2331 Abs. 1 sind auf die Zuwendung aus fortgesetztem Gesamtgut entsprechend anwendbar (§ 2331 Abs. 2)";
    label en unofficial "the rules of § 2331 (1) apply mutatis mutandis to a grant from continued joint property (§ 2331 (2))";
}
pub relation anspruch_gegen_beschenkten_2329(a: Anspruch, e: Erbfall, p: Person) kind empirical {
    key(a);
    label de official "Pflichtteilsberechtigter Anspruch gegen den Beschenkten nach § 2329 (§ 2332 Abs. 1)";
    label en unofficial "beneficiary's claim against the donee under § 2329 (§ 2332 (1))";
}
pub relation verjaehrungsbeginn_anspruch_2329_2332(a: Anspruch, tag: Date) kind derived {
    key(a);
    label de official "Die Verjährungsfrist des Anspruchs gegen den Beschenkten beginnt mit dem Erbfall (§ 2332 Abs. 1)";
    label en unofficial "the limitation period for the claim against the donee begins with the devolution (§ 2332 (1))";
}
pub relation pflichtteil_oder_2329_nach_ausschlagung_geltendmachbar_2332(a: Anspruch, e: Erbfall) kind empirical {
    label de official "Der Pflichtteilsanspruch oder Anspruch nach § 2329 kann erst nach Ausschlagung der Erbschaft oder eines Vermächtnisses geltend gemacht werden (§ 2332 Abs. 2)";
    label en unofficial "the compulsory-portion or § 2329 claim becomes assertable only after disclaimer of inheritance or legacy (§ 2332 (2))";
}
pub relation verjaehrung_nicht_durch_ausschlagung_gehemmt_2332(a: Anspruch, e: Erbfall) kind derived {
    label de official "Die Verjährung wird nicht dadurch gehemmt, dass der Anspruch erst nach Ausschlagung geltend gemacht werden kann (§ 2332 Abs. 2)";
    label en unofficial "limitation is not suspended merely because the claim becomes assertable only after disclaimer (§ 2332 (2))";
}
pub relation entziehungsberechtigter_verzeiht_2337(e: Erbfall, p: Person) kind empirical {
    label de official "Der Erblasser hat dem Pflichtteilsberechtigten den Entziehungsgrund verziehen (§ 2337)";
    label en unofficial "the decedent forgave the beneficiary the ground for withdrawal (§ 2337)";
}
pub relation recht_zur_entziehung_erloschen_2337(e: Erbfall, p: Person) kind derived {
    label de official "Das Recht zur Entziehung des Pflichtteils ist durch Verzeihung erloschen (§ 2337 Satz 1)";
    label en unofficial "the right to withdraw the compulsory portion has lapsed through forgiveness (§ 2337 sentence 1)";
}
pub relation entziehungsverfuegung_unwirksam_durch_verzeihung_2337(e: Erbfall, p: Person) kind derived {
    label de official "Eine angeordnete Pflichtteilsentziehung ist durch Verzeihung unwirksam (§ 2337 Satz 2)";
    label en unofficial "a disposition ordering withdrawal is ineffective through forgiveness (§ 2337 sentence 2)";
}
pub relation abkoemmling_verschwendung_gefaehrdet_erwerb_2338(e: Erbfall, p: Person) kind empirical {
    label de official "Der Abkömmling hat sich in einem seinen späteren Erwerb erheblich gefährdenden Maß der Verschwendung ergeben (§ 2338 Abs. 1)";
    label en unofficial "the descendant has engaged in wastefulness materially endangering future acquisition (§ 2338 (1))";
}
pub relation abkoemmling_ueberschuldung_gefaehrdet_erwerb_2338(e: Erbfall, p: Person) kind empirical {
    label de official "Der Abkömmling ist in einem seinen späteren Erwerb erheblich gefährdenden Maß überschuldet (§ 2338 Abs. 1)";
    label en unofficial "the descendant is overindebted to a degree materially endangering future acquisition (§ 2338 (1))";
}
pub relation pflichtteilsbeschraenkung_angeordnet_2338(e: Erbfall, p: Person) kind empirical {
    label de official "Der Erblasser hat die Pflichtteilsbeschränkung durch Verfügung angeordnet (§ 2338 Abs. 1)";
    label en unofficial "the decedent ordered a restriction of the compulsory portion by disposition (§ 2338 (1))";
}
pub relation pflichtteilsbeschraenkung_zulaessig_2338(e: Erbfall, p: Person) kind derived {
    label de official "Der Erblasser kann das Pflichtteilsrecht des gefährdeten Abkömmlings durch die in § 2338 vorgesehene Anordnung beschränken (§ 2338 Abs. 1)";
    label en unofficial "the decedent may restrict the endangered descendant's compulsory-portion right by the arrangement in § 2338 (§ 2338 (1))";
}
pub relation verwaltung_testamentsvollstrecker_lebenszeit_2338(e: Erbfall, p: Person) kind empirical {
    label de official "Für die Lebenszeit des Abkömmlings ist die Verwaltung einem Testamentsvollstrecker übertragen (§ 2338 Abs. 1 Satz 2)";
    label en unofficial "administration is transferred to an executor for the descendant's lifetime (§ 2338 (1) sentence 2)";
}
pub relation abkoemmling_anspruch_jaehrlicher_reinertrag_2338(e: Erbfall, p: Person) kind derived {
    label de official "Der Abkömmling hat bei lebenszeitlicher Testamentsvollstreckung Anspruch auf den jährlichen Reinertrag (§ 2338 Abs. 1 Satz 2)";
    label en unofficial "with lifetime executorship, the descendant has a claim to annual net proceeds (§ 2338 (1) sentence 2)";
}
pub relation abkoemmling_dauerhaft_verschwendung_abgewendet_2338(e: Erbfall, p: Person) kind empirical {
    label de official "Der Abkömmling hat sich zur Zeit des Erbfalls dauerhaft vom verschwenderischen Leben abgewendet (§ 2338 Abs. 2 Satz 2)";
    label en unofficial "at the devolution, the descendant has permanently abandoned the wasteful life (§ 2338 (2) sentence 2)";
}
pub relation ueberschuldungsgrund_entfallen_2338(e: Erbfall, p: Person) kind empirical {
    label de official "Die den Grund der Anordnung bildende Überschuldung besteht zur Zeit des Erbfalls nicht mehr (§ 2338 Abs. 2 Satz 2)";
    label en unofficial "at the devolution, the overindebtedness forming the ground of the arrangement no longer exists (§ 2338 (2) sentence 2)";
}
pub relation pflichtteilsbeschraenkung_unwirksam_2338(e: Erbfall, p: Person) kind derived {
    label de official "Die Pflichtteilsbeschränkung ist wegen dauerhafter Abwendung oder Wegfalls der Überschuldung unwirksam (§ 2338 Abs. 2 Satz 2)";
    label en unofficial "the restriction is ineffective due to permanent abandonment or cessation of overindebtedness (§ 2338 (2) sentence 2)";
}
pub relation entfernter_pflichtteilsberechtigter_2309(e: Erbfall, p: Person) kind empirical {
    label de official "Die Person ist ein entfernterer Abkömmling oder ein Elternteil des Erblassers (§ 2309)";
    label en unofficial "the person is a more remote descendant or a parent of the decedent (§ 2309)";
}
pub relation naeherer_pflichtteilsberechtigter_verlangt(e: Erbfall, p: Person) kind empirical {
    label de official "Ein näherer Abkömmling, der den entfernten Abkömmling oder Elternteil bei gesetzlicher Erbfolge ausschließen würde, kann den Pflichtteil verlangen (§ 2309)";
    label en unofficial "a closer descendant who would exclude the remote descendant or parent in intestacy may claim the compulsory portion (§ 2309)";
}
pub relation naeherer_pflichtteilsberechtigter_nimmt_an(e: Erbfall, p: Person) kind empirical {
    label de official "Ein näherer Abkömmling, der den entfernten Abkömmling oder Elternteil bei gesetzlicher Erbfolge ausschließen würde, nimmt das ihm Hinterlassene an (§ 2309)";
    label en unofficial "a closer descendant who would exclude the remote descendant or parent in intestacy accepts what was left to them (§ 2309)";
}
pub relation pflichtteilsrecht_2309_ausgeschlossen(e: Erbfall, p: Person) kind derived {
    label de official "Das Pflichtteilsrecht des entfernteren Abkömmlings oder Elternteils ist insoweit ausgeschlossen (§ 2309)";
    label en unofficial "the compulsory-portion right of the more remote descendant or parent is excluded to that extent (§ 2309)";
}
pub relation erbe_verlangt_stundung_2331a(e: Erbfall, erbe: Person) kind empirical {
    label de official "Der Erbe verlangt Stundung des Pflichtteils (§ 2331a Abs. 1)";
    label en unofficial "the heir requests deferral of the compulsory portion (§ 2331a (1))";
}
@source(BGB_P2313) {
    rule AufschiebendBedingtesRechtBleibtAusserAnsatz(e: Erbfall, position: Nachlassposition) strict {
        label de official "Ein Recht, das von einer aufschiebenden Bedingung abhängig ist, bleibt bei der Feststellung des Nachlasswerts außer Ansatz (§ 2313 Abs. 1 Satz 1)";
        label en unofficial "A right depending on a suspensive condition is excluded when determining estate value (§ 2313 (1) sentence 1)";
        when aufschiebend_bedingtes_recht_2313(e, position);
        then nachlassposition_ausser_ansatz_2313(e, position);
    }
    rule AufschiebendBedingteVerbindlichkeitBleibtAusserAnsatz(e: Erbfall, position: Nachlassposition) strict {
        label de official "Eine Verbindlichkeit, die von einer aufschiebenden Bedingung abhängig ist, bleibt bei der Feststellung des Nachlasswerts außer Ansatz (§ 2313 Abs. 1 Satz 1)";
        label en unofficial "A liability depending on a suspensive condition is excluded when determining estate value (§ 2313 (1) sentence 1)";
        when aufschiebend_bedingte_verbindlichkeit_2313(e, position);
        then nachlassposition_ausser_ansatz_2313(e, position);
    }
    rule AufloesendBedingtesRechtAlsUnbedingt(e: Erbfall, position: Nachlassposition) strict {
        label de official "Ein Recht, das von einer auflösenden Bedingung abhängig ist, kommt als unbedingtes in Ansatz (§ 2313 Abs. 1 Satz 2)";
        label en unofficial "A right depending on a resolutory condition is taken into account as unconditional (§ 2313 (1) sentence 2)";
        when aufloesend_bedingtes_recht_2313(e, position);
        then nachlassposition_als_unbedingt_anzusetzen_2313(e, position);
    }
    rule AufloesendBedingteVerbindlichkeitAlsUnbedingt(e: Erbfall, position: Nachlassposition) strict {
        label de official "Eine Verbindlichkeit, die von einer auflösenden Bedingung abhängig ist, kommt als unbedingte in Ansatz (§ 2313 Abs. 1 Satz 2)";
        label en unofficial "A liability depending on a resolutory condition is taken into account as unconditional (§ 2313 (1) sentence 2)";
        when aufloesend_bedingte_verbindlichkeit_2313(e, position);
        then nachlassposition_als_unbedingt_anzusetzen_2313(e, position);
    }
    rule UngewissesRechtBleibtAusserAnsatz(e: Erbfall, position: Nachlassposition) strict {
        label de official "Für ein ungewisses Recht gilt bei der Feststellung des Nachlasswerts dasselbe wie für ein aufschiebend bedingtes Recht (§ 2313 Abs. 2 Satz 1)";
        label en unofficial "An uncertain right is treated like a right under a suspensive condition (§ 2313 (2) sentence 1)";
        when ungewisses_recht_2313(e, position);
        then nachlassposition_ausser_ansatz_2313(e, position);
    }
    rule UnsicheresRechtBleibtAusserAnsatz(e: Erbfall, position: Nachlassposition) strict {
        label de official "Für ein unsicheres Recht gilt bei der Feststellung des Nachlasswerts dasselbe wie für ein aufschiebend bedingtes Recht (§ 2313 Abs. 2 Satz 1)";
        label en unofficial "An insecure right is treated like a right under a suspensive condition (§ 2313 (2) sentence 1)";
        when unsicheres_recht_2313(e, position);
        then nachlassposition_ausser_ansatz_2313(e, position);
    }
    rule ZweifelhafteVerbindlichkeitBleibtAusserAnsatz(e: Erbfall, position: Nachlassposition) strict {
        label de official "Für eine zweifelhafte Verbindlichkeit gilt bei der Feststellung des Nachlasswerts dasselbe wie für eine aufschiebend bedingte Verbindlichkeit (§ 2313 Abs. 2 Satz 1)";
        label en unofficial "A doubtful liability is treated like a liability under a suspensive condition (§ 2313 (2) sentence 1)";
        when zweifelhafte_verbindlichkeit_2313(e, position);
        then nachlassposition_ausser_ansatz_2313(e, position);
    }
    rule AusgleichungNachEintrittAufschiebendeBedingung(e: Erbfall, position: Nachlassposition) strict {
        label de official "Tritt eine aufschiebende Bedingung ein, ist die der veränderten Rechtslage entsprechende Ausgleichung vorzunehmen (§ 2313 Abs. 1 Satz 3)";
        label en unofficial "When a suspensive condition occurs, adjustment matching the changed legal situation is required (§ 2313 (1) sentence 3)";
        when bedingung_eingetreten_2313(e, position) and nachlassposition_ausser_ansatz_2313(e, position);
        then ausgleichung_nach_veraenderter_rechtslage_2313_erforderlich(e, position);
    }
    rule AusgleichungNachEintrittAufloesendeBedingung(e: Erbfall, position: Nachlassposition) strict {
        label de official "Tritt eine auflösende Bedingung ein, ist die der veränderten Rechtslage entsprechende Ausgleichung vorzunehmen (§ 2313 Abs. 1 Satz 3)";
        label en unofficial "When a resolutory condition occurs, adjustment matching the changed legal situation is required (§ 2313 (1) sentence 3)";
        when bedingung_eingetreten_2313(e, position) and nachlassposition_als_unbedingt_anzusetzen_2313(e, position);
        then ausgleichung_nach_veraenderter_rechtslage_2313_erforderlich(e, position);
    }
    rule FeststellungUngewissenRechts(e: Erbfall, erbe: Person, position: Nachlassposition) strict {
        label de official "Der Erbe ist dem Pflichtteilsberechtigten gegenüber zur Feststellung eines ungewissen Rechts verpflichtet, soweit dies ordnungsmäßiger Verwaltung entspricht (§ 2313 Abs. 2 Satz 2)";
        label en unofficial "The heir must determine an uncertain right for the beneficiary where proper administration requires it (§ 2313 (2) sentence 2)";
        when ungewisses_recht_2313(e, position) and ordnungsmaessige_verwaltung_erfordert_feststellung_2313(e, erbe, position);
        then erbe_muss_ungewisses_recht_feststellen_2313(e, erbe, position);
    }
    rule VerfolgungUnsicherenRechts(e: Erbfall, erbe: Person, position: Nachlassposition) strict {
        label de official "Der Erbe ist dem Pflichtteilsberechtigten gegenüber zur Verfolgung eines unsicheren Rechts verpflichtet, soweit dies ordnungsmäßiger Verwaltung entspricht (§ 2313 Abs. 2 Satz 2)";
        label en unofficial "The heir must pursue an insecure right for the beneficiary where proper administration requires it (§ 2313 (2) sentence 2)";
        when unsicheres_recht_2313(e, position) and ordnungsmaessige_verwaltung_erfordert_verfolgung_2313(e, erbe, position);
        then erbe_muss_unsicheres_recht_verfolgen_2313(e, erbe, position);
    }
}

@source(BGB_P2314) {
    rule NachlassauskunftAufVerlangen(e: Erbfall, p: Person, erbe: Person) strict {
        label de official "Ist der Pflichtteilsberechtigte nicht Erbe, hat ihm der Erbe auf Verlangen Auskunft über den Bestand des Nachlasses zu erteilen (§ 2314 Abs. 1 Satz 1)";
        label en unofficial "If the beneficiary is not an heir, the heir must upon demand provide information on the estate (§ 2314 (1) sentence 1)";
        when pflichtteilsberechtigter_nicht_erbe_2314(e, p) and nachlassauskunft_verlangt_2314(e, p, erbe);
        then erbe_muss_nachlassauskunft_erteilen_2314(e, erbe, p);
    }
    rule BeiziehungZumVerzeichnis(e: Erbfall, p: Person) strict {
        label de official "Der Pflichtteilsberechtigte kann verlangen, bei der Aufnahme des Nachlassverzeichnisses zugezogen zu werden (§ 2314 Abs. 1 Satz 2)";
        label en unofficial "The beneficiary may demand attendance at preparation of the estate inventory (§ 2314 (1) sentence 2)";
        when pflichtteilsberechtigter_nicht_erbe_2314(e, p) and beiziehung_zum_verzeichnis_verlangt_2314(e, p);
        then beiziehung_zum_verzeichnis_verlangbar_2314(e, p);
    }
    rule WertermittlungDerNachlassgegenstaende(e: Erbfall, p: Person) strict {
        label de official "Der Pflichtteilsberechtigte kann die Wertermittlung der Nachlassgegenstände verlangen (§ 2314 Abs. 1 Satz 2)";
        label en unofficial "The beneficiary may demand valuation of the estate assets (§ 2314 (1) sentence 2)";
        when pflichtteilsberechtigter_nicht_erbe_2314(e, p) and wertermittlung_nachlassgegenstaende_verlangt_2314(e, p);
        then wertermittlung_nachlassgegenstaende_verlangbar_2314(e, p);
    }
    rule AmtlichesOderNotariellesVerzeichnis(e: Erbfall, p: Person) strict {
        label de official "Der Pflichtteilsberechtigte kann verlangen, dass das Verzeichnis durch Behörde, Beamten oder Notar aufgenommen wird (§ 2314 Abs. 1 Satz 3)";
        label en unofficial "The beneficiary may demand an inventory prepared by the authority, official, or notary (§ 2314 (1) sentence 3)";
        when pflichtteilsberechtigter_nicht_erbe_2314(e, p) and amtliches_oder_notarielles_verzeichnis_verlangt_2314(e, p);
        then amtliches_oder_notarielles_verzeichnis_verlangbar_2314(e, p);
    }
    rule KostenDerNachlassauskunft(e: Erbfall) strict {
        label de official "Die Kosten der Auskunft und der Aufnahme des Verzeichnisses fallen dem Nachlass zur Last (§ 2314 Abs. 2)";
        label en unofficial "The estate bears the costs of information and preparation of the inventory (§ 2314 (2))";
        when kosten_nachlassauskunft_2314_entstanden(e);
        then kosten_nachlassauskunft_traegt_nachlass_2314(e);
    }
}

@source(BGB_P2315) {
    rule AnrechnungDerZuwendung(e: Erbfall, p: Person, z: Pflichtteilszuwendung, wert: Money) strict {
        label de official "Der Pflichtteilsberechtigte muss sich eine ihm durch Rechtsgeschäft unter Lebenden mit Anrechnungsbestimmung zugewendete Leistung auf den Pflichtteil anrechnen lassen; maßgeblich ist ihr Wert zur Zeit der Zuwendung (§ 2315 Abs. 1, Abs. 2 Satz 2)";
        label en unofficial "The beneficiary must credit an inter vivos grant made with a crediting specification against the compulsory portion, at its value when made (§ 2315 (1), (2) sentence 2)";
        when zuwendung_unter_leben_2315(e, p, z) and anrechnung_auf_pflichtteil_bestimmt_2315(z) and wert_zuwendung_zeit_leistung_2315(z, wert);
        then zuwendung_auf_pflichtteil_anzurechnen_2315(e, p, z, wert);
    }
    rule NachlasswertMitAnzurechnendenZuwendungen(e: Erbfall, p: Person, z: Pflichtteilszuwendung, nachlass: Money, wert: Money) strict {
        label de official "Bei der Bestimmung des Pflichtteils wird der Wert der anzurechnenden Zuwendung dem Nachlass hinzugerechnet (§ 2315 Abs. 2 Satz 1)";
        label en unofficial "When determining the compulsory portion, the value of the creditable grant is added to the estate (§ 2315 (2) sentence 1)";
        when nachlasswert(e, nachlass) and zuwendung_auf_pflichtteil_anzurechnen_2315(e, p, z, wert);
        then nachlasswert_mit_zuwendungen_2315(e, p, nachlass + (sum all w: Money for x: Pflichtteilszuwendung where zuwendung_auf_pflichtteil_anzurechnen_2315(e, p, x, w)));
    }
    rule PflichtteilVorAnrechnung(e: Erbfall, p: Person, z: Pflichtteilszuwendung, n: Money, zaehler: Integer, nenner: Integer) strict {
        label de official "Aus dem um die anzurechnenden Zuwendungen erhöhten Nachlasswert wird zunächst der Pflichtteil nach seiner Quote bestimmt (§ 2303 Abs. 1 Satz 2, § 2315 Abs. 2 Satz 1)";
        label en unofficial "The compulsory portion is first calculated at its quota from estate value increased by creditable grants (§ 2303 (1) sentence 2, § 2315 (2) sentence 1)";
        when nachlasswert_mit_zuwendungen_2315(e, p, n) and pflichtteilsquote_bruch(e, p, zaehler, nenner) and zuwendung_auf_pflichtteil_anzurechnen_2315(e, p, z, _);
        then pflichtteil_vor_anrechnung_2315(e, p, div_round(n * zaehler, nenner * 1.0, 2, "HALF_UP"));
    }
    rule PflichtteilNachAnrechnungPositiv(e: Erbfall, p: Person, z: Pflichtteilszuwendung, brutto: Money, wert: Money) strict {
        label de official "Die mit Anrechnungsbestimmung zugewendeten Werte werden auf den so bestimmten Pflichtteil angerechnet; soweit ein positiver Rest verbleibt, besteht er als Geldanspruch fort (§ 2315 Abs. 1, 2)";
        label en unofficial "The values granted with a crediting specification are credited against the determined compulsory portion; any positive remainder remains a monetary claim (§ 2315 (1), (2))";
        when pflichtteil_vor_anrechnung_2315(e, p, brutto) and zuwendung_auf_pflichtteil_anzurechnen_2315(e, p, z, wert) and brutto >= (sum all w: Money for x: Pflichtteilszuwendung where zuwendung_auf_pflichtteil_anzurechnen_2315(e, p, x, w));
        then pflichtteil_nach_anrechnung_2315(e, p, brutto - (sum all w: Money for x: Pflichtteilszuwendung where zuwendung_auf_pflichtteil_anzurechnen_2315(e, p, x, w)));
    }
    rule PflichtteilNachAnrechnungNull(e: Erbfall, p: Person, z: Pflichtteilszuwendung, brutto: Money, wert: Money) strict {
        label de official "Übersteigen die anzurechnenden Zuwendungen den so bestimmten Pflichtteil, verbleibt kein Zahlungsanspruch; § 2315 begründet keinen Rückzahlungsanspruch (§ 2315 Abs. 1, 2)";
        label en unofficial "If creditable grants exceed the determined compulsory portion, no payment claim remains; § 2315 creates no repayment claim (§ 2315 (1), (2))";
        when pflichtteil_vor_anrechnung_2315(e, p, brutto) and zuwendung_auf_pflichtteil_anzurechnen_2315(e, p, z, wert) and brutto < (sum all w: Money for x: Pflichtteilszuwendung where zuwendung_auf_pflichtteil_anzurechnen_2315(e, p, x, w));
        then pflichtteil_nach_anrechnung_2315(e, p, 0.00 EUR);
    }
}

@source(BGB_P2316) {
    rule PflichtteilNachAusgleichung(e: Erbfall, p: Person, wert: Money) strict {
        label de official "Bei mehreren Abkömmlingen mit ausgleichungspflichtiger Zuwendung oder Leistung bestimmt sich der Pflichtteil nach der Hälfte dessen, was auf den gesetzlichen Erbteil unter Berücksichtigung der Ausgleichung entfiele (§ 2316 Abs. 1 Satz 1)";
        label en unofficial "With multiple descendants and a grant or service subject to equalisation, the compulsory portion is half of what would fall to the statutory share after equalisation (§ 2316 (1) sentence 1)";
        when abkoemmling_mehrere_2316(e, p) and ausgleichung_bei_teilung_2316_zu_beruecksichtigen(e, p) and gesetzlicher_erbteilwert_nach_ausgleichung_2316(e, p, wert);
        then pflichtteil_nach_ausgleichung_2316(e, p, div_round(wert, 2.0, 2, "HALF_UP"));
    }
    rule ErbverzichtBleibtAusserBetracht(e: Erbfall, p: Person) strict {
        label de official "Ein Abkömmling, der durch Erbverzicht von der gesetzlichen Erbfolge ausgeschlossen ist, bleibt bei der Berechnung außer Betracht (§ 2316 Abs. 1 Satz 2)";
        label en unofficial "A descendant excluded from intestacy by succession renunciation is excluded from the calculation (§ 2316 (1) sentence 2)";
        when abkoemmling_durch_erbverzicht_ausgeschlossen_2316(e, p);
        then abkoemmling_bei_ausgleichungsberechnung_ausser_betracht_2316(e, p);
    }
    rule MehrbetragDesPflichtteilsberechtigtenErben(e: Erbfall, p: Person, pflichtteilbetrag: Money, erbteil: Money) strict {
        label de official "Ist der Pflichtteilsberechtigte Erbe und übersteigt sein Pflichtteil nach Absatz 1 den Wert des hinterlassenen Erbteils, kann er von den Miterben den Mehrbetrag als Pflichtteil verlangen (§ 2316 Abs. 2)";
        label en unofficial "If the beneficiary is an heir and the portion under subsection (1) exceeds the share left, he may demand the excess from co-heirs (§ 2316 (2))";
        when pflichtteilsberechtigter_ist_erbe_2316(e, p) and pflichtteil_nach_ausgleichung_2316(e, p, pflichtteilbetrag) and hinterlassener_erbteil_wert_2316(e, p, erbteil) and pflichtteilbetrag > erbteil;
        then mehrbetrag_als_pflichtteil_verlangbar_2316(e, p, pflichtteilbetrag - erbteil);
    }
    rule AusschlussDerBeruecksichtigungUnwirksam(e: Erbfall, p: Person, z: Pflichtteilszuwendung) strict {
        label de official "Eine Zuwendung der in § 2050 Abs. 1 bezeichneten Art kann nicht zum Nachteil eines Pflichtteilsberechtigten von der Berücksichtigung ausgeschlossen werden (§ 2316 Abs. 3)";
        label en unofficial "A grant of the § 2050 (1) kind cannot be excluded from account to the beneficiary's detriment (§ 2316 (3))";
        when zuwendung_2050_abs1_2316(e, p, z) and beruecksichtigung_ausgeschlossen_2316(z);
        then beruecksichtigungsausschluss_unwirksam_gegen_pflichtteilsberechtigten_2316(e, p, z);
    }
    rule DoppeltBeruecksichtigteZuwendung(e: Erbfall, p: Person, z: Pflichtteilszuwendung, wert: Money) strict {
        label de official "Eine nach Absatz 1 zu berücksichtigende Zuwendung, die zugleich nach § 2315 anzurechnen ist, fällt unter § 2316 Abs. 4";
        label en unofficial "A grant taken into account under subsection (1) and also creditable under § 2315 falls under § 2316 (4)";
        when zuwendung_2050_abs1_2316(e, p, z) and zuwendung_auf_pflichtteil_anzurechnen_2315(e, p, z, wert);
        then zuwendung_nach_abs1_und_2315_anzurechnen_2316(e, p, z, wert);
    }
    rule HalberAnrechnungswert(e: Erbfall, p: Person, z: Pflichtteilszuwendung, wert: Money) strict {
        label de official "Die zugleich nach § 2315 anzurechnende, nach Absatz 1 zu berücksichtigende Zuwendung kommt auf den Pflichtteil nur mit der Hälfte ihres Wertes zur Anrechnung (§ 2316 Abs. 4)";
        label en unofficial "A grant taken into account under subsection (1) and credited under § 2315 is credited to the portion at only half its value (§ 2316 (4))";
        when zuwendung_nach_abs1_und_2315_anzurechnen_2316(e, p, z, wert);
        then anrechnungswert_haelfte_2316(e, p, z, div_round(wert, 2.0, 2, "HALF_UP"));
    }
}

@source(BGB_P2318) {
    rule VerhaeltnismaessigePflichtteilslastBeiVermaechtnis(e: Erbfall, erbe: Person, last: Pflichtteilslast) strict {
        label de official "Der Erbe kann die Erfüllung eines ihm auferlegten Vermächtnisses soweit verweigern, dass Erbe und Vermächtnisnehmer die Pflichtteilslast verhältnismäßig tragen (§ 2318 Abs. 1)";
        label en unofficial "The heir may refuse performance of an imposed legacy to ensure proportional bearing of the compulsory-portion burden by heir and legatee (§ 2318 (1))";
        when erbe_mit_vermaechtnis_beschwert_2318(e, erbe, last);
        then pflichtteilslast_verhaeltnismaessig_zu_tragen_2318(e, erbe, last);
    }
    rule VerhaeltnismaessigePflichtteilslastBeiAuflage(e: Erbfall, erbe: Person, last: Pflichtteilslast) strict {
        label de official "Für eine dem Erben auferlegte Auflage gilt dieselbe verhältnismäßige Pflichtteilslast (§ 2318 Abs. 1 Satz 2)";
        label en unofficial "The same proportional compulsory-portion burden applies to a charge imposed on the heir (§ 2318 (1) sentence 2)";
        when erbe_mit_auflage_beschwert_2318(e, erbe, last);
        then pflichtteilslast_verhaeltnismaessig_zu_tragen_2318(e, erbe, last);
    }
    rule SchutzDesPflichtteilsberechtigtenVermaechtnisnehmers(e: Erbfall, p: Person, last: Pflichtteilslast) strict {
        label de official "Gegenüber einem pflichtteilsberechtigten Vermächtnisnehmer ist die Kürzung nur zulässig, soweit ihm der Pflichtteil verbleibt (§ 2318 Abs. 2)";
        label en unofficial "A reduction against a beneficiary legatee is permitted only insofar as his compulsory portion remains (§ 2318 (2))";
        when vermaechtnisnehmer_pflichtteilsberechtigt_2318(e, p, last) and kuerzung_laesst_pflichtteil_vermaechtnisnehmer_2318(e, p, last);
        then kuerzung_gegen_pflichtteilsberechtigten_vermaechtnisnehmer_zulaessig_2318(e, p, last);
    }
    rule SchutzDesEigenenPflichtteilsDesErben(e: Erbfall, erbe: Person, last: Pflichtteilslast) strict {
        label de official "Der selbst pflichtteilsberechtigte Erbe kann Vermächtnis und Auflage wegen der Pflichtteilslast soweit kürzen, dass ihm sein eigener Pflichtteil verbleibt (§ 2318 Abs. 3)";
        label en unofficial "The beneficiary heir may reduce legacy and charge because of the burden so that his own compulsory portion remains (§ 2318 (3))";
        when erbe_selbst_pflichtteilsberechtigt_2318(e, erbe, last) and kuerzung_laesst_eigenen_pflichtteil_2318(e, erbe, last);
        then kuerzung_zur_wahrung_eigenen_pflichtteils_zulaessig_2318(e, erbe, last);
    }
}
@source(BGB_P2319) {
    rule PflichtteilsberechtigterMiterbeDarfBefriedigungVerweigern(e: Erbfall, erbe: Person, last: Pflichtteilslast) strict {
        label de official "Ein pflichtteilsberechtigter Miterbe kann nach der Teilung die Befriedigung eines anderen Berechtigten soweit verweigern, dass ihm sein eigener Pflichtteil verbleibt (§ 2319 Satz 1)";
        label en unofficial "After partition, a beneficiary co-heir may refuse satisfaction of another beneficiary so that his own portion remains (§ 2319 sentence 1)";
        when miterbe_selbst_pflichtteilsberechtigt_2319(e, erbe, last) and teilung_erfolgt_2319(e, last);
        then befriedigung_anderer_berechtigter_soweit_verweigerbar_2319(e, erbe, last);
    }
    rule UebrigeMiterbenHaftenFuerAusfall(e: Erbfall, erbe: Person, last: Pflichtteilslast) strict {
        label de official "Für den Ausfall infolge der zulässigen Verweigerung haften die übrigen Erben (§ 2319 Satz 2)";
        label en unofficial "The remaining heirs are liable for the shortfall caused by the permitted refusal (§ 2319 sentence 2)";
        when befriedigung_anderer_berechtigter_soweit_verweigerbar_2319(e, erbe, last);
        then uebrige_miterben_haften_fuer_ausfall_2319(e, last);
    }
}
@source(BGB_P2320) {
    rule GesetzlicherNachrueckerTraegtLast(e: Erbfall, erbe: Person, last: Pflichtteilslast, vorteil: Money) strict {
        label de official "Wer anstelle des Pflichtteilsberechtigten gesetzlicher Erbe wird, trägt im Verhältnis zu Miterben die Pflichtteilslast bis zur Höhe des erlangten Vorteils (§ 2320 Abs. 1)";
        label en unofficial "A statutory heir stepping in for the beneficiary bears the burden vis-à-vis co-heirs up to the advantage gained (§ 2320 (1))";
        when anstelle_pflichtteilsberechtigten_gesetzlicher_erbe_2320(e, erbe, last) and erlangter_vorteil_2320(e, erbe, last, vorteil);
        then pflichtteilslast_bis_vorteil_zu_tragen_2320(e, erbe, last, vorteil);
    }
    presumption VerfuegungsnachrueckerTraegtLast(e: Erbfall, erbe: Person, last: Pflichtteilslast) {
        label de official "Im Zweifel gilt dasselbe für denjenigen, dem der Erblasser den Erbteil des Pflichtteilsberechtigten durch Verfügung von Todes wegen zugewendet hat (§ 2320 Abs. 2)";
        label en unofficial "In case of doubt, the same applies to a person granted the beneficiary's share by testamentary disposition (§ 2320 (2))";
        when erbteil_pflichtteilsberechtigten_durch_verfuegung_zugewendet_2320(e, erbe, last);
        presume verfuegungsnachruecker_traegt_last_vermutet_2320(e, erbe, last);
        unless abweichender_wille_2320(e, erbe, last);
    }
}
@source(BGB_P2321)
rule AusschlagungsbeguenstigterTraegtLast(e: Erbfall, p: Person, last: Pflichtteilslast, vorteil: Money) strict {
    label de official "Schlägt der Pflichtteilsberechtigte sein Vermächtnis aus, trägt der dadurch Begünstigte im Verhältnis zu Erben und Vermächtnisnehmern die Pflichtteilslast bis zur Höhe des Vorteils (§ 2321)";
    label en unofficial "Where the beneficiary disclaims his legacy, the person benefiting bears the burden vis-à-vis heirs and legatees up to the advantage (§ 2321)";
    when pflichtteilsberechtigter_schlaegt_vermaechtnis_aus_2321(e, last) and ausschlagung_kommt_zugute_2321(e, p, last, vorteil);
    then pflichtteilslast_bis_vorteil_zu_tragen_2321(e, p, last, vorteil);
}
@source(BGB_P2322)
rule KuerzungNachAusschlagung(e: Erbfall, p: Person, last: Pflichtteilslast) strict {
    label de official "Ist die ausgeschlagene Erbschaft oder das ausgeschlagene Vermächtnis mit Vermächtnis oder Auflage beschwert, kann der Begünstigte soweit kürzen, dass der zur Deckung der Pflichtteilslast erforderliche Betrag verbleibt (§ 2322)";
    label en unofficial "If the disclaimed inheritance or legacy is encumbered, the beneficiary may reduce it so the amount needed to cover the burden remains (§ 2322)";
    when ausgeschlagene_erbschaft_oder_vermaechtnis_beschwert_2322(e, p, last) and betrag_zur_deckung_pflichtteilslast_verbleibt_2322(e, p, last);
    then vermaechtnis_oder_auflage_kuerzbar_2322(e, p, last);
}
@source(BGB_P2323)
rule NichtBelasteterErbeKannNichtVerweigern(e: Erbfall, erbe: Person, last: Pflichtteilslast) strict {
    label de official "Der Erbe kann die Erfüllung eines Vermächtnisses oder einer Auflage aufgrund § 2318 Abs. 1 nicht verweigern, soweit er die Pflichtteilslast nach §§ 2320 bis 2322 nicht trägt (§ 2323)";
    label en unofficial "The heir may not refuse performance of legacy or charge under § 2318 (1) insofar as he does not bear the burden under §§ 2320 to 2322 (§ 2323)";
    when erbe_traegt_pflichtteilslast_nicht_2323(e, erbe, last);
    then erfuellung_nicht_wegen_2318_verweigerbar_2323(e, erbe, last);
}
@source(BGB_P2324)
rule AbweichendeAnordnungDerPflichtteilslast(e: Erbfall, erbe: Person, last: Pflichtteilslast) strict {
    label de official "Der Erblasser kann durch Verfügung von Todes wegen einzelnen Erben die Pflichtteilslast auferlegen und abweichende Anordnungen treffen (§ 2324)";
    label en unofficial "The decedent may by mortis-causa disposition impose the burden on individual heirs and make divergent orders (§ 2324)";
    when abweichende_anordnung_pflichtteilslast_2324(e, erbe, last);
    then abweichende_anordnung_pflichtteilslast_zulaessig_2324(e, erbe, last);
}
@source(BGB_P2326) {
    rule ErgaenzungTrotzHaelfte(e: Erbfall, p: Person) strict {
        label de official "Der Pflichtteilsberechtigte kann die Ergänzung des Pflichtteils auch dann verlangen, wenn ihm die Hälfte des gesetzlichen Erbteils hinterlassen ist (§ 2326 Satz 1)";
        label en unofficial "The beneficiary may claim the supplementary portion even if half the statutory share was left (§ 2326 sentence 1)";
        when pflichtteilsberechtigter_mit_erbteil_2326(e, p) and hinterlassener_erbteil_genau_haelfte_gesetzlich_2326(e, p);
        then pflichtteilsergaenzung_auch_bei_haelfte_verlangbar_2326(e, p);
    }
    rule ErgaenzungNurSoweitMehrwertNichtReicht(e: Erbfall, p: Person, ergaenzung: Money, mehrwert: Money) strict {
        label de official "Ist dem Pflichtteilsberechtigten mehr als die Hälfte hinterlassen, ist der Ergänzungsanspruch ausgeschlossen, soweit der Wert des Mehrhinterlassenen reicht (§ 2326 Satz 2)";
        label en unofficial "If more than half was left, the supplementary claim is excluded to the extent the excess value reaches (§ 2326 sentence 2)";
        when pflichtteilsberechtigter_mit_erbteil_2326(e, p) and hinterlassener_erbteil_mehr_als_haelfte_gesetzlich_2326(e, p, mehrwert) and pflichtteilsergaenzung(e, p, ergaenzung) and ergaenzung > mehrwert;
        then pflichtteilsergaenzung_soweit_mehrwert_nicht_ausgeschlossen_2326(e, p, ergaenzung - mehrwert);
    }
}
@source(BGB_P2327) {
    rule EigenesGeschenkWirdHinzugerechnetUndAngerechnet(e: Erbfall, p: Person, s: Schenkung) strict {
        label de official "Hat der Pflichtteilsberechtigte selbst ein Geschenk erhalten, wird es wie ein Drittschenkungs-Geschenk dem Nachlass hinzugerechnet und auf die Ergänzung angerechnet (§ 2327 Abs. 1 Satz 1)";
        label en unofficial "Where the beneficiary received a gift, it is added like a third-party gift and credited against the supplement (§ 2327 (1) sentence 1)";
        when pflichtteilsberechtigter_selbst_beschenkt_2327(e, p, s);
        then eigenes_geschenk_dem_nachlass_hinzuzurechnen_2327(e, p, s);
    }
    rule EigenesGeschenkAufErgaenzungAnrechnung(e: Erbfall, p: Person, s: Schenkung) strict {
        label de official "Das eigene Geschenk wird zugleich dem Pflichtteilsberechtigten auf die Ergänzung angerechnet (§ 2327 Abs. 1 Satz 1)";
        label en unofficial "The beneficiary's own gift is simultaneously credited against the supplement (§ 2327 (1) sentence 1)";
        when pflichtteilsberechtigter_selbst_beschenkt_2327(e, p, s);
        then eigenes_geschenk_auf_ergaenzung_anzurechnen_2327(e, p, s);
    }
    rule GeschenkNach2315AufGesamtbetrag(e: Erbfall, p: Person, s: Schenkung) strict {
        label de official "Ein nach § 2315 anzurechnendes Geschenk wird auf Gesamtbetrag von Pflichtteil und Ergänzung angerechnet (§ 2327 Abs. 1 Satz 2)";
        label en unofficial "A gift creditable under § 2315 is credited against the aggregate of portion and supplement (§ 2327 (1) sentence 2)";
        when pflichtteilsberechtigter_selbst_beschenkt_2327(e, p, s) and eigenes_geschenk_nach_2315_anzurechnen_2327(e, p, s);
        then eigenes_geschenk_2315_auf_gesamtbetrag_anzurechnen_2327(e, p, s);
    }
    rule NachfolgerregelFuerBeschenktenAbkoemmling(e: Erbfall, p: Person) strict {
        label de official "Ist der beschenkte Pflichtteilsberechtigte Abkömmling, findet § 2051 Abs. 1 entsprechende Anwendung (§ 2327 Abs. 2)";
        label en unofficial "If the beneficiary who received the gift is a descendant, § 2051 (1) applies mutatis mutandis (§ 2327 (2))";
        when pflichtteilsberechtigter_abkoemmling_2327(e, p);
        then ersatzabkoemmling_2051_auf_2327_anwendbar(e, p);
    }
}
@source(BGB_P2328)
rule SelbstPflichtteilsberechtigterErbeVerweigerung(e: Erbfall, erbe: Person) strict {
    label de official "Ist der Erbe selbst pflichtteilsberechtigt, kann er Ergänzung soweit verweigern, dass ihm eigener Pflichtteil einschließlich eigener Ergänzung verbleibt (§ 2328)";
    label en unofficial "If the heir is himself a beneficiary, he may refuse the supplement to preserve his own portion including his own supplement (§ 2328)";
    when erbe_selbst_pflichtteilsberechtigt_2328(e, erbe) and verweigerung_laesst_eigenen_pflichtteil_und_ergaenzung_2328(e, erbe);
    then erbe_kann_ergaenzung_soweit_verweigern_2328(e, erbe);
}
@source(BGB_P2330)
rule AnstandsschenkungVonErgaenzungAusgenommen(e: Erbfall, s: Schenkung) strict {
    label de official "Die Vorschriften der §§ 2325 bis 2329 finden keine Anwendung auf Schenkungen zur Erfüllung einer sittlichen Pflicht oder aus Anstandsrücksicht (§ 2330)";
    label en unofficial "§§ 2325 to 2329 do not apply to gifts fulfilling a moral duty or consideration of propriety (§ 2330)";
    when schenkung_sittliche_pflicht_oder_anstand_2330(e, s);
    then pflichtteilsergaenzungsregeln_nicht_anwendbar_2330(e, s);
}
@source(BGB_P2331) {
    rule GesamtgutzuwendungJeZurHaelfte(e: Erbfall, s: Schenkung, erster: Person, zweiter: Person) strict {
        label de official "Eine Zuwendung aus dem Gesamtgut der Gütergemeinschaft gilt als von jedem Ehegatten zur Hälfte gemacht (§ 2331 Abs. 1 Satz 1)";
        label en unofficial "A grant from joint property is deemed made by each spouse as to one half (§ 2331 (1) sentence 1)";
        when zuwendung_aus_gesamtgut_2331(e, s, erster, zweiter);
        then zuwendung_aus_gesamtgut_haelftig_gemacht_2331(e, s, erster);
    }
    rule GesamtgutzuwendungJeZurHaelfteZweiterEhegatte(e: Erbfall, s: Schenkung, erster: Person, zweiter: Person) strict {
        label de official "Eine Zuwendung aus dem Gesamtgut gilt auch vom anderen Ehegatten zur Hälfte gemacht (§ 2331 Abs. 1 Satz 1)";
        label en unofficial "A grant from joint property is also deemed made by the other spouse as to one half (§ 2331 (1) sentence 1)";
        when zuwendung_aus_gesamtgut_2331(e, s, erster, zweiter);
        then zuwendung_aus_gesamtgut_haelftig_gemacht_2331(e, s, zweiter);
    }
    rule AusnahmeAlleinigeZuwendungAusGesamtgut(e: Erbfall, s: Schenkung, erster: Person, zweiter: Person) strict {
        label de official "Ist der Beschenkte Abkömmling nur eines Ehegatten oder leistet ein Ehegatte Ersatz an das Gesamtgut, gilt die Zuwendung als von diesem Ehegatten gemacht (§ 2331 Abs. 1 Satz 2)";
        label en unofficial "If the recipient descends from only one spouse or a spouse compensates joint property, the grant is deemed made by that spouse (§ 2331 (1) sentence 2)";
        when zuwendung_aus_gesamtgut_2331(e, s, erster, zweiter) and beschenkter_nur_von_einem_ehegatten_abkoemmling_2331(e, s, erster);
        then zuwendung_als_von_einem_ehegatten_gemacht_2331(e, s, erster);
    }
    rule AusnahmeErsatzAnGesamtgut(e: Erbfall, s: Schenkung, erster: Person, zweiter: Person) strict {
        label de official "Leistet ein Ehegatte wegen der Zuwendung Ersatz an das Gesamtgut, gilt die Zuwendung als von diesem Ehegatten gemacht (§ 2331 Abs. 1 Satz 2)";
        label en unofficial "Where a spouse compensates the joint property because of the grant, it is deemed made by that spouse (§ 2331 (1) sentence 2)";
        when zuwendung_aus_gesamtgut_2331(e, s, erster, zweiter) and ehegatte_leistet_ersatz_an_gesamtgut_2331(e, s, erster);
        then zuwendung_als_von_einem_ehegatten_gemacht_2331(e, s, erster);
    }
    rule FortgesetztesGesamtgut(e: Erbfall, s: Schenkung) strict {
        label de official "Die Vorschriften über Zuwendungen aus Gesamtgut gelten für Zuwendungen aus dem Gesamtgut der fortgesetzten Gütergemeinschaft entsprechend (§ 2331 Abs. 2)";
        label en unofficial "The rules for grants from joint property apply mutatis mutandis to grants from continued joint property (§ 2331 (2))";
        when zuwendung_aus_fortgesetztem_gesamtgut_2331(e, s);
        then regeln_gesamtgutzuwendung_entsprechend_anwendbar_2331(e, s);
    }
}
@source(BGB_P2332) {
    rule BeginnVerjaehrungGegenBeschenktenMitErbfall(a: Anspruch, e: Erbfall, p: Person, tag: Date) strict {
        label de official "Die Verjährungsfrist des Pflichtteilsanspruchs gegen den Beschenkten nach § 2329 beginnt mit dem Erbfall (§ 2332 Abs. 1)";
        label en unofficial "The limitation period for the § 2329 claim against the donee begins with the devolution (§ 2332 (1))";
        when anspruch_gegen_beschenkten_2329(a, e, p) and de.bgb.erbfolge::erbfall_am(e, tag);
        then verjaehrungsbeginn_anspruch_2329_2332(a, tag);
    }
    rule AusschlagungHemmtNicht(a: Anspruch, e: Erbfall) strict {
        label de official "Die Verjährung des Pflichtteilsanspruchs und des Anspruchs nach § 2329 wird nicht dadurch gehemmt, dass sie erst nach Ausschlagung geltend gemacht werden können (§ 2332 Abs. 2)";
        label en unofficial "Limitation of the compulsory-portion and § 2329 claims is not suspended merely because they become assertable after disclaimer (§ 2332 (2))";
        when pflichtteil_oder_2329_nach_ausschlagung_geltendmachbar_2332(a, e);
        then verjaehrung_nicht_durch_ausschlagung_gehemmt_2332(a, e);
    }
}
@source(BGB_P2337)
rule VerzeihungLassenEntziehungsrechtErloschen(e: Erbfall, p: Person) strict {
    label de official "Das Recht zur Entziehung des Pflichtteils erlischt durch Verzeihung (§ 2337 Satz 1); eine angeordnete Entziehung wird dadurch unwirksam (Satz 2)";
    label en unofficial "The right to withdraw the compulsory portion lapses through forgiveness (§ 2337 sentence 1); an ordered withdrawal becomes ineffective (sentence 2)";
    when entziehungsberechtigter_verzeiht_2337(e, p);
    then recht_zur_entziehung_erloschen_2337(e, p);
}
@source(BGB_P2338) {
    rule BeschraenkungWegenVerschwendung(e: Erbfall, p: Person) strict {
        label de official "Bei erheblich gefährdender Verschwendung kann der Erblasser das Pflichtteilsrecht des Abkömmlings beschränken (§ 2338 Abs. 1)";
        label en unofficial "With materially endangering wastefulness, the decedent may restrict the descendant's compulsory portion (§ 2338 (1))";
        when abkoemmling_verschwendung_gefaehrdet_erwerb_2338(e, p) and pflichtteilsbeschraenkung_angeordnet_2338(e, p);
        then pflichtteilsbeschraenkung_zulaessig_2338(e, p);
    }
    rule BeschraenkungWegenUeberschuldung(e: Erbfall, p: Person) strict {
        label de official "Bei erheblich gefährdender Überschuldung kann der Erblasser das Pflichtteilsrecht des Abkömmlings beschränken (§ 2338 Abs. 1)";
        label en unofficial "With materially endangering overindebtedness, the decedent may restrict the descendant's compulsory portion (§ 2338 (1))";
        when abkoemmling_ueberschuldung_gefaehrdet_erwerb_2338(e, p) and pflichtteilsbeschraenkung_angeordnet_2338(e, p);
        then pflichtteilsbeschraenkung_zulaessig_2338(e, p);
    }
    rule JaerlicherReinertragBeiVerwaltung(e: Erbfall, p: Person) strict {
        label de official "Bei Übertragung der Verwaltung auf einen Testamentsvollstrecker für die Lebenszeit des Abkömmlings hat dieser Anspruch auf den jährlichen Reinertrag (§ 2338 Abs. 1 Satz 2)";
        label en unofficial "Where administration is assigned to an executor for the descendant's lifetime, he has a claim to annual net proceeds (§ 2338 (1) sentence 2)";
        when verwaltung_testamentsvollstrecker_lebenszeit_2338(e, p);
        then abkoemmling_anspruch_jaehrlicher_reinertrag_2338(e, p);
    }
    rule BeschraenkungUnwirksamNachAbwendung(e: Erbfall, p: Person) strict {
        label de official "Die Anordnung ist unwirksam, wenn der Abkömmling sich zur Zeit des Erbfalls dauerhaft vom verschwenderischen Leben abgewendet hat (§ 2338 Abs. 2 Satz 2)";
        label en unofficial "The arrangement is ineffective where at devolution the descendant permanently abandoned the wasteful life (§ 2338 (2) sentence 2)";
        when pflichtteilsbeschraenkung_angeordnet_2338(e, p) and abkoemmling_dauerhaft_verschwendung_abgewendet_2338(e, p);
        then pflichtteilsbeschraenkung_unwirksam_2338(e, p);
    }
    rule BeschraenkungUnwirksamNachWegfallUeberschuldung(e: Erbfall, p: Person) strict {
        label de official "Die Anordnung ist unwirksam, wenn die den Grund bildende Überschuldung zur Zeit des Erbfalls nicht mehr besteht (§ 2338 Abs. 2 Satz 2)";
        label en unofficial "The arrangement is ineffective where the overindebtedness forming its ground no longer exists at devolution (§ 2338 (2) sentence 2)";
        when pflichtteilsbeschraenkung_angeordnet_2338(e, p) and ueberschuldungsgrund_entfallen_2338(e, p);
        then pflichtteilsbeschraenkung_unwirksam_2338(e, p);
    }
}
@source(BGB_P2337)
rule VerzeihungMachtEntziehungsverfuegungUnwirksam(e: Erbfall, p: Person) strict {
    label de official "Eine Verfügung, durch die Pflichtteilsentziehung angeordnet ist, wird durch Verzeihung unwirksam (§ 2337 Satz 2)";
    label en unofficial "A disposition ordering withdrawal becomes ineffective through forgiveness (§ 2337 sentence 2)";
    when entziehungsberechtigter_verzeiht_2337(e, p) and entziehung_durch_verfuegung_2336(e, p);
    then entziehungsverfuegung_unwirksam_durch_verzeihung_2337(e, p);
}

@source(BGB_P2331a)
pub external judgment relation sofortige_erfuellung_unbillige_haerte_2331a(e: Erbfall, erbe: Person) {
    authority Court;
    label de official "Die sofortige Erfüllung des gesamten Pflichtteilsanspruchs wäre für den Erben wegen der Art der Nachlassgegenstände eine unbillige Härte (§ 2331a Abs. 1)";
    label en unofficial "immediate performance of the entire compulsory-portion claim would be an unreasonable hardship for the heir because of the nature of the estate assets (§ 2331a (1))";
}
pub relation stundung_des_pflichtteils_verlangbar(e: Erbfall, erbe: Person) kind derived {
    label de official "Der Erbe kann Stundung des Pflichtteils verlangen (§ 2331a Abs. 1)";
    label en unofficial "the heir may request deferral of the compulsory portion (§ 2331a (1))";
}
pub relation entziehung_durch_verfuegung_2336(e: Erbfall, p: Person) kind empirical {
    label de official "Der Erblasser hat die Entziehung des Pflichtteils durch letztwillige Verfügung angeordnet (§ 2336 Abs. 1)";
    label en unofficial "the decedent ordered withdrawal of the compulsory portion by testamentary disposition (§ 2336 (1))";
}
@source(BGB_P2333)
pub external judgment relation trachtet_nach_dem_leben_2333(e: Erbfall, p: Person) {
    authority Court;
    label de official "Der Abkömmling trachtet einer in § 2333 Abs. 1 Nr. 1 bezeichneten Person nach dem Leben (§ 2333 Abs. 1 Nr. 1)";
    label en unofficial "the descendant attempts the life of a person specified in § 2333 (1) no. 1";
}
@source(BGB_P2333)
pub external judgment relation schwere_vorsaetzliche_straftat_2333(e: Erbfall, p: Person) {
    authority Court;
    label de official "Der Abkömmling hat sich eines Verbrechens oder schweren vorsätzlichen Vergehens gegen eine in § 2333 Abs. 1 Nr. 1 bezeichnete Person schuldig gemacht (§ 2333 Abs. 1 Nr. 2)";
    label en unofficial "the descendant committed a crime or serious intentional offence against a person specified in § 2333 (1) no. 1";
}
@source(BGB_P2333)
pub external judgment relation unterhaltspflicht_boesswillig_verletzt_2333(e: Erbfall, p: Person) {
    authority Court;
    label de official "Der Abkömmling hat seine gesetzliche Unterhaltspflicht dem Erblasser gegenüber böswillig verletzt (§ 2333 Abs. 1 Nr. 3)";
    label en unofficial "the descendant maliciously breached their statutory maintenance duty toward the decedent (§ 2333 (1) no. 3)";
}
pub relation wegen_vorsaetzlicher_straftat_einjahr_verurteilt_2333(e: Erbfall, p: Person) kind empirical {
    label de official "Der Abkömmling ist wegen vorsätzlicher Straftat zu mindestens einem Jahr Freiheitsstrafe ohne Bewährung rechtskräftig verurteilt (§ 2333 Abs. 1 Nr. 4)";
    label en unofficial "the descendant was finally convicted for an intentional offence to at least one year of imprisonment without probation (§ 2333 (1) no. 4)";
}
@source(BGB_P2333)
pub external judgment relation teilhabe_am_nachlass_unzumutbar_2333(e: Erbfall, p: Person) {
    authority Court;
    label de official "Die Teilhabe des Abkömmlings am Nachlass ist dem Erblasser wegen der Tat unzumutbar (§ 2333 Abs. 1 Nr. 4)";
    label en unofficial "the descendant's participation in the estate is unreasonable for the decedent because of the act (§ 2333 (1) no. 4)";
}
pub relation pflichtteil_entziehbar_2333(e: Erbfall, p: Person) kind derived {
    label de official "Der Pflichtteil kann aus dem festgestellten Grund entzogen werden (§ 2333 Abs. 1)";
    label en unofficial "the compulsory portion may be withdrawn for the established ground (§ 2333 (1))";
}
pub relation entziehungsgrund_zur_errichtung_bestehend_2336(e: Erbfall, p: Person) kind empirical {
    label de official "Der Entziehungsgrund bestand zur Zeit der Errichtung der Verfügung (§ 2336 Abs. 2)";
    label en unofficial "the ground for withdrawal existed when the disposition was made (§ 2336 (2))";
}
pub relation entziehungsgrund_in_verfuegung_angegeben_2336(e: Erbfall, p: Person) kind empirical {
    label de official "Der Grund der Entziehung ist in der letztwilligen Verfügung angegeben (§ 2336 Abs. 2)";
    label en unofficial "the ground for withdrawal is stated in the testamentary disposition (§ 2336 (2))";
}
pub relation entziehung_formwirksam_2336(e: Erbfall, p: Person) kind derived {
    label de official "Die Entziehung erfüllt Form, zeitliches Bestehen und Angabe des Grundes (§ 2336 Abs. 1, 2)";
    label en unofficial "the withdrawal satisfies form, temporal existence and statement of the ground (§ 2336 (1), (2))";
}
pub relation beweislast_entziehung_beim_geltendmachenden(e: Erbfall, p: Person) kind derived {
    label de official "Die Beweislast für den Grund der Entziehung liegt beimjenigen, der sie geltend macht (§ 2336 Abs. 3)";
    label en unofficial "the burden of proof for the withdrawal ground lies with the person asserting it (§ 2336 (3))";
}
pub relation erbverzicht_vereinbart(e: Erbfall, p: Person) kind empirical {
    label de official "Der Erblasser und der Verwandte sowie dessen Ehegatte haben einen Erbverzicht vereinbart (§ 2346 Abs. 1)";
    label en unofficial "the decedent and the relative or their spouse agreed to renounce succession (§ 2346 (1))";
}
pub relation erbverzicht_notariell_beurkundet(e: Erbfall, p: Person) kind empirical {
    label de official "Der Erbverzichtsvertrag ist notariell beurkundet (§ 2348)";
    label en unofficial "the succession-renunciation agreement was notarised (§ 2348)";
}
pub relation erbverzicht_wirksam(e: Erbfall, p: Person) kind derived {
    label de official "Der Erbverzicht schließt das gesetzliche Erbrecht aus (§§ 2346 Abs. 1, 2348)";
    label en unofficial "the renunciation excludes statutory succession rights (§§ 2346 (1), 2348)";
}
pub relation erbverzicht_aufhebungsvertrag(e: Erbfall, p: Person) kind empirical {
    label de official "Der Erblasser und der Verzichtende haben die Aufhebung des Erbverzichts durch Vertrag vereinbart (§ 2351)";
    label en unofficial "the decedent and renunciant agreed by contract to rescind the renunciation (§ 2351)";
}
pub relation erbverzicht_aufgehoben(e: Erbfall, p: Person) kind derived {
    label de official "Der Erbverzicht ist durch Vertrag aufgehoben (§ 2351)";
    label en unofficial "the succession renunciation is rescinded by contract (§ 2351)";
}
pub entity Erbschein {
    label de official "Erbschein des Nachlassgerichts (§§ 2353 ff.)";
    label en unofficial "certificate of inheritance issued by the probate court (§§ 2353 ff.)";
}
pub relation im_erbschein_als_erbe_bezeichnet(s: Erbschein, p: Person) kind empirical {
    key(s);
    label de official "Die Person ist im Erbschein als Erbe bezeichnet (§ 2365)";
    label en unofficial "the person is designated as heir in the certificate (§ 2365)";
}
pub relation erbrecht_im_erbschein_angegeben(s: Erbschein, p: Person) kind empirical {
    label de official "Das dem Erben zustehende Erbrecht ist im Erbschein angegeben (§ 2365)";
    label en unofficial "the inheritance right is stated in the certificate (§ 2365)";
}
pub relation erbrecht_nach_erbschein_vermutet(s: Erbschein, p: Person) kind derived {
    label de official "Es wird vermutet, dass dem im Erbschein bezeichneten Erben das angegebene Erbrecht zusteht und er nur wie angegeben beschränkt ist (§ 2365)";
    label en unofficial "it is presumed that the designated heir has the stated inheritance right and only the stated restrictions (§ 2365)";
}
pub entity Erbschaftskauf {
    label de official "Kaufvertrag über eine Erbschaft (§§ 2371 ff.)";
    label en unofficial "contract for the purchase of an inheritance (§§ 2371 ff.)";
}
pub relation erbschaftskauf_notariell_beurkundet(k: Erbschaftskauf) kind empirical {
    label de official "Der Erbschaftskaufvertrag ist notariell beurkundet (§ 2371)";
    label en unofficial "the inheritance-purchase agreement was notarised (§ 2371)";
}
pub relation erbschaftskauf_formwirksam(k: Erbschaftskauf) kind derived {
    label de official "Der Vertrag über den Kauf einer Erbschaft erfüllt die notarielle Form (§ 2371)";
    label en unofficial "the inheritance-purchase contract satisfies the notarisation requirement (§ 2371)";
}
pub relation testament_errichtet_am(p: Person, tag: Date) kind empirical {
    label de official "Die Person hat am angegebenen Tag ein Testament errichtet (§ 2229)";
    label en unofficial "the person made a will on the stated day (§ 2229)";
}
pub relation testierfaehig_alter_2229(p: Person, tag: Date) kind derived {
    label de official "Die Person hat am Errichtungstag das sechzehnte Lebensjahr vollendet (§ 2229 Abs. 1)";
    label en unofficial "the person completed their sixteenth year on the day of making the will (§ 2229 (1))";
}
pub entity Testament {
    label de official "Letztwillige Verfügung in Testamentsform (§§ 2229 ff.)";
    label en unofficial "testamentary disposition in will form (§§ 2229 ff.)";
}
pub relation verfuegung_von_todes_wegen_persoenlich_2064(t: Testament, errichter: Person) kind empirical {
    label de official "Der Erblasser hat die Verfügung von Todes wegen persönlich errichtet (§ 2064)";
    label en unofficial "the testator made the mortis causa disposition personally (§ 2064)";
}
pub relation verfuegung_von_todes_wegen_persoenlich_wirksam_2064(t: Testament, errichter: Person) kind derived {
    label de official "Die Verfügung erfüllt das Erfordernis der persönlichen Errichtung (§ 2064)";
    label en unofficial "the disposition satisfies the requirement of personal making (§ 2064)";
}
pub relation erbeinsetzung_durch_dritten_bestimmt_2065(t: Testament) kind empirical {
    label de official "Der Erblasser hat die Bestimmung der Person, die eine Zuwendung erhalten soll, einem Dritten überlassen (§ 2065 Abs. 2)";
    label en unofficial "the testator left determination of the beneficiary to a third party (§ 2065 (2))";
}
pub relation drittbestimmung_der_erbeinsetzung_unzulaessig_2065(t: Testament) kind derived {
    label de official "Die Bestimmung der Person des Bedachten durch einen Dritten ist unzulässig (§ 2065 Abs. 2)";
    label en unofficial "determination of the beneficiary by a third party is impermissible (§ 2065 (2))";
}
pub relation gesetzliche_erben_ohne_naehere_bestimmung_bedacht_2066(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser hat seine gesetzlichen Erben ohne nähere Bestimmung bedacht (§ 2066 Satz 1)";
    label en unofficial "the testator named his statutory heirs without further specification (§ 2066 sentence 1)";
}
pub relation zuwendung_unbedingt_oder_bis_erbfall_eingetreten_2066(t: Testament) kind empirical {
    label de official "Die Zuwendung ist unbedingt oder ihre aufschiebende Bedingung beziehungsweise ihr Anfangstermin ist bis zum Erbfall eingetreten (§ 2066 Satz 1)";
    label en unofficial "the gift is unconditional or its suspensive condition or initial term occurred by the devolution (§ 2066 sentence 1)";
}
pub relation gesetzlicher_erbteil_am_erbfall_2066(t: Testament, p: Person, z: Integer, n: Integer) kind empirical {
    label de official "Die Person wäre beim Erbfall gesetzlicher Erbe mit dem angegebenen Erbteil (§ 2066 Satz 1)";
    label en unofficial "the person would be a statutory heir at devolution with the stated share (§ 2066 sentence 1)";
}
pub relation als_gesetzlicher_erbe_bedacht_2066(t: Testament, p: Person, z: Integer, n: Integer) kind derived {
    label de official "Die Person ist nach dem Verhältnis ihres gesetzlichen Erbteils bedacht (§ 2066 Satz 1)";
    label en unofficial "the person is intended in proportion to their statutory share (§ 2066 sentence 1)";
}
pub relation zuwendung_bedingt_und_nach_erbfall_eingetreten_2066(t: Testament) kind empirical {
    label de official "Die Zuwendung steht unter aufschiebender Bedingung oder Anfangstermin, die beziehungsweise der erst nach dem Erbfall eingetreten ist (§ 2066 Satz 2)";
    label en unofficial "the gift has a suspensive condition or initial term which occurred only after devolution (§ 2066 sentence 2)";
}
pub relation gesetzlicher_erbteil_bei_spaeterem_eintritt_2066(t: Testament, p: Person, z: Integer, n: Integer) kind empirical {
    label de official "Die Person wäre gesetzlicher Erbe, wenn der Erblasser beim späteren Eintritt der Bedingung oder des Termins gestorben wäre (§ 2066 Satz 2)";
    label en unofficial "the person would be a statutory heir had the testator died when the later condition or term occurred (§ 2066 sentence 2)";
}
pub relation als_gesetzlicher_erbe_beim_spaeteren_eintritt_bedacht_2066(t: Testament, p: Person, z: Integer, n: Integer) kind derived {
    label de official "Die Person gilt im Zweifel beim späteren Eintritt nach ihrem dann gesetzlichen Erbteil als bedacht (§ 2066 Satz 2)";
    label en unofficial "in case of doubt, the person is intended at the later event in proportion to their then statutory share (§ 2066 sentence 2)";
}
pub relation verwandte_ohne_naehere_bestimmung_bedacht_2067(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser hat seine Verwandten oder nächsten Verwandten ohne nähere Bestimmung bedacht (§ 2067 Satz 1)";
    label en unofficial "the testator named his relatives or nearest relatives without further specification (§ 2067 sentence 1)";
}
pub relation verwandter_gesetzlicher_erbteil_am_erbfall_2067(t: Testament, p: Person, z: Integer, n: Integer) kind empirical {
    label de official "Der Verwandte wäre beim Erbfall gesetzlicher Erbe mit dem angegebenen Erbteil (§ 2067 Satz 1)";
    label en unofficial "the relative would be a statutory heir at devolution with the stated share (§ 2067 sentence 1)";
}
pub relation verwandter_als_gesetzlicher_erbe_bedacht_2067(t: Testament, p: Person, z: Integer, n: Integer) kind derived {
    label de official "Der Verwandte gilt im Zweifel nach dem Verhältnis seines gesetzlichen Erbteils als bedacht (§ 2067 Satz 1)";
    label en unofficial "in case of doubt, the relative is intended in proportion to their statutory share (§ 2067 sentence 1)";
}
pub relation kind_ohne_naehere_bestimmung_bedacht_2068(t: Testament, kind: Person) kind empirical {
    label de official "Der Erblasser hat sein Kind ohne nähere Bestimmung bedacht (§ 2068)";
    label en unofficial "the testator named a child without further specification (§ 2068)";
}
pub relation kind_vor_testament_mit_abkoemmlingen_verstorben_2068(t: Testament, kind: Person) kind empirical {
    label de official "Das Kind ist vor Errichtung des Testaments unter Hinterlassung von Abkömmlingen gestorben (§ 2068)";
    label en unofficial "the child died before the will was made, leaving descendants (§ 2068)";
}
pub relation abkoemmling_tritt_gesetzlich_an_stelle_des_kindes_2068(t: Testament, abkoemmling: Person, kind: Person) kind empirical {
    label de official "Der Abkömmling träte bei gesetzlicher Erbfolge an die Stelle des Kindes (§ 2068)";
    label en unofficial "the descendant would take the child's place under statutory succession (§ 2068)";
}
pub relation abkoemmling_als_ersatz_bedacht_vermutet_2068(t: Testament, abkoemmling: Person, kind: Person) kind derived {
    label de official "Der Abkömmling gilt im Zweifel insoweit als bedacht, wie er bei gesetzlicher Erbfolge an die Stelle des Kindes träte (§ 2068)";
    label en unofficial "in case of doubt, the descendant is intended to the extent they would replace the child under statutory succession (§ 2068)";
}
pub relation abkoemmling_bedacht_2069(t: Testament, abkoemmling: Person) kind empirical {
    label de official "Der Erblasser hat einen seiner Abkömmlinge bedacht (§ 2069)";
    label en unofficial "the testator named one of his descendants (§ 2069)";
}
pub relation bedachter_abkoemmling_nach_testament_weggefallen_2069(t: Testament, abkoemmling: Person) kind empirical {
    label de official "Der bedachte Abkömmling ist nach Errichtung des Testaments weggefallen (§ 2069)";
    label en unofficial "the named descendant fell away after the will was made (§ 2069)";
}
pub relation abkoemmling_tritt_gesetzlich_an_stelle_bedachten_2069(t: Testament, ersatz: Person, bedachter: Person) kind empirical {
    label de official "Der Abkömmling träte bei gesetzlicher Erbfolge an die Stelle des bedachten Abkömmlings (§ 2069)";
    label en unofficial "the descendant would take the named descendant's place under statutory succession (§ 2069)";
}
pub relation abkoemmling_als_ersatz_bedacht_vermutet_2069(t: Testament, ersatz: Person, bedachter: Person) kind derived {
    label de official "Der Abkömmling gilt im Zweifel insoweit als bedacht, wie er bei gesetzlicher Erbfolge an die Stelle des weggefallenen Abkömmlings träte (§ 2069)";
    label en unofficial "in case of doubt, the descendant is intended to the extent they would replace the fallen descendant under statutory succession (§ 2069)";
}
pub relation abkoemmlinge_eines_dritten_ohne_naehere_bestimmung_bedacht_2070(t: Testament) kind empirical {
    label de official "Der Erblasser hat die Abkömmlinge eines Dritten ohne nähere Bestimmung bedacht (§ 2070)";
    label en unofficial "the testator named descendants of a third party without further specification (§ 2070)";
}
pub relation abkoemmling_zum_massgeblichen_zeitpunkt_noch_nicht_gezeugt_2070(t: Testament, p: Person) kind empirical {
    label de official "Der Abkömmling war beim Erbfall oder beim späteren Eintritt von Bedingung oder Termin noch nicht gezeugt (§ 2070)";
    label en unofficial "the descendant was not yet conceived at devolution or at the later condition or term (§ 2070)";
}
pub relation abkoemmling_nicht_bedacht_vermutet_2070(t: Testament, p: Person) kind derived {
    label de official "Der noch nicht gezeugte Abkömmling gilt im Zweifel als nicht bedacht (§ 2070)";
    label en unofficial "in case of doubt, the not-yet-conceived descendant is not intended (§ 2070)";
}
pub relation personengruppe_oder_dienstverhaeltnis_ohne_naehere_bestimmung_bedacht_2071(t: Testament) kind empirical {
    label de official "Der Erblasser hat eine Klasse von Personen oder Personen in einem Dienst- oder Geschäftsverhältnis ohne nähere Bestimmung bedacht (§ 2071)";
    label en unofficial "the testator named a class or persons in a service or business relationship without further specification (§ 2071)";
}
pub relation person_zum_erbfall_in_bezeichneter_gruppe_oder_verhaeltnis_2071(t: Testament, p: Person) kind empirical {
    label de official "Die Person gehörte beim Erbfall der bezeichneten Klasse an oder stand im bezeichneten Verhältnis (§ 2071)";
    label en unofficial "the person was in the named class or relationship at devolution (§ 2071)";
}
pub relation person_als_gruppenmitglied_bedacht_vermutet_2071(t: Testament, p: Person) kind derived {
    label de official "Die Person gilt im Zweifel als bedacht (§ 2071)";
    label en unofficial "in case of doubt, the person is intended (§ 2071)";
}
pub relation arme_ohne_naehere_bestimmung_bedacht_2072(t: Testament) kind empirical {
    label de official "Der Erblasser hat die Armen ohne nähere Bestimmung bedacht (§ 2072)";
    label en unofficial "the testator named the poor without further specification (§ 2072)";
}
pub relation oeffentliche_armenkasse_letzter_wohnsitzgemeinde_2072(t: Testament, kasse: Person) kind empirical {
    label de official "Die öffentliche Armenkasse gehört zur Gemeinde des letzten Wohnsitzes des Erblassers (§ 2072)";
    label en unofficial "the public poor fund belongs to the municipality of the testator's last domicile (§ 2072)";
}
pub relation armenkasse_unter_verteilungsauflage_bedacht_vermutet_2072(t: Testament, kasse: Person) kind derived {
    label de official "Die öffentliche Armenkasse gilt im Zweifel unter der Auflage als bedacht, das Zugewendete unter Arme zu verteilen (§ 2072)";
    label en unofficial "in case of doubt, the public poor fund is intended subject to distributing the gift among the poor (§ 2072)";
}
pub relation mehrdeutige_bezeichnung_trifft_zu_2073(t: Testament, p: Person) kind empirical {
    label de official "Die Bezeichnung des Bedachten passt auf diese Person und weitere Personen (§ 2073)";
    label en unofficial "the beneficiary designation fits this and further persons (§ 2073)";
}
pub relation bedachter_nicht_ermittelbar_2073(t: Testament) kind empirical {
    label de official "Es lässt sich nicht ermitteln, wer von den passend Bezeichneten bedacht sein sollte (§ 2073)";
    label en unofficial "it cannot be determined which of the matching persons was intended (§ 2073)";
}
pub relation person_zu_gleichen_teilen_bedacht_2073(t: Testament, p: Person) kind derived {
    label de official "Die passend bezeichnete Person gilt als zu gleichen Teilen bedacht (§ 2073)";
    label en unofficial "the matching person is deemed intended in equal shares (§ 2073)";
}
pub relation letztwillige_zuwendung_aufschiebend_bedingt_2074(t: Testament, bedachter: Person) kind empirical {
    label de official "Der Erblasser hat die letztwillige Zuwendung unter einer aufschiebenden Bedingung gemacht (§ 2074)";
    label en unofficial "the testator made the testamentary gift subject to a suspensive condition (§ 2074)";
}
pub relation bedachter_erlebt_bedingungseintritt_2074(t: Testament, bedachter: Person) kind empirical {
    label de official "Der Bedachte erlebt den Eintritt der aufschiebenden Bedingung (§ 2074)";
    label en unofficial "the beneficiary survives the occurrence of the suspensive condition (§ 2074)";
}
pub relation zuwendung_nur_bei_erleben_bedingungseintritt_vermutet_2074(t: Testament, bedachter: Person) kind derived {
    label de official "Die Zuwendung gilt im Zweifel nur, wenn der Bedachte den Eintritt der Bedingung erlebt (§ 2074)";
    label en unofficial "in case of doubt, the gift applies only if the beneficiary survives the condition's occurrence (§ 2074)";
}
pub relation unbestimmtes_unterlassen_oder_fortgesetztes_tun_bedingt_2075(t: Testament, bedachter: Person) kind empirical {
    label de official "Die Zuwendung ist daran geknüpft, dass der Bedachte während unbestimmter Dauer etwas unterlässt oder fortgesetzt tut (§ 2075)";
    label en unofficial "the gift is conditional on the beneficiary omitting or continuously doing something for an indefinite time (§ 2075)";
}
pub relation unterlassen_oder_tun_steht_in_willkuer_des_bedachten_2075(t: Testament, bedachter: Person) kind empirical {
    label de official "Das Unterlassen oder Tun liegt lediglich in der Willkür des Bedachten (§ 2075)";
    label en unofficial "the omission or conduct lies solely within the beneficiary's discretion (§ 2075)";
}
pub relation aufloesende_bedingung_fuer_handlung_oder_unterlassen_vermutet_2075(t: Testament, bedachter: Person) kind derived {
    label de official "Die Zuwendung gilt im Zweifel als von der auflösenden Bedingung abhängig, dass der Bedachte handelt oder das Tun unterlässt (§ 2075)";
    label en unofficial "in case of doubt, the gift is subject to a resolutory condition that the beneficiary acts or ceases the conduct (§ 2075)";
}
pub relation bedingung_bezweckt_vorteil_dritten_2076(t: Testament, dritter: Person) kind empirical {
    label de official "Die Bedingung der letztwilligen Zuwendung bezweckt den Vorteil eines Dritten (§ 2076)";
    label en unofficial "the testamentary condition benefits a third party (§ 2076)";
}
pub relation dritter_verweigert_erforderliche_mitwirkung_2076(t: Testament, dritter: Person) kind empirical {
    label de official "Der Dritte verweigert die zum Eintritt der Bedingung erforderliche Mitwirkung (§ 2076)";
    label en unofficial "the third party refuses the cooperation needed for the condition to occur (§ 2076)";
}
pub relation bedingung_als_eingetreten_vermutet_2076(t: Testament, dritter: Person) kind derived {
    label de official "Die Bedingung gilt im Zweifel als eingetreten (§ 2076)";
    label en unofficial "in case of doubt, the condition is deemed fulfilled (§ 2076)";
}
pub relation ehegatte_durch_letztwillige_verfuegung_bedacht_2077(t: Testament, ehegatte: Person) kind empirical {
    label de official "Der Erblasser hat seinen Ehegatten durch letztwillige Verfügung bedacht (§ 2077 Abs. 1)";
    label en unofficial "the testator named their spouse in a testamentary disposition (§ 2077 (1))";
}
pub relation ehe_vor_tod_aufgeloest_2077(t: Testament) kind empirical {
    label de official "Die Ehe war vor dem Tod des Erblassers aufgelöst (§ 2077 Abs. 1 Satz 1)";
    label en unofficial "the marriage was dissolved before the testator's death (§ 2077 (1) sentence 1)";
}
pub relation scheidungsvoraussetzungen_und_antrag_oder_zustimmung_2077(t: Testament) kind empirical {
    label de official "Beim Tod lagen die Scheidungsvoraussetzungen vor und der Erblasser hatte Scheidung beantragt oder zugestimmt (§ 2077 Abs. 1 Satz 2)";
    label en unofficial "at death the divorce requirements existed and the testator had applied or consented (§ 2077 (1) sentence 2)";
}
pub relation aufhebungsberechtigt_und_aufhebungsantrag_2077(t: Testament) kind empirical {
    label de official "Der Erblasser war beim Tod aufhebungsberechtigt und hatte Aufhebung beantragt (§ 2077 Abs. 1 Satz 3)";
    label en unofficial "at death the testator was entitled to annulment and had applied for it (§ 2077 (1) sentence 3)";
}
pub relation verlobter_durch_letztwillige_verfuegung_bedacht_2077(t: Testament, verlobter: Person) kind empirical {
    label de official "Der Erblasser hat seinen Verlobten durch letztwillige Verfügung bedacht (§ 2077 Abs. 2)";
    label en unofficial "the testator named their fiancé in a testamentary disposition (§ 2077 (2))";
}
pub relation verloebnis_vor_tod_aufgeloest_2077(t: Testament) kind empirical {
    label de official "Das Verlöbnis war vor dem Tod des Erblassers aufgelöst (§ 2077 Abs. 2)";
    label en unofficial "the engagement was dissolved before the testator's death (§ 2077 (2))";
}
pub relation testator_wollte_verfuegung_trotz_aufloesung_2077(t: Testament) kind empirical {
    label de official "Es ist anzunehmen, dass der Erblasser die Verfügung auch für den Auflösungsfall getroffen hätte (§ 2077 Abs. 3)";
    label en unofficial "it is to be assumed the testator would have made the disposition despite the dissolution (§ 2077 (3))";
}
pub relation verfuegung_unwirksam_wegen_aufloesung_2077(t: Testament) kind derived {
    label de official "Die letztwillige Verfügung ist wegen Auflösung der Ehe oder des Verlöbnisses unwirksam (§ 2077 Abs. 1 und 2)";
    label en unofficial "the testamentary disposition is ineffective because of dissolution of marriage or engagement (§ 2077 (1) and (2))";
}
pub relation verfuegung_trotz_aufloesung_nicht_unwirksam_2077(t: Testament) kind derived {
    label de official "Die Verfügung ist wegen des vom Erblasser auch für diesen Fall vorausgesetzten Fortgeltungswillens nicht unwirksam (§ 2077 Abs. 3)";
    label en unofficial "the disposition is not ineffective because the testator intended it to continue in that event (§ 2077 (3))";
}
pub relation erklaerungsinhalt_geirrt_oder_nicht_gewollt_2078(t: Testament) kind empirical {
    label de official "Der Erblasser irrte über den Inhalt seiner Erklärung oder wollte eine Erklärung dieses Inhalts nicht abgeben (§ 2078 Abs. 1)";
    label en unofficial "the testator erred about the declaration's content or did not intend a declaration of that content (§ 2078 (1))";
}
pub relation bei_kenntnis_nicht_abgegeben_2078(t: Testament) kind empirical {
    label de official "Der Erblasser hätte die Erklärung bei Kenntnis der Sachlage nicht abgegeben (§ 2078 Abs. 1)";
    label en unofficial "the testator would not have made the declaration knowing the facts (§ 2078 (1))";
}
pub relation irrige_annahme_erwartung_oder_drohung_bestimmt_2078(t: Testament) kind empirical {
    label de official "Irrige Annahme oder Erwartung eines Umstands oder widerrechtliche Drohung bestimmte den Erblasser zur Verfügung (§ 2078 Abs. 2)";
    label en unofficial "a mistaken assumption or expectation, or unlawful threat, induced the testamentary disposition (§ 2078 (2))";
}
pub relation letztwillige_verfuegung_anfechtbar_2078(t: Testament) kind derived {
    label de official "Die letztwillige Verfügung kann wegen Irrtums oder Drohung angefochten werden (§ 2078)";
    label en unofficial "the testamentary disposition may be contested for error or threat (§ 2078)";
}
pub relation pflichtteilsberechtigter_beim_erbfall_uebergangen_2079(t: Testament, p: Person) kind empirical {
    label de official "Ein beim Erbfall vorhandener Pflichtteilsberechtigter ist übergangen (§ 2079)";
    label en unofficial "a compulsory-portion beneficiary existing at devolution was omitted (§ 2079)";
}
pub relation pflichtteilsberechtigter_unbekannt_oder_spaeter_entstanden_2079(t: Testament, p: Person) kind empirical {
    label de official "Der Pflichtteilsberechtigte war bei Errichtung unbekannt, wurde erst danach geboren oder pflichtteilsberechtigt (§ 2079)";
    label en unofficial "the beneficiary was unknown when the will was made, born later, or became entitled later (§ 2079)";
}
pub relation testator_haette_auch_mit_kenntnis_verfuegt_2079(t: Testament) kind empirical {
    label de official "Es ist anzunehmen, dass der Erblasser die Verfügung auch bei Kenntnis der Sachlage getroffen hätte (§ 2079 Satz 2)";
    label en unofficial "it is to be assumed the testator would have made the disposition knowing the facts (§ 2079 sentence 2)";
}
pub relation letztwillige_verfuegung_anfechtbar_2079(t: Testament, p: Person) kind derived {
    label de official "Die letztwillige Verfügung kann wegen Übergehung eines Pflichtteilsberechtigten angefochten werden (§ 2079 Satz 1)";
    label en unofficial "the testamentary disposition may be contested for omission of a compulsory-portion beneficiary (§ 2079 sentence 1)";
}
pub entity Anfechtung {
    label de official "Anfechtung einer letztwilligen Verfügung (§§ 2078 ff.)";
    label en unofficial "contest of a testamentary disposition (§§ 2078 ff.)";
}
pub relation aufhebung_kommt_unmittelbar_zustatten_2080(a: Anfechtung, p: Person) kind empirical { label de official "Die Aufhebung käme der Person unmittelbar zustatten (§ 2080 Abs. 1)"; label en unofficial "the avoidance would directly benefit the person (§ 2080 (1))"; }
pub relation person_anfechtungsberechtigt_2080(a: Anfechtung, p: Person) kind derived { label de official "Die Person ist zur Anfechtung berechtigt (§ 2080 Abs. 1)"; label en unofficial "the person is entitled to contest (§ 2080 (1))"; }
pub relation irrtum_betrifft_bestimmte_person_2080(a: Anfechtung, p: Person) kind empirical { label de official "Der Irrtum nach § 2078 betrifft nur diese bestimmte Person (§ 2080 Abs. 2)"; label en unofficial "the § 2078 error concerns only this particular person (§ 2080 (2))"; }
pub relation bestimmte_person_anfechtungsberechtigt_oder_waere_es_2080(a: Anfechtung, p: Person) kind empirical { label de official "Die bestimmte Person ist anfechtungsberechtigt oder wäre es bei Leben am Erbfall (§ 2080 Abs. 2)"; label en unofficial "the particular person is entitled to contest or would be if alive at devolution (§ 2080 (2))"; }
pub relation anderer_nicht_anfechtungsberechtigt_2080(a: Anfechtung, p: Person) kind derived { label de official "Ein anderer ist nicht anfechtungsberechtigt (§ 2080 Abs. 2)"; label en unofficial "another person is not entitled to contest (§ 2080 (2))"; }
pub relation anfechtung_wegen_2079(a: Anfechtung, t: Testament, p: Person) kind empirical { label de official "Die Anfechtung betrifft die Übergehung dieses Pflichtteilsberechtigten nach § 2079"; label en unofficial "the contest concerns omission of this compulsory-portion beneficiary under § 2079"; }
pub relation pflichtteilsberechtigter_allein_anfechtungsberechtigt_2080(a: Anfechtung, p: Person) kind derived { label de official "Nur der Pflichtteilsberechtigte hat das Anfechtungsrecht (§ 2080 Abs. 3)"; label en unofficial "only the compulsory-portion beneficiary holds the right to contest (§ 2080 (3))"; }
pub relation anfechtungserklaerung_nachlassgericht_2081(a: Anfechtung) kind empirical { label de official "Die Anfechtung ist gegenüber dem Nachlassgericht erklärt (§ 2081 Abs. 1 und 3)"; label en unofficial "the contest is declared to the probate court (§ 2081 (1) and (3))"; }
pub relation anfechtungserklaerung_formgerecht_2081(a: Anfechtung) kind derived { label de official "Die Anfechtungserklärung ist gegenüber dem Nachlassgericht erfolgt (§ 2081 Abs. 1 und 3)"; label en unofficial "the contest declaration was made to the probate court (§ 2081 (1) and (3))"; }
pub relation anfechtungsgrund_kenntnis_am_2082(a: Anfechtung, p: Person, tag: Date) kind empirical { label de official "Der Anfechtungsberechtigte erlangte Kenntnis vom Anfechtungsgrund (§ 2082 Abs. 2)"; label en unofficial "the entitled person obtained knowledge of the ground for contest (§ 2082 (2))"; }
pub relation anfechtungsfrist_beginnt_2082(a: Anfechtung, p: Person, tag: Date) kind derived { label de official "Die Jahresfrist beginnt mit Kenntnis vom Anfechtungsgrund (§ 2082 Abs. 2)"; label en unofficial "the one-year period begins with knowledge of the ground (§ 2082 (2))"; }
pub relation anfechtung_binnen_jahresfrist_2082(a: Anfechtung) kind empirical { label de official "Die Anfechtung erfolgte binnen Jahresfrist (§ 2082 Abs. 1)"; label en unofficial "the contest was made within one year (§ 2082 (1))"; }
pub relation seit_erbfall_dreissig_jahre_verstrichen_2082(a: Anfechtung) kind empirical { label de official "Seit dem Erbfall sind dreißig Jahre verstrichen (§ 2082 Abs. 3)"; label en unofficial "thirty years have elapsed since devolution (§ 2082 (3))"; }
pub relation anfechtung_fristgerecht_2082(a: Anfechtung) kind derived { label de official "Die Anfechtung ist fristgerecht (§ 2082 Abs. 1)"; label en unofficial "the contest is timely (§ 2082 (1))"; }
pub relation anfechtung_wegen_dreissig_jahren_ausgeschlossen_2082(a: Anfechtung) kind derived { label de official "Die Anfechtung ist wegen Ablaufes von dreißig Jahren seit Erbfall ausgeschlossen (§ 2082 Abs. 3)"; label en unofficial "the contest is barred because thirty years have elapsed since devolution (§ 2082 (3))"; }
pub relation leistungsverpflichtung_durch_anfechtbare_verfuegung_2083(t: Testament, beschwerter: Person) kind empirical { label de official "Eine anfechtbare letztwillige Verfügung begründet eine Leistungspflicht des Beschwerten (§ 2083)"; label en unofficial "a contestable disposition creates a performance obligation for the burdened person (§ 2083)"; }
pub relation beschwerter_darf_leistung_verweigern_2083(t: Testament, beschwerter: Person) kind derived { label de official "Der Beschwerte kann die Leistung verweigern (§ 2083)"; label en unofficial "the burdened person may refuse performance (§ 2083)"; }
pub relation mehrere_auslegungen_eine_erfolgreich_2084(t: Testament) kind empirical { label de official "Der Inhalt lässt mehrere Auslegungen zu, von denen eine der Verfügung Erfolg gibt (§ 2084)"; label en unofficial "the content permits multiple constructions, one of which gives effect to the disposition (§ 2084)"; }
pub relation wirksame_auslegung_vorzuziehen_vermutet_2084(t: Testament) kind derived { label de official "Die wirksame Auslegung ist im Zweifel vorzuziehen (§ 2084)"; label en unofficial "the effective construction is preferred in case of doubt (§ 2084)"; }
pub relation eine_von_mehreren_verfuegungen_unwirksam_2085(t: Testament) kind empirical { label de official "Eine von mehreren im Testament enthaltenen Verfügungen ist unwirksam (§ 2085)"; label en unofficial "one of several dispositions in the will is ineffective (§ 2085)"; }
pub relation testator_haette_uebrige_ohne_unwirksame_nicht_getroffen_2085(t: Testament) kind empirical { label de official "Der Erblasser hätte die übrigen Verfügungen ohne die unwirksame nicht getroffen (§ 2085)"; label en unofficial "the testator would not have made the remaining dispositions without the ineffective one (§ 2085)"; }
pub relation uebrige_verfuegungen_ebenfalls_unwirksam_2085(t: Testament) kind derived { label de official "Die übrigen Verfügungen sind ebenfalls unwirksam (§ 2085)"; label en unofficial "the remaining dispositions are also ineffective (§ 2085)"; }
pub relation ergaenzungsvorbehalt_ohne_ergaenzung_2086(t: Testament) kind empirical { label de official "Der Verfügung ist ein Ergänzungsvorbehalt beigefügt, die Ergänzung unterblieb (§ 2086)"; label en unofficial "the disposition has a reservation of supplementation but no supplementation occurred (§ 2086)"; }
pub relation wirksamkeit_von_ergaenzung_abhaengig_2086(t: Testament) kind empirical { label de official "Die Wirksamkeit sollte von der Ergänzung abhängen (§ 2086)"; label en unofficial "effectiveness was intended to depend on the supplementation (§ 2086)"; }
pub relation verfuegung_trotz_fehlender_ergaenzung_wirksam_2086(t: Testament) kind derived { label de official "Die Verfügung ist trotz unterbliebener Ergänzung wirksam (§ 2086)"; label en unofficial "the disposition is effective despite the absent supplementation (§ 2086)"; }
pub relation vermoegen_oder_vermoegensbruchteil_zugewendet_2087(t: Testament, p: Person) kind empirical { label de official "Dem Bedachten ist das Vermögen oder ein Bruchteil des Vermögens zugewendet (§ 2087 Abs. 1)"; label en unofficial "the beneficiary was given the estate or a fraction of it (§ 2087 (1))"; }
pub relation einzelne_gegenstaende_zugewendet_2087(t: Testament, p: Person) kind empirical { label de official "Dem Bedachten sind nur einzelne Gegenstände zugewendet (§ 2087 Abs. 2)"; label en unofficial "the beneficiary was given only individual items (§ 2087 (2))"; }
pub relation zuwendung_als_erbeinsetzung_anzusehen_2087(t: Testament, p: Person) kind derived { label de official "Die Zuwendung ist als Erbeinsetzung anzusehen (§ 2087 Abs. 1)"; label en unofficial "the gift is to be regarded as appointment as heir (§ 2087 (1))"; }
pub relation gegenstandszuwendung_nicht_als_erbeinsetzung_vermutet_2087(t: Testament, p: Person) kind derived { label de official "Die Zuwendung einzelner Gegenstände gilt im Zweifel nicht als Erbeinsetzung (§ 2087 Abs. 2)"; label en unofficial "a gift of individual items is in case of doubt not appointment as heir (§ 2087 (2))"; }
pub relation einzelner_erbe_auf_bruchteil_eingesetzt_2088(t: Testament, p: Person, z: Integer, n: Integer) kind empirical { label de official "Nur ein Erbe ist auf den Bruchteil der Erbschaft eingesetzt (§ 2088 Abs. 1)"; label en unofficial "only one heir is appointed to a fraction of the estate (§ 2088 (1))"; }
pub relation mehrere_erben_auf_nicht_erschoepfende_bruchteile_2088(t: Testament) kind empirical { label de official "Mehrere Erben sind auf Bruchteile eingesetzt, welche die Erbschaft nicht erschöpfen (§ 2088 Abs. 2)"; label en unofficial "multiple heirs are appointed to fractions that do not exhaust the estate (§ 2088 (2))"; }
pub relation rest_erbschaft_gesetzliche_erbfolge_2088(t: Testament) kind derived { label de official "Im übrigen Teil tritt gesetzliche Erbfolge ein (§ 2088)"; label en unofficial "statutory succession applies to the remainder (§ 2088)"; }
pub relation eingesetzte_sollen_alleinige_erben_sein_2089(t: Testament) kind empirical { label de official "Nach dem Willen des Erblassers sollen die eingesetzten Erben alleinige Erben sein (§ 2089)"; label en unofficial "the testator intended the appointed heirs to be sole heirs (§ 2089)"; }
pub relation bruchteile_erschoepfen_nicht_2089(t: Testament) kind empirical { label de official "Die allen eingesetzten Erben bestimmten Bruchteile erschöpfen die Erbschaft nicht (§ 2089)"; label en unofficial "the fractions allotted to all appointed heirs do not exhaust the estate (§ 2089)"; }
pub relation bruchteile_verhaeltnismaessig_erhoeht_2089(t: Testament) kind derived { label de official "Die Bruchteile erhöhen sich verhältnismäßig (§ 2089)"; label en unofficial "the fractions are proportionately increased (§ 2089)"; }
pub relation eingesetzte_bruchteile_uebersteigen_ganzes_2090(t: Testament) kind empirical { label de official "Die Bruchteile aller eingesetzten Erben übersteigen die Erbschaft (§ 2090)"; label en unofficial "the fractions of all appointed heirs exceed the estate (§ 2090)"; }
pub relation bruchteile_verhaeltnismaessig_gemindert_2090(t: Testament) kind derived { label de official "Die Bruchteile mindern sich verhältnismäßig (§ 2090)"; label en unofficial "the fractions are proportionately reduced (§ 2090)"; }
pub relation mehrere_erben_ohne_erbteilbestimmung_2091(t: Testament) kind empirical { label de official "Mehrere Erben sind eingesetzt, ohne dass die Erbteile bestimmt sind (§ 2091)"; label en unofficial "multiple heirs are appointed without specified shares (§ 2091)"; }
pub relation erbe_ohne_erbteilbestimmung_eingesetzt_2091(t: Testament, p: Person) kind empirical { label de official "Dieser Erbe ist ohne Bestimmung seines Erbteils eingesetzt (§ 2091)"; label en unofficial "this heir is appointed without a specified share (§ 2091)"; }
pub relation erbe_zu_gleichen_teilen_eingesetzt_2091(t: Testament, p: Person) kind derived { label de official "Der Erbe ist zu gleichen Teilen eingesetzt (§ 2091)"; label en unofficial "the heir is appointed in equal shares (§ 2091)"; }
pub relation bruchteilserben_und_unbestimmte_erben_2092(t: Testament) kind empirical { label de official "Von mehreren Erben sind einige auf Bruchteile, andere ohne Bruchteile eingesetzt (§ 2092 Abs. 1)"; label en unofficial "some heirs are appointed to fractions and others without fractions (§ 2092 (1))"; }
pub relation erbe_ohne_bruchteil_eingesetzt_2092(t: Testament, p: Person) kind empirical { label de official "Dieser Erbe ist ohne Bruchteil eingesetzt (§ 2092 Abs. 1)"; label en unofficial "this heir is appointed without a fraction (§ 2092 (1))"; }
pub relation unbestimmter_erbe_erhaelt_freigebliebenen_teil_2092(t: Testament, p: Person) kind derived { label de official "Der ohne Bruchteil eingesetzte Erbe erhält den freigebliebenen Teil (§ 2092 Abs. 1)"; label en unofficial "the heir appointed without a fraction receives the unallocated part (§ 2092 (1))"; }
pub relation bestimmte_bruchteile_erschoepfen_2092(t: Testament) kind empirical { label de official "Die bestimmten Bruchteile erschöpfen die Erbschaft (§ 2092 Abs. 2)"; label en unofficial "the specified fractions exhaust the estate (§ 2092 (2))"; }
pub relation bruchteile_nach_2092_abs2_verhaeltnismaessig_gemindert(t: Testament) kind derived { label de official "Die Bruchteile mindern sich nach § 2092 Abs. 2 verhältnismäßig"; label en unofficial "the fractions are proportionately reduced under § 2092 (2)"; }
pub relation gemeinschaftlicher_erbteil_eingesetzt_2093(t: Testament) kind empirical { label de official "Einige von mehreren Erben sind auf denselben Bruchteil eingesetzt (§ 2093)"; label en unofficial "some of multiple heirs are appointed to the same fraction (§ 2093)"; }
pub relation regeln_2089_bis_2092_auf_gemeinschaftlichen_erbteil_anwendbar_2093(t: Testament) kind derived { label de official "§§ 2089 bis 2092 finden auf den gemeinschaftlichen Erbteil entsprechende Anwendung (§ 2093)"; label en unofficial "§§ 2089 through 2092 apply mutatis mutandis to the joint share (§ 2093)"; }
pub relation mehrere_eingesetzte_erben_schliessen_gesetzliche_erbfolge_aus_2094(t: Testament) kind empirical { label de official "Mehrere eingesetzte Erben schließen die gesetzliche Erbfolge aus (§ 2094 Abs. 1)"; label en unofficial "multiple appointed heirs exclude statutory succession (§ 2094 (1))"; }
pub relation eingesetzter_erbe_weggefallen_2094(t: Testament, weggefallen: Person) kind empirical { label de official "Ein eingesetzter Erbe ist vor oder nach Eintritt des Erbfalls weggefallen (§ 2094 Abs. 1)"; label en unofficial "an appointed heir fell away before or after devolution (§ 2094 (1))"; }
pub relation uebriger_erbe_anwachsungsberechtigt_2094(t: Testament, erbe: Person, weggefallen: Person) kind empirical { label de official "Der übrige eingesetzte Erbe ist nach dem Verhältnis seines Erbteils anwachungsberechtigt (§ 2094 Abs. 1)"; label en unofficial "the remaining appointed heir has accretion in proportion to their share (§ 2094 (1))"; }
pub relation erbteil_wachst_an_2094(t: Testament, erbe: Person, weggefallen: Person) kind derived { label de official "Der Erbteil des weggefallenen Erben wächst dem übrigen Erben an (§ 2094 Abs. 1)"; label en unofficial "the fallen heir's share accrues to the remaining heir (§ 2094 (1))"; }
pub relation gemeinschaftlicher_erbteil_anwachsung_vorrangig_2094(t: Testament) kind empirical { label de official "Für einen gemeinschaftlichen Erbteil tritt die Anwachsung zunächst unter dessen Teilhabern ein (§ 2094 Abs. 1 Satz 2)"; label en unofficial "accretion of a joint share occurs first among its participants (§ 2094 (1) sentence 2)"; }
pub relation nur_teilweise_ueber_erbschaft_verfuegt_2094(t: Testament) kind empirical { label de official "Über nur einen Teil der Erbschaft ist verfügt und im Übrigen gilt gesetzliche Erbfolge (§ 2094 Abs. 2)"; label en unofficial "only part of the estate is disposed of and statutory succession applies to the rest (§ 2094 (2))"; }
pub relation anwachsung_nur_gemeinschaftlicher_erbteil_2094(t: Testament) kind derived { label de official "Bei teilweiser Verfügung tritt Anwachsung nur für einen gemeinschaftlichen Erbteil ein (§ 2094 Abs. 2)"; label en unofficial "with partial disposition, accretion applies only to a joint share (§ 2094 (2))"; }
pub relation anwachsung_ausgeschlossen_2094(t: Testament) kind empirical { label de official "Der Erblasser hat die Anwachsung ausgeschlossen (§ 2094 Abs. 3)"; label en unofficial "the testator excluded accretion (§ 2094 (3))"; }
pub relation angewachsener_erbteil_besonderer_erbteil_2095(t: Testament, erbe: Person) kind derived { label de official "Der durch Anwachsung anfallende Erbteil gilt für Vermächtnisse, Auflagen und Ausgleichungspflicht als besonderer Erbteil (§ 2095)"; label en unofficial "an accrued share is a separate share for legacies, charges and equalisation (§ 2095)"; }
pub relation ersatzerbe_fuer_wegfall_eingesetzt_2096(t: Testament, ersatz: Person, zuerst: Person) kind empirical { label de official "Der Erblasser hat einen anderen als Erben für den Wegfall des zuerst berufenen Erben eingesetzt (§ 2096)"; label en unofficial "the testator appointed another heir for the initial heir's falling away (§ 2096)"; }
pub relation ersatzerbeneinsetzung_zulaessig_2096(t: Testament, ersatz: Person, zuerst: Person) kind derived { label de official "Die Einsetzung als Ersatzerbe für den Wegfall des zuerst Berufenen ist zulässig (§ 2096)"; label en unofficial "appointment as substitute heir for the initial heir's falling away is permitted (§ 2096)"; }
pub relation ersatzerbe_nur_unfaehigkeit_oder_unwille_2097(t: Testament, ersatz: Person, zuerst: Person) kind empirical { label de official "Der Ersatzerbe ist für den Fall der Unfähigkeit oder nur für den Fall des Unwillens des zuerst Berufenen eingesetzt (§ 2097)"; label en unofficial "the substitute is appointed for inability or only unwillingness of the initial heir (§ 2097)"; }
pub relation ersatzerbe_fuer_beide_wegfallsfaelle_vermutet_2097(t: Testament, ersatz: Person, zuerst: Person) kind derived { label de official "Der Ersatzerbe gilt im Zweifel für Unfähigkeit und Unwillen als eingesetzt (§ 2097)"; label en unofficial "in case of doubt, the substitute is appointed for both inability and unwillingness (§ 2097)"; }
pub relation erben_wechselseitig_als_ersatzerben_eingesetzt_2098(t: Testament) kind empirical { label de official "Erben sind gegenseitig oder die übrigen für einen als Ersatzerben eingesetzt (§ 2098 Abs. 1)"; label en unofficial "heirs are reciprocal substitutes or the others substitute for one (§ 2098 (1))"; }
pub relation wechselseitige_ersatzfolge_nach_erbteilen_vermutet_2098(t: Testament) kind derived { label de official "Die wechselseitige Ersatzeinsetzung gilt im Zweifel nach dem Verhältnis der Erbteile (§ 2098 Abs. 1)"; label en unofficial "reciprocal substitution is in case of doubt in proportion to shares (§ 2098 (1))"; }
pub relation gemeinschaftlicher_erbteil_ersatzfolge_vorrangig_2098(t: Testament) kind empirical { label de official "Erben auf gemeinschaftlichen Erbteil gehen als Ersatzerben hierfür den anderen vor (§ 2098 Abs. 2)"; label en unofficial "heirs of a joint share take priority as substitutes for it (§ 2098 (2))"; }
pub relation ersatzerbenrecht_geht_anwachsung_vor_2099(t: Testament) kind derived { label de official "Das Recht des Ersatzerben geht dem Anwachsungsrecht vor (§ 2099)"; label en unofficial "the substitute heir's right takes priority over accretion (§ 2099)"; }
pub relation vorerbe_und_nacherbe_nacheinander_eingesetzt_2100(t: Testament, vorerbe: Person, nacherbe: Person) kind empirical { label de official "Ein Erbe soll erst Erbe werden, nachdem zunächst ein anderer Erbe war (§ 2100)"; label en unofficial "an heir is to become heir after another was initially heir (§ 2100)"; }
pub relation nacherbeinsetzung_zulaessig_2100(t: Testament, nacherbe: Person) kind derived { label de official "Die Einsetzung als Nacherbe ist zulässig (§ 2100)"; label en unofficial "appointment as subsequent heir is permitted (§ 2100)"; }
pub relation beim_erbfall_noch_nicht_gezeugter_als_erbe_eingesetzt_2101(t: Testament, p: Person) kind empirical { label de official "Eine beim Erbfall noch nicht gezeugte Person ist als Erbe eingesetzt (§ 2101 Abs. 1)"; label en unofficial "a person not yet conceived at devolution is appointed as heir (§ 2101 (1))"; }
pub relation spaeter_entstehende_juristische_person_als_erbe_eingesetzt_2101(t: Testament, p: Person) kind empirical { label de official "Eine erst nach dem Erbfall entstehende juristische Person ist als Erbe eingesetzt (§ 2101 Abs. 2)"; label en unofficial "a legal person arising only after devolution is appointed as heir (§ 2101 (2))"; }
pub relation noch_nicht_gezeugter_oder_juristische_person_als_nacherbe_vermutet_2101(t: Testament, p: Person) kind derived { label de official "Die Person gilt im Zweifel als Nacherbe eingesetzt (§ 2101)"; label en unofficial "the person is in case of doubt appointed as subsequent heir (§ 2101)"; }
pub relation nichteignung_als_nacherbe_nach_willen_2101(t: Testament, p: Person) kind empirical { label de official "Es entspricht nicht dem Willen des Erblassers, dass die Person Nacherbe sein soll (§ 2101 Abs. 1 Satz 2)"; label en unofficial "the testator did not intend the person to be a subsequent heir (§ 2101 (1) sentence 2)"; }
pub relation einsetzung_unwirksam_2101(t: Testament, p: Person) kind derived { label de official "Die Einsetzung ist unwirksam (§ 2101 Abs. 1 Satz 2)"; label en unofficial "the appointment is ineffective (§ 2101 (1) sentence 2)"; }
pub relation als_nacherbe_eingesetzt_2102(t: Testament, p: Person) kind empirical { label de official "Die Person ist als Nacherbe eingesetzt (§ 2102)"; label en unofficial "the person is appointed as subsequent heir (§ 2102)"; }
pub relation nacherbe_auch_ersatzerbe_vermutet_2102(t: Testament, p: Person) kind derived { label de official "Die Nacherbeneinsetzung enthält im Zweifel auch Ersatzerbeneinsetzung (§ 2102 Abs. 1)"; label en unofficial "a subsequent-heir appointment includes substitute appointment in case of doubt (§ 2102 (1))"; }
pub relation zweifel_ersatz_oder_nacherbe_2102(t: Testament, p: Person) kind empirical { label de official "Es ist zweifelhaft, ob die Person als Ersatz- oder Nacherbe eingesetzt ist (§ 2102 Abs. 2)"; label en unofficial "it is doubtful whether the person is substitute or subsequent heir (§ 2102 (2))"; }
pub relation im_zweifel_ersatzerbe_2102(t: Testament, p: Person) kind derived { label de official "Die Person gilt als Ersatzerbe eingesetzt (§ 2102 Abs. 2)"; label en unofficial "the person is deemed appointed as substitute heir (§ 2102 (2))"; }
pub relation herausgabe_an_anderen_bei_zeitpunkt_oder_ereignis_2103(t: Testament, anderer: Person) kind empirical { label de official "Der Erbe soll die Erbschaft bei bestimmtem Zeitpunkt oder Ereignis an einen anderen herausgeben (§ 2103)"; label en unofficial "the heir must hand the estate to another on a specified time or event (§ 2103)"; }
pub relation anderer_als_nacherbe_vermutet_2103(t: Testament, anderer: Person) kind derived { label de official "Der andere gilt als Nacherbe eingesetzt (§ 2103)"; label en unofficial "the other is deemed appointed as subsequent heir (§ 2103)"; }
pub relation erbe_nur_bis_zeitpunkt_oder_ereignis_2104(t: Testament) kind empirical { label de official "Der eingesetzte Erbe soll nur bis zu einem bestimmten Zeitpunkt oder Ereignis Erbe sein (§ 2104)"; label en unofficial "the appointed heir is to be heir only until a specified time or event (§ 2104)"; }
pub relation gesetzlicher_erbe_beim_spaeteren_ereignis_2104(t: Testament, p: Person) kind empirical { label de official "Die Person wäre gesetzlicher Erbe, wenn der Erblasser beim Zeitpunkt oder Ereignis gestorben wäre (§ 2104)"; label en unofficial "the person would be statutory heir if the testator died at the time or event (§ 2104)"; }
pub relation gesetzlicher_erbe_als_nacherbe_vermutet_2104(t: Testament, p: Person) kind derived { label de official "Die Person gilt als Nacherbe eingesetzt (§ 2104)"; label en unofficial "the person is deemed appointed as subsequent heir (§ 2104)"; }
pub relation eingesetzter_erbe_erhaelt_nur_spaeter_2105(t: Testament) kind empirical { label de official "Der eingesetzte Erbe soll die Erbschaft erst mit künftigem Zeitpunkt oder Ereignis erhalten (§ 2105 Abs. 1)"; label en unofficial "the appointed heir is to receive the estate only at a future time or event (§ 2105 (1))"; }
pub relation gesetzlicher_erbe_bis_dahin_2105(t: Testament, p: Person) kind empirical { label de official "Die Person ist bis dahin gesetzlicher Erbe des Erblassers (§ 2105)"; label en unofficial "the person is the testator's statutory heir until then (§ 2105)"; }
pub relation gesetzlicher_erbe_als_vorerbe_2105(t: Testament, p: Person) kind derived { label de official "Die Person gilt als Vorerbe eingesetzt (§ 2105)"; label en unofficial "the person is deemed appointed as prior heir (§ 2105)"; }
pub relation nacherbe_ohne_eintrittszeitpunkt_2106(t: Testament, nacherbe: Person, vorerbe: Person) kind empirical { label de official "Ein Nacherbe ist eingesetzt, ohne Zeitpunkt oder Ereignis des Eintritts zu bestimmen (§ 2106 Abs. 1)"; label en unofficial "a subsequent heir is appointed without a specified time or event of succession (§ 2106 (1))"; }
pub relation nacherbschaft_mit_tod_des_vorerben_2106(t: Testament, nacherbe: Person) kind derived { label de official "Die Erbschaft fällt dem Nacherben mit dem Tod des Vorerben an (§ 2106 Abs. 1)"; label en unofficial "the estate devolves on the subsequent heir on the prior heir's death (§ 2106 (1))"; }
pub relation noch_nicht_gezeugter_nacherbe_geboren_2106(t: Testament, p: Person) kind empirical { label de official "Der nach § 2101 als Nacherbe anzusehende noch nicht gezeugte Eingesetzte ist geboren (§ 2106 Abs. 2)"; label en unofficial "the not-yet-conceived appointee treated as subsequent heir under § 2101 has been born (§ 2106 (2))"; }
pub relation nacherbschaft_mit_geburt_2106(t: Testament, p: Person) kind derived { label de official "Die Erbschaft fällt dem Nacherben mit seiner Geburt an (§ 2106 Abs. 2)"; label en unofficial "the estate devolves on the subsequent heir on birth (§ 2106 (2))"; }
pub relation kinderloser_abkoemmling_vorerbe_nacherbe_bestimmt_2107(t: Testament, vorerbe: Person, nacherbe: Person) kind empirical { label de official "Für einen bei Errichtung kinderlosen oder dem Erblasser unbekannt nachkommenschaftshabenden Abkömmling ist ein Nacherbe für die Zeit nach seinem Tod bestimmt (§ 2107)"; label en unofficial "a subsequent heir is designated after the death of a descendant childless or believed childless when the will was made (§ 2107)"; }
pub relation nacherbe_nur_bei_nachkommenschaftslosem_tod_vermutet_2107(t: Testament, nacherbe: Person) kind derived { label de official "Der Nacherbe gilt nur für den Fall des nachkommenschaftslosen Todes als eingesetzt (§ 2107)"; label en unofficial "the subsequent heir is in case of doubt appointed only for death without descendants (§ 2107)"; }
pub relation nacherbe_vor_eintritt_nach_erbfall_verstorben_2108(t: Testament, nacherbe: Person) kind empirical { label de official "Der eingesetzte Nacherbe starb nach Eintritt des Erbfalls, aber vor Eintritt der Nacherbfolge (§ 2108 Abs. 2)"; label en unofficial "the appointed subsequent heir died after devolution but before subsequent succession (§ 2108 (2))"; }
pub relation nacherbrecht_geht_auf_erben_ueber_2108(t: Testament, nacherbe: Person) kind derived { label de official "Das Nacherbrecht geht auf die Erben des eingesetzten Nacherben über (§ 2108 Abs. 2)"; label en unofficial "the subsequent-heir right passes to the appointed subsequent heir's heirs (§ 2108 (2))"; }
pub relation nacherbschaft_dreissig_jahre_ohne_eintritt_2109(t: Testament) kind empirical { label de official "Dreißig Jahre nach Erbfall sind abgelaufen, ohne dass der Fall der Nacherbfolge eingetreten ist (§ 2109 Abs. 1)"; label en unofficial "thirty years elapsed after devolution without subsequent succession occurring (§ 2109 (1))"; }
pub relation nacherbeinsetzung_unwirksam_2109(t: Testament) kind derived { label de official "Die Nacherbeneinsetzung ist unwirksam (§ 2109 Abs. 1)"; label en unofficial "the subsequent-heir appointment is ineffective (§ 2109 (1))"; }
pub relation vorerbe_miterbenwegfall_erbteil_erhalten_2110(t: Testament) kind empirical { label de official "Dem Vorerben fällt durch Wegfall eines Miterben ein Erbteil an (§ 2110 Abs. 1)"; label en unofficial "a share accrues to the prior heir through a co-heir's falling away (§ 2110 (1))"; }
pub relation nacherbrecht_erstreckt_sich_auf_angewachsenen_erbteil_2110(t: Testament) kind derived { label de official "Das Nacherbrecht erstreckt sich im Zweifel auf den dem Vorerben angewachsenen Erbteil (§ 2110 Abs. 1)"; label en unofficial "the subsequent right extends in case of doubt to the accrued share (§ 2110 (1))"; }
pub relation vorerbe_vorausvermaechtnis_zugewendet_2110(t: Testament) kind empirical { label de official "Dem Vorerben ist ein Vorausvermächtnis zugewendet (§ 2110 Abs. 2)"; label en unofficial "the prior heir receives an advance legacy (§ 2110 (2))"; }
pub relation nacherbrecht_erstreckt_sich_nicht_auf_vorausvermaechtnis_2110(t: Testament) kind derived { label de official "Das Nacherbrecht erstreckt sich im Zweifel nicht auf das Vorausvermächtnis (§ 2110 Abs. 2)"; label en unofficial "the subsequent right does not in case of doubt extend to the advance legacy (§ 2110 (2))"; }
pub relation vorerbe_erwirbt_ersatz_aus_erbschaftsrecht_2111(t: Testament, vorerbe: Person) kind empirical { label de official "Der Vorerbe erwirbt aufgrund eines Erbschaftsrechts oder als Ersatz für einen Erbschaftsgegenstand (§ 2111 Abs. 1)"; label en unofficial "the prior heir acquires under an estate right or as replacement for an estate asset (§ 2111 (1))"; }
pub relation ersatz_gehoert_zur_erbschaft_2111(t: Testament, vorerbe: Person) kind derived { label de official "Der Ersatz gehört zur Erbschaft (§ 2111 Abs. 1)"; label en unofficial "the replacement belongs to the estate (§ 2111 (1))"; }
pub relation vorerbe_inventar_grundstueck_einverleibt_2111(t: Testament, vorerbe: Person) kind empirical { label de official "Der Vorerbe hat etwas dem Inventar eines erbschaftlichen Grundstücks einverleibt (§ 2111 Abs. 2)"; label en unofficial "the prior heir incorporated something into the inventory of estate land (§ 2111 (2))"; }
pub relation einverleibung_gehoert_zur_erbschaft_2111(t: Testament, vorerbe: Person) kind derived { label de official "Die Einverleibung gehört zur Erbschaft (§ 2111 Abs. 2)"; label en unofficial "the incorporation belongs to the estate (§ 2111 (2))"; }
pub relation vorerbe_verfuegt_ueber_erbschaftsgegenstand_2112(t: Testament, vorerbe: Person) kind empirical { label de official "Der Vorerbe verfügt über einen zur Erbschaft gehörenden Gegenstand (§ 2112)"; label en unofficial "the prior heir disposes of an estate asset (§ 2112)"; }
pub relation verfuegung_vorerbe_zulaessig_2112(t: Testament, vorerbe: Person) kind derived { label de official "Die Verfügung des Vorerben ist zulässig, soweit §§ 2113 bis 2115 nichts anderes bestimmen (§ 2112)"; label en unofficial "the prior heir's disposition is permitted unless §§ 2113–2115 provide otherwise (§ 2112)"; }
pub relation vorerbe_verfuegung_grundstueck_schiff_oder_unentgeltlich_2113(t: Testament, vorerbe: Person) kind empirical { label de official "Der Vorerbe verfügt über Grundstück, eingetragenes Schiff oder unentgeltlich über einen Erbschaftsgegenstand (§ 2113 Abs. 1 und 2)"; label en unofficial "the prior heir disposes of land, registered vessel, or gratuitously of an estate asset (§ 2113 (1) and (2))"; }
pub relation verfuegung_beeintraechtigt_nacherbrecht_2113(t: Testament) kind empirical { label de official "Die Verfügung würde das Recht des Nacherben vereiteln oder beeinträchtigen (§ 2113)"; label en unofficial "the disposition would defeat or impair the subsequent heir's right (§ 2113)"; }
pub relation verfuegung_bei_nacherbfolge_unwirksam_2113(t: Testament) kind derived { label de official "Die Verfügung ist beim Eintritt der Nacherbfolge insoweit unwirksam (§ 2113)"; label en unofficial "the disposition is ineffective to that extent upon subsequent succession (§ 2113)"; }
pub relation vorerbe_hypothekenforderung_kuendigt_oder_zieht_ein_2114(t: Testament, vorerbe: Person) kind empirical { label de official "Der Vorerbe kündigt oder zieht eine Hypotheken-, Grund-, Renten- oder Schiffshypothekenforderung der Erbschaft ein (§ 2114)"; label en unofficial "the prior heir terminates or collects an estate mortgage or equivalent claim (§ 2114)"; }
pub relation vorerbe_kuendigung_einziehung_zulaessig_2114(t: Testament, vorerbe: Person) kind derived { label de official "Kündigung und Einziehung stehen dem Vorerben zu (§ 2114)"; label en unofficial "termination and collection belong to the prior heir (§ 2114)"; }
pub relation zwangsverfuegung_beeintraechtigt_nacherbrecht_2115(t: Testament) kind empirical { label de official "Eine Zwangsvollstreckungs-, Arrest- oder Insolvenzverfügung würde das Nacherbrecht beeinträchtigen (§ 2115 Satz 1)"; label en unofficial "an enforcement, attachment or insolvency disposition would impair the subsequent right (§ 2115 sentence 1)"; }
pub relation zwangsverfuegung_bei_nacherbfolge_unwirksam_2115(t: Testament) kind derived { label de official "Die Zwangsverfügung ist beim Eintritt der Nacherbfolge insoweit unwirksam (§ 2115 Satz 1)"; label en unofficial "the coercive disposition is ineffective to that extent upon subsequent succession (§ 2115 sentence 1)"; }
pub relation nacherbe_verlangt_hinterlegung_inhaberpapiere_2116(t: Testament, vorerbe: Person) kind empirical { label de official "Der Nacherbe verlangt Hinterlegung erbschaftlicher Inhaberpapiere (§ 2116 Abs. 1)"; label en unofficial "the subsequent heir demands deposit of estate bearer securities (§ 2116 (1))"; }
pub relation vorerbe_muss_papiere_mit_zustimmungsvorbehalt_hinterlegen_2116(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe muss die Papiere mit Zustimmungsvorbehalt hinterlegen (§ 2116 Abs. 1)"; label en unofficial "the prior heir must deposit the securities subject to consent (§ 2116 (1))"; }
pub relation vorerbe_ueber_hinterlegte_papiere_verfuegt_2116(t: Testament, vorerbe: Person) kind empirical { label de official "Der Vorerbe verfügt über hinterlegte Papiere (§ 2116 Abs. 2)"; label en unofficial "the prior heir disposes of deposited securities (§ 2116 (2))"; }
pub relation verfuegung_hinterlegte_papiere_nur_mit_zustimmung_2116(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe kann über hinterlegte Papiere nur mit Zustimmung des Nacherben verfügen (§ 2116 Abs. 2)"; label en unofficial "the prior heir may dispose of deposited securities only with the subsequent heir's consent (§ 2116 (2))"; }
pub relation vorerbe_waehlt_umschreibung_oder_umwandlung_2117(t: Testament, vorerbe: Person) kind empirical { label de official "Der Vorerbe wählt Umschreibung oder zulässige Umwandlung statt Hinterlegung (§ 2117)"; label en unofficial "the prior heir elects registration or permitted conversion instead of deposit (§ 2117)"; }
pub relation umschreibung_oder_umwandlung_zulaessig_2117(t: Testament, vorerbe: Person) kind derived { label de official "Umschreibung oder Umwandlung mit Zustimmungsvorbehalt ist zulässig (§ 2117)"; label en unofficial "registration or conversion subject to consent is permitted (§ 2117)"; }
pub relation nacherbe_verlangt_sperrvermerk_2118(t: Testament, vorerbe: Person) kind empirical { label de official "Der Nacherbe verlangt Sperrvermerk für Buchforderung des Bundes oder Landes (§ 2118)"; label en unofficial "the subsequent heir demands a blocking notation for a federal or Land book claim (§ 2118)"; }
pub relation vorerbe_muss_sperrvermerk_eintragen_2118(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe muss den Sperrvermerk eintragen lassen (§ 2118)"; label en unofficial "the prior heir must have the blocking notation entered (§ 2118)"; }
pub relation dauerhaft_anzulegendes_geld_2119(t: Testament, vorerbe: Person) kind empirical { label de official "Geld der Erbschaft ist nach ordnungsmäßiger Wirtschaft dauerhaft anzulegen (§ 2119)"; label en unofficial "estate money must be invested permanently under prudent management (§ 2119)"; }
pub relation geldanlage_nach_240a_erforderlich_2119(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe darf das Geld nur entsprechend § 240a anlegen (§ 2119)"; label en unofficial "the prior heir may invest the money only in accordance with § 240a (§ 2119)"; }
pub relation ordnungsmaessige_verwaltung_braucht_nacherben_einwilligung_2120(t: Testament, vorerbe: Person) kind empirical { label de official "Zur ordnungsmäßigen Verwaltung ist eine sonst nicht nacherbenwirksame Verfügung erforderlich (§ 2120)"; label en unofficial "prudent administration requires a disposition otherwise ineffective against the subsequent heir (§ 2120)"; }
pub relation nacherbe_muss_einwilligen_2120(t: Testament, vorerbe: Person) kind derived { label de official "Der Nacherbe ist zur Einwilligung verpflichtet (§ 2120)"; label en unofficial "the subsequent heir is obliged to consent (§ 2120)"; }
pub relation nacherbe_verlangt_verzeichnis_2121(t: Testament, vorerbe: Person) kind empirical { label de official "Der Nacherbe verlangt Verzeichnis der Erbschaftsgegenstände (§ 2121 Abs. 1)"; label en unofficial "the subsequent heir demands an inventory of estate assets (§ 2121 (1))"; }
pub relation vorerbe_muss_verzeichnis_mitteilen_2121(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe muss das Verzeichnis mitteilen (§ 2121 Abs. 1)"; label en unofficial "the prior heir must provide the inventory (§ 2121 (1))"; }
pub relation zustand_durch_sachverstaendige_feststellen_2122(t: Testament, p: Person) kind empirical { label de official "Vorerbe oder Nacherbe will den Zustand der Erbschaft durch Sachverständige feststellen lassen (§ 2122)"; label en unofficial "the prior or subsequent heir wishes to have estate condition determined by experts (§ 2122)"; }
pub relation zustandsfeststellung_zulaessig_2122(t: Testament, p: Person) kind derived { label de official "Die Zustandsfeststellung durch Sachverständige ist zulässig (§ 2122)"; label en unofficial "determination of condition by experts is permitted (§ 2122)"; }
pub relation wald_oder_bodenabbauanlage_in_erbschaft_2123(t: Testament) kind empirical { label de official "Zur Erbschaft gehört Wald oder eine auf Bodenabbau gerichtete Anlage (§ 2123)"; label en unofficial "the estate includes forest or an extraction installation (§ 2123)"; }
pub relation wirtschaftsplan_verlangt_2123(t: Testament) kind empirical { label de official "Vorerbe oder Nacherbe verlangt Wirtschaftsplan (§ 2123)"; label en unofficial "the prior or subsequent heir demands an economic plan (§ 2123)"; }
pub relation wirtschaftsplan_festzustellen_2123(t: Testament) kind derived { label de official "Maß der Nutzung und wirtschaftliche Behandlung sind durch Wirtschaftsplan festzustellen (§ 2123)"; label en unofficial "the measure of use and economic treatment must be set by an economic plan (§ 2123)"; }
pub relation gewoehnliche_erhaltungskosten_2124(t: Testament, vorerbe: Person) kind empirical { label de official "Es fallen gewöhnliche Erhaltungskosten an (§ 2124 Abs. 1)"; label en unofficial "ordinary maintenance costs arise (§ 2124 (1))"; }
pub relation vorerbe_traegt_gewoehnliche_erhaltungskosten_2124(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe trägt die gewöhnlichen Erhaltungskosten (§ 2124 Abs. 1)"; label en unofficial "the prior heir bears ordinary maintenance costs (§ 2124 (1))"; }
pub relation nicht_2124_verwendung_gemacht_2125(t: Testament, vorerbe: Person) kind empirical { label de official "Der Vorerbe macht eine nicht von § 2124 erfasste Verwendung auf die Erbschaft (§ 2125 Abs. 1)"; label en unofficial "the prior heir makes an expenditure not covered by § 2124 (§ 2125 (1))"; }
pub relation nacherbe_muss_verwendung_ersetzen_2125(t: Testament, vorerbe: Person) kind derived { label de official "Der Nacherbe muss die Verwendung bei Eintritt der Nacherbfolge nach GoA-Regeln ersetzen (§ 2125 Abs. 1)"; label en unofficial "the subsequent heir must reimburse the expenditure under agency-without-authority rules upon succession (§ 2125 (1))"; }
pub relation ausserordentliche_stammwertlast_2126(t: Testament, vorerbe: Person) kind empirical { label de official "Es liegt eine außerordentliche auf den Stammwert gelegte Last vor (§ 2126)"; label en unofficial "an extraordinary burden on capital value exists (§ 2126)"; }
pub relation vorerbe_traegt_ausserordentliche_last_nicht_2126(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe trägt die außerordentliche Last im Verhältnis zum Nacherben nicht (§ 2126)"; label en unofficial "the prior heir does not bear the extraordinary burden vis-à-vis the subsequent heir (§ 2126)"; }
pub relation verwaltung_gefaehrdet_nacherbrecht_2127(t: Testament, vorerbe: Person) kind empirical { label de official "Grund besteht anzunehmen, dass die Verwaltung die Nacherbenrechte erheblich verletzt (§ 2127)"; label en unofficial "there is reason to believe administration substantially harms the subsequent right (§ 2127)"; }
pub relation nacherbe_darf_auskunft_verlangen_2127(t: Testament, vorerbe: Person) kind derived { label de official "Der Nacherbe darf Auskunft über den Bestand der Erbschaft verlangen (§ 2127)"; label en unofficial "the subsequent heir may demand information about estate composition (§ 2127)"; }
pub relation verhalten_oder_vermoegenslage_besorgnis_2128(t: Testament, vorerbe: Person) kind empirical { label de official "Verhalten oder Vermögenslage des Vorerben begründet Besorgnis erheblicher Rechtsverletzung (§ 2128 Abs. 1)"; label en unofficial "the prior heir's conduct or assets give rise to concern of substantial harm (§ 2128 (1))"; }
pub relation nacherbe_darf_sicherheit_verlangen_2128(t: Testament, vorerbe: Person) kind derived { label de official "Der Nacherbe darf Sicherheitsleistung verlangen (§ 2128 Abs. 1)"; label en unofficial "the subsequent heir may demand security (§ 2128 (1))"; }
pub relation vorerbe_verwaltung_entzogen_2129(t: Testament, vorerbe: Person) kind empirical { label de official "Dem Vorerben ist die Verwaltung nach § 1052 entzogen (§ 2129 Abs. 1)"; label en unofficial "administration was withdrawn from the prior heir under § 1052 (§ 2129 (1))"; }
pub relation vorerbe_verliert_verfuegungsrecht_2129(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe verliert das Recht, über Erbschaftsgegenstände zu verfügen (§ 2129 Abs. 1)"; label en unofficial "the prior heir loses the right to dispose of estate assets (§ 2129 (1))"; }
pub relation nacherbfolge_eingetreten_2130(t: Testament, vorerbe: Person) kind empirical { label de official "Der Fall der Nacherbfolge ist eingetreten (§ 2130)"; label en unofficial "the event of subsequent succession has occurred (§ 2130)"; }
pub relation vorerbe_muss_ordentlich_verwaltete_erbschaft_herausgeben_2130(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe muss die Erbschaft im Zustand fortgesetzter ordnungsmäßiger Verwaltung herausgeben (§ 2130 Abs. 1)"; label en unofficial "the prior heir must hand over the estate in the state of continued prudent administration (§ 2130 (1))"; }
pub relation nacherbe_verlangt_rechenschaft_2130(t: Testament, vorerbe: Person) kind empirical { label de official "Der Nacherbe verlangt Rechenschaft (§ 2130 Abs. 2)"; label en unofficial "the subsequent heir demands an account (§ 2130 (2))"; }
pub relation vorerbe_muss_rechenschaft_ablegen_2130(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe muss Rechenschaft ablegen (§ 2130 Abs. 2)"; label en unofficial "the prior heir must render an account (§ 2130 (2))"; }
pub relation vorerbe_wendet_eigene_sorgfalt_an_2131(t: Testament, vorerbe: Person) kind empirical { label de official "Der Vorerbe wendet die in eigenen Angelegenheiten übliche Sorgfalt an (§ 2131)"; label en unofficial "the prior heir applies the care usual in their own affairs (§ 2131)"; }
pub relation vorerbe_sorgfaltspflicht_erfuellt_2131(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe erfüllt seine Sorgfaltspflicht gegenüber dem Nacherben (§ 2131)"; label en unofficial "the prior heir fulfils their duty of care toward the subsequent heir (§ 2131)"; }
pub relation ordnungsmaessige_nutzung_verursacht_abnutzung_2132(t: Testament, vorerbe: Person) kind empirical { label de official "Ordnungsmäßige Benutzung verursacht Veränderung oder Verschlechterung (§ 2132)"; label en unofficial "proper use causes alteration or deterioration (§ 2132)"; }
pub relation vorerbe_nicht_haftbar_gewoehnliche_abnutzung_2132(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe hat gewöhnliche Abnutzung nicht zu vertreten (§ 2132)"; label en unofficial "the prior heir is not liable for ordinary wear (§ 2132)"; }
pub relation vorerbe_verwendet_erbschaftsgegenstand_fuer_sich_2134(t: Testament, vorerbe: Person) kind empirical { label de official "Der Vorerbe verwendet einen Erbschaftsgegenstand für sich (§ 2134)"; label en unofficial "the prior heir uses an estate asset for themselves (§ 2134)"; }
pub relation vorerbe_muss_wert_ersetzen_2134(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe muss nach Eintritt der Nacherbfolge den Wert ersetzen (§ 2134)"; label en unofficial "the prior heir must compensate value after subsequent succession (§ 2134)"; }
pub relation erblasser_befreit_vorerbe_2136(t: Testament, vorerbe: Person) kind empirical { label de official "Der Erblasser befreit den Vorerben von gesetzlichen Beschränkungen und Verpflichtungen (§ 2136)"; label en unofficial "the testator releases the prior heir from statutory restrictions and duties (§ 2136)"; }
pub relation befreiung_vorerbe_wirksam_2136(t: Testament, vorerbe: Person) kind derived { label de official "Die Befreiung des Vorerben ist wirksam (§ 2136)"; label en unofficial "the prior heir's release is effective (§ 2136)"; }
pub relation nacherbe_auf_restbestand_eingesetzt_2137(t: Testament, vorerbe: Person) kind empirical { label de official "Der Nacherbe ist auf den beim Eintritt noch übrigen Bestand eingesetzt (§ 2137 Abs. 1)"; label en unofficial "the subsequent heir is appointed to what remains at succession (§ 2137 (1))"; }
pub relation vollbefreiung_vorerbe_vermutet_2137(t: Testament, vorerbe: Person) kind derived { label de official "Die Befreiung von allen § 2136-Beschränkungen gilt als angeordnet (§ 2137)"; label en unofficial "release from all § 2136 restrictions is deemed ordered (§ 2137)"; }
pub relation befreiter_vorerbe_besitzt_nur_restgegenstaende_2138(t: Testament, vorerbe: Person) kind empirical { label de official "Beim befreiten Vorerben sind nur noch bestimmte Erbschaftsgegenstände vorhanden (§ 2138 Abs. 1)"; label en unofficial "only certain estate assets remain with the released prior heir (§ 2138 (1))"; }
pub relation herausgabepflicht_nur_restgegenstaende_2138(t: Testament, vorerbe: Person) kind derived { label de official "Die Herausgabepflicht beschränkt sich auf die noch vorhandenen Erbschaftsgegenstände (§ 2138 Abs. 1)"; label en unofficial "the handover duty is limited to remaining estate assets (§ 2138 (1))"; }
pub relation nacherbfolge_eingetreten_2139(t: Testament, vorerbe: Person) kind empirical { label de official "Der Fall der Nacherbfolge ist eingetreten (§ 2139)"; label en unofficial "the event of subsequent succession has occurred (§ 2139)"; }
pub relation vorerbe_hoert_auf_erbe_zu_sein_2139(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe hört auf, Erbe zu sein; die Erbschaft fällt dem Nacherben an (§ 2139)"; label en unofficial "the prior heir ceases to be heir and the estate devolves on the subsequent heir (§ 2139)"; }
pub relation vorerbe_nacherbfolge_noch_nicht_bekannt_2140(t: Testament, vorerbe: Person) kind empirical { label de official "Der Vorerbe kennt den Eintritt der Nacherbfolge nicht und muss ihn nicht kennen (§ 2140)"; label en unofficial "the prior heir does not know and need not know of subsequent succession (§ 2140)"; }
pub relation vorerbe_darf_bis_kenntnis_wie_bisher_verfuegen_2140(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe darf bis zur Kenntnis im bisherigen Umfang verfügen (§ 2140)"; label en unofficial "the prior heir may dispose to the prior extent until knowledge (§ 2140)"; }
pub relation geburt_nacherbe_beim_eintritt_zu_erwarten_2141(t: Testament) kind empirical { label de official "Beim Eintritt der Nacherbfolge ist die Geburt eines Nacherben zu erwarten (§ 2141)"; label en unofficial "at subsequent succession, birth of a subsequent heir is expected (§ 2141)"; }
pub relation mutterunterhalt_nach_1963_anwendbar_2141(t: Testament) kind derived { label de official "§ 1963 gilt für den Unterhaltsanspruch der Mutter entsprechend (§ 2141)"; label en unofficial "§ 1963 applies mutatis mutandis to the mother's maintenance claim (§ 2141)"; }
pub relation erbfall_eingetreten_nacherbe_2142(t: Testament, nacherbe: Person) kind empirical { label de official "Der Erbfall ist eingetreten (§ 2142 Abs. 1)"; label en unofficial "the devolution has occurred (§ 2142 (1))"; }
pub relation nacherbe_darf_ausschlagen_2142(t: Testament, nacherbe: Person) kind derived { label de official "Der Nacherbe darf die Erbschaft ausschlagen (§ 2142 Abs. 1)"; label en unofficial "the subsequent heir may disclaim the inheritance (§ 2142 (1))"; }
pub relation nacherbe_hat_ausgeschlagen_2142(t: Testament, nacherbe: Person) kind empirical { label de official "Der Nacherbe hat die Erbschaft ausgeschlagen (§ 2142 Abs. 2)"; label en unofficial "the subsequent heir disclaimed the inheritance (§ 2142 (2))"; }
pub relation erbschaft_verbleibt_vorerben_2142(t: Testament, nacherbe: Person) kind derived { label de official "Die Erbschaft verbleibt dem Vorerben (§ 2142 Abs. 2)"; label en unofficial "the inheritance remains with the prior heir (§ 2142 (2))"; }
pub relation nacherbfolge_eingetreten_2143(t: Testament) kind empirical { label de official "Die Nacherbfolge ist eingetreten (§ 2143)"; label en unofficial "subsequent succession has occurred (§ 2143)"; }
pub relation erloschene_rechtsverhaeltnisse_leben_wieder_2143(t: Testament) kind derived { label de official "Durch Vereinigung erloschene Rechtsverhältnisse gelten als nicht erloschen (§ 2143)"; label en unofficial "legal relationships extinguished by merger are deemed not extinguished (§ 2143)"; }
pub relation nacherbe_hat_erbschaft_erlangt_2144(t: Testament, nacherbe: Person) kind empirical { label de official "Der Nacherbe hat etwas aus der Erbschaft erlangt (§ 2144 Abs. 1)"; label en unofficial "the subsequent heir obtained something from the estate (§ 2144 (1))"; }
pub relation haftungsbeschraenkung_fuer_nacherbe_2144(t: Testament, nacherbe: Person) kind derived { label de official "Die Haftungsbeschränkung für Nachlassverbindlichkeiten gilt für den Nacherben (§ 2144 Abs. 1)"; label en unofficial "limitation of liability for estate debts applies to the subsequent heir (§ 2144 (1))"; }
pub relation nacherbe_haftet_nicht_fuer_verbindlichkeit_2145(t: Testament, nacherbe: Person, vorerbe: Person) kind empirical { label de official "Der Nacherbe haftet für eine Nachlassverbindlichkeit nicht (§ 2145 Abs. 1)"; label en unofficial "the subsequent heir is not liable for an estate debt (§ 2145 (1))"; }
pub relation vorerbe_haftet_weiter_2145(t: Testament, vorerbe: Person) kind derived { label de official "Der Vorerbe haftet nach Eintritt der Nacherbfolge insoweit weiter (§ 2145 Abs. 1)"; label en unofficial "the prior heir remains liable to that extent after succession (§ 2145 (1))"; }
pub relation nacherbfolge_nachlassgericht_angezeigt_2146(t: Testament, vorerbe: Person) kind empirical { label de official "Der Eintritt der Nacherbfolge ist dem Nachlassgericht angezeigt (§ 2146 Abs. 1)"; label en unofficial "subsequent succession was notified to the probate court (§ 2146 (1))"; }
pub relation anzeigepflicht_erfuellt_2146(t: Testament, vorerbe: Person) kind derived { label de official "Die Anzeigepflicht gegenüber Nachlassgläubigern ist erfüllt (§ 2146 Abs. 1)"; label en unofficial "the notification duty toward estate creditors is fulfilled (§ 2146 (1))"; }
pub relation erbe_oder_vermaechtnisnehmer_mit_vermaechtnis_beschwert_2147(t: Testament, p: Person) kind empirical { label de official "Ein Erbe oder Vermächtnisnehmer ist mit Vermächtnis beschwert (§ 2147)"; label en unofficial "an heir or legatee is burdened with a legacy (§ 2147)"; }
pub relation beschwerung_mit_vermaechtnis_zulaessig_2147(t: Testament, p: Person) kind derived { label de official "Die Beschwerung mit Vermächtnis ist zulässig (§ 2147)"; label en unofficial "the burdening with a legacy is permitted (§ 2147)"; }
pub relation mehrere_erben_oder_vermaechtnisnehmer_beschwert_2148(t: Testament) kind empirical { label de official "Mehrere Erben oder Vermächtnisnehmer sind mit demselben Vermächtnis beschwert (§ 2148)"; label en unofficial "multiple heirs or legatees are burdened by the same legacy (§ 2148)"; }
pub relation beschwerung_nach_erbteil_oder_vermaechtniswert_vermutet_2148(t: Testament) kind derived { label de official "Die Beschwerung gilt im Zweifel nach Erbteil oder Vermächtniswert verteilt (§ 2148)"; label en unofficial "the burden is in case of doubt apportioned by inheritance share or legacy value (§ 2148)"; }
pub relation eingesetzter_erbe_gegenstand_nicht_erhalten_soll_2149(t: Testament) kind empirical { label de official "Ein eingesetzter Erbe soll einen Erbschaftsgegenstand nicht erhalten (§ 2149)"; label en unofficial "an appointed heir is not to receive an estate asset (§ 2149)"; }
pub relation gegenstand_gesetzlichen_erben_vermacht_2149(t: Testament) kind derived { label de official "Der Gegenstand gilt den gesetzlichen Erben als vermacht (§ 2149)"; label en unofficial "the asset is deemed bequeathed to statutory heirs (§ 2149)"; }
pub relation erbe_erhaelt_vorausvermaechtnis_2150(t: Testament, p: Person) kind empirical { label de official "Ein Erbe erhält ein Vermächtnis als Vorausvermächtnis (§ 2150)"; label en unofficial "an heir receives a legacy as an advance legacy (§ 2150)"; }
pub relation vorausvermaechtnis_gilt_auch_bei_eigener_beschwerung_2150(t: Testament, p: Person) kind derived { label de official "Das Vorausvermächtnis gilt auch bei eigener Beschwerung des Erben als Vermächtnis (§ 2150)"; label en unofficial "the advance legacy remains a legacy even when the heir is themselves burdened (§ 2150)"; }
pub relation mehrere_bedachte_bestimmung_durch_beschwerten_oder_dritten_2151(t: Testament) kind empirical { label de official "Mehrere Bedachte; Beschwerter oder Dritter soll Empfänger bestimmen (§ 2151 Abs. 1)"; label en unofficial "multiple beneficiaries; burdened person or third party is to determine recipient (§ 2151 (1))"; }
pub relation bestimmung_nicht_treffbar_2151(t: Testament) kind empirical { label de official "Beschwerter oder Dritter kann die Bestimmung nicht treffen (§ 2151 Abs. 3)"; label en unofficial "the burdened person or third party cannot make the determination (§ 2151 (3))"; }
pub relation bedachte_gesamtglaeubiger_2151(t: Testament) kind derived { label de official "Die Bedachten sind Gesamtgläubiger (§ 2151 Abs. 3)"; label en unofficial "the beneficiaries are joint creditors (§ 2151 (3))"; }
pub relation mehrere_wahlweise_bedachte_2152(t: Testament) kind empirical { label de official "Mehrere sind wahlweise mit Vermächtnis bedacht (§ 2152)"; label en unofficial "multiple persons are alternatively bequeathed a legacy (§ 2152)"; }
pub relation beschwerter_bestimmt_wahlbedachten_vermutet_2152(t: Testament) kind derived { label de official "Der Beschwerte soll im Zweifel bestimmen, wer das Vermächtnis erhält (§ 2152)"; label en unofficial "the burdened person determines the recipient in case of doubt (§ 2152)"; }
pub relation anteilsbestimmung_nicht_treffbar_2153(t: Testament) kind empirical { label de official "Bestimmung der Anteile mehrerer Bedachter ist nicht treffbar (§ 2153 Abs. 2)"; label en unofficial "allocation of multiple beneficiaries' shares cannot be made (§ 2153 (2))"; }
pub relation bedachte_zu_gleichen_teilen_berechtigt_2153(t: Testament) kind derived { label de official "Die Bedachten sind zu gleichen Teilen berechtigt (§ 2153 Abs. 2)"; label en unofficial "the beneficiaries are entitled in equal shares (§ 2153 (2))"; }
pub relation wahlvermaechtnis_dritter_kann_wahl_nicht_treffen_2154(t: Testament) kind empirical { label de official "Bei Wahlvermächtnis kann der Dritte die Wahl nicht treffen (§ 2154 Abs. 2)"; label en unofficial "in an elective legacy, the third party cannot make the election (§ 2154 (2))"; }
pub relation wahlrecht_geht_auf_beschwerten_ueber_2154(t: Testament) kind derived { label de official "Das Wahlrecht geht auf den Beschwerten über (§ 2154 Abs. 2)"; label en unofficial "the right of election passes to the burdened person (§ 2154 (2))"; }
pub relation gattungsvermaechtnis_angeordnet_2155(t: Testament) kind empirical { label de official "Die vermachte Sache ist nur der Gattung nach bestimmt (§ 2155 Abs. 1)"; label en unofficial "the bequeathed item is specified only by kind (§ 2155 (1))"; }
pub relation passende_gattungssache_zu_leisten_2155(t: Testament) kind derived { label de official "Eine den Verhältnissen des Bedachten entsprechende Sache ist zu leisten (§ 2155 Abs. 1)"; label en unofficial "an item appropriate to the beneficiary's circumstances must be performed (§ 2155 (1))"; }
pub relation zweckvermaechtnis_leistung_nach_billigem_ermessen_2156(t: Testament) kind empirical { label de official "Bei Zweckvermächtnis ist Leistungsbestimmung billigem Ermessen überlassen (§ 2156)"; label en unofficial "for a purpose legacy, performance determination is left to equitable discretion (§ 2156)"; }
pub relation vorschriften_315_bis_319_anwendbar_2156(t: Testament) kind derived { label de official "§§ 315 bis 319 sind auf das Zweckvermächtnis anwendbar (§ 2156)"; label en unofficial "§§ 315 through 319 apply to the purpose legacy (§ 2156)"; }
pub relation eigenhaendig_geschrieben_2247(t: Testament, errichter: Person) kind empirical {
    label de official "Der Erblasser hat das Testament eigenhändig geschrieben (§ 2247 Abs. 1)";
    label en unofficial "the testator personally wrote the will (§ 2247 (1))";
}
pub relation eigenhaendig_unterschrieben_2247(t: Testament, errichter: Person) kind empirical {
    label de official "Der Erblasser hat das Testament eigenhändig unterschrieben (§ 2247 Abs. 1)";
    label en unofficial "the testator personally signed the will (§ 2247 (1))";
}
pub relation eigenhaendiges_testament_formwirksam(t: Testament, errichter: Person) kind derived {
    label de official "Das Testament erfüllt die eigenhändige Form (§ 2247 Abs. 1)";
    label en unofficial "the will satisfies the handwritten form (§ 2247 (1))";
}
pub relation testament_widerrufen_durch_neues_2253(t: Testament) kind empirical {
    label de official "Das Testament ist durch Testament widerrufen (§ 2253)";
    label en unofficial "the will is revoked by a will (§ 2253)";
}
pub relation testament_vernichtet_mit_widerrufsabsicht_2253(t: Testament) kind empirical {
    label de official "Das Testament ist durch eine Handlung des Erblassers mit Widerrufsabsicht vernichtet (§ 2255 Satz 1)";
    label en unofficial "the will was destroyed by the testator with intent to revoke (§ 2255 sentence 1)";
}
pub relation testament_widerrufen(t: Testament) kind derived {
    label de official "Das Testament ist widerrufen (§§ 2253, 2255)";
    label en unofficial "the will is revoked (§§ 2253, 2255)";
}
pub relation gemeinschaftliches_testament_errichtet(t: Testament, erster: Person, zweiter: Person) kind empirical {
    label de official "Zwei Personen haben ein gemeinschaftliches Testament errichtet (§ 2265)";
    label en unofficial "two persons made a joint will (§ 2265)";
}
pub relation zum_errichtungszeitpunkt_verheiratet_2265(erster: Person, zweiter: Person, t: Testament) kind empirical {
    label de official "Die beiden Errichter waren zur Zeit der Errichtung miteinander verheiratet (§ 2265)";
    label en unofficial "the two makers were married to each other when the joint will was made (§ 2265)";
}
pub relation gemeinschaftliches_testament_zulaessig(t: Testament) kind derived {
    label de official "Das gemeinschaftliche Testament ist den Errichtern nach § 2265 eröffnet";
    label en unofficial "the joint will is available to its makers under § 2265";
}
pub entity Erbvertrag {
    label de official "Vertrag über eine Erbeinsetzung, ein Vermächtnis oder eine Auflage (§§ 2274 ff.)";
    label en unofficial "contract concerning an appointment of heir, legacy or charge (§§ 2274 ff.)";
}
pub relation erbvertrag_persoenlich_geschlossen(v: Erbvertrag, person: Person) kind empirical {
    label de official "Die Person hat den Erbvertrag persönlich geschlossen (§ 2274)";
    label en unofficial "the person concluded the inheritance contract personally (§ 2274)";
}
pub relation erbvertrag_persoenlich_formwirksam(v: Erbvertrag, person: Person) kind derived {
    label de official "Der Erbvertrag erfüllt das Erfordernis des persönlichen Abschlusses (§ 2274)";
    label en unofficial "the inheritance contract meets the requirement of personal conclusion (§ 2274)";
}
pub relation erbvertrag_notariell_beurkundet_2276(v: Erbvertrag) kind empirical {
    label de official "Der Erbvertrag ist notariell beurkundet (§ 2276 Abs. 1)";
    label en unofficial "the inheritance contract was notarised (§ 2276 (1))";
}
pub relation vertragschliessende_gleichzeitig_anwesend_2276(v: Erbvertrag) kind empirical {
    label de official "Die Vertragschließenden waren bei der Beurkundung gleichzeitig anwesend (§ 2276 Abs. 1)";
    label en unofficial "the contracting parties were simultaneously present at notarisation (§ 2276 (1))";
}
pub relation erbvertrag_notarielle_form_gewahrt(v: Erbvertrag) kind derived {
    label de official "Der Erbvertrag erfüllt notarielle Beurkundung und gleichzeitige Anwesenheit (§ 2276 Abs. 1)";
    label en unofficial "the inheritance contract satisfies notarisation and simultaneous presence (§ 2276 (1))";
}
pub relation verfuegung_unter_leben_trotz_erbvertrag(v: Erbvertrag, person: Person) kind empirical {
    label de official "Der Erblasser nimmt trotz Erbvertrags eine Verfügung unter Lebenden vor (§ 2286)";
    label en unofficial "the testator makes an inter vivos disposition despite the inheritance contract (§ 2286)";
}
pub relation verfuegung_unter_leben_unberuehrt_2286(v: Erbvertrag, person: Person) kind derived {
    label de official "Das Recht des Erblassers, über sein Vermögen durch Rechtsgeschäft unter Lebenden zu verfügen, wird durch den Erbvertrag nicht beschränkt (§ 2286)";
    label en unofficial "the testator's right to dispose inter vivos is not restricted by the inheritance contract (§ 2286)";
}
@source(BGB_P2229)
pub external judgment relation geistestoerung_testierunfaehig_2229(p: Person, tag: Date) {
    authority Court;
    label de official "Die Person ist wegen krankhafter Störung der Geistestätigkeit, Geistesschwäche oder Bewusstseinsstörung nicht in der Lage, die Bedeutung einer von ihr abgegebenen Willenserklärung einzusehen und nach dieser Einsicht zu handeln (§ 2229 Abs. 4)";
    label en unofficial "because of mental disorder, mental weakness or disturbance of consciousness, the person cannot understand and act on the significance of their declaration (§ 2229 (4))";
}

@source(BGB_P2303) {
    rule PflichtteilsberechtigterAbkoemmling(e: Erbfall, p: Person, n: Integer) strict {
        label de official "Ist ein Abkömmling des Erblassers durch Verfügung von Todes wegen von der Erbfolge ausgeschlossen, so kann er von dem Erben den Pflichtteil verlangen (§ 2303 Abs. 1 Satz 1)";
        label en unofficial "If a descendant of the decedent is excluded from succession by disposition mortis causa, he may demand the compulsory portion from the heir (§ 2303 (1) sentence 1)";
        when de.bgb.erbfolge::abkoemmling(e, p, n) and de.bgb.erbfolge::erbfaehig(e, p)
            and durch_verfuegung_von_todes_wegen_ausgeschlossen(e, p);
        then pflichtteilsberechtigt(e, p);
    }
    rule PflichtteilsberechtigterElternteil(e: Erbfall, p: Person) strict {
        label de official "Das gleiche Recht steht den Eltern des Erblassers zu, wenn sie durch Verfügung von Todes wegen von der Erbfolge ausgeschlossen sind (§ 2303 Abs. 2 Satz 1)";
        label en unofficial "The same right belongs to the decedent's parents when excluded by disposition mortis causa (§ 2303 (2) sentence 1)";
        when de.bgb.erbfolge::elternteil(e, p) and de.bgb.erbfolge::erbfaehig(e, p)
            and durch_verfuegung_von_todes_wegen_ausgeschlossen(e, p);
        then pflichtteilsberechtigt(e, p);
    }
    rule PflichtteilsberechtigterEhegatte(e: Erbfall, p: Person) strict {
        label de official "Das gleiche Recht steht dem Ehegatten des Erblassers zu, wenn er durch Verfügung von Todes wegen von der Erbfolge ausgeschlossen ist (§ 2303 Abs. 2 Satz 1); die Vorschrift des § 1371 bleibt unberührt (Satz 2)";
        label en unofficial "The same right belongs to the decedent's spouse when excluded by disposition mortis causa (§ 2303 (2) sentence 1); § 1371 remains unaffected (sentence 2)";
        when de.bgb.erbfolge::ueberlebender_ehegatte(e, p) and durch_verfuegung_von_todes_wegen_ausgeschlossen(e, p);
        then pflichtteilsberechtigt(e, p);
    }
    rule PflichtteilsquoteHaelfte(e: Erbfall, p: Person, z: Integer, n: Integer) strict {
        label de official "Der Pflichtteil besteht in der Hälfte des Wertes des gesetzlichen Erbteils (§ 2303 Abs. 1 Satz 2); der Erbteil wird mit den durch Verfügung Ausgeschlossenen festgestellt (§ 2310 Satz 1)";
        label en unofficial "The compulsory portion consists of half the value of the statutory share (§ 2303 (1) sentence 2); the share is determined counting those excluded by disposition (§ 2310 sentence 1)";
        when pflichtteilsberechtigt(e, p) and de.bgb.erbfolge::gesetzlicher_erbteil_bruch(e, p, z, n);
        then pflichtteilsquote_bruch(e, p, z, n * 2);
    }
    rule PflichtteilsquoteAlsBruch(e: Erbfall, p: Person, z: Integer, n: Integer) strict {
        label de official "Pflichtteilsquote als exakter Bruch";
        label en unofficial "compulsory-portion quota as an exact fraction";
        when pflichtteilsquote_bruch(e, p, z, n);
        then pflichtteilsquote(e, p, z / n);
    }
}

@source(BGB_P2311)
rule PflichtteilAlsGeld(e: Erbfall, p: Person, z: Integer, n: Integer, w: Money) strict {
    label de official "Der Berechnung des Pflichtteils wird der Bestand und der Wert des Nachlasses zur Zeit des Erbfalls zugrunde gelegt (§ 2311 Abs. 1 Satz 1): Nachlasswert × Quote, einmal auf den Cent gerundet (kaufmännisch; Politik des Pakets, keine Norm)";
    label en unofficial "The compulsory portion is computed on the composition and value of the estate at the devolution (§ 2311 (1) sentence 1): estate value × quota, rounded once to the cent (half up; package policy, not a norm)";
    when pflichtteilsquote_bruch(e, p, z, n) and nachlasswert(e, w);
    then pflichtteil(e, p, div_round(w * z, n * 1.0, 2, "HALF_UP"));
}

@source(BGB_P2305)
rule Zusatzpflichtteilsquote(e: Erbfall, p: Person, z: Integer, n: Integer) strict {
    label de official "Ist einem Pflichtteilsberechtigten ein Erbteil hinterlassen, der geringer ist als die Hälfte des gesetzlichen Erbteils, kann er den fehlenden Wert verlangen (§ 2305 Satz 1): die Vergleichsquote ist die Hälfte des gesetzlichen Erbteils";
    label en unofficial "Where a compulsory-portion beneficiary was left a share smaller than half the statutory share, they may demand the missing value (§ 2305 sentence 1): the comparison quota is half the statutory share";
    when als_erbe_hinterlassener_pflichtteilsberechtigter(e, p) and de.bgb.erbfolge::gesetzlicher_erbteil_bruch(e, p, z, n);
    then zusatzpflichtteilsquote_bruch(e, p, z, n * 2);
}
@source(BGB_P2304)
presumption PflichtteilszuwendungKeineErbeinsetzung(e: Erbfall, p: Person) {
    label de official "Die Zuwendung des Pflichtteils ist im Zweifel nicht als Erbeinsetzung anzusehen (§ 2304)";
    label en unofficial "In case of doubt, a grant of the compulsory portion is not to be regarded as appointment as heir (§ 2304)";
    when zuwendung_des_pflichtteils_2304(e, p);
    presume zuwendung_nicht_als_erbeinsetzung_2304(e, p);
}
@source(BGB_P2305)
rule ZusatzpflichtteilAlsGeld(e: Erbfall, p: Person, z: Integer, n: Integer, nachlass: Money, hinterlassen: Money) strict {
    label de official "Ist der hinterlassene Erbteil geringer als die Hälfte des gesetzlichen Erbteils, kann der Pflichtteilsberechtigte von den Miterben den Wert des fehlenden Teils verlangen (§ 2305); Beschränkungen und Beschwerungen nach § 2306 bleiben außer Betracht; die Geldforderung wird einmal gerundet";
    label en unofficial "If the share left is smaller than half the statutory share, the beneficiary may demand the missing value from the co-heirs (§ 2305); § 2306 restrictions and encumbrances are disregarded; the money claim is rounded once";
    when zusatzpflichtteilsquote_bruch(e, p, z, n) and nachlasswert(e, nachlass) and hinterlassener_erbteil_wert(e, p, hinterlassen)
        and hinterlassen < div_round(nachlass * z, n * 1.0, 2, "HALF_UP");
    then zusatzpflichtteil(e, p, div_round(nachlass * z, n * 1.0, 2, "HALF_UP") - hinterlassen);
}

@source(BGB_P2306)
rule PflichtteilNachAusschlagungBeschraenkterErbteil(e: Erbfall, p: Person) strict {
    label de official "Ist ein als Erbe berufener Pflichtteilsberechtigter in der in § 2306 Abs. 1 bezeichneten Art beschränkt oder beschwert, so kann er den Pflichtteil verlangen, wenn er den Erbteil ausschlägt (§ 2306 Abs. 1 Satz 1)";
    label en unofficial "A compulsory-portion beneficiary called as heir who is restricted or encumbered as specified in § 2306 (1) may demand the compulsory portion if they disclaim the share (§ 2306 (1) sentence 1)";
    when als_erbe_hinterlassener_pflichtteilsberechtigter(e, p) and erbteil_beschraenkt_oder_beschwert_2306(e, p) and erbteil_ausgeschlagen_2306(e, p);
    then pflichtteil_nach_ausschlagung_verlangbar(e, p);
}
@source(BGB_P2307)
rule PflichtteilNachAusschlagungVermaechtnis(e: Erbfall, p: Person) strict {
    label de official "Ist ein Pflichtteilsberechtigter mit einem Vermächtnis bedacht, so kann er den Pflichtteil verlangen, wenn er das Vermächtnis ausschlägt (§ 2307 Abs. 1 Satz 1)";
    label en unofficial "A compulsory-portion beneficiary provided for by a legacy may demand the compulsory portion if they disclaim the legacy (§ 2307 (1) sentence 1)";
    when vermaechtnis_bedacht_2307(e, p) and vermaechtnis_ausgeschlagen_2307(e, p);
    then pflichtteil_nach_ausschlagung_verlangbar(e, p);
}

@source(BGB_P2317)
rule PflichtteilsanspruchEntstehtMitErbfall(e: Erbfall, p: Person) strict {
    label de official "Der Anspruch auf den Pflichtteil entsteht mit dem Erbfall (§ 2317 Abs. 1)";
    label en unofficial "The compulsory-portion claim arises with the devolution (§ 2317 (1))";
    when pflichtteilsberechtigt(e, p);
    then pflichtteilsanspruch_entstanden(e, p);
}
@source(BGB_P2317)
rule PflichtteilsanspruchIstUebertragbar(e: Erbfall, p: Person) strict {
    label de official "Der Anspruch ist vererblich und übertragbar (§ 2317 Abs. 2)";
    label en unofficial "The claim is inheritable and assignable (§ 2317 (2))";
    when pflichtteilsanspruch_entstanden(e, p);
    then pflichtteilsanspruch_vererblich_und_uebertragbar(e, p);
}

@source(BGB_P2309)
rule EntfernterPflichtteilAusgeschlossenBeiVerlangen(e: Erbfall, entfernter: Person, naeherer: Person) strict {
    label de official "Entferntere Abkömmlinge und die Eltern des Erblassers sind insoweit nicht pflichtteilsberechtigt, als ein Abkömmling, der sie bei gesetzlicher Erbfolge ausschließen würde, den Pflichtteil verlangen kann (§ 2309)";
    label en unofficial "More remote descendants and parents are not entitled to a compulsory portion to the extent that a descendant who would exclude them in intestacy may claim it (§ 2309)";
    when entfernter_pflichtteilsberechtigter_2309(e, entfernter) and naeherer_pflichtteilsberechtigter_verlangt(e, naeherer);
    then pflichtteilsrecht_2309_ausgeschlossen(e, entfernter);
}
@source(BGB_P2309)
rule EntfernterPflichtteilAusgeschlossenBeiAnnahme(e: Erbfall, entfernter: Person, naeherer: Person) strict {
    label de official "Entferntere Abkömmlinge und die Eltern des Erblassers sind insoweit nicht pflichtteilsberechtigt, als ein ausschließender Abkömmling das ihm Hinterlassene annimmt (§ 2309)";
    label en unofficial "More remote descendants and parents are not entitled to a compulsory portion to the extent that an excluding descendant accepts what was left to them (§ 2309)";
    when entfernter_pflichtteilsberechtigter_2309(e, entfernter) and naeherer_pflichtteilsberechtigter_nimmt_an(e, naeherer);
    then pflichtteilsrecht_2309_ausgeschlossen(e, entfernter);
}

@source(BGB_P2331a)
rule StundungBeiUnbilligerHaerte(e: Erbfall, erbe: Person) strict {
    label de official "Der Erbe kann Stundung des Pflichtteils verlangen, wenn die sofortige Erfüllung des gesamten Anspruchs für ihn wegen der Art der Nachlassgegenstände eine unbillige Härte wäre; die Interessen des Pflichtteilsberechtigten sind angemessen zu berücksichtigen (§ 2331a Abs. 1)";
    label en unofficial "The heir may request deferral where immediate performance would be an unreasonable hardship because of the estate assets; the beneficiary's interests must be appropriately considered (§ 2331a (1))";
    when erbe_verlangt_stundung_2331a(e, erbe) and sofortige_erfuellung_unbillige_haerte_2331a(e, erbe);
    then stundung_des_pflichtteils_verlangbar(e, erbe);
}

@source(BGB_P2333) {
    rule EntziehungWegenNachDemLebenTrachtens(e: Erbfall, p: Person) strict {
        label de official "Der Erblasser kann einem Abkömmling den Pflichtteil entziehen, wenn der Abkömmling einer in § 2333 Abs. 1 Nr. 1 bezeichneten Person nach dem Leben trachtet";
        label en unofficial "The decedent may withdraw the compulsory portion where the descendant attempts the life of a person under § 2333 (1) no. 1";
        when entziehung_durch_verfuegung_2336(e, p) and trachtet_nach_dem_leben_2333(e, p);
        then pflichtteil_entziehbar_2333(e, p);
    }
    rule EntziehungWegenSchwererStraftat(e: Erbfall, p: Person) strict {
        label de official "Der Erblasser kann einem Abkömmling den Pflichtteil entziehen, wenn dieser sich eines Verbrechens oder schweren vorsätzlichen Vergehens schuldig macht (§ 2333 Abs. 1 Nr. 2)";
        label en unofficial "The decedent may withdraw the compulsory portion where the descendant commits a crime or serious intentional offence (§ 2333 (1) no. 2)";
        when entziehung_durch_verfuegung_2336(e, p) and schwere_vorsaetzliche_straftat_2333(e, p);
        then pflichtteil_entziehbar_2333(e, p);
    }
    rule EntziehungWegenBoeswilligerUnterhaltsverletzung(e: Erbfall, p: Person) strict {
        label de official "Der Erblasser kann einem Abkömmling den Pflichtteil entziehen, wenn dieser seine gesetzliche Unterhaltspflicht böswillig verletzt (§ 2333 Abs. 1 Nr. 3)";
        label en unofficial "The decedent may withdraw the compulsory portion where the descendant maliciously breaches their statutory maintenance duty (§ 2333 (1) no. 3)";
        when entziehung_durch_verfuegung_2336(e, p) and unterhaltspflicht_boesswillig_verletzt_2333(e, p);
        then pflichtteil_entziehbar_2333(e, p);
    }
    rule EntziehungWegenVerurteilung(e: Erbfall, p: Person) strict {
        label de official "Der Erblasser kann einem Abkömmling den Pflichtteil entziehen bei rechtskräftiger Verurteilung wegen vorsätzlicher Straftat zu mindestens einem Jahr ohne Bewährung und Unzumutbarkeit der Teilhabe (§ 2333 Abs. 1 Nr. 4)";
        label en unofficial "The decedent may withdraw the compulsory portion after the specified final conviction and where participation is unreasonable (§ 2333 (1) no. 4)";
        when entziehung_durch_verfuegung_2336(e, p) and wegen_vorsaetzlicher_straftat_einjahr_verurteilt_2333(e, p) and teilhabe_am_nachlass_unzumutbar_2333(e, p);
        then pflichtteil_entziehbar_2333(e, p);
    }
}
@source(BGB_P2336)
rule EntziehungFormUndGrund(e: Erbfall, p: Person) strict {
    label de official "Die Entziehung erfolgt durch letztwillige Verfügung; der Grund muss zur Zeit der Errichtung bestehen und in der Verfügung angegeben werden (§ 2336 Abs. 1, 2)";
    label en unofficial "Withdrawal is by testamentary disposition; the ground must exist at its making and be stated in it (§ 2336 (1), (2))";
    when entziehung_durch_verfuegung_2336(e, p) and entziehungsgrund_zur_errichtung_bestehend_2336(e, p) and entziehungsgrund_in_verfuegung_angegeben_2336(e, p);
    then entziehung_formwirksam_2336(e, p);
}
@source(BGB_P2336)
rule BeweislastDerEntziehung(e: Erbfall, p: Person) strict {
    label de official "Der Beweis des Grundes liegt demjenigen ob, welcher die Entziehung geltend macht (§ 2336 Abs. 3)";
    label en unofficial "Proof of the ground is incumbent on the person asserting the withdrawal (§ 2336 (3))";
    when entziehung_durch_verfuegung_2336(e, p);
    then beweislast_entziehung_beim_geltendmachenden(e, p);
}
@source(BGB_P2346)
rule ErbverzichtSchliesstGesetzlicheErbfolgeAus(e: Erbfall, p: Person) strict {
    label de official "Verwandte sowie der Ehegatte des Erblassers können durch Vertrag mit dem Erblasser auf ihr gesetzliches Erbrecht verzichten (§ 2346 Abs. 1); der Verzicht auf den Pflichtteil ist zulässig (§ 2346 Abs. 2)";
    label en unofficial "Relatives and the spouse may renounce statutory succession by contract with the decedent (§ 2346 (1)); renunciation of the compulsory portion is permitted (§ 2346 (2))";
    when erbverzicht_vereinbart(e, p) and erbverzicht_notariell_beurkundet(e, p);
    then erbverzicht_wirksam(e, p);
}
@source(BGB_P2351)
rule ErbverzichtNurDurchVertragAufgehoben(e: Erbfall, p: Person) strict {
    label de official "Der Erblasser kann den Erbverzicht nur durch Vertrag mit dem Verzichtenden aufheben (§ 2351)";
    label en unofficial "The decedent may rescind a succession renunciation only by contract with the renunciant (§ 2351)";
    when erbverzicht_wirksam(e, p) and erbverzicht_aufhebungsvertrag(e, p);
    then erbverzicht_aufgehoben(e, p);
}
@source(BGB_P2365)
presumption VermutungDerRichtigkeitDesErbscheins(s: Erbschein, p: Person) {
    label de official "Es wird vermutet, dass demjenigen, welcher in dem Erbschein als Erbe bezeichnet ist, das angegebene Erbrecht zusteht und er nicht durch andere als die angegebenen Anordnungen beschränkt sei (§ 2365)";
    label en unofficial "It is presumed that the person designated as heir has the stated inheritance right and no other restrictions (§ 2365)";
    when im_erbschein_als_erbe_bezeichnet(s, p) and erbrecht_im_erbschein_angegeben(s, p);
    presume erbrecht_nach_erbschein_vermutet(s, p);
}
@source(BGB_P2371)
rule ErbschaftskaufNotarielleForm(k: Erbschaftskauf) strict {
    label de official "Der Vertrag über den Kauf einer Erbschaft bedarf der notariellen Beurkundung (§ 2371)";
    label en unofficial "A contract for the purchase of an inheritance requires notarisation (§ 2371)";
    when erbschaftskauf_notariell_beurkundet(k);
    then erbschaftskauf_formwirksam(k);
}
@source(BGB_P2229)
rule SechzehntesLebensjahrFuerTestament(p: Person, errichtung: Date, vollendung: Date) strict {
    label de official "Ein Minderjähriger kann ein Testament erst errichten, wenn er das sechzehnte Lebensjahr vollendet hat (§ 2229 Abs. 1); am Tag der Vollendung ist das Lebensjahr erst mit Ablauf vollendet";
    label en unofficial "A minor may make a will only after completing the sixteenth year (§ 2229 (1)); completion occurs at the end of the completion day";
    when testament_errichtet_am(p, errichtung) and de.bgb.fristen::lebensjahr_vollendet_am(p, 16 calendar_year, vollendung) and errichtung > vollendung;
    then testierfaehig_alter_2229(p, errichtung);
}
@source(BGB_P2247)
rule EigenhaendigesTestamentForm(t: Testament, errichter: Person) strict {
    label de official "Der Erblasser kann ein Testament durch eine eigenhändig geschriebene und unterschriebene Erklärung errichten (§ 2247 Abs. 1); Ort und Zeit sollen angegeben werden, sind aber keine zusätzliche Wirksamkeitsvoraussetzung (§ 2247 Abs. 2)";
    label en unofficial "The testator may make a will by a declaration personally written and signed (§ 2247 (1)); place and date should be stated but are not an additional validity requirement (§ 2247 (2))";
    when eigenhaendig_geschrieben_2247(t, errichter) and eigenhaendig_unterschrieben_2247(t, errichter);
    then eigenhaendiges_testament_formwirksam(t, errichter);
}
@source(BGB_P2064)
rule VerfuegungVonTodesWegenNurPersoenlich(t: Testament, errichter: Person) strict {
    label de official "Der Erblasser kann eine Verfügung von Todes wegen nur persönlich errichten (§ 2064)";
    label en unofficial "A testator may make a disposition mortis causa only personally (§ 2064)";
    when verfuegung_von_todes_wegen_persoenlich_2064(t, errichter);
    then verfuegung_von_todes_wegen_persoenlich_wirksam_2064(t, errichter);
}
@source(BGB_P2066) {
    rule GesetzlicheErbenAmErbfallBedacht(t: Testament, erblasser: Person, p: Person, z: Integer, n: Integer) strict {
        label de official "Bedacht der Erblasser seine gesetzlichen Erben ohne nähere Bestimmung, sind die gesetzlichen Erben zur Zeit des Erbfalls nach dem Verhältnis ihrer gesetzlichen Erbteile bedacht (§ 2066 Satz 1)";
        label en unofficial "Where the testator names statutory heirs without further specification, the statutory heirs at devolution are intended in proportion to their statutory shares (§ 2066 sentence 1)";
        when gesetzliche_erben_ohne_naehere_bestimmung_bedacht_2066(t, erblasser) and zuwendung_unbedingt_oder_bis_erbfall_eingetreten_2066(t) and gesetzlicher_erbteil_am_erbfall_2066(t, p, z, n);
        then als_gesetzlicher_erbe_bedacht_2066(t, p, z, n);
    }
    presumption GesetzlicheErbenBeimSpaeterenEintrittBedacht(t: Testament, erblasser: Person, p: Person, z: Integer, n: Integer) {
        label de official "Treten aufschiebende Bedingung oder Anfangstermin erst nach dem Erbfall ein, sind im Zweifel die gesetzlichen Erben bedacht, die bei einem Tod beim Eintritt berufen wären (§ 2066 Satz 2)";
        label en unofficial "Where a suspensive condition or initial term occurs after devolution, the statutory heirs who would take on death at that event are intended in case of doubt (§ 2066 sentence 2)";
        when gesetzliche_erben_ohne_naehere_bestimmung_bedacht_2066(t, erblasser) and zuwendung_bedingt_und_nach_erbfall_eingetreten_2066(t) and gesetzlicher_erbteil_bei_spaeterem_eintritt_2066(t, p, z, n);
        presume als_gesetzlicher_erbe_beim_spaeteren_eintritt_bedacht_2066(t, p, z, n);
    }
}
@source(BGB_P2067) {
    presumption VerwandteAlsGesetzlicheErbenBedacht(t: Testament, erblasser: Person, p: Person, z: Integer, n: Integer) {
        label de official "Bedacht der Erblasser Verwandte oder nächste Verwandte ohne nähere Bestimmung, sind im Zweifel die beim Erbfall berufenen gesetzlichen Erben nach ihren gesetzlichen Erbteilen bedacht (§ 2067 Satz 1)";
        label en unofficial "Where the testator names relatives or nearest relatives without further specification, the statutory heirs at devolution are intended in case of doubt in proportion to their statutory shares (§ 2067 sentence 1)";
        when verwandte_ohne_naehere_bestimmung_bedacht_2067(t, erblasser) and verwandter_gesetzlicher_erbteil_am_erbfall_2067(t, p, z, n);
        presume verwandter_als_gesetzlicher_erbe_bedacht_2067(t, p, z, n);
    }
}
@source(BGB_P2068)
presumption VorverstorbenesKindDurchAbkoemmlingeErsetzt(t: Testament, kind: Person, abkoemmling: Person) {
    label de official "Ist ein ohne nähere Bestimmung bedachtes Kind vor Errichtung des Testaments unter Hinterlassung von Abkömmlingen gestorben, sind diese im Zweifel insoweit bedacht, wie sie bei gesetzlicher Erbfolge an seine Stelle träten (§ 2068)";
    label en unofficial "Where a child named without further specification died before the will leaving descendants, those descendants are intended in case of doubt to the extent of their statutory substitution (§ 2068)";
    when kind_ohne_naehere_bestimmung_bedacht_2068(t, kind) and kind_vor_testament_mit_abkoemmlingen_verstorben_2068(t, kind) and abkoemmling_tritt_gesetzlich_an_stelle_des_kindes_2068(t, abkoemmling, kind);
    presume abkoemmling_als_ersatz_bedacht_vermutet_2068(t, abkoemmling, kind);
}
@source(BGB_P2069)
presumption NachTestamentWeggefallenerAbkoemmlingErsetzt(t: Testament, bedachter: Person, ersatz: Person) {
    label de official "Fällt ein bedachter Abkömmling nach Errichtung des Testaments weg, sind dessen Abkömmlinge im Zweifel insoweit bedacht, wie sie bei gesetzlicher Erbfolge an seine Stelle träten (§ 2069)";
    label en unofficial "Where a named descendant falls away after the will, their descendants are intended in case of doubt to the extent of their statutory substitution (§ 2069)";
    when abkoemmling_bedacht_2069(t, bedachter) and bedachter_abkoemmling_nach_testament_weggefallen_2069(t, bedachter) and abkoemmling_tritt_gesetzlich_an_stelle_bedachten_2069(t, ersatz, bedachter);
    presume abkoemmling_als_ersatz_bedacht_vermutet_2069(t, ersatz, bedachter);
}
@source(BGB_P2070)
presumption NochNichtGezeugterDritterAbkoemmlingNichtBedacht(t: Testament, p: Person) {
    label de official "Ein zur maßgeblichen Zeit noch nicht gezeugter Abkömmling eines ohne nähere Bestimmung bedachten Dritten gilt im Zweifel als nicht bedacht (§ 2070)";
    label en unofficial "A descendant of a third party who was not conceived at the relevant time is not intended in case of doubt (§ 2070)";
    when abkoemmlinge_eines_dritten_ohne_naehere_bestimmung_bedacht_2070(t) and abkoemmling_zum_massgeblichen_zeitpunkt_noch_nicht_gezeugt_2070(t, p);
    presume abkoemmling_nicht_bedacht_vermutet_2070(t, p);
}
@source(BGB_P2071)
presumption GruppenmitgliedAmErbfallBedacht(t: Testament, p: Person) {
    label de official "Die beim Erbfall der ohne nähere Bestimmung bezeichneten Klasse angehörige oder im Dienst- oder Geschäftsverhältnis stehende Person gilt im Zweifel als bedacht (§ 2071)";
    label en unofficial "A person in the named unqualified class or service or business relationship at devolution is intended in case of doubt (§ 2071)";
    when personengruppe_oder_dienstverhaeltnis_ohne_naehere_bestimmung_bedacht_2071(t) and person_zum_erbfall_in_bezeichneter_gruppe_oder_verhaeltnis_2071(t, p);
    presume person_als_gruppenmitglied_bedacht_vermutet_2071(t, p);
}
@source(BGB_P2072)
presumption ArmenkasseLetztenWohnsitzesBedacht(t: Testament, kasse: Person) {
    label de official "Bedacht der Erblasser die Armen ohne nähere Bestimmung, ist im Zweifel die öffentliche Armenkasse der Gemeinde seines letzten Wohnsitzes unter Verteilungsauflage bedacht (§ 2072)";
    label en unofficial "Where the testator names the poor without further specification, the public poor fund of the last-domicile municipality is intended in case of doubt subject to distribution among the poor (§ 2072)";
    when arme_ohne_naehere_bestimmung_bedacht_2072(t) and oeffentliche_armenkasse_letzter_wohnsitzgemeinde_2072(t, kasse);
    presume armenkasse_unter_verteilungsauflage_bedacht_vermutet_2072(t, kasse);
}
@source(BGB_P2073)
rule MehrdeutigBezeichneteZuGleichenTeilen(t: Testament, p: Person) strict {
    label de official "Passt die Bezeichnung des Bedachten auf mehrere Personen und lässt sich nicht ermitteln, wer bedacht sein sollte, gelten sie als zu gleichen Teilen bedacht (§ 2073)";
    label en unofficial "Where a beneficiary designation fits multiple persons and the intended person cannot be determined, they are intended in equal shares (§ 2073)";
    when mehrdeutige_bezeichnung_trifft_zu_2073(t, p) and bedachter_nicht_ermittelbar_2073(t);
    then person_zu_gleichen_teilen_bedacht_2073(t, p);
}
@source(BGB_P2074)
presumption AufschiebendeBedingungErleben(t: Testament, bedachter: Person) {
    label de official "Eine unter aufschiebender Bedingung gemachte letztwillige Zuwendung soll im Zweifel nur gelten, wenn der Bedachte den Eintritt der Bedingung erlebt (§ 2074)";
    label en unofficial "A testamentary gift under a suspensive condition applies in case of doubt only if the beneficiary survives the condition's occurrence (§ 2074)";
    when letztwillige_zuwendung_aufschiebend_bedingt_2074(t, bedachter) and bedachter_erlebt_bedingungseintritt_2074(t, bedachter);
    presume zuwendung_nur_bei_erleben_bedingungseintritt_vermutet_2074(t, bedachter);
}
@source(BGB_P2075)
presumption WillkuerbedingungIstAufloesend(t: Testament, bedachter: Person) {
    label de official "Ist das unbestimmte Unterlassen oder fortgesetzte Tun allein dem Willen des Bedachten überlassen, gilt die Zuwendung im Zweifel als von einer auflösenden Bedingung abhängig (§ 2075)";
    label en unofficial "Where indefinite omission or continued conduct lies solely within the beneficiary's discretion, the gift is in case of doubt subject to a resolutory condition (§ 2075)";
    when unbestimmtes_unterlassen_oder_fortgesetztes_tun_bedingt_2075(t, bedachter) and unterlassen_oder_tun_steht_in_willkuer_des_bedachten_2075(t, bedachter);
    presume aufloesende_bedingung_fuer_handlung_oder_unterlassen_vermutet_2075(t, bedachter);
}
@source(BGB_P2076)
presumption VerweigerteDrittmitwirkungErfuelltBedingung(t: Testament, dritter: Person) {
    label de official "Bezweckt die Bedingung den Vorteil eines Dritten, gilt sie im Zweifel als eingetreten, wenn der Dritte die erforderliche Mitwirkung verweigert (§ 2076)";
    label en unofficial "Where a condition benefits a third party, it is deemed fulfilled in case of doubt if that party refuses the needed cooperation (§ 2076)";
    when bedingung_bezweckt_vorteil_dritten_2076(t, dritter) and dritter_verweigert_erforderliche_mitwirkung_2076(t, dritter);
    presume bedingung_als_eingetreten_vermutet_2076(t, dritter);
}
@source(BGB_P2077) {
    presumption EheaufloesungMachtVerfuegungUnwirksam(t: Testament, ehegatte: Person) {
        label de official "Eine zugunsten des Ehegatten getroffene letztwillige Verfügung ist unwirksam, wenn die Ehe vor dem Tod aufgelöst war (§ 2077 Abs. 1 Satz 1)";
        label en unofficial "A testamentary disposition in favour of a spouse is ineffective if the marriage was dissolved before death (§ 2077 (1) sentence 1)";
        when ehegatte_durch_letztwillige_verfuegung_bedacht_2077(t, ehegatte) and ehe_vor_tod_aufgeloest_2077(t);
        presume verfuegung_unwirksam_wegen_aufloesung_2077(t);
        unless testator_wollte_verfuegung_trotz_aufloesung_2077(t);
    }
    presumption ScheidungsreifeMachtVerfuegungUnwirksam(t: Testament, ehegatte: Person) {
        label de official "Der Eheauflösung steht gleich, dass beim Tod die Scheidungsvoraussetzungen vorlagen und der Erblasser Scheidung beantragt oder zugestimmt hatte (§ 2077 Abs. 1 Satz 2)";
        label en unofficial "Dissolution includes divorce requirements at death plus the testator's application or consent (§ 2077 (1) sentence 2)";
        when ehegatte_durch_letztwillige_verfuegung_bedacht_2077(t, ehegatte) and scheidungsvoraussetzungen_und_antrag_oder_zustimmung_2077(t);
        presume verfuegung_unwirksam_wegen_aufloesung_2077(t);
        unless testator_wollte_verfuegung_trotz_aufloesung_2077(t);
    }
    presumption AufhebungsantragMachtVerfuegungUnwirksam(t: Testament, ehegatte: Person) {
        label de official "Der Eheauflösung steht gleich, dass der Erblasser beim Tod aufhebungsberechtigt war und Aufhebung beantragt hatte (§ 2077 Abs. 1 Satz 3)";
        label en unofficial "Dissolution includes the testator's entitlement and application for annulment at death (§ 2077 (1) sentence 3)";
        when ehegatte_durch_letztwillige_verfuegung_bedacht_2077(t, ehegatte) and aufhebungsberechtigt_und_aufhebungsantrag_2077(t);
        presume verfuegung_unwirksam_wegen_aufloesung_2077(t);
        unless testator_wollte_verfuegung_trotz_aufloesung_2077(t);
    }
    presumption VerloebnisaufloesungMachtVerfuegungUnwirksam(t: Testament, verlobter: Person) {
        label de official "Eine zugunsten des Verlobten getroffene letztwillige Verfügung ist unwirksam, wenn das Verlöbnis vor dem Tod aufgelöst war (§ 2077 Abs. 2)";
        label en unofficial "A testamentary disposition in favour of a fiancé is ineffective if the engagement was dissolved before death (§ 2077 (2))";
        when verlobter_durch_letztwillige_verfuegung_bedacht_2077(t, verlobter) and verloebnis_vor_tod_aufgeloest_2077(t);
        presume verfuegung_unwirksam_wegen_aufloesung_2077(t);
        unless testator_wollte_verfuegung_trotz_aufloesung_2077(t);
    }
    rule FortgeltungswilleErhaeltVerfuegung(t: Testament) strict {
        label de official "Die Verfügung ist nicht unwirksam, wenn anzunehmen ist, dass der Erblasser sie auch für den Auflösungsfall getroffen hätte (§ 2077 Abs. 3)";
        label en unofficial "The disposition is not ineffective where the testator would have made it despite the dissolution (§ 2077 (3))";
        when testator_wollte_verfuegung_trotz_aufloesung_2077(t);
        then verfuegung_trotz_aufloesung_nicht_unwirksam_2077(t);
    }
}
@source(BGB_P2078) {
    rule InhaltsirrtumAnfechtbar(t: Testament) strict {
        label de official "Die letztwillige Verfügung kann angefochten werden, soweit der Erblasser über den Inhalt irrte oder eine Erklärung dieses Inhalts nicht abgeben wollte und sie bei Kenntnis der Sachlage nicht abgegeben hätte (§ 2078 Abs. 1)";
        label en unofficial "A testamentary disposition may be contested where the testator erred about its content or did not intend that content and would not have made it knowing the facts (§ 2078 (1))";
        when erklaerungsinhalt_geirrt_oder_nicht_gewollt_2078(t) and bei_kenntnis_nicht_abgegeben_2078(t);
        then letztwillige_verfuegung_anfechtbar_2078(t);
    }
    rule MotivirrtumOderDrohungAnfechtbar(t: Testament) strict {
        label de official "Die letztwillige Verfügung kann angefochten werden, soweit irrige Annahme oder Erwartung oder widerrechtliche Drohung den Erblasser bestimmte (§ 2078 Abs. 2)";
        label en unofficial "A testamentary disposition may be contested where mistaken assumption or expectation, or unlawful threat, induced it (§ 2078 (2))";
        when irrige_annahme_erwartung_oder_drohung_bestimmt_2078(t);
        then letztwillige_verfuegung_anfechtbar_2078(t);
    }
}
@source(BGB_P2079)
rule UebergangenerPflichtteilsberechtigterAnfechtung(t: Testament, p: Person) strict {
    label de official "Eine letztwillige Verfügung kann angefochten werden, wenn ein beim Erbfall vorhandener Pflichtteilsberechtigter übergangen wurde, der bei Errichtung unbekannt war oder erst später geboren oder berechtigt wurde (§ 2079 Satz 1)";
    label en unofficial "A testamentary disposition may be contested where an existing compulsory-portion beneficiary was omitted and was unknown, born later, or became entitled later (§ 2079 sentence 1)";
    when pflichtteilsberechtigter_beim_erbfall_uebergangen_2079(t, p) and pflichtteilsberechtigter_unbekannt_oder_spaeter_entstanden_2079(t, p);
    then letztwillige_verfuegung_anfechtbar_2079(t, p);
}
@source(BGB_P2080) {
    rule UnmittelbarerVorteilBerechtigtZurAnfechtung(a: Anfechtung, p: Person) strict {
        label de official "Zur Anfechtung ist berechtigt, wem die Aufhebung unmittelbar zustatten käme (§ 2080 Abs. 1)"; label en unofficial "A person directly benefiting from avoidance is entitled to contest (§ 2080 (1))";
        when aufhebung_kommt_unmittelbar_zustatten_2080(a, p); then person_anfechtungsberechtigt_2080(a, p);
    }
    rule PersonenbezogenerIrrtumSchliesstAndereAus(a: Anfechtung, p: Person) strict {
        label de official "Betrifft der Irrtum nur eine anfechtungsberechtigte bestimmte Person, ist ein anderer nicht berechtigt (§ 2080 Abs. 2)"; label en unofficial "Where the error concerns only an entitled particular person, another is not entitled (§ 2080 (2))";
        when irrtum_betrifft_bestimmte_person_2080(a, p) and bestimmte_person_anfechtungsberechtigt_oder_waere_es_2080(a, p); then anderer_nicht_anfechtungsberechtigt_2080(a, p);
    }
    rule UebergangenerHatAlleinigesAnfechtungsrecht(a: Anfechtung, t: Testament, p: Person) strict {
        label de official "Im Fall des § 2079 steht das Anfechtungsrecht nur dem Pflichtteilsberechtigten zu (§ 2080 Abs. 3)"; label en unofficial "In a § 2079 case, only the compulsory-portion beneficiary holds the right to contest (§ 2080 (3))";
        when anfechtung_wegen_2079(a, t, p); then pflichtteilsberechtigter_allein_anfechtungsberechtigt_2080(a, p);
    }
}
@source(BGB_P2081)
rule AnfechtungGegenueberNachlassgericht(a: Anfechtung) strict {
    label de official "Die Anfechtung erfolgt durch Erklärung gegenüber dem Nachlassgericht (§ 2081 Abs. 1 und 3)"; label en unofficial "A contest is made by declaration to the probate court (§ 2081 (1) and (3))";
    when anfechtungserklaerung_nachlassgericht_2081(a); then anfechtungserklaerung_formgerecht_2081(a);
}
@source(BGB_P2082) {
    rule JahresfristBeginntMitKenntnis(a: Anfechtung, p: Person, tag: Date) strict {
        label de official "Die Jahresfrist beginnt mit Kenntnis des Anfechtungsgrundes (§ 2082 Abs. 2)"; label en unofficial "The one-year period begins with knowledge of the ground (§ 2082 (2))";
        when anfechtungsgrund_kenntnis_am_2082(a, p, tag); then anfechtungsfrist_beginnt_2082(a, p, tag);
    }
    rule AnfechtungBinnenJahresfrist(a: Anfechtung) strict {
        label de official "Die Anfechtung kann nur binnen Jahresfrist erfolgen (§ 2082 Abs. 1)"; label en unofficial "A contest may be made only within one year (§ 2082 (1))";
        when anfechtung_binnen_jahresfrist_2082(a); then anfechtung_fristgerecht_2082(a);
    }
    rule DreissigJahreSchliessenAnfechtungAus(a: Anfechtung) strict {
        label de official "Die Anfechtung ist ausgeschlossen, wenn seit dem Erbfall dreißig Jahre verstrichen sind (§ 2082 Abs. 3)"; label en unofficial "A contest is barred when thirty years have elapsed since devolution (§ 2082 (3))";
        when seit_erbfall_dreissig_jahre_verstrichen_2082(a); then anfechtung_wegen_dreissig_jahren_ausgeschlossen_2082(a);
    }
}
@source(BGB_P2083)
rule AnfechtbarkeitseinredeErlaubtLeistungsverweigerung(t: Testament, beschwerter: Person) strict {
    label de official "Begründet eine anfechtbare letztwillige Verfügung eine Leistungspflicht, kann der Beschwerte die Leistung auch bei Ausschluss nach § 2082 verweigern (§ 2083)"; label en unofficial "Where a contestable disposition creates an obligation, the burdened person may refuse performance even if contest is time-barred (§ 2083)";
    when leistungsverpflichtung_durch_anfechtbare_verfuegung_2083(t, beschwerter); then beschwerter_darf_leistung_verweigern_2083(t, beschwerter);
}
@source(BGB_P2084)
presumption WirksameAuslegungVorzuziehen(t: Testament) {
    label de official "Lässt der Inhalt verschiedene Auslegungen zu, ist im Zweifel diejenige vorzuziehen, bei welcher die Verfügung Erfolg haben kann (§ 2084)"; label en unofficial "Where content permits multiple constructions, the one giving effect is preferred in case of doubt (§ 2084)";
    when mehrere_auslegungen_eine_erfolgreich_2084(t); presume wirksame_auslegung_vorzuziehen_vermutet_2084(t);
}
@source(BGB_P2085)
rule TeilunwirksamkeitErfasstUebrigeNurBeiKausalitaet(t: Testament) strict {
    label de official "Die Unwirksamkeit einer von mehreren Verfügungen erfasst die übrigen nur, wenn der Erblasser sie ohne die unwirksame nicht getroffen hätte (§ 2085)"; label en unofficial "Ineffectiveness of one of several dispositions affects the others only if the testator would not have made them without it (§ 2085)";
    when eine_von_mehreren_verfuegungen_unwirksam_2085(t) and testator_haette_uebrige_ohne_unwirksame_nicht_getroffen_2085(t); then uebrige_verfuegungen_ebenfalls_unwirksam_2085(t);
}
@source(BGB_P2086)
presumption FehlendeErgaenzungLaesstVerfuegungWirksam(t: Testament) {
    label de official "Ein unterbliebene Ergänzung trotz Ergänzungsvorbehalts lässt die Verfügung wirksam, sofern ihre Wirksamkeit nicht von der Ergänzung abhängen sollte (§ 2086)"; label en unofficial "An absent supplementation despite a reservation leaves the disposition effective unless effectiveness was intended to depend on it (§ 2086)";
    when ergaenzungsvorbehalt_ohne_ergaenzung_2086(t); presume verfuegung_trotz_fehlender_ergaenzung_wirksam_2086(t); unless wirksamkeit_von_ergaenzung_abhaengig_2086(t);
}
@source(BGB_P2087) {
    rule VermoegenszuwendungIstErbeinsetzung(t: Testament, p: Person) strict {
        label de official "Die Zuwendung des Vermögens oder eines Bruchteils ist als Erbeinsetzung anzusehen, auch ohne Bezeichnung als Erbe (§ 2087 Abs. 1)"; label en unofficial "A gift of the estate or a fraction is appointment as heir even without the title (§ 2087 (1))";
        when vermoegen_oder_vermoegensbruchteil_zugewendet_2087(t, p); then zuwendung_als_erbeinsetzung_anzusehen_2087(t, p);
    }
    presumption GegenstandszuwendungNichtErbeinsetzung(t: Testament, p: Person) {
        label de official "Die Zuwendung nur einzelner Gegenstände gilt im Zweifel nicht als Erbeinsetzung (§ 2087 Abs. 2)"; label en unofficial "A gift only of individual items is in case of doubt not appointment as heir (§ 2087 (2))";
        when einzelne_gegenstaende_zugewendet_2087(t, p); presume gegenstandszuwendung_nicht_als_erbeinsetzung_vermutet_2087(t, p);
    }
}
@source(BGB_P2088) {
    rule EinzelnerBruchteilLaesstGesetzlicheErbfolgeImRest(t: Testament, p: Person, z: Integer, n: Integer) strict {
        label de official "Ist nur ein Erbe auf einen Bruchteil eingesetzt, tritt für den Rest gesetzliche Erbfolge ein (§ 2088 Abs. 1)"; label en unofficial "Where only one heir is appointed to a fraction, statutory succession applies to the remainder (§ 2088 (1))";
        when einzelner_erbe_auf_bruchteil_eingesetzt_2088(t, p, z, n); then rest_erbschaft_gesetzliche_erbfolge_2088(t);
    }
    rule MehrereNichtErschoepfendeBruchteileLassenGesetzlicheErbfolgeImRest(t: Testament) strict {
        label de official "Erschöpfen mehrere eingesetzte Bruchteile die Erbschaft nicht, tritt für den Rest gesetzliche Erbfolge ein (§ 2088 Abs. 2)"; label en unofficial "Where multiple appointed fractions do not exhaust the estate, statutory succession applies to the remainder (§ 2088 (2))";
        when mehrere_erben_auf_nicht_erschoepfende_bruchteile_2088(t); then rest_erbschaft_gesetzliche_erbfolge_2088(t);
    }
}
@source(BGB_P2089)
rule NichtErschoepfendeAlleinerbenBruchteileErhoehen(t: Testament) strict {
    label de official "Sollen die eingesetzten Bruchteilserben alleinige Erben sein und erschöpfen ihre Bruchteile die Erbschaft nicht, erhöhen sich diese verhältnismäßig (§ 2089)"; label en unofficial "Where fractional heirs are intended to be sole heirs and their shares do not exhaust the estate, their shares increase proportionately (§ 2089)";
    when eingesetzte_sollen_alleinige_erben_sein_2089(t) and bruchteile_erschoepfen_nicht_2089(t); then bruchteile_verhaeltnismaessig_erhoeht_2089(t);
}
@source(BGB_P2090)
rule UebersteigendeBruchteileMindern(t: Testament) strict {
    label de official "Übersteigen die Bruchteile aller eingesetzten Erben die Erbschaft, mindern sie sich verhältnismäßig (§ 2090)"; label en unofficial "Where all appointed fractions exceed the estate, they are proportionately reduced (§ 2090)";
    when eingesetzte_bruchteile_uebersteigen_ganzes_2090(t); then bruchteile_verhaeltnismaessig_gemindert_2090(t);
}
@source(BGB_P2091)
presumption UnbestimmteErbteileGleich(t: Testament, p: Person) {
    label de official "Sind mehrere Erben ohne bestimmte Erbteile eingesetzt, sind sie im Zweifel zu gleichen Teilen eingesetzt, vorbehaltlich §§ 2066 bis 2069 (§ 2091)"; label en unofficial "Multiple heirs appointed without specified shares take equal shares in case of doubt, subject to §§ 2066–2069 (§ 2091)";
    when mehrere_erben_ohne_erbteilbestimmung_2091(t) and erbe_ohne_erbteilbestimmung_eingesetzt_2091(t, p); presume erbe_zu_gleichen_teilen_eingesetzt_2091(t, p);
}
@source(BGB_P2092) {
    rule UnbestimmteErbenErhaltenRest(t: Testament, p: Person) strict {
        label de official "Bei teils bestimmten und teils unbestimmten Erbteilen erhalten die letzteren den freigebliebenen Teil (§ 2092 Abs. 1)"; label en unofficial "Where some shares are specified and others not, the latter receive the unallocated part (§ 2092 (1))";
        when bruchteilserben_und_unbestimmte_erben_2092(t) and erbe_ohne_bruchteil_eingesetzt_2092(t, p); then unbestimmter_erbe_erhaelt_freigebliebenen_teil_2092(t, p);
    }
    rule EroepschopfteBestimmteBruchteileMindern(t: Testament) strict {
        label de official "Erschöpfen die bestimmten Bruchteile die Erbschaft, mindern sich die Bruchteile nach § 2092 Abs. 2 verhältnismäßig"; label en unofficial "Where specified fractions exhaust the estate, the fractions are reduced proportionately under § 2092 (2)";
        when bestimmte_bruchteile_erschoepfen_2092(t); then bruchteile_nach_2092_abs2_verhaeltnismaessig_gemindert(t);
    }
}
@source(BGB_P2093)
rule GemeinschaftlicherErbteilEntsprechendeAnwendung(t: Testament) strict {
    label de official "Für den gemeinschaftlichen Erbteil gelten §§ 2089 bis 2092 entsprechend (§ 2093)"; label en unofficial "§§ 2089–2092 apply mutatis mutandis to a joint share (§ 2093)";
    when gemeinschaftlicher_erbteil_eingesetzt_2093(t); then regeln_2089_bis_2092_auf_gemeinschaftlichen_erbteil_anwendbar_2093(t);
}
@source(BGB_P2094) {
    rule AnwachsungUnterUebrigenErben(t: Testament, weggefallen: Person, erbe: Person) strict {
        label de official "Fällt bei Ausschluss der gesetzlichen Erbfolge ein eingesetzter Erbe weg, wächst sein Erbteil den übrigen nach dem Verhältnis ihrer Erbteile an (§ 2094 Abs. 1)"; label en unofficial "If an appointed heir falls away while statutory succession is excluded, the share accrues to the others in proportion to their shares (§ 2094 (1))";
        when mehrere_eingesetzte_erben_schliessen_gesetzliche_erbfolge_aus_2094(t) and eingesetzter_erbe_weggefallen_2094(t, weggefallen) and uebriger_erbe_anwachsungsberechtigt_2094(t, erbe, weggefallen);
        then erbteil_wachst_an_2094(t, erbe, weggefallen);
    }
    rule TeilweiseVerfuegungBeschraenktAnwachsung(t: Testament) strict {
        label de official "Bei nur teilweiser Verfügung und gesetzlicher Erbfolge im Übrigen tritt Anwachsung nur bei gemeinschaftlichem Erbteil ein (§ 2094 Abs. 2)"; label en unofficial "With only partial disposition and statutory succession otherwise, accretion occurs only for a joint share (§ 2094 (2))";
        when nur_teilweise_ueber_erbschaft_verfuegt_2094(t); then anwachsung_nur_gemeinschaftlicher_erbteil_2094(t);
    }
}
@source(BGB_P2095)
rule AngewachsenerErbteilIstBesonders(t: Testament, erbe: Person, weggefallen: Person) strict {
    label de official "Der durch Anwachsung anfallende Erbteil gilt für Vermächtnisse, Auflagen und Ausgleichungspflicht als besonderer Erbteil (§ 2095)"; label en unofficial "An accrued share counts as a separate share for legacies, charges and equalisation (§ 2095)";
    when erbteil_wachst_an_2094(t, erbe, weggefallen); then angewachsener_erbteil_besonderer_erbteil_2095(t, erbe);
}
@source(BGB_P2096)
rule ErsatzerbeinsetzungZulaessig(t: Testament, ersatz: Person, zuerst: Person) strict {
    label de official "Der Erblasser kann für den Wegfall des zuerst berufenen Erben einen anderen als Ersatzerben einsetzen (§ 2096)"; label en unofficial "The testator may appoint another as substitute heir for the initial heir's falling away (§ 2096)";
    when ersatzerbe_fuer_wegfall_eingesetzt_2096(t, ersatz, zuerst); then ersatzerbeneinsetzung_zulaessig_2096(t, ersatz, zuerst);
}
@source(BGB_P2097)
presumption ErsatzerbeFuerBeideFaelle(t: Testament, ersatz: Person, zuerst: Person) {
    label de official "Ist ein Ersatzerbe für Unfähigkeit oder Unwillen des zunächst Berufenen eingesetzt, gilt er im Zweifel für beide Fälle als eingesetzt (§ 2097)"; label en unofficial "A substitute appointed for inability or unwillingness of the initial heir is in case of doubt appointed for both (§ 2097)";
    when ersatzerbe_nur_unfaehigkeit_oder_unwille_2097(t, ersatz, zuerst); presume ersatzerbe_fuer_beide_wegfallsfaelle_vermutet_2097(t, ersatz, zuerst);
}
@source(BGB_P2098)
presumption WechselseitigeErsatzerbenNachAnteilen(t: Testament) {
    label de official "Gegenseitige Ersatzerben gelten im Zweifel nach dem Verhältnis ihrer Erbteile als eingesetzt (§ 2098 Abs. 1)"; label en unofficial "Reciprocal substitute heirs are in case of doubt appointed in proportion to their shares (§ 2098 (1))";
    when erben_wechselseitig_als_ersatzerben_eingesetzt_2098(t); presume wechselseitige_ersatzfolge_nach_erbteilen_vermutet_2098(t);
}
@source(BGB_P2099)
rule ErsatzerbeVorAnwachsung(t: Testament, ersatz: Person, zuerst: Person) strict {
    label de official "Das Recht des Ersatzerben geht dem Anwachsungsrecht vor (§ 2099)"; label en unofficial "The substitute heir's right has priority over accretion (§ 2099)";
    when ersatzerbeneinsetzung_zulaessig_2096(t, ersatz, zuerst); then ersatzerbenrecht_geht_anwachsung_vor_2099(t);
}
@source(BGB_P2100)
rule NacherbeinsetzungZulaessig(t: Testament, vorerbe: Person, nacherbe: Person) strict {
    label de official "Der Erblasser kann einen Erben so einsetzen, dass er erst nach einem zunächst berufenen Erben Erbe wird (§ 2100)"; label en unofficial "The testator may appoint an heir to succeed an initially appointed heir (§ 2100)";
    when vorerbe_und_nacherbe_nacheinander_eingesetzt_2100(t, vorerbe, nacherbe); then nacherbeinsetzung_zulaessig_2100(t, nacherbe);
}
@source(BGB_P2101) {
    presumption NochNichtGezeugterIstNacherbe(t: Testament, p: Person) {
        label de official "Eine beim Erbfall noch nicht gezeugte als Erbe eingesetzte Person gilt im Zweifel als Nacherbe (§ 2101 Abs. 1)"; label en unofficial "A person not conceived at devolution who is appointed heir is in case of doubt a subsequent heir (§ 2101 (1))";
        when beim_erbfall_noch_nicht_gezeugter_als_erbe_eingesetzt_2101(t, p); presume noch_nicht_gezeugter_oder_juristische_person_als_nacherbe_vermutet_2101(t, p); unless nichteignung_als_nacherbe_nach_willen_2101(t, p);
    }
    presumption SpaetereJuristischePersonIstNacherbe(t: Testament, p: Person) {
        label de official "Eine erst nach dem Erbfall entstehende juristische Person gilt im Zweifel als Nacherbe (§ 2101 Abs. 2)"; label en unofficial "A legal person arising after devolution is in case of doubt a subsequent heir (§ 2101 (2))";
        when spaeter_entstehende_juristische_person_als_erbe_eingesetzt_2101(t, p); presume noch_nicht_gezeugter_oder_juristische_person_als_nacherbe_vermutet_2101(t, p);
    }
    rule NichteignungAlsNacherbeMachtEinsetzungUnwirksam(t: Testament, p: Person) strict {
        label de official "Entspricht es nicht dem Willen des Erblassers, dass der Eingesetzte Nacherbe sein soll, ist die Einsetzung unwirksam (§ 2101 Abs. 1 Satz 2)"; label en unofficial "If the testator did not intend a subsequent-heir appointment, the appointment is ineffective (§ 2101 (1) sentence 2)";
        when beim_erbfall_noch_nicht_gezeugter_als_erbe_eingesetzt_2101(t, p) and nichteignung_als_nacherbe_nach_willen_2101(t, p); then einsetzung_unwirksam_2101(t, p);
    }
}
@source(BGB_P2102) {
    presumption NacherbeAuchErsatzerbe(t: Testament, p: Person) {
        label de official "Die Einsetzung als Nacherbe enthält im Zweifel auch die Einsetzung als Ersatzerbe (§ 2102 Abs. 1)"; label en unofficial "Appointment as subsequent heir includes substitute appointment in case of doubt (§ 2102 (1))";
        when als_nacherbe_eingesetzt_2102(t, p); presume nacherbe_auch_ersatzerbe_vermutet_2102(t, p);
    }
    presumption ZweifelIstErsatzerbe(t: Testament, p: Person) {
        label de official "Ist zweifelhaft, ob jemand als Ersatz- oder Nacherbe eingesetzt ist, gilt er als Ersatzerbe (§ 2102 Abs. 2)"; label en unofficial "Where it is doubtful whether someone is substitute or subsequent heir, they are deemed a substitute heir (§ 2102 (2))";
        when zweifel_ersatz_oder_nacherbe_2102(t, p); presume im_zweifel_ersatzerbe_2102(t, p);
    }
}
@source(BGB_P2103)
presumption HerausgabepflichtBegruendetNacherbschaft(t: Testament, anderer: Person) {
    label de official "Soll der Erbe die Erbschaft bei einem Zeitpunkt oder Ereignis einem anderen herausgeben, gilt der andere als Nacherbe eingesetzt (§ 2103)"; label en unofficial "Where the heir must hand the estate to another on a time or event, the other is deemed a subsequent heir (§ 2103)";
    when herausgabe_an_anderen_bei_zeitpunkt_oder_ereignis_2103(t, anderer); presume anderer_als_nacherbe_vermutet_2103(t, anderer);
}
@source(BGB_P2104)
presumption GesetzlicheErbenAlsNacherben(t: Testament, p: Person) {
    label de official "Soll der Erbe nur bis zu Zeitpunkt oder Ereignis Erbe sein, sind ohne andere Bestimmung die dann berufenen gesetzlichen Erben im Zweifel Nacherben (§ 2104)"; label en unofficial "Where an heir is heir only until a time or event, the then statutory heirs are in case of doubt subsequent heirs absent another designation (§ 2104)";
    when erbe_nur_bis_zeitpunkt_oder_ereignis_2104(t) and gesetzlicher_erbe_beim_spaeteren_ereignis_2104(t, p); presume gesetzlicher_erbe_als_nacherbe_vermutet_2104(t, p);
}
@source(BGB_P2105)
presumption GesetzlicheErbenAlsVorerben(t: Testament, p: Person) {
    label de official "Soll der eingesetzte Erbe die Erbschaft erst künftig erhalten, sind die gesetzlichen Erben bis dahin Vorerben (§ 2105)"; label en unofficial "Where the appointed heir receives the estate only later, statutory heirs are prior heirs until then (§ 2105)";
    when eingesetzter_erbe_erhaelt_nur_spaeter_2105(t) and gesetzlicher_erbe_bis_dahin_2105(t, p); presume gesetzlicher_erbe_als_vorerbe_2105(t, p);
}
@source(BGB_P2106) {
    rule NacherbfolgeMitTodDesVorerben(t: Testament, nacherbe: Person, vorerbe: Person) strict {
        label de official "Ohne bestimmte Eintrittszeit oder Ereignis fällt die Erbschaft dem Nacherben mit Tod des Vorerben an (§ 2106 Abs. 1)"; label en unofficial "Absent a specified event, the estate devolves on the subsequent heir at the prior heir's death (§ 2106 (1))";
        when nacherbe_ohne_eintrittszeitpunkt_2106(t, nacherbe, vorerbe); then nacherbschaft_mit_tod_des_vorerben_2106(t, nacherbe);
    }
    rule NacherbfolgeMitGeburt(t: Testament, p: Person) strict {
        label de official "Bei einer nach § 2101 anzusehenden Nacherbeneinsetzung fällt die Erbschaft mit Geburt des Nacherben an (§ 2106 Abs. 2)"; label en unofficial "For a § 2101 subsequent-heir appointment, the estate devolves on the heir's birth (§ 2106 (2))";
        when noch_nicht_gezeugter_nacherbe_geboren_2106(t, p); then nacherbschaft_mit_geburt_2106(t, p);
    }
}
@source(BGB_P2107)
presumption KinderloserVorerbeNacherbeNurOhneNachkommen(t: Testament, vorerbe: Person, nacherbe: Person) {
    label de official "Für einen kinderlosen Vorerben bestimmter Nacherbe gilt im Zweifel nur bei nachkommenschaftslosem Tod als eingesetzt (§ 2107)"; label en unofficial "A subsequent heir named after a childless prior heir is in case of doubt appointed only for death without descendants (§ 2107)";
    when kinderloser_abkoemmling_vorerbe_nacherbe_bestimmt_2107(t, vorerbe, nacherbe); presume nacherbe_nur_bei_nachkommenschaftslosem_tod_vermutet_2107(t, nacherbe);
}
@source(BGB_P2108)
presumption NacherbrechtVererblich(t: Testament, nacherbe: Person) {
    label de official "Stirbt der Nacherbe nach Erbfall vor Eintritt der Nacherbfolge, geht sein Recht im Zweifel auf seine Erben über (§ 2108 Abs. 2)"; label en unofficial "Where the subsequent heir dies after devolution before succession, their right passes to their heirs in case of doubt (§ 2108 (2))";
    when nacherbe_vor_eintritt_nach_erbfall_verstorben_2108(t, nacherbe); presume nacherbrecht_geht_auf_erben_ueber_2108(t, nacherbe);
}
@source(BGB_P2109)
rule DreissigJahreMachenNacherbeinsetzungUnwirksam(t: Testament) strict {
    label de official "Die Nacherbeneinsetzung wird dreißig Jahre nach Erbfall unwirksam, wenn der Fall vorher nicht eingetreten ist (§ 2109 Abs. 1)"; label en unofficial "A subsequent-heir appointment becomes ineffective after thirty years if succession has not occurred (§ 2109 (1))";
    when nacherbschaft_dreissig_jahre_ohne_eintritt_2109(t); then nacherbeinsetzung_unwirksam_2109(t);
}
@source(BGB_P2110) {
    presumption NacherbrechtUmfasstAngewachsenenErbteil(t: Testament) {
        label de official "Das Nacherbrecht erstreckt sich im Zweifel auf einen dem Vorerben durch Miterbenwegfall angefallenen Erbteil (§ 2110 Abs. 1)"; label en unofficial "The subsequent right extends in case of doubt to a share accrued through a co-heir's falling away (§ 2110 (1))";
        when vorerbe_miterbenwegfall_erbteil_erhalten_2110(t); presume nacherbrecht_erstreckt_sich_auf_angewachsenen_erbteil_2110(t);
    }
    presumption NacherbrechtUmfasstKeinVorausvermaechtnis(t: Testament) {
        label de official "Das Nacherbrecht erstreckt sich im Zweifel nicht auf ein Vorausvermächtnis des Vorerben (§ 2110 Abs. 2)"; label en unofficial "The subsequent right does not in case of doubt extend to a prior heir's advance legacy (§ 2110 (2))";
        when vorerbe_vorausvermaechtnis_zugewendet_2110(t); presume nacherbrecht_erstreckt_sich_nicht_auf_vorausvermaechtnis_2110(t);
    }
}
@source(BGB_P2111) {
    rule UnmittelbareErsetzungGehoertZurErbschaft(t: Testament, vorerbe: Person) strict {
        label de official "Was der Vorerbe aufgrund eines Erbschaftsrechts oder als Ersatz für einen Erbschaftsgegenstand erwirbt, gehört zur Erbschaft (§ 2111 Abs. 1)"; label en unofficial "What the prior heir acquires under an estate right or as replacement belongs to the estate (§ 2111 (1))";
        when vorerbe_erwirbt_ersatz_aus_erbschaftsrecht_2111(t, vorerbe); then ersatz_gehoert_zur_erbschaft_2111(t, vorerbe);
    }
    rule GrundstuecksinventarGehoertZurErbschaft(t: Testament, vorerbe: Person) strict {
        label de official "Was der Vorerbe dem Inventar eines erbschaftlichen Grundstücks einverleibt, gehört zur Erbschaft (§ 2111 Abs. 2)"; label en unofficial "What the prior heir incorporates into estate land inventory belongs to the estate (§ 2111 (2))";
        when vorerbe_inventar_grundstueck_einverleibt_2111(t, vorerbe); then einverleibung_gehoert_zur_erbschaft_2111(t, vorerbe);
    }
}
@source(BGB_P2112)
rule VorerbeDarfVerfuegen(t: Testament, vorerbe: Person) strict {
    label de official "Der Vorerbe kann über Erbschaftsgegenstände verfügen, soweit §§ 2113 bis 2115 nichts anderes bestimmen (§ 2112)"; label en unofficial "The prior heir may dispose of estate assets unless §§ 2113–2115 provide otherwise (§ 2112)";
    when vorerbe_verfuegt_ueber_erbschaftsgegenstand_2112(t, vorerbe); then verfuegung_vorerbe_zulaessig_2112(t, vorerbe);
}
@source(BGB_P2113)
rule BeeintraechtigendeGrundstuecksOderSchenkungsverfuegungUnwirksam(t: Testament, vorerbe: Person) strict {
    label de official "Eine Grundstücks-, Schiffs- oder unentgeltliche Verfügung des Vorerben ist bei Nacherbfolge insoweit unwirksam, als sie das Nacherbrecht beeinträchtigt (§ 2113)"; label en unofficial "A prior heir's land, vessel or gratuitous disposition is ineffective upon subsequent succession insofar as it impairs the subsequent right (§ 2113)";
    when vorerbe_verfuegung_grundstueck_schiff_oder_unentgeltlich_2113(t, vorerbe) and verfuegung_beeintraechtigt_nacherbrecht_2113(t); then verfuegung_bei_nacherbfolge_unwirksam_2113(t);
}
@source(BGB_P2114)
rule VorerbeKannHypothekenforderungEinziehen(t: Testament, vorerbe: Person) strict {
    label de official "Kündigung und Einziehung einer zur Erbschaft gehörenden Hypothekenforderung und gleichgestellter Forderungen stehen dem Vorerben zu (§ 2114)"; label en unofficial "Termination and collection of an estate mortgage and equivalent claims belong to the prior heir (§ 2114)";
    when vorerbe_hypothekenforderung_kuendigt_oder_zieht_ein_2114(t, vorerbe); then vorerbe_kuendigung_einziehung_zulaessig_2114(t, vorerbe);
}
@source(BGB_P2115)
rule BeeintraechtigendeZwangsverfuegungUnwirksam(t: Testament) strict {
    label de official "Eine Zwangsvollstreckungs-, Arrest- oder Insolvenzverfügung ist bei Nacherbfolge insoweit unwirksam, als sie das Nacherbrecht beeinträchtigt (§ 2115 Satz 1)"; label en unofficial "An enforcement, attachment or insolvency disposition is ineffective upon subsequent succession insofar as it impairs the subsequent right (§ 2115 sentence 1)";
    when zwangsverfuegung_beeintraechtigt_nacherbrecht_2115(t); then zwangsverfuegung_bei_nacherbfolge_unwirksam_2115(t);
}
@source(BGB_P2116) {
    rule HinterlegungAufVerlangen(t: Testament, vorerbe: Person) strict {
        label de official "Der Vorerbe hat auf Verlangen des Nacherben erbschaftliche Inhaberpapiere mit Zustimmungsvorbehalt zu hinterlegen (§ 2116 Abs. 1)"; label en unofficial "On the subsequent heir's demand, the prior heir must deposit estate bearer securities subject to consent (§ 2116 (1))";
        when nacherbe_verlangt_hinterlegung_inhaberpapiere_2116(t, vorerbe); then vorerbe_muss_papiere_mit_zustimmungsvorbehalt_hinterlegen_2116(t, vorerbe);
    }
    rule HinterlegtePapiereNurMitZustimmung(t: Testament, vorerbe: Person) strict {
        label de official "Der Vorerbe kann über hinterlegte Papiere nur mit Zustimmung des Nacherben verfügen (§ 2116 Abs. 2)"; label en unofficial "The prior heir may dispose of deposited securities only with the subsequent heir's consent (§ 2116 (2))";
        when vorerbe_ueber_hinterlegte_papiere_verfuegt_2116(t, vorerbe); then verfuegung_hinterlegte_papiere_nur_mit_zustimmung_2116(t, vorerbe);
    }
}
@source(BGB_P2117)
rule UmschreibungOderUmwandlungStattHinterlegung(t: Testament, vorerbe: Person) strict {
    label de official "Der Vorerbe kann mit Zustimmungsvorbehalt umschreiben oder zulässig umwandeln statt zu hinterlegen (§ 2117)"; label en unofficial "The prior heir may register or permissibly convert subject to consent instead of depositing (§ 2117)";
    when vorerbe_waehlt_umschreibung_oder_umwandlung_2117(t, vorerbe); then umschreibung_oder_umwandlung_zulaessig_2117(t, vorerbe);
}
@source(BGB_P2118)
rule SperrvermerkAufVerlangen(t: Testament, vorerbe: Person) strict {
    label de official "Der Vorerbe hat auf Verlangen des Nacherben einen Sperrvermerk für Buchforderungen eintragen zu lassen (§ 2118)"; label en unofficial "On demand, the prior heir must have a blocking notation entered for book claims (§ 2118)";
    when nacherbe_verlangt_sperrvermerk_2118(t, vorerbe); then vorerbe_muss_sperrvermerk_eintragen_2118(t, vorerbe);
}
@source(BGB_P2119)
rule DaueranlageNurNach240a(t: Testament, vorerbe: Person) strict {
    label de official "Dauerhaft anzulegendes Geld darf der Vorerbe nur entsprechend § 240a anlegen (§ 2119)"; label en unofficial "The prior heir may invest permanently held money only in accordance with § 240a (§ 2119)";
    when dauerhaft_anzulegendes_geld_2119(t, vorerbe); then geldanlage_nach_240a_erforderlich_2119(t, vorerbe);
}
@source(BGB_P2120)
rule NacherbeMussZurOrdentlichenVerwaltungEinwilligen(t: Testament, vorerbe: Person) strict {
    label de official "Ist eine sonst nicht nacherbenwirksame Verfügung zur ordnungsmäßigen Verwaltung erforderlich, muss der Nacherbe einwilligen (§ 2120)"; label en unofficial "If an otherwise ineffective disposition is needed for prudent administration, the subsequent heir must consent (§ 2120)";
    when ordnungsmaessige_verwaltung_braucht_nacherben_einwilligung_2120(t, vorerbe); then nacherbe_muss_einwilligen_2120(t, vorerbe);
}
@source(BGB_P2121)
rule VerzeichnisAufVerlangen(t: Testament, vorerbe: Person) strict {
    label de official "Der Vorerbe hat auf Verlangen des Nacherben ein Verzeichnis der Erbschaftsgegenstände mitzuteilen (§ 2121 Abs. 1)"; label en unofficial "On demand, the prior heir must provide an inventory of estate assets (§ 2121 (1))";
    when nacherbe_verlangt_verzeichnis_2121(t, vorerbe); then vorerbe_muss_verzeichnis_mitteilen_2121(t, vorerbe);
}
@source(BGB_P2122)
rule ZustandsfeststellungDurchSachverstaendige(t: Testament, p: Person) strict {
    label de official "Vorerbe und Nacherbe dürfen den Zustand der Erbschaft auf eigene Kosten durch Sachverständige feststellen lassen (§ 2122)"; label en unofficial "Prior and subsequent heirs may have estate condition determined by experts at their own cost (§ 2122)";
    when zustand_durch_sachverstaendige_feststellen_2122(t, p); then zustandsfeststellung_zulaessig_2122(t, p);
}
@source(BGB_P2123)
rule WirtschaftsplanFuerWaldOderBodenabbau(t: Testament) strict {
    label de official "Bei Wald oder Bodenabbauanlage ist auf Verlangen das Maß der Nutzung und Behandlung durch Wirtschaftsplan festzustellen (§ 2123)"; label en unofficial "For forest or extraction, use and treatment are set by an economic plan on demand (§ 2123)";
    when wald_oder_bodenabbauanlage_in_erbschaft_2123(t) and wirtschaftsplan_verlangt_2123(t); then wirtschaftsplan_festzustellen_2123(t);
}
@source(BGB_P2124)
rule VorerbeTraegtGewoehnlicheErhaltung(t: Testament, vorerbe: Person) strict {
    label de official "Der Vorerbe trägt dem Nacherben gegenüber die gewöhnlichen Erhaltungskosten (§ 2124 Abs. 1)"; label en unofficial "The prior heir bears ordinary maintenance costs vis-à-vis the subsequent heir (§ 2124 (1))";
    when gewoehnliche_erhaltungskosten_2124(t, vorerbe); then vorerbe_traegt_gewoehnliche_erhaltungskosten_2124(t, vorerbe);
}
@source(BGB_P2125)
rule NichtErhaltungVerwendungZuErsetzen(t: Testament, vorerbe: Person) strict {
    label de official "Nicht von § 2124 erfasste Verwendungen muss der Nacherbe bei Eintritt der Nacherbfolge nach GoA-Regeln ersetzen (§ 2125 Abs. 1)"; label en unofficial "The subsequent heir must reimburse non-§2124 expenditure on succession under agency-without-authority rules (§ 2125 (1))";
    when nicht_2124_verwendung_gemacht_2125(t, vorerbe); then nacherbe_muss_verwendung_ersetzen_2125(t, vorerbe);
}
@source(BGB_P2126)
rule VorerbeTraegtKeineAusserordentlicheStammwertlast(t: Testament, vorerbe: Person) strict {
    label de official "Der Vorerbe trägt außerordentliche auf den Stammwert gelegte Lasten nicht (§ 2126)"; label en unofficial "The prior heir does not bear extraordinary burdens on capital value (§ 2126)";
    when ausserordentliche_stammwertlast_2126(t, vorerbe); then vorerbe_traegt_ausserordentliche_last_nicht_2126(t, vorerbe);
}
@source(BGB_P2127)
rule GefaehrdungBegruendetAuskunft(t: Testament, vorerbe: Person) strict {
    label de official "Bei Besorgnis erheblicher Verletzung der Nacherbenrechte durch Verwaltung darf der Nacherbe Auskunft verlangen (§ 2127)"; label en unofficial "Where administration may substantially harm the subsequent right, the subsequent heir may demand information (§ 2127)";
    when verwaltung_gefaehrdet_nacherbrecht_2127(t, vorerbe); then nacherbe_darf_auskunft_verlangen_2127(t, vorerbe);
}
@source(BGB_P2128)
rule BesorgnisBegruendetSicherheit(t: Testament, vorerbe: Person) strict {
    label de official "Bei Besorgnis erheblicher Verletzung durch Verhalten oder Vermögenslage darf der Nacherbe Sicherheit verlangen (§ 2128 Abs. 1)"; label en unofficial "Where conduct or assets give rise to concern of substantial harm, the subsequent heir may demand security (§ 2128 (1))";
    when verhalten_oder_vermoegenslage_besorgnis_2128(t, vorerbe); then nacherbe_darf_sicherheit_verlangen_2128(t, vorerbe);
}
@source(BGB_P2129)
rule VerwaltungsentziehungNimmtVerfuegungsrecht(t: Testament, vorerbe: Person) strict {
    label de official "Wird dem Vorerben die Verwaltung entzogen, verliert er das Recht über Erbschaftsgegenstände zu verfügen (§ 2129 Abs. 1)"; label en unofficial "Where administration is withdrawn from the prior heir, they lose the right to dispose of estate assets (§ 2129 (1))";
    when vorerbe_verwaltung_entzogen_2129(t, vorerbe); then vorerbe_verliert_verfuegungsrecht_2129(t, vorerbe);
}
@source(BGB_P2130) {
    rule HerausgabeNachNacherbfolge(t: Testament, vorerbe: Person) strict {
        label de official "Nach Eintritt der Nacherbfolge muss der Vorerbe die ordentlich verwaltete Erbschaft herausgeben (§ 2130 Abs. 1)"; label en unofficial "After subsequent succession, the prior heir must hand over the prudently managed estate (§ 2130 (1))";
        when nacherbfolge_eingetreten_2130(t, vorerbe); then vorerbe_muss_ordentlich_verwaltete_erbschaft_herausgeben_2130(t, vorerbe);
    }
    rule RechenschaftAufVerlangen(t: Testament, vorerbe: Person) strict {
        label de official "Der Vorerbe hat auf Verlangen Rechenschaft abzulegen (§ 2130 Abs. 2)"; label en unofficial "The prior heir must render an account on demand (§ 2130 (2))";
        when nacherbe_verlangt_rechenschaft_2130(t, vorerbe); then vorerbe_muss_rechenschaft_ablegen_2130(t, vorerbe);
    }
}
@source(BGB_P2131)
rule EigeneSorgfaltGenuegt(t: Testament, vorerbe: Person) strict {
    label de official "Der Vorerbe haftet in der Verwaltung nur für die in eigenen Angelegenheiten übliche Sorgfalt (§ 2131)"; label en unofficial "The prior heir is liable in administration only for care usual in their own affairs (§ 2131)";
    when vorerbe_wendet_eigene_sorgfalt_an_2131(t, vorerbe); then vorerbe_sorgfaltspflicht_erfuellt_2131(t, vorerbe);
}
@source(BGB_P2132)
rule KeineHaftungOrdentlicheAbnutzung(t: Testament, vorerbe: Person) strict {
    label de official "Ordnungsmäßige Benutzung verursachte Abnutzung hat der Vorerbe nicht zu vertreten (§ 2132)"; label en unofficial "The prior heir is not liable for deterioration caused by proper use (§ 2132)";
    when ordnungsmaessige_nutzung_verursacht_abnutzung_2132(t, vorerbe); then vorerbe_nicht_haftbar_gewoehnliche_abnutzung_2132(t, vorerbe);
}
@source(BGB_P2134)
rule EigennutzungErsetztWert(t: Testament, vorerbe: Person) strict {
    label de official "Verwendet der Vorerbe einen Erbschaftsgegenstand für sich, muss er nach Nacherbfolge den Wert ersetzen (§ 2134)"; label en unofficial "Where the prior heir uses an estate asset for themselves, they must compensate value after succession (§ 2134)";
    when vorerbe_verwendet_erbschaftsgegenstand_fuer_sich_2134(t, vorerbe); then vorerbe_muss_wert_ersetzen_2134(t, vorerbe);
}
@source(BGB_P2136)
rule VorerbenbefreiungWirksam(t: Testament, vorerbe: Person) strict {
    label de official "Der Erblasser kann den Vorerben von den in § 2136 genannten Beschränkungen und Verpflichtungen befreien (§ 2136)"; label en unofficial "The testator may release the prior heir from the restrictions and duties named in § 2136 (§ 2136)";
    when erblasser_befreit_vorerbe_2136(t, vorerbe); then befreiung_vorerbe_wirksam_2136(t, vorerbe);
}
@source(BGB_P2137)
presumption RestbestandBegruendetVollbefreiung(t: Testament, vorerbe: Person) {
    label de official "Ist der Nacherbe auf den Restbestand eingesetzt, gilt die Befreiung von allen § 2136-Beschränkungen als angeordnet (§ 2137 Abs. 1)"; label en unofficial "Where the subsequent heir is appointed to the remaining estate, release from all § 2136 restrictions is deemed ordered (§ 2137 (1))";
    when nacherbe_auf_restbestand_eingesetzt_2137(t, vorerbe); presume vollbefreiung_vorerbe_vermutet_2137(t, vorerbe);
}
@source(BGB_P2138)
rule BefreiterVorerbeGibtNurRestHeraus(t: Testament, vorerbe: Person) strict {
    label de official "Die Herausgabepflicht des befreiten Vorerben beschränkt sich auf die bei ihm noch vorhandenen Erbschaftsgegenstände (§ 2138 Abs. 1)"; label en unofficial "A released prior heir's handover duty is limited to estate assets still held (§ 2138 (1))";
    when befreiter_vorerbe_besitzt_nur_restgegenstaende_2138(t, vorerbe); then herausgabepflicht_nur_restgegenstaende_2138(t, vorerbe);
}
@source(BGB_P2139)
rule EintrittNacherbfolgeBeendetVorerbschaft(t: Testament, vorerbe: Person) strict {
    label de official "Mit Eintritt der Nacherbfolge hört der Vorerbe auf, Erbe zu sein, und die Erbschaft fällt dem Nacherben an (§ 2139)"; label en unofficial "Upon subsequent succession, the prior heir ceases to be heir and the estate devolves on the subsequent heir (§ 2139)";
    when nacherbfolge_eingetreten_2139(t, vorerbe); then vorerbe_hoert_auf_erbe_zu_sein_2139(t, vorerbe);
}
@source(BGB_P2140)
rule VorerbeDarfBisKenntnisVerfuegen(t: Testament, vorerbe: Person) strict {
    label de official "Der Vorerbe darf nach Eintritt der Nacherbfolge bis zur Kenntnis weiterhin wie vorher verfügen (§ 2140)"; label en unofficial "After succession, the prior heir may continue to dispose as before until knowledge (§ 2140)";
    when vorerbe_nacherbfolge_noch_nicht_bekannt_2140(t, vorerbe); then vorerbe_darf_bis_kenntnis_wie_bisher_verfuegen_2140(t, vorerbe);
}
@source(BGB_P2141)
rule WerdendeMutterUnterhalt(t: Testament) strict {
    label de official "Ist bei Nacherbfolge die Geburt eines Nacherben zu erwarten, gilt § 1963 für den Unterhaltsanspruch der Mutter entsprechend (§ 2141)"; label en unofficial "Where a subsequent heir's birth is expected at succession, § 1963 applies to the mother's maintenance claim (§ 2141)";
    when geburt_nacherbe_beim_eintritt_zu_erwarten_2141(t); then mutterunterhalt_nach_1963_anwendbar_2141(t);
}
@source(BGB_P2142) {
    rule NacherbeKannAusschlagen(t: Testament, nacherbe: Person) strict {
        label de official "Der Nacherbe kann die Erbschaft ausschlagen, sobald der Erbfall eingetreten ist (§ 2142 Abs. 1)"; label en unofficial "The subsequent heir may disclaim once devolution has occurred (§ 2142 (1))";
        when erbfall_eingetreten_nacherbe_2142(t, nacherbe); then nacherbe_darf_ausschlagen_2142(t, nacherbe);
    }
    rule AusschlagungLaesstErbschaftBeimVorerben(t: Testament, nacherbe: Person) strict {
        label de official "Schlägt der Nacherbe aus, verbleibt die Erbschaft dem Vorerben, soweit nicht anders bestimmt (§ 2142 Abs. 2)"; label en unofficial "If the subsequent heir disclaims, the inheritance remains with the prior heir unless otherwise provided (§ 2142 (2))";
        when nacherbe_hat_ausgeschlagen_2142(t, nacherbe); then erbschaft_verbleibt_vorerben_2142(t, nacherbe);
    }
}
@source(BGB_P2143)
rule RechtsverhaeltnisseLebenWiederAuf(t: Testament) strict {
    label de official "Mit Eintritt der Nacherbfolge gelten durch Vereinigung erloschene Rechtsverhältnisse als nicht erloschen (§ 2143)"; label en unofficial "On subsequent succession, legal relationships extinguished by merger are deemed not extinguished (§ 2143)";
    when nacherbfolge_eingetreten_2143(t); then erloschene_rechtsverhaeltnisse_leben_wieder_2143(t);
}
@source(BGB_P2144)
rule HaftungsbeschraenkungNacherbe(t: Testament, nacherbe: Person) strict {
    label de official "Für den Nacherben gelten Haftungsbeschränkungen für Nachlassverbindlichkeiten (§ 2144 Abs. 1)"; label en unofficial "Limitations of liability for estate debts apply to the subsequent heir (§ 2144 (1))";
    when nacherbe_hat_erbschaft_erlangt_2144(t, nacherbe); then haftungsbeschraenkung_fuer_nacherbe_2144(t, nacherbe);
}
@source(BGB_P2145)
rule VorerbeHaftetSoweitNacherbeNichtHaftet(t: Testament, nacherbe: Person, vorerbe: Person) strict {
    label de official "Der Vorerbe haftet nach Eintritt der Nacherbfolge weiter, soweit der Nacherbe nicht haftet (§ 2145 Abs. 1)"; label en unofficial "The prior heir remains liable after succession insofar as the subsequent heir is not liable (§ 2145 (1))";
    when nacherbe_haftet_nicht_fuer_verbindlichkeit_2145(t, nacherbe, vorerbe); then vorerbe_haftet_weiter_2145(t, vorerbe);
}
@source(BGB_P2146)
rule AnzeigeDerNacherbfolge(t: Testament, vorerbe: Person) strict {
    label de official "Der Vorerbe muss den Eintritt der Nacherbfolge dem Nachlassgericht unverzüglich anzeigen (§ 2146 Abs. 1)"; label en unofficial "The prior heir must promptly notify the probate court of subsequent succession (§ 2146 (1))";
    when nacherbfolge_nachlassgericht_angezeigt_2146(t, vorerbe); then anzeigepflicht_erfuellt_2146(t, vorerbe);
}
@source(BGB_P2147)
rule VermaechtnisKannErbeOderVermaechtnisnehmerBeschweren(t: Testament, p: Person) strict {
    label de official "Mit einem Vermächtnis kann der Erbe oder ein Vermächtnisnehmer beschwert werden (§ 2147)"; label en unofficial "An heir or legatee may be burdened with a legacy (§ 2147)";
    when erbe_oder_vermaechtnisnehmer_mit_vermaechtnis_beschwert_2147(t, p); then beschwerung_mit_vermaechtnis_zulaessig_2147(t, p);
}
@source(BGB_P2148)
presumption MehrereBeschwerteNachWertOderQuote(t: Testament) {
    label de official "Mehrere Beschwerte gelten im Zweifel nach Erbteilen oder Vermächtniswerten als beschwert (§ 2148)"; label en unofficial "Multiple burdened persons are in case of doubt burdened by shares or legacy values (§ 2148)";
    when mehrere_erben_oder_vermaechtnisnehmer_beschwert_2148(t); presume beschwerung_nach_erbteil_oder_vermaechtniswert_vermutet_2148(t);
}
@source(BGB_P2149)
rule AusgeschlossenerGegenstandAlsVermaechtnis(t: Testament) strict {
    label de official "Soll ein eingesetzter Erbe einen Erbschaftsgegenstand nicht erhalten, gilt dieser den gesetzlichen Erben als vermacht (§ 2149)"; label en unofficial "If an appointed heir is not to receive an estate asset, it is deemed bequeathed to statutory heirs (§ 2149)";
    when eingesetzter_erbe_gegenstand_nicht_erhalten_soll_2149(t); then gegenstand_gesetzlichen_erben_vermacht_2149(t);
}
@source(BGB_P2150)
rule VorausvermaechtnisBleibtVermaechtnis(t: Testament, p: Person) strict {
    label de official "Ein einem Erben zugewendetes Vorausvermächtnis gilt auch bei eigener Beschwerung als Vermächtnis (§ 2150)"; label en unofficial "An advance legacy to an heir remains a legacy even where the heir is burdened (§ 2150)";
    when erbe_erhaelt_vorausvermaechtnis_2150(t, p); then vorausvermaechtnis_gilt_auch_bei_eigener_beschwerung_2150(t, p);
}
@source(BGB_P2151)
rule FehlendeEmpfaengerbestimmungMachtGesamtglaeubiger(t: Testament) strict {
    label de official "Kann die Bestimmung bei mehreren Bedachten nicht getroffen werden, sind sie Gesamtgläubiger (§ 2151 Abs. 3)"; label en unofficial "If recipient determination among multiple beneficiaries cannot be made, they are joint creditors (§ 2151 (3))";
    when mehrere_bedachte_bestimmung_durch_beschwerten_oder_dritten_2151(t) and bestimmung_nicht_treffbar_2151(t); then bedachte_gesamtglaeubiger_2151(t);
}
@source(BGB_P2152)
presumption BeschwerterBestimmtWahlbedachten(t: Testament) {
    label de official "Bei wahlweise Bedachten soll im Zweifel der Beschwerte bestimmen, wer das Vermächtnis erhält (§ 2152)"; label en unofficial "For alternative beneficiaries, the burdened person determines the recipient in case of doubt (§ 2152)";
    when mehrere_wahlweise_bedachte_2152(t); presume beschwerter_bestimmt_wahlbedachten_vermutet_2152(t);
}
@source(BGB_P2153)
rule FehlendeAnteilsbestimmungGleicheTeile(t: Testament) strict {
    label de official "Kann die Anteilsbestimmung nicht getroffen werden, sind die Bedachten zu gleichen Teilen berechtigt (§ 2153 Abs. 2)"; label en unofficial "If share allocation cannot be made, beneficiaries are entitled in equal shares (§ 2153 (2))";
    when anteilsbestimmung_nicht_treffbar_2153(t); then bedachte_zu_gleichen_teilen_berechtigt_2153(t);
}
@source(BGB_P2154)
rule FehlendeDrittwahlGehtAufBeschwerten(t: Testament) strict {
    label de official "Kann der Dritte die Wahl beim Wahlvermächtnis nicht treffen, geht das Wahlrecht auf den Beschwerten über (§ 2154 Abs. 2)"; label en unofficial "If the third party cannot elect in an elective legacy, the right passes to the burdened person (§ 2154 (2))";
    when wahlvermaechtnis_dritter_kann_wahl_nicht_treffen_2154(t); then wahlrecht_geht_auf_beschwerten_ueber_2154(t);
}
@source(BGB_P2155)
rule GattungsvermaechtnisPassendeSache(t: Testament) strict {
    label de official "Bei Gattungsvermächtnis ist eine den Verhältnissen des Bedachten entsprechende Sache zu leisten (§ 2155 Abs. 1)"; label en unofficial "For a generic legacy, an item appropriate to the beneficiary's circumstances must be performed (§ 2155 (1))";
    when gattungsvermaechtnis_angeordnet_2155(t); then passende_gattungssache_zu_leisten_2155(t);
}
@source(BGB_P2156)
rule ZweckvermaechtnisBilligesErmessen(t: Testament) strict {
    label de official "Bei Zweckvermächtnis mit Leistungsbestimmung nach billigem Ermessen gelten §§ 315 bis 319 (§ 2156)"; label en unofficial "For a purpose legacy with equitable performance determination, §§ 315–319 apply (§ 2156)";
    when zweckvermaechtnis_leistung_nach_billigem_ermessen_2156(t); then vorschriften_315_bis_319_anwendbar_2156(t);
}
@source(BGB_P2065)
rule BestimmungDerPersonNichtDurchDritten(t: Testament) strict {
    label de official "Der Erblasser kann die Bestimmung der Person, welche eine Zuwendung erhalten soll, sowie die Bestimmung des Gegenstands der Zuwendung nicht einem anderen überlassen (§ 2065 Abs. 2)";
    label en unofficial "The testator may not leave determination of the beneficiary or object of a gift to another (§ 2065 (2))";
    when erbeinsetzung_durch_dritten_bestimmt_2065(t);
    then drittbestimmung_der_erbeinsetzung_unzulaessig_2065(t);
}
@source(BGB_P2253)
rule WiderrufDurchTestament(t: Testament) strict {
    label de official "Der Erblasser kann ein Testament sowie eine einzelne in einem Testament enthaltene Verfügung jederzeit durch Testament widerrufen (§ 2253)";
    label en unofficial "The testator may revoke a will or an individual disposition at any time by will (§ 2253)";
    when testament_widerrufen_durch_neues_2253(t);
    then testament_widerrufen(t);
}
@source(BGB_P2255)
rule WiderrufDurchVernichtung(t: Testament) strict {
    label de official "Ein Testament kann auch dadurch widerrufen werden, dass der Erblasser es in der Absicht, es aufzuheben, vernichtet oder Veränderungen vornimmt (§ 2255 Satz 1)";
    label en unofficial "A will may also be revoked where the testator destroys or alters it intending to revoke it (§ 2255 sentence 1)";
    when testament_vernichtet_mit_widerrufsabsicht_2253(t);
    then testament_widerrufen(t);
}
@source(BGB_P2265)
rule GemeinschaftlichesTestamentNurEhegatten(t: Testament, erster: Person, zweiter: Person) strict {
    label de official "Ein gemeinschaftliches Testament kann nur von Ehegatten errichtet werden (§ 2265)";
    label en unofficial "A joint will may be made only by spouses (§ 2265)";
    when gemeinschaftliches_testament_errichtet(t, erster, zweiter) and zum_errichtungszeitpunkt_verheiratet_2265(erster, zweiter, t);
    then gemeinschaftliches_testament_zulaessig(t);
}
@source(BGB_P2274)
rule ErbvertragNurPersoenlich(v: Erbvertrag, person: Person) strict {
    label de official "Der Erblasser kann einen Erbvertrag nur persönlich schließen (§ 2274)";
    label en unofficial "The testator may conclude an inheritance contract only personally (§ 2274)";
    when erbvertrag_persoenlich_geschlossen(v, person);
    then erbvertrag_persoenlich_formwirksam(v, person);
}
@source(BGB_P2276)
rule ErbvertragNotarUndGleichzeitigeAnwesenheit(v: Erbvertrag) strict {
    label de official "Der Erbvertrag muss bei gleichzeitiger Anwesenheit beider Vertragschließenden vor einem Notar geschlossen werden (§ 2276 Abs. 1)";
    label en unofficial "The inheritance contract must be concluded before a notary with both contracting parties simultaneously present (§ 2276 (1))";
    when erbvertrag_notariell_beurkundet_2276(v) and vertragschliessende_gleichzeitig_anwesend_2276(v);
    then erbvertrag_notarielle_form_gewahrt(v);
}
@source(BGB_P2286)
rule VerfuegungsfreiheitUnterLebenden(v: Erbvertrag, person: Person) strict {
    label de official "Durch einen Erbvertrag wird das Recht des Erblassers, über sein Vermögen durch Rechtsgeschäft unter Lebenden zu verfügen, nicht beschränkt (§ 2286)";
    label en unofficial "An inheritance contract does not restrict the testator's right to dispose of assets by inter vivos transaction (§ 2286)";
    when verfuegung_unter_leben_trotz_erbvertrag(v, person);
    then verfuegung_unter_leben_unberuehrt_2286(v, person);
}

// --- Pflichtteilsergänzung (§ 2325) ----------------------------------------------------------------

pub relation schenkung_im_jahr_vor_dem_erbfall(e: Erbfall, s: Schenkung, jahr: Integer) kind derived {
    key(e, s);
    label de official "Die Schenkung liegt im angegebenen Jahr vor dem Erbfall, vom Tag der Leistung an gerechnet (§ 2325 Abs. 3 Satz 1)";
    label en unofficial "The gift lies in the given year before the devolution, counted from the day of performance (§ 2325 (3) sentence 1)";
}
pub relation abschmelzung_zehntel(e: Erbfall, s: Schenkung, zehntel: Integer) kind derived {
    key(e, s);
    label de official "Zehntel, mit denen die Schenkung berücksichtigt wird: zehn im ersten Jahr, jedes weitere Jahr eines weniger, null nach zehn Jahren (§ 2325 Abs. 3)";
    label en unofficial "tenths at which the gift is taken into account: ten in the first year, one less each further year, zero after ten years (§ 2325 (3))";
}
pub relation anrechnungsbetrag_zehntel(e: Erbfall, s: Schenkung, betrag: Money) kind derived {
    key(e, s);
    label de official "Anzusetzender Wert mal Zehntel (noch nicht durch zehn geteilt)";
    label en unofficial "value taken into account times tenths (not yet divided by ten)";
}
pub relation pflichtteilsergaenzung(e: Erbfall, p: Person, betrag: Money) kind derived {
    key(e, p);
    label de official "Pflichtteilsergänzungsanspruch: der Betrag, um den sich der Pflichtteil erhöht, wenn die verschenkten Gegenstände dem Nachlass hinzugerechnet werden (§ 2325 Abs. 1), mit Abschmelzung (Abs. 3), einmal auf den Cent gerundet (Politik des Pakets)";
    label en unofficial "supplementary compulsory-portion claim: the amount by which the portion increases when the gifts are added to the estate (§ 2325 (1)), with the sliding scale ((3)), rounded once to the cent (package policy)";
}

@source(BGB_P2325) {
    rule SchenkungImErstenJahr(e: Erbfall, s: Schenkung, t: Date, l: Date) strict {
        label de official "Die Schenkung wird innerhalb des ersten Jahres vor dem Erbfall in vollem Umfang berücksichtigt (§ 2325 Abs. 3 Satz 1): Leistung am oder nach dem Tag ein Jahr vor dem Erbfall";
        label en unofficial "A gift within the first year before the devolution is taken into account in full (§ 2325 (3) sentence 1)";
        when de.bgb.erbfolge::erbfall_am(e, t) and abschmelzungsbeginn(s, l) and t >= l and t < add_calendar_period(l, 1 calendar_year);
        then schenkung_im_jahr_vor_dem_erbfall(e, s, 1);
    }
    rule SchenkungImZweitenJahr(e: Erbfall, s: Schenkung, t: Date, l: Date) strict {
        label de official "Innerhalb jedes weiteren Jahres vor dem Erbfall um jeweils ein Zehntel weniger (§ 2325 Abs. 3 Satz 1): zweites Jahr";
        label en unofficial "Each further year before the devolution one tenth less (§ 2325 (3) sentence 1): second year";
        when de.bgb.erbfolge::erbfall_am(e, t) and abschmelzungsbeginn(s, l) and t >= add_calendar_period(l, 1 calendar_year) and t < add_calendar_period(l, 2 calendar_year);
        then schenkung_im_jahr_vor_dem_erbfall(e, s, 2);
    }
    rule SchenkungImDrittenJahr(e: Erbfall, s: Schenkung, t: Date, l: Date) strict {
        label de official "Innerhalb jedes weiteren Jahres vor dem Erbfall um jeweils ein Zehntel weniger (§ 2325 Abs. 3 Satz 1): drittes Jahr";
        label en unofficial "Each further year one tenth less (§ 2325 (3) sentence 1): third year";
        when de.bgb.erbfolge::erbfall_am(e, t) and abschmelzungsbeginn(s, l) and t >= add_calendar_period(l, 2 calendar_year) and t < add_calendar_period(l, 3 calendar_year);
        then schenkung_im_jahr_vor_dem_erbfall(e, s, 3);
    }
    rule SchenkungImViertenJahr(e: Erbfall, s: Schenkung, t: Date, l: Date) strict {
        label de official "Innerhalb jedes weiteren Jahres vor dem Erbfall um jeweils ein Zehntel weniger (§ 2325 Abs. 3 Satz 1): viertes Jahr";
        label en unofficial "Each further year one tenth less (§ 2325 (3) sentence 1): fourth year";
        when de.bgb.erbfolge::erbfall_am(e, t) and abschmelzungsbeginn(s, l) and t >= add_calendar_period(l, 3 calendar_year) and t < add_calendar_period(l, 4 calendar_year);
        then schenkung_im_jahr_vor_dem_erbfall(e, s, 4);
    }
    rule SchenkungImFuenftenJahr(e: Erbfall, s: Schenkung, t: Date, l: Date) strict {
        label de official "Innerhalb jedes weiteren Jahres vor dem Erbfall um jeweils ein Zehntel weniger (§ 2325 Abs. 3 Satz 1): fünftes Jahr";
        label en unofficial "Each further year one tenth less (§ 2325 (3) sentence 1): fifth year";
        when de.bgb.erbfolge::erbfall_am(e, t) and abschmelzungsbeginn(s, l) and t >= add_calendar_period(l, 4 calendar_year) and t < add_calendar_period(l, 5 calendar_year);
        then schenkung_im_jahr_vor_dem_erbfall(e, s, 5);
    }
    rule SchenkungImSechstenJahr(e: Erbfall, s: Schenkung, t: Date, l: Date) strict {
        label de official "Innerhalb jedes weiteren Jahres vor dem Erbfall um jeweils ein Zehntel weniger (§ 2325 Abs. 3 Satz 1): sechstes Jahr";
        label en unofficial "Each further year one tenth less (§ 2325 (3) sentence 1): sixth year";
        when de.bgb.erbfolge::erbfall_am(e, t) and abschmelzungsbeginn(s, l) and t >= add_calendar_period(l, 5 calendar_year) and t < add_calendar_period(l, 6 calendar_year);
        then schenkung_im_jahr_vor_dem_erbfall(e, s, 6);
    }
    rule SchenkungImSiebtenJahr(e: Erbfall, s: Schenkung, t: Date, l: Date) strict {
        label de official "Innerhalb jedes weiteren Jahres vor dem Erbfall um jeweils ein Zehntel weniger (§ 2325 Abs. 3 Satz 1): siebtes Jahr";
        label en unofficial "Each further year one tenth less (§ 2325 (3) sentence 1): seventh year";
        when de.bgb.erbfolge::erbfall_am(e, t) and abschmelzungsbeginn(s, l) and t >= add_calendar_period(l, 6 calendar_year) and t < add_calendar_period(l, 7 calendar_year);
        then schenkung_im_jahr_vor_dem_erbfall(e, s, 7);
    }
    rule SchenkungImAchtenJahr(e: Erbfall, s: Schenkung, t: Date, l: Date) strict {
        label de official "Innerhalb jedes weiteren Jahres vor dem Erbfall um jeweils ein Zehntel weniger (§ 2325 Abs. 3 Satz 1): achtes Jahr";
        label en unofficial "Each further year one tenth less (§ 2325 (3) sentence 1): eighth year";
        when de.bgb.erbfolge::erbfall_am(e, t) and abschmelzungsbeginn(s, l) and t >= add_calendar_period(l, 7 calendar_year) and t < add_calendar_period(l, 8 calendar_year);
        then schenkung_im_jahr_vor_dem_erbfall(e, s, 8);
    }
    rule SchenkungImNeuntenJahr(e: Erbfall, s: Schenkung, t: Date, l: Date) strict {
        label de official "Innerhalb jedes weiteren Jahres vor dem Erbfall um jeweils ein Zehntel weniger (§ 2325 Abs. 3 Satz 1): neuntes Jahr";
        label en unofficial "Each further year one tenth less (§ 2325 (3) sentence 1): ninth year";
        when de.bgb.erbfolge::erbfall_am(e, t) and abschmelzungsbeginn(s, l) and t >= add_calendar_period(l, 8 calendar_year) and t < add_calendar_period(l, 9 calendar_year);
        then schenkung_im_jahr_vor_dem_erbfall(e, s, 9);
    }
    rule SchenkungImZehntenJahr(e: Erbfall, s: Schenkung, t: Date, l: Date) strict {
        label de official "Innerhalb jedes weiteren Jahres vor dem Erbfall um jeweils ein Zehntel weniger (§ 2325 Abs. 3 Satz 1): zehntes Jahr";
        label en unofficial "Each further year one tenth less (§ 2325 (3) sentence 1): tenth year";
        when de.bgb.erbfolge::erbfall_am(e, t) and abschmelzungsbeginn(s, l) and t >= add_calendar_period(l, 9 calendar_year) and t < add_calendar_period(l, 10 calendar_year);
        then schenkung_im_jahr_vor_dem_erbfall(e, s, 10);
    }
    rule AbschmelzungNachJahr(e: Erbfall, s: Schenkung, j: Integer) strict {
        label de official "Zehn Zehntel im ersten Jahr, jedes weitere Jahr eines weniger (§ 2325 Abs. 3 Satz 1): elf minus Jahr";
        label en unofficial "Ten tenths in the first year, one less each further year (§ 2325 (3) sentence 1): eleven minus year";
        when schenkung_im_jahr_vor_dem_erbfall(e, s, j);
        then abschmelzung_zehntel(e, s, 11 - j);
    }
    rule SchenkungNachZehnJahrenUnberuecksichtigt(e: Erbfall, s: Schenkung, t: Date, l: Date) strict {
        label de official "Sind zehn Jahre seit der Leistung des verschenkten Gegenstandes verstrichen, bleibt die Schenkung unberücksichtigt (§ 2325 Abs. 3 Satz 2)";
        label en unofficial "If ten years have passed since performance of the gift, it is disregarded (§ 2325 (3) sentence 2)";
        when de.bgb.erbfolge::erbfall_am(e, t) and abschmelzungsbeginn(s, l) and t >= add_calendar_period(l, 10 calendar_year);
        then abschmelzung_zehntel(e, s, 0);
    }
    rule AnrechnungsbetragZehntel(e: Erbfall, s: Schenkung, p: Person, w: Money, k: Integer) strict {
        label de official "Der verschenkte Gegenstand wird mit seinem anzusetzenden Wert (§ 2325 Abs. 2) und den Zehnteln der Abschmelzung (Abs. 3) dem Nachlass hinzugerechnet";
        label en unofficial "The gift is added to the estate at its accountable value (§ 2325 (2)) and the tenths of the sliding scale ((3))";
        when schenkung_des_erblassers(e, s, p) and anzusetzender_wert(s, w) and abschmelzung_zehntel(e, s, k);
        then anrechnungsbetrag_zehntel(e, s, w * k);
    }
    rule Pflichtteilsergaenzung(e: Erbfall, p: Person, z: Integer, n: Integer, s: Schenkung, m: Money) strict {
        label de official "Der Pflichtteilsberechtigte kann als Ergänzung des Pflichtteils den Betrag verlangen, um den sich der Pflichtteil erhöht, wenn der verschenkte Gegenstand dem Nachlass hinzugerechnet wird (§ 2325 Abs. 1): Summe der angerechneten Werte × Quote, durch zehn, einmal auf den Cent gerundet (Politik des Pakets)";
        label en unofficial "The entitled person may demand as a supplement the amount by which the portion increases when the gift is added to the estate (§ 2325 (1)): sum of accounted values × quota, divided by ten, rounded once to the cent (package policy)";
        when pflichtteilsquote_bruch(e, p, z, n) and anrechnungsbetrag_zehntel(e, s, m);
        then pflichtteilsergaenzung(e, p, div_round((sum all y: Money for x: Schenkung where anrechnungsbetrag_zehntel(e, x, y)) * z, n * 10.0, 2, "HALF_UP"));
    }
}
