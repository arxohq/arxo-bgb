// BÜRGERLICHES GESETZBUCH, BUCH 5 — VERSTREUTE STELLEN
// (§§ 2200, 2228, 2254, 2166 Abs. 1–3). Modul 4 des Fortsetzungsauftrags
// vom 18.09.2026: Überprüfung der Vorgänger-Grenzen bei § 2200/§ 2228.
//
// § 2200 IST KEINE REINE VERFAHRENSNORM: Abs. 1 verleiht dem Nachlassgericht
// die BEFUGNIS zur Ernennung eines Testamentsvollstreckers, wenn der
// Erblasser darum ersucht hat — das ist eine materielle Rechtsfolge
// (Amtsentstehung), nicht ein Verfahrensschritt ohne eigene Wirkung. Die
// Ernennung mündet in DENSELBEN Kopf wie § 2197
// (`ernennung_wirksam_2197`), damit die gesamte nachgelagerte TV-Maschinerie
// (Amt, Vergütung, Haftung) unabhängig vom Ernennungsweg greift. Abs. 2
// (Anhörung „soll … wenn es ohne erhebliche Verzögerung … geschehen kann“)
// bleibt reine Ordnungsvorschrift ohne selbständige Rechtsfolge außerhalb
// des Verfahrens — hierin bestätigt sich die Vorgänger-Einschätzung nur
// TEILWEISE (nur für Abs. 2, nicht für Abs. 1).
//
// § 2228 IST EBENFALLS KEINE REINE VERFAHRENSNORM: sie begründet ein
// Einsichtsrecht — eine materielle Berechtigung Dritter — bei glaubhaft
// gemachtem rechtlichem Interesse; Kanal §47.3 wie bei § 2384 Abs. 2
// desselben Pakets (identisches Wertungsmerkmal „rechtliches Interesse
// glaubhaft machen“, authority Court).
//
// § 2254 BLEIBT OHNE EIGENE REGEL — Vorgänger-Einschätzung BESTÄTIGT: alle
// Widerrufsregeln des Pakets (§§ 2253, 2255–2258,
// `abschnitt-03-titel-07-errichtung-und-aufhebung.law`) sind bereits
// STRUKTURELL auf `t: Testament` als widerrufendes Instrument typisiert —
// es gibt im Modell keine andere Widerrufsform, die § 2254 ausschließen
// müsste. Eine eigene Regel hätte keinen eigenständigen Inhalt.
//
// § 2166 ABS. 1–3 (Belastung mit einer Hypothek): die Verpflichtung des
// Vermächtnisnehmers ist ein VERGLEICH zweier Geldbeträge (Schuld, Wert des
// Grundstücks) — „insoweit … gedeckt wird“ heißt: der KLEINERE der beiden
// Beträge, genau das Niederstwertprinzip-Muster aus § 2325 Abs. 2
// (`NiederstwertLeistungswert`/`NiederstwertErbfallwert`, zwei
// `strict`-Regeln mit `<=`/`>`) — KEINE Multiplikation, kein `div_round`.
//
// §§ 2167, 2168, 2168a BLEIBEN GRENZE MIT BEGRÜNDUNG: ihre Verpflichtung
// ist ein ANTEIL nach dem WERTVERHÄLTNIS zweier Grundstücke (Wert des
// vermachten Grundstücks zum Wert sämtlicher belasteter Grundstücke) — ein
// Quotient zweier Money-Größen, nicht zweier ganzer Zahlen wie beim
// gesetzlichen Erbteil (Bruch z/n). Money × Money ist undefiniert (Lehre);
// eine korrekte Umrechnung in Cent-Ganzzahlen (Rechenwache) für einen
// Wertquotienten wurde in diesem Zug nicht geprüft, und ein falscher
// Finanzformel-Fehler wiegt schwerer als eine offene Aufgabe — bewusst
// nicht versucht, statt einer riskanten Näherung. § 2168a erweitert §§
// 2166 f. nur auf Schiffe/Schiffsbauwerke, für die dieses Paket keinen
// eigenen Sachentitätstyp führt (Grundstücke werden hier nicht als eigene
// Entität, sondern über Testament-Ebene Fakten abgebildet) — auch ohne
// gesonderten Rechtssatz.

language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// ---- § 2200 Ernennung durch das Nachlassgericht ----------------------------

pub relation erblasser_ersucht_nachlassgericht_um_ernennung_2200(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser hat in dem Testament das Nachlassgericht ersucht, einen Testamentsvollstrecker zu ernennen (§ 2200 Abs. 1)";
    label en unofficial "in the will the testator asked the probate court to appoint an executor (§ 2200 (1))";
}
pub relation nachlassgericht_ernennt_testamentsvollstrecker_2200(t: Testament, vollstrecker: Person) kind empirical {
    label de official "Das Nachlassgericht nimmt die Ernennung des Testamentsvollstreckers vor (§ 2200 Abs. 1)";
    label en unofficial "the probate court makes the appointment of the executor (§ 2200 (1))";
}

// ---- § 2228 Akteneinsicht ---------------------------------------------------

pub relation erklaerung_nach_2198_2199_2202_2226_abgegeben_2228(t: Testament, erklaerender: Person) kind empirical {
    label de official "Eine Erklärung nach § 2198 Abs. 1 Satz 2, § 2199 Abs. 3, § 2202 Abs. 2 oder § 2226 Satz 2 ist abgegeben (§ 2228)";
    label en unofficial "a declaration under § 2198 (1) sentence 2, § 2199 (3), § 2202 (2) or § 2226 sentence 2 has been made (§ 2228)";
}
pub relation dritter_begehrt_akteneinsicht_2228(t: Testament, dritter: Person) kind empirical {
    label de official "Ein Dritter begehrt Einsicht der abgegebenen Erklärungen (§ 2228)";
    label en unofficial "a third party seeks to inspect the declarations made (§ 2228)";
}
pub external judgment relation rechtliches_interesse_glaubhaft_gemacht_2228(t: Testament, dritter: Person) {
    authority Court;
    label de official "Der Dritte macht ein rechtliches Interesse glaubhaft (§ 2228)";
    label en unofficial "the third party shows a credible legal interest (§ 2228)";
}
pub relation akteneinsicht_zu_gestatten_2228(t: Testament, dritter: Person) kind derived {
    label de official "Das Nachlassgericht hat dem Dritten die Einsicht zu gestatten (§ 2228)";
    label en unofficial "the probate court must allow the third party to inspect (§ 2228)";
}

// ---- § 2166 Belastung mit einer Hypothek -----------------------------------

pub relation vermachtes_grundstueck_mit_hypothek_belastet_2166(t: Testament, vermaechtnisnehmer: Person, erbe: Person) kind empirical {
    label de official "Ein vermachtes, zur Erbschaft gehörendes Grundstück ist mit einer Hypothek für eine Schuld des Erblassers oder eine ihm obliegende Schuld belastet (§ 2166 Abs. 1 Satz 1)";
    label en unofficial "a bequeathed estate parcel is encumbered with a mortgage for a debt of the testator or one owed by him (§ 2166 (1) sentence 1)";
}
pub relation hypothekenschuld_betrag_2166(t: Testament, schuld: Money) kind empirical {
    label de official "Die durch die Hypothek gesicherte Schuld beträgt den angegebenen Betrag (§ 2166 Abs. 1 Satz 1)";
    label en unofficial "the debt secured by the mortgage is the stated amount (§ 2166 (1) sentence 1)";
}
pub relation grundstueckswert_beim_eigentumsuebergang_2166(t: Testament, wert: Money) kind empirical {
    label de official "Der Wert des Grundstücks zur Zeit des Eigentumsübergangs auf den Vermächtnisnehmer, nach Abzug vorgehender Belastungen, beträgt den angegebenen Betrag (§ 2166 Abs. 1 Satz 2)";
    label en unofficial "the parcel's value at the time title passes to the legatee, after deducting prior-ranking encumbrances, is the stated amount (§ 2166 (1) sentence 2)";
}
pub relation hypothek_der_art_des_1190_2166(t: Testament) kind empirical {
    label de official "Die Hypothek ist eine Hypothek der in § 1190 bezeichneten Art (Höchstbetragshypothek) (§ 2166 Abs. 3)";
    label en unofficial "the mortgage is of the § 1190 kind (maximum-amount mortgage) (§ 2166 (3))";
}
pub relation dritter_zur_berichtigung_verpflichtet_2166(t: Testament) kind empirical {
    label de official "Ein Dritter ist dem Erblasser gegenüber zur Berichtigung der Schuld verpflichtet (§ 2166 Abs. 2)";
    label en unofficial "a third party owes the testator a duty to discharge the debt (§ 2166 (2))";
}
pub relation erbe_kann_berichtigung_von_drittem_erlangen_2166(t: Testament, erbe: Person, vermaechtnisnehmer: Person, betrag: Money) kind empirical {
    label de official "Der Erbe kann die Berichtigung von dem Dritten erlangen (§ 2166 Abs. 2, Gegenausnahme)";
    label en unofficial "the heir can obtain discharge from the third party (§ 2166 (2), counter-exception)";
}
pub relation gedeckter_betrag_2166(t: Testament, betrag: Money) kind derived {
    label de official "Die Schuld ist durch den Grundstückswert in Höhe des angegebenen Betrags gedeckt — der kleinere der beiden Werte (§ 2166 Abs. 1)";
    label en unofficial "the debt is covered by the parcel's value up to the stated amount — the lower of the two figures (§ 2166 (1))";
}
pub relation vermaechtnisnehmer_zur_befriedigung_verpflichtet_2166(t: Testament, vermaechtnisnehmer: Person, erbe: Person, betrag: Money) kind derived {
    label de official "Der Vermächtnisnehmer ist dem Erben gegenüber zur rechtzeitigen Befriedigung des Gläubigers in Höhe des angegebenen Betrags verpflichtet (§ 2166)";
    label en unofficial "the legatee owes the heir timely satisfaction of the creditor up to the stated amount (§ 2166)";
}

// ============================================================================

@source(BGB_P2200)
rule ErnennungDurchNachlassgericht(t: Testament, erblasser: Person, vollstrecker: Person) strict {
    label de official "Hat der Erblasser im Testament das Nachlassgericht um Ernennung eines Testamentsvollstreckers ersucht, kann das Gericht die Ernennung vornehmen (§ 2200 Abs. 1)";
    label en unofficial "where the testator asked the probate court in the will to appoint an executor, the court may make the appointment (§ 2200 (1))";
    when erblasser_ersucht_nachlassgericht_um_ernennung_2200(t, erblasser) and nachlassgericht_ernennt_testamentsvollstrecker_2200(t, vollstrecker);
    then ernennung_wirksam_2197(t, vollstrecker);
}

@source(BGB_P2228)
rule AkteneinsichtBeiGlaubhaftemInteresse(t: Testament, erklaerender: Person, dritter: Person) strict {
    label de official "Das Nachlassgericht hat die Einsicht der genannten Erklärungen jedem zu gestatten, der ein rechtliches Interesse glaubhaft macht (§ 2228)";
    label en unofficial "the probate court must allow inspection of the listed declarations to anyone who shows a credible legal interest (§ 2228)";
    when erklaerung_nach_2198_2199_2202_2226_abgegeben_2228(t, erklaerender) and dritter_begehrt_akteneinsicht_2228(t, dritter) and rechtliches_interesse_glaubhaft_gemacht_2228(t, dritter);
    then akteneinsicht_zu_gestatten_2228(t, dritter);
}

@source(BGB_P2166) {
    rule GedeckterBetragBeiSchuldNichtGroesser(t: Testament, schuld: Money, wert: Money) strict {
        label de official "Ist die Schuld nicht größer als der Grundstückswert, ist sie in voller Höhe gedeckt (§ 2166 Abs. 1)";
        label en unofficial "where the debt does not exceed the parcel's value, it is fully covered (§ 2166 (1))";
        when hypothekenschuld_betrag_2166(t, schuld) and grundstueckswert_beim_eigentumsuebergang_2166(t, wert) and schuld <= wert;
        then gedeckter_betrag_2166(t, schuld);
    }
    rule GedeckterBetragBeiWertGeringer(t: Testament, schuld: Money, wert: Money) strict {
        label de official "Ist der Grundstückswert geringer als die Schuld, ist die Schuld nur in Höhe des Wertes gedeckt (§ 2166 Abs. 1)";
        label en unofficial "where the parcel's value is lower than the debt, it is covered only up to that value (§ 2166 (1))";
        when hypothekenschuld_betrag_2166(t, schuld) and grundstueckswert_beim_eigentumsuebergang_2166(t, wert) and wert < schuld;
        then gedeckter_betrag_2166(t, wert);
    }
    rule VerpflichtungOhneDritten(t: Testament, vermaechtnisnehmer: Person, erbe: Person, betrag: Money) strict {
        label de official "Ohne Berichtigungspflicht eines Dritten ist der Vermächtnisnehmer in Höhe des gedeckten Betrags verpflichtet (§ 2166 Abs. 1)";
        label en unofficial "absent a third party's duty to discharge, the legatee is liable up to the covered amount (§ 2166 (1))";
        when vermachtes_grundstueck_mit_hypothek_belastet_2166(t, vermaechtnisnehmer, erbe) and gedeckter_betrag_2166(t, betrag) and not_known(hypothek_der_art_des_1190_2166(t)) and not_known(dritter_zur_berichtigung_verpflichtet_2166(t));
        then vermaechtnisnehmer_zur_befriedigung_verpflichtet_2166(t, vermaechtnisnehmer, erbe, betrag);
    }
    presumption VerpflichtungSubsidiaerBeiDrittem(t: Testament, vermaechtnisnehmer: Person, erbe: Person, betrag: Money) {
        label de official "Ist ein Dritter zur Berichtigung verpflichtet, besteht die Verpflichtung des Vermächtnisnehmers im Zweifel nur, soweit der Erbe die Berichtigung nicht von dem Dritten erlangen kann (§ 2166 Abs. 2)";
        label en unofficial "where a third party owes discharge, the legatee's duty applies in case of doubt only insofar as the heir cannot obtain it from the third party (§ 2166 (2))";
        when vermachtes_grundstueck_mit_hypothek_belastet_2166(t, vermaechtnisnehmer, erbe) and gedeckter_betrag_2166(t, betrag) and dritter_zur_berichtigung_verpflichtet_2166(t) and not_known(hypothek_der_art_des_1190_2166(t));
        presume vermaechtnisnehmer_zur_befriedigung_verpflichtet_2166(t, vermaechtnisnehmer, erbe, betrag);
        unless erbe_kann_berichtigung_von_drittem_erlangen_2166(t, erbe, vermaechtnisnehmer, betrag);
    }
}
