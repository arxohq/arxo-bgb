language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

pub relation position_trigger_2164(t: Person, tag: Date) kind empirical { label de official "Vermächtniszubehör nach § 2164"; label en unofficial "legacy accessories under § 2164"; }
pub relation position_trigger_2174(t: Person, p: Person, tag: Date) kind empirical { label de official "Vermächtnisanspruch nach § 2174"; label en unofficial "legacy claim under § 2174"; }
pub relation position_trigger_2231(t: Person, p: Person, tag: Date) kind empirical { label de official "Notarielle Testamentserrichtung nach § 2231"; label en unofficial "notarial execution of a will under § 2231"; }
pub relation position_trigger_2266(t: Person, p: Person, tag: Date) kind empirical { label de official "Gemeinschaftliches Nottestament nach § 2266"; label en unofficial "joint emergency will under § 2266"; }

@source(BGB_P2164)
rule PositionZubehoer2164(t: Person, tag: Date) strict { label de official "Das Zubehör gilt als mitvermacht (§ 2164)"; label en unofficial "accessories are deemed bequeathed (§ 2164)"; when position_trigger_2164(t, tag); then liberty Zubehoer2164 { holder t; action position_trigger_2164(t, tag); window [tag, infinity); }; }
@source(BGB_P2174)
rule PositionAnspruch2174(t: Person, p: Person, tag: Date) strict { label de official "Der Bedachte kann die Leistung aus dem Vermächtnis verlangen (§ 2174)"; label en unofficial "the beneficiary may demand performance of the legacy (§ 2174)"; when position_trigger_2174(t, p, tag); then liberty Anspruch2174 { holder p; action position_trigger_2174(t, p, tag); window [tag, infinity); }; }
@source(BGB_P2231)
rule PositionForm2231(t: Person, p: Person, tag: Date) strict { label de official "Das Testament kann durch notarielle Niederschrift errichtet werden (§ 2231)"; label en unofficial "the will may be executed by notarial record (§ 2231)"; when position_trigger_2231(t, p, tag); then liberty Form2231 { holder p; action position_trigger_2231(t, p, tag); window [tag, infinity); }; }
@source(BGB_P2266)
rule PositionNottestament2266(t: Person, p: Person, tag: Date) strict { label de official "Das gemeinschaftliche Testament darf als Nottestament errichtet werden (§ 2266)"; label en unofficial "the joint will may be made as an emergency will (§ 2266)"; when position_trigger_2266(t, p, tag); then liberty Nottestament2266 { holder p; action position_trigger_2266(t, p, tag); window [tag, infinity); }; }
