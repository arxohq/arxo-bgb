// BÜRGERLICHES GESETZBUCH, BUCH 5 ABSCHNITT 4 — ERBVERTRAG (§§ 2275,
// 2278–2302; § 2277 „(weggefallen)“, §§ 2274, 2276, 2286 bereits in
// package.law — NICHT angetastet, nur ergänzt: § 2276 Abs. 2 fehlte).
//
// § 2276 ABS. 2 — MOST ZU de.bgb.ehe § 1410: `ehevertrag_formwirksam` und
// der Typ `Ehevertrag` sind beim Eigentümer bereits `pub` (sources.law/
// titel-06-02-vertragliches-gueterrecht.law) — kein neuer `pub` nötig,
// reine qualifizierte Referenz.
//
// § 2283 EIN JAHR und § 2287 Abs. 2 DREI JAHRE: die Verjährungsfrist selbst
// (§§ 195, 199) ist nicht importiert (de.bgb.fristen liefert Hemmung/
// Neubeginn, keine allgemeine Verjährungsfrist als Rechenbaustein für
// dieses Paket) — diese Runde formalisiert den GENANNTEN Fristbeginn
// (Zeitpunkt) als eigenes Datum, nicht die volle Fristberechnung; das
// Fristende bleibt Fallangabe wie an anderen Stellen des Pakets ohne
// eigenen Verjährungsrechner.

language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// --- Deklarationen §§ 2275, 2278–2286 --------------------------------------

pub relation erblasser_unbeschraenkt_geschaeftsfaehig_2275(v: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Der Erblasser ist unbeschränkt geschäftsfähig (§ 2275)";
    label en unofficial "the testator has unlimited legal capacity (§ 2275)";
}
pub relation erbvertrag_voraussetzung_geschaeftsfaehigkeit_erfuellt_2275(v: Erbvertrag, erblasser: Person) kind derived {
    label de official "Die Voraussetzung des § 2275 ist erfüllt (§ 2275)";
    label en unofficial "the § 2275 requirement is met (§ 2275)";
}
pub relation erbvertrag_zwischen_ehegatten_oder_verlobten_mit_ehevertrag_verbunden_2276(v: Erbvertrag, ehevertrag: de.bgb.ehe::Ehevertrag) kind empirical {
    label de official "Der Erbvertrag zwischen Ehegatten oder Verlobten ist mit einem Ehevertrag in derselben Urkunde verbunden (§ 2276 Abs. 2)";
    label en unofficial "the inheritance contract between spouses or persons engaged to marry is combined with a marriage contract in the same document (§ 2276 (2))";
}
pub relation erbvertragsform_durch_ehevertragsform_gewahrt_2276(v: Erbvertrag) kind derived {
    label de official "Für den Erbvertrag genügt die für den Ehevertrag vorgeschriebene Form (§ 2276 Abs. 2)";
    label en unofficial "the form prescribed for the marriage contract suffices for the inheritance contract (§ 2276 (2))";
}
pub relation vertragschliessender_trifft_vertragsmaessige_verfuegung_2278(v: Erbvertrag, person: Person) kind empirical {
    label de official "Ein Vertragschließender trifft im Erbvertrag eine vertragsmäßige Verfügung von Todes wegen (§ 2278 Abs. 1)";
    label en unofficial "a contracting party makes a contractual disposition mortis causa in the inheritance contract (§ 2278 (1))";
}
pub relation vertragsmaessige_verfuegung_zulaessig_2278(v: Erbvertrag, person: Person) kind derived {
    label de official "Die vertragsmäßige Verfügung ist zulässig (§ 2278 Abs. 1)";
    label en unofficial "the contractual disposition is permitted (§ 2278 (1))";
}
pub relation verfuegung_weder_erbeinsetzung_noch_vermaechtnis_noch_auflage_noch_rechtswahl_2278(v: Erbvertrag, person: Person) kind empirical {
    label de official "Die Verfügung ist weder Erbeinsetzung, Vermächtnis, Auflage noch Wahl des anzuwendenden Erbrechts (§ 2278 Abs. 2)";
    label en unofficial "the disposition is neither an heir appointment, legacy, charge nor a choice of applicable succession law (§ 2278 (2))";
}
pub relation vertragsmaessige_verfuegung_unzulaessig_2278(v: Erbvertrag, person: Person) kind derived {
    label de official "Eine solche Verfügung kann vertragsmäßig nicht getroffen werden (§ 2278 Abs. 2)";
    label en unofficial "such a disposition cannot be made contractually (§ 2278 (2))";
}
pub relation vertragsmaessige_zuwendung_oder_auflage_angeordnet_2279(v: Erbvertrag, person: Person) kind empirical {
    label de official "Eine vertragsmäßige Zuwendung oder Auflage ist angeordnet (§ 2279 Abs. 1)";
    label en unofficial "a contractual grant or charge is ordered (§ 2279 (1))";
}
pub relation letztwillige_vorschriften_auf_vertragsmaessige_zuwendung_entsprechend_anwendbar_2279(v: Erbvertrag, person: Person) kind derived {
    label de official "Die für letztwillige Zuwendungen und Auflagen geltenden Vorschriften finden entsprechende Anwendung (§ 2279 Abs. 1)";
    label en unofficial "the rules governing testamentary grants and charges apply mutatis mutandis (§ 2279 (1))";
}
pub relation erbvertrag_zwischen_ehegatten_lebenspartnern_verlobten_dritter_bedacht_2279(v: Erbvertrag, dritter: Person) kind empirical {
    label de official "Ein Dritter ist in einem Erbvertrag zwischen Ehegatten, Lebenspartnern oder Verlobten bedacht (§ 2279 Abs. 2)";
    label en unofficial "a third party is a beneficiary in an inheritance contract between spouses, civil partners or persons engaged to marry (§ 2279 (2))";
}
pub relation p2077_auch_fuer_drittbedachten_anwendbar_2279(v: Erbvertrag, dritter: Person) kind derived {
    label de official "§ 2077 gilt auch insoweit, als der Dritte bedacht ist (§ 2279 Abs. 2)";
    label en unofficial "§ 2077 applies also to the extent the third party is a beneficiary (§ 2279 (2))";
}
pub relation ehegatten_oder_lebenspartner_gegenseitige_einsetzung_mit_drittzuwendung_im_erbvertrag_2280(v: Erbvertrag, dritter: Person) kind empirical {
    label de official "Ehegatten oder Lebenspartner haben sich im Erbvertrag gegenseitig eingesetzt und Drittzuwendung nach dem Überlebenden oder ein nach dessen Tod zu erfüllendes Vermächtnis bestimmt (§ 2280)";
    label en unofficial "spouses or civil partners appointed each other in the contract and provided for a third-party grant, or a legacy performable, after the survivor's death (§ 2280)";
}
pub relation p2269_auf_erbvertrag_entsprechend_anwendbar_2280(v: Erbvertrag, dritter: Person) kind derived {
    label de official "§ 2269 findet entsprechende Anwendung (§ 2280)";
    label en unofficial "§ 2269 applies mutatis mutandis (§ 2280)";
}
pub relation erblasser_ficht_erbvertrag_wegen_2078_oder_2079_an_2281(v: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Der Erblasser ficht den Erbvertrag auf Grund der §§ 2078, 2079 an (§ 2281 Abs. 1)";
    label en unofficial "the testator avoids the contract under §§ 2078, 2079 (§ 2281 (1))";
}
pub relation pflichtteilsberechtigter_zur_zeit_der_2079_anfechtung_vorhanden_2281(v: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Bei Anfechtung auf Grund des § 2079 ist der Pflichtteilsberechtigte zur Zeit der Anfechtung vorhanden (§ 2281 Abs. 1)";
    label en unofficial "for avoidance under § 2079, the person entitled to the compulsory portion exists at the time of avoidance (§ 2281 (1))";
}
pub relation anfechtung_durch_erblasser_zulaessig_2281(v: Erbvertrag, erblasser: Person) kind derived {
    label de official "Die Anfechtung durch den Erblasser ist zulässig (§ 2281 Abs. 1)";
    label en unofficial "avoidance by the testator is permitted (§ 2281 (1))";
}
pub relation anfechtung_gegen_drittbeguenstigung_nach_tod_des_anderen_2281(v: Erbvertrag, erblasser: Person, dritter: Person) kind empirical {
    label de official "Nach dem Tode des anderen Vertragschließenden soll eine zugunsten eines Dritten getroffene Verfügung angefochten werden (§ 2281 Abs. 2 Satz 1)";
    label en unofficial "after the other contracting party's death, a disposition in favour of a third party is to be avoided (§ 2281 (2) sentence 1)";
}
pub relation anfechtung_ggue_nachlassgericht_zu_erklaeren_2281(v: Erbvertrag, erblasser: Person) kind derived {
    label de official "Die Anfechtung ist dem Nachlassgericht gegenüber zu erklären (§ 2281 Abs. 2 Satz 1)";
    label en unofficial "avoidance must be declared to the probate court (§ 2281 (2) sentence 1)";
}
pub relation anfechtung_durch_vertreter_versucht_2282(v: Erbvertrag, vertreter: Person) kind empirical {
    label de official "Die Anfechtung wird durch einen Vertreter des Erblassers versucht (§ 2282 Abs. 1)";
    label en unofficial "avoidance is attempted through a representative of the testator (§ 2282 (1))";
}
pub relation anfechtung_durch_vertreter_unwirksam_2282(v: Erbvertrag, vertreter: Person) kind derived {
    label de official "Die Anfechtung durch den Vertreter ist unwirksam (§ 2282 Abs. 1)";
    label en unofficial "avoidance by the representative is ineffective (§ 2282 (1))";
}
pub relation erblasser_geschaeftsunfaehig_und_betreuer_ficht_an_2282(v: Erbvertrag, erblasser: Person, betreuer: Person) kind empirical {
    label de official "Der Erblasser ist geschäftsunfähig, und sein Betreuer ficht den Erbvertrag an (§ 2282 Abs. 2)";
    label en unofficial "the testator lacks legal capacity, and their custodian avoids the contract (§ 2282 (2))";
}
pub relation anfechtung_durch_betreuer_zulaessig_2282(v: Erbvertrag, betreuer: Person) kind derived {
    label de official "Die Anfechtung durch den Betreuer ist zulässig (§ 2282 Abs. 2)";
    label en unofficial "avoidance by the custodian is permitted (§ 2282 (2))";
}
pub relation anfechtungserklaerung_notariell_beurkundet_2282(v: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Die Anfechtungserklärung ist notariell beurkundet (§ 2282 Abs. 3)";
    label en unofficial "the declaration of avoidance is notarised (§ 2282 (3))";
}
pub relation anfechtungserklaerung_formwirksam_2282(v: Erbvertrag, erblasser: Person) kind derived {
    label de official "Die Anfechtungserklärung ist formwirksam (§ 2282 Abs. 3)";
    label en unofficial "the declaration of avoidance is valid in form (§ 2282 (3))";
}
pub relation anfechtbarkeit_wegen_drohung_2283(v: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Die Anfechtbarkeit beruht auf Drohung (§ 2283 Abs. 2 Halbsatz 1)";
    label en unofficial "voidability rests on duress (§ 2283 (2) first half-sentence)";
}
pub relation anfechtungsgrund_zwangslage_endete_am_2283(v: Erbvertrag, erblasser: Person, tag: Date) kind empirical {
    label de official "Im Falle der Anfechtbarkeit wegen Drohung endet die Zwangslage am angegebenen Tag (§ 2283 Abs. 2)";
    label en unofficial "in case of voidability for duress, the compulsion ends on the stated day (§ 2283 (2))";
}
pub relation anfechtungsfrist_beginn_drohung_2283(v: Erbvertrag, erblasser: Person, tag: Date) kind derived {
    label de official "Die Jahresfrist des § 2283 Abs. 1 beginnt mit dem Ende der Zwangslage (§ 2283 Abs. 2 Halbsatz 1)";
    label en unofficial "the one-year period of § 2283 (1) begins when the compulsion ends (§ 2283 (2) first half-sentence)";
}
pub relation kenntnis_vom_anfechtungsgrund_am_2283(v: Erbvertrag, erblasser: Person, tag: Date) kind empirical {
    label de official "Der Erblasser erlangt in den übrigen Fällen Kenntnis von dem Anfechtungsgrund am angegebenen Tag (§ 2283 Abs. 2)";
    label en unofficial "in the other cases the testator learns of the ground for avoidance on the stated day (§ 2283 (2))";
}
pub relation anfechtungsfrist_beginn_kenntnis_2283(v: Erbvertrag, erblasser: Person, tag: Date) kind derived {
    label de official "Die Jahresfrist beginnt mit der Kenntnis vom Anfechtungsgrund (§ 2283 Abs. 2 Halbsatz 2)";
    label en unofficial "the one-year period begins on learning of the ground for avoidance (§ 2283 (2) second half-sentence)";
}
pub relation gesetzlicher_vertreter_hat_nicht_rechtzeitig_angefochten_und_geschaeftsunfaehigkeit_weggefallen_2283(v: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Der gesetzliche Vertreter hat im Falle des § 2282 Abs. 2 nicht rechtzeitig angefochten, und die Geschäftsunfähigkeit ist weggefallen (§ 2283 Abs. 3)";
    label en unofficial "in a § 2282 (2) case, the legal representative did not avoid in time, and incapacity has ended (§ 2283 (3))";
}
pub relation erblasser_selbst_anfechtungsberechtigt_2283(v: Erbvertrag, erblasser: Person) kind derived {
    label de official "Der Erblasser kann den Erbvertrag nach Wegfall der Geschäftsunfähigkeit selbst anfechten, wie ohne gesetzlichen Vertreter (§ 2283 Abs. 3)";
    label en unofficial "the testator may, after incapacity ends, avoid the contract personally, as if never represented (§ 2283 (3))";
}
pub relation erblasser_bestaetigt_anfechtbaren_erbvertrag_persoenlich_2284(v: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Der Erblasser bestätigt den anfechtbaren Erbvertrag persönlich (§ 2284)";
    label en unofficial "the testator personally confirms the voidable contract (§ 2284)";
}
pub relation bestaetigung_wirksam_2284(v: Erbvertrag, erblasser: Person) kind derived {
    label de official "Die Bestätigung ist wirksam (§ 2284)";
    label en unofficial "the confirmation is valid (§ 2284)";
}
pub relation anfechtungsrecht_des_erblassers_zur_zeit_des_erbfalls_erloschen_2285(v: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Das Anfechtungsrecht des Erblassers ist zur Zeit des Erbfalls erloschen (§ 2285)";
    label en unofficial "the testator's right to avoid has lapsed at the time of devolution (§ 2285)";
}
pub relation dritte_koennen_nicht_mehr_anfechten_2285(v: Erbvertrag) kind derived {
    label de official "Die in § 2080 bezeichneten Personen können den Erbvertrag nicht mehr anfechten (§ 2285)";
    label en unofficial "the persons named in § 2080 can no longer avoid the contract (§ 2285)";
}

// --- Deklarationen §§ 2287–2302 --------------------------------------------

pub relation erblasser_beeintraechtigt_vertragserben_durch_schenkung_2287(v: Erbvertrag, vertragserbe: Person, schenkung: Schenkung, beschenkter: Person) kind empirical {
    label de official "Der Erblasser hat in Beeinträchtigungsabsicht eine Schenkung gemacht, und dem Vertragserben ist die Erbschaft angefallen (§ 2287 Abs. 1)";
    label en unofficial "the testator made a gift intending to prejudice the contractual heir, and the estate has devolved on the heir (§ 2287 (1))";
}
pub relation herausgabe_nach_bereicherungsrecht_forderbar_2287(v: Erbvertrag, vertragserbe: Person, beschenkter: Person) kind derived {
    label de official "Der Vertragserbe kann vom Beschenkten Herausgabe des Geschenks nach Bereicherungsrecht fordern (§ 2287 Abs. 1)";
    label en unofficial "the contractual heir may demand return of the gift from the donee under unjust-enrichment rules (§ 2287 (1))";
}
pub relation erbfall_am_fuer_2287_anspruch_2287(v: Erbvertrag, e: Erbfall, tag: Date) kind empirical {
    label de official "Der Erbfall, mit dem die Verjährungsfrist des Anspruchs nach § 2287 beginnt, tritt am angegebenen Tag ein (§ 2287 Abs. 2)";
    label en unofficial "the devolution beginning the limitation period of the § 2287 claim occurs on the stated day (§ 2287 (2))";
}
pub relation verjaehrungsbeginn_2287_anspruch(v: Erbvertrag, tag: Date) kind derived {
    label de official "Die Verjährungsfrist des Anspruchs nach § 2287 beginnt mit dem Erbfall (§ 2287 Abs. 2)";
    label en unofficial "the limitation period of the § 2287 claim begins with the devolution (§ 2287 (2))";
}
pub relation erblasser_zerstoert_beschaedigt_vermaechtnisgegenstand_beeintraechtigungsabsicht_erbe_ausserstande_2288(v: Erbvertrag, erbe: Person, bedachter: Person) kind empirical {
    label de official "Der Erblasser hat den vertragsmäßig vermachten Gegenstand in Beeinträchtigungsabsicht zerstört, beiseite geschafft oder beschädigt, und der Erbe ist dadurch außerstande, die Leistung zu bewirken (§ 2288 Abs. 1)";
    label en unofficial "the testator, intending prejudice, destroyed, removed or damaged the contractually bequeathed object, and the heir is thereby unable to perform (§ 2288 (1))";
}
pub relation wert_tritt_an_stelle_des_gegenstands_2288(v: Erbvertrag, bedachter: Person) kind derived {
    label de official "An die Stelle des Gegenstands tritt der Wert (§ 2288 Abs. 1)";
    label en unofficial "the value takes the place of the object (§ 2288 (1))";
}
pub relation erblasser_veraeussert_oder_belastet_vermaechtnisgegenstand_beeintraechtigungsabsicht_2288(v: Erbvertrag, erbe: Person, bedachter: Person) kind empirical {
    label de official "Der Erblasser hat den Gegenstand in Beeinträchtigungsabsicht veräußert oder belastet (§ 2288 Abs. 2 Satz 1)";
    label en unofficial "the testator, intending prejudice, alienated or encumbered the object (§ 2288 (2) sentence 1)";
}
pub relation erbe_zur_verschaffung_oder_beseitigung_verpflichtet_2288(v: Erbvertrag, erbe: Person, bedachter: Person) kind derived {
    label de official "Der Erbe ist verpflichtet, dem Bedachten den Gegenstand zu verschaffen oder die Belastung zu beseitigen (§ 2288 Abs. 2 Satz 1)";
    label en unofficial "the heir must procure the object for the beneficiary or remove the encumbrance (§ 2288 (2) sentence 1)";
}
pub relation veraeusserung_oder_belastung_schenkweise_erblasser_ersatz_von_erben_nicht_erlangbar_2288(v: Erbvertrag, bedachter: Person, beschenkter: Person) kind empirical {
    label de official "Die Veräußerung oder Belastung ist schenkweise erfolgt, und der Bedachte kann Ersatz vom Erben nicht erlangen (§ 2288 Abs. 2 Satz 2)";
    label en unofficial "the alienation or encumbrance was gratuitous, and the beneficiary cannot obtain compensation from the heir (§ 2288 (2) sentence 2)";
}
pub relation anspruch_gegen_beschenkten_wie_2287_2288(v: Erbvertrag, bedachter: Person, beschenkter: Person) kind derived {
    label de official "Dem Bedachten steht der im § 2287 bestimmte Anspruch gegen den Beschenkten zu (§ 2288 Abs. 2 Satz 2)";
    label en unofficial "the beneficiary has the § 2287 claim against the donee (§ 2288 (2) sentence 2)";
}
pub relation vertragsmaessige_zuwendung_beeintraechtigt_fruehere_letztwillige_verfuegung_2289(v: Erbvertrag, bedachter: Person) kind empirical {
    label de official "Das Recht des vertragsmäßig Bedachten würde durch eine frühere letztwillige Verfügung des Erblassers beeinträchtigt (§ 2289 Abs. 1 Satz 1)";
    label en unofficial "the contractual beneficiary's right would be prejudiced by an earlier testamentary disposition of the testator (§ 2289 (1) sentence 1)";
}
pub relation fruehere_letztwillige_verfuegung_insoweit_aufgehoben_2289(v: Erbvertrag, bedachter: Person) kind derived {
    label de official "Die frühere letztwillige Verfügung wird insoweit aufgehoben (§ 2289 Abs. 1 Satz 1)";
    label en unofficial "the earlier testamentary disposition is revoked to that extent (§ 2289 (1) sentence 1)";
}
pub relation spaetere_verfuegung_von_todes_wegen_beeintraechtigt_ohne_2297_2289(v: Erbvertrag, bedachter: Person) kind empirical {
    label de official "Eine spätere Verfügung von Todes wegen würde das Recht des Bedachten beeinträchtigen, und § 2297 greift nicht ein (§ 2289 Abs. 1 Satz 2)";
    label en unofficial "a later testamentary disposition would prejudice the beneficiary's right, and § 2297 does not apply (§ 2289 (1) sentence 2)";
}
pub relation spaetere_verfuegung_unwirksam_2289(v: Erbvertrag, bedachter: Person) kind derived {
    label de official "Die spätere Verfügung ist im gleichen Umfang unwirksam (§ 2289 Abs. 1 Satz 2)";
    label en unofficial "the later disposition is ineffective to the same extent (§ 2289 (1) sentence 2)";
}
pub relation bedachter_pflichtteilsberechtigter_abkoemmling_2289(v: Erbvertrag, bedachter: Person) kind empirical {
    label de official "Der Bedachte ist ein pflichtteilsberechtigter Abkömmling des Erblassers (§ 2289 Abs. 2)";
    label en unofficial "the beneficiary is a compulsory-portion-entitled descendant of the testator (§ 2289 (2))";
}
pub relation p2338_anordnungen_durch_spaetere_letztwillige_verfuegung_zulaessig_2289(v: Erbvertrag, bedachter: Person) kind derived {
    label de official "Der Erblasser kann durch spätere letztwillige Verfügung die nach § 2338 zulässigen Anordnungen treffen (§ 2289 Abs. 2)";
    label en unofficial "the testator may make the § 2338 orders by a later testamentary disposition (§ 2289 (2))";
}
pub relation vertragschliessende_heben_erbvertrag_oder_verfuegung_durch_vertrag_auf_bei_lebzeiten_2290(v: Erbvertrag, aufhebungsvertrag: Erbvertrag) kind empirical {
    label de official "Die den Erbvertrag schließenden Personen heben ihn oder eine einzelne vertragsmäßige Verfügung durch Vertrag auf, beide noch lebend (§ 2290 Abs. 1 Satz 1, 2)";
    label en unofficial "the parties to the contract revoke it or a single contractual disposition by contract, both still alive (§ 2290 (1) sentences 1, 2)";
}
pub relation aufhebung_durch_vertrag_wirksam_2290(v: Erbvertrag, aufhebungsvertrag: Erbvertrag) kind derived {
    label de official "Die Aufhebung durch Vertrag ist wirksam (§ 2290 Abs. 1 Satz 1)";
    label en unofficial "the revocation by contract is valid (§ 2290 (1) sentence 1)";
}
pub relation aufhebungsvertrag_persoenlich_geschlossen_2290(v: Erbvertrag, aufhebungsvertrag: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Der Erblasser schließt den Aufhebungsvertrag persönlich (§ 2290 Abs. 2)";
    label en unofficial "the testator concludes the revocation contract personally (§ 2290 (2))";
}
pub relation aufhebungsvertrag_notarielle_form_nach_2276_gewahrt_2290(v: Erbvertrag, aufhebungsvertrag: Erbvertrag) kind empirical {
    label de official "Der Aufhebungsvertrag wahrt die Form des § 2276 (§ 2290 Abs. 3)";
    label en unofficial "the revocation contract observes the § 2276 form (§ 2290 (3))";
}
pub relation aufhebungsvertrag_formwirksam_2290(v: Erbvertrag, aufhebungsvertrag: Erbvertrag) kind derived {
    label de official "Der Aufhebungsvertrag ist formwirksam (§ 2290 Abs. 2, 3)";
    label en unofficial "the revocation contract is valid in form (§ 2290 (2), (3))";
}
pub relation vermaechtnis_auflage_oder_rechtswahl_durch_testament_aufgehoben_mit_zustimmung_2291(v: Erbvertrag, aufhebungstestament: Testament, erblasser: Person) kind empirical {
    label de official "Eine vertragsmäßige Verfügung über Vermächtnis, Auflage oder Rechtswahl wird durch Testament aufgehoben, der andere Vertragschließende stimmt zu (§ 2291 Abs. 1)";
    label en unofficial "a contractual disposition on legacy, charge or choice of law is revoked by will, with the other party's consent (§ 2291 (1))";
}
pub relation aufhebung_durch_testament_wirksam_2291(v: Erbvertrag, aufhebungstestament: Testament) kind derived {
    label de official "Die Aufhebung durch Testament ist wirksam (§ 2291 Abs. 1)";
    label en unofficial "the revocation by will is valid (§ 2291 (1))";
}
pub relation zustimmungserklaerung_notariell_beurkundet_2291(v: Erbvertrag, zustimmender: Person) kind empirical {
    label de official "Die Zustimmungserklärung ist notariell beurkundet (§ 2291 Abs. 2)";
    label en unofficial "the declaration of consent is notarised (§ 2291 (2))";
}
pub relation zustimmung_formwirksam_und_unwiderruflich_2291(v: Erbvertrag, zustimmender: Person) kind derived {
    label de official "Die Zustimmung ist formwirksam und unwiderruflich (§ 2291 Abs. 2)";
    label en unofficial "the consent is valid in form and irrevocable (§ 2291 (2))";
}
pub relation zwischen_ehegatten_oder_lebenspartnern_geschlossener_erbvertrag_durch_gemeinschaftliches_testament_aufgehoben_2292(v: Erbvertrag, t: Testament) kind empirical {
    label de official "Ein zwischen Ehegatten oder Lebenspartnern geschlossener Erbvertrag wird durch ein gemeinschaftliches Testament aufgehoben (§ 2292)";
    label en unofficial "an inheritance contract between spouses or civil partners is revoked by a joint will (§ 2292)";
}
pub relation aufhebung_durch_gemeinschaftliches_testament_zulaessig_2292(v: Erbvertrag, t: Testament) kind derived {
    label de official "Die Aufhebung durch gemeinschaftliches Testament ist zulässig (§ 2292)";
    label en unofficial "revocation by joint will is permitted (§ 2292)";
}
pub relation ruecktritt_im_erbvertrag_vorbehalten_2293(v: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Der Erblasser hat sich im Erbvertrag den Rücktritt vorbehalten (§ 2293)";
    label en unofficial "the testator reserved the right to withdraw in the contract (§ 2293)";
}
pub relation ruecktritt_bei_vorbehalt_zulaessig_2293(v: Erbvertrag, erblasser: Person) kind derived {
    label de official "Der Rücktritt vom Erbvertrag ist zulässig (§ 2293)";
    label en unofficial "withdrawal from the contract is permitted (§ 2293)";
}
pub relation bedachter_verfehlung_die_zur_pflichtteilsentziehung_berechtigen_wuerde_2294(v: Erbvertrag, bedachter: Person) kind empirical {
    label de official "Der Bedachte macht sich einer Verfehlung schuldig, die zur Entziehung des Pflichtteils berechtigt oder berechtigen würde, wäre er Abkömmling (§ 2294)";
    label en unofficial "the beneficiary commits an offence entitling withdrawal of the compulsory portion, or would if they were a descendant (§ 2294)";
}
pub relation ruecktritt_bei_verfehlung_zulaessig_2294(v: Erbvertrag, bedachter: Person) kind derived {
    label de official "Der Erblasser kann von der vertragsmäßigen Verfügung zurücktreten (§ 2294)";
    label en unofficial "the testator may withdraw from the contractual disposition (§ 2294)";
}
pub relation gegenverpflichtung_wiederkehrender_leistungen_vor_tod_aufgehoben_2295(v: Erbvertrag, bedachter: Person) kind empirical {
    label de official "Die Verfügung ist mit Rücksicht auf eine Verpflichtung des Bedachten zu wiederkehrenden Leistungen getroffen, und diese wird vor dem Tode des Erblassers aufgehoben (§ 2295)";
    label en unofficial "the disposition was made with regard to the beneficiary's obligation to render recurring performances, which is cancelled before the testator's death (§ 2295)";
}
pub relation ruecktritt_bei_aufhebung_gegenverpflichtung_zulaessig_2295(v: Erbvertrag, bedachter: Person) kind derived {
    label de official "Der Erblasser kann von der vertragsmäßigen Verfügung zurücktreten (§ 2295)";
    label en unofficial "the testator may withdraw from the contractual disposition (§ 2295)";
}
pub relation ruecktritt_durch_vertreter_versucht_2296(v: Erbvertrag, vertreter: Person) kind empirical {
    label de official "Der Rücktritt wird durch einen Vertreter versucht (§ 2296 Abs. 1)";
    label en unofficial "withdrawal is attempted through a representative (§ 2296 (1))";
}
pub relation ruecktritt_durch_vertreter_unwirksam_2296(v: Erbvertrag, vertreter: Person) kind derived {
    label de official "Der Rücktritt durch den Vertreter ist unwirksam (§ 2296 Abs. 1)";
    label en unofficial "withdrawal by the representative is ineffective (§ 2296 (1))";
}
pub relation ruecktrittserklaerung_ggue_anderem_vertragschliessenden_notariell_beurkundet_2296(v: Erbvertrag, ruecktretender: Person, anderer: Person) kind empirical {
    label de official "Die Rücktrittserklärung erfolgt gegenüber dem anderen Vertragschließenden und ist notariell beurkundet (§ 2296 Abs. 2)";
    label en unofficial "the declaration of withdrawal is made to the other contracting party and is notarised (§ 2296 (2))";
}
pub relation ruecktritt_formwirksam_2296(v: Erbvertrag, ruecktretender: Person) kind derived {
    label de official "Der Rücktritt ist formwirksam (§ 2296 Abs. 2)";
    label en unofficial "the withdrawal is valid in form (§ 2296 (2))";
}
pub relation erblasser_ruecktrittsberechtigt_nach_tod_des_anderen_hebt_durch_testament_auf_2297(v: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Der zum Rücktritt berechtigte Erblasser hebt nach dem Tode des anderen Vertragschließenden die vertragsmäßige Verfügung durch Testament auf (§ 2297 Satz 1)";
    label en unofficial "the testator entitled to withdraw revokes the contractual disposition by will after the other party's death (§ 2297 sentence 1)";
}
pub relation aufhebung_durch_testament_nach_ruecktrittsrecht_wirksam_2297(v: Erbvertrag, erblasser: Person) kind derived {
    label de official "Die Aufhebung durch Testament ist wirksam (§ 2297 Satz 1)";
    label en unofficial "the revocation by will is valid (§ 2297 sentence 1)";
}
pub relation ruecktrittsfall_des_2294_2297(v: Erbvertrag, erblasser: Person) kind empirical {
    label de official "Es liegt ein Fall des § 2294 vor (§ 2297 Satz 2)";
    label en unofficial "a § 2294 case applies (§ 2297 sentence 2)";
}
pub relation p2336_abs2_3_entsprechend_anwendbar_2297(v: Erbvertrag, erblasser: Person) kind derived {
    label de official "§ 2336 Abs. 2 und 3 findet entsprechende Anwendung (§ 2297 Satz 2)";
    label en unofficial "§ 2336 (2) and (3) apply mutatis mutandis (§ 2297 sentence 2)";
}
pub relation gegenseitiger_erbvertrag_eine_verfuegung_nichtig_2298(v: Erbvertrag, nichtige_verfuegung: Person) kind empirical {
    label de official "In einem gegenseitigen Erbvertrag ist eine der vertragsmäßigen Verfügungen nichtig (§ 2298 Abs. 1)";
    label en unofficial "in a mutual inheritance contract, one of the contractual dispositions is void (§ 2298 (1))";
}
pub relation ganzer_vertrag_unwirksam_2298(v: Erbvertrag) kind derived {
    label de official "Die Nichtigkeit einer Verfügung hat die Unwirksamkeit des ganzen Vertrags zur Folge (§ 2298 Abs. 1)";
    label en unofficial "the invalidity of one disposition renders the whole contract ineffective (§ 2298 (1))";
}
pub relation gegenseitiger_erbvertrag_ruecktritt_vorbehalten_ausgeuebt_2298(v: Erbvertrag, ruecktretender: Person) kind empirical {
    label de official "In einem gegenseitigen Erbvertrag mit vorbehaltenem Rücktritt übt einer der Vertragschließenden den Rücktritt aus (§ 2298 Abs. 2 Satz 1)";
    label en unofficial "in a mutual contract with a reserved right of withdrawal, one party exercises withdrawal (§ 2298 (2) sentence 1)";
}
pub relation ganzer_vertrag_durch_ruecktritt_aufgehoben_2298(v: Erbvertrag) kind derived {
    label de official "Der ganze Vertrag wird aufgehoben (§ 2298 Abs. 2 Satz 1)";
    label en unofficial "the whole contract is revoked (§ 2298 (2) sentence 1)";
}
pub relation ueberlebender_schlaegt_zuwendung_aus_erbvertrag_aus_2298(v: Erbvertrag, ueberlebender: Person) kind empirical {
    label de official "Der Überlebende schlägt das ihm durch den Vertrag Zugewendete aus (§ 2298 Abs. 2 Satz 3)";
    label en unofficial "the survivor disclaims what was granted to them under the contract (§ 2298 (2) sentence 3)";
}
pub relation ueberlebender_kann_verfuegung_durch_testament_aufheben_2298(v: Erbvertrag, ueberlebender: Person) kind derived {
    label de official "Der Überlebende kann seine Verfügung durch Testament aufheben (§ 2298 Abs. 2 Satz 3)";
    label en unofficial "the survivor may revoke their disposition by will (§ 2298 (2) sentence 3)";
}
pub relation anderer_wille_der_vertragschliessenden_bei_2298_anzunehmen(v: Erbvertrag) kind empirical {
    label de official "Ein anderer Wille der Vertragschließenden ist anzunehmen (§ 2298 Abs. 3, Gegenausnahme)";
    label en unofficial "a different intention of the parties must be assumed (§ 2298 (3), counter-exception)";
}
pub relation vertragschliessender_trifft_einseitige_letztwillensfaehige_verfuegung_im_erbvertrag_2299(v: Erbvertrag, person: Person) kind empirical {
    label de official "Ein Vertragschließender trifft im Erbvertrag einseitig eine Verfügung, die durch Testament getroffen werden könnte (§ 2299 Abs. 1)";
    label en unofficial "a contracting party unilaterally makes in the contract a disposition that could be made by will (§ 2299 (1))";
}
pub relation einseitige_verfuegung_zulaessig_2299(v: Erbvertrag, person: Person) kind derived {
    label de official "Die einseitige Verfügung ist zulässig (§ 2299 Abs. 1)";
    label en unofficial "the unilateral disposition is permitted (§ 2299 (1))";
}
pub relation erbvertrag_durch_ruecktritt_oder_vertrag_aufgehoben_2299(v: Erbvertrag, person: Person) kind empirical {
    label de official "Der Erbvertrag wird durch Ausübung des Rücktrittsrechts oder durch Vertrag aufgehoben (§ 2299 Abs. 3)";
    label en unofficial "the contract is revoked by exercise of the right of withdrawal or by contract (§ 2299 (3))";
}
pub relation einseitige_verfuegung_ausser_kraft_vermutet_2299(v: Erbvertrag, person: Person) kind derived {
    label de official "Die einseitige Verfügung tritt im Zweifel außer Kraft (§ 2299 Abs. 3)";
    label en unofficial "the unilateral disposition lapses in case of doubt (§ 2299 (3))";
}
pub relation anderer_wille_des_erblassers_bei_2299_anzunehmen(v: Erbvertrag, person: Person) kind empirical {
    label de official "Ein anderer Wille des Erblassers ist anzunehmen (§ 2299 Abs. 3, Gegenausnahme)";
    label en unofficial "a different intention of the testator must be assumed (§ 2299 (3), counter-exception)";
}
pub relation erbvertrag_enthaelt_nur_verfuegungen_von_todes_wegen_aus_verwahrung_zurueckgenommen_2300(v: Erbvertrag) kind empirical {
    label de official "Ein nur Verfügungen von Todes wegen enthaltender Erbvertrag wird aus amtlicher oder notarieller Verwahrung zurückgenommen und den Vertragschließenden gemeinschaftlich zurückgegeben (§ 2300 Abs. 2)";
    label en unofficial "an inheritance contract containing only mortis-causa dispositions is withdrawn from official or notarial safekeeping and returned jointly to the parties (§ 2300 (2))";
}
pub relation ruecknahme_wie_2256_abs1_gilt_als_widerrufen_2300(v: Erbvertrag) kind derived {
    label de official "Die Rücknahme gilt entsprechend § 2256 Abs. 1 als Widerruf (§ 2300 Abs. 2 Satz 3)";
    label en unofficial "the withdrawal counts, in line with § 2256 (1), as revocation (§ 2300 (2) sentence 3)";
}
pub relation schenkungsversprechen_unter_ueberlebensbedingung_erteilt_2301(v: Erbvertrag, schenker: Person, beschenkter: Person) kind empirical {
    label de official "Ein Schenkungsversprechen wird unter der Bedingung erteilt, dass der Beschenkte den Schenker überlebt (§ 2301 Abs. 1)";
    label en unofficial "a promise of gift is made on condition that the donee survives the donor (§ 2301 (1))";
}
pub relation vorschriften_ueber_verfuegungen_von_todes_wegen_anwendbar_2301(v: Erbvertrag, schenker: Person, beschenkter: Person) kind derived {
    label de official "Auf das Schenkungsversprechen finden die Vorschriften über Verfügungen von Todes wegen Anwendung (§ 2301 Abs. 1)";
    label en unofficial "the promise is governed by the rules on dispositions mortis causa (§ 2301 (1))";
}
pub relation schenker_vollzieht_schenkung_durch_leistung_2301(v: Erbvertrag, schenker: Person, beschenkter: Person) kind empirical {
    label de official "Der Schenker vollzieht die Schenkung durch Leistung des zugewendeten Gegenstands (§ 2301 Abs. 2)";
    label en unofficial "the donor performs the gift by delivering the granted object (§ 2301 (2))";
}
pub relation vorschriften_ueber_schenkungen_unter_lebenden_anwendbar_2301(v: Erbvertrag, schenker: Person, beschenkter: Person) kind derived {
    label de official "Es finden die Vorschriften über Schenkungen unter Lebenden Anwendung (§ 2301 Abs. 2)";
    label en unofficial "the rules on inter-vivos gifts apply (§ 2301 (2))";
}
pub relation vertrag_ueber_errichtung_nichterrichtung_aufhebung_oder_nichtaufhebung_einer_verfuegung_2302(v: Erbvertrag) kind empirical {
    label de official "Ein Vertrag verpflichtet dazu, eine Verfügung von Todes wegen zu errichten oder nicht zu errichten, aufzuheben oder nicht aufzuheben (§ 2302)";
    label en unofficial "a contract obliges a party to make or not make, revoke or not revoke, a disposition mortis causa (§ 2302)";
}
pub relation solcher_vertrag_nichtig_2302(v: Erbvertrag) kind derived {
    label de official "Ein solcher Vertrag ist nichtig (§ 2302)";
    label en unofficial "such a contract is void (§ 2302)";
}

// --- Regeln §§ 2275, 2276 Abs. 2, 2278–2286 --------------------------------

@source(BGB_P2275)
rule VoraussetzungGeschaeftsfaehigkeit(v: Erbvertrag, erblasser: Person) strict {
    label de official "Einen Erbvertrag kann als Erblasser nur schließen, wer unbeschränkt geschäftsfähig ist (§ 2275)"; label en unofficial "Only a person with unlimited legal capacity may conclude an inheritance contract as testator (§ 2275)";
    when erblasser_unbeschraenkt_geschaeftsfaehig_2275(v, erblasser); then erbvertrag_voraussetzung_geschaeftsfaehigkeit_erfuellt_2275(v, erblasser);
}
@source(BGB_P2276)
rule ErbvertragsformDurchEhevertragsformGewahrt(v: Erbvertrag, ehevertrag: de.bgb.ehe::Ehevertrag) strict {
    label de official "Für einen mit einem Ehevertrag verbundenen Erbvertrag zwischen Ehegatten oder Verlobten genügt die für den Ehevertrag vorgeschriebene Form (§ 2276 Abs. 2)"; label en unofficial "For an inheritance contract between spouses or engaged persons combined with a marriage contract, the marriage-contract form suffices (§ 2276 (2))";
    when erbvertrag_zwischen_ehegatten_oder_verlobten_mit_ehevertrag_verbunden_2276(v, ehevertrag) and de.bgb.ehe::ehevertrag_formwirksam(ehevertrag); then erbvertragsform_durch_ehevertragsform_gewahrt_2276(v);
}
@source(BGB_P2278) {
    rule VertragsmaessigeVerfuegungZulaessig(v: Erbvertrag, person: Person) strict {
        label de official "Jeder Vertragschließende kann im Erbvertrag vertragsmäßige Verfügungen von Todes wegen treffen (§ 2278 Abs. 1)"; label en unofficial "Each contracting party may make contractual dispositions mortis causa in the contract (§ 2278 (1))";
        when vertragschliessender_trifft_vertragsmaessige_verfuegung_2278(v, person); then vertragsmaessige_verfuegung_zulaessig_2278(v, person);
    }
    rule VertragsmaessigeVerfuegungUnzulaessig(v: Erbvertrag, person: Person) strict {
        label de official "Andere Verfügungen als Erbeinsetzung, Vermächtnis, Auflage und Rechtswahl können vertragsmäßig nicht getroffen werden (§ 2278 Abs. 2)"; label en unofficial "Dispositions other than heir appointment, legacy, charge and choice of law cannot be made contractually (§ 2278 (2))";
        when verfuegung_weder_erbeinsetzung_noch_vermaechtnis_noch_auflage_noch_rechtswahl_2278(v, person); then vertragsmaessige_verfuegung_unzulaessig_2278(v, person);
    }
}
@source(BGB_P2279) {
    rule LetztwilligeVorschriftenEntsprechendAnwendbar(v: Erbvertrag, person: Person) strict {
        label de official "Auf vertragsmäßige Zuwendungen und Auflagen finden die für letztwillige Zuwendungen geltenden Vorschriften entsprechende Anwendung (§ 2279 Abs. 1)"; label en unofficial "The rules for testamentary grants and charges apply mutatis mutandis to contractual ones (§ 2279 (1))";
        when vertragsmaessige_zuwendung_oder_auflage_angeordnet_2279(v, person); then letztwillige_vorschriften_auf_vertragsmaessige_zuwendung_entsprechend_anwendbar_2279(v, person);
    }
    rule P2077AuchFuerDrittbedachten(v: Erbvertrag, dritter: Person) strict {
        label de official "§ 2077 gilt für einen Erbvertrag zwischen Ehegatten, Lebenspartnern oder Verlobten auch, soweit ein Dritter bedacht ist (§ 2279 Abs. 2)"; label en unofficial "§ 2077 applies to a contract between spouses, civil partners or engaged persons also as regards a third-party beneficiary (§ 2279 (2))";
        when erbvertrag_zwischen_ehegatten_lebenspartnern_verlobten_dritter_bedacht_2279(v, dritter); then p2077_auch_fuer_drittbedachten_anwendbar_2279(v, dritter);
    }
}
@source(BGB_P2280)
rule P2269AufErbvertragEntsprechendAnwendbar(v: Erbvertrag, dritter: Person) strict {
    label de official "§ 2269 findet auf einen entsprechenden Erbvertrag zwischen Ehegatten oder Lebenspartnern entsprechende Anwendung (§ 2280)"; label en unofficial "§ 2269 applies mutatis mutandis to a corresponding contract between spouses or civil partners (§ 2280)";
    when ehegatten_oder_lebenspartner_gegenseitige_einsetzung_mit_drittzuwendung_im_erbvertrag_2280(v, dritter); then p2269_auf_erbvertrag_entsprechend_anwendbar_2280(v, dritter);
}
@source(BGB_P2281) {
    rule AnfechtungDurchErblasserZulaessig(v: Erbvertrag, erblasser: Person) strict {
        label de official "Der Erbvertrag kann auf Grund der §§ 2078, 2079 auch vom Erblasser angefochten werden; bei § 2079 muss der Pflichtteilsberechtigte zur Zeit der Anfechtung vorhanden sein (§ 2281 Abs. 1)"; label en unofficial "The testator may also avoid under §§ 2078, 2079; for § 2079 the person entitled to the compulsory portion must exist at that time (§ 2281 (1))";
        when erblasser_ficht_erbvertrag_wegen_2078_oder_2079_an_2281(v, erblasser) and pflichtteilsberechtigter_zur_zeit_der_2079_anfechtung_vorhanden_2281(v, erblasser); then anfechtung_durch_erblasser_zulaessig_2281(v, erblasser);
    }
    rule AnfechtungGgueNachlassgericht(v: Erbvertrag, erblasser: Person, dritter: Person) strict {
        label de official "Soll nach dem Tode des anderen Vertragschließenden eine Drittbegünstigung angefochten werden, ist die Anfechtung dem Nachlassgericht gegenüber zu erklären (§ 2281 Abs. 2 Satz 1)"; label en unofficial "Where a third-party benefit is to be avoided after the other party's death, avoidance is declared to the probate court (§ 2281 (2) sentence 1)";
        when anfechtung_gegen_drittbeguenstigung_nach_tod_des_anderen_2281(v, erblasser, dritter); then anfechtung_ggue_nachlassgericht_zu_erklaeren_2281(v, erblasser);
    }
}
@source(BGB_P2282) {
    rule AnfechtungDurchVertreterUnwirksam(v: Erbvertrag, vertreter: Person) strict {
        label de official "Die Anfechtung kann nicht durch einen Vertreter des Erblassers erfolgen (§ 2282 Abs. 1)"; label en unofficial "Avoidance cannot be effected through a representative of the testator (§ 2282 (1))";
        when anfechtung_durch_vertreter_versucht_2282(v, vertreter); then anfechtung_durch_vertreter_unwirksam_2282(v, vertreter);
    }
    rule AnfechtungDurchBetreuer(v: Erbvertrag, erblasser: Person, betreuer: Person) strict {
        label de official "Für einen geschäftsunfähigen Erblasser kann sein Betreuer den Erbvertrag anfechten (§ 2282 Abs. 2)"; label en unofficial "For an incapacitated testator, their custodian may avoid the contract (§ 2282 (2))";
        when erblasser_geschaeftsunfaehig_und_betreuer_ficht_an_2282(v, erblasser, betreuer); then anfechtung_durch_betreuer_zulaessig_2282(v, betreuer);
    }
    rule AnfechtungserklaerungNotarielleForm(v: Erbvertrag, erblasser: Person) strict {
        label de official "Die Anfechtungserklärung bedarf der notariellen Beurkundung (§ 2282 Abs. 3)"; label en unofficial "The declaration of avoidance requires notarisation (§ 2282 (3))";
        when anfechtungserklaerung_notariell_beurkundet_2282(v, erblasser); then anfechtungserklaerung_formwirksam_2282(v, erblasser);
    }
}
@source(BGB_P2283) {
    rule AnfechtungsfristBeginnDrohung(v: Erbvertrag, erblasser: Person, tag: Date) strict {
        label de official "Bei Anfechtbarkeit wegen Drohung beginnt die Jahresfrist mit dem Ende der Zwangslage (§ 2283 Abs. 2 Halbsatz 1)"; label en unofficial "For voidability owing to duress, the one-year period begins when the compulsion ends (§ 2283 (2) first half-sentence)";
        when anfechtbarkeit_wegen_drohung_2283(v, erblasser) and anfechtungsgrund_zwangslage_endete_am_2283(v, erblasser, tag); then anfechtungsfrist_beginn_drohung_2283(v, erblasser, tag);
    }
    rule AnfechtungsfristBeginnKenntnis(v: Erbvertrag, erblasser: Person, tag: Date) strict {
        label de official "In den übrigen Fällen beginnt die Jahresfrist mit der Kenntnis vom Anfechtungsgrund (§ 2283 Abs. 2 Halbsatz 2)"; label en unofficial "In other cases, the one-year period begins on learning of the ground for avoidance (§ 2283 (2) second half-sentence)";
        when kenntnis_vom_anfechtungsgrund_am_2283(v, erblasser, tag) and not_known(anfechtbarkeit_wegen_drohung_2283(v, erblasser)); then anfechtungsfrist_beginn_kenntnis_2283(v, erblasser, tag);
    }
    rule ErblasserSelbstAnfechtungsberechtigtNachWegfall(v: Erbvertrag, erblasser: Person) strict {
        label de official "Hat der gesetzliche Vertreter nicht rechtzeitig angefochten, kann der Erblasser nach Wegfall der Geschäftsunfähigkeit selbst anfechten (§ 2283 Abs. 3)"; label en unofficial "Where the legal representative did not avoid in time, the testator may avoid personally after incapacity ends (§ 2283 (3))";
        when gesetzlicher_vertreter_hat_nicht_rechtzeitig_angefochten_und_geschaeftsunfaehigkeit_weggefallen_2283(v, erblasser); then erblasser_selbst_anfechtungsberechtigt_2283(v, erblasser);
    }
}
@source(BGB_P2284)
rule BestaetigungNurPersoenlich(v: Erbvertrag, erblasser: Person) strict {
    label de official "Die Bestätigung eines anfechtbaren Erbvertrags kann nur durch den Erblasser persönlich erfolgen (§ 2284)"; label en unofficial "Confirmation of a voidable contract can be made only personally by the testator (§ 2284)";
    when erblasser_bestaetigt_anfechtbaren_erbvertrag_persoenlich_2284(v, erblasser); then bestaetigung_wirksam_2284(v, erblasser);
}
@source(BGB_P2285)
rule DritteKoennenNichtMehrAnfechten(v: Erbvertrag, erblasser: Person) strict {
    label de official "Die in § 2080 bezeichneten Personen können nicht mehr anfechten, wenn das Anfechtungsrecht des Erblassers zur Zeit des Erbfalls erloschen ist (§ 2285)"; label en unofficial "The § 2080 persons can no longer avoid once the testator's right to avoid lapsed at devolution (§ 2285)";
    when anfechtungsrecht_des_erblassers_zur_zeit_des_erbfalls_erloschen_2285(v, erblasser); then dritte_koennen_nicht_mehr_anfechten_2285(v);
}

// --- Regeln §§ 2287–2302 ----------------------------------------------------

@source(BGB_P2287) {
    rule HerausgabeNachBereicherungsrecht(v: Erbvertrag, vertragserbe: Person, schenkung: Schenkung, beschenkter: Person) strict {
        label de official "Hat der Erblasser in Beeinträchtigungsabsicht geschenkt, kann der Vertragserbe nach Anfall der Erbschaft vom Beschenkten Herausgabe nach Bereicherungsrecht fordern (§ 2287 Abs. 1)"; label en unofficial "Where the testator gifted with intent to prejudice, the contractual heir, once the estate has devolved, may demand return from the donee under unjust-enrichment rules (§ 2287 (1))";
        when erblasser_beeintraechtigt_vertragserben_durch_schenkung_2287(v, vertragserbe, schenkung, beschenkter); then herausgabe_nach_bereicherungsrecht_forderbar_2287(v, vertragserbe, beschenkter);
    }
    rule VerjaehrungsbeginnMitErbfall(v: Erbvertrag, e: Erbfall, tag: Date) strict {
        label de official "Die Verjährungsfrist des Anspruchs nach § 2287 beginnt mit dem Erbfall (§ 2287 Abs. 2)"; label en unofficial "The limitation period of the § 2287 claim begins with the devolution (§ 2287 (2))";
        when erbfall_am_fuer_2287_anspruch_2287(v, e, tag); then verjaehrungsbeginn_2287_anspruch(v, tag);
    }
}
@source(BGB_P2288) {
    rule WertErsetztGegenstandBeiZerstoerung(v: Erbvertrag, erbe: Person, bedachter: Person) strict {
        label de official "Hat der Erblasser den Gegenstand in Beeinträchtigungsabsicht zerstört, beschädigt oder beiseite geschafft, tritt der Wert an seine Stelle (§ 2288 Abs. 1)"; label en unofficial "Where the testator destroyed, damaged or removed the object intending prejudice, its value takes its place (§ 2288 (1))";
        when erblasser_zerstoert_beschaedigt_vermaechtnisgegenstand_beeintraechtigungsabsicht_erbe_ausserstande_2288(v, erbe, bedachter); then wert_tritt_an_stelle_des_gegenstands_2288(v, bedachter);
    }
    rule ErbeVerschaffungOderBeseitigungBeiVeraeusserung(v: Erbvertrag, erbe: Person, bedachter: Person) strict {
        label de official "Hat der Erblasser den Gegenstand in Beeinträchtigungsabsicht veräußert oder belastet, muss der Erbe ihn verschaffen oder die Belastung beseitigen (§ 2288 Abs. 2 Satz 1)"; label en unofficial "Where the testator alienated or encumbered the object intending prejudice, the heir must procure it or remove the encumbrance (§ 2288 (2) sentence 1)";
        when erblasser_veraeussert_oder_belastet_vermaechtnisgegenstand_beeintraechtigungsabsicht_2288(v, erbe, bedachter); then erbe_zur_verschaffung_oder_beseitigung_verpflichtet_2288(v, erbe, bedachter);
    }
    rule AnspruchGegenBeschenktenBeiSchenkweiserVeraeusserung(v: Erbvertrag, bedachter: Person, beschenkter: Person) strict {
        label de official "War die Veräußerung oder Belastung schenkweise, steht dem Bedachten, soweit Ersatz vom Erben nicht erlangbar, der Anspruch nach § 2287 gegen den Beschenkten zu (§ 2288 Abs. 2 Satz 2)"; label en unofficial "Where the alienation or encumbrance was gratuitous, the beneficiary, to the extent compensation cannot be had from the heir, has the § 2287 claim against the donee (§ 2288 (2) sentence 2)";
        when veraeusserung_oder_belastung_schenkweise_erblasser_ersatz_von_erben_nicht_erlangbar_2288(v, bedachter, beschenkter); then anspruch_gegen_beschenkten_wie_2287_2288(v, bedachter, beschenkter);
    }
}
@source(BGB_P2289) {
    rule FruehereVerfuegungAufgehoben(v: Erbvertrag, bedachter: Person) strict {
        label de official "Durch den Erbvertrag wird eine frühere letztwillige Verfügung aufgehoben, soweit sie das Recht des vertragsmäßig Bedachten beeinträchtigen würde (§ 2289 Abs. 1 Satz 1)"; label en unofficial "The contract revokes an earlier testamentary disposition to the extent it would prejudice the contractual beneficiary's right (§ 2289 (1) sentence 1)";
        when vertragsmaessige_zuwendung_beeintraechtigt_fruehere_letztwillige_verfuegung_2289(v, bedachter); then fruehere_letztwillige_verfuegung_insoweit_aufgehoben_2289(v, bedachter);
    }
    rule SpaetereVerfuegungUnwirksam(v: Erbvertrag, bedachter: Person) strict {
        label de official "In gleichem Umfang ist eine spätere Verfügung von Todes wegen unwirksam, unbeschadet des § 2297 (§ 2289 Abs. 1 Satz 2)"; label en unofficial "To the same extent, a later testamentary disposition is ineffective, without prejudice to § 2297 (§ 2289 (1) sentence 2)";
        when spaetere_verfuegung_von_todes_wegen_beeintraechtigt_ohne_2297_2289(v, bedachter); then spaetere_verfuegung_unwirksam_2289(v, bedachter);
    }
    rule P2338AnordnungenZulaessigBeiAbkoemmling(v: Erbvertrag, bedachter: Person) strict {
        label de official "Ist der Bedachte pflichtteilsberechtigter Abkömmling, kann der Erblasser durch spätere letztwillige Verfügung die nach § 2338 zulässigen Anordnungen treffen (§ 2289 Abs. 2)"; label en unofficial "Where the beneficiary is a compulsory-portion-entitled descendant, the testator may make the § 2338 orders by a later testamentary disposition (§ 2289 (2))";
        when bedachter_pflichtteilsberechtigter_abkoemmling_2289(v, bedachter); then p2338_anordnungen_durch_spaetere_letztwillige_verfuegung_zulaessig_2289(v, bedachter);
    }
}
@source(BGB_P2290) {
    rule AufhebungDurchVertragBeiLebzeitenBeider(v: Erbvertrag, aufhebungsvertrag: Erbvertrag) strict {
        label de official "Der Erbvertrag oder eine einzelne Verfügung kann durch Vertrag der Vertragschließenden aufgehoben werden, solange beide leben (§ 2290 Abs. 1)"; label en unofficial "The contract or a single disposition may be revoked by agreement of the parties while both are alive (§ 2290 (1))";
        when vertragschliessende_heben_erbvertrag_oder_verfuegung_durch_vertrag_auf_bei_lebzeiten_2290(v, aufhebungsvertrag); then aufhebung_durch_vertrag_wirksam_2290(v, aufhebungsvertrag);
    }
    rule AufhebungsvertragFormwirksam(v: Erbvertrag, aufhebungsvertrag: Erbvertrag, erblasser: Person) strict {
        label de official "Der Erblasser schließt den Aufhebungsvertrag nur persönlich, in der Form des § 2276 (§ 2290 Abs. 2, 3)"; label en unofficial "The testator concludes the revocation contract only personally, in the § 2276 form (§ 2290 (2), (3))";
        when aufhebungsvertrag_persoenlich_geschlossen_2290(v, aufhebungsvertrag, erblasser) and aufhebungsvertrag_notarielle_form_nach_2276_gewahrt_2290(v, aufhebungsvertrag); then aufhebungsvertrag_formwirksam_2290(v, aufhebungsvertrag);
    }
}
@source(BGB_P2291) {
    rule AufhebungDurchTestamentMitZustimmung(v: Erbvertrag, aufhebungstestament: Testament, erblasser: Person) strict {
        label de official "Eine vertragsmäßige Verfügung über Vermächtnis, Auflage oder Rechtswahl kann der Erblasser mit Zustimmung des anderen durch Testament aufheben (§ 2291 Abs. 1)"; label en unofficial "A contractual disposition on legacy, charge or choice of law may be revoked by will with the other party's consent (§ 2291 (1))";
        when vermaechtnis_auflage_oder_rechtswahl_durch_testament_aufgehoben_mit_zustimmung_2291(v, aufhebungstestament, erblasser); then aufhebung_durch_testament_wirksam_2291(v, aufhebungstestament);
    }
    rule ZustimmungFormwirksamUndUnwiderruflich(v: Erbvertrag, zustimmender: Person) strict {
        label de official "Die Zustimmungserklärung bedarf der notariellen Beurkundung und ist unwiderruflich (§ 2291 Abs. 2)"; label en unofficial "The declaration of consent requires notarisation and is irrevocable (§ 2291 (2))";
        when zustimmungserklaerung_notariell_beurkundet_2291(v, zustimmender); then zustimmung_formwirksam_und_unwiderruflich_2291(v, zustimmender);
    }
}
@source(BGB_P2292)
rule AufhebungDurchGemeinschaftlichesTestament(v: Erbvertrag, t: Testament) strict {
    label de official "Ein zwischen Ehegatten oder Lebenspartnern geschlossener Erbvertrag kann auch durch gemeinschaftliches Testament aufgehoben werden (§ 2292)"; label en unofficial "A contract between spouses or civil partners may also be revoked by joint will (§ 2292)";
    when zwischen_ehegatten_oder_lebenspartnern_geschlossener_erbvertrag_durch_gemeinschaftliches_testament_aufgehoben_2292(v, t); then aufhebung_durch_gemeinschaftliches_testament_zulaessig_2292(v, t);
}
@source(BGB_P2293)
rule RuecktrittBeiVorbehalt(v: Erbvertrag, erblasser: Person) strict {
    label de official "Der Erblasser kann vom Erbvertrag zurücktreten, wenn er sich den Rücktritt vorbehalten hat (§ 2293)"; label en unofficial "The testator may withdraw from the contract if they reserved the right (§ 2293)";
    when ruecktritt_im_erbvertrag_vorbehalten_2293(v, erblasser); then ruecktritt_bei_vorbehalt_zulaessig_2293(v, erblasser);
}
@source(BGB_P2294)
rule RuecktrittBeiVerfehlung(v: Erbvertrag, bedachter: Person) strict {
    label de official "Der Erblasser kann zurücktreten, wenn sich der Bedachte einer zur Pflichtteilsentziehung berechtigenden Verfehlung schuldig macht (§ 2294)"; label en unofficial "The testator may withdraw where the beneficiary commits an offence entitling withdrawal of the compulsory portion (§ 2294)";
    when bedachter_verfehlung_die_zur_pflichtteilsentziehung_berechtigen_wuerde_2294(v, bedachter); then ruecktritt_bei_verfehlung_zulaessig_2294(v, bedachter);
}
@source(BGB_P2295)
rule RuecktrittBeiAufhebungGegenverpflichtung(v: Erbvertrag, bedachter: Person) strict {
    label de official "Der Erblasser kann zurücktreten, wenn die Gegenverpflichtung zu wiederkehrenden Leistungen vor seinem Tode aufgehoben wird (§ 2295)"; label en unofficial "The testator may withdraw where the counter-obligation to recurring performances is cancelled before their death (§ 2295)";
    when gegenverpflichtung_wiederkehrender_leistungen_vor_tod_aufgehoben_2295(v, bedachter); then ruecktritt_bei_aufhebung_gegenverpflichtung_zulaessig_2295(v, bedachter);
}
@source(BGB_P2296) {
    rule RuecktrittDurchVertreterUnwirksam(v: Erbvertrag, vertreter: Person) strict {
        label de official "Der Rücktritt kann nicht durch einen Vertreter erfolgen (§ 2296 Abs. 1)"; label en unofficial "Withdrawal cannot be effected through a representative (§ 2296 (1))";
        when ruecktritt_durch_vertreter_versucht_2296(v, vertreter); then ruecktritt_durch_vertreter_unwirksam_2296(v, vertreter);
    }
    rule RuecktrittFormwirksam(v: Erbvertrag, ruecktretender: Person, anderer: Person) strict {
        label de official "Der Rücktritt erfolgt durch notariell beurkundete Erklärung gegenüber dem anderen Vertragschließenden (§ 2296 Abs. 2)"; label en unofficial "Withdrawal is by notarised declaration to the other contracting party (§ 2296 (2))";
        when ruecktrittserklaerung_ggue_anderem_vertragschliessenden_notariell_beurkundet_2296(v, ruecktretender, anderer); then ruecktritt_formwirksam_2296(v, ruecktretender);
    }
}
@source(BGB_P2297) {
    rule AufhebungDurchTestamentNachTodDesAnderen(v: Erbvertrag, erblasser: Person) strict {
        label de official "Der zum Rücktritt berechtigte Erblasser kann nach dem Tode des anderen die vertragsmäßige Verfügung durch Testament aufheben (§ 2297 Satz 1)"; label en unofficial "The testator entitled to withdraw may revoke the contractual disposition by will after the other party's death (§ 2297 sentence 1)";
        when erblasser_ruecktrittsberechtigt_nach_tod_des_anderen_hebt_durch_testament_auf_2297(v, erblasser); then aufhebung_durch_testament_nach_ruecktrittsrecht_wirksam_2297(v, erblasser);
    }
    rule P2336Abs23EntsprechendBei2294(v: Erbvertrag, erblasser: Person) strict {
        label de official "In den Fällen des § 2294 findet § 2336 Abs. 2, 3 entsprechende Anwendung (§ 2297 Satz 2)"; label en unofficial "In § 2294 cases, § 2336 (2), (3) apply mutatis mutandis (§ 2297 sentence 2)";
        when ruecktrittsfall_des_2294_2297(v, erblasser); then p2336_abs2_3_entsprechend_anwendbar_2297(v, erblasser);
    }
}
@source(BGB_P2298) {
    rule GanzerVertragUnwirksamBeiNichtigkeit(v: Erbvertrag, nichtige_verfuegung: Person) strict {
        label de official "Sind von beiden Teilen vertragsmäßige Verfügungen getroffen, hat die Nichtigkeit einer die Unwirksamkeit des ganzen Vertrags zur Folge (§ 2298 Abs. 1)"; label en unofficial "Where both parties made contractual dispositions, the invalidity of one renders the whole contract ineffective (§ 2298 (1))";
        when gegenseitiger_erbvertrag_eine_verfuegung_nichtig_2298(v, nichtige_verfuegung); then ganzer_vertrag_unwirksam_2298(v);
    }
    presumption GanzerVertragDurchRuecktrittAufgehoben(v: Erbvertrag, ruecktretender: Person) {
        label de official "Ist der Rücktritt vorbehalten, wird durch den Rücktritt eines Vertragschließenden im Zweifel der ganze Vertrag aufgehoben (§ 2298 Abs. 2 Satz 1)"; label en unofficial "Where withdrawal is reserved, one party's withdrawal in case of doubt revokes the whole contract (§ 2298 (2) sentence 1)";
        when gegenseitiger_erbvertrag_ruecktritt_vorbehalten_ausgeuebt_2298(v, ruecktretender); presume ganzer_vertrag_durch_ruecktritt_aufgehoben_2298(v); unless anderer_wille_der_vertragschliessenden_bei_2298_anzunehmen(v);
    }
    rule UeberlebenderKannErbvertragBeiAusschlagungAufheben(v: Erbvertrag, ueberlebender: Person) strict {
        label de official "Schlägt der Überlebende das ihm Zugewendete aus, kann er seine Verfügung durch Testament aufheben (§ 2298 Abs. 2 Satz 3)"; label en unofficial "Where the survivor disclaims what was granted to them, they may revoke their disposition by will (§ 2298 (2) sentence 3)";
        when ueberlebender_schlaegt_zuwendung_aus_erbvertrag_aus_2298(v, ueberlebender); then ueberlebender_kann_verfuegung_durch_testament_aufheben_2298(v, ueberlebender);
    }
}
@source(BGB_P2299) {
    rule EinseitigeVerfuegungZulaessig(v: Erbvertrag, person: Person) strict {
        label de official "Jeder Vertragschließende kann im Erbvertrag einseitig jede testamentsfähige Verfügung treffen (§ 2299 Abs. 1)"; label en unofficial "Each contracting party may unilaterally make in the contract any disposition that could be made by will (§ 2299 (1))";
        when vertragschliessender_trifft_einseitige_letztwillensfaehige_verfuegung_im_erbvertrag_2299(v, person); then einseitige_verfuegung_zulaessig_2299(v, person);
    }
    presumption EinseitigeVerfuegungAusserKraft(v: Erbvertrag, person: Person) {
        label de official "Wird der Erbvertrag durch Rücktritt oder Vertrag aufgehoben, tritt die einseitige Verfügung im Zweifel außer Kraft (§ 2299 Abs. 3)"; label en unofficial "Where the contract is revoked by withdrawal or agreement, the unilateral disposition lapses in case of doubt (§ 2299 (3))";
        when erbvertrag_durch_ruecktritt_oder_vertrag_aufgehoben_2299(v, person); presume einseitige_verfuegung_ausser_kraft_vermutet_2299(v, person); unless anderer_wille_des_erblassers_bei_2299_anzunehmen(v, person);
    }
}
@source(BGB_P2300)
rule RuecknahmeGiltAlsWiderruf(v: Erbvertrag) strict {
    label de official "Wird ein nur Verfügungen von Todes wegen enthaltender Erbvertrag gemeinschaftlich zurückgenommen, gilt § 2256 Abs. 1 entsprechend (§ 2300 Abs. 2)"; label en unofficial "Where a contract containing only mortis-causa dispositions is jointly withdrawn, § 2256 (1) applies mutatis mutandis (§ 2300 (2))";
    when erbvertrag_enthaelt_nur_verfuegungen_von_todes_wegen_aus_verwahrung_zurueckgenommen_2300(v); then ruecknahme_wie_2256_abs1_gilt_als_widerrufen_2300(v);
}
@source(BGB_P2301) {
    rule SchenkungsversprechenAlsVerfuegungVonTodesWegen(v: Erbvertrag, schenker: Person, beschenkter: Person) strict {
        label de official "Auf ein unter Überlebensbedingung erteiltes Schenkungsversprechen finden die Vorschriften über Verfügungen von Todes wegen Anwendung (§ 2301 Abs. 1)"; label en unofficial "The rules on dispositions mortis causa apply to a promise of gift made on condition of survival (§ 2301 (1))";
        when schenkungsversprechen_unter_ueberlebensbedingung_erteilt_2301(v, schenker, beschenkter); then vorschriften_ueber_verfuegungen_von_todes_wegen_anwendbar_2301(v, schenker, beschenkter);
    }
    rule VollzugDurchLeistungAlsLebendschenkung(v: Erbvertrag, schenker: Person, beschenkter: Person) strict {
        label de official "Vollzieht der Schenker die Schenkung durch Leistung, finden die Vorschriften über Schenkungen unter Lebenden Anwendung (§ 2301 Abs. 2)"; label en unofficial "Where the donor performs the gift by delivery, the rules on inter-vivos gifts apply (§ 2301 (2))";
        when schenker_vollzieht_schenkung_durch_leistung_2301(v, schenker, beschenkter); then vorschriften_ueber_schenkungen_unter_lebenden_anwendbar_2301(v, schenker, beschenkter);
    }
}
@source(BGB_P2302)
rule VertragUeberErrichtungOderAufhebungNichtig(v: Erbvertrag) strict {
    label de official "Ein Vertrag, durch den sich jemand zur Errichtung, Nichterrichtung, Aufhebung oder Nichtaufhebung einer Verfügung von Todes wegen verpflichtet, ist nichtig (§ 2302)"; label en unofficial "A contract obliging someone to make or not make, revoke or not revoke, a disposition mortis causa is void (§ 2302)";
    when vertrag_ueber_errichtung_nichterrichtung_aufhebung_oder_nichtaufhebung_einer_verfuegung_2302(v); then solcher_vertrag_nichtig_2302(v);
}
