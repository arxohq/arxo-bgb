// BÜRGERLICHES GESETZBUCH, BUCH 5 ABSCHNITT 3 TITEL 7 — ERRICHTUNG UND
// AUFHEBUNG EINES TESTAMENTS (§§ 2229–2264, nur die im Register
// tatsächlich vorhandenen Paragraphen: §§ 2230, 2260–2262, 2264 sind
// „(weggefallen)“ — kein Fragment, keine Norm, kein Formalisierungsauftrag).
//
// § 2229 Abs. 1 (Altersgrenze) und § 2247 Abs. 1, 2 (eigenhändige
// Grundform) sind BEREITS in package.law formalisiert
// (testierfaehig_alter_2229, eigenhaendiges_testament_formwirksam) — diese
// Runde rührt sie NICHT an, sondern ergänzt: § 2229 Abs. 2 (keine
// Zustimmung des Vertreters nötig), Abs. 4 (Testierunfähigkeit — die
// bereits als `external judgment relation geistestoerung_testierunfaehig_
// 2229` deklarierte, bisher an KEINE Regel angeschlossene Wertung wird
// hier erstmals mit einer Folge verbunden), § 2247 Abs. 3–5.
//
// § 2249, § 2250 (Nottestamente): diese Runde formalisiert die
// MATERIELLE Voraussetzung (Besorgnis/Absperrung/Todesgefahr) und die
// GRUNDFORM (Niederschrift bzw. mündliche Erklärung vor drei Zeugen), NICHT
// die einzelnen Beurkundungsgesetz-Verweisungen (§§ 6–35 BeurkG) — jene
// sind ein fremdes Gesetz, kein Fund für dieses Paket; die Wirksamkeit der
// Nottestamentsform selbst ist der Fund.
//
// § 2252 DREI MONATE: kalendarisch über dieselbe Politik BGB_VERFUEGUNGEN_JAHR
// (Jahresschritt-Politik funktioniert auch für Monate, § 188 Abs. 2) wie
// §§ 2162, 2210 — Abs. 2 (Hemmung) als Eingabe des Falls (Anzahl
// Hemmungstage, wie an anderer Stelle im Paket bei § 1954 Abs. 2 Vorbild
// aus BG-15 üblich), Abs. 3 (Unterbrechung bei neuer Seereise) und Abs. 4
// (Fortbestand bei Todeserklärung) als eigene Regeln.

language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// --- Deklarationen -----------------------------------------------------

pub relation minderjaehriger_errichtet_testament_2229(t: Testament, minderjaehriger: Person) kind empirical {
    label de official "Ein Minderjähriger, der das 16. Lebensjahr vollendet hat, errichtet ein Testament (§ 2229 Abs. 2)";
    label en unofficial "a minor who has completed their sixteenth year makes a will (§ 2229 (2))";
}
pub relation keine_zustimmung_des_vertreters_erforderlich_2229(t: Testament, minderjaehriger: Person) kind derived {
    label de official "Der Minderjährige bedarf zur Errichtung nicht der Zustimmung seines gesetzlichen Vertreters (§ 2229 Abs. 2)";
    label en unofficial "the minor does not need their legal representative's consent to make the will (§ 2229 (2))";
}
pub relation testament_unwirksam_wegen_testierunfaehigkeit_2229(t: Testament, errichter: Person, tag: Date) kind derived {
    label de official "Das Testament ist wegen Testierunfähigkeit des Erblassers unwirksam (§ 2229 Abs. 4)";
    label en unofficial "the will is ineffective because the testator lacked testamentary capacity (§ 2229 (4))";
}
pub relation notarielle_niederschrift_2231(t: Testament) kind empirical {
    label de official "Das Testament ist zur Niederschrift eines Notars errichtet (§ 2231 Nr. 1)";
    label en unofficial "the will is made before a notary's record (§ 2231 no. 1)";
}
pub relation ordentliche_form_notariell_2231(t: Testament) kind derived {
    label de official "Das Testament ist in ordentlicher Form errichtet (§ 2231 Nr. 1)";
    label en unofficial "the will is made in ordinary form (§ 2231 no. 1)";
}
pub relation ordentliche_form_eigenhaendig_2231(t: Testament) kind derived {
    label de official "Das Testament ist in ordentlicher Form errichtet (§ 2231 Nr. 2)";
    label en unofficial "the will is made in ordinary form (§ 2231 no. 2)";
}
pub relation erblasser_erklaert_letzten_willen_dem_notar_oder_uebergibt_schrift_2232(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser erklärt dem Notar seinen letzten Willen oder übergibt ihm eine Schrift mit dieser Erklärung, offen oder verschlossen, nicht notwendig eigenhändig geschrieben (§ 2232)";
    label en unofficial "the testator declares their last will to the notary or hands over a writing containing it, open or sealed, not necessarily handwritten (§ 2232)";
}
pub relation oeffentliches_testament_formwirksam_2232(t: Testament, erblasser: Person) kind derived {
    label de official "Das öffentliche Testament ist formwirksam errichtet (§ 2232)";
    label en unofficial "the public will is validly executed in form (§ 2232)";
}
pub relation erblasser_minderjaehrig_2233(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser ist minderjährig (§ 2233 Abs. 1)";
    label en unofficial "the testator is a minor (§ 2233 (1))";
}
pub relation errichtung_nur_durch_erklaerung_oder_offene_schrift_2233(t: Testament, erblasser: Person) kind empirical {
    label de official "Der minderjährige Erblasser errichtet nur durch Erklärung gegenüber dem Notar oder durch Übergabe einer offenen Schrift (§ 2233 Abs. 1)";
    label en unofficial "the minor testator makes the will only by declaration to the notary or by handing over an open writing (§ 2233 (1))";
}
pub relation errichtung_minderjaehriger_formwirksam_2233(t: Testament, erblasser: Person) kind derived {
    label de official "Die Errichtung ist formwirksam (§ 2233 Abs. 1)";
    label en unofficial "the making of the will is valid in form (§ 2233 (1))";
}
pub relation erblasser_nicht_lesefaehig_2233(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser ist nach eigenen Angaben oder Überzeugung des Notars nicht imstande, Geschriebenes zu lesen (§ 2233 Abs. 2)";
    label en unofficial "the testator is, per their own statement or the notary's conviction, unable to read writing (§ 2233 (2))";
}
pub relation errichtung_nur_durch_erklaerung_ggue_notar_2233(t: Testament, erblasser: Person) kind empirical {
    label de official "Der lesefähigkeitsbeeinträchtigte Erblasser errichtet nur durch Erklärung gegenüber dem Notar (§ 2233 Abs. 2)";
    label en unofficial "the testator unable to read makes the will only by declaration to the notary (§ 2233 (2))";
}
pub relation errichtung_nicht_lesefaehiger_formwirksam_2233(t: Testament, erblasser: Person) kind derived {
    label de official "Die Errichtung ist formwirksam (§ 2233 Abs. 2)";
    label en unofficial "the making of the will is valid in form (§ 2233 (2))";
}
pub relation unterschrift_alternative_stellt_urheberschaft_und_ernstlichkeit_fest_2247(t: Testament, errichter: Person) kind empirical {
    label de official "Eine von Vorname/Familienname abweichende Unterzeichnung reicht zur Feststellung der Urheberschaft und Ernstlichkeit aus (§ 2247 Abs. 3 Satz 2)";
    label en unofficial "a signature deviating from first and family name suffices to establish authorship and seriousness (§ 2247 (3) sentence 2)";
}
pub relation abweichende_unterzeichnung_steht_gueltigkeit_nicht_entgegen_2247(t: Testament, errichter: Person) kind derived {
    label de official "Die abweichende Unterzeichnung steht der Gültigkeit nicht entgegen (§ 2247 Abs. 3 Satz 2)";
    label en unofficial "the deviating signature does not affect validity (§ 2247 (3) sentence 2)";
}
pub relation errichter_minderjaehrig_oder_nicht_lesefaehig_2247(t: Testament, errichter: Person) kind empirical {
    label de official "Der Errichter ist minderjährig oder kann Geschriebenes nicht lesen (§ 2247 Abs. 4)";
    label en unofficial "the maker is a minor or cannot read writing (§ 2247 (4))";
}
pub relation eigenhaendige_errichtung_ausgeschlossen_2247(t: Testament, errichter: Person) kind derived {
    label de official "Die eigenhändige Errichtung nach § 2247 ist ausgeschlossen (§ 2247 Abs. 4)";
    label en unofficial "handwritten execution under § 2247 is excluded (§ 2247 (4))";
}
pub relation zeit_oder_ortsangabe_fehlt_und_zweifel_2247(t: Testament) kind empirical {
    label de official "Die Angabe über Zeit oder Ort der Errichtung fehlt, und daraus ergeben sich Zweifel an der Gültigkeit (§ 2247 Abs. 5)";
    label en unofficial "the statement of time or place is missing, raising doubts about validity (§ 2247 (5))";
}
pub relation feststellungen_anderweit_treffbar_2247(t: Testament) kind empirical {
    label de official "Die notwendigen Feststellungen lassen sich anderweit treffen (§ 2247 Abs. 5)";
    label en unofficial "the necessary findings can be made otherwise (§ 2247 (5))";
}
pub relation trotz_fehlender_angabe_gueltig_2247(t: Testament) kind derived {
    label de official "Das Testament ist trotz fehlender Zeit- oder Ortsangabe gültig (§ 2247 Abs. 5)";
    label en unofficial "the will is valid despite the missing time or place statement (§ 2247 (5))";
}
pub relation nach_2247_errichtetes_testament_2248(t: Testament, erblasser: Person) kind empirical {
    label de official "Ein Testament ist nach § 2247 errichtet (§ 2248)";
    label en unofficial "a will is made under § 2247 (§ 2248)";
}
pub relation erblasser_verlangt_amtliche_verwahrung_2248(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser verlangt besondere amtliche Verwahrung (§ 2248)";
    label en unofficial "the testator demands special official safekeeping (§ 2248)";
}
pub relation amtliche_verwahrung_geschuldet_2248(t: Testament, erblasser: Person) kind derived {
    label de official "Das Testament ist auf Verlangen des Erblassers in amtliche Verwahrung zu nehmen (§ 2248)";
    label en unofficial "the will must be taken into official safekeeping on the testator's demand (§ 2248)";
}
pub relation besorgnis_frueheren_todes_vor_notartestament_2249(t: Testament, erblasser: Person) kind empirical {
    label de official "Es ist zu besorgen, dass der Erblasser früher stirbt, als die Errichtung eines Testaments vor einem Notar möglich ist (§ 2249 Abs. 1 Satz 1)";
    label en unofficial "it is feared the testator will die before a notarial will can be made (§ 2249 (1) sentence 1)";
}
pub relation buergermeister_niederschrift_mit_zwei_zeugen_2249(t: Testament, erblasser: Person) kind empirical {
    label de official "Das Testament wird zur Niederschrift des Bürgermeisters unter Zuziehung zweier tauglicher Zeugen errichtet (§ 2249 Abs. 1)";
    label en unofficial "the will is made before the mayor's record with two qualified witnesses (§ 2249 (1))";
}
pub relation buergermeistertestament_formwirksam_2249(t: Testament, erblasser: Person) kind derived {
    label de official "Das Nottestament vor dem Bürgermeister ist formwirksam errichtet (§ 2249 Abs. 1)";
    label en unofficial "the emergency will before the mayor is validly made in form (§ 2249 (1))";
}
pub relation besorgnis_unbegruendet_2249(t: Testament) kind empirical {
    label de official "Die Besorgnis der Unmöglichkeit eines Notartestaments war nicht begründet (§ 2249 Abs. 2 Satz 2)";
    label en unofficial "the fear that a notarial will was impossible was unfounded (§ 2249 (2) sentence 2)";
}
pub relation unbegruendete_besorgnis_steht_gueltigkeit_nicht_entgegen_2249(t: Testament) kind derived {
    label de official "Der Gültigkeit steht nicht entgegen, dass die Besorgnis nicht begründet war (§ 2249 Abs. 2 Satz 2)";
    label en unofficial "unfoundedness of the fear does not affect validity (§ 2249 (2) sentence 2)";
}
pub relation formfehler_bei_niederschrift_aber_sichere_wiedergabe_2249(t: Testament) kind empirical {
    label de official "Bei der Niederschrift sind Formfehler unterlaufen, doch ist mit Sicherheit anzunehmen, dass sie die Erklärung des Erblassers zuverlässig wiedergibt (§ 2249 Abs. 6)";
    label en unofficial "form errors occurred in the record, yet it can be assumed with certainty that it reliably reproduces the testator's declaration (§ 2249 (6))";
}
pub relation formverstoss_steht_wirksamkeit_nicht_entgegen_2249(t: Testament) kind derived {
    label de official "Der Formverstoß steht der Wirksamkeit der Beurkundung nicht entgegen (§ 2249 Abs. 6)";
    label en unofficial "the form violation does not affect the validity of the notarisation (§ 2249 (6))";
}
pub relation ort_infolge_ausserordentlicher_umstaende_abgesperrt_2250(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Ort, an dem sich der Erblasser aufhält, ist infolge außerordentlicher Umstände so abgesperrt, dass Notartestament nicht oder erheblich erschwert möglich ist (§ 2250 Abs. 1)";
    label en unofficial "the place where the testator is located is cut off by extraordinary circumstances so a notarial will is impossible or much harder (§ 2250 (1))";
}
pub relation nottestament_2249_form_oder_drei_zeugen_2250(t: Testament, erblasser: Person) kind empirical {
    label de official "Das Testament wird in der Form des § 2249 oder durch mündliche Erklärung vor drei Zeugen errichtet (§ 2250 Abs. 1)";
    label en unofficial "the will is made in the § 2249 form or by oral declaration before three witnesses (§ 2250 (1))";
}
pub relation abgesperrter_ort_nottestament_formwirksam_2250(t: Testament, erblasser: Person) kind derived {
    label de official "Das Nottestament wegen Absperrung ist formwirksam errichtet (§ 2250 Abs. 1)";
    label en unofficial "the emergency will owing to isolation is validly made in form (§ 2250 (1))";
}
pub relation nahe_todesgefahr_notartestament_und_2249_nicht_mehr_moeglich_2250(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser befindet sich in so naher Todesgefahr, dass voraussichtlich auch ein Testament nach § 2249 nicht mehr möglich ist (§ 2250 Abs. 2)";
    label en unofficial "the testator faces such imminent mortal danger that even a § 2249 will is unlikely still possible (§ 2250 (2))";
}
pub relation muendliche_erklaerung_vor_drei_zeugen_2250(t: Testament, erblasser: Person) kind empirical {
    label de official "Das Testament wird durch mündliche Erklärung vor drei Zeugen errichtet (§ 2250 Abs. 2)";
    label en unofficial "the will is made by oral declaration before three witnesses (§ 2250 (2))";
}
pub relation todesgefahr_nottestament_formwirksam_2250(t: Testament, erblasser: Person) kind derived {
    label de official "Das Nottestament wegen naher Todesgefahr ist formwirksam errichtet (§ 2250 Abs. 2)";
    label en unofficial "the emergency will owing to imminent mortal danger is validly made in form (§ 2250 (2))";
}
pub relation seereise_deutsches_schiff_ausserhalb_inlaendischen_hafens_2251(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser befindet sich während einer Seereise an Bord eines deutschen Schiffes außerhalb eines inländischen Hafens (§ 2251)";
    label en unofficial "the testator is during a sea voyage aboard a German vessel outside a domestic port (§ 2251)";
}
pub relation seetestament_vor_drei_zeugen_2251(t: Testament, erblasser: Person) kind empirical {
    label de official "Das Testament wird durch mündliche Erklärung vor drei Zeugen nach § 2250 Abs. 3 errichtet (§ 2251)";
    label en unofficial "the will is made by oral declaration before three witnesses under § 2250 (3) (§ 2251)";
}
pub relation seetestament_formwirksam_2251(t: Testament, erblasser: Person) kind derived {
    label de official "Das Nottestament auf See ist formwirksam errichtet (§ 2251)";
    label en unofficial "the emergency will at sea is validly made in form (§ 2251)";
}
pub relation nottestament_errichtet_am_2252(t: Testament, erblasser: Person, tag: Date) kind empirical {
    label de official "Ein Nottestament nach § 2249, § 2250 oder § 2251 ist errichtet worden (§ 2252 Abs. 1)";
    label en unofficial "an emergency will under § 2249, § 2250 or § 2251 has been made (§ 2252 (1))";
}
pub relation drei_monate_grenze_2252(t: Testament, grenze: Date) kind derived {
    label de official "Kalendarische Grenze der drei Monate seit der Errichtung, § 188 Abs. 2 (§ 2252 Abs. 1)";
    label en unofficial "calendar boundary of the three months since making the will, § 188 (2) (§ 2252 (1))";
}
pub relation drei_monate_verstrichen_und_erblasser_lebt_noch_2252(t: Testament, erblasser: Person) kind empirical {
    label de official "Seit der Errichtung sind drei Monate verstrichen, und der Erblasser lebt noch (§ 2252 Abs. 1)";
    label en unofficial "three months have elapsed since making the will, and the testator is still alive (§ 2252 (1))";
}
pub relation nottestament_gilt_als_nicht_errichtet_2252(t: Testament, erblasser: Person) kind derived {
    label de official "Das Nottestament gilt als nicht errichtet (§ 2252 Abs. 1)";
    label en unofficial "the emergency will is deemed not to have been made (§ 2252 (1))";
}
pub relation erblasser_ausserstande_notartestament_zu_errichten_2252(t: Testament, erblasser: Person, hemmungstage: Quantity) kind empirical {
    label de official "Der Erblasser ist außerstande, ein Testament vor einem Notar zu errichten; Anzahl der Hemmungstage ist Eingabe des Falls (§ 2252 Abs. 2)";
    label en unofficial "the testator is unable to make a will before a notary; the number of days of suspension is a case input (§ 2252 (2))";
}
pub relation drei_monats_frist_um_hemmungstage_verlaengert_2252(t: Testament, erblasser: Person, hemmungstage: Quantity) kind derived {
    label de official "Beginn und Lauf der Dreimonatsfrist sind für die Dauer der Hemmung gehemmt (§ 2252 Abs. 2)";
    label en unofficial "commencement and running of the three-month period are suspended for the duration (§ 2252 (2))";
}
pub relation erblasser_tritt_vor_fristablauf_neue_seereise_an_2252(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser tritt im Falle des § 2251 vor Ablauf der Frist eine neue Seereise an (§ 2252 Abs. 3)";
    label en unofficial "in a § 2251 case, the testator embarks on a new sea voyage before the period lapses (§ 2252 (3))";
}
pub relation frist_unterbrochen_neu_beginnend_2252(t: Testament, erblasser: Person) kind derived {
    label de official "Die Frist wird unterbrochen; nach Beendigung der neuen Reise beginnt die volle Frist von neuem (§ 2252 Abs. 3)";
    label en unofficial "the period is interrupted; on completion of the new voyage the full period begins anew (§ 2252 (3))";
}
pub relation erblasser_nach_fristablauf_fuer_tot_erklaert_und_frist_beim_letzten_lebenszeichen_nicht_verstrichen_2252(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser wird nach Fristablauf für tot erklärt, doch war die Frist zu der Zeit des letzten Lebenszeichens noch nicht verstrichen (§ 2252 Abs. 4)";
    label en unofficial "the testator is declared dead after the period lapsed, but the period had not yet elapsed at the time of the last sign of life (§ 2252 (4))";
}
pub relation testament_behaelt_kraft_2252(t: Testament, erblasser: Person) kind derived {
    label de official "Das Testament behält seine Kraft (§ 2252 Abs. 4)";
    label en unofficial "the will retains its force (§ 2252 (4))";
}
pub relation erblasser_hat_testamentsurkunde_vernichtet_oder_veraendert_2255(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser hat die Testamentsurkunde vernichtet oder in bezeichneter Weise verändert (§ 2255 Satz 2)";
    label en unofficial "the testator has destroyed the will document or altered it in the specified way (§ 2255 sentence 2)";
}
pub relation aufhebungsabsicht_vermutet_2255(t: Testament, erblasser: Person) kind derived {
    label de official "Es wird vermutet, dass der Erblasser die Aufhebung des Testaments beabsichtigt habe (§ 2255 Satz 2)";
    label en unofficial "it is presumed the testator intended to revoke the will (§ 2255 sentence 2)";
}
pub relation gegenbeweis_gegen_aufhebungsabsicht_2255(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Gegenbeweis gegen die vermutete Aufhebungsabsicht ist geführt (§ 2255 Satz 2, Gegenausnahme)";
    label en unofficial "counter-evidence against the presumed intention to revoke has been produced (§ 2255 sentence 2, counter-exception)";
}
pub relation notariell_oder_nach_2249_errichtetes_testament_aus_verwahrung_zurueckgegeben_2256(t: Testament, erblasser: Person) kind empirical {
    label de official "Die in amtliche Verwahrung genommene Urkunde eines vor einem Notar oder nach § 2249 errichteten Testaments wird dem Erblasser zurückgegeben (§ 2256 Abs. 1 Satz 1)";
    label en unofficial "the officially safekept document of a notarial or § 2249 will is returned to the testator (§ 2256 (1) sentence 1)";
}
pub relation testament_gilt_als_widerrufen_durch_ruecknahme_2256(t: Testament, erblasser: Person) kind derived {
    label de official "Das Testament gilt als widerrufen (§ 2256 Abs. 1 Satz 1)";
    label en unofficial "the will is deemed revoked (§ 2256 (1) sentence 1)";
}
pub relation erblasser_verlangt_ruecknahme_2256(t: Testament, erblasser: Person) kind empirical {
    label de official "Der Erblasser verlangt die Rückgabe (§ 2256 Abs. 2 Satz 1)";
    label en unofficial "the testator demands the return (§ 2256 (2) sentence 1)";
}
pub relation ruecknahme_jederzeit_verlangbar_2256(t: Testament, erblasser: Person) kind derived {
    label de official "Der Erblasser kann die Rückgabe jederzeit verlangen (§ 2256 Abs. 2 Satz 1)";
    label en unofficial "the testator may demand the return at any time (§ 2256 (2) sentence 1)";
}
pub relation nach_2248_hinterlegtes_testament_zurueckgegeben_2256(t: Testament, erblasser: Person) kind empirical {
    label de official "Ein nach § 2248 hinterlegtes Testament wird zurückgegeben (§ 2256 Abs. 3)";
    label en unofficial "a will deposited under § 2248 is returned (§ 2256 (3))";
}
pub relation ruecknahme_ohne_einfluss_auf_wirksamkeit_2256(t: Testament, erblasser: Person) kind derived {
    label de official "Die Rückgabe ist auf die Wirksamkeit des nach § 2248 hinterlegten Testaments ohne Einfluss (§ 2256 Abs. 3)";
    label en unofficial "the return does not affect the validity of a will deposited under § 2248 (§ 2256 (3))";
}
pub relation widerruf_einer_verfuegung_durch_testament_widerrufen_2257(t: Testament, widerrufstestament: Testament) kind empirical {
    label de official "Der durch Testament erfolgte Widerruf einer letztwilligen Verfügung wird widerrufen (§ 2257)";
    label en unofficial "the testamentary revocation of a disposition is itself revoked (§ 2257)";
}
pub relation urspruengliche_verfuegung_wieder_wirksam_vermutet_2257(t: Testament) kind derived {
    label de official "Im Zweifel ist die ursprüngliche Verfügung wirksam, wie wenn sie nicht widerrufen worden wäre (§ 2257)";
    label en unofficial "in case of doubt the original disposition is valid as if it had not been revoked (§ 2257)";
}
pub relation spaeteres_testament_errichtet_im_widerspruch_zum_frueheren_2258(spaeteres: Testament, frueheres: Testament) kind empirical {
    label de official "Ein späteres Testament wird errichtet und steht mit dem früheren im Widerspruch (§ 2258 Abs. 1)";
    label en unofficial "a later will is made and conflicts with the earlier one (§ 2258 (1))";
}
pub relation frueheres_testament_insoweit_aufgehoben_2258(spaeteres: Testament, frueheres: Testament) kind derived {
    label de official "Das frühere Testament wird insoweit aufgehoben, als das spätere mit ihm im Widerspruch steht (§ 2258 Abs. 1)";
    label en unofficial "the earlier will is revoked to the extent it conflicts with the later one (§ 2258 (1))";
}
pub relation spaeteres_testament_widerrufen_2258(spaeteres: Testament, frueheres: Testament) kind empirical {
    label de official "Das spätere Testament wird widerrufen (§ 2258 Abs. 2)";
    label en unofficial "the later will is revoked (§ 2258 (2))";
}
pub relation frueheres_testament_wieder_wirksam_vermutet_2258(spaeteres: Testament, frueheres: Testament) kind derived {
    label de official "Im Zweifel ist das frühere Testament wieder wirksam, wie wenn es nicht aufgehoben worden wäre (§ 2258 Abs. 2)";
    label en unofficial "in case of doubt the earlier will is again valid as if not revoked (§ 2258 (2))";
}
pub relation besitzer_erlangt_kenntnis_vom_tod_und_testament_nicht_in_verwahrung_2259(t: Testament, besitzer: Person) kind empirical {
    label de official "Wer ein nicht in amtlicher Verwahrung befindliches Testament besitzt, erlangt Kenntnis vom Tod des Erblassers (§ 2259 Abs. 1)";
    label en unofficial "the possessor of a will not in official safekeeping learns of the testator's death (§ 2259 (1))";
}
pub relation ablieferungspflicht_ans_nachlassgericht_2259(t: Testament, besitzer: Person) kind derived {
    label de official "Der Besitzer ist verpflichtet, das Testament unverzüglich an das Nachlassgericht abzuliefern (§ 2259 Abs. 1)";
    label en unofficial "the possessor must promptly deliver the will to the probate court (§ 2259 (1))";
}
pub relation testament_bei_anderer_behoerde_als_gericht_verwahrt_nach_tod_2259(t: Testament) kind empirical {
    label de official "Ein Testament befindet sich nach dem Tode des Erblassers bei einer anderen Behörde als einem Gericht in amtlicher Verwahrung (§ 2259 Abs. 2)";
    label en unofficial "a will is, after the testator's death, in official safekeeping at an authority other than a court (§ 2259 (2))";
}
pub relation ablieferung_an_nachlassgericht_geschuldet_2259(t: Testament) kind derived {
    label de official "Es ist an das Nachlassgericht abzuliefern (§ 2259 Abs. 2)";
    label en unofficial "it must be delivered to the probate court (§ 2259 (2))";
}
pub relation erblasser_verbietet_alsbaldige_eroeffnung_2263(t: Testament) kind empirical {
    label de official "Der Erblasser ordnet an, dass das Testament nicht alsbald nach seinem Tode eröffnet werden soll (§ 2263)";
    label en unofficial "the testator orders that the will not be opened promptly after death (§ 2263)";
}
pub relation eroeffnungsverbot_nichtig_2263(t: Testament) kind derived {
    label de official "Das Eröffnungsverbot ist nichtig (§ 2263)";
    label en unofficial "the prohibition on opening is void (§ 2263)";
}

// --- Regeln --------------------------------------------------------------

@source(BGB_P2229) {
    rule KeineZustimmungDesVertretersNoetig(t: Testament, minderjaehriger: Person) strict {
        label de official "Der testierfähige Minderjährige bedarf zur Errichtung nicht der Zustimmung seines gesetzlichen Vertreters (§ 2229 Abs. 2)"; label en unofficial "The minor with testamentary capacity does not need their legal representative's consent (§ 2229 (2))";
        when minderjaehriger_errichtet_testament_2229(t, minderjaehriger); then keine_zustimmung_des_vertreters_erforderlich_2229(t, minderjaehriger);
    }
    rule TestierunfaehigkeitMachtTestamentUnwirksam(t: Testament, errichter: Person, tag: Date) strict {
        label de official "Wer wegen Geistesstörung, Geistesschwäche oder Bewusstseinsstörung die Bedeutung seiner Erklärung nicht einsehen und danach handeln kann, kann kein Testament errichten (§ 2229 Abs. 4)"; label en unofficial "A person who, owing to mental disorder, cannot understand and act on the significance of their declaration cannot make a will (§ 2229 (4))";
        when verfuegung_von_todes_wegen_persoenlich_2064(t, errichter) and testament_errichtet_am(errichter, tag) and geistestoerung_testierunfaehig_2229(errichter, tag); then testament_unwirksam_wegen_testierunfaehigkeit_2229(t, errichter, tag);
    }
}
@source(BGB_P2231) {
    rule OrdentlicheFormNotariell(t: Testament) strict {
        label de official "Ein Testament kann in ordentlicher Form zur Niederschrift eines Notars errichtet werden (§ 2231 Nr. 1)"; label en unofficial "A will may be made in ordinary form before a notary's record (§ 2231 no. 1)";
        when notarielle_niederschrift_2231(t); then ordentliche_form_notariell_2231(t);
    }
    rule OrdentlicheFormEigenhaendig(t: Testament, errichter: Person) strict {
        label de official "Ein Testament kann in ordentlicher Form durch eine Erklärung nach § 2247 errichtet werden (§ 2231 Nr. 2)"; label en unofficial "A will may be made in ordinary form by a § 2247 declaration (§ 2231 no. 2)";
        when eigenhaendiges_testament_formwirksam(t, errichter); then ordentliche_form_eigenhaendig_2231(t);
    }
}
@source(BGB_P2232)
rule OeffentlichesTestamentForm(t: Testament, erblasser: Person) strict {
    label de official "Ein öffentliches Testament wird errichtet, indem der Erblasser dem Notar seinen letzten Willen erklärt oder eine Schrift übergibt (§ 2232)"; label en unofficial "A public will is made by the testator declaring their last will to the notary or handing over a writing (§ 2232)";
    when erblasser_erklaert_letzten_willen_dem_notar_oder_uebergibt_schrift_2232(t, erblasser); then oeffentliches_testament_formwirksam_2232(t, erblasser);
}
@source(BGB_P2233) {
    rule MinderjaehrigerNurErklaerungOderOffeneSchrift(t: Testament, erblasser: Person) strict {
        label de official "Der minderjährige Erblasser kann nur durch Erklärung gegenüber dem Notar oder Übergabe einer offenen Schrift errichten (§ 2233 Abs. 1)"; label en unofficial "The minor testator may make the will only by declaration to the notary or handing over an open writing (§ 2233 (1))";
        when erblasser_minderjaehrig_2233(t, erblasser) and errichtung_nur_durch_erklaerung_oder_offene_schrift_2233(t, erblasser); then errichtung_minderjaehriger_formwirksam_2233(t, erblasser);
    }
    rule NichtLesefaehigNurErklaerung(t: Testament, erblasser: Person) strict {
        label de official "Der nicht lesefähige Erblasser kann nur durch Erklärung gegenüber dem Notar errichten (§ 2233 Abs. 2)"; label en unofficial "The testator unable to read may make the will only by declaration to the notary (§ 2233 (2))";
        when erblasser_nicht_lesefaehig_2233(t, erblasser) and errichtung_nur_durch_erklaerung_ggue_notar_2233(t, erblasser); then errichtung_nicht_lesefaehiger_formwirksam_2233(t, erblasser);
    }
}
@source(BGB_P2247) {
    rule AbweichendeUnterzeichnungGenuegt(t: Testament, errichter: Person) strict {
        label de official "Reicht eine von Vorname/Familienname abweichende Unterzeichnung zur Feststellung von Urheberschaft und Ernstlichkeit aus, steht sie der Gültigkeit nicht entgegen (§ 2247 Abs. 3 Satz 2)"; label en unofficial "Where a deviating signature suffices to establish authorship and seriousness, it does not affect validity (§ 2247 (3) sentence 2)";
        when unterschrift_alternative_stellt_urheberschaft_und_ernstlichkeit_fest_2247(t, errichter); then abweichende_unterzeichnung_steht_gueltigkeit_nicht_entgegen_2247(t, errichter);
    }
    rule EigenhaendigeErrichtungAusgeschlossen(t: Testament, errichter: Person) strict {
        label de official "Minderjährige und Nichtlesefähige können nicht nach § 2247 errichten (§ 2247 Abs. 4)"; label en unofficial "Minors and those unable to read cannot make a will under § 2247 (§ 2247 (4))";
        when errichter_minderjaehrig_oder_nicht_lesefaehig_2247(t, errichter); then eigenhaendige_errichtung_ausgeschlossen_2247(t, errichter);
    }
    rule TrotzFehlenderAngabeGueltigBeiAnderweitigerFeststellbarkeit(t: Testament) strict {
        label de official "Fehlt die Zeit- oder Ortsangabe und ergeben sich Zweifel, ist das Testament nur gültig, wenn die Feststellungen anderweit treffbar sind (§ 2247 Abs. 5)"; label en unofficial "Where the time or place statement is missing and doubts arise, the will is valid only if the findings can be made otherwise (§ 2247 (5))";
        when zeit_oder_ortsangabe_fehlt_und_zweifel_2247(t) and feststellungen_anderweit_treffbar_2247(t); then trotz_fehlender_angabe_gueltig_2247(t);
    }
}
@source(BGB_P2248)
rule AmtlicheVerwahrungAufVerlangen(t: Testament, erblasser: Person) strict {
    label de official "Ein nach § 2247 errichtetes Testament ist auf Verlangen des Erblassers in besondere amtliche Verwahrung zu nehmen (§ 2248)"; label en unofficial "A will made under § 2247 must be taken into special official safekeeping on the testator's demand (§ 2248)";
    when nach_2247_errichtetes_testament_2248(t, erblasser) and erblasser_verlangt_amtliche_verwahrung_2248(t, erblasser); then amtliche_verwahrung_geschuldet_2248(t, erblasser);
}
@source(BGB_P2249) {
    rule BuergermeistertestamentBeiBesorgnis(t: Testament, erblasser: Person) strict {
        label de official "Bei Besorgnis früheren Todes kann das Testament zur Niederschrift des Bürgermeisters unter Zuziehung zweier Zeugen errichtet werden (§ 2249 Abs. 1)"; label en unofficial "Where earlier death is feared, the will may be made before the mayor's record with two witnesses (§ 2249 (1))";
        when besorgnis_frueheren_todes_vor_notartestament_2249(t, erblasser) and buergermeister_niederschrift_mit_zwei_zeugen_2249(t, erblasser); then buergermeistertestament_formwirksam_2249(t, erblasser);
    }
    rule UnbegruendeteBesorgnisUnschaedlich(t: Testament) strict {
        label de official "Der Gültigkeit steht nicht entgegen, dass die Besorgnis nicht begründet war (§ 2249 Abs. 2 Satz 2)"; label en unofficial "Unfoundedness of the fear does not affect validity (§ 2249 (2) sentence 2)";
        when besorgnis_unbegruendet_2249(t); then unbegruendete_besorgnis_steht_gueltigkeit_nicht_entgegen_2249(t);
    }
    rule FormverstossUnschaedlichBeiSichererWiedergabe(t: Testament) strict {
        label de official "Formfehler stehen der Wirksamkeit nicht entgegen, wenn mit Sicherheit anzunehmen ist, dass die Niederschrift die Erklärung zuverlässig wiedergibt (§ 2249 Abs. 6)"; label en unofficial "Form errors do not affect validity where the record can be assumed with certainty to reliably reproduce the declaration (§ 2249 (6))";
        when formfehler_bei_niederschrift_aber_sichere_wiedergabe_2249(t); then formverstoss_steht_wirksamkeit_nicht_entgegen_2249(t);
    }
}
@source(BGB_P2250) {
    rule NottestamentBeiAbgesperrtemOrt(t: Testament, erblasser: Person) strict {
        label de official "An abgesperrtem Ort kann das Testament in der Form des § 2249 oder mündlich vor drei Zeugen errichtet werden (§ 2250 Abs. 1)"; label en unofficial "At a cut-off location, the will may be made in the § 2249 form or orally before three witnesses (§ 2250 (1))";
        when ort_infolge_ausserordentlicher_umstaende_abgesperrt_2250(t, erblasser) and nottestament_2249_form_oder_drei_zeugen_2250(t, erblasser); then abgesperrter_ort_nottestament_formwirksam_2250(t, erblasser);
    }
    rule NottestamentBeiNaherTodesgefahr(t: Testament, erblasser: Person) strict {
        label de official "Bei naher Todesgefahr, die auch ein § 2249-Testament ausschließt, genügt mündliche Erklärung vor drei Zeugen (§ 2250 Abs. 2)"; label en unofficial "In imminent mortal danger excluding even a § 2249 will, an oral declaration before three witnesses suffices (§ 2250 (2))";
        when nahe_todesgefahr_notartestament_und_2249_nicht_mehr_moeglich_2250(t, erblasser) and muendliche_erklaerung_vor_drei_zeugen_2250(t, erblasser); then todesgefahr_nottestament_formwirksam_2250(t, erblasser);
    }
}
@source(BGB_P2251)
rule SeetestamentFormwirksam(t: Testament, erblasser: Person) strict {
    label de official "Während einer Seereise außerhalb eines inländischen Hafens genügt mündliche Erklärung vor drei Zeugen (§ 2251)"; label en unofficial "During a sea voyage outside a domestic port, an oral declaration before three witnesses suffices (§ 2251)";
    when seereise_deutsches_schiff_ausserhalb_inlaendischen_hafens_2251(t, erblasser) and seetestament_vor_drei_zeugen_2251(t, erblasser); then seetestament_formwirksam_2251(t, erblasser);
}
@source(BGB_P2252) {
    rule DreiMonatsGrenze(t: Testament, erblasser: Person, tag: Date) strict {
        label de official "Kalendarische Grenze der drei Monate seit Errichtung des Nottestaments (§ 2252 Abs. 1)"; label en unofficial "Calendar boundary of the three months since making the emergency will (§ 2252 (1))";
        when nottestament_errichtet_am_2252(t, erblasser, tag); then drei_monate_grenze_2252(t, add_calendar_period(tag, 3 calendar_month));
    }
    rule NottestamentGiltAlsNichtErrichtetNachDreiMonaten(t: Testament, erblasser: Person) strict {
        label de official "Das Nottestament gilt als nicht errichtet, wenn seit der Errichtung drei Monate verstrichen sind und der Erblasser noch lebt (§ 2252 Abs. 1)"; label en unofficial "The emergency will is deemed not made where three months have elapsed and the testator is still alive (§ 2252 (1))";
        when drei_monate_verstrichen_und_erblasser_lebt_noch_2252(t, erblasser); then nottestament_gilt_als_nicht_errichtet_2252(t, erblasser);
    }
    rule FristHemmungBeiUnvermoegen(t: Testament, erblasser: Person, hemmungstage: Quantity) strict {
        label de official "Beginn und Lauf der Frist sind gehemmt, solange der Erblasser außerstande ist, ein Notartestament zu errichten (§ 2252 Abs. 2)"; label en unofficial "Commencement and running of the period are suspended while the testator cannot make a notarial will (§ 2252 (2))";
        when erblasser_ausserstande_notartestament_zu_errichten_2252(t, erblasser, hemmungstage); then drei_monats_frist_um_hemmungstage_verlaengert_2252(t, erblasser, hemmungstage);
    }
    rule FristUnterbrechungBeiNeuerSeereise(t: Testament, erblasser: Person) strict {
        label de official "Tritt der Erblasser vor Fristablauf eine neue Seereise an, beginnt nach deren Ende die volle Frist von neuem (§ 2252 Abs. 3)"; label en unofficial "Where the testator embarks on a new sea voyage before the period lapses, the full period begins anew after it ends (§ 2252 (3))";
        when erblasser_tritt_vor_fristablauf_neue_seereise_an_2252(t, erblasser); then frist_unterbrochen_neu_beginnend_2252(t, erblasser);
    }
    rule TestamentBehaeltKraftBeiTodeserklaerung(t: Testament, erblasser: Person) strict {
        label de official "Wird der Erblasser für tot erklärt, behält das Testament seine Kraft, wenn die Frist beim letzten Lebenszeichen noch nicht verstrichen war (§ 2252 Abs. 4)"; label en unofficial "Where the testator is declared dead, the will retains force if the period had not lapsed at the last sign of life (§ 2252 (4))";
        when erblasser_nach_fristablauf_fuer_tot_erklaert_und_frist_beim_letzten_lebenszeichen_nicht_verstrichen_2252(t, erblasser); then testament_behaelt_kraft_2252(t, erblasser);
    }
}
// § 2253 (Widerruf jederzeit) und § 2255 Satz 1 (Widerruf durch Vernichtung)
// sind bereits in package.law formalisiert (WiderrufDurchTestament auf
// testament_widerrufen_durch_neues_2253, WiderrufDurchVernichtung auf
// testament_vernichtet_mit_widerrufsabsicht_2253 → testament_widerrufen);
// diese Runde fügt nur § 2255 Satz 2 (Vermutung) hinzu. § 2254 („Der
// Widerruf erfolgt durch ein Testament“) ist durch dieselbe Vorschrift
// bereits inhaltlich mitgetragen — kein eigener Fund nötig.
@source(BGB_P2255) {
    presumption AufhebungsabsichtVermutet(t: Testament, erblasser: Person) {
        label de official "Hat der Erblasser die Urkunde vernichtet oder in bezeichneter Weise verändert, wird die Aufhebungsabsicht vermutet (§ 2255 Satz 2)"; label en unofficial "Where the testator destroyed or altered the document as specified, the intention to revoke is presumed (§ 2255 sentence 2)";
        when erblasser_hat_testamentsurkunde_vernichtet_oder_veraendert_2255(t, erblasser); presume aufhebungsabsicht_vermutet_2255(t, erblasser); unless gegenbeweis_gegen_aufhebungsabsicht_2255(t, erblasser);
    }
}
@source(BGB_P2256) {
    rule TestamentGiltAlsWiderrufenDurchRuecknahme(t: Testament, erblasser: Person) strict {
        label de official "Ein notarielles oder § 2249-Testament gilt als widerrufen, wenn die verwahrte Urkunde dem Erblasser zurückgegeben wird (§ 2256 Abs. 1 Satz 1)"; label en unofficial "A notarial or § 2249 will is deemed revoked when the safekept document is returned to the testator (§ 2256 (1) sentence 1)";
        when notariell_oder_nach_2249_errichtetes_testament_aus_verwahrung_zurueckgegeben_2256(t, erblasser); then testament_gilt_als_widerrufen_durch_ruecknahme_2256(t, erblasser);
    }
    rule RuecknahmeJederzeitVerlangbar(t: Testament, erblasser: Person) strict {
        label de official "Der Erblasser kann die Rückgabe jederzeit verlangen (§ 2256 Abs. 2 Satz 1)"; label en unofficial "The testator may demand the return at any time (§ 2256 (2) sentence 1)";
        when erblasser_verlangt_ruecknahme_2256(t, erblasser); then ruecknahme_jederzeit_verlangbar_2256(t, erblasser);
    }
    rule RuecknahmeBeiHinterlegtemTestamentOhneEinfluss(t: Testament, erblasser: Person) strict {
        label de official "Die Vorschrift über die jederzeitige Rückgabe gilt auch für ein nach § 2248 hinterlegtes Testament; die Rückgabe ist auf dessen Wirksamkeit ohne Einfluss (§ 2256 Abs. 3)"; label en unofficial "The rule on demanding return also applies to a will deposited under § 2248; the return does not affect its validity (§ 2256 (3))";
        when nach_2248_hinterlegtes_testament_zurueckgegeben_2256(t, erblasser); then ruecknahme_ohne_einfluss_auf_wirksamkeit_2256(t, erblasser);
    }
}
@source(BGB_P2257)
presumption WiderrufDesWiderrufs(t: Testament, widerrufstestament: Testament) {
    label de official "Wird der Widerruf einer letztwilligen Verfügung widerrufen, ist im Zweifel die Verfügung wirksam, wie wenn sie nicht widerrufen worden wäre (§ 2257)"; label en unofficial "Where the revocation of a disposition is itself revoked, the disposition is in case of doubt valid as if never revoked (§ 2257)";
    when widerruf_einer_verfuegung_durch_testament_widerrufen_2257(t, widerrufstestament); presume urspruengliche_verfuegung_wieder_wirksam_vermutet_2257(t);
}
@source(BGB_P2258) {
    rule SpaeteresTestamentHebtWiderspruechlichesFrueheresAuf(spaeteres: Testament, frueheres: Testament) strict {
        label de official "Durch ein späteres Testament wird ein früheres insoweit aufgehoben, als es mit ihm im Widerspruch steht (§ 2258 Abs. 1)"; label en unofficial "A later will revokes an earlier one to the extent they conflict (§ 2258 (1))";
        when spaeteres_testament_errichtet_im_widerspruch_zum_frueheren_2258(spaeteres, frueheres); then frueheres_testament_insoweit_aufgehoben_2258(spaeteres, frueheres);
    }
    presumption FrueheresTestamentWiederWirksam(spaeteres: Testament, frueheres: Testament) {
        label de official "Wird das spätere Testament widerrufen, ist im Zweifel das frühere wieder wirksam, wie wenn es nicht aufgehoben worden wäre (§ 2258 Abs. 2)"; label en unofficial "Where the later will is revoked, the earlier one is in case of doubt again valid as if never revoked (§ 2258 (2))";
        when spaeteres_testament_widerrufen_2258(spaeteres, frueheres); presume frueheres_testament_wieder_wirksam_vermutet_2258(spaeteres, frueheres);
    }
}
@source(BGB_P2259) {
    rule AblieferungspflichtBeiKenntnisVomTod(t: Testament, besitzer: Person) strict {
        label de official "Wer ein nicht amtlich verwahrtes Testament besitzt, muss es unverzüglich nach Kenntnis vom Tod des Erblassers ans Nachlassgericht abliefern (§ 2259 Abs. 1)"; label en unofficial "The possessor of a will not in official safekeeping must promptly deliver it to the probate court on learning of the testator's death (§ 2259 (1))";
        when besitzer_erlangt_kenntnis_vom_tod_und_testament_nicht_in_verwahrung_2259(t, besitzer); then ablieferungspflicht_ans_nachlassgericht_2259(t, besitzer);
    }
    rule AblieferungBeiVerwahrungAndererBehoerde(t: Testament) strict {
        label de official "Ein bei anderer Behörde als einem Gericht verwahrtes Testament ist nach dem Tode ans Nachlassgericht abzuliefern (§ 2259 Abs. 2)"; label en unofficial "A will kept at an authority other than a court must be delivered to the probate court after death (§ 2259 (2))";
        when testament_bei_anderer_behoerde_als_gericht_verwahrt_nach_tod_2259(t); then ablieferung_an_nachlassgericht_geschuldet_2259(t);
    }
}
@source(BGB_P2263)
rule EroeffnungsverbotNichtig(t: Testament) strict {
    label de official "Eine Anordnung, die die alsbaldige Eröffnung des Testaments verbietet, ist nichtig (§ 2263)"; label en unofficial "An order prohibiting the prompt opening of the will is void (§ 2263)";
    when erblasser_verbietet_alsbaldige_eroeffnung_2263(t); then eroeffnungsverbot_nichtig_2263(t);
}
