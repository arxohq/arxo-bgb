// BÜRGERLICHES GESETZBUCH, BUCH 5 ABSCHNITT 3 TITEL 8 — GEMEINSCHAFTLICHES
// TESTAMENT (§§ 2265–2272; § 2273 ist „(weggefallen)“, kein Fund). § 2265
// ist bereits in package.law formalisiert (gemeinschaftliches_testament_
// zulaessig) — NICHT angetastet.
//
// § 2271 verweist auf §§ 2296, 2294, 2336, 2289 Abs. 2 (Erbvertrags- und
// Entziehungsvorschriften, noch nicht formalisiert): diese Runde
// formalisiert die WIDERRUFSGRENZEN selbst (Lebzeiten/nach Tod/
// Ausschlagung), nicht die Verweisungsketten — ihre entsprechende
// Anwendung bleibt als deklarierte Randbedingung des Erbvertragsmoduls.

language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// --- Deklarationen -----------------------------------------------------

pub relation gemeinschaftliches_testament_voraussetzungen_nur_bei_einem_ehegatten_2266(t: Testament, ehegatte: Person) kind empirical {
    label de official "Die Voraussetzungen der §§ 2249, 2250 für ein Nottestament liegen nur bei einem der Ehegatten vor (§ 2266)";
    label en unofficial "the § 2249/2250 emergency-will conditions are met for only one of the spouses (§ 2266)";
}
pub relation gemeinschaftliches_nottestament_zulaessig_2266(t: Testament, ehegatte: Person) kind derived {
    label de official "Das gemeinschaftliche Nottestament ist gleichwohl nach §§ 2249, 2250 zulässig (§ 2266)";
    label en unofficial "the joint emergency will is nonetheless permitted under §§ 2249, 2250 (§ 2266)";
}
pub relation ein_ehegatte_errichtet_nach_2247_anderer_unterzeichnet_eigenhaendig_mit_2267(t: Testament, errichter: Person, mitunterzeichner: Person) kind empirical {
    label de official "Ein Ehegatte errichtet das Testament nach § 2247, der andere unterzeichnet die gemeinschaftliche Erklärung eigenhändig mit (§ 2267 Satz 1)";
    label en unofficial "one spouse makes the will under § 2247, the other personally co-signs the joint declaration (§ 2267 sentence 1)";
}
pub relation gemeinschaftliches_eigenhaendiges_testament_formwirksam_2267(t: Testament, errichter: Person, mitunterzeichner: Person) kind derived {
    label de official "Das gemeinschaftliche eigenhändige Testament ist formwirksam errichtet (§ 2267 Satz 1)";
    label en unofficial "the joint handwritten will is validly made in form (§ 2267 sentence 1)";
}
pub relation gemeinschaftliches_testament_faellt_unter_2077_2268(t: Testament, ehegatte: Person) kind empirical {
    label de official "Ein Fall des § 2077 liegt vor (§ 2268 Abs. 1)";
    label en unofficial "a § 2077 case applies (§ 2268 (1))";
}
pub relation gemeinschaftliches_testament_ganzem_inhalt_nach_unwirksam_2268(t: Testament) kind derived {
    label de official "Das gemeinschaftliche Testament ist seinem ganzen Inhalt nach unwirksam (§ 2268 Abs. 1)";
    label en unofficial "the joint will is ineffective in its entirety (§ 2268 (1))";
}
pub relation ehe_vor_tod_aufgeloest_oder_2077_abs1_satz2_3_fall_2268(t: Testament, ehegatte: Person) kind empirical {
    label de official "Die Ehe wird vor dem Tode eines Ehegatten aufgelöst, oder die Voraussetzungen des § 2077 Abs. 1 Satz 2 oder 3 liegen vor (§ 2268 Abs. 2)";
    label en unofficial "the marriage is dissolved before the death of a spouse, or the § 2077 (1) sentence 2 or 3 conditions apply (§ 2268 (2))";
}
pub relation anzunehmen_dass_verfuegung_auch_fuer_diesen_fall_getroffen_2268(t: Testament, ehegatte: Person) kind empirical {
    label de official "Es ist anzunehmen, dass die Verfügung auch für diesen Fall getroffen sein würde (§ 2268 Abs. 2)";
    label en unofficial "it must be assumed the disposition would also have been made for this case (§ 2268 (2))";
}
pub relation verfuegung_insoweit_wirksam_2268(t: Testament, ehegatte: Person) kind derived {
    label de official "Die Verfügung bleibt insoweit wirksam (§ 2268 Abs. 2)";
    label en unofficial "the disposition remains effective to that extent (§ 2268 (2))";
}
pub relation gegenseitige_erbeinsetzung_mit_drittzuwendung_nach_ueberlebendem_2269(t: Testament, dritter: Person) kind empirical {
    label de official "Die Ehegatten setzen sich gegenseitig als Erben ein und bestimmen, dass der beiderseitige Nachlass nach dem Tod des Überlebenden an einen Dritten fallen soll (§ 2269 Abs. 1)";
    label en unofficial "the spouses appoint each other heirs and provide that the combined estate passes to a third party after the survivor's death (§ 2269 (1))";
}
pub relation dritter_als_erbe_des_letztversterbenden_fuer_gesamten_nachlass_vermutet_2269(t: Testament, dritter: Person) kind derived {
    label de official "Im Zweifel ist anzunehmen, dass der Dritte für den gesamten Nachlass als Erbe des zuletzt versterbenden Ehegatten eingesetzt ist (§ 2269 Abs. 1)";
    label en unofficial "in case of doubt the third party is deemed appointed heir of the last-dying spouse for the whole estate (§ 2269 (1))";
}
pub relation vermaechtnis_nach_tod_des_ueberlebenden_zu_erfuellen_angeordnet_2269(t: Testament, bedachter: Person) kind empirical {
    label de official "Die Ehegatten ordnen ein Vermächtnis an, das nach dem Tode des Überlebenden erfüllt werden soll (§ 2269 Abs. 2)";
    label en unofficial "the spouses order a legacy to be performed after the survivor's death (§ 2269 (2))";
}
pub relation vermaechtnisanfall_erst_mit_tod_des_ueberlebenden_vermutet_2269(t: Testament, bedachter: Person) kind derived {
    label de official "Im Zweifel fällt das Vermächtnis dem Bedachten erst mit dem Tode des Überlebenden an (§ 2269 Abs. 2)";
    label en unofficial "in case of doubt the legacy devolves on the beneficiary only on the survivor's death (§ 2269 (2))";
}
pub relation verfuegung_des_einen_ehegatten_nicht_ohne_verfuegung_des_anderen_2270(t: Testament, ehegatte: Person, andereverfuegung: Person) kind empirical {
    label de official "Von den Verfügungen ist anzunehmen, dass die eine nicht ohne die andere getroffen sein würde (§ 2270 Abs. 1)";
    label en unofficial "it must be assumed one disposition would not have been made without the other (§ 2270 (1))";
}
pub relation verfuegungen_wechselbezueglich_2270(t: Testament, ehegatte: Person, andereverfuegung: Person) kind derived {
    label de official "Die Verfügungen sind wechselbezüglich (§ 2270 Abs. 1)";
    label en unofficial "the dispositions are reciprocal (§ 2270 (1))";
}
pub relation eine_wechselbezuegliche_verfuegung_nichtig_oder_widerrufen_2270(t: Testament, nichtige: Person, andere: Person) kind empirical {
    label de official "Eine der wechselbezüglichen Verfügungen ist nichtig oder widerrufen (§ 2270 Abs. 1)";
    label en unofficial "one of the reciprocal dispositions is void or revoked (§ 2270 (1))";
}
pub relation andere_wechselbezuegliche_verfuegung_unwirksam_2270(t: Testament, andere: Person) kind derived {
    label de official "Die Unwirksamkeit oder der Widerruf der einen zieht die Unwirksamkeit der anderen nach sich (§ 2270 Abs. 1)";
    label en unofficial "the ineffectiveness or revocation of one entails the ineffectiveness of the other (§ 2270 (1))";
}
pub relation ehegatten_bedenken_sich_gegenseitig_oder_zuwendung_mit_verfuegung_fuer_nahestehenden_2270(t: Testament, ehegatte: Person, andereverfuegung: Person) kind empirical {
    label de official "Die Ehegatten bedenken sich gegenseitig, oder eine Zuwendung ist mit einer Verfügung zugunsten eines dem anderen Ehegatten nahestehenden Bedachten verbunden (§ 2270 Abs. 2)";
    label en unofficial "the spouses benefit each other, or a grant is combined with a disposition favouring someone close to the other spouse (§ 2270 (2))";
}
pub relation wechselbezueglichkeit_vermutet_2270(t: Testament, ehegatte: Person, andereverfuegung: Person) kind derived {
    label de official "Im Zweifel ist Wechselbezüglichkeit anzunehmen (§ 2270 Abs. 2)";
    label en unofficial "reciprocity is presumed in case of doubt (§ 2270 (2))";
}
pub relation verfuegung_ist_weder_erbeinsetzung_noch_vermaechtnis_noch_auflage_noch_rechtswahl_2270(t: Testament, ehegatte: Person) kind empirical {
    label de official "Die Verfügung ist weder Erbeinsetzung, Vermächtnis, Auflage noch Wahl des anzuwendenden Erbrechts (§ 2270 Abs. 3)";
    label en unofficial "the disposition is neither an heir appointment, legacy, charge nor a choice of applicable succession law (§ 2270 (3))";
}
pub relation abs1_nicht_anwendbar_2270(t: Testament, ehegatte: Person) kind derived {
    label de official "Absatz 1 findet auf eine solche Verfügung keine Anwendung (§ 2270 Abs. 3)";
    label en unofficial "subsection (1) does not apply to such a disposition (§ 2270 (3))";
}
pub relation widerruf_wechselbezueglicher_verfuegung_bei_lebzeiten_beider_2271(t: Testament, ehegatte: Person) kind empirical {
    label de official "Der Widerruf einer wechselbezüglichen Verfügung erfolgt bei Lebzeiten beider Ehegatten (§ 2271 Abs. 1 Satz 1)";
    label en unofficial "revocation of a reciprocal disposition occurs while both spouses are alive (§ 2271 (1) sentence 1)";
}
pub relation widerruf_nach_2296_form_2271(t: Testament, ehegatte: Person) kind derived {
    label de official "Der Widerruf erfolgt nach der für den Rücktritt vom Erbvertrag geltenden Vorschrift des § 2296 (§ 2271 Abs. 1 Satz 1)";
    label en unofficial "revocation follows § 2296, governing withdrawal from an inheritance contract (§ 2271 (1) sentence 1)";
}
pub relation ehegatte_versucht_einseitige_aufhebung_durch_neue_verfuegung_bei_lebzeiten_2271(t: Testament, ehegatte: Person) kind empirical {
    label de official "Ein Ehegatte versucht, seine Verfügung durch eine neue letztwillige Verfügung bei Lebzeiten des anderen einseitig aufzuheben (§ 2271 Abs. 1 Satz 2)";
    label en unofficial "a spouse attempts to unilaterally revoke their disposition by a new testamentary disposition while the other is alive (§ 2271 (1) sentence 2)";
}
pub relation einseitige_aufhebung_unwirksam_2271(t: Testament, ehegatte: Person) kind derived {
    label de official "Die einseitige Aufhebung ist unwirksam (§ 2271 Abs. 1 Satz 2)";
    label en unofficial "the unilateral revocation is ineffective (§ 2271 (1) sentence 2)";
}
pub relation anderer_ehegatte_verstorben_2271(t: Testament, ueberlebender: Person) kind empirical {
    label de official "Der andere Ehegatte ist verstorben (§ 2271 Abs. 2 Satz 1)";
    label en unofficial "the other spouse has died (§ 2271 (2) sentence 1)";
}
pub relation widerrufsrecht_erloschen_2271(t: Testament, ueberlebender: Person) kind derived {
    label de official "Das Recht zum Widerruf ist erloschen (§ 2271 Abs. 2 Satz 1)";
    label en unofficial "the right to revoke has lapsed (§ 2271 (2) sentence 1)";
}
pub relation ueberlebender_schlaegt_zuwendung_aus_2271(t: Testament, ueberlebender: Person) kind empirical {
    label de official "Der Überlebende schlägt das ihm Zugewendete aus (§ 2271 Abs. 2 Satz 1)";
    label en unofficial "the survivor disclaims what was granted to them (§ 2271 (2) sentence 1)";
}
pub relation ueberlebender_kann_verfuegung_aufheben_2271(t: Testament, ueberlebender: Person) kind derived {
    label de official "Der Überlebende kann seine Verfügung aufheben (§ 2271 Abs. 2 Satz 1)";
    label en unofficial "the survivor may revoke their disposition (§ 2271 (2) sentence 1)";
}
pub relation ueberlebender_nach_annahme_grund_nach_2294_2336_2271(t: Testament, ueberlebender: Person) kind empirical {
    label de official "Nach Annahme der Zuwendung liegt ein Grund nach § 2294 oder § 2336 vor (§ 2271 Abs. 2 Satz 2)";
    label en unofficial "after accepting the grant, a § 2294 or § 2336 ground exists (§ 2271 (2) sentence 2)";
}
pub relation ueberlebender_zur_aufhebung_trotz_annahme_berechtigt_2271(t: Testament, ueberlebender: Person) kind derived {
    label de official "Der Überlebende ist auch nach der Annahme zur Aufhebung berechtigt (§ 2271 Abs. 2 Satz 2)";
    label en unofficial "the survivor is entitled to revoke even after acceptance (§ 2271 (2) sentence 2)";
}
pub relation pflichtteilsberechtigter_abkoemmling_bedacht_2271(t: Testament, abkoemmling: Person) kind empirical {
    label de official "Ein pflichtteilsberechtigter Abkömmling der Ehegatten oder eines von ihnen ist bedacht (§ 2271 Abs. 3)";
    label en unofficial "a compulsory-portion-entitled descendant of the spouses or one of them is a beneficiary (§ 2271 (3))";
}
pub relation p2289_abs2_entsprechend_anwendbar_2271(t: Testament, abkoemmling: Person) kind derived {
    label de official "Die Vorschrift des § 2289 Abs. 2 findet entsprechende Anwendung (§ 2271 Abs. 3)";
    label en unofficial "§ 2289 (2) applies mutatis mutandis (§ 2271 (3))";
}
pub relation gemeinschaftliches_testament_aus_verwahrung_zurueckgenommen_2272(t: Testament, ehegatte1: Person, ehegatte2: Person) kind empirical {
    label de official "Ein gemeinschaftliches Testament wird nach § 2256 aus amtlicher Verwahrung zurückgenommen (§ 2272)";
    label en unofficial "a joint will is withdrawn from official safekeeping under § 2256 (§ 2272)";
}
pub relation ruecknahme_nur_durch_beide_ehegatten_2272(t: Testament, ehegatte1: Person, ehegatte2: Person) kind derived {
    label de official "Die Rücknahme kann nur von beiden Ehegatten gemeinsam vorgenommen werden (§ 2272)";
    label en unofficial "withdrawal may be made only jointly by both spouses (§ 2272)";
}

// --- Regeln --------------------------------------------------------------

@source(BGB_P2266)
rule GemeinschaftlichesNottestamentBeiEinseitigenVoraussetzungen(t: Testament, ehegatte: Person) strict {
    label de official "Ein gemeinschaftliches Testament kann nach §§ 2249, 2250 auch errichtet werden, wenn die Voraussetzungen nur bei einem Ehegatten vorliegen (§ 2266)"; label en unofficial "A joint will may also be made under §§ 2249, 2250 where the conditions are met for only one spouse (§ 2266)";
    when gemeinschaftliches_testament_voraussetzungen_nur_bei_einem_ehegatten_2266(t, ehegatte); then gemeinschaftliches_nottestament_zulaessig_2266(t, ehegatte);
}
@source(BGB_P2267)
rule GemeinschaftlichesEigenhaendigesTestament(t: Testament, errichter: Person, mitunterzeichner: Person) strict {
    label de official "Es genügt, wenn ein Ehegatte nach § 2247 errichtet und der andere eigenhändig mitunterzeichnet (§ 2267 Satz 1)"; label en unofficial "It suffices that one spouse makes the will under § 2247 and the other personally co-signs (§ 2267 sentence 1)";
    when ein_ehegatte_errichtet_nach_2247_anderer_unterzeichnet_eigenhaendig_mit_2267(t, errichter, mitunterzeichner); then gemeinschaftliches_eigenhaendiges_testament_formwirksam_2267(t, errichter, mitunterzeichner);
}
@source(BGB_P2268) {
    rule UnwirksamBeiEhenichtigkeit(t: Testament, ehegatte: Person) strict {
        label de official "Liegt ein Fall des § 2077 vor, ist das gemeinschaftliche Testament seinem ganzen Inhalt nach unwirksam (§ 2268 Abs. 1)"; label en unofficial "Where a § 2077 case applies, the joint will is entirely ineffective (§ 2268 (1))";
        when gemeinschaftliches_testament_faellt_unter_2077_2268(t, ehegatte); then gemeinschaftliches_testament_ganzem_inhalt_nach_unwirksam_2268(t);
    }
    rule VerfuegungBleibtInsoweitWirksam(t: Testament, ehegatte: Person) strict {
        label de official "Bei Eheauflösung oder § 2077 Abs. 1 Satz 2, 3 bleiben Verfügungen insoweit wirksam, als anzunehmen ist, dass sie auch für diesen Fall getroffen wären (§ 2268 Abs. 2)"; label en unofficial "On dissolution or § 2077 (1) sentences 2, 3, dispositions remain effective insofar as they would have been made for that case too (§ 2268 (2))";
        when ehe_vor_tod_aufgeloest_oder_2077_abs1_satz2_3_fall_2268(t, ehegatte) and anzunehmen_dass_verfuegung_auch_fuer_diesen_fall_getroffen_2268(t, ehegatte); then verfuegung_insoweit_wirksam_2268(t, ehegatte);
    }
}
@source(BGB_P2269) {
    presumption DritterAlsErbeDesLetztversterbendenFuerGesamtenNachlass(t: Testament, dritter: Person) {
        label de official "Setzen sich Ehegatten gegenseitig ein und bestimmen einen Dritten für den beiderseitigen Nachlass nach dem Überlebenden, gilt der Dritte im Zweifel als Erbe für den gesamten Nachlass (§ 2269 Abs. 1)"; label en unofficial "Where spouses appoint each other and name a third party for the combined estate after the survivor, the third party is in case of doubt heir for the whole estate (§ 2269 (1))";
        when gegenseitige_erbeinsetzung_mit_drittzuwendung_nach_ueberlebendem_2269(t, dritter); presume dritter_als_erbe_des_letztversterbenden_fuer_gesamten_nachlass_vermutet_2269(t, dritter);
    }
    presumption VermaechtnisanfallErstMitTodDesUeberlebenden(t: Testament, bedachter: Person) {
        label de official "Ordnen die Ehegatten ein nach dem Tode des Überlebenden zu erfüllendes Vermächtnis an, fällt es im Zweifel erst mit dessen Tod an (§ 2269 Abs. 2)"; label en unofficial "Where the spouses order a legacy performable after the survivor's death, it in case of doubt devolves only then (§ 2269 (2))";
        when vermaechtnis_nach_tod_des_ueberlebenden_zu_erfuellen_angeordnet_2269(t, bedachter); presume vermaechtnisanfall_erst_mit_tod_des_ueberlebenden_vermutet_2269(t, bedachter);
    }
}
@source(BGB_P2270) {
    rule WechselbezueglicheVerfuegungenUnwirksamkeitFolge(t: Testament, ehegatte: Person, andereverfuegung: Person) strict {
        label de official "Sind Verfügungen wechselbezüglich, zieht Nichtigkeit oder Widerruf der einen die Unwirksamkeit der anderen nach sich (§ 2270 Abs. 1)"; label en unofficial "Where dispositions are reciprocal, invalidity or revocation of one entails ineffectiveness of the other (§ 2270 (1))";
        when verfuegung_des_einen_ehegatten_nicht_ohne_verfuegung_des_anderen_2270(t, ehegatte, andereverfuegung); then verfuegungen_wechselbezueglich_2270(t, ehegatte, andereverfuegung);
    }
    rule AndereVerfuegungWirdUnwirksam(t: Testament, nichtige: Person, andere: Person) strict {
        label de official "Ist eine wechselbezügliche Verfügung nichtig oder widerrufen, wird die andere unwirksam (§ 2270 Abs. 1)"; label en unofficial "Where one reciprocal disposition is void or revoked, the other becomes ineffective (§ 2270 (1))";
        when eine_wechselbezuegliche_verfuegung_nichtig_oder_widerrufen_2270(t, nichtige, andere); then andere_wechselbezuegliche_verfuegung_unwirksam_2270(t, andere);
    }
    presumption WechselbezueglichkeitVermutet(t: Testament, ehegatte: Person, andereverfuegung: Person) {
        label de official "Bedenken sich die Ehegatten gegenseitig oder ist eine Zuwendung mit einer Verfügung für einen Nahestehenden verbunden, wird Wechselbezüglichkeit im Zweifel vermutet (§ 2270 Abs. 2)"; label en unofficial "Where the spouses benefit each other or a grant is combined with a disposition for someone close, reciprocity is presumed in case of doubt (§ 2270 (2))";
        when ehegatten_bedenken_sich_gegenseitig_oder_zuwendung_mit_verfuegung_fuer_nahestehenden_2270(t, ehegatte, andereverfuegung); presume wechselbezueglichkeit_vermutet_2270(t, ehegatte, andereverfuegung);
    }
    rule Abs1NichtAnwendbarAufAndereVerfuegungen(t: Testament, ehegatte: Person) strict {
        label de official "Auf andere Verfügungen als Erbeinsetzung, Vermächtnis, Auflage und Rechtswahl findet Absatz 1 keine Anwendung (§ 2270 Abs. 3)"; label en unofficial "Subsection (1) does not apply to dispositions other than heir appointment, legacy, charge and choice of law (§ 2270 (3))";
        when verfuegung_ist_weder_erbeinsetzung_noch_vermaechtnis_noch_auflage_noch_rechtswahl_2270(t, ehegatte); then abs1_nicht_anwendbar_2270(t, ehegatte);
    }
}
@source(BGB_P2271) {
    rule WiderrufBeiLebzeitenNach2296(t: Testament, ehegatte: Person) strict {
        label de official "Der Widerruf einer wechselbezüglichen Verfügung erfolgt bei Lebzeiten beider Ehegatten nach § 2296 (§ 2271 Abs. 1 Satz 1)"; label en unofficial "Revocation of a reciprocal disposition while both spouses live follows § 2296 (§ 2271 (1) sentence 1)";
        when widerruf_wechselbezueglicher_verfuegung_bei_lebzeiten_beider_2271(t, ehegatte); then widerruf_nach_2296_form_2271(t, ehegatte);
    }
    rule EinseitigeAufhebungUnwirksam(t: Testament, ehegatte: Person) strict {
        label de official "Ein Ehegatte kann seine Verfügung bei Lebzeiten des anderen nicht durch neue Verfügung einseitig aufheben (§ 2271 Abs. 1 Satz 2)"; label en unofficial "A spouse cannot unilaterally revoke their disposition by a new disposition while the other lives (§ 2271 (1) sentence 2)";
        when ehegatte_versucht_einseitige_aufhebung_durch_neue_verfuegung_bei_lebzeiten_2271(t, ehegatte); then einseitige_aufhebung_unwirksam_2271(t, ehegatte);
    }
    rule WiderrufsrechtErlischtMitTod(t: Testament, ueberlebender: Person) strict {
        label de official "Das Widerrufsrecht erlischt mit dem Tode des anderen Ehegatten (§ 2271 Abs. 2 Satz 1)"; label en unofficial "The right to revoke lapses on the other spouse's death (§ 2271 (2) sentence 1)";
        when anderer_ehegatte_verstorben_2271(t, ueberlebender); then widerrufsrecht_erloschen_2271(t, ueberlebender);
    }
    rule UeberlebenderKannBeiAusschlagungAufheben(t: Testament, ueberlebender: Person) strict {
        label de official "Der Überlebende kann seine Verfügung aufheben, wenn er das ihm Zugewendete ausschlägt (§ 2271 Abs. 2 Satz 1)"; label en unofficial "The survivor may revoke their disposition if they disclaim what was granted to them (§ 2271 (2) sentence 1)";
        when ueberlebender_schlaegt_zuwendung_aus_2271(t, ueberlebender); then ueberlebender_kann_verfuegung_aufheben_2271(t, ueberlebender);
    }
    rule UeberlebenderAufhebungTrotzAnnahmeBei2294Oder2336(t: Testament, ueberlebender: Person) strict {
        label de official "Auch nach Annahme ist der Überlebende nach § 2294, § 2336 zur Aufhebung berechtigt (§ 2271 Abs. 2 Satz 2)"; label en unofficial "Even after acceptance, the survivor may revoke under §§ 2294, 2336 (§ 2271 (2) sentence 2)";
        when ueberlebender_nach_annahme_grund_nach_2294_2336_2271(t, ueberlebender); then ueberlebender_zur_aufhebung_trotz_annahme_berechtigt_2271(t, ueberlebender);
    }
    rule P2289Abs2EntsprechendBeiPflichtteilsberechtigtemAbkoemmling(t: Testament, abkoemmling: Person) strict {
        label de official "Ist ein pflichtteilsberechtigter Abkömmling bedacht, findet § 2289 Abs. 2 entsprechende Anwendung (§ 2271 Abs. 3)"; label en unofficial "Where a compulsory-portion-entitled descendant is a beneficiary, § 2289 (2) applies mutatis mutandis (§ 2271 (3))";
        when pflichtteilsberechtigter_abkoemmling_bedacht_2271(t, abkoemmling); then p2289_abs2_entsprechend_anwendbar_2271(t, abkoemmling);
    }
}
@source(BGB_P2272)
rule RuecknahmeNurDurchBeideEhegatten(t: Testament, ehegatte1: Person, ehegatte2: Person) strict {
    label de official "Ein gemeinschaftliches Testament kann nach § 2256 nur von beiden Ehegatten zurückgenommen werden (§ 2272)"; label en unofficial "A joint will may be withdrawn under § 2256 only jointly by both spouses (§ 2272)";
    when gemeinschaftliches_testament_aus_verwahrung_zurueckgenommen_2272(t, ehegatte1, ehegatte2); then ruecknahme_nur_durch_beide_ehegatten_2272(t, ehegatte1, ehegatte2);
}
