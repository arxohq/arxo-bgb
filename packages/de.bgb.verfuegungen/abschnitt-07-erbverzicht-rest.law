// BÜRGERLICHES GESETZBUCH, BUCH 5 ABSCHNITT 7 — ERBVERZICHT, REST
// (§§ 2347, 2349, 2350, 2352). §§ 2346 (Abschluss), 2348 (Form, ANCHORED
// über die Notariatsformel im § 2346-Regelkopf), 2351 (Aufhebung) bereits
// in package.law — nicht angetastet.
//
// § 2349, § 2350 Abs. 1, Abs. 2 sind „im Zweifel“-Vermutungen mit
// POSITIVER Gegenausnahme („ein anderes wird bestimmt“) — nicht doppelter
// Negation, wie an den übrigen Vermutungsstellen des Pakets.
//
// § 2352 Satz 3 „Die Vorschriften der §§ 2347 bis 2349 finden Anwendung“:
// § 2347 gilt bereits generisch für jeden Vertrag zwischen Erblasser und
// einem anderen über dessen Erb-/Pflichtteilsrecht (dieselben `e:
// Erbfall, erblasser: Person`-Variablen wie bei § 2346/§ 2352 — kein
// eigenes Prädikat nötig). § 2349 (Erstreckung auf Abkömmlinge) wird für
// den Zuwendungsverzicht bewusst NICHT nachgebildet — siehe Begründung
// beim § 2352-Block unten (Grenze, keine übersehene Norm).

language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

// ---- § 2347 Persönliche Anforderungen, Vertretung --------------------------

pub relation erblasser_beschraenkt_geschaeftsfaehig_2347(e: Erbfall, erblasser: Person) kind empirical {
    label de official "Der Erblasser ist in der Geschäftsfähigkeit beschränkt (§ 2347 Satz 1)";
    label en unofficial "the testator has limited capacity to contract (§ 2347 sentence 1)";
}
pub relation keine_zustimmung_des_gesetzlichen_vertreters_erforderlich_2347(e: Erbfall, erblasser: Person) kind derived {
    label de official "Der Erblasser bedarf nicht der Zustimmung seines gesetzlichen Vertreters (§ 2347 Satz 1)";
    label en unofficial "the testator does not need the consent of their legal representative (§ 2347 sentence 1)";
}
pub relation erblasser_geschaeftsunfaehig_2347(e: Erbfall, erblasser: Person) kind empirical {
    label de official "Der Erblasser ist geschäftsunfähig (§ 2347 Satz 2)";
    label en unofficial "the testator lacks capacity to contract (§ 2347 sentence 2)";
}
pub relation vertrag_durch_gesetzlichen_vertreter_geschlossen_2347(e: Erbfall, erblasser: Person, vertreter: Person) kind empirical {
    label de official "Der Vertrag nach § 2346 wird durch den gesetzlichen Vertreter des Erblassers geschlossen (§ 2347 Satz 2)";
    label en unofficial "the § 2346 contract is entered into by the testator's legal representative (§ 2347 sentence 2)";
}
pub relation vertragsschluss_durch_vertreter_zulaessig_2347(e: Erbfall, erblasser: Person, vertreter: Person) kind derived {
    label de official "Der Vertrag kann durch den gesetzlichen Vertreter geschlossen werden (§ 2347 Satz 2)";
    label en unofficial "the contract may be entered into by the legal representative (§ 2347 sentence 2)";
}

// ---- § 2349 Erstreckung auf Abkömmlinge ------------------------------------

pub relation abkoemmling_oder_seitenverwandter_verzichtet_2349(e: Erbfall, verzichtender: Person) kind empirical {
    label de official "Ein Abkömmling oder ein Seitenverwandter des Erblassers verzichtet auf das gesetzliche Erbrecht (§ 2349)";
    label en unofficial "a descendant or a collateral relative of the testator renounces the statutory right of succession (§ 2349)";
}
pub relation anderes_zur_erstreckung_bestimmt_2349(e: Erbfall, verzichtender: Person) kind empirical {
    label de official "Ein anderes ist bestimmt worden — der Verzicht soll sich nicht auf die Abkömmlinge des Verzichtenden erstrecken (§ 2349, Gegenausnahme)";
    label en unofficial "another arrangement has been made — the renunciation is not to extend to the renunciant's descendants (§ 2349, counter-exception)";
}
pub relation verzicht_erstreckt_sich_auf_abkoemmlinge_2349(e: Erbfall, verzichtender: Person) kind derived {
    label de official "Die Wirkung des Verzichts erstreckt sich im Zweifel auf die Abkömmlinge des Verzichtenden (§ 2349)";
    label en unofficial "in case of doubt the renunciation's effect extends to the renunciant's descendants (§ 2349)";
}

// ---- § 2350 Verzicht zugunsten eines anderen -------------------------------

pub relation verzicht_zugunsten_eines_anderen_2350(e: Erbfall, verzichtender: Person, anderer: Person) kind empirical {
    label de official "Jemand verzichtet zugunsten eines anderen auf das gesetzliche Erbrecht (§ 2350 Abs. 1)";
    label en unofficial "someone renounces the statutory right of succession in favour of another (§ 2350 (1))";
}
pub relation verzicht_ausdruecklich_auch_ohne_erbwerden_des_anderen_2350(e: Erbfall, verzichtender: Person, anderer: Person) kind empirical {
    label de official "Es ist ausdrücklich bestimmt, dass der Verzicht auch gelten soll, wenn der andere nicht Erbe wird (§ 2350 Abs. 1, Gegenausnahme)";
    label en unofficial "it is expressly provided that the renunciation applies even if the other does not become heir (§ 2350 (1), counter-exception)";
}
pub relation verzicht_gilt_nur_fuer_fall_dass_anderer_erbe_wird_2350(e: Erbfall, verzichtender: Person, anderer: Person) kind derived {
    label de official "Im Zweifel gilt der Verzicht nur für den Fall, dass der andere Erbe wird (§ 2350 Abs. 1)";
    label en unofficial "in case of doubt the renunciation applies only if the other becomes heir (§ 2350 (1))";
}
pub relation abkoemmling_des_erblassers_verzichtet_2350(e: Erbfall, verzichtender: Person) kind empirical {
    label de official "Ein Abkömmling des Erblassers verzichtet auf das gesetzliche Erbrecht (§ 2350 Abs. 2)";
    label en unofficial "a descendant of the testator renounces the statutory right of succession (§ 2350 (2))";
}
pub relation verzicht_ausdruecklich_auch_zugunsten_anderer_personen_2350(e: Erbfall, verzichtender: Person) kind empirical {
    label de official "Es ist ausdrücklich bestimmt, dass der Verzicht auch zugunsten anderer als der übrigen Abkömmlinge und des Ehegatten oder Lebenspartners gelten soll (§ 2350 Abs. 2, Gegenausnahme)";
    label en unofficial "it is expressly provided that the renunciation is also to benefit persons other than the remaining descendants and the spouse or civil partner (§ 2350 (2), counter-exception)";
}
pub relation verzicht_gilt_nur_zugunsten_anderer_abkoemmlinge_und_ehegatten_2350(e: Erbfall, verzichtender: Person) kind derived {
    label de official "Im Zweifel gilt der Verzicht nur zugunsten der anderen Abkömmlinge und des Ehegatten oder Lebenspartners des Erblassers (§ 2350 Abs. 2)";
    label en unofficial "in case of doubt the renunciation applies only in favour of the other descendants and the testator's spouse or civil partner (§ 2350 (2))";
}

// ---- § 2352 Verzicht auf Zuwendungen ---------------------------------------

pub relation als_erbe_eingesetzt_oder_vermaechtnisnehmer_2352(e: Erbfall, bedachter: Person) kind empirical {
    label de official "Die Person ist durch Testament als Erbe eingesetzt oder mit einem Vermächtnis bedacht (§ 2352 Satz 1)";
    label en unofficial "the person has been named heir by will or made a legatee (§ 2352 sentence 1)";
}
pub relation verzicht_auf_zuwendung_durch_vertrag_mit_erblasser_2352(e: Erbfall, bedachter: Person, erblasser: Person) kind empirical {
    label de official "Die Person verzichtet durch Vertrag mit dem Erblasser auf die Zuwendung (§ 2352 Satz 1)";
    label en unofficial "the person renounces the benefit by contract with the testator (§ 2352 sentence 1)";
}
pub relation verzicht_auf_zuwendung_wirksam_2352(e: Erbfall, bedachter: Person) kind derived {
    label de official "Der Verzicht auf die Zuwendung ist wirksam (§ 2352)";
    label en unofficial "the renunciation of the benefit is effective (§ 2352)";
}
pub relation zuwendung_an_dritten_in_erbvertrag_gemacht_2352(e: Erbfall, dritter: Person) kind empirical {
    label de official "Einem Dritten ist in einem Erbvertrag eine Zuwendung gemacht (§ 2352 Satz 2)";
    label en unofficial "a benefit has been made to a third party in a contract of inheritance (§ 2352 sentence 2)";
}
pub relation dritter_verzichtet_auf_zuwendung_durch_vertrag_mit_erblasser_2352(e: Erbfall, dritter: Person, erblasser: Person) kind empirical {
    label de official "Der Dritte verzichtet durch Vertrag mit dem Erblasser auf die Zuwendung (§ 2352 Satz 2)";
    label en unofficial "the third party renounces the benefit by contract with the testator (§ 2352 sentence 2)";
}

// ============================================================================

@source(BGB_P2347) {
    rule KeineZustimmungBeiBeschraenkterGeschaeftsfaehigkeit(e: Erbfall, erblasser: Person) strict {
        label de official "Ist der Erblasser in der Geschäftsfähigkeit beschränkt, bedarf er nicht der Zustimmung seines gesetzlichen Vertreters (§ 2347 Satz 1)";
        label en unofficial "if the testator has limited capacity to contract, no consent of the legal representative is needed (§ 2347 sentence 1)";
        when erblasser_beschraenkt_geschaeftsfaehig_2347(e, erblasser);
        then keine_zustimmung_des_gesetzlichen_vertreters_erforderlich_2347(e, erblasser);
    }
    rule VertretungBeiGeschaeftsunfaehigkeit(e: Erbfall, erblasser: Person, vertreter: Person) strict {
        label de official "Ist der Erblasser geschäftsunfähig, kann der Vertrag durch den gesetzlichen Vertreter geschlossen werden (§ 2347 Satz 2)";
        label en unofficial "if the testator lacks capacity to contract, the legal representative may enter into the contract (§ 2347 sentence 2)";
        when erblasser_geschaeftsunfaehig_2347(e, erblasser) and vertrag_durch_gesetzlichen_vertreter_geschlossen_2347(e, erblasser, vertreter);
        then vertragsschluss_durch_vertreter_zulaessig_2347(e, erblasser, vertreter);
    }
}

@source(BGB_P2349)
presumption ErstreckungAufAbkoemmlinge(e: Erbfall, verzichtender: Person) {
    label de official "Verzichtet ein Abkömmling oder Seitenverwandter auf das gesetzliche Erbrecht, erstreckt sich die Wirkung im Zweifel auf seine Abkömmlinge (§ 2349)";
    label en unofficial "where a descendant or collateral relative renounces the statutory right of succession, its effect extends, in case of doubt, to their descendants (§ 2349)";
    when abkoemmling_oder_seitenverwandter_verzichtet_2349(e, verzichtender);
    presume verzicht_erstreckt_sich_auf_abkoemmlinge_2349(e, verzichtender);
    unless anderes_zur_erstreckung_bestimmt_2349(e, verzichtender);
}

@source(BGB_P2350) {
    presumption VerzichtNurFuerFallDassAndererErbeWird(e: Erbfall, verzichtender: Person, anderer: Person) {
        label de official "Verzichtet jemand zugunsten eines anderen, ist im Zweifel anzunehmen, dass der Verzicht nur gilt, falls der andere Erbe wird (§ 2350 Abs. 1)";
        label en unofficial "where someone renounces in favour of another, it is presumed the renunciation applies only if the other becomes heir (§ 2350 (1))";
        when verzicht_zugunsten_eines_anderen_2350(e, verzichtender, anderer);
        presume verzicht_gilt_nur_fuer_fall_dass_anderer_erbe_wird_2350(e, verzichtender, anderer);
        unless verzicht_ausdruecklich_auch_ohne_erbwerden_des_anderen_2350(e, verzichtender, anderer);
    }
    presumption VerzichtNurZugunstenAndererAbkoemmlingeUndEhegatten(e: Erbfall, verzichtender: Person) {
        label de official "Verzichtet ein Abkömmling des Erblassers, ist im Zweifel anzunehmen, dass der Verzicht nur zugunsten der anderen Abkömmlinge und des Ehegatten oder Lebenspartners gilt (§ 2350 Abs. 2)";
        label en unofficial "where a descendant of the testator renounces, it is presumed the renunciation applies only in favour of the other descendants and the spouse or civil partner (§ 2350 (2))";
        when abkoemmling_des_erblassers_verzichtet_2350(e, verzichtender);
        presume verzicht_gilt_nur_zugunsten_anderer_abkoemmlinge_und_ehegatten_2350(e, verzichtender);
        unless verzicht_ausdruecklich_auch_zugunsten_anderer_personen_2350(e, verzichtender);
    }
}

@source(BGB_P2352) {
    rule VerzichtAufZuwendungDurchTestamentBedachten(e: Erbfall, bedachter: Person, erblasser: Person) strict {
        label de official "Wer durch Testament als Erbe eingesetzt oder mit einem Vermächtnis bedacht ist, kann durch Vertrag mit dem Erblasser auf die Zuwendung verzichten (§ 2352 Satz 1)";
        label en unofficial "a person named heir by will or made a legatee may renounce the benefit by contract with the testator (§ 2352 sentence 1)";
        when als_erbe_eingesetzt_oder_vermaechtnisnehmer_2352(e, bedachter) and verzicht_auf_zuwendung_durch_vertrag_mit_erblasser_2352(e, bedachter, erblasser);
        then verzicht_auf_zuwendung_wirksam_2352(e, bedachter);
    }
    rule VerzichtAufErbvertraglicheZuwendungAnDritten(e: Erbfall, dritter: Person, erblasser: Person) strict {
        label de official "Das Gleiche gilt für eine Zuwendung, die in einem Erbvertrag einem Dritten gemacht ist (§ 2352 Satz 2)";
        label en unofficial "the same applies to a benefit made to a third party in a contract of inheritance (§ 2352 sentence 2)";
        when zuwendung_an_dritten_in_erbvertrag_gemacht_2352(e, dritter) and dritter_verzichtet_auf_zuwendung_durch_vertrag_mit_erblasser_2352(e, dritter, erblasser);
        then verzicht_auf_zuwendung_wirksam_2352(e, dritter);
    }
    // Satz 3 „Die Vorschriften der §§ 2347 bis 2349 finden Anwendung“: § 2347
    // gilt hier generisch mit (e, erblasser) mit — kein eigenes Prädikat.
    // § 2349 (Erstreckung) wird für den Zuwendungsverzicht BEWUSST NICHT
    // durch einen zweiten defeasible-Produzenten desselben Kopfes
    // (`verzicht_erstreckt_sich_auf_abkoemmlinge_2349`) nachgebildet: das
    // würde einen gesetzlichen Erbrechtsverzicht und einen Zuwendungsverzicht
    // auf demselben Prädikat verschmelzen, obwohl es zwei verschiedene
    // Verzichtsarten sind. Grenze, keine übersehene Norm.
}
