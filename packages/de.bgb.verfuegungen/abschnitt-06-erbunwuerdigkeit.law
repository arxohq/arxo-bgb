// BÜRGERLICHES GESETZBUCH, BUCH 5 ABSCHNITT 6 — ERBUNWÜRDIGKEIT
// (§§ 2339–2345). § 2346 (Abschnitt 7, Erbverzicht) bereits in
// package.law — nicht angetastet.
//
// § 2339 Abs. 1 Nr. 1–3: die Verfehlungen selbst (vorsätzliche Tötung,
// widerrechtliche Verhinderung, arglistige Täuschung/Drohung) sind
// Wertungen, die ein Gericht im Anfechtungsprozess (§ 2342) feststellt —
// Kanal §47.3, wie bei § 2333. § 2344 Abs. 2 nennt den Wegfall-Mechanismus
// („als hätte er nicht gelebt“) — dasselbe Wegfall-Prädikat, das
// `de.bgb.erbfolge` für seine Stämme führt; diese Runde formalisiert NUR
// die Erbunwürdigkeits-eigene Folge (Anfall gilt als nicht erfolgt), nicht
// die Brücke zum externen Wegfall-Konsumenten — der bleibt, wie im README
// von `de.bgb.erbfolge` für § 2344/§ 2346 vorgesehen, Fallangabe.

language "law.core" version "0.2";
package de.bgb.verfuegungen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verfuegungen";

pub external judgment relation erblasser_vorsaetzlich_widerrechtlich_getoetet_oder_testierunfaehig_gemacht_2339(e: Erbfall, p: Person) {
    authority Court;
    label de official "Die Person hat den Erblasser vorsätzlich und widerrechtlich getötet, zu töten versucht oder in einen bis zum Tode fortdauernden Zustand der Testierunfähigkeit versetzt (§ 2339 Abs. 1 Nr. 1)";
    label en unofficial "the person intentionally and unlawfully killed, attempted to kill, or rendered testamentarily incapable until death, the testator (§ 2339 (1) no. 1)";
}
pub external judgment relation erblasser_vorsaetzlich_widerrechtlich_an_verfuegung_gehindert_2339(e: Erbfall, p: Person) {
    authority Court;
    label de official "Die Person hat den Erblasser vorsätzlich und widerrechtlich verhindert, eine Verfügung von Todes wegen zu errichten oder aufzuheben (§ 2339 Abs. 1 Nr. 2)";
    label en unofficial "the person intentionally and unlawfully prevented the testator from making or revoking a disposition mortis causa (§ 2339 (1) no. 2)";
}
pub external judgment relation erblasser_durch_taeuschung_oder_drohung_zu_verfuegung_bestimmt_2339(e: Erbfall, p: Person) {
    authority Court;
    label de official "Die Person hat den Erblasser durch arglistige Täuschung oder widerrechtliche Drohung bestimmt, eine Verfügung von Todes wegen zu errichten oder aufzuheben (§ 2339 Abs. 1 Nr. 3)";
    label en unofficial "the person, by fraudulent deceit or unlawful threat, caused the testator to make or revoke a disposition mortis causa (§ 2339 (1) no. 3)";
}
pub relation straftat_nach_267_271_274_stgb_2339(e: Erbfall, p: Person) kind empirical {
    label de official "Die Person hat sich in Ansehung einer Verfügung des Erblassers einer Straftat nach §§ 267, 271 bis 274 StGB schuldig gemacht (§ 2339 Abs. 1 Nr. 4)";
    label en unofficial "the person is guilty of an offence under §§ 267, 271 to 274 of the Criminal Code regarding a disposition of the testator (§ 2339 (1) no. 4)";
}
pub relation erbunwuerdig_2339(e: Erbfall, p: Person) kind derived {
    label de official "Die Person ist erbunwürdig (§ 2339 Abs. 1)";
    label en unofficial "the person is unworthy to inherit (§ 2339 (1))";
}
pub relation verfuegung_zu_der_3_oder_4_bestimmt_vor_erbfall_unwirksam_geworden_2339(e: Erbfall, p: Person) kind empirical {
    label de official "Die Verfügung, zu deren Errichtung, Aufhebung oder in deren Ansehung nach Nr. 3, 4 gehandelt wurde, ist vor dem Erbfall unwirksam geworden (§ 2339 Abs. 2)";
    label en unofficial "the disposition concerned by no. 3 or 4 became ineffective before devolution (§ 2339 (2))";
}
pub relation erbunwuerdigkeit_nach_abs2_ausgeschlossen_2339(e: Erbfall, p: Person) kind derived {
    label de official "Die Erbunwürdigkeit tritt in den Fällen der Nr. 3, 4 nicht ein (§ 2339 Abs. 2)";
    label en unofficial "unworthiness does not arise in the no. 3, 4 cases (§ 2339 (2))";
}
pub relation erbschaft_dem_erbunwuerdigen_angefallen_2340(e: Erbfall, p: Person) kind empirical {
    label de official "Die Erbschaft ist dem (möglicherweise) Erbunwürdigen angefallen (§ 2340 Abs. 2 Satz 1)";
    label en unofficial "the estate has devolved on the (possibly) unworthy person (§ 2340 (2) sentence 1)";
}
pub relation anfechtung_des_erbschaftserwerbs_geltend_gemacht_2340(e: Erbfall, p: Person) kind derived {
    label de official "Die Erbunwürdigkeit wird durch Anfechtung des Erbschaftserwerbs geltend gemacht; erst nach Anfall zulässig (§ 2340 Abs. 1, 2)";
    label en unofficial "unworthiness is asserted by avoidance of the acquisition of the estate; permitted only after devolution (§ 2340 (1), (2))";
}
pub relation anfechtungsfrist_des_2082_massgeblich_2340(e: Erbfall, p: Person) kind derived {
    label de official "Die Anfechtung kann nur innerhalb der in § 2082 bestimmten Fristen erfolgen (§ 2340 Abs. 3)";
    label en unofficial "avoidance may only occur within the periods specified in § 2082 (§ 2340 (3))";
}
pub relation wegfall_des_erbunwuerdigen_kommt_person_zustatten_2341(e: Erbfall, berechtigter: Person, erbunwuerdiger: Person) kind empirical {
    label de official "Der Wegfall des Erbunwürdigen kommt der Person zustatten, sei es auch nur beim Wegfall eines anderen (§ 2341)";
    label en unofficial "the unworthy person's falling away benefits that person, even if only upon another's falling away (§ 2341)";
}
pub relation anfechtungsberechtigt_2341(e: Erbfall, berechtigter: Person) kind derived {
    label de official "Die Person ist anfechtungsberechtigt (§ 2341)";
    label en unofficial "the person is entitled to avoid (§ 2341)";
}
pub relation anfechtungsklage_erhoben_2342(e: Erbfall, p: Person) kind empirical {
    label de official "Die Anfechtungsklage auf Erbunwürdigerklärung ist erhoben (§ 2342 Abs. 1)";
    label en unofficial "the action to declare unworthiness has been brought (§ 2342 (1))";
}
pub relation klage_auf_erbunwuerdigerklaerung_gerichtet_2342(e: Erbfall, p: Person) kind derived {
    label de official "Die Klage ist darauf gerichtet, dass der Erbe für erbunwürdig erklärt wird (§ 2342 Abs. 1)";
    label en unofficial "the action seeks a declaration that the heir is unworthy (§ 2342 (1))";
}
pub relation urteil_rechtskraeftig_2342(e: Erbfall, p: Person) kind empirical {
    label de official "Das Urteil ist rechtskräftig geworden (§ 2342 Abs. 2)";
    label en unofficial "the judgment has become final (§ 2342 (2))";
}
pub relation anfechtungswirkung_eingetreten_2342(e: Erbfall, p: Person) kind derived {
    label de official "Die Wirkung der Anfechtung tritt mit der Rechtskraft des Urteils ein (§ 2342 Abs. 2)";
    label en unofficial "the effect of avoidance occurs upon the judgment becoming final (§ 2342 (2))";
}
pub relation erblasser_hat_erbunwuerdigem_verziehen_2343(e: Erbfall, p: Person) kind empirical {
    label de official "Der Erblasser hat dem Erbunwürdigen verziehen (§ 2343)";
    label en unofficial "the testator has forgiven the unworthy person (§ 2343)";
}
pub relation anfechtung_wegen_verzeihung_ausgeschlossen_2343(e: Erbfall, p: Person) kind derived {
    label de official "Die Anfechtung ist ausgeschlossen (§ 2343)";
    label en unofficial "avoidance is excluded (§ 2343)";
}
pub relation erbe_fuer_erbunwuerdig_erklaert_2344(e: Erbfall, erbunwuerdiger: Person) kind empirical {
    label de official "Der Erbe ist rechtskräftig für erbunwürdig erklärt (§ 2344 Abs. 1)";
    label en unofficial "the heir has been finally declared unworthy (§ 2344 (1))";
}
pub relation anfall_an_erbunwuerdigen_gilt_als_nicht_erfolgt_2344(e: Erbfall, erbunwuerdiger: Person) kind derived {
    label de official "Der Anfall an ihn gilt als nicht erfolgt (§ 2344 Abs. 1)";
    label en unofficial "the devolution on him is deemed not to have occurred (§ 2344 (1))";
}
pub relation ersatzberufener_ohne_erbunwuerdigen_2344(e: Erbfall, erbunwuerdiger: Person, ersatzberufener: Person) kind empirical {
    label de official "Der Ersatzberufene wäre berufen, wenn der Erbunwürdige zur Zeit des Erbfalls nicht gelebt hätte (§ 2344 Abs. 2)";
    label en unofficial "the substitute would be called if the unworthy person had not been alive at devolution (§ 2344 (2))";
}
pub relation erbschaft_faellt_ersatzberufenem_rueckwirkend_an_2344(e: Erbfall, ersatzberufener: Person) kind derived {
    label de official "Die Erbschaft fällt dem Ersatzberufenen an; der Anfall gilt als mit dem Erbfall erfolgt (§ 2344 Abs. 2)";
    label en unofficial "the estate devolves on the substitute; devolution is deemed to have occurred with the original devolution (§ 2344 (2))";
}
pub relation vermaechtnisnehmer_verfehlung_nach_2339_abs1_2345(e: Erbfall, vermaechtnisnehmer: Person) kind empirical {
    label de official "Der Vermächtnisnehmer hat sich einer Verfehlung nach § 2339 Abs. 1 schuldig gemacht (§ 2345 Abs. 1 Satz 1)";
    label en unofficial "the legatee is guilty of an offence under § 2339 (1) (§ 2345 (1) sentence 1)";
}
pub relation vermaechtnisanspruch_anfechtbar_2345(e: Erbfall, vermaechtnisnehmer: Person) kind derived {
    label de official "Der Anspruch aus dem Vermächtnis ist anfechtbar; §§ 2082, 2083, 2339 Abs. 2, 2341, 2343 finden Anwendung (§ 2345 Abs. 1)";
    label en unofficial "the legacy claim is avoidable; §§ 2082, 2083, 2339 (2), 2341, 2343 apply (§ 2345 (1))";
}
pub relation pflichtteilsberechtigter_verfehlung_nach_2339_abs1_2345(e: Erbfall, p: Person) kind empirical {
    label de official "Der Pflichtteilsberechtigte hat sich einer Verfehlung nach § 2339 Abs. 1 schuldig gemacht (§ 2345 Abs. 2)";
    label en unofficial "the beneficiary is guilty of an offence under § 2339 (1) (§ 2345 (2))";
}
pub relation pflichtteilsanspruch_anfechtbar_2345(e: Erbfall, p: Person) kind derived {
    label de official "Dasselbe gilt für den Pflichtteilsanspruch (§ 2345 Abs. 2)";
    label en unofficial "the same applies to the compulsory-portion claim (§ 2345 (2))";
}

@source(BGB_P2339) {
    rule ErbunwuerdigWegenToetung(e: Erbfall, p: Person) strict {
        label de official "Erbunwürdig ist, wer den Erblasser vorsätzlich und widerrechtlich getötet, zu töten versucht oder testierunfähig gemacht hat (§ 2339 Abs. 1 Nr. 1)"; label en unofficial "A person who intentionally and unlawfully killed, attempted to kill, or rendered testamentarily incapable, the testator is unworthy (§ 2339 (1) no. 1)";
        when erblasser_vorsaetzlich_widerrechtlich_getoetet_oder_testierunfaehig_gemacht_2339(e, p); then erbunwuerdig_2339(e, p);
    }
    rule ErbunwuerdigWegenVerhinderung(e: Erbfall, p: Person) strict {
        label de official "Erbunwürdig ist, wer den Erblasser vorsätzlich und widerrechtlich an einer Verfügung von Todes wegen gehindert hat (§ 2339 Abs. 1 Nr. 2)"; label en unofficial "A person who intentionally and unlawfully prevented a disposition mortis causa is unworthy (§ 2339 (1) no. 2)";
        when erblasser_vorsaetzlich_widerrechtlich_an_verfuegung_gehindert_2339(e, p) and not_known(verfuegung_zu_der_3_oder_4_bestimmt_vor_erbfall_unwirksam_geworden_2339(e, p)); then erbunwuerdig_2339(e, p);
    }
    rule ErbunwuerdigWegenTaeuschungOderDrohung(e: Erbfall, p: Person) strict {
        label de official "Erbunwürdig ist, wer den Erblasser durch arglistige Täuschung oder widerrechtliche Drohung zu einer Verfügung bestimmt hat (§ 2339 Abs. 1 Nr. 3)"; label en unofficial "A person who by fraudulent deceit or unlawful threat caused a disposition is unworthy (§ 2339 (1) no. 3)";
        when erblasser_durch_taeuschung_oder_drohung_zu_verfuegung_bestimmt_2339(e, p) and not_known(verfuegung_zu_der_3_oder_4_bestimmt_vor_erbfall_unwirksam_geworden_2339(e, p)); then erbunwuerdig_2339(e, p);
    }
    rule ErbunwuerdigWegenStraftat(e: Erbfall, p: Person) strict {
        label de official "Erbunwürdig ist, wer sich in Ansehung einer Verfügung einer Straftat nach §§ 267, 271 bis 274 StGB schuldig gemacht hat (§ 2339 Abs. 1 Nr. 4)"; label en unofficial "A person guilty of an offence under §§ 267, 271 to 274 of the Criminal Code regarding a disposition is unworthy (§ 2339 (1) no. 4)";
        when straftat_nach_267_271_274_stgb_2339(e, p) and not_known(verfuegung_zu_der_3_oder_4_bestimmt_vor_erbfall_unwirksam_geworden_2339(e, p)); then erbunwuerdig_2339(e, p);
    }
    rule KeineErbunwuerdigkeitBeiVorherigerUnwirksamkeit(e: Erbfall, p: Person) strict {
        label de official "Die Erbunwürdigkeit nach Nr. 3, 4 tritt nicht ein, wenn die betroffene Verfügung vor dem Erbfall unwirksam geworden ist (§ 2339 Abs. 2)"; label en unofficial "Unworthiness under no. 3, 4 does not arise if the disposition concerned became ineffective before devolution (§ 2339 (2))";
        when verfuegung_zu_der_3_oder_4_bestimmt_vor_erbfall_unwirksam_geworden_2339(e, p); then erbunwuerdigkeit_nach_abs2_ausgeschlossen_2339(e, p);
    }
}
@source(BGB_P2340) {
    rule AnfechtungNachAnfallZulaessig(e: Erbfall, p: Person) strict {
        label de official "Die Erbunwürdigkeit wird durch Anfechtung des Erbschaftserwerbs geltend gemacht, zulässig erst nach dem Anfall (§ 2340 Abs. 1, 2)"; label en unofficial "Unworthiness is asserted by avoidance of the acquisition, permitted only after devolution (§ 2340 (1), (2))";
        when erbschaft_dem_erbunwuerdigen_angefallen_2340(e, p); then anfechtung_des_erbschaftserwerbs_geltend_gemacht_2340(e, p);
    }
    rule AnfechtungsfristNach2082(e: Erbfall, p: Person) strict {
        label de official "Die Anfechtung kann nur innerhalb der in § 2082 bestimmten Fristen erfolgen (§ 2340 Abs. 3)"; label en unofficial "Avoidance may occur only within the § 2082 periods (§ 2340 (3))";
        when erbschaft_dem_erbunwuerdigen_angefallen_2340(e, p); then anfechtungsfrist_des_2082_massgeblich_2340(e, p);
    }
}
@source(BGB_P2341)
rule AnfechtungsberechtigtBeiWegfallsvorteil(e: Erbfall, berechtigter: Person, erbunwuerdiger: Person) strict {
    label de official "Anfechtungsberechtigt ist, wem der Wegfall des Erbunwürdigen zustatten kommt, auch nur bei dessen weiterem Wegfall (§ 2341)"; label en unofficial "Entitled to avoid is whoever benefits from the unworthy person's falling away, even only upon a further falling away (§ 2341)";
    when wegfall_des_erbunwuerdigen_kommt_person_zustatten_2341(e, berechtigter, erbunwuerdiger); then anfechtungsberechtigt_2341(e, berechtigter);
}
@source(BGB_P2342) {
    rule AnfechtungsklageAufErbunwuerdigerklaerung(e: Erbfall, p: Person) strict {
        label de official "Die Anfechtung erfolgt durch Klage auf Erbunwürdigerklärung (§ 2342 Abs. 1)"; label en unofficial "Avoidance is by action for a declaration of unworthiness (§ 2342 (1))";
        when anfechtungsklage_erhoben_2342(e, p); then klage_auf_erbunwuerdigerklaerung_gerichtet_2342(e, p);
    }
    rule AnfechtungswirkungMitRechtskraft(e: Erbfall, p: Person) strict {
        label de official "Die Wirkung der Anfechtung tritt erst mit der Rechtskraft des Urteils ein (§ 2342 Abs. 2)"; label en unofficial "The effect of avoidance occurs only upon the judgment becoming final (§ 2342 (2))";
        when urteil_rechtskraeftig_2342(e, p); then anfechtungswirkung_eingetreten_2342(e, p);
    }
}
@source(BGB_P2343)
rule AnfechtungAusgeschlossenBeiVerzeihung(e: Erbfall, p: Person) strict {
    label de official "Die Anfechtung ist ausgeschlossen, wenn der Erblasser dem Erbunwürdigen verziehen hat (§ 2343)"; label en unofficial "Avoidance is excluded where the testator has forgiven the unworthy person (§ 2343)";
    when erblasser_hat_erbunwuerdigem_verziehen_2343(e, p); then anfechtung_wegen_verzeihung_ausgeschlossen_2343(e, p);
}
@source(BGB_P2344) {
    rule AnfallGiltAlsNichtErfolgt(e: Erbfall, erbunwuerdiger: Person) strict {
        label de official "Ist ein Erbe für erbunwürdig erklärt, gilt der Anfall an ihn als nicht erfolgt (§ 2344 Abs. 1)"; label en unofficial "Where an heir is declared unworthy, the devolution on him is deemed not to have occurred (§ 2344 (1))";
        when erbe_fuer_erbunwuerdig_erklaert_2344(e, erbunwuerdiger); then anfall_an_erbunwuerdigen_gilt_als_nicht_erfolgt_2344(e, erbunwuerdiger);
    }
    rule ErbschaftFaelltErsatzberufenemRueckwirkendAn(e: Erbfall, erbunwuerdiger: Person, ersatzberufener: Person) strict {
        label de official "Die Erbschaft fällt dem an, der ohne den Erbunwürdigen berufen wäre; der Anfall gilt als mit dem Erbfall erfolgt (§ 2344 Abs. 2)"; label en unofficial "The estate devolves on whoever would be called absent the unworthy person; devolution is deemed to occur with the original devolution (§ 2344 (2))";
        when erbe_fuer_erbunwuerdig_erklaert_2344(e, erbunwuerdiger) and ersatzberufener_ohne_erbunwuerdigen_2344(e, erbunwuerdiger, ersatzberufener); then erbschaft_faellt_ersatzberufenem_rueckwirkend_an_2344(e, ersatzberufener);
    }
}
@source(BGB_P2345) {
    rule VermaechtnisanspruchAnfechtbar(e: Erbfall, vermaechtnisnehmer: Person) strict {
        label de official "Hat sich ein Vermächtnisnehmer einer Verfehlung nach § 2339 Abs. 1 schuldig gemacht, ist der Anspruch aus dem Vermächtnis anfechtbar (§ 2345 Abs. 1)"; label en unofficial "Where a legatee is guilty of a § 2339 (1) offence, the legacy claim is avoidable (§ 2345 (1))";
        when vermaechtnisnehmer_verfehlung_nach_2339_abs1_2345(e, vermaechtnisnehmer); then vermaechtnisanspruch_anfechtbar_2345(e, vermaechtnisnehmer);
    }
    rule PflichtteilsanspruchAnfechtbar(e: Erbfall, p: Person) strict {
        label de official "Dasselbe gilt für den Pflichtteilsanspruch bei entsprechender Verfehlung des Pflichtteilsberechtigten (§ 2345 Abs. 2)"; label en unofficial "The same applies to the compulsory-portion claim on the corresponding offence by the beneficiary (§ 2345 (2))";
        when pflichtteilsberechtigter_verfehlung_nach_2339_abs1_2345(e, p); then pflichtteilsanspruch_anfechtbar_2345(e, p);
    }
}
