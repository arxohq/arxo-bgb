language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";

test "§§ 1968, 1973, 1990, 2018, 2034, 2050: Erbenpositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1968(entity_ref("urn:erb:e1968"), entity_ref("urn:erb:p1968"), 1000.00 EUR, @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1973(entity_ref("urn:erb:e1973"), entity_ref("urn:erb:p1973"), entity_ref("urn:erb:v1973"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1990(entity_ref("urn:erb:e1990"), entity_ref("urn:erb:p1990"), entity_ref("urn:erb:v1990"), @2026-01-01) { origin case_input; }
 assert "d": position_trigger_2018(entity_ref("urn:erb:e2018"), entity_ref("urn:erb:p2018"), entity_ref("urn:erb:b2018"), @2026-01-01) { origin case_input; }
 assert "e": position_trigger_2034(entity_ref("urn:erb:v2034"), entity_ref("urn:erb:p2034"), @2026-01-01) { origin case_input; }
 assert "f": position_trigger_2050(entity_ref("urn:erb:e2050"), entity_ref("urn:erb:p2050"), entity_ref("urn:erb:z2050"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Beerdigungskosten1968, ACTIVE); expect position(Verweigerung1973, ACTIVE); expect position(Duernftigkeit1990, ACTIVE); expect position(Herausgabe2018, ACTIVE); expect position(Vorkauf2034, ACTIVE); expect position(Ausgleichung2050, ACTIVE);
}

test "§§ 1968, 1973, 1990, 2018, 2034, 2050: Erbenpositionen erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1968(entity_ref("urn:erb:e1968"), entity_ref("urn:erb:p1968"), 1000.00 EUR, @2026-01-01) { origin case_input; }
 assert "ag": traegt_beerdigungskosten(entity_ref("urn:erb:e1968"), entity_ref("urn:erb:p1968"), 1000.00 EUR) { origin case_input; }
 assert "b": position_trigger_1973(entity_ref("urn:erb:e1973"), entity_ref("urn:erb:p1973"), entity_ref("urn:erb:v1973"), @2026-01-01) { origin case_input; }
 assert "bg": befriedigung_verweigerbar(entity_ref("urn:erb:e1973"), entity_ref("urn:erb:v1973")) { origin case_input; }
 assert "c": position_trigger_1990(entity_ref("urn:erb:e1990"), entity_ref("urn:erb:p1990"), entity_ref("urn:erb:v1990"), @2026-01-01) { origin case_input; }
 assert "cg": duerftigkeitseinrede(entity_ref("urn:erb:e1990"), entity_ref("urn:erb:v1990")) { origin case_input; }
 assert "d": position_trigger_2018(entity_ref("urn:erb:e2018"), entity_ref("urn:erb:p2018"), entity_ref("urn:erb:b2018"), @2026-01-01) { origin case_input; }
 assert "dg": herausgabeanspruch_des_erben(entity_ref("urn:erb:e2018"), entity_ref("urn:erb:p2018"), entity_ref("urn:erb:b2018")) { origin case_input; }
 assert "e": position_trigger_2034(entity_ref("urn:erb:v2034"), entity_ref("urn:erb:p2034"), @2026-01-01) { origin case_input; }
 assert "eg": vorkaufsberechtigt(entity_ref("urn:erb:v2034"), entity_ref("urn:erb:p2034")) { origin case_input; }
 assert "f": position_trigger_2050(entity_ref("urn:erb:e2050"), entity_ref("urn:erb:p2050"), entity_ref("urn:erb:z2050"), @2026-01-01) { origin case_input; }
 assert "fg": zur_ausgleichung_zu_bringen(entity_ref("urn:erb:e2050"), entity_ref("urn:erb:p2050"), entity_ref("urn:erb:z2050")) { origin case_input; } }
 evaluate positions();
 expect position(Beerdigungskosten1968, SATISFIED); expect position(Verweigerung1973, ACTIVE); expect position(Duernftigkeit1990, ACTIVE); expect position(Herausgabe2018, ACTIVE); expect position(Vorkauf2034, ACTIVE); expect position(Ausgleichung2050, SATISFIED);
}
