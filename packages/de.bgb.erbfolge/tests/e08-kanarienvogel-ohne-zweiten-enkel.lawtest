language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";

// Kanarienvogel „ein Erbe weniger“: wie e02, aber ohne G2 — G1 erhält den ganzen Stamm des C2 (1/4 statt 1/8); die übrigen Anteile bleiben.
test "Kanarienvogel: Wegfall eines Enkels verändert genau den Stamm" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:pilot:e08:E"), entity_ref("urn:de:bgb:pilot:e08:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:pilot:e08:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:pilot:e08:E"), entity_ref("urn:de:bgb:pilot:e08:F")) { origin case_input; }
        assert "f4": ehe_beim_erbfall(entity_ref("urn:de:bgb:pilot:e08:E"), entity_ref("urn:de:bgb:pilot:e08:EHE")) { origin case_input; }
        assert "f5": de.bgb.ehe::ehegatten(entity_ref("urn:de:bgb:pilot:e08:EHE"), entity_ref("urn:de:bgb:pilot:e08:D"), entity_ref("urn:de:bgb:pilot:e08:S")) { origin case_input; }
        assert "f6": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e08:E"), entity_ref("urn:de:bgb:pilot:e08:S")) { origin case_input; }
        assert "f7": de.bgb.ehe::kein_ehevertrag(entity_ref("urn:de:bgb:pilot:e08:EHE")) { origin case_input; }
        assert "f10": abstammung(entity_ref("urn:de:bgb:pilot:e08:F"), entity_ref("urn:de:bgb:pilot:e08:D"), entity_ref("urn:de:bgb:pilot:e08:C1")) { origin case_input; }
        assert "f11": abstammung(entity_ref("urn:de:bgb:pilot:e08:F"), entity_ref("urn:de:bgb:pilot:e08:D"), entity_ref("urn:de:bgb:pilot:e08:C2")) { origin case_input; }
        assert "f12": abstammung(entity_ref("urn:de:bgb:pilot:e08:F"), entity_ref("urn:de:bgb:pilot:e08:C2"), entity_ref("urn:de:bgb:pilot:e08:G1")) { origin case_input; }
        assert "f13": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e08:E"), entity_ref("urn:de:bgb:pilot:e08:C1")) { origin case_input; }
        assert "f14": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e08:E"), entity_ref("urn:de:bgb:pilot:e08:G1")) { origin case_input; }
        assert "f15": vorverstorben(entity_ref("urn:de:bgb:pilot:e08:E"), entity_ref("urn:de:bgb:pilot:e08:C2")) { origin case_input; }
    }
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e08:E"), entity_ref("urn:de:bgb:pilot:e08:G1"), 1 / 4));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e08:E"), entity_ref("urn:de:bgb:pilot:e08:G1"), 1 / 8));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e08:E"), entity_ref("urn:de:bgb:pilot:e08:C1"), 1 / 4));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e08:E"), entity_ref("urn:de:bgb:pilot:e08:S"), 1 / 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(erbschaft_vollstaendig_verteilt(entity_ref("urn:de:bgb:pilot:e08:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
