language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";

// § 1925 Abs. 3 Satz 2: Mutter vorverstorben ohne Abkömmlinge — der überlebende Vater erbt allein.
test "§ 1925 Abs. 3 Satz 2: überlebender Elternteil erbt allein" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:pilot:e06:E"), entity_ref("urn:de:bgb:pilot:e06:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:pilot:e06:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:pilot:e06:E"), entity_ref("urn:de:bgb:pilot:e06:F")) { origin case_input; }
        assert "f10": abstammung(entity_ref("urn:de:bgb:pilot:e06:F"), entity_ref("urn:de:bgb:pilot:e06:M"), entity_ref("urn:de:bgb:pilot:e06:D")) { origin case_input; }
        assert "f11": abstammung(entity_ref("urn:de:bgb:pilot:e06:F"), entity_ref("urn:de:bgb:pilot:e06:V"), entity_ref("urn:de:bgb:pilot:e06:D")) { origin case_input; }
        assert "f12": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e06:E"), entity_ref("urn:de:bgb:pilot:e06:V")) { origin case_input; }
        assert "f13": vorverstorben(entity_ref("urn:de:bgb:pilot:e06:E"), entity_ref("urn:de:bgb:pilot:e06:M")) { origin case_input; }
    }
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e06:E"), entity_ref("urn:de:bgb:pilot:e06:V"), 1 / 1));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(erbschaft_vollstaendig_verteilt(entity_ref("urn:de:bgb:pilot:e06:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
