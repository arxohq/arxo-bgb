language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";


// § 1933 Satz 1: Zur Zeit des Todes lagen die Voraussetzungen fuer die Scheidung
// vor (Wertung des Gerichts, Kanal §47.3) und der Erblasser hatte die Scheidung
// beantragt. Erwartung aus dem Text, vor der Ausfuehrung gerechnet: das Erbrecht
// des ueberlebenden Ehegatten ist ausgeschlossen, das einzige Kind erbt allein.
test "§ 1933 Satz 1: Ausschluss des Ehegattenerbrechts — das Kind erbt allein" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:e:w01:E"), entity_ref("urn:de:bgb:e:w01:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:e:w01:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:e:w01:E"), entity_ref("urn:de:bgb:e:w01:F")) { origin case_input; }
        assert "f4": ehe_beim_erbfall(entity_ref("urn:de:bgb:e:w01:E"), entity_ref("urn:de:bgb:e:w01:EHE")) { origin case_input; }
        assert "f5": de.bgb.ehe::ehegatten(entity_ref("urn:de:bgb:e:w01:EHE"), entity_ref("urn:de:bgb:e:w01:D"), entity_ref("urn:de:bgb:e:w01:S")) { origin case_input; }
        assert "f6": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:w01:E"), entity_ref("urn:de:bgb:e:w01:S")) { origin case_input; }
        assert "f7": de.bgb.ehe::kein_ehevertrag(entity_ref("urn:de:bgb:e:w01:EHE")) { origin case_input; }
        assert "f8": abstammung(entity_ref("urn:de:bgb:e:w01:F"), entity_ref("urn:de:bgb:e:w01:D"), entity_ref("urn:de:bgb:e:w01:K")) { origin case_input; }
        assert "f9": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:w01:E"), entity_ref("urn:de:bgb:e:w01:K")) { origin case_input; }
        assert "f10": voraussetzungen_der_scheidung_lagen_vor(entity_ref("urn:de:bgb:e:w01:EHE")) { origin adjudicated; }
        assert "f11": erblasser_hat_scheidung_beantragt_oder_zugestimmt(entity_ref("urn:de:bgb:e:w01:E")) { origin case_input; }
    }
    evaluate truth(ehegattenerbrecht_ausgeschlossen(entity_ref("urn:de:bgb:e:w01:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesamterbteil(entity_ref("urn:de:bgb:e:w01:E"), entity_ref("urn:de:bgb:e:w01:K"), 1 / 1));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ehegatte_unterhaltsberechtigt_1569_bis_1586b(entity_ref("urn:de:bgb:e:w01:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(nachlass_vollstaendig_verteilt(entity_ref("urn:de:bgb:e:w01:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
