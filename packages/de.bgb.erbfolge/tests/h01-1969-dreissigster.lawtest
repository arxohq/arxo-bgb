language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";


// § 1969 Abs. 1 Satz 1: Der Erbe schuldet den Familienangehoerigen des
// Hausstands fuer die ERSTEN 30 TAGE nach dem Eintritt des Erbfalls Unterhalt
// und die Benutzung der Wohnung. Erbfall am 1. Maerz 2026; der Tag des
// Ereignisses wird nicht mitgerechnet (§ 187 Abs. 1), 30 Tage enden am
// 31. Maerz 2026.
test "§ 1969: der Dreissigste endet 30 Tage nach dem Erbfall" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:e:h01:E"), entity_ref("urn:de:bgb:e:h01:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:e:h01:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:e:h01:E"), entity_ref("urn:de:bgb:e:h01:F")) { origin case_input; }
        assert "f4": abstammung(entity_ref("urn:de:bgb:e:h01:F"), entity_ref("urn:de:bgb:e:h01:D"), entity_ref("urn:de:bgb:e:h01:K")) { origin case_input; }
        assert "f5": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:h01:E"), entity_ref("urn:de:bgb:e:h01:K")) { origin case_input; }
        assert "f6": familienangehoeriger_des_hausstands(entity_ref("urn:de:bgb:e:h01:E"), entity_ref("urn:de:bgb:e:h01:A")) { origin case_input; }
    }
    evaluate truth(dreissigster_ende(entity_ref("urn:de:bgb:e:h01:E"), @2026-03-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(unterhalt_und_wohnung_geschuldet(entity_ref("urn:de:bgb:e:h01:E"), entity_ref("urn:de:bgb:e:h01:A"), @2026-03-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(auf_dreissigsten_gelten_vermaechtnisvorschriften(entity_ref("urn:de:bgb:e:h01:E"), entity_ref("urn:de:bgb:e:h01:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
