language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";


// Kanarienvogel zu g03: eine Stimme weniger. Stimmt nur EIN Kind von dreien zu,
// so sind das 1/3 und damit NICHT mehr als die Haelfte; die Mehrheit des
// § 2038 Abs. 2 mit § 745 Abs. 1 ist nicht erreicht. Die Erhaltungsmassregel
// kann jeder Miterbe allein treffen (Abs. 1 Satz 2 Halbsatz 2) — sie haengt
// nicht von der Mehrheit ab.
test "Kanarienvogel: eine Stimme weniger erreicht die Mehrheit nicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:e:g03b:E"), entity_ref("urn:de:bgb:e:g03b:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:e:g03b:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:e:g03b:E"), entity_ref("urn:de:bgb:e:g03b:F")) { origin case_input; }
        assert "f4": abstammung(entity_ref("urn:de:bgb:e:g03b:F"), entity_ref("urn:de:bgb:e:g03b:D"), entity_ref("urn:de:bgb:e:g03b:K1")) { origin case_input; }
        assert "f5": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:g03b:E"), entity_ref("urn:de:bgb:e:g03b:K1")) { origin case_input; }
        assert "f6": abstammung(entity_ref("urn:de:bgb:e:g03b:F"), entity_ref("urn:de:bgb:e:g03b:D"), entity_ref("urn:de:bgb:e:g03b:K2")) { origin case_input; }
        assert "f7": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:g03b:E"), entity_ref("urn:de:bgb:e:g03b:K2")) { origin case_input; }
        assert "f8": abstammung(entity_ref("urn:de:bgb:e:g03b:F"), entity_ref("urn:de:bgb:e:g03b:D"), entity_ref("urn:de:bgb:e:g03b:K3")) { origin case_input; }
        assert "f9": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:g03b:E"), entity_ref("urn:de:bgb:e:g03b:K3")) { origin case_input; }
        assert "f10": massregel_des_erbfalls(entity_ref("urn:de:bgb:e:g03b:M"), entity_ref("urn:de:bgb:e:g03b:E")) { origin case_input; }
        assert "f11": zustimmung_zur_massregel(entity_ref("urn:de:bgb:e:g03b:M"), entity_ref("urn:de:bgb:e:g03b:K1")) { origin case_input; }
        assert "f12": zur_erhaltung_notwendig(entity_ref("urn:de:bgb:e:g03b:M")) { origin case_input; }
    }
    evaluate truth(alleinmassregel_zulaessig(entity_ref("urn:de:bgb:e:g03b:E"), entity_ref("urn:de:bgb:e:g03b:K1"), entity_ref("urn:de:bgb:e:g03b:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(stimmenmehrheit_fuer_massregel(entity_ref("urn:de:bgb:e:g03b:M")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
