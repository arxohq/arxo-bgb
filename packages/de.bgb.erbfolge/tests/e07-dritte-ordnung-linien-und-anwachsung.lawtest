language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";

// § 1926 Abs. 2–4: Eltern vorverstorben ohne weitere Abkömmlinge; väterliche Linie: Großvater GVv lebt (1/4), Großmutter GMv vorverstorben, an ihre Stelle tritt Onkel O (1/4); mütterliche Linie: beide Großeltern vorverstorben, GVm hat den Abkömmling T (Halbonkel, nur Kind von GVm), GMm keine Abkömmlinge — ihr Anteil fällt dem Stamm GVm zu: T erhält die ganze Hälfte der Linie (1/2).
test "§ 1926 Abs. 3: Linien der Großeltern, Eintritt der Abkömmlinge und Anwachsung im Paar" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:pilot:e07:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:F")) { origin case_input; }
        assert "f10": abstammung(entity_ref("urn:de:bgb:pilot:e07:F"), entity_ref("urn:de:bgb:pilot:e07:M"), entity_ref("urn:de:bgb:pilot:e07:D")) { origin case_input; }
        assert "f11": abstammung(entity_ref("urn:de:bgb:pilot:e07:F"), entity_ref("urn:de:bgb:pilot:e07:V"), entity_ref("urn:de:bgb:pilot:e07:D")) { origin case_input; }
        assert "f12": abstammung(entity_ref("urn:de:bgb:pilot:e07:F"), entity_ref("urn:de:bgb:pilot:e07:GVv"), entity_ref("urn:de:bgb:pilot:e07:V")) { origin case_input; }
        assert "f13": abstammung(entity_ref("urn:de:bgb:pilot:e07:F"), entity_ref("urn:de:bgb:pilot:e07:GMv"), entity_ref("urn:de:bgb:pilot:e07:V")) { origin case_input; }
        assert "f14": abstammung(entity_ref("urn:de:bgb:pilot:e07:F"), entity_ref("urn:de:bgb:pilot:e07:GVv"), entity_ref("urn:de:bgb:pilot:e07:O")) { origin case_input; }
        assert "f15": abstammung(entity_ref("urn:de:bgb:pilot:e07:F"), entity_ref("urn:de:bgb:pilot:e07:GMv"), entity_ref("urn:de:bgb:pilot:e07:O")) { origin case_input; }
        assert "f16": abstammung(entity_ref("urn:de:bgb:pilot:e07:F"), entity_ref("urn:de:bgb:pilot:e07:GVm"), entity_ref("urn:de:bgb:pilot:e07:M")) { origin case_input; }
        assert "f17": abstammung(entity_ref("urn:de:bgb:pilot:e07:F"), entity_ref("urn:de:bgb:pilot:e07:GMm"), entity_ref("urn:de:bgb:pilot:e07:M")) { origin case_input; }
        assert "f18": abstammung(entity_ref("urn:de:bgb:pilot:e07:F"), entity_ref("urn:de:bgb:pilot:e07:GVm"), entity_ref("urn:de:bgb:pilot:e07:T")) { origin case_input; }
        assert "f19": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:GVv")) { origin case_input; }
        assert "f20": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:O")) { origin case_input; }
        assert "f21": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:T")) { origin case_input; }
        assert "f22": vorverstorben(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:M")) { origin case_input; }
        assert "f23": vorverstorben(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:V")) { origin case_input; }
        assert "f24": vorverstorben(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:GMv")) { origin case_input; }
        assert "f25": vorverstorben(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:GVm")) { origin case_input; }
        assert "f26": vorverstorben(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:GMm")) { origin case_input; }
    }
    evaluate truth(berufene_ordnung(entity_ref("urn:de:bgb:pilot:e07:E"), 3));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:GVv"), 1 / 4));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:O"), 1 / 4));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e07:E"), entity_ref("urn:de:bgb:pilot:e07:T"), 1 / 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(erbschaft_vollstaendig_verteilt(entity_ref("urn:de:bgb:pilot:e07:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
