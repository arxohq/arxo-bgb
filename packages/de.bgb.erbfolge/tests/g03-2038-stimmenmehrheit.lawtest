language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";


// § 2038 Abs. 2 Satz 1 mit § 745 Abs. 1: Die Stimmen der Miterben zaehlen nach
// der Groesse ihrer Erbteile. Drei Kinder erben zu gleichen Teilen, also je 1/3;
// stimmen zwei von ihnen zu, so sind das 2/3 und damit MEHR als die Haelfte.
test "§ 2038 Abs. 2: die Mehrheit zaehlt nach der Groesse der Erbteile" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:e:g03:E"), entity_ref("urn:de:bgb:e:g03:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:e:g03:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:e:g03:E"), entity_ref("urn:de:bgb:e:g03:F")) { origin case_input; }
        assert "f4": abstammung(entity_ref("urn:de:bgb:e:g03:F"), entity_ref("urn:de:bgb:e:g03:D"), entity_ref("urn:de:bgb:e:g03:K1")) { origin case_input; }
        assert "f5": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:g03:E"), entity_ref("urn:de:bgb:e:g03:K1")) { origin case_input; }
        assert "f6": abstammung(entity_ref("urn:de:bgb:e:g03:F"), entity_ref("urn:de:bgb:e:g03:D"), entity_ref("urn:de:bgb:e:g03:K2")) { origin case_input; }
        assert "f7": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:g03:E"), entity_ref("urn:de:bgb:e:g03:K2")) { origin case_input; }
        assert "f8": abstammung(entity_ref("urn:de:bgb:e:g03:F"), entity_ref("urn:de:bgb:e:g03:D"), entity_ref("urn:de:bgb:e:g03:K3")) { origin case_input; }
        assert "f9": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:g03:E"), entity_ref("urn:de:bgb:e:g03:K3")) { origin case_input; }
        assert "f10": massregel_des_erbfalls(entity_ref("urn:de:bgb:e:g03:M"), entity_ref("urn:de:bgb:e:g03:E")) { origin case_input; }
        assert "f11": zustimmung_zur_massregel(entity_ref("urn:de:bgb:e:g03:M"), entity_ref("urn:de:bgb:e:g03:K1")) { origin case_input; }
        assert "f12": zustimmung_zur_massregel(entity_ref("urn:de:bgb:e:g03:M"), entity_ref("urn:de:bgb:e:g03:K2")) { origin case_input; }
        assert "f13": zur_ordnungsmaessigen_verwaltung_erforderlich(entity_ref("urn:de:bgb:e:g03:M")) { origin case_input; }
    }
    evaluate truth(verwaltung_steht_gemeinschaftlich_zu(entity_ref("urn:de:bgb:e:g03:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(stimmenmehrheit_fuer_massregel(entity_ref("urn:de:bgb:e:g03:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(mitwirkungspflicht(entity_ref("urn:de:bgb:e:g03:E"), entity_ref("urn:de:bgb:e:g03:K3"), entity_ref("urn:de:bgb:e:g03:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
