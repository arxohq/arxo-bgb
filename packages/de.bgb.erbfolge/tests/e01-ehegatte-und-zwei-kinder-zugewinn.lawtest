language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";

// § 1924 Abs. 4, § 1931 Abs. 1, § 1371 Abs. 1: Ehefrau S (Zugewinngemeinschaft) neben zwei Kindern — S 1/4 + 1/4 = 1/2, C1 und C2 je 1/4 (BMJ „Erben und Vererben“, S. 17: neben Abkömmlingen ein Viertel, erhöht um ein Viertel).
test "§§ 1924, 1931, 1371: Ehegatte bei Zugewinngemeinschaft neben zwei Kindern" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:pilot:e01:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:F")) { origin case_input; }
        assert "f4": ehe_beim_erbfall(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:EHE")) { origin case_input; }
        assert "f5": de.bgb.ehe::ehegatten(entity_ref("urn:de:bgb:pilot:e01:EHE"), entity_ref("urn:de:bgb:pilot:e01:D"), entity_ref("urn:de:bgb:pilot:e01:S")) { origin case_input; }
        assert "f6": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:S")) { origin case_input; }
        assert "f7": de.bgb.ehe::kein_ehevertrag(entity_ref("urn:de:bgb:pilot:e01:EHE")) { origin case_input; }
        assert "f10": abstammung(entity_ref("urn:de:bgb:pilot:e01:F"), entity_ref("urn:de:bgb:pilot:e01:D"), entity_ref("urn:de:bgb:pilot:e01:C1")) { origin case_input; }
        assert "f11": abstammung(entity_ref("urn:de:bgb:pilot:e01:F"), entity_ref("urn:de:bgb:pilot:e01:D"), entity_ref("urn:de:bgb:pilot:e01:C2")) { origin case_input; }
        assert "f12": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:C1")) { origin case_input; }
        assert "f13": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:C2")) { origin case_input; }
    }
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:S"), 1 / 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:C1"), 1 / 4));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:C2"), 1 / 4));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e01:E"), entity_ref("urn:de:bgb:pilot:e01:S"), 1 / 4));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(erbschaft_vollstaendig_verteilt(entity_ref("urn:de:bgb:pilot:e01:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
