language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";

test "§§ 1945, 1954, 1955: Anfechtungspositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1945(entity_ref("urn:erb:e1945"), entity_ref("urn:erb:p1945"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1954(entity_ref("urn:erb:e1954"), entity_ref("urn:erb:p1954"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1955(entity_ref("urn:erb:e1955"), entity_ref("urn:erb:p1955"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(AusschlagungForm1945, ACTIVE); expect position(Anfechtung1954, ACTIVE); expect position(AnfechtungForm1955, ACTIVE);
}

test "§§ 1945, 1954, 1955: Anfechtungspositionen erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1945(entity_ref("urn:erb:e1945"), entity_ref("urn:erb:p1945"), @2026-01-01) { origin case_input; }
 assert "ag": ausschlagung_formgerecht(entity_ref("urn:erb:e1945"), entity_ref("urn:erb:p1945")) { origin case_input; }
 assert "b": position_trigger_1954(entity_ref("urn:erb:e1954"), entity_ref("urn:erb:p1954"), @2026-01-01) { origin case_input; }
 assert "bg": annahme_oder_ausschlagung_anfechtbar(entity_ref("urn:erb:e1954"), entity_ref("urn:erb:p1954")) { origin case_input; }
 assert "c": position_trigger_1955(entity_ref("urn:erb:e1955"), entity_ref("urn:erb:p1955"), @2026-01-01) { origin case_input; }
 assert "cg": anfechtung_formgerecht(entity_ref("urn:erb:e1955"), entity_ref("urn:erb:p1955")) { origin case_input; } }
 evaluate positions();
 expect position(AusschlagungForm1945, ACTIVE); expect position(Anfechtung1954, ACTIVE); expect position(AnfechtungForm1955, SATISFIED);
}
