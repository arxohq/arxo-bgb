language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";


// Kanarienvogel zu w01: dieselbe Lage OHNE den Antrag des Erblassers. § 1933
// verlangt beides — die Voraussetzungen der Scheidung UND den Antrag oder die
// Zustimmung. Faellt der Antrag weg, so bleibt es beim gesetzlichen Erbteil des
// Ehegatten: ein Viertel nach § 1931 Abs. 1 Satz 1, erhoeht um ein Viertel nach
// § 1371 Abs. 1, also die Haelfte; das Kind erhaelt die andere Haelfte.
test "Kanarienvogel: ohne Scheidungsantrag bleibt das Ehegattenerbrecht bestehen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:e:w01b:E"), entity_ref("urn:de:bgb:e:w01b:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:e:w01b:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:e:w01b:E"), entity_ref("urn:de:bgb:e:w01b:F")) { origin case_input; }
        assert "f4": ehe_beim_erbfall(entity_ref("urn:de:bgb:e:w01b:E"), entity_ref("urn:de:bgb:e:w01b:EHE")) { origin case_input; }
        assert "f5": de.bgb.ehe::ehegatten(entity_ref("urn:de:bgb:e:w01b:EHE"), entity_ref("urn:de:bgb:e:w01b:D"), entity_ref("urn:de:bgb:e:w01b:S")) { origin case_input; }
        assert "f6": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:w01b:E"), entity_ref("urn:de:bgb:e:w01b:S")) { origin case_input; }
        assert "f7": de.bgb.ehe::kein_ehevertrag(entity_ref("urn:de:bgb:e:w01b:EHE")) { origin case_input; }
        assert "f8": abstammung(entity_ref("urn:de:bgb:e:w01b:F"), entity_ref("urn:de:bgb:e:w01b:D"), entity_ref("urn:de:bgb:e:w01b:K")) { origin case_input; }
        assert "f9": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:w01b:E"), entity_ref("urn:de:bgb:e:w01b:K")) { origin case_input; }
        assert "f10": voraussetzungen_der_scheidung_lagen_vor(entity_ref("urn:de:bgb:e:w01b:EHE")) { origin adjudicated; }
    }
    evaluate truth(gesamterbteil(entity_ref("urn:de:bgb:e:w01b:E"), entity_ref("urn:de:bgb:e:w01b:S"), 1 / 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesamterbteil(entity_ref("urn:de:bgb:e:w01b:E"), entity_ref("urn:de:bgb:e:w01b:K"), 1 / 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(nachlass_vollstaendig_verteilt(entity_ref("urn:de:bgb:e:w01b:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
