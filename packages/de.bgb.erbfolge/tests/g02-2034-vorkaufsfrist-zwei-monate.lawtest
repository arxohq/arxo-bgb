language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";


// § 2034: Verkauft ein Miterbe seinen Anteil an einen Dritten, so sind die
// uebrigen Miterben zum Vorkauf berechtigt; die Frist fuer die Ausuebung
// betraegt ZWEI MONATE. Mitteilung des Kaufvertrags am Sonnabend, dem
// 7. Maerz 2026; zwei Monate enden nach § 188 Abs. 2 am Donnerstag, dem
// 7. Mai 2026, einem Werktag, so dass § 193 nichts verschiebt.
test "§ 2034 Abs. 2: die Vorkaufsfrist betraegt zwei Monate" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:e:g02:E"), entity_ref("urn:de:bgb:e:g02:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:e:g02:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:e:g02:E"), entity_ref("urn:de:bgb:e:g02:F")) { origin case_input; }
        assert "f4": abstammung(entity_ref("urn:de:bgb:e:g02:F"), entity_ref("urn:de:bgb:e:g02:D"), entity_ref("urn:de:bgb:e:g02:K1")) { origin case_input; }
        assert "f5": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:g02:E"), entity_ref("urn:de:bgb:e:g02:K1")) { origin case_input; }
        assert "f6": abstammung(entity_ref("urn:de:bgb:e:g02:F"), entity_ref("urn:de:bgb:e:g02:D"), entity_ref("urn:de:bgb:e:g02:K2")) { origin case_input; }
        assert "f7": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:g02:E"), entity_ref("urn:de:bgb:e:g02:K2")) { origin case_input; }
        assert "f8": anteil_verkauft(entity_ref("urn:de:bgb:e:g02:V"), entity_ref("urn:de:bgb:e:g02:E"), entity_ref("urn:de:bgb:e:g02:K1"), entity_ref("urn:de:bgb:e:g02:X")) { origin case_input; }
        assert "f9": kaufvertrag_mitgeteilt_am(entity_ref("urn:de:bgb:e:g02:V"), @2026-03-07) { origin case_input; }
    }
    evaluate truth(vorkaufsberechtigt(entity_ref("urn:de:bgb:e:g02:V"), entity_ref("urn:de:bgb:e:g02:K2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(vorkaufsfrist_ende(entity_ref("urn:de:bgb:e:g02:V"), @2026-05-07));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(vorkaufsrecht_vererblich(entity_ref("urn:de:bgb:e:g02:V"), entity_ref("urn:de:bgb:e:g02:K2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
