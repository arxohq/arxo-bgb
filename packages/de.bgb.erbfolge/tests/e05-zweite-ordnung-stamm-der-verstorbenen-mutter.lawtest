language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";

// § 1925 Abs. 2, 3: kein Ehegatte, keine Abkömmlinge; Vater V lebt (1/2); an die Stelle der vorverstorbenen Mutter M treten ihre Abkömmlinge: Bruder B (1/4) und der Stamm des vorverstorbenen Bruders B2 mit Neffe N (1/4).
test "§ 1925 Abs. 3 Satz 1: Stamm der vorverstorbenen Mutter neben dem lebenden Vater" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:pilot:e05:E"), entity_ref("urn:de:bgb:pilot:e05:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:pilot:e05:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:pilot:e05:E"), entity_ref("urn:de:bgb:pilot:e05:F")) { origin case_input; }
        assert "f10": abstammung(entity_ref("urn:de:bgb:pilot:e05:F"), entity_ref("urn:de:bgb:pilot:e05:M"), entity_ref("urn:de:bgb:pilot:e05:D")) { origin case_input; }
        assert "f11": abstammung(entity_ref("urn:de:bgb:pilot:e05:F"), entity_ref("urn:de:bgb:pilot:e05:V"), entity_ref("urn:de:bgb:pilot:e05:D")) { origin case_input; }
        assert "f12": abstammung(entity_ref("urn:de:bgb:pilot:e05:F"), entity_ref("urn:de:bgb:pilot:e05:M"), entity_ref("urn:de:bgb:pilot:e05:B")) { origin case_input; }
        assert "f13": abstammung(entity_ref("urn:de:bgb:pilot:e05:F"), entity_ref("urn:de:bgb:pilot:e05:V"), entity_ref("urn:de:bgb:pilot:e05:B")) { origin case_input; }
        assert "f14": abstammung(entity_ref("urn:de:bgb:pilot:e05:F"), entity_ref("urn:de:bgb:pilot:e05:M"), entity_ref("urn:de:bgb:pilot:e05:B2")) { origin case_input; }
        assert "f15": abstammung(entity_ref("urn:de:bgb:pilot:e05:F"), entity_ref("urn:de:bgb:pilot:e05:V"), entity_ref("urn:de:bgb:pilot:e05:B2")) { origin case_input; }
        assert "f16": abstammung(entity_ref("urn:de:bgb:pilot:e05:F"), entity_ref("urn:de:bgb:pilot:e05:B2"), entity_ref("urn:de:bgb:pilot:e05:N")) { origin case_input; }
        assert "f17": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e05:E"), entity_ref("urn:de:bgb:pilot:e05:V")) { origin case_input; }
        assert "f18": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e05:E"), entity_ref("urn:de:bgb:pilot:e05:B")) { origin case_input; }
        assert "f19": lebt_beim_erbfall(entity_ref("urn:de:bgb:pilot:e05:E"), entity_ref("urn:de:bgb:pilot:e05:N")) { origin case_input; }
        assert "f20": vorverstorben(entity_ref("urn:de:bgb:pilot:e05:E"), entity_ref("urn:de:bgb:pilot:e05:M")) { origin case_input; }
        assert "f21": vorverstorben(entity_ref("urn:de:bgb:pilot:e05:E"), entity_ref("urn:de:bgb:pilot:e05:B2")) { origin case_input; }
    }
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e05:E"), entity_ref("urn:de:bgb:pilot:e05:V"), 1 / 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e05:E"), entity_ref("urn:de:bgb:pilot:e05:B"), 1 / 4));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e05:E"), entity_ref("urn:de:bgb:pilot:e05:N"), 1 / 4));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesetzlicher_erbteil(entity_ref("urn:de:bgb:pilot:e05:E"), entity_ref("urn:de:bgb:pilot:e05:B2"), 1 / 4));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(erbschaft_vollstaendig_verteilt(entity_ref("urn:de:bgb:pilot:e05:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
