language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";


// § 1974 Abs. 1 Satz 1: Ein Nachlassglaeubiger, der seine Forderung SPAETER als
// fuenf Jahre nach dem Erbfall geltend macht, steht einem ausgeschlossenen
// Glaeubiger gleich. Erbfall am 1. Maerz 2026, fuenf Jahre enden nach § 188
// Abs. 2 am 1. Maerz 2031; die Forderung wird erst am 1. April 2031 geltend
// gemacht, ist dem Erben vorher nicht bekannt geworden und war im Aufgebot
// nicht angemeldet. Der Nachlass ist durch die uebrigen Glaeubiger erschoepft,
// daher kann der Erbe die Befriedigung verweigern (§ 1973 Abs. 1 Satz 1).
test "§ 1974 Abs. 1: die Forderung nach fuenf Jahren steht dem Ausschluss gleich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_ERBFOLGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erblasser(entity_ref("urn:de:bgb:e:h02:E"), entity_ref("urn:de:bgb:e:h02:D")) { origin case_input; }
        assert "f2": erbfall_am(entity_ref("urn:de:bgb:e:h02:E"), @2026-03-01) { origin case_input; }
        assert "f3": familie(entity_ref("urn:de:bgb:e:h02:E"), entity_ref("urn:de:bgb:e:h02:F")) { origin case_input; }
        assert "f4": abstammung(entity_ref("urn:de:bgb:e:h02:F"), entity_ref("urn:de:bgb:e:h02:D"), entity_ref("urn:de:bgb:e:h02:K")) { origin case_input; }
        assert "f5": lebt_beim_erbfall(entity_ref("urn:de:bgb:e:h02:E"), entity_ref("urn:de:bgb:e:h02:K")) { origin case_input; }
        assert "f6": verbindlichkeit_des_erbfalls(entity_ref("urn:de:bgb:e:h02:V"), entity_ref("urn:de:bgb:e:h02:E")) { origin case_input; }
        assert "f7": glaeubiger(entity_ref("urn:de:bgb:e:h02:V"), entity_ref("urn:de:bgb:e:h02:G")) { origin case_input; }
        assert "f8": vom_erblasser_herruehrende_schuld(entity_ref("urn:de:bgb:e:h02:V")) { origin case_input; }
        assert "f9": forderung_geltend_gemacht_am(entity_ref("urn:de:bgb:e:h02:V"), @2031-04-01) { origin case_input; }
        assert "f10": nachlass_durch_nicht_ausgeschlossene_erschoepft(entity_ref("urn:de:bgb:e:h02:E")) { origin case_input; }
    }
    evaluate truth(verschweigungsfrist_ende(entity_ref("urn:de:bgb:e:h02:E"), @2031-03-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(steht_ausgeschlossenem_glaeubiger_gleich(entity_ref("urn:de:bgb:e:h02:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(befriedigung_verweigerbar(entity_ref("urn:de:bgb:e:h02:E"), entity_ref("urn:de:bgb:e:h02:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
