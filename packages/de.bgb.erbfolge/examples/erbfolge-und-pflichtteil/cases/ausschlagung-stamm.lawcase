language "law.core" version "0.2";
package examples.de.bgb.erbfolge_und_pflichtteil version "0.1.0";
namespace "urn:law:examples:de:bgb:erbfolge-und-pflichtteil";

case AusschlagungStamm {
    context {
        deadline_policy examples.de.bgb.erbfolge_und_pflichtteil::BGB_ERBFOLGE_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-17;
        knowledge_time @2026-09-17T09:00:00Z;
        decision_time @2026-09-17T09:00:00Z;
        timezone "Europe/Berlin";
    }
    assert "erblasser": de.bgb.erbfolge::erblasser(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:D")) { origin case_input; }
    assert "tag": de.bgb.erbfolge::erbfall_am(entity_ref("urn:de:bgb:p2:E"), @2026-03-01) { origin case_input; }
    assert "familie": de.bgb.erbfolge::familie(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:F")) { origin case_input; }
    assert "d-c1": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:p2:F"), entity_ref("urn:de:bgb:p2:D"), entity_ref("urn:de:bgb:p2:C1")) { origin case_input; }
    assert "d-c2": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:p2:F"), entity_ref("urn:de:bgb:p2:D"), entity_ref("urn:de:bgb:p2:C2")) { origin case_input; }
    assert "c1-g1": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:p2:F"), entity_ref("urn:de:bgb:p2:C1"), entity_ref("urn:de:bgb:p2:G1")) { origin case_input; }
    assert "lebt-c1": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:C1")) { origin case_input; }
    assert "lebt-c2": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:C2")) { origin case_input; }
    assert "lebt-g1": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:G1")) { origin case_input; }
    assert "kenntnis": de.bgb.erbfolge::kenntnis_von_anfall_und_grund_am(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:C1"), @2026-03-05) { origin case_input; }
    assert "keine-hemmung": de.bgb.erbfolge::keine_hemmung_der_ausschlagungsfrist(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:C1")) { origin case_input; }
    assert "form": de.bgb.erbfolge::erklaerung_in_oeffentlich_beglaubigter_form(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:C1")) { origin case_input; }
    assert "erklaert": de.bgb.erbfolge::ausschlagung_erklaert_am(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:C1"), @2026-04-10) { origin case_input; }
}
