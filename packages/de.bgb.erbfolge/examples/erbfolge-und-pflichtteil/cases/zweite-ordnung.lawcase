language "law.core" version "0.2";
package examples.de.bgb.erbfolge_und_pflichtteil version "0.1.0";
namespace "urn:law:examples:de:bgb:erbfolge-und-pflichtteil";

case ZweiteOrdnung {
    context {
        deadline_policy examples.de.bgb.erbfolge_und_pflichtteil::BGB_ERBFOLGE_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-17;
        knowledge_time @2026-09-17T09:00:00Z;
        decision_time @2026-09-17T09:00:00Z;
        timezone "Europe/Berlin";
    }
    assert "erblasser": de.bgb.erbfolge::erblasser(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:D")) { origin case_input; }
    assert "tag": de.bgb.erbfolge::erbfall_am(entity_ref("urn:de:bgb:p2:E"), @2026-03-01) { origin case_input; }
    assert "familie": de.bgb.erbfolge::familie(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:F")) { origin case_input; }
    assert "m-d": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:p2:F"), entity_ref("urn:de:bgb:p2:M"), entity_ref("urn:de:bgb:p2:D")) { origin case_input; }
    assert "v-d": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:p2:F"), entity_ref("urn:de:bgb:p2:V"), entity_ref("urn:de:bgb:p2:D")) { origin case_input; }
    assert "m-b": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:p2:F"), entity_ref("urn:de:bgb:p2:M"), entity_ref("urn:de:bgb:p2:B")) { origin case_input; }
    assert "v-b": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:p2:F"), entity_ref("urn:de:bgb:p2:V"), entity_ref("urn:de:bgb:p2:B")) { origin case_input; }
    assert "m-b2": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:p2:F"), entity_ref("urn:de:bgb:p2:M"), entity_ref("urn:de:bgb:p2:B2")) { origin case_input; }
    assert "v-b2": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:p2:F"), entity_ref("urn:de:bgb:p2:V"), entity_ref("urn:de:bgb:p2:B2")) { origin case_input; }
    assert "b2-n": de.bgb.erbfolge::abstammung(entity_ref("urn:de:bgb:p2:F"), entity_ref("urn:de:bgb:p2:B2"), entity_ref("urn:de:bgb:p2:N")) { origin case_input; }
    assert "lebt-v": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:V")) { origin case_input; }
    assert "lebt-b": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:B")) { origin case_input; }
    assert "lebt-n": de.bgb.erbfolge::lebt_beim_erbfall(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:N")) { origin case_input; }
    assert "vor-m": de.bgb.erbfolge::vorverstorben(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:M")) { origin case_input; }
    assert "vor-b2": de.bgb.erbfolge::vorverstorben(entity_ref("urn:de:bgb:p2:E"), entity_ref("urn:de:bgb:p2:B2")) { origin case_input; }
}
