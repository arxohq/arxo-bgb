language "law.core" version "0.2";
package examples.de.bgb.erbfolge_und_pflichtteil version "0.1.0";
namespace "urn:law:examples:de:bgb:erbfolge-und-pflichtteil";

import de.bgb.erbfolge version "0.1.0";
import de.bgb.verfuegungen version "0.1.0";
import de.bgb.ehe version "0.1.0";
import de.bgb.core version "0.1.0";
import de.bgb.fristen version "0.1.0";
import calc.kinship version "0.1.0";

// Case packages resolve deadline policies locally (§86/§168.2). Parameters
// repeat BGB_ERBFOLGE_KALENDER: same-day start, end included, no roll
// (§ 193 is computed in the canon, not by a policy roll).
deadline policy BGB_ERBFOLGE_KALENDER {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

// EIGHT FILES. No norm is written here.
//
// Statutory shares as exact fractions; the compulsory portion as money.
// Partition of the estate is not computed. The BMJ brochure is an external
// check (e04, p01), not reproduced.
