// BÜRGERLICHES GESETZBUCH, BUCH 5 ABSCHNITT 2 TITEL 3 — ERBSCHAFTSANSPRUCH
// (§§ 2018–2031).
//
// Der Titel führt EINEN Träger: den Erbschaftsbesitzer, also den, der auf
// Grund eines ihm in Wirklichkeit nicht zustehenden Erbrechts etwas aus der
// Erbschaft erlangt hat (§ 2018). Die Verweisungen auf fremde Regelwerke —
// §§ 406–408 (Abtretung), §§ 812 ff. (Bereicherung), §§ 987 ff. und
// §§ 1000–1003 (Eigentümer-Besitzer-Verhältnis), §§ 823 ff. (unerlaubte
// Handlung) — werden NICHT nachgebaut: sie stehen bei BG-04, BG-09 und
// BG-10. Dieses Paket stellt fest, WELCHES Regime gilt; die Rechtsfolge
// selbst bleibt beim Eigentümerpaket (SOURCES.json.external).

language "law.core" version "0.2";
package de.bgb.erbfolge version "0.1.0";
namespace "urn:de:corpus:clir:bgb-erbfolge";

pub relation erbschaftsbesitz_erlangt(e: Erbfall, besitzer: Person) kind empirical {
    label de official "Die Person hat auf Grund eines ihr in Wirklichkeit nicht zustehenden Erbrechts etwas aus der Erbschaft erlangt (§ 2018)";
    label en unofficial "The person obtained something from the estate on the basis of a right of succession not actually vested in him (§ 2018)";
}
pub relation erbschaftsbesitzer(e: Erbfall, besitzer: Person) kind institutional {
    label de official "Erbschaftsbesitzer (§ 2018); ihm gleich steht, wer die Erbschaft durch Vertrag von einem Erbschaftsbesitzer erwirbt (§ 2030)";
    label en unofficial "possessor of the estate (§ 2018); a person acquiring the estate by contract from him is treated alike (§ 2030)";
}
pub relation herausgabeanspruch_des_erben(e: Erbfall, erbe: Person, besitzer: Person) kind institutional {
    label de official "Der Erbe kann von dem Erbschaftsbesitzer die Herausgabe des Erlangten verlangen (§ 2018)";
    label en unofficial "The heir may demand from the possessor of the estate the surrender of what he obtained (§ 2018)";
}
pub relation mit_mitteln_der_erbschaft_erworben(e: Erbfall, besitzer: Person, g: Nachlassgegenstand) kind empirical {
    label de official "Der Erbschaftsbesitzer hat den Gegenstand durch Rechtsgeschäft mit Mitteln der Erbschaft erworben (§ 2019 Abs. 1)";
    label en unofficial "The possessor acquired the object by legal transaction with means of the estate (§ 2019 (1))";
}
pub relation gilt_als_aus_der_erbschaft_erlangt(e: Erbfall, besitzer: Person, g: Nachlassgegenstand) kind institutional {
    label de official "Als aus der Erbschaft erlangt gilt auch, was der Erbschaftsbesitzer durch Rechtsgeschäft mit Mitteln der Erbschaft erwirbt (§ 2019 Abs. 1)";
    label en unofficial "What the possessor acquires by transaction with means of the estate also counts as obtained from the estate (§ 2019 (1))";
}
pub relation schuldner_kennt_die_zugehoerigkeit(e: Erbfall, schuldner: Person) kind empirical {
    label de official "Der Schuldner hat von der Zugehörigkeit der Forderung zur Erbschaft Kenntnis erlangt (§ 2019 Abs. 2)";
    label en unofficial "The debtor has learned that the claim belongs to the estate (§ 2019 (2))";
}
pub relation zugehoerigkeit_gegen_den_schuldner_wirksam(e: Erbfall, schuldner: Person) kind institutional {
    label de official "Der Schuldner hat die Zugehörigkeit der Forderung zur Erbschaft gegen sich gelten zu lassen; die §§ 406 bis 408 finden entsprechende Anwendung (§ 2019 Abs. 2)";
    label en unofficial "The debtor must accept that the claim belongs to the estate; §§ 406 to 408 apply accordingly (§ 2019 (2))";
}
pub relation nutzungen_gezogen(e: Erbfall, besitzer: Person) kind empirical {
    label de official "Der Erbschaftsbesitzer hat Nutzungen gezogen; dazu gehören auch Früchte, an denen er das Eigentum erworben hat (§ 2020)";
    label en unofficial "The possessor has taken benefits; these include fruits of which he acquired ownership (§ 2020)";
}
pub relation nutzungen_herauszugeben(e: Erbfall, erbe: Person, besitzer: Person) kind institutional {
    label de official "Der Erbschaftsbesitzer hat dem Erben die gezogenen Nutzungen herauszugeben (§ 2020)";
    label en unofficial "The possessor must surrender the benefits taken to the heir (§ 2020)";
}
pub relation zur_herausgabe_ausserstande(e: Erbfall, besitzer: Person) kind empirical {
    label de official "Der Erbschaftsbesitzer ist zur Herausgabe außerstande (§ 2021)";
    label en unofficial "The possessor is unable to surrender (§ 2021)";
}
pub relation haftung_nach_bereicherungsrecht(e: Erbfall, besitzer: Person) kind institutional {
    label de official "Soweit der Erbschaftsbesitzer zur Herausgabe außerstande ist, bestimmt sich seine Verpflichtung nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung (§ 2021) — Rechtsfolge bei de.bgb.bereicherung_delikt";
    label en unofficial "To the extent the possessor cannot surrender, his duty follows the rules on unjust enrichment (§ 2021) — legal consequence in de.bgb.bereicherung_delikt";
}
pub relation verwendungen_gemacht(e: Erbfall, besitzer: Person, betrag: Money) kind empirical {
    key(e, besitzer);
    label de official "Verwendungen des Erbschaftsbesitzers, einschließlich der Aufwendungen zur Bestreitung von Lasten der Erbschaft oder zur Berichtigung von Nachlassverbindlichkeiten (§ 2022 Abs. 1, 2)";
    label en unofficial "outlays of the possessor, including expenses to bear charges of the estate or to discharge its liabilities (§ 2022 (1), (2))";
}
pub relation herausgabe_nur_gegen_verwendungsersatz(e: Erbfall, besitzer: Person, betrag: Money) kind institutional {
    key(e, besitzer);
    label de official "Der Erbschaftsbesitzer ist zur Herausgabe der zur Erbschaft gehörenden Sachen nur gegen Ersatz aller Verwendungen verpflichtet; die §§ 1000 bis 1003 finden Anwendung (§ 2022 Abs. 1)";
    label en unofficial "The possessor must surrender the estate's things only against reimbursement of all outlays; §§ 1000 to 1003 apply (§ 2022 (1))";
}
pub relation rechtshaengigkeit_eingetreten(e: Erbfall, besitzer: Person) kind empirical {
    label de official "Die Rechtshängigkeit des Erbschaftsanspruchs ist eingetreten (§ 2023 Abs. 1)";
    label en unofficial "The claim to the estate has become pending (§ 2023 (1))";
}
pub relation haftung_nach_eigentuemer_besitzer_verhaeltnis(e: Erbfall, besitzer: Person) kind institutional {
    label de official "Von dem Eintritt der Rechtshängigkeit an bestimmt sich der Anspruch des Erben nach den Vorschriften, die für das Verhältnis zwischen dem Eigentümer und dem Besitzer von dem Eintritt der Rechtshängigkeit des Eigentumsanspruchs an gelten (§ 2023 Abs. 1, 2) — Rechtsfolge bei de.bgb.besitz_eigentum";
    label en unofficial "From the moment of pendency the heir's claim follows the rules applying between owner and possessor from pendency of the vindication (§ 2023 (1), (2)) — legal consequence in de.bgb.besitz_eigentum";
}
pub relation bei_besitzerwerb_nicht_in_gutem_glauben(e: Erbfall, besitzer: Person) kind empirical {
    label de official "Der Erbschaftsbesitzer ist bei dem Beginn des Erbschaftsbesitzes nicht in gutem Glauben (§ 2024 Satz 1)";
    label en unofficial "The possessor is not in good faith at the beginning of his possession of the estate (§ 2024 sentence 1)";
}
pub relation spaeter_kenntnis_erlangt(e: Erbfall, besitzer: Person) kind empirical {
    label de official "Der Erbschaftsbesitzer erfährt später, dass er nicht Erbe ist (§ 2024 Satz 2)";
    label en unofficial "The possessor later learns that he is not the heir (§ 2024 sentence 2)";
}
pub relation durch_straftat_oder_verbotene_eigenmacht_erlangt(e: Erbfall, besitzer: Person) kind empirical {
    label de official "Der Erbschaftsbesitzer hat einen Erbschaftsgegenstand durch eine Straftat oder eine zur Erbschaft gehörende Sache durch verbotene Eigenmacht erlangt (§ 2025 Satz 1)";
    label en unofficial "The possessor obtained an object of the estate by a criminal offence or a thing of the estate by unlawful interference (§ 2025 sentence 1)";
}
pub relation haftung_nach_deliktsrecht(e: Erbfall, besitzer: Person) kind institutional {
    label de official "Der Erbschaftsbesitzer haftet nach den Vorschriften über den Schadensersatz wegen unerlaubter Handlungen (§ 2025 Satz 1) — Rechtsfolge bei de.bgb.bereicherung_delikt";
    label en unofficial "The possessor is liable under the rules on damages for torts (§ 2025 sentence 1) — legal consequence in de.bgb.bereicherung_delikt";
}
pub relation erbschaftsanspruch_verjaehrt(e: Erbfall, besitzer: Person) kind empirical {
    label de official "Der Erbschaftsanspruch ist verjährt (§ 2026; Verjährung nach §§ 195, 199 bei de.bgb.fristen)";
    label en unofficial "The claim to the estate is time-barred (§ 2026; limitation under §§ 195, 199 in de.bgb.fristen)";
}
pub relation berufung_auf_ersitzung_ausgeschlossen(e: Erbfall, besitzer: Person) kind institutional {
    label de official "Der Erbschaftsbesitzer kann sich dem Erben gegenüber, solange nicht der Erbschaftsanspruch verjährt ist, nicht auf die Ersitzung einer Sache berufen, die er als zur Erbschaft gehörend im Besitz hat (§ 2026)";
    label en unofficial "The possessor cannot, as long as the claim is not time-barred, rely on acquisitive prescription of a thing he possesses as belonging to the estate (§ 2026)";
}
pub relation auskunftspflicht_des_erbschaftsbesitzers(e: Erbfall, besitzer: Person) kind institutional {
    label de official "Der Erbschaftsbesitzer ist verpflichtet, dem Erben über den Bestand der Erbschaft und über den Verbleib der Erbschaftsgegenstände Auskunft zu erteilen (§ 2027 Abs. 1)";
    label en unofficial "The possessor must inform the heir about the composition of the estate and the whereabouts of its objects (§ 2027 (1))";
}
pub relation sache_vor_besitzergreifung_des_erben_genommen(e: Erbfall, wer: Person) kind empirical {
    label de official "Die Person hat, ohne Erbschaftsbesitzer zu sein, eine Sache aus dem Nachlass in Besitz genommen, bevor der Erbe den Besitz tatsächlich ergriffen hat (§ 2027 Abs. 2)";
    label en unofficial "The person, without being a possessor of the estate, took possession of a thing from the estate before the heir actually took possession (§ 2027 (2))";
}
pub relation haeusliche_gemeinschaft_beim_erbfall(e: Erbfall, wer: Person) kind empirical {
    label de official "Die Person hat sich zur Zeit des Erbfalls mit dem Erblasser in häuslicher Gemeinschaft befunden (§ 2028 Abs. 1)";
    label en unofficial "The person lived in domestic community with the decedent at the devolution (§ 2028 (1))";
}
pub relation auskunftspflicht_des_hausgenossen(e: Erbfall, wer: Person) kind institutional {
    label de official "Der Hausgenosse ist verpflichtet, dem Erben auf Verlangen Auskunft darüber zu erteilen, welche erbschaftlichen Geschäfte er geführt hat und was ihm über den Verbleib der Erbschaftsgegenstände bekannt ist (§ 2028 Abs. 1)";
    label en unofficial "The member of the household must on demand inform the heir which business of the estate he conducted and what he knows about the whereabouts of its objects (§ 2028 (1))";
}
pub external judgment relation auskunft_nicht_mit_erforderlicher_sorgfalt_erteilt(wer: Person, e: Erbfall) {
    authority Court;
    label de official "Es besteht Grund zu der Annahme, dass die Auskunft nicht mit der erforderlichen Sorgfalt erteilt worden ist (§ 2028 Abs. 2) — Wertung, Kanal §47.3";
    label en unofficial "There is reason to assume the information was not given with the required care (§ 2028 (2)) — evaluative standard, channel §47.3";
}
pub relation eidesstattliche_versicherung_des_hausgenossen(e: Erbfall, wer: Person) kind institutional {
    label de official "Der Verpflichtete hat auf Verlangen des Erben zu Protokoll an Eides statt zu versichern, dass er seine Angaben nach bestem Wissen so vollständig gemacht habe, als er dazu imstande sei (§ 2028 Abs. 2)";
    label en unofficial "On the heir's demand the obliged person must affirm in lieu of oath that he gave his statements as completely as he could (§ 2028 (2))";
}
pub relation einzelanspruch_des_erben(e: Erbfall, erbe: Person, besitzer: Person) kind empirical {
    label de official "Dem Erben steht ein Anspruch in Ansehung eines einzelnen Erbschaftsgegenstands zu (§ 2029)";
    label en unofficial "The heir has a claim in respect of a single object of the estate (§ 2029)";
}
pub relation haftung_nach_erbschaftsanspruchsregeln(e: Erbfall, besitzer: Person) kind institutional {
    label de official "Die Haftung des Erbschaftsbesitzers bestimmt sich auch gegenüber den Einzelansprüchen nach den Vorschriften über den Erbschaftsanspruch (§ 2029)";
    label en unofficial "The possessor's liability also follows the rules on the claim to the estate as regards individual claims (§ 2029)";
}
pub relation erbschaft_vom_besitzer_erworben(e: Erbfall, erwerber: Person) kind empirical {
    label de official "Die Person hat die Erbschaft durch Vertrag von einem Erbschaftsbesitzer erworben (§ 2030)";
    label en unofficial "The person acquired the estate by contract from a possessor of the estate (§ 2030)";
}
pub relation fuer_tot_erklaert(e: Erbfall, p: Person) kind empirical {
    label de official "Die Person ist für tot erklärt oder ihre Todeszeit ist nach den Vorschriften des Verschollenheitsgesetzes festgestellt, und sie überlebt den Zeitpunkt, der als Zeitpunkt ihres Todes gilt (§ 2031 Abs. 1 Satz 1, Abs. 2)";
    label en unofficial "The person was declared dead or the time of death established under the Missing Persons Act, and she survives the moment deemed her death (§ 2031 (1) sentence 1, (2))";
}
pub relation kenntnis_von_der_todeserklaerung_am(e: Erbfall, p: Person, tag: Date) kind empirical {
    key(e, p);
    label de official "Zeitpunkt, in welchem die für tot Erklärte von der Todeserklärung oder der Feststellung der Todeszeit Kenntnis erlangt (§ 2031 Abs. 1 Satz 2)";
    label en unofficial "time at which the person declared dead learns of the declaration or the establishment of the time of death (§ 2031 (1) sentence 2)";
}
pub relation herausgabeanspruch_des_fuer_tot_erklaerten(e: Erbfall, p: Person) kind institutional {
    label de official "Die für tot Erklärte kann die Herausgabe ihres Vermögens nach den für den Erbschaftsanspruch geltenden Vorschriften verlangen (§ 2031 Abs. 1 Satz 1)";
    label en unofficial "The person declared dead may demand restitution of her property under the rules on the claim to the estate (§ 2031 (1) sentence 1)";
}
pub relation verjaehrung_nicht_vor_jahresablauf(e: Erbfall, p: Person, tag: Date) kind derived {
    key(e, p);
    label de official "Solange sie noch lebt, wird die Verjährung ihres Anspruchs nicht vor dem Ablauf eines Jahres nach der Kenntniserlangung vollendet (§ 2031 Abs. 1 Satz 2)";
    label en unofficial "As long as she is alive, limitation of her claim is not completed before one year after she obtained knowledge (§ 2031 (1) sentence 2)";
}

@source(BGB_P2018) {
    rule Erbschaftsbesitzer(e: Erbfall, besitzer: Person) strict {
        label de official "Erbschaftsbesitzer ist, wer auf Grund eines ihm in Wirklichkeit nicht zustehenden Erbrechts etwas aus der Erbschaft erlangt hat (§ 2018)";
        label en unofficial "A possessor of the estate is a person who obtained something from it on the basis of a right of succession not actually vested in him (§ 2018)";
        when erbschaftsbesitz_erlangt(e, besitzer);
        then erbschaftsbesitzer(e, besitzer);
    }
    rule HerausgabeDesErlangten(e: Erbfall, erbe: Person, besitzer: Person) strict {
        label de official "Der Erbe kann von jedem Erbschaftsbesitzer die Herausgabe des Erlangten verlangen (§ 2018)";
        label en unofficial "The heir may demand from any possessor of the estate the surrender of what he obtained (§ 2018)";
        when erbschaft_angefallen(e, erbe) and erbschaftsbesitzer(e, besitzer) and erbe != besitzer;
        then herausgabeanspruch_des_erben(e, erbe, besitzer);
    }
}

@source(BGB_P2019) {
    rule UnmittelbareErsetzung(e: Erbfall, besitzer: Person, g: Nachlassgegenstand) strict {
        label de official "Als aus der Erbschaft erlangt gilt auch, was der Erbschaftsbesitzer durch Rechtsgeschäft mit Mitteln der Erbschaft erwirbt (§ 2019 Abs. 1)";
        label en unofficial "What the possessor acquires by transaction with means of the estate also counts as obtained from it (§ 2019 (1))";
        when erbschaftsbesitzer(e, besitzer) and mit_mitteln_der_erbschaft_erworben(e, besitzer, g);
        then gilt_als_aus_der_erbschaft_erlangt(e, besitzer, g);
    }
    rule ZugehoerigkeitGegenDenSchuldner(e: Erbfall, schuldner: Person) strict {
        label de official "Die Zugehörigkeit einer so erworbenen Forderung zur Erbschaft hat der Schuldner erst dann gegen sich gelten zu lassen, wenn er von der Zugehörigkeit Kenntnis erlangt; die §§ 406 bis 408 finden entsprechende Anwendung (§ 2019 Abs. 2)";
        label en unofficial "The debtor must accept that such an acquired claim belongs to the estate only once he learns of it; §§ 406 to 408 apply accordingly (§ 2019 (2))";
        when schuldner_kennt_die_zugehoerigkeit(e, schuldner);
        then zugehoerigkeit_gegen_den_schuldner_wirksam(e, schuldner);
    }
}

@source(BGB_P2020)
rule NutzungenHerauszugeben(e: Erbfall, erbe: Person, besitzer: Person) strict {
    label de official "Der Erbschaftsbesitzer hat dem Erben die gezogenen Nutzungen herauszugeben; die Verpflichtung erstreckt sich auch auf Früchte, an denen er das Eigentum erworben hat (§ 2020)";
    label en unofficial "The possessor must surrender to the heir the benefits taken; the duty extends to fruits of which he acquired ownership (§ 2020)";
    when herausgabeanspruch_des_erben(e, erbe, besitzer) and nutzungen_gezogen(e, besitzer);
    then nutzungen_herauszugeben(e, erbe, besitzer);
}

@source(BGB_P2021)
rule HaftungNachBereicherungsrecht(e: Erbfall, besitzer: Person) strict {
    label de official "Soweit der Erbschaftsbesitzer zur Herausgabe außerstande ist, bestimmt sich seine Verpflichtung nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung (§ 2021)";
    label en unofficial "To the extent the possessor cannot surrender, his duty follows the rules on unjust enrichment (§ 2021)";
    when erbschaftsbesitzer(e, besitzer) and zur_herausgabe_ausserstande(e, besitzer);
    then haftung_nach_bereicherungsrecht(e, besitzer);
}

@source(BGB_P2022)
rule VerwendungsersatzZugUmZug(e: Erbfall, besitzer: Person, betrag: Money) strict {
    label de official "Der Erbschaftsbesitzer ist zur Herausgabe der zur Erbschaft gehörenden Sachen nur gegen Ersatz aller Verwendungen verpflichtet, soweit sie nicht durch Anrechnung auf die nach § 2021 herauszugebende Bereicherung gedeckt werden; die §§ 1000 bis 1003 finden Anwendung (§ 2022 Abs. 1)";
    label en unofficial "The possessor must surrender the estate's things only against reimbursement of all outlays not covered by set-off against the enrichment under § 2021; §§ 1000 to 1003 apply (§ 2022 (1))";
    when erbschaftsbesitzer(e, besitzer) and verwendungen_gemacht(e, besitzer, betrag);
    then herausgabe_nur_gegen_verwendungsersatz(e, besitzer, betrag);
}

@source(BGB_P2023)
rule HaftungAbRechtshaengigkeit(e: Erbfall, besitzer: Person) strict {
    label de official "Hat der Erbschaftsbesitzer zur Erbschaft gehörende Sachen herauszugeben, so bestimmt sich von dem Eintritt der Rechtshängigkeit an der Anspruch des Erben nach den für das Eigentümer-Besitzer-Verhältnis geltenden Vorschriften (§ 2023 Abs. 1, 2)";
    label en unofficial "Where the possessor must surrender things of the estate, from pendency the heir's claim follows the owner-possessor rules (§ 2023 (1), (2))";
    when erbschaftsbesitzer(e, besitzer) and rechtshaengigkeit_eingetreten(e, besitzer);
    then haftung_nach_eigentuemer_besitzer_verhaeltnis(e, besitzer);
}

@source(BGB_P2024) {
    rule HaftungBeiAnfaenglicherBoesglaeubigkeit(e: Erbfall, besitzer: Person) strict {
        label de official "Ist der Erbschaftsbesitzer bei dem Beginn des Erbschaftsbesitzes nicht in gutem Glauben, so haftet er so, wie wenn der Anspruch des Erben zu dieser Zeit rechtshängig geworden wäre (§ 2024 Satz 1)";
        label en unofficial "If the possessor is not in good faith at the beginning of his possession, he is liable as if the heir's claim had become pending then (§ 2024 sentence 1)";
        when erbschaftsbesitzer(e, besitzer) and bei_besitzerwerb_nicht_in_gutem_glauben(e, besitzer);
        then haftung_nach_eigentuemer_besitzer_verhaeltnis(e, besitzer);
    }
    rule HaftungAbSpaetererKenntnis(e: Erbfall, besitzer: Person) strict {
        label de official "Erfährt der Erbschaftsbesitzer später, dass er nicht Erbe ist, so haftet er in gleicher Weise von der Erlangung der Kenntnis an (§ 2024 Satz 2)";
        label en unofficial "If the possessor later learns that he is not the heir, he is liable in the same way from that moment (§ 2024 sentence 2)";
        when erbschaftsbesitzer(e, besitzer) and spaeter_kenntnis_erlangt(e, besitzer);
        then haftung_nach_eigentuemer_besitzer_verhaeltnis(e, besitzer);
    }
}

@source(BGB_P2025)
rule HaftungBeiUnerlaubterHandlung(e: Erbfall, besitzer: Person) strict {
    label de official "Hat der Erbschaftsbesitzer einen Erbschaftsgegenstand durch eine Straftat oder eine zur Erbschaft gehörende Sache durch verbotene Eigenmacht erlangt, so haftet er nach den Vorschriften über den Schadensersatz wegen unerlaubter Handlungen (§ 2025 Satz 1)";
    label en unofficial "If the possessor obtained an object of the estate by a criminal offence or a thing by unlawful interference, he is liable under the rules on damages for torts (§ 2025 sentence 1)";
    when erbschaftsbesitzer(e, besitzer) and durch_straftat_oder_verbotene_eigenmacht_erlangt(e, besitzer);
    then haftung_nach_deliktsrecht(e, besitzer);
}

@source(BGB_P2026)
rule KeineBerufungAufErsitzung(e: Erbfall, besitzer: Person) strict {
    label de official "Der Erbschaftsbesitzer kann sich dem Erben gegenüber, solange nicht der Erbschaftsanspruch verjährt ist, nicht auf die Ersitzung einer Sache berufen, die er als zur Erbschaft gehörend im Besitz hat (§ 2026)";
    label en unofficial "The possessor cannot, as long as the claim is not time-barred, rely on acquisitive prescription of a thing he possesses as belonging to the estate (§ 2026)";
    when erbschaftsbesitzer(e, besitzer) and not_known(erbschaftsanspruch_verjaehrt(e, besitzer));
    then berufung_auf_ersitzung_ausgeschlossen(e, besitzer);
}

@source(BGB_P2027) {
    rule AuskunftDesErbschaftsbesitzers(e: Erbfall, besitzer: Person) strict {
        label de official "Der Erbschaftsbesitzer ist verpflichtet, dem Erben über den Bestand der Erbschaft und über den Verbleib der Erbschaftsgegenstände Auskunft zu erteilen (§ 2027 Abs. 1)";
        label en unofficial "The possessor must inform the heir about the composition of the estate and the whereabouts of its objects (§ 2027 (1))";
        when erbschaftsbesitzer(e, besitzer);
        then auskunftspflicht_des_erbschaftsbesitzers(e, besitzer);
    }
    rule AuskunftDesBesitzergreifers(e: Erbfall, wer: Person) strict {
        label de official "Die gleiche Verpflichtung hat, wer, ohne Erbschaftsbesitzer zu sein, eine Sache aus dem Nachlass in Besitz nimmt, bevor der Erbe den Besitz tatsächlich ergriffen hat (§ 2027 Abs. 2)";
        label en unofficial "The same duty falls on a person who, without being a possessor of the estate, takes a thing from it before the heir actually took possession (§ 2027 (2))";
        when sache_vor_besitzergreifung_des_erben_genommen(e, wer);
        then auskunftspflicht_des_erbschaftsbesitzers(e, wer);
    }
}

@source(BGB_P2028) {
    rule AuskunftDesHausgenossen(e: Erbfall, wer: Person) strict {
        label de official "Wer sich zur Zeit des Erbfalls mit dem Erblasser in häuslicher Gemeinschaft befunden hat, ist verpflichtet, dem Erben auf Verlangen Auskunft zu erteilen (§ 2028 Abs. 1)";
        label en unofficial "A person who lived in domestic community with the decedent at the devolution must on demand inform the heir (§ 2028 (1))";
        when haeusliche_gemeinschaft_beim_erbfall(e, wer);
        then auskunftspflicht_des_hausgenossen(e, wer);
    }
    rule EidesstattlicheVersicherungDesHausgenossen(e: Erbfall, wer: Person) strict {
        label de official "Besteht Grund zu der Annahme, dass die Auskunft nicht mit der erforderlichen Sorgfalt erteilt worden ist, so hat der Verpflichtete auf Verlangen des Erben an Eides statt zu versichern, dass er seine Angaben nach bestem Wissen so vollständig gemacht habe, als er dazu imstande sei (§ 2028 Abs. 2)";
        label en unofficial "If there is reason to assume the information was not given with the required care, the obliged person must on demand affirm in lieu of oath that he gave his statements as completely as he could (§ 2028 (2))";
        when auskunftspflicht_des_hausgenossen(e, wer) and auskunft_nicht_mit_erforderlicher_sorgfalt_erteilt(wer, e);
        then eidesstattliche_versicherung_des_hausgenossen(e, wer);
    }
}

@source(BGB_P2029)
rule HaftungBeiEinzelanspruechen(e: Erbfall, erbe: Person, besitzer: Person) strict {
    label de official "Die Haftung des Erbschaftsbesitzers bestimmt sich auch gegenüber den Ansprüchen, die dem Erben in Ansehung der einzelnen Erbschaftsgegenstände zustehen, nach den Vorschriften über den Erbschaftsanspruch (§ 2029)";
    label en unofficial "The possessor's liability also follows the rules on the claim to the estate as regards claims concerning individual objects (§ 2029)";
    when erbschaftsbesitzer(e, besitzer) and einzelanspruch_des_erben(e, erbe, besitzer);
    then haftung_nach_erbschaftsanspruchsregeln(e, besitzer);
}

@source(BGB_P2030)
rule Erbschaftserwerber(e: Erbfall, erwerber: Person) strict {
    label de official "Wer die Erbschaft durch Vertrag von einem Erbschaftsbesitzer erwirbt, steht im Verhältnis zu dem Erben einem Erbschaftsbesitzer gleich (§ 2030)";
    label en unofficial "A person acquiring the estate by contract from a possessor is treated towards the heir as a possessor of the estate (§ 2030)";
    when erbschaft_vom_besitzer_erworben(e, erwerber);
    then erbschaftsbesitzer(e, erwerber);
}

@source(BGB_P2031) {
    rule HerausgabeAnDenFuerTotErklaerten(e: Erbfall, p: Person) strict {
        label de official "Überlebt eine Person, die für tot erklärt oder deren Todeszeit festgestellt ist, den Zeitpunkt, der als Zeitpunkt ihres Todes gilt, so kann sie die Herausgabe ihres Vermögens nach den für den Erbschaftsanspruch geltenden Vorschriften verlangen (§ 2031 Abs. 1 Satz 1, Abs. 2)";
        label en unofficial "If a person declared dead survives the moment deemed her death, she may demand restitution of her property under the rules on the claim to the estate (§ 2031 (1) sentence 1, (2))";
        when fuer_tot_erklaert(e, p);
        then herausgabeanspruch_des_fuer_tot_erklaerten(e, p);
    }
    rule VerjaehrungNichtVorEinemJahr(e: Erbfall, p: Person, tag: Date) strict {
        label de official "Solange sie noch lebt, wird die Verjährung ihres Anspruchs nicht vor dem Ablauf eines Jahres nach dem Zeitpunkt vollendet, in welchem sie von der Todeserklärung oder der Feststellung der Todeszeit Kenntnis erlangt (§ 2031 Abs. 1 Satz 2)";
        label en unofficial "As long as she lives, limitation of her claim is not completed before one year after she learns of the declaration or establishment of the time of death (§ 2031 (1) sentence 2)";
        when fuer_tot_erklaert(e, p) and kenntnis_von_der_todeserklaerung_am(e, p, tag);
        then verjaehrung_nicht_vor_jahresablauf(e, p, add_calendar_period(tag, 1 calendar_year));
    }
}
