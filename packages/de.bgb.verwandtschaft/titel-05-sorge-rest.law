// --- Titel 5: Elterliche Sorge — Fortsetzung (§§ 1626b–1698b) -----------------------------------
//
// Die Datei setzt `titel-04-06-sorge-und-beistandschaft.law` fort: dort stehen
// § 1626, § 1626a, § 1626e, § 1629, § 1631, § 1632, § 1666, § 1671, § 1684,
// § 1687 und § 1696. Hier folgen die übrigen Paragraphen des Titels in der
// Ordnung des Gesetzes: die Wirksamkeitsvoraussetzungen der Sorgeerklärung
// (§§ 1626b–1626d), Ausübung und Meinungsverschiedenheit (§§ 1627, 1628), die
// Haftungsbeschränkung des volljährig Gewordenen (§ 1629a), Pflegerbestellung
// und Familienpflege (§ 1630), die Grenzen der Personensorge (§§ 1631a–1631e),
// die VERMÖGENSSORGE (§§ 1638–1649), Haftung und Verhältnismäßigkeit
// (§§ 1664, 1666a, 1667), das RUHEN und die Beendigung der Sorge
// (§§ 1673–1682), Umgang und Auskunft weiterer Personen (§§ 1685–1688) und die
// Abwicklung (§§ 1693, 1697a, 1698–1698b).
//
// DREI KANÄLE. Kindeswohl, Eignung und Neigung, Erforderlichkeit, Sorgfalt in
// eigenen Angelegenheiten, ernsthaftes Interesse und berechtigtes Interesse
// sind WERTUNGEN und stehen im Urteilskanal (§ 47.3). Die Feststellungen des
// Familiengerichts (§ 1674 Abs. 1, § 1674a Satz 2, § 1673 Abs. 1
// Geschäftsunfähigkeit, § 1677 Todeserklärung) sind Tatsachen des Falls mit
// `origin adjudicated`. Die Schwellen, die der Text selbst nennt — 15 000 Euro
// des § 1640 Abs. 2 Nr. 1, drei Monate des § 1629a Abs. 4, sechs Monate des
// § 1631d Abs. 2, das 19. Lebensjahr des § 1643 Abs. 4 —, sind Regeln und
// werden von BEIDEN Seiten belegt.
//
// § 1643 ABS. 1 VERWEIST auf die §§ 1850–1854 (Genehmigungen des Betreuers).
// Die Verweisung wird NICHT nachgebaut: das genehmigungsbedürftige Grundgeschäft
// ist ein ausdrücklicher Eingang des Falls, und AUSGEFÜHRT werden die
// ABWEICHUNGEN der Absätze 2 bis 5, die § 1643 selbst anordnet (Ledger
// D-13-08). So bleibt der Paragraph ohne Abhängigkeit von einem parallel
// bearbeiteten Paket, und die Abweichungen — das Eigentliche der Norm — sind
// vollständig gerechnet.

// --- § 1626b Besondere Wirksamkeitsvoraussetzungen der Sorgeerklärung ---------------------------

pub relation sorgeerklaerung_vor_der_geburt_abgegeben(kind: Person) kind empirical {
    label de official "Die Sorgeerklärung ist schon vor der Geburt des Kindes abgegeben worden (§ 1626b Abs. 2)";
    label en unofficial "the declaration of custody was made before the birth of the child (§ 1626b (2))";
}
pub relation sorgeentscheidung_nach_1696_geaendert(kind: Person) kind empirical {
    label de official "Eine gerichtliche Entscheidung über die elterliche Sorge ist nach § 1696 Abs. 1 Satz 1 geändert worden (§ 1626b Abs. 3) — festgestellte Tatsache";
    label en unofficial "a judicial decision on parental custody has been changed under § 1696 (1) sentence 1 (§ 1626b (3)) — adjudicated fact";
}
pub relation sorgeerklaerung_vor_der_geburt_wirksam(kind: Person) kind institutional {
    label de official "Die Sorgeerklärung kann schon vor der Geburt des Kindes abgegeben werden (§ 1626b Abs. 2)";
    label en unofficial "The declaration of custody may be made before the birth of the child (§ 1626b (2))";
}

@source(BGB_P1626b) {
    rule SorgeerklaerungVorDerGeburtWirksam(k: Person) strict {
        label de official "Die Sorgeerklärung kann schon vor der Geburt des Kindes abgegeben werden (§ 1626b Abs. 2)";
        label en unofficial "The declaration of custody may be made before the birth of the child (§ 1626b (2))";
        when sorgeerklaerung_vor_der_geburt_abgegeben(k) and not_known(sorgeerklaerung_unter_bedingung_oder_zeitbestimmung(k));
        then sorgeerklaerung_vor_der_geburt_wirksam(k);
    }
    rule SorgeerklaerungUnwirksamNachAenderung(k: Person) strict {
        label de official "Eine Sorgeerklärung ist unwirksam, soweit eine gerichtliche Entscheidung über die elterliche Sorge nach § 1696 Abs. 1 Satz 1 geändert wurde (§ 1626b Abs. 3)";
        label en unofficial "A declaration of custody is ineffective insofar as a judicial decision on parental custody has been changed under § 1696 (1) sentence 1 (§ 1626b (3))";
        when sorgeerklaerungen_abgegeben(k) and sorgeentscheidung_nach_1696_geaendert(k);
        then sorgeerklaerung_unwirksam(k);
    }
}

// --- § 1626c Persönliche Abgabe; beschränkt geschäftsfähiger Elternteil -------------------------

pub relation elternteil_beschraenkt_geschaeftsfaehig(kind: Person, elternteil: Person) kind empirical {
    label de official "Der Elternteil ist in der Geschäftsfähigkeit beschränkt (§ 1626c Abs. 2 Satz 1)";
    label en unofficial "the parent has limited capacity to contract (§ 1626c (2) sentence 1)";
}
pub relation zustimmung_des_gesetzlichen_vertreters_erteilt(kind: Person, elternteil: Person) kind empirical {
    label de official "Der gesetzliche Vertreter des beschränkt geschäftsfähigen Elternteils hat selbst zugestimmt (§ 1626c Abs. 2 Satz 1, 2)";
    label en unofficial "the legal representative of the parent with limited capacity has personally given his approval (§ 1626c (2) sentences 1, 2)";
}
pub relation zustimmung_gerichtlich_ersetzt(kind: Person, elternteil: Person) kind empirical {
    label de official "Das Familiengericht hat die Zustimmung auf Antrag des beschränkt geschäftsfähigen Elternteils ersetzt (§ 1626c Abs. 2 Satz 3) — festgestellte Tatsache";
    label en unofficial "the family court replaced the approval on application of the parent with limited capacity (§ 1626c (2) sentence 3) — adjudicated fact";
}

@source(BGB_P1626c)
pub external judgment relation sorgeerklaerung_widerspricht_dem_wohl_des_elternteils(kind: Person, elternteil: Person) {
    authority Court;
    label de official "§ 1626c Abs. 2 Satz 3. Das Familiengericht hat die Zustimmung zu ersetzen, wenn die Sorgeerklärung dem Wohl des beschränkt geschäftsfähigen Elternteils nicht widerspricht";
    label en unofficial "§ 1626c (2) sentence 3. The family court must replace the approval where the declaration of custody does not conflict with the welfare of the parent with limited capacity";
}

pub relation sorgeerklaerung_nur_persoenlich(kind: Person) kind institutional {
    label de official "Die Eltern können die Sorgeerklärungen nur selbst abgeben (§ 1626c Abs. 1)";
    label en unofficial "The parents may make the declarations of custody only themselves (§ 1626c (1))";
}
pub relation zustimmung_erforderlich(kind: Person, elternteil: Person) kind institutional {
    label de official "Die Sorgeerklärung eines beschränkt geschäftsfähigen Elternteils bedarf der Zustimmung seines gesetzlichen Vertreters (§ 1626c Abs. 2 Satz 1)";
    label en unofficial "The declaration of custody of a parent with limited capacity requires the approval of his legal representative (§ 1626c (2) sentence 1)";
}
pub relation zustimmung_liegt_vor(kind: Person, elternteil: Person) kind institutional {
    label de official "Die Zustimmung ist erteilt oder vom Familiengericht ersetzt (§ 1626c Abs. 2 Satz 1, 3)";
    label en unofficial "the approval has been given or replaced by the family court (§ 1626c (2) sentences 1, 3)";
}

@source(BGB_P1626c) {
    rule SorgeerklaerungNurPersoenlich(k: Person) strict {
        label de official "Die Eltern können die Sorgeerklärungen nur selbst abgeben (§ 1626c Abs. 1)";
        label en unofficial "The parents may make the declarations of custody only themselves (§ 1626c (1))";
        when sorgeerklaerungen_abgegeben(k);
        then sorgeerklaerung_nur_persoenlich(k);
    }
    rule ZustimmungErforderlich(k: Person, e: Person) strict {
        label de official "Die Sorgeerklärung eines beschränkt geschäftsfähigen Elternteils bedarf der Zustimmung seines gesetzlichen Vertreters (§ 1626c Abs. 2 Satz 1)";
        label en unofficial "The declaration of custody of a parent with limited capacity requires the approval of his legal representative (§ 1626c (2) sentence 1)";
        when sorgeerklaerungen_abgegeben(k) and elternteil_beschraenkt_geschaeftsfaehig(k, e);
        then zustimmung_erforderlich(k, e);
    }
    rule ZustimmungErteilt(k: Person, e: Person) strict {
        label de official "Die Zustimmung kann nur vom gesetzlichen Vertreter selbst abgegeben werden (§ 1626c Abs. 2 Satz 2)";
        label en unofficial "The approval may be given only by the legal representative himself (§ 1626c (2) sentence 2)";
        when zustimmung_erforderlich(k, e) and zustimmung_des_gesetzlichen_vertreters_erteilt(k, e);
        then zustimmung_liegt_vor(k, e);
    }
    rule ZustimmungErsetzt(k: Person, e: Person) strict {
        label de official "Das Familiengericht hat die Zustimmung auf Antrag des beschränkt geschäftsfähigen Elternteils zu ersetzen, wenn die Sorgeerklärung dem Wohl dieses Elternteils nicht widerspricht (§ 1626c Abs. 2 Satz 3)";
        label en unofficial "The family court must replace the approval on application where the declaration does not conflict with that parent's welfare (§ 1626c (2) sentence 3)";
        when zustimmung_erforderlich(k, e) and zustimmung_gerichtlich_ersetzt(k, e)
         and not_known(sorgeerklaerung_widerspricht_dem_wohl_des_elternteils(k, e));
        then zustimmung_liegt_vor(k, e);
    }
}

// --- § 1626d Form; Mitteilungspflicht -------------------------------------------------------------
//
// „unverzüglich“ ist nach DECISION-0194 ein OFFENER Wertbegriff und keine Frist
// von null Tagen: die Mitteilungspflicht wird als Pflicht ausgeführt, ihr
// Zeitpunkt nicht gerechnet.

pub relation mitteilung_an_das_jugendamt_geschuldet(kind: Person) kind institutional {
    label de official "Die beurkundende Stelle teilt die Abgabe von Sorgeerklärungen und Zustimmungen dem zuständigen Jugendamt unverzüglich mit (§ 1626d Abs. 2)";
    label en unofficial "The certifying body must notify the competent youth welfare office of the declarations and approvals without undue delay (§ 1626d (2))";
}
pub relation beurkundung_erforderlich(kind: Person) kind institutional {
    label de official "Sorgeerklärungen und Zustimmungen müssen öffentlich beurkundet werden (§ 1626d Abs. 1)";
    label en unofficial "Declarations of custody and approvals must be publicly recorded (§ 1626d (1))";
}

@source(BGB_P1626d) {
    rule BeurkundungErforderlich(k: Person) strict {
        label de official "Sorgeerklärungen und Zustimmungen müssen öffentlich beurkundet werden (§ 1626d Abs. 1)";
        label en unofficial "Declarations of custody and approvals must be publicly recorded (§ 1626d (1))";
        when sorgeerklaerungen_abgegeben(k);
        then beurkundung_erforderlich(k);
    }
    rule MitteilungAnDasJugendamt(k: Person) strict {
        label de official "Die beurkundende Stelle teilt die Abgabe von Sorgeerklärungen und Zustimmungen dem zuständigen Jugendamt unverzüglich mit (§ 1626d Abs. 2)";
        label en unofficial "The certifying body notifies the competent youth welfare office of the declarations and approvals without undue delay (§ 1626d (2))";
        when sorgeerklaerungen_abgegeben(k) and sorgeerklaerung_oeffentlich_beurkundet(k);
        then mitteilung_an_das_jugendamt_geschuldet(k);
    }
}

// --- § 1627 Ausübung der elterlichen Sorge, § 1628 Entscheidungsbefugnis -------------------------

pub relation meinungsverschiedenheit(kind: Person) kind empirical {
    label de official "Die Eltern können sich in einer Angelegenheit der elterlichen Sorge nicht einigen (§ 1627 Satz 2, § 1628 Satz 1)";
    label en unofficial "the parents cannot agree on a matter of parental custody (§ 1627 sentence 2, § 1628 sentence 1)";
}
pub relation antrag_eines_elternteils_nach_1628(kind: Person, elternteil: Person) kind empirical {
    label de official "Ein Elternteil beantragt die Übertragung der Entscheidung durch das Familiengericht (§ 1628 Satz 1)";
    label en unofficial "a parent applies for the decision to be transferred by the family court (§ 1628 sentence 1)";
}
pub relation uebertragung_mit_beschraenkung_oder_auflage(kind: Person, elternteil: Person) kind empirical {
    label de official "Die Übertragung ist mit Beschränkungen oder mit Auflagen verbunden (§ 1628 Satz 2)";
    label en unofficial "the transfer is combined with restrictions or conditions (§ 1628 sentence 2)";
}

pub relation sorge_in_eigener_verantwortung_und_einvernehmen(kind: Person) kind institutional {
    label de official "Die Eltern haben die elterliche Sorge in eigener Verantwortung und in gegenseitigem Einvernehmen zum Wohl des Kindes auszuüben (§ 1627 Satz 1)";
    label en unofficial "The parents must exercise parental custody on their own responsibility and in mutual agreement for the child's welfare (§ 1627 sentence 1)";
}
pub relation einigungsversuch_geschuldet(kind: Person) kind institutional {
    label de official "Bei Meinungsverschiedenheiten müssen die Eltern versuchen, sich zu einigen (§ 1627 Satz 2)";
    label en unofficial "In case of differences of opinion the parents must try to reach agreement (§ 1627 sentence 2)";
}
pub relation entscheidung_kann_uebertragen_werden(kind: Person, elternteil: Person) kind institutional {
    label de official "Können sich die Eltern in einer Angelegenheit von erheblicher Bedeutung nicht einigen, so kann das Familiengericht auf Antrag eines Elternteils die Entscheidung einem Elternteil übertragen (§ 1628 Satz 1)";
    label en unofficial "Where the parents cannot agree in a matter of considerable importance, the family court may on application transfer the decision to one parent (§ 1628 sentence 1)";
}
pub relation uebertragung_beschraenkt(kind: Person, elternteil: Person) kind institutional {
    label de official "Die Übertragung kann mit Beschränkungen oder mit Auflagen verbunden werden (§ 1628 Satz 2)";
    label en unofficial "The transfer may be combined with restrictions or conditions (§ 1628 sentence 2)";
}

@source(BGB_P1627) {
    rule SorgeInEigenerVerantwortung(k: Person) strict {
        label de official "Die Eltern haben die elterliche Sorge in eigener Verantwortung und in gegenseitigem Einvernehmen zum Wohl des Kindes auszuüben (§ 1627 Satz 1)";
        label en unofficial "The parents must exercise parental custody on their own responsibility and in mutual agreement for the child's welfare (§ 1627 sentence 1)";
        when elterliche_sorge_gemeinsam(k);
        then sorge_in_eigener_verantwortung_und_einvernehmen(k);
    }
    rule EinigungsversuchGeschuldet(k: Person) strict {
        label de official "Bei Meinungsverschiedenheiten müssen die Eltern versuchen, sich zu einigen (§ 1627 Satz 2)";
        label en unofficial "In case of differences of opinion the parents must try to reach agreement (§ 1627 sentence 2)";
        when elterliche_sorge_gemeinsam(k) and meinungsverschiedenheit(k);
        then einigungsversuch_geschuldet(k);
    }
}

@source(BGB_P1628) {
    rule EntscheidungKannUebertragenWerden(k: Person, e: Person) strict {
        label de official "Können sich die Eltern in einer einzelnen Angelegenheit oder in einer bestimmten Art von Angelegenheiten der elterlichen Sorge, deren Regelung für das Kind von erheblicher Bedeutung ist, nicht einigen, so kann das Familiengericht auf Antrag eines Elternteils die Entscheidung einem Elternteil übertragen (§ 1628 Satz 1)";
        label en unofficial "Where the parents cannot agree on a matter of parental custody of considerable importance for the child, the family court may on application transfer the decision to one parent (§ 1628 sentence 1)";
        when elterliche_sorge_gemeinsam(k) and meinungsverschiedenheit(k)
         and angelegenheit_von_erheblicher_bedeutung(k) and antrag_eines_elternteils_nach_1628(k, e);
        then entscheidung_kann_uebertragen_werden(k, e);
    }
    rule UebertragungBeschraenkt(k: Person, e: Person) strict {
        label de official "Die Übertragung kann mit Beschränkungen oder mit Auflagen verbunden werden (§ 1628 Satz 2)";
        label en unofficial "The transfer may be combined with restrictions or conditions (§ 1628 sentence 2)";
        when entscheidung_nach_1628_uebertragen(k, e) and uebertragung_mit_beschraenkung_oder_auflage(k, e);
        then uebertragung_beschraenkt(k, e);
    }
}

// --- § 1629a Beschränkung der Minderjährigenhaftung ----------------------------------------------
//
// Abs. 1 beschränkt die Haftung auf den BESTAND des bei Eintritt der
// Volljährigkeit vorhandenen Vermögens; Abs. 2 nimmt zwei Gruppen aus; Abs. 4
// enthält eine VERMUTUNG mit einer DREI-MONATS-Schwelle, die vom Tag des
// Eintritts der Volljährigkeit an vorwärts gerechnet wird (Ledger D-13-03).

pub relation volljaehrigkeit_eingetreten_am(person: Person, tag: Date) kind institutional {
    label de official "Tag, mit dessen Ablauf die Volljährigkeit eintritt: Vollendung des 18. Lebensjahrs (§ 2; Bezugstag der §§ 1629a, 1643 Abs. 4)";
    label en unofficial "day at whose end majority is attained: completion of the 18th year of life (§ 2; reference day of §§ 1629a, 1643 (4))";
}
pub relation verbindlichkeit_aus_vertretung_der_eltern(person: Person) kind empirical {
    label de official "Verbindlichkeit, die die Eltern im Rahmen ihrer gesetzlichen Vertretungsmacht mit Wirkung für das Kind begründet haben oder die auf Grund eines während der Minderjährigkeit erfolgten Erwerbs von Todes wegen entstanden ist (§ 1629a Abs. 1 Satz 1)";
    label en unofficial "liability created by the parents within their statutory power of representation with effect for the child, or arising from an acquisition on death during minority (§ 1629a (1) sentence 1)";
}
pub relation verbindlichkeit_aus_erwerbsgeschaeft_112(person: Person) kind empirical {
    label de official "Verbindlichkeit aus dem selbständigen Betrieb eines Erwerbsgeschäfts, zu dem der Minderjährige nach § 112 ermächtigt war (§ 1629a Abs. 2)";
    label en unofficial "liability from the independent operation of a business for which the minor was authorised under § 112 (§ 1629a (2))";
}
pub relation verbindlichkeit_fuer_persoenliche_beduerfnisse(person: Person) kind empirical {
    label de official "Verbindlichkeit aus Rechtsgeschäften, die allein der Befriedigung der persönlichen Bedürfnisse des Minderjährigen dienten (§ 1629a Abs. 2)";
    label en unofficial "liability from transactions serving solely to satisfy the minor's personal needs (§ 1629a (2))";
}
pub relation beschraenkung_geltend_gemacht(person: Person) kind empirical {
    label de official "Der volljährig Gewordene beruft sich auf die Beschränkung der Haftung (§ 1629a Abs. 1 Satz 2)";
    label en unofficial "the person who has attained majority invokes the limitation of liability (§ 1629a (1) sentence 2)";
}
pub relation mitglied_einer_erbengemeinschaft_oder_gesellschaft(person: Person) kind empirical {
    label de official "Der volljährig Gewordene ist Mitglied einer Erbengemeinschaft oder Gesellschaft oder Inhaber eines Handelsgeschäfts (§ 1629a Abs. 4 Satz 1)";
    label en unofficial "the person who attained majority is a member of a community of heirs or a partnership or the holder of a commercial business (§ 1629a (4) sentence 1)";
}
pub relation auseinandersetzung_oder_kuendigung_am(person: Person, tag: Date) kind empirical {
    label de official "Tag, an dem die Auseinandersetzung des Nachlasses verlangt, die Kündigung der Gesellschaft erklärt oder das Handelsgeschäft eingestellt worden ist (§ 1629a Abs. 4 Satz 1)";
    label en unofficial "day on which partition of the estate was demanded, notice of the partnership given or the commercial business discontinued (§ 1629a (4) sentence 1)";
}
pub relation verbindlichkeit_vor_der_volljaehrigkeit_nachgewiesen(person: Person) kind empirical {
    label de official "Der Zweifel ist ausgeräumt: die Verbindlichkeit ist vor dem Eintritt der Volljährigkeit entstanden (Widerlegung der Vermutung des § 1629a Abs. 4 Satz 1)";
    label en unofficial "the doubt is removed: the liability arose before majority was attained (rebuttal of the presumption of § 1629a (4) sentence 1)";
}

pub relation haftung_auf_den_bestand_beschraenkt(person: Person) kind institutional {
    label de official "Die Haftung beschränkt sich auf den Bestand des bei Eintritt der Volljährigkeit vorhandenen Vermögens des Kindes (§ 1629a Abs. 1 Satz 1)";
    label en unofficial "Liability is limited to the assets of the child existing when majority is attained (§ 1629a (1) sentence 1)";
}
pub relation keine_haftungsbeschraenkung(person: Person) kind institutional {
    label de official "Absatz 1 gilt nicht für Verbindlichkeiten aus dem selbständigen Betrieb eines Erwerbsgeschäfts nach § 112 und für Verbindlichkeiten, die allein der Befriedigung persönlicher Bedürfnisse dienten (§ 1629a Abs. 2)";
    label en unofficial "Subsection (1) does not apply to liabilities from an independent business under § 112 or those serving solely personal needs (§ 1629a (2))";
}
pub relation dreimonatsfrist_der_auseinandersetzung(person: Person, tag: Date) kind institutional {
    label de official "Letzter Tag der drei Monate nach Eintritt der Volljährigkeit, binnen deren die Auseinandersetzung zu verlangen oder die Kündigung zu erklären ist (§ 1629a Abs. 4 Satz 1)";
    label en unofficial "last day of the three months after attaining majority within which partition must be demanded or notice given (§ 1629a (4) sentence 1)";
}
pub relation verbindlichkeit_nach_der_volljaehrigkeit_entstanden(person: Person) kind institutional {
    label de official "Im Zweifel ist anzunehmen, dass die Verbindlichkeit nach dem Eintritt der Volljährigkeit entstanden ist (§ 1629a Abs. 4 Satz 1)";
    label en unofficial "In case of doubt it is to be assumed that the liability arose after majority was attained (§ 1629a (4) sentence 1)";
}

@source(BGB_P1629a) {
    rule VolljaehrigkeitEingetretenAm(p: Person, t: Date) strict {
        label de official "Die Volljährigkeit tritt mit der Vollendung des 18. Lebensjahrs ein (§ 2); der Tag wird nach § 187 Abs. 2, § 188 Abs. 2 gerechnet (§ 1629a Abs. 1 Satz 1)";
        label en unofficial "Majority is attained on completion of the 18th year of life (§ 2); the day is computed under § 187 (2), § 188 (2) (§ 1629a (1) sentence 1)";
        when de.bgb.fristen::lebensjahr_vollendet_am(p, 18 calendar_year, t);
        then volljaehrigkeit_eingetreten_am(p, t);
    }
    rule HaftungAufDenBestandBeschraenkt(p: Person) strict {
        label de official "Die Haftung für Verbindlichkeiten, die die Eltern im Rahmen ihrer gesetzlichen Vertretungsmacht begründet haben, beschränkt sich auf den Bestand des bei Eintritt der Volljährigkeit vorhandenen Vermögens des Kindes (§ 1629a Abs. 1 Satz 1)";
        label en unofficial "Liability for obligations created by the parents within their statutory power of representation is limited to the assets existing when majority is attained (§ 1629a (1) sentence 1)";
        when verbindlichkeit_aus_vertretung_der_eltern(p) and beschraenkung_geltend_gemacht(p)
         and not_known(verbindlichkeit_aus_erwerbsgeschaeft_112(p))
         and not_known(verbindlichkeit_fuer_persoenliche_beduerfnisse(p));
        then haftung_auf_den_bestand_beschraenkt(p);
    }
    rule KeineBeschraenkungBeiErwerbsgeschaeft(p: Person) strict {
        label de official "Absatz 1 gilt nicht für Verbindlichkeiten aus dem selbständigen Betrieb eines Erwerbsgeschäfts, soweit der Minderjährige hierzu nach § 112 ermächtigt war (§ 1629a Abs. 2)";
        label en unofficial "Subsection (1) does not apply to liabilities from an independent business for which the minor was authorised under § 112 (§ 1629a (2))";
        when verbindlichkeit_aus_erwerbsgeschaeft_112(p);
        then keine_haftungsbeschraenkung(p);
    }
    rule KeineBeschraenkungBeiPersoenlichenBeduerfnissen(p: Person) strict {
        label de official "Absatz 1 gilt nicht für Verbindlichkeiten aus Rechtsgeschäften, die allein der Befriedigung persönlicher Bedürfnisse dienten (§ 1629a Abs. 2)";
        label en unofficial "Subsection (1) does not apply to liabilities from transactions serving solely personal needs (§ 1629a (2))";
        when verbindlichkeit_fuer_persoenliche_beduerfnisse(p);
        then keine_haftungsbeschraenkung(p);
    }
    rule DreimonatsfristDerAuseinandersetzung(p: Person, v: Date) strict {
        label de official "Die drei Monate laufen vom Eintritt der Volljährigkeit an (§ 1629a Abs. 4 Satz 1); vorwärts gerechnet vom Tag der Vollendung des 18. Lebensjahrs";
        label en unofficial "The three months run from attaining majority (§ 1629a (4) sentence 1), counted forward from the day of completing the 18th year";
        when mitglied_einer_erbengemeinschaft_oder_gesellschaft(p) and volljaehrigkeit_eingetreten_am(p, v);
        then dreimonatsfrist_der_auseinandersetzung(p, add_calendar_period(v, 3 calendar_month));
    }
    presumption VerbindlichkeitNachDerVolljaehrigkeit(p: Person, e: Date, t: Date) {
        label de official "Hat das volljährig gewordene Mitglied einer Erbengemeinschaft oder Gesellschaft nicht binnen drei Monaten nach Eintritt der Volljährigkeit die Auseinandersetzung verlangt oder die Kündigung erklärt, ist im Zweifel anzunehmen, dass die Verbindlichkeit nach dem Eintritt der Volljährigkeit entstanden ist (§ 1629a Abs. 4 Satz 1)";
        label en unofficial "Where the member who attained majority did not demand partition or give notice within three months, it is assumed in case of doubt that the liability arose after majority (§ 1629a (4) sentence 1)";
        when dreimonatsfrist_der_auseinandersetzung(p, e) and auseinandersetzung_oder_kuendigung_am(p, t) and t > e;
        presume verbindlichkeit_nach_der_volljaehrigkeit_entstanden(p);
        unless verbindlichkeit_vor_der_volljaehrigkeit_nachgewiesen(p);
    }
}

// --- § 1630 Elterliche Sorge bei Pflegerbestellung oder Familienpflege ---------------------------

pub relation pfleger_bestellt(kind: Person, angelegenheit: Angelegenheit1630) kind empirical {
    label de official "Für diese Angelegenheit des Kindes ist ein Pfleger bestellt (§ 1630 Abs. 1)";
    label en unofficial "a curator is appointed for this matter of the child (§ 1630 (1))";
}
pub relation kind_fuer_laengere_zeit_in_familienpflege(kind: Person, pflegeperson: Person) kind empirical {
    label de official "Die Eltern geben das Kind für längere Zeit in Familienpflege (§ 1630 Abs. 3 Satz 1, § 1688 Abs. 1 Satz 1)";
    label en unofficial "the parents place the child in family care for a longer time (§ 1630 (3) sentence 1, § 1688 (1) sentence 1)";
}
pub relation uebertragung_auf_die_pflegeperson_beantragt(kind: Person, pflegeperson: Person) kind empirical {
    label de official "Die Übertragung von Angelegenheiten der elterlichen Sorge auf die Pflegeperson ist beantragt (§ 1630 Abs. 3 Satz 1)";
    label en unofficial "transfer of matters of parental custody to the carer has been applied for (§ 1630 (3) sentence 1)";
}
pub relation zustimmung_der_eltern_zur_uebertragung(kind: Person, pflegeperson: Person) kind empirical {
    label de official "Bei einem Antrag der Pflegeperson ist die Zustimmung der Eltern erforderlich und erteilt (§ 1630 Abs. 3 Satz 2)";
    label en unofficial "for an application by the carer the parents' approval is required and has been given (§ 1630 (3) sentence 2)";
}

pub enum Angelegenheit1630 {
    label de official "Gegenstand, für den ein Pfleger bestellt sein kann (§ 1630 Abs. 1, 2)";
    label en unofficial "subject for which a curator may be appointed (§ 1630 (1), (2))";
    Personensorge,
    Vermoegenssorge,
    EinzelneAngelegenheit
}

pub relation sorge_erstreckt_sich_nicht_auf(kind: Person, angelegenheit: Angelegenheit1630) kind institutional {
    label de official "Die elterliche Sorge erstreckt sich nicht auf Angelegenheiten des Kindes, für die ein Pfleger bestellt ist (§ 1630 Abs. 1)";
    label en unofficial "Parental custody does not extend to matters of the child for which a curator is appointed (§ 1630 (1))";
}
pub relation rechte_und_pflichten_eines_pflegers(kind: Person, pflegeperson: Person) kind institutional {
    label de official "Im Umfang der Übertragung hat die Pflegeperson die Rechte und Pflichten eines Pflegers (§ 1630 Abs. 3 Satz 3)";
    label en unofficial "Within the scope of the transfer the carer has the rights and duties of a curator (§ 1630 (3) sentence 3)";
}

@source(BGB_P1630) {
    rule SorgeErstrecktSichNichtAufPflegschaft(k: Person, a: Angelegenheit1630) strict {
        label de official "Die elterliche Sorge erstreckt sich nicht auf Angelegenheiten des Kindes, für die ein Pfleger bestellt ist (§ 1630 Abs. 1)";
        label en unofficial "Parental custody does not extend to matters of the child for which a curator is appointed (§ 1630 (1))";
        when pfleger_bestellt(k, a);
        then sorge_erstreckt_sich_nicht_auf(k, a);
    }
    rule UebertragungAufDiePflegepersonAufElternantrag(k: Person, pp: Person) strict {
        label de official "Geben die Eltern das Kind für längere Zeit in Familienpflege, so kann das Familiengericht auf Antrag der Eltern Angelegenheiten der elterlichen Sorge auf die Pflegeperson übertragen; im Umfang der Übertragung hat die Pflegeperson die Rechte und Pflichten eines Pflegers (§ 1630 Abs. 3 Satz 1, 3)";
        label en unofficial "Where the parents place the child in family care for a longer time, the family court may transfer matters of custody to the carer on the parents' application (§ 1630 (3) sentences 1, 3)";
        when kind_fuer_laengere_zeit_in_familienpflege(k, pp) and uebertragung_auf_die_pflegeperson_beantragt(k, pp);
        then rechte_und_pflichten_eines_pflegers(k, pp);
    }
    rule UebertragungAufAntragDerPflegeperson(k: Person, pp: Person) strict {
        label de official "Für die Übertragung auf Antrag der Pflegeperson ist die Zustimmung der Eltern erforderlich (§ 1630 Abs. 3 Satz 2)";
        label en unofficial "A transfer on the carer's application requires the parents' approval (§ 1630 (3) sentence 2)";
        when kind_fuer_laengere_zeit_in_familienpflege(k, pp) and zustimmung_der_eltern_zur_uebertragung(k, pp);
        then rechte_und_pflichten_eines_pflegers(k, pp);
    }
}

// --- §§ 1631a–1631e Grenzen der Personensorge ----------------------------------------------------

pub relation angelegenheit_der_ausbildung_oder_des_berufs(kind: Person) kind empirical {
    label de official "Es geht um eine Angelegenheit der Ausbildung und des Berufs (§ 1631a Satz 1)";
    label en unofficial "the matter concerns education and profession (§ 1631a sentence 1)";
}
pub relation zweifel_ueber_eignung_oder_neigung(kind: Person) kind empirical {
    label de official "Es bestehen Zweifel über Eignung und Neigung des Kindes (§ 1631a Satz 2)";
    label en unofficial "there are doubts about the child's aptitude and inclination (§ 1631a sentence 2)";
}
pub relation unterbringung_mit_freiheitsentziehung(kind: Person) kind empirical {
    label de official "Eine Unterbringung des Kindes, die mit Freiheitsentziehung verbunden ist (§ 1631b Abs. 1 Satz 1)";
    label en unofficial "a placement of the child involving deprivation of liberty (§ 1631b (1) sentence 1)";
}
pub relation freiheitsentziehende_massnahme_in_einer_einrichtung(kind: Person) kind empirical {
    label de official "Dem Kind soll in einem Krankenhaus, einem Heim oder einer sonstigen Einrichtung über einen längeren Zeitraum oder regelmäßig in nicht altersgerechter Weise die Freiheit entzogen werden (§ 1631b Abs. 2 Satz 1)";
    label en unofficial "the child is to be deprived of liberty in a hospital, home or other institution over a longer period or regularly in a manner not appropriate to its age (§ 1631b (2) sentence 1)";
}
pub relation aufschub_mit_gefahr_verbunden(kind: Person) kind empirical {
    label de official "Mit dem Aufschub ist Gefahr verbunden (§ 1631b Abs. 1 Satz 3)";
    label en unofficial "postponement involves danger (§ 1631b (1) sentence 3)";
}
pub relation sterilisation_geplant(kind: Person) kind empirical {
    label de official "Eine Sterilisation des Kindes ist geplant (§ 1631c)";
    label en unofficial "a sterilisation of the child is planned (§ 1631c)";
}
pub relation beschneidung_medizinisch_nicht_erforderlich(kind: Person) kind empirical {
    label de official "Eine medizinisch nicht erforderliche Beschneidung des nicht einsichts- und urteilsfähigen männlichen Kindes, die nach den Regeln der ärztlichen Kunst durchgeführt werden soll (§ 1631d Abs. 1 Satz 1)";
    label en unofficial "a medically unnecessary circumcision of a male child lacking insight and judgement, to be carried out according to the rules of medical practice (§ 1631d (1) sentence 1)";
}
pub relation beschneidung_durch_religionsgesellschaft(kind: Person, tag: Date) kind empirical {
    label de official "Eine von einer Religionsgesellschaft dazu vorgesehene, besonders ausgebildete Person soll die Beschneidung an diesem Tag durchführen (§ 1631d Abs. 2)";
    label en unofficial "a specially trained person designated by a religious society is to perform the circumcision on this day (§ 1631d (2))";
}
pub relation variante_der_geschlechtsentwicklung(kind: Person) kind empirical {
    label de official "Das nicht einwilligungsfähige Kind hat eine Variante der Geschlechtsentwicklung (§ 1631e Abs. 1)";
    label en unofficial "the child unable to consent has a variant of sex development (§ 1631e (1))";
}
pub relation behandlung_allein_zur_angleichung(kind: Person) kind empirical {
    label de official "Die Behandlung erfolgt, ohne dass ein weiterer Grund hinzutritt, allein in der Absicht, das körperliche Erscheinungsbild des Kindes anzugleichen (§ 1631e Abs. 1)";
    label en unofficial "the treatment is carried out, without any further reason, solely to align the child's physical appearance (§ 1631e (1))";
}
pub relation eingriff_nicht_aufschiebbar(kind: Person) kind empirical {
    label de official "Der operative Eingriff kann nicht bis zu einer selbstbestimmten Entscheidung des Kindes aufgeschoben werden (§ 1631e Abs. 2 Satz 1)";
    label en unofficial "the surgical intervention cannot be postponed until a self-determined decision of the child (§ 1631e (2) sentence 1)";
}
pub relation befuerwortende_stellungnahme_der_kommission(kind: Person) kind empirical {
    label de official "Die Eltern legen dem Familiengericht eine den Eingriff befürwortende Stellungnahme einer interdisziplinären Kommission vor (§ 1631e Abs. 3 Satz 3, Abs. 4)";
    label en unofficial "the parents submit to the family court an opinion of an interdisciplinary commission supporting the intervention (§ 1631e (3) sentence 3, (4))";
}
pub relation eingriff_zur_gefahrenabwehr_erforderlich(kind: Person) kind empirical {
    label de official "Der operative Eingriff ist zur Abwehr einer Gefahr für das Leben oder die Gesundheit des Kindes erforderlich und kann nicht bis zur Erteilung der Genehmigung aufgeschoben werden (§ 1631e Abs. 3 Satz 1)";
    label en unofficial "the intervention is necessary to avert a danger to the child's life or health and cannot be postponed until the approval is granted (§ 1631e (3) sentence 1)";
}
pub relation entspricht_nicht_dem_wohl_des_kindes_nachgewiesen(kind: Person) kind empirical {
    label de official "Der Gegenbeweis ist geführt: der geplante Eingriff entspricht dem Wohl des Kindes nicht am besten (Widerlegung der Vermutung des § 1631e Abs. 3 Satz 3)";
    label en unofficial "the presumption of § 1631e (3) sentence 3 is rebutted: the planned intervention does not best serve the child's welfare";
}

@source(BGB_P1631a)
pub external judgment relation eignung_und_neigung_des_kindes(kind: Person) {
    authority Court;
    label de official "§ 1631a Satz 1. In Angelegenheiten der Ausbildung und des Berufs nehmen die Eltern insbesondere auf Eignung und Neigung des Kindes Rücksicht";
    label en unofficial "§ 1631a sentence 1. In matters of education and profession the parents take particular account of the child's aptitude and inclination";
}
@source(BGB_P1631b)
pub external judgment relation unterbringung_zum_wohl_des_kindes_erforderlich(kind: Person) {
    authority Court;
    label de official "§ 1631b Abs. 1 Satz 2. Die Unterbringung ist zum Wohl des Kindes, insbesondere zur Abwendung einer erheblichen Selbst- oder Fremdgefährdung, erforderlich und der Gefahr kann nicht auf andere Weise, auch nicht durch andere öffentliche Hilfen, begegnet werden";
    label en unofficial "§ 1631b (1) sentence 2. The placement is necessary for the child's welfare, in particular to avert substantial danger to itself or others, and the danger cannot be met otherwise, including by other public assistance";
}
@source(BGB_P1631d)
pub external judgment relation kindeswohl_durch_beschneidung_gefaehrdet(kind: Person) {
    authority Court;
    label de official "§ 1631d Abs. 1 Satz 2. Durch die Beschneidung wird auch unter Berücksichtigung ihres Zwecks das Kindeswohl gefährdet";
    label en unofficial "§ 1631d (1) sentence 2. The circumcision endangers the child's welfare even taking its purpose into account";
}

pub relation ruecksicht_auf_eignung_und_neigung(kind: Person) kind institutional {
    label de official "In Angelegenheiten der Ausbildung und des Berufs nehmen die Eltern insbesondere auf Eignung und Neigung des Kindes Rücksicht (§ 1631a Satz 1)";
    label en unofficial "In matters of education and profession the parents take particular account of the child's aptitude and inclination (§ 1631a sentence 1)";
}
pub relation rat_einzuholen(kind: Person) kind institutional {
    label de official "Bestehen Zweifel, so soll der Rat eines Lehrers oder einer anderen geeigneten Person eingeholt werden (§ 1631a Satz 2)";
    label en unofficial "In case of doubt the advice of a teacher or another suitable person should be obtained (§ 1631a sentence 2)";
}
pub relation genehmigung_des_familiengerichts_erforderlich_1631b(kind: Person) kind institutional {
    label de official "Eine Unterbringung des Kindes, die mit Freiheitsentziehung verbunden ist, bedarf der Genehmigung des Familiengerichts (§ 1631b Abs. 1 Satz 1, Abs. 2 Satz 1)";
    label en unofficial "A placement of the child involving deprivation of liberty requires the approval of the family court (§ 1631b (1) sentence 1, (2) sentence 1)";
}
pub relation unterbringung_zulaessig(kind: Person) kind institutional {
    label de official "Die Unterbringung ist zulässig, solange sie zum Wohl des Kindes erforderlich ist und der Gefahr nicht auf andere Weise begegnet werden kann (§ 1631b Abs. 1 Satz 2)";
    label en unofficial "The placement is permissible as long as it is necessary for the child's welfare and the danger cannot be met otherwise (§ 1631b (1) sentence 2)";
}
pub relation unterbringung_ohne_genehmigung_zulaessig(kind: Person) kind institutional {
    label de official "Ohne die Genehmigung ist die Unterbringung nur zulässig, wenn mit dem Aufschub Gefahr verbunden ist; die Genehmigung ist unverzüglich nachzuholen (§ 1631b Abs. 1 Satz 3)";
    label en unofficial "Without the approval the placement is permissible only where postponement involves danger; the approval must be obtained without undue delay (§ 1631b (1) sentence 3)";
}
pub relation einwilligung_in_die_sterilisation_ausgeschlossen(kind: Person) kind institutional {
    label de official "Die Eltern können nicht in eine Sterilisation des Kindes einwilligen; auch das Kind selbst kann nicht einwilligen (§ 1631c Satz 1, 2)";
    label en unofficial "The parents cannot consent to a sterilisation of the child; nor can the child itself consent (§ 1631c sentences 1, 2)";
}
pub relation einwilligung_in_die_beschneidung_umfasst(kind: Person) kind institutional {
    label de official "Die Personensorge umfasst auch das Recht, in eine medizinisch nicht erforderliche Beschneidung des nicht einsichts- und urteilsfähigen männlichen Kindes einzuwilligen (§ 1631d Abs. 1 Satz 1)";
    label en unofficial "Parental care also includes the right to consent to a medically unnecessary circumcision of a male child lacking insight and judgement (§ 1631d (1) sentence 1)";
}
pub relation beschneidung_durch_nichtarzt_zulaessig(kind: Person) kind institutional {
    label de official "In den ersten sechs Monaten nach der Geburt des Kindes dürfen auch von einer Religionsgesellschaft dazu vorgesehene Personen Beschneidungen durchführen (§ 1631d Abs. 2)";
    label en unofficial "In the first six months after the child's birth, persons designated by a religious society may also perform circumcisions (§ 1631d (2))";
}
pub relation ende_der_sechs_monate_nach_der_geburt(kind: Person, tag: Date) kind institutional {
    label de official "Letzter Tag der ersten sechs Monate nach der Geburt des Kindes (§ 1631d Abs. 2), vom Tag der Geburt an vorwärts gerechnet";
    label en unofficial "last day of the first six months after the child's birth (§ 1631d (2)), counted forward from the day of birth";
}
pub relation einwilligungsbefugnis_fehlt_1631e(kind: Person) kind institutional {
    label de official "Die Personensorge umfasst nicht das Recht, in eine allein der Angleichung dienende Behandlung eines nicht einwilligungsfähigen Kindes mit einer Variante der Geschlechtsentwicklung einzuwilligen (§ 1631e Abs. 1)";
    label en unofficial "Parental care does not include the right to consent to a treatment of a child unable to consent with a variant of sex development serving solely alignment (§ 1631e (1))";
}
pub relation einwilligung_in_den_eingriff_moeglich(kind: Person) kind institutional {
    label de official "In operative Eingriffe können die Eltern nur einwilligen, wenn der Eingriff nicht bis zu einer selbstbestimmten Entscheidung des Kindes aufgeschoben werden kann (§ 1631e Abs. 2 Satz 1)";
    label en unofficial "The parents may consent to surgical interventions only where the intervention cannot be postponed until a self-determined decision of the child (§ 1631e (2) sentence 1)";
}
pub relation genehmigung_des_familiengerichts_erforderlich_1631e(kind: Person) kind institutional {
    label de official "Die Einwilligung nach Absatz 2 Satz 1 bedarf der Genehmigung des Familiengerichts (§ 1631e Abs. 3 Satz 1)";
    label en unofficial "The consent under subsection (2) sentence 1 requires the approval of the family court (§ 1631e (3) sentence 1)";
}
pub relation eingriff_entspricht_dem_wohl_des_kindes_am_besten(kind: Person) kind institutional {
    label de official "Legen die Eltern eine befürwortende Stellungnahme einer interdisziplinären Kommission vor, wird vermutet, dass der geplante Eingriff dem Wohl des Kindes am besten entspricht (§ 1631e Abs. 3 Satz 3)";
    label en unofficial "Where the parents submit a supporting opinion of an interdisciplinary commission, it is presumed that the intervention best serves the child's welfare (§ 1631e (3) sentence 3)";
}

@source(BGB_P1631a) {
    rule RuecksichtAufEignungUndNeigung(k: Person) strict {
        label de official "In Angelegenheiten der Ausbildung und des Berufs nehmen die Eltern insbesondere auf Eignung und Neigung des Kindes Rücksicht (§ 1631a Satz 1)";
        label en unofficial "In matters of education and profession the parents take particular account of the child's aptitude and inclination (§ 1631a sentence 1)";
        when angelegenheit_der_ausbildung_oder_des_berufs(k) and eignung_und_neigung_des_kindes(k);
        then ruecksicht_auf_eignung_und_neigung(k);
    }
    rule RatEinzuholen(k: Person) strict {
        label de official "Bestehen Zweifel, so soll der Rat eines Lehrers oder einer anderen geeigneten Person eingeholt werden (§ 1631a Satz 2)";
        label en unofficial "In case of doubt the advice of a teacher or another suitable person should be obtained (§ 1631a sentence 2)";
        when angelegenheit_der_ausbildung_oder_des_berufs(k) and zweifel_ueber_eignung_oder_neigung(k);
        then rat_einzuholen(k);
    }
}

@source(BGB_P1631b) {
    rule GenehmigungDerUnterbringung(k: Person) strict {
        label de official "Eine Unterbringung des Kindes, die mit Freiheitsentziehung verbunden ist, bedarf der Genehmigung des Familiengerichts (§ 1631b Abs. 1 Satz 1)";
        label en unofficial "A placement of the child involving deprivation of liberty requires the approval of the family court (§ 1631b (1) sentence 1)";
        when unterbringung_mit_freiheitsentziehung(k);
        then genehmigung_des_familiengerichts_erforderlich_1631b(k);
    }
    rule GenehmigungDerFreiheitsentziehendenMassnahme(k: Person) strict {
        label de official "Die Genehmigung des Familiengerichts ist auch erforderlich, wenn dem Kind in einer Einrichtung über einen längeren Zeitraum oder regelmäßig in nicht altersgerechter Weise die Freiheit entzogen werden soll (§ 1631b Abs. 2 Satz 1)";
        label en unofficial "The approval is also required where the child is to be deprived of liberty in an institution over a longer period or regularly in a manner not appropriate to its age (§ 1631b (2) sentence 1)";
        when freiheitsentziehende_massnahme_in_einer_einrichtung(k);
        then genehmigung_des_familiengerichts_erforderlich_1631b(k);
    }
    rule UnterbringungZulaessig(k: Person) strict {
        label de official "Die Unterbringung ist zulässig, solange sie zum Wohl des Kindes erforderlich ist und der Gefahr nicht auf andere Weise begegnet werden kann (§ 1631b Abs. 1 Satz 2)";
        label en unofficial "The placement is permissible as long as it is necessary for the child's welfare and the danger cannot be met otherwise (§ 1631b (1) sentence 2)";
        when unterbringung_mit_freiheitsentziehung(k) and unterbringung_zum_wohl_des_kindes_erforderlich(k);
        then unterbringung_zulaessig(k);
    }
    rule UnterbringungOhneGenehmigung(k: Person) strict {
        label de official "Ohne die Genehmigung ist die Unterbringung nur zulässig, wenn mit dem Aufschub Gefahr verbunden ist (§ 1631b Abs. 1 Satz 3)";
        label en unofficial "Without the approval the placement is permissible only where postponement involves danger (§ 1631b (1) sentence 3)";
        when unterbringung_zulaessig(k) and aufschub_mit_gefahr_verbunden(k);
        then unterbringung_ohne_genehmigung_zulaessig(k);
    }
}

@source(BGB_P1631c)
rule SterilisationVerboten(k: Person) strict {
    label de official "Die Eltern können nicht in eine Sterilisation des Kindes einwilligen; auch das Kind selbst kann nicht in die Sterilisation einwilligen (§ 1631c Satz 1, 2)";
    label en unofficial "The parents cannot consent to a sterilisation of the child; nor can the child itself consent (§ 1631c sentences 1, 2)";
    when sterilisation_geplant(k);
    then einwilligung_in_die_sterilisation_ausgeschlossen(k);
}

@source(BGB_P1631d) {
    rule EinwilligungInDieBeschneidung(k: Person) strict {
        label de official "Die Personensorge umfasst auch das Recht, in eine medizinisch nicht erforderliche Beschneidung des nicht einsichts- und urteilsfähigen männlichen Kindes einzuwilligen; dies gilt nicht, wenn durch die Beschneidung das Kindeswohl gefährdet wird (§ 1631d Abs. 1)";
        label en unofficial "Parental care includes the right to consent to a medically unnecessary circumcision of a male child lacking insight and judgement; this does not apply where the circumcision endangers the child's welfare (§ 1631d (1))";
        when beschneidung_medizinisch_nicht_erforderlich(k) and personensorge(k)
         and not_known(kindeswohl_durch_beschneidung_gefaehrdet(k));
        then einwilligung_in_die_beschneidung_umfasst(k);
    }
    rule EndeDerSechsMonate(k: Person, g: Date) strict {
        label de official "Die ersten sechs Monate laufen vom Tag der Geburt des Kindes an (§ 1631d Abs. 2)";
        label en unofficial "The first six months run from the day of the child's birth (§ 1631d (2))";
        when geburt_des_kindes_am(k, g);
        then ende_der_sechs_monate_nach_der_geburt(k, add_calendar_period(g, 6 calendar_month));
    }
    rule BeschneidungDurchNichtarzt(k: Person, t: Date, e: Date) strict {
        label de official "In den ersten sechs Monaten nach der Geburt des Kindes dürfen auch von einer Religionsgesellschaft dazu vorgesehene, besonders ausgebildete Personen Beschneidungen gemäß Absatz 1 durchführen (§ 1631d Abs. 2)";
        label en unofficial "In the first six months after the birth, specially trained persons designated by a religious society may also perform circumcisions under subsection (1) (§ 1631d (2))";
        when einwilligung_in_die_beschneidung_umfasst(k) and beschneidung_durch_religionsgesellschaft(k, t)
         and ende_der_sechs_monate_nach_der_geburt(k, e) and t <= e;
        then beschneidung_durch_nichtarzt_zulaessig(k);
    }
}

@source(BGB_P1631e) {
    rule EinwilligungsbefugnisFehlt(k: Person) strict {
        label de official "Die Personensorge umfasst nicht das Recht, in eine Behandlung eines nicht einwilligungsfähigen Kindes mit einer Variante der Geschlechtsentwicklung einzuwilligen, die allein in der Absicht der Angleichung erfolgt (§ 1631e Abs. 1)";
        label en unofficial "Parental care does not include the right to consent to a treatment serving solely alignment of a child unable to consent with a variant of sex development (§ 1631e (1))";
        when variante_der_geschlechtsentwicklung(k) and behandlung_allein_zur_angleichung(k);
        then einwilligungsbefugnis_fehlt_1631e(k);
    }
    rule EinwilligungInDenEingriffMoeglich(k: Person) strict {
        label de official "In operative Eingriffe, für die nicht bereits nach Absatz 1 die Einwilligungsbefugnis fehlt, können die Eltern nur einwilligen, wenn der Eingriff nicht bis zu einer selbstbestimmten Entscheidung des Kindes aufgeschoben werden kann (§ 1631e Abs. 2 Satz 1)";
        label en unofficial "The parents may consent to surgical interventions not already excluded by subsection (1) only where the intervention cannot be postponed (§ 1631e (2) sentence 1)";
        when variante_der_geschlechtsentwicklung(k) and eingriff_nicht_aufschiebbar(k)
         and not_known(einwilligungsbefugnis_fehlt_1631e(k));
        then einwilligung_in_den_eingriff_moeglich(k);
    }
    rule GenehmigungDesEingriffs(k: Person) strict {
        label de official "Die Einwilligung nach Absatz 2 Satz 1 bedarf der Genehmigung des Familiengerichts, es sei denn, der Eingriff ist zur Abwehr einer Gefahr für Leben oder Gesundheit erforderlich und nicht aufschiebbar (§ 1631e Abs. 3 Satz 1)";
        label en unofficial "The consent under subsection (2) sentence 1 requires the family court's approval unless the intervention is necessary to avert a danger to life or health and cannot be postponed (§ 1631e (3) sentence 1)";
        when einwilligung_in_den_eingriff_moeglich(k) and not_known(eingriff_zur_gefahrenabwehr_erforderlich(k));
        then genehmigung_des_familiengerichts_erforderlich_1631e(k);
    }
    presumption EingriffEntsprichtDemWohlDesKindes(k: Person) {
        label de official "Legen die Eltern dem Familiengericht eine den Eingriff befürwortende Stellungnahme einer interdisziplinären Kommission nach Absatz 4 vor, wird vermutet, dass der geplante Eingriff dem Wohl des Kindes am besten entspricht (§ 1631e Abs. 3 Satz 3)";
        label en unofficial "Where the parents submit a supporting opinion of an interdisciplinary commission under subsection (4), it is presumed that the intervention best serves the child's welfare (§ 1631e (3) sentence 3)";
        when befuerwortende_stellungnahme_der_kommission(k);
        presume eingriff_entspricht_dem_wohl_des_kindes_am_besten(k);
        unless entspricht_nicht_dem_wohl_des_kindes_nachgewiesen(k);
    }
}

// --- §§ 1638–1649 Vermögenssorge ------------------------------------------------------------------
//
// Die SCHWELLE des § 1640 Abs. 2 Nr. 1 (15 000 Euro) steht im Text und wird
// von beiden Seiten gerechnet; die Grenze ist „übersteigt nicht“, der Erwerb
// von genau 15 000 Euro ist daher ausgenommen. § 1643 Abs. 4 nennt eine
// Dauer — länger als EIN JAHR nach dem Eintritt der Volljährigkeit — und das
// 19. Lebensjahr als Kündigungsgrenze; beide werden über
// `de.bgb.fristen::lebensjahr_vollendet_am` gerechnet.

pub relation erwerb_von_todes_wegen_oder_unentgeltlich(kind: Person, betrag: Money) kind empirical {
    label de official "Vermögen, das das Kind von Todes wegen, durch unentgeltliche Zuwendung auf den Todesfall oder unter Lebenden erwirbt (§ 1638 Abs. 1, § 1639 Abs. 1, § 1640 Abs. 1)";
    label en unofficial "assets the child acquires on death, by gratuitous disposition on death or inter vivos (§ 1638 (1), § 1639 (1), § 1640 (1))";
}
pub relation verwaltungsausschluss_bestimmt(kind: Person) kind empirical {
    label de official "Der Erblasser hat durch letztwillige Verfügung oder der Zuwendende bei der Zuwendung bestimmt, dass die Eltern das Vermögen nicht verwalten sollen (§ 1638 Abs. 1)";
    label en unofficial "the testator or donor determined that the parents are not to administer the assets (§ 1638 (1))";
}
pub relation verwaltungsausschluss_fuer_einen_elternteil(kind: Person, elternteil: Person) kind empirical {
    label de official "Es ist bestimmt, dass ein bestimmter Elternteil das Vermögen nicht verwalten soll (§ 1638 Abs. 3 Satz 1)";
    label en unofficial "it is determined that a particular parent is not to administer the assets (§ 1638 (3) sentence 1)";
}
pub relation surrogat_des_ausgeschlossenen_vermoegens(kind: Person) kind empirical {
    label de official "Das Kind erwirbt etwas auf Grund eines zu dem ausgeschlossenen Vermögen gehörenden Rechts, als Ersatz für einen Gegenstand dieses Vermögens oder durch ein sich auf es beziehendes Rechtsgeschäft (§ 1638 Abs. 2)";
    label en unofficial "the child acquires something by virtue of a right belonging to the excluded assets, as substitute for an item of those assets or by a transaction relating to them (§ 1638 (2))";
}
pub relation anordnung_des_erblassers_oder_zuwendenden(kind: Person) kind empirical {
    label de official "Durch letztwillige Verfügung oder bei der Zuwendung sind Anordnungen über die Verwaltung getroffen worden (§ 1639 Abs. 1)";
    label en unofficial "directions on the administration were given by will or at the time of the disposition (§ 1639 (1))";
}
pub relation abweichende_anordnung_zum_verzeichnis(kind: Person) kind empirical {
    label de official "Der Erblasser oder der Zuwendende hat hinsichtlich des Verzeichnisses eine abweichende Anordnung getroffen (§ 1640 Abs. 2 Nr. 2)";
    label en unofficial "the testator or donor gave a deviating direction concerning the inventory (§ 1640 (2) no. 2)";
}
pub relation verzeichnis_nicht_oder_ungenuegend_eingereicht(kind: Person) kind empirical {
    label de official "Die Eltern reichen kein Verzeichnis ein oder das eingereichte Verzeichnis ist ungenügend (§ 1640 Abs. 3)";
    label en unofficial "the parents submit no inventory or the inventory submitted is insufficient (§ 1640 (3))";
}
pub relation schenkung_in_vertretung_des_kindes(kind: Person) kind empirical {
    label de official "Die Eltern machen in Vertretung des Kindes eine Schenkung (§ 1641 Satz 1)";
    label en unofficial "the parents make a gift in representation of the child (§ 1641 sentence 1)";
}
pub relation schenkung_aus_sittlicher_pflicht_oder_anstand(kind: Person) kind empirical {
    label de official "Die Schenkung entspricht einer sittlichen Pflicht oder einer auf den Anstand zu nehmenden Rücksicht (§ 1641 Satz 2)";
    label en unofficial "the gift corresponds to a moral duty or to considerations of decency (§ 1641 sentence 2)";
}
pub relation geld_des_kindes_unterliegt_der_verwaltung(kind: Person) kind empirical {
    label de official "Geld des Kindes unterliegt der Verwaltung der Eltern (§ 1642)";
    label en unofficial "money of the child is subject to the parents' administration (§ 1642)";
}
pub relation geld_zur_bestreitung_von_ausgaben_bereitzuhalten(kind: Person) kind empirical {
    label de official "Das Geld ist zur Bestreitung von Ausgaben bereitzuhalten (§ 1642)";
    label en unofficial "the money is to be kept available to meet expenses (§ 1642)";
}
pub relation betreuerrechtlich_genehmigungsbeduerftiges_geschaeft(kind: Person) kind empirical {
    label de official "Ein Rechtsgeschäft, für das ein Betreuer nach den §§ 1850 bis 1854 der Genehmigung des Betreuungsgerichts bedürfte (§ 1643 Abs. 1) — Eingang des Falls, die Verweisung wird nicht nachgebaut (Ledger D-13-08)";
    label en unofficial "a transaction for which a curator would need the approval of the curatorship court under §§ 1850 to 1854 (§ 1643 (1)) — case input; the reference is not rebuilt (ledger D-13-08)";
}
pub relation verfuegung_ueber_grundpfandrecht(kind: Person) kind empirical {
    label de official "Verfügung über ein Grundpfandrecht oder Verpflichtung zu einer solchen Verfügung (§ 1643 Abs. 2)";
    label en unofficial "disposition of a land charge or obligation to such a disposition (§ 1643 (2))";
}
pub relation anfall_infolge_ausschlagung_eines_elternteils(kind: Person, elternteil: Person) kind empirical {
    label de official "Der Anfall einer Erbschaft oder eines Vermächtnisses an das Kind tritt erst infolge der Ausschlagung eines Elternteils ein (§ 1643 Abs. 3 Satz 1)";
    label en unofficial "the devolution of an inheritance or legacy on the child occurs only as a result of a parent's disclaimer (§ 1643 (3) sentence 1)";
}
pub relation elternteil_neben_dem_kind_berufen(kind: Person, elternteil: Person) kind empirical {
    label de official "Der Elternteil war neben dem Kind berufen (§ 1643 Abs. 3 Satz 1)";
    label en unofficial "the parent was called to the succession alongside the child (§ 1643 (3) sentence 1)";
}
pub relation auseinandersetzungsvertrag_oder_ausscheiden(kind: Person) kind empirical {
    label de official "Ein Auseinandersetzungsvertrag oder eine Vereinbarung, mit der das Kind aus einer Erbengemeinschaft ausscheidet (§ 1643 Abs. 3 Satz 2)";
    label en unofficial "a partition agreement or an agreement by which the child leaves a community of heirs (§ 1643 (3) sentence 2)";
}
pub relation dauerschuldvertrag_endet_am(kind: Person, tag: Date) kind empirical {
    label de official "Tag, bis zu dem das Vertragsverhältnis über wiederkehrende Leistungen fortdauern soll (§ 1643 Abs. 4 Satz 1)";
    label en unofficial "day until which the contractual relationship on recurring performances is to continue (§ 1643 (4) sentence 1)";
}
pub relation ausbildungs_dienst_oder_arbeitsvertrag(kind: Person) kind empirical {
    label de official "Es handelt sich um einen Ausbildungs-, Dienst- oder Arbeitsvertrag (§ 1643 Abs. 4 Satz 2 Nr. 1)";
    label en unofficial "the contract is a training, service or employment contract (§ 1643 (4) sentence 2 no. 1)";
}
pub relation geringe_wirtschaftliche_bedeutung(kind: Person) kind empirical {
    label de official "Der Vertrag hat geringe wirtschaftliche Bedeutung für das Kind (§ 1643 Abs. 4 Satz 2 Nr. 2)";
    label en unofficial "the contract is of minor economic significance for the child (§ 1643 (4) sentence 2 no. 2)";
}
pub relation kuendbar_bis_zum_ablauf_des_19_lebensjahres(kind: Person) kind empirical {
    label de official "Das Vertragsverhältnis kann vom Kind nach Eintritt der Volljährigkeit spätestens zum Ablauf des 19. Lebensjahres ohne eigene Nachteile gekündigt werden (§ 1643 Abs. 4 Satz 2 Nr. 3)";
    label en unofficial "the child may terminate the relationship after attaining majority at the latest by the end of its 19th year without disadvantage (§ 1643 (4) sentence 2 no. 3)";
}
pub relation kind_volljaehrig_geworden(kind: Person) kind empirical {
    label de official "Das Kind ist volljährig geworden: an die Stelle der Genehmigung des Familiengerichts tritt seine eigene Genehmigung (§ 1644 Abs. 3 Satz 2)";
    label en unofficial "the child has attained majority: its own approval replaces that of the family court (§ 1644 (3) sentence 2)";
}
pub relation genehmigung_des_gerichts_erteilt(kind: Person) kind empirical {
    label de official "Das Familiengericht hat die Genehmigung erteilt (§ 1644 Abs. 1) — festgestellte Tatsache";
    label en unofficial "the family court granted the approval (§ 1644 (1)) — adjudicated fact";
}
pub relation neues_erwerbsgeschaeft_im_namen_des_kindes(kind: Person) kind empirical {
    label de official "Die Eltern beginnen ein neues Erwerbsgeschäft im Namen des Kindes (§ 1645)";
    label en unofficial "the parents begin a new business in the child's name (§ 1645)";
}
pub relation erwerb_mit_mitteln_des_kindes(kind: Person) kind empirical {
    label de official "Die Eltern erwerben mit Mitteln des Kindes bewegliche Sachen oder ein Recht, zu dessen Übertragung der Abtretungsvertrag genügt (§ 1646 Abs. 1, 2)";
    label en unofficial "the parents acquire movable things or a right transferable by assignment using the child's means (§ 1646 (1), (2))";
}
pub relation erwerb_nicht_fuer_rechnung_des_kindes(kind: Person) kind empirical {
    label de official "Die Eltern wollen nicht für Rechnung des Kindes erwerben (§ 1646 Abs. 1 Satz 1 Halbsatz 2)";
    label en unofficial "the parents do not intend to acquire for the child's account (§ 1646 (1) sentence 1)";
}
pub relation aufwendungen_bei_ausuebung_der_sorge(kind: Person, elternteil: Person) kind empirical {
    label de official "Die Eltern machen bei der Ausübung der Personensorge oder der Vermögenssorge Aufwendungen, die sie den Umständen nach für erforderlich halten dürfen (§ 1648)";
    label en unofficial "the parents make expenses in exercising parental care which they may consider necessary in the circumstances (§ 1648)";
}
pub relation aufwendungen_fallen_den_eltern_zur_last(kind: Person, elternteil: Person) kind empirical {
    label de official "Die Aufwendungen fallen den Eltern selbst zur Last (§ 1648)";
    label en unofficial "the expenses are borne by the parents themselves (§ 1648)";
}
pub relation vermoegenseinkuenfte_nicht_benoetigt(kind: Person) kind empirical {
    label de official "Einkünfte des Kindesvermögens, die zur ordnungsmäßigen Verwaltung des Vermögens nicht benötigt werden (§ 1649 Abs. 1 Satz 1)";
    label en unofficial "income from the child's assets not needed for the proper administration of the assets (§ 1649 (1) sentence 1)";
}
pub relation vermoegenseinkuenfte_reichen_nicht_aus(kind: Person) kind empirical {
    label de official "Die Vermögenseinkünfte reichen für den Unterhalt des Kindes nicht aus (§ 1649 Abs. 1 Satz 2)";
    label en unofficial "the income from the assets does not suffice for the child's maintenance (§ 1649 (1) sentence 2)";
}
pub relation einkuenfte_aus_arbeit_oder_erwerbsgeschaeft(kind: Person) kind empirical {
    label de official "Einkünfte, die das Kind durch seine Arbeit oder durch den ihm nach § 112 gestatteten selbständigen Betrieb eines Erwerbsgeschäfts erwirbt (§ 1649 Abs. 1 Satz 2)";
    label en unofficial "income the child earns by its work or by an independent business permitted under § 112 (§ 1649 (1) sentence 2)";
}
pub relation einkuenfte_auch_fuer_den_unterhalt_des_kindes_nicht_benoetigt(kind: Person) kind empirical {
    label de official "Einkünfte, die zur ordnungsmäßigen Verwaltung des Vermögens UND für den Unterhalt des Kindes nicht benötigt werden (§ 1649 Abs. 2)";
    label en unofficial "income needed neither for the proper administration of the assets nor for the child's maintenance (§ 1649 (2))";
}
pub relation minderjaehriges_geschwister(kind: Person, geschwister: Person) kind empirical {
    label de official "Minderjähriges Geschwister des Kindes (§ 1649 Abs. 2)";
    label en unofficial "minor sibling of the child (§ 1649 (2))";
}

@source(BGB_P1649)
pub external judgment relation verwendung_entspricht_der_billigkeit(kind: Person) {
    authority Court;
    label de official "§ 1649 Abs. 2. Die Verwendung der Einkünfte für den eigenen Unterhalt der Eltern und den Unterhalt der minderjährigen Geschwister entspricht unter Berücksichtigung der Vermögens- und Erwerbsverhältnisse der Beteiligten der Billigkeit";
    label en unofficial "§ 1649 (2). Using the income for the parents' own maintenance and that of the minor siblings is equitable in view of the parties' financial circumstances";
}
@source(BGB_P1664)
pub external judgment relation sorgfalt_in_eigenen_angelegenheiten_verletzt(kind: Person, elternteil: Person) {
    authority Court;
    label de official "§ 1664 Abs. 1. Der Elternteil hat die Sorgfalt, die er in eigenen Angelegenheiten anzuwenden pflegt, bei der Ausübung der elterlichen Sorge nicht eingehalten";
    label en unofficial "§ 1664 (1). The parent failed to apply the care he customarily applies in his own affairs when exercising parental custody";
}
@source(BGB_P1666a)
pub external judgment relation gefahr_nur_durch_trennung_abwendbar(kind: Person) {
    authority Court;
    label de official "§ 1666a Abs. 1 Satz 1. Der Gefahr kann nicht auf andere Weise, auch nicht durch öffentliche Hilfen, begegnet werden";
    label en unofficial "§ 1666a (1) sentence 1. The danger cannot be met otherwise, including by public assistance";
}

pub relation vermoegenssorge_erstreckt_sich_nicht_auf_den_erwerb(kind: Person) kind institutional {
    label de official "Die Vermögenssorge erstreckt sich nicht auf das Vermögen, das das Kind erwirbt, wenn der Erblasser oder Zuwendende bestimmt hat, dass die Eltern es nicht verwalten sollen (§ 1638 Abs. 1, 2)";
    label en unofficial "Parental property care does not extend to assets the child acquires where the testator or donor determined that the parents are not to administer them (§ 1638 (1), (2))";
}
pub relation verwaltung_durch_den_anderen_elternteil(kind: Person, elternteil: Person) kind institutional {
    label de official "Ist bestimmt, dass ein Elternteil das Vermögen nicht verwalten soll, so verwaltet es der andere Elternteil und vertritt insoweit das Kind (§ 1638 Abs. 3)";
    label en unofficial "Where one parent is not to administer the assets, the other parent administers them and represents the child in that respect (§ 1638 (3))";
}
pub relation verwaltung_nach_den_anordnungen(kind: Person) kind institutional {
    label de official "Was das Kind von Todes wegen oder durch unentgeltliche Zuwendung erwirbt, haben die Eltern nach den getroffenen Anordnungen zu verwalten (§ 1639 Abs. 1)";
    label en unofficial "The parents must administer what the child acquires on death or by gratuitous disposition according to the directions given (§ 1639 (1))";
}
pub relation vermoegensverzeichnis_einzureichen(kind: Person) kind institutional {
    label de official "Die Eltern haben das ihrer Verwaltung unterliegende Vermögen zu verzeichnen, das Verzeichnis mit der Versicherung der Richtigkeit und Vollständigkeit zu versehen und dem Familiengericht einzureichen (§ 1640 Abs. 1)";
    label en unofficial "The parents must list the assets under their administration, certify the list as correct and complete and submit it to the family court (§ 1640 (1))";
}
pub relation verzeichnispflicht_entfaellt(kind: Person) kind institutional {
    label de official "Absatz 1 gilt nicht, wenn der Wert eines Vermögenserwerbs 15 000 Euro nicht übersteigt oder eine abweichende Anordnung getroffen ist (§ 1640 Abs. 2)";
    label en unofficial "Subsection (1) does not apply where the value of an acquisition does not exceed EUR 15,000 or a deviating direction was given (§ 1640 (2))";
}
pub relation aufnahme_des_verzeichnisses_durch_behoerde(kind: Person) kind institutional {
    label de official "Reichen die Eltern kein oder ein ungenügendes Verzeichnis ein, so kann das Familiengericht anordnen, dass das Verzeichnis durch eine zuständige Behörde, einen Beamten oder Notar aufgenommen wird (§ 1640 Abs. 3)";
    label en unofficial "Where no or an insufficient inventory is submitted, the family court may order it to be drawn up by a competent authority, official or notary (§ 1640 (3))";
}
pub relation schenkung_unzulaessig(kind: Person) kind institutional {
    label de official "Die Eltern können nicht in Vertretung des Kindes Schenkungen machen (§ 1641 Satz 1)";
    label en unofficial "The parents cannot make gifts in representation of the child (§ 1641 sentence 1)";
}
pub relation schenkung_ausgenommen(kind: Person) kind institutional {
    label de official "Ausgenommen sind Schenkungen, durch die einer sittlichen Pflicht oder einer auf den Anstand zu nehmenden Rücksicht entsprochen wird (§ 1641 Satz 2)";
    label en unofficial "Exempted are gifts corresponding to a moral duty or to considerations of decency (§ 1641 sentence 2)";
}
pub relation anlegungspflicht(kind: Person) kind institutional {
    label de official "Die Eltern haben das ihrer Verwaltung unterliegende Geld des Kindes nach den Grundsätzen einer wirtschaftlichen Vermögensverwaltung anzulegen, soweit es nicht zur Bestreitung von Ausgaben bereitzuhalten ist (§ 1642)";
    label en unofficial "The parents must invest the child's money under their administration according to the principles of economic asset management, unless it is to be kept available for expenses (§ 1642)";
}
pub relation genehmigung_des_familiengerichts_erforderlich_1643(kind: Person) kind institutional {
    label de official "Die Eltern bedürfen der Genehmigung des Familiengerichts in den Fällen, in denen ein Betreuer nach den §§ 1850 bis 1854 der Genehmigung bedarf (§ 1643 Abs. 1)";
    label en unofficial "The parents need the family court's approval in the cases in which a curator needs approval under §§ 1850 to 1854 (§ 1643 (1))";
}
pub relation ein_jahr_nach_der_volljaehrigkeit(kind: Person, tag: Date) kind institutional {
    label de official "Tag, ein Jahr nach dem Eintritt der Volljährigkeit des Kindes: die Grenze, jenseits deren ein Vertrag über wiederkehrende Leistungen genehmigungsbedürftig ist (§ 1643 Abs. 4 Satz 1)";
    label en unofficial "day one year after the child attains majority: the limit beyond which a contract on recurring performances requires approval (§ 1643 (4) sentence 1)";
}
pub relation genehmigung_nicht_erforderlich_1643(kind: Person) kind institutional {
    label de official "Ausnahmen von der Genehmigungsbedürftigkeit nach § 1643 Abs. 2 bis 5";
    label en unofficial "exceptions from the requirement of approval under § 1643 (2) to (5)";
}
pub relation genehmigung_wirksam(kind: Person) kind institutional {
    label de official "Das Familiengericht erteilt die Genehmigung, wenn das Rechtsgeschäft dem Wohl des Kindes unter Berücksichtigung der Grundsätze einer wirtschaftlichen Vermögensverwaltung nicht widerspricht; ist das Kind volljährig geworden, so tritt seine Genehmigung an die Stelle der Genehmigung des Familiengerichts (§ 1644 Abs. 1, Abs. 3 Satz 2)";
    label en unofficial "The family court grants the approval where the transaction does not conflict with the child's welfare; once the child is of age its own approval replaces the court's (§ 1644 (1), (3) sentence 2)";
}
pub relation anzeigepflicht_erwerbsgeschaeft(kind: Person) kind institutional {
    label de official "Die Eltern haben Beginn, Art und Umfang eines neuen Erwerbsgeschäfts im Namen des Kindes beim Familiengericht anzuzeigen (§ 1645)";
    label en unofficial "The parents must notify the family court of the beginning, nature and extent of a new business in the child's name (§ 1645)";
}
pub relation eigentum_geht_auf_das_kind_ueber(kind: Person) kind institutional {
    label de official "Erwerben die Eltern mit Mitteln des Kindes bewegliche Sachen, so geht mit dem Erwerb das Eigentum auf das Kind über, es sei denn, dass die Eltern nicht für Rechnung des Kindes erwerben wollen (§ 1646 Abs. 1, 2)";
    label en unofficial "Where the parents acquire movable things with the child's means, ownership passes to the child on acquisition unless they do not intend to acquire for the child's account (§ 1646 (1), (2))";
}
pub relation aufwendungsersatz(kind: Person, elternteil: Person) kind institutional {
    label de official "Machen die Eltern bei der Ausübung der Sorge Aufwendungen, die sie den Umständen nach für erforderlich halten dürfen, so können sie von dem Kind Ersatz verlangen, sofern nicht die Aufwendungen ihnen selbst zur Last fallen (§ 1648)";
    label en unofficial "Where the parents make expenses they may consider necessary, they may demand reimbursement from the child unless the expenses are borne by themselves (§ 1648)";
}
pub relation einkuenfte_fuer_den_unterhalt_des_kindes(kind: Person) kind institutional {
    label de official "Die Einkünfte des Kindesvermögens, die zur ordnungsmäßigen Verwaltung nicht benötigt werden, sind für den Unterhalt des Kindes zu verwenden (§ 1649 Abs. 1 Satz 1)";
    label en unofficial "Income from the child's assets not needed for proper administration must be used for the child's maintenance (§ 1649 (1) sentence 1)";
}
pub relation arbeitseinkuenfte_fuer_den_unterhalt(kind: Person) kind institutional {
    label de official "Soweit die Vermögenseinkünfte nicht ausreichen, können die Einkünfte aus Arbeit oder Erwerbsgeschäft verwendet werden (§ 1649 Abs. 1 Satz 2)";
    label en unofficial "Where the income from assets does not suffice, income from work or business may be used (§ 1649 (1) sentence 2)";
}
pub relation einkuenfte_fuer_eltern_und_geschwister(kind: Person, beguenstigter: Person) kind institutional {
    label de official "Die Eltern können die nicht benötigten Einkünfte für ihren eigenen Unterhalt und für den Unterhalt der minderjährigen Geschwister des Kindes verwenden, soweit dies der Billigkeit entspricht (§ 1649 Abs. 2)";
    label en unofficial "The parents may use income not needed for their own maintenance and that of the child's minor siblings where this is equitable (§ 1649 (2))";
}

@source(BGB_P1638) {
    rule VermoegenssorgeAusgeschlossen(k: Person, betrag: Money) strict {
        label de official "Die Vermögenssorge erstreckt sich nicht auf das Vermögen, welches das Kind erwirbt, wenn der Erblasser oder Zuwendende bestimmt hat, dass die Eltern es nicht verwalten sollen (§ 1638 Abs. 1)";
        label en unofficial "Parental property care does not extend to assets the child acquires where the testator or donor determined that the parents are not to administer them (§ 1638 (1))";
        when erwerb_von_todes_wegen_oder_unentgeltlich(k, betrag) and verwaltungsausschluss_bestimmt(k);
        then vermoegenssorge_erstreckt_sich_nicht_auf_den_erwerb(k);
    }
    rule SurrogatEbenfallsAusgeschlossen(k: Person) strict {
        label de official "Was das Kind auf Grund eines zu einem solchen Vermögen gehörenden Rechts, als Ersatz oder durch ein sich darauf beziehendes Rechtsgeschäft erwirbt, können die Eltern gleichfalls nicht verwalten (§ 1638 Abs. 2)";
        label en unofficial "What the child acquires by virtue of a right belonging to such assets, as substitute or by a related transaction, the parents likewise cannot administer (§ 1638 (2))";
        when surrogat_des_ausgeschlossenen_vermoegens(k);
        then vermoegenssorge_erstreckt_sich_nicht_auf_den_erwerb(k);
    }
    rule VerwaltungDurchDenAnderenElternteil(f: Familie, k: Person, e: Person, a: Person) strict {
        label de official "Ist bestimmt, dass ein Elternteil das Vermögen nicht verwalten soll, so verwaltet es der andere Elternteil; insoweit vertritt dieser das Kind (§ 1638 Abs. 3)";
        label en unofficial "Where one parent is not to administer the assets, the other parent administers them and represents the child in that respect (§ 1638 (3))";
        when verwaltungsausschluss_fuer_einen_elternteil(k, e) and elternteil(f, a, k) and a != e;
        then verwaltung_durch_den_anderen_elternteil(k, a);
    }
}

@source(BGB_P1639)
rule VerwaltungNachDenAnordnungen(k: Person, betrag: Money) strict {
    label de official "Was das Kind von Todes wegen, durch unentgeltliche Zuwendung auf den Todesfall oder unter Lebenden erwirbt, haben die Eltern nach den Anordnungen zu verwalten, die durch letztwillige Verfügung oder bei der Zuwendung getroffen worden sind (§ 1639 Abs. 1)";
    label en unofficial "The parents must administer what the child acquires on death or by gratuitous disposition according to the directions given by will or at the disposition (§ 1639 (1))";
    when erwerb_von_todes_wegen_oder_unentgeltlich(k, betrag) and anordnung_des_erblassers_oder_zuwendenden(k);
    then verwaltung_nach_den_anordnungen(k);
}

@source(BGB_P1640) {
    rule VerzeichnisEinzureichen(k: Person, betrag: Money) strict {
        label de official "Die Eltern haben das ihrer Verwaltung unterliegende Vermögen, welches das Kind von Todes wegen erwirbt, zu verzeichnen und dem Familiengericht einzureichen (§ 1640 Abs. 1); Absatz 1 gilt nicht, wenn der Wert 15 000 Euro nicht übersteigt (Abs. 2 Nr. 1)";
        label en unofficial "The parents must list assets acquired on death and submit the list to the family court (§ 1640 (1)); subsection (1) does not apply where the value does not exceed EUR 15,000 ((2) no. 1)";
        when erwerb_von_todes_wegen_oder_unentgeltlich(k, betrag) and betrag > 15000.00 EUR
         and not_known(abweichende_anordnung_zum_verzeichnis(k))
         and not_known(vermoegenssorge_erstreckt_sich_nicht_auf_den_erwerb(k));
        then vermoegensverzeichnis_einzureichen(k);
    }
    rule VerzeichnispflichtEntfaelltUnterDerSchwelle(k: Person, betrag: Money) strict {
        label de official "Absatz 1 gilt nicht, wenn der Wert eines Vermögenserwerbs 15 000 Euro nicht übersteigt (§ 1640 Abs. 2 Nr. 1): der Erwerb von genau 15 000 Euro ist ausgenommen";
        label en unofficial "Subsection (1) does not apply where the value of an acquisition does not exceed EUR 15,000 ((2) no. 1): an acquisition of exactly EUR 15,000 is exempt";
        when erwerb_von_todes_wegen_oder_unentgeltlich(k, betrag) and betrag <= 15000.00 EUR;
        then verzeichnispflicht_entfaellt(k);
    }
    rule VerzeichnispflichtEntfaelltBeiAnordnung(k: Person) strict {
        label de official "Absatz 1 gilt nicht, soweit der Erblasser oder der Zuwendende eine abweichende Anordnung getroffen hat (§ 1640 Abs. 2 Nr. 2)";
        label en unofficial "Subsection (1) does not apply insofar as the testator or donor gave a deviating direction ((2) no. 2)";
        when abweichende_anordnung_zum_verzeichnis(k);
        then verzeichnispflicht_entfaellt(k);
    }
    rule AufnahmeDurchBehoerde(k: Person) strict {
        label de official "Reichen die Eltern entgegen Absatz 1 kein Verzeichnis ein oder ist das eingereichte Verzeichnis ungenügend, so kann das Familiengericht anordnen, dass es durch eine zuständige Behörde, einen Beamten oder Notar aufgenommen wird (§ 1640 Abs. 3)";
        label en unofficial "Where no or an insufficient inventory is submitted, the family court may order it to be drawn up by a competent authority, official or notary (§ 1640 (3))";
        when vermoegensverzeichnis_einzureichen(k) and verzeichnis_nicht_oder_ungenuegend_eingereicht(k);
        then aufnahme_des_verzeichnisses_durch_behoerde(k);
    }
}

@source(BGB_P1641) {
    rule SchenkungUnzulaessig(k: Person) strict {
        label de official "Die Eltern können nicht in Vertretung des Kindes Schenkungen machen (§ 1641 Satz 1)";
        label en unofficial "The parents cannot make gifts in representation of the child (§ 1641 sentence 1)";
        when schenkung_in_vertretung_des_kindes(k) and not_known(schenkung_aus_sittlicher_pflicht_oder_anstand(k));
        then schenkung_unzulaessig(k);
    }
    rule SchenkungAusgenommen(k: Person) strict {
        label de official "Ausgenommen sind Schenkungen, durch die einer sittlichen Pflicht oder einer auf den Anstand zu nehmenden Rücksicht entsprochen wird (§ 1641 Satz 2)";
        label en unofficial "Exempted are gifts corresponding to a moral duty or to considerations of decency (§ 1641 sentence 2)";
        when schenkung_in_vertretung_des_kindes(k) and schenkung_aus_sittlicher_pflicht_oder_anstand(k);
        then schenkung_ausgenommen(k);
    }
}

@source(BGB_P1642)
rule Anlegungspflicht(k: Person) strict {
    label de official "Die Eltern haben das ihrer Verwaltung unterliegende Geld des Kindes nach den Grundsätzen einer wirtschaftlichen Vermögensverwaltung anzulegen, soweit es nicht zur Bestreitung von Ausgaben bereitzuhalten ist (§ 1642)";
    label en unofficial "The parents must invest the child's money under their administration according to the principles of economic asset management, unless it is to be kept available for expenses (§ 1642)";
    when geld_des_kindes_unterliegt_der_verwaltung(k) and not_known(geld_zur_bestreitung_von_ausgaben_bereitzuhalten(k));
    then anlegungspflicht(k);
}

@source(BGB_P1643) {
    rule GenehmigungNachDenBetreuungsvorschriften(k: Person) strict {
        label de official "Die Eltern bedürfen der Genehmigung des Familiengerichts in den Fällen, in denen ein Betreuer nach den §§ 1850 bis 1854 der Genehmigung des Betreuungsgerichts bedarf, soweit sich nicht aus den Absätzen 2 bis 5 etwas anderes ergibt (§ 1643 Abs. 1)";
        label en unofficial "The parents need the family court's approval in the cases in which a curator needs approval under §§ 1850 to 1854, unless subsections (2) to (5) provide otherwise (§ 1643 (1))";
        when betreuerrechtlich_genehmigungsbeduerftiges_geschaeft(k) and not_known(genehmigung_nicht_erforderlich_1643(k));
        then genehmigung_des_familiengerichts_erforderlich_1643(k);
    }
    rule KeineGenehmigungBeiGrundpfandrecht(k: Person) strict {
        label de official "Nicht genehmigungsbedürftig gemäß § 1850 sind Verfügungen über Grundpfandrechte sowie Verpflichtungen zu einer solchen Verfügung (§ 1643 Abs. 2)";
        label en unofficial "Dispositions of land charges and obligations to such dispositions do not require approval under § 1850 (§ 1643 (2))";
        when verfuegung_ueber_grundpfandrecht(k);
        then genehmigung_nicht_erforderlich_1643(k);
    }
    rule KeineGenehmigungBeiAusschlagung(k: Person, e: Person) strict {
        label de official "Tritt der Anfall einer Erbschaft an das Kind erst infolge der Ausschlagung eines Elternteils ein, so ist die Genehmigung abweichend von § 1851 Nummer 1 nur erforderlich, wenn der Elternteil neben dem Kind berufen war (§ 1643 Abs. 3 Satz 1)";
        label en unofficial "Where the devolution occurs only through a parent's disclaimer, approval is required only where the parent was called alongside the child (§ 1643 (3) sentence 1)";
        when anfall_infolge_ausschlagung_eines_elternteils(k, e) and not_known(elternteil_neben_dem_kind_berufen(k, e));
        then genehmigung_nicht_erforderlich_1643(k);
    }
    rule KeineGenehmigungBeiAuseinandersetzung(k: Person) strict {
        label de official "Ein Auseinandersetzungsvertrag und eine Vereinbarung, mit der das Kind aus einer Erbengemeinschaft ausscheidet, bedürfen keiner Genehmigung (§ 1643 Abs. 3 Satz 2)";
        label en unofficial "A partition agreement and an agreement by which the child leaves a community of heirs do not require approval (§ 1643 (3) sentence 2)";
        when auseinandersetzungsvertrag_oder_ausscheiden(k);
        then genehmigung_nicht_erforderlich_1643(k);
    }
    rule EinJahrNachDerVolljaehrigkeit(k: Person, v: Date) strict {
        label de official "Die Grenze des Absatzes 4 Satz 1 liegt ein Jahr nach dem Eintritt der Volljährigkeit des Kindes (§ 1643 Abs. 4 Satz 1)";
        label en unofficial "The limit of subsection (4) sentence 1 lies one year after the child attains majority (§ 1643 (4) sentence 1)";
        when volljaehrigkeit_eingetreten_am(k, v);
        then ein_jahr_nach_der_volljaehrigkeit(k, add_calendar_period(v, 1 calendar_year));
    }
    rule GenehmigungBeiLangemDauerschuldverhaeltnis(k: Person, g: Date, e: Date) strict {
        label de official "Die Eltern bedürfen abweichend von § 1853 Satz 1 Nummer 1 der Genehmigung zum Abschluss eines Vertrags über wiederkehrende Leistungen, wenn das Vertragsverhältnis länger als ein Jahr nach dem Eintritt der Volljährigkeit des Kindes fortdauern soll (§ 1643 Abs. 4 Satz 1)";
        label en unofficial "Approval is required for a contract on recurring performances continuing longer than one year after the child attains majority (§ 1643 (4) sentence 1)";
        when ein_jahr_nach_der_volljaehrigkeit(k, g) and dauerschuldvertrag_endet_am(k, e) and e > g
         and not_known(ausbildungs_dienst_oder_arbeitsvertrag(k))
         and not_known(geringe_wirtschaftliche_bedeutung(k))
         and not_known(kuendbar_bis_zum_ablauf_des_19_lebensjahres(k));
        then genehmigung_des_familiengerichts_erforderlich_1643(k);
    }
    rule KeineGenehmigungBeiArbeitsvertrag(k: Person) strict {
        label de official "Eine Genehmigung ist nicht erforderlich, wenn es sich um einen Ausbildungs-, Dienst- oder Arbeitsvertrag handelt (§ 1643 Abs. 4 Satz 2 Nr. 1)";
        label en unofficial "No approval is required where the contract is a training, service or employment contract ((4) sentence 2 no. 1)";
        when ausbildungs_dienst_oder_arbeitsvertrag(k);
        then genehmigung_nicht_erforderlich_1643(k);
    }
    rule KeineGenehmigungBeiGeringerBedeutung(k: Person) strict {
        label de official "Eine Genehmigung ist nicht erforderlich, wenn der Vertrag geringe wirtschaftliche Bedeutung für das Kind hat (§ 1643 Abs. 4 Satz 2 Nr. 2)";
        label en unofficial "No approval is required where the contract is of minor economic significance for the child ((4) sentence 2 no. 2)";
        when geringe_wirtschaftliche_bedeutung(k);
        then genehmigung_nicht_erforderlich_1643(k);
    }
    rule KeineGenehmigungBeiKuendbarkeit(k: Person) strict {
        label de official "Eine Genehmigung ist nicht erforderlich, wenn das Vertragsverhältnis vom Kind nach Eintritt der Volljährigkeit spätestens zum Ablauf des 19. Lebensjahres ohne eigene Nachteile gekündigt werden kann (§ 1643 Abs. 4 Satz 2 Nr. 3)";
        label en unofficial "No approval is required where the child may terminate the relationship at the latest by the end of its 19th year without disadvantage ((4) sentence 2 no. 3)";
        when kuendbar_bis_zum_ablauf_des_19_lebensjahres(k);
        then genehmigung_nicht_erforderlich_1643(k);
    }
}

@source(BGB_P1644) {
    rule GenehmigungDurchDasGericht(k: Person) strict {
        label de official "Das Familiengericht erteilt die Genehmigung, wenn das Rechtsgeschäft dem Wohl des Kindes unter Berücksichtigung der Grundsätze einer wirtschaftlichen Vermögensverwaltung nicht widerspricht (§ 1644 Abs. 1)";
        label en unofficial "The family court grants the approval where the transaction does not conflict with the child's welfare, having regard to the principles of economic asset management (§ 1644 (1))";
        when genehmigung_des_familiengerichts_erforderlich_1643(k) and genehmigung_des_gerichts_erteilt(k)
         and not_known(kind_volljaehrig_geworden(k));
        then genehmigung_wirksam(k);
    }
    rule GenehmigungDurchDasVolljaehrigeKind(k: Person) strict {
        label de official "Ist das Kind volljährig geworden, so tritt seine Genehmigung an die Stelle der Genehmigung des Familiengerichts (§ 1644 Abs. 3 Satz 2)";
        label en unofficial "Once the child has attained majority, its own approval replaces that of the family court (§ 1644 (3) sentence 2)";
        when genehmigung_des_familiengerichts_erforderlich_1643(k) and kind_volljaehrig_geworden(k);
        then genehmigung_wirksam(k);
    }
}

@source(BGB_P1645)
rule AnzeigepflichtErwerbsgeschaeft(k: Person) strict {
    label de official "Die Eltern haben Beginn, Art und Umfang eines neuen Erwerbsgeschäfts im Namen des Kindes beim Familiengericht anzuzeigen (§ 1645)";
    label en unofficial "The parents must notify the family court of the beginning, nature and extent of a new business in the child's name (§ 1645)";
    when neues_erwerbsgeschaeft_im_namen_des_kindes(k);
    then anzeigepflicht_erwerbsgeschaeft(k);
}

@source(BGB_P1646)
rule EigentumGehtAufDasKindUeber(k: Person) strict {
    label de official "Erwerben die Eltern mit Mitteln des Kindes bewegliche Sachen, so geht mit dem Erwerb das Eigentum auf das Kind über, es sei denn, dass die Eltern nicht für Rechnung des Kindes erwerben wollen (§ 1646 Abs. 1 Satz 1, Abs. 2)";
    label en unofficial "Where the parents acquire movable things with the child's means, ownership passes to the child unless they do not intend to acquire for the child's account (§ 1646 (1) sentence 1, (2))";
    when erwerb_mit_mitteln_des_kindes(k) and not_known(erwerb_nicht_fuer_rechnung_des_kindes(k));
    then eigentum_geht_auf_das_kind_ueber(k);
}

@source(BGB_P1648)
rule Aufwendungsersatz(k: Person, e: Person) strict {
    label de official "Machen die Eltern bei der Ausübung der Personensorge oder der Vermögenssorge Aufwendungen, die sie den Umständen nach für erforderlich halten dürfen, so können sie von dem Kind Ersatz verlangen, sofern nicht die Aufwendungen ihnen selbst zur Last fallen (§ 1648)";
    label en unofficial "Where the parents make expenses they may consider necessary, they may demand reimbursement from the child unless the expenses are borne by themselves (§ 1648)";
    when aufwendungen_bei_ausuebung_der_sorge(k, e) and not_known(aufwendungen_fallen_den_eltern_zur_last(k, e));
    then aufwendungsersatz(k, e);
}

@source(BGB_P1649) {
    rule EinkuenfteFuerDenUnterhaltDesKindes(k: Person) strict {
        label de official "Die Einkünfte des Kindesvermögens, die zur ordnungsmäßigen Verwaltung des Vermögens nicht benötigt werden, sind für den Unterhalt des Kindes zu verwenden (§ 1649 Abs. 1 Satz 1)";
        label en unofficial "Income from the child's assets not needed for the proper administration of the assets must be used for the child's maintenance (§ 1649 (1) sentence 1)";
        when vermoegenseinkuenfte_nicht_benoetigt(k);
        then einkuenfte_fuer_den_unterhalt_des_kindes(k);
    }
    rule ArbeitseinkuenfteFuerDenUnterhalt(k: Person) strict {
        label de official "Soweit die Vermögenseinkünfte nicht ausreichen, können die Einkünfte verwendet werden, die das Kind durch seine Arbeit oder durch den ihm nach § 112 gestatteten selbständigen Betrieb eines Erwerbsgeschäfts erwirbt (§ 1649 Abs. 1 Satz 2)";
        label en unofficial "Where the income from assets does not suffice, income from the child's work or permitted business may be used (§ 1649 (1) sentence 2)";
        when vermoegenseinkuenfte_reichen_nicht_aus(k) and einkuenfte_aus_arbeit_oder_erwerbsgeschaeft(k);
        then arbeitseinkuenfte_fuer_den_unterhalt(k);
    }
    rule EinkuenfteFuerDieEltern(f: Familie, k: Person, e: Person) strict {
        label de official "Die Eltern können die Einkünfte des Vermögens, die zur ordnungsmäßigen Verwaltung und für den Unterhalt des Kindes nicht benötigt werden, für ihren eigenen Unterhalt verwenden, soweit dies der Billigkeit entspricht (§ 1649 Abs. 2)";
        label en unofficial "The parents may use income not needed for administration or the child's maintenance for their own maintenance where equitable (§ 1649 (2))";
        when einkuenfte_auch_fuer_den_unterhalt_des_kindes_nicht_benoetigt(k) and elternteil(f, e, k)
         and verwendung_entspricht_der_billigkeit(k);
        then einkuenfte_fuer_eltern_und_geschwister(k, e);
    }
    rule EinkuenfteFuerDieGeschwister(k: Person, g: Person) strict {
        label de official "Die Eltern können die nicht benötigten Einkünfte auch für den Unterhalt der minderjährigen Geschwister des Kindes verwenden, soweit dies der Billigkeit entspricht (§ 1649 Abs. 2)";
        label en unofficial "The parents may also use income not needed for the maintenance of the child's minor siblings where equitable (§ 1649 (2))";
        when einkuenfte_auch_fuer_den_unterhalt_des_kindes_nicht_benoetigt(k) and minderjaehriges_geschwister(k, g)
         and verwendung_entspricht_der_billigkeit(k);
        then einkuenfte_fuer_eltern_und_geschwister(k, g);
    }
}

// --- § 1664 Beschränkte Haftung, § 1666a Verhältnismäßigkeit, § 1667 Vermögensgefährdung --------

pub relation schaden_bei_ausuebung_der_sorge(kind: Person, elternteil: Person) kind empirical {
    label de official "Bei der Ausübung der elterlichen Sorge ist dem Kind ein Schaden entstanden (§ 1664 Abs. 1)";
    label en unofficial "damage to the child arose in the exercise of parental custody (§ 1664 (1))";
}
pub relation beide_eltern_verantwortlich(kind: Person) kind empirical {
    label de official "Für den Schaden sind beide Eltern verantwortlich (§ 1664 Abs. 2)";
    label en unofficial "both parents are responsible for the damage (§ 1664 (2))";
}
pub relation massnahme_trennt_das_kind_von_der_familie(kind: Person, massnahme: Massnahme1666) kind empirical {
    label de official "Mit der Maßnahme ist eine Trennung des Kindes von der elterlichen Familie verbunden oder einem Elternteil soll die Nutzung der Familienwohnung untersagt werden (§ 1666a Abs. 1 Satz 1, 2)";
    label en unofficial "the measure entails separating the child from the parental family or prohibiting a parent from using the family home (§ 1666a (1) sentences 1, 2)";
}
pub relation andere_massnahmen_erfolglos_oder_unzureichend(kind: Person) kind empirical {
    label de official "Andere Maßnahmen sind erfolglos geblieben oder es ist anzunehmen, dass sie zur Abwendung der Gefahr nicht ausreichen (§ 1666a Abs. 2)";
    label en unofficial "other measures have failed or it is to be assumed that they will not suffice to avert the danger (§ 1666a (2))";
}
pub relation anordnung_des_verzeichnisses_und_der_rechnungslegung(kind: Person) kind empirical {
    label de official "Das Familiengericht ordnet an, dass die Eltern ein Verzeichnis des Vermögens einreichen und über die Verwaltung Rechnung legen (§ 1667 Abs. 1 Satz 1) — festgestellte Tatsache";
    label en unofficial "the family court orders the parents to submit an inventory and render account of the administration (§ 1667 (1) sentence 1) — adjudicated fact";
}
pub relation wertpapiere_im_vermoegen_des_kindes(kind: Person) kind empirical {
    label de official "Zum Vermögen des Kindes gehören Wertpapiere oder Wertgegenstände (§ 1667 Abs. 2 Satz 2)";
    label en unofficial "the child's assets include securities or valuables (§ 1667 (2) sentence 2)";
}
pub relation elternteil_gefaehrdet_das_vermoegen(kind: Person, elternteil: Person) kind empirical {
    label de official "Dieser Elternteil gefährdet das Vermögen des Kindes (§ 1667 Abs. 3 Satz 1)";
    label en unofficial "this parent endangers the child's assets (§ 1667 (3) sentence 1)";
}

pub enum Massnahme1667 {
    label de official "Gerichtliche Maßnahmen bei Gefährdung des Kindesvermögens (§ 1667 Abs. 1–3)";
    label en unofficial "judicial measures where the child's property is endangered (§ 1667 (1)–(3))";
    VerzeichnisUndRechnungslegung,
    AufnahmeDurchBehoerde,
    BestimmteAnlegungUndGenehmigungZurAbhebung,
    PflichtenWieEinBetreuerFuerWertpapiere,
    Sicherheitsleistung
}

pub relation haftung_nur_fuer_eigenuebliche_sorgfalt(kind: Person, elternteil: Person) kind institutional {
    label de official "Die Eltern haben bei der Ausübung der elterlichen Sorge dem Kind gegenüber nur für die Sorgfalt einzustehen, die sie in eigenen Angelegenheiten anzuwenden pflegen (§ 1664 Abs. 1)";
    label en unofficial "In exercising parental custody the parents are liable to the child only for the care they customarily apply in their own affairs (§ 1664 (1))";
}
pub relation gesamtschuldnerische_haftung_der_eltern(kind: Person) kind institutional {
    label de official "Sind für einen Schaden beide Eltern verantwortlich, so haften sie als Gesamtschuldner (§ 1664 Abs. 2)";
    label en unofficial "Where both parents are responsible for damage, they are liable as joint and several debtors (§ 1664 (2))";
}
pub relation trennungsmassnahme_zulaessig(kind: Person, massnahme: Massnahme1666) kind institutional {
    label de official "Maßnahmen, mit denen eine Trennung des Kindes von der elterlichen Familie verbunden ist, sind nur zulässig, wenn der Gefahr nicht auf andere Weise, auch nicht durch öffentliche Hilfen, begegnet werden kann (§ 1666a Abs. 1 Satz 1)";
    label en unofficial "Measures separating the child from the parental family are permissible only where the danger cannot be met otherwise, including by public assistance (§ 1666a (1) sentence 1)";
}
pub relation entziehung_der_gesamten_personensorge_zulaessig(kind: Person) kind institutional {
    label de official "Die gesamte Personensorge darf nur entzogen werden, wenn andere Maßnahmen erfolglos geblieben sind oder wenn anzunehmen ist, dass sie zur Abwendung der Gefahr nicht ausreichen (§ 1666a Abs. 2)";
    label en unofficial "The entire parental care may be withdrawn only where other measures have failed or are assumed to be insufficient (§ 1666a (2))";
}
pub relation massnahme_bei_vermoegensgefaehrdung(kind: Person, massnahme: Massnahme1667) kind institutional {
    label de official "Gerichtliche Maßnahmen bei Gefährdung des Kindesvermögens (§ 1667 Abs. 1–3)";
    label en unofficial "judicial measures where the child's property is endangered (§ 1667 (1)–(3))";
}
pub relation kosten_der_massnahme_traegt_der_elternteil(kind: Person, elternteil: Person) kind institutional {
    label de official "Die Kosten der angeordneten Maßnahmen trägt der Elternteil, der sie veranlasst hat (§ 1667 Abs. 4)";
    label en unofficial "The costs of the ordered measures are borne by the parent who caused them (§ 1667 (4))";
}

@source(BGB_P1664) {
    rule HaftungNurFuerEigenuebicheSorgfalt(k: Person, e: Person) strict {
        label de official "Die Eltern haben bei der Ausübung der elterlichen Sorge dem Kind gegenüber nur für die Sorgfalt einzustehen, die sie in eigenen Angelegenheiten anzuwenden pflegen (§ 1664 Abs. 1)";
        label en unofficial "In exercising parental custody the parents are liable to the child only for the care they customarily apply in their own affairs (§ 1664 (1))";
        when schaden_bei_ausuebung_der_sorge(k, e) and sorgfalt_in_eigenen_angelegenheiten_verletzt(k, e);
        then haftung_nur_fuer_eigenuebliche_sorgfalt(k, e);
    }
    rule GesamtschuldnerischeHaftung(k: Person) strict {
        label de official "Sind für einen Schaden beide Eltern verantwortlich, so haften sie als Gesamtschuldner (§ 1664 Abs. 2)";
        label en unofficial "Where both parents are responsible for damage, they are liable as joint and several debtors (§ 1664 (2))";
        when beide_eltern_verantwortlich(k);
        then gesamtschuldnerische_haftung_der_eltern(k);
    }
}

@source(BGB_P1666a) {
    rule TrennungsmassnahmeZulaessig(k: Person, m: Massnahme1666) strict {
        label de official "Maßnahmen, mit denen eine Trennung des Kindes von der elterlichen Familie verbunden ist, sind nur zulässig, wenn der Gefahr nicht auf andere Weise, auch nicht durch öffentliche Hilfen, begegnet werden kann (§ 1666a Abs. 1 Satz 1)";
        label en unofficial "Measures separating the child from the parental family are permissible only where the danger cannot be met otherwise, including by public assistance (§ 1666a (1) sentence 1)";
        when massnahme_trennt_das_kind_von_der_familie(k, m) and gefahr_nur_durch_trennung_abwendbar(k);
        then trennungsmassnahme_zulaessig(k, m);
    }
    rule EntziehungDerGesamtenPersonensorge(k: Person) strict {
        label de official "Die gesamte Personensorge darf nur entzogen werden, wenn andere Maßnahmen erfolglos geblieben sind oder wenn anzunehmen ist, dass sie zur Abwendung der Gefahr nicht ausreichen (§ 1666a Abs. 2)";
        label en unofficial "The entire parental care may be withdrawn only where other measures have failed or are assumed insufficient (§ 1666a (2))";
        when kindeswohl_gefaehrdet(k) and andere_massnahmen_erfolglos_oder_unzureichend(k);
        then entziehung_der_gesamten_personensorge_zulaessig(k);
    }
}

@source(BGB_P1667) {
    rule VerzeichnisUndRechnungslegung(k: Person, e: Person) strict {
        label de official "Das Familiengericht kann anordnen, dass die Eltern ein Verzeichnis des Vermögens des Kindes einreichen und über die Verwaltung Rechnung legen (§ 1667 Abs. 1 Satz 1)";
        label en unofficial "The family court may order the parents to submit an inventory of the child's assets and render account of the administration (§ 1667 (1) sentence 1)";
        when elternteil_gefaehrdet_das_vermoegen(k, e);
        then massnahme_bei_vermoegensgefaehrdung(k, VerzeichnisUndRechnungslegung);
    }
    rule AufnahmeDurchBehoerde1667(k: Person) strict {
        label de official "Ist das eingereichte Verzeichnis ungenügend, so kann das Familiengericht anordnen, dass es durch eine zuständige Behörde, einen Beamten oder Notar aufgenommen wird (§ 1667 Abs. 1 Satz 3)";
        label en unofficial "Where the inventory submitted is insufficient, the family court may order it to be drawn up by a competent authority, official or notary (§ 1667 (1) sentence 3)";
        when anordnung_des_verzeichnisses_und_der_rechnungslegung(k) and verzeichnis_nicht_oder_ungenuegend_eingereicht(k);
        then massnahme_bei_vermoegensgefaehrdung(k, AufnahmeDurchBehoerde);
    }
    rule BestimmteAnlegung(k: Person, e: Person) strict {
        label de official "Das Familiengericht kann anordnen, dass das Geld des Kindes in bestimmter Weise anzulegen und zur Abhebung seine Genehmigung erforderlich ist (§ 1667 Abs. 2 Satz 1)";
        label en unofficial "The family court may order that the child's money be invested in a particular way and that its approval be required for withdrawals (§ 1667 (2) sentence 1)";
        when elternteil_gefaehrdet_das_vermoegen(k, e) and geld_des_kindes_unterliegt_der_verwaltung(k);
        then massnahme_bei_vermoegensgefaehrdung(k, BestimmteAnlegungUndGenehmigungZurAbhebung);
    }
    rule PflichtenWieEinBetreuer(k: Person, e: Person) strict {
        label de official "Gehören Wertpapiere oder Wertgegenstände zum Vermögen des Kindes, so kann das Familiengericht dem Elternteil die gleichen Verpflichtungen auferlegen, die nach den §§ 1843 bis 1845 einem Betreuer obliegen (§ 1667 Abs. 2 Satz 2)";
        label en unofficial "Where the child's assets include securities or valuables, the family court may impose on the parent the duties of a curator under §§ 1843 to 1845 (§ 1667 (2) sentence 2)";
        when elternteil_gefaehrdet_das_vermoegen(k, e) and wertpapiere_im_vermoegen_des_kindes(k);
        then massnahme_bei_vermoegensgefaehrdung(k, PflichtenWieEinBetreuerFuerWertpapiere);
    }
    rule Sicherheitsleistung(k: Person, e: Person) strict {
        label de official "Das Familiengericht kann dem Elternteil, der das Vermögen des Kindes gefährdet, Sicherheitsleistung für das seiner Verwaltung unterliegende Vermögen auferlegen (§ 1667 Abs. 3 Satz 1)";
        label en unofficial "The family court may impose on the parent endangering the child's assets the provision of security for the assets under his administration (§ 1667 (3) sentence 1)";
        when elternteil_gefaehrdet_das_vermoegen(k, e);
        then massnahme_bei_vermoegensgefaehrdung(k, Sicherheitsleistung);
    }
    rule KostenDerMassnahme(k: Person, e: Person) strict {
        label de official "Die Kosten der angeordneten Maßnahmen trägt der Elternteil, der sie veranlasst hat (§ 1667 Abs. 4)";
        label en unofficial "The costs of the ordered measures are borne by the parent who caused them (§ 1667 (4))";
        when elternteil_gefaehrdet_das_vermoegen(k, e);
        then kosten_der_massnahme_traegt_der_elternteil(k, e);
    }
}

// --- §§ 1673–1682 Ruhen und Beendigung der elterlichen Sorge ------------------------------------

pub relation elternteil_geschaeftsunfaehig(kind: Person, elternteil: Person) kind empirical {
    label de official "Der Elternteil ist geschäftsunfähig (§ 1673 Abs. 1) — festgestellte Tatsache";
    label en unofficial "the parent lacks capacity to contract (§ 1673 (1)) — adjudicated fact";
}
pub relation ruhen_gerichtlich_festgestellt(kind: Person, elternteil: Person) kind empirical {
    label de official "Das Familiengericht stellt fest, dass der Elternteil auf längere Zeit die elterliche Sorge tatsächlich nicht ausüben kann (§ 1674 Abs. 1) — festgestellte Tatsache";
    label en unofficial "the family court finds that the parent is unable for a longer time actually to exercise parental custody (§ 1674 (1)) — adjudicated fact";
}
pub relation wegfall_des_ruhensgrundes_festgestellt(kind: Person, elternteil: Person) kind empirical {
    label de official "Das Familiengericht stellt fest, dass der Grund des Ruhens nicht mehr besteht (§ 1674 Abs. 2) — festgestellte Tatsache";
    label en unofficial "the family court finds that the ground for the suspension no longer exists (§ 1674 (2)) — adjudicated fact";
}
pub relation vertraulich_geboren(kind: Person) kind empirical {
    label de official "Das Kind ist nach § 25 Abs. 1 des Schwangerschaftskonfliktgesetzes vertraulich geboren (§ 1674a Satz 1)";
    label en unofficial "the child was born confidentially under § 25 (1) of the Pregnancy Conflict Act (§ 1674a sentence 1)";
}
pub relation angaben_fuer_den_geburtseintrag_gemacht(kind: Person, elternteil: Person) kind empirical {
    label de official "Das Familiengericht stellt fest, dass ein Elternteil ihm gegenüber die für den Geburtseintrag des Kindes erforderlichen Angaben gemacht hat (§ 1674a Satz 2) — festgestellte Tatsache";
    label en unofficial "the family court finds that a parent gave it the particulars required for the child's birth entry (§ 1674a sentence 2) — adjudicated fact";
}
pub relation fuer_tot_erklaert(kind: Person, elternteil: Person, tag: Date) kind empirical {
    label de official "Der Elternteil ist für tot erklärt oder seine Todeszeit ist nach dem Verschollenheitsgesetz festgestellt; der Tag gilt als Zeitpunkt des Todes (§ 1677) — festgestellte Tatsache";
    label en unofficial "the parent has been declared dead or the time of death established under the Missing Persons Act; the day counts as the time of death (§ 1677) — adjudicated fact";
}
pub relation elternteil_tatsaechlich_verhindert(kind: Person, elternteil: Person) kind empirical {
    label de official "Der Elternteil ist tatsächlich verhindert, die elterliche Sorge auszuüben (§ 1678 Abs. 1, § 1693)";
    label en unofficial "the parent is actually prevented from exercising parental custody (§ 1678 (1), § 1693)";
}
pub relation keine_aussicht_auf_wegfall_des_ruhensgrundes(kind: Person, elternteil: Person) kind empirical {
    label de official "Es besteht keine Aussicht, dass der Grund des Ruhens wegfallen werde (§ 1678 Abs. 2)";
    label en unofficial "there is no prospect that the ground for the suspension will cease (§ 1678 (2))";
}
pub relation elternteil_gestorben(kind: Person, elternteil: Person) kind empirical {
    label de official "Der Elternteil ist gestorben (§ 1680 Abs. 1, 2)";
    label en unofficial "the parent has died (§ 1680 (1), (2))";
}
pub relation sorge_entzogen(kind: Person, elternteil: Person) kind empirical {
    label de official "Dem Elternteil ist die elterliche Sorge entzogen worden (§ 1680 Abs. 3) — festgestellte Tatsache";
    label en unofficial "parental custody has been withdrawn from the parent (§ 1680 (3)) — adjudicated fact";
}
pub relation fuer_tot_erklaerter_elternteil_lebt(kind: Person, elternteil: Person) kind empirical {
    label de official "Der für tot erklärte Elternteil lebt noch und beantragt die Rückübertragung der elterlichen Sorge (§ 1681 Abs. 2)";
    label en unofficial "the parent declared dead is still alive and applies for the retransfer of parental custody (§ 1681 (2))";
}
pub relation kind_lebte_lange_im_haushalt_mit_ehegatten(kind: Person, bezugsperson: Person) kind empirical {
    label de official "Das Kind hat seit längerer Zeit in einem Haushalt mit einem Elternteil und dessen Ehegatten, Lebenspartner oder einer nach § 1685 Abs. 1 umgangsberechtigten volljährigen Person gelebt (§ 1682 Satz 1, 2)";
    label en unofficial "the child has lived for a longer time in a household with a parent and that parent's spouse, partner or an adult entitled to contact under § 1685 (1) (§ 1682 sentences 1, 2)";
}
pub relation wegnahme_beabsichtigt(kind: Person, elternteil: Person) kind empirical {
    label de official "Der andere Elternteil, der den Aufenthalt des Kindes nunmehr allein bestimmen kann, will das Kind wegnehmen (§ 1682 Satz 1)";
    label en unofficial "the other parent, now able to determine the child's residence alone, wants to remove the child (§ 1682 sentence 1)";
}

@source(BGB_P1682)
pub external judgment relation kindeswohl_durch_wegnahme_gefaehrdet(kind: Person, bezugsperson: Person) {
    authority Court;
    label de official "§ 1682 Satz 1. Das Kindeswohl würde durch die Wegnahme gefährdet";
    label en unofficial "§ 1682 sentence 1. The child's welfare would be endangered by the removal";
}
@source(BGB_P1678)
pub external judgment relation uebertragung_widerspricht_dem_kindeswohl(kind: Person, elternteil: Person) {
    authority Court;
    label de official "§ 1678 Abs. 2, § 1680 Abs. 2, § 1681 Abs. 2. Die Übertragung der elterlichen Sorge auf den anderen Elternteil widerspricht dem Wohl des Kindes";
    label en unofficial "§ 1678 (2), § 1680 (2), § 1681 (2). Transferring parental custody to the other parent conflicts with the child's welfare";
}

pub relation elterliche_sorge_ruht(kind: Person, elternteil: Person) kind institutional {
    label de official "Die elterliche Sorge eines Elternteils ruht (§§ 1673, 1674, 1674a)";
    label en unofficial "the parental custody of a parent is suspended (§§ 1673, 1674, 1674a)";
}
pub relation personensorge_neben_dem_vertreter(kind: Person, elternteil: Person) kind institutional {
    label de official "Ist der Elternteil in der Geschäftsfähigkeit beschränkt, so steht ihm die Personensorge neben dem gesetzlichen Vertreter des Kindes zu; zur Vertretung des Kindes ist er nicht berechtigt (§ 1673 Abs. 2 Satz 2)";
    label en unofficial "Where the parent has limited capacity, parental care belongs to him alongside the child's legal representative; he is not entitled to represent the child (§ 1673 (2) sentence 2)";
}
pub relation elterliche_sorge_lebt_wieder_auf(kind: Person, elternteil: Person) kind institutional {
    label de official "Die elterliche Sorge lebt wieder auf, wenn das Familiengericht feststellt, dass der Grund des Ruhens nicht mehr besteht (§ 1674 Abs. 2, § 1674a Satz 2)";
    label en unofficial "Parental custody revives where the family court finds that the ground for the suspension no longer exists (§ 1674 (2), § 1674a sentence 2)";
}
pub relation sorge_nicht_auszuueben(kind: Person, elternteil: Person) kind institutional {
    label de official "Solange die elterliche Sorge ruht, ist ein Elternteil nicht berechtigt, sie auszuüben (§ 1675)";
    label en unofficial "As long as parental custody is suspended, a parent is not entitled to exercise it (§ 1675)";
}
pub relation elterliche_sorge_endet(kind: Person, elternteil: Person, tag: Date) kind institutional {
    label de official "Die elterliche Sorge eines Elternteils endet mit dem Zeitpunkt, der als Zeitpunkt des Todes gilt (§ 1677)";
    label en unofficial "The parental custody of a parent ends at the time deemed to be the time of death (§ 1677)";
}
pub relation anderer_elternteil_uebt_die_sorge_allein_aus(kind: Person, elternteil: Person) kind institutional {
    label de official "Ist ein Elternteil tatsächlich verhindert oder ruht seine elterliche Sorge, so übt der andere Teil die elterliche Sorge allein aus (§ 1678 Abs. 1)";
    label en unofficial "Where a parent is actually prevented or his custody is suspended, the other exercises parental custody alone (§ 1678 (1))";
}
pub relation sorge_dem_ueberlebenden_elternteil_zu_uebertragen(kind: Person, elternteil: Person) kind institutional {
    label de official "Das Familiengericht hat die elterliche Sorge dem anderen Elternteil zu übertragen, wenn dies dem Wohl des Kindes nicht widerspricht (§ 1678 Abs. 2, § 1680 Abs. 2, § 1681)";
    label en unofficial "The family court must transfer parental custody to the other parent where this does not conflict with the child's welfare (§ 1678 (2), § 1680 (2), § 1681)";
}
pub relation sorge_steht_dem_ueberlebenden_elternteil_zu(kind: Person, elternteil: Person) kind institutional {
    label de official "Stand die elterliche Sorge den Eltern gemeinsam zu und ist ein Elternteil gestorben, so steht die elterliche Sorge dem überlebenden Elternteil zu (§ 1680 Abs. 1)";
    label en unofficial "Where the parents held custody jointly and one has died, parental custody belongs to the surviving parent (§ 1680 (1))";
}
pub relation verbleibensanordnung(kind: Person, bezugsperson: Person) kind institutional {
    label de official "Das Familiengericht kann anordnen, dass das Kind bei der Bezugsperson verbleibt, wenn und solange das Kindeswohl durch die Wegnahme gefährdet würde (§ 1682)";
    label en unofficial "The family court may order that the child remain with the attachment figure if and as long as removal would endanger the child's welfare (§ 1682)";
}

@source(BGB_P1673) {
    rule RuhenBeiGeschaeftsunfaehigkeit(k: Person, e: Person) strict {
        label de official "Die elterliche Sorge eines Elternteils ruht, wenn er geschäftsunfähig ist (§ 1673 Abs. 1)";
        label en unofficial "The parental custody of a parent is suspended where he lacks capacity to contract (§ 1673 (1))";
        when elternteil_geschaeftsunfaehig(k, e);
        then elterliche_sorge_ruht(k, e);
    }
    rule PersonensorgeNebenDemVertreter(k: Person, e: Person) strict {
        label de official "Ist der Elternteil in der Geschäftsfähigkeit beschränkt, so ruht seine elterliche Sorge ebenfalls; die Personensorge steht ihm neben dem gesetzlichen Vertreter des Kindes zu, zur Vertretung ist er nicht berechtigt (§ 1673 Abs. 2 Satz 1, 2)";
        label en unofficial "Where the parent has limited capacity his custody is likewise suspended; parental care belongs to him alongside the legal representative, but not representation (§ 1673 (2) sentences 1, 2)";
        when elternteil_beschraenkt_geschaeftsfaehig(k, e);
        then personensorge_neben_dem_vertreter(k, e);
    }
    rule RuhenBeiBeschraenkterGeschaeftsfaehigkeit(k: Person, e: Person) strict {
        label de official "Das Gleiche gilt, wenn der Elternteil in der Geschäftsfähigkeit beschränkt ist (§ 1673 Abs. 2 Satz 1)";
        label en unofficial "The same applies where the parent has limited capacity to contract (§ 1673 (2) sentence 1)";
        when elternteil_beschraenkt_geschaeftsfaehig(k, e);
        then elterliche_sorge_ruht(k, e);
    }
}

@source(BGB_P1674) {
    rule RuhenBeiTatsaechlichemHindernis(k: Person, e: Person) strict {
        label de official "Die elterliche Sorge eines Elternteils ruht, wenn das Familiengericht feststellt, dass er auf längere Zeit die elterliche Sorge tatsächlich nicht ausüben kann (§ 1674 Abs. 1)";
        label en unofficial "Parental custody is suspended where the family court finds that the parent is unable for a longer time actually to exercise it (§ 1674 (1))";
        when ruhen_gerichtlich_festgestellt(k, e) and not_known(wegfall_des_ruhensgrundes_festgestellt(k, e));
        then elterliche_sorge_ruht(k, e);
    }
    rule SorgeLebtWiederAuf(k: Person, e: Person) strict {
        label de official "Die elterliche Sorge lebt wieder auf, wenn das Familiengericht feststellt, dass der Grund des Ruhens nicht mehr besteht (§ 1674 Abs. 2)";
        label en unofficial "Parental custody revives where the family court finds that the ground for the suspension no longer exists (§ 1674 (2))";
        when ruhen_gerichtlich_festgestellt(k, e) and wegfall_des_ruhensgrundes_festgestellt(k, e);
        then elterliche_sorge_lebt_wieder_auf(k, e);
    }
}

@source(BGB_P1674a) {
    rule RuhenBeiVertraulicherGeburt(f: Familie, k: Person, e: Person) strict {
        label de official "Die elterliche Sorge der Eltern für ein vertraulich geborenes Kind ruht (§ 1674a Satz 1)";
        label en unofficial "The parental custody of the parents of a confidentially born child is suspended (§ 1674a sentence 1)";
        when vertraulich_geboren(k) and elternteil(f, e, k) and not_known(angaben_fuer_den_geburtseintrag_gemacht(k, e));
        then elterliche_sorge_ruht(k, e);
    }
    rule SorgeLebtNachAngabenWiederAuf(k: Person, e: Person) strict {
        label de official "Die elterliche Sorge lebt wieder auf, wenn das Familiengericht feststellt, dass ein Elternteil ihm gegenüber die für den Geburtseintrag erforderlichen Angaben gemacht hat (§ 1674a Satz 2)";
        label en unofficial "Parental custody revives where the family court finds that a parent gave it the particulars required for the birth entry (§ 1674a sentence 2)";
        when vertraulich_geboren(k) and angaben_fuer_den_geburtseintrag_gemacht(k, e);
        then elterliche_sorge_lebt_wieder_auf(k, e);
    }
}

@source(BGB_P1675)
rule WirkungDesRuhens(k: Person, e: Person) strict {
    label de official "Solange die elterliche Sorge ruht, ist ein Elternteil nicht berechtigt, sie auszuüben (§ 1675)";
    label en unofficial "As long as parental custody is suspended, a parent is not entitled to exercise it (§ 1675)";
    when elterliche_sorge_ruht(k, e);
    then sorge_nicht_auszuueben(k, e);
}

@source(BGB_P1677)
rule BeendigungDurchTodeserklaerung(k: Person, e: Person, t: Date) strict {
    label de official "Die elterliche Sorge eines Elternteils endet, wenn er für tot erklärt oder seine Todeszeit nach den Vorschriften des Verschollenheitsgesetzes festgestellt wird, mit dem Zeitpunkt, der als Zeitpunkt des Todes gilt (§ 1677)";
    label en unofficial "Parental custody ends where the parent is declared dead or the time of death is established, at the time deemed to be the time of death (§ 1677)";
    when fuer_tot_erklaert(k, e, t);
    then elterliche_sorge_endet(k, e, t);
}

@source(BGB_P1678) {
    rule AndererElternteilUebtAllein(f: Familie, k: Person, e: Person, a: Person) strict {
        label de official "Ist ein Elternteil tatsächlich verhindert, die elterliche Sorge auszuüben, oder ruht seine elterliche Sorge, so übt der andere Teil die elterliche Sorge allein aus (§ 1678 Abs. 1)";
        label en unofficial "Where a parent is actually prevented or his custody is suspended, the other exercises parental custody alone (§ 1678 (1))";
        when elternteil_tatsaechlich_verhindert(k, e) and elternteil(f, a, k) and a != e
         and elterliche_sorge_gemeinsam(k);
        then anderer_elternteil_uebt_die_sorge_allein_aus(k, a);
    }
    rule AndererElternteilUebtAlleinBeiRuhen(f: Familie, k: Person, e: Person, a: Person) strict {
        label de official "Dasselbe gilt, wenn die elterliche Sorge des einen Elternteils ruht (§ 1678 Abs. 1)";
        label en unofficial "The same applies where the custody of one parent is suspended (§ 1678 (1))";
        when elterliche_sorge_ruht(k, e) and elternteil(f, a, k) and a != e and elterliche_sorge_gemeinsam(k);
        then anderer_elternteil_uebt_die_sorge_allein_aus(k, a);
    }
    rule UebertragungBeiDauerhaftemRuhen(f: Familie, k: Person, e: Person, a: Person) strict {
        label de official "Ruht die elterliche Sorge des allein sorgeberechtigten Elternteils und besteht keine Aussicht auf Wegfall des Grundes, so hat das Familiengericht die elterliche Sorge dem anderen Elternteil zu übertragen, wenn dies dem Wohl des Kindes nicht widerspricht (§ 1678 Abs. 2)";
        label en unofficial "Where the sole custodial parent's custody is suspended with no prospect of change, the court must transfer custody to the other parent unless this conflicts with the child's welfare (§ 1678 (2))";
        when elterliche_sorge_ruht(k, e) and elterliche_sorge_allein(k, e) and keine_aussicht_auf_wegfall_des_ruhensgrundes(k, e)
         and elternteil(f, a, k) and a != e and not_known(uebertragung_widerspricht_dem_kindeswohl(k, a));
        then sorge_dem_ueberlebenden_elternteil_zu_uebertragen(k, a);
    }
}

@source(BGB_P1680) {
    rule SorgeDesUeberlebendenElternteils(f: Familie, k: Person, e: Person, a: Person) strict {
        label de official "Stand die elterliche Sorge den Eltern gemeinsam zu und ist ein Elternteil gestorben, so steht die elterliche Sorge dem überlebenden Elternteil zu (§ 1680 Abs. 1)";
        label en unofficial "Where the parents held custody jointly and one has died, parental custody belongs to the surviving parent (§ 1680 (1))";
        when elterliche_sorge_gemeinsam(k) and elternteil_gestorben(k, e) and elternteil(f, a, k) and a != e;
        then sorge_steht_dem_ueberlebenden_elternteil_zu(k, a);
    }
    rule UebertragungNachTodDesAlleinsorgeberechtigten(f: Familie, k: Person, e: Person, a: Person) strict {
        label de official "Ist ein Elternteil, dem die elterliche Sorge allein zustand, gestorben, so hat das Familiengericht die elterliche Sorge dem überlebenden Elternteil zu übertragen, wenn dies dem Wohl des Kindes nicht widerspricht (§ 1680 Abs. 2)";
        label en unofficial "Where a sole custodial parent has died, the court must transfer custody to the surviving parent unless this conflicts with the child's welfare (§ 1680 (2))";
        when elterliche_sorge_allein(k, e) and elternteil_gestorben(k, e) and elternteil(f, a, k) and a != e
         and not_known(uebertragung_widerspricht_dem_kindeswohl(k, a));
        then sorge_dem_ueberlebenden_elternteil_zu_uebertragen(k, a);
    }
    rule UebertragungBeiEntziehung(f: Familie, k: Person, e: Person, a: Person) strict {
        label de official "Die Absätze 1 und 2 gelten entsprechend, soweit einem Elternteil die elterliche Sorge entzogen wird (§ 1680 Abs. 3)";
        label en unofficial "Subsections (1) and (2) apply accordingly where custody is withdrawn from a parent (§ 1680 (3))";
        when sorge_entzogen(k, e) and elternteil(f, a, k) and a != e and elterliche_sorge_gemeinsam(k);
        then sorge_steht_dem_ueberlebenden_elternteil_zu(k, a);
    }
}

@source(BGB_P1681) {
    rule TodeserklaerungWirktWieDerTod(f: Familie, k: Person, e: Person, a: Person, t: Date) strict {
        label de official "§ 1680 Abs. 1 und 2 gilt entsprechend, wenn die elterliche Sorge eines Elternteils endet, weil er für tot erklärt oder seine Todeszeit festgestellt worden ist (§ 1681 Abs. 1)";
        label en unofficial "§ 1680 (1) and (2) apply accordingly where custody ends because the parent was declared dead or the time of death established (§ 1681 (1))";
        when elterliche_sorge_endet(k, e, t) and elternteil(f, a, k) and a != e and elterliche_sorge_gemeinsam(k);
        then sorge_steht_dem_ueberlebenden_elternteil_zu(k, a);
    }
    rule RueckuebertragungAnDenLebenden(k: Person, e: Person) strict {
        label de official "Lebt dieser Elternteil noch, so hat ihm das Familiengericht auf Antrag die elterliche Sorge in dem Umfang zu übertragen, in dem sie ihm vor dem nach § 1677 maßgebenden Zeitpunkt zustand, wenn dies dem Wohl des Kindes nicht widerspricht (§ 1681 Abs. 2)";
        label en unofficial "Where that parent is still alive, the court must on application retransfer custody to the extent he held it before, unless this conflicts with the child's welfare (§ 1681 (2))";
        when fuer_tot_erklaerter_elternteil_lebt(k, e) and not_known(uebertragung_widerspricht_dem_kindeswohl(k, e));
        then sorge_dem_ueberlebenden_elternteil_zu_uebertragen(k, e);
    }
}

@source(BGB_P1682)
rule Verbleibensanordnung(k: Person, b: Person, e: Person) strict {
    label de official "Hat das Kind seit längerer Zeit in einem Haushalt mit einem Elternteil und dessen Ehegatten gelebt und will der andere Elternteil das Kind wegnehmen, so kann das Familiengericht anordnen, dass das Kind bei dem Ehegatten verbleibt, wenn und solange das Kindeswohl durch die Wegnahme gefährdet würde (§ 1682)";
    label en unofficial "Where the child has lived for a longer time in a household with a parent and that parent's spouse and the other parent wants to remove it, the court may order that the child remain with the spouse if and as long as removal would endanger the child's welfare (§ 1682)";
    when kind_lebte_lange_im_haushalt_mit_ehegatten(k, b) and wegnahme_beabsichtigt(k, e)
     and kindeswohl_durch_wegnahme_gefaehrdet(k, b);
    then verbleibensanordnung(k, b);
}

// --- §§ 1685–1688 Umgang und Befugnisse weiterer Personen ---------------------------------------

pub relation grosselternteil_oder_geschwister(kind: Person, person: Person) kind empirical {
    label de official "Großelternteil oder Geschwister des Kindes (§ 1685 Abs. 1)";
    label en unofficial "grandparent or sibling of the child (§ 1685 (1))";
}
pub relation enge_bezugsperson(kind: Person, person: Person) kind empirical {
    label de official "Enge Bezugsperson des Kindes, die für das Kind tatsächliche Verantwortung trägt oder getragen hat (§ 1685 Abs. 2 Satz 1)";
    label en unofficial "close attachment figure who bears or has borne actual responsibility for the child (§ 1685 (2) sentence 1)";
}
pub relation laengere_haeusliche_gemeinschaft(kind: Person, person: Person) kind empirical {
    label de official "Die Person hat mit dem Kind längere Zeit in häuslicher Gemeinschaft zusammengelebt (§ 1685 Abs. 2 Satz 2)";
    label en unofficial "the person lived with the child in domestic community for a longer time (§ 1685 (2) sentence 2)";
}
pub relation tatsaechliche_verantwortung_widerlegt(kind: Person, person: Person) kind empirical {
    label de official "Der Zweifel ist ausgeräumt: eine Übernahme tatsächlicher Verantwortung liegt trotz der häuslichen Gemeinschaft nicht vor (Widerlegung der Regelannahme des § 1685 Abs. 2 Satz 2)";
    label en unofficial "the assumption of § 1685 (2) sentence 2 is rebutted: no actual responsibility was assumed despite the domestic community";
}
pub relation auskunft_ueber_die_persoenlichen_verhaeltnisse_verlangt(kind: Person, fragender: Person) kind empirical {
    label de official "Der Elternteil oder der leibliche Vater verlangt Auskunft über die persönlichen Verhältnisse des Kindes (§ 1686, § 1686a Abs. 1 Nr. 2)";
    label en unofficial "the parent or biological father demands information on the child's personal circumstances (§ 1686, § 1686a (1) no. 2)";
}
pub relation leiblicher_nicht_rechtlicher_vater(kind: Person, mann: Person) kind empirical {
    label de official "Der leibliche, nicht rechtliche Vater des Kindes, solange die Vaterschaft eines anderen Mannes besteht (§ 1686a Abs. 1)";
    label en unofficial "the biological but not legal father of the child, as long as another man's paternity exists (§ 1686a (1))";
}
pub relation kind_haelt_sich_beim_nicht_sorgeberechtigten_auf(kind: Person, elternteil: Person) kind empirical {
    label de official "Das Kind hält sich mit Einwilligung des Sorgeberechtigten oder auf Grund einer gerichtlichen Entscheidung bei diesem nicht sorgeberechtigten Elternteil auf (§ 1687a)";
    label en unofficial "the child stays with this non-custodial parent with the consent of the custodian or on the basis of a court decision (§ 1687a)";
}
pub relation ehegatte_des_alleinsorgeberechtigten(kind: Person, ehegatte: Person) kind empirical {
    label de official "Der Ehegatte eines allein sorgeberechtigten Elternteils, der nicht Elternteil des Kindes ist (§ 1687b Abs. 1)";
    label en unofficial "the spouse of a sole custodial parent who is not a parent of the child (§ 1687b (1))";
}
pub relation ehegatten_leben_getrennt(kind: Person, ehegatte: Person) kind empirical {
    label de official "Die Ehegatten leben nicht nur vorübergehend getrennt: die Befugnisse nach § 1687b Abs. 1 bestehen nicht (Abs. 4)";
    label en unofficial "the spouses live apart other than temporarily: the powers under § 1687b (1) do not exist ((4))";
}
pub relation befugnisse_gerichtlich_eingeschraenkt(kind: Person, person: Person) kind empirical {
    label de official "Das Familiengericht hat die Befugnisse eingeschränkt oder ausgeschlossen (§ 1687b Abs. 3, § 1688 Abs. 3 Satz 2) — festgestellte Tatsache";
    label en unofficial "the family court restricted or excluded the powers (§ 1687b (3), § 1688 (3) sentence 2) — adjudicated fact";
}
pub relation sorgeberechtigter_erklaert_etwas_anderes(kind: Person, pflegeperson: Person) kind empirical {
    label de official "Der Inhaber der elterlichen Sorge erklärt etwas anderes: die Befugnisse der Pflegeperson bestehen nicht (§ 1688 Abs. 3 Satz 1)";
    label en unofficial "the holder of parental custody declares otherwise: the carer's powers do not exist (§ 1688 (3) sentence 1)";
}

@source(BGB_P1685)
pub external judgment relation umgang_dient_dem_wohl_des_kindes(kind: Person, person: Person) {
    authority Court;
    label de official "§ 1685 Abs. 1, § 1686a Abs. 1 Nr. 1. Der Umgang dient dem Wohl des Kindes";
    label en unofficial "§ 1685 (1), § 1686a (1) no. 1. The contact serves the child's welfare";
}
@source(BGB_P1686)
pub external judgment relation berechtigtes_interesse_an_der_auskunft(kind: Person, fragender: Person) {
    authority Court;
    label de official "§ 1686, § 1686a Abs. 1 Nr. 2. Der Fragende hat ein berechtigtes Interesse an der Auskunft und die Auskunft widerspricht dem Wohl des Kindes nicht";
    label en unofficial "§ 1686, § 1686a (1) no. 2. The person asking has a legitimate interest and the information does not conflict with the child's welfare";
}
@source(BGB_P1686a)
pub external judgment relation ernsthaftes_interesse_am_kind_gezeigt(kind: Person, mann: Person) {
    authority Court;
    label de official "§ 1686a Abs. 1. Der leibliche Vater hat ernsthaftes Interesse an dem Kind gezeigt";
    label en unofficial "§ 1686a (1). The biological father has shown serious interest in the child";
}

pub relation sozial_familiaere_beziehung_1685(kind: Person, person: Person) kind institutional {
    label de official "Eine Übernahme tatsächlicher Verantwortung ist in der Regel anzunehmen, wenn die Person mit dem Kind längere Zeit in häuslicher Gemeinschaft zusammengelebt hat (§ 1685 Abs. 2 Satz 2)";
    label en unofficial "The assumption of actual responsibility is as a rule to be presumed where the person lived with the child in domestic community for a longer time (§ 1685 (2) sentence 2)";
}
pub relation umgangsrecht_der_bezugsperson(kind: Person, person: Person) kind institutional {
    label de official "Großeltern, Geschwister und enge Bezugspersonen haben ein Recht auf Umgang mit dem Kind, wenn dieser dem Wohl des Kindes dient (§ 1685 Abs. 1, 2)";
    label en unofficial "Grandparents, siblings and close attachment figures have a right of contact where this serves the child's welfare (§ 1685 (1), (2))";
}
pub relation auskunftsanspruch_ueber_das_kind(kind: Person, fragender: Person) kind institutional {
    label de official "Jeder Elternteil kann vom anderen Elternteil bei berechtigtem Interesse Auskunft über die persönlichen Verhältnisse des Kindes verlangen, soweit dies dem Wohl des Kindes nicht widerspricht (§ 1686, § 1686a Abs. 1 Nr. 2)";
    label en unofficial "Each parent may demand information on the child's personal circumstances from the other where there is a legitimate interest and this does not conflict with the child's welfare (§ 1686, § 1686a (1) no. 2)";
}
pub relation umgangsrecht_des_leiblichen_vaters(kind: Person, mann: Person) kind institutional {
    label de official "Solange die Vaterschaft eines anderen Mannes besteht, hat der leibliche Vater, der ernsthaftes Interesse an dem Kind gezeigt hat, ein Recht auf Umgang, wenn der Umgang dem Kindeswohl dient (§ 1686a Abs. 1 Nr. 1)";
    label en unofficial "As long as another man's paternity exists, the biological father who has shown serious interest has a right of contact where it serves the child's welfare (§ 1686a (1) no. 1)";
}
pub relation entscheidungsbefugnis_des_nicht_sorgeberechtigten(kind: Person, elternteil: Person) kind institutional {
    label de official "Für jeden Elternteil, der nicht Inhaber der elterlichen Sorge ist und bei dem sich das Kind aufhält, gilt § 1687 Abs. 1 Satz 4 und 5 und Abs. 2 entsprechend (§ 1687a)";
    label en unofficial "For each non-custodial parent with whom the child stays, § 1687 (1) sentences 4 and 5 and (2) apply accordingly (§ 1687a)";
}
pub relation mitentscheidungsbefugnis_des_ehegatten(kind: Person, ehegatte: Person) kind institutional {
    label de official "Der Ehegatte eines allein sorgeberechtigten Elternteils hat im Einvernehmen mit diesem die Befugnis zur Mitentscheidung in Angelegenheiten des täglichen Lebens des Kindes (§ 1687b Abs. 1)";
    label en unofficial "The spouse of a sole custodial parent has, in agreement with him, the power to participate in decisions on matters of daily life (§ 1687b (1))";
}
pub relation notbefugnis_des_ehegatten(kind: Person, ehegatte: Person) kind institutional {
    label de official "Bei Gefahr im Verzug ist der Ehegatte berechtigt, alle Rechtshandlungen vorzunehmen, die zum Wohl des Kindes notwendig sind; der sorgeberechtigte Elternteil ist unverzüglich zu unterrichten (§ 1687b Abs. 2)";
    label en unofficial "In case of imminent danger the spouse may take all legal steps necessary for the child's welfare; the custodial parent must be informed without undue delay (§ 1687b (2))";
}
pub relation entscheidungsbefugnis_der_pflegeperson(kind: Person, pflegeperson: Person) kind institutional {
    label de official "Lebt ein Kind für längere Zeit in Familienpflege, so ist die Pflegeperson berechtigt, in Angelegenheiten des täglichen Lebens zu entscheiden und den Inhaber der elterlichen Sorge insoweit zu vertreten (§ 1688 Abs. 1 Satz 1)";
    label en unofficial "Where a child lives in family care for a longer time, the carer may decide on matters of daily life and represent the custodian in such matters (§ 1688 (1) sentence 1)";
}
pub relation verwaltungsbefugnis_der_pflegeperson(kind: Person, pflegeperson: Person) kind institutional {
    label de official "Die Pflegeperson ist befugt, den Arbeitsverdienst des Kindes zu verwalten sowie Unterhalts-, Versicherungs-, Versorgungs- und sonstige Sozialleistungen für das Kind geltend zu machen und zu verwalten (§ 1688 Abs. 1 Satz 2)";
    label en unofficial "The carer may administer the child's earnings and assert and administer maintenance, insurance, pension and other social benefits for the child (§ 1688 (1) sentence 2)";
}

@source(BGB_P1685) {
    presumption TatsaechlicheVerantwortungVermutet(k: Person, p: Person) {
        label de official "Eine Übernahme tatsächlicher Verantwortung ist in der Regel anzunehmen, wenn die Person mit dem Kind längere Zeit in häuslicher Gemeinschaft zusammengelebt hat (§ 1685 Abs. 2 Satz 2)";
        label en unofficial "The assumption of actual responsibility is as a rule to be presumed where the person lived with the child in domestic community for a longer time (§ 1685 (2) sentence 2)";
        when laengere_haeusliche_gemeinschaft(k, p);
        presume sozial_familiaere_beziehung_1685(k, p);
        unless tatsaechliche_verantwortung_widerlegt(k, p);
    }
    rule UmgangsrechtDerGrosselternUndGeschwister(k: Person, p: Person) strict {
        label de official "Großeltern und Geschwister haben ein Recht auf Umgang mit dem Kind, wenn dieser dem Wohl des Kindes dient (§ 1685 Abs. 1)";
        label en unofficial "Grandparents and siblings have a right of contact with the child where this serves the child's welfare (§ 1685 (1))";
        when grosselternteil_oder_geschwister(k, p) and umgang_dient_dem_wohl_des_kindes(k, p);
        then umgangsrecht_der_bezugsperson(k, p);
    }
    rule UmgangsrechtDerEngenBezugsperson(k: Person, p: Person) strict {
        label de official "Gleiches gilt für enge Bezugspersonen des Kindes, wenn diese für das Kind tatsächliche Verantwortung tragen oder getragen haben (sozial-familiäre Beziehung) (§ 1685 Abs. 2 Satz 1)";
        label en unofficial "The same applies to close attachment figures who bear or have borne actual responsibility for the child (§ 1685 (2) sentence 1)";
        when enge_bezugsperson(k, p) and umgang_dient_dem_wohl_des_kindes(k, p);
        then umgangsrecht_der_bezugsperson(k, p);
    }
}

@source(BGB_P1686)
rule AuskunftUeberDasKind(f: Familie, k: Person, e: Person, a: Person) strict {
    label de official "Jeder Elternteil kann vom anderen Elternteil bei berechtigtem Interesse Auskunft über die persönlichen Verhältnisse des Kindes verlangen, soweit dies dem Wohl des Kindes nicht widerspricht (§ 1686)";
    label en unofficial "Each parent may demand information on the child's personal circumstances from the other where there is a legitimate interest and this does not conflict with the child's welfare (§ 1686)";
    when elternteil(f, e, k) and elternteil(f, a, k) and a != e
     and auskunft_ueber_die_persoenlichen_verhaeltnisse_verlangt(k, e) and berechtigtes_interesse_an_der_auskunft(k, e);
    then auskunftsanspruch_ueber_das_kind(k, e);
}

@source(BGB_P1686a) {
    rule UmgangsrechtDesLeiblichenVaters(k: Person, m: Person) strict {
        label de official "Solange die Vaterschaft eines anderen Mannes besteht, hat der leibliche Vater, der ernsthaftes Interesse an dem Kind gezeigt hat, ein Recht auf Umgang mit dem Kind, wenn der Umgang dem Kindeswohl dient (§ 1686a Abs. 1 Nr. 1)";
        label en unofficial "As long as another man's paternity exists, the biological father who has shown serious interest has a right of contact where it serves the child's welfare (§ 1686a (1) no. 1)";
        when leiblicher_nicht_rechtlicher_vater(k, m) and ernsthaftes_interesse_am_kind_gezeigt(k, m)
         and umgang_dient_dem_wohl_des_kindes(k, m);
        then umgangsrecht_des_leiblichen_vaters(k, m);
    }
    rule AuskunftsanspruchDesLeiblichenVaters(k: Person, m: Person) strict {
        label de official "Der leibliche Vater hat ein Recht auf Auskunft von jedem Elternteil über die persönlichen Verhältnisse des Kindes, soweit er ein berechtigtes Interesse hat und dies dem Wohl des Kindes nicht widerspricht (§ 1686a Abs. 1 Nr. 2)";
        label en unofficial "The biological father has a right to information from each parent on the child's personal circumstances where he has a legitimate interest and this does not conflict with the child's welfare (§ 1686a (1) no. 2)";
        when leiblicher_nicht_rechtlicher_vater(k, m) and ernsthaftes_interesse_am_kind_gezeigt(k, m)
         and auskunft_ueber_die_persoenlichen_verhaeltnisse_verlangt(k, m) and berechtigtes_interesse_an_der_auskunft(k, m);
        then auskunftsanspruch_ueber_das_kind(k, m);
    }
}

@source(BGB_P1687a)
rule EntscheidungsbefugnisDesNichtSorgeberechtigten(k: Person, e: Person) strict {
    label de official "Für jeden Elternteil, der nicht Inhaber der elterlichen Sorge ist und bei dem sich das Kind mit Einwilligung des anderen Elternteils oder auf Grund einer gerichtlichen Entscheidung aufhält, gilt § 1687 Abs. 1 Satz 4 und 5 und Abs. 2 entsprechend (§ 1687a)";
    label en unofficial "For each non-custodial parent with whom the child stays with consent or by court decision, § 1687 (1) sentences 4 and 5 and (2) apply accordingly (§ 1687a)";
    when kind_haelt_sich_beim_nicht_sorgeberechtigten_auf(k, e);
    then entscheidungsbefugnis_des_nicht_sorgeberechtigten(k, e);
}

@source(BGB_P1687b) {
    rule MitentscheidungsbefugnisDesEhegatten(k: Person, s: Person) strict {
        label de official "Der Ehegatte eines allein sorgeberechtigten Elternteils, der nicht Elternteil des Kindes ist, hat im Einvernehmen mit dem sorgeberechtigten Elternteil die Befugnis zur Mitentscheidung in Angelegenheiten des täglichen Lebens des Kindes (§ 1687b Abs. 1); die Befugnisse bestehen nicht, wenn die Ehegatten nicht nur vorübergehend getrennt leben (Abs. 4)";
        label en unofficial "The spouse of a sole custodial parent who is not a parent of the child has, in agreement with him, the power to participate in decisions on daily matters (§ 1687b (1)); not where the spouses live apart other than temporarily ((4))";
        when ehegatte_des_alleinsorgeberechtigten(k, s) and not_known(ehegatten_leben_getrennt(k, s))
         and not_known(befugnisse_gerichtlich_eingeschraenkt(k, s));
        then mitentscheidungsbefugnis_des_ehegatten(k, s);
    }
    rule NotbefugnisDesEhegatten(k: Person, s: Person) strict {
        label de official "Bei Gefahr im Verzug ist der Ehegatte dazu berechtigt, alle Rechtshandlungen vorzunehmen, die zum Wohl des Kindes notwendig sind (§ 1687b Abs. 2)";
        label en unofficial "In case of imminent danger the spouse may take all legal steps necessary for the child's welfare (§ 1687b (2))";
        when ehegatte_des_alleinsorgeberechtigten(k, s) and gefahr_im_verzug(k);
        then notbefugnis_des_ehegatten(k, s);
    }
}

@source(BGB_P1688) {
    rule EntscheidungsbefugnisDerPflegeperson(k: Person, pp: Person) strict {
        label de official "Lebt ein Kind für längere Zeit in Familienpflege, so ist die Pflegeperson berechtigt, in Angelegenheiten des täglichen Lebens zu entscheiden sowie den Inhaber der elterlichen Sorge in solchen Angelegenheiten zu vertreten (§ 1688 Abs. 1 Satz 1); dies gilt nicht, wenn der Inhaber der elterlichen Sorge etwas anderes erklärt (Abs. 3 Satz 1)";
        label en unofficial "Where a child lives in family care for a longer time, the carer may decide on daily matters and represent the custodian therein (§ 1688 (1) sentence 1); not where the custodian declares otherwise ((3) sentence 1)";
        when kind_fuer_laengere_zeit_in_familienpflege(k, pp)
         and not_known(sorgeberechtigter_erklaert_etwas_anderes(k, pp))
         and not_known(befugnisse_gerichtlich_eingeschraenkt(k, pp));
        then entscheidungsbefugnis_der_pflegeperson(k, pp);
    }
    rule VerwaltungsbefugnisDerPflegeperson(k: Person, pp: Person) strict {
        label de official "Die Pflegeperson ist befugt, den Arbeitsverdienst des Kindes zu verwalten sowie Unterhalts-, Versicherungs-, Versorgungs- und sonstige Sozialleistungen für das Kind geltend zu machen und zu verwalten (§ 1688 Abs. 1 Satz 2)";
        label en unofficial "The carer may administer the child's earnings and assert and administer maintenance, insurance, pension and other social benefits (§ 1688 (1) sentence 2)";
        when entscheidungsbefugnis_der_pflegeperson(k, pp);
        then verwaltungsbefugnis_der_pflegeperson(k, pp);
    }
}

// --- §§ 1693, 1697a, 1698–1698b Abwicklung -------------------------------------------------------

pub relation beide_eltern_verhindert(kind: Person) kind empirical {
    label de official "Die Eltern sind verhindert, die elterliche Sorge auszuüben (§ 1693)";
    label en unofficial "the parents are prevented from exercising parental custody (§ 1693)";
}
pub relation verfahren_ueber_eine_angelegenheit_des_titels(kind: Person) kind empirical {
    label de official "Ein Verfahren über eine in Titel 5 geregelte Angelegenheit ist anhängig (§ 1697a Abs. 1)";
    label en unofficial "proceedings on a matter regulated in title 5 are pending (§ 1697a (1))";
}
pub relation vermoegenssorge_beendet(kind: Person, elternteil: Person) kind empirical {
    label de official "Die elterliche Sorge endet oder ruht oder die Vermögenssorge hört aus einem anderen Grunde auf (§ 1698 Abs. 1)";
    label en unofficial "parental custody ends or is suspended or property care ceases for another reason (§ 1698 (1))";
}
pub relation rechenschaft_verlangt(kind: Person, elternteil: Person) kind empirical {
    label de official "Das Kind verlangt Rechenschaft über die Verwaltung (§ 1698 Abs. 1)";
    label en unofficial "the child demands an account of the administration (§ 1698 (1))";
}
pub relation grund_zur_annahme_zweckwidriger_verwendung(kind: Person, elternteil: Person) kind empirical {
    label de official "Es besteht Grund zu der Annahme, dass die Eltern die Nutzungen entgegen § 1649 verwendet haben (§ 1698 Abs. 2)";
    label en unofficial "there is reason to assume that the parents used the profits contrary to § 1649 (§ 1698 (2))";
}
pub relation kenntnis_von_der_beendigung(kind: Person, elternteil: Person) kind empirical {
    label de official "Die Eltern haben von der Beendigung der elterlichen Sorge Kenntnis erlangt oder müssen sie kennen (§ 1698a Abs. 1 Satz 1)";
    label en unofficial "the parents have learnt of the termination of parental custody or must know of it (§ 1698a (1) sentence 1)";
}
pub relation kind_verstorben(kind: Person) kind empirical {
    label de official "Das Kind ist gestorben: die elterliche Sorge endet (§ 1698b)";
    label en unofficial "the child has died: parental custody ends (§ 1698b)";
}
pub relation erbe_kann_noch_nicht_fuersorge_treffen(kind: Person) kind empirical {
    label de official "Der Erbe kann noch nicht anderweit Fürsorge treffen (§ 1698b)";
    label en unofficial "the heir cannot yet make other provision (§ 1698b)";
}

@source(BGB_P1697a)
pub external judgment relation entscheidung_entspricht_dem_kindeswohl_am_besten(kind: Person) {
    authority Court;
    label de official "§ 1697a Abs. 1. Die Entscheidung entspricht unter Berücksichtigung der tatsächlichen Gegebenheiten und Möglichkeiten sowie der berechtigten Interessen der Beteiligten dem Wohl des Kindes am besten";
    label en unofficial "§ 1697a (1). The decision best serves the child's welfare, having regard to the actual circumstances and possibilities and the legitimate interests of those involved";
}

pub relation erforderliche_massregeln_zu_treffen(kind: Person) kind institutional {
    label de official "Sind die Eltern verhindert, die elterliche Sorge auszuüben, so hat das Familiengericht die im Interesse des Kindes erforderlichen Maßregeln zu treffen (§ 1693)";
    label en unofficial "Where the parents are prevented from exercising parental custody, the family court must take the measures necessary in the child's interest (§ 1693)";
}
pub relation kindeswohlprinzip_massgebend(kind: Person) kind institutional {
    label de official "Soweit nichts anderes bestimmt ist, trifft das Gericht diejenige Entscheidung, die dem Wohl des Kindes am besten entspricht (§ 1697a Abs. 1)";
    label en unofficial "Unless otherwise provided, the court takes the decision that best serves the child's welfare (§ 1697a (1))";
}
pub relation erziehungsverhaeltnisse_zu_beruecksichtigen(kind: Person) kind institutional {
    label de official "Lebt das Kind in Familienpflege, so hat das Gericht auch zu berücksichtigen, ob und inwieweit sich die Erziehungsverhältnisse bei den Eltern verbessert haben (§ 1697a Abs. 2 Satz 1)";
    label en unofficial "Where the child lives in family care, the court must also consider whether and to what extent the conditions of upbringing at the parents' have improved (§ 1697a (2) sentence 1)";
}
pub relation herausgabe_des_kindesvermoegens(kind: Person, elternteil: Person) kind institutional {
    label de official "Endet oder ruht die elterliche Sorge oder hört aus einem anderen Grunde die Vermögenssorge auf, so haben die Eltern dem Kind das Vermögen herauszugeben (§ 1698 Abs. 1)";
    label en unofficial "Where parental custody ends or is suspended or property care ceases, the parents must surrender the assets to the child (§ 1698 (1))";
}
pub relation rechenschaftspflicht(kind: Person, elternteil: Person) kind institutional {
    label de official "Auf Verlangen haben die Eltern über die Verwaltung Rechenschaft abzulegen; über die Nutzungen nur insoweit, als Grund zu der Annahme besteht, dass sie sie entgegen § 1649 verwendet haben (§ 1698 Abs. 1, 2)";
    label en unofficial "On demand the parents must render account of the administration; of the profits only where there is reason to assume misuse contrary to § 1649 (§ 1698 (1), (2))";
}
pub relation fortfuehrung_der_geschaefte(kind: Person, elternteil: Person) kind institutional {
    label de official "Die Eltern dürfen die mit der Personensorge und mit der Vermögenssorge verbundenen Geschäfte fortführen, bis sie von der Beendigung der elterlichen Sorge Kenntnis erlangen oder sie kennen müssen (§ 1698a Abs. 1 Satz 1)";
    label en unofficial "The parents may continue the business connected with parental care until they learn of the termination of parental custody or must know of it (§ 1698a (1) sentence 1)";
}
pub relation dringende_geschaefte_zu_besorgen(kind: Person, elternteil: Person) kind institutional {
    label de official "Endet die elterliche Sorge durch den Tod des Kindes, so haben die Eltern die Geschäfte, die nicht ohne Gefahr aufgeschoben werden können, zu besorgen, bis der Erbe anderweit Fürsorge treffen kann (§ 1698b)";
    label en unofficial "Where parental custody ends by the child's death, the parents must attend to business that cannot be postponed without danger until the heir can make other provision (§ 1698b)";
}

@source(BGB_P1693)
rule ErforderlicheMassregeln(k: Person) strict {
    label de official "Sind die Eltern verhindert, die elterliche Sorge auszuüben, so hat das Familiengericht die im Interesse des Kindes erforderlichen Maßregeln zu treffen (§ 1693)";
    label en unofficial "Where the parents are prevented from exercising parental custody, the family court must take the measures necessary in the child's interest (§ 1693)";
    when beide_eltern_verhindert(k);
    then erforderliche_massregeln_zu_treffen(k);
}

@source(BGB_P1697a) {
    rule KindeswohlprinzipMassgebend(k: Person) strict {
        label de official "Soweit nichts anderes bestimmt ist, trifft das Gericht in Verfahren über die in diesem Titel geregelten Angelegenheiten diejenige Entscheidung, die dem Wohl des Kindes am besten entspricht (§ 1697a Abs. 1)";
        label en unofficial "Unless otherwise provided, the court takes in proceedings on matters of this title the decision that best serves the child's welfare (§ 1697a (1))";
        when verfahren_ueber_eine_angelegenheit_des_titels(k) and entscheidung_entspricht_dem_kindeswohl_am_besten(k);
        then kindeswohlprinzip_massgebend(k);
    }
    rule ErziehungsverhaeltnisseZuBeruecksichtigen(k: Person, pp: Person) strict {
        label de official "Lebt das Kind in Familienpflege, so hat das Gericht auch zu berücksichtigen, ob und inwieweit sich innerhalb eines vertretbaren Zeitraums die Erziehungsverhältnisse bei den Eltern verbessert haben (§ 1697a Abs. 2 Satz 1)";
        label en unofficial "Where the child lives in family care, the court must also consider whether the conditions of upbringing at the parents' have improved within a reasonable period (§ 1697a (2) sentence 1)";
        when verfahren_ueber_eine_angelegenheit_des_titels(k) and kind_fuer_laengere_zeit_in_familienpflege(k, pp);
        then erziehungsverhaeltnisse_zu_beruecksichtigen(k);
    }
}

@source(BGB_P1698) {
    rule HerausgabeDesKindesvermoegens(k: Person, e: Person) strict {
        label de official "Endet oder ruht die elterliche Sorge der Eltern oder hört aus einem anderen Grunde ihre Vermögenssorge auf, so haben sie dem Kind das Vermögen herauszugeben (§ 1698 Abs. 1)";
        label en unofficial "Where parental custody ends or is suspended or property care ceases, the parents must surrender the assets to the child (§ 1698 (1))";
        when vermoegenssorge_beendet(k, e);
        then herausgabe_des_kindesvermoegens(k, e);
    }
    rule RechenschaftUeberDieVerwaltung(k: Person, e: Person) strict {
        label de official "Auf Verlangen haben die Eltern über die Verwaltung Rechenschaft abzulegen (§ 1698 Abs. 1)";
        label en unofficial "On demand the parents must render account of the administration (§ 1698 (1))";
        when vermoegenssorge_beendet(k, e) and rechenschaft_verlangt(k, e);
        then rechenschaftspflicht(k, e);
    }
    rule RechenschaftUeberDieNutzungen(k: Person, e: Person) strict {
        label de official "Über die Nutzungen des Kindesvermögens brauchen die Eltern nur insoweit Rechenschaft abzulegen, als Grund zu der Annahme besteht, dass sie die Nutzungen entgegen § 1649 verwendet haben (§ 1698 Abs. 2)";
        label en unofficial "The parents need render account of the profits only where there is reason to assume they used them contrary to § 1649 (§ 1698 (2))";
        when vermoegenssorge_beendet(k, e) and grund_zur_annahme_zweckwidriger_verwendung(k, e);
        then rechenschaftspflicht(k, e);
    }
}

@source(BGB_P1698a)
rule FortfuehrungDerGeschaefte(k: Person, e: Person) strict {
    label de official "Die Eltern dürfen die mit der Personensorge und mit der Vermögenssorge für das Kind verbundenen Geschäfte fortführen, bis sie von der Beendigung der elterlichen Sorge Kenntnis erlangen oder sie kennen müssen (§ 1698a Abs. 1 Satz 1); dies gilt entsprechend, wenn die elterliche Sorge ruht (Abs. 2)";
    label en unofficial "The parents may continue the business connected with parental care until they learn of the termination or must know of it (§ 1698a (1) sentence 1); this applies accordingly where custody is suspended ((2))";
    when vermoegenssorge_beendet(k, e) and not_known(kenntnis_von_der_beendigung(k, e));
    then fortfuehrung_der_geschaefte(k, e);
}

@source(BGB_P1698b)
rule DringendeGeschaefteNachDemTodDesKindes(f: Familie, k: Person, e: Person) strict {
    label de official "Endet die elterliche Sorge durch den Tod des Kindes, so haben die Eltern die Geschäfte, die nicht ohne Gefahr aufgeschoben werden können, zu besorgen, bis der Erbe anderweit Fürsorge treffen kann (§ 1698b)";
    label en unofficial "Where parental custody ends by the child's death, the parents must attend to business that cannot be postponed without danger until the heir can make other provision (§ 1698b)";
    when kind_verstorben(k) and elternteil(f, e, k) and erbe_kann_noch_nicht_fuersorge_treffen(k);
    then dringende_geschaefte_zu_besorgen(k, e);
}
