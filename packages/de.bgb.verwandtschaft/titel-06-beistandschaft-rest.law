// --- Titel 6: Beistandschaft — Fortsetzung (§§ 1713–1717) ----------------------------------------
//
// § 1712 und die Grundfälle des § 1715 Abs. 1 stehen in
// `titel-04-06-sorge-und-beistandschaft.law`. Hier folgen der geschlossene
// Kreis der Antragsberechtigten (§ 1713), der Eintritt mit dem Zugang des
// Antrags beim Jugendamt (§ 1714), das Ende beim Wegfall der Voraussetzungen
// (§ 1715 Abs. 2), die Wirkung auf die elterliche Sorge (§ 1716) und das
// Erfordernis des gewöhnlichen Aufenthalts im Inland (§ 1717).

pub relation ehrenamtlicher_vormund(kind: Person, person: Person) kind empirical {
    label de official "Ehrenamtlicher Vormund des Kindes (§ 1713 Abs. 1 Satz 3)";
    label en unofficial "honorary guardian of the child (§ 1713 (1) sentence 3)";
}
pub relation pflegeperson_mit_uebertragenen_angelegenheiten(kind: Person, person: Person) kind empirical {
    label de official "Pflegeperson, der nach § 1630 Abs. 3 Angelegenheiten der elterlichen Sorge übertragen wurden (§ 1713 Abs. 1 Satz 3)";
    label en unofficial "carer to whom matters of parental custody were transferred under § 1630 (3) (§ 1713 (1) sentence 3)";
}
pub relation antrag_durch_einen_vertreter_gestellt(kind: Person, person: Person) kind empirical {
    label de official "Der Antrag ist durch einen Vertreter gestellt worden: er kann nicht durch einen Vertreter gestellt werden (§ 1713 Abs. 1 Satz 4)";
    label en unofficial "the application was made by a representative: it cannot be made by a representative (§ 1713 (1) sentence 4)";
}
pub relation werdende_mutter(kind: Person, mutter: Person) kind empirical {
    label de official "Werdende Mutter, die den Antrag vor der Geburt des Kindes stellt (§ 1713 Abs. 2 Satz 1)";
    label en unofficial "expectant mother who makes the application before the birth of the child (§ 1713 (2) sentence 1)";
}
pub relation kind_stuende_unter_vormundschaft(kind: Person) kind empirical {
    label de official "Das Kind stünde, sofern es bereits geboren wäre, unter Vormundschaft (§ 1713 Abs. 2 Satz 1)";
    label en unofficial "the child would be under guardianship if it were already born (§ 1713 (2) sentence 1)";
}
pub relation antrag_dem_jugendamt_zugegangen_am(kind: Person, person: Person, tag: Date) kind empirical {
    label de official "Tag, an dem der Antrag dem Jugendamt zugegangen ist (§ 1714 Satz 1)";
    label en unofficial "day on which the application reached the youth welfare office (§ 1714 sentence 1)";
}
pub relation voraussetzungen_des_1713_entfallen(kind: Person, person: Person) kind empirical {
    label de official "Der Antragsteller erfüllt keine der in § 1713 genannten Voraussetzungen mehr (§ 1715 Abs. 2)";
    label en unofficial "the applicant no longer meets any of the conditions of § 1713 (§ 1715 (2))";
}
pub relation gewoehnlicher_aufenthalt_im_inland(kind: Person) kind empirical {
    label de official "Das Kind hat seinen gewöhnlichen Aufenthalt im Inland (§ 1717 Satz 1)";
    label en unofficial "the child has its habitual residence in Germany (§ 1717 sentence 1)";
}
pub relation gewoehnlicher_aufenthalt_im_ausland_begruendet(kind: Person) kind empirical {
    label de official "Das Kind begründet seinen gewöhnlichen Aufenthalt im Ausland (§ 1717 Satz 1 Halbsatz 2)";
    label en unofficial "the child establishes its habitual residence abroad (§ 1717 sentence 1)";
}

pub relation antragsberechtigt(kind: Person, person: Person) kind institutional {
    label de official "Geschlossener Kreis der Antragsberechtigten der Beistandschaft (§ 1713 Abs. 1, 2)";
    label en unofficial "closed circle of persons entitled to apply for the assistance (§ 1713 (1), (2))";
}
pub relation beistandschaft_tritt_ein_am(kind: Person, person: Person, tag: Date) kind institutional {
    label de official "Die Beistandschaft tritt ein, sobald der Antrag dem Jugendamt zugeht; dies gilt auch, wenn der Antrag vor der Geburt des Kindes gestellt wird (§ 1714)";
    label en unofficial "The assistance begins as soon as the application reaches the youth welfare office; this also applies where it is made before the birth (§ 1714)";
}
pub relation beistandschaft_endet_mangels_voraussetzungen(kind: Person, person: Person) kind institutional {
    label de official "Die Beistandschaft endet auch, sobald der Antragsteller keine der in § 1713 genannten Voraussetzungen mehr erfüllt (§ 1715 Abs. 2)";
    label en unofficial "The assistance also ends as soon as the applicant no longer meets any of the conditions of § 1713 (§ 1715 (2))";
}
pub relation elterliche_sorge_nicht_eingeschraenkt(kind: Person) kind institutional {
    label de official "Durch die Beistandschaft wird die elterliche Sorge nicht eingeschränkt (§ 1716 Satz 1)";
    label en unofficial "The assistance does not restrict parental custody (§ 1716 sentence 1)";
}
pub relation vorschriften_ueber_die_pflegschaft_anwendbar(kind: Person) kind institutional {
    label de official "Im Übrigen gelten die Vorschriften über die Pflegschaft für Minderjährige mit Ausnahme derjenigen über die Aufsicht des Familiengerichts und die Rechnungslegung sinngemäß (§ 1716 Satz 2)";
    label en unofficial "Otherwise the provisions on curatorship for minors apply mutatis mutandis, except those on supervision by the family court and on rendering accounts (§ 1716 sentence 2)";
}
pub relation beistandschaft_nur_bei_inlandsaufenthalt(kind: Person) kind institutional {
    label de official "Die Beistandschaft tritt nur ein, wenn das Kind seinen gewöhnlichen Aufenthalt im Inland hat (§ 1717 Satz 1 Halbsatz 1)";
    label en unofficial "The assistance begins only where the child has its habitual residence in Germany (§ 1717 sentence 1)";
}
pub relation beistandschaft_endet_bei_aufenthalt_im_ausland(kind: Person, person: Person) kind institutional {
    label de official "Die Beistandschaft endet, wenn das Kind seinen gewöhnlichen Aufenthalt im Ausland begründet (§ 1717 Satz 1 Halbsatz 2)";
    label en unofficial "The assistance ends where the child establishes its habitual residence abroad (§ 1717 sentence 1)";
}

@source(BGB_P1713) {
    rule AntragsberechtigtAlleinsorgeOderObhut(k: Person, e: Person) strict {
        label de official "Den Antrag kann ein Elternteil stellen, dem für den Aufgabenkreis der beantragten Beistandschaft die alleinige elterliche Sorge zusteht; steht die elterliche Sorge den Eltern gemeinsam zu, kann der Antrag von dem Elternteil gestellt werden, in dessen Obhut sich das Kind befindet (§ 1713 Abs. 1 Satz 1, 2)";
        label en unofficial "The application may be made by a parent with sole custody for the scope of the assistance; where custody is joint, by the parent in whose care the child is (§ 1713 (1) sentences 1, 2)";
        when antragsteller_hat_alleinsorge_oder_obhut(k, e) and not_known(antrag_durch_einen_vertreter_gestellt(k, e));
        then antragsberechtigt(k, e);
    }
    rule AntragsberechtigtEhrenamtlicherVormund(k: Person, v: Person) strict {
        label de official "Der Antrag kann auch von einem ehrenamtlichen Vormund gestellt werden (§ 1713 Abs. 1 Satz 3)";
        label en unofficial "The application may also be made by an honorary guardian (§ 1713 (1) sentence 3)";
        when ehrenamtlicher_vormund(k, v) and not_known(antrag_durch_einen_vertreter_gestellt(k, v));
        then antragsberechtigt(k, v);
    }
    rule AntragsberechtigtPflegeperson(k: Person, pp: Person) strict {
        label de official "Der Antrag kann auch von einer Pflegeperson gestellt werden, der nach § 1630 Absatz 3 Angelegenheiten der elterlichen Sorge übertragen wurden (§ 1713 Abs. 1 Satz 3)";
        label en unofficial "The application may also be made by a carer to whom matters of parental custody were transferred under § 1630 (3) (§ 1713 (1) sentence 3)";
        when pflegeperson_mit_uebertragenen_angelegenheiten(k, pp) and not_known(antrag_durch_einen_vertreter_gestellt(k, pp));
        then antragsberechtigt(k, pp);
    }
    rule AntragsberechtigtWerdendeMutter(k: Person, m: Person) strict {
        label de official "Vor der Geburt des Kindes kann die werdende Mutter den Antrag auch dann stellen, wenn das Kind, sofern es bereits geboren wäre, unter Vormundschaft stünde (§ 1713 Abs. 2 Satz 1)";
        label en unofficial "Before the birth the expectant mother may make the application even where the child would be under guardianship if already born (§ 1713 (2) sentence 1)";
        when werdende_mutter(k, m) and kind_stuende_unter_vormundschaft(k);
        then antragsberechtigt(k, m);
    }
}

@source(BGB_P1714)
rule BeistandschaftTrittMitZugangEin(k: Person, e: Person, t: Date) strict {
    label de official "Die Beistandschaft tritt ein, sobald der Antrag dem Jugendamt zugeht; dies gilt auch, wenn der Antrag vor der Geburt des Kindes gestellt wird (§ 1714)";
    label en unofficial "The assistance begins as soon as the application reaches the youth welfare office; this also applies where it is made before the birth (§ 1714)";
    when antragsberechtigt(k, e) and antrag_dem_jugendamt_zugegangen_am(k, e, t);
    then beistandschaft_tritt_ein_am(k, e, t);
}

@source(BGB_P1715)
rule BeistandschaftEndetMangelsVoraussetzungen(k: Person, e: Person) strict {
    label de official "Die Beistandschaft endet auch, sobald der Antragsteller keine der in § 1713 genannten Voraussetzungen mehr erfüllt (§ 1715 Abs. 2)";
    label en unofficial "The assistance also ends as soon as the applicant no longer meets any of the conditions of § 1713 (§ 1715 (2))";
    when antrag_auf_beistandschaft(k, e) and voraussetzungen_des_1713_entfallen(k, e);
    then beistandschaft_endet_mangels_voraussetzungen(k, e);
}

@source(BGB_P1716) {
    rule SorgeNichtEingeschraenkt(k: Person, e: Person) strict {
        label de official "Durch die Beistandschaft wird die elterliche Sorge nicht eingeschränkt (§ 1716 Satz 1)";
        label en unofficial "The assistance does not restrict parental custody (§ 1716 sentence 1)";
        when beistandschaft_besteht(k, e);
        then elterliche_sorge_nicht_eingeschraenkt(k);
    }
    rule PflegschaftsvorschriftenAnwendbar(k: Person, e: Person) strict {
        label de official "Im Übrigen gelten die Vorschriften über die Pflegschaft für Minderjährige mit Ausnahme derjenigen über die Aufsicht des Familiengerichts und die Rechnungslegung sinngemäß (§ 1716 Satz 2)";
        label en unofficial "Otherwise the provisions on curatorship for minors apply mutatis mutandis, except those on court supervision and rendering accounts (§ 1716 sentence 2)";
        when beistandschaft_besteht(k, e);
        then vorschriften_ueber_die_pflegschaft_anwendbar(k);
    }
}

@source(BGB_P1717) {
    rule BeistandschaftNurBeiInlandsaufenthalt(k: Person) strict {
        label de official "Die Beistandschaft tritt nur ein, wenn das Kind seinen gewöhnlichen Aufenthalt im Inland hat (§ 1717 Satz 1 Halbsatz 1)";
        label en unofficial "The assistance begins only where the child has its habitual residence in Germany (§ 1717 sentence 1)";
        when gewoehnlicher_aufenthalt_im_inland(k);
        then beistandschaft_nur_bei_inlandsaufenthalt(k);
    }
    rule BeistandschaftEndetImAusland(k: Person, e: Person) strict {
        label de official "Die Beistandschaft endet, wenn das Kind seinen gewöhnlichen Aufenthalt im Ausland begründet (§ 1717 Satz 1 Halbsatz 2)";
        label en unofficial "The assistance ends where the child establishes its habitual residence abroad (§ 1717 sentence 1)";
        when antrag_auf_beistandschaft(k, e) and gewoehnlicher_aufenthalt_im_ausland_begruendet(k);
        then beistandschaft_endet_bei_aufenthalt_im_ausland(k, e);
    }
}
