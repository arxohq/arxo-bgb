language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1626d Abs. 1 mit § 1626e, Kanarienvogel „minus ein Merkmal“: dieselben Sorgeerklärungen OHNE öffentliche Beurkundung sind unwirksam, und die gemeinsame Sorge entsteht nicht.
test "§ 1626e: Sorgeerklärungen ohne öffentliche Beurkundung sind unwirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": minderjaehriges_kind(entity_ref("urn:de:bgb:vw:s03:K")) { origin case_input; }
        assert "f2": sorgeerklaerungen_abgegeben(entity_ref("urn:de:bgb:vw:s03:K")) { origin case_input; }
    }
    evaluate truth(sorgeerklaerung_unwirksam(entity_ref("urn:de:bgb:vw:s03:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(elterliche_sorge_gemeinsam(entity_ref("urn:de:bgb:vw:s03:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
