language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1685 Abs. 2 Satz 2: eine Übernahme tatsächlicher Verantwortung ist IN DER REGEL anzunehmen, wenn die Person mit dem Kind längere Zeit in häuslicher Gemeinschaft zusammengelebt hat. Die Widerlegung ist ein ausdrücklicher Eingang des Falls; hier fehlt sie. Das Umgangsrecht selbst hängt zusätzlich an der Wertung „dient dem Wohl des Kindes“, die das Gericht bejaht hat.
test "§ 1685 Abs. 2: die Regelannahme der sozial-familiären Beziehung hält" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": laengere_haeusliche_gemeinschaft(entity_ref("urn:de:bgb:vw:sr05:K"), entity_ref("urn:de:bgb:vw:sr05:B")) { origin case_input; }
        assert "f2": enge_bezugsperson(entity_ref("urn:de:bgb:vw:sr05:K"), entity_ref("urn:de:bgb:vw:sr05:B")) { origin case_input; }
        assert "f3": umgang_dient_dem_wohl_des_kindes(entity_ref("urn:de:bgb:vw:sr05:K"), entity_ref("urn:de:bgb:vw:sr05:B")) { origin adjudicated; }
    }
    evaluate truth(sozial_familiaere_beziehung_1685(entity_ref("urn:de:bgb:vw:sr05:K"), entity_ref("urn:de:bgb:vw:sr05:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(umgangsrecht_der_bezugsperson(entity_ref("urn:de:bgb:vw:sr05:K"), entity_ref("urn:de:bgb:vw:sr05:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
