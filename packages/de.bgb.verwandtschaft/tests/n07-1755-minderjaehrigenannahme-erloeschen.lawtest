language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// §§ 1754 Abs. 2, 1755 Abs. 1 Satz 1: mit der ausgesprochenen Annahme eines Minderjährigen erlangt das Kind die Stellung eines Kindes des Annehmenden, und das Verwandtschaftsverhältnis zum leiblichen Vater erlischt.
test "§§ 1754, 1755: Annahme eines Minderjährigen — Stellung als Kind, Erlöschen der Verwandtschaft" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": familie_des_falls(entity_ref("urn:de:bgb:vw:n07:F")) { origin case_input; }
        assert "f2": abstammung(entity_ref("urn:de:bgb:vw:n07:F"), entity_ref("urn:de:bgb:vw:n07:V"), entity_ref("urn:de:bgb:vw:n07:K")) { origin case_input; }
        assert "f3": annahme_als_kind(entity_ref("urn:de:bgb:vw:n07:F"), entity_ref("urn:de:bgb:vw:n07:A"), entity_ref("urn:de:bgb:vw:n07:K")) { origin case_input; }
        assert "f4": annahme_eines_minderjaehrigen(entity_ref("urn:de:bgb:vw:n07:F"), entity_ref("urn:de:bgb:vw:n07:K")) { origin case_input; }
        assert "f5": annahme_ausgesprochen(entity_ref("urn:de:bgb:vw:n07:A"), entity_ref("urn:de:bgb:vw:n07:K")) { origin adjudicated; }
    }
    evaluate truth(stellung_eines_kindes(entity_ref("urn:de:bgb:vw:n07:K"), entity_ref("urn:de:bgb:vw:n07:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verwandtschaft_erloschen(entity_ref("urn:de:bgb:vw:n07:K"), entity_ref("urn:de:bgb:vw:n07:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
