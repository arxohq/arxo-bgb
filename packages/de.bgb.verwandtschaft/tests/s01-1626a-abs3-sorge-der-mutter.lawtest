language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1626a Abs. 3: sind die Eltern bei der Geburt nicht miteinander verheiratet und liegen weder Sorgeerklärungen noch eine Heirat noch eine gerichtliche Übertragung vor, so hat die MUTTER die elterliche Sorge. Die gemeinsame Sorge entsteht nicht.
test "§ 1626a Abs. 3: ohne Sorgeerklärungen hat die Mutter die elterliche Sorge" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": familie_des_falls(entity_ref("urn:de:bgb:vw:s01:F")) { origin case_input; }
        assert "f2": minderjaehriges_kind(entity_ref("urn:de:bgb:vw:s01:K")) { origin case_input; }
        assert "f3": geboren_von(entity_ref("urn:de:bgb:vw:s01:K"), entity_ref("urn:de:bgb:vw:s01:M")) { origin case_input; }
        assert "f4": abstammung(entity_ref("urn:de:bgb:vw:s01:F"), entity_ref("urn:de:bgb:vw:s01:M"), entity_ref("urn:de:bgb:vw:s01:K")) { origin case_input; }
    }
    evaluate truth(elterliche_sorge_gemeinsam(entity_ref("urn:de:bgb:vw:s01:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(elterliche_sorge_allein(entity_ref("urn:de:bgb:vw:s01:K"), entity_ref("urn:de:bgb:vw:s01:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
