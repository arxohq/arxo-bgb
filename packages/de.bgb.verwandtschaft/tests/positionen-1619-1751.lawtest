language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";

test "§§ 1619, 1684, 1751: Kindschaftspflichten aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.verwandtschaft::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1619(entity_ref("urn:kin:k1619"), entity_ref("urn:kin:p1619"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1684(entity_ref("urn:kin:k1684"), entity_ref("urn:kin:p1684"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1751(entity_ref("urn:kin:k1751"), entity_ref("urn:kin:a1751"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Dienstleistung1619, ACTIVE); expect position(Umgang1684, ACTIVE); expect position(Unterhalt1751, ACTIVE);
}

test "§§ 1619, 1684, 1751: Kindschaftspflichten erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.verwandtschaft::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1619(entity_ref("urn:kin:k1619"), entity_ref("urn:kin:p1619"), @2026-01-01) { origin case_input; }
 assert "ag": dienstleistung_1619_geschuldet(entity_ref("urn:kin:k1619"), entity_ref("urn:kin:p1619")) { origin case_input; }
 assert "b": position_trigger_1684(entity_ref("urn:kin:k1684"), entity_ref("urn:kin:p1684"), @2026-01-01) { origin case_input; }
 assert "bg": umgang_1684_geschuldet(entity_ref("urn:kin:k1684"), entity_ref("urn:kin:p1684")) { origin case_input; }
 assert "c": position_trigger_1751(entity_ref("urn:kin:k1751"), entity_ref("urn:kin:a1751"), @2026-01-01) { origin case_input; }
 assert "cg": unterhalt_1751_geschuldet(entity_ref("urn:kin:a1751"), entity_ref("urn:kin:k1751")) { origin case_input; } }
 evaluate positions();
 expect position(Dienstleistung1619, SATISFIED); expect position(Umgang1684, SATISFIED); expect position(Unterhalt1751, SATISFIED);
}
