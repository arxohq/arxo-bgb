language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1612b Abs. 1 Satz 1 Nr. 2, andere Seite derselben Unterscheidung: betreut kein Elternteil, ist das Kindergeld in VOLLER Höhe anzurechnen — 250,00 €; der Barbedarf von 468,00 € mindert sich auf 218,00 €.
test "§ 1612b Abs. 1 Nr. 2: Kindergeld in voller Höhe mindert den Barbedarf" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": minderjaehriges_kind(entity_ref("urn:de:bgb:vw:u06:K")) { origin case_input; }
        assert "f2": lebt_nicht_im_haushalt_des_elternteils(entity_ref("urn:de:bgb:vw:u06:K"), entity_ref("urn:de:bgb:vw:u06:E")) { origin case_input; }
        assert "f3": de.bgb.fristen::geburtstag(entity_ref("urn:de:bgb:vw:u06:K"), @2018-05-10) { origin case_input; }
        assert "f4": de.bgb.fristen::lebensjahr_gefragt(entity_ref("urn:de:bgb:vw:u06:K"), 6 calendar_year) { origin case_input; }
        assert "f5": de.bgb.fristen::lebensjahr_gefragt(entity_ref("urn:de:bgb:vw:u06:K"), 12 calendar_year) { origin case_input; }
        assert "f6": unterhaltsmonat(entity_ref("urn:de:bgb:vw:u06:K"), @2024-04-01) { origin case_input; }
        assert "f7": mindestunterhalt(@2024-01-01, @2024-12-31, 537.00 EUR) { origin case_input; }
        assert "f8": kindergeld(entity_ref("urn:de:bgb:vw:u06:K"), 250.00 EUR) { origin case_input; }
    }
    evaluate truth(anzurechnendes_kindergeld(entity_ref("urn:de:bgb:vw:u06:K"), 250.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(barbedarf_nach_kindergeld(entity_ref("urn:de:bgb:vw:u06:K"), entity_ref("urn:de:bgb:vw:u06:E"), 218.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
