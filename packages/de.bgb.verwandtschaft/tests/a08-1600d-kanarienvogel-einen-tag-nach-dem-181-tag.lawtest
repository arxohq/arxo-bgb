language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1600d Abs. 3 Satz 1, andere Seite der Schwelle: dieselbe Geburt am 20.03.2026, Beiwohnung am 21.09.2025 — einen Tag NACH dem 181. Tag vor der Geburt (20.09.2025). Die Vermutung entsteht nicht.
test "§ 1600d Abs. 3: Beiwohnung einen Tag nach dem 181. Tag — keine Vermutung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geburtstag_des_kindes(entity_ref("urn:de:bgb:vw:a08:K"), @2026-03-20) { origin case_input; }
        assert "f2": beiwohnung_am(entity_ref("urn:de:bgb:vw:a08:K"), entity_ref("urn:de:bgb:vw:a08:M"), @2025-09-21) { origin adjudicated; }
    }
    evaluate truth(beiwohnung_in_der_empfaengniszeit(entity_ref("urn:de:bgb:vw:a08:K"), entity_ref("urn:de:bgb:vw:a08:M")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(als_vater_vermutet(entity_ref("urn:de:bgb:vw:a08:K"), entity_ref("urn:de:bgb:vw:a08:M")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
