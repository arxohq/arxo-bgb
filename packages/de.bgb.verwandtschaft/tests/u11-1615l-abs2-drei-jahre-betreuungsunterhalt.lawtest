language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1615l Abs. 2 Satz 3: kann von der Mutter wegen der Betreuung des Kindes eine Erwerbstätigkeit nicht erwartet werden, besteht die Unterhaltspflicht für mindestens drei Jahre nach der Geburt — bis zum 20.03.2029.
test "§ 1615l Abs. 2: Betreuungsunterhalt für mindestens drei Jahre" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geburt_des_kindes_am(entity_ref("urn:de:bgb:vw:u11:K"), @2026-03-20) { origin case_input; }
        assert "f2": mutter_des_kindes_1615l(entity_ref("urn:de:bgb:vw:u11:K"), entity_ref("urn:de:bgb:vw:u11:M")) { origin case_input; }
        assert "f3": vater_des_kindes_1615l(entity_ref("urn:de:bgb:vw:u11:K"), entity_ref("urn:de:bgb:vw:u11:V")) { origin case_input; }
        assert "f4": erwerbstaetigkeit_wegen_betreuung_nicht_zu_erwarten(entity_ref("urn:de:bgb:vw:u11:M")) { origin case_input; }
    }
    evaluate truth(betreuungsunterhalt_mindestens_bis(entity_ref("urn:de:bgb:vw:u11:M"), entity_ref("urn:de:bgb:vw:u11:V"), @2029-03-20));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
