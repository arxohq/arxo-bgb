language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1617 Abs. 4 Satz 1: treffen die Eltern binnen eines Monats nach der Geburt keine Bestimmung, so erhält das Kind den alphabetischen Doppelnamen kraft Gesetzes. Geburt am 15.01.2026; der Monat endet kalendarisch am 15.02.2026 (§ 187 Abs. 1, § 188 Abs. 2), das ist ein Sonntag, daher tritt nach § 193 der nächste Werktag an seine Stelle — Montag, der 16.02.2026. Am 17.02.2026 ist die Frist abgelaufen.
test "§ 1617 Abs. 4: ohne Bestimmung binnen eines Monats gilt der alphabetische Doppelname" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": elterliche_sorge_gemeinsam(entity_ref("urn:de:bgb:vw:ek02:K")) { origin case_input; }
        assert "f2": geburt_des_kindes_am(entity_ref("urn:de:bgb:vw:ek02:K"), @2026-01-15) { origin case_input; }
        assert "f3": bestimmungsfrist_1617(entity_ref("urn:de:bgb:vw:ek02:K"), entity_ref("urn:de:bgb:vw:ek02:FR")) { origin case_input; }
        assert "f4": erklaerungstag(entity_ref("urn:de:bgb:vw:ek02:K"), @2026-02-17) { origin case_input; }
    }
    evaluate truth(letzter_tag_der_bestimmungsfrist(entity_ref("urn:de:bgb:vw:ek02:K"), @2026-02-16));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(alphabetischer_doppelname_kraft_gesetzes(entity_ref("urn:de:bgb:vw:ek02:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
