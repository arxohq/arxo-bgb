language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// Querschnitt Ehe → Zugewinn § 1378 → Scheidung §§ 1564–1566 → Unterhalt: A und B sind rechtskräftig geschieden seit 30.09.2025. Güterstand: A hat 20.000,00 € → 30.000,00 € (Zugewinn 10.000,00 €), B hat 60.000,00 € → 40.000,00 € (Zugewinn 0, § 1373 kein negativer Zugewinn) — A schuldet B die Hälfte des Überschusses 5.000,00 € (§ 1378 Abs. 1). B betreut das gemeinsame Kind K (geboren 15.07.2024) und kann von A binnen der drei Jahre ohne Billigkeitsprüfung Unterhalt verlangen (§ 1570 Abs. 1 Satz 1). K lebt nicht im Haushalt des A und ist im April 2024 in der ersten Altersstufe: Mindestunterhalt 468,00 € (§ 1612a).
test "Querschnitt: Zugewinnausgleich, nachehelicher Unterhalt und Kindesunterhalt nach wirksamer Scheidung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": de.bgb.ehe::ehegatten(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:A"), entity_ref("urn:de:bgb:vw:fam01:B")) { origin case_input; }
        assert "f2": de.bgb.ehe::kein_ehevertrag(entity_ref("urn:de:bgb:vw:fam01:E")) { origin case_input; }
        assert "f3": de.bgb.ehe::scheidungsurteil_rechtskraeftig_am(entity_ref("urn:de:bgb:vw:fam01:E"), @2025-09-30) { origin adjudicated; }
        assert "f4": de.bgb.ehe::gueterstand_beendet_am(entity_ref("urn:de:bgb:vw:fam01:E"), @2025-09-30) { origin case_input; }
        assert "f5": de.bgb.ehe::gueterstand_auf_andere_weise_als_durch_tod_beendet(entity_ref("urn:de:bgb:vw:fam01:E")) { origin case_input; }
        assert "f6": de.bgb.ehe::vermoegen_beim_eintritt_des_gueterstands(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:A"), 20000.00 EUR) { origin case_input; }
        assert "f7": de.bgb.ehe::vermoegen_beim_eintritt_des_gueterstands(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:B"), 60000.00 EUR) { origin case_input; }
        assert "f8": de.bgb.ehe::vermoegen_bei_beendigung_des_gueterstands(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:A"), 30000.00 EUR) { origin case_input; }
        assert "f9": de.bgb.ehe::vermoegen_bei_beendigung_des_gueterstands(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:B"), 40000.00 EUR) { origin case_input; }
        assert "f10": de.bgb.ehe::keine_hinzurechnung_zum_anfangsvermoegen(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:A")) { origin case_input; }
        assert "f11": de.bgb.ehe::keine_hinzurechnung_zum_anfangsvermoegen(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:B")) { origin case_input; }
        assert "f12": de.bgb.ehe::keine_illoyale_minderung(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:A")) { origin case_input; }
        assert "f13": de.bgb.ehe::keine_illoyale_minderung(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:B")) { origin case_input; }
        assert "f14": de.bgb.ehe::geschiedener_ehegatte(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:B")) { origin case_input; }
        assert "f15": de.bgb.ehe::gemeinschaftliches_kind(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:K")) { origin case_input; }
        assert "f16": de.bgb.ehe::geburt_des_kindes_am(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:K"), @2024-07-15) { origin case_input; }
        assert "f17": de.bgb.ehe::betreuungsfrist_1570(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:K"), entity_ref("urn:de:bgb:vw:fam01:F")) { origin case_input; }
        assert "f18": de.bgb.ehe::pflege_oder_erziehung_des_kindes(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:B"), entity_ref("urn:de:bgb:vw:fam01:K")) { origin case_input; }
        assert "f19": de.bgb.ehe::bewertungstag(entity_ref("urn:de:bgb:vw:fam01:E"), @2026-01-01) { origin case_input; }
        assert "f20": minderjaehriges_kind(entity_ref("urn:de:bgb:vw:fam01:K")) { origin case_input; }
        assert "f21": lebt_nicht_im_haushalt_des_elternteils(entity_ref("urn:de:bgb:vw:fam01:K"), entity_ref("urn:de:bgb:vw:fam01:A")) { origin case_input; }
        assert "f22": de.bgb.fristen::geburtstag(entity_ref("urn:de:bgb:vw:fam01:K"), @2018-05-10) { origin case_input; }
        assert "f23": de.bgb.fristen::lebensjahr_gefragt(entity_ref("urn:de:bgb:vw:fam01:K"), 6 calendar_year) { origin case_input; }
        assert "f24": de.bgb.fristen::lebensjahr_gefragt(entity_ref("urn:de:bgb:vw:fam01:K"), 12 calendar_year) { origin case_input; }
        assert "f25": unterhaltsmonat(entity_ref("urn:de:bgb:vw:fam01:K"), @2024-04-01) { origin case_input; }
        assert "f26": mindestunterhalt(@2024-01-01, @2024-12-31, 537.00 EUR) { origin case_input; }
    }
    evaluate truth(de.bgb.ehe::ehe_geschieden_am(entity_ref("urn:de:bgb:vw:fam01:E"), @2025-09-30));
    expect truth_status == TRUE_ONLY;
    evaluate truth(de.bgb.ehe::ausgleichsforderung(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:B"), entity_ref("urn:de:bgb:vw:fam01:A"), 5000.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(de.bgb.ehe::nachehelicher_unterhaltsanspruch(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:B"), entity_ref("urn:de:bgb:vw:fam01:A"), de.bgb.ehe::Kindesbetreuung_1570));
    expect truth_status == TRUE_ONLY;
    evaluate truth(mindestunterhaltsanspruch(entity_ref("urn:de:bgb:vw:fam01:K"), entity_ref("urn:de:bgb:vw:fam01:A"), 468.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(familienrechtliche_lage_nach_scheidung(entity_ref("urn:de:bgb:vw:fam01:E"), entity_ref("urn:de:bgb:vw:fam01:K"), entity_ref("urn:de:bgb:vw:fam01:B"), entity_ref("urn:de:bgb:vw:fam01:A"), @2025-09-30, 5000.00 EUR, de.bgb.ehe::Kindesbetreuung_1570, 468.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect applied(FamilienrechtlicheLageNachScheidungBerechnen);
    expect evaluation_status == COMPUTED;
}
