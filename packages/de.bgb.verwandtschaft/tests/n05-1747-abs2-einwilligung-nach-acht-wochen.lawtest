language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1747 Abs. 2 Satz 1: Kind geboren am 20.03.2026; acht Wochen später ist der 15.05.2026. Eine an diesem Tag erteilte Einwilligung der Eltern ist wirksam.
test "§ 1747 Abs. 2: Einwilligung der Eltern, wenn das Kind acht Wochen alt ist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geburtstag_des_kindes(entity_ref("urn:de:bgb:vw:n05:K"), @2026-03-20) { origin case_input; }
        assert "f2": einwilligung_eines_elternteils_erteilt_am(entity_ref("urn:de:bgb:vw:n05:K"), entity_ref("urn:de:bgb:vw:n05:M"), @2026-05-15) { origin case_input; }
    }
    evaluate truth(fruehestens_einwilligungsfaehig_ab(entity_ref("urn:de:bgb:vw:n05:K"), @2026-05-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(elterliche_einwilligung_wirksam(entity_ref("urn:de:bgb:vw:n05:K"), entity_ref("urn:de:bgb:vw:n05:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(elterliche_einwilligung_zu_frueh(entity_ref("urn:de:bgb:vw:n05:K"), entity_ref("urn:de:bgb:vw:n05:M")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
