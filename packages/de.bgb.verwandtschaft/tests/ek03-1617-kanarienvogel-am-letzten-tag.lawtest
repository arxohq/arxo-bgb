language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// Kanarienvogel zu ek02: derselbe Sachverhalt, aber die Erklärung fällt auf den LETZTEN Tag der Frist (16.02.2026). Die Frist ist damit nicht abgelaufen, der gesetzliche Doppelname tritt nicht ein.
test "§ 1617 Abs. 4: am letzten Tag der Frist tritt der gesetzliche Doppelname nicht ein" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": elterliche_sorge_gemeinsam(entity_ref("urn:de:bgb:vw:ek03:K")) { origin case_input; }
        assert "f2": geburt_des_kindes_am(entity_ref("urn:de:bgb:vw:ek03:K"), @2026-01-15) { origin case_input; }
        assert "f3": bestimmungsfrist_1617(entity_ref("urn:de:bgb:vw:ek03:K"), entity_ref("urn:de:bgb:vw:ek03:FR")) { origin case_input; }
        assert "f4": erklaerungstag(entity_ref("urn:de:bgb:vw:ek03:K"), @2026-02-16) { origin case_input; }
    }
    evaluate truth(alphabetischer_doppelname_kraft_gesetzes(entity_ref("urn:de:bgb:vw:ek03:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
