language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1743 Satz 1: der Annehmende ist am 15.06.1999 geboren; das 25. Lebensjahr ist mit ABLAUF des 14.06.2024 vollendet (§ 187 Abs. 2 Satz 2, § 188 Abs. 2). Am 15.06.2024 ist das Mindestalter erfüllt.
test "§ 1743: Mindestalter von 25 Jahren am Tag nach der Vollendung erfüllt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": annahmeantrag(entity_ref("urn:de:bgb:vw:n01:A"), entity_ref("urn:de:bgb:vw:n01:K")) { origin case_input; }
        assert "f2": de.bgb.fristen::geburtstag(entity_ref("urn:de:bgb:vw:n01:A"), @1999-06-15) { origin case_input; }
        assert "f3": de.bgb.fristen::lebensjahr_gefragt(entity_ref("urn:de:bgb:vw:n01:A"), 25 calendar_year) { origin case_input; }
        assert "f4": annahmetag(entity_ref("urn:de:bgb:vw:n01:A"), entity_ref("urn:de:bgb:vw:n01:K"), @2024-06-15) { origin case_input; }
    }
    evaluate truth(mindestalter_erfuellt(entity_ref("urn:de:bgb:vw:n01:A"), entity_ref("urn:de:bgb:vw:n01:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(mindestalter_nicht_erfuellt(entity_ref("urn:de:bgb:vw:n01:A"), entity_ref("urn:de:bgb:vw:n01:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
