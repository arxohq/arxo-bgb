language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1600c Abs. 1: im anhängigen Anfechtungsverfahren wird vermutet, dass das Kind von dem Mann abstammt, dessen Vaterschaft besteht. Abs. 2 nimmt davon den Fall des Willensmangels aus; hier ist kein Willensmangel angegeben, die Vermutung hält.
test "§ 1600c Abs. 1: Vaterschaftsvermutung im Anfechtungsverfahren" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": anfechtungsverfahren_anhaengig(entity_ref("urn:de:bgb:vw:a09:K"), entity_ref("urn:de:bgb:vw:a09:V")) { origin case_input; }
    }
    evaluate truth(abstammung_vom_mann_vermutet(entity_ref("urn:de:bgb:vw:a09:K"), entity_ref("urn:de:bgb:vw:a09:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
