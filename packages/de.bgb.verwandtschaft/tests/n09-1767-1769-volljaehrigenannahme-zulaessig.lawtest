language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1767 Abs. 1 mit § 1769: die Annahme eines Volljährigen ist sittlich gerechtfertigt (Antwort des Gerichts) und es stehen keine überwiegenden Interessen entgegen — die Annahme ist zulässig.
test "§§ 1767, 1769: Zulässigkeit der Annahme eines Volljährigen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": annahmeantrag(entity_ref("urn:de:bgb:vw:n09:A"), entity_ref("urn:de:bgb:vw:n09:K")) { origin case_input; }
        assert "f2": anzunehmender_volljaehrig(entity_ref("urn:de:bgb:vw:n09:K")) { origin case_input; }
        assert "f3": annahme_sittlich_gerechtfertigt(entity_ref("urn:de:bgb:vw:n09:A"), entity_ref("urn:de:bgb:vw:n09:K")) { origin adjudicated; }
    }
    evaluate truth(volljaehrigenannahme_zulaessig(entity_ref("urn:de:bgb:vw:n09:A"), entity_ref("urn:de:bgb:vw:n09:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
