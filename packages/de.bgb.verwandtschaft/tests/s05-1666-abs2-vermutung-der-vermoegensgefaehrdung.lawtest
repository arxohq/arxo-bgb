language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1666 Abs. 2: verletzt der Inhaber der Vermögenssorge seine Pflichten, so ist IN DER REGEL anzunehmen, dass das Vermögen des Kindes gefährdet ist. Die Ausnahme des Wortes „in der Regel“ ist eine Wertung und steht in der Ausnahmeklausel der Vermutung; solange das Gericht sie nicht beantwortet hat, FRAGT das Dokument (REQUIRES_JUDGMENT) statt zu schweigen. Die Gegenprobe mit beantworteter Frage steht in s05b.
test "§ 1666 Abs. 2: ohne Antwort des Gerichts fragt die Vermutung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": pflichtverletzung_des_inhabers_der_vermoegenssorge(entity_ref("urn:de:bgb:vw:s05:K")) { origin case_input; }
    }
    evaluate truth(vermoegen_des_kindes_gefaehrdet(entity_ref("urn:de:bgb:vw:s05:K")));
    expect evaluation_status == REQUIRES_JUDGMENT;
}
