language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1666 Abs. 1, 3: das Gericht hat die Gefährdung des Kindeswohls festgestellt und die Entziehung der elterlichen Sorge für erforderlich gehalten; beide Antworten sind Wertungen des Gerichts (§47.3). Die Maßnahme ist zu treffen. Nach einer ANDEREN Maßnahme gefragt, schweigt das Modell nicht, sondern fragt das Gericht: die Erforderlichkeit jeder einzelnen Maßnahme ist eine eigene Wertung (REQUIRES_JUDGMENT).
test "§ 1666: Gefährdung des Kindeswohls — Entziehung der elterlichen Sorge" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kindeswohl_gefaehrdet(entity_ref("urn:de:bgb:vw:s04:K")) { origin adjudicated; }
        assert "f2": massnahme_zur_abwendung_erforderlich(entity_ref("urn:de:bgb:vw:s04:K"), EntziehungDerElterlichenSorge) { origin adjudicated; }
    }
    evaluate truth(massnahme_zu_treffen(entity_ref("urn:de:bgb:vw:s04:K"), EntziehungDerElterlichenSorge));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(massnahme_zu_treffen(entity_ref("urn:de:bgb:vw:s04:K"), GebotSchulpflicht));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
}
