language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1625: gewährt ein Elternteil einem Kind, dessen Vermögen seiner Verwaltung unterliegt, eine Ausstattung, so ist im Zweifel anzunehmen, dass er sie AUS DIESEM VERMÖGEN gewährt. Zugleich § 1624 Abs. 1: die Zuwendung von 20 000,00 € übersteigt das den Umständen entsprechende Maß von 12 000,00 € und gilt insoweit als Schenkung.
test "§ 1625: im Zweifel wird die Ausstattung aus dem Kindesvermögen gewährt" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zuwendung_zur_ausstattung(entity_ref("urn:de:bgb:vw:ek08:K"), entity_ref("urn:de:bgb:vw:ek08:E"), 20000.00 EUR) { origin case_input; }
        assert "f2": vermoegen_unterliegt_der_verwaltung(entity_ref("urn:de:bgb:vw:ek08:K"), entity_ref("urn:de:bgb:vw:ek08:E")) { origin case_input; }
        assert "f3": das_den_umstaenden_entsprechende_mass(entity_ref("urn:de:bgb:vw:ek08:K"), entity_ref("urn:de:bgb:vw:ek08:E"), 12000.00 EUR) { origin case_input; }
    }
    evaluate truth(ausstattung_aus_dem_kindesvermoegen(entity_ref("urn:de:bgb:vw:ek08:K"), entity_ref("urn:de:bgb:vw:ek08:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
