language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1616: führen die Eltern einen Ehenamen, so erhält das Kind ihn als Geburtsnamen. Zugleich die Gegenprobe zu § 1617: das Bestimmungsrecht der Eltern setzt voraus, dass sie KEINEN Ehenamen führen.
test "§ 1616: das Kind erhält den Ehenamen der Eltern als Geburtsnamen" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": eltern_fuehren_ehenamen(entity_ref("urn:de:bgb:vw:ek01:K")) { origin case_input; }
        assert "f2": elterliche_sorge_gemeinsam(entity_ref("urn:de:bgb:vw:ek01:K")) { origin case_input; }
    }
    evaluate truth(geburtsname_ist_der_ehename(entity_ref("urn:de:bgb:vw:ek01:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(bestimmungsrecht_der_eltern(entity_ref("urn:de:bgb:vw:ek01:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
