language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1605 Abs. 1 Satz 1: Verwandte in gerader Linie sind einander zur Auskunft über Einkünfte und Vermögen verpflichtet, soweit dies zur Feststellung eines Unterhaltsanspruchs erforderlich ist. Verlangen und Erforderlichkeit sind Angaben des Falls, die Verwandtschaft wird gerechnet.
test "§ 1605: Auskunftspflicht zwischen Verwandten in gerader Linie" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": familie_des_falls(entity_ref("urn:de:bgb:vw:u12:F")) { origin case_input; }
        assert "f2": abstammung(entity_ref("urn:de:bgb:vw:u12:F"), entity_ref("urn:de:bgb:vw:u12:V"), entity_ref("urn:de:bgb:vw:u12:K")) { origin case_input; }
        assert "f3": auskunft_verlangt(entity_ref("urn:de:bgb:vw:u12:V"), entity_ref("urn:de:bgb:vw:u12:K")) { origin case_input; }
        assert "f4": auskunft_zur_feststellung_erforderlich(entity_ref("urn:de:bgb:vw:u12:V"), entity_ref("urn:de:bgb:vw:u12:K")) { origin case_input; }
    }
    evaluate truth(auskunftspflicht(entity_ref("urn:de:bgb:vw:u12:V"), entity_ref("urn:de:bgb:vw:u12:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
