language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1617a Abs. 4 Satz 1: die Erteilung des Namens bedarf der Einwilligung des Kindes, wenn es das fünfte Lebensjahr vollendet hat. Geburt am 10.06.2020; das fünfte Lebensjahr ist mit Ablauf des 09.06.2025 vollendet (§ 187 Abs. 2, § 188 Abs. 2). Die Erklärung vom 10.06.2025 liegt danach.
test "§ 1617a Abs. 4: ab Vollendung des fünften Lebensjahrs ist die Einwilligung des Kindes erforderlich" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": elterliche_sorge_allein(entity_ref("urn:de:bgb:vw:ek04:K"), entity_ref("urn:de:bgb:vw:ek04:M")) { origin case_input; }
        assert "f2": namenserteilung_erklaert(entity_ref("urn:de:bgb:vw:ek04:K"), entity_ref("urn:de:bgb:vw:ek04:M")) { origin case_input; }
        assert "f3": de.bgb.fristen::geburtstag(entity_ref("urn:de:bgb:vw:ek04:K"), @2020-06-10) { origin case_input; }
        assert "f4": de.bgb.fristen::lebensjahr_gefragt(entity_ref("urn:de:bgb:vw:ek04:K"), 5 calendar_year) { origin case_input; }
        assert "f5": erklaerungstag(entity_ref("urn:de:bgb:vw:ek04:K"), @2025-06-10) { origin case_input; }
    }
    evaluate truth(geburtsname_ist_der_name_des_sorgeberechtigten(entity_ref("urn:de:bgb:vw:ek04:K"), entity_ref("urn:de:bgb:vw:ek04:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(fuenftes_lebensjahr_vollendet(entity_ref("urn:de:bgb:vw:ek04:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(einwilligung_des_kindes_erforderlich(entity_ref("urn:de:bgb:vw:ek04:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
