language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1666a: eine mit der Trennung des Kindes von der elterlichen Familie verbundene Maßnahme ist nur zulässig, wenn der Gefahr nicht auf andere Weise begegnet werden kann (Abs. 1 Satz 1); die GESAMTE Personensorge darf nur entzogen werden, wenn andere Maßnahmen erfolglos geblieben sind oder nicht ausreichen (Abs. 2). Beide Wertungen hat das Gericht beantwortet.
test "§ 1666a: Verhältnismäßigkeit der Trennung und der Entziehung der Personensorge" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kindeswohl_gefaehrdet(entity_ref("urn:de:bgb:vw:sr06:K")) { origin adjudicated; }
        assert "f2": massnahme_trennt_das_kind_von_der_familie(entity_ref("urn:de:bgb:vw:sr06:K"), EntziehungDerElterlichenSorge) { origin case_input; }
        assert "f3": gefahr_nur_durch_trennung_abwendbar(entity_ref("urn:de:bgb:vw:sr06:K")) { origin adjudicated; }
        assert "f4": andere_massnahmen_erfolglos_oder_unzureichend(entity_ref("urn:de:bgb:vw:sr06:K")) { origin case_input; }
    }
    evaluate truth(trennungsmassnahme_zulaessig(entity_ref("urn:de:bgb:vw:sr06:K"), EntziehungDerElterlichenSorge));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(entziehung_der_gesamten_personensorge_zulaessig(entity_ref("urn:de:bgb:vw:sr06:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
