language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1673 Abs. 1: die elterliche Sorge eines geschäftsunfähigen Elternteils RUHT; § 1675: solange sie ruht, ist der Elternteil nicht berechtigt, sie auszuüben. § 1678 Abs. 1: der andere Teil übt die elterliche Sorge allein aus.
test "§§ 1673, 1675, 1678: Ruhen bei Geschäftsunfähigkeit und die Folge für den anderen Elternteil" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f0": minderjaehriges_kind(entity_ref("urn:de:bgb:vw:sr04:K")) { origin case_input; }
        assert "f1": familie_des_falls(entity_ref("urn:de:bgb:vw:sr04:F")) { origin case_input; }
        assert "f2": abstammung(entity_ref("urn:de:bgb:vw:sr04:F"), entity_ref("urn:de:bgb:vw:sr04:V"), entity_ref("urn:de:bgb:vw:sr04:K")) { origin case_input; }
        assert "f3": abstammung(entity_ref("urn:de:bgb:vw:sr04:F"), entity_ref("urn:de:bgb:vw:sr04:M"), entity_ref("urn:de:bgb:vw:sr04:K")) { origin case_input; }
        assert "f4": geboren_von(entity_ref("urn:de:bgb:vw:sr04:K"), entity_ref("urn:de:bgb:vw:sr04:M")) { origin case_input; }
        assert "f5": mit_der_mutter_verheiratet_bei_geburt(entity_ref("urn:de:bgb:vw:sr04:K"), entity_ref("urn:de:bgb:vw:sr04:V")) { origin case_input; }
        assert "f6": eltern_bei_der_geburt_verheiratet(entity_ref("urn:de:bgb:vw:sr04:K")) { origin case_input; }
        assert "f7": elternteil_geschaeftsunfaehig(entity_ref("urn:de:bgb:vw:sr04:K"), entity_ref("urn:de:bgb:vw:sr04:V")) { origin adjudicated; }
    }
    evaluate truth(elterliche_sorge_ruht(entity_ref("urn:de:bgb:vw:sr04:K"), entity_ref("urn:de:bgb:vw:sr04:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(sorge_nicht_auszuueben(entity_ref("urn:de:bgb:vw:sr04:K"), entity_ref("urn:de:bgb:vw:sr04:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anderer_elternteil_uebt_die_sorge_allein_aus(entity_ref("urn:de:bgb:vw:sr04:K"), entity_ref("urn:de:bgb:vw:sr04:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
