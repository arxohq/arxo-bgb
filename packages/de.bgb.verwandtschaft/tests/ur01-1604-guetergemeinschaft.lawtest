language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1604 Satz 1: lebt der Unterhaltspflichtige in Gütergemeinschaft, bestimmt sich seine Unterhaltspflicht Verwandten gegenüber so, als ob das Gesamtgut ihm gehörte. Der Güterstand kommt qualifiziert aus de.bgb.ehe: die Ehegatten haben durch Ehevertrag Gütergemeinschaft vereinbart (§ 1408 Abs. 1, § 1415).
test "§ 1604 Satz 1: Gütergemeinschaft — die Leistungsfähigkeit rechnet mit dem Gesamtgut" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ehe_des_pflichtigen(entity_ref("urn:de:bgb:vw:ur01:P"), entity_ref("urn:de:bgb:vw:ur01:E")) { origin case_input; }
        assert "f2": de.bgb.ehe::ehevertrag_gueterstand(entity_ref("urn:de:bgb:vw:ur01:E"), de.bgb.ehe::Guetergemeinschaft) { origin case_input; }
    }
    evaluate truth(leistungsfaehigkeit_nach_dem_gesamtgut(entity_ref("urn:de:bgb:vw:ur01:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
