language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1610a: werden für Aufwendungen infolge eines Körperschadens Sozialleistungen von 1 200,00 € in Anspruch genommen, so wird vermutet, dass die Kosten nicht geringer sind. Der Gegenbeweis ist ein ausdrücklicher Eingang des Falls; hier fehlt er, die Vermutung hält.
test "§ 1610a: die Deckungsvermutung hält ohne Gegenbeweis" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": sozialleistungen_fuer_schadensbedingte_aufwendungen(entity_ref("urn:de:bgb:vw:ur03:B"), 1200.00 EUR) { origin case_input; }
    }
    evaluate truth(kosten_der_aufwendungen_mindestens(entity_ref("urn:de:bgb:vw:ur03:B"), 1200.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
