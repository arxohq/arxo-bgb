language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// Kanarienvogel zu vs01: ein Erwerb von genau 15 000,00 € ÜBERSTEIGT die Schwelle des § 1640 Abs. 2 Nr. 1 nicht. Die Verzeichnispflicht entfällt.
test "§ 1640 Abs. 2 Nr. 1: bei genau 15 000,00 € entfällt die Verzeichnispflicht" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erwerb_von_todes_wegen_oder_unentgeltlich(entity_ref("urn:de:bgb:vw:vs02:K"), 15000.00 EUR) { origin case_input; }
    }
    evaluate truth(verzeichnispflicht_entfaellt(entity_ref("urn:de:bgb:vw:vs02:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(vermoegensverzeichnis_einzureichen(entity_ref("urn:de:bgb:vw:vs02:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
