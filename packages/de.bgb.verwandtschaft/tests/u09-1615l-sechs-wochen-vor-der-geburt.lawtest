language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1615l Abs. 1 Satz 1: Geburt am 20.03.2026; der Zeitraum reicht von sechs Wochen davor bis acht Wochen danach, also bis zum 15.05.2026. Der 06.02.2026 liegt genau sechs Wochen vor der Geburt und damit noch im Zeitraum (vorwärts gerechnet: 06.02.2026 + sechs Wochen = 20.03.2026, der Tag der Geburt).
test "§ 1615l Abs. 1: sechs Wochen vor der Geburt liegen im Unterhaltszeitraum" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geburt_des_kindes_am(entity_ref("urn:de:bgb:vw:u09:K"), @2026-03-20) { origin case_input; }
        assert "f2": mutter_des_kindes_1615l(entity_ref("urn:de:bgb:vw:u09:K"), entity_ref("urn:de:bgb:vw:u09:M")) { origin case_input; }
        assert "f3": vater_des_kindes_1615l(entity_ref("urn:de:bgb:vw:u09:K"), entity_ref("urn:de:bgb:vw:u09:V")) { origin case_input; }
        assert "f4": unterhaltszeitraum_tag(entity_ref("urn:de:bgb:vw:u09:K"), @2026-02-06) { origin case_input; }
    }
    evaluate truth(letzter_tag_des_zeitraums_1615l(entity_ref("urn:de:bgb:vw:u09:K"), @2026-05-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(sechs_wochen_nach_dem_tag(entity_ref("urn:de:bgb:vw:u09:K"), @2026-03-20));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(unterhalt_aus_anlass_der_geburt(entity_ref("urn:de:bgb:vw:u09:M"), entity_ref("urn:de:bgb:vw:u09:V"), @2026-02-06, @2026-05-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
