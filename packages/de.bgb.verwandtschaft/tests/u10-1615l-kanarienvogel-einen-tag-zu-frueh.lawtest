language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1615l Abs. 1 Satz 1, andere Seite der Schwelle: der 05.02.2026 liegt einen Tag mehr als sechs Wochen vor der Geburt (05.02.2026 + sechs Wochen = 19.03.2026, also VOR der Geburt am 20.03.2026) und damit nicht mehr im Zeitraum.
test "§ 1615l Abs. 1: einen Tag mehr als sechs Wochen vor der Geburt — kein Anspruch" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geburt_des_kindes_am(entity_ref("urn:de:bgb:vw:u10:K"), @2026-03-20) { origin case_input; }
        assert "f2": mutter_des_kindes_1615l(entity_ref("urn:de:bgb:vw:u10:K"), entity_ref("urn:de:bgb:vw:u10:M")) { origin case_input; }
        assert "f3": vater_des_kindes_1615l(entity_ref("urn:de:bgb:vw:u10:K"), entity_ref("urn:de:bgb:vw:u10:V")) { origin case_input; }
        assert "f4": unterhaltszeitraum_tag(entity_ref("urn:de:bgb:vw:u10:K"), @2026-02-05) { origin case_input; }
    }
    evaluate truth(unterhalt_aus_anlass_der_geburt(entity_ref("urn:de:bgb:vw:u10:M"), entity_ref("urn:de:bgb:vw:u10:V"), @2026-02-05, @2026-05-15));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
