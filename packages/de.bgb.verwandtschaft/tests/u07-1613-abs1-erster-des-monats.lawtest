language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1613 Abs. 1 Satz 2: der Verpflichtete ist am 18.07.2025 zur Auskunft aufgefordert worden und der Anspruch bestand zu diesem Zeitpunkt dem Grunde nach; der Unterhalt wird ab dem ERSTEN des Monats geschuldet, in den das Ereignis fällt — ab dem 01.07.2025.
test "§ 1613 Abs. 1: Unterhalt ab dem Ersten des Monats der Aufforderung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": aufforderung_zur_auskunft_am(entity_ref("urn:de:bgb:vw:u07:P"), entity_ref("urn:de:bgb:vw:u07:B"), @2025-07-18) { origin case_input; }
        assert "f2": anspruch_dem_grunde_nach_bestand_am(entity_ref("urn:de:bgb:vw:u07:P"), entity_ref("urn:de:bgb:vw:u07:B"), @2025-07-18) { origin case_input; }
    }
    evaluate truth(unterhalt_geschuldet_ab(entity_ref("urn:de:bgb:vw:u07:P"), entity_ref("urn:de:bgb:vw:u07:B"), @2025-07-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
