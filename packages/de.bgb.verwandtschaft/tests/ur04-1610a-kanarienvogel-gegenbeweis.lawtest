language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// Kanarienvogel zu ur03: derselbe Sachverhalt, aber der Gegenbeweis ist geführt (§ 1610a, Widerlegung der Vermutung). Die Vermutung trägt dann nicht mehr.
test "§ 1610a: mit geführtem Gegenbeweis trägt die Vermutung nicht" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": sozialleistungen_fuer_schadensbedingte_aufwendungen(entity_ref("urn:de:bgb:vw:ur04:B"), 1200.00 EUR) { origin case_input; }
        assert "f2": geringere_kosten_nachgewiesen(entity_ref("urn:de:bgb:vw:ur04:B"), 1200.00 EUR) { origin case_input; }
    }
    evaluate truth(kosten_der_aufwendungen_mindestens(entity_ref("urn:de:bgb:vw:ur04:B"), 1200.00 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
