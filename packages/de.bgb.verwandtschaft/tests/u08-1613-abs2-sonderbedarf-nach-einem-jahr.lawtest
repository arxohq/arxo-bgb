language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1613 Abs. 2 Nr. 1: der Sonderbedarf ist am 15.05.2024 entstanden, die Jahresfrist endet am 15.05.2025 (ein Donnerstag, § 193 ändert nichts). Am 16.05.2025 kann der Sonderbedarf ohne vorherigen Verzug oder Rechtshängigkeit nicht mehr geltend gemacht werden.
test "§ 1613 Abs. 2 Nr. 1: Sonderbedarf nach Ablauf eines Jahres" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": sonderbedarf_entstanden_am(entity_ref("urn:de:bgb:vw:u08:B"), @2024-05-15) { origin case_input; }
        assert "f2": sonderbedarfsfrist(entity_ref("urn:de:bgb:vw:u08:B"), entity_ref("urn:de:bgb:vw:u08:F")) { origin case_input; }
        assert "f3": bewertungstag(entity_ref("urn:de:bgb:vw:u08:B"), @2025-05-16) { origin case_input; }
    }
    evaluate truth(letzter_tag_der_sonderbedarfsfrist(entity_ref("urn:de:bgb:vw:u08:B"), @2025-05-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(sonderbedarf_nicht_mehr_geltend_zu_machen(entity_ref("urn:de:bgb:vw:u08:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
