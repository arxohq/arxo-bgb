language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1615a: besteht für das Kind keine Vaterschaft nach § 1592 Nr. 1 oder § 1593 und haben die Eltern das Kind weder während ihrer Ehe gezeugt noch nach der Geburt einander geheiratet, so gelten die allgemeinen Vorschriften. Das Schweigen des Falls zu den drei Verneinungen ist hier ausdrücklich: keine Ehe bei der Geburt, keine Zeugung in der Ehe, keine spätere Heirat.
test "§ 1615a: ohne Vaterschaft nach § 1592 Nr. 1 gelten die allgemeinen Vorschriften" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geburt_des_kindes_am(entity_ref("urn:de:bgb:vw:ur05:K"), @2026-03-04) { origin case_input; }
    }
    evaluate truth(allgemeine_vorschriften_anwendbar(entity_ref("urn:de:bgb:vw:ur05:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
