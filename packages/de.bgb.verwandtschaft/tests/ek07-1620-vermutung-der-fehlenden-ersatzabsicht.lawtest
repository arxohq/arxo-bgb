language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1620: macht ein dem elterlichen Hausstand angehörendes volljähriges Kind eine Aufwendung für die Kosten des Haushalts, so ist IM ZWEIFEL anzunehmen, dass die Absicht fehlt, Ersatz zu verlangen. Der Nachweis der Ersatzabsicht ist ein ausdrücklicher Eingang; hier fehlt er.
test "§ 1620: im Zweifel fehlt die Absicht, Ersatz zu verlangen" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": volljaehriges_kind_im_elterlichen_hausstand(entity_ref("urn:de:bgb:vw:ek07:K"), entity_ref("urn:de:bgb:vw:ek07:E")) { origin case_input; }
        assert "f2": aufwendung_fuer_den_haushalt(entity_ref("urn:de:bgb:vw:ek07:K"), entity_ref("urn:de:bgb:vw:ek07:E")) { origin case_input; }
    }
    evaluate truth(ersatzabsicht_fehlt(entity_ref("urn:de:bgb:vw:ek07:K"), entity_ref("urn:de:bgb:vw:ek07:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
