language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1746 Abs. 1 Satz 3, Abs. 2: das Kind ist am 20.08.2011 geboren, das 14. Lebensjahr ist mit Ablauf des 19.08.2025 vollendet. Am 20.08.2025 erklärt das Kind die Einwilligung selbst und kann sie bis zum Wirksamwerden widerrufen.
test "§ 1746: ab Vollendung des 14. Lebensjahrs erklärt das Kind selbst" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": annahmeantrag(entity_ref("urn:de:bgb:vw:n03:A"), entity_ref("urn:de:bgb:vw:n03:K")) { origin case_input; }
        assert "f2": de.bgb.fristen::geburtstag(entity_ref("urn:de:bgb:vw:n03:K"), @2011-08-20) { origin case_input; }
        assert "f3": de.bgb.fristen::lebensjahr_gefragt(entity_ref("urn:de:bgb:vw:n03:K"), 14 calendar_year) { origin case_input; }
        assert "f4": annahmetag(entity_ref("urn:de:bgb:vw:n03:A"), entity_ref("urn:de:bgb:vw:n03:K"), @2025-08-20) { origin case_input; }
        assert "f5": einwilligung_des_kindes_erteilt(entity_ref("urn:de:bgb:vw:n03:K"), entity_ref("urn:de:bgb:vw:n03:A")) { origin case_input; }
    }
    evaluate truth(kind_erklaert_selbst(entity_ref("urn:de:bgb:vw:n03:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(widerruf_der_einwilligung_moeglich(entity_ref("urn:de:bgb:vw:n03:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(einwilligung_des_kindes_wirksam(entity_ref("urn:de:bgb:vw:n03:K"), entity_ref("urn:de:bgb:vw:n03:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
