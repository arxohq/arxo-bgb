language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1600d Abs. 3 Satz 1: Geburt am 20.03.2026; die Empfängniszeit reicht vom 300. Tag (24.05.2025) bis zum 181. Tag (20.09.2025) vor der Geburt, beide Tage eingeschlossen. Die Beiwohnung am 01.07.2025 liegt darin; ohne schwerwiegende Zweifel wird der Mann als Vater vermutet (Abs. 2).
test "§ 1600d Abs. 2, 3: Beiwohnung in der Empfängniszeit begründet die Vermutung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geburtstag_des_kindes(entity_ref("urn:de:bgb:vw:a07:K"), @2026-03-20) { origin case_input; }
        assert "f2": beiwohnung_am(entity_ref("urn:de:bgb:vw:a07:K"), entity_ref("urn:de:bgb:vw:a07:M"), @2025-07-01) { origin adjudicated; }
    }
    evaluate truth(fruehestmoegliche_geburt(entity_ref("urn:de:bgb:vw:a07:K"), entity_ref("urn:de:bgb:vw:a07:M"), @2025-12-29));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(spaetestmoegliche_geburt(entity_ref("urn:de:bgb:vw:a07:K"), entity_ref("urn:de:bgb:vw:a07:M"), @2026-04-27));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(beiwohnung_in_der_empfaengniszeit(entity_ref("urn:de:bgb:vw:a07:K"), entity_ref("urn:de:bgb:vw:a07:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(als_vater_vermutet(entity_ref("urn:de:bgb:vw:a07:K"), entity_ref("urn:de:bgb:vw:a07:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
