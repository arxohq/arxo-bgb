language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1612b Abs. 1 Satz 1 Nr. 1: erfüllt ein Elternteil seine Unterhaltspflicht durch Betreuung (§ 1606 Abs. 3 Satz 2 — Antwort des Gerichts), so ist das Kindergeld von 250,00 € nur ZUR HÄLFTE anzurechnen: 125,00 €. Der Barbedarf von 468,00 € (erste Altersstufe, u02) mindert sich auf 343,00 €.
test "§ 1612b Abs. 1 Nr. 1: Kindergeld zur Hälfte mindert den Barbedarf" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": minderjaehriges_kind(entity_ref("urn:de:bgb:vw:u05:K")) { origin case_input; }
        assert "f2": lebt_nicht_im_haushalt_des_elternteils(entity_ref("urn:de:bgb:vw:u05:K"), entity_ref("urn:de:bgb:vw:u05:E")) { origin case_input; }
        assert "f3": de.bgb.fristen::geburtstag(entity_ref("urn:de:bgb:vw:u05:K"), @2018-05-10) { origin case_input; }
        assert "f4": de.bgb.fristen::lebensjahr_gefragt(entity_ref("urn:de:bgb:vw:u05:K"), 6 calendar_year) { origin case_input; }
        assert "f5": de.bgb.fristen::lebensjahr_gefragt(entity_ref("urn:de:bgb:vw:u05:K"), 12 calendar_year) { origin case_input; }
        assert "f6": unterhaltsmonat(entity_ref("urn:de:bgb:vw:u05:K"), @2024-04-01) { origin case_input; }
        assert "f7": mindestunterhalt(@2024-01-01, @2024-12-31, 537.00 EUR) { origin case_input; }
        assert "f8": kindergeld(entity_ref("urn:de:bgb:vw:u05:K"), 250.00 EUR) { origin case_input; }
        assert "f9": betreuung_erfuellt_die_unterhaltspflicht(entity_ref("urn:de:bgb:vw:u05:B"), entity_ref("urn:de:bgb:vw:u05:K")) { origin adjudicated; }
    }
    evaluate truth(anzurechnendes_kindergeld(entity_ref("urn:de:bgb:vw:u05:K"), 125.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(barbedarf_nach_kindergeld(entity_ref("urn:de:bgb:vw:u05:K"), entity_ref("urn:de:bgb:vw:u05:E"), 343.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
