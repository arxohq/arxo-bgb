language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// §§ 1601–1603: Vater und Kind sind in gerader Linie verwandt (§ 1589 Abs. 1 Satz 1, gerechnet aus der Blutkante des Graphen). Das Gericht hat festgestellt, dass das Kind außerstande ist, sich selbst zu unterhalten (§ 1602 Abs. 1); zur Leistungsfähigkeit des Vaters liegt keine gegenteilige Antwort vor (§ 1603 Abs. 1). Der Anspruch besteht.
test "§§ 1601–1603: Unterhaltsanspruch des Kindes gegen den Vater in gerader Linie" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": familie_des_falls(entity_ref("urn:de:bgb:vw:u01:F")) { origin case_input; }
        assert "f2": abstammung(entity_ref("urn:de:bgb:vw:u01:F"), entity_ref("urn:de:bgb:vw:u01:V"), entity_ref("urn:de:bgb:vw:u01:K")) { origin case_input; }
        assert "f3": ausserstande_sich_selbst_zu_unterhalten(entity_ref("urn:de:bgb:vw:u01:K")) { origin adjudicated; }
    }
    evaluate truth(verwandt_in_gerader_linie(entity_ref("urn:de:bgb:vw:u01:F"), entity_ref("urn:de:bgb:vw:u01:V"), entity_ref("urn:de:bgb:vw:u01:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(unterhaltspflicht_dem_grunde_nach(entity_ref("urn:de:bgb:vw:u01:F"), entity_ref("urn:de:bgb:vw:u01:V"), entity_ref("urn:de:bgb:vw:u01:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(beduerftig(entity_ref("urn:de:bgb:vw:u01:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(unterhaltsanspruch_besteht(entity_ref("urn:de:bgb:vw:u01:F"), entity_ref("urn:de:bgb:vw:u01:V"), entity_ref("urn:de:bgb:vw:u01:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
