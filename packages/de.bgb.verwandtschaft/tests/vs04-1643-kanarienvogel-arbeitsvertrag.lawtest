language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// Kanarienvogel zu vs03 („minus ein Merkmal“): derselbe lange Vertrag, aber es handelt sich um einen Ausbildungs-, Dienst- oder Arbeitsvertrag (§ 1643 Abs. 4 Satz 2 Nr. 1). Eine Genehmigung ist nicht erforderlich.
test "§ 1643 Abs. 4 Satz 2 Nr. 1: der Arbeitsvertrag ist nicht genehmigungsbedürftig" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": de.bgb.fristen::geburtstag(entity_ref("urn:de:bgb:vw:vs04:K"), @2006-05-20) { origin case_input; }
        assert "f2": de.bgb.fristen::lebensjahr_gefragt(entity_ref("urn:de:bgb:vw:vs04:K"), 18 calendar_year) { origin case_input; }
        assert "f3": dauerschuldvertrag_endet_am(entity_ref("urn:de:bgb:vw:vs04:K"), @2025-06-30) { origin case_input; }
        assert "f4": ausbildungs_dienst_oder_arbeitsvertrag(entity_ref("urn:de:bgb:vw:vs04:K")) { origin case_input; }
    }
    evaluate truth(genehmigung_nicht_erforderlich_1643(entity_ref("urn:de:bgb:vw:vs04:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(genehmigung_des_familiengerichts_erforderlich_1643(entity_ref("urn:de:bgb:vw:vs04:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
