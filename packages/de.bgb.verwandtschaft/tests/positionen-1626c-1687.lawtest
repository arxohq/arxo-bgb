language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";

test "§§ 1626c, 1631b, 1687: Sorgepositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.verwandtschaft::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1626c(entity_ref("urn:kin:k1626c"), entity_ref("urn:kin:p1626c"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1631b(entity_ref("urn:kin:k1631b"), entity_ref("urn:kin:p1631b"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1687(entity_ref("urn:kin:k1687"), entity_ref("urn:kin:p1687"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Zustimmung1626c, ACTIVE); expect position(Genehmigung1631b, ACTIVE); expect position(Alleinentscheidung1687, ACTIVE);
}

test "§§ 1626c, 1631b, 1687: Sorgepositionen erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.verwandtschaft::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1626c(entity_ref("urn:kin:k1626c"), entity_ref("urn:kin:p1626c"), @2026-01-01) { origin case_input; }
 assert "ag": zustimmung_1626c_geschuldet(entity_ref("urn:kin:k1626c"), entity_ref("urn:kin:p1626c")) { origin case_input; }
 assert "b": position_trigger_1631b(entity_ref("urn:kin:k1631b"), entity_ref("urn:kin:p1631b"), @2026-01-01) { origin case_input; }
 assert "bg": genehmigung_1631b_geschuldet(entity_ref("urn:kin:k1631b")) { origin case_input; }
 assert "c": position_trigger_1687(entity_ref("urn:kin:k1687"), entity_ref("urn:kin:p1687"), @2026-01-01) { origin case_input; }
 assert "cg": alleinentscheidung_1687_ausuebbar(entity_ref("urn:kin:k1687"), entity_ref("urn:kin:p1687")) { origin case_input; } }
 evaluate positions();
 expect position(Zustimmung1626c, SATISFIED); expect position(Genehmigung1631b, SATISFIED); expect position(Alleinentscheidung1687, ACTIVE);
}
