language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1626a Abs. 1 Nr. 1 mit § 1626d Abs. 1: öffentlich beurkundete Sorgeerklärungen begründen die gemeinsame elterliche Sorge; sie umfasst die gemeinschaftliche Vertretung des Kindes (§ 1629 Abs. 1 Satz 2).
test "§ 1626a Abs. 1 Nr. 1: beurkundete Sorgeerklärungen begründen die gemeinsame Sorge" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": minderjaehriges_kind(entity_ref("urn:de:bgb:vw:s02:K")) { origin case_input; }
        assert "f2": sorgeerklaerungen_abgegeben(entity_ref("urn:de:bgb:vw:s02:K")) { origin case_input; }
        assert "f3": sorgeerklaerung_oeffentlich_beurkundet(entity_ref("urn:de:bgb:vw:s02:K")) { origin case_input; }
    }
    evaluate truth(sorgeerklaerung_unwirksam(entity_ref("urn:de:bgb:vw:s02:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(elterliche_sorge_gemeinsam(entity_ref("urn:de:bgb:vw:s02:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(vertretung_des_kindes_gemeinschaftlich(entity_ref("urn:de:bgb:vw:s02:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
