language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1687 Abs. 1 Satz 1, 2: Eltern mit gemeinsamer Sorge leben getrennt; der Elternteil, bei dem sich das Kind gewöhnlich aufhält, entscheidet in Angelegenheiten des täglichen Lebens allein.
test "§ 1687: Alleinentscheidung des Elternteils, bei dem das Kind lebt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": minderjaehriges_kind(entity_ref("urn:de:bgb:vw:s06:K")) { origin case_input; }
        assert "f2": eltern_bei_der_geburt_verheiratet(entity_ref("urn:de:bgb:vw:s06:K")) { origin case_input; }
        assert "f3": eltern_leben_getrennt(entity_ref("urn:de:bgb:vw:s06:K")) { origin case_input; }
        assert "f4": kind_haelt_sich_gewoehnlich_auf_bei(entity_ref("urn:de:bgb:vw:s06:K"), entity_ref("urn:de:bgb:vw:s06:M")) { origin case_input; }
    }
    evaluate truth(elterliche_sorge_gemeinsam(entity_ref("urn:de:bgb:vw:s06:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(alleinentscheidung_in_angelegenheiten_des_taeglichen_lebens(entity_ref("urn:de:bgb:vw:s06:K"), entity_ref("urn:de:bgb:vw:s06:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
