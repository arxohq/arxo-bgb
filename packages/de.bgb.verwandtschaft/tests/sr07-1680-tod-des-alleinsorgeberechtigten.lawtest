language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1680 Abs. 2: ist ein Elternteil, dem die elterliche Sorge ALLEIN zustand, gestorben, so hat das Familiengericht die elterliche Sorge dem überlebenden Elternteil zu übertragen, wenn dies dem Wohl des Kindes nicht widerspricht. Unabhängige Erwartung: BMJ, „Das Kindschaftsrecht“ (Stand 2025, S. 19): „Stand dem verstorbenen Elternteil die elterliche Sorge vor seinem Tod allein zu, so ist eine gerichtliche Entscheidung erforderlich. Das Familiengericht überträgt dem überlebenden Elternteil die elterliche Sorge, wenn dies dem Wohl des Kindes nicht widerspricht.“ — Schnappschuss in sources/bmj-kindschaftsrecht/.
test "§ 1680 Abs. 2: Tod des allein sorgeberechtigten Elternteils — Übertragung auf den überlebenden" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": familie_des_falls(entity_ref("urn:de:bgb:vw:sr07:F")) { origin case_input; }
        assert "f2": minderjaehriges_kind(entity_ref("urn:de:bgb:vw:sr07:K")) { origin case_input; }
        assert "f3": abstammung(entity_ref("urn:de:bgb:vw:sr07:F"), entity_ref("urn:de:bgb:vw:sr07:M"), entity_ref("urn:de:bgb:vw:sr07:K")) { origin case_input; }
        assert "f4": abstammung(entity_ref("urn:de:bgb:vw:sr07:F"), entity_ref("urn:de:bgb:vw:sr07:V"), entity_ref("urn:de:bgb:vw:sr07:K")) { origin case_input; }
        assert "f5": geboren_von(entity_ref("urn:de:bgb:vw:sr07:K"), entity_ref("urn:de:bgb:vw:sr07:M")) { origin case_input; }
        assert "f6": mit_der_mutter_verheiratet_bei_geburt(entity_ref("urn:de:bgb:vw:sr07:K"), entity_ref("urn:de:bgb:vw:sr07:V")) { origin case_input; }
        assert "f7": alleinsorge_gerichtlich_uebertragen(entity_ref("urn:de:bgb:vw:sr07:K"), entity_ref("urn:de:bgb:vw:sr07:M")) { origin adjudicated; }
        assert "f8": elternteil_gestorben(entity_ref("urn:de:bgb:vw:sr07:K"), entity_ref("urn:de:bgb:vw:sr07:M")) { origin case_input; }
    }
    evaluate truth(elterliche_sorge_allein(entity_ref("urn:de:bgb:vw:sr07:K"), entity_ref("urn:de:bgb:vw:sr07:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(sorge_dem_ueberlebenden_elternteil_zu_uebertragen(entity_ref("urn:de:bgb:vw:sr07:K"), entity_ref("urn:de:bgb:vw:sr07:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(sorge_steht_dem_ueberlebenden_elternteil_zu(entity_ref("urn:de:bgb:vw:sr07:K"), entity_ref("urn:de:bgb:vw:sr07:V")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
