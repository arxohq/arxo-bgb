language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1592 Nr. 1: Vater ist der Mann, der zum Zeitpunkt der Geburt mit der Mutter verheiratet ist.
test "§ 1592 Nr. 1: Vaterschaft kraft Ehe bei der Geburt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": mit_der_mutter_verheiratet_bei_geburt(entity_ref("urn:de:bgb:vw:a02:K"), entity_ref("urn:de:bgb:vw:a02:V")) { origin case_input; }
    }
    evaluate truth(vaterschaft_nach_1592_nr1(entity_ref("urn:de:bgb:vw:a02:K"), entity_ref("urn:de:bgb:vw:a02:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(vater(entity_ref("urn:de:bgb:vw:a02:K"), entity_ref("urn:de:bgb:vw:a02:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
