language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1641: die Eltern können nicht in Vertretung des Kindes Schenkungen machen; ausgenommen sind Schenkungen, durch die einer sittlichen Pflicht oder einer auf den Anstand zu nehmenden Rücksicht entsprochen wird. Hier greift die Ausnahme — das Verbot also nicht.
test "§ 1641: die Anstandsschenkung ist vom Verbot ausgenommen" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": schenkung_in_vertretung_des_kindes(entity_ref("urn:de:bgb:vw:vs05:K")) { origin case_input; }
        assert "f2": schenkung_aus_sittlicher_pflicht_oder_anstand(entity_ref("urn:de:bgb:vw:vs05:K")) { origin case_input; }
    }
    evaluate truth(schenkung_ausgenommen(entity_ref("urn:de:bgb:vw:vs05:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(schenkung_unzulaessig(entity_ref("urn:de:bgb:vw:vs05:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
