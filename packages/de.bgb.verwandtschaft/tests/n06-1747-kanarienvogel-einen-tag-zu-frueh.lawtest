language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1747 Abs. 2 Satz 1, andere Seite der Schwelle: eine am 14.05.2026 — einen Tag vor Ablauf der acht Wochen — erteilte Einwilligung kann nicht erteilt werden.
test "§ 1747 Abs. 2: Einwilligung einen Tag zu früh" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geburtstag_des_kindes(entity_ref("urn:de:bgb:vw:n06:K"), @2026-03-20) { origin case_input; }
        assert "f2": einwilligung_eines_elternteils_erteilt_am(entity_ref("urn:de:bgb:vw:n06:K"), entity_ref("urn:de:bgb:vw:n06:M"), @2026-05-14) { origin case_input; }
    }
    evaluate truth(elterliche_einwilligung_zu_frueh(entity_ref("urn:de:bgb:vw:n06:K"), entity_ref("urn:de:bgb:vw:n06:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(elterliche_einwilligung_wirksam(entity_ref("urn:de:bgb:vw:n06:K"), entity_ref("urn:de:bgb:vw:n06:M")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
