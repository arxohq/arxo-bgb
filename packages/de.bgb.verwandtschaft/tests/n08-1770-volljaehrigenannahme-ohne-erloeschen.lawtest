language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1770 Abs. 1, 2: bei der Annahme eines Volljährigen erstrecken sich die Wirkungen nicht auf die Verwandten des Annehmenden, und die Verwandtschaft des Angenommenen zu seinen Verwandten bleibt bestehen — die Kehrseite von n07 am gleichen Sachverhalt.
test "§ 1770: Annahme eines Volljährigen — die bisherige Verwandtschaft bleibt bestehen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": familie_des_falls(entity_ref("urn:de:bgb:vw:n08:F")) { origin case_input; }
        assert "f2": abstammung(entity_ref("urn:de:bgb:vw:n08:F"), entity_ref("urn:de:bgb:vw:n08:V"), entity_ref("urn:de:bgb:vw:n08:K")) { origin case_input; }
        assert "f3": annahme_als_kind(entity_ref("urn:de:bgb:vw:n08:F"), entity_ref("urn:de:bgb:vw:n08:A"), entity_ref("urn:de:bgb:vw:n08:K")) { origin case_input; }
        assert "f4": annahme_eines_volljaehrigen(entity_ref("urn:de:bgb:vw:n08:F"), entity_ref("urn:de:bgb:vw:n08:K")) { origin case_input; }
        assert "f5": anzunehmender_volljaehrig(entity_ref("urn:de:bgb:vw:n08:K")) { origin case_input; }
        assert "f6": annahme_ausgesprochen(entity_ref("urn:de:bgb:vw:n08:A"), entity_ref("urn:de:bgb:vw:n08:K")) { origin adjudicated; }
    }
    evaluate truth(verwandtschaft_bleibt_bestehen(entity_ref("urn:de:bgb:vw:n08:K"), entity_ref("urn:de:bgb:vw:n08:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(keine_schwaegerschaft_durch_volljaehrigenannahme(entity_ref("urn:de:bgb:vw:n08:A"), entity_ref("urn:de:bgb:vw:n08:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(unterhalt_vor_den_leiblichen_verwandten(entity_ref("urn:de:bgb:vw:n08:A"), entity_ref("urn:de:bgb:vw:n08:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verwandtschaft_erloschen(entity_ref("urn:de:bgb:vw:n08:K"), entity_ref("urn:de:bgb:vw:n08:V")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
