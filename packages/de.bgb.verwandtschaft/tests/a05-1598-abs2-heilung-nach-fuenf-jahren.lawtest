language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1598 Abs. 2 Satz 1: Eintragung am 15.03.2020, fünf Jahre enden mit dem 15.03.2025 (§ 188 Abs. 2, same_day). Der 15.03.2025 ist ein Sonnabend; § 193 wird hier NICHT gelesen, weil innerhalb der Frist nichts zu erklären ist — die Heilung tritt von selbst ein. Am 16.03.2025 ist die Anerkennung wirksam, obwohl die Zustimmung der Mutter fehlt.
test "§ 1598 Abs. 2: fünf Jahre seit der Eintragung heilen die Anerkennung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": vaterschaft_anerkannt(entity_ref("urn:de:bgb:vw:a05:K"), entity_ref("urn:de:bgb:vw:a05:V")) { origin case_input; }
        assert "f2": eintragung_in_personenstandsregister_am(entity_ref("urn:de:bgb:vw:a05:K"), entity_ref("urn:de:bgb:vw:a05:V"), @2020-03-15) { origin case_input; }
        assert "f3": heilungsfrist_1598(entity_ref("urn:de:bgb:vw:a05:K"), entity_ref("urn:de:bgb:vw:a05:F")) { origin case_input; }
        assert "f4": bewertungstag(entity_ref("urn:de:bgb:vw:a05:K"), @2025-03-16) { origin case_input; }
    }
    evaluate truth(letzter_tag_der_heilungsfrist(entity_ref("urn:de:bgb:vw:a05:K"), @2025-03-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anerkennung_geheilt(entity_ref("urn:de:bgb:vw:a05:K"), entity_ref("urn:de:bgb:vw:a05:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anerkennung_unwirksam(entity_ref("urn:de:bgb:vw:a05:K"), entity_ref("urn:de:bgb:vw:a05:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anerkennung_wirksam(entity_ref("urn:de:bgb:vw:a05:K"), entity_ref("urn:de:bgb:vw:a05:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
