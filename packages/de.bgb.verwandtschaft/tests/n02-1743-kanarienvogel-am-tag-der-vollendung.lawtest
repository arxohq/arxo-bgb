language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1743 Satz 1, andere Seite der Schwelle: AM Tag der Vollendung (14.06.2024) ist das 25. Lebensjahr noch nicht vollendet — die Frist endet erst mit dem Ablauf dieses Tages (Ledger D-09-06). Das Mindestalter ist nicht erfüllt.
test "§ 1743: am Tag der Vollendung ist das 25. Lebensjahr noch nicht vollendet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": annahmeantrag(entity_ref("urn:de:bgb:vw:n02:A"), entity_ref("urn:de:bgb:vw:n02:K")) { origin case_input; }
        assert "f2": de.bgb.fristen::geburtstag(entity_ref("urn:de:bgb:vw:n02:A"), @1999-06-15) { origin case_input; }
        assert "f3": de.bgb.fristen::lebensjahr_gefragt(entity_ref("urn:de:bgb:vw:n02:A"), 25 calendar_year) { origin case_input; }
        assert "f4": annahmetag(entity_ref("urn:de:bgb:vw:n02:A"), entity_ref("urn:de:bgb:vw:n02:K"), @2024-06-14) { origin case_input; }
    }
    evaluate truth(mindestalter_nicht_erfuellt(entity_ref("urn:de:bgb:vw:n02:A"), entity_ref("urn:de:bgb:vw:n02:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(mindestalter_erfuellt(entity_ref("urn:de:bgb:vw:n02:A"), entity_ref("urn:de:bgb:vw:n02:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
