language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// §§ 1713 Abs. 1, 1714, 1717 Satz 1: der allein sorgeberechtigte Elternteil ist antragsberechtigt, die Beistandschaft tritt mit dem Zugang des Antrags beim Jugendamt ein und besteht nur, wenn das Kind seinen gewöhnlichen Aufenthalt im Inland hat.
test "§§ 1713, 1714, 1717: die Beistandschaft tritt mit dem Zugang ein" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": antrag_auf_beistandschaft(entity_ref("urn:de:bgb:vw:bs01:K"), entity_ref("urn:de:bgb:vw:bs01:M")) { origin case_input; }
        assert "f2": antragsteller_hat_alleinsorge_oder_obhut(entity_ref("urn:de:bgb:vw:bs01:K"), entity_ref("urn:de:bgb:vw:bs01:M")) { origin case_input; }
        assert "f3": antrag_dem_jugendamt_zugegangen_am(entity_ref("urn:de:bgb:vw:bs01:K"), entity_ref("urn:de:bgb:vw:bs01:M"), @2026-04-01) { origin case_input; }
        assert "f4": gewoehnlicher_aufenthalt_im_inland(entity_ref("urn:de:bgb:vw:bs01:K")) { origin case_input; }
    }
    evaluate truth(antragsberechtigt(entity_ref("urn:de:bgb:vw:bs01:K"), entity_ref("urn:de:bgb:vw:bs01:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(beistandschaft_tritt_ein_am(entity_ref("urn:de:bgb:vw:bs01:K"), entity_ref("urn:de:bgb:vw:bs01:M"), @2026-04-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(elterliche_sorge_nicht_eingeschraenkt(entity_ref("urn:de:bgb:vw:bs01:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
