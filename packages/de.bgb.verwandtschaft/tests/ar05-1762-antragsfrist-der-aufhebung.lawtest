language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1762 Abs. 2 Satz 1: der Aufhebungsantrag kann nur innerhalb EINES JAHRES gestellt werden, wenn seit der Annahme noch keine DREI JAHRE verstrichen sind. Annahme am 10.01.2024 → drei Jahre bis zum 10.01.2027; Fristbeginn am 01.02.2026 → ein Jahr bis zum 01.02.2027. Der Antrag vom 01.12.2026 liegt innerhalb beider Grenzen.
test "§ 1762 Abs. 2: der Aufhebungsantrag innerhalb eines Jahres und der drei Jahre" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": annahme_ausgesprochen_am(entity_ref("urn:de:bgb:vw:ar05:K"), @2024-01-10) { origin case_input; }
        assert "f2": fristbeginn_des_aufhebungsantrags(entity_ref("urn:de:bgb:vw:ar05:A"), entity_ref("urn:de:bgb:vw:ar05:K"), @2026-02-01) { origin case_input; }
        assert "f3": antrag_ohne_dessen_erklaerung(entity_ref("urn:de:bgb:vw:ar05:E"), entity_ref("urn:de:bgb:vw:ar05:A"), entity_ref("urn:de:bgb:vw:ar05:K")) { origin case_input; }
        assert "f4": aufhebungsantrag_notariell_beurkundet(entity_ref("urn:de:bgb:vw:ar05:A"), entity_ref("urn:de:bgb:vw:ar05:K")) { origin case_input; }
        assert "f5": aufhebungsantrag_gestellt_am(entity_ref("urn:de:bgb:vw:ar05:A"), entity_ref("urn:de:bgb:vw:ar05:K"), @2026-12-01) { origin case_input; }
    }
    evaluate truth(drei_jahre_seit_der_annahme(entity_ref("urn:de:bgb:vw:ar05:K"), @2027-01-10));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(letzter_tag_der_aufhebungsfrist(entity_ref("urn:de:bgb:vw:ar05:A"), entity_ref("urn:de:bgb:vw:ar05:K"), @2027-02-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aufhebungsantrag_zulaessig(entity_ref("urn:de:bgb:vw:ar05:E"), entity_ref("urn:de:bgb:vw:ar05:A"), entity_ref("urn:de:bgb:vw:ar05:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
