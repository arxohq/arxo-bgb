language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// Kanarienvogel zu sr02: dieselbe Geburt, aber die Beschneidung am 16.07.2026 — einen Tag nach dem Ende der sechs Monate. Die Erlaubnis des § 1631d Abs. 2 greift nicht mehr; das Einwilligungsrecht des Absatzes 1 bleibt unberührt.
test "§ 1631d Abs. 2: einen Tag nach den sechs Monaten greift die Erlaubnis nicht" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geburt_des_kindes_am(entity_ref("urn:de:bgb:vw:sr03:K"), @2026-01-15) { origin case_input; }
        assert "f2": personensorge(entity_ref("urn:de:bgb:vw:sr03:K")) { origin case_input; }
        assert "f3": beschneidung_medizinisch_nicht_erforderlich(entity_ref("urn:de:bgb:vw:sr03:K")) { origin case_input; }
        assert "f4": beschneidung_durch_religionsgesellschaft(entity_ref("urn:de:bgb:vw:sr03:K"), @2026-07-16) { origin case_input; }
    }
    evaluate truth(beschneidung_durch_nichtarzt_zulaessig(entity_ref("urn:de:bgb:vw:sr03:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(einwilligung_in_die_beschneidung_umfasst(entity_ref("urn:de:bgb:vw:sr03:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
