language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1631d Abs. 2: in den ersten SECHS MONATEN nach der Geburt dürfen auch von einer Religionsgesellschaft vorgesehene Personen die Beschneidung durchführen. Geburt am 15.01.2026; die sechs Monate enden am 15.07.2026, die Beschneidung an diesem Tag liegt noch innerhalb. Abs. 1 Satz 2 (Gefährdung des Kindeswohls) ist nicht beantwortet.
test "§ 1631d Abs. 2: am letzten Tag der sechs Monate ist die Beschneidung durch den Nichtarzt zulässig" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geburt_des_kindes_am(entity_ref("urn:de:bgb:vw:sr02:K"), @2026-01-15) { origin case_input; }
        assert "f2": personensorge(entity_ref("urn:de:bgb:vw:sr02:K")) { origin case_input; }
        assert "f3": beschneidung_medizinisch_nicht_erforderlich(entity_ref("urn:de:bgb:vw:sr02:K")) { origin case_input; }
        assert "f4": beschneidung_durch_religionsgesellschaft(entity_ref("urn:de:bgb:vw:sr02:K"), @2026-07-15) { origin case_input; }
    }
    evaluate truth(ende_der_sechs_monate_nach_der_geburt(entity_ref("urn:de:bgb:vw:sr02:K"), @2026-07-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(beschneidung_durch_nichtarzt_zulaessig(entity_ref("urn:de:bgb:vw:sr02:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
