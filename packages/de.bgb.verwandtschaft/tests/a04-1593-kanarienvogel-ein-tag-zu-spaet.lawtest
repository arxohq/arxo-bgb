language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1593 Satz 1, andere Seite der Schwelle: dieselbe Auflösung am 10.01.2025, Geburt am 07.11.2025 — einen Tag nach dem 300. Tag (06.11.2025). Die Vaterschaft des früheren Ehemanns entsteht nicht.
test "§ 1593: Geburt einen Tag nach dem 300. Tag — keine Vaterschaft" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ehe_durch_tod_aufgeloest_am(entity_ref("urn:de:bgb:vw:a04:K"), entity_ref("urn:de:bgb:vw:a04:V"), @2025-01-10) { origin case_input; }
        assert "f2": geburtstag_des_kindes(entity_ref("urn:de:bgb:vw:a04:K"), @2025-11-07) { origin case_input; }
    }
    evaluate truth(innerhalb_von_300_tagen_geboren(entity_ref("urn:de:bgb:vw:a04:K"), entity_ref("urn:de:bgb:vw:a04:V")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(vaterschaft_nach_1593(entity_ref("urn:de:bgb:vw:a04:K"), entity_ref("urn:de:bgb:vw:a04:V")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
