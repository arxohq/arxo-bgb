language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// Kanarienvogel zu ar03: derselbe Sachverhalt, aber der Entscheidungstag ist der 10.06.2025 — der Tag, mit dem die fünf Monate nach der Geburt ablaufen. Die Fristen des § 1748 Abs. 2 sind noch nicht abgelaufen; die Einwilligung darf nicht ersetzt werden.
test "§ 1748 Abs. 2 Satz 3: am Tag des Ablaufs der fünf Monate ist die Ersetzung noch nicht möglich" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geburt_des_kindes_am(entity_ref("urn:de:bgb:vw:ar04:K"), @2025-01-10) { origin case_input; }
        assert "f2": belehrung_durch_das_jugendamt_am(entity_ref("urn:de:bgb:vw:ar04:K"), entity_ref("urn:de:bgb:vw:ar04:E"), @2025-02-01) { origin case_input; }
        assert "f3": ersetzung_beantragt(entity_ref("urn:de:bgb:vw:ar04:K"), entity_ref("urn:de:bgb:vw:ar04:E")) { origin case_input; }
        assert "f4": gleichgueltigkeit_gegenueber_dem_kind(entity_ref("urn:de:bgb:vw:ar04:K"), entity_ref("urn:de:bgb:vw:ar04:E")) { origin case_input; }
        assert "f5": unterbleiben_gereicht_zu_unverhaeltnismaessigem_nachteil(entity_ref("urn:de:bgb:vw:ar04:K")) { origin adjudicated; }
        assert "f6": entscheidungstag_ueber_die_ersetzung(entity_ref("urn:de:bgb:vw:ar04:K"), @2025-06-10) { origin case_input; }
    }
    evaluate truth(einwilligung_zu_ersetzen(entity_ref("urn:de:bgb:vw:ar04:K"), entity_ref("urn:de:bgb:vw:ar04:E")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
