language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";
// § 1666 Abs. 2, Gegenprobe zu s05: das Gericht hat die Ausnahme VERNEINT (negative Antwort, `origin adjudicated`).
// Damit ist die Frage beantwortet und die Vermutung der Vermögensgefährdung hält.
test "§ 1666 Abs. 2: nach verneinter Ausnahme hält die Vermutung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_VERWANDTSCHAFT_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": pflichtverletzung_des_inhabers_der_vermoegenssorge(entity_ref("urn:de:bgb:vw:s05b:K")) { origin case_input; }
        assert "f2": not vermoegensgefaehrdung_ausnahmsweise_zu_verneinen(entity_ref("urn:de:bgb:vw:s05b:K")) { origin adjudicated; }
    }
    evaluate truth(vermoegen_des_kindes_gefaehrdet(entity_ref("urn:de:bgb:vw:s05b:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
