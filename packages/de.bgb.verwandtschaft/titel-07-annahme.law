// --- Titel 7: Annahme als Kind (§§ 1741–1772) ----------------------------------------------------
//
// ZWEI ANNAHMEN, ZWEI WIRKUNGEN. Die Annahme eines Minderjährigen gibt dem
// Kind die Stellung eines Kindes des Annehmenden (§ 1754) und lässt die
// bisherige Verwandtschaft ERLÖSCHEN (§ 1755) — im Graphen des Titels 1 die
// Politik `ReplacesBlood`. Die Annahme eines Volljährigen erstreckt sich NICHT
// auf die Verwandten des Annehmenden und lässt die bisherige Verwandtschaft
// unberührt (§ 1770 Abs. 1, 2) — `AddsBranch`. Beide Brücken stehen in
// `package.law` und sind `pub`.
//
// DER BESCHLUSS IST EINE TATSACHE, KEINE RECHNUNG. Die Annahme wird vom
// Familiengericht AUSGESPROCHEN (§ 1752 Abs. 1, § 1768 Abs. 1): der Fall trägt
// sie mit `origin adjudicated`. Das Paket rechnet, was der Text an MESSBAREN
// Voraussetzungen nennt — Mindestalter (§ 1743: 25 bzw. 21 Jahre),
// Einwilligungsalter des Kindes (§ 1746 Abs. 2: 14 Jahre), Alter des Kindes
// bei der elterlichen Einwilligung (§ 1747 Abs. 2: acht Wochen) — und stellt
// die Wertungen in den Urteilskanal: Kindeswohl (§ 1741 Abs. 1), angemessene
// Pflegezeit (§ 1744), entgegenstehende Interessen (§ 1745, § 1769),
// Ersetzungsgründe (§ 1748), sittliche Rechtfertigung (§ 1767 Abs. 1),
// wichtiger Grund (§ 1771).

// --- Eingänge des Falls ---------------------------------------------------------------------------

pub relation annahmeantrag(annehmender: Person, anzunehmender: Person) kind empirical {
    label de official "Antrag des Annehmenden auf Ausspruch der Annahme (§ 1752 Abs. 1, § 1768 Abs. 1)";
    label en unofficial "application of the adopter for the adoption to be pronounced (§ 1752 (1), § 1768 (1))";
}
pub relation annahme_ausgesprochen(annehmender: Person, anzunehmender: Person) kind empirical {
    label de official "Die Annahme als Kind ist vom Familiengericht ausgesprochen (§ 1752 Abs. 1) — Tatsache des Falls mit `origin adjudicated`";
    label en unofficial "the adoption has been pronounced by the family court (§ 1752 (1)) — a fact of the case with `origin adjudicated`";
}
pub relation annehmender_verheiratet_mit(annehmender: Person, ehegatte: Person) kind empirical {
    label de official "Der Annehmende ist mit dieser Person verheiratet (§ 1741 Abs. 2)";
    label en unofficial "the adopter is married to this person (§ 1741 (2))";
}
pub relation gemeinschaftliche_annahme_durch_ehepaar(erster: Person, zweiter: Person, kind: Person) kind empirical {
    label de official "Ein Ehepaar nimmt ein Kind gemeinschaftlich an (§ 1741 Abs. 2 Satz 2, § 1754 Abs. 1)";
    label en unofficial "a married couple adopts a child jointly (§ 1741 (2) sentence 2, § 1754 (1))";
}
pub relation stiefkindannahme(annehmender: Person, ehegatte: Person, kind: Person) kind empirical {
    label de official "Ein Ehegatte nimmt ein Kind seines Ehegatten allein an (§ 1741 Abs. 2 Satz 3, § 1754 Abs. 1, § 1755 Abs. 2)";
    label en unofficial "a spouse adopts a child of the other spouse alone (§ 1741 (2) sentence 3, § 1754 (1), § 1755 (2))";
}
pub relation anzunehmender_volljaehrig(anzunehmender: Person) kind empirical {
    label de official "Der Anzunehmende ist volljährig (§ 1767 Abs. 1)";
    label en unofficial "the person to be adopted is of full age (§ 1767 (1))";
}
pub relation einwilligung_des_kindes_erteilt(kind: Person, annehmender: Person) kind empirical {
    label de official "Die Einwilligung des Kindes in die Annahme ist erteilt (§ 1746 Abs. 1 Satz 1)";
    label en unofficial "the child's consent to the adoption has been given (§ 1746 (1) sentence 1)";
}
pub relation einwilligung_durch_gesetzlichen_vertreter(kind: Person, annehmender: Person) kind empirical {
    label de official "Die Einwilligung ist durch den gesetzlichen Vertreter des Kindes erteilt (§ 1746 Abs. 1 Satz 2)";
    label en unofficial "the consent was given by the child's legal representative (§ 1746 (1) sentence 2)";
}
pub relation kind_geschaeftsunfaehig(kind: Person) kind empirical {
    label de official "Das Kind ist geschäftsunfähig (§ 1746 Abs. 1 Satz 2, Abs. 2)";
    label en unofficial "the child lacks capacity to contract (§ 1746 (1) sentence 2, (2))";
}
pub relation einwilligung_eines_elternteils_erteilt_am(kind: Person, elternteil: Person, tag: Date) kind empirical {
    label de official "Tag, an dem ein Elternteil die Einwilligung in die Annahme erteilt hat (§ 1747 Abs. 1, Abs. 2 Satz 1)";
    label en unofficial "day on which a parent gave consent to the adoption (§ 1747 (1), (2) sentence 1)";
}
pub relation elternteil_dauernd_ausserstande_oder_unbekannt(kind: Person, elternteil: Person) kind empirical {
    label de official "Der Elternteil ist zur Abgabe einer Erklärung dauernd außerstande oder sein Aufenthalt ist dauernd unbekannt; seine Einwilligung ist nicht erforderlich (§ 1747 Abs. 4 Satz 1)";
    label en unofficial "the parent is permanently unable to make a declaration or his whereabouts are permanently unknown; his consent is not required (§ 1747 (4) sentence 1)";
}
pub relation einwilligung_des_elternteils_ersetzt(kind: Person, elternteil: Person) kind empirical {
    label de official "Das Familiengericht hat die Einwilligung des Elternteils ersetzt (§ 1748) — Tatsache des Falls mit `origin adjudicated`";
    label en unofficial "the family court has substituted the parent's consent (§ 1748) — a fact of the case with `origin adjudicated`";
}
pub relation einwilligung_des_anderen_ehegatten(annehmender: Person, ehegatte: Person) kind empirical {
    label de official "Der andere Ehegatte hat in die Annahme durch einen Ehegatten allein eingewilligt (§ 1749 Abs. 1 Satz 1)";
    label en unofficial "the other spouse has consented to the adoption by one spouse alone (§ 1749 (1) sentence 1)";
}
pub relation kind_in_pflege_gehabt(annehmender: Person, kind: Person) kind empirical {
    label de official "Der Annehmende hat das Kind in Pflege gehabt (§ 1744)";
    label en unofficial "the adopter has had the child in care (§ 1744)";
}
pub relation annahmetag(annehmender: Person, anzunehmender: Person, tag: Date) kind empirical {
    label de official "Tag, auf den die Voraussetzungen der Annahme geprüft werden (Eingang des Falls, keine Norm)";
    label en unofficial "day on which the requirements of the adoption are assessed (input of the case, not a norm)";
}
pub relation annehmende_mit_dem_kind_im_zweiten_oder_dritten_grad(annehmender: Person, kind: Person) kind institutional {
    label de official "Die Annehmenden sind mit dem Kind im zweiten oder dritten Grad verwandt oder verschwägert (§ 1756 Abs. 1)";
    label en unofficial "the adopters are related or related by marriage to the child in the second or third degree (§ 1756 (1))";
}

// --- Urteilskanal des Titels ----------------------------------------------------------------------

@source(BGB_P1741)
pub external judgment relation annahme_dient_dem_kindeswohl(annehmender: Person, kind: Person) {
    authority Court;
    label de official "§ 1741 Abs. 1 Satz 1. Die Annahme als Kind dient dem Wohl des Kindes und es ist zu erwarten, dass zwischen dem Annehmenden und dem Kind ein Eltern-Kind-Verhältnis entsteht";
    label en unofficial "§ 1741 (1) sentence 1. The adoption serves the child's welfare and it is to be expected that a parent–child relationship will arise between the adopter and the child";
}
@source(BGB_P1744)
pub external judgment relation angemessene_pflegezeit(annehmender: Person, kind: Person) {
    authority Court;
    label de official "§ 1744. Der Annehmende hat das Kind eine angemessene Zeit in Pflege gehabt";
    label en unofficial "§ 1744. The adopter has had the child in care for an appropriate period";
}
@source(BGB_P1745)
pub external judgment relation ueberwiegende_interessen_stehen_entgegen(annehmender: Person, kind: Person) {
    authority Court;
    label de official "§ 1745 Satz 1. Der Annahme stehen überwiegende Interessen der Kinder des Annehmenden oder des Anzunehmenden entgegen oder es ist zu befürchten, dass Interessen des Anzunehmenden durch Kinder des Annehmenden gefährdet werden; vermögensrechtliche Interessen sollen nicht ausschlaggebend sein (Satz 2)";
    label en unofficial "§ 1745 sentence 1. Overriding interests of the children of the adopter or of the person to be adopted conflict with the adoption, or it is to be feared that interests of the person to be adopted will be endangered by children of the adopter; financial interests should not be decisive (sentence 2)";
}
@source(BGB_P1767)
pub external judgment relation annahme_sittlich_gerechtfertigt(annehmender: Person, anzunehmender: Person) {
    authority Court;
    label de official "§ 1767 Abs. 1. Die Annahme eines Volljährigen ist sittlich gerechtfertigt; dies ist insbesondere anzunehmen, wenn zwischen dem Annehmenden und dem Anzunehmenden ein Eltern-Kind-Verhältnis bereits entstanden ist";
    label en unofficial "§ 1767 (1). The adoption of a person of full age is morally justified; this is to be assumed in particular where a parent–child relationship has already arisen between them";
}
@source(BGB_P1769)
pub external judgment relation ueberwiegende_interessen_gegen_volljaehrigenannahme(annehmender: Person, anzunehmender: Person) {
    authority Court;
    label de official "§ 1769. Der Annahme eines Volljährigen stehen überwiegende Interessen der Kinder des Annehmenden oder des Anzunehmenden entgegen";
    label en unofficial "§ 1769. Overriding interests of the children of the adopter or of the person to be adopted conflict with the adoption of a person of full age";
}
@source(BGB_P1771)
pub external judgment relation wichtiger_grund_fuer_aufhebung(annehmender: Person, angenommener: Person) {
    authority Court;
    label de official "§ 1771 Satz 1. Für die Aufhebung des zu einem Volljährigen begründeten Annahmeverhältnisses liegt ein wichtiger Grund vor";
    label en unofficial "§ 1771 sentence 1. An important reason exists for cancelling the adoptive relationship established with a person of full age";
}

// --- § 1743 Mindestalter --------------------------------------------------------------------------
//
// Zwei Schwellen, beide aus dem Text: 25 Jahre im Grundfall, 21 Jahre in den
// Fällen des § 1741 Abs. 2 Satz 3 (Stiefkindannahme) und für den zweiten
// Ehegatten des § 1741 Abs. 2 Satz 2. Gerechnet über
// `de.bgb.fristen::lebensjahr_vollendet_am`: das Lebensjahr ist mit ABLAUF des
// Vollendungstages vollendet, am Tag selbst also noch nicht (Ledger D-09-06).

pub relation mindestalter_erfuellt(annehmender: Person, anzunehmender: Person) kind institutional {
    label de official "Der Annehmende hat das nach § 1743 erforderliche Lebensjahr vollendet";
    label en unofficial "the adopter has completed the year of life required by § 1743";
}
pub relation mindestalter_nicht_erfuellt(annehmender: Person, anzunehmender: Person) kind institutional {
    label de official "Der Annehmende hat das nach § 1743 erforderliche Lebensjahr noch nicht vollendet";
    label en unofficial "the adopter has not yet completed the year of life required by § 1743";
}

@source(BGB_P1743) {
    rule Mindestalter25Erfuellt(a: Person, k: Person, v: Date, t: Date) strict {
        label de official "Der Annehmende muss das 25. Lebensjahr vollendet haben (§ 1743 Satz 1); vollendet ist es mit dem Ablauf des Vollendungstages (§ 187 Abs. 2, § 188 Abs. 2)";
        label en unofficial "The adopter must have completed the 25th year of life (§ 1743 sentence 1); it is completed at the end of the day of completion (§ 187 (2), § 188 (2))";
        when annahmeantrag(a, k) and not_known(stiefkindannahme_des_annehmenden(a, k))
         and de.bgb.fristen::lebensjahr_vollendet_am(a, 25 calendar_year, v) and annahmetag(a, k, t) and t > v;
        then mindestalter_erfuellt(a, k);
    }
    rule Mindestalter25NichtErfuellt(a: Person, k: Person, v: Date, t: Date) strict {
        label de official "Am Tag der Vollendung selbst ist das 25. Lebensjahr noch nicht vollendet (§ 1743 Satz 1 mit § 188 Abs. 2)";
        label en unofficial "On the day of completion itself the 25th year of life is not yet completed (§ 1743 sentence 1 with § 188 (2))";
        when annahmeantrag(a, k) and not_known(stiefkindannahme_des_annehmenden(a, k))
         and de.bgb.fristen::lebensjahr_vollendet_am(a, 25 calendar_year, v) and annahmetag(a, k, t) and t <= v;
        then mindestalter_nicht_erfuellt(a, k);
    }
    rule Mindestalter21Stiefkind(a: Person, k: Person, v: Date, t: Date) strict {
        label de official "In den Fällen des § 1741 Abs. 2 Satz 3 genügt die Vollendung des 21. Lebensjahrs (§ 1743 Satz 1)";
        label en unofficial "In the cases of § 1741 (2) sentence 3 completion of the 21st year of life suffices (§ 1743 sentence 1)";
        when stiefkindannahme_des_annehmenden(a, k)
         and de.bgb.fristen::lebensjahr_vollendet_am(a, 21 calendar_year, v) and annahmetag(a, k, t) and t > v;
        then mindestalter_erfuellt(a, k);
    }
    rule Mindestalter21StiefkindNichtErfuellt(a: Person, k: Person, v: Date, t: Date) strict {
        label de official "Am Tag der Vollendung selbst ist das 21. Lebensjahr noch nicht vollendet (§ 1743 Satz 1 mit § 188 Abs. 2)";
        label en unofficial "On the day of completion itself the 21st year of life is not yet completed (§ 1743 sentence 1 with § 188 (2))";
        when stiefkindannahme_des_annehmenden(a, k)
         and de.bgb.fristen::lebensjahr_vollendet_am(a, 21 calendar_year, v) and annahmetag(a, k, t) and t <= v;
        then mindestalter_nicht_erfuellt(a, k);
    }
}

pub relation stiefkindannahme_des_annehmenden(annehmender: Person, kind: Person) kind institutional {
    label de official "Der Annehmende nimmt ein Kind seines Ehegatten allein an (§ 1741 Abs. 2 Satz 3): zweistelliger Kopf für die Schwelle des § 1743";
    label en unofficial "the adopter adopts a child of his spouse alone (§ 1741 (2) sentence 3): two-place head for the threshold of § 1743";
}

@source(BGB_P1741)
rule StiefkindannahmeDesAnnehmenden(a: Person, e: Person, k: Person) strict {
    label de official "Ein Ehegatte kann ein Kind seines Ehegatten allein annehmen (§ 1741 Abs. 2 Satz 3)";
    label en unofficial "A spouse may adopt a child of his spouse alone (§ 1741 (2) sentence 3)";
    when stiefkindannahme(a, e, k);
    then stiefkindannahme_des_annehmenden(a, k);
}

// --- § 1746 Einwilligung des Kindes ---------------------------------------------------------------
//
// Abs. 1 Satz 2, 3 und Abs. 2 hängen an derselben Schwelle: 14 Jahre. Unter
// 14 (oder geschäftsunfähig) erklärt NUR der gesetzliche Vertreter; ab 14 und
// nicht geschäftsunfähig erklärt NUR das Kind selbst und kann bis zum
// Wirksamwerden widerrufen. Beide Seiten der Schwelle werden gerechnet.

pub relation einwilligung_des_kindes_wirksam(kind: Person, annehmender: Person) kind institutional {
    label de official "Die Einwilligung des Kindes ist von der richtigen Person erklärt (§ 1746 Abs. 1)";
    label en unofficial "the child's consent was declared by the right person (§ 1746 (1))";
}
pub relation kind_erklaert_selbst(kind: Person) kind institutional {
    label de official "Das Kind hat das 14. Lebensjahr vollendet und ist nicht geschäftsunfähig: es erklärt die Einwilligung selbst (§ 1746 Abs. 1 Satz 3, Abs. 2)";
    label en unofficial "the child has completed its 14th year of life and is not incapable: it declares the consent itself (§ 1746 (1) sentence 3, (2))";
}
pub relation nur_gesetzlicher_vertreter_erklaert(kind: Person) kind institutional {
    label de official "Für ein Kind, das geschäftsunfähig oder noch nicht 14 Jahre alt ist, kann nur sein gesetzlicher Vertreter die Einwilligung erteilen (§ 1746 Abs. 1 Satz 2)";
    label en unofficial "for a child that is incapable or not yet 14 years old only its legal representative may give the consent (§ 1746 (1) sentence 2)";
}
pub relation widerruf_der_einwilligung_moeglich(kind: Person) kind institutional {
    label de official "Hat das Kind das 14. Lebensjahr vollendet und ist es nicht geschäftsunfähig, so kann es die Einwilligung bis zum Wirksamwerden des Ausspruchs der Annahme gegenüber dem Familiengericht widerrufen (§ 1746 Abs. 2 Satz 1)";
    label en unofficial "If the child has completed its 14th year of life and is not incapable, it may revoke the consent until the adoption takes effect (§ 1746 (2) sentence 1)";
}

@source(BGB_P1746) {
    rule KindAbVierzehnErklaertSelbst(k: Person, a: Person, v: Date, t: Date) strict {
        label de official "Im Übrigen kann das Kind die Einwilligung nur selbst erteilen (§ 1746 Abs. 1 Satz 3); Voraussetzung ist die Vollendung des 14. Lebensjahrs und fehlende Geschäftsunfähigkeit (Abs. 1 Satz 2)";
        label en unofficial "Otherwise the child may give the consent only itself (§ 1746 (1) sentence 3); this requires completion of the 14th year of life and no incapacity (subsection (1) sentence 2)";
        when annahmeantrag(a, k) and de.bgb.fristen::lebensjahr_vollendet_am(k, 14 calendar_year, v)
         and annahmetag(a, k, t) and t > v and not_known(kind_geschaeftsunfaehig(k));
        then kind_erklaert_selbst(k);
    }
    rule KindUnterVierzehn(k: Person, a: Person, v: Date, t: Date) strict {
        label de official "Für ein Kind, das noch nicht 14 Jahre alt ist, kann nur sein gesetzlicher Vertreter die Einwilligung erteilen (§ 1746 Abs. 1 Satz 2)";
        label en unofficial "For a child not yet 14 years old only its legal representative may give the consent (§ 1746 (1) sentence 2)";
        when annahmeantrag(a, k) and de.bgb.fristen::lebensjahr_vollendet_am(k, 14 calendar_year, v)
         and annahmetag(a, k, t) and t <= v;
        then nur_gesetzlicher_vertreter_erklaert(k);
    }
    rule KindGeschaeftsunfaehig(k: Person, a: Person) strict {
        label de official "Für ein Kind, das geschäftsunfähig ist, kann nur sein gesetzlicher Vertreter die Einwilligung erteilen (§ 1746 Abs. 1 Satz 2)";
        label en unofficial "For a child that is incapable only its legal representative may give the consent (§ 1746 (1) sentence 2)";
        when annahmeantrag(a, k) and kind_geschaeftsunfaehig(k);
        then nur_gesetzlicher_vertreter_erklaert(k);
    }
    rule EinwilligungDurchDasKindWirksam(k: Person, a: Person) strict {
        label de official "Das Kind, das selbst erklären kann, erteilt die Einwilligung wirksam (§ 1746 Abs. 1 Satz 3)";
        label en unofficial "The child able to declare itself gives the consent effectively (§ 1746 (1) sentence 3)";
        when kind_erklaert_selbst(k) and einwilligung_des_kindes_erteilt(k, a);
        then einwilligung_des_kindes_wirksam(k, a);
    }
    rule EinwilligungDurchVertreterWirksam(k: Person, a: Person) strict {
        label de official "Für das Kind unter 14 Jahren oder das geschäftsunfähige Kind erteilt der gesetzliche Vertreter die Einwilligung (§ 1746 Abs. 1 Satz 2)";
        label en unofficial "For a child under 14 or an incapable child the legal representative gives the consent (§ 1746 (1) sentence 2)";
        when nur_gesetzlicher_vertreter_erklaert(k) and einwilligung_durch_gesetzlichen_vertreter(k, a);
        then einwilligung_des_kindes_wirksam(k, a);
    }
    rule WiderrufMoeglich(k: Person) strict {
        label de official "Hat das Kind das 14. Lebensjahr vollendet und ist es nicht geschäftsunfähig, so kann es die Einwilligung widerrufen (§ 1746 Abs. 2 Satz 1)";
        label en unofficial "If the child has completed its 14th year and is not incapable, it may revoke the consent (§ 1746 (2) sentence 1)";
        when kind_erklaert_selbst(k);
        then widerruf_der_einwilligung_moeglich(k);
    }
}

// --- § 1747 Einwilligung der Eltern ----------------------------------------------------------------
//
// Abs. 2 Satz 1: „Die Einwilligung kann erst erteilt werden, wenn das Kind acht
// Wochen alt ist.“ Das ist eine Frist vom Tag der Geburt an; eine vorher
// erteilte Einwilligung ist keine. Beide Seiten der Schwelle werden gerechnet.

pub relation fruehestens_einwilligungsfaehig_ab(kind: Person, tag: Date) kind institutional {
    label de official "Tag, ab dem die Einwilligung der Eltern erteilt werden kann: das Kind ist acht Wochen alt (§ 1747 Abs. 2 Satz 1)";
    label en unofficial "day from which the parents' consent may be given: the child is eight weeks old (§ 1747 (2) sentence 1)";
}
pub relation elterliche_einwilligung_wirksam(kind: Person, elternteil: Person) kind institutional {
    label de official "Die Einwilligung des Elternteils in die Annahme ist wirksam erteilt (§ 1747 Abs. 1, Abs. 2 Satz 1)";
    label en unofficial "the parent's consent to the adoption was effectively given (§ 1747 (1), (2) sentence 1)";
}
pub relation elterliche_einwilligung_zu_frueh(kind: Person, elternteil: Person) kind institutional {
    label de official "Die Einwilligung wurde erteilt, bevor das Kind acht Wochen alt war (§ 1747 Abs. 2 Satz 1)";
    label en unofficial "the consent was given before the child was eight weeks old (§ 1747 (2) sentence 1)";
}
pub relation einwilligung_der_eltern_nicht_erforderlich(kind: Person, elternteil: Person) kind institutional {
    label de official "Die Einwilligung eines Elternteils ist nicht erforderlich (§ 1747 Abs. 4 Satz 1) oder ist vom Familiengericht ersetzt (§ 1748)";
    label en unofficial "the consent of a parent is not required (§ 1747 (4) sentence 1) or has been substituted by the family court (§ 1748)";
}

@source(BGB_P1747) {
    rule AchtWochenAlt(k: Person, g: Date) strict {
        label de official "Die Einwilligung kann erst erteilt werden, wenn das Kind acht Wochen alt ist (§ 1747 Abs. 2 Satz 1)";
        label en unofficial "The consent may be given only when the child is eight weeks old (§ 1747 (2) sentence 1)";
        when geburtstag_des_kindes(k, g);
        then fruehestens_einwilligungsfaehig_ab(k, add_calendar_period(g, 8 calendar_week));
    }
    rule ElterlicheEinwilligungWirksam(k: Person, e: Person, t: Date, ab: Date) strict {
        label de official "Die ab dem Tag, an dem das Kind acht Wochen alt ist, erteilte Einwilligung der Eltern ist wirksam (§ 1747 Abs. 1, Abs. 2 Satz 1)";
        label en unofficial "The parents' consent given from the day the child is eight weeks old is effective (§ 1747 (1), (2) sentence 1)";
        when einwilligung_eines_elternteils_erteilt_am(k, e, t) and fruehestens_einwilligungsfaehig_ab(k, ab) and t >= ab;
        then elterliche_einwilligung_wirksam(k, e);
    }
    rule ElterlicheEinwilligungZuFrueh(k: Person, e: Person, t: Date, ab: Date) strict {
        label de official "Eine vor Ablauf der acht Wochen erteilte Einwilligung kann nicht erteilt werden (§ 1747 Abs. 2 Satz 1)";
        label en unofficial "A consent given before the eight weeks have passed cannot be given (§ 1747 (2) sentence 1)";
        when einwilligung_eines_elternteils_erteilt_am(k, e, t) and fruehestens_einwilligungsfaehig_ab(k, ab) and t < ab;
        then elterliche_einwilligung_zu_frueh(k, e);
    }
    rule EinwilligungNichtErforderlich(k: Person, e: Person) strict {
        label de official "Die Einwilligung eines Elternteils ist nicht erforderlich, wenn er zur Abgabe einer Erklärung dauernd außerstande oder sein Aufenthalt dauernd unbekannt ist (§ 1747 Abs. 4 Satz 1)";
        label en unofficial "The consent of a parent is not required where he is permanently unable to declare or his whereabouts are permanently unknown (§ 1747 (4) sentence 1)";
        when elternteil_dauernd_ausserstande_oder_unbekannt(k, e);
        then einwilligung_der_eltern_nicht_erforderlich(k, e);
    }
    rule EinwilligungErsetzt(k: Person, e: Person) strict {
        label de official "Das Familiengericht hat die Einwilligung des Elternteils ersetzt (§ 1748)";
        label en unofficial "The family court has substituted the parent's consent (§ 1748)";
        when einwilligung_des_elternteils_ersetzt(k, e);
        then einwilligung_der_eltern_nicht_erforderlich(k, e);
    }
}

// --- §§ 1754–1756 Wirkung der Annahme -------------------------------------------------------------

pub relation stellung_eines_kindes(kind: Person, annehmender: Person) kind institutional {
    label de official "Das Kind erlangt die rechtliche Stellung eines Kindes des Annehmenden (§ 1754 Abs. 2)";
    label en unofficial "the child acquires the legal status of a child of the adopter (§ 1754 (2))";
}
pub relation stellung_eines_gemeinschaftlichen_kindes(kind: Person, erster: Person, zweiter: Person) kind institutional {
    label de official "Nimmt ein Ehepaar ein Kind an oder nimmt ein Ehegatte ein Kind des anderen Ehegatten an, so erlangt das Kind die rechtliche Stellung eines gemeinschaftlichen Kindes der Ehegatten (§ 1754 Abs. 1)";
    label en unofficial "If a married couple adopts a child, or a spouse adopts a child of the other spouse, the child acquires the legal status of a joint child of the spouses (§ 1754 (1))";
}
pub relation verwandtschaft_erloschen(kind: Person, bisheriger_verwandter: Person) kind institutional {
    label de official "Mit der Annahme erlöschen das Verwandtschaftsverhältnis des Kindes zu den bisherigen Verwandten und die sich aus ihm ergebenden Rechte und Pflichten (§ 1755 Abs. 1 Satz 1)";
    label en unofficial "With the adoption the child's kinship to its former relatives and the rights and duties arising from it expire (§ 1755 (1) sentence 1)";
}
pub relation verwandtschaft_bleibt_bestehen(kind: Person, verwandter: Person) kind institutional {
    label de official "Das Verwandtschaftsverhältnis bleibt bestehen (§ 1756, § 1770 Abs. 2)";
    label en unofficial "the kinship continues (§ 1756, § 1770 (2))";
}
pub relation anspruch_bis_zur_annahme_entstanden_bleibt(kind: Person) kind institutional {
    label de official "Ansprüche des Kindes, die bis zur Annahme entstanden sind, insbesondere auf Renten, Waisengeld und andere entsprechende wiederkehrende Leistungen, werden durch die Annahme nicht berührt; dies gilt nicht für Unterhaltsansprüche (§ 1755 Abs. 1 Satz 2)";
    label en unofficial "Claims of the child arisen up to the adoption, in particular to pensions, orphan's benefits and similar recurring payments, are not affected by the adoption; this does not apply to maintenance claims (§ 1755 (1) sentence 2)";
}

@source(BGB_P1754) {
    rule StellungEinesKindes(a: Person, k: Person) strict {
        label de official "In den anderen Fällen erlangt das Kind die rechtliche Stellung eines Kindes des Annehmenden (§ 1754 Abs. 2)";
        label en unofficial "In the other cases the child acquires the legal status of a child of the adopter (§ 1754 (2))";
        when annahme_ausgesprochen(a, k);
        then stellung_eines_kindes(k, a);
    }
    rule StellungEinesGemeinschaftlichenKindesEhepaar(e1: Person, e2: Person, k: Person) strict {
        label de official "Nimmt ein Ehepaar ein Kind an, so erlangt das Kind die rechtliche Stellung eines gemeinschaftlichen Kindes der Ehegatten (§ 1754 Abs. 1)";
        label en unofficial "If a married couple adopts a child, it acquires the legal status of a joint child of the spouses (§ 1754 (1))";
        when gemeinschaftliche_annahme_durch_ehepaar(e1, e2, k) and annahme_ausgesprochen(e1, k);
        then stellung_eines_gemeinschaftlichen_kindes(k, e1, e2);
    }
    rule StellungEinesGemeinschaftlichenKindesStiefkind(a: Person, e: Person, k: Person) strict {
        label de official "Nimmt ein Ehegatte ein Kind des anderen Ehegatten an, so erlangt das Kind die rechtliche Stellung eines gemeinschaftlichen Kindes der Ehegatten (§ 1754 Abs. 1)";
        label en unofficial "If a spouse adopts a child of the other spouse, it acquires the legal status of a joint child of the spouses (§ 1754 (1))";
        when stiefkindannahme(a, e, k) and annahme_ausgesprochen(a, k);
        then stellung_eines_gemeinschaftlichen_kindes(k, a, e);
    }
}

@source(BGB_P1755) {
    rule VerwandtschaftErlischt(f: Familie, a: Person, k: Person, v: Person) strict {
        label de official "Mit der Annahme erlöschen das Verwandtschaftsverhältnis des Kindes zu den bisherigen Verwandten und die sich aus ihm ergebenden Rechte und Pflichten (§ 1755 Abs. 1 Satz 1)";
        label en unofficial "With the adoption the child's kinship to its former relatives and the rights and duties arising from it expire (§ 1755 (1) sentence 1)";
        // Gelesen wird die KANTE der leiblichen Abstammung, nicht das gerechnete
        // Verwandtschaftsverhältnis: unter der Politik `ReplacesBlood` hat der
        // Rechner die Blutlinie bereits ersetzt, und `verwandt` schwiege hier.
        when annahme_ausgesprochen(a, k) and annahme_eines_minderjaehrigen(f, k)
         and not_known(stiefkindannahme_des_annehmenden(a, k))
         and abstammung(f, v, k);
        then verwandtschaft_erloschen(k, v);
    }
    rule AnsprueheBleiben(k: Person, v: Person) strict {
        label de official "Ansprüche des Kindes, die bis zur Annahme entstanden sind, werden durch die Annahme nicht berührt; dies gilt nicht für Unterhaltsansprüche (§ 1755 Abs. 1 Satz 2)";
        label en unofficial "Claims of the child arisen up to the adoption are not affected by it; this does not apply to maintenance claims (§ 1755 (1) sentence 2)";
        when verwandtschaft_erloschen(k, v);
        then anspruch_bis_zur_annahme_entstanden_bleibt(k);
    }
}

@source(BGB_P1756) {
    rule VerwandtschaftBleibtBeiVerwandtenannahme(f: Familie, a: Person, k: Person, v: Person, g: Integer) strict {
        label de official "Sind die Annehmenden mit dem Kind im zweiten oder dritten Grad verwandt oder verschwägert, so erlöschen nur das Verwandtschaftsverhältnis des Kindes zu den ELTERN des Kindes und die sich aus ihm ergebenden Rechte und Pflichten (§ 1756 Abs. 1): zu den übrigen Verwandten bleibt es bestehen";
        label en unofficial "If the adopters are related or related by marriage to the child in the second or third degree, only the kinship to the child's PARENTS expires (§ 1756 (1)): to the other relatives it continues";
        when annahme_ausgesprochen(a, k) and annehmende_mit_dem_kind_im_zweiten_oder_dritten_grad(a, k)
         and verwandt(f, v, k, g) and not_known(elternteil(f, v, k));
        then verwandtschaft_bleibt_bestehen(k, v);
    }
    rule GradZweiOderDrei(f: Familie, a: Person, k: Person, g: Integer) strict {
        label de official "Verwandtschaft oder Schwägerschaft im zweiten oder dritten Grad (§ 1756 Abs. 1): der Grad folgt der Zahl der vermittelnden Geburten (§ 1589 Abs. 1 Satz 3)";
        label en unofficial "Kinship or affinity in the second or third degree (§ 1756 (1)): the degree follows the number of mediating births (§ 1589 (1) sentence 3)";
        when annahmeantrag(a, k) and verwandt(f, a, k, g) and g >= 2 and g <= 3;
        then annehmende_mit_dem_kind_im_zweiten_oder_dritten_grad(a, k);
    }
    rule StiefkindannahmeErlischtNurZumAnderenElternteil(f: Familie, a: Person, e: Person, k: Person, v: Person, g: Integer) strict {
        label de official "Nimmt ein Ehegatte das Kind seines Ehegatten an, so tritt das Erlöschen nur im Verhältnis zu dem ANDEREN Elternteil und dessen Verwandten ein (§ 1755 Abs. 2): zum Ehegatten als Elternteil bleibt die Verwandtschaft bestehen";
        label en unofficial "If a spouse adopts the child of the other spouse, the expiry occurs only in relation to the OTHER parent and his relatives (§ 1755 (2)): to the spouse as parent the kinship continues";
        when stiefkindannahme(a, e, k) and annahme_ausgesprochen(a, k) and elternteil(f, e, k) and verwandt(f, e, k, g);
        then verwandtschaft_bleibt_bestehen(k, e);
    }
}

// --- §§ 1767–1772 Annahme Volljähriger ------------------------------------------------------------

pub relation volljaehrigenannahme_zulaessig(annehmender: Person, anzunehmender: Person) kind institutional {
    label de official "Ein Volljähriger kann als Kind angenommen werden, wenn die Annahme sittlich gerechtfertigt ist (§ 1767 Abs. 1); sie darf nicht ausgesprochen werden, wenn ihr überwiegende Interessen der Kinder entgegenstehen (§ 1769)";
    label en unofficial "A person of full age may be adopted if the adoption is morally justified (§ 1767 (1)); it may not be pronounced where overriding interests of the children conflict with it (§ 1769)";
}
pub relation keine_schwaegerschaft_durch_volljaehrigenannahme(annehmender: Person, anzunehmender: Person) kind institutional {
    label de official "Der Ehegatte des Annehmenden wird nicht mit dem Angenommenen, dessen Ehegatte nicht mit dem Annehmenden verschwägert (§ 1770 Abs. 1 Satz 2)";
    label en unofficial "the adopter's spouse does not become related by marriage to the adoptee, nor the adoptee's spouse to the adopter (§ 1770 (1) sentence 2)";
}
pub relation unterhalt_vor_den_leiblichen_verwandten(annehmender: Person, angenommener: Person) kind institutional {
    label de official "Der Annehmende ist dem Angenommenen und dessen Abkömmlingen vor den leiblichen Verwandten des Angenommenen zur Gewährung des Unterhalts verpflichtet (§ 1770 Abs. 3)";
    label en unofficial "The adopter is liable to maintain the adoptee and his descendants before the adoptee's biological relatives (§ 1770 (3))";
}

@source(BGB_P1767)
rule VolljaehrigenannahmeZulaessig(a: Person, k: Person) strict {
    label de official "Ein Volljähriger kann als Kind angenommen werden, wenn die Annahme sittlich gerechtfertigt ist (§ 1767 Abs. 1); die Annahme darf nicht ausgesprochen werden, wenn ihr überwiegende Interessen der Kinder des Annehmenden oder des Anzunehmenden entgegenstehen (§ 1769)";
    label en unofficial "A person of full age may be adopted if the adoption is morally justified (§ 1767 (1)); it may not be pronounced where overriding interests of the children conflict with it (§ 1769)";
    when annahmeantrag(a, k) and anzunehmender_volljaehrig(k) and annahme_sittlich_gerechtfertigt(a, k)
     and not_known(ueberwiegende_interessen_gegen_volljaehrigenannahme(a, k));
    then volljaehrigenannahme_zulaessig(a, k);
}

@source(BGB_P1770) {
    rule KeineSchwaegerschaft(a: Person, k: Person) strict {
        label de official "Die Wirkungen der Annahme eines Volljährigen erstrecken sich nicht auf die Verwandten des Annehmenden; der Ehegatte des Annehmenden wird nicht mit dem Angenommenen verschwägert (§ 1770 Abs. 1)";
        label en unofficial "The effects of adopting a person of full age do not extend to the adopter's relatives; the adopter's spouse does not become related by marriage to the adoptee (§ 1770 (1))";
        when annahme_ausgesprochen(a, k) and anzunehmender_volljaehrig(k);
        then keine_schwaegerschaft_durch_volljaehrigenannahme(a, k);
    }
    rule VerwandtschaftBleibtBeiVolljaehrigenannahme(f: Familie, a: Person, k: Person, v: Person, g: Integer) strict {
        label de official "Die Rechte und Pflichten aus dem Verwandtschaftsverhältnis des Angenommenen und seiner Abkömmlinge zu ihren Verwandten werden durch die Annahme nicht berührt (§ 1770 Abs. 2)";
        label en unofficial "The rights and duties from the kinship of the adoptee and his descendants to their relatives are not affected by the adoption (§ 1770 (2))";
        when annahme_ausgesprochen(a, k) and annahme_eines_volljaehrigen(f, k) and abstammung(f, v, k) and verwandt(f, v, k, g);
        then verwandtschaft_bleibt_bestehen(k, v);
    }
    rule UnterhaltVorDenLeiblichenVerwandten(a: Person, k: Person) strict {
        label de official "Der Annehmende ist dem Angenommenen und dessen Abkömmlingen vor den leiblichen Verwandten des Angenommenen zur Gewährung des Unterhalts verpflichtet (§ 1770 Abs. 3)";
        label en unofficial "The adopter is liable to maintain the adoptee and his descendants before the adoptee's biological relatives (§ 1770 (3))";
        when annahme_ausgesprochen(a, k) and anzunehmender_volljaehrig(k);
        then unterhalt_vor_den_leiblichen_verwandten(a, k);
    }
}
