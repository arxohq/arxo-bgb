language "law.core" version "0.2";
package de.bgb.verwandtschaft version "0.1.0";
namespace "urn:de:corpus:clir:bgb-verwandtschaft";

pub relation position_trigger_1619(kind: Person, elternteil: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Dienstleistungspflicht des Kindes (§ 1619)"; label en unofficial "case input for the child's service duty (§ 1619)"; }
pub relation dienstleistung_1619_geschuldet(kind: Person, elternteil: Person) kind empirical { label de official "Dienstleistungen im elterlichen Hauswesen und Geschäft sind geschuldet (§ 1619)"; label en unofficial "services in the parents' household and business are owed (§ 1619)"; }
pub relation position_trigger_1684(kind: Person, elternteil: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum Umgang mit dem Elternteil (§ 1684)"; label en unofficial "case input for contact with the parent (§ 1684)"; }
pub relation umgang_1684_geschuldet(kind: Person, elternteil: Person) kind empirical { label de official "Der Elternteil ist zum Umgang mit dem Kind verpflichtet (§ 1684)"; label en unofficial "The parent owes contact with the child (§ 1684)"; }
pub relation position_trigger_1751(kind: Person, annehmender: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur vorrangigen Unterhaltspflicht des Annehmenden (§ 1751)"; label en unofficial "case input for the adopter's priority maintenance duty (§ 1751)"; }
pub relation unterhalt_1751_geschuldet(annehmender: Person, kind: Person) kind empirical { label de official "Der Annehmende schuldet dem Kind vorrangig Unterhalt (§ 1751)"; label en unofficial "The adopter owes priority maintenance to the child (§ 1751)"; }

@source(BGB_P1619)
rule PositionDienstleistung1619(kind: Person, elternteil: Person, tag: Date) strict { label de official "Das Kind ist zu Dienstleistungen im elterlichen Hauswesen und Geschäft verpflichtet (§ 1619)"; label en unofficial "The child is obliged to render services in the parents' household and business (§ 1619)"; when position_trigger_1619(kind, elternteil, tag); then duty Dienstleistung1619 { bearer kind; beneficiary elternteil; achieve dienstleistung_1619_geschuldet(kind, elternteil) during [tag, infinity); }; }
@source(BGB_P1684)
rule PositionUmgang1684(kind: Person, elternteil: Person, tag: Date) strict { label de official "Der Elternteil ist zum Umgang mit dem Kind verpflichtet (§ 1684)"; label en unofficial "The parent is obliged to have contact with the child (§ 1684)"; when position_trigger_1684(kind, elternteil, tag); then duty Umgang1684 { bearer elternteil; beneficiary kind; achieve umgang_1684_geschuldet(kind, elternteil) during [tag, infinity); }; }
@source(BGB_P1751)
rule PositionUnterhalt1751(kind: Person, annehmender: Person, tag: Date) strict { label de official "Der Annehmende ist dem Kind vorrangig zur Gewährung des Unterhalts verpflichtet (§ 1751)"; label en unofficial "The adopter is obliged to maintain the child with priority (§ 1751)"; when position_trigger_1751(kind, annehmender, tag); then duty Unterhalt1751 { bearer annehmender; beneficiary kind; achieve unterhalt_1751_geschuldet(annehmender, kind) during [tag, infinity); }; }
