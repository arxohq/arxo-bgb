// --- Titel 4, 5 und 6: Eltern und Kind, elterliche Sorge, Beistandschaft ------------------------
// --- (§§ 1616–1625, 1626–1698b, 1712–1717) -----------------------------------------------------
//
// WAS HIER AUSGEFÜHRT IST UND WARUM. Diese drei Titel sind überwiegend
// VERFAHRENSRECHT und Zuweisung von Befugnissen: fast jede ihrer Normen endet
// bei einer Entscheidung des Familiengerichts (§§ 1628, 1666, 1671, 1696) oder
// bei einer Erklärung gegenüber dem Standesamt (§§ 1616–1618). Ausgeführt
// werden hier die Normen, die eine RECHTSFOLGE aus messbaren Merkmalen ziehen:
// wem die elterliche Sorge zusteht (§ 1626, § 1626a), wer das Kind vertritt
// (§ 1629), wann Sorgeerklärungen unwirksam sind (§§ 1626b–1626e), die
// Gefährdung des Kindeswohls mit dem geschlossenen Katalog der Maßnahmen
// (§ 1666), das Umgangsrecht (§ 1684) und die Alleinentscheidung bei
// getrennt lebenden Eltern (§ 1687), sowie die Beistandschaft (§§ 1712–1717).
//
// Die Wertungen bleiben im Urteilskanal: Kindeswohl (§ 1626 Abs. 3, § 1626a
// Abs. 2, § 1671, § 1696), Gefährdung (§ 1666 Abs. 1), Erforderlichkeit der
// Maßnahme (§ 1666 Abs. 1, § 1666a), erhebliche Bedeutung der Angelegenheit
// (§ 1628, § 1687 Abs. 1 Satz 1).
//
// NAMENSRECHT (§§ 1616–1617i) liegt in `titel-04-eltern-kind.law`: der NAME
// selbst wird nicht gerechnet, wohl aber die Bedingungen der Erklärungen
// (Ledger D-13-07). Die übrigen Paragraphen des Titels 5 stehen in
// `titel-05-sorge-rest.law`, der Rest der Beistandschaft in
// `titel-06-beistandschaft-rest.law`.

// --- § 1626, § 1626a Elterliche Sorge ------------------------------------------------------------

pub relation eltern_bei_der_geburt_verheiratet(kind: Person) kind empirical {
    label de official "Die Eltern sind bei der Geburt des Kindes miteinander verheiratet (§ 1626a Abs. 1 im Umkehrschluss)";
    label en unofficial "the parents are married to each other at the birth of the child (§ 1626a (1) a contrario)";
}
pub relation sorgeerklaerungen_abgegeben(kind: Person) kind empirical {
    label de official "Die Eltern haben erklärt, dass sie die Sorge gemeinsam übernehmen wollen (Sorgeerklärungen, § 1626a Abs. 1 Nr. 1)";
    label en unofficial "the parents have declared that they wish to assume custody jointly (declarations of custody, § 1626a (1) no. 1)";
}
pub relation eltern_haben_einander_geheiratet(kind: Person) kind empirical {
    label de official "Die Eltern haben einander geheiratet (§ 1626a Abs. 1 Nr. 2)";
    label en unofficial "the parents have married each other (§ 1626a (1) no. 2)";
}
pub relation gemeinsame_sorge_gerichtlich_uebertragen(kind: Person) kind empirical {
    label de official "Das Familiengericht hat den Eltern die elterliche Sorge gemeinsam übertragen (§ 1626a Abs. 1 Nr. 3, Abs. 2) — Tatsache des Falls mit `origin adjudicated`";
    label en unofficial "the family court has transferred custody to the parents jointly (§ 1626a (1) no. 3, (2)) — a fact of the case with `origin adjudicated`";
}
pub relation sorgeerklaerung_unter_bedingung_oder_zeitbestimmung(kind: Person) kind empirical {
    label de official "Eine Sorgeerklärung ist unter einer Bedingung oder einer Zeitbestimmung abgegeben (§ 1626b Abs. 1)";
    label en unofficial "a declaration of custody was made subject to a condition or a time provision (§ 1626b (1))";
}
pub relation sorgeerklaerung_oeffentlich_beurkundet(kind: Person) kind empirical {
    label de official "Sorgeerklärungen und Zustimmungen sind öffentlich beurkundet (§ 1626d Abs. 1)";
    label en unofficial "declarations of custody and consents have been publicly recorded (§ 1626d (1))";
}
pub relation gerichtliche_sorgeentscheidung_ergangen(kind: Person) kind empirical {
    label de official "Über die elterliche Sorge ist eine gerichtliche Entscheidung nach § 1626a Abs. 1 Nr. 3 oder § 1671 getroffen oder nach § 1696 Abs. 1 Satz 1 geändert worden (§ 1626b Abs. 3)";
    label en unofficial "a judicial decision on custody under § 1626a (1) no. 3 or § 1671 has been made or altered under § 1696 (1) sentence 1 (§ 1626b (3))";
}
pub relation alleinsorge_gerichtlich_uebertragen(kind: Person, elternteil: Person) kind empirical {
    label de official "Das Familiengericht hat die elterliche Sorge einem Elternteil allein übertragen (§ 1671) — Tatsache des Falls mit `origin adjudicated`";
    label en unofficial "the family court has transferred custody to one parent alone (§ 1671) — a fact of the case with `origin adjudicated`";
}
pub relation eltern_leben_getrennt(kind: Person) kind empirical {
    label de official "Die Eltern leben nicht nur vorübergehend getrennt (§ 1687 Abs. 1 Satz 1)";
    label en unofficial "the parents live apart other than merely temporarily (§ 1687 (1) sentence 1)";
}
pub relation kind_haelt_sich_gewoehnlich_auf_bei(kind: Person, elternteil: Person) kind empirical {
    label de official "Der Elternteil, bei dem sich das Kind mit Einwilligung des anderen Elternteils oder auf Grund einer gerichtlichen Entscheidung gewöhnlich aufhält (§ 1687 Abs. 1 Satz 2)";
    label en unofficial "the parent with whom the child habitually resides with the other parent's consent or by judicial decision (§ 1687 (1) sentence 2)";
}
pub relation entscheidung_nach_1628_uebertragen(kind: Person, elternteil: Person) kind empirical {
    label de official "Das Familiengericht hat die Entscheidung in einer Angelegenheit der elterlichen Sorge einem Elternteil übertragen (§ 1628 Satz 1) — Tatsache des Falls mit `origin adjudicated`";
    label en unofficial "the family court has transferred the decision in a matter of custody to one parent (§ 1628 sentence 1) — a fact of the case with `origin adjudicated`";
}
pub relation gefahr_im_verzug(kind: Person) kind empirical {
    label de official "Gefahr im Verzug (§ 1629 Abs. 1 Satz 4)";
    label en unofficial "imminent danger (§ 1629 (1) sentence 4)";
}

pub relation sorgeerklaerung_unwirksam(kind: Person) kind institutional {
    label de official "Sorgeerklärungen und Zustimmungen sind NUR unwirksam, wenn sie den Erfordernissen der vorstehenden Vorschriften nicht genügen (§ 1626e)";
    label en unofficial "Declarations of custody and consents are ineffective ONLY if they fail the requirements of the preceding provisions (§ 1626e)";
}
pub relation elterliche_sorge_gemeinsam(kind: Person) kind institutional {
    label de official "Den Eltern steht die elterliche Sorge gemeinsam zu (§ 1626 Abs. 1, § 1626a Abs. 1)";
    label en unofficial "the parents hold parental custody jointly (§ 1626 (1), § 1626a (1))";
}
pub relation elterliche_sorge_allein(kind: Person, elternteil: Person) kind institutional {
    label de official "Einem Elternteil steht die elterliche Sorge allein zu (§ 1626a Abs. 3, § 1671)";
    label en unofficial "one parent holds parental custody alone (§ 1626a (3), § 1671)";
}
pub relation vertretung_des_kindes_gemeinschaftlich(kind: Person) kind institutional {
    label de official "Die Eltern vertreten das Kind gemeinschaftlich (§ 1629 Abs. 1 Satz 2)";
    label en unofficial "the parents represent the child jointly (§ 1629 (1) sentence 2)";
}
pub relation vertretung_des_kindes_allein(kind: Person, elternteil: Person) kind institutional {
    label de official "Ein Elternteil vertritt das Kind allein, soweit er die elterliche Sorge allein ausübt oder ihm die Entscheidung nach § 1628 übertragen ist; bei Gefahr im Verzug ist jeder Elternteil berechtigt (§ 1629 Abs. 1 Satz 3, 4)";
    label en unofficial "a parent represents the child alone insofar as he exercises custody alone or the decision under § 1628 has been transferred to him; in case of imminent danger either parent is entitled (§ 1629 (1) sentences 3, 4)";
}
pub relation alleinentscheidung_in_angelegenheiten_des_taeglichen_lebens(kind: Person, elternteil: Person) kind institutional {
    label de official "Der Elternteil, bei dem sich das Kind gewöhnlich aufhält, hat die Befugnis zur alleinigen Entscheidung in Angelegenheiten des täglichen Lebens (§ 1687 Abs. 1 Satz 2)";
    label en unofficial "the parent with whom the child habitually resides has the power to decide alone in matters of daily life (§ 1687 (1) sentence 2)";
}

@source(BGB_P1626a)
pub external judgment relation gemeinsame_sorge_widerspricht_dem_kindeswohl(kind: Person) {
    authority Court;
    label de official "§ 1626a Abs. 2 Satz 1. Die Übertragung der gemeinsamen elterlichen Sorge widerspricht dem Kindeswohl";
    label en unofficial "§ 1626a (2) sentence 1. The transfer of joint parental custody is contrary to the child's welfare";
}
@source(BGB_P1628)
pub external judgment relation angelegenheit_von_erheblicher_bedeutung(kind: Person) {
    authority Court;
    label de official "§ 1628 Satz 1, § 1687 Abs. 1 Satz 1. Die Regelung der Angelegenheit ist für das Kind von erheblicher Bedeutung";
    label en unofficial "§ 1628 sentence 1, § 1687 (1) sentence 1. The regulation of the matter is of considerable importance for the child";
}

@source(BGB_P1626a) {
    rule GemeinsameSorgeVerheirateterEltern(k: Person) strict {
        label de official "Die Eltern haben die Pflicht und das Recht, für das minderjährige Kind zu sorgen (§ 1626 Abs. 1 Satz 1); sind sie bei der Geburt miteinander verheiratet, steht ihnen die Sorge gemeinsam zu (§ 1626a Abs. 1 im Umkehrschluss)";
        label en unofficial "The parents have the duty and the right to care for the minor child (§ 1626 (1) sentence 1); if they are married to each other at the birth, custody is joint (§ 1626a (1) a contrario)";
        when minderjaehriges_kind(k) and eltern_bei_der_geburt_verheiratet(k);
        then elterliche_sorge_gemeinsam(k);
    }
    rule GemeinsameSorgeDurchSorgeerklaerungen(k: Person) strict {
        label de official "Sind die Eltern bei der Geburt des Kindes nicht miteinander verheiratet, so steht ihnen die elterliche Sorge gemeinsam zu, wenn sie erklären, dass sie die Sorge gemeinsam übernehmen wollen (§ 1626a Abs. 1 Nr. 1)";
        label en unofficial "If the parents are not married to each other at the birth, custody is joint where they declare that they wish to assume it jointly (§ 1626a (1) no. 1)";
        when minderjaehriges_kind(k) and sorgeerklaerungen_abgegeben(k) and not_known(sorgeerklaerung_unwirksam(k));
        then elterliche_sorge_gemeinsam(k);
    }
    rule GemeinsameSorgeDurchHeirat(k: Person) strict {
        label de official "Die elterliche Sorge steht den Eltern gemeinsam zu, wenn sie einander heiraten (§ 1626a Abs. 1 Nr. 2)";
        label en unofficial "Custody is joint where the parents marry each other (§ 1626a (1) no. 2)";
        when minderjaehriges_kind(k) and eltern_haben_einander_geheiratet(k);
        then elterliche_sorge_gemeinsam(k);
    }
    rule GemeinsameSorgeDurchUebertragung(k: Person) strict {
        label de official "Die elterliche Sorge steht den Eltern gemeinsam zu, soweit ihnen das Familiengericht sie gemeinsam überträgt (§ 1626a Abs. 1 Nr. 3)";
        label en unofficial "Custody is joint insofar as the family court transfers it to them jointly (§ 1626a (1) no. 3)";
        when minderjaehriges_kind(k) and gemeinsame_sorge_gerichtlich_uebertragen(k);
        then elterliche_sorge_gemeinsam(k);
    }
    rule SorgeDerMutter(f: Familie, k: Person, m: Person) strict {
        label de official "Im Übrigen hat die Mutter die elterliche Sorge (§ 1626a Abs. 3)";
        label en unofficial "Otherwise the mother has parental custody (§ 1626a (3))";
        when minderjaehriges_kind(k) and mutter(k, m) and elternteil(f, m, k) and not_known(elterliche_sorge_gemeinsam(k))
         and not_known(sorge_gerichtlich_geregelt(k));
        then elterliche_sorge_allein(k, m);
    }
}

pub relation sorge_gerichtlich_geregelt(kind: Person) kind institutional {
    label de official "Über die elterliche Sorge ist gerichtlich entschieden (§ 1671, § 1696): einstelliger Kopf für die Auffangregel des § 1626a Abs. 3";
    label en unofficial "custody has been decided judicially (§ 1671, § 1696): one-place head for the residual rule of § 1626a (3)";
}

@source(BGB_P1671) {
    rule AlleinsorgeDurchUebertragung(k: Person, e: Person) strict {
        label de official "Das Familiengericht hat die elterliche Sorge einem Elternteil allein übertragen (§ 1671 Abs. 1, 2)";
        label en unofficial "The family court has transferred custody to one parent alone (§ 1671 (1), (2))";
        when alleinsorge_gerichtlich_uebertragen(k, e);
        then elterliche_sorge_allein(k, e);
    }
    rule SorgeGerichtlichGeregelt(k: Person, e: Person) strict {
        label de official "Einstelliger Kopf der gerichtlichen Sorgeregelung (§ 1671)";
        label en unofficial "One-place head of the judicial custody arrangement (§ 1671)";
        when alleinsorge_gerichtlich_uebertragen(k, e);
        then sorge_gerichtlich_geregelt(k);
    }
}

@source(BGB_P1626e) {
    rule SorgeerklaerungUnwirksamBedingung(k: Person) strict {
        label de official "Eine Sorgeerklärung unter einer Bedingung oder einer Zeitbestimmung ist unwirksam (§ 1626b Abs. 1, § 1626e)";
        label en unofficial "A declaration of custody subject to a condition or a time provision is ineffective (§ 1626b (1), § 1626e)";
        when sorgeerklaerung_unter_bedingung_oder_zeitbestimmung(k);
        then sorgeerklaerung_unwirksam(k);
    }
    rule SorgeerklaerungUnwirksamForm(k: Person) strict {
        label de official "Sorgeerklärungen und Zustimmungen müssen öffentlich beurkundet werden (§ 1626d Abs. 1); ohne Form sind sie unwirksam (§ 1626e)";
        label en unofficial "Declarations of custody and consents must be publicly recorded (§ 1626d (1)); without that form they are ineffective (§ 1626e)";
        when sorgeerklaerungen_abgegeben(k) and not_known(sorgeerklaerung_oeffentlich_beurkundet(k));
        then sorgeerklaerung_unwirksam(k);
    }
    rule SorgeerklaerungUnwirksamNachEntscheidung(k: Person) strict {
        label de official "Eine Sorgeerklärung ist unwirksam, soweit eine gerichtliche Entscheidung über die elterliche Sorge getroffen oder geändert wurde (§ 1626b Abs. 3, § 1626e)";
        label en unofficial "A declaration of custody is ineffective insofar as a judicial decision on custody has been made or altered (§ 1626b (3), § 1626e)";
        when sorgeerklaerungen_abgegeben(k) and gerichtliche_sorgeentscheidung_ergangen(k);
        then sorgeerklaerung_unwirksam(k);
    }
}

// --- § 1629 Vertretung des Kindes ------------------------------------------------------------------

@source(BGB_P1629) {
    rule VertretungGemeinschaftlich(k: Person) strict {
        label de official "Die elterliche Sorge umfasst die Vertretung des Kindes; die Eltern vertreten das Kind gemeinschaftlich (§ 1629 Abs. 1 Satz 1, 2)";
        label en unofficial "Parental custody includes representation of the child; the parents represent the child jointly (§ 1629 (1) sentences 1, 2)";
        when elterliche_sorge_gemeinsam(k);
        then vertretung_des_kindes_gemeinschaftlich(k);
    }
    rule VertretungAlleinBeiAlleinsorge(k: Person, e: Person) strict {
        label de official "Ein Elternteil vertritt das Kind allein, soweit er die elterliche Sorge allein ausübt (§ 1629 Abs. 1 Satz 3)";
        label en unofficial "A parent represents the child alone insofar as he exercises custody alone (§ 1629 (1) sentence 3)";
        when elterliche_sorge_allein(k, e);
        then vertretung_des_kindes_allein(k, e);
    }
    rule VertretungAlleinNach1628(k: Person, e: Person) strict {
        label de official "Ein Elternteil vertritt das Kind allein, soweit ihm die Entscheidung nach § 1628 übertragen ist (§ 1629 Abs. 1 Satz 3)";
        label en unofficial "A parent represents the child alone insofar as the decision under § 1628 has been transferred to him (§ 1629 (1) sentence 3)";
        when entscheidung_nach_1628_uebertragen(k, e);
        then vertretung_des_kindes_allein(k, e);
    }
    rule VertretungBeiGefahrImVerzug(f: Familie, k: Person, e: Person) strict {
        label de official "Bei Gefahr im Verzug ist jeder Elternteil dazu berechtigt, alle Rechtshandlungen vorzunehmen, die zum Wohl des Kindes notwendig sind (§ 1629 Abs. 1 Satz 4)";
        label en unofficial "In case of imminent danger either parent is entitled to take all legal acts necessary for the child's welfare (§ 1629 (1) sentence 4)";
        when elterliche_sorge_gemeinsam(k) and gefahr_im_verzug(k) and elternteil(f, e, k);
        then vertretung_des_kindes_allein(k, e);
    }
}

// --- § 1666 Gefährdung des Kindeswohls -------------------------------------------------------------
//
// Der Katalog des Abs. 3 ist mit „insbesondere“ eingeleitet und damit NICHT
// abschließend; die sechs Nummern sind dennoch als Aufzählung geführt, weil
// der Text sie benennt, und die Offenheit steht im README, nicht in einer
// erfundenen siebten Nummer. Abs. 2 ist eine Vermutung (§146) mit einem
// tatsächlichen Auslöser.

pub enum Massnahme1666 {
    label de official "Gerichtliche Maßnahmen bei Gefährdung des Kindeswohls (§ 1666 Abs. 3 Nr. 1–6; die Aufzählung ist mit „insbesondere“ nicht abschließend)";
    label en unofficial "judicial measures where the child's welfare is endangered (§ 1666 (3) nos. 1–6; the list is not exhaustive)";
    GebotOeffentlicheHilfen,
    GebotSchulpflicht,
    VerbotWohnungsnutzung,
    VerbotKontaktaufnahme,
    ErsetzungVonErklaerungen,
    EntziehungDerElterlichenSorge
}

@source(BGB_P1666)
pub external judgment relation kindeswohl_gefaehrdet(kind: Person) {
    authority Court;
    label de official "§ 1666 Abs. 1. Das körperliche, geistige oder seelische Wohl des Kindes oder sein Vermögen ist gefährdet und die Eltern sind nicht gewillt oder nicht in der Lage, die Gefahr abzuwenden";
    label en unofficial "§ 1666 (1). The physical, mental or emotional welfare of the child or its property is endangered and the parents are unwilling or unable to avert the danger";
}
@source(BGB_P1666)
pub external judgment relation massnahme_zur_abwendung_erforderlich(kind: Person, massnahme: Massnahme1666) {
    authority Court;
    label de official "§ 1666 Abs. 1, § 1666a. Die Maßnahme ist zur Abwendung der Gefahr erforderlich; eine mit der Trennung des Kindes von der elterlichen Familie verbundene Maßnahme ist nur zulässig, wenn der Gefahr nicht auf andere Weise, auch nicht durch öffentliche Hilfen, begegnet werden kann";
    label en unofficial "§ 1666 (1), § 1666a. The measure is necessary to avert the danger; a measure separating the child from the parental family is permissible only where the danger cannot be met otherwise, including by public assistance";
}

pub relation pflichtverletzung_des_inhabers_der_vermoegenssorge(kind: Person) kind empirical {
    label de official "Der Inhaber der Vermögenssorge verletzt seine Unterhaltspflicht gegenüber dem Kind oder seine mit der Vermögenssorge verbundenen Pflichten oder befolgt Anordnungen des Gerichts nicht (§ 1666 Abs. 2)";
    label en unofficial "the holder of property custody breaches his maintenance duty or the duties connected with property custody, or does not comply with court orders (§ 1666 (2))";
}
pub relation vermoegen_des_kindes_gefaehrdet(kind: Person) kind institutional {
    label de official "In der Regel ist anzunehmen, dass das Vermögen des Kindes gefährdet ist (§ 1666 Abs. 2)";
    label en unofficial "as a rule it is to be assumed that the child's property is endangered (§ 1666 (2))";
}
pub relation massnahme_zu_treffen(kind: Person, massnahme: Massnahme1666) kind institutional {
    label de official "Das Familiengericht hat die Maßnahmen zu treffen, die zur Abwendung der Gefahr erforderlich sind (§ 1666 Abs. 1, Abs. 3)";
    label en unofficial "The family court must take the measures necessary to avert the danger (§ 1666 (1), (3))";
}

@source(BGB_P1666)
pub external judgment relation vermoegensgefaehrdung_ausnahmsweise_zu_verneinen(kind: Person) {
    authority Court;
    label de official "§ 1666 Abs. 2. Ausnahme von der Regelannahme der Vermögensgefährdung („in der Regel“)";
    label en unofficial "§ 1666 (2). Exception to the assumption of endangerment of the property (\"as a rule\")";
}

@source(BGB_P1666) {
    presumption VermoegensgefaehrdungVermutet(k: Person) {
        label de official "In der Regel ist anzunehmen, dass das Vermögen des Kindes gefährdet ist, wenn der Inhaber der Vermögenssorge seine Pflichten verletzt oder Anordnungen des Gerichts nicht befolgt (§ 1666 Abs. 2)";
        label en unofficial "As a rule it is to be assumed that the child's property is endangered where the holder of property custody breaches his duties or does not comply with court orders (§ 1666 (2))";
        when pflichtverletzung_des_inhabers_der_vermoegenssorge(k);
        presume vermoegen_des_kindes_gefaehrdet(k);
        unless vermoegensgefaehrdung_ausnahmsweise_zu_verneinen(k);
    }
    rule MassnahmeZuTreffen(k: Person, m: Massnahme1666) strict {
        label de official "Wird das Wohl des Kindes gefährdet und sind die Eltern nicht gewillt oder nicht in der Lage, die Gefahr abzuwenden, so hat das Familiengericht die Maßnahmen zu treffen, die zur Abwendung der Gefahr erforderlich sind (§ 1666 Abs. 1, Abs. 3)";
        label en unofficial "Where the child's welfare is endangered and the parents are unwilling or unable to avert the danger, the family court must take the measures necessary to avert it (§ 1666 (1), (3))";
        when kindeswohl_gefaehrdet(k) and massnahme_zur_abwendung_erforderlich(k, m);
        then massnahme_zu_treffen(k, m);
    }
}

// --- § 1684 Umgang, § 1687 Alleinentscheidung ------------------------------------------------------

pub relation umgangsrecht(kind: Person, elternteil: Person) kind institutional {
    label de official "Das Kind hat das Recht auf Umgang mit jedem Elternteil; jeder Elternteil ist zum Umgang mit dem Kind verpflichtet und berechtigt (§ 1684 Abs. 1)";
    label en unofficial "The child has the right of contact with each parent; each parent is obliged and entitled to have contact with the child (§ 1684 (1))";
}
pub relation umgangsrecht_eingeschraenkt_oder_ausgeschlossen(kind: Person, elternteil: Person) kind empirical {
    label de official "Das Familiengericht hat das Umgangsrecht eingeschränkt oder ausgeschlossen (§ 1684 Abs. 4) — Tatsache des Falls mit `origin adjudicated`";
    label en unofficial "the family court has restricted or excluded the right of contact (§ 1684 (4)) — a fact of the case with `origin adjudicated`";
}

@source(BGB_P1684)
rule UmgangsrechtJedesElternteils(f: Familie, k: Person, e: Person) strict {
    label de official "Das Kind hat das Recht auf Umgang mit jedem Elternteil; jeder Elternteil ist zum Umgang mit dem Kind verpflichtet und berechtigt (§ 1684 Abs. 1)";
    label en unofficial "The child has the right of contact with each parent; each parent is obliged and entitled to have contact (§ 1684 (1))";
    when minderjaehriges_kind(k) and elternteil(f, e, k) and not_known(umgangsrecht_eingeschraenkt_oder_ausgeschlossen(k, e));
    then umgangsrecht(k, e);
}

@source(BGB_P1687)
rule AlleinentscheidungDesBetreuendenElternteils(k: Person, e: Person) strict {
    label de official "Leben Eltern, denen die elterliche Sorge gemeinsam zusteht, nicht nur vorübergehend getrennt, so hat der Elternteil, bei dem sich das Kind mit Einwilligung des anderen Elternteils oder auf Grund einer gerichtlichen Entscheidung gewöhnlich aufhält, die Befugnis zur alleinigen Entscheidung in Angelegenheiten des täglichen Lebens (§ 1687 Abs. 1 Satz 1, 2)";
    label en unofficial "Where parents holding custody jointly live apart other than temporarily, the parent with whom the child habitually resides has the power to decide alone in matters of daily life (§ 1687 (1) sentences 1, 2)";
    when elterliche_sorge_gemeinsam(k) and eltern_leben_getrennt(k) and kind_haelt_sich_gewoehnlich_auf_bei(k, e);
    then alleinentscheidung_in_angelegenheiten_des_taeglichen_lebens(k, e);
}

// --- Titel 6: Beistandschaft (§§ 1712–1717) --------------------------------------------------------

pub relation antrag_auf_beistandschaft(kind: Person, elternteil: Person) kind empirical {
    label de official "Schriftlicher Antrag des Elternteils auf Beistandschaft des Jugendamts (§ 1712 Abs. 1, § 1714)";
    label en unofficial "written application of the parent for assistance by the youth welfare office (§ 1712 (1), § 1714)";
}
pub relation antragsteller_hat_alleinsorge_oder_obhut(kind: Person, elternteil: Person) kind empirical {
    label de official "Der Antragsteller ist allein sorgeberechtigt oder — bei gemeinsamer Sorge — der Elternteil, in dessen Obhut sich das Kind befindet (§ 1713 Abs. 1)";
    label en unofficial "the applicant has sole custody or — where custody is joint — is the parent in whose care the child is (§ 1713 (1))";
}
pub relation beistandschaft_beendet_verlangt(kind: Person, elternteil: Person) kind empirical {
    label de official "Der Elternteil, der die Beistandschaft beantragt hat, verlangt ihre Beendigung (§ 1715 Abs. 1 Satz 1)";
    label en unofficial "the parent who applied for the assistance demands its termination (§ 1715 (1) sentence 1)";
}
pub relation beistandschaft_besteht(kind: Person, elternteil: Person) kind institutional {
    label de official "Das Jugendamt wird auf schriftlichen Antrag Beistand des Kindes (§ 1712 Abs. 1, § 1714 Satz 1)";
    label en unofficial "the youth welfare office becomes the child's assistant upon written application (§ 1712 (1), § 1714 sentence 1)";
}
pub relation beistandschaft_endet(kind: Person, elternteil: Person) kind institutional {
    label de official "Die Beistandschaft endet, wenn der Elternteil, der sie beantragt hat, dies verlangt (§ 1715 Abs. 1 Satz 1)";
    label en unofficial "the assistance ends when the parent who applied for it so demands (§ 1715 (1) sentence 1)";
}

@source(BGB_P1712) {
    rule BeistandschaftTrittEin(k: Person, e: Person) strict {
        label de official "Das Jugendamt wird auf schriftlichen Antrag eines Elternteils Beistand des Kindes für die Feststellung der Vaterschaft und die Geltendmachung von Unterhaltsansprüchen (§ 1712 Abs. 1); die Beistandschaft tritt mit dem Eingang des Antrags ein (§ 1714 Satz 1) und nur, wenn das Kind seinen gewöhnlichen Aufenthalt im Inland hat (§ 1717 Satz 1)";
        label en unofficial "Upon written application of a parent the youth welfare office becomes the child's assistant for establishing paternity and asserting maintenance claims (§ 1712 (1)); the assistance begins upon receipt of the application (§ 1714 sentence 1)";
        when antrag_auf_beistandschaft(k, e) and antragsteller_hat_alleinsorge_oder_obhut(k, e)
         and gewoehnlicher_aufenthalt_im_inland(k)
         and not_known(beistandschaft_endet(k, e))
         and not_known(beistandschaft_endet_bei_aufenthalt_im_ausland(k, e));
        then beistandschaft_besteht(k, e);
    }
    rule BeistandschaftEndet(k: Person, e: Person) strict {
        label de official "Die Beistandschaft endet, wenn der Elternteil, der sie beantragt hat, dies verlangt (§ 1715 Abs. 1 Satz 1)";
        label en unofficial "The assistance ends when the parent who applied for it so demands (§ 1715 (1) sentence 1)";
        when antrag_auf_beistandschaft(k, e) and beistandschaft_beendet_verlangt(k, e);
        then beistandschaft_endet(k, e);
    }
}

// --- Titel 4: § 1619 Dienstleistungen, § 1624 Ausstattung ------------------------------------------

pub relation kind_dem_hausstand_angehoerig_und_von_eltern_erzogen(kind: Person, elternteil: Person) kind empirical {
    label de official "Das Kind ist dem elterlichen Hausstand angehörig und wird von den Eltern erzogen oder unterhalten (§ 1619)";
    label en unofficial "the child belongs to the parental household and is brought up or maintained by the parents (§ 1619)";
}
pub relation dienstleistungspflicht(kind: Person, elternteil: Person) kind institutional {
    label de official "Das Kind ist verpflichtet, in einer seinen Kräften und seiner Lebensstellung entsprechenden Weise den Eltern in ihrem Hauswesen und Geschäft Dienste zu leisten (§ 1619)";
    label en unofficial "The child is obliged to render services to the parents in their household and business in a manner corresponding to its powers and station in life (§ 1619)";
}

@source(BGB_P1619)
rule DienstleistungspflichtDesKindes(k: Person, e: Person) strict {
    label de official "Das Kind ist, solange es dem elterlichen Hausstand angehört und von den Eltern erzogen oder unterhalten wird, verpflichtet, in einer seinen Kräften und seiner Lebensstellung entsprechenden Weise den Eltern in ihrem Hauswesen und Geschäft Dienste zu leisten (§ 1619)";
    label en unofficial "While it belongs to the parental household and is brought up or maintained by the parents, the child is obliged to render services in the parents' household and business in a manner corresponding to its powers and station in life (§ 1619)";
    when kind_dem_hausstand_angehoerig_und_von_eltern_erzogen(k, e);
    then dienstleistungspflicht(k, e);
}

pub relation zuwendung_zur_ausstattung(kind: Person, elternteil: Person, betrag: Money) kind empirical {
    label de official "Was einem Kinde mit Rücksicht auf seine Verheiratung oder auf die Erlangung einer selbständigen Lebensstellung zur Begründung oder zur Erhaltung der Wirtschaft oder der Lebensstellung von dem Vater oder der Mutter zugewendet wird (Ausstattung, § 1624 Abs. 1)";
    label en unofficial "what is given to a child by the father or mother in view of its marriage or of attaining an independent position in life (endowment, § 1624 (1))";
}
pub relation das_den_umstaenden_entsprechende_mass(kind: Person, elternteil: Person, betrag: Money) kind empirical {
    label de official "Das den Umständen, insbesondere den Vermögensverhältnissen des Vaters oder der Mutter, entsprechende Maß (§ 1624 Abs. 1)";
    label en unofficial "the measure corresponding to the circumstances, in particular the property situation of the father or mother (§ 1624 (1))";
}
pub relation ausstattung_gilt_als_schenkung(kind: Person, elternteil: Person, betrag: Money) kind institutional {
    label de official "Die Ausstattung gilt, auch wenn eine Verpflichtung nicht besteht, nur insoweit als Schenkung, als sie das den Umständen entsprechende Maß übersteigt (§ 1624 Abs. 1)";
    label en unofficial "The endowment counts as a gift, even absent an obligation, only insofar as it exceeds the measure corresponding to the circumstances (§ 1624 (1))";
}

@source(BGB_P1624)
rule AusstattungUeberMass(k: Person, e: Person, zuwendung: Money, mass: Money) strict {
    label de official "Was einem Kinde als Ausstattung zugewendet wird, gilt, auch wenn eine Verpflichtung nicht besteht, nur insoweit als Schenkung, als die Ausstattung das den Umständen, insbesondere den Vermögensverhältnissen des Vaters oder der Mutter, entsprechende Maß übersteigt (§ 1624 Abs. 1)";
    label en unofficial "What is given to a child as an endowment counts as a gift, even absent an obligation, only insofar as it exceeds the measure corresponding to the circumstances (§ 1624 (1))";
    when zuwendung_zur_ausstattung(k, e, zuwendung) and das_den_umstaenden_entsprechende_mass(k, e, mass) and zuwendung > mass;
    then ausstattung_gilt_als_schenkung(k, e, zuwendung - mass);
}

// --- § 1626 Abs. 1, § 1631, § 1632, § 1696 Inhalt der Sorge und Abänderung ------------------------

pub relation personensorge(kind: Person) kind institutional {
    label de official "Die elterliche Sorge umfasst die Sorge für die Person des Kindes (Personensorge) (§ 1626 Abs. 1 Satz 2)";
    label en unofficial "parental custody includes care for the person of the child (personal custody) (§ 1626 (1) sentence 2)";
}
pub relation vermoegenssorge(kind: Person) kind institutional {
    label de official "Die elterliche Sorge umfasst die Sorge für das Vermögen des Kindes (Vermögenssorge) (§ 1626 Abs. 1 Satz 2)";
    label en unofficial "parental custody includes care for the property of the child (property custody) (§ 1626 (1) sentence 2)";
}
pub relation recht_auf_gewaltfreie_erziehung(kind: Person) kind institutional {
    label de official "Das Kind hat ein Recht auf Pflege und Erziehung unter Ausschluss von Gewalt, körperlichen Bestrafungen, seelischen Verletzungen und anderen entwürdigenden Maßnahmen (§ 1631 Abs. 2)";
    label en unofficial "The child has a right to care and upbringing free from violence, corporal punishment, emotional harm and other degrading measures (§ 1631 (2))";
}
pub relation herausgabeanspruch(kind: Person, elternteil: Person, vorenthaltender: Person) kind institutional {
    label de official "Die Personensorge umfasst das Recht, die Herausgabe des Kindes von jedem zu verlangen, der es den Eltern oder einem Elternteil widerrechtlich vorenthält (§ 1632 Abs. 1)";
    label en unofficial "Personal custody includes the right to demand surrender of the child from anyone who unlawfully withholds it from the parents or a parent (§ 1632 (1))";
}
pub relation kind_widerrechtlich_vorenthalten(kind: Person, vorenthaltender: Person) kind empirical {
    label de official "Eine Person enthält das Kind den Eltern oder einem Elternteil widerrechtlich vor (§ 1632 Abs. 1)";
    label en unofficial "a person unlawfully withholds the child from the parents or a parent (§ 1632 (1))";
}
pub relation kindesschutzrechtliche_massnahme_aufzuheben(kind: Person, massnahme: Massnahme1666) kind institutional {
    label de official "Eine kindesschutzrechtliche Maßnahme ist aufzuheben, wenn eine Gefahr für das Wohl des Kindes nicht mehr besteht oder die Erforderlichkeit der Maßnahme entfallen ist (§ 1696 Abs. 2)";
    label en unofficial "A child-protection measure is to be revoked where a danger to the child's welfare no longer exists or the measure is no longer necessary (§ 1696 (2))";
}
pub relation gefahr_nicht_mehr_bestehend(kind: Person) kind empirical {
    label de official "Eine Gefahr für das Wohl des Kindes besteht nicht mehr (§ 1696 Abs. 2) — Tatsache des Falls mit `origin adjudicated`";
    label en unofficial "a danger to the child's welfare no longer exists (§ 1696 (2)) — a fact of the case with `origin adjudicated`";
}

@source(BGB_P1626) {
    rule PersonensorgeUndVermoegenssorgeGemeinsam(k: Person) strict {
        label de official "Die Eltern haben die Pflicht und das Recht, für das minderjährige Kind zu sorgen (elterliche Sorge); die elterliche Sorge umfasst die Sorge für die Person des Kindes (Personensorge) und das Vermögen des Kindes (Vermögenssorge) (§ 1626 Abs. 1)";
        label en unofficial "The parents have the duty and the right to care for the minor child (parental custody); it includes care for the person (personal custody) and for the property of the child (property custody) (§ 1626 (1))";
        when elterliche_sorge_gemeinsam(k);
        then personensorge(k);
    }
    rule VermoegenssorgeGemeinsam(k: Person) strict {
        label de official "Die elterliche Sorge umfasst die Sorge für das Vermögen des Kindes (§ 1626 Abs. 1 Satz 2)";
        label en unofficial "Parental custody includes care for the property of the child (§ 1626 (1) sentence 2)";
        when elterliche_sorge_gemeinsam(k);
        then vermoegenssorge(k);
    }
    rule PersonensorgeAllein(k: Person, e: Person) strict {
        label de official "Auch die allein ausgeübte elterliche Sorge umfasst Personen- und Vermögenssorge (§ 1626 Abs. 1 Satz 2)";
        label en unofficial "Custody exercised alone also includes personal and property custody (§ 1626 (1) sentence 2)";
        when elterliche_sorge_allein(k, e);
        then personensorge(k);
    }
    rule VermoegenssorgeAllein(k: Person, e: Person) strict {
        label de official "Auch die allein ausgeübte elterliche Sorge umfasst die Vermögenssorge (§ 1626 Abs. 1 Satz 2)";
        label en unofficial "Custody exercised alone also includes property custody (§ 1626 (1) sentence 2)";
        when elterliche_sorge_allein(k, e);
        then vermoegenssorge(k);
    }
}

@source(BGB_P1631)
rule GewaltfreieErziehung(k: Person) strict {
    label de official "Das Kind hat ein Recht auf Pflege und Erziehung unter Ausschluss von Gewalt, körperlichen Bestrafungen, seelischen Verletzungen und anderen entwürdigenden Maßnahmen (§ 1631 Abs. 2)";
    label en unofficial "The child has a right to care and upbringing free from violence, corporal punishment, emotional harm and other degrading measures (§ 1631 (2))";
    when personensorge(k);
    then recht_auf_gewaltfreie_erziehung(k);
}

@source(BGB_P1632)
rule HerausgabeDesKindes(f: Familie, k: Person, e: Person, d: Person) strict {
    label de official "Die Personensorge umfasst das Recht, die Herausgabe des Kindes von jedem zu verlangen, der es den Eltern oder einem Elternteil widerrechtlich vorenthält (§ 1632 Abs. 1)";
    label en unofficial "Personal custody includes the right to demand surrender of the child from anyone who unlawfully withholds it from the parents or a parent (§ 1632 (1))";
    when personensorge(k) and elternteil(f, e, k) and kind_widerrechtlich_vorenthalten(k, d);
    then herausgabeanspruch(k, e, d);
}

@source(BGB_P1696)
rule MassnahmeAufzuheben(k: Person, m: Massnahme1666) strict {
    label de official "Eine kindesschutzrechtliche Maßnahme ist aufzuheben, wenn eine Gefahr für das Wohl des Kindes nicht mehr besteht oder die Erforderlichkeit der Maßnahme entfallen ist (§ 1696 Abs. 2)";
    label en unofficial "A child-protection measure is to be revoked where a danger to the child's welfare no longer exists or the measure is no longer necessary (§ 1696 (2))";
    when massnahme_zu_treffen(k, m) and gefahr_nicht_mehr_bestehend(k);
    then kindesschutzrechtliche_massnahme_aufzuheben(k, m);
}
