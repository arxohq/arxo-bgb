// BÜRGERLICHES GESETZBUCH — BRÜCKE IN doctrine.ius_privatum (K6)
//
// Der geltende Text rechnet Verjährung in de.bgb.fristen. Dieses Paket
// übersetzt die Einrede des § 214 Abs. 1 in die gemeinsame Kopfzeile
// remedium_exclusum, ohne die Typen der Nabe umzubenennen und ohne
// de.bgb.fristen zu importieren in den Wörterbuch-Sinn: fristen bleibt
// Eigentümer der Frist. Die Personen- und Causa-Kante bringt das Falldossier.

language "law.core" version "0.2";
package de.bgb.ius_privatum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ius-privatum";

import de.bgb.core version "0.1.0";
import de.bgb.fristen version "0.1.0";
import doctrine.ius_privatum version "0.1.0";

type Person = de.bgb.core::Person;
type Anspruch = de.bgb.core::Anspruch;

deadline policy BGB_FRISTEN_KALENDER {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

pub relation persona_of(p: Person, x: doctrine.ius_privatum::Persona) kind empirical {
    label de official "diese Person des BGB tritt in der vergleichenden Kette als dieses Gesicht auf";
    label en unofficial "this person of the Code appears in the comparative chain as this persona";
}

pub relation causa_of_anspruch(a: Anspruch, c: doctrine.ius_privatum::Causa) kind empirical {
    label de official "dieser Anspruch ist das vergleichende Streitverhältnis";
    label en unofficial "this claim is the comparative causa";
}
