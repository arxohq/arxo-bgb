// --- Untertitel 2 Unterkapitel 3–5 (§§ 562–567b): Pfandrecht des Vermieters,
// --- Wechsel der Vertragsparteien beim Tod des Mieters, Kauf bricht nicht Miete
//
// EIN MONAT AB KENNTNIS, VIERMAL. §§ 562b Abs. 2 Satz 2 (Erlöschen des
// Pfandrechts), 563 Abs. 3 Satz 1 (Ablehnung des Eintritts), 563 Abs. 4
// (Kündigung durch den Vermieter), 563a Abs. 2 (Kündigung der überlebenden
// Mieter) und 564 Satz 2 (Kündigung durch Erben oder Vermieter) knüpfen alle
// an denselben Punkt an: den Tag, an dem der Berechtigte KENNTNIS erlangt.
// Das ist eine festgestellte Tatsache, kein Tag, den das Paket errechnet; die
// Frist selbst ist ein Monatsschritt des § 188 Abs. 2, und weil innerhalb der
// Frist eine Erklärung abzugeben ist, wird § 193 ausdrücklich gerechnet.
//
// DER 15. DES MONATS. § 566b Abs. 1 Satz 2 und § 566c Satz 2 lassen die
// Verfügung beziehungsweise das Rechtsgeschäft auch für den FOLGENDEN
// Kalendermonat wirken, wenn das Eigentum oder die Kenntnis nach dem 15. Tag
// des Monats eintritt. Der Tag wird mit `day_of_month` aus dem Datum gelesen,
// nicht vom Fall angegeben.

// --- §§ 562–562d Vermieterpfandrecht --------------------------------------------------------------

pub relation pfandrecht_des(pf: Vermieterpfandrecht, m: Mietverhaeltnis) kind empirical {
    key(pf);
    label de official "Pfandrecht des Vermieters an den eingebrachten Sachen des Mieters (§ 562 Abs. 1 Satz 1)";
    label en unofficial "lessor's lien over the tenant's belongings brought onto the premises (§ 562 (1) sentence 1)";
}
pub relation forderung_aus_dem_mietverhaeltnis(pf: Vermieterpfandrecht) kind empirical {
    label de official "Forderung des Vermieters aus dem Mietverhältnis, für die das Pfandrecht besteht (§ 562 Abs. 1 Satz 1)";
    label en unofficial "the lessor's claim under the lease for which the lien exists (§ 562 (1) sentence 1)";
}
pub relation sache_der_pfaendung_nicht_unterworfen(pf: Vermieterpfandrecht) kind empirical {
    label de official "die Sache unterliegt der Pfändung nicht (§ 562 Abs. 1 Satz 2)";
    label en unofficial "the thing is not subject to attachment (§ 562 (1) sentence 2)";
}
pub relation kuenftige_entschaedigungsforderung(pf: Vermieterpfandrecht) kind empirical {
    label de official "künftige Entschädigungsforderung oder Miete für eine spätere Zeit als das laufende und das folgende Mietjahr (§ 562 Abs. 2)";
    label en unofficial "future claim for compensation, or rent for a period later than the current and the following lease year (§ 562 (2))";
}
pub relation sachen_entfernt_am(pf: Vermieterpfandrecht, tag: Date) kind empirical {
    key(pf);
    label de official "Tag der Entfernung der Sachen von dem Grundstück (§ 562a Satz 1, § 562b Abs. 2)";
    label en unofficial "day on which the things were removed from the land (§ 562a sentence 1, § 562b (2))";
}
pub relation entfernung_ohne_wissen_oder_unter_widerspruch(pf: Vermieterpfandrecht) kind empirical {
    label de official "die Entfernung erfolgt ohne Wissen oder unter Widerspruch des Vermieters (§ 562a Satz 1, § 562b Abs. 2 Satz 1)";
    label en unofficial "the removal takes place without the lessor's knowledge or against his objection (§ 562a sentence 1, § 562b (2) sentence 1)";
}
pub relation vermieter_kenntnis_von_entfernung_am(pf: Vermieterpfandrecht, tag: Date) kind empirical {
    key(pf);
    label de official "Tag, an dem der Vermieter von der Entfernung der Sachen Kenntnis erlangt (§ 562b Abs. 2 Satz 2) — festgestellte Tatsache";
    label en unofficial "day on which the lessor learns of the removal of the things (§ 562b (2) sentence 2) — established fact";
}
pub relation herausgabeanspruch_gerichtlich_geltend_gemacht_am(pf: Vermieterpfandrecht, tag: Date) kind empirical {
    key(pf);
    label de official "Tag, an dem der Vermieter den Herausgabeanspruch gerichtlich geltend macht (§ 562b Abs. 2 Satz 2)";
    label en unofficial "day on which the lessor asserts the claim for surrender in court (§ 562b (2) sentence 2)";
}
pub relation sicherheit_fuer_pfandrecht_geleistet(pf: Vermieterpfandrecht) kind empirical {
    label de official "der Mieter wendet die Geltendmachung des Pfandrechts durch Sicherheitsleistung ab (§ 562c Satz 1)";
    label en unofficial "the tenant averts assertion of the lien by providing security (§ 562c sentence 1)";
}

pub relation pfandrecht_besteht(pf: Vermieterpfandrecht) kind institutional {
    label de official "das Pfandrecht des Vermieters besteht an der Sache (§ 562 Abs. 1)";
    label en unofficial "the lessor's lien over the thing exists (§ 562 (1))";
}
pub relation pfandrecht_nicht_geltend_zu_machen(pf: Vermieterpfandrecht) kind institutional {
    label de official "für künftige Entschädigungsforderungen und für die Miete für eine spätere Zeit als das laufende und das folgende Mietjahr kann das Pfandrecht nicht geltend gemacht werden (§ 562 Abs. 2)";
    label en unofficial "the lien may not be asserted for future claims for compensation or for rent for a period later than the current and the following lease year (§ 562 (2))";
}
pub relation pfandrecht_erloschen(pf: Vermieterpfandrecht) kind institutional {
    label de official "das Pfandrecht des Vermieters ist erloschen (§ 562a Satz 1, § 562b Abs. 2 Satz 2)";
    label en unofficial "the lessor's lien has lapsed (§ 562a sentence 1, § 562b (2) sentence 2)";
}
pub relation erloeschensfrist_562b_kalenderende(pf: Vermieterpfandrecht, tag: Date) kind institutional {
    key(pf);
    label de official "kalendarisches Ende des Monats nach der Kenntniserlangung von der Entfernung (§ 562b Abs. 2 Satz 2)";
    label en unofficial "calendar end of the month after learning of the removal (§ 562b (2) sentence 2)";
}
pub relation erloeschensfrist_562b_ende(pf: Vermieterpfandrecht, tag: Date) kind institutional {
    key(pf);
    label de official "Tag, mit dessen Ablauf das Pfandrecht erlischt, wenn der Herausgabeanspruch nicht vorher gerichtlich geltend gemacht ist (§ 562b Abs. 2 Satz 2, § 193)";
    label en unofficial "day at whose end the lien lapses if the claim for surrender is not asserted in court beforehand (§ 562b (2) sentence 2, § 193)";
}
pub relation pfandrecht_abgewendet(pf: Vermieterpfandrecht) kind institutional {
    label de official "der Mieter hat die Geltendmachung des Pfandrechts durch Sicherheitsleistung abgewendet (§ 562c Satz 1)";
    label en unofficial "the tenant has averted assertion of the lien by providing security (§ 562c sentence 1)";
}

@source(BGB_P562)
rule Pfandrecht562Abs1(pf: Vermieterpfandrecht, m: Mietverhaeltnis) strict {
    label de official "Der Vermieter hat für seine Forderungen aus dem Mietverhältnis ein Pfandrecht an den eingebrachten Sachen des Mieters; es erstreckt sich nicht auf die Sachen, die der Pfändung nicht unterliegen (§ 562 Abs. 1)";
    label en unofficial "The lessor has a lien over the tenant's belongings brought onto the premises for his claims under the lease; it does not extend to things not subject to attachment (§ 562 (1))";
    when pfandrecht_des(pf, m) and forderung_aus_dem_mietverhaeltnis(pf)
     and not sache_der_pfaendung_nicht_unterworfen(pf);
    then pfandrecht_besteht(pf);
}

@source(BGB_P562)
rule Pfandrecht562Abs2(pf: Vermieterpfandrecht) strict {
    label de official "Für künftige Entschädigungsforderungen und für die Miete für eine spätere Zeit als das laufende und das folgende Mietjahr kann das Pfandrecht nicht geltend gemacht werden (§ 562 Abs. 2)";
    label en unofficial "The lien may not be asserted for future claims for compensation or for rent for a period later than the current and the following lease year (§ 562 (2))";
    when kuenftige_entschaedigungsforderung(pf);
    then pfandrecht_nicht_geltend_zu_machen(pf);
}

@source(BGB_P562a)
rule Erloeschen562a(pf: Vermieterpfandrecht, t: Date) strict {
    label de official "Das Pfandrecht des Vermieters erlischt mit der Entfernung der Sachen von dem Grundstück, außer wenn diese ohne Wissen oder unter Widerspruch des Vermieters erfolgt (§ 562a Satz 1)";
    label en unofficial "The lessor's lien lapses on removal of the things from the land, except where removal occurs without his knowledge or against his objection (§ 562a sentence 1)";
    when sachen_entfernt_am(pf, t) and not entfernung_ohne_wissen_oder_unter_widerspruch(pf);
    then pfandrecht_erloschen(pf);
}

@source(BGB_P562b)
rule Erloeschensfrist562bKalenderende(pf: Vermieterpfandrecht, k: Date) strict {
    label de official "Das Pfandrecht erlischt mit dem Ablauf eines Monats, nachdem der Vermieter von der Entfernung der Sachen Kenntnis erlangt hat (§ 562b Abs. 2 Satz 2) — Monatsschritt nach § 188 Abs. 2, Politik BGB_MIETE_KALENDER";
    label en unofficial "The lien lapses at the end of one month after the lessor learns of the removal of the things (§ 562b (2) sentence 2) — monthly step under § 188 (2), policy BGB_MIETE_KALENDER";
    when entfernung_ohne_wissen_oder_unter_widerspruch(pf) and vermieter_kenntnis_von_entfernung_am(pf, k);
    then erloeschensfrist_562b_kalenderende(pf, add_calendar_period(k, 1 calendar_month));
}

@source(BGB_P562b)
rule Erloeschensfrist562bVerlegung193(pf: Vermieterpfandrecht, k: Date) strict {
    label de official "Innerhalb der Frist ist der Anspruch gerichtlich geltend zu machen; § 193 verlegt den letzten Tag auf den nächsten Werktag";
    label en unofficial "The claim must be asserted in court within the period; § 193 moves the last day to the next working day";
    when erloeschensfrist_562b_kalenderende(pf, k);
    then erloeschensfrist_562b_ende(pf, add_business_days(k, 1 business_day));
}

@source(BGB_P562b)
rule Erloeschen562bAbs2Satz2(pf: Vermieterpfandrecht, e: Date, g: Date) strict {
    label de official "Das Pfandrecht erlischt mit dem Ablauf eines Monats nach der Kenntniserlangung, wenn der Vermieter den Herausgabeanspruch nicht vorher gerichtlich geltend gemacht hat (§ 562b Abs. 2 Satz 2)";
    label en unofficial "The lien lapses at the end of one month after the lessor learns of the removal if he has not asserted the claim for surrender in court beforehand (§ 562b (2) sentence 2)";
    when erloeschensfrist_562b_ende(pf, e) and herausgabeanspruch_gerichtlich_geltend_gemacht_am(pf, g) and g > e;
    then pfandrecht_erloschen(pf);
}

@source(BGB_P562c)
rule Abwendung562c(pf: Vermieterpfandrecht) strict {
    label de official "Der Mieter kann die Geltendmachung des Pfandrechts des Vermieters durch Sicherheitsleistung abwenden (§ 562c Satz 1)";
    label en unofficial "The tenant may avert assertion of the lessor's lien by providing security (§ 562c sentence 1)";
    when sicherheit_fuer_pfandrecht_geleistet(pf);
    then pfandrecht_abgewendet(pf);
}

// --- §§ 563–564 Eintritt und Fortsetzung beim Tod des Mieters -------------------------------------

pub relation tod_des_mieters_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag des Todes des Mieters (§§ 563, 563a, 564, 580) — festgestellte Tatsache";
    label en unofficial "day of the tenant's death (§§ 563, 563a, 564, 580) — established fact";
}
pub relation ehegatte_im_gemeinsamen_haushalt(m: Mietverhaeltnis, p: Person) kind empirical {
    label de official "Ehegatte oder Lebenspartner, der mit dem Mieter einen gemeinsamen Haushalt führt (§ 563 Abs. 1)";
    label en unofficial "spouse or civil partner running a joint household with the tenant (§ 563 (1))";
}
pub relation kind_im_gemeinsamen_haushalt(m: Mietverhaeltnis, p: Person) kind empirical {
    label de official "Kind des Mieters, das in dem gemeinsamen Haushalt lebt (§ 563 Abs. 2 Satz 1)";
    label en unofficial "child of the tenant living in the joint household (§ 563 (2) sentence 1)";
}
pub relation familienangehoeriger_im_gemeinsamen_haushalt(m: Mietverhaeltnis, p: Person) kind empirical {
    label de official "anderer Familienangehöriger, der mit dem Mieter einen gemeinsamen Haushalt führt (§ 563 Abs. 2 Satz 2)";
    label en unofficial "other family member running a joint household with the tenant (§ 563 (2) sentence 2)";
}
pub relation dauerhafter_gemeinsamer_haushalt(m: Mietverhaeltnis, p: Person) kind empirical {
    label de official "Person, die mit dem Mieter einen auf Dauer angelegten gemeinsamen Haushalt führt (§ 563 Abs. 2 Satz 3)";
    label en unofficial "person running a permanently established joint household with the tenant (§ 563 (2) sentence 3)";
}
pub relation kenntnis_vom_tod_am(m: Mietverhaeltnis, p: Person, tag: Date) kind empirical {
    label de official "Tag, an dem die Person vom Tod des Mieters Kenntnis erlangt (§ 563 Abs. 3 Satz 1, § 563a Abs. 2, § 564 Satz 2, § 580) — festgestellte Tatsache";
    label en unofficial "day on which the person learns of the tenant's death (§ 563 (3) sentence 1, § 563a (2), § 564 sentence 2, § 580) — established fact";
}
pub relation fortsetzung_abgelehnt_am(m: Mietverhaeltnis, p: Person, tag: Date) kind empirical {
    label de official "Tag, an dem die eingetretene Person dem Vermieter erklärt, dass sie das Mietverhältnis nicht fortsetzen will (§ 563 Abs. 3 Satz 1)";
    label en unofficial "day on which the person who has entered declares to the lessor that she does not wish to continue the lease (§ 563 (3) sentence 1)";
}
pub relation mehrere_mieter(m: Mietverhaeltnis) kind empirical {
    label de official "mehrere Personen im Sinne des § 563 sind gemeinsam Mieter (§ 563a Abs. 1)";
    label en unofficial "several persons within the meaning of § 563 are jointly tenants (§ 563a (1))";
}
pub relation kein_eintritt_erfolgt(m: Mietverhaeltnis) kind empirical {
    label de official "beim Tod des Mieters treten keine Personen im Sinne des § 563 ein und das Mietverhältnis wird nicht nach § 563a fortgesetzt (§ 564 Satz 1) — ausdrückliche Angabe des Falls";
    label en unofficial "on the tenant's death no persons within the meaning of § 563 enter and the lease is not continued under § 563a (§ 564 sentence 1) — express statement of the case";
}
pub relation wichtiger_grund_in_der_person_des_eingetretenen(m: Mietverhaeltnis, p: Person) kind empirical {
    label de official "in der Person des Eingetretenen liegt ein wichtiger Grund (§ 563 Abs. 4)";
    label en unofficial "there is a compelling reason in the person of the entrant (§ 563 (4))";
}

pub relation eintritt_in_das_mietverhaeltnis(m: Mietverhaeltnis, p: Person) kind institutional {
    label de official "die Person tritt mit dem Tod des Mieters in das Mietverhältnis ein (§ 563 Abs. 1 und 2)";
    label en unofficial "the person enters the lease on the tenant's death (§ 563 (1) and (2))";
}
pub relation eintritt_gilt_als_nicht_erfolgt(m: Mietverhaeltnis, p: Person) kind institutional {
    label de official "erklärt die eingetretene Person innerhalb eines Monats nach Kenntnis vom Tod, dass sie nicht fortsetzen will, gilt der Eintritt als nicht erfolgt (§ 563 Abs. 3 Satz 1)";
    label en unofficial "if the entrant declares within one month of learning of the death that she does not wish to continue, the entry is deemed not to have occurred (§ 563 (3) sentence 1)";
}
pub relation ablehnungsfrist_563_ende(m: Mietverhaeltnis, p: Person, tag: Date) kind institutional {
    label de official "Tag, mit dessen Ablauf der Monat seit der Kenntnis vom Tod des Mieters endet (§ 563 Abs. 3 Satz 1, § 188 Abs. 2, § 193)";
    label en unofficial "day at whose end the month since learning of the tenant's death expires (§ 563 (3) sentence 1, § 188 (2), § 193)";
}
pub relation fortsetzung_mit_ueberlebenden_mietern(m: Mietverhaeltnis) kind institutional {
    label de official "sind mehrere Personen gemeinsam Mieter, so wird das Mietverhältnis beim Tod eines Mieters mit den überlebenden Mietern fortgesetzt (§ 563a Abs. 1)";
    label en unofficial "where several persons are jointly tenants, on the death of one the lease is continued with the surviving tenants (§ 563a (1))";
}
pub relation fortsetzung_mit_dem_erben(m: Mietverhaeltnis) kind institutional {
    label de official "treten keine Personen im Sinne des § 563 ein, so wird das Mietverhältnis mit dem Erben fortgesetzt (§ 564 Satz 1)";
    label en unofficial "where no persons within the meaning of § 563 enter, the lease is continued with the heir (§ 564 sentence 1)";
}

pub relation ehegatte_tritt_ein(m: Mietverhaeltnis) kind institutional {
    label de official "ein Ehegatte oder Lebenspartner tritt nach § 563 Abs. 1 in das Mietverhältnis ein — einstelliger Träger, weil die Ausnahme des Absatzes 2 keine Person benennt (§190, LDC-E4101)";
    label en unofficial "a spouse or civil partner enters the lease under § 563 (1) — a unary carrier, because the exception in subsection (2) names no person (§190, LDC-E4101)";
}

@source(BGB_P563)
rule EhegatteTrittEin563Abs1(m: Mietverhaeltnis, p: Person, t: Date) strict {
    label de official "Der Ehegatte oder Lebenspartner, der mit dem Mieter einen gemeinsamen Haushalt führt, tritt mit dem Tod des Mieters in das Mietverhältnis ein (§ 563 Abs. 1) — Träger der Ausnahme des Absatzes 2";
    label en unofficial "The spouse or civil partner running a joint household with the tenant enters the lease on the tenant's death (§ 563 (1)) — carrier of the exception in subsection (2)";
    when tod_des_mieters_am(m, t) and ehegatte_im_gemeinsamen_haushalt(m, p);
    then ehegatte_tritt_ein(m);
}

@source(BGB_P563)
rule Eintritt563Abs1(m: Mietverhaeltnis, p: Person, t: Date) strict {
    label de official "Der Ehegatte oder Lebenspartner, der mit dem Mieter einen gemeinsamen Haushalt führt, tritt mit dem Tod des Mieters in das Mietverhältnis ein (§ 563 Abs. 1)";
    label en unofficial "The spouse or civil partner running a joint household with the tenant enters the lease on the tenant's death (§ 563 (1))";
    when tod_des_mieters_am(m, t) and ehegatte_im_gemeinsamen_haushalt(m, p);
    then eintritt_in_das_mietverhaeltnis(m, p);
}

@source(BGB_P563)
rule Eintritt563Abs2Satz1(m: Mietverhaeltnis, p: Person, t: Date) defeasible {
    label de official "Leben in dem gemeinsamen Haushalt Kinder des Mieters, treten diese mit dem Tod des Mieters in das Mietverhältnis ein, wenn nicht der Ehegatte oder Lebenspartner eintritt (§ 563 Abs. 2 Satz 1)";
    label en unofficial "Where children of the tenant live in the joint household, they enter the lease on the tenant's death unless the spouse or civil partner enters (§ 563 (2) sentence 1)";
    when tod_des_mieters_am(m, t) and kind_im_gemeinsamen_haushalt(m, p)
     and not_known(ehegatte_tritt_ein(m));
    then eintritt_in_das_mietverhaeltnis(m, p);
}

@source(BGB_P563)
rule Eintritt563Abs2Satz2(m: Mietverhaeltnis, p: Person, t: Date) defeasible {
    label de official "Andere Familienangehörige, die mit dem Mieter einen gemeinsamen Haushalt führen, treten mit dem Tod des Mieters in das Mietverhältnis ein, wenn nicht der Ehegatte oder der Lebenspartner eintritt (§ 563 Abs. 2 Satz 2)";
    label en unofficial "Other family members running a joint household with the tenant enter the lease on his death unless the spouse or civil partner enters (§ 563 (2) sentence 2)";
    when tod_des_mieters_am(m, t) and familienangehoeriger_im_gemeinsamen_haushalt(m, p)
     and not_known(ehegatte_tritt_ein(m));
    then eintritt_in_das_mietverhaeltnis(m, p);
}

@source(BGB_P563)
rule Eintritt563Abs2Satz3(m: Mietverhaeltnis, p: Person, t: Date) defeasible {
    label de official "Dasselbe gilt für Personen, die mit dem Mieter einen auf Dauer angelegten gemeinsamen Haushalt führen (§ 563 Abs. 2 Satz 3)";
    label en unofficial "The same applies to persons running a permanently established joint household with the tenant (§ 563 (2) sentence 3)";
    when tod_des_mieters_am(m, t) and dauerhafter_gemeinsamer_haushalt(m, p)
     and not_known(ehegatte_tritt_ein(m));
    then eintritt_in_das_mietverhaeltnis(m, p);
}

@source(BGB_P563)
rule Ablehnungsfrist563Abs3(m: Mietverhaeltnis, p: Person, k: Date) strict {
    label de official "Erklären eingetretene Personen innerhalb eines Monats, nachdem sie vom Tod des Mieters Kenntnis erlangt haben, dem Vermieter, dass sie das Mietverhältnis nicht fortsetzen wollen, gilt der Eintritt als nicht erfolgt (§ 563 Abs. 3 Satz 1) — Monatsschritt nach § 188 Abs. 2, § 193 ausdrücklich";
    label en unofficial "If the entrants declare to the lessor within one month of learning of the tenant's death that they do not wish to continue the lease, the entry is deemed not to have occurred (§ 563 (3) sentence 1) — monthly step under § 188 (2), § 193 expressly";
    when kenntnis_vom_tod_am(m, p, k);
    then ablehnungsfrist_563_ende(m, p, add_business_days(add_calendar_period(k, 1 calendar_month), 1 business_day));
}

@source(BGB_P563)
rule Ablehnung563Abs3Satz1(m: Mietverhaeltnis, p: Person, e: Date, a: Date) defeasible {
    label de official "Der Eintritt gilt als nicht erfolgt, wenn die Erklärung dem Vermieter innerhalb des Monats zugeht (§ 563 Abs. 3 Satz 1)";
    label en unofficial "The entry is deemed not to have occurred if the declaration reaches the lessor within the month (§ 563 (3) sentence 1)";
    when eintritt_in_das_mietverhaeltnis(m, p) and ablehnungsfrist_563_ende(m, p, e)
     and fortsetzung_abgelehnt_am(m, p, a) and a <= e;
    then eintritt_gilt_als_nicht_erfolgt(m, p);
}

@source(BGB_P563)
rule Kuendigungsrecht563Abs4(m: Mietverhaeltnis, p: Person, v: Person) defeasible {
    label de official "Der Vermieter kann das Mietverhältnis innerhalb eines Monats, nachdem er von dem endgültigen Eintritt Kenntnis erlangt hat, außerordentlich mit der gesetzlichen Frist kündigen, wenn in der Person des Eingetretenen ein wichtiger Grund vorliegt (§ 563 Abs. 4)";
    label en unofficial "The lessor may terminate extraordinarily with the statutory notice period within one month of learning of the final entry if there is a compelling reason in the entrant's person (§ 563 (4))";
    when eintritt_in_das_mietverhaeltnis(m, p) and wichtiger_grund_in_der_person_des_eingetretenen(m, p)
     and vermieter(m, v) and not_known(eintritt_gilt_als_nicht_erfolgt(m, p));
    then ausserordentliches_kuendigungsrecht_gesetzliche_frist(m, v);
}

@source(BGB_P563a)
rule Fortsetzung563aAbs1(m: Mietverhaeltnis, t: Date) strict {
    label de official "Sind mehrere Personen im Sinne des § 563 gemeinsam Mieter, so wird das Mietverhältnis beim Tod eines Mieters mit den überlebenden Mietern fortgesetzt (§ 563a Abs. 1)";
    label en unofficial "Where several persons within the meaning of § 563 are jointly tenants, on the death of one the lease is continued with the surviving tenants (§ 563a (1))";
    when tod_des_mieters_am(m, t) and mehrere_mieter(m);
    then fortsetzung_mit_ueberlebenden_mietern(m);
}

@source(BGB_P564)
rule Fortsetzung564Satz1(m: Mietverhaeltnis, t: Date) strict {
    label de official "Treten beim Tod des Mieters keine Personen im Sinne des § 563 in das Mietverhältnis ein oder wird es nicht mit ihnen nach § 563a fortgesetzt, so wird es mit dem Erben fortgesetzt (§ 564 Satz 1)";
    label en unofficial "Where on the tenant's death no persons within the meaning of § 563 enter and the lease is not continued under § 563a, it is continued with the heir (§ 564 sentence 1)";
    when tod_des_mieters_am(m, t) and kein_eintritt_erfolgt(m);
    then fortsetzung_mit_dem_erben(m);
}

@source(BGB_P564)
rule Kuendigungsrecht564Satz2(m: Mietverhaeltnis, v: Person) strict {
    label de official "In diesem Fall ist sowohl der Erbe als auch der Vermieter berechtigt, das Mietverhältnis innerhalb eines Monats außerordentlich mit der gesetzlichen Frist zu kündigen, nachdem sie vom Tod des Mieters und davon Kenntnis erlangt haben, dass ein Eintritt nicht erfolgt ist (§ 564 Satz 2)";
    label en unofficial "In that case both the heir and the lessor are entitled to terminate extraordinarily with the statutory notice period within one month of learning of the death and that no entry occurred (§ 564 sentence 2)";
    when fortsetzung_mit_dem_erben(m) and vermieter(m, v);
    then ausserordentliches_kuendigungsrecht_gesetzliche_frist(m, v);
}

// --- §§ 566–567b Kauf bricht nicht Miete ----------------------------------------------------------

pub relation eigentumsuebergang_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag des Übergangs des Eigentums an dem vermieteten Wohnraum auf den Erwerber (§ 566 Abs. 1, § 566b Abs. 1, § 577a Abs. 1) — festgestellte Tatsache";
    label en unofficial "day on which ownership of the let residential space passes to the acquirer (§ 566 (1), § 566b (1), § 577a (1)) — established fact";
}
pub relation veraeusserung_nach_ueberlassung(m: Mietverhaeltnis) kind empirical {
    label de official "der vermietete Wohnraum wird NACH der Überlassung an den Mieter veräußert (§ 566 Abs. 1)";
    label en unofficial "the let residential space is sold AFTER it was handed over to the tenant (§ 566 (1))";
}
pub relation erwerber(m: Mietverhaeltnis, p: Person) kind empirical {
    key(m);
    label de official "der Erwerber des vermieteten Wohnraums (§ 566 Abs. 1)";
    label en unofficial "the acquirer of the let residential space (§ 566 (1))";
}
pub relation verfuegung_ueber_die_miete_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, an dem der Vermieter über die Miete verfügt hat (§ 566b Abs. 1 Satz 1)";
    label en unofficial "day on which the lessor disposed of the rent (§ 566b (1) sentence 1)";
}
pub relation mieter_kenntnis_vom_eigentumsuebergang_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, an dem der Mieter von dem Übergang des Eigentums Kenntnis erlangt (§ 566c Satz 1 und 2) — festgestellte Tatsache";
    label en unofficial "day on which the tenant learns of the transfer of ownership (§ 566c sentences 1 and 2) — established fact";
}

pub relation fuenfzehnter_des_uebergangsmonats(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "der 15. Tag des Monats, in dem das Eigentum übergeht (§ 566b Abs. 1 Satz 2) — gerechnet als Monatsanfang plus vierzehn Kalendertage; eine Funktion für den Monatstag nennt die Fläche v1 nicht";
    label en unofficial "the 15th day of the month in which ownership passes (§ 566b (1) sentence 2) — computed as the start of the month plus fourteen calendar days; surface v1 names no function for the day of the month";
}
pub relation fuenfzehnter_des_kenntnismonats(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "der 15. Tag des Monats, in dem der Mieter Kenntnis vom Eigentumsübergang erlangt (§ 566c Satz 2)";
    label en unofficial "the 15th day of the month in which the tenant learns of the transfer of ownership (§ 566c sentence 2)";
}
pub relation erwerber_tritt_ein(m: Mietverhaeltnis, p: Person) kind institutional {
    label de official "der Erwerber tritt anstelle des Vermieters in die sich während der Dauer seines Eigentums aus dem Mietverhältnis ergebenden Rechte und Pflichten ein (§ 566 Abs. 1)";
    label en unofficial "the acquirer takes the lessor's place in the rights and duties arising from the lease during his ownership (§ 566 (1))";
}
pub relation vorausverfuegung_wirksam_laufender_monat(m: Mietverhaeltnis) kind institutional {
    label de official "die Verfügung über die Miete ist wirksam, soweit sie sich auf die Miete für den zur Zeit des Eigentumsübergangs laufenden Kalendermonat bezieht (§ 566b Abs. 1 Satz 1)";
    label en unofficial "the disposition of the rent is effective in so far as it relates to the rent for the calendar month current at the time of the transfer (§ 566b (1) sentence 1)";
}
pub relation vorausverfuegung_wirksam_folgender_monat(m: Mietverhaeltnis) kind institutional {
    label de official "geht das Eigentum nach dem 15. Tag des Monats über, so ist die Verfügung auch für den folgenden Kalendermonat wirksam (§ 566b Abs. 1 Satz 2)";
    label en unofficial "where ownership passes after the 15th day of the month, the disposition is also effective for the following calendar month (§ 566b (1) sentence 2)";
}
pub relation rechtsgeschaeft_wirksam_folgender_monat(m: Mietverhaeltnis) kind institutional {
    label de official "erlangt der Mieter die Kenntnis nach dem 15. Tag des Monats, so ist das Rechtsgeschäft auch für die Miete des folgenden Kalendermonats wirksam (§ 566c Satz 2)";
    label en unofficial "where the tenant learns of the transfer after the 15th day of the month, the transaction is also effective for the rent of the following calendar month (§ 566c sentence 2)";
}

@source(BGB_P566)
rule KaufBrichtNichtMiete566Abs1(m: Mietverhaeltnis, p: Person, t: Date) strict {
    label de official "Wird der vermietete Wohnraum nach der Überlassung an den Mieter von dem Vermieter an einen Dritten veräußert, so tritt der Erwerber anstelle des Vermieters in die sich während der Dauer seines Eigentums aus dem Mietverhältnis ergebenden Rechte und Pflichten ein (§ 566 Abs. 1)";
    label en unofficial "Where the let residential space is sold to a third party after being handed over to the tenant, the acquirer takes the lessor's place in the rights and duties arising during his ownership (§ 566 (1))";
    when veraeusserung_nach_ueberlassung(m) and erwerber(m, p) and eigentumsuebergang_am(m, t);
    then erwerber_tritt_ein(m, p);
}

@source(BGB_P566b)
rule Vorausverfuegung566bAbs1Satz1(m: Mietverhaeltnis, t: Date, vf: Date) strict {
    label de official "Hat der Vermieter vor dem Übergang des Eigentums über die Miete verfügt, so ist die Verfügung wirksam, soweit sie sich auf die Miete für den zur Zeit des Eigentumsübergangs laufenden Kalendermonat bezieht (§ 566b Abs. 1 Satz 1)";
    label en unofficial "Where the lessor disposed of the rent before the transfer of ownership, the disposition is effective in so far as it relates to the rent for the calendar month current at the time of transfer (§ 566b (1) sentence 1)";
    when eigentumsuebergang_am(m, t) and verfuegung_ueber_die_miete_am(m, vf) and vf < t;
    then vorausverfuegung_wirksam_laufender_monat(m);
}

@source(BGB_P566b)
rule FuenfzehnterUebergangsmonat566b(m: Mietverhaeltnis, t: Date) strict {
    label de official "Der 15. Tag des Übergangsmonats wird aus dem Monatsanfang und vierzehn Kalendertagen gebildet (§ 566b Abs. 1 Satz 2)";
    label en unofficial "The 15th day of the month of transfer is formed from the start of the month plus fourteen calendar days (§ 566b (1) sentence 2)";
    when eigentumsuebergang_am(m, t);
    then fuenfzehnter_des_uebergangsmonats(m, add_calendar_period(month_start_of(t), 14 calendar_day));
}

@source(BGB_P566b)
rule Vorausverfuegung566bAbs1Satz2(m: Mietverhaeltnis, t: Date, vf: Date, f: Date) strict {
    label de official "Geht das Eigentum nach dem 15. Tag des Monats über, so ist die Verfügung auch wirksam, soweit sie sich auf die Miete für den folgenden Kalendermonat bezieht (§ 566b Abs. 1 Satz 2)";
    label en unofficial "Where ownership passes after the 15th day of the month, the disposition is also effective for the rent of the following calendar month (§ 566b (1) sentence 2)";
    when eigentumsuebergang_am(m, t) and verfuegung_ueber_die_miete_am(m, vf) and vf < t
     and fuenfzehnter_des_uebergangsmonats(m, f) and t > f;
    then vorausverfuegung_wirksam_folgender_monat(m);
}

@source(BGB_P566c)
rule FuenfzehnterKenntnismonat566c(m: Mietverhaeltnis, k: Date) strict {
    label de official "Der 15. Tag des Kenntnismonats wird aus dem Monatsanfang und vierzehn Kalendertagen gebildet (§ 566c Satz 2)";
    label en unofficial "The 15th day of the month of knowledge is formed from the start of the month plus fourteen calendar days (§ 566c sentence 2)";
    when mieter_kenntnis_vom_eigentumsuebergang_am(m, k);
    then fuenfzehnter_des_kenntnismonats(m, add_calendar_period(month_start_of(k), 14 calendar_day));
}

@source(BGB_P566c)
rule Rechtsgeschaeft566cSatz2(m: Mietverhaeltnis, k: Date, f: Date) strict {
    label de official "Erlangt der Mieter die Kenntnis nach dem 15. Tag des Monats, so ist das Rechtsgeschäft auch wirksam, soweit es sich auf die Miete für den folgenden Kalendermonat bezieht (§ 566c Satz 2)";
    label en unofficial "Where the tenant learns of the transfer after the 15th day of the month, the transaction is also effective for the rent of the following calendar month (§ 566c sentence 2)";
    when mieter_kenntnis_vom_eigentumsuebergang_am(m, k) and fuenfzehnter_des_kenntnismonats(m, f) and k > f;
    then rechtsgeschaeft_wirksam_folgender_monat(m);
}

// --- §§ 562d, 563b, 565, 566a, 566d, 566e, 567, 567a, 567b ----------------------------------------

pub relation sache_fuer_anderen_glaeubiger_gepfaendet(pf: Vermieterpfandrecht) kind empirical {
    label de official "eine Sache, die dem Pfandrecht des Vermieters unterliegt, wird für einen anderen Gläubiger gepfändet (§ 562d)";
    label en unofficial "a thing subject to the lessor's lien is attached for another creditor (§ 562d)";
}
pub relation verstorbener_mieter_ohne_sicherheit(m: Mietverhaeltnis) kind empirical {
    label de official "der verstorbene Mieter hat keine Sicherheit geleistet (§ 563b Abs. 3)";
    label en unofficial "the deceased tenant provided no security (§ 563b (3))";
}
pub relation gewerbliche_weitervermietung_vereinbart(m: Mietverhaeltnis) kind empirical {
    label de official "der Mieter soll nach dem Mietvertrag den gemieteten Wohnraum gewerblich einem Dritten zu Wohnzwecken weitervermieten (§ 565 Abs. 1 Satz 1)";
    label en unofficial "under the lease the tenant is to sublet the residential space commercially to a third party for residential purposes (§ 565 (1) sentence 1)";
}
pub relation sicherheit_geleistet_566a(m: Mietverhaeltnis) kind empirical {
    label de official "der Mieter des veräußerten Wohnraums hat dem Vermieter für die Erfüllung seiner Pflichten Sicherheit geleistet (§ 566a Satz 1)";
    label en unofficial "the tenant of the sold residential space provided the lessor with security for the performance of his duties (§ 566a sentence 1)";
}
pub relation sicherheit_vom_erwerber_nicht_erlangbar(m: Mietverhaeltnis) kind empirical {
    label de official "bei Beendigung des Mietverhältnisses kann der Mieter die Sicherheit von dem Erwerber nicht erlangen (§ 566a Satz 2)";
    label en unofficial "on termination of the lease the tenant cannot obtain the security from the acquirer (§ 566a sentence 2)";
}
pub relation gegenforderung_gegen_vermieter(m: Mietverhaeltnis) kind empirical {
    label de official "dem Mieter steht gegen den Vermieter eine Forderung zu, mit der er gegen die Mietforderung des Erwerbers aufrechnen kann (§ 566d Satz 1)";
    label en unofficial "the tenant has a claim against the lessor with which he may set off against the acquirer's claim for rent (§ 566d sentence 1)";
}
pub relation gegenforderung_nach_kenntnis_erworben(m: Mietverhaeltnis) kind empirical {
    label de official "der Mieter hat die Gegenforderung erworben, nachdem er von dem Übergang des Eigentums Kenntnis erlangt hat (§ 566d Satz 2)";
    label en unofficial "the tenant acquired the counterclaim after learning of the transfer of ownership (§ 566d sentence 2)";
}
pub relation mitteilung_des_eigentumsuebergangs(m: Mietverhaeltnis) kind empirical {
    label de official "der Vermieter teilt dem Mieter mit, dass er das Eigentum an dem vermieteten Wohnraum auf einen Dritten übertragen hat (§ 566e Abs. 1)";
    label en unofficial "the lessor informs the tenant that he has transferred ownership of the let residential space to a third party (§ 566e (1))";
}
pub relation belastung_mit_recht_eines_dritten(m: Mietverhaeltnis) kind empirical {
    label de official "der vermietete Wohnraum wird nach der Überlassung an den Mieter mit dem Recht eines Dritten belastet (§ 567 Satz 1)";
    label en unofficial "after handover to the tenant the let residential space is encumbered with a third party's right (§ 567 sentence 1)";
}
pub relation gebrauch_durch_ausuebung_entzogen(m: Mietverhaeltnis) kind empirical {
    label de official "durch die Ausübung des Rechts wird dem Mieter der vertragsgemäße Gebrauch entzogen (§ 567 Satz 1)";
    label en unofficial "the exercise of the right deprives the tenant of use in conformity with the contract (§ 567 sentence 1)";
}
pub relation gebrauch_durch_ausuebung_beschraenkt(m: Mietverhaeltnis) kind empirical {
    label de official "durch die Ausübung des Rechts wird der Mieter in dem vertragsgemäßen Gebrauch beschränkt (§ 567 Satz 2)";
    label en unofficial "the exercise of the right restricts the tenant in his use in conformity with the contract (§ 567 sentence 2)";
}
pub relation veraeusserung_vor_ueberlassung(m: Mietverhaeltnis) kind empirical {
    label de official "der Vermieter hat den Wohnraum VOR der Überlassung an den Mieter an einen Dritten veräußert oder belastet (§ 567a)";
    label en unofficial "before handover to the tenant the lessor sold or encumbered the residential space to a third party (§ 567a)";
}
pub relation erwerber_hat_pflichten_uebernommen(m: Mietverhaeltnis) kind empirical {
    label de official "der Erwerber hat dem Vermieter gegenüber die Erfüllung der sich aus dem Mietverhältnis ergebenden Pflichten übernommen (§ 567a)";
    label en unofficial "the acquirer undertook to the lessor to perform the duties arising from the lease (§ 567a)";
}
pub relation weiterveraeusserung_durch_erwerber(m: Mietverhaeltnis) kind empirical {
    label de official "der vermietete Wohnraum wird von dem Erwerber weiterveräußert oder belastet (§ 567b Satz 1)";
    label en unofficial "the let residential space is further sold or encumbered by the acquirer (§ 567b sentence 1)";
}

pub relation pfandrecht_nur_fuer_das_letzte_jahr(pf: Vermieterpfandrecht) kind institutional {
    label de official "gegenüber dem pfändenden Gläubiger kann das Pfandrecht nicht wegen der Miete für eine frühere Zeit als das letzte Jahr vor der Pfändung geltend gemacht werden (§ 562d)";
    label en unofficial "as against the attaching creditor the lien may not be asserted for rent for a period earlier than the last year before the attachment (§ 562d)";
}
pub relation gesamtschuldnerische_haftung_563b(m: Mietverhaeltnis, p: Person) kind institutional {
    label de official "die eingetretenen Personen haften neben dem Erben für die bis zum Tod des Mieters entstandenen Verbindlichkeiten als Gesamtschuldner (§ 563b Abs. 1 Satz 1)";
    label en unofficial "the persons who have entered are jointly and severally liable with the heir for obligations arisen up to the tenant's death (§ 563b (1) sentence 1)";
}
pub relation sicherheitsleistung_verlangbar_563b(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "der Vermieter kann, falls der verstorbene Mieter keine Sicherheit geleistet hat, von den eingetretenen Personen nach Maßgabe des § 551 eine Sicherheitsleistung verlangen (§ 563b Abs. 3)";
    label en unofficial "where the deceased tenant provided no security, the lessor may demand security from the entrants in accordance with § 551 (§ 563b (3))";
}
pub relation vermieter_tritt_in_untermietverhaeltnis_ein(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "bei der Beendigung des Mietverhältnisses tritt der Vermieter in die Rechte und Pflichten aus dem Mietverhältnis zwischen dem Mieter und dem Dritten ein (§ 565 Abs. 1 Satz 1)";
    label en unofficial "on termination of the lease the lessor takes over the rights and duties under the lease between the tenant and the third party (§ 565 (1) sentence 1)";
}
pub relation erwerber_tritt_in_sicherheit_ein(m: Mietverhaeltnis, p: Person) kind institutional {
    label de official "der Erwerber tritt in die durch die Sicherheitsleistung begründeten Rechte und Pflichten ein (§ 566a Satz 1)";
    label en unofficial "the acquirer takes over the rights and duties created by the security (§ 566a sentence 1)";
}
pub relation vermieter_weiterhin_zur_rueckgewaehr_verpflichtet(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "kann der Mieter die Sicherheit von dem Erwerber nicht erlangen, so ist der Vermieter weiterhin zur Rückgewähr verpflichtet (§ 566a Satz 2)";
    label en unofficial "where the tenant cannot obtain the security from the acquirer, the lessor remains obliged to return it (§ 566a sentence 2)";
}
pub relation aufrechnung_zulaessig_566d(m: Mietverhaeltnis) kind institutional {
    label de official "der Mieter kann gegen die Mietforderung des Erwerbers eine ihm gegen den Vermieter zustehende Forderung aufrechnen (§ 566d Satz 1)";
    label en unofficial "the tenant may set off a claim against the lessor against the acquirer's claim for rent (§ 566d sentence 1)";
}
pub relation mitteilung_gegen_sich_gelten_lassen(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "teilt der Vermieter die Übertragung mit, so muss er sie dem Mieter gegenüber gegen sich gelten lassen, auch wenn sie nicht erfolgt oder nicht wirksam ist (§ 566e Abs. 1)";
    label en unofficial "where the lessor communicates the transfer, he must allow it to be held against him vis-à-vis the tenant even if it did not occur or is ineffective (§ 566e (1))";
}
pub relation unterlassungspflicht_des_dritten(m: Mietverhaeltnis) kind institutional {
    label de official "wird der Mieter durch die Ausübung des Rechts in dem vertragsgemäßen Gebrauch beschränkt, so ist der Dritte ihm gegenüber verpflichtet, die Ausübung zu unterlassen, soweit sie den vertragsgemäßen Gebrauch beeinträchtigen würde (§ 567 Satz 2)";
    label en unofficial "where the exercise of the right restricts the tenant's contractual use, the third party is obliged towards him to refrain from exercising it in so far as it would impair that use (§ 567 sentence 2)";
}

@source(BGB_P562d)
rule Pfaendung562d(pf: Vermieterpfandrecht) strict {
    label de official "Wird eine Sache, die dem Pfandrecht des Vermieters unterliegt, für einen anderen Gläubiger gepfändet, so kann diesem gegenüber das Pfandrecht nicht wegen der Miete für eine frühere Zeit als das letzte Jahr vor der Pfändung geltend gemacht werden (§ 562d)";
    label en unofficial "Where a thing subject to the lessor's lien is attached for another creditor, the lien may not be asserted against him for rent for a period earlier than the last year before the attachment (§ 562d)";
    when pfandrecht_besteht(pf) and sache_fuer_anderen_glaeubiger_gepfaendet(pf);
    then pfandrecht_nur_fuer_das_letzte_jahr(pf);
}

@source(BGB_P563b)
rule Haftung563bAbs1(m: Mietverhaeltnis, p: Person) defeasible {
    label de official "Die Personen, die nach § 563 in das Mietverhältnis eingetreten sind, haften neben dem Erben für die bis zum Tod des Mieters entstandenen Verbindlichkeiten als Gesamtschuldner (§ 563b Abs. 1 Satz 1)";
    label en unofficial "The persons who entered the lease under § 563 are jointly and severally liable with the heir for obligations arisen up to the tenant's death (§ 563b (1) sentence 1)";
    when eintritt_in_das_mietverhaeltnis(m, p) and not_known(eintritt_gilt_als_nicht_erfolgt(m, p));
    then gesamtschuldnerische_haftung_563b(m, p);
}

@source(BGB_P563b)
rule Sicherheit563bAbs3(m: Mietverhaeltnis, p: Person, v: Person) defeasible {
    label de official "Der Vermieter kann, falls der verstorbene Mieter keine Sicherheit geleistet hat, von den eingetretenen Personen nach Maßgabe des § 551 eine Sicherheitsleistung verlangen (§ 563b Abs. 3)";
    label en unofficial "Where the deceased tenant provided no security, the lessor may demand security from the entrants in accordance with § 551 (§ 563b (3))";
    when eintritt_in_das_mietverhaeltnis(m, p) and verstorbener_mieter_ohne_sicherheit(m) and vermieter(m, v);
    then sicherheitsleistung_verlangbar_563b(m, v);
}

@source(BGB_P565)
rule GewerblicheWeitervermietung565Abs1(m: Mietverhaeltnis, v: Person, e: Date) strict {
    label de official "Soll der Mieter nach dem Mietvertrag den gemieteten Wohnraum gewerblich einem Dritten zu Wohnzwecken weitervermieten, so tritt der Vermieter bei der Beendigung des Mietverhältnisses in die Rechte und Pflichten aus dem Mietverhältnis zwischen dem Mieter und dem Dritten ein (§ 565 Abs. 1 Satz 1)";
    label en unofficial "Where under the lease the tenant is to sublet the space commercially to a third party for residential purposes, on termination the lessor takes over the rights and duties under the lease between the tenant and the third party (§ 565 (1) sentence 1)";
    when gewerbliche_weitervermietung_vereinbart(m) and vermieter(m, v) and beendigung_am(m, e);
    then vermieter_tritt_in_untermietverhaeltnis_ein(m, v);
}

@source(BGB_P566a)
rule Mietsicherheit566aSatz1(m: Mietverhaeltnis, p: Person) strict {
    label de official "Hat der Mieter des veräußerten Wohnraums dem Vermieter Sicherheit geleistet, so tritt der Erwerber in die dadurch begründeten Rechte und Pflichten ein (§ 566a Satz 1)";
    label en unofficial "Where the tenant of the sold space provided the lessor with security, the acquirer takes over the rights and duties created by it (§ 566a sentence 1)";
    when erwerber_tritt_ein(m, p) and sicherheit_geleistet_566a(m);
    then erwerber_tritt_in_sicherheit_ein(m, p);
}

@source(BGB_P566a)
rule Mietsicherheit566aSatz2(m: Mietverhaeltnis, v: Person) strict {
    label de official "Kann bei Beendigung des Mietverhältnisses der Mieter die Sicherheit von dem Erwerber nicht erlangen, so ist der Vermieter weiterhin zur Rückgewähr verpflichtet (§ 566a Satz 2)";
    label en unofficial "Where on termination the tenant cannot obtain the security from the acquirer, the lessor remains obliged to return it (§ 566a sentence 2)";
    when sicherheit_geleistet_566a(m) and sicherheit_vom_erwerber_nicht_erlangbar(m) and vermieter(m, v);
    then vermieter_weiterhin_zur_rueckgewaehr_verpflichtet(m, v);
}

@source(BGB_P566d)
rule Aufrechnung566d(m: Mietverhaeltnis) strict {
    label de official "Soweit die Entrichtung der Miete an den Vermieter nach § 566c dem Erwerber gegenüber wirksam ist, kann der Mieter gegen die Mietforderung des Erwerbers eine ihm gegen den Vermieter zustehende Forderung aufrechnen; die Aufrechnung ist ausgeschlossen, wenn der Mieter die Gegenforderung nach der Kenntniserlangung erworben hat (§ 566d)";
    label en unofficial "In so far as payment of rent to the lessor is effective against the acquirer under § 566c, the tenant may set off a claim against the lessor; set-off is excluded where he acquired the counterclaim after learning of the transfer (§ 566d)";
    when gegenforderung_gegen_vermieter(m) and not gegenforderung_nach_kenntnis_erworben(m);
    then aufrechnung_zulaessig_566d(m);
}

@source(BGB_P566e)
rule Mitteilung566eAbs1(m: Mietverhaeltnis, v: Person) strict {
    label de official "Teilt der Vermieter dem Mieter mit, dass er das Eigentum an dem vermieteten Wohnraum auf einen Dritten übertragen hat, so muss er in Ansehung der Mietforderung dem Mieter gegenüber die mitgeteilte Übertragung gegen sich gelten lassen, auch wenn sie nicht erfolgt oder nicht wirksam ist (§ 566e Abs. 1)";
    label en unofficial "Where the lessor informs the tenant that he has transferred ownership to a third party, he must, as regards the claim for rent, allow the communicated transfer to be held against him even if it did not occur or is ineffective (§ 566e (1))";
    when mitteilung_des_eigentumsuebergangs(m) and vermieter(m, v);
    then mitteilung_gegen_sich_gelten_lassen(m, v);
}

@source(BGB_P567)
rule Belastung567Satz1(m: Mietverhaeltnis, p: Person, t: Date) strict {
    label de official "Wird der vermietete Wohnraum nach der Überlassung an den Mieter mit dem Recht eines Dritten belastet, so sind die §§ 566 bis 566e entsprechend anzuwenden, wenn durch die Ausübung des Rechts dem Mieter der vertragsgemäße Gebrauch entzogen wird (§ 567 Satz 1)";
    label en unofficial "Where the let space is encumbered with a third party's right after handover, §§ 566 to 566e apply accordingly if the exercise of the right deprives the tenant of contractual use (§ 567 sentence 1)";
    when belastung_mit_recht_eines_dritten(m) and gebrauch_durch_ausuebung_entzogen(m)
     and erwerber(m, p) and eigentumsuebergang_am(m, t);
    then erwerber_tritt_ein(m, p);
}

@source(BGB_P567)
rule Belastung567Satz2(m: Mietverhaeltnis) strict {
    label de official "Wird der Mieter durch die Ausübung des Rechts in dem vertragsgemäßen Gebrauch beschränkt, so ist der Dritte dem Mieter gegenüber verpflichtet, die Ausübung zu unterlassen, soweit sie den vertragsgemäßen Gebrauch beeinträchtigen würde (§ 567 Satz 2)";
    label en unofficial "Where the exercise of the right restricts the tenant's contractual use, the third party must refrain from exercising it in so far as it would impair that use (§ 567 sentence 2)";
    when belastung_mit_recht_eines_dritten(m) and gebrauch_durch_ausuebung_beschraenkt(m);
    then unterlassungspflicht_des_dritten(m);
}

@source(BGB_P567a)
rule VeraeusserungVorUeberlassung567a(m: Mietverhaeltnis, p: Person, t: Date) strict {
    label de official "Hat vor der Überlassung des vermieteten Wohnraums der Vermieter den Wohnraum an einen Dritten veräußert oder belastet, so gilt das Gleiche wie in den Fällen des § 566 Abs. 1 und des § 567, wenn der Erwerber dem Vermieter gegenüber die Erfüllung der sich aus dem Mietverhältnis ergebenden Pflichten übernommen hat (§ 567a)";
    label en unofficial "Where before handover the lessor sold or encumbered the space to a third party, the same applies as in the cases of § 566 (1) and § 567 if the acquirer undertook to the lessor to perform the duties arising from the lease (§ 567a)";
    when veraeusserung_vor_ueberlassung(m) and erwerber_hat_pflichten_uebernommen(m)
     and erwerber(m, p) and eigentumsuebergang_am(m, t);
    then erwerber_tritt_ein(m, p);
}

@source(BGB_P567b)
rule Weiterveraeusserung567b(m: Mietverhaeltnis, p: Person, t: Date) strict {
    label de official "Wird der vermietete Wohnraum von dem Erwerber weiterveräußert oder belastet, so sind § 566 Abs. 1 und die §§ 566a bis 567a entsprechend anzuwenden (§ 567b Satz 1)";
    label en unofficial "Where the let space is further sold or encumbered by the acquirer, § 566 (1) and §§ 566a to 567a apply accordingly (§ 567b sentence 1)";
    when weiterveraeusserung_durch_erwerber(m) and erwerber(m, p) and eigentumsuebergang_am(m, t);
    then erwerber_tritt_ein(m, p);
}
