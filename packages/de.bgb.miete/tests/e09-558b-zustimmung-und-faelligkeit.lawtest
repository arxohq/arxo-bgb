language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";
// § 558b Abs. 1 und 2: Zugang am 10. Januar führt zu drittem Monat April und Fristende 31. März.
test "§ 558b: Fristende und erhöhte Miete ab drittem Monat" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": erhoehung_zugegangen_am(entity_ref("urn:de:bgb:miete:e09:E"), @2025-01-10) { origin case_input; }
        assert "f2": zustimmung_erklaert_am(entity_ref("urn:de:bgb:miete:e09:E"), @2025-03-31) { origin case_input; }
    }
    evaluate truth(erhoehte_miete_geschuldet_ab(entity_ref("urn:de:bgb:miete:e09:E"), @2025-04-01));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zustimmungsfrist_558b_kalenderende(entity_ref("urn:de:bgb:miete:e09:E"), @2025-03-31));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zustimmungsfrist_558b_ende(entity_ref("urn:de:bgb:miete:e09:E"), @2025-03-31));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zustimmung_rechtzeitig(entity_ref("urn:de:bgb:miete:e09:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
