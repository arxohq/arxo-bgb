language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";

test "§ 535: vier Pflichten sind bei nachgewiesener Erfüllung erfüllt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": vermieter(entity_ref("urn:de:bgb:miete:p535b"), entity_ref("urn:de:bgb:miete:p535b:V")) { origin case_input; }
        assert "f2": mieter(entity_ref("urn:de:bgb:miete:p535b"), entity_ref("urn:de:bgb:miete:p535b:M")) { origin case_input; }
        assert "f3": mietverhaeltnis_beginn_am(entity_ref("urn:de:bgb:miete:p535b"), @2026-01-01) { origin case_input; }
        assert "f4": gebrauch_gewaehrt(entity_ref("urn:de:bgb:miete:p535b")) { origin case_input; }
        assert "f5": zustand_vertragsgemaess(entity_ref("urn:de:bgb:miete:p535b")) { origin case_input; }
        assert "f6": lasten_getragen(entity_ref("urn:de:bgb:miete:p535b")) { origin case_input; }
        assert "f7": miete_entrichtet(entity_ref("urn:de:bgb:miete:p535b")) { origin case_input; }
    }
    evaluate positions();
    expect position(GebrauchGewaehrung535, SATISFIED);
    expect position(ZustandErhalten535, ACTIVE);
    expect position(LastenTragen535, SATISFIED);
    expect position(Mietzahlung535, SATISFIED);
}
