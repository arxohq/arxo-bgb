language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";
// § 558 Abs. 1 und 3: Wartefrist, Vergleichsmiete und Kappungsgrenze sind gewahrt.
test "§ 558: Anspruch auf Zustimmung besteht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": vermieter(entity_ref("urn:de:bgb:miete:e08"), entity_ref("urn:de:bgb:miete:e08:V")) { origin case_input; }
        assert "f2": erhoehung_des(entity_ref("urn:de:bgb:miete:e08:E"), entity_ref("urn:de:bgb:miete:e08")) { origin case_input; }
        assert "f3": letzte_mietaenderung_am(entity_ref("urn:de:bgb:miete:e08"), @2024-01-01) { origin case_input; }
        assert "f4": erhoehung_eintritt_am(entity_ref("urn:de:bgb:miete:e08:E"), @2025-06-01) { origin case_input; }
        assert "f5": miete_vor_drei_jahren(entity_ref("urn:de:bgb:miete:e08:E"), 700.00 EUR) { origin case_input; }
        assert "f6": verlangte_miete(entity_ref("urn:de:bgb:miete:e08:E"), 820.00 EUR) { origin case_input; }
        assert "f7": ortsuebliche_vergleichsmiete(entity_ref("urn:de:bgb:miete:e08"), 850.00 EUR) { origin case_input; }
        assert "f8": erhoehung_in_textform(entity_ref("urn:de:bgb:miete:e08:E")) { origin case_input; }
    }
    evaluate truth(wartefrist_558_ende(entity_ref("urn:de:bgb:miete:e08"), @2025-04-01));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zustimmungsanspruch_558_besteht(entity_ref("urn:de:bgb:miete:e08:E")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zustimmungsanspruch_558(entity_ref("urn:de:bgb:miete:e08:E"), entity_ref("urn:de:bgb:miete:e08:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
