language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";
// § 573c Abs. 1 Satz 1: Zugang am vierten Tag des Monats ist nicht fristgerecht.
test "§ 573c Abs. 1: Zugang nach dem dritten Werktag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": vermieter(entity_ref("urn:de:bgb:miete:k06"), entity_ref("urn:de:bgb:miete:k06:V")) { origin case_input; }
        assert "f2": mieter(entity_ref("urn:de:bgb:miete:k06"), entity_ref("urn:de:bgb:miete:k06:M")) { origin case_input; }
        assert "f3": gegenstandsart(entity_ref("urn:de:bgb:miete:k06"), Wohnraum) { origin case_input; }
        assert "f4": ueberlassung_am(entity_ref("urn:de:bgb:miete:k06"), @2022-03-01) { origin case_input; }
        assert "f5": kuendigung_des(entity_ref("urn:de:bgb:miete:k06:K"), entity_ref("urn:de:bgb:miete:k06")) { origin case_input; }
        assert "f6": kuendigung_durch_vermieter(entity_ref("urn:de:bgb:miete:k06:K")) { origin case_input; }
        assert "f7": kuendigungsmonat_beginn(entity_ref("urn:de:bgb:miete:k06:K"), @2025-04-01) { origin case_input; }
        assert "f8": kuendigung_erklaert_am(entity_ref("urn:de:bgb:miete:k06:K"), @2025-04-04) { origin case_input; }
        assert "f9": kuendigung_schriftlich(entity_ref("urn:de:bgb:miete:k06:K")) { origin case_input; }
    }
    evaluate truth(dritter_werktag_des_kuendigungsmonats(entity_ref("urn:de:bgb:miete:k06:K"), @2025-04-03));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kuendigung_fristgerecht(entity_ref("urn:de:bgb:miete:k06:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
