language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";
// § 558 Abs. 3 Satz 1: die Miete darf sich innerhalb von drei Jahren nicht um mehr als 20 vom Hundert erhöhen. Miete vor drei Jahren 700,00 €, Kappungsgrenze also 840,00 €. Die Wohnung liegt NICHT in einem Gebiet nach Satz 3, die verlangte Miete von 860,00 € überschreitet die Grenze. § 558 Abs. 1 Satz 1: die Miete ist seit dem 1. Januar 2024 unverändert, 15 Monate enden mit dem Ablauf des 1. April 2025; die Erhöhung soll zum 1. Juni 2025 eintreten — die Wartefrist ist gewahrt, aber der Zustimmungsanspruch scheitert an der Kappungsgrenze (NEITHER).
test "§ 558 Abs. 3: 20 vom Hundert — die Kappungsgrenze ist überschritten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": vermieter(entity_ref("urn:de:bgb:miete:e03"), entity_ref("urn:de:bgb:miete:e03:V")) { origin case_input; }
        assert "f2": mieter(entity_ref("urn:de:bgb:miete:e03"), entity_ref("urn:de:bgb:miete:e03:M")) { origin case_input; }
        assert "f3": gegenstandsart(entity_ref("urn:de:bgb:miete:e03"), Wohnraum) { origin case_input; }
        assert "f4": not kappungsgrenzengebiet(entity_ref("urn:de:bgb:miete:e03")) { origin case_input; }
        assert "f5": letzte_mietaenderung_am(entity_ref("urn:de:bgb:miete:e03"), @2024-01-01) { origin case_input; }
        assert "f6": ortsuebliche_vergleichsmiete(entity_ref("urn:de:bgb:miete:e03"), 900.00 EUR) { origin case_input; }
        assert "f7": erhoehung_des(entity_ref("urn:de:bgb:miete:e03:E"), entity_ref("urn:de:bgb:miete:e03")) { origin case_input; }
        assert "f8": erhoehung_zugegangen_am(entity_ref("urn:de:bgb:miete:e03:E"), @2025-03-10) { origin case_input; }
        assert "f9": erhoehung_in_textform(entity_ref("urn:de:bgb:miete:e03:E")) { origin case_input; }
        assert "f10": erhoehung_eintritt_am(entity_ref("urn:de:bgb:miete:e03:E"), @2025-06-01) { origin case_input; }
        assert "f11": miete_vor_drei_jahren(entity_ref("urn:de:bgb:miete:e03:E"), 700.00 EUR) { origin case_input; }
        assert "f12": verlangte_miete(entity_ref("urn:de:bgb:miete:e03:E"), 860.00 EUR) { origin case_input; }
    }
    evaluate truth(wartefrist_558_ende(entity_ref("urn:de:bgb:miete:e03"), @2025-04-01));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kappungsgrenze(entity_ref("urn:de:bgb:miete:e03:E"), 840.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kappungsgrenze_ueberschritten(entity_ref("urn:de:bgb:miete:e03:E")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zustimmungsanspruch_558_besteht(entity_ref("urn:de:bgb:miete:e03:E")));
    expect truth_status == NEITHER;
    evaluate truth(erhoehte_miete_geschuldet_ab(entity_ref("urn:de:bgb:miete:e03:E"), @2025-06-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
