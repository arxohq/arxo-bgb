language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";
// MINUS EIN SUBJEKT. Derselbe Fall wie k03, aber der Fall gibt NICHT an, dass der Vermieter kündigt. § 573c Abs. 1 Satz 2 verlängert die Frist nur FÜR DEN VERMIETER; ohne diese Angabe greift die zweite Stufe nicht, und es bleibt bei der Grundstufe des Satzes 1: das Mietverhältnis endet mit dem Ablauf des 30. Juni 2025. Der Zeuge zeigt, dass die Stufenregeln den Kündigenden wirklich lesen.
test "§ 573c Abs. 1 Satz 2: ohne die Kündigung des Vermieters bleibt es bei der Grundstufe" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": vermieter(entity_ref("urn:de:bgb:miete:k05"), entity_ref("urn:de:bgb:miete:k05:V")) { origin case_input; }
        assert "f2": mieter(entity_ref("urn:de:bgb:miete:k05"), entity_ref("urn:de:bgb:miete:k05:M")) { origin case_input; }
        assert "f3": gegenstandsart(entity_ref("urn:de:bgb:miete:k05"), Wohnraum) { origin case_input; }
        assert "f4": ueberlassung_am(entity_ref("urn:de:bgb:miete:k05"), @2018-03-01) { origin case_input; }
        assert "f5": kuendigung_des(entity_ref("urn:de:bgb:miete:k05:K"), entity_ref("urn:de:bgb:miete:k05")) { origin case_input; }
        assert "f6": not kuendigung_durch_vermieter(entity_ref("urn:de:bgb:miete:k05:K")) { origin case_input; }
        assert "f7": kuendigungsmonat_beginn(entity_ref("urn:de:bgb:miete:k05:K"), @2025-04-01) { origin case_input; }
        assert "f8": kuendigung_erklaert_am(entity_ref("urn:de:bgb:miete:k05:K"), @2025-04-03) { origin case_input; }
        assert "f9": kuendigung_schriftlich(entity_ref("urn:de:bgb:miete:k05:K")) { origin case_input; }
    }
    evaluate truth(acht_jahre_seit_ueberlassung_am(entity_ref("urn:de:bgb:miete:k05"), @2026-03-01));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kuendigungsfrist_stufe(entity_ref("urn:de:bgb:miete:k05:K"), 5));
    expect truth_status == NEITHER;
    evaluate truth(kuendigungsfrist_stufe(entity_ref("urn:de:bgb:miete:k05:K"), 2));
    expect truth_status == NEITHER;
    evaluate truth(beendigung_durch_kuendigung_am(entity_ref("urn:de:bgb:miete:k05:K"), @2025-09-30));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
