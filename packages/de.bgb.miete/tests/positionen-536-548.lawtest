language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";

test "§§ 536–548: Rechte und Pflichten sind im Fall aktiv" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": vermieter(entity_ref("urn:de:bgb:miete:p536"), entity_ref("urn:de:bgb:miete:p536:V")) { origin case_input; }
        assert "f2": mieter(entity_ref("urn:de:bgb:miete:p536"), entity_ref("urn:de:bgb:miete:p536:M")) { origin case_input; }
        assert "f3": mietverhaeltnis_beginn_am(entity_ref("urn:de:bgb:miete:p536"), @2026-01-01) { origin case_input; }
        assert "f4": mangel_der_mietsache(entity_ref("urn:de:bgb:miete:p536:G"), entity_ref("urn:de:bgb:miete:p536")) { origin case_input; }
        assert "f5": tauglichkeit_gemindert(entity_ref("urn:de:bgb:miete:p536:G")) { origin case_input; }
        assert "f6": minderungsquote(entity_ref("urn:de:bgb:miete:p536:G"), 1, 10) { origin adjudicated; }
        assert "f7": miete_monatlich(entity_ref("urn:de:bgb:miete:p536"), 1000.00 EUR) { origin case_input; }
        assert "f8": herabgesetzte_miete(entity_ref("urn:de:bgb:miete:p536"), entity_ref("urn:de:bgb:miete:p536:G"), 900.00 EUR) { origin case_input; }
        assert "f9": gebrauch_einem_dritten_ueberlassen_durch_vermieter(entity_ref("urn:de:bgb:miete:p536")) { origin case_input; }
        assert "f10": einrichtung_des_mieters(entity_ref("urn:de:bgb:miete:p536")) { origin case_input; }
        assert "f11": gebrauch_einem_dritten_ueberlassen(entity_ref("urn:de:bgb:miete:p536")) { origin case_input; }
        assert "f12": erlaubnis_verweigert(entity_ref("urn:de:bgb:miete:p536")) { origin case_input; }
        assert "f13": miete_nicht_geschuldet(entity_ref("urn:de:bgb:miete:p536")) { origin case_input; }
        assert "f14": gebrauchsueberlassung_ohne_erlaubnis_unzulaessig(entity_ref("urn:de:bgb:miete:p536")) { origin case_input; }
        assert "f15": ausserordentliches_kuendigungsrecht_gesetzliche_frist(entity_ref("urn:de:bgb:miete:p536"), entity_ref("urn:de:bgb:miete:p536:M")) { origin case_input; }
        assert "f16": not mietzeit_bestimmt(entity_ref("urn:de:bgb:miete:p536")) { origin case_input; }
        assert "f17": wichtiger_grund(entity_ref("urn:de:bgb:miete:p536")) { origin case_input; }
        assert "f18": fristlose_kuendigung_zulaessig(entity_ref("urn:de:bgb:miete:p536")) { origin case_input; }
        assert "f19": beendigung_am(entity_ref("urn:de:bgb:miete:p536"), @2026-06-30) { origin case_input; }
        assert "f20": rueckgabepflicht(entity_ref("urn:de:bgb:miete:p536"), entity_ref("urn:de:bgb:miete:p536:M")) { origin case_input; }
        assert "f21": miete_im_voraus_entrichtet(entity_ref("urn:de:bgb:miete:p536"), 1000.00 EUR) { origin case_input; }
        assert "f22": vermieter_hat_beendigung_zu_vertreten(entity_ref("urn:de:bgb:miete:p536")) { origin case_input; }
        assert "f23": erstattung_vorausgezahlter_miete(entity_ref("urn:de:bgb:miete:p536"), 1000.00 EUR) { origin case_input; }
    }
    evaluate positions();
    expect position(HerabgesetzteMiete536, SATISFIED);
    expect position(KeineMiete537, ACTIVE);
    expect position(Wegnahme539, ACTIVE);
    expect position(Unterlassung540, VIOLATED);
    expect position(Kuendigung540, ACTIVE);
    expect position(Kuendigung542, ACTIVE);
    expect position(Kuendigung543, ACTIVE);
    expect position(Immunitaet544, ACTIVE);
    expect position(Rueckgabe546, SATISFIED);
    expect position(Erstattung547, SATISFIED);
    expect position(Bereicherung547, SATISFIED);
}

test "§§ 536–548: dieselben Positionen bleiben beobachtbar nach Ende" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": vermieter(entity_ref("urn:de:bgb:miete:p536b"), entity_ref("urn:de:bgb:miete:p536b:V")) { origin case_input; }
        assert "f2": mieter(entity_ref("urn:de:bgb:miete:p536b"), entity_ref("urn:de:bgb:miete:p536b:M")) { origin case_input; }
        assert "f3": mietverhaeltnis_beginn_am(entity_ref("urn:de:bgb:miete:p536b"), @2026-01-01) { origin case_input; }
        assert "f4": beendigung_am(entity_ref("urn:de:bgb:miete:p536b"), @2026-06-30) { origin case_input; }
        assert "f5": rueckgabepflicht(entity_ref("urn:de:bgb:miete:p536b"), entity_ref("urn:de:bgb:miete:p536b:M")) { origin case_input; }
        assert "f6": miete_im_voraus_entrichtet(entity_ref("urn:de:bgb:miete:p536b"), 1000.00 EUR) { origin case_input; }
        assert "f7": vermieter_hat_beendigung_zu_vertreten(entity_ref("urn:de:bgb:miete:p536b")) { origin case_input; }
        assert "f8": erstattung_vorausgezahlter_miete(entity_ref("urn:de:bgb:miete:p536b"), 1000.00 EUR) { origin case_input; }
    }
    evaluate positions();
    expect position(Rueckgabe546, SATISFIED);
    expect position(Erstattung547, SATISFIED);
    expect position(Bereicherung547, SATISFIED);
    expect not position(HerabgesetzteMiete536, ACTIVE);
    expect not position(Wegnahme539, ACTIVE);
    expect not position(Unterlassung540, VIOLATED);
    expect not position(Kuendigung540, ACTIVE);
    expect not position(Kuendigung542, ACTIVE);
    expect not position(Kuendigung543, ACTIVE);
}

test "§ 540: Verbot der Nutzungsüberlassung bleibt ohne Überlassung aktiv" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": vermieter(entity_ref("urn:de:bgb:miete:p540-maintenance"), entity_ref("urn:de:bgb:miete:p540-maintenance:V")) { origin case_input; }
        assert "f2": mieter(entity_ref("urn:de:bgb:miete:p540-maintenance"), entity_ref("urn:de:bgb:miete:p540-maintenance:M")) { origin case_input; }
        assert "f3": mietverhaeltnis_beginn_am(entity_ref("urn:de:bgb:miete:p540-maintenance"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(Unterlassung540, ACTIVE);
}
