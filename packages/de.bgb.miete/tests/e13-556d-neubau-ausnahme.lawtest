language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";
// § 556f Satz 1: Erstvermietung nach dem 1. Oktober 2014 fällt nicht unter § 556d.
test "§ 556f Satz 1: Neubau ist von der Mietpreisbremse ausgenommen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": gegenstandsart(entity_ref("urn:de:bgb:miete:e13"), Wohnraum) { origin case_input; }
        assert "f2": gebiet_mit_angespanntem_wohnungsmarkt(entity_ref("urn:de:bgb:miete:e13")) { origin case_input; }
        assert "f3": vertragsschluss_am(entity_ref("urn:de:bgb:miete:e13"), @2025-01-10) { origin case_input; }
        assert "f4": landesverordnung_gilt_am(entity_ref("urn:de:bgb:miete:e13"), @2025-01-10) { origin case_input; }
        assert "f5": erstmals_genutzt_und_vermietet_am(entity_ref("urn:de:bgb:miete:e13"), @2020-06-01) { origin case_input; }
    }
    evaluate truth(mietpreisbremse_nicht_anwendbar(entity_ref("urn:de:bgb:miete:e13")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(mietpreisbremse_anwendbar(entity_ref("urn:de:bgb:miete:e13")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
