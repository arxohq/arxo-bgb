language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";
// § 556d Abs. 1: die zulässige Miete beträgt 110 % der Vergleichsmiete.
test "§ 556d: zehn Prozent über der Vergleichsmiete" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": gegenstandsart(entity_ref("urn:de:bgb:miete:e12"), Wohnraum) { origin case_input; }
        assert "f2": gebiet_mit_angespanntem_wohnungsmarkt(entity_ref("urn:de:bgb:miete:e12")) { origin case_input; }
        assert "f3": vertragsschluss_am(entity_ref("urn:de:bgb:miete:e12"), @2025-01-10) { origin case_input; }
        assert "f4": landesverordnung_gilt_am(entity_ref("urn:de:bgb:miete:e12"), @2025-01-10) { origin case_input; }
        assert "f5": ortsuebliche_vergleichsmiete(entity_ref("urn:de:bgb:miete:e12"), 800.00 EUR) { origin case_input; }
        assert "f6": vereinbarte_miete_bei_mietbeginn(entity_ref("urn:de:bgb:miete:e12"), 900.00 EUR) { origin case_input; }
    }
    evaluate truth(mietpreisbremse_anwendbar(entity_ref("urn:de:bgb:miete:e12")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zulaessige_miete(entity_ref("urn:de:bgb:miete:e12"), 880.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(zulaessige_miete_ueberschritten(entity_ref("urn:de:bgb:miete:e12")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
