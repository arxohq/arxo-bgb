language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";
// § 558b Abs. 2 Satz 2: nach dem Zustimmungsfristende laufen drei weitere Monate.
test "§ 558b Abs. 2 Satz 2: Ende der Klagefrist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": erhoehung_zugegangen_am(entity_ref("urn:de:bgb:miete:e11:E"), @2025-01-10) { origin case_input; }
    }
    evaluate truth(zustimmungsfrist_558b_kalenderende(entity_ref("urn:de:bgb:miete:e11:E"), @2025-03-31));
    expect truth_status == TRUE_ONLY;
    evaluate truth(klagefrist_558b_ende(entity_ref("urn:de:bgb:miete:e11:E"), @2025-06-30));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
