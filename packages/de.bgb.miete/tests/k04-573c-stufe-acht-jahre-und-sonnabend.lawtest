language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";
// Zwei Prüfungen in einem Fall. (1) § 573c Abs. 1 Satz 2, dritte Stufe: Überlassung am 1. März 2015, acht Jahre enden mit dem Ablauf des 1. März 2023; der Kündigungsmonat Februar 2025 liegt danach, die Stufe ist acht — das Mietverhältnis endet mit dem Ablauf des 31. Oktober 2025. (2) Der dritte Werktag: der Februar 2025 beginnt an einem Sonnabend, der 1. und 2. Februar sind Sonnabend und Sonntag, der dritte Werktag ist deshalb Mittwoch, der 5. Februar 2025 — die Erklärung an diesem Tag ist noch fristgerecht.
test "§ 573c Abs. 1: dritte Stufe und der dritte Werktag nach einem Wochenende" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": vermieter(entity_ref("urn:de:bgb:miete:k04"), entity_ref("urn:de:bgb:miete:k04:V")) { origin case_input; }
        assert "f2": mieter(entity_ref("urn:de:bgb:miete:k04"), entity_ref("urn:de:bgb:miete:k04:M")) { origin case_input; }
        assert "f3": gegenstandsart(entity_ref("urn:de:bgb:miete:k04"), Wohnraum) { origin case_input; }
        assert "f4": ueberlassung_am(entity_ref("urn:de:bgb:miete:k04"), @2015-03-01) { origin case_input; }
        assert "f5": kuendigung_des(entity_ref("urn:de:bgb:miete:k04:K"), entity_ref("urn:de:bgb:miete:k04")) { origin case_input; }
        assert "f6": kuendigung_durch_vermieter(entity_ref("urn:de:bgb:miete:k04:K")) { origin case_input; }
        assert "f7": kuendigungsmonat_beginn(entity_ref("urn:de:bgb:miete:k04:K"), @2025-02-01) { origin case_input; }
        assert "f8": kuendigung_erklaert_am(entity_ref("urn:de:bgb:miete:k04:K"), @2025-02-05) { origin case_input; }
        assert "f9": kuendigung_schriftlich(entity_ref("urn:de:bgb:miete:k04:K")) { origin case_input; }
    }
    evaluate truth(dritter_werktag_des_kuendigungsmonats(entity_ref("urn:de:bgb:miete:k04:K"), @2025-02-05));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kuendigung_fristgerecht(entity_ref("urn:de:bgb:miete:k04:K")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kuendigungsfrist_stufe(entity_ref("urn:de:bgb:miete:k04:K"), 8));
    expect truth_status == TRUE_ONLY;
    evaluate truth(beendigung_durch_kuendigung_am(entity_ref("urn:de:bgb:miete:k04:K"), @2025-10-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
