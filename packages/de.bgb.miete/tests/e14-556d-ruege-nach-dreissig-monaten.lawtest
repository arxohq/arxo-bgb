language "law.core" version "0.2";
package de.bgb.miete version "0.1.0";
namespace "urn:de:corpus:clir:bgb-miete";
// § 556g Abs. 2 Satz 3: nach Ablauf von 30 Monaten ist die Rückforderung zeitlich begrenzt.
test "§ 556g Abs. 2: verspätete Rüge nach 30 Monaten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_MIETE_KALENDER; }
        assert "f1": mietverhaeltnis_beginn_am(entity_ref("urn:de:bgb:miete:e14"), @2023-01-01) { origin case_input; }
        assert "f2": ruege_zugegangen_am(entity_ref("urn:de:bgb:miete:e14"), @2025-08-02) { origin case_input; }
    }
    evaluate truth(ruegefrist_30_monate_ende(entity_ref("urn:de:bgb:miete:e14"), @2025-07-01));
    expect truth_status == TRUE_ONLY;
    evaluate truth(rueckforderung_nur_ab_zugang_der_ruege(entity_ref("urn:de:bgb:miete:e14")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
