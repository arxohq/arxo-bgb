language "law.core" version "0.2";
package examples.de.bgb.kuendigung_und_mieterhoehung version "0.1.0";
namespace "urn:law:examples:de:bgb:kuendigung-und-mieterhoehung";

case MieterhoehungBisKappungsgrenze {
    context {
        deadline_policy examples.de.bgb.kuendigung_und_mieterhoehung::BGB_MIETE_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-17;
        knowledge_time @2026-09-17T09:00:00Z;
        decision_time @2026-09-17T09:00:00Z;
        timezone "Europe/Berlin";
    }
    assert "vermieter": de.bgb.miete::vermieter(entity_ref("urn:de:bgb:p7:k01"), entity_ref("urn:de:bgb:p7:k01:V")) { origin case_input; }
    assert "mieterhoehung": de.bgb.miete::erhoehung_des(entity_ref("urn:de:bgb:p7:k01:E"), entity_ref("urn:de:bgb:p7:k01")) { origin case_input; }
    assert "kein-kappungsgebiet": not de.bgb.miete::kappungsgrenzengebiet(entity_ref("urn:de:bgb:p7:k01")) { origin case_input; }
    assert "aenderung": de.bgb.miete::letzte_mietaenderung_am(entity_ref("urn:de:bgb:p7:k01"), @2024-01-01) { origin case_input; }
    assert "eintritt": de.bgb.miete::erhoehung_eintritt_am(entity_ref("urn:de:bgb:p7:k01:E"), @2025-06-01) { origin case_input; }
    assert "alt": de.bgb.miete::miete_vor_drei_jahren(entity_ref("urn:de:bgb:p7:k01:E"), 700.00 EUR) { origin case_input; }
    assert "verlangt": de.bgb.miete::verlangte_miete(entity_ref("urn:de:bgb:p7:k01:E"), 820.00 EUR) { origin case_input; }
    assert "vergleich": de.bgb.miete::ortsuebliche_vergleichsmiete(entity_ref("urn:de:bgb:p7:k01"), 850.00 EUR) { origin case_input; }
    assert "textform": de.bgb.miete::erhoehung_in_textform(entity_ref("urn:de:bgb:p7:k01:E")) { origin case_input; }
}
