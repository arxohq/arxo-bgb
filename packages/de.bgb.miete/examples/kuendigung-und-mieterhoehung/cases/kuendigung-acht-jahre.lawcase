language "law.core" version "0.2";
package examples.de.bgb.kuendigung_und_mieterhoehung version "0.1.0";
namespace "urn:law:examples:de:bgb:kuendigung-und-mieterhoehung";

case KuendigungAchtJahre {
    context {
        deadline_policy examples.de.bgb.kuendigung_und_mieterhoehung::BGB_MIETE_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-17;
        knowledge_time @2026-09-17T09:00:00Z;
        decision_time @2026-09-17T09:00:00Z;
        timezone "Europe/Berlin";
    }
    assert "vermieter": de.bgb.miete::vermieter(entity_ref("urn:de:bgb:p7:k01"), entity_ref("urn:de:bgb:p7:k01:V")) { origin case_input; }
    assert "mieter": de.bgb.miete::mieter(entity_ref("urn:de:bgb:p7:k01"), entity_ref("urn:de:bgb:p7:k01:M")) { origin case_input; }
    assert "wohnraum": de.bgb.miete::gegenstandsart(entity_ref("urn:de:bgb:p7:k01"), Wohnraum) { origin case_input; }
    assert "ueberlassung": de.bgb.miete::ueberlassung_am(entity_ref("urn:de:bgb:p7:k01"), @2015-03-01) { origin case_input; }
    assert "kuendigung": de.bgb.miete::kuendigung_des(entity_ref("urn:de:bgb:p7:k01:K"), entity_ref("urn:de:bgb:p7:k01")) { origin case_input; }
    assert "durch-vermieter": de.bgb.miete::kuendigung_durch_vermieter(entity_ref("urn:de:bgb:p7:k01:K")) { origin case_input; }
    assert "monat": de.bgb.miete::kuendigungsmonat_beginn(entity_ref("urn:de:bgb:p7:k01:K"), @2025-02-01) { origin case_input; }
    assert "erklaert": de.bgb.miete::kuendigung_erklaert_am(entity_ref("urn:de:bgb:p7:k01:K"), @2025-02-05) { origin case_input; }
    assert "schriftlich": de.bgb.miete::kuendigung_schriftlich(entity_ref("urn:de:bgb:p7:k01:K")) { origin case_input; }
}
