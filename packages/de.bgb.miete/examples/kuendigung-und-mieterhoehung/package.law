language "law.core" version "0.2";
package examples.de.bgb.kuendigung_und_mieterhoehung version "0.1.0";
namespace "urn:law:examples:de:bgb:kuendigung-und-mieterhoehung";

import de.bgb.miete version "0.1.0";
import de.bgb.fristen version "0.1.0";
import de.bgb.core version "0.1.0";

// §168.4 / §86: the collection owns the calendar policy used by the cases.
// Canon BGB policies stay unexported (not `pub`).
deadline policy BGB_MIETE_KALENDER {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

// Six cases. No norm is written here: all conclusions come from de.bgb.miete.
