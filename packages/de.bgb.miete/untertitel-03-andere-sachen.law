// --- Untertitel 3 Mietverhältnisse über andere Sachen (§§ 578–580a)
//
// EINE VERWEISUNGSKETTE, KEINE KOPIE. §§ 578, 578a und 578b sagen nur, WELCHE
// Vorschriften der ersten beiden Untertitel auf welchen Gegenstand anzuwenden
// sind. Das Paket führt das als FESTSTELLUNG aus (`vorschriften_anwendbar`),
// nicht als Kopie der Regeln: die Regeln selbst stehen einmal bei ihrem
// Paragraphen und lesen den Gegenstand aus `gegenstandsart`.
//
// § 580a KENNT SECHS FRISTEN. Absatz 1 Nr. 1 (Tagesmiete: an jedem Tag zum
// Ablauf des folgenden Tages), Nr. 2 (Wochenmiete: erster Werktag einer Woche
// zum Ablauf des folgenden Sonnabends), Nr. 3 (Monatsmiete: dritter Werktag
// zum Ablauf des übernächsten Monats; bei gewerblich genutzten unbebauten
// Grundstücken nur zum Ablauf eines Kalendervierteljahrs), Absatz 2
// (Geschäftsräume: dritter Werktag eines Kalendervierteljahres zum Ablauf des
// nächsten), Absatz 3 Nr. 1 und Nr. 2 (bewegliche Sachen und digitale
// Produkte). Ausgeführt sind die drei, die ein reines Datum liefern; die
// Vierteljahresfristen brauchen den Beginn des Kalendervierteljahrs als
// Angabe des Falls, weil die Fläche v1 keinen Term für den Quartalsanfang
// nennt (Ledger D-06-08).

pub relation bemessung_nach_tagen(m: Mietverhaeltnis) kind empirical {
    label de official "die Miete ist nach Tagen bemessen (§ 580a Abs. 1 Nr. 1, Abs. 3 Nr. 1)";
    label en unofficial "the rent is measured by days (§ 580a (1) no. 1, (3) no. 1)";
}
pub relation bemessung_nach_wochen(m: Mietverhaeltnis) kind empirical {
    label de official "die Miete ist nach Wochen bemessen (§ 580a Abs. 1 Nr. 2)";
    label en unofficial "the rent is measured by weeks (§ 580a (1) no. 2)";
}
pub relation bemessung_nach_monaten_oder_laenger(m: Mietverhaeltnis) kind empirical {
    label de official "die Miete ist nach Monaten oder längeren Zeitabschnitten bemessen (§ 580a Abs. 1 Nr. 3, Abs. 3 Nr. 2)";
    label en unofficial "the rent is measured by months or longer periods (§ 580a (1) no. 3, (3) no. 2)";
}
pub relation gewerblich_genutztes_unbebautes_grundstueck(m: Mietverhaeltnis) kind empirical {
    label de official "Mietverhältnis über ein gewerblich genutztes unbebautes Grundstück (§ 580a Abs. 1 Nr. 3 Halbsatz 2)";
    label en unofficial "lease of commercially used undeveloped land (§ 580a (1) no. 3 second half-sentence)";
}
pub relation kalendervierteljahr_beginn(k: Kuendigung, tag: Date) kind empirical {
    label de official "Beginn des Kalendervierteljahrs, in dem gekündigt wird (§ 580a Abs. 2) — Angabe des Falls, weil die Fläche v1 keinen Term für den Quartalsanfang nennt";
    label en unofficial "start of the calendar quarter in which notice is given (§ 580a (2)) — a statement of the case, because surface v1 names no term for the start of a quarter";
}

pub relation vorschriften_anwendbar_grundstueck(m: Mietverhaeltnis) kind institutional {
    label de official "auf Mietverhältnisse über Grundstücke sind die §§ 554, 562 bis 562d, 566 bis 567b sowie 570 entsprechend anzuwenden; § 550 gilt mit der Maßgabe der Textform (§ 578 Abs. 1)";
    label en unofficial "§§ 554, 562 to 562d, 566 to 567b and 570 apply accordingly to leases of land; § 550 applies with the proviso of text form (§ 578 (1))";
}
pub relation vorschriften_anwendbar_raeume(m: Mietverhaeltnis) kind institutional {
    label de official "auf Mietverhältnisse über Räume, die keine Wohnräume sind, sind die in Absatz 1 genannten Vorschriften sowie § 552 Abs. 1, §§ 555a bis 555f und § 569 Abs. 2 entsprechend anzuwenden (§ 578 Abs. 2)";
    label en unofficial "§§ named in subsection (1) as well as § 552 (1), §§ 555a to 555f and § 569 (2) apply accordingly to leases of rooms that are not residential (§ 578 (2))";
}
pub relation vorschriften_anwendbar_schiff(m: Mietverhaeltnis) kind institutional {
    label de official "die Vorschriften der §§ 566, 566a, 566e bis 567b gelten im Falle der Veräußerung oder Belastung eines im Schiffsregister eingetragenen Schiffs entsprechend (§ 578a Abs. 1)";
    label en unofficial "§§ 566, 566a, 566e to 567b apply accordingly on the sale or encumbrance of a ship entered in the ship register (§ 578a (1))";
}
pub relation maengelvorschriften_nicht_anwendbar(m: Mietverhaeltnis) kind institutional {
    label de official "auf einen Verbrauchervertrag über die Miete digitaler Produkte sind § 535 Abs. 1 Satz 2 und die §§ 536 bis 536d nicht anzuwenden; an ihre Stelle treten die Vorschriften des Abschnitts 3 Titel 2a (§ 578b Abs. 1)";
    label en unofficial "§ 535 (1) sentence 2 and §§ 536 to 536d do not apply to a consumer contract for the lease of digital products; the provisions of Division 3 Title 2a take their place (§ 578b (1))";
}
pub relation miete_faellig_am_ende_der_mietzeit(m: Mietverhaeltnis) kind institutional {
    label de official "die Miete für ein Grundstück und für bewegliche Sachen ist am Ende der Mietzeit zu entrichten; ist sie nach Zeitabschnitten bemessen, nach Ablauf der einzelnen Zeitabschnitte (§ 579 Abs. 1 Satz 1 und 2)";
    label en unofficial "the rent for land and movables is payable at the end of the lease period; if measured by periods, at the end of each period (§ 579 (1) sentences 1 and 2)";
}

@source(BGB_P578)
rule Grundstueck578Abs1(m: Mietverhaeltnis) strict {
    label de official "Auf Mietverhältnisse über Grundstücke sind die Vorschriften der §§ 554, 562 bis 562d, 566 bis 567b sowie 570 entsprechend anzuwenden (§ 578 Abs. 1)";
    label en unofficial "§§ 554, 562 to 562d, 566 to 567b and 570 apply accordingly to leases of land (§ 578 (1))";
    when gegenstandsart(m, Grundstueck);
    then vorschriften_anwendbar_grundstueck(m);
}

@source(BGB_P578)
rule Raeume578Abs2(m: Mietverhaeltnis) strict {
    label de official "Auf Mietverhältnisse über Räume, die keine Wohnräume sind, sind die in Absatz 1 genannten Vorschriften sowie § 552 Abs. 1, § 555a Absatz 1 bis 3, §§ 555b, 555c Absatz 1 bis 4, § 555d Absatz 1 bis 6, § 555e Absatz 1 und 2, § 555f und § 569 Abs. 2 entsprechend anzuwenden (§ 578 Abs. 2)";
    label en unofficial "§§ named in subsection (1) as well as § 552 (1), § 555a (1) to (3), §§ 555b, 555c (1) to (4), § 555d (1) to (6), § 555e (1) and (2), § 555f and § 569 (2) apply accordingly to leases of non-residential rooms (§ 578 (2))";
    when gegenstandsart(m, Geschaeftsraum);
    then vorschriften_anwendbar_raeume(m);
}

@source(BGB_P578)
rule SonstigeRaeume578Abs2(m: Mietverhaeltnis) strict {
    label de official "Dasselbe gilt für sonstige Räume, die keine Wohnräume sind (§ 578 Abs. 2 Satz 1)";
    label en unofficial "The same applies to other rooms that are not residential (§ 578 (2) sentence 1)";
    when gegenstandsart(m, SonstigeRaeume);
    then vorschriften_anwendbar_raeume(m);
}

@source(BGB_P578a)
rule Schiff578aAbs1(m: Mietverhaeltnis) strict {
    label de official "Die Vorschriften der §§ 566, 566a, 566e bis 567b gelten im Falle der Veräußerung oder Belastung eines im Schiffsregister eingetragenen Schiffs entsprechend (§ 578a Abs. 1)";
    label en unofficial "§§ 566, 566a, 566e to 567b apply accordingly on the sale or encumbrance of a registered ship (§ 578a (1))";
    when gegenstandsart(m, EingetragenesSchiff);
    then vorschriften_anwendbar_schiff(m);
}

@source(BGB_P578b)
rule DigitaleProdukte578bAbs1(m: Mietverhaeltnis) strict {
    label de official "Auf einen Verbrauchervertrag, bei dem der Unternehmer sich verpflichtet, dem Verbraucher digitale Produkte zu vermieten, sind § 535 Absatz 1 Satz 2 und die §§ 536 bis 536d nicht anzuwenden (§ 578b Abs. 1 Satz 1 Nr. 1)";
    label en unofficial "§ 535 (1) sentence 2 and §§ 536 to 536d do not apply to a consumer contract under which the trader undertakes to lease digital products to the consumer (§ 578b (1) sentence 1 no. 1)";
    when gegenstandsart(m, DigitalesProdukt);
    then maengelvorschriften_nicht_anwendbar(m);
}

@source(BGB_P579)
rule Faelligkeit579Abs1(m: Mietverhaeltnis) strict {
    label de official "Die Miete für ein Grundstück und für bewegliche Sachen ist am Ende der Mietzeit zu entrichten; ist die Miete nach Zeitabschnitten bemessen, so ist sie nach Ablauf der einzelnen Zeitabschnitte zu entrichten (§ 579 Abs. 1 Satz 1 und 2)";
    label en unofficial "The rent for land and movables is payable at the end of the lease period; if measured by periods, it is payable at the end of each period (§ 579 (1) sentences 1 and 2)";
    when gegenstandsart(m, Grundstueck);
    then miete_faellig_am_ende_der_mietzeit(m);
}

@source(BGB_P579)
rule FaelligkeitBeweglich579Abs1(m: Mietverhaeltnis) strict {
    label de official "Dasselbe gilt für bewegliche Sachen (§ 579 Abs. 1 Satz 1)";
    label en unofficial "The same applies to movables (§ 579 (1) sentence 1)";
    when gegenstandsart(m, BeweglicheSache);
    then miete_faellig_am_ende_der_mietzeit(m);
}

@source(BGB_P579)
rule FaelligkeitRaeume579Abs2(m: Mietverhaeltnis, b: Date) strict {
    label de official "Für Mietverhältnisse über Räume gilt § 556b Abs. 1 entsprechend (§ 579 Abs. 2): die Miete ist spätestens bis zum dritten Werktag des Zeitabschnitts zu entrichten";
    label en unofficial "For leases of rooms § 556b (1) applies accordingly (§ 579 (2)): the rent is payable at the latest by the third working day of the period";
    when gegenstandsart(m, Geschaeftsraum) and zeitabschnitt_beginn(m, b);
    then miete_faellig_spaetestens_am(m, add_business_days(b, 3 business_day));
}

// --- § 580 Außerordentliche Kündigung bei Tod des Mieters -----------------------------------------

@source(BGB_P580)
rule Kuendigung580(m: Mietverhaeltnis, v: Person, t: Date) strict {
    label de official "Stirbt der Mieter, so ist sowohl der Erbe als auch der Vermieter berechtigt, das Mietverhältnis innerhalb eines Monats, nachdem sie vom Tod des Mieters Kenntnis erlangt haben, außerordentlich mit der gesetzlichen Frist zu kündigen (§ 580)";
    label en unofficial "If the tenant dies, both the heir and the lessor are entitled to terminate extraordinarily with the statutory notice period within one month of learning of the death (§ 580)";
    when tod_des_mieters_am(m, t) and vermieter(m, v);
    then ausserordentliches_kuendigungsrecht_gesetzliche_frist(m, v);
}

// --- § 580a Kündigungsfristen ---------------------------------------------------------------------

pub relation kuendigungstag(k: Kuendigung, tag: Date) kind empirical {
    key(k);
    label de official "Tag, an dem die Kündigung erklärt wird, wenn die Miete nach Tagen bemessen ist (§ 580a Abs. 1 Nr. 1, Abs. 3 Nr. 1)";
    label en unofficial "day on which notice is given where the rent is measured by days (§ 580a (1) no. 1, (3) no. 1)";
}
pub relation wochenbeginn(k: Kuendigung, tag: Date) kind empirical {
    key(k);
    label de official "Beginn der Woche, in der gekündigt wird (§ 580a Abs. 1 Nr. 2) — Angabe des Falls";
    label en unofficial "start of the week in which notice is given (§ 580a (1) no. 2) — a statement of the case";
}

@source(BGB_P580a)
rule Tagesfrist580aAbs1Nr1(k: Kuendigung, m: Mietverhaeltnis, t: Date) strict {
    label de official "Ist die Miete nach Tagen bemessen, so ist die ordentliche Kündigung an jedem Tag zum Ablauf des folgenden Tages zulässig (§ 580a Abs. 1 Nr. 1)";
    label en unofficial "Where the rent is measured by days, ordinary notice is admissible on any day to the end of the following day (§ 580a (1) no. 1)";
    when kuendigung_des(k, m) and gegenstandsart(m, Grundstueck) and bemessung_nach_tagen(m)
     and kuendigungstag(k, t);
    then beendigung_durch_kuendigung_am(k, add_calendar_period(t, 1 calendar_day));
}

pub relation erster_werktag_der_woche(k: Kuendigung, tag: Date) kind institutional {
    key(k);
    label de official "der erste Werktag der Woche, in der gekündigt wird (§ 580a Abs. 1 Nr. 2) — ein gerechneter Term steht nicht im Guard, sondern in einem eigenen Schluss";
    label en unofficial "the first working day of the week in which notice is given (§ 580a (1) no. 2) — a computed term does not stand in a guard but in a conclusion of its own";
}
pub relation dritter_werktag_des_kalendervierteljahrs(k: Kuendigung, tag: Date) kind institutional {
    key(k);
    label de official "der dritte Werktag des Kalendervierteljahrs, in dem gekündigt wird (§ 580a Abs. 2)";
    label en unofficial "the third working day of the calendar quarter in which notice is given (§ 580a (2))";
}

@source(BGB_P580a)
rule ErsterWerktagDerWoche580aAbs1Nr2(k: Kuendigung, w: Date) strict {
    label de official "Der erste Werktag der Woche wird vom Wochenbeginn an mit dem Kalender gezählt (§ 580a Abs. 1 Nr. 2)";
    label en unofficial "The first working day of the week is counted from the start of the week with the calendar (§ 580a (1) no. 2)";
    when wochenbeginn(k, w);
    then erster_werktag_der_woche(k, add_business_days(w, 1 business_day));
}

@source(BGB_P580a)
rule DritterWerktagVierteljahr580aAbs2(k: Kuendigung, q: Date) strict {
    label de official "Der dritte Werktag des Kalendervierteljahrs wird vom Quartalsanfang an mit dem Kalender gezählt (§ 580a Abs. 2)";
    label en unofficial "The third working day of the calendar quarter is counted from the start of the quarter with the calendar (§ 580a (2))";
    when kalendervierteljahr_beginn(k, q);
    then dritter_werktag_des_kalendervierteljahrs(k, add_business_days(q, 3 business_day));
}

@source(BGB_P580a)
rule Wochenfrist580aAbs1Nr2(k: Kuendigung, m: Mietverhaeltnis, w: Date, e: Date, f: Date) strict {
    label de official "Ist die Miete nach Wochen bemessen, so ist die Kündigung spätestens am ersten Werktag einer Woche zum Ablauf des folgenden Sonnabends zulässig (§ 580a Abs. 1 Nr. 2) — der erste Werktag wird mit dem Kalender gezählt, der Sonnabend der folgenden Woche als Wochenbeginn plus zwölf Tage";
    label en unofficial "Where the rent is measured by weeks, notice is admissible at the latest on the first working day of a week to the end of the following Saturday (§ 580a (1) no. 2) — the first working day is counted with the calendar, the Saturday of the following week as the start of the week plus twelve days";
    when kuendigung_des(k, m) and gegenstandsart(m, Grundstueck) and bemessung_nach_wochen(m)
     and wochenbeginn(k, w) and erster_werktag_der_woche(k, f) and kuendigung_erklaert_am(k, e) and e <= f;
    then beendigung_durch_kuendigung_am(k, add_calendar_period(w, 12 calendar_day));
}

@source(BGB_P580a)
rule Monatsfrist580aAbs1Nr3(k: Kuendigung, m: Mietverhaeltnis, b: Date, d: Date, e: Date) strict {
    label de official "Ist die Miete nach Monaten oder längeren Zeitabschnitten bemessen, so ist die Kündigung spätestens am dritten Werktag eines Kalendermonats zum Ablauf des übernächsten Monats zulässig (§ 580a Abs. 1 Nr. 3)";
    label en unofficial "Where the rent is measured by months or longer periods, notice is admissible at the latest on the third working day of a calendar month to the end of the month after next (§ 580a (1) no. 3)";
    when kuendigung_des(k, m) and gegenstandsart(m, Grundstueck) and bemessung_nach_monaten_oder_laenger(m)
     and not gewerblich_genutztes_unbebautes_grundstueck(m)
     and kuendigungsmonat_beginn(k, b) and dritter_werktag_des_kuendigungsmonats(k, d)
     and kuendigung_erklaert_am(k, e) and e <= d;
    then beendigung_durch_kuendigung_am(k, month_end_of(add_calendar_period(b, 2 calendar_month)));
}

@source(BGB_P580a)
rule Geschaeftsraumfrist580aAbs2(k: Kuendigung, m: Mietverhaeltnis, q: Date, e: Date, f: Date) strict {
    label de official "Bei einem Mietverhältnis über Geschäftsräume ist die ordentliche Kündigung spätestens am dritten Werktag eines Kalendervierteljahres zum Ablauf des nächsten Kalendervierteljahrs zulässig (§ 580a Abs. 2)";
    label en unofficial "For a lease of business premises ordinary notice is admissible at the latest on the third working day of a calendar quarter to the end of the next calendar quarter (§ 580a (2))";
    when kuendigung_des(k, m) and gegenstandsart(m, Geschaeftsraum) and kalendervierteljahr_beginn(k, q)
     and dritter_werktag_des_kalendervierteljahrs(k, f) and kuendigung_erklaert_am(k, e) and e <= f;
    then beendigung_durch_kuendigung_am(k, month_end_of(add_calendar_period(q, 5 calendar_month)));
}

@source(BGB_P580a)
rule BeweglicheSachen580aAbs3Nr1(k: Kuendigung, m: Mietverhaeltnis, t: Date) strict {
    label de official "Bei einem Mietverhältnis über bewegliche Sachen oder digitale Produkte ist die ordentliche Kündigung, wenn die Miete nach Tagen bemessen ist, an jedem Tag zum Ablauf des folgenden Tages zulässig (§ 580a Abs. 3 Nr. 1)";
    label en unofficial "For a lease of movables or digital products, where the rent is measured by days, ordinary notice is admissible on any day to the end of the following day (§ 580a (3) no. 1)";
    when kuendigung_des(k, m) and gegenstandsart(m, BeweglicheSache) and bemessung_nach_tagen(m)
     and kuendigungstag(k, t);
    then beendigung_durch_kuendigung_am(k, add_calendar_period(t, 1 calendar_day));
}
