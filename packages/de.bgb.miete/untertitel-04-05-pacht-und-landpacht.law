// --- Untertitel 4 Pachtvertrag (§§ 581–584b) und Untertitel 5 Landpachtvertrag (§§ 585–597)
//
// ZWEI VERWEISUNGSKETTEN. § 581 Abs. 2: auf den Pachtvertrag mit Ausnahme des
// Landpachtvertrags sind die Vorschriften über den Mietvertrag entsprechend
// anzuwenden, soweit sich aus den §§ 582 bis 584b nichts anderes ergibt.
// § 585 Abs. 2: für Landpachtverträge gelten § 581 Abs. 1 und die §§ 582 bis
// 583a sowie die besonderen Vorschriften der §§ 585a bis 597. Beide Ketten
// sind FESTSTELLUNGEN über die Anwendbarkeit; die Regeln stehen einmal bei
// ihrem Paragraphen und lesen `vertragsart`.
//
// DREI KÜNDIGUNGSFRISTEN MIT DEM DRITTEN WERKTAG. § 584 Abs. 1 (Pacht: nur für
// den Schluss eines Pachtjahrs, spätestens am dritten Werktag des HALBEN
// Jahres, mit dessen Ablauf die Pacht enden soll), § 594a Abs. 1 (Landpacht:
// spätestens am dritten Werktag eines Pachtjahrs für den Schluss des NÄCHSTEN
// Pachtjahrs) und § 594a Abs. 2 (außerordentliche Kündigung mit gesetzlicher
// Frist: wie § 584 Abs. 1). Das Pachtjahr ist im Zweifel das Kalenderjahr
// (§ 594a Abs. 1 Satz 2); sein Beginn kommt als Angabe des Falls, weil der
// Vertrag ein anderes Pachtjahr bestimmen kann.
//
// SECHS MONATE, ZWEIMAL. § 591b Abs. 1 wiederholt für die Landpacht, was
// § 548 für die Miete sagt, mit demselben Anknüpfungspunkt: Rückerhalt der
// Sache für den Verpächter, Beendigung des Pachtverhältnisses für den Pächter.

// --- § 581 Vertragstypische Pflichten beim Pachtvertrag -------------------------------------------

pub relation fruchtgenuss_gewaehrt(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "Pflicht des Verpächters, dem Pächter den Gebrauch des verpachteten Gegenstands und den Genuss der Früchte zu gewähren, soweit sie nach den Regeln einer ordnungsmäßigen Wirtschaft als Ertrag anzusehen sind (§ 581 Abs. 1 Satz 1)";
    label en unofficial "the lessor's duty to grant the lessee use of the leased object and the enjoyment of the fruits in so far as they are to be regarded as yield under the rules of proper management (§ 581 (1) sentence 1)";
}
pub relation mietvorschriften_auf_pacht_anwendbar(m: Mietverhaeltnis) kind institutional {
    label de official "auf den Pachtvertrag mit Ausnahme des Landpachtvertrags sind die Vorschriften über den Mietvertrag entsprechend anzuwenden, soweit sich nicht aus den §§ 582 bis 584b etwas anderes ergibt (§ 581 Abs. 2)";
    label en unofficial "the provisions on the lease apply accordingly to the usufructuary lease, except the farm lease, unless §§ 582 to 584b provide otherwise (§ 581 (2))";
}
pub relation landpachtvorschriften_anwendbar(m: Mietverhaeltnis) kind institutional {
    label de official "für Landpachtverträge gelten § 581 Abs. 1 und die §§ 582 bis 583a sowie die besonderen Vorschriften der §§ 585a bis 597 (§ 585 Abs. 2)";
    label en unofficial "for farm leases § 581 (1) and §§ 582 to 583a apply, as well as the special provisions of §§ 585a to 597 (§ 585 (2))";
}

@source(BGB_P581)
rule Pachtpflichten581Abs1(m: Mietverhaeltnis, v: Person) strict {
    label de official "Durch den Pachtvertrag wird der Verpächter verpflichtet, dem Pächter den Gebrauch des verpachteten Gegenstands und den Genuss der Früchte während der Pachtzeit zu gewähren (§ 581 Abs. 1 Satz 1)";
    label en unofficial "Under the usufructuary lease the lessor is obliged to grant the lessee use of the leased object and enjoyment of the fruits during the lease period (§ 581 (1) sentence 1)";
    when vertragsart(m, Pacht) and vermieter(m, v);
    then fruchtgenuss_gewaehrt(m, v);
}

@source(BGB_P581)
rule PachtpflichtenLandpacht581Abs1(m: Mietverhaeltnis, v: Person) strict {
    label de official "Dasselbe gilt für den Landpachtvertrag (§ 585 Abs. 2 in Verbindung mit § 581 Abs. 1 Satz 1)";
    label en unofficial "The same applies to the farm lease (§ 585 (2) in conjunction with § 581 (1) sentence 1)";
    when vertragsart(m, Landpacht) and vermieter(m, v);
    then fruchtgenuss_gewaehrt(m, v);
}

@source(BGB_P581)
rule Verweisung581Abs2(m: Mietverhaeltnis) strict {
    label de official "Auf den Pachtvertrag mit Ausnahme des Landpachtvertrags sind die Vorschriften über den Mietvertrag entsprechend anzuwenden (§ 581 Abs. 2)";
    label en unofficial "The provisions on the lease apply accordingly to the usufructuary lease except the farm lease (§ 581 (2))";
    when vertragsart(m, Pacht);
    then mietvorschriften_auf_pacht_anwendbar(m);
}

@source(BGB_P585)
rule Verweisung585Abs2(m: Mietverhaeltnis) strict {
    label de official "Für Landpachtverträge gelten § 581 Abs. 1 und die §§ 582 bis 583a sowie die nachfolgenden besonderen Vorschriften (§ 585 Abs. 2)";
    label en unofficial "For farm leases § 581 (1) and §§ 582 to 583a apply, as well as the following special provisions (§ 585 (2))";
    when vertragsart(m, Landpacht);
    then landpachtvorschriften_anwendbar(m);
}

// --- §§ 582, 582a, 583, 583a Inventar --------------------------------------------------------------

pub relation inventar_mitverpachtet(m: Mietverhaeltnis) kind empirical {
    label de official "ein Grundstück ist mit Inventar verpachtet (§ 582 Abs. 1)";
    label en unofficial "land is leased together with inventory (§ 582 (1))";
}
pub relation inventar_zum_schaetzwert_uebernommen(m: Mietverhaeltnis) kind empirical {
    label de official "der Pächter übernimmt das Inventar zum Schätzwert mit der Verpflichtung, es bei Beendigung zum Schätzwert zurückzugewähren (§ 582a Abs. 1 Satz 1)";
    label en unofficial "the lessee takes over the inventory at its estimated value with the duty to return it at that value on termination (§ 582a (1) sentence 1)";
}
pub relation inventarstueck_in_abgang_gekommen(m: Mietverhaeltnis) kind empirical {
    label de official "ein Inventarstück ist infolge eines vom Pächter nicht zu vertretenden Umstands in Abgang gekommen (§ 582 Abs. 2 Satz 1)";
    label en unofficial "an item of inventory has been lost as a result of a circumstance for which the lessee is not responsible (§ 582 (2) sentence 1)";
}
pub relation schaetzwert_uebernommen(m: Mietverhaeltnis, betrag: Money) kind empirical {
    key(m);
    label de official "Gesamtschätzwert des übernommenen Inventars (§ 582a Abs. 3 Satz 3 und 4)";
    label en unofficial "total estimated value of the inventory taken over (§ 582a (3) sentences 3 and 4)";
}
pub relation schaetzwert_zurueckgewaehrt(m: Mietverhaeltnis, betrag: Money) kind empirical {
    key(m);
    label de official "Gesamtschätzwert des zurückzugewährenden Inventars, bewertet mit den Preisen im Zeitpunkt der Beendigung (§ 582a Abs. 3 Satz 3 und 4)";
    label en unofficial "total estimated value of the inventory to be returned, valued at prices at the time of termination (§ 582a (3) sentences 3 and 4)";
}
pub relation forderung_wegen_inventars(m: Mietverhaeltnis) kind empirical {
    label de official "Forderung des Pächters gegen den Verpächter, die sich auf das mitgepachtete Inventar bezieht (§ 583 Abs. 1)";
    label en unofficial "the lessee's claim against the lessor relating to the inventory leased with the land (§ 583 (1))";
}

pub relation erhaltung_des_inventars(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "dem Pächter obliegt die Erhaltung der einzelnen Inventarstücke (§ 582 Abs. 1)";
    label en unofficial "the lessee is responsible for maintaining the individual items of inventory (§ 582 (1))";
}
pub relation ersatzpflicht_des_verpaechters(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "der Verpächter ist verpflichtet, Inventarstücke zu ersetzen, die ohne Verschulden des Pächters in Abgang kommen (§ 582 Abs. 2 Satz 1)";
    label en unofficial "the lessor must replace items of inventory lost without the lessee's fault (§ 582 (2) sentence 1)";
}
pub relation gefahrtragung_des_paechters(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "übernimmt der Pächter das Inventar zum Schätzwert, so trägt er die Gefahr des zufälligen Untergangs und der zufälligen Verschlechterung (§ 582a Abs. 1 Satz 1)";
    label en unofficial "where the lessee takes over the inventory at its estimated value, he bears the risk of accidental destruction and deterioration (§ 582a (1) sentence 1)";
}
pub relation geldausgleich_inventar(m: Mietverhaeltnis, betrag: Money) kind institutional {
    key(m);
    label de official "Unterschied zwischen dem Gesamtschätzwert des übernommenen und dem des zurückzugewährenden Inventars, in Geld auszugleichen (§ 582a Abs. 3 Satz 3)";
    label en unofficial "the difference between the total estimated value of the inventory taken over and that of the inventory to be returned, to be settled in money (§ 582a (3) sentence 3)";
}
pub relation paechterpfandrecht(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "dem Pächter eines Grundstücks steht für Forderungen, die sich auf das mitgepachtete Inventar beziehen, ein Pfandrecht an den in seinen Besitz gelangten Inventarstücken zu (§ 583 Abs. 1)";
    label en unofficial "the lessee of land has a lien over the items of inventory in his possession for claims relating to the inventory leased with the land (§ 583 (1))";
}

@source(BGB_P582)
rule Inventarerhaltung582Abs1(m: Mietverhaeltnis, mi: Person) strict {
    label de official "Wird ein Grundstück mit Inventar verpachtet, so obliegt dem Pächter die Erhaltung der einzelnen Inventarstücke (§ 582 Abs. 1)";
    label en unofficial "Where land is leased with inventory, the lessee is responsible for maintaining the individual items (§ 582 (1))";
    when inventar_mitverpachtet(m) and mieter(m, mi);
    then erhaltung_des_inventars(m, mi);
}

@source(BGB_P582)
rule Inventarersatz582Abs2(m: Mietverhaeltnis, v: Person) strict {
    label de official "Der Verpächter ist verpflichtet, Inventarstücke zu ersetzen, die infolge eines vom Pächter nicht zu vertretenden Umstands in Abgang kommen (§ 582 Abs. 2 Satz 1)";
    label en unofficial "The lessor must replace items of inventory lost as a result of a circumstance for which the lessee is not responsible (§ 582 (2) sentence 1)";
    when inventar_mitverpachtet(m) and inventarstueck_in_abgang_gekommen(m) and vermieter(m, v);
    then ersatzpflicht_des_verpaechters(m, v);
}

@source(BGB_P582a)
rule Gefahrtragung582aAbs1(m: Mietverhaeltnis, mi: Person) strict {
    label de official "Übernimmt der Pächter das Inventar zum Schätzwert mit der Verpflichtung, es bei Beendigung des Pachtverhältnisses zum Schätzwert zurückzugewähren, so trägt er die Gefahr des zufälligen Untergangs und der zufälligen Verschlechterung des Inventars (§ 582a Abs. 1 Satz 1)";
    label en unofficial "Where the lessee takes over the inventory at its estimated value with the duty to return it at that value, he bears the risk of accidental destruction and deterioration (§ 582a (1) sentence 1)";
    when inventar_zum_schaetzwert_uebernommen(m) and mieter(m, mi);
    then gefahrtragung_des_paechters(m, mi);
}

@source(BGB_P582a)
rule Geldausgleich582aAbs3(m: Mietverhaeltnis, alt: Money, neu: Money) strict {
    label de official "Besteht zwischen dem Gesamtschätzwert des übernommenen und dem des zurückzugewährenden Inventars ein Unterschied, so ist dieser in Geld auszugleichen; den Schätzwerten sind die Preise im Zeitpunkt der Beendigung zugrunde zu legen (§ 582a Abs. 3 Satz 3 und 4)";
    label en unofficial "Where the total estimated values of the inventory taken over and of that to be returned differ, the difference is to be settled in money, valued at prices at the time of termination (§ 582a (3) sentences 3 and 4)";
    when inventar_zum_schaetzwert_uebernommen(m) and schaetzwert_uebernommen(m, alt)
     and schaetzwert_zurueckgewaehrt(m, neu);
    then geldausgleich_inventar(m, alt - neu);
}

@source(BGB_P583)
rule Paechterpfandrecht583Abs1(m: Mietverhaeltnis, mi: Person) strict {
    label de official "Dem Pächter eines Grundstücks steht für die Forderungen gegen den Verpächter, die sich auf das mitgepachtete Inventar beziehen, ein Pfandrecht an den in seinen Besitz gelangten Inventarstücken zu (§ 583 Abs. 1)";
    label en unofficial "The lessee of land has a lien over the items of inventory in his possession for claims against the lessor relating to the inventory leased with the land (§ 583 (1))";
    when inventar_mitverpachtet(m) and forderung_wegen_inventars(m) and mieter(m, mi);
    then paechterpfandrecht(m, mi);
}

// --- § 584 Kündigungsfrist der Pacht ---------------------------------------------------------------

pub relation pachtjahr_ende(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, mit dessen Ablauf das Pachtjahr endet (§ 584 Abs. 1, § 594a Abs. 1) — im Zweifel das Kalenderjahr (§ 594a Abs. 1 Satz 2), der Vertrag kann ein anderes bestimmen";
    label en unofficial "day at whose end the lease year ends (§ 584 (1), § 594a (1)) — in case of doubt the calendar year (§ 594a (1) sentence 2); the contract may fix another";
}
pub relation halbjahr_beginn(k: Kuendigung, tag: Date) kind empirical {
    key(k);
    label de official "Beginn des halben Jahres, mit dessen Ablauf die Pacht enden soll (§ 584 Abs. 1 Satz 2, § 594a Abs. 2) — Angabe des Falls";
    label en unofficial "start of the half-year at whose end the lease is to end (§ 584 (1) sentence 2, § 594a (2)) — a statement of the case";
}
pub relation pachtjahr_beginn(k: Kuendigung, tag: Date) kind empirical {
    key(k);
    label de official "Beginn des Pachtjahrs, in dem gekündigt wird (§ 594a Abs. 1 Satz 1) — Angabe des Falls; im Zweifel der 1. Januar (Satz 2)";
    label en unofficial "start of the lease year in which notice is given (§ 594a (1) sentence 1) — a statement of the case; in case of doubt 1 January (sentence 2)";
}
pub relation pachtzeit_nicht_bestimmt(m: Mietverhaeltnis) kind empirical {
    label de official "die Pachtzeit ist nicht bestimmt (§ 584 Abs. 1 Satz 1, § 594a Abs. 1 Satz 1) — ausdrückliche Angabe des Falls";
    label en unofficial "the lease period is not fixed (§ 584 (1) sentence 1, § 594a (1) sentence 1) — express statement of the case";
}

pub relation dritter_werktag_des_halben_jahres(k: Kuendigung, tag: Date) kind institutional {
    key(k);
    label de official "der dritte Werktag des halben Jahres, mit dessen Ablauf die Pacht enden soll (§ 584 Abs. 1 Satz 2, § 594a Abs. 2)";
    label en unofficial "the third working day of the half-year at whose end the lease is to end (§ 584 (1) sentence 2, § 594a (2))";
}
pub relation dritter_werktag_des_pachtjahrs(k: Kuendigung, tag: Date) kind institutional {
    key(k);
    label de official "der dritte Werktag des Pachtjahrs, in dem gekündigt wird (§ 594a Abs. 1 Satz 1)";
    label en unofficial "the third working day of the lease year in which notice is given (§ 594a (1) sentence 1)";
}
pub relation pachtkuendigung_fristgerecht(k: Kuendigung) kind institutional {
    label de official "die Kündigung des Pachtverhältnisses ist fristgerecht erklärt (§ 584 Abs. 1, § 594a Abs. 1 und 2)";
    label en unofficial "notice terminating the usufructuary lease was given in time (§ 584 (1), § 594a (1) and (2))";
}

@source(BGB_P584)
rule DritterWerktagHalbjahr584Abs1(k: Kuendigung, h: Date) strict {
    label de official "Der dritte Werktag des halben Jahres wird vom Beginn des halben Jahres an mit dem Kalender gezählt (§ 584 Abs. 1 Satz 2)";
    label en unofficial "The third working day of the half-year is counted from its start with the calendar (§ 584 (1) sentence 2)";
    when halbjahr_beginn(k, h);
    then dritter_werktag_des_halben_jahres(k, add_business_days(h, 3 business_day));
}

@source(BGB_P584)
rule Pachtkuendigung584Abs1(k: Kuendigung, m: Mietverhaeltnis, d: Date, e: Date, p: Date) strict {
    label de official "Ist bei dem Pachtverhältnis über ein Grundstück oder ein Recht die Pachtzeit nicht bestimmt, so ist die Kündigung nur für den Schluss eines Pachtjahrs zulässig; sie hat spätestens am dritten Werktag des halben Jahres zu erfolgen, mit dessen Ablauf die Pacht enden soll (§ 584 Abs. 1)";
    label en unofficial "Where the period of a usufructuary lease of land or of a right is not fixed, notice is admissible only for the end of a lease year; it must be given at the latest on the third working day of the half-year at whose end the lease is to end (§ 584 (1))";
    when kuendigung_des(k, m) and vertragsart(m, Pacht) and pachtzeit_nicht_bestimmt(m)
     and dritter_werktag_des_halben_jahres(k, d) and kuendigung_erklaert_am(k, e) and e <= d
     and pachtjahr_ende(m, p);
    then beendigung_durch_kuendigung_am(k, p);
}

@source(BGB_P584)
rule Pachtkuendigung584Fristgerecht(k: Kuendigung, d: Date, e: Date) strict {
    label de official "Die Kündigung ist fristgerecht, wenn sie dem anderen Teil bis zum Ablauf des dritten Werktags des halben Jahres zugeht (§ 584 Abs. 1 Satz 2)";
    label en unofficial "The notice is in time if it reaches the other party by the end of the third working day of the half-year (§ 584 (1) sentence 2)";
    when dritter_werktag_des_halben_jahres(k, d) and kuendigung_erklaert_am(k, e) and e <= d;
    then pachtkuendigung_fristgerecht(k);
}

@source(BGB_P584a)
rule KeinKuendigungsrecht584aAbs1(m: Mietverhaeltnis) strict {
    label de official "Dem Pächter steht das in § 540 Abs. 1 bestimmte Kündigungsrecht nicht zu (§ 584a Abs. 1)";
    label en unofficial "The lessee does not have the right of termination provided for in § 540 (1) (§ 584a (1))";
    when vertragsart(m, Pacht) and erlaubnis_verweigert(m);
    then kuendigungsrecht_540_ausgeschlossen(m);
}

pub relation kuendigungsrecht_540_ausgeschlossen(m: Mietverhaeltnis) kind institutional {
    label de official "dem Pächter steht das Kündigungsrecht des § 540 Abs. 1 nicht zu (§ 584a Abs. 1); der Verpächter kann nicht nach § 580 kündigen (Abs. 2)";
    label en unofficial "the lessee does not have the right of termination of § 540 (1) (§ 584a (1)); the lessor may not terminate under § 580 (subsection (2))";
}

@source(BGB_P584b)
rule VerspaeteteRueckgabe584b(m: Mietverhaeltnis, pacht: Money) strict {
    label de official "Gibt der Pächter den gepachteten Gegenstand nach der Beendigung des Pachtverhältnisses nicht zurück, so kann der Verpächter für die Dauer der Vorenthaltung als Entschädigung die vereinbarte Pacht nach dem Verhältnis der gezogenen Nutzungen verlangen (§ 584b Satz 1)";
    label en unofficial "Where the lessee does not return the leased object after termination, the lessor may demand the agreed rent as compensation for the duration of the withholding, in proportion to the benefits taken (§ 584b sentence 1)";
    when vertragsart(m, Pacht) and sache_nicht_zurueckgegeben(m) and miete_monatlich(m, pacht);
    then entschaedigung_bei_vorenthaltung(m, pacht);
}

// --- §§ 585a–586a Landpacht: Form, Beschreibung, Pflichten ----------------------------------------

pub relation landpacht_laenger_als_zwei_jahre(m: Mietverhaeltnis) kind empirical {
    label de official "der Landpachtvertrag ist für längere Zeit als zwei Jahre geschlossen (§ 585a)";
    label en unofficial "the farm lease was concluded for a period longer than two years (§ 585a)";
}
pub relation textform_gewahrt(m: Mietverhaeltnis) kind empirical {
    label de official "der Vertrag ist in Textform geschlossen (§ 585a, § 578 Abs. 1 Satz 2)";
    label en unofficial "the contract was concluded in text form (§ 585a, § 578 (1) sentence 2)";
}
pub relation beschreibung_angefertigt(m: Mietverhaeltnis) kind empirical {
    label de official "eine Beschreibung der Pachtsache im Sinne des § 585b Abs. 1 ist angefertigt (§ 585b Abs. 3)";
    label en unofficial "a description of the leased property within the meaning of § 585b (1) has been drawn up (§ 585b (3))";
}
pub relation beschreibung_verweigert(m: Mietverhaeltnis) kind empirical {
    label de official "ein Vertragsteil weigert sich, bei der Anfertigung einer Beschreibung mitzuwirken, oder es ergeben sich Meinungsverschiedenheiten tatsächlicher Art (§ 585b Abs. 2 Satz 1)";
    label en unofficial "a party refuses to cooperate in drawing up a description, or differences of fact arise (§ 585b (2) sentence 1)";
}
pub relation sachverstaendigenantrag_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, an dem ein Vertragsteil die Anfertigung der Beschreibung durch einen Sachverständigen verlangt (§ 585b Abs. 2 Satz 1)";
    label en unofficial "day on which a party demands that the description be drawn up by an expert (§ 585b (2) sentence 1)";
}

pub relation beschreibung_wird_als_richtig_vermutet(m: Mietverhaeltnis) kind institutional {
    label de official "ist eine Beschreibung angefertigt, so wird im Verhältnis der Vertragsteile zueinander vermutet, dass sie richtig ist (§ 585b Abs. 3)";
    label en unofficial "where a description has been drawn up, it is presumed as between the parties to be correct (§ 585b (3))";
}
pub relation sachverstaendigenfrist_ueberlassung_ende(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag, mit dessen Ablauf neun Monate seit der Überlassung der Pachtsache verstrichen sind; danach kann die Beschreibung durch einen Sachverständigen nicht mehr verlangt werden (§ 585b Abs. 2 Satz 1)";
    label en unofficial "day at whose end nine months since handover of the leased property have elapsed; thereafter a description by an expert may no longer be demanded (§ 585b (2) sentence 1)";
}
pub relation sachverstaendigenfrist_beendigung_ende(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag, mit dessen Ablauf drei Monate seit der Beendigung des Pachtverhältnisses verstrichen sind (§ 585b Abs. 2 Satz 1)";
    label en unofficial "day at whose end three months since termination of the lease have elapsed (§ 585b (2) sentence 1)";
}
pub relation instandhaltungspflicht_des_paechters(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "der Pächter hat die gewöhnlichen Ausbesserungen der Pachtsache auf seine Kosten durchzuführen und ist zur ordnungsmäßigen Bewirtschaftung verpflichtet (§ 586 Abs. 1 Satz 2 und 3)";
    label en unofficial "the lessee must carry out ordinary repairs at his own expense and is obliged to manage the property properly (§ 586 (1) sentences 2 and 3)";
}

@source(BGB_P585a)
rule Form585a(m: Mietverhaeltnis) strict {
    label de official "Wird der Landpachtvertrag für längere Zeit als zwei Jahre nicht in Textform geschlossen, so gilt er für unbestimmte Zeit (§ 585a)";
    label en unofficial "Where a farm lease for longer than two years is not concluded in text form, it is deemed to run for an indefinite period (§ 585a)";
    when vertragsart(m, Landpacht) and landpacht_laenger_als_zwei_jahre(m) and not textform_gewahrt(m);
    then gilt_fuer_unbestimmte_zeit(m);
}

@source(BGB_P585b)
rule BeschreibungVermutung585bAbs3(m: Mietverhaeltnis) strict {
    label de official "Ist eine Beschreibung der genannten Art angefertigt, so wird im Verhältnis der Vertragsteile zueinander vermutet, dass sie richtig ist (§ 585b Abs. 3)";
    label en unofficial "Where a description of the stated kind has been drawn up, it is presumed as between the parties to be correct (§ 585b (3))";
    when vertragsart(m, Landpacht) and beschreibung_angefertigt(m);
    then beschreibung_wird_als_richtig_vermutet(m);
}

@source(BGB_P585b)
rule Sachverstaendigenfrist585bAbs2Ueberlassung(m: Mietverhaeltnis, u: Date) strict {
    label de official "Die Beschreibung durch einen Sachverständigen kann nicht mehr verlangt werden, wenn seit der Überlassung der Pachtsache mehr als neun Monate verstrichen sind (§ 585b Abs. 2 Satz 1)";
    label en unofficial "A description by an expert may no longer be demanded where more than nine months have elapsed since handover of the leased property (§ 585b (2) sentence 1)";
    when vertragsart(m, Landpacht) and ueberlassung_am(m, u);
    then sachverstaendigenfrist_ueberlassung_ende(m, add_calendar_period(u, 9 calendar_month));
}

@source(BGB_P585b)
rule Sachverstaendigenfrist585bAbs2Beendigung(m: Mietverhaeltnis, e: Date) strict {
    label de official "Dasselbe gilt, wenn seit der Beendigung des Pachtverhältnisses mehr als drei Monate verstrichen sind (§ 585b Abs. 2 Satz 1)";
    label en unofficial "The same applies where more than three months have elapsed since termination of the lease (§ 585b (2) sentence 1)";
    when vertragsart(m, Landpacht) and beendigung_am(m, e);
    then sachverstaendigenfrist_beendigung_ende(m, add_calendar_period(e, 3 calendar_month));
}

@source(BGB_P586)
rule Landpachtpflichten586Abs1(m: Mietverhaeltnis, mi: Person) strict {
    label de official "Der Pächter hat die gewöhnlichen Ausbesserungen der Pachtsache auf seine Kosten durchzuführen und ist zur ordnungsmäßigen Bewirtschaftung der Pachtsache verpflichtet (§ 586 Abs. 1 Satz 2 und 3)";
    label en unofficial "The lessee must carry out ordinary repairs at his own expense and is obliged to manage the leased property properly (§ 586 (1) sentences 2 and 3)";
    when vertragsart(m, Landpacht) and mieter(m, mi);
    then instandhaltungspflicht_des_paechters(m, mi);
}

@source(BGB_P586a)
rule LastenLandpacht586a(m: Mietverhaeltnis, v: Person) strict {
    label de official "Der Verpächter hat die auf der Pachtsache ruhenden Lasten zu tragen (§ 586a)";
    label en unofficial "The lessor must bear the charges on the leased property (§ 586a)";
    when vertragsart(m, Landpacht) and vermieter(m, v);
    then pflicht_lasten_zu_tragen(m, v);
}

// --- §§ 588–591b Landpacht: Duldung, Nutzung, Verwendungen, Verjährung ----------------------------

pub relation massnahme_zur_erhaltung(m: Mietverhaeltnis) kind empirical {
    label de official "Einwirkung auf die Pachtsache, die zu ihrer Erhaltung erforderlich ist (§ 588 Abs. 1)";
    label en unofficial "interference with the leased property necessary for its preservation (§ 588 (1))";
}
pub relation massnahme_zur_verbesserung(m: Mietverhaeltnis) kind empirical {
    label de official "Maßnahme zur Verbesserung der Pachtsache (§ 588 Abs. 2 Satz 1)";
    label en unofficial "measure for the improvement of the leased property (§ 588 (2) sentence 1)";
}
pub relation nutzung_einem_dritten_ueberlassen_landpacht(m: Mietverhaeltnis) kind empirical {
    label de official "der Pächter überlässt die Nutzung der Pachtsache einem Dritten (§ 589 Abs. 1 Nr. 1, Abs. 2)";
    label en unofficial "the lessee lets a third party use the leased property (§ 589 (1) no. 1, (2))";
}
pub relation landwirtschaftliche_bestimmung_geaendert(m: Mietverhaeltnis) kind empirical {
    label de official "der Pächter ändert die landwirtschaftliche Bestimmung der Pachtsache (§ 590 Abs. 1)";
    label en unofficial "the lessee changes the agricultural designation of the leased property (§ 590 (1))";
}
pub relation vorherige_erlaubnis_erteilt(m: Mietverhaeltnis) kind empirical {
    label de official "der Verpächter hat die vorherige Erlaubnis erteilt (§ 590 Abs. 1 und 2)";
    label en unofficial "the lessor gave prior permission (§ 590 (1) and (2))";
}
pub relation notwendige_verwendung(m: Mietverhaeltnis, betrag: Money) kind empirical {
    key(m);
    label de official "notwendige Verwendungen des Pächters auf die Pachtsache (§ 590b)";
    label en unofficial "necessary expenditure by the lessee on the leased property (§ 590b)";
}
pub relation mehrwert_der_verwendung(m: Mietverhaeltnis, betrag: Money) kind empirical {
    key(m);
    label de official "Betrag, um den andere als notwendige Verwendungen den Wert der Pachtsache über die Pachtzeit hinaus erhöhen (Mehrwert, § 591 Abs. 1)";
    label en unofficial "amount by which expenditure other than necessary expenditure increases the value of the leased property beyond the lease period (added value, § 591 (1))";
}
pub relation verpaechter_hat_zugestimmt(m: Mietverhaeltnis) kind empirical {
    label de official "der Verpächter hat den Verwendungen zugestimmt (§ 591 Abs. 1)";
    label en unofficial "the lessor consented to the expenditure (§ 591 (1))";
}
pub relation berufsunfaehig_geworden(m: Mietverhaeltnis) kind empirical {
    label de official "der Pächter ist berufsunfähig im Sinne der Vorschriften der gesetzlichen Rentenversicherung geworden (§ 594c Satz 1)";
    label en unofficial "the lessee has become incapable of pursuing his occupation within the meaning of the statutory pension insurance provisions (§ 594c sentence 1)";
}
pub relation verpaechter_widerspricht_ueberlassung(m: Mietverhaeltnis) kind empirical {
    label de official "der Verpächter widerspricht der Überlassung der Pachtsache zur Nutzung an einen Dritten, der eine ordnungsmäßige Bewirtschaftung gewährleistet (§ 594c Satz 1)";
    label en unofficial "the lessor objects to the leased property being let for use to a third party who guarantees proper management (§ 594c sentence 1)";
}
pub relation verzug_mit_der_pacht_seit(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, seit dem der Pächter mit der Entrichtung der Pacht oder eines nicht unerheblichen Teils in Verzug ist (§ 594e Abs. 2 Satz 1)";
    label en unofficial "day since which the lessee has been in default with the rent or a not insignificant part of it (§ 594e (2) sentence 1)";
}
pub relation pacht_nach_zeitabschnitten_unter_einem_jahr(m: Mietverhaeltnis) kind empirical {
    label de official "die Pacht ist nach Zeitabschnitten von weniger als einem Jahr bemessen (§ 594e Abs. 2 Satz 2)";
    label en unofficial "the rent is measured by periods of less than one year (§ 594e (2) sentence 2)";
}
pub relation betriebsuebergabe_vorweggenommene_erbfolge(m: Mietverhaeltnis) kind empirical {
    label de official "bei der Übergabe eines Betriebs im Wege der vorweggenommenen Erbfolge wird ein zugepachtetes Grundstück mit übergeben (§ 593a Satz 1)";
    label en unofficial "on the transfer of a farm by way of anticipated succession a leased plot is transferred with it (§ 593a sentence 1)";
}
pub relation ordnungsmaessige_bewirtschaftung_nicht_gewaehrleistet(m: Mietverhaeltnis) kind empirical {
    label de official "die ordnungsmäßige Bewirtschaftung der Pachtsache durch den Übernehmer ist nicht gewährleistet (§ 593a Satz 3)";
    label en unofficial "proper management of the leased property by the transferee is not guaranteed (§ 593a sentence 3)";
}

@source(BGB_P588)
pub external judgment relation verbesserung_bedeutet_haerte(m: Mietverhaeltnis) {
    authority Court;
    label de official "§ 588 Abs. 2 Satz 1. Die Maßnahme zur Verbesserung würde für den Pächter eine Härte bedeuten, die auch unter Würdigung der berechtigten Interessen des Verpächters nicht zu rechtfertigen ist";
    label en unofficial "§ 588 (2) sentence 1. The improvement measure would constitute hardship for the lessee that cannot be justified even weighing the lessor's legitimate interests";
}

@source(BGB_P595)
pub external judgment relation beendigung_der_landpacht_bedeutet_haerte(m: Mietverhaeltnis) {
    authority Court;
    label de official "§ 595 Abs. 1 Satz 1. Die vertragsmäßige Beendigung des Pachtverhältnisses würde für den Pächter oder seine Familie eine Härte bedeuten, die auch unter Würdigung der berechtigten Interessen des Verpächters nicht zu rechtfertigen ist";
    label en unofficial "§ 595 (1) sentence 1. Contractual termination of the lease would constitute hardship for the lessee or his family that cannot be justified even weighing the lessor's legitimate interests";
}

pub relation duldungspflicht_erhaltung_landpacht(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "der Pächter hat Einwirkungen auf die Pachtsache zu dulden, die zu ihrer Erhaltung erforderlich sind (§ 588 Abs. 1)";
    label en unofficial "the lessee must tolerate interference with the leased property necessary for its preservation (§ 588 (1))";
}
pub relation duldungspflicht_verbesserung(m: Mietverhaeltnis) kind institutional {
    label de official "Maßnahmen zur Verbesserung der Pachtsache hat der Pächter zu dulden, es sei denn, die Maßnahme würde für ihn eine nicht zu rechtfertigende Härte bedeuten (§ 588 Abs. 2 Satz 1)";
    label en unofficial "the lessee must tolerate measures for the improvement of the leased property unless they would constitute unjustifiable hardship for him (§ 588 (2) sentence 1)";
}
pub relation nutzungsueberlassung_ohne_erlaubnis_unzulaessig(m: Mietverhaeltnis) kind institutional {
    label de official "der Pächter ist ohne Erlaubnis des Verpächters nicht berechtigt, die Nutzung der Pachtsache einem Dritten zu überlassen (§ 589 Abs. 1 Nr. 1)";
    label en unofficial "without the lessor's permission the lessee is not entitled to let a third party use the leased property (§ 589 (1) no. 1)";
}
pub relation aenderung_der_bestimmung_unzulaessig(m: Mietverhaeltnis) kind institutional {
    label de official "der Pächter darf die landwirtschaftliche Bestimmung der Pachtsache nur mit vorheriger Erlaubnis des Verpächters ändern (§ 590 Abs. 1)";
    label en unofficial "the lessee may change the agricultural designation of the leased property only with the lessor's prior permission (§ 590 (1))";
}
pub relation ersatz_notwendiger_verwendungen(m: Mietverhaeltnis, betrag: Money) kind institutional {
    key(m);
    label de official "der Verpächter ist verpflichtet, dem Pächter die notwendigen Verwendungen auf die Pachtsache zu ersetzen (§ 590b)";
    label en unofficial "the lessor must reimburse the lessee for necessary expenditure on the leased property (§ 590b)";
}
pub relation ersatz_des_mehrwerts(m: Mietverhaeltnis, betrag: Money) kind institutional {
    key(m);
    label de official "andere als notwendige Verwendungen, denen der Verpächter zugestimmt hat, hat er bei Beendigung des Pachtverhältnisses zu ersetzen, soweit sie den Wert der Pachtsache über die Pachtzeit hinaus erhöhen (§ 591 Abs. 1)";
    label en unofficial "expenditure other than necessary expenditure to which the lessor consented must be reimbursed on termination in so far as it increases the value of the property beyond the lease period (§ 591 (1))";
}
pub relation verjaehrung_591b_verpaechter_ende(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag, mit dessen Ablauf die sechsmonatige Verjährung der Ersatzansprüche des Verpächters endet; sie beginnt mit dem Rückerhalt der Sache (§ 591b Abs. 1, Abs. 2 Satz 1)";
    label en unofficial "day at whose end the six-month limitation of the lessor's claims expires; it begins when he receives the property back (§ 591b (1), (2) sentence 1)";
}
pub relation verjaehrung_591b_paechter_ende(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag, mit dessen Ablauf die sechsmonatige Verjährung der Ansprüche des Pächters endet; sie beginnt mit der Beendigung des Pachtverhältnisses (§ 591b Abs. 1, Abs. 2 Satz 2)";
    label en unofficial "day at whose end the six-month limitation of the lessee's claims expires; it begins on termination of the lease (§ 591b (1), (2) sentence 2)";
}

@source(BGB_P588)
rule Duldung588Abs1(m: Mietverhaeltnis, mi: Person) strict {
    label de official "Der Pächter hat Einwirkungen auf die Pachtsache zu dulden, die zu ihrer Erhaltung erforderlich sind (§ 588 Abs. 1)";
    label en unofficial "The lessee must tolerate interference with the leased property necessary for its preservation (§ 588 (1))";
    when vertragsart(m, Landpacht) and massnahme_zur_erhaltung(m) and mieter(m, mi);
    then duldungspflicht_erhaltung_landpacht(m, mi);
}

@source(BGB_P588)
rule Duldung588Abs2(m: Mietverhaeltnis) defeasible {
    label de official "Maßnahmen zur Verbesserung der Pachtsache hat der Pächter zu dulden, es sei denn, dass die Maßnahme für ihn eine Härte bedeuten würde, die auch unter Würdigung der berechtigten Interessen des Verpächters nicht zu rechtfertigen ist (§ 588 Abs. 2 Satz 1)";
    label en unofficial "The lessee must tolerate measures for the improvement of the leased property unless they would constitute hardship for him that cannot be justified even weighing the lessor's legitimate interests (§ 588 (2) sentence 1)";
    when vertragsart(m, Landpacht) and massnahme_zur_verbesserung(m);
    unless verbesserung_bedeutet_haerte(m);
    then duldungspflicht_verbesserung(m);
}

@source(BGB_P589)
rule Nutzungsueberlassung589Abs1(m: Mietverhaeltnis) defeasible {
    label de official "Der Pächter ist ohne Erlaubnis des Verpächters nicht berechtigt, die Nutzung der Pachtsache einem Dritten zu überlassen, insbesondere die Sache weiter zu verpachten (§ 589 Abs. 1 Nr. 1)";
    label en unofficial "Without the lessor's permission the lessee is not entitled to let a third party use the leased property, in particular to sub-lease it (§ 589 (1) no. 1)";
    when vertragsart(m, Landpacht);
    unless erlaubnis_zur_gebrauchsueberlassung_erteilt(m);
    then nutzungsueberlassung_ohne_erlaubnis_unzulaessig(m);
}

@source(BGB_P590)
rule Bestimmungsaenderung590Abs1(m: Mietverhaeltnis) defeasible {
    label de official "Der Pächter darf die landwirtschaftliche Bestimmung der Pachtsache nur mit vorheriger Erlaubnis des Verpächters ändern (§ 590 Abs. 1)";
    label en unofficial "The lessee may change the agricultural designation of the leased property only with the lessor's prior permission (§ 590 (1))";
    when vertragsart(m, Landpacht) and landwirtschaftliche_bestimmung_geaendert(m);
    unless vorherige_erlaubnis_erteilt(m);
    then aenderung_der_bestimmung_unzulaessig(m);
}

@source(BGB_P590a)
rule VertragswidrigerGebrauch590a(m: Mietverhaeltnis, v: Person) strict {
    label de official "Macht der Pächter von der Pachtsache einen vertragswidrigen Gebrauch und setzt er den Gebrauch ungeachtet einer Abmahnung fort, so kann der Verpächter auf Unterlassung klagen (§ 590a)";
    label en unofficial "Where the lessee uses the leased property contrary to the contract and continues despite a warning, the lessor may sue for an injunction (§ 590a)";
    when vertragsart(m, Landpacht) and vertragswidriger_gebrauch_fortgesetzt(m) and vermieter(m, v);
    then unterlassungsklage_zulaessig(m, v);
}

@source(BGB_P590b)
rule NotwendigeVerwendungen590b(m: Mietverhaeltnis, betrag: Money) strict {
    label de official "Der Verpächter ist verpflichtet, dem Pächter die notwendigen Verwendungen auf die Pachtsache zu ersetzen (§ 590b)";
    label en unofficial "The lessor must reimburse the lessee for necessary expenditure on the leased property (§ 590b)";
    when vertragsart(m, Landpacht) and notwendige_verwendung(m, betrag);
    then ersatz_notwendiger_verwendungen(m, betrag);
}

@source(BGB_P591)
rule Mehrwert591Abs1(m: Mietverhaeltnis, betrag: Money, e: Date) strict {
    label de official "Andere als notwendige Verwendungen, denen der Verpächter zugestimmt hat, hat er dem Pächter bei Beendigung des Pachtverhältnisses zu ersetzen, soweit die Verwendungen den Wert der Pachtsache über die Pachtzeit hinaus erhöhen (§ 591 Abs. 1)";
    label en unofficial "Expenditure other than necessary expenditure to which the lessor consented must be reimbursed on termination in so far as it increases the value of the property beyond the lease period (§ 591 (1))";
    when vertragsart(m, Landpacht) and verpaechter_hat_zugestimmt(m) and mehrwert_der_verwendung(m, betrag)
     and beendigung_am(m, e);
    then ersatz_des_mehrwerts(m, betrag);
}

@source(BGB_P591a)
rule Wegnahmerecht591a(m: Mietverhaeltnis, mi: Person) strict {
    label de official "Der Pächter ist berechtigt, eine Einrichtung, mit der er die Sache versehen hat, wegzunehmen (§ 591a Satz 1)";
    label en unofficial "The lessee is entitled to remove a fixture with which he has provided the property (§ 591a sentence 1)";
    when vertragsart(m, Landpacht) and einrichtung_des_mieters(m) and mieter(m, mi);
    then wegnahmerecht(m, mi);
}

@source(BGB_P591b)
rule Verjaehrung591bVerpaechter(m: Mietverhaeltnis, r: Date) strict {
    label de official "Die Ersatzansprüche des Verpächters wegen Veränderung oder Verschlechterung der verpachteten Sache verjähren in sechs Monaten; die Verjährung beginnt mit dem Zeitpunkt, in welchem er die Sache zurückerhält (§ 591b Abs. 1, Abs. 2 Satz 1)";
    label en unofficial "The lessor's claims for compensation for change or deterioration of the leased property are time-barred after six months; limitation begins when he receives the property back (§ 591b (1), (2) sentence 1)";
    when vertragsart(m, Landpacht) and ersatzanspruch_des_vermieters(m) and rueckgabe_am(m, r);
    then verjaehrung_591b_verpaechter_ende(m, add_calendar_period(r, 6 calendar_month));
}

@source(BGB_P591b)
rule Verjaehrung591bPaechter(m: Mietverhaeltnis, e: Date) strict {
    label de official "Die Ansprüche des Pächters auf Ersatz von Verwendungen oder auf Gestattung der Wegnahme einer Einrichtung verjähren in sechs Monaten; die Verjährung beginnt mit der Beendigung des Pachtverhältnisses (§ 591b Abs. 1, Abs. 2 Satz 2)";
    label en unofficial "The lessee's claims for reimbursement of expenditure or for permission to remove a fixture are time-barred after six months; limitation begins on termination of the lease (§ 591b (1), (2) sentence 2)";
    when vertragsart(m, Landpacht) and ersatzanspruch_des_mieters(m) and beendigung_am(m, e);
    then verjaehrung_591b_paechter_ende(m, add_calendar_period(e, 6 calendar_month));
}

// --- §§ 593a–597 Landpacht: Übergabe, Ende, Kündigung, Rückgabe -----------------------------------

pub relation uebernehmer_tritt_ein(m: Mietverhaeltnis) kind institutional {
    label de official "wird bei der Übergabe eines Betriebs im Wege der vorweggenommenen Erbfolge ein zugepachtetes Grundstück mit übergeben, so tritt der Übernehmer anstelle des Pächters in den Pachtvertrag ein (§ 593a Satz 1)";
    label en unofficial "where on the transfer of a farm by way of anticipated succession a leased plot is transferred with it, the transferee takes the lessee's place in the lease (§ 593a sentence 1)";
}
pub relation pachtverhaeltnis_endet_mit_zeitablauf(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "das Pachtverhältnis endet mit dem Ablauf der Zeit, für die es eingegangen ist (§ 594 Satz 1)";
    label en unofficial "the lease ends at the expiry of the period for which it was entered into (§ 594 sentence 1)";
}
pub relation fortsetzungsanspruch_595(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "der Pächter kann vom Verpächter die Fortsetzung des Pachtverhältnisses verlangen (§ 595 Abs. 1)";
    label en unofficial "the lessee may demand continuation of the lease from the lessor (§ 595 (1))";
}
pub relation fortsetzungsanspruch_595_besteht(m: Mietverhaeltnis) kind institutional {
    label de official "die Voraussetzungen des Fortsetzungsverlangens der Landpacht liegen vor; er ist ausgeschlossen, wenn der Pächter selbst gekündigt hat (§ 595 Abs. 3 Nr. 1)";
    label en unofficial "the conditions for the farm-lease continuation claim are met; it is excluded where the lessee himself gave notice (§ 595 (3) no. 1)";
}
pub relation rueckgabepflicht_landpacht(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "der Pächter ist verpflichtet, die Pachtsache nach Beendigung des Pachtverhältnisses in dem Zustand zurückzugeben, der einer bis zur Rückgabe fortgesetzten ordnungsmäßigen Bewirtschaftung entspricht (§ 596 Abs. 1)";
    label en unofficial "the lessee must return the leased property after termination in the condition corresponding to proper management continued up to the return (§ 596 (1))";
}

@source(BGB_P593a)
rule Betriebsuebergabe593a(m: Mietverhaeltnis) strict {
    label de official "Wird bei der Übergabe eines Betriebs im Wege der vorweggenommenen Erbfolge ein zugepachtetes Grundstück, das der Landwirtschaft dient, mit übergeben, so tritt der Übernehmer anstelle des Pächters in den Pachtvertrag ein (§ 593a Satz 1)";
    label en unofficial "Where on the transfer of a farm by way of anticipated succession a leased plot serving agriculture is transferred with it, the transferee takes the lessee's place in the lease (§ 593a sentence 1)";
    when vertragsart(m, Landpacht) and betriebsuebergabe_vorweggenommene_erbfolge(m);
    then uebernehmer_tritt_ein(m);
}

@source(BGB_P593a)
rule Kuendigungsrecht593aSatz3(m: Mietverhaeltnis, v: Person) strict {
    label de official "Ist die ordnungsmäßige Bewirtschaftung der Pachtsache durch den Übernehmer nicht gewährleistet, so ist der Verpächter berechtigt, das Pachtverhältnis außerordentlich mit der gesetzlichen Frist zu kündigen (§ 593a Satz 3)";
    label en unofficial "Where proper management by the transferee is not guaranteed, the lessor may terminate the lease extraordinarily with the statutory notice period (§ 593a sentence 3)";
    when uebernehmer_tritt_ein(m) and ordnungsmaessige_bewirtschaftung_nicht_gewaehrleistet(m) and vermieter(m, v);
    then ausserordentliches_kuendigungsrecht_gesetzliche_frist(m, v);
}

@source(BGB_P594)
rule Zeitablauf594Satz1(m: Mietverhaeltnis, e: Date) strict {
    label de official "Das Pachtverhältnis endet mit dem Ablauf der Zeit, für die es eingegangen ist (§ 594 Satz 1)";
    label en unofficial "The lease ends at the expiry of the period for which it was entered into (§ 594 sentence 1)";
    when vertragsart(m, Landpacht) and mietzeit_bestimmt(m) and mietzeit_ende(m, e);
    then pachtverhaeltnis_endet_mit_zeitablauf(m, e);
}

@source(BGB_P594a)
rule DritterWerktagPachtjahr594aAbs1(k: Kuendigung, p: Date) strict {
    label de official "Der dritte Werktag des Pachtjahrs wird vom Beginn des Pachtjahrs an mit dem Kalender gezählt (§ 594a Abs. 1 Satz 1)";
    label en unofficial "The third working day of the lease year is counted from its start with the calendar (§ 594a (1) sentence 1)";
    when pachtjahr_beginn(k, p);
    then dritter_werktag_des_pachtjahrs(k, add_business_days(p, 3 business_day));
}

@source(BGB_P594a)
rule Landpachtkuendigung594aAbs1(k: Kuendigung, m: Mietverhaeltnis, d: Date, e: Date, p: Date) strict {
    label de official "Ist die Pachtzeit nicht bestimmt, so kann jeder Vertragsteil das Pachtverhältnis spätestens am dritten Werktag eines Pachtjahrs für den Schluss des nächsten Pachtjahrs kündigen; im Zweifel gilt das Kalenderjahr als Pachtjahr (§ 594a Abs. 1 Satz 1 und 2)";
    label en unofficial "Where the lease period is not fixed, either party may terminate at the latest on the third working day of a lease year for the end of the next lease year; in case of doubt the calendar year counts as the lease year (§ 594a (1) sentences 1 and 2)";
    when kuendigung_des(k, m) and vertragsart(m, Landpacht) and pachtzeit_nicht_bestimmt(m)
     and dritter_werktag_des_pachtjahrs(k, d) and kuendigung_erklaert_am(k, e) and e <= d
     and pachtjahr_beginn(k, p);
    then beendigung_durch_kuendigung_am(k, month_end_of(add_calendar_period(p, 23 calendar_month)));
}

@source(BGB_P594a)
rule Landpachtkuendigung594aFristgerecht(k: Kuendigung, d: Date, e: Date) strict {
    label de official "Die Kündigung ist fristgerecht, wenn sie dem anderen Teil bis zum Ablauf des dritten Werktags des Pachtjahrs zugeht (§ 594a Abs. 1 Satz 1)";
    label en unofficial "The notice is in time if it reaches the other party by the end of the third working day of the lease year (§ 594a (1) sentence 1)";
    when dritter_werktag_des_pachtjahrs(k, d) and kuendigung_erklaert_am(k, e) and e <= d;
    then pachtkuendigung_fristgerecht(k);
}

@source(BGB_P594b)
rule Dreissigjahre594b(m: Mietverhaeltnis, u: Date) strict {
    label de official "Wird ein Pachtvertrag für eine längere Zeit als 30 Jahre geschlossen, so kann nach 30 Jahren jeder Vertragsteil das Pachtverhältnis spätestens am dritten Werktag eines Pachtjahrs für den Schluss des nächsten Pachtjahrs kündigen (§ 594b Satz 1)";
    label en unofficial "Where a lease is concluded for longer than 30 years, after 30 years either party may terminate at the latest on the third working day of a lease year for the end of the next lease year (§ 594b sentence 1)";
    when vertragsart(m, Landpacht) and vertrag_laenger_als_dreissig_jahre(m) and ueberlassung_am(m, u);
    then dreissigjahresfrist_ende(m, add_calendar_period(u, 30 calendar_year));
}

@source(BGB_P594c)
rule Berufsunfaehigkeit594c(m: Mietverhaeltnis, mi: Person) strict {
    label de official "Ist der Pächter berufsunfähig im Sinne der Vorschriften der gesetzlichen Rentenversicherung geworden, so kann er das Pachtverhältnis außerordentlich mit der gesetzlichen Frist kündigen, wenn der Verpächter der Überlassung der Pachtsache an einen Dritten widerspricht (§ 594c Satz 1)";
    label en unofficial "Where the lessee has become incapable of pursuing his occupation, he may terminate extraordinarily with the statutory notice period if the lessor objects to letting a third party use the leased property (§ 594c sentence 1)";
    when vertragsart(m, Landpacht) and berufsunfaehig_geworden(m)
     and verpaechter_widerspricht_ueberlassung(m) and mieter(m, mi);
    then ausserordentliches_kuendigungsrecht_gesetzliche_frist(m, mi);
}

@source(BGB_P594e)
rule WichtigerGrund594eAbs2Satz1(m: Mietverhaeltnis, k: Kuendigung, s: Date, g: Date, e: Date) strict {
    label de official "Abweichend von § 543 Abs. 2 Nr. 3 liegt ein wichtiger Grund insbesondere vor, wenn der Pächter mit der Entrichtung der Pacht oder eines nicht unerheblichen Teils länger als drei Monate in Verzug ist (§ 594e Abs. 2 Satz 1)";
    label en unofficial "In derogation from § 543 (2) no. 3 there is a compelling reason in particular where the lessee has been in default with the rent or a not insignificant part of it for more than three months (§ 594e (2) sentence 1)";
    when vertragsart(m, Landpacht) and verzug_mit_der_pacht_seit(m, s)
     and not pacht_nach_zeitabschnitten_unter_einem_jahr(m)
     and verzugsgrenze_594e(m, g) and kuendigung_des(k, m) and kuendigung_erklaert_am(k, e) and e > g;
    then wichtiger_grund(m);
}

pub relation verzugsgrenze_594e(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag, mit dessen Ablauf drei Monate seit dem Beginn des Verzugs verstrichen sind (§ 594e Abs. 2 Satz 1)";
    label en unofficial "day at whose end three months since the beginning of the default have elapsed (§ 594e (2) sentence 1)";
}

@source(BGB_P594e)
rule Verzugsgrenze594eAbs2(m: Mietverhaeltnis, s: Date) strict {
    label de official "Die drei Monate des § 594e Abs. 2 Satz 1 werden vom Beginn des Verzugs an gerechnet (§ 188 Abs. 2)";
    label en unofficial "The three months of § 594e (2) sentence 1 are counted from the beginning of the default (§ 188 (2))";
    when vertragsart(m, Landpacht) and verzug_mit_der_pacht_seit(m, s);
    then verzugsgrenze_594e(m, add_calendar_period(s, 3 calendar_month));
}

@source(BGB_P594e)
rule WichtigerGrund594eAbs2Satz2(m: Mietverhaeltnis) strict {
    label de official "Ist die Pacht nach Zeitabschnitten von weniger als einem Jahr bemessen, so ist die Kündigung erst zulässig, wenn der Pächter für zwei aufeinander folgende Termine in Verzug ist (§ 594e Abs. 2 Satz 2)";
    label en unofficial "Where the rent is measured by periods of less than one year, notice is admissible only where the lessee is in default for two consecutive dates (§ 594e (2) sentence 2)";
    when vertragsart(m, Landpacht) and pacht_nach_zeitabschnitten_unter_einem_jahr(m)
     and verzug_zwei_aufeinander_folgende_termine(m);
    then wichtiger_grund(m);
}

@source(BGB_P594f)
rule Schriftform594f(k: Kuendigung) strict {
    label de official "Die Kündigung bedarf der schriftlichen Form (§ 594f)";
    label en unofficial "The notice requires written form (§ 594f)";
    when kuendigung_schriftlich(k);
    then kuendigung_formwirksam(k);
}

@source(BGB_P595)
rule Fortsetzung595Abs1(m: Mietverhaeltnis) defeasible {
    label de official "Der Pächter kann vom Verpächter die Fortsetzung des Pachtverhältnisses verlangen, wenn der Betrieb seine wirtschaftliche Lebensgrundlage bildet und die vertragsmäßige Beendigung für ihn oder seine Familie eine nicht zu rechtfertigende Härte bedeuten würde; das gilt nicht, wenn er selbst gekündigt hat (§ 595 Abs. 1, Abs. 3 Nr. 1)";
    label en unofficial "The lessee may demand continuation where the farm forms his economic livelihood and contractual termination would constitute unjustifiable hardship for him or his family; this does not apply where he himself gave notice (§ 595 (1), (3) no. 1)";
    when vertragsart(m, Landpacht) and beendigung_der_landpacht_bedeutet_haerte(m);
    unless mieter_hat_gekuendigt(m);
    then fortsetzungsanspruch_595_besteht(m);
}

@source(BGB_P595)
rule Fortsetzung595Traeger(m: Mietverhaeltnis, mi: Person) defeasible {
    label de official "Den Fortsetzungsanspruch hat der Pächter (§ 595 Abs. 1 Satz 1)";
    label en unofficial "The claim to continuation vests in the lessee (§ 595 (1) sentence 1)";
    when fortsetzungsanspruch_595_besteht(m) and mieter(m, mi);
    then fortsetzungsanspruch_595(m, mi);
}

@source(BGB_P596)
rule Rueckgabe596Abs1(m: Mietverhaeltnis, mi: Person, e: Date) strict {
    label de official "Der Pächter ist verpflichtet, die Pachtsache nach Beendigung des Pachtverhältnisses in dem Zustand zurückzugeben, der einer bis zur Rückgabe fortgesetzten ordnungsmäßigen Bewirtschaftung entspricht (§ 596 Abs. 1)";
    label en unofficial "The lessee must return the leased property after termination in the condition corresponding to proper management continued up to the return (§ 596 (1))";
    when vertragsart(m, Landpacht) and mieter(m, mi) and beendigung_am(m, e);
    then rueckgabepflicht_landpacht(m, mi);
}

@source(BGB_P596)
rule KeinZurueckbehaltungsrecht596Abs2(m: Mietverhaeltnis) strict {
    label de official "Dem Pächter steht wegen seiner Ansprüche gegen den Verpächter ein Zurückbehaltungsrecht am Grundstück nicht zu (§ 596 Abs. 2)";
    label en unofficial "The lessee has no right of retention over the land for his claims against the lessor (§ 596 (2))";
    when vertragsart(m, Landpacht);
    then kein_zurueckbehaltungsrecht(m);
}

@source(BGB_P597)
rule VerspaeteteRueckgabe597(m: Mietverhaeltnis, pacht: Money) strict {
    label de official "Gibt der Pächter die Pachtsache nach Beendigung des Pachtverhältnisses nicht zurück, so kann der Verpächter für die Dauer der Vorenthaltung als Entschädigung die vereinbarte Pacht verlangen; die Geltendmachung eines weiteren Schadens ist nicht ausgeschlossen (§ 597)";
    label en unofficial "Where the lessee does not return the leased property after termination, the lessor may demand the agreed rent as compensation for the duration of the withholding; the assertion of further damage is not excluded (§ 597)";
    when vertragsart(m, Landpacht) and sache_nicht_zurueckgegeben(m) and miete_monatlich(m, pacht);
    then entschaedigung_bei_vorenthaltung(m, pacht);
}

// --- §§ 583a, 587, 592, 593, 593b, 594d, 595a, 596a, 596b -----------------------------------------

pub relation verfuegungsbeschraenkung_vereinbart(m: Mietverhaeltnis) kind empirical {
    label de official "Vertragsbestimmung, die den Pächter eines Betriebs verpflichtet, nicht oder nicht ohne Einwilligung des Verpächters über Inventarstücke zu verfügen oder Inventar an den Verpächter zu veräußern (§ 583a)";
    label en unofficial "contractual term obliging the lessee of a business not to dispose of items of inventory, or not without the lessor's consent, or to sell inventory to the lessor (§ 583a)";
}
pub relation verpaechter_verpflichtet_sich_zum_erwerb(m: Mietverhaeltnis) kind empirical {
    label de official "der Verpächter verpflichtet sich, das Inventar bei der Beendigung des Pachtverhältnisses zum Schätzwert zu erwerben (§ 583a)";
    label en unofficial "the lessor undertakes to acquire the inventory at its estimated value on termination of the lease (§ 583a)";
}
pub relation pacht_nach_zeitabschnitten_bemessen(m: Mietverhaeltnis) kind empirical {
    label de official "die Pacht ist nach Zeitabschnitten bemessen (§ 587 Abs. 1 Satz 2)";
    label en unofficial "the rent is measured by periods (§ 587 (1) sentence 2)";
}
pub relation zeitabschnitt_ende(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, mit dessen Ablauf der Zeitabschnitt endet, nach dem die Pacht bemessen ist (§ 587 Abs. 1 Satz 2)";
    label en unofficial "day at whose end the period by which the rent is measured expires (§ 587 (1) sentence 2)";
}
pub relation fruechte_der_pachtsache(m: Mietverhaeltnis) kind empirical {
    label de official "Früchte der Pachtsache, auf die sich das Pfandrecht des Verpächters erstreckt (§ 592 Satz 1)";
    label en unofficial "fruits of the leased property to which the lessor's lien extends (§ 592 sentence 1)";
}
pub relation grobes_missverhaeltnis_eingetreten(m: Mietverhaeltnis) kind empirical {
    label de official "die Verhältnisse, die für die Festsetzung der Vertragsleistungen maßgebend waren, haben sich nachhaltig so geändert, dass die gegenseitigen Verpflichtungen in ein grobes Missverhältnis geraten sind (§ 593 Abs. 1 Satz 1)";
    label en unofficial "the circumstances decisive for fixing the contractual performances have changed so persistently that the mutual obligations have become grossly disproportionate (§ 593 (1) sentence 1)";
}
pub relation aenderung_verlangt_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, an dem die Änderung des Vertrags verlangt wird (§ 593 Abs. 2 Satz 1, Abs. 3)";
    label en unofficial "day on which the change of the contract is demanded (§ 593 (2) sentence 1, (3))";
}
pub relation letzte_aenderung_der_vertragsleistungen_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag des Beginns des Pachtverhältnisses oder des Wirksamwerdens der letzten Änderung der Vertragsleistungen (§ 593 Abs. 2 Satz 1)";
    label en unofficial "day of the beginning of the lease or of the taking effect of the last change of the contractual performances (§ 593 (2) sentence 1)";
}
pub relation verwuestendes_naturereignis(m: Mietverhaeltnis) kind empirical {
    label de official "verwüstende Naturereignisse, gegen die ein Versicherungsschutz nicht üblich ist, haben das Verhältnis der Vertragsleistungen grundlegend und nachhaltig verändert (§ 593 Abs. 2 Satz 2)";
    label en unofficial "devastating natural events against which insurance is not customary have fundamentally and persistently altered the relation of the contractual performances (§ 593 (2) sentence 2)";
}
pub relation grundstueck_veraeussert_oder_belastet(m: Mietverhaeltnis) kind empirical {
    label de official "das verpachtete Grundstück wird veräußert oder mit dem Recht eines Dritten belastet (§ 593b)";
    label en unofficial "the leased land is sold or encumbered with a third party's right (§ 593b)";
}
pub relation tod_des_paechters_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag des Todes des Pächters (§ 594d Abs. 1) — festgestellte Tatsache";
    label en unofficial "day of the lessee's death (§ 594d (1)) — established fact";
}
pub relation kalendervierteljahr_ende(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, mit dessen Ablauf das Kalendervierteljahr endet, zu dem gekündigt wird (§ 594d Abs. 1) — Angabe des Falls";
    label en unofficial "day at whose end the calendar quarter to which notice is given expires (§ 594d (1)) — a statement of the case";
}
pub relation pachtjahr_endet_im_laufe(m: Mietverhaeltnis) kind empirical {
    label de official "das Pachtverhältnis endet im Laufe eines Pachtjahrs (§ 596a Abs. 1 Satz 1)";
    label en unofficial "the lease ends in the course of a lease year (§ 596a (1) sentence 1)";
}
pub relation wert_der_nicht_getrennten_fruechte(m: Mietverhaeltnis, betrag: Money) kind empirical {
    key(m);
    label de official "Wert der noch nicht getrennten, jedoch nach den Regeln einer ordnungsmäßigen Bewirtschaftung vor dem Ende des Pachtjahrs zu trennenden Früchte (§ 596a Abs. 1 Satz 1)";
    label en unofficial "value of the fruits not yet separated but to be separated before the end of the lease year under the rules of proper management (§ 596a (1) sentence 1)";
}
pub relation mehrmenge_zurueckgelassener_erzeugnisse(m: Mietverhaeltnis, betrag: Money) kind empirical {
    key(m);
    label de official "Wert der Erzeugnisse, die der Pächter in größerer Menge oder besserer Beschaffenheit zurückzulassen verpflichtet ist, als er bei Beginn übernommen hat (§ 596b Abs. 2)";
    label en unofficial "value of the produce the lessee must leave behind in greater quantity or better quality than he took over at the start (§ 596b (2))";
}

pub relation verfuegungsbeschraenkung_wirksam(m: Mietverhaeltnis) kind institutional {
    label de official "Vertragsbestimmungen über Verfügungsbeschränkungen sind nur wirksam, wenn sich der Verpächter verpflichtet, das Inventar bei der Beendigung zum Schätzwert zu erwerben (§ 583a)";
    label en unofficial "contractual terms restricting disposal are effective only where the lessor undertakes to acquire the inventory at its estimated value on termination (§ 583a)";
}
pub relation pacht_faellig_am(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag der Fälligkeit der Pacht: der erste Werktag nach dem Ablauf des einzelnen Zeitabschnitts (§ 587 Abs. 1 Satz 2)";
    label en unofficial "day on which the rent falls due: the first working day after the end of the individual period (§ 587 (1) sentence 2)";
}
pub relation verpaechterpfandrecht_besteht(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "der Verpächter hat für seine Forderungen aus dem Pachtverhältnis ein Pfandrecht an den eingebrachten Sachen des Pächters sowie an den Früchten der Pachtsache (§ 592 Satz 1)";
    label en unofficial "the lessor has a lien over the lessee's belongings brought onto the property and over the fruits of the leased property for his claims under the lease (§ 592 sentence 1)";
}
pub relation aenderungsanspruch_593(m: Mietverhaeltnis) kind institutional {
    label de official "jeder Vertragsteil kann eine Änderung des Vertrags mit Ausnahme der Pachtdauer verlangen (§ 593 Abs. 1 Satz 1)";
    label en unofficial "either party may demand a change of the contract other than of the lease duration (§ 593 (1) sentence 1)";
}
pub relation zweijahressperre_593_ende(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag, mit dessen Ablauf zwei Jahre seit dem Beginn des Pachtverhältnisses oder seit dem Wirksamwerden der letzten Änderung verstrichen sind (§ 593 Abs. 2 Satz 1)";
    label en unofficial "day at whose end two years since the beginning of the lease or since the last change took effect have elapsed (§ 593 (2) sentence 1)";
}
pub relation erwerber_tritt_in_landpacht_ein(m: Mietverhaeltnis) kind institutional {
    label de official "wird das verpachtete Grundstück veräußert oder belastet, so gelten die §§ 566 bis 567b entsprechend (§ 593b)";
    label en unofficial "where the leased land is sold or encumbered, §§ 566 to 567b apply accordingly (§ 593b)";
}
pub relation kuendigungsrecht_594d(m: Mietverhaeltnis, p: Person) kind institutional {
    label de official "stirbt der Pächter, so sind seine Erben und der Verpächter innerhalb eines Monats nach Kenntnis vom Tod berechtigt, das Pachtverhältnis mit einer Frist von sechs Monaten zum Ende eines Kalendervierteljahrs zu kündigen (§ 594d Abs. 1)";
    label en unofficial "if the lessee dies, his heirs and the lessor may, within one month of learning of the death, terminate the lease on six months' notice to the end of a calendar quarter (§ 594d (1))";
}
pub relation kuendigungsrecht_nach_verlaengerung_595a(m: Mietverhaeltnis) kind institutional {
    label de official "soweit die Vertragsteile zur außerordentlichen Kündigung mit der gesetzlichen Frist berechtigt sind, steht ihnen dieses Recht auch nach Verlängerung des Landpachtverhältnisses oder Änderung des Vertrags zu (§ 595a Abs. 1)";
    label en unofficial "in so far as the parties are entitled to extraordinary termination with the statutory period, that right also exists after extension of the farm lease or a change of the contract (§ 595a (1))";
}
pub relation ersatz_der_fruechte_596a(m: Mietverhaeltnis, betrag: Money) kind institutional {
    key(m);
    label de official "endet das Pachtverhältnis im Laufe eines Pachtjahrs, so hat der Verpächter dem Pächter den Wert der noch nicht getrennten Früchte zu ersetzen (§ 596a Abs. 1 Satz 1)";
    label en unofficial "where the lease ends in the course of a lease year, the lessor must reimburse the lessee the value of the fruits not yet separated (§ 596a (1) sentence 1)";
}
pub relation ruecklassungspflicht(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "der Pächter eines Betriebs hat von den bei Beendigung vorhandenen landwirtschaftlichen Erzeugnissen so viel zurückzulassen, wie zur Fortführung der Wirtschaft bis zur nächsten Ernte nötig ist (§ 596b Abs. 1)";
    label en unofficial "the lessee of a farm must leave behind as much of the agricultural produce present at termination as is necessary to continue the business until the next harvest (§ 596b (1))";
}
pub relation wertersatz_fuer_mehrmenge(m: Mietverhaeltnis, betrag: Money) kind institutional {
    key(m);
    label de official "soweit der Pächter Erzeugnisse in größerer Menge oder besserer Beschaffenheit zurückzulassen verpflichtet ist, als er übernommen hat, kann er vom Verpächter Ersatz des Wertes verlangen (§ 596b Abs. 2)";
    label en unofficial "in so far as the lessee must leave behind produce in greater quantity or better quality than he took over, he may demand reimbursement of the value from the lessor (§ 596b (2))";
}

@source(BGB_P583a)
rule Verfuegungsbeschraenkung583a(m: Mietverhaeltnis) strict {
    label de official "Vertragsbestimmungen, die den Pächter eines Betriebs verpflichten, nicht oder nicht ohne Einwilligung des Verpächters über Inventarstücke zu verfügen oder Inventar an den Verpächter zu veräußern, sind nur wirksam, wenn sich der Verpächter verpflichtet, das Inventar bei der Beendigung des Pachtverhältnisses zum Schätzwert zu erwerben (§ 583a)";
    label en unofficial "Contractual terms obliging the lessee of a business not to dispose of inventory, or not without consent, or to sell inventory to the lessor, are effective only where the lessor undertakes to acquire the inventory at its estimated value on termination (§ 583a)";
    when verfuegungsbeschraenkung_vereinbart(m) and verpaechter_verpflichtet_sich_zum_erwerb(m);
    then verfuegungsbeschraenkung_wirksam(m);
}

@source(BGB_P587)
rule Faelligkeit587Abs1Satz2(m: Mietverhaeltnis, e: Date) strict {
    label de official "Ist die Pacht nach Zeitabschnitten bemessen, so ist sie am ersten Werktag nach dem Ablauf der einzelnen Zeitabschnitte zu entrichten (§ 587 Abs. 1 Satz 2)";
    label en unofficial "Where the rent is measured by periods, it is payable on the first working day after the end of each period (§ 587 (1) sentence 2)";
    when vertragsart(m, Landpacht) and pacht_nach_zeitabschnitten_bemessen(m) and zeitabschnitt_ende(m, e);
    then pacht_faellig_am(m, add_business_days(add_calendar_period(e, 1 calendar_day), 1 business_day));
}

@source(BGB_P587)
rule KeineBefreiung587Abs2(m: Mietverhaeltnis) strict {
    label de official "Der Pächter wird von der Entrichtung der Pacht nicht dadurch befreit, dass er durch einen in seiner Person liegenden Grund an der Ausübung des Nutzungsrechts verhindert ist (§ 587 Abs. 2 Satz 1)";
    label en unofficial "The lessee is not released from payment of rent by being prevented from exercising his right of use by a reason lying in his own person (§ 587 (2) sentence 1)";
    when vertragsart(m, Landpacht) and in_der_person_liegender_hinderungsgrund(m);
    then miete_bleibt_geschuldet(m);
}

@source(BGB_P592)
rule Verpaechterpfandrecht592(m: Mietverhaeltnis, v: Person) strict {
    label de official "Der Verpächter hat für seine Forderungen aus dem Pachtverhältnis ein Pfandrecht an den eingebrachten Sachen des Pächters sowie an den Früchten der Pachtsache; für künftige Entschädigungsforderungen kann das Pfandrecht nicht geltend gemacht werden (§ 592 Satz 1 und 2)";
    label en unofficial "The lessor has a lien over the lessee's belongings brought onto the property and over its fruits for his claims under the lease; it may not be asserted for future claims for compensation (§ 592 sentences 1 and 2)";
    when vertragsart(m, Landpacht) and fruechte_der_pachtsache(m) and vermieter(m, v);
    then verpaechterpfandrecht_besteht(m, v);
}

@source(BGB_P593)
rule Zweijahressperre593Abs2(m: Mietverhaeltnis, a: Date) strict {
    label de official "Eine Änderung kann frühestens zwei Jahre nach Beginn des Pachtverhältnisses oder nach dem Wirksamwerden der letzten Änderung der Vertragsleistungen verlangt werden (§ 593 Abs. 2 Satz 1)";
    label en unofficial "A change may be demanded at the earliest two years after the beginning of the lease or after the last change of the contractual performances took effect (§ 593 (2) sentence 1)";
    when vertragsart(m, Landpacht) and letzte_aenderung_der_vertragsleistungen_am(m, a);
    then zweijahressperre_593_ende(m, add_calendar_period(a, 2 calendar_year));
}

@source(BGB_P593)
rule Aenderungsanspruch593Abs1(m: Mietverhaeltnis, s: Date, v: Date) strict {
    label de official "Haben sich die Verhältnisse nachhaltig so geändert, dass die gegenseitigen Verpflichtungen in ein grobes Missverhältnis zueinander geraten sind, so kann jeder Vertragsteil eine Änderung des Vertrags mit Ausnahme der Pachtdauer verlangen; das Verlangen ist frühestens nach Ablauf der zwei Jahre zulässig (§ 593 Abs. 1 Satz 1, Abs. 2 Satz 1)";
    label en unofficial "Where circumstances have changed so persistently that the mutual obligations have become grossly disproportionate, either party may demand a change of the contract other than of its duration; the demand is admissible at the earliest after the two years have elapsed (§ 593 (1) sentence 1, (2) sentence 1)";
    when vertragsart(m, Landpacht) and grobes_missverhaeltnis_eingetreten(m)
     and zweijahressperre_593_ende(m, s) and aenderung_verlangt_am(m, v) and v > s;
    then aenderungsanspruch_593(m);
}

@source(BGB_P593)
rule Aenderungsanspruch593Abs2Satz2(m: Mietverhaeltnis) strict {
    label de official "Die Zweijahressperre gilt nicht, wenn verwüstende Naturereignisse, gegen die ein Versicherungsschutz nicht üblich ist, das Verhältnis der Vertragsleistungen grundlegend und nachhaltig verändert haben (§ 593 Abs. 2 Satz 2)";
    label en unofficial "The two-year bar does not apply where devastating natural events against which insurance is not customary have fundamentally and persistently altered the relation of the contractual performances (§ 593 (2) sentence 2)";
    when vertragsart(m, Landpacht) and grobes_missverhaeltnis_eingetreten(m) and verwuestendes_naturereignis(m);
    then aenderungsanspruch_593(m);
}

@source(BGB_P593b)
rule Veraeusserung593b(m: Mietverhaeltnis) strict {
    label de official "Wird das verpachtete Grundstück veräußert oder mit dem Recht eines Dritten belastet, so gelten die §§ 566 bis 567b entsprechend (§ 593b)";
    label en unofficial "Where the leased land is sold or encumbered with a third party's right, §§ 566 to 567b apply accordingly (§ 593b)";
    when vertragsart(m, Landpacht) and grundstueck_veraeussert_oder_belastet(m);
    then erwerber_tritt_in_landpacht_ein(m);
}

@source(BGB_P594d)
rule Kuendigungsrecht594dAbs1(m: Mietverhaeltnis, v: Person, t: Date) strict {
    label de official "Stirbt der Pächter, so sind sowohl seine Erben als auch der Verpächter innerhalb eines Monats, nachdem sie vom Tod Kenntnis erlangt haben, berechtigt, das Pachtverhältnis mit einer Frist von sechs Monaten zum Ende eines Kalendervierteljahrs zu kündigen (§ 594d Abs. 1)";
    label en unofficial "If the lessee dies, both his heirs and the lessor may, within one month of learning of the death, terminate the lease on six months' notice to the end of a calendar quarter (§ 594d (1))";
    when vertragsart(m, Landpacht) and tod_des_paechters_am(m, t) and vermieter(m, v);
    then kuendigungsrecht_594d(m, v);
}

@source(BGB_P594d)
rule Beendigung594dAbs1(m: Mietverhaeltnis, k: Kuendigung, q: Date, e: Date) strict {
    label de official "Die Kündigung nach § 594d Abs. 1 wirkt zum Ende des Kalendervierteljahrs, das mindestens sechs Monate nach der Erklärung endet (§ 594d Abs. 1)";
    label en unofficial "Notice under § 594d (1) takes effect at the end of the calendar quarter ending at least six months after the declaration (§ 594d (1))";
    when kuendigung_des(k, m) and vertragsart(m, Landpacht) and kalendervierteljahr_ende(m, q)
     and kuendigung_erklaert_am(k, e) and sechsmonatsgrenze_594d(m, e, q);
    then beendigung_durch_kuendigung_am(k, q);
}

pub relation sechsmonatsgrenze_594d(m: Mietverhaeltnis, erklaerung: Date, quartalsende: Date) kind institutional {
    label de official "das angegebene Quartalsende liegt mindestens sechs Monate nach der Erklärung der Kündigung (§ 594d Abs. 1)";
    label en unofficial "the stated end of quarter lies at least six months after the declaration of notice (§ 594d (1))";
}

@source(BGB_P594d)
rule Sechsmonatsgrenze594d(m: Mietverhaeltnis, k: Kuendigung, e: Date, q: Date, f: Date) strict {
    label de official "Die Sechsmonatsfrist wird vorwärts von der Erklärung an gerechnet (§ 594d Abs. 1, § 188 Abs. 2)";
    label en unofficial "The six-month period is computed forwards from the declaration (§ 594d (1), § 188 (2))";
    when kuendigung_des(k, m) and kuendigung_erklaert_am(k, e) and kalendervierteljahr_ende(m, q)
     and erklaerung_plus_sechs_monate(k, f) and f <= q;
    then sechsmonatsgrenze_594d(m, e, q);
}

pub relation erklaerung_plus_sechs_monate(k: Kuendigung, tag: Date) kind institutional {
    key(k);
    label de official "Tag, der sechs Monate nach der Erklärung der Kündigung liegt (§ 594d Abs. 1)";
    label en unofficial "day six months after the declaration of notice (§ 594d (1))";
}

@source(BGB_P594d)
rule ErklaerungPlusSechsMonate594d(k: Kuendigung, e: Date) strict {
    label de official "Der Tag sechs Monate nach der Erklärung wird mit dem Monatsschritt des § 188 Abs. 2 gebildet (§ 594d Abs. 1)";
    label en unofficial "The day six months after the declaration is formed with the monthly step of § 188 (2) (§ 594d (1))";
    when kuendigung_erklaert_am(k, e);
    then erklaerung_plus_sechs_monate(k, add_calendar_period(e, 6 calendar_month));
}

@source(BGB_P595a)
rule Kuendigungsrecht595aAbs1(m: Mietverhaeltnis) defeasible {
    label de official "Soweit die Vertragsteile zur außerordentlichen Kündigung eines Landpachtverhältnisses mit der gesetzlichen Frist berechtigt sind, steht ihnen dieses Recht auch nach Verlängerung des Landpachtverhältnisses oder Änderung des Landpachtvertrags zu (§ 595a Abs. 1)";
    label en unofficial "In so far as the parties are entitled to extraordinary termination of a farm lease with the statutory period, that right also exists after extension of the lease or a change of the contract (§ 595a (1))";
    when vertragsart(m, Landpacht) and mietverhaeltnis_auf_unbestimmte_zeit_verlaengert(m);
    then kuendigungsrecht_nach_verlaengerung_595a(m);
}

@source(BGB_P596a)
rule Fruechte596aAbs1(m: Mietverhaeltnis, betrag: Money) strict {
    label de official "Endet das Pachtverhältnis im Laufe eines Pachtjahrs, so hat der Verpächter dem Pächter den Wert der noch nicht getrennten, jedoch vor dem Ende des Pachtjahrs zu trennenden Früchte zu ersetzen (§ 596a Abs. 1 Satz 1)";
    label en unofficial "Where the lease ends in the course of a lease year, the lessor must reimburse the lessee the value of the fruits not yet separated but to be separated before the end of the lease year (§ 596a (1) sentence 1)";
    when vertragsart(m, Landpacht) and pachtjahr_endet_im_laufe(m) and wert_der_nicht_getrennten_fruechte(m, betrag);
    then ersatz_der_fruechte_596a(m, betrag);
}

@source(BGB_P596b)
rule Ruecklassung596bAbs1(m: Mietverhaeltnis, mi: Person, e: Date) strict {
    label de official "Der Pächter eines Betriebs hat von den bei Beendigung des Pachtverhältnisses vorhandenen landwirtschaftlichen Erzeugnissen so viel zurückzulassen, wie zur Fortführung der Wirtschaft bis zur nächsten Ernte nötig ist (§ 596b Abs. 1)";
    label en unofficial "The lessee of a farm must leave behind as much of the agricultural produce present at termination as is necessary to continue the business until the next harvest (§ 596b (1))";
    when vertragsart(m, Landpacht) and mieter(m, mi) and beendigung_am(m, e);
    then ruecklassungspflicht(m, mi);
}

@source(BGB_P596b)
rule Wertersatz596bAbs2(m: Mietverhaeltnis, betrag: Money) strict {
    label de official "Soweit der Pächter Erzeugnisse in größerer Menge oder besserer Beschaffenheit zurückzulassen verpflichtet ist, als er bei Beginn des Pachtverhältnisses übernommen hat, kann er vom Verpächter Ersatz des Wertes verlangen (§ 596b Abs. 2)";
    label en unofficial "In so far as the lessee must leave behind produce in greater quantity or better quality than he took over at the start, he may demand reimbursement of the value from the lessor (§ 596b (2))";
    when vertragsart(m, Landpacht) and mehrmenge_zurueckgelassener_erzeugnisse(m, betrag);
    then wertersatz_fuer_mehrmenge(m, betrag);
}
