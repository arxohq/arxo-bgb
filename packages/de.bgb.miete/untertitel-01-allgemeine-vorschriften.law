// --- Untertitel 1 Allgemeine Vorschriften für Mietverhältnisse (§§ 535–548a)
//
// DREI KETTEN. (1) Die Hauptpflichten des § 535 tragen alles Weitere: die
// Gebrauchsgewährung, die Erhaltung und die Lastentragung auf der einen, die
// Entrichtung der Miete auf der anderen Seite. (2) Der Mangel (§ 536) mindert
// die Miete, begründet Schadensersatz (§ 536a) und wird durch Kenntnis
// (§ 536b) gesperrt; § 536d nimmt dem Vermieter die Berufung auf einen
// Ausschluss, wenn er den Mangel arglistig verschwiegen hat. (3) Die
// Beendigung läuft über Zeitablauf (§ 542 Abs. 2), außerordentliche fristlose
// Kündigung (§ 543) und die stillschweigende Verlängerung (§ 545).
//
// MINDERUNG IST EINE WERTUNG MIT EINER RECHNUNG. § 536 Abs. 1 Satz 2 sagt
// „eine angemessen herabgesetzte Miete“ und nennt weder Quote noch Formel. Der
// Text delegiert also die Quote an das Gericht (Kanal §47.3), und das Paket
// rechnet mit ihr GENAU EINMAL je Verhältnis: die Quote kommt als Verhältnis
// zweier ganzer Zahlen (Zähler, Nenner) herein, der Betrag entsteht durch
// `div_round(Miete × (Nenner − Zähler), Nenner × 1.0, 2, "HALF_UP")`
// (Ledger D-06-04). Satz 1 (Aufhebung der Tauglichkeit) ist der Sonderfall
// der vollen Befreiung und wird nicht gerechnet, sondern festgestellt.
//
// DIE ZWEI WOCHEN DES § 545. Sie sind eine Wochenfrist des § 188 Abs. 2, nicht
// eine Tagesfrist: der Text sagt „innerhalb von zwei Wochen“ und benennt in
// Satz 2 für jede Partei ein eigenes Ereignis. Weil INNERHALB der Frist eine
// Erklärung abzugeben ist, greift § 193: das kalendarische Ende wird auf den
// nächsten Werktag verlegt (Ledger D-06-05).

// --- § 535 Inhalt und Hauptpflichten des Mietvertrags ---------------------------------------------

pub relation pflicht_gebrauch_zu_gewaehren(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "Pflicht des Vermieters, dem Mieter den Gebrauch der Mietsache während der Mietzeit zu gewähren (§ 535 Abs. 1 Satz 1)";
    label en unofficial "lessor's duty to grant the tenant use of the leased property during the lease period (§ 535 (1) sentence 1)";
}
pub relation pflicht_zustand_zu_erhalten(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "Pflicht des Vermieters, die Mietsache in einem zum vertragsgemäßen Gebrauch geeigneten Zustand zu überlassen und in diesem Zustand zu erhalten (§ 535 Abs. 1 Satz 2)";
    label en unofficial "lessor's duty to hand over the property in a condition suitable for use in conformity with the contract and to maintain it in that condition (§ 535 (1) sentence 2)";
}
pub relation pflicht_lasten_zu_tragen(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "Pflicht des Vermieters, die auf der Mietsache ruhenden Lasten zu tragen (§ 535 Abs. 1 Satz 3, § 586a)";
    label en unofficial "lessor's duty to bear the charges on the leased property (§ 535 (1) sentence 3, § 586a)";
}
pub relation pflicht_miete_zu_entrichten(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "Pflicht des Mieters, dem Vermieter die vereinbarte Miete zu entrichten (§ 535 Abs. 2, § 581 Abs. 1 Satz 2)";
    label en unofficial "tenant's duty to pay the lessor the agreed rent (§ 535 (2), § 581 (1) sentence 2)";
}

@source(BGB_P535)
rule Hauptpflichten535Abs1(m: Mietverhaeltnis, v: Person) strict {
    label de official "Durch den Mietvertrag wird der Vermieter verpflichtet, dem Mieter den Gebrauch der Mietsache während der Mietzeit zu gewähren, sie in einem zum vertragsgemäßen Gebrauch geeigneten Zustand zu überlassen und zu erhalten und die auf ihr ruhenden Lasten zu tragen (§ 535 Abs. 1)";
    label en unofficial "Under the lease the lessor is obliged to grant the tenant use of the property during the lease period, to hand it over and maintain it in a condition suitable for use in conformity with the contract and to bear the charges on it (§ 535 (1))";
    when vermieter(m, v);
    then pflicht_gebrauch_zu_gewaehren(m, v);
}

@source(BGB_P535)
rule Erhaltungspflicht535Abs1Satz2(m: Mietverhaeltnis, v: Person) strict {
    label de official "Der Vermieter hat die Mietsache dem Mieter in einem zum vertragsgemäßen Gebrauch geeigneten Zustand zu überlassen und sie während der Mietzeit in diesem Zustand zu erhalten (§ 535 Abs. 1 Satz 2)";
    label en unofficial "The lessor must hand over the property in a condition suitable for use in conformity with the contract and maintain it in that condition during the lease period (§ 535 (1) sentence 2)";
    when vermieter(m, v);
    then pflicht_zustand_zu_erhalten(m, v);
}

@source(BGB_P535)
rule Lastentragung535Abs1Satz3(m: Mietverhaeltnis, v: Person) strict {
    label de official "Der Vermieter hat die auf der Mietsache ruhenden Lasten zu tragen (§ 535 Abs. 1 Satz 3)";
    label en unofficial "The lessor must bear the charges on the leased property (§ 535 (1) sentence 3)";
    when vermieter(m, v);
    then pflicht_lasten_zu_tragen(m, v);
}

@source(BGB_P535)
rule Mietzahlungspflicht535Abs2(m: Mietverhaeltnis, mi: Person) strict {
    label de official "Der Mieter ist verpflichtet, dem Vermieter die vereinbarte Miete zu entrichten (§ 535 Abs. 2)";
    label en unofficial "The tenant is obliged to pay the lessor the agreed rent (§ 535 (2))";
    when mieter(m, mi);
    then pflicht_miete_zu_entrichten(m, mi);
}

@source(BGB_P535)
rule PositionGebrauch535Abs1(m: Mietverhaeltnis, v: Person, mi: Person, beginn: Date) strict {
    label de official "Der Vermieter hat dem Mieter den Gebrauch der Mietsache während der Mietzeit zu gewähren (§ 535 Abs. 1)";
    label en unofficial "The lessor must grant the tenant use of the leased property during the lease (§ 535 (1))";
    when vermieter(m, v) and mieter(m, mi) and mietverhaeltnis_beginn_am(m, beginn);
    then duty GebrauchGewaehrung535 {
        bearer v;
        beneficiary mi;
        achieve gebrauch_gewaehrt(m) during [beginn, infinity);
    };
}

@source(BGB_P535)
rule PositionZustand535Abs1Satz2(m: Mietverhaeltnis, v: Person, mi: Person, beginn: Date) strict {
    label de official "Der Vermieter hat die Mietsache während der Mietzeit in vertragsgemäßem Zustand zu erhalten (§ 535 Abs. 1 Satz 2)";
    label en unofficial "The lessor must maintain the property in a condition suitable for contractual use during the lease (§ 535 (1) sentence 2)";
    when vermieter(m, v) and mieter(m, mi) and mietverhaeltnis_beginn_am(m, beginn);
    then duty ZustandErhalten535 {
        bearer v;
        beneficiary mi;
        maintain zustand_vertragsgemaess(m) during [beginn, infinity);
    };
}

@source(BGB_P535)
rule PositionLasten535Abs1Satz3(m: Mietverhaeltnis, v: Person, mi: Person, beginn: Date) strict {
    label de official "Der Vermieter hat die auf der Mietsache ruhenden Lasten zu tragen (§ 535 Abs. 1 Satz 3)";
    label en unofficial "The lessor must bear charges resting on the leased property (§ 535 (1) sentence 3)";
    when vermieter(m, v) and mieter(m, mi) and mietverhaeltnis_beginn_am(m, beginn);
    then duty LastenTragen535 {
        bearer v;
        beneficiary mi;
        achieve lasten_getragen(m) during [beginn, infinity);
    };
}

@source(BGB_P535)
rule PositionMietzahlung535Abs2(m: Mietverhaeltnis, v: Person, mi: Person, beginn: Date) strict {
    label de official "Der Mieter ist verpflichtet, dem Vermieter die vereinbarte Miete zu entrichten (§ 535 Abs. 2)";
    label en unofficial "The tenant is obliged to pay the lessor the agreed rent (§ 535 (2))";
    when vermieter(m, v) and mieter(m, mi) and mietverhaeltnis_beginn_am(m, beginn);
    then duty Mietzahlung535 {
        bearer mi;
        beneficiary v;
        achieve miete_entrichtet(m) during [beginn, infinity);
    };
}

// --- § 536 Mietminderung bei Sach- und Rechtsmängeln ----------------------------------------------

pub relation mangel_der_mietsache(g: Mangel, m: Mietverhaeltnis) kind empirical {
    key(g);
    label de official "Mangel der Mietsache, der ihre Tauglichkeit zum vertragsgemäßen Gebrauch aufhebt oder mindert (§ 536 Abs. 1)";
    label en unofficial "defect of the leased property that removes or reduces its suitability for use in conformity with the contract (§ 536 (1))";
}
pub relation tauglichkeit_aufgehoben(g: Mangel) kind empirical {
    label de official "der Mangel hebt die Tauglichkeit zum vertragsgemäßen Gebrauch auf (§ 536 Abs. 1 Satz 1)";
    label en unofficial "the defect removes suitability for use in conformity with the contract (§ 536 (1) sentence 1)";
}
pub relation tauglichkeit_gemindert(g: Mangel) kind empirical {
    label de official "der Mangel mindert die Tauglichkeit zum vertragsgemäßen Gebrauch (§ 536 Abs. 1 Satz 2)";
    label en unofficial "the defect reduces suitability for use in conformity with the contract (§ 536 (1) sentence 2)";
}
pub relation zugesicherte_eigenschaft_fehlt(g: Mangel) kind empirical {
    label de official "eine zugesicherte Eigenschaft fehlt oder fällt später weg (§ 536 Abs. 2)";
    label en unofficial "a warranted quality is missing or later ceases to exist (§ 536 (2))";
}
pub relation gebrauch_durch_recht_eines_dritten_entzogen(g: Mangel) kind empirical {
    label de official "dem Mieter wird der vertragsgemäße Gebrauch durch das Recht eines Dritten ganz oder zum Teil entzogen (§ 536 Abs. 3)";
    label en unofficial "the tenant is deprived, wholly or in part, of use in conformity with the contract by the right of a third party (§ 536 (3))";
}
pub relation energetische_modernisierung_massnahme(g: Mangel) kind empirical {
    label de official "die Minderung der Tauglichkeit tritt auf Grund einer Maßnahme ein, die einer energetischen Modernisierung nach § 555b Nummer 1 dient (§ 536 Abs. 1a)";
    label en unofficial "the reduction in suitability results from a measure serving an energy-efficiency modernisation under § 555b no. 1 (§ 536 (1a))";
}
pub relation massnahme_beginn_am(g: Mangel, tag: Date) kind empirical {
    key(g);
    label de official "Tag, an dem die Maßnahme der energetischen Modernisierung beginnt (§ 536 Abs. 1a)";
    label en unofficial "day on which the energy-efficiency modernisation measure begins (§ 536 (1a))";
}

@source(BGB_P536)
pub external judgment relation minderung_der_tauglichkeit_unerheblich(g: Mangel) {
    authority Court;
    label de official "§ 536 Abs. 1 Satz 3. Die Minderung der Tauglichkeit ist unerheblich und bleibt außer Betracht";
    label en unofficial "§ 536 (1) sentence 3. The reduction in suitability is insignificant and is disregarded";
}

@source(BGB_P536)
pub external judgment relation minderungsquote(g: Mangel, zaehler: Integer, nenner: Integer) {
    authority Court;
    label de official "§ 536 Abs. 1 Satz 2. Verhältnis, in dem die Miete angemessen herabzusetzen ist, als Zähler und Nenner ganzer Zahlen — der Text nennt weder Quote noch Formel";
    label en unofficial "§ 536 (1) sentence 2. Ratio by which the rent is to be appropriately reduced, as numerator and denominator of whole numbers — the text names neither quota nor formula";
}

pub relation von_der_miete_befreit(m: Mietverhaeltnis, g: Mangel) kind institutional {
    label de official "der Mieter ist für die Zeit, in der die Tauglichkeit aufgehoben ist, von der Entrichtung der Miete befreit (§ 536 Abs. 1 Satz 1)";
    label en unofficial "the tenant is released from payment of rent for the period during which suitability is removed (§ 536 (1) sentence 1)";
}
pub relation herabgesetzte_miete(m: Mietverhaeltnis, g: Mangel, betrag: Money) kind institutional {
    key(m, g);
    label de official "die angemessen herabgesetzte Miete für die Zeit, während der die Tauglichkeit gemindert ist (§ 536 Abs. 1 Satz 2) — eine Division je Verhältnis, kaufmännisch auf den Cent gerundet";
    label en unofficial "the appropriately reduced rent for the period during which suitability is reduced (§ 536 (1) sentence 2) — one division per lease, rounded commercially to the cent";
}
pub relation minderung_bleibt_ausser_betracht(g: Mangel) kind institutional {
    label de official "die Minderung der Tauglichkeit bleibt außer Betracht (§ 536 Abs. 1 Satz 3, Abs. 1a)";
    label en unofficial "the reduction in suitability is disregarded (§ 536 (1) sentence 3, (1a))";
}
pub relation minderung_ausser_betracht_bis(g: Mangel, tag: Date) kind institutional {
    key(g);
    label de official "letzter Tag der drei Monate, für deren Dauer die Minderung wegen einer energetischen Modernisierung außer Betracht bleibt (§ 536 Abs. 1a)";
    label en unofficial "last day of the three months for whose duration the reduction is disregarded because of an energy-efficiency modernisation (§ 536 (1a))";
}

@source(BGB_P536)
rule Befreiung536Abs1Satz1(m: Mietverhaeltnis, g: Mangel) defeasible {
    label de official "Hat die Mietsache einen Mangel, der ihre Tauglichkeit zum vertragsgemäßen Gebrauch aufhebt, so ist der Mieter für die Zeit, in der die Tauglichkeit aufgehoben ist, von der Entrichtung der Miete befreit (§ 536 Abs. 1 Satz 1)";
    label en unofficial "If the property has a defect removing its suitability for use in conformity with the contract, the tenant is released from payment of rent for the period during which suitability is removed (§ 536 (1) sentence 1)";
    when mangel_der_mietsache(g, m) and tauglichkeit_aufgehoben(g)
     and not_known(maengelrechte_ausgeschlossen(m, g));
    then von_der_miete_befreit(m, g);
}

@source(BGB_P536)
rule UnerheblicheMinderung536Abs1Satz3(g: Mangel) strict {
    label de official "Eine unerhebliche Minderung der Tauglichkeit bleibt außer Betracht (§ 536 Abs. 1 Satz 3)";
    label en unofficial "An insignificant reduction in suitability is disregarded (§ 536 (1) sentence 3)";
    when tauglichkeit_gemindert(g) and minderung_der_tauglichkeit_unerheblich(g);
    then minderung_bleibt_ausser_betracht(g);
}

@source(BGB_P536)
rule EnergetischeModernisierung536Abs1a(g: Mangel, b: Date) strict {
    label de official "Für die Dauer von drei Monaten bleibt eine Minderung der Tauglichkeit außer Betracht, soweit diese auf Grund einer Maßnahme eintritt, die einer energetischen Modernisierung nach § 555b Nummer 1 dient (§ 536 Abs. 1a) — Monatsschritt nach § 188 Abs. 2, Politik BGB_MIETE_KALENDER";
    label en unofficial "For a duration of three months a reduction in suitability is disregarded in so far as it results from a measure serving an energy-efficiency modernisation under § 555b no. 1 (§ 536 (1a)) — monthly step under § 188 (2), policy BGB_MIETE_KALENDER";
    when energetische_modernisierung_massnahme(g) and massnahme_beginn_am(g, b);
    then minderung_ausser_betracht_bis(g, add_calendar_period(b, 3 calendar_month));
}

@source(BGB_P536)
rule EnergetischeModernisierungAusserBetracht536Abs1a(g: Mangel, e: Date) strict {
    label de official "Innerhalb der drei Monate bleibt die Minderung außer Betracht (§ 536 Abs. 1a)";
    label en unofficial "Within the three months the reduction is disregarded (§ 536 (1a))";
    when minderung_ausser_betracht_bis(g, e);
    then minderung_bleibt_ausser_betracht(g);
}

@source(BGB_P536)
rule HerabgesetzteMiete536Abs1Satz2(m: Mietverhaeltnis, g: Mangel, miete: Money, z: Integer, n: Integer) defeasible {
    label de official "Für die Zeit, während der die Tauglichkeit gemindert ist, hat der Mieter nur eine angemessen herabgesetzte Miete zu entrichten (§ 536 Abs. 1 Satz 2) — die Quote gibt das Gericht als Verhältnis an, die Rechnung steht einmal je Verhältnis";
    label en unofficial "For the period during which suitability is reduced the tenant owes only an appropriately reduced rent (§ 536 (1) sentence 2) — the court states the ratio, the computation stands once per lease";
    when mangel_der_mietsache(g, m) and tauglichkeit_gemindert(g) and not_known(minderung_bleibt_ausser_betracht(g))
     and miete_monatlich(m, miete) and minderungsquote(g, z, n);
    then herabgesetzte_miete(m, g, div_round(miete * (n - z), n * 1.0, 2, "HALF_UP"));
}

@source(BGB_P536)
rule ZugesicherteEigenschaft536Abs2(m: Mietverhaeltnis, g: Mangel) defeasible {
    label de official "Absatz 1 Satz 1 und 2 gilt auch, wenn eine zugesicherte Eigenschaft fehlt oder später wegfällt (§ 536 Abs. 2)";
    label en unofficial "Subsection (1) sentences 1 and 2 also apply where a warranted quality is missing or later ceases to exist (§ 536 (2))";
    when mangel_der_mietsache(g, m) and zugesicherte_eigenschaft_fehlt(g) and tauglichkeit_aufgehoben(g)
     and not_known(maengelrechte_ausgeschlossen(m, g));
    then von_der_miete_befreit(m, g);
}

@source(BGB_P536)
rule RechtDrittes536Abs3(m: Mietverhaeltnis, g: Mangel) defeasible {
    label de official "Wird dem Mieter der vertragsgemäße Gebrauch durch das Recht eines Dritten ganz oder zum Teil entzogen, so gelten die Absätze 1 und 2 entsprechend (§ 536 Abs. 3)";
    label en unofficial "Where the tenant is deprived of contractual use by a third party's right, subsections (1) and (2) apply accordingly (§ 536 (3))";
    when mangel_der_mietsache(g, m) and gebrauch_durch_recht_eines_dritten_entzogen(g) and tauglichkeit_aufgehoben(g)
     and not_known(maengelrechte_ausgeschlossen(m, g));
    then von_der_miete_befreit(m, g);
}

// --- § 536a Schadens- und Aufwendungsersatz, § 536b Kenntnis, § 536c Anzeige, § 536d Ausschluss ----

pub relation mangel_bei_vertragsschluss_vorhanden(g: Mangel) kind empirical {
    label de official "der Mangel im Sinne des § 536 ist bei Vertragsschluss vorhanden (§ 536a Abs. 1 Alt. 1)";
    label en unofficial "the defect within the meaning of § 536 exists at the time the contract is concluded (§ 536a (1) alt. 1)";
}
pub relation vermieter_hat_umstand_zu_vertreten(g: Mangel) kind empirical {
    label de official "der Mangel entsteht später wegen eines Umstands, den der Vermieter zu vertreten hat (§ 536a Abs. 1 Alt. 2)";
    label en unofficial "the defect arises later because of a circumstance for which the lessor is responsible (§ 536a (1) alt. 2)";
}
pub relation vermieter_in_verzug_mit_beseitigung(g: Mangel) kind empirical {
    label de official "der Vermieter kommt mit der Beseitigung eines Mangels in Verzug (§ 536a Abs. 1 Alt. 3, Abs. 2 Nr. 1)";
    label en unofficial "the lessor is in default with the removal of a defect (§ 536a (1) alt. 3, (2) no. 1)";
}
pub relation umgehende_beseitigung_notwendig(g: Mangel) kind empirical {
    label de official "die umgehende Beseitigung des Mangels ist zur Erhaltung oder Wiederherstellung des Bestands der Mietsache notwendig (§ 536a Abs. 2 Nr. 2)";
    label en unofficial "immediate removal of the defect is necessary to preserve or restore the existence of the leased property (§ 536a (2) no. 2)";
}
pub relation mieter_kannte_mangel_bei_vertragsschluss(m: Mietverhaeltnis, g: Mangel) kind empirical {
    label de official "der Mieter kennt bei Vertragsschluss den Mangel der Mietsache (§ 536b Satz 1) — festgestellte Tatsache, im Fall origin adjudicated";
    label en unofficial "the tenant knows of the defect when the contract is concluded (§ 536b sentence 1) — established fact, in the case with origin adjudicated";
}
pub relation unkenntnis_infolge_grober_fahrlaessigkeit(m: Mietverhaeltnis, g: Mangel) kind empirical {
    label de official "der Mangel ist dem Mieter infolge grober Fahrlässigkeit unbekannt geblieben (§ 536b Satz 2)";
    label en unofficial "the defect remained unknown to the tenant as a result of gross negligence (§ 536b sentence 2)";
}
pub relation mangel_arglistig_verschwiegen(m: Mietverhaeltnis, g: Mangel) kind empirical {
    label de official "der Vermieter hat den Mangel arglistig verschwiegen (§ 536b Satz 2, § 536d) — festgestellte Tatsache";
    label en unofficial "the lessor fraudulently concealed the defect (§ 536b sentence 2, § 536d) — established fact";
}
pub relation mangelhafte_sache_in_kenntnis_angenommen(m: Mietverhaeltnis, g: Mangel) kind empirical {
    label de official "der Mieter nimmt eine mangelhafte Sache an, obwohl er den Mangel kennt (§ 536b Satz 3)";
    label en unofficial "the tenant accepts a defective thing although he knows of the defect (§ 536b sentence 3)";
}
pub relation rechte_bei_annahme_vorbehalten(m: Mietverhaeltnis, g: Mangel) kind empirical {
    label de official "der Mieter behält sich seine Rechte bei der Annahme vor (§ 536b Satz 3)";
    label en unofficial "the tenant reserves his rights on acceptance (§ 536b sentence 3)";
}
pub relation ausschlussvereinbarung_wegen_mangels(m: Mietverhaeltnis) kind empirical {
    label de official "eine Vereinbarung, durch die die Rechte des Mieters wegen eines Mangels ausgeschlossen oder beschränkt werden (§ 536d)";
    label en unofficial "an agreement excluding or restricting the tenant's rights on account of a defect (§ 536d)";
}

pub relation maengelrechte_ausgeschlossen(m: Mietverhaeltnis, g: Mangel) kind institutional {
    label de official "dem Mieter stehen die Rechte aus den §§ 536 und 536a nicht zu (§ 536b)";
    label en unofficial "the tenant is not entitled to the rights under §§ 536 and 536a (§ 536b)";
}
pub relation schadensersatzanspruch_wegen_mangels(m: Mietverhaeltnis, g: Mangel, mi: Person) kind institutional {
    label de official "der Mieter kann unbeschadet der Rechte aus § 536 Schadensersatz verlangen (§ 536a Abs. 1)";
    label en unofficial "the tenant may claim damages without prejudice to the rights under § 536 (§ 536a (1))";
}
pub relation recht_zur_selbstbeseitigung(m: Mietverhaeltnis, g: Mangel, mi: Person) kind institutional {
    label de official "der Mieter kann den Mangel selbst beseitigen und Ersatz der erforderlichen Aufwendungen verlangen (§ 536a Abs. 2)";
    label en unofficial "the tenant may remove the defect himself and claim reimbursement of the necessary expenses (§ 536a (2))";
}
pub relation berufung_auf_ausschluss_versagt(m: Mietverhaeltnis) kind institutional {
    label de official "der Vermieter kann sich auf die Ausschlussvereinbarung nicht berufen (§ 536d)";
    label en unofficial "the lessor may not rely on the agreement of exclusion (§ 536d)";
}

@source(BGB_P536b)
rule KenntnisSperrt536bSatz1(m: Mietverhaeltnis, g: Mangel) strict {
    label de official "Kennt der Mieter bei Vertragsschluss den Mangel der Mietsache, so stehen ihm die Rechte aus den §§ 536 und 536a nicht zu (§ 536b Satz 1)";
    label en unofficial "If the tenant knows of the defect when the contract is concluded, he is not entitled to the rights under §§ 536 and 536a (§ 536b sentence 1)";
    when mangel_der_mietsache(g, m) and mieter_kannte_mangel_bei_vertragsschluss(m, g);
    then maengelrechte_ausgeschlossen(m, g);
}

@source(BGB_P536b)
rule GrobeFahrlaessigkeit536bSatz2(m: Mietverhaeltnis, g: Mangel) strict {
    label de official "Ist der Mangel dem Mieter infolge grober Fahrlässigkeit unbekannt geblieben, so stehen ihm diese Rechte nur zu, wenn der Vermieter den Mangel arglistig verschwiegen hat (§ 536b Satz 2)";
    label en unofficial "If the defect remained unknown to the tenant through gross negligence, he has those rights only if the lessor fraudulently concealed the defect (§ 536b sentence 2)";
    when mangel_der_mietsache(g, m) and unkenntnis_infolge_grober_fahrlaessigkeit(m, g)
     and not mangel_arglistig_verschwiegen(m, g);
    then maengelrechte_ausgeschlossen(m, g);
}

@source(BGB_P536b)
rule AnnahmeOhneVorbehalt536bSatz3(m: Mietverhaeltnis, g: Mangel) strict {
    label de official "Nimmt der Mieter eine mangelhafte Sache an, obwohl er den Mangel kennt, so kann er die Rechte aus den §§ 536 und 536a nur geltend machen, wenn er sich seine Rechte bei der Annahme vorbehält (§ 536b Satz 3)";
    label en unofficial "If the tenant accepts a defective thing although he knows of the defect, he may assert the rights under §§ 536 and 536a only if he reserves his rights on acceptance (§ 536b sentence 3)";
    when mangel_der_mietsache(g, m) and mangelhafte_sache_in_kenntnis_angenommen(m, g)
     and not rechte_bei_annahme_vorbehalten(m, g);
    then maengelrechte_ausgeschlossen(m, g);
}

@source(BGB_P536a)
rule Schadensersatz536aAbs1Vorhanden(m: Mietverhaeltnis, g: Mangel, mi: Person) defeasible {
    label de official "Ist ein Mangel im Sinne des § 536 bei Vertragsschluss vorhanden, so kann der Mieter unbeschadet der Rechte aus § 536 Schadensersatz verlangen (§ 536a Abs. 1 Alt. 1)";
    label en unofficial "If a defect within the meaning of § 536 exists when the contract is concluded, the tenant may claim damages without prejudice to the rights under § 536 (§ 536a (1) alt. 1)";
    when mangel_der_mietsache(g, m) and mangel_bei_vertragsschluss_vorhanden(g) and mieter(m, mi)
     and not_known(maengelrechte_ausgeschlossen(m, g));
    then schadensersatzanspruch_wegen_mangels(m, g, mi);
}

@source(BGB_P536a)
rule Schadensersatz536aAbs1Vertreten(m: Mietverhaeltnis, g: Mangel, mi: Person) defeasible {
    label de official "Entsteht ein solcher Mangel später wegen eines Umstands, den der Vermieter zu vertreten hat, so kann der Mieter Schadensersatz verlangen (§ 536a Abs. 1 Alt. 2)";
    label en unofficial "If such a defect arises later because of a circumstance for which the lessor is responsible, the tenant may claim damages (§ 536a (1) alt. 2)";
    when mangel_der_mietsache(g, m) and vermieter_hat_umstand_zu_vertreten(g) and mieter(m, mi)
     and not_known(maengelrechte_ausgeschlossen(m, g));
    then schadensersatzanspruch_wegen_mangels(m, g, mi);
}

@source(BGB_P536a)
rule Schadensersatz536aAbs1Verzug(m: Mietverhaeltnis, g: Mangel, mi: Person) defeasible {
    label de official "Kommt der Vermieter mit der Beseitigung eines Mangels in Verzug, so kann der Mieter Schadensersatz verlangen (§ 536a Abs. 1 Alt. 3)";
    label en unofficial "If the lessor is in default with the removal of a defect, the tenant may claim damages (§ 536a (1) alt. 3)";
    when mangel_der_mietsache(g, m) and vermieter_in_verzug_mit_beseitigung(g) and mieter(m, mi)
     and not_known(maengelrechte_ausgeschlossen(m, g));
    then schadensersatzanspruch_wegen_mangels(m, g, mi);
}

@source(BGB_P536a)
rule Selbstbeseitigung536aAbs2Nr1(m: Mietverhaeltnis, g: Mangel, mi: Person) defeasible {
    label de official "Der Mieter kann den Mangel selbst beseitigen und Ersatz der erforderlichen Aufwendungen verlangen, wenn der Vermieter mit der Beseitigung des Mangels in Verzug ist (§ 536a Abs. 2 Nr. 1)";
    label en unofficial "The tenant may remove the defect himself and claim reimbursement of the necessary expenses if the lessor is in default with its removal (§ 536a (2) no. 1)";
    when mangel_der_mietsache(g, m) and vermieter_in_verzug_mit_beseitigung(g) and mieter(m, mi)
     and not_known(maengelrechte_ausgeschlossen(m, g));
    then recht_zur_selbstbeseitigung(m, g, mi);
}

@source(BGB_P536a)
rule Selbstbeseitigung536aAbs2Nr2(m: Mietverhaeltnis, g: Mangel, mi: Person) defeasible {
    label de official "Der Mieter kann den Mangel selbst beseitigen und Ersatz verlangen, wenn die umgehende Beseitigung zur Erhaltung oder Wiederherstellung des Bestands der Mietsache notwendig ist (§ 536a Abs. 2 Nr. 2)";
    label en unofficial "The tenant may remove the defect himself and claim reimbursement if immediate removal is necessary to preserve or restore the existence of the leased property (§ 536a (2) no. 2)";
    when mangel_der_mietsache(g, m) and umgehende_beseitigung_notwendig(g) and mieter(m, mi)
     and not_known(maengelrechte_ausgeschlossen(m, g));
    then recht_zur_selbstbeseitigung(m, g, mi);
}

@source(BGB_P536d)
rule Arglist536d(m: Mietverhaeltnis, g: Mangel) strict {
    label de official "Auf eine Vereinbarung, durch die die Rechte des Mieters wegen eines Mangels ausgeschlossen oder beschränkt werden, kann sich der Vermieter nicht berufen, wenn er den Mangel arglistig verschwiegen hat (§ 536d)";
    label en unofficial "The lessor may not rely on an agreement excluding or restricting the tenant's rights on account of a defect if he fraudulently concealed the defect (§ 536d)";
    when ausschlussvereinbarung_wegen_mangels(m) and mangel_arglistig_verschwiegen(m, g);
    then berufung_auf_ausschluss_versagt(m);
}

// --- § 536c Mängelanzeige --------------------------------------------------------------------------

pub relation mangel_im_laufe_der_mietzeit(g: Mangel) kind empirical {
    label de official "im Laufe der Mietzeit zeigt sich ein Mangel der Mietsache oder eine Schutzmaßnahme wird erforderlich (§ 536c Abs. 1 Satz 1)";
    label en unofficial "in the course of the lease period a defect appears or a protective measure becomes necessary (§ 536c (1) sentence 1)";
}
pub relation anzeige_unterlassen(m: Mietverhaeltnis, g: Mangel) kind empirical {
    label de official "der Mieter unterlässt die Anzeige (§ 536c Abs. 2 Satz 1)";
    label en unofficial "the tenant fails to give notice (§ 536c (2) sentence 1)";
}
pub relation abhilfe_infolge_unterlassung_unmoeglich(m: Mietverhaeltnis, g: Mangel) kind empirical {
    label de official "der Vermieter konnte infolge der Unterlassung der Anzeige nicht Abhilfe schaffen (§ 536c Abs. 2 Satz 2)";
    label en unofficial "as a result of the omitted notice the lessor could not provide a remedy (§ 536c (2) sentence 2)";
}

@source(BGB_P536c)
pub external judgment relation anzeige_unverzueglich_erstattet(m: Mietverhaeltnis, g: Mangel) {
    authority Court;
    label de official "§ 536c Abs. 1 Satz 1. Die Anzeige ist unverzüglich erstattet — „unverzüglich“ ist eine Wertung, keine Nullfrist (DECISION-0194)";
    label en unofficial "§ 536c (1) sentence 1. Notice was given without undue delay — “without undue delay” is an evaluation, not a zero period (DECISION-0194)";
}

pub relation anzeigepflicht(m: Mietverhaeltnis, g: Mangel, mi: Person) kind institutional {
    label de official "Pflicht des Mieters, dem Vermieter den Mangel unverzüglich anzuzeigen (§ 536c Abs. 1 Satz 1)";
    label en unofficial "tenant's duty to notify the lessor of the defect without undue delay (§ 536c (1) sentence 1)";
}
pub relation schadensersatzpflicht_wegen_unterlassener_anzeige(m: Mietverhaeltnis, g: Mangel, mi: Person) kind institutional {
    label de official "der Mieter ist dem Vermieter zum Ersatz des aus der Unterlassung entstehenden Schadens verpflichtet (§ 536c Abs. 2 Satz 1)";
    label en unofficial "the tenant is liable to the lessor for the damage arising from the omission (§ 536c (2) sentence 1)";
}
pub relation maengelrechte_wegen_unterlassener_anzeige_gesperrt(m: Mietverhaeltnis, g: Mangel) kind institutional {
    label de official "der Mieter ist nicht berechtigt, die Rechte des § 536, den Schadensersatz nach § 536a Abs. 1 und die Kündigung ohne Abhilfefrist nach § 543 Abs. 3 Satz 1 geltend zu machen (§ 536c Abs. 2 Satz 2)";
    label en unofficial "the tenant may not assert the rights under § 536, damages under § 536a (1) or termination without a remedial period under § 543 (3) sentence 1 (§ 536c (2) sentence 2)";
}

@source(BGB_P536c)
rule Anzeigepflicht536cAbs1(m: Mietverhaeltnis, g: Mangel, mi: Person) strict {
    label de official "Zeigt sich im Laufe der Mietzeit ein Mangel der Mietsache, so hat der Mieter dies dem Vermieter unverzüglich anzuzeigen (§ 536c Abs. 1 Satz 1)";
    label en unofficial "If a defect appears in the course of the lease period, the tenant must notify the lessor without undue delay (§ 536c (1) sentence 1)";
    when mangel_der_mietsache(g, m) and mangel_im_laufe_der_mietzeit(g) and mieter(m, mi);
    then anzeigepflicht(m, g, mi);
}

@source(BGB_P536c)
rule Ersatzpflicht536cAbs2Satz1(m: Mietverhaeltnis, g: Mangel, mi: Person) strict {
    label de official "Unterlässt der Mieter die Anzeige, so ist er dem Vermieter zum Ersatz des daraus entstehenden Schadens verpflichtet (§ 536c Abs. 2 Satz 1)";
    label en unofficial "If the tenant fails to give notice, he is liable to the lessor for the damage arising from this (§ 536c (2) sentence 1)";
    when anzeigepflicht(m, g, mi) and anzeige_unterlassen(m, g);
    then schadensersatzpflicht_wegen_unterlassener_anzeige(m, g, mi);
}

@source(BGB_P536c)
rule Rechtsverlust536cAbs2Satz2(m: Mietverhaeltnis, g: Mangel) strict {
    label de official "Soweit der Vermieter infolge der Unterlassung der Anzeige nicht Abhilfe schaffen konnte, ist der Mieter nicht berechtigt, die in § 536 bestimmten Rechte geltend zu machen, nach § 536a Abs. 1 Schadensersatz zu verlangen oder ohne Bestimmung einer angemessenen Abhilfefrist nach § 543 Abs. 3 Satz 1 zu kündigen (§ 536c Abs. 2 Satz 2)";
    label en unofficial "In so far as the lessor could not provide a remedy because notice was omitted, the tenant may not assert the rights under § 536, claim damages under § 536a (1) or terminate without setting a reasonable remedial period under § 543 (3) sentence 1 (§ 536c (2) sentence 2)";
    when anzeige_unterlassen(m, g) and abhilfe_infolge_unterlassung_unmoeglich(m, g);
    then maengelrechte_wegen_unterlassener_anzeige_gesperrt(m, g);
}

// --- §§ 537–541 Miete bei Verhinderung, Abnutzung, Aufwendungen, Dritte, Unterlassung -------------

pub relation in_der_person_liegender_hinderungsgrund(m: Mietverhaeltnis) kind empirical {
    label de official "der Mieter ist durch einen in seiner Person liegenden Grund an der Ausübung seines Gebrauchsrechts gehindert (§ 537 Abs. 1 Satz 1)";
    label en unofficial "the tenant is prevented from exercising his right of use by a reason lying in his own person (§ 537 (1) sentence 1)";
}
pub relation gebrauch_einem_dritten_ueberlassen_durch_vermieter(m: Mietverhaeltnis) kind empirical {
    label de official "der Vermieter ist infolge der Überlassung des Gebrauchs an einen Dritten außerstande, dem Mieter den Gebrauch zu gewähren (§ 537 Abs. 2)";
    label en unofficial "as a result of granting use to a third party the lessor is unable to grant use to the tenant (§ 537 (2))";
}
pub relation veraenderung_durch_vertragsgemaessen_gebrauch(m: Mietverhaeltnis) kind empirical {
    label de official "Veränderungen oder Verschlechterungen der Mietsache, die durch den vertragsgemäßen Gebrauch herbeigeführt werden (§ 538)";
    label en unofficial "changes or deterioration of the leased property brought about by use in conformity with the contract (§ 538)";
}
pub relation einrichtung_des_mieters(m: Mietverhaeltnis) kind empirical {
    label de official "eine Einrichtung, mit der der Mieter die Mietsache versehen hat (§ 539 Abs. 2, § 552 Abs. 1)";
    label en unofficial "a fixture with which the tenant has provided the leased property (§ 539 (2), § 552 (1))";
}
pub relation erlaubnis_zur_gebrauchsueberlassung_erteilt(m: Mietverhaeltnis) kind empirical {
    label de official "der Vermieter hat die Erlaubnis erteilt, den Gebrauch der Mietsache einem Dritten zu überlassen (§ 540 Abs. 1 Satz 1)";
    label en unofficial "the lessor has granted permission to let a third party use the property (§ 540 (1) sentence 1)";
}
pub relation erlaubnis_verweigert(m: Mietverhaeltnis) kind empirical {
    label de official "der Vermieter verweigert die Erlaubnis (§ 540 Abs. 1 Satz 2, § 553 Abs. 1)";
    label en unofficial "the lessor refuses permission (§ 540 (1) sentence 2, § 553 (1))";
}
pub relation wichtiger_grund_in_der_person_des_dritten(m: Mietverhaeltnis) kind empirical {
    label de official "in der Person des Dritten liegt ein wichtiger Grund (§ 540 Abs. 1 Satz 2, § 553 Abs. 1 Satz 2) — ausdrückliche Angabe des Falls";
    label en unofficial "there is a compelling reason in the person of the third party (§ 540 (1) sentence 2, § 553 (1) sentence 2) — express statement of the case";
}
pub relation vertragswidriger_gebrauch_fortgesetzt(m: Mietverhaeltnis) kind empirical {
    label de official "der Mieter setzt einen vertragswidrigen Gebrauch der Mietsache trotz einer Abmahnung des Vermieters fort (§ 541, § 590a)";
    label en unofficial "the tenant continues a use contrary to the contract despite a warning by the lessor (§ 541, § 590a)";
}

pub relation miete_bleibt_geschuldet(m: Mietverhaeltnis) kind institutional {
    label de official "der Mieter wird von der Entrichtung der Miete nicht befreit (§ 537 Abs. 1 Satz 1, § 587 Abs. 2 Satz 1)";
    label en unofficial "the tenant is not released from payment of rent (§ 537 (1) sentence 1, § 587 (2) sentence 1)";
}
pub relation miete_nicht_geschuldet(m: Mietverhaeltnis) kind institutional {
    label de official "der Mieter ist zur Entrichtung der Miete nicht verpflichtet (§ 537 Abs. 2)";
    label en unofficial "the tenant is not obliged to pay the rent (§ 537 (2))";
}
pub relation mieter_hat_nicht_zu_vertreten(m: Mietverhaeltnis) kind institutional {
    label de official "Veränderungen oder Verschlechterungen durch den vertragsgemäßen Gebrauch hat der Mieter nicht zu vertreten (§ 538)";
    label en unofficial "the tenant is not responsible for changes or deterioration caused by use in conformity with the contract (§ 538)";
}
pub relation wegnahmerecht(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "der Mieter ist berechtigt, eine Einrichtung wegzunehmen, mit der er die Mietsache versehen hat (§ 539 Abs. 2, § 591a Satz 1)";
    label en unofficial "the tenant is entitled to remove a fixture with which he has provided the property (§ 539 (2), § 591a sentence 1)";
}
pub relation gebrauchsueberlassung_ohne_erlaubnis_unzulaessig(m: Mietverhaeltnis) kind institutional {
    label de official "der Mieter ist ohne die Erlaubnis des Vermieters nicht berechtigt, den Gebrauch der Mietsache einem Dritten zu überlassen (§ 540 Abs. 1 Satz 1, § 589 Abs. 1)";
    label en unofficial "without the lessor's permission the tenant is not entitled to let a third party use the property (§ 540 (1) sentence 1, § 589 (1))";
}
pub relation ausserordentliches_kuendigungsrecht_gesetzliche_frist(m: Mietverhaeltnis, p: Person) kind institutional {
    label de official "die Partei kann das Mietverhältnis außerordentlich mit der gesetzlichen Frist kündigen (§ 540 Abs. 1 Satz 2, § 544 Satz 1, § 563 Abs. 4, § 563a Abs. 2, § 564 Satz 2, § 580)";
    label en unofficial "the party may terminate the lease extraordinarily with the statutory notice period (§ 540 (1) sentence 2, § 544 sentence 1, § 563 (4), § 563a (2), § 564 sentence 2, § 580)";
}
pub relation unterlassungsklage_zulaessig(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "der Vermieter kann auf Unterlassung klagen (§ 541, § 590a)";
    label en unofficial "the lessor may sue for an injunction (§ 541, § 590a)";
}

@source(BGB_P537)
rule KeineBefreiung537Abs1(m: Mietverhaeltnis) strict {
    label de official "Der Mieter wird von der Entrichtung der Miete nicht dadurch befreit, dass er durch einen in seiner Person liegenden Grund an der Ausübung seines Gebrauchsrechts gehindert wird (§ 537 Abs. 1 Satz 1)";
    label en unofficial "The tenant is not released from payment of rent by being prevented from exercising his right of use by a reason lying in his own person (§ 537 (1) sentence 1)";
    when in_der_person_liegender_hinderungsgrund(m);
    then miete_bleibt_geschuldet(m);
}

@source(BGB_P537)
rule KeineMiete537Abs2(m: Mietverhaeltnis) strict {
    label de official "Solange der Vermieter infolge der Überlassung des Gebrauchs an einen Dritten außerstande ist, dem Mieter den Gebrauch zu gewähren, ist der Mieter zur Entrichtung der Miete nicht verpflichtet (§ 537 Abs. 2)";
    label en unofficial "As long as the lessor is unable to grant use to the tenant because use was granted to a third party, the tenant is not obliged to pay the rent (§ 537 (2))";
    when gebrauch_einem_dritten_ueberlassen_durch_vermieter(m);
    then miete_nicht_geschuldet(m);
}

@source(BGB_P538)
rule Abnutzung538(m: Mietverhaeltnis) strict {
    label de official "Veränderungen oder Verschlechterungen der Mietsache, die durch den vertragsgemäßen Gebrauch herbeigeführt werden, hat der Mieter nicht zu vertreten (§ 538)";
    label en unofficial "The tenant is not responsible for changes or deterioration of the property brought about by use in conformity with the contract (§ 538)";
    when veraenderung_durch_vertragsgemaessen_gebrauch(m);
    then mieter_hat_nicht_zu_vertreten(m);
}

@source(BGB_P539)
rule Wegnahmerecht539Abs2(m: Mietverhaeltnis, mi: Person) strict {
    label de official "Der Mieter ist berechtigt, eine Einrichtung wegzunehmen, mit der er die Mietsache versehen hat (§ 539 Abs. 2)";
    label en unofficial "The tenant is entitled to remove a fixture with which he has provided the property (§ 539 (2))";
    when einrichtung_des_mieters(m) and mieter(m, mi);
    then wegnahmerecht(m, mi);
}

@source(BGB_P540)
rule Gebrauchsueberlassung540Abs1Satz1(m: Mietverhaeltnis, v: Person) defeasible {
    label de official "Der Mieter ist ohne die Erlaubnis des Vermieters nicht berechtigt, den Gebrauch der Mietsache einem Dritten zu überlassen, insbesondere sie weiter zu vermieten (§ 540 Abs. 1 Satz 1)";
    label en unofficial "Without the lessor's permission the tenant is not entitled to let a third party use the property, in particular to sublet it (§ 540 (1) sentence 1)";
    when vermieter(m, v);
    unless erlaubnis_zur_gebrauchsueberlassung_erteilt(m);
    then gebrauchsueberlassung_ohne_erlaubnis_unzulaessig(m);
}

@source(BGB_P540)
rule Verweigerung540Abs1Satz2(m: Mietverhaeltnis, mi: Person) strict {
    label de official "Verweigert der Vermieter die Erlaubnis, so kann der Mieter das Mietverhältnis außerordentlich mit der gesetzlichen Frist kündigen, sofern nicht in der Person des Dritten ein wichtiger Grund vorliegt (§ 540 Abs. 1 Satz 2)";
    label en unofficial "If the lessor refuses permission, the tenant may terminate the lease extraordinarily with the statutory notice period unless there is a compelling reason in the person of the third party (§ 540 (1) sentence 2)";
    when erlaubnis_verweigert(m) and mieter(m, mi) and not wichtiger_grund_in_der_person_des_dritten(m);
    then ausserordentliches_kuendigungsrecht_gesetzliche_frist(m, mi);
}

@source(BGB_P541)
rule Unterlassungsklage541(m: Mietverhaeltnis, v: Person) strict {
    label de official "Setzt der Mieter einen vertragswidrigen Gebrauch der Mietsache trotz einer Abmahnung des Vermieters fort, so kann dieser auf Unterlassung klagen (§ 541)";
    label en unofficial "If the tenant continues a use contrary to the contract despite a warning, the lessor may sue for an injunction (§ 541)";
    when vertragswidriger_gebrauch_fortgesetzt(m) and vermieter(m, v);
    then unterlassungsklage_zulaessig(m, v);
}

// --- §§ 542, 543, 544 Ende des Mietverhältnisses und außerordentliche fristlose Kündigung ---------

pub relation kuendigung_des(k: Kuendigung, m: Mietverhaeltnis) kind empirical {
    key(k);
    label de official "Kündigung, die dieses Miet- oder Pachtverhältnis betrifft (§§ 542, 543, 568, 573, 594a)";
    label en unofficial "notice of termination concerning this lease (§§ 542, 543, 568, 573, 594a)";
}
pub relation kuendigung_erklaert_am(k: Kuendigung, tag: Date) kind empirical {
    key(k);
    label de official "Tag, an dem die Kündigung dem anderen Teil zugeht (§§ 573c, 580a, 584, 594a)";
    label en unofficial "day on which the notice reaches the other party (§§ 573c, 580a, 584, 594a)";
}
pub relation kuendigung_durch_vermieter(k: Kuendigung) kind empirical {
    label de official "die Kündigung wird vom Vermieter erklärt (§§ 573, 573a, 573c Abs. 1 Satz 2)";
    label en unofficial "the notice is given by the lessor (§§ 573, 573a, 573c (1) sentence 2)";
}
pub relation kuendigung_schriftlich(k: Kuendigung) kind empirical {
    label de official "die Kündigung ist in schriftlicher Form erklärt (§ 568 Abs. 1, § 594f)";
    label en unofficial "the notice is given in written form (§ 568 (1), § 594f)";
}
pub relation verzug_zwei_aufeinander_folgende_termine(m: Mietverhaeltnis) kind empirical {
    label de official "der Mieter ist für zwei aufeinander folgende Termine mit der Entrichtung der Miete oder eines nicht unerheblichen Teils der Miete in Verzug (§ 543 Abs. 2 Satz 1 Nr. 3 Buchst. a)";
    label en unofficial "the tenant is in default for two consecutive dates with payment of the rent or of a not insignificant part of it (§ 543 (2) sentence 1 no. 3 lit. a)";
}
pub relation rueckstand_betrag(m: Mietverhaeltnis, betrag: Money) kind empirical {
    key(m);
    label de official "Höhe des Betrages, mit dem der Mieter in einem Zeitraum von mehr als zwei Terminen in Verzug ist (§ 543 Abs. 2 Satz 1 Nr. 3 Buchst. b)";
    label en unofficial "amount with which the tenant is in default over a period covering more than two dates (§ 543 (2) sentence 1 no. 3 lit. b)";
}
pub relation zeitraum_ueber_mehr_als_zwei_termine(m: Mietverhaeltnis) kind empirical {
    label de official "der Verzug erstreckt sich über einen Zeitraum von mehr als zwei Terminen (§ 543 Abs. 2 Satz 1 Nr. 3 Buchst. b)";
    label en unofficial "the default extends over a period covering more than two dates (§ 543 (2) sentence 1 lit. b)";
}
pub relation gebrauch_nicht_rechtzeitig_gewaehrt(m: Mietverhaeltnis) kind empirical {
    label de official "dem Mieter wird der vertragsgemäße Gebrauch ganz oder zum Teil nicht rechtzeitig gewährt oder wieder entzogen (§ 543 Abs. 2 Satz 1 Nr. 1)";
    label en unofficial "the tenant is not granted contractual use in good time, wholly or in part, or it is withdrawn again (§ 543 (2) sentence 1 no. 1)";
}
pub relation mietsache_erheblich_gefaehrdet_oder_unbefugt_ueberlassen(m: Mietverhaeltnis) kind empirical {
    label de official "der Mieter verletzt die Rechte des Vermieters in erheblichem Maße, indem er die Mietsache erheblich gefährdet oder sie unbefugt einem Dritten überlässt (§ 543 Abs. 2 Satz 1 Nr. 2)";
    label en unofficial "the tenant substantially violates the lessor's rights by significantly endangering the property or letting a third party use it without authority (§ 543 (2) sentence 1 no. 2)";
}
pub relation vermieter_vorher_befriedigt(m: Mietverhaeltnis) kind empirical {
    label de official "der Vermieter wird vor der Kündigung befriedigt (§ 543 Abs. 2 Satz 2)";
    label en unofficial "the lessor is satisfied before the notice is given (§ 543 (2) sentence 2)";
}
pub relation abmahnung_erfolglos(m: Mietverhaeltnis) kind empirical {
    label de official "eine Abmahnung ist erfolglos geblieben (§ 543 Abs. 3 Satz 1)";
    label en unofficial "a warning has remained unsuccessful (§ 543 (3) sentence 1)";
}
pub relation abhilfefrist_erfolglos_abgelaufen(m: Mietverhaeltnis) kind empirical {
    label de official "eine zur Abhilfe bestimmte angemessene Frist ist erfolglos abgelaufen (§ 543 Abs. 3 Satz 1)";
    label en unofficial "a reasonable period fixed for remedy has expired without success (§ 543 (3) sentence 1)";
}
pub relation pflichtverletzung_aus_dem_mietvertrag(m: Mietverhaeltnis) kind empirical {
    label de official "der wichtige Grund besteht in der Verletzung einer Pflicht aus dem Mietvertrag (§ 543 Abs. 3 Satz 1)";
    label en unofficial "the compelling reason consists in the breach of a duty under the lease (§ 543 (3) sentence 1)";
}

@source(BGB_P543)
pub external judgment relation fortsetzung_nicht_zumutbar(m: Mietverhaeltnis) {
    authority Court;
    label de official "§ 543 Abs. 1 Satz 2. Dem Kündigenden kann unter Berücksichtigung aller Umstände des Einzelfalls und unter Abwägung der beiderseitigen Interessen die Fortsetzung des Mietverhältnisses nicht zugemutet werden";
    label en unofficial "§ 543 (1) sentence 2. Having regard to all the circumstances of the case and weighing the interests of both parties, the terminating party cannot reasonably be expected to continue the lease";
}

@source(BGB_P543)
pub external judgment relation teil_der_miete_nicht_unerheblich(m: Mietverhaeltnis) {
    authority Court;
    label de official "§ 543 Abs. 2 Satz 1 Nr. 3 Buchst. a. Der rückständige Teil der Miete ist nicht unerheblich — bei Wohnraum bestimmt § 569 Abs. 3 Nr. 1 die Schwelle";
    label en unofficial "§ 543 (2) sentence 1 no. 3 lit. a. The rent in arrears is not insignificant — for residential space § 569 (3) no. 1 fixes the threshold";
}

@source(BGB_P543)
pub external judgment relation frist_oder_abmahnung_entbehrlich(m: Mietverhaeltnis) {
    authority Court;
    label de official "§ 543 Abs. 3 Satz 2 Nr. 1 und 2. Eine Frist oder Abmahnung verspricht offensichtlich keinen Erfolg oder die sofortige Kündigung ist aus besonderen Gründen unter Abwägung der beiderseitigen Interessen gerechtfertigt";
    label en unofficial "§ 543 (3) sentence 2 nos. 1 and 2. A period or warning clearly offers no prospect of success, or immediate termination is justified for special reasons weighing the interests of both parties";
}

pub relation wichtiger_grund(m: Mietverhaeltnis) kind institutional {
    label de official "ein wichtiger Grund zur außerordentlichen fristlosen Kündigung liegt vor (§ 543 Abs. 1 Satz 2, Abs. 2, § 569 Abs. 1, 2, 2a)";
    label en unofficial "there is a compelling reason for extraordinary termination without notice (§ 543 (1) sentence 2, (2), § 569 (1), (2), (2a))";
}
pub relation abhilfe_entbehrlich(m: Mietverhaeltnis) kind institutional {
    label de official "es bedarf keiner Abhilfefrist und keiner Abmahnung (§ 543 Abs. 3 Satz 2, § 569 Abs. 2a Satz 3)";
    label en unofficial "no remedial period and no warning are required (§ 543 (3) sentence 2, § 569 (2a) sentence 3)";
}
pub relation fristlose_kuendigung_zulaessig(m: Mietverhaeltnis) kind institutional {
    label de official "die außerordentliche fristlose Kündigung aus wichtigem Grund ist zulässig (§ 543 Abs. 1 Satz 1, Abs. 3, § 594e Abs. 1)";
    label en unofficial "extraordinary termination without notice for a compelling reason is admissible (§ 543 (1) sentence 1, (3), § 594e (1))";
}
pub relation kuendigung_ausgeschlossen(m: Mietverhaeltnis) kind institutional {
    label de official "die Kündigung ist ausgeschlossen, weil der Vermieter vorher befriedigt wird (§ 543 Abs. 2 Satz 2)";
    label en unofficial "termination is excluded because the lessor is satisfied beforehand (§ 543 (2) sentence 2)";
}
pub relation mietverhaeltnis_endet_mit_zeitablauf(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "ein Mietverhältnis, das auf bestimmte Zeit eingegangen ist, endet mit dem Ablauf dieser Zeit (§ 542 Abs. 2, § 594 Satz 1)";
    label en unofficial "a lease entered into for a fixed term ends with the expiry of that term (§ 542 (2), § 594 sentence 1)";
}
pub relation ordentliche_kuendigung_zulaessig(m: Mietverhaeltnis) kind institutional {
    label de official "ist die Mietzeit nicht bestimmt, so kann jede Vertragspartei nach den gesetzlichen Vorschriften kündigen (§ 542 Abs. 1)";
    label en unofficial "if the lease period is not fixed, either party may terminate under the statutory provisions (§ 542 (1))";
}

@source(BGB_P542)
rule OrdentlicheKuendigung542Abs1(m: Mietverhaeltnis, v: Person) strict {
    label de official "Ist die Mietzeit nicht bestimmt, so kann jede Vertragspartei das Mietverhältnis nach den gesetzlichen Vorschriften kündigen (§ 542 Abs. 1)";
    label en unofficial "If the lease period is not fixed, either party may terminate the lease under the statutory provisions (§ 542 (1))";
    when vermieter(m, v) and not mietzeit_bestimmt(m);
    then ordentliche_kuendigung_zulaessig(m);
}

@source(BGB_P542)
rule Zeitablauf542Abs2(m: Mietverhaeltnis, e: Date) strict {
    label de official "Ein Mietverhältnis, das auf bestimmte Zeit eingegangen ist, endet mit dem Ablauf dieser Zeit (§ 542 Abs. 2)";
    label en unofficial "A lease entered into for a fixed term ends with the expiry of that term (§ 542 (2))";
    when mietzeit_bestimmt(m) and mietzeit_ende(m, e);
    then mietverhaeltnis_endet_mit_zeitablauf(m, e);
}

@source(BGB_P543)
rule WichtigerGrund543Abs1Satz2(m: Mietverhaeltnis) strict {
    label de official "Ein wichtiger Grund liegt vor, wenn dem Kündigenden unter Berücksichtigung aller Umstände des Einzelfalls und unter Abwägung der beiderseitigen Interessen die Fortsetzung des Mietverhältnisses nicht zugemutet werden kann (§ 543 Abs. 1 Satz 2)";
    label en unofficial "There is a compelling reason where the terminating party cannot reasonably be expected to continue the lease, having regard to all circumstances and weighing both parties' interests (§ 543 (1) sentence 2)";
    when fortsetzung_nicht_zumutbar(m);
    then wichtiger_grund(m);
}

@source(BGB_P543)
rule WichtigerGrund543Abs2Nr1(m: Mietverhaeltnis) strict {
    label de official "Ein wichtiger Grund liegt insbesondere vor, wenn dem Mieter der vertragsgemäße Gebrauch der Mietsache ganz oder zum Teil nicht rechtzeitig gewährt oder wieder entzogen wird (§ 543 Abs. 2 Satz 1 Nr. 1)";
    label en unofficial "There is a compelling reason in particular where the tenant is not granted contractual use in good time, wholly or in part, or it is withdrawn again (§ 543 (2) sentence 1 no. 1)";
    when gebrauch_nicht_rechtzeitig_gewaehrt(m);
    then wichtiger_grund(m);
}

@source(BGB_P543)
rule WichtigerGrund543Abs2Nr2(m: Mietverhaeltnis) strict {
    label de official "Ein wichtiger Grund liegt insbesondere vor, wenn der Mieter die Rechte des Vermieters dadurch in erheblichem Maße verletzt, dass er die Mietsache erheblich gefährdet oder sie unbefugt einem Dritten überlässt (§ 543 Abs. 2 Satz 1 Nr. 2)";
    label en unofficial "There is a compelling reason in particular where the tenant substantially violates the lessor's rights by significantly endangering the property or letting a third party use it without authority (§ 543 (2) sentence 1 no. 2)";
    when mietsache_erheblich_gefaehrdet_oder_unbefugt_ueberlassen(m);
    then wichtiger_grund(m);
}

@source(BGB_P543)
rule WichtigerGrund543Abs2Nr3a(m: Mietverhaeltnis) strict {
    label de official "Ein wichtiger Grund liegt insbesondere vor, wenn der Mieter für zwei aufeinander folgende Termine mit der Entrichtung der Miete oder eines nicht unerheblichen Teils der Miete in Verzug ist (§ 543 Abs. 2 Satz 1 Nr. 3 Buchst. a)";
    label en unofficial "There is a compelling reason in particular where the tenant is in default for two consecutive dates with the rent or a not insignificant part of it (§ 543 (2) sentence 1 no. 3 lit. a)";
    when verzug_zwei_aufeinander_folgende_termine(m) and teil_der_miete_nicht_unerheblich(m);
    then wichtiger_grund(m);
}

@source(BGB_P543)
rule WichtigerGrund543Abs2Nr3b(m: Mietverhaeltnis, rueckstand: Money, miete: Money) strict {
    label de official "Ein wichtiger Grund liegt insbesondere vor, wenn der Mieter in einem Zeitraum, der sich über mehr als zwei Termine erstreckt, mit einem Betrag in Verzug ist, der die Miete für zwei Monate erreicht (§ 543 Abs. 2 Satz 1 Nr. 3 Buchst. b)";
    label en unofficial "There is a compelling reason in particular where, over a period covering more than two dates, the tenant is in default with an amount reaching the rent for two months (§ 543 (2) sentence 1 no. 3 lit. b)";
    when zeitraum_ueber_mehr_als_zwei_termine(m) and rueckstand_betrag(m, rueckstand)
     and miete_monatlich(m, miete) and rueckstand >= miete * 2;
    then wichtiger_grund(m);
}

@source(BGB_P543)
rule KuendigungAusgeschlossen543Abs2Satz2(m: Mietverhaeltnis) strict {
    label de official "Im Falle des Satzes 1 Nr. 3 ist die Kündigung ausgeschlossen, wenn der Vermieter vorher befriedigt wird (§ 543 Abs. 2 Satz 2)";
    label en unofficial "In the case of sentence 1 no. 3 termination is excluded if the lessor is satisfied beforehand (§ 543 (2) sentence 2)";
    when vermieter_vorher_befriedigt(m);
    then kuendigung_ausgeschlossen(m);
}

@source(BGB_P543)
rule AbhilfeEntbehrlich543Abs3Satz2Nr1Nr2(m: Mietverhaeltnis) strict {
    label de official "Die Abhilfefrist und die Abmahnung sind entbehrlich, wenn eine Frist oder Abmahnung offensichtlich keinen Erfolg verspricht oder die sofortige Kündigung aus besonderen Gründen gerechtfertigt ist (§ 543 Abs. 3 Satz 2 Nr. 1 und 2)";
    label en unofficial "A remedial period and a warning are dispensable where they clearly offer no prospect of success or immediate termination is justified for special reasons (§ 543 (3) sentence 2 nos. 1 and 2)";
    when frist_oder_abmahnung_entbehrlich(m);
    then abhilfe_entbehrlich(m);
}

@source(BGB_P543)
rule AbhilfeEntbehrlich543Abs3Satz2Nr3(m: Mietverhaeltnis) strict {
    label de official "Die Abhilfefrist und die Abmahnung sind entbehrlich, wenn der Mieter mit der Entrichtung der Miete im Sinne des Absatzes 2 Nr. 3 in Verzug ist (§ 543 Abs. 3 Satz 2 Nr. 3)";
    label en unofficial "A remedial period and a warning are dispensable where the tenant is in default with the rent within the meaning of subsection (2) no. 3 (§ 543 (3) sentence 2 no. 3)";
    when verzug_zwei_aufeinander_folgende_termine(m);
    then abhilfe_entbehrlich(m);
}

@source(BGB_P543)
rule FristloseKuendigungOhnePflichtverletzung543Abs1(m: Mietverhaeltnis) defeasible {
    label de official "Jede Vertragspartei kann das Mietverhältnis aus wichtigem Grund außerordentlich fristlos kündigen; besteht der wichtige Grund nicht in der Verletzung einer Pflicht aus dem Mietvertrag, so bedarf es keiner Abhilfefrist (§ 543 Abs. 1 Satz 1, Abs. 3 Satz 1 im Umkehrschluss)";
    label en unofficial "Either party may terminate the lease without notice for a compelling reason; where the compelling reason is not a breach of a duty under the lease, no remedial period is required (§ 543 (1) sentence 1, (3) sentence 1 a contrario)";
    when wichtiger_grund(m) and not pflichtverletzung_aus_dem_mietvertrag(m);
    unless kuendigung_ausgeschlossen(m);
    then fristlose_kuendigung_zulaessig(m);
}

@source(BGB_P543)
rule FristloseKuendigungNachAbhilfe543Abs3Satz1(m: Mietverhaeltnis) defeasible {
    label de official "Besteht der wichtige Grund in der Verletzung einer Pflicht aus dem Mietvertrag, so ist die Kündigung erst nach erfolglosem Ablauf einer zur Abhilfe bestimmten angemessenen Frist oder nach erfolgloser Abmahnung zulässig (§ 543 Abs. 3 Satz 1)";
    label en unofficial "Where the compelling reason is a breach of a duty under the lease, termination is admissible only after a reasonable remedial period has expired without success or a warning has been unsuccessful (§ 543 (3) sentence 1)";
    when wichtiger_grund(m) and pflichtverletzung_aus_dem_mietvertrag(m) and abhilfefrist_erfolglos_abgelaufen(m);
    unless kuendigung_ausgeschlossen(m);
    then fristlose_kuendigung_zulaessig(m);
}

@source(BGB_P543)
rule FristloseKuendigungNachAbmahnung543Abs3Satz1(m: Mietverhaeltnis) defeasible {
    label de official "Die Kündigung ist auch nach erfolgloser Abmahnung zulässig (§ 543 Abs. 3 Satz 1 Alt. 2)";
    label en unofficial "Termination is also admissible after an unsuccessful warning (§ 543 (3) sentence 1 alt. 2)";
    when wichtiger_grund(m) and pflichtverletzung_aus_dem_mietvertrag(m) and abmahnung_erfolglos(m);
    unless kuendigung_ausgeschlossen(m);
    then fristlose_kuendigung_zulaessig(m);
}

@source(BGB_P543)
rule FristloseKuendigungOhneAbhilfe543Abs3Satz2(m: Mietverhaeltnis) defeasible {
    label de official "Die Abhilfefrist und die Abmahnung entfallen in den Fällen des § 543 Abs. 3 Satz 2 (§ 543 Abs. 3 Satz 2)";
    label en unofficial "The remedial period and the warning are dispensed with in the cases of § 543 (3) sentence 2 (§ 543 (3) sentence 2)";
    when wichtiger_grund(m) and pflichtverletzung_aus_dem_mietvertrag(m) and abhilfe_entbehrlich(m);
    unless kuendigung_ausgeschlossen(m);
    then fristlose_kuendigung_zulaessig(m);
}

// --- § 544 Vertrag über mehr als 30 Jahre ---------------------------------------------------------

pub relation vertrag_laenger_als_dreissig_jahre(m: Mietverhaeltnis) kind empirical {
    label de official "der Mietvertrag ist für eine längere Zeit als 30 Jahre geschlossen (§ 544 Satz 1, § 594b Satz 1)";
    label en unofficial "the lease was concluded for a period longer than 30 years (§ 544 sentence 1, § 594b sentence 1)";
}
pub relation vertrag_auf_lebenszeit(m: Mietverhaeltnis) kind empirical {
    label de official "der Vertrag ist für die Lebenszeit des Vermieters oder des Mieters geschlossen (§ 544 Satz 2, § 594b Satz 2)";
    label en unofficial "the contract was concluded for the lifetime of the lessor or the tenant (§ 544 sentence 2, § 594b sentence 2)";
}
pub relation dreissigjahresfrist_ende(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag, mit dessen Ablauf 30 Jahre nach Überlassung der Mietsache verstrichen sind (§ 544 Satz 1) — Jahresschritt nach § 188 Abs. 2, Politik BGB_MIETE_KALENDER";
    label en unofficial "day at whose end 30 years since handover have elapsed (§ 544 sentence 1) — yearly step under § 188 (2), policy BGB_MIETE_KALENDER";
}

@source(BGB_P544)
rule Dreissigjahresfrist544Satz1(m: Mietverhaeltnis, u: Date) strict {
    label de official "Wird ein Mietvertrag für eine längere Zeit als 30 Jahre geschlossen, so kann jede Vertragspartei nach Ablauf von 30 Jahren nach Überlassung der Mietsache außerordentlich mit der gesetzlichen Frist kündigen (§ 544 Satz 1)";
    label en unofficial "Where a lease is concluded for longer than 30 years, either party may terminate extraordinarily with the statutory notice period after 30 years since handover (§ 544 sentence 1)";
    when vertrag_laenger_als_dreissig_jahre(m) and ueberlassung_am(m, u);
    then dreissigjahresfrist_ende(m, add_calendar_period(u, 30 calendar_year));
}

pub relation kuendigungsrecht_544(m: Mietverhaeltnis) kind institutional {
    label de official "nach Ablauf von 30 Jahren nach Überlassung besteht das außerordentliche Kündigungsrecht mit der gesetzlichen Frist; es ist unzulässig, wenn der Vertrag für die Lebenszeit einer Partei geschlossen ist (§ 544)";
    label en unofficial "after 30 years since handover the right of extraordinary termination with the statutory notice period exists; it is inadmissible where the contract was concluded for the lifetime of a party (§ 544)";
}

@source(BGB_P544)
rule Kuendigungsrecht544Satz1(m: Mietverhaeltnis, e: Date) defeasible {
    label de official "Nach Ablauf von 30 Jahren steht jeder Vertragspartei das außerordentliche Kündigungsrecht mit der gesetzlichen Frist zu; die Kündigung ist unzulässig, wenn der Vertrag für die Lebenszeit des Vermieters oder des Mieters geschlossen worden ist (§ 544)";
    label en unofficial "After 30 years each party has the right of extraordinary termination with the statutory notice period; termination is inadmissible where the contract was concluded for the lifetime of the lessor or the tenant (§ 544)";
    when dreissigjahresfrist_ende(m, e);
    unless vertrag_auf_lebenszeit(m);
    then kuendigungsrecht_544(m);
}

@source(BGB_P544)
rule Kuendigungsrecht544Vermieter(m: Mietverhaeltnis, v: Person) defeasible {
    label de official "Das Kündigungsrecht des § 544 Satz 1 steht dem Vermieter zu; der Träger des Rechts wird eine Stufe über der poraussierbaren Kopfregel benannt (§190, LDC-E4101)";
    label en unofficial "The right of § 544 sentence 1 vests in the lessor; the holder is named one layer above the defeasible head rule (§190, LDC-E4101)";
    when kuendigungsrecht_544(m) and vermieter(m, v);
    then ausserordentliches_kuendigungsrecht_gesetzliche_frist(m, v);
}

@source(BGB_P544)
rule Kuendigungsrecht544Mieter(m: Mietverhaeltnis, mi: Person) defeasible {
    label de official "Das Kündigungsrecht des § 544 Satz 1 steht ebenso dem Mieter zu (§ 544 Satz 1: „jede Vertragspartei“)";
    label en unofficial "The right of § 544 sentence 1 equally vests in the tenant (§ 544 sentence 1: “either party”)";
    when kuendigungsrecht_544(m) and mieter(m, mi);
    then ausserordentliches_kuendigungsrecht_gesetzliche_frist(m, mi);
}

// --- § 545 Stillschweigende Verlängerung: zwei Wochen ---------------------------------------------

pub relation gebrauch_nach_ablauf_fortgesetzt_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, an dem der Mieter nach Ablauf der Mietzeit den Gebrauch der Mietsache fortsetzt (§ 545 Satz 1, Satz 2 Nr. 1)";
    label en unofficial "day on which the tenant continues use after expiry of the lease period (§ 545 sentence 1, sentence 2 no. 1)";
}
pub relation vermieter_kenntnis_von_fortsetzung_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Zeitpunkt, in dem der Vermieter von der Fortsetzung Kenntnis erhält (§ 545 Satz 2 Nr. 2) — festgestellte Tatsache";
    label en unofficial "point in time at which the lessor learns of the continuation (§ 545 sentence 2 no. 2) — established fact";
}
pub relation entgegenstehender_wille_erklaert_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, an dem eine Vertragspartei ihren entgegenstehenden Willen dem anderen Teil erklärt (§ 545 Satz 1)";
    label en unofficial "day on which a party declares its contrary intention to the other party (§ 545 sentence 1)";
}
pub relation widerspruchsfrist_545_kalenderende(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "kalendarisches Ende der zwei Wochen des § 545 Satz 1 vor Anwendung des § 193 — gerechnet vom Tag der Fortsetzung des Gebrauchs (Satz 2 Nr. 1)";
    label en unofficial "calendar end of the two weeks of § 545 sentence 1 before applying § 193 — counted from the day use was continued (sentence 2 no. 1)";
}
pub relation widerspruchsfrist_545_ende(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag, mit dessen Ablauf die Frist des § 545 Satz 1 endet (§ 188 Abs. 2, § 193)";
    label en unofficial "day at whose end the period of § 545 sentence 1 expires (§ 188 (2), § 193)";
}
pub relation mietverhaeltnis_auf_unbestimmte_zeit_verlaengert(m: Mietverhaeltnis) kind institutional {
    label de official "das Mietverhältnis verlängert sich auf unbestimmte Zeit (§ 545 Satz 1)";
    label en unofficial "the lease is extended for an indefinite period (§ 545 sentence 1)";
}
pub relation entgegenstehender_wille_rechtzeitig(m: Mietverhaeltnis) kind institutional {
    label de official "der entgegenstehende Wille ist innerhalb von zwei Wochen erklärt (§ 545 Satz 1)";
    label en unofficial "the contrary intention was declared within two weeks (§ 545 sentence 1)";
}

@source(BGB_P545)
rule Widerspruchsfrist545Kalenderende(m: Mietverhaeltnis, f: Date) strict {
    label de official "Die Frist von zwei Wochen beginnt für den Mieter mit der Fortsetzung des Gebrauchs (§ 545 Satz 2 Nr. 1); sie ist nach Wochen bestimmt und endet mit dem Ablauf des Tages der zweiten Woche, welcher durch seine Benennung dem Tag des Ereignisses entspricht (§ 188 Abs. 2, Politik BGB_MIETE_KALENDER)";
    label en unofficial "The two-week period begins for the tenant with the continuation of use (§ 545 sentence 2 no. 1); being fixed by weeks it ends with the day of the second week corresponding by name to the event day (§ 188 (2), policy BGB_MIETE_KALENDER)";
    when gebrauch_nach_ablauf_fortgesetzt_am(m, f);
    then widerspruchsfrist_545_kalenderende(m, add_calendar_period(f, 2 calendar_week));
}

@source(BGB_P545)
rule Widerspruchsfrist545Verlegung193(m: Mietverhaeltnis, k: Date) strict {
    label de official "Innerhalb der Frist ist eine Willenserklärung abzugeben; fällt der letzte Tag auf einen Sonntag, einen anerkannten Feiertag oder einen Sonnabend, so tritt an seine Stelle der nächste Werktag (§ 193)";
    label en unofficial "A declaration of intention must be made within the period; if the last day falls on a Sunday, a recognised public holiday or a Saturday, the next working day takes its place (§ 193)";
    when widerspruchsfrist_545_kalenderende(m, k);
    then widerspruchsfrist_545_ende(m, add_business_days(k, 1 business_day));
}

@source(BGB_P545)
rule EntgegenstehenderWilleRechtzeitig545(m: Mietverhaeltnis, e: Date, w: Date) strict {
    label de official "Der entgegenstehende Wille ist rechtzeitig erklärt, wenn die Erklärung dem anderen Teil bis zum Ablauf der Frist zugeht (§ 545 Satz 1)";
    label en unofficial "The contrary intention is declared in good time if the declaration reaches the other party by the end of the period (§ 545 sentence 1)";
    when widerspruchsfrist_545_ende(m, e) and entgegenstehender_wille_erklaert_am(m, w) and w <= e;
    then entgegenstehender_wille_rechtzeitig(m);
}

@source(BGB_P545)
rule StillschweigendeVerlaengerung545(m: Mietverhaeltnis, f: Date) defeasible {
    label de official "Setzt der Mieter nach Ablauf der Mietzeit den Gebrauch der Mietsache fort, so verlängert sich das Mietverhältnis auf unbestimmte Zeit, sofern nicht eine Vertragspartei ihren entgegenstehenden Willen innerhalb von zwei Wochen dem anderen Teil erklärt (§ 545 Satz 1)";
    label en unofficial "If the tenant continues use after expiry of the lease period, the lease is extended for an indefinite period unless a party declares its contrary intention to the other within two weeks (§ 545 sentence 1)";
    when gebrauch_nach_ablauf_fortgesetzt_am(m, f);
    unless entgegenstehender_wille_rechtzeitig(m);
    then mietverhaeltnis_auf_unbestimmte_zeit_verlaengert(m);
}

// --- §§ 546, 546a, 547 Rückgabe, Entschädigung, Erstattung ----------------------------------------

pub relation rueckgabe_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, an dem der Vermieter die Mietsache zurückerhält (§ 546 Abs. 1, § 548 Abs. 1 Satz 2) — festgestellte Tatsache";
    label en unofficial "day on which the lessor receives the property back (§ 546 (1), § 548 (1) sentence 2) — established fact";
}
pub relation sache_nicht_zurueckgegeben(m: Mietverhaeltnis) kind empirical {
    label de official "der Mieter gibt die Mietsache nach Beendigung des Mietverhältnisses nicht zurück (§ 546a Abs. 1, § 571 Abs. 1, § 584b, § 597)";
    label en unofficial "the tenant does not return the property after termination of the lease (§ 546a (1), § 571 (1), § 584b, § 597)";
}
pub relation gebrauch_einem_dritten_ueberlassen(m: Mietverhaeltnis) kind empirical {
    label de official "der Mieter hat den Gebrauch der Mietsache einem Dritten überlassen (§ 546 Abs. 2, § 596 Abs. 3)";
    label en unofficial "the tenant has let a third party use the property (§ 546 (2), § 596 (3))";
}
pub relation miete_im_voraus_entrichtet(m: Mietverhaeltnis, betrag: Money) kind empirical {
    key(m);
    label de official "für die Zeit nach Beendigung des Mietverhältnisses im Voraus entrichtete Miete (§ 547 Abs. 1 Satz 1)";
    label en unofficial "rent paid in advance for the period after termination of the lease (§ 547 (1) sentence 1)";
}
pub relation vermieter_hat_beendigung_zu_vertreten(m: Mietverhaeltnis) kind empirical {
    label de official "der Vermieter hat die Beendigung des Mietverhältnisses zu vertreten (§ 547 Abs. 1 Satz 2 im Umkehrschluss)";
    label en unofficial "the lessor is responsible for the termination of the lease (§ 547 (1) sentence 2 a contrario)";
}

pub relation rueckgabepflicht(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "Pflicht des Mieters, die Mietsache nach Beendigung des Mietverhältnisses zurückzugeben (§ 546 Abs. 1, § 596 Abs. 1)";
    label en unofficial "tenant's duty to return the property after termination of the lease (§ 546 (1), § 596 (1))";
}
pub relation rueckforderung_vom_dritten(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "der Vermieter kann die Sache nach Beendigung des Mietverhältnisses auch von dem Dritten zurückfordern (§ 546 Abs. 2, § 596 Abs. 3)";
    label en unofficial "after termination the lessor may also demand the property back from the third party (§ 546 (2), § 596 (3))";
}
pub relation entschaedigung_bei_vorenthaltung(m: Mietverhaeltnis, betrag: Money) kind institutional {
    key(m);
    label de official "Entschädigung für die Dauer der Vorenthaltung in Höhe der vereinbarten Miete (§ 546a Abs. 1, § 597 Satz 1)";
    label en unofficial "compensation for the duration of the withholding in the amount of the agreed rent (§ 546a (1), § 597 sentence 1)";
}
pub relation weiterer_schaden_nicht_ausgeschlossen(m: Mietverhaeltnis) kind institutional {
    label de official "die Geltendmachung eines weiteren Schadens ist nicht ausgeschlossen (§ 546a Abs. 2, § 584b Satz 2, § 597 Satz 2)";
    label en unofficial "the assertion of further damage is not excluded (§ 546a (2), § 584b sentence 2, § 597 sentence 2)";
}
pub relation erstattung_vorausgezahlter_miete(m: Mietverhaeltnis, betrag: Money) kind institutional {
    key(m);
    label de official "der Vermieter hat die im Voraus entrichtete Miete zurückzuerstatten und ab Empfang zu verzinsen (§ 547 Abs. 1 Satz 1)";
    label en unofficial "the lessor must refund the rent paid in advance and pay interest on it from receipt (§ 547 (1) sentence 1)";
}

@source(BGB_P546)
rule Rueckgabepflicht546Abs1(m: Mietverhaeltnis, mi: Person, e: Date) strict {
    label de official "Der Mieter ist verpflichtet, die Mietsache nach Beendigung des Mietverhältnisses zurückzugeben (§ 546 Abs. 1)";
    label en unofficial "The tenant is obliged to return the leased property after termination of the lease (§ 546 (1))";
    when mieter(m, mi) and beendigung_am(m, e);
    then rueckgabepflicht(m, mi);
}

@source(BGB_P546)
rule RueckforderungVomDritten546Abs2(m: Mietverhaeltnis, v: Person, e: Date) strict {
    label de official "Hat der Mieter den Gebrauch der Mietsache einem Dritten überlassen, so kann der Vermieter die Sache nach Beendigung des Mietverhältnisses auch von dem Dritten zurückfordern (§ 546 Abs. 2)";
    label en unofficial "Where the tenant has let a third party use the property, after termination the lessor may also demand it back from the third party (§ 546 (2))";
    when gebrauch_einem_dritten_ueberlassen(m) and vermieter(m, v) and beendigung_am(m, e);
    then rueckforderung_vom_dritten(m, v);
}

@source(BGB_P546a)
rule Entschaedigung546aAbs1(m: Mietverhaeltnis, miete: Money) strict {
    label de official "Gibt der Mieter die Mietsache nach Beendigung des Mietverhältnisses nicht zurück, so kann der Vermieter für die Dauer der Vorenthaltung als Entschädigung die vereinbarte Miete verlangen (§ 546a Abs. 1)";
    label en unofficial "If the tenant does not return the property after termination, the lessor may demand the agreed rent as compensation for the duration of the withholding (§ 546a (1))";
    when sache_nicht_zurueckgegeben(m) and miete_monatlich(m, miete);
    then entschaedigung_bei_vorenthaltung(m, miete);
}

@source(BGB_P546a)
rule WeitererSchaden546aAbs2(m: Mietverhaeltnis, betrag: Money) strict {
    label de official "Die Geltendmachung eines weiteren Schadens ist nicht ausgeschlossen (§ 546a Abs. 2)";
    label en unofficial "The assertion of further damage is not excluded (§ 546a (2))";
    when entschaedigung_bei_vorenthaltung(m, betrag);
    then weiterer_schaden_nicht_ausgeschlossen(m);
}

@source(BGB_P547)
rule Erstattung547Abs1Satz1(m: Mietverhaeltnis, betrag: Money) strict {
    label de official "Ist die Miete für die Zeit nach Beendigung des Mietverhältnisses im Voraus entrichtet worden, so hat der Vermieter sie zurückzuerstatten und ab Empfang zu verzinsen (§ 547 Abs. 1 Satz 1)";
    label en unofficial "If rent has been paid in advance for the period after termination, the lessor must refund it and pay interest from receipt (§ 547 (1) sentence 1)";
    when miete_im_voraus_entrichtet(m, betrag) and vermieter_hat_beendigung_zu_vertreten(m);
    then erstattung_vorausgezahlter_miete(m, betrag);
}

// --- § 548 Verjährung der Ersatzansprüche: sechs Monate -------------------------------------------

pub relation ersatzanspruch_des_vermieters(m: Mietverhaeltnis) kind empirical {
    label de official "Ersatzanspruch des Vermieters wegen Veränderungen oder Verschlechterungen der Mietsache (§ 548 Abs. 1 Satz 1, § 591b Abs. 1)";
    label en unofficial "lessor's claim for compensation for changes or deterioration of the property (§ 548 (1) sentence 1, § 591b (1))";
}
pub relation ersatzanspruch_des_mieters(m: Mietverhaeltnis) kind empirical {
    label de official "Anspruch des Mieters auf Ersatz von Aufwendungen oder auf Gestattung der Wegnahme einer Einrichtung (§ 548 Abs. 2, § 591b Abs. 1)";
    label en unofficial "tenant's claim for reimbursement of expenses or for permission to remove a fixture (§ 548 (2), § 591b (1))";
}
pub relation verjaehrung_548_vermieter_ende(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag, mit dessen Ablauf die sechsmonatige Verjährung der Ersatzansprüche des Vermieters endet (§ 548 Abs. 1, § 188 Abs. 2) — die Verjährung tritt mit Zeitablauf ein, § 193 verlegt nichts";
    label en unofficial "day at whose end the six-month limitation of the lessor's claims expires (§ 548 (1), § 188 (2)) — limitation occurs by lapse of time, § 193 shifts nothing";
}
pub relation verjaehrung_548_mieter_ende(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag, mit dessen Ablauf die sechsmonatige Verjährung der Ansprüche des Mieters endet (§ 548 Abs. 2, § 188 Abs. 2)";
    label en unofficial "day at whose end the six-month limitation of the tenant's claims expires (§ 548 (2), § 188 (2))";
}

@source(BGB_P548)
rule Verjaehrung548Abs1(m: Mietverhaeltnis, r: Date) strict {
    label de official "Die Ersatzansprüche des Vermieters wegen Veränderungen oder Verschlechterungen der Mietsache verjähren in sechs Monaten; die Verjährung beginnt mit dem Zeitpunkt, in dem er die Mietsache zurückerhält (§ 548 Abs. 1 Satz 1 und 2)";
    label en unofficial "The lessor's claims for compensation for changes or deterioration are time-barred after six months; limitation begins when he receives the property back (§ 548 (1) sentences 1 and 2)";
    when ersatzanspruch_des_vermieters(m) and rueckgabe_am(m, r);
    then verjaehrung_548_vermieter_ende(m, add_calendar_period(r, 6 calendar_month));
}

@source(BGB_P548)
rule Verjaehrung548Abs2(m: Mietverhaeltnis, e: Date) strict {
    label de official "Ansprüche des Mieters auf Ersatz von Aufwendungen oder auf Gestattung der Wegnahme einer Einrichtung verjähren in sechs Monaten nach der Beendigung des Mietverhältnisses (§ 548 Abs. 2)";
    label en unofficial "The tenant's claims for reimbursement of expenses or for permission to remove a fixture are time-barred six months after termination of the lease (§ 548 (2))";
    when ersatzanspruch_des_mieters(m) and beendigung_am(m, e);
    then verjaehrung_548_mieter_ende(m, add_calendar_period(e, 6 calendar_month));
}

// --- § 548a Miete digitaler Produkte ---------------------------------------------------------------

pub relation vorschriften_ueber_sachmiete_anwendbar(m: Mietverhaeltnis) kind institutional {
    label de official "die Vorschriften über die Miete von Sachen sind auf die Miete digitaler Produkte entsprechend anzuwenden (§ 548a)";
    label en unofficial "the provisions on the lease of things apply accordingly to the lease of digital products (§ 548a)";
}

@source(BGB_P548a)
rule DigitaleProdukte548a(m: Mietverhaeltnis) strict {
    label de official "Die Vorschriften über die Miete von Sachen sind auf die Miete digitaler Produkte entsprechend anzuwenden (§ 548a)";
    label en unofficial "The provisions on the lease of things apply accordingly to the lease of digital products (§ 548a)";
    when gegenstandsart(m, DigitalesProdukt);
    then vorschriften_ueber_sachmiete_anwendbar(m);
}
