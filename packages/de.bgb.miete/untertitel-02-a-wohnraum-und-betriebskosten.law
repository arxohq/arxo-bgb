// --- Untertitel 2 Kapitel 1–2 (§§ 549–556c): Anwendungsbereich, Vertrag, Kaution,
// --- Erhaltung und Modernisierung, Betriebskosten
//
// DREI GELTUNGSSTUFEN. § 549 Abs. 1 erklärt für Wohnraum die §§ 535–548 für
// anwendbar, soweit sich aus den §§ 549–577a nichts anderes ergibt. Abs. 2
// nimmt drei Gruppen von Wohnraum vom Mieterschutz aus, Abs. 3 das Studenten-
// und Jugendwohnheim. Die Ausnahmen sind ein GESCHLOSSENER Katalog des Textes
// und werden je Nummer als eigene Regel ausgeführt: die Ungleichheit von
// Aufzählungsgliedern im Guard liegt außerhalb der Fläche v1.
//
// DIE KAUTION IST DIE ERSTE RECHNUNG DES PAKETS. § 551 Abs. 1 nennt das
// Dreifache der auf einen Monat entfallenden Miete OHNE Betriebskosten —
// deshalb trägt der Fall die Nettomiete getrennt (`nettomiete_monatlich`).
// Abs. 2 Satz 1 nennt drei GLEICHE monatliche Teilzahlungen; sie entstehen
// durch EINE Division je Sicherheit (Ledger D-06-04).
//
// DIE ZWÖLF MONATE DES § 556 ABS. 3 STEHEN ZWEIMAL. Satz 2 bindet den
// Vermieter (Abrechnung nach dem Ende des Abrechnungszeitraums), Satz 5 den
// Mieter (Einwendungen nach dem Zugang der Abrechnung). Beide verlangen eine
// MITTEILUNG innerhalb der Frist, also greift § 193; beide haben eine
// Ausnahme „es sei denn, er hat die verspätete Geltendmachung nicht zu
// vertreten“ — eine Angabe des Falls, die die Sperre poraussiert.

// --- § 549 Anwendungsbereich ----------------------------------------------------------------------

pub relation nur_voruebergehender_gebrauch(m: Mietverhaeltnis) kind empirical {
    label de official "Wohnraum, der nur zum vorübergehenden Gebrauch vermietet ist (§ 549 Abs. 2 Nr. 1, § 573c Abs. 2, § 569 Abs. 3 Nr. 1 Satz 2)";
    label en unofficial "residential space let only for temporary use (§ 549 (2) no. 1, § 573c (2), § 569 (3) no. 1 sentence 2)";
}
pub relation teil_der_vermieterwohnung_moebliert(m: Mietverhaeltnis) kind empirical {
    label de official "Wohnraum, der Teil der vom Vermieter selbst bewohnten Wohnung ist und den der Vermieter überwiegend mit Einrichtungsgegenständen auszustatten hat, ohne dauernden Gebrauch mit Familie oder Haushalt (§ 549 Abs. 2 Nr. 2)";
    label en unofficial "residential space forming part of the lessor's own dwelling and furnished predominantly by the lessor, not let for permanent use with family or household (§ 549 (2) no. 2)";
}
pub relation traeger_fuer_dringenden_wohnungsbedarf(m: Mietverhaeltnis) kind empirical {
    label de official "Wohnraum, den eine juristische Person des öffentlichen Rechts oder ein anerkannter privater Träger der Wohlfahrtspflege angemietet hat, um ihn Personen mit dringendem Wohnungsbedarf zu überlassen, mit Hinweis bei Vertragsschluss (§ 549 Abs. 2 Nr. 3)";
    label en unofficial "residential space rented by a public-law legal person or a recognised private welfare provider in order to let it to persons in urgent need of housing, with notice on conclusion (§ 549 (2) no. 3)";
}
pub relation studenten_oder_jugendwohnheim(m: Mietverhaeltnis) kind empirical {
    label de official "Wohnraum in einem Studenten- oder Jugendwohnheim (§ 549 Abs. 3, § 551 Abs. 3 Satz 5)";
    label en unofficial "residential space in a student or youth hostel (§ 549 (3), § 551 (3) sentence 5)";
}

pub relation allgemeine_vorschriften_anwendbar(m: Mietverhaeltnis) kind institutional {
    label de official "für das Mietverhältnis über Wohnraum gelten die §§ 535 bis 548, soweit sich nicht aus den §§ 549 bis 577a etwas anderes ergibt (§ 549 Abs. 1)";
    label en unofficial "§§ 535 to 548 apply to the residential lease unless §§ 549 to 577a provide otherwise (§ 549 (1))";
}
pub relation mieterschutzvorschriften_ausgeschlossen(m: Mietverhaeltnis) kind institutional {
    label de official "die Vorschriften über die Miethöhe bei Mietbeginn, die Mieterhöhung und den Mieterschutz bei Beendigung gelten für dieses Mietverhältnis nicht (§ 549 Abs. 2, Abs. 3)";
    label en unofficial "the provisions on the level of rent at the start, on increases in rent and on tenant protection at termination do not apply to this lease (§ 549 (2), (3))";
}

@source(BGB_P549)
rule Anwendungsbereich549Abs1(m: Mietverhaeltnis) strict {
    label de official "Für Mietverhältnisse über Wohnraum gelten die §§ 535 bis 548, soweit sich nicht aus den §§ 549 bis 577a etwas anderes ergibt (§ 549 Abs. 1)";
    label en unofficial "For residential leases §§ 535 to 548 apply unless §§ 549 to 577a provide otherwise (§ 549 (1))";
    when gegenstandsart(m, Wohnraum);
    then allgemeine_vorschriften_anwendbar(m);
}

@source(BGB_P549)
rule Ausnahme549Abs2Nr1(m: Mietverhaeltnis) strict {
    label de official "Die genannten Vorschriften gelten nicht für Mietverhältnisse über Wohnraum, der nur zum vorübergehenden Gebrauch vermietet ist (§ 549 Abs. 2 Nr. 1)";
    label en unofficial "Those provisions do not apply to leases of residential space let only for temporary use (§ 549 (2) no. 1)";
    when gegenstandsart(m, Wohnraum) and nur_voruebergehender_gebrauch(m);
    then mieterschutzvorschriften_ausgeschlossen(m);
}

@source(BGB_P549)
rule Ausnahme549Abs2Nr2(m: Mietverhaeltnis) strict {
    label de official "Die genannten Vorschriften gelten nicht für Wohnraum, der Teil der vom Vermieter selbst bewohnten Wohnung ist und den der Vermieter überwiegend mit Einrichtungsgegenständen auszustatten hat (§ 549 Abs. 2 Nr. 2)";
    label en unofficial "Those provisions do not apply to residential space forming part of the lessor's own dwelling and furnished predominantly by the lessor (§ 549 (2) no. 2)";
    when gegenstandsart(m, Wohnraum) and teil_der_vermieterwohnung_moebliert(m);
    then mieterschutzvorschriften_ausgeschlossen(m);
}

@source(BGB_P549)
rule Ausnahme549Abs2Nr3(m: Mietverhaeltnis) strict {
    label de official "Die genannten Vorschriften gelten nicht für Wohnraum, den eine juristische Person des öffentlichen Rechts oder ein anerkannter privater Träger der Wohlfahrtspflege für Personen mit dringendem Wohnungsbedarf angemietet hat (§ 549 Abs. 2 Nr. 3)";
    label en unofficial "Those provisions do not apply to residential space rented by a public-law legal person or a recognised private welfare provider for persons in urgent need of housing (§ 549 (2) no. 3)";
    when gegenstandsart(m, Wohnraum) and traeger_fuer_dringenden_wohnungsbedarf(m);
    then mieterschutzvorschriften_ausgeschlossen(m);
}

@source(BGB_P549)
rule Ausnahme549Abs3(m: Mietverhaeltnis) strict {
    label de official "Für Wohnraum in einem Studenten- oder Jugendwohnheim gelten die §§ 556d bis 561 sowie die §§ 573, 573a, 573d Abs. 1 und §§ 575, 575a Abs. 1, §§ 577, 577a nicht (§ 549 Abs. 3)";
    label en unofficial "For residential space in a student or youth hostel §§ 556d to 561 and §§ 573, 573a, 573d (1), 575, 575a (1), 577, 577a do not apply (§ 549 (3))";
    when gegenstandsart(m, Wohnraum) and studenten_oder_jugendwohnheim(m);
    then mieterschutzvorschriften_ausgeschlossen(m);
}

// --- § 550 Form des Mietvertrags ------------------------------------------------------------------

pub relation vertrag_fuer_laenger_als_ein_jahr(m: Mietverhaeltnis) kind empirical {
    label de official "der Mietvertrag ist für längere Zeit als ein Jahr geschlossen (§ 550 Satz 1, § 578 Abs. 1 Satz 2)";
    label en unofficial "the lease was concluded for a period longer than one year (§ 550 sentence 1, § 578 (1) sentence 2)";
}
pub relation schriftform_gewahrt(m: Mietverhaeltnis) kind empirical {
    label de official "der Mietvertrag ist in schriftlicher Form geschlossen (§ 550 Satz 1)";
    label en unofficial "the lease was concluded in written form (§ 550 sentence 1)";
}
pub relation gilt_fuer_unbestimmte_zeit(m: Mietverhaeltnis) kind institutional {
    label de official "der Mietvertrag gilt für unbestimmte Zeit (§ 550 Satz 1, § 585a)";
    label en unofficial "the lease is deemed to be concluded for an indefinite period (§ 550 sentence 1, § 585a)";
}
pub relation kuendigung_fruehestens_zum(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "die Kündigung ist frühestens zum Ablauf eines Jahres nach Überlassung des Wohnraums zulässig (§ 550 Satz 2)";
    label en unofficial "termination is admissible at the earliest at the end of one year after the residential space was handed over (§ 550 sentence 2)";
}

@source(BGB_P550)
rule Schriftform550Satz1(m: Mietverhaeltnis) strict {
    label de official "Wird der Mietvertrag für längere Zeit als ein Jahr nicht in schriftlicher Form geschlossen, so gilt er für unbestimmte Zeit (§ 550 Satz 1)";
    label en unofficial "If a lease for longer than one year is not concluded in written form, it is deemed to run for an indefinite period (§ 550 sentence 1)";
    when gegenstandsart(m, Wohnraum) and vertrag_fuer_laenger_als_ein_jahr(m) and not schriftform_gewahrt(m);
    then gilt_fuer_unbestimmte_zeit(m);
}

@source(BGB_P550)
rule Jahressperre550Satz2(m: Mietverhaeltnis, u: Date) strict {
    label de official "Die Kündigung ist jedoch frühestens zum Ablauf eines Jahres nach Überlassung des Wohnraums zulässig (§ 550 Satz 2) — Jahresschritt nach § 188 Abs. 2, Politik BGB_MIETE_KALENDER";
    label en unofficial "Termination is, however, admissible at the earliest at the end of one year after handover of the residential space (§ 550 sentence 2) — yearly step under § 188 (2), policy BGB_MIETE_KALENDER";
    when gilt_fuer_unbestimmte_zeit(m) and ueberlassung_am(m, u);
    then kuendigung_fruehestens_zum(m, add_calendar_period(u, 1 calendar_year));
}

// --- § 551 Begrenzung und Anlage von Mietsicherheiten ---------------------------------------------

pub relation sicherheit_des(s: Mietsicherheit, m: Mietverhaeltnis) kind empirical {
    key(s);
    label de official "Sicherheit, die der Mieter für die Erfüllung seiner Pflichten zu leisten hat (§ 551 Abs. 1)";
    label en unofficial "security the tenant has to provide for the performance of his duties (§ 551 (1))";
}
pub relation sicherheit_vereinbart_betrag(s: Mietsicherheit, betrag: Money) kind empirical {
    key(s);
    label de official "der als Sicherheit vereinbarte Betrag (§ 551 Abs. 1)";
    label en unofficial "the amount agreed as security (§ 551 (1))";
}
pub relation sicherheit_als_geldsumme(s: Mietsicherheit) kind empirical {
    label de official "als Sicherheit ist eine Geldsumme bereitzustellen (§ 551 Abs. 2 Satz 1)";
    label en unofficial "a sum of money is to be provided as security (§ 551 (2) sentence 1)";
}
pub relation mietverhaeltnis_beginn_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Beginn des Mietverhältnisses (§ 551 Abs. 2 Satz 2, § 556e Abs. 2 Satz 2, § 556g Abs. 2 Satz 3)";
    label en unofficial "beginning of the lease (§ 551 (2) sentence 2, § 556e (2) sentence 2, § 556g (2) sentence 3)";
}

pub relation hoechstbetrag_der_sicherheit(s: Mietsicherheit, betrag: Money) kind institutional {
    key(s);
    label de official "die Sicherheit darf höchstens das Dreifache der auf einen Monat entfallenden Miete ohne die als Pauschale oder als Vorauszahlung ausgewiesenen Betriebskosten betragen (§ 551 Abs. 1)";
    label en unofficial "the security may not exceed three times the monthly rent excluding operating costs shown as a flat rate or advance payment (§ 551 (1))";
}
pub relation sicherheit_uebersteigt_hoechstbetrag(s: Mietsicherheit) kind institutional {
    label de official "die vereinbarte Sicherheit übersteigt den Höchstbetrag des § 551 Abs. 1 — insoweit ist die Vereinbarung nach Abs. 4 unwirksam";
    label en unofficial "the agreed security exceeds the maximum of § 551 (1) — to that extent the agreement is void under subsection (4)";
}
pub relation monatliche_teilzahlung(s: Mietsicherheit, betrag: Money) kind institutional {
    key(s);
    label de official "der Mieter ist zu drei gleichen monatlichen Teilzahlungen berechtigt (§ 551 Abs. 2 Satz 1) — eine Division je Sicherheit, kaufmännisch auf den Cent gerundet";
    label en unofficial "the tenant is entitled to pay in three equal monthly instalments (§ 551 (2) sentence 1) — one division per security, rounded commercially to the cent";
}
pub relation erste_teilzahlung_faellig_am(s: Mietsicherheit, tag: Date) kind institutional {
    key(s);
    label de official "die erste Teilzahlung ist zu Beginn des Mietverhältnisses fällig (§ 551 Abs. 2 Satz 2)";
    label en unofficial "the first instalment falls due at the beginning of the lease (§ 551 (2) sentence 2)";
}
pub relation keine_verzinsungspflicht(s: Mietsicherheit) kind institutional {
    label de official "bei Wohnraum in einem Studenten- oder Jugendwohnheim besteht für den Vermieter keine Pflicht, die Sicherheitsleistung zu verzinsen (§ 551 Abs. 3 Satz 5)";
    label en unofficial "for residential space in a student or youth hostel the lessor is under no duty to pay interest on the security (§ 551 (3) sentence 5)";
}

@source(BGB_P551)
rule Hoechstbetrag551Abs1(s: Mietsicherheit, m: Mietverhaeltnis, netto: Money) strict {
    label de official "Hat der Mieter Sicherheit zu leisten, so darf diese höchstens das Dreifache der auf einen Monat entfallenden Miete ohne die als Pauschale oder als Vorauszahlung ausgewiesenen Betriebskosten betragen (§ 551 Abs. 1)";
    label en unofficial "Where the tenant has to provide security, it may not exceed three times the monthly rent excluding operating costs shown as a flat rate or advance payment (§ 551 (1))";
    when sicherheit_des(s, m) and nettomiete_monatlich(m, netto);
    then hoechstbetrag_der_sicherheit(s, netto * 3);
}

@source(BGB_P551)
rule Ueberschreitung551Abs1(s: Mietsicherheit, vereinbart: Money, hoechst: Money) strict {
    label de official "Übersteigt die vereinbarte Sicherheit den Höchstbetrag, so ist die Vereinbarung insoweit zum Nachteil des Mieters abweichend und unwirksam (§ 551 Abs. 1, Abs. 4)";
    label en unofficial "Where the agreed security exceeds the maximum, the agreement deviates to the tenant's detriment and is void to that extent (§ 551 (1), (4))";
    when sicherheit_vereinbart_betrag(s, vereinbart) and hoechstbetrag_der_sicherheit(s, hoechst)
     and vereinbart > hoechst;
    then sicherheit_uebersteigt_hoechstbetrag(s);
}

@source(BGB_P551)
rule Teilzahlungen551Abs2Satz1(s: Mietsicherheit, betrag: Money) strict {
    label de official "Ist als Sicherheit eine Geldsumme bereitzustellen, so ist der Mieter zu drei gleichen monatlichen Teilzahlungen berechtigt (§ 551 Abs. 2 Satz 1)";
    label en unofficial "Where a sum of money is to be provided as security, the tenant is entitled to pay it in three equal monthly instalments (§ 551 (2) sentence 1)";
    when sicherheit_als_geldsumme(s) and sicherheit_vereinbart_betrag(s, betrag);
    then monatliche_teilzahlung(s, div_round(betrag, 3 * 1.0, 2, "HALF_UP"));
}

@source(BGB_P551)
rule ErsteTeilzahlung551Abs2Satz2(s: Mietsicherheit, m: Mietverhaeltnis, b: Date) strict {
    label de official "Die erste Teilzahlung ist zu Beginn des Mietverhältnisses fällig (§ 551 Abs. 2 Satz 2)";
    label en unofficial "The first instalment falls due at the beginning of the lease (§ 551 (2) sentence 2)";
    when sicherheit_des(s, m) and sicherheit_als_geldsumme(s) and mietverhaeltnis_beginn_am(m, b);
    then erste_teilzahlung_faellig_am(s, b);
}

@source(BGB_P551)
rule KeineVerzinsung551Abs3Satz5(s: Mietsicherheit, m: Mietverhaeltnis) strict {
    label de official "Bei Wohnraum in einem Studenten- oder Jugendwohnheim besteht für den Vermieter keine Pflicht, die Sicherheitsleistung zu verzinsen (§ 551 Abs. 3 Satz 5)";
    label en unofficial "For residential space in a student or youth hostel the lessor is under no duty to pay interest on the security (§ 551 (3) sentence 5)";
    when sicherheit_des(s, m) and studenten_oder_jugendwohnheim(m);
    then keine_verzinsungspflicht(s);
}

// --- §§ 552–555 Wegnahmerecht, Gestattung, bauliche Veränderungen, Vertragsstrafe -----------------

pub relation abwendung_angeboten(m: Mietverhaeltnis) kind empirical {
    label de official "der Vermieter wendet die Ausübung des Wegnahmerechts durch Zahlung einer angemessenen Entschädigung ab (§ 552 Abs. 1)";
    label en unofficial "the lessor averts exercise of the right of removal by paying reasonable compensation (§ 552 (1))";
}
pub relation berechtigtes_interesse_an_ueberlassung_entstanden(m: Mietverhaeltnis) kind empirical {
    label de official "für den Mieter entsteht nach Abschluss des Mietvertrags ein Interesse, einen Teil des Wohnraums einem Dritten zum Gebrauch zu überlassen (§ 553 Abs. 1 Satz 1)";
    label en unofficial "after conclusion of the lease the tenant acquires an interest in letting a third party use part of the residential space (§ 553 (1) sentence 1)";
}
pub relation wohnraum_wuerde_uebermaessig_belegt(m: Mietverhaeltnis) kind empirical {
    label de official "der Wohnraum würde übermäßig belegt (§ 553 Abs. 1 Satz 2)";
    label en unofficial "the residential space would be overcrowded (§ 553 (1) sentence 2)";
}
pub relation bauliche_veraenderung_verlangt(m: Mietverhaeltnis) kind empirical {
    label de official "der Mieter verlangt die Erlaubnis baulicher Veränderungen, die dem Gebrauch durch Menschen mit Behinderungen, dem Laden elektrisch betriebener Fahrzeuge, dem Einbruchsschutz oder der Stromerzeugung durch Steckersolargeräte dienen (§ 554 Abs. 1 Satz 1)";
    label en unofficial "the tenant demands permission for structural alterations serving use by persons with disabilities, charging of electric vehicles, burglary protection or electricity generation by plug-in solar devices (§ 554 (1) sentence 1)";
}
pub relation vertragsstrafe_versprochen(m: Mietverhaeltnis) kind empirical {
    label de official "der Vermieter lässt sich eine Vertragsstrafe vom Mieter versprechen (§ 555)";
    label en unofficial "the lessor has the tenant promise a contractual penalty (§ 555)";
}

@source(BGB_P552)
pub external judgment relation berechtigtes_interesse_an_wegnahme(m: Mietverhaeltnis) {
    authority Court;
    label de official "§ 552 Abs. 1. Der Mieter hat ein berechtigtes Interesse an der Wegnahme";
    label en unofficial "§ 552 (1). The tenant has a legitimate interest in removal";
}

@source(BGB_P553)
pub external judgment relation ueberlassung_nicht_zumutbar(m: Mietverhaeltnis) {
    authority Court;
    label de official "§ 553 Abs. 1 Satz 2. Dem Vermieter kann die Überlassung an den Dritten aus sonstigen Gründen nicht zugemutet werden";
    label en unofficial "§ 553 (1) sentence 2. For other reasons the lessor cannot reasonably be expected to permit use by the third party";
}

@source(BGB_P554)
pub external judgment relation bauliche_veraenderung_nicht_zumutbar(m: Mietverhaeltnis) {
    authority Court;
    label de official "§ 554 Abs. 1 Satz 2. Die bauliche Veränderung kann dem Vermieter auch unter Würdigung der Interessen des Mieters nicht zugemutet werden";
    label en unofficial "§ 554 (1) sentence 2. Even weighing the tenant's interests, the lessor cannot reasonably be expected to accept the structural alteration";
}

pub relation wegnahmerecht_abgewendet(m: Mietverhaeltnis) kind institutional {
    label de official "der Vermieter kann die Ausübung des Wegnahmerechts durch Zahlung einer angemessenen Entschädigung abwenden (§ 552 Abs. 1)";
    label en unofficial "the lessor may avert exercise of the right of removal by paying reasonable compensation (§ 552 (1))";
}
pub relation anspruch_auf_erlaubnis_der_ueberlassung(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "der Mieter kann vom Vermieter die Erlaubnis verlangen, einen Teil des Wohnraums einem Dritten zum Gebrauch zu überlassen (§ 553 Abs. 1 Satz 1)";
    label en unofficial "the tenant may demand the lessor's permission to let a third party use part of the residential space (§ 553 (1) sentence 1)";
}
pub relation anspruch_auf_bauliche_veraenderung(m: Mietverhaeltnis, mi: Person) kind institutional {
    label de official "der Mieter kann verlangen, dass ihm der Vermieter die bauliche Veränderung erlaubt (§ 554 Abs. 1 Satz 1)";
    label en unofficial "the tenant may demand that the lessor permit the structural alteration (§ 554 (1) sentence 1)";
}
pub relation vertragsstrafe_unwirksam(m: Mietverhaeltnis) kind institutional {
    label de official "eine Vereinbarung, durch die sich der Vermieter eine Vertragsstrafe vom Mieter versprechen lässt, ist unwirksam (§ 555)";
    label en unofficial "an agreement by which the lessor has the tenant promise a contractual penalty is void (§ 555)";
}

@source(BGB_P552)
rule Abwendung552Abs1(m: Mietverhaeltnis) defeasible {
    label de official "Der Vermieter kann die Ausübung des Wegnahmerechts (§ 539 Abs. 2) durch Zahlung einer angemessenen Entschädigung abwenden, wenn nicht der Mieter ein berechtigtes Interesse an der Wegnahme hat (§ 552 Abs. 1)";
    label en unofficial "The lessor may avert exercise of the right of removal (§ 539 (2)) by paying reasonable compensation unless the tenant has a legitimate interest in removal (§ 552 (1))";
    when einrichtung_des_mieters(m) and abwendung_angeboten(m);
    unless berechtigtes_interesse_an_wegnahme(m);
    then wegnahmerecht_abgewendet(m);
}

@source(BGB_P553)
pub external judgment relation berechtigtes_interesse_an_ueberlassung(m: Mietverhaeltnis) {
    authority Court;
    label de official "§ 553 Abs. 1 Satz 1. Das Interesse des Mieters, einen Teil des Wohnraums einem Dritten zu überlassen, ist berechtigt";
    label en unofficial "§ 553 (1) sentence 1. The tenant's interest in letting a third party use part of the residential space is legitimate";
}

pub relation erlaubnis_der_ueberlassung_geschuldet(m: Mietverhaeltnis) kind institutional {
    label de official "die Erlaubnis zur Überlassung eines Teils des Wohnraums an einen Dritten ist geschuldet (§ 553 Abs. 1) — einstellige Kopfregel, weil die Ausnahme des Satzes 2 alle Variablen des Kopfes binden muss (§190, LDC-E4101)";
    label en unofficial "permission to let a third party use part of the residential space is owed (§ 553 (1)) — a unary head, because the exception of sentence 2 must bind every head variable (§190, LDC-E4101)";
}

@source(BGB_P553)
rule Gestattung553Abs1(m: Mietverhaeltnis) defeasible {
    label de official "Entsteht für den Mieter nach Abschluss des Mietvertrags ein berechtigtes Interesse, einen Teil des Wohnraums einem Dritten zum Gebrauch zu überlassen, so kann er von dem Vermieter die Erlaubnis hierzu verlangen; dies gilt nicht bei einem wichtigen Grund in der Person des Dritten, bei übermäßiger Belegung oder wenn die Überlassung nicht zugemutet werden kann (§ 553 Abs. 1)";
    label en unofficial "Where after conclusion of the lease the tenant acquires a legitimate interest in letting a third party use part of the space, he may demand permission; this does not apply where there is a compelling reason in the third party's person, where the space would be overcrowded, or where permission cannot reasonably be expected (§ 553 (1))";
    when gegenstandsart(m, Wohnraum) and berechtigtes_interesse_an_ueberlassung_entstanden(m)
     and berechtigtes_interesse_an_ueberlassung(m)
     and not wichtiger_grund_in_der_person_des_dritten(m) and not wohnraum_wuerde_uebermaessig_belegt(m);
    unless ueberlassung_nicht_zumutbar(m);
    then erlaubnis_der_ueberlassung_geschuldet(m);
}

@source(BGB_P553)
rule Gestattung553Abs1Traeger(m: Mietverhaeltnis, mi: Person) defeasible {
    label de official "Den Anspruch auf die Erlaubnis hat der Mieter (§ 553 Abs. 1 Satz 1); der Träger wird eine Stufe über der poraussierbaren Kopfregel benannt";
    label en unofficial "The claim to permission vests in the tenant (§ 553 (1) sentence 1); the holder is named one layer above the defeasible head rule";
    when erlaubnis_der_ueberlassung_geschuldet(m) and mieter(m, mi);
    then anspruch_auf_erlaubnis_der_ueberlassung(m, mi);
}

pub relation bauliche_veraenderung_zu_erlauben(m: Mietverhaeltnis) kind institutional {
    label de official "die bauliche Veränderung ist zu erlauben (§ 554 Abs. 1) — einstellige Kopfregel wegen der Ausnahme des Satzes 2 (§190, LDC-E4101)";
    label en unofficial "the structural alteration must be permitted (§ 554 (1)) — a unary head because of the exception in sentence 2 (§190, LDC-E4101)";
}

@source(BGB_P554)
rule BaulicheVeraenderung554Abs1(m: Mietverhaeltnis) defeasible {
    label de official "Der Mieter kann verlangen, dass ihm der Vermieter bauliche Veränderungen erlaubt, die dem Gebrauch durch Menschen mit Behinderungen, dem Laden elektrisch betriebener Fahrzeuge, dem Einbruchsschutz oder der Stromerzeugung durch Steckersolargeräte dienen; der Anspruch besteht nicht, wenn die Veränderung dem Vermieter nicht zugemutet werden kann (§ 554 Abs. 1)";
    label en unofficial "The tenant may demand permission for structural alterations serving use by persons with disabilities, charging of electric vehicles, burglary protection or plug-in solar generation; the claim does not exist where the alteration cannot reasonably be expected of the lessor (§ 554 (1))";
    when bauliche_veraenderung_verlangt(m);
    unless bauliche_veraenderung_nicht_zumutbar(m);
    then bauliche_veraenderung_zu_erlauben(m);
}

@source(BGB_P554)
rule BaulicheVeraenderung554Traeger(m: Mietverhaeltnis, mi: Person) defeasible {
    label de official "Den Anspruch auf die Erlaubnis der baulichen Veränderung hat der Mieter (§ 554 Abs. 1 Satz 1)";
    label en unofficial "The claim to permission for the structural alteration vests in the tenant (§ 554 (1) sentence 1)";
    when bauliche_veraenderung_zu_erlauben(m) and mieter(m, mi);
    then anspruch_auf_bauliche_veraenderung(m, mi);
}

@source(BGB_P555)
rule Vertragsstrafe555(m: Mietverhaeltnis) strict {
    label de official "Eine Vereinbarung, durch die sich der Vermieter eine Vertragsstrafe vom Mieter versprechen lässt, ist unwirksam (§ 555)";
    label en unofficial "An agreement by which the lessor has the tenant promise a contractual penalty is void (§ 555)";
    when gegenstandsart(m, Wohnraum) and vertragsstrafe_versprochen(m);
    then vertragsstrafe_unwirksam(m);
}

// --- §§ 555a–555f Erhaltungs- und Modernisierungsmaßnahmen ----------------------------------------

pub relation massnahme_des(ma: Modernisierungsmassnahme, m: Mietverhaeltnis) kind empirical {
    key(ma);
    label de official "Maßnahme an der Mietsache, die dieses Mietverhältnis betrifft (§§ 555a, 555b)";
    label en unofficial "measure on the leased property concerning this lease (§§ 555a, 555b)";
}
pub relation erhaltungsmassnahme(ma: Modernisierungsmassnahme) kind empirical {
    label de official "Maßnahme, die zur Instandhaltung oder Instandsetzung der Mietsache erforderlich ist (§ 555a Abs. 1)";
    label en unofficial "measure necessary for the maintenance or repair of the leased property (§ 555a (1))";
}
pub relation energieeinsparung_endenergie(ma: Modernisierungsmassnahme) kind empirical {
    label de official "bauliche Veränderung, durch die in Bezug auf die Mietsache Endenergie nachhaltig eingespart wird — energetische Modernisierung (§ 555b Nr. 1)";
    label en unofficial "structural alteration sustainably saving final energy in respect of the leased property — energy-efficiency modernisation (§ 555b no. 1)";
}
pub relation heizungsanlage_eingebaut(ma: Modernisierungsmassnahme) kind empirical {
    label de official "bauliche Veränderung, durch die eine Heizungsanlage im Sinne des § 42 des Gebäudemodernisierungsgesetzes eingebaut oder aufgestellt wird (§ 555b Nr. 1a)";
    label en unofficial "structural alteration installing or setting up a heating system within the meaning of § 42 of the Building Modernisation Act (§ 555b no. 1a)";
}
pub relation gebrauchswert_erhoeht(ma: Modernisierungsmassnahme) kind empirical {
    label de official "bauliche Veränderung, durch die der Gebrauchswert der Mietsache nachhaltig erhöht wird (§ 555b Nr. 4)";
    label en unofficial "structural alteration sustainably increasing the utility value of the leased property (§ 555b no. 4)";
}
pub relation wasserverbrauch_reduziert(ma: Modernisierungsmassnahme) kind empirical {
    label de official "bauliche Veränderung, durch die der Wasserverbrauch nachhaltig reduziert wird (§ 555b Nr. 3)";
    label en unofficial "structural alteration sustainably reducing water consumption (§ 555b no. 3)";
}
pub relation wohnverhaeltnisse_verbessert(ma: Modernisierungsmassnahme) kind empirical {
    label de official "bauliche Veränderung, durch die die allgemeinen Wohnverhältnisse auf Dauer verbessert werden (§ 555b Nr. 5)";
    label en unofficial "structural alteration permanently improving general living conditions (§ 555b no. 5)";
}
pub relation umstaende_nicht_zu_vertreten(ma: Modernisierungsmassnahme) kind empirical {
    label de official "bauliche Veränderung auf Grund von Umständen, die der Vermieter nicht zu vertreten hat und die keine Erhaltungsmaßnahme sind (§ 555b Nr. 6)";
    label en unofficial "structural alteration due to circumstances for which the lessor is not responsible and which are not maintenance measures (§ 555b no. 6)";
}
pub relation neuer_wohnraum_geschaffen(ma: Modernisierungsmassnahme) kind empirical {
    label de official "bauliche Veränderung, durch die neuer Wohnraum geschaffen wird (§ 555b Nr. 7)";
    label en unofficial "structural alteration creating new residential space (§ 555b no. 7)";
}
pub relation massnahme_beginn_geplant_am(ma: Modernisierungsmassnahme, tag: Date) kind empirical {
    key(ma);
    label de official "voraussichtlicher Beginn der Modernisierungsmaßnahme (§ 555c Abs. 1 Satz 2 Nr. 2)";
    label en unofficial "expected start of the modernisation measure (§ 555c (1) sentence 2 no. 2)";
}
pub relation ankuendigung_zugegangen_am(ma: Modernisierungsmassnahme, tag: Date) kind empirical {
    key(ma);
    label de official "Tag des Zugangs der Modernisierungsankündigung beim Mieter (§ 555d Abs. 3 Satz 1, § 555e Abs. 1 Satz 2)";
    label en unofficial "day on which the modernisation announcement reaches the tenant (§ 555d (3) sentence 1, § 555e (1) sentence 2)";
}
pub relation ankuendigung_in_textform(ma: Modernisierungsmassnahme) kind empirical {
    label de official "die Modernisierungsankündigung ist in Textform erklärt (§ 555c Abs. 1 Satz 1)";
    label en unofficial "the modernisation announcement is made in text form (§ 555c (1) sentence 1)";
}
pub relation ankuendigung_vollstaendig(ma: Modernisierungsmassnahme) kind empirical {
    label de official "die Modernisierungsankündigung enthält die Angaben des § 555c Abs. 1 Satz 2 Nr. 1 bis 3 (§ 555d Abs. 3 Satz 2)";
    label en unofficial "the announcement contains the particulars of § 555c (1) sentence 2 nos. 1 to 3 (§ 555d (3) sentence 2)";
}
pub relation nur_unerhebliche_einwirkung(ma: Modernisierungsmassnahme) kind empirical {
    label de official "die Maßnahme ist nur mit einer unerheblichen Einwirkung auf die Mietsache verbunden und führt nur zu einer unerheblichen Mieterhöhung (§ 555c Abs. 4, § 555a Abs. 2)";
    label en unofficial "the measure involves only an insignificant effect on the property and leads only to an insignificant increase in rent (§ 555c (4), § 555a (2))";
}
pub relation haerteeinwand_erklaert_am(ma: Modernisierungsmassnahme, tag: Date) kind empirical {
    key(ma);
    label de official "Tag, an dem der Mieter die eine Härte begründenden Umstände in Textform mitteilt (§ 555d Abs. 3 Satz 1)";
    label en unofficial "day on which the tenant communicates the circumstances constituting hardship in text form (§ 555d (3) sentence 1)";
}
pub relation sonderkuendigung_555e_erklaert_am(ma: Modernisierungsmassnahme, tag: Date) kind empirical {
    key(ma);
    label de official "Tag, an dem der Mieter nach Zugang der Modernisierungsankündigung außerordentlich kündigt (§ 555e Abs. 1)";
    label en unofficial "day on which the tenant gives extraordinary notice after receiving the modernisation announcement (§ 555e (1))";
}

@source(BGB_P555d)
pub external judgment relation modernisierung_bedeutet_haerte(ma: Modernisierungsmassnahme) {
    authority Court;
    label de official "§ 555d Abs. 2 Satz 1. Die Modernisierungsmaßnahme würde für den Mieter, seine Familie oder einen Angehörigen seines Haushalts eine Härte bedeuten, die auch unter Würdigung der berechtigten Interessen des Vermieters, anderer Mieter und der Belange der Energieeinsparung und des Klimaschutzes nicht zu rechtfertigen ist";
    label en unofficial "§ 555d (2) sentence 1. The modernisation would constitute hardship for the tenant, his family or a member of his household that cannot be justified even weighing the legitimate interests of the lessor, of other tenants and the concerns of energy saving and climate protection";
}

pub relation duldungspflicht_erhaltung(ma: Modernisierungsmassnahme, mi: Person) kind institutional {
    label de official "der Mieter hat Erhaltungsmaßnahmen zu dulden (§ 555a Abs. 1)";
    label en unofficial "the tenant must tolerate maintenance measures (§ 555a (1))";
}
pub relation ankuendigungspflicht_erhaltung(ma: Modernisierungsmassnahme) kind institutional {
    label de official "Erhaltungsmaßnahmen sind dem Mieter rechtzeitig anzukündigen (§ 555a Abs. 2)";
    label en unofficial "maintenance measures must be announced to the tenant in good time (§ 555a (2))";
}
pub relation modernisierungsmassnahme(ma: Modernisierungsmassnahme) kind institutional {
    label de official "die bauliche Veränderung ist eine Modernisierungsmaßnahme im Sinne des § 555b";
    label en unofficial "the structural alteration is a modernisation measure within the meaning of § 555b";
}
pub relation ankuendigung_erklaert_am(ma: Modernisierungsmassnahme, tag: Date) kind empirical {
    key(ma);
    label de official "Tag, an dem der Vermieter die Modernisierungsmaßnahme in Textform ankündigt (§ 555c Abs. 1 Satz 1)";
    label en unofficial "day on which the lessor announces the modernisation measure in text form (§ 555c (1) sentence 1)";
}
pub relation ankuendigung_plus_drei_monate(ma: Modernisierungsmassnahme, tag: Date) kind institutional {
    key(ma);
    label de official "Tag, der drei Monate nach der Modernisierungsankündigung liegt (§ 555c Abs. 1 Satz 1) — der Text nennt einen Abstand VOR dem Beginn; gerechnet wird er VORWÄRTS von der Ankündigung an (Ledger D-06-07)";
    label en unofficial "day three months after the modernisation announcement (§ 555c (1) sentence 1) — the text names a distance BEFORE the start; it is computed FORWARDS from the announcement (ledger D-06-07)";
}
pub relation ankuendigung_rechtzeitig_555c(ma: Modernisierungsmassnahme) kind institutional {
    label de official "die Modernisierungsankündigung ist spätestens drei Monate vor dem Beginn der Maßnahme erklärt (§ 555c Abs. 1 Satz 1)";
    label en unofficial "the modernisation announcement was made at the latest three months before the measure begins (§ 555c (1) sentence 1)";
}
pub relation duldungspflicht_modernisierung(ma: Modernisierungsmassnahme, mi: Person) kind institutional {
    label de official "der Mieter hat eine Modernisierungsmaßnahme zu dulden (§ 555d Abs. 1)";
    label en unofficial "the tenant must tolerate a modernisation measure (§ 555d (1))";
}
pub relation duldungspflicht_besteht(ma: Modernisierungsmassnahme) kind institutional {
    label de official "die Duldungspflicht nach § 555d Abs. 1 besteht; sie entfällt bei einer Härte nach Abs. 2 — einstellige Kopfregel wegen der Ausnahme (§190, LDC-E4101)";
    label en unofficial "the duty to tolerate under § 555d (1) exists; it lapses in case of hardship under subsection (2) — a unary head because of the exception (§190, LDC-E4101)";
}
pub relation haerteeinwand_ausschlussfrist_ende(ma: Modernisierungsmassnahme, tag: Date) kind institutional {
    key(ma);
    label de official "Ablauf des Monats, der auf den Zugang der Modernisierungsankündigung folgt: letzter Tag für die Mitteilung der Härtegründe (§ 555d Abs. 3 Satz 1)";
    label en unofficial "end of the month following receipt of the announcement: last day for communicating the grounds of hardship (§ 555d (3) sentence 1)";
}
pub relation haerteeinwand_rechtzeitig(ma: Modernisierungsmassnahme) kind institutional {
    label de official "die Härtegründe sind innerhalb der Ausschlussfrist mitgeteilt (§ 555d Abs. 3 Satz 1)";
    label en unofficial "the grounds of hardship were communicated within the cut-off period (§ 555d (3) sentence 1)";
}
pub relation sonderkuendigungsfrist_555e_ende(ma: Modernisierungsmassnahme, tag: Date) kind institutional {
    key(ma);
    label de official "Ablauf des Monats, der auf den Zugang der Modernisierungsankündigung folgt: letzter Tag für die Sonderkündigung (§ 555e Abs. 1 Satz 2)";
    label en unofficial "end of the month following receipt of the announcement: last day for the special notice (§ 555e (1) sentence 2)";
}
pub relation sonderkuendigung_555e_rechtzeitig(ma: Modernisierungsmassnahme) kind institutional {
    label de official "die Sonderkündigung ist bis zum Ablauf des Monats erklärt, der auf den Zugang der Ankündigung folgt (§ 555e Abs. 1 Satz 2)";
    label en unofficial "the special notice was given by the end of the month following receipt of the announcement (§ 555e (1) sentence 2)";
}

@source(BGB_P555a)
rule Erhaltung555aAbs1(ma: Modernisierungsmassnahme, m: Mietverhaeltnis, mi: Person) strict {
    label de official "Der Mieter hat Maßnahmen zu dulden, die zur Instandhaltung oder Instandsetzung der Mietsache erforderlich sind (§ 555a Abs. 1)";
    label en unofficial "The tenant must tolerate measures necessary for the maintenance or repair of the leased property (§ 555a (1))";
    when massnahme_des(ma, m) and erhaltungsmassnahme(ma) and mieter(m, mi);
    then duldungspflicht_erhaltung(ma, mi);
}

@source(BGB_P555a)
rule Ankuendigung555aAbs2(ma: Modernisierungsmassnahme) strict {
    label de official "Erhaltungsmaßnahmen sind dem Mieter rechtzeitig anzukündigen, es sei denn, sie sind nur mit einer unerheblichen Einwirkung auf die Mietsache verbunden oder ihre sofortige Durchführung ist zwingend erforderlich (§ 555a Abs. 2)";
    label en unofficial "Maintenance measures must be announced in good time unless they involve only an insignificant effect on the property or their immediate performance is imperative (§ 555a (2))";
    when erhaltungsmassnahme(ma) and not nur_unerhebliche_einwirkung(ma);
    then ankuendigungspflicht_erhaltung(ma);
}

@source(BGB_P555b)
rule Modernisierung555bNr1(ma: Modernisierungsmassnahme) strict {
    label de official "Modernisierungsmaßnahmen sind bauliche Veränderungen, durch die in Bezug auf die Mietsache Endenergie nachhaltig eingespart wird (§ 555b Nr. 1)";
    label en unofficial "Modernisation measures are structural alterations sustainably saving final energy in respect of the property (§ 555b no. 1)";
    when energieeinsparung_endenergie(ma);
    then modernisierungsmassnahme(ma);
}

@source(BGB_P555b)
rule Modernisierung555bNr1a(ma: Modernisierungsmassnahme) strict {
    label de official "Modernisierungsmaßnahmen sind bauliche Veränderungen, durch die eine Heizungsanlage im Sinne des § 42 des Gebäudemodernisierungsgesetzes eingebaut oder aufgestellt wird (§ 555b Nr. 1a)";
    label en unofficial "Modernisation measures are structural alterations installing or setting up a heating system within the meaning of § 42 of the Building Modernisation Act (§ 555b no. 1a)";
    when heizungsanlage_eingebaut(ma);
    then modernisierungsmassnahme(ma);
}

@source(BGB_P555b)
rule Modernisierung555bNr3(ma: Modernisierungsmassnahme) strict {
    label de official "Modernisierungsmaßnahmen sind bauliche Veränderungen, durch die der Wasserverbrauch nachhaltig reduziert wird (§ 555b Nr. 3)";
    label en unofficial "Modernisation measures are structural alterations sustainably reducing water consumption (§ 555b no. 3)";
    when wasserverbrauch_reduziert(ma);
    then modernisierungsmassnahme(ma);
}

@source(BGB_P555b)
rule Modernisierung555bNr4(ma: Modernisierungsmassnahme) strict {
    label de official "Modernisierungsmaßnahmen sind bauliche Veränderungen, durch die der Gebrauchswert der Mietsache nachhaltig erhöht wird (§ 555b Nr. 4)";
    label en unofficial "Modernisation measures are structural alterations sustainably increasing the utility value of the property (§ 555b no. 4)";
    when gebrauchswert_erhoeht(ma);
    then modernisierungsmassnahme(ma);
}

@source(BGB_P555b)
rule Modernisierung555bNr5(ma: Modernisierungsmassnahme) strict {
    label de official "Modernisierungsmaßnahmen sind bauliche Veränderungen, durch die die allgemeinen Wohnverhältnisse auf Dauer verbessert werden (§ 555b Nr. 5)";
    label en unofficial "Modernisation measures are structural alterations permanently improving general living conditions (§ 555b no. 5)";
    when wohnverhaeltnisse_verbessert(ma);
    then modernisierungsmassnahme(ma);
}

@source(BGB_P555b)
rule Modernisierung555bNr6(ma: Modernisierungsmassnahme) strict {
    label de official "Modernisierungsmaßnahmen sind bauliche Veränderungen, die auf Grund von Umständen durchgeführt werden, die der Vermieter nicht zu vertreten hat und die keine Erhaltungsmaßnahmen nach § 555a sind (§ 555b Nr. 6)";
    label en unofficial "Modernisation measures are structural alterations carried out because of circumstances for which the lessor is not responsible and which are not maintenance measures under § 555a (§ 555b no. 6)";
    when umstaende_nicht_zu_vertreten(ma) and not erhaltungsmassnahme(ma);
    then modernisierungsmassnahme(ma);
}

@source(BGB_P555b)
rule Modernisierung555bNr7(ma: Modernisierungsmassnahme) strict {
    label de official "Modernisierungsmaßnahmen sind bauliche Veränderungen, durch die neuer Wohnraum geschaffen wird (§ 555b Nr. 7)";
    label en unofficial "Modernisation measures are structural alterations creating new residential space (§ 555b no. 7)";
    when neuer_wohnraum_geschaffen(ma);
    then modernisierungsmassnahme(ma);
}

@source(BGB_P555c)
rule Ankuendigungsfrist555cAbs1(ma: Modernisierungsmassnahme, a: Date) strict {
    label de official "Der Vermieter hat dem Mieter eine Modernisierungsmaßnahme spätestens drei Monate vor ihrem Beginn in Textform anzukündigen (§ 555c Abs. 1 Satz 1) — der Abstand wird vorwärts von der Ankündigung an gerechnet, Politik BGB_MIETE_KALENDER";
    label en unofficial "The lessor must announce a modernisation measure to the tenant in text form at the latest three months before it begins (§ 555c (1) sentence 1) — the distance is computed forwards from the announcement, policy BGB_MIETE_KALENDER";
    when modernisierungsmassnahme(ma) and ankuendigung_erklaert_am(ma, a) and ankuendigung_in_textform(ma);
    then ankuendigung_plus_drei_monate(ma, add_calendar_period(a, 3 calendar_month));
}

@source(BGB_P555c)
rule AnkuendigungRechtzeitig555cAbs1(ma: Modernisierungsmassnahme, f: Date, b: Date) strict {
    label de official "Die Ankündigung ist rechtzeitig, wenn zwischen ihr und dem Beginn der Maßnahme mindestens drei Monate liegen (§ 555c Abs. 1 Satz 1)";
    label en unofficial "The announcement is in time if at least three months lie between it and the start of the measure (§ 555c (1) sentence 1)";
    when ankuendigung_plus_drei_monate(ma, f) and massnahme_beginn_geplant_am(ma, b) and f <= b;
    then ankuendigung_rechtzeitig_555c(ma);
}

@source(BGB_P555d)
rule Duldung555dAbs1(ma: Modernisierungsmassnahme) defeasible {
    label de official "Der Mieter hat eine Modernisierungsmaßnahme zu dulden; eine Duldungspflicht besteht nicht, wenn die Maßnahme für den Mieter, seine Familie oder einen Angehörigen seines Haushalts eine nicht zu rechtfertigende Härte bedeuten würde (§ 555d Abs. 1 und 2)";
    label en unofficial "The tenant must tolerate a modernisation measure; the duty does not exist where the measure would constitute unjustifiable hardship for the tenant, his family or a member of his household (§ 555d (1) and (2))";
    when modernisierungsmassnahme(ma);
    unless modernisierung_bedeutet_haerte(ma);
    then duldungspflicht_besteht(ma);
}

@source(BGB_P555d)
rule Duldung555dTraeger(ma: Modernisierungsmassnahme, m: Mietverhaeltnis, mi: Person) defeasible {
    label de official "Die Duldungspflicht trifft den Mieter (§ 555d Abs. 1)";
    label en unofficial "The duty to tolerate rests on the tenant (§ 555d (1))";
    when duldungspflicht_besteht(ma) and massnahme_des(ma, m) and mieter(m, mi);
    then duldungspflicht_modernisierung(ma, mi);
}

@source(BGB_P555d)
rule Ausschlussfrist555dAbs3(ma: Modernisierungsmassnahme, z: Date) strict {
    label de official "Der Mieter hat dem Vermieter Umstände, die eine Härte begründen, bis zum Ablauf des Monats, der auf den Zugang der Modernisierungsankündigung folgt, in Textform mitzuteilen; der Lauf der Frist beginnt nur, wenn die Ankündigung den Vorschriften des § 555c entspricht (§ 555d Abs. 3)";
    label en unofficial "The tenant must communicate circumstances constituting hardship in text form by the end of the month following receipt of the announcement; the period begins to run only if the announcement complies with § 555c (§ 555d (3))";
    when ankuendigung_zugegangen_am(ma, z) and ankuendigung_vollstaendig(ma) and ankuendigung_in_textform(ma);
    then haerteeinwand_ausschlussfrist_ende(ma, month_end_of(add_calendar_period(z, 1 calendar_month)));
}

@source(BGB_P555d)
rule HaerteeinwandRechtzeitig555dAbs3(ma: Modernisierungsmassnahme, e: Date, h: Date) strict {
    label de official "Die Mitteilung ist rechtzeitig, wenn sie dem Vermieter bis zum Ablauf der Frist zugeht (§ 555d Abs. 3 Satz 1)";
    label en unofficial "The communication is in time if it reaches the lessor by the end of the period (§ 555d (3) sentence 1)";
    when haerteeinwand_ausschlussfrist_ende(ma, e) and haerteeinwand_erklaert_am(ma, h) and h <= e;
    then haerteeinwand_rechtzeitig(ma);
}

@source(BGB_P555e)
rule Sonderkuendigungsfrist555eAbs1(ma: Modernisierungsmassnahme, z: Date) strict {
    label de official "Die Kündigung muss bis zum Ablauf des Monats erfolgen, der auf den Zugang der Modernisierungsankündigung folgt (§ 555e Abs. 1 Satz 2)";
    label en unofficial "Notice must be given by the end of the month following receipt of the modernisation announcement (§ 555e (1) sentence 2)";
    when ankuendigung_zugegangen_am(ma, z) and not nur_unerhebliche_einwirkung(ma);
    then sonderkuendigungsfrist_555e_ende(ma, month_end_of(add_calendar_period(z, 1 calendar_month)));
}

@source(BGB_P555e)
rule Sonderkuendigung555eRechtzeitig(ma: Modernisierungsmassnahme, e: Date, k: Date) strict {
    label de official "Nach Zugang der Modernisierungsankündigung kann der Mieter das Mietverhältnis außerordentlich zum Ablauf des übernächsten Monats kündigen, wenn er bis zum Ablauf des Folgemonats kündigt (§ 555e Abs. 1)";
    label en unofficial "After receipt of the announcement the tenant may terminate extraordinarily to the end of the month after next if he gives notice by the end of the following month (§ 555e (1))";
    when sonderkuendigungsfrist_555e_ende(ma, e) and sonderkuendigung_555e_erklaert_am(ma, k) and k <= e;
    then sonderkuendigung_555e_rechtzeitig(ma);
}

// --- §§ 556–556c Betriebskosten -------------------------------------------------------------------

pub relation betriebskosten_vereinbart(m: Mietverhaeltnis) kind empirical {
    label de official "die Vertragsparteien haben vereinbart, dass der Mieter Betriebskosten trägt (§ 556 Abs. 1 Satz 1)";
    label en unofficial "the parties agreed that the tenant bears operating costs (§ 556 (1) sentence 1)";
}
pub relation vorauszahlungen_vereinbart(m: Mietverhaeltnis) kind empirical {
    label de official "die Betriebskosten sind als Vorauszahlung ausgewiesen (§ 556 Abs. 2 Satz 1, Abs. 3 Satz 1)";
    label en unofficial "operating costs are shown as advance payments (§ 556 (2) sentence 1, (3) sentence 1)";
}
pub relation pauschale_vereinbart(m: Mietverhaeltnis) kind empirical {
    label de official "die Betriebskosten sind als Pauschale ausgewiesen (§ 556 Abs. 2 Satz 1, § 560 Abs. 1)";
    label en unofficial "operating costs are shown as a flat rate (§ 556 (2) sentence 1, § 560 (1))";
}
pub relation abrechnung_des(ab: Betriebskostenabrechnung, m: Mietverhaeltnis) kind empirical {
    key(ab);
    label de official "Abrechnung über die Vorauszahlungen für Betriebskosten dieses Mietverhältnisses (§ 556 Abs. 3)";
    label en unofficial "statement of account on advance payments for operating costs of this lease (§ 556 (3))";
}
pub relation abrechnungszeitraum_ende(ab: Betriebskostenabrechnung, tag: Date) kind empirical {
    key(ab);
    label de official "Ende des Abrechnungszeitraums (§ 556 Abs. 3 Satz 2)";
    label en unofficial "end of the accounting period (§ 556 (3) sentence 2)";
}
pub relation abrechnung_mitgeteilt_am(ab: Betriebskostenabrechnung, tag: Date) kind empirical {
    key(ab);
    label de official "Tag, an dem die Abrechnung dem Mieter mitgeteilt wird (§ 556 Abs. 3 Satz 2)";
    label en unofficial "day on which the statement is communicated to the tenant (§ 556 (3) sentence 2)";
}
pub relation abrechnung_zugegangen_am(ab: Betriebskostenabrechnung, tag: Date) kind empirical {
    key(ab);
    label de official "Tag des Zugangs der Abrechnung beim Mieter (§ 556 Abs. 3 Satz 5)";
    label en unofficial "day on which the statement reaches the tenant (§ 556 (3) sentence 5)";
}
pub relation einwendungen_mitgeteilt_am(ab: Betriebskostenabrechnung, tag: Date) kind empirical {
    key(ab);
    label de official "Tag, an dem der Mieter seine Einwendungen gegen die Abrechnung mitteilt (§ 556 Abs. 3 Satz 5)";
    label en unofficial "day on which the tenant communicates objections to the statement (§ 556 (3) sentence 5)";
}
pub relation verspaetung_nicht_zu_vertreten_vermieter(ab: Betriebskostenabrechnung) kind empirical {
    label de official "der Vermieter hat die verspätete Geltendmachung nicht zu vertreten (§ 556 Abs. 3 Satz 3)";
    label en unofficial "the lessor is not responsible for the delayed assertion (§ 556 (3) sentence 3)";
}
pub relation verspaetung_nicht_zu_vertreten_mieter(ab: Betriebskostenabrechnung) kind empirical {
    label de official "der Mieter hat die verspätete Geltendmachung nicht zu vertreten (§ 556 Abs. 3 Satz 6)";
    label en unofficial "the tenant is not responsible for the delayed assertion (§ 556 (3) sentence 6)";
}
pub relation umlagemassstab_vereinbart(m: Mietverhaeltnis) kind empirical {
    label de official "die Vertragsparteien haben einen Maßstab für die Umlage der Betriebskosten vereinbart (§ 556a Abs. 1 Satz 1, Abs. 2)";
    label en unofficial "the parties agreed a basis for apportioning operating costs (§ 556a (1) sentence 1, (2))";
}
pub relation erfasster_verbrauch(m: Mietverhaeltnis) kind empirical {
    label de official "die Betriebskosten hängen von einem erfassten Verbrauch oder einer erfassten Verursachung durch die Mieter ab (§ 556a Abs. 1 Satz 2)";
    label en unofficial "the operating costs depend on recorded consumption or recorded causation by the tenants (§ 556a (1) sentence 2)";
}
pub relation zeitabschnitt_beginn(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Beginn des Zeitabschnitts, nach dem die Miete bemessen ist (§ 556b Abs. 1)";
    label en unofficial "start of the period by which the rent is measured (§ 556b (1))";
}
pub relation umstellung_auf_waermelieferung_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, an dem der Vermieter die Versorgung von der Eigenversorgung auf die gewerbliche Wärmelieferung umstellt (§ 556c Abs. 1, Abs. 2)";
    label en unofficial "day on which the lessor switches supply from self-supply to commercial heat supply (§ 556c (1), (2))";
}
pub relation waerme_mit_verbesserter_effizienz(m: Mietverhaeltnis) kind empirical {
    label de official "die Wärme wird mit verbesserter Effizienz aus einer neuen Anlage oder aus einem Wärmenetz geliefert (§ 556c Abs. 1 Satz 1 Nr. 1)";
    label en unofficial "heat is supplied with improved efficiency from a new plant or a heat network (§ 556c (1) sentence 1 no. 1)";
}
pub relation kosten_der_waermelieferung_nicht_hoeher(m: Mietverhaeltnis) kind empirical {
    label de official "die Kosten der Wärmelieferung übersteigen die bisherigen Betriebskosten für die Eigenversorgung nicht (§ 556c Abs. 1 Satz 1 Nr. 2)";
    label en unofficial "the costs of heat supply do not exceed the previous operating costs of self-supply (§ 556c (1) sentence 1 no. 2)";
}
pub relation jahresnutzungsgrad_prozent(m: Mietverhaeltnis, prozent: Integer) kind empirical {
    key(m);
    label de official "Jahresnutzungsgrad der bestehenden Anlage vor der Umstellung in vollen Prozent (§ 556c Abs. 1 Satz 2)";
    label en unofficial "annual efficiency of the existing plant before the switch, in whole per cent (§ 556c (1) sentence 2)";
}

pub relation abrechnungspflicht(m: Mietverhaeltnis, v: Person) kind institutional {
    label de official "über die Vorauszahlungen für Betriebskosten ist jährlich abzurechnen (§ 556 Abs. 3 Satz 1)";
    label en unofficial "advance payments for operating costs must be accounted for annually (§ 556 (3) sentence 1)";
}
pub relation abrechnungsfrist_kalenderende(ab: Betriebskostenabrechnung, tag: Date) kind institutional {
    key(ab);
    label de official "kalendarisches Ende der zwölf Monate nach dem Ende des Abrechnungszeitraums vor Anwendung des § 193 (§ 556 Abs. 3 Satz 2)";
    label en unofficial "calendar end of the twelve months after the end of the accounting period before applying § 193 (§ 556 (3) sentence 2)";
}
pub relation abrechnungsfrist_ende(ab: Betriebskostenabrechnung, tag: Date) kind institutional {
    key(ab);
    label de official "Tag, mit dessen Ablauf die Abrechnungsfrist des § 556 Abs. 3 Satz 2 endet (§ 188 Abs. 2, § 193)";
    label en unofficial "day at whose end the accounting period of § 556 (3) sentence 2 expires (§ 188 (2), § 193)";
}
pub relation nachforderung_ausgeschlossen(ab: Betriebskostenabrechnung) kind institutional {
    label de official "nach Ablauf der Frist ist die Geltendmachung einer Nachforderung durch den Vermieter ausgeschlossen (§ 556 Abs. 3 Satz 3)";
    label en unofficial "after expiry of the period the lessor may no longer assert an additional claim (§ 556 (3) sentence 3)";
}
pub relation einwendungsfrist_kalenderende(ab: Betriebskostenabrechnung, tag: Date) kind institutional {
    key(ab);
    label de official "kalendarisches Ende der zwölf Monate nach dem Zugang der Abrechnung vor Anwendung des § 193 (§ 556 Abs. 3 Satz 5)";
    label en unofficial "calendar end of the twelve months after receipt of the statement before applying § 193 (§ 556 (3) sentence 5)";
}
pub relation einwendungsfrist_ende(ab: Betriebskostenabrechnung, tag: Date) kind institutional {
    key(ab);
    label de official "Tag, mit dessen Ablauf die Einwendungsfrist des § 556 Abs. 3 Satz 5 endet (§ 188 Abs. 2, § 193)";
    label en unofficial "day at whose end the objection period of § 556 (3) sentence 5 expires (§ 188 (2), § 193)";
}
pub relation einwendungen_ausgeschlossen(ab: Betriebskostenabrechnung) kind institutional {
    label de official "nach Ablauf der Frist kann der Mieter Einwendungen nicht mehr geltend machen (§ 556 Abs. 3 Satz 6)";
    label en unofficial "after expiry of the period the tenant may no longer raise objections (§ 556 (3) sentence 6)";
}
pub relation umlage_nach_wohnflaeche(m: Mietverhaeltnis) kind institutional {
    label de official "haben die Vertragsparteien nichts anderes vereinbart, sind die Betriebskosten nach dem Anteil der Wohnfläche umzulegen (§ 556a Abs. 1 Satz 1)";
    label en unofficial "unless the parties agreed otherwise, operating costs are apportioned according to the share of living space (§ 556a (1) sentence 1)";
}
pub relation umlage_nach_verbrauch(m: Mietverhaeltnis) kind institutional {
    label de official "verbrauchsabhängige Betriebskosten sind nach einem Maßstab umzulegen, der dem unterschiedlichen Verbrauch Rechnung trägt (§ 556a Abs. 1 Satz 2)";
    label en unofficial "consumption-dependent operating costs are apportioned by a basis reflecting the differing consumption (§ 556a (1) sentence 2)";
}
pub relation miete_faellig_spaetestens_am(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "die Miete ist zu Beginn, spätestens bis zum dritten Werktag der einzelnen Zeitabschnitte zu entrichten (§ 556b Abs. 1) — der dritte Werktag wird mit dem Kalender KALENDER_BUNDESWEIT gezählt";
    label en unofficial "the rent is payable at the beginning, at the latest by the third working day of the individual periods (§ 556b (1)) — the third working day is counted with the calendar KALENDER_BUNDESWEIT";
}
pub relation kosten_der_waermelieferung_zu_tragen(m: Mietverhaeltnis) kind institutional {
    label de official "der Mieter hat die Kosten der Wärmelieferung als Betriebskosten zu tragen (§ 556c Abs. 1 Satz 1)";
    label en unofficial "the tenant must bear the costs of heat supply as operating costs (§ 556c (1) sentence 1)";
}
pub relation umstellungsankuendigung_erklaert_am(m: Mietverhaeltnis, tag: Date) kind empirical {
    key(m);
    label de official "Tag, an dem der Vermieter die Umstellung auf die Wärmelieferung in Textform ankündigt (§ 556c Abs. 2)";
    label en unofficial "day on which the lessor announces the switch to heat supply in text form (§ 556c (2))";
}
pub relation umstellungsankuendigung_plus_drei_monate(m: Mietverhaeltnis, tag: Date) kind institutional {
    key(m);
    label de official "Tag, der drei Monate nach der Umstellungsankündigung liegt (§ 556c Abs. 2) — vorwärts gerechnet (Ledger D-06-07)";
    label en unofficial "day three months after the announcement of the switch (§ 556c (2)) — computed forwards (ledger D-06-07)";
}
pub relation umstellungsankuendigung_rechtzeitig(m: Mietverhaeltnis) kind institutional {
    label de official "die Umstellung ist spätestens drei Monate zuvor in Textform angekündigt (§ 556c Abs. 2)";
    label en unofficial "the switch was announced in text form at the latest three months beforehand (§ 556c (2))";
}
pub relation verbesserung_der_betriebsfuehrung_genuegt(m: Mietverhaeltnis) kind institutional {
    label de official "beträgt der Jahresnutzungsgrad der bestehenden Anlage vor der Umstellung mindestens 80 Prozent, kann sich der Wärmelieferant auf die Verbesserung der Betriebsführung beschränken (§ 556c Abs. 1 Satz 2)";
    label en unofficial "where the annual efficiency of the existing plant before the switch is at least 80 per cent, the heat supplier may confine itself to improving the operation of the plant (§ 556c (1) sentence 2)";
}

@source(BGB_P556)
rule Abrechnungspflicht556Abs3Satz1(m: Mietverhaeltnis, v: Person) strict {
    label de official "Über die Vorauszahlungen für Betriebskosten ist jährlich abzurechnen; dabei ist der Grundsatz der Wirtschaftlichkeit zu beachten (§ 556 Abs. 3 Satz 1)";
    label en unofficial "Advance payments for operating costs must be accounted for annually, observing the principle of economy (§ 556 (3) sentence 1)";
    when betriebskosten_vereinbart(m) and vorauszahlungen_vereinbart(m) and vermieter(m, v);
    then abrechnungspflicht(m, v);
}

@source(BGB_P556)
rule Abrechnungsfrist556Abs3Satz2(ab: Betriebskostenabrechnung, e: Date) strict {
    label de official "Die Abrechnung ist dem Mieter spätestens bis zum Ablauf des zwölften Monats nach Ende des Abrechnungszeitraums mitzuteilen (§ 556 Abs. 3 Satz 2) — Monatsschritt nach § 188 Abs. 2, Politik BGB_MIETE_KALENDER";
    label en unofficial "The statement must be communicated to the tenant at the latest by the end of the twelfth month after the end of the accounting period (§ 556 (3) sentence 2) — monthly step under § 188 (2), policy BGB_MIETE_KALENDER";
    when abrechnungszeitraum_ende(ab, e);
    then abrechnungsfrist_kalenderende(ab, add_calendar_period(e, 12 calendar_month));
}

@source(BGB_P556)
rule Abrechnungsfrist556Verlegung193(ab: Betriebskostenabrechnung, k: Date) strict {
    label de official "Innerhalb der Frist ist die Abrechnung mitzuteilen; fällt der letzte Tag auf einen Sonntag, einen anerkannten Feiertag oder einen Sonnabend, so tritt an seine Stelle der nächste Werktag (§ 193)";
    label en unofficial "The statement must be communicated within the period; if the last day falls on a Sunday, a recognised public holiday or a Saturday, the next working day takes its place (§ 193)";
    when abrechnungsfrist_kalenderende(ab, k);
    then abrechnungsfrist_ende(ab, add_business_days(k, 1 business_day));
}

@source(BGB_P556)
rule Nachforderung556Abs3Satz3(ab: Betriebskostenabrechnung, e: Date, mt: Date) defeasible {
    label de official "Nach Ablauf dieser Frist ist die Geltendmachung einer Nachforderung durch den Vermieter ausgeschlossen, es sei denn, der Vermieter hat die verspätete Geltendmachung nicht zu vertreten (§ 556 Abs. 3 Satz 3)";
    label en unofficial "After expiry of that period the lessor may no longer assert an additional claim unless he is not responsible for the delay (§ 556 (3) sentence 3)";
    when abrechnungsfrist_ende(ab, e) and abrechnung_mitgeteilt_am(ab, mt) and mt > e;
    unless verspaetung_nicht_zu_vertreten_vermieter(ab);
    then nachforderung_ausgeschlossen(ab);
}

@source(BGB_P556)
rule Einwendungsfrist556Abs3Satz5(ab: Betriebskostenabrechnung, z: Date) strict {
    label de official "Einwendungen gegen die Abrechnung hat der Mieter dem Vermieter spätestens bis zum Ablauf des zwölften Monats nach Zugang der Abrechnung mitzuteilen (§ 556 Abs. 3 Satz 5)";
    label en unofficial "The tenant must communicate objections to the statement at the latest by the end of the twelfth month after receipt of the statement (§ 556 (3) sentence 5)";
    when abrechnung_zugegangen_am(ab, z);
    then einwendungsfrist_kalenderende(ab, add_calendar_period(z, 12 calendar_month));
}

@source(BGB_P556)
rule Einwendungsfrist556Verlegung193(ab: Betriebskostenabrechnung, k: Date) strict {
    label de official "Innerhalb der Frist sind die Einwendungen mitzuteilen; § 193 verlegt den letzten Tag auf den nächsten Werktag";
    label en unofficial "The objections must be communicated within the period; § 193 moves the last day to the next working day";
    when einwendungsfrist_kalenderende(ab, k);
    then einwendungsfrist_ende(ab, add_business_days(k, 1 business_day));
}

@source(BGB_P556)
rule Einwendungen556Abs3Satz6(ab: Betriebskostenabrechnung, e: Date, mt: Date) defeasible {
    label de official "Nach Ablauf dieser Frist kann der Mieter Einwendungen nicht mehr geltend machen, es sei denn, der Mieter hat die verspätete Geltendmachung nicht zu vertreten (§ 556 Abs. 3 Satz 6)";
    label en unofficial "After expiry of that period the tenant may no longer raise objections unless he is not responsible for the delay (§ 556 (3) sentence 6)";
    when einwendungsfrist_ende(ab, e) and einwendungen_mitgeteilt_am(ab, mt) and mt > e;
    unless verspaetung_nicht_zu_vertreten_mieter(ab);
    then einwendungen_ausgeschlossen(ab);
}

@source(BGB_P556a)
rule Wohnflaechenmassstab556aAbs1Satz1(m: Mietverhaeltnis) strict {
    label de official "Haben die Vertragsparteien nichts anderes vereinbart, sind die Betriebskosten nach dem Anteil der Wohnfläche umzulegen (§ 556a Abs. 1 Satz 1)";
    label en unofficial "Unless the parties agreed otherwise, operating costs are apportioned according to the share of living space (§ 556a (1) sentence 1)";
    when betriebskosten_vereinbart(m) and not umlagemassstab_vereinbart(m) and not erfasster_verbrauch(m);
    then umlage_nach_wohnflaeche(m);
}

@source(BGB_P556a)
rule Verbrauchsmassstab556aAbs1Satz2(m: Mietverhaeltnis) strict {
    label de official "Betriebskosten, die von einem erfassten Verbrauch oder einer erfassten Verursachung durch die Mieter abhängen, sind nach einem Maßstab umzulegen, der dem unterschiedlichen Verbrauch oder der unterschiedlichen Verursachung Rechnung trägt (§ 556a Abs. 1 Satz 2)";
    label en unofficial "Operating costs depending on recorded consumption or causation by the tenants are apportioned by a basis reflecting the differing consumption or causation (§ 556a (1) sentence 2)";
    when betriebskosten_vereinbart(m) and erfasster_verbrauch(m);
    then umlage_nach_verbrauch(m);
}

@source(BGB_P556b)
rule Faelligkeit556bAbs1(m: Mietverhaeltnis, b: Date) strict {
    label de official "Die Miete ist zu Beginn, spätestens bis zum dritten Werktag der einzelnen Zeitabschnitte zu entrichten, nach denen sie bemessen ist (§ 556b Abs. 1)";
    label en unofficial "The rent is payable at the beginning, at the latest by the third working day of the individual periods by which it is measured (§ 556b (1))";
    when gegenstandsart(m, Wohnraum) and zeitabschnitt_beginn(m, b);
    then miete_faellig_spaetestens_am(m, add_business_days(b, 3 business_day));
}

@source(BGB_P556c)
rule Waermelieferung556cAbs1Satz1(m: Mietverhaeltnis, u: Date) strict {
    label de official "Stellt der Vermieter die Versorgung auf die eigenständig gewerbliche Wärmelieferung um, so hat der Mieter die Kosten der Wärmelieferung als Betriebskosten zu tragen, wenn die Wärme mit verbesserter Effizienz geliefert wird und die Kosten die bisherigen Betriebskosten nicht übersteigen (§ 556c Abs. 1 Satz 1)";
    label en unofficial "Where the lessor switches supply to independent commercial heat supply, the tenant bears the costs of heat supply as operating costs if the heat is supplied with improved efficiency and the costs do not exceed the previous operating costs (§ 556c (1) sentence 1)";
    when betriebskosten_vereinbart(m) and umstellung_auf_waermelieferung_am(m, u)
     and waerme_mit_verbesserter_effizienz(m) and kosten_der_waermelieferung_nicht_hoeher(m);
    then kosten_der_waermelieferung_zu_tragen(m);
}

@source(BGB_P556c)
rule Jahresnutzungsgrad556cAbs1Satz2(m: Mietverhaeltnis, g: Integer) strict {
    label de official "Beträgt der Jahresnutzungsgrad der bestehenden Anlage vor der Umstellung mindestens 80 Prozent, kann sich der Wärmelieferant anstelle der Maßnahmen nach Nummer 1 auf die Verbesserung der Betriebsführung der Anlage beschränken (§ 556c Abs. 1 Satz 2)";
    label en unofficial "Where the annual efficiency of the existing plant before the switch is at least 80 per cent, the heat supplier may, instead of the measures under no. 1, confine itself to improving the operation of the plant (§ 556c (1) sentence 2)";
    when jahresnutzungsgrad_prozent(m, g) and g >= 80;
    then verbesserung_der_betriebsfuehrung_genuegt(m);
}

@source(BGB_P556c)
rule Umstellungsankuendigung556cAbs2(m: Mietverhaeltnis, a: Date) strict {
    label de official "Der Vermieter hat die Umstellung spätestens drei Monate zuvor in Textform anzukündigen (§ 556c Abs. 2) — der Abstand wird vorwärts von der Ankündigung an gerechnet";
    label en unofficial "The lessor must announce the switch in text form at the latest three months beforehand (§ 556c (2)) — the distance is computed forwards from the announcement";
    when umstellungsankuendigung_erklaert_am(m, a);
    then umstellungsankuendigung_plus_drei_monate(m, add_calendar_period(a, 3 calendar_month));
}

@source(BGB_P556c)
rule UmstellungsankuendigungRechtzeitig556cAbs2(m: Mietverhaeltnis, f: Date, u: Date) strict {
    label de official "Die Umstellungsankündigung ist rechtzeitig, wenn zwischen ihr und der Umstellung mindestens drei Monate liegen (§ 556c Abs. 2)";
    label en unofficial "The announcement of the switch is in time if at least three months lie between it and the switch (§ 556c (2))";
    when umstellungsankuendigung_plus_drei_monate(m, f) and umstellung_auf_waermelieferung_am(m, u) and f <= u;
    then umstellungsankuendigung_rechtzeitig(m);
}
