// BÜRGERLICHES GESETZBUCH (1896) — sixth link of the comparative private-law
// chain (DECISION-0091, IUS-PRIVATUM-CHAIN F7). First edition
// (Reichsgesetzblatt 1896, Nr. 21), in force from 1 January 1900; not the
// living text (fork 2 of the decision).
//
// SCOPE — the paragraph list (SCOPE in the sync script) from four pinned
// Wikisource books: persons and capacity, Anspruch and Verjährung, obligation
// and contract, performance and release, loan, deposit, delicts, possession
// and ownership, succession. Outside the list is “außerhalb der
// vergleichenden Kette”, not a debt.
//
// TYPES come from the dictionary (DECISION-0091 §3), via E-0098 aliases.
// Anspruch § 194 is the nearest kin of the dictionary’s Causa.

language "law.core" version "0.2";
package de.bgb_1896 version "0.1.0";
namespace "urn:de:corpus:clir:bgb-1896";
import doctrine.ius_privatum version "0.1.0";

source BGB_1896 {
    kind code;
    jurisdiction DE;
    number "RGBl. 1896 Nr. 21";
    label de official "Bürgerliches Gesetzbuch";
    label en unofficial "German Civil Code of 1896";
}

edition BGB_1896_WIKISOURCE of BGB_1896 {
    label de official "Bürgerliches Gesetzbuch. Vom 18. August 1896 (Reichsgesetzblatt 1896, Nr. 21, S. 195–603)";
    label en unofficial "First 1896 edition, German Wikisource transcription of the Reichsgesetzblatt";
    language de;
    officiality unofficial;
    materialization_status PINNED_UNOFFICIAL_COPY;
    adopted @1896-08-18;
    in_force [@1900-01-01, infinity);
}

publication BGB_1896_WIKISOURCE_TEXT of BGB_1896_WIKISOURCE {
    media_type "text/plain; charset=utf-8";
    uri "https://de.wikisource.org/wiki/B%C3%BCrgerliches_Gesetzbuch";
    retrieved_at @2026-09-02T20:20:00Z;
    content_hash "sha256:a3dc2d0be91f5ec0cf7873eb227500cf40bb7bc94161e3a7412619feb9b2d9a6";
    local_path "sources/bgb-1896/de.txt";
}

type Persona = doctrine.ius_privatum::Persona;
type Res = doctrine.ius_privatum::Res;
type Causa = doctrine.ius_privatum::Causa;
