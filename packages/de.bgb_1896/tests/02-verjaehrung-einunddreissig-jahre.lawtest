language "law.core" version "0.2";
package de.bgb_1896 version "0.1.0";
namespace "urn:de:corpus:clir:bgb-1896";

// Thirty-one full years: the regular period of thirty years (§ 195) is
// completed; the obligor may refuse performance (§ 222 (1)).
test "urn:query:de-bgb-1896-verjaehrung-einunddreissig-jahre" {
    given {
        context { decision_time @1900-01-01T12:00:00Z; knowledge_time @1900-01-01T12:00:00Z; legal_time @1900-01-01; timezone "Europe/Berlin"; }
        assert "c": doctrine.ius_privatum::contractus(entity_ref("urn:de:bgb1896:g31"), entity_ref("urn:de:bgb1896:s31"), entity_ref("urn:de:bgb1896:c31")) { origin case_input; }
        assert "p": doctrine.ius_privatum::petitio(entity_ref("urn:de:bgb1896:c31"), entity_ref("urn:de:bgb1896:g31"), entity_ref("urn:de:bgb1896:s31")) { origin case_input; }
        assert "n": doctrine.ius_privatum::actio_nata_ante_annos(entity_ref("urn:de:bgb1896:c31"), 31) { origin case_input; }
    }
    evaluate truth(verjaehrung_vollendet(entity_ref("urn:de:bgb1896:c31")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(leistung_verweigern_berechtigt(entity_ref("urn:de:bgb1896:s31"), entity_ref("urn:de:bgb1896:g31"), entity_ref("urn:de:bgb1896:c31")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(doctrine.ius_privatum::remedium_exclusum(entity_ref("urn:de:bgb1896:g31"), entity_ref("urn:de:bgb1896:s31"), entity_ref("urn:de:bgb1896:c31")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
