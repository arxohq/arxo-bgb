language "law.core" version "0.2";
package de.bgb_1896 version "0.1.0";
namespace "urn:de:corpus:clir:bgb-1896";

// After thirty-one years the claim is time-barred, yet what was rendered
// cannot be reclaimed: a bare right (§ 222 (2)).
test "urn:query:de-bgb-1896-verjaehrung-geleistetes" {
    given {
        context { decision_time @1900-01-01T12:00:00Z; knowledge_time @1900-01-01T12:00:00Z; legal_time @1900-01-01; timezone "Europe/Berlin"; }
        assert "c": doctrine.ius_privatum::contractus(entity_ref("urn:de:bgb1896:gg"), entity_ref("urn:de:bgb1896:sg"), entity_ref("urn:de:bgb1896:cg")) { origin case_input; }
        assert "p": doctrine.ius_privatum::petitio(entity_ref("urn:de:bgb1896:cg"), entity_ref("urn:de:bgb1896:gg"), entity_ref("urn:de:bgb1896:sg")) { origin case_input; }
        assert "n": doctrine.ius_privatum::actio_nata_ante_annos(entity_ref("urn:de:bgb1896:cg"), 31) { origin case_input; }
    }
    evaluate truth(geleistetes_nicht_zurueckforderbar(entity_ref("urn:de:bgb1896:cg")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
