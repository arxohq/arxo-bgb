language "law.core" version "0.2";
package de.bgb_1896 version "0.1.0";
namespace "urn:de:corpus:clir:bgb-1896";

// Four full years: the regular period is thirty years (§ 195). Limitation
// has not been completed; the Einrede of § 222 is not open.
test "urn:query:de-bgb-1896-verjaehrung-vier-jahre" {
    given {
        context { decision_time @1900-01-01T12:00:00Z; knowledge_time @1900-01-01T12:00:00Z; legal_time @1900-01-01; timezone "Europe/Berlin"; }
        assert "c": doctrine.ius_privatum::contractus(entity_ref("urn:de:bgb1896:g"), entity_ref("urn:de:bgb1896:s"), entity_ref("urn:de:bgb1896:c")) { origin case_input; }
        assert "p": doctrine.ius_privatum::petitio(entity_ref("urn:de:bgb1896:c"), entity_ref("urn:de:bgb1896:g"), entity_ref("urn:de:bgb1896:s")) { origin case_input; }
        assert "n": doctrine.ius_privatum::actio_nata_ante_annos(entity_ref("urn:de:bgb1896:c"), 4) { origin case_input; }
    }
    evaluate truth(verjaehrung_vollendet(entity_ref("urn:de:bgb1896:c")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
