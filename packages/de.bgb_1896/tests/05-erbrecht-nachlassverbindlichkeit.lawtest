language "law.core" version "0.2";
package de.bgb_1896 version "0.1.0";
namespace "urn:de:corpus:clir:bgb-1896";

// A contractual debt of the deceased is an estate liability (§ 1967);
// the claim passes against the heir.
test "urn:query:de-bgb-1896-erbrecht-nachlassverbindlichkeit" {
    given {
        context { decision_time @1900-01-01T12:00:00Z; knowledge_time @1900-01-01T12:00:00Z; legal_time @1900-01-01; timezone "Europe/Berlin"; }
        assert "c": doctrine.ius_privatum::contractus(entity_ref("urn:de:bgb1896:xg"), entity_ref("urn:de:bgb1896:xd"), entity_ref("urn:de:bgb1896:xc")) { origin case_input; }
        assert "d": doctrine.ius_privatum::mortuus(entity_ref("urn:de:bgb1896:xd")) { origin case_input; }
    }
    evaluate truth(nachlassverbindlichkeit(entity_ref("urn:de:bgb1896:xd"), entity_ref("urn:de:bgb1896:xc")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(doctrine.ius_privatum::remedium_transit_contra_heredem(entity_ref("urn:de:bgb1896:xc")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
