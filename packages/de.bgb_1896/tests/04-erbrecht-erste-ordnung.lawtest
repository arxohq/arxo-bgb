language "law.core" version "0.2";
package de.bgb_1896 version "0.1.0";
namespace "urn:de:corpus:clir:bgb-1896";

// Intestate: a child is the statutory heir of the first order (§ 1924);
// the estate devolves, and the dictionary sees an heir (§ 1922, § 1942).
test "urn:query:de-bgb-1896-erbrecht-erste-ordnung" {
    given {
        context { decision_time @1900-01-01T12:00:00Z; knowledge_time @1900-01-01T12:00:00Z; legal_time @1900-01-01; timezone "Europe/Berlin"; }
        assert "d": doctrine.ius_privatum::mortuus(entity_ref("urn:de:bgb1896:d")) { origin case_input; }
        assert "s": doctrine.ius_privatum::sine_testamento(entity_ref("urn:de:bgb1896:d")) { origin case_input; }
        assert "f": doctrine.ius_privatum::filius(entity_ref("urn:de:bgb1896:h"), entity_ref("urn:de:bgb1896:d")) { origin case_input; }
    }
    evaluate truth(gesetzlicher_erbe_erster_ordnung(entity_ref("urn:de:bgb1896:h"), entity_ref("urn:de:bgb1896:d")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(doctrine.ius_privatum::heres_est(entity_ref("urn:de:bgb1896:h"), entity_ref("urn:de:bgb1896:d")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
