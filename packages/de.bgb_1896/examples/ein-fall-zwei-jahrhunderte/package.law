language "law.core" version "0.2";
package examples.de.bgb.ein_fall_zwei_jahrhunderte version "0.1.0";
namespace "urn:law:examples:de:bgb:ein-fall-zwei-jahrhunderte";

import de.bgb_1896 version "0.1.0";
import de.bgb.fristen version "0.1.0";
import de.bgb.core version "0.1.0";
import doctrine.ius_privatum version "0.1.0";

// Case package §168.4: one claim, two texts. The 1896 monument answers in
// years (§ 195: thirty); the living Code answers in dates (§§ 195, 199:
// three years from the close of the year). No norm is written here.
deadline policy BGB_FRISTEN_KALENDER {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}
