language "law.core" version "0.2";
package examples.de.bgb.ein_fall_zwei_jahrhunderte version "0.1.0";
namespace "urn:law:examples:de:bgb:ein-fall-zwei-jahrhunderte";

case EinunddreissigJahre_1896 {
    context {
        legal_time @1900-01-01;
        knowledge_time @2024-06-01T12:00:00Z;
        decision_time @2024-06-01T12:00:00Z;
        timezone "Europe/Berlin";
    }
    assert "vertrag": doctrine.ius_privatum::contractus(entity_ref("urn:de:bgb:p11:g31"), entity_ref("urn:de:bgb:p11:s31"), entity_ref("urn:de:bgb:p11:c31")) { origin case_input; }
    assert "petitio": doctrine.ius_privatum::petitio(entity_ref("urn:de:bgb:p11:c31"), entity_ref("urn:de:bgb:p11:g31"), entity_ref("urn:de:bgb:p11:s31")) { origin case_input; }
    assert "jahre": doctrine.ius_privatum::actio_nata_ante_annos(entity_ref("urn:de:bgb:p11:c31"), 31) { origin case_input; }
}
