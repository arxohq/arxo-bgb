language "law.core" version "0.2";
package examples.de.bgb.ein_fall_zwei_jahrhunderte version "0.1.0";
namespace "urn:law:examples:de:bgb:ein-fall-zwei-jahrhunderte";

case VierJahre_Heute {
    context {
        deadline_policy examples.de.bgb.ein_fall_zwei_jahrhunderte::BGB_FRISTEN_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-17;
        knowledge_time @2024-06-01T12:00:00Z;
        decision_time @2024-06-01T12:00:00Z;
        timezone "Europe/Berlin";
    }
    const a: de.bgb.core::Anspruch = entity_ref("urn:de:bgb:p11:a4");
    assert "entstanden": de.bgb.core::anspruch_entstanden_am(a, @2020-03-15) { origin case_input; }
    assert "kenntnis": de.bgb.fristen::kenntnis_erlangt_am(a, @2020-03-15) { origin case_input; }
    assert "keine-hemmung": de.bgb.fristen::keine_hemmung(a) { origin case_input; }
}
