// TITEL 4 — SCHENKUNG (§§ 516–534)
//
// Teil des Pakets BG-08 (`package.law`). Zwanzig Paragraphen, nach Absätzen
// bearbeitet.
//
// „GROBER UNDANK" IST EINE WERTUNG (§ 47.3, DECISION-0194). § 530 Absatz 1
// macht den Widerruf von einer „schweren Verfehlung" abhängig, durch die sich
// der Beschenkte „groben Undanks schuldig macht" — kein Tatbestandsmerkmal,
// das aus Fallangaben folgt. Ebenso „angemessener Unterhalt" (§§ 519 Absatz 1,
// 528 Absatz 1 Satz 1), „standesmäßiger Unterhalt" (§ 529 Absatz 2),
// „angemessene Frist" (§ 516 Absatz 2 Satz 1) und „sittliche Pflicht oder auf
// den Anstand zu nehmende Rücksicht" (§ 534). Ein flacher Fall-Fakt „der
// Beschenkte war grob undankbar" ist verboten.
//
// ZWEI FRISTEN, ZWEI ANKNÜPFUNGEN. § 529 Absatz 1 zählt ZEHN JAHRE seit der
// Leistung des geschenkten Gegenstandes und fragt, ob die Bedürftigkeit
// INNERHALB dieser Zeit eingetreten ist; § 532 Satz 1 zählt EIN JAHR ab der
// KENNTNIS des Widerrufsberechtigten von den Voraussetzungen seines Rechts.
// Der Tag der Kenntnis ist eine festgestellte Tatsache des Falls (§ 199
// Absatz 1 Nummer 2), keine Wertung. Beide Zeilen stehen in DEADLINES.json
// unter BG-08.

language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";

pub entity Schenkung {
    label de official "Schenkung (§ 516 Absatz 1)";
    label en unofficial "gift (§ 516 (1))";
}

// § 516: Begriff der Schenkung; Annahmefiktion des Absatzes 2.

pub relation schenker(s: Schenkung, p: Person) kind empirical {
    key(s);
    label de official "Schenker: derjenige, der aus seinem Vermögen einen anderen bereichert (§ 516 Absatz 1)";
    label en unofficial "donor: the person who enriches another out of his own assets (§ 516 (1))";
}
pub relation beschenkter(s: Schenkung, p: Person) kind empirical {
    key(s);
    label de official "Beschenkter (§ 516 Absatz 1)";
    label en unofficial "donee (§ 516 (1))";
}
pub relation zuwendung_bereichert_den_anderen(s: Schenkung, wert: Money) kind empirical {
    key(s);
    label de official "Zuwendung, durch die jemand aus seinem Vermögen einen anderen bereichert; Wert der Zuwendung (§ 516 Absatz 1)";
    label en unofficial "disposition by which a person enriches another out of his own assets; value of the disposition (§ 516 (1))";
}
pub relation einigkeit_ueber_unentgeltlichkeit(s: Schenkung) kind empirical {
    label de official "Beide Teile sind darüber einig, dass die Zuwendung unentgeltlich erfolgt (§ 516 Absatz 1)";
    label en unofficial "both parties agree that the disposition is made gratuitously (§ 516 (1))";
}
pub relation schenkung_liegt_vor(s: Schenkung) kind institutional {
    label de official "Eine Schenkung liegt vor (§ 516 Absatz 1)";
    label en unofficial "a gift exists (§ 516 (1))";
}
pub relation zuwendung_ohne_willen_des_anderen(s: Schenkung) kind empirical {
    label de official "Die Zuwendung ist ohne den Willen des anderen erfolgt (§ 516 Absatz 2 Satz 1)";
    label en unofficial "the disposition was made without the other party's assent (§ 516 (2) sentence 1)";
}
pub relation annahmefrist_516(f: Frist) kind empirical {
    key(f);
    label de official "Angemessene Frist zur Erklärung über die Annahme, die der Zuwendende bestimmt hat (§ 516 Absatz 2 Satz 1)";
    label en unofficial "reasonable period for declaring acceptance, determined by the disposing party (§ 516 (2) sentence 1)";
}
pub relation aufforderung_zur_annahme_am(f: Frist, tag: Date) kind empirical {
    key(f);
    label de official "Tag der Aufforderung, sich über die Annahme zu erklären (§ 516 Absatz 2 Satz 1)";
    label en unofficial "day of the invitation to declare acceptance (§ 516 (2) sentence 1)";
}
pub relation annahmefrist_dauer_tage(f: Frist, dauer: Quantity) kind empirical {
    key(f);
    label de official "Dauer der vom Zuwendenden bestimmten Frist in Tagen — die Angemessenheit der Dauer beurteilt das Gericht (§ 516 Absatz 2 Satz 1)";
    label en unofficial "length in days of the period determined by the disposing party — its reasonableness is assessed by the court (§ 516 (2) sentence 1)";
}
pub relation schenkung_vor_fristablauf_abgelehnt(s: Schenkung) kind empirical {
    label de official "Der andere hat die Schenkung vor Ablauf der Frist abgelehnt (§ 516 Absatz 2 Satz 2)";
    label en unofficial "the other party rejected the gift before the period expired (§ 516 (2) sentence 2)";
}
pub relation frist_516_abgelaufen(s: Schenkung) kind empirical {
    label de official "Die Frist des § 516 Absatz 2 Satz 1 ist abgelaufen";
    label en unofficial "the period under § 516 (2) sentence 1 has expired";
}
pub relation schenkung_gilt_als_angenommen(s: Schenkung) kind institutional {
    label de official "Nach dem Ablauf der Frist gilt die Schenkung als angenommen, wenn nicht der andere sie vorher abgelehnt hat (§ 516 Absatz 2 Satz 2)";
    label en unofficial "after the period expires the gift is deemed accepted unless the other party rejected it beforehand (§ 516 (2) sentence 2)";
}

@source(BGB_P516) {
    rule SchenkungLiegtVor(s: Schenkung, wert: Money) strict {
        label de official "Eine Zuwendung, durch die jemand aus seinem Vermögen einen anderen bereichert, ist Schenkung, wenn beide Teile darüber einig sind, dass die Zuwendung unentgeltlich erfolgt (§ 516 Absatz 1)";
        label en unofficial "a disposition by which a person enriches another out of his own assets is a gift where both parties agree that it is made gratuitously (§ 516 (1))";
        when zuwendung_bereichert_den_anderen(s, wert) and einigkeit_ueber_unentgeltlichkeit(s);
        then schenkung_liegt_vor(s);
    }
    rule Annahmefrist516Ereignis(f: Frist, t: Date) strict {
        label de official "Die Frist zur Erklärung über die Annahme läuft von der Aufforderung an (§ 516 Absatz 2 Satz 1, § 187 Absatz 1)";
        label en unofficial "the period for declaring acceptance runs from the invitation (§ 516 (2) sentence 1, § 187 (1))";
        when annahmefrist_516(f) and aufforderung_zur_annahme_am(f, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
    rule Annahmefrist516Dauer(f: Frist, dauer: Quantity) strict {
        label de official "Der Zuwendende bestimmt eine angemessene Frist zur Erklärung über die Annahme (§ 516 Absatz 2 Satz 1)";
        label en unofficial "the disposing party determines a reasonable period for declaring acceptance (§ 516 (2) sentence 1)";
        when annahmefrist_516(f) and annahmefrist_dauer_tage(f, dauer);
        then de.bgb.fristen::frist_dauer_tage(f, dauer);
    }
    rule SchenkungGiltAlsAngenommen(s: Schenkung) strict {
        label de official "Nach dem Ablauf der Frist gilt die Schenkung als angenommen, wenn nicht der andere sie vorher abgelehnt hat (§ 516 Absatz 2 Satz 2)";
        label en unofficial "after the period expires the gift is deemed accepted unless the other party rejected it beforehand (§ 516 (2) sentence 2)";
        when zuwendung_ohne_willen_des_anderen(s) and frist_516_abgelaufen(s)
            and not_known(schenkung_vor_fristablauf_abgelehnt(s));
        then schenkung_gilt_als_angenommen(s);
    }
}

// § 517: Unterlassen eines Vermögenserwerbs ist keine Schenkung — eine
// Ausnahme mit positivem Prädikat, gelesen von § 516 nicht, sondern als
// eigener Schluss geführt (die Norm sagt, was NICHT vorliegt).

pub relation unterlassener_vermoegenserwerb(s: Schenkung) kind empirical {
    label de official "Jemand unterlässt zum Vorteil eines anderen einen Vermögenserwerb, verzichtet auf ein angefallenes, noch nicht endgültig erworbenes Recht oder schlägt eine Erbschaft oder ein Vermächtnis aus (§ 517)";
    label en unofficial "a person refrains, to another's advantage, from acquiring property, waives a right accrued but not finally acquired, or disclaims an inheritance or legacy (§ 517)";
}
pub relation keine_schenkung_517(s: Schenkung) kind institutional {
    label de official "Eine Schenkung liegt nicht vor (§ 517)";
    label en unofficial "no gift exists (§ 517)";
}
@source(BGB_P517)
rule KeineSchenkungBeiUnterlassenemErwerb(s: Schenkung) strict {
    label de official "Eine Schenkung liegt nicht vor, wenn jemand zum Vorteil eines anderen einen Vermögenserwerb unterlässt oder auf ein angefallenes, noch nicht endgültig erworbenes Recht verzichtet oder eine Erbschaft oder ein Vermächtnis ausschlägt (§ 517)";
    label en unofficial "no gift exists where a person refrains, to another's advantage, from acquiring property, waives a right accrued but not finally acquired, or disclaims an inheritance or legacy (§ 517)";
    when unterlassener_vermoegenserwerb(s);
    then keine_schenkung_517(s);
}

// § 518: Form des Schenkungsversprechens — notarielle Beurkundung, Heilung
// durch Bewirkung der versprochenen Leistung.

pub relation schenkungsversprechen(s: Schenkung) kind empirical {
    label de official "Vertrag, durch den eine Leistung schenkweise versprochen wird (§ 518 Absatz 1 Satz 1)";
    label en unofficial "contract by which performance is promised by way of gift (§ 518 (1) sentence 1)";
}
pub relation notariell_beurkundet(s: Schenkung) kind empirical {
    label de official "Das Schenkungsversprechen ist notariell beurkundet (§ 518 Absatz 1 Satz 1)";
    label en unofficial "the promise of a gift has been recorded by a notary (§ 518 (1) sentence 1)";
}
pub relation versprochene_leistung_bewirkt(s: Schenkung) kind empirical {
    label de official "Die versprochene Leistung ist bewirkt (§ 518 Absatz 2)";
    label en unofficial "the promised performance has been rendered (§ 518 (2))";
}
pub relation schenkungsversprechen_gueltig(s: Schenkung) kind institutional {
    label de official "Das Schenkungsversprechen ist gültig (§ 518)";
    label en unofficial "the promise of a gift is valid (§ 518)";
}

@source(BGB_P518) {
    rule SchenkungsversprechenGueltigBeiBeurkundung(s: Schenkung) strict {
        label de official "Zur Gültigkeit eines Vertrags, durch den eine Leistung schenkweise versprochen wird, ist die notarielle Beurkundung des Versprechens erforderlich (§ 518 Absatz 1 Satz 1)";
        label en unofficial "the validity of a contract by which performance is promised by way of gift requires notarial recording of the promise (§ 518 (1) sentence 1)";
        when schenkungsversprechen(s) and notariell_beurkundet(s);
        then schenkungsversprechen_gueltig(s);
    }
    rule FormmangelGeheiltDurchBewirkung(s: Schenkung) strict {
        label de official "Der Mangel der Form wird durch die Bewirkung der versprochenen Leistung geheilt (§ 518 Absatz 2)";
        label en unofficial "the defect of form is cured by rendering the promised performance (§ 518 (2))";
        when schenkungsversprechen(s) and versprochene_leistung_bewirkt(s);
        then schenkungsversprechen_gueltig(s);
    }
}

// § 519: Einrede des Notbedarfs — Wertung „angemessener Unterhalt".

@source(BGB_P519)
pub external judgment relation angemessener_unterhalt_gefaehrdet_519(s: Schenkung) {
    authority Court;
    label de official "Der Schenker ist bei Berücksichtigung seiner sonstigen Verpflichtungen außerstande, das Versprechen zu erfüllen, ohne dass sein angemessener Unterhalt oder die Erfüllung der ihm kraft Gesetzes obliegenden Unterhaltspflichten gefährdet wird (§ 519 Absatz 1)";
    label en unofficial "having regard to his other obligations the donor is unable to perform the promise without endangering his reasonable maintenance or the statutory maintenance obligations incumbent on him (§ 519 (1))";
}
pub relation einrede_des_notbedarfs(s: Schenkung) kind institutional {
    label de official "Der Schenker ist berechtigt, die Erfüllung eines schenkweise erteilten Versprechens zu verweigern (§ 519 Absatz 1)";
    label en unofficial "the donor is entitled to refuse performance of a promise made by way of gift (§ 519 (1))";
}
@source(BGB_P519)
rule EinredeDesNotbedarfs(s: Schenkung) strict {
    label de official "Der Schenker ist berechtigt, die Erfüllung eines schenkweise erteilten Versprechens zu verweigern, soweit er bei Berücksichtigung seiner sonstigen Verpflichtungen außerstande ist, das Versprechen zu erfüllen, ohne dass sein angemessener Unterhalt oder die Erfüllung der ihm kraft Gesetzes obliegenden Unterhaltspflichten gefährdet wird (§ 519 Absatz 1)";
    label en unofficial "the donor may refuse performance of a promise made by way of gift in so far as, having regard to his other obligations, he is unable to perform it without endangering his reasonable maintenance or his statutory maintenance obligations (§ 519 (1))";
    when schenkungsversprechen_gueltig(s) and angemessener_unterhalt_gefaehrdet_519(s);
    then einrede_des_notbedarfs(s);
}
pub relation schenker_519(s: Schenkung, p: Person) kind empirical {
    label de official "Schenker nach § 519";
    label en unofficial "donor under § 519";
}
pub relation verweigerung_519_am(s: Schenkung, tag: Date) kind empirical {
    label de official "Der Schenker hat die Erfüllung verweigert (§ 519)";
    label en unofficial "the donor refused performance (§ 519)";
}
pub relation einrede_519_beginn_am(s: Schenkung, tag: Date) kind empirical {
    label de official "Beginn der Einrede nach § 519";
    label en unofficial "start of the defence under § 519";
}
@source(BGB_P519)
rule Position519Einrede(s: Schenkung, p: Person, beginn: Date) strict {
    label de official "Der Schenker ist berechtigt, die Erfüllung bei Gefährdung seines Unterhalts zu verweigern (§ 519)";
    label en unofficial "The donor has the liberty to refuse performance where maintenance is endangered (§ 519)";
    when schenker_519(s, p) and schenkungsversprechen_gueltig(s)
     and angemessener_unterhalt_gefaehrdet_519(s)
     and einrede_519_beginn_am(s, beginn);
    then liberty Liberty519Einrede {
        holder p;
        action verweigerung_519_am(s, beginn);
        window [beginn, infinity);
    };
}

// § 521, § 522, § 523, § 524: Haftungsmaßstab und Mängelhaftung des Schenkers.

pub relation schenker_haftet_nur_fuer_vorsatz_und_grobe_fahrlaessigkeit(s: Schenkung) kind institutional {
    label de official "Der Schenker hat nur Vorsatz und grobe Fahrlässigkeit zu vertreten (§ 521)";
    label en unofficial "the donor is responsible only for intent and gross negligence (§ 521)";
}
pub relation keine_verzugszinsen_des_schenkers(s: Schenkung) kind institutional {
    label de official "Zur Entrichtung von Verzugszinsen ist der Schenker nicht verpflichtet (§ 522)";
    label en unofficial "the donor is not obliged to pay default interest (§ 522)";
}
pub relation rechtsmangel_arglistig_verschwiegen(s: Schenkung) kind empirical {
    label de official "Der Schenker hat arglistig einen Mangel im Recht verschwiegen (§ 523 Absatz 1)";
    label en unofficial "the donor fraudulently concealed a defect of title (§ 523 (1))";
}
pub relation sachmangel_arglistig_verschwiegen(s: Schenkung) kind empirical {
    label de official "Der Schenker hat arglistig einen Fehler der verschenkten Sache verschwiegen (§ 524 Absatz 1)";
    label en unofficial "the donor fraudulently concealed a defect of the thing given (§ 524 (1))";
}
pub relation schadensersatzanspruch_des_beschenkten(s: Schenkung) kind institutional {
    label de official "Der Schenker ist verpflichtet, dem Beschenkten den aus dem arglistig verschwiegenen Mangel entstehenden Schaden zu ersetzen (§ 523 Absatz 1, § 524 Absatz 1)";
    label en unofficial "the donor must compensate the donee for the damage arising from the fraudulently concealed defect (§ 523 (1), § 524 (1))";
}

@source(BGB_P521)
rule HaftungDesSchenkers(s: Schenkung) strict {
    label de official "Der Schenker hat nur Vorsatz und grobe Fahrlässigkeit zu vertreten (§ 521)";
    label en unofficial "the donor is responsible only for intent and gross negligence (§ 521)";
    when schenkung_liegt_vor(s);
    then schenker_haftet_nur_fuer_vorsatz_und_grobe_fahrlaessigkeit(s);
}
pub relation schenker_521(s: Schenkung, p: Person) kind empirical {
    label de official "Schenker nach § 521";
    label en unofficial "donor under § 521";
}
pub relation haftungsbegrenzung_521_berufen_am(s: Schenkung, tag: Date) kind empirical {
    label de official "Der Schenker hat sich auf die Haftungsbegrenzung berufen (§ 521)";
    label en unofficial "the donor invoked the limitation of liability (§ 521)";
}
pub relation haftungsbeginn_521_am(s: Schenkung, tag: Date) kind empirical {
    label de official "Beginn der Haftungsbegrenzung nach § 521";
    label en unofficial "start of the limitation of liability under § 521";
}
@source(BGB_P521)
rule Position521Haftung(s: Schenkung, p: Person, beginn: Date) strict {
    label de official "Der Schenker ist berechtigt, sich auf Vorsatz und grobe Fahrlässigkeit als Haftungsmaßstab zu berufen (§ 521)";
    label en unofficial "The donor has the liberty to invoke the intent and gross negligence liability standard (§ 521)";
    when schenker_521(s, p) and schenkung_liegt_vor(s)
     and haftungsbeginn_521_am(s, beginn);
    then liberty Liberty521Haftung {
        holder p;
        action haftungsbegrenzung_521_berufen_am(s, beginn);
        window [beginn, infinity);
    };
}
@source(BGB_P522)
rule KeineVerzugszinsen(s: Schenkung) strict {
    label de official "Zur Entrichtung von Verzugszinsen ist der Schenker nicht verpflichtet (§ 522)";
    label en unofficial "the donor is not obliged to pay default interest (§ 522)";
    when schenkung_liegt_vor(s);
    then keine_verzugszinsen_des_schenkers(s);
}
@source(BGB_P523)
rule HaftungFuerArglistigVerschwiegenenRechtsmangel(s: Schenkung) strict {
    label de official "Verschweigt der Schenker arglistig einen Mangel im Recht, so ist er verpflichtet, dem Beschenkten den daraus entstehenden Schaden zu ersetzen (§ 523 Absatz 1)";
    label en unofficial "where the donor fraudulently conceals a defect of title he must compensate the donee for the resulting damage (§ 523 (1))";
    when schenkung_liegt_vor(s) and rechtsmangel_arglistig_verschwiegen(s);
    then schadensersatzanspruch_des_beschenkten(s);
}
@source(BGB_P524)
rule HaftungFuerArglistigVerschwiegenenSachmangel(s: Schenkung) strict {
    label de official "Verschweigt der Schenker arglistig einen Fehler der verschenkten Sache, so ist er verpflichtet, dem Beschenkten den daraus entstehenden Schaden zu ersetzen (§ 524 Absatz 1)";
    label en unofficial "where the donor fraudulently conceals a defect of the thing given he must compensate the donee for the resulting damage (§ 524 (1))";
    when schenkung_liegt_vor(s) and sachmangel_arglistig_verschwiegen(s);
    then schadensersatzanspruch_des_beschenkten(s);
}
pub relation schenker_524(s: Schenkung, p: Person) kind empirical {
    label de official "Schenker nach § 524";
    label en unofficial "donor under § 524";
}
pub relation schadensersatz_524_geleistet_am(s: Schenkung, tag: Date) kind empirical {
    label de official "Der Schenker hat den Schaden ersetzt (§ 524)";
    label en unofficial "the donor compensated the damage (§ 524)";
}
pub relation schadensersatzpflicht_524_beginn_am(s: Schenkung, tag: Date) kind empirical {
    label de official "Beginn der Schadensersatzpflicht nach § 524";
    label en unofficial "start of the compensation duty under § 524";
}
@source(BGB_P524)
rule Position524Schadensersatz(s: Schenkung, p: Person, beginn: Date) strict {
    label de official "Der Schenker ist verpflichtet, einen arglistig verschwiegenen Mangel zu ersetzen (§ 524)";
    label en unofficial "The donor is obliged to compensate a fraudulently concealed defect (§ 524)";
    when schenker_524(s, p) and schenkung_liegt_vor(s)
     and sachmangel_arglistig_verschwiegen(s)
     and schadensersatzpflicht_524_beginn_am(s, beginn);
    then duty Duty524Schadensersatz {
        bearer p;
        achieve schadensersatz_524_geleistet_am(s, beginn) during [beginn, infinity);
    };
}

// § 525, § 527: Schenkung unter Auflage.

pub relation auflage_vereinbart(s: Schenkung) kind empirical {
    label de official "Die Schenkung ist unter einer Auflage gemacht (§ 525 Absatz 1)";
    label en unofficial "the gift is made subject to a condition (§ 525 (1))";
}
pub relation schenker_hat_geleistet(s: Schenkung) kind empirical {
    label de official "Der Schenker hat seinerseits geleistet (§ 525 Absatz 1)";
    label en unofficial "the donor has performed on his part (§ 525 (1))";
}
pub relation auflage_vollzogen(s: Schenkung) kind empirical {
    label de official "Der Beschenkte hat die Auflage vollzogen (§ 527 Absatz 1)";
    label en unofficial "the donee has fulfilled the condition (§ 527 (1))";
}
pub relation dritter_zur_vollziehung_berechtigt(s: Schenkung) kind empirical {
    label de official "Ein Dritter ist berechtigt, die Vollziehung der Auflage zu verlangen (§ 527 Absatz 2)";
    label en unofficial "a third party is entitled to demand fulfilment of the condition (§ 527 (2))";
}
pub relation anspruch_auf_vollziehung_der_auflage(s: Schenkung) kind institutional {
    label de official "Der Schenker kann die Vollziehung der Auflage verlangen (§ 525 Absatz 1)";
    label en unofficial "the donor may demand fulfilment of the condition (§ 525 (1))";
}
pub relation herausgabeanspruch_wegen_nichtvollziehung(s: Schenkung) kind institutional {
    label de official "Der Schenker kann die Herausgabe des Geschenkes fordern, soweit das Geschenk zur Vollziehung der Auflage hätte verwendet werden müssen (§ 527 Absatz 1)";
    label en unofficial "the donor may demand return of the gift in so far as it should have been used to fulfil the condition (§ 527 (1))";
}

@source(BGB_P525)
rule AnspruchAufVollziehungDerAuflage(s: Schenkung) strict {
    label de official "Wer eine Schenkung unter einer Auflage macht, kann die Vollziehung der Auflage verlangen, wenn er seinerseits geleistet hat (§ 525 Absatz 1)";
    label en unofficial "a person making a gift subject to a condition may demand fulfilment of the condition once he has performed on his part (§ 525 (1))";
    when schenkung_liegt_vor(s) and auflage_vereinbart(s) and schenker_hat_geleistet(s);
    then anspruch_auf_vollziehung_der_auflage(s);
}
@source(BGB_P527)
rule HerausgabeWegenNichtvollziehung(s: Schenkung) strict {
    label de official "Unterbleibt die Vollziehung der Auflage, so kann der Schenker die Herausgabe des Geschenkes fordern, soweit das Geschenk zur Vollziehung der Auflage hätte verwendet werden müssen; der Anspruch ist ausgeschlossen, wenn ein Dritter berechtigt ist, die Vollziehung zu verlangen (§ 527)";
    label en unofficial "where the condition is not fulfilled the donor may demand return of the gift in so far as it should have been used for that purpose; the claim is excluded where a third party is entitled to demand fulfilment (§ 527)";
    when anspruch_auf_vollziehung_der_auflage(s) and not_known(auflage_vollzogen(s))
        and not_known(dritter_zur_vollziehung_berechtigt(s));
    then herausgabeanspruch_wegen_nichtvollziehung(s);
}
pub relation schenker_527(s: Schenkung, p: Person) kind empirical {
    label de official "Schenker nach § 527";
    label en unofficial "donor under § 527";
}
pub relation herausgabe_527_verlangt_am(s: Schenkung, tag: Date) kind empirical {
    label de official "Der Schenker hat die Herausgabe des Geschenkes verlangt (§ 527)";
    label en unofficial "the donor demanded return of the gift (§ 527)";
}
pub relation herausgaberecht_527_beginn_am(s: Schenkung, tag: Date) kind empirical {
    label de official "Beginn des Herausgaberechts nach § 527";
    label en unofficial "start of the return power under § 527";
}
@source(BGB_P527)
rule Position527Herausgabe(s: Schenkung, p: Person, beginn: Date) strict {
    label de official "Der Schenker ist berechtigt, bei Nichtvollziehung der Auflage die Herausgabe zu verlangen (§ 527)";
    label en unofficial "The donor has the power to demand return where the condition was not fulfilled (§ 527)";
    when schenker_527(s, p) and anspruch_auf_vollziehung_der_auflage(s)
     and not_known(auflage_vollzogen(s))
     and not_known(dritter_zur_vollziehung_berechtigt(s))
     and herausgaberecht_527_beginn_am(s, beginn);
    then liberty Liberty527Herausgabe {
        holder p;
        action herausgabe_527_verlangt_am(s, beginn);
        window [beginn, infinity);
    };
}

// § 520 (D-08-23): Erlöschen eines Rentenversprechens mit dem Tode des
// Schenkers, soweit sich aus dem Versprechen nichts anderes ergibt.
pub relation rentenversprechen_520(s: Schenkung) kind empirical {
    label de official "Der Schenker verspricht eine in wiederkehrenden Leistungen bestehende Unterstützung (§ 520)";
    label en unofficial "the donor promises support consisting of recurring payments (§ 520)";
}
pub relation schenker_verstorben_520(s: Schenkung) kind empirical {
    label de official "Der Schenker ist verstorben (§ 520)";
    label en unofficial "the donor has died (§ 520)";
}
pub relation anderes_ergibt_sich_aus_versprechen_520(s: Schenkung) kind empirical {
    label de official "Aus dem Versprechen ergibt sich ein anderes als das Erlöschen mit dem Tode (§ 520)";
    label en unofficial "the promise indicates something other than lapse upon death (§ 520)";
}
pub relation verbindlichkeit_520_erloschen(s: Schenkung) kind institutional {
    label de official "Die Verbindlichkeit aus dem Rentenversprechen ist mit dem Tode des Schenkers erloschen (§ 520)";
    label en unofficial "the obligation under the promise of recurring support lapses upon the donor's death (§ 520)";
}
@source(BGB_P520)
rule Verbindlichkeit520ErlischtMitTod(s: Schenkung) strict {
    label de official "Verspricht der Schenker eine in wiederkehrenden Leistungen bestehende Unterstützung, so erlischt die Verbindlichkeit mit seinem Tode, sofern nicht aus dem Versprechen sich ein anderes ergibt (§ 520)";
    label en unofficial "where the donor promises support consisting of recurring payments, the obligation lapses upon his death, unless the promise indicates otherwise (§ 520)";
    when rentenversprechen_520(s) and schenker_verstorben_520(s) and not_known(anderes_ergibt_sich_aus_versprechen_520(s));
    then verbindlichkeit_520_erloschen(s);
}

// § 526 (D-08-23): Verweigerungsrecht des Beschenkten, solange der
// mangelbedingte Fehlbetrag nicht ausgeglichen ist.
pub relation wert_der_zuwendung_526(s: Schenkung, betrag: Money) kind empirical {
    key(s);
    label de official "Wert der Zuwendung, gemindert durch einen Mangel im Recht oder einen Mangel der verschenkten Sache (§ 526 Satz 1)";
    label en unofficial "value of the gift, reduced by a defect of title or a defect of the thing given (§ 526 sentence 1)";
}
pub relation erforderliche_aufwendungen_zur_auflage_526(s: Schenkung, betrag: Money) kind empirical {
    key(s);
    label de official "Zur Vollziehung der Auflage erforderliche Aufwendungen (§ 526 Satz 1)";
    label en unofficial "outlays necessary to fulfil the condition (§ 526 sentence 1)";
}
pub relation fehlbetrag_526_ausgeglichen(s: Schenkung) kind empirical {
    label de official "Der durch den Mangel entstandene Fehlbetrag ist ausgeglichen worden (§ 526 Satz 1)";
    label en unofficial "the shortfall caused by the defect has been made up (§ 526 sentence 1)";
}
pub relation vollziehung_526_verweigerbar(s: Schenkung) kind institutional {
    label de official "Der Beschenkte ist berechtigt, die Vollziehung der Auflage zu verweigern, bis der Fehlbetrag ausgeglichen wird (§ 526 Satz 1)";
    label en unofficial "the donee is entitled to refuse fulfilment of the condition until the shortfall is made up (§ 526 sentence 1)";
}
@source(BGB_P526)
rule Vollziehung526VerweigerbarBeiWertminderung(s: Schenkung, wert: Money, aufwendungen: Money) strict {
    label de official "Soweit infolge eines Mangels im Recht oder eines Mangels der verschenkten Sache der Wert der Zuwendung die Höhe der zur Vollziehung der Auflage erforderlichen Aufwendungen nicht erreicht, ist der Beschenkte berechtigt, die Vollziehung der Auflage zu verweigern, bis der Fehlbetrag ausgeglichen wird (§ 526 Satz 1)";
    label en unofficial "in so far as, owing to a defect of title or of the thing given, the value of the gift does not reach the amount of outlays necessary to fulfil the condition, the donee may refuse fulfilment until the shortfall is made up (§ 526 sentence 1)";
    when wert_der_zuwendung_526(s, wert) and erforderliche_aufwendungen_zur_auflage_526(s, aufwendungen)
        and wert < aufwendungen and not_known(fehlbetrag_526_ausgeglichen(s));
    then vollziehung_526_verweigerbar(s);
}
pub relation beschenkter_526(s: Schenkung, p: Person) kind empirical {
    label de official "Beschenkter nach § 526";
    label en unofficial "donee under § 526";
}
pub relation verweigerung_526_am(s: Schenkung, tag: Date) kind empirical {
    label de official "Der Beschenkte hat die Vollziehung der Auflage verweigert (§ 526)";
    label en unofficial "the donee refused fulfilment of the condition (§ 526)";
}
pub relation verweigerungsrecht_526_beginn_am(s: Schenkung, tag: Date) kind empirical {
    label de official "Beginn des Verweigerungsrechts nach § 526";
    label en unofficial "start of the refusal liberty under § 526";
}
@source(BGB_P526)
rule Position526Verweigerung(s: Schenkung, p: Person, beginn: Date) strict {
    label de official "Der Beschenkte ist berechtigt, die Vollziehung der Auflage bis zum Ausgleich des Fehlbetrags zu verweigern (§ 526)";
    label en unofficial "The donee has the liberty to refuse fulfilment of the condition until the shortfall is made up (§ 526)";
    when beschenkter_526(s, p) and wert_der_zuwendung_526(s, 100 EUR)
     and erforderliche_aufwendungen_zur_auflage_526(s, 200 EUR)
     and verweigerungsrecht_526_beginn_am(s, beginn);
    then liberty Liberty526Verweigerung {
        holder p;
        action verweigerung_526_am(s, beginn);
        window [beginn, infinity);
    };
}

// § 533 (D-08-23): Verzicht auf das Widerrufsrecht erst wirksam, wenn der
// Undank dem Widerrufsberechtigten bekannt geworden ist.
pub relation verzicht_auf_widerrufsrecht_erklaert_533(s: Schenkung) kind empirical {
    label de official "Der Widerrufsberechtigte hat auf das Widerrufsrecht wegen groben Undanks verzichtet (§ 533)";
    label en unofficial "the person entitled to revoke has waived the right to revoke for gross ingratitude (§ 533)";
}
pub relation undank_dem_widerrufsberechtigten_bekannt_geworden_533(s: Schenkung) kind empirical {
    label de official "Der Undank ist dem Widerrufsberechtigten bekannt geworden (§ 533)";
    label en unofficial "the ingratitude has become known to the person entitled to revoke (§ 533)";
}
pub relation verzicht_533_wirksam(s: Schenkung) kind institutional {
    label de official "Der Verzicht auf das Widerrufsrecht ist wirksam (§ 533)";
    label en unofficial "the waiver of the right to revoke is effective (§ 533)";
}
@source(BGB_P533)
rule Verzicht533WirksamNurNachBekanntwerden(s: Schenkung) strict {
    label de official "Auf das Widerrufsrecht kann erst verzichtet werden, wenn der Undank dem Widerrufsberechtigten bekannt geworden ist (§ 533)";
    label en unofficial "the right to revoke may be waived only once the ingratitude has become known to the person entitled to revoke (§ 533)";
    when verzicht_auf_widerrufsrecht_erklaert_533(s) and undank_dem_widerrufsberechtigten_bekannt_geworden_533(s);
    then verzicht_533_wirksam(s);
}

// § 528, § 529: Rückforderung wegen Verarmung des Schenkers und ihr Ausschluss.
// Die Zehnjahresfrist des § 529 Absatz 1 zählt ab der LEISTUNG des geschenkten
// Gegenstandes; verglichen wird mit dem Tag des Eintritts der Bedürftigkeit.

@source(BGB_P528)
pub external judgment relation schenker_kann_unterhalt_nicht_bestreiten(s: Schenkung) {
    authority Court;
    label de official "Der Schenker ist nach der Vollziehung der Schenkung außerstande, seinen angemessenen Unterhalt zu bestreiten und die ihm gegenüber Verwandten, Ehegatten oder Lebenspartnern gesetzlich obliegende Unterhaltspflicht zu erfüllen (§ 528 Absatz 1 Satz 1)";
    label en unofficial "after the gift has been executed the donor is unable to provide his reasonable maintenance and to meet his statutory maintenance obligations towards relatives, spouse or civil partner (§ 528 (1) sentence 1)";
}
pub relation ruckforderungsfrist_529(f: Frist) kind empirical {
    key(f);
    label de official "Zehnjahresfrist des § 529 Absatz 1: seit der Leistung des geschenkten Gegenstandes";
    label en unofficial "the ten-year period of § 529 (1): since delivery of the object given";
}
pub relation leistung_des_geschenkten_gegenstandes_am(f: Frist, tag: Date) kind empirical {
    key(f);
    label de official "Tag der Leistung des geschenkten Gegenstandes (§ 529 Absatz 1)";
    label en unofficial "day of delivery of the object given (§ 529 (1))";
}
pub relation beduerftigkeit_eingetreten_am(s: Schenkung, tag: Date) kind empirical {
    key(s);
    label de official "Tag des Eintritts der Bedürftigkeit des Schenkers — festgestellte Tatsache des Falls (§ 529 Absatz 1)";
    label en unofficial "day on which the donor's neediness arose — an established fact of the case (§ 529 (1))";
}
pub relation beduerftigkeit_vorsaetzlich_oder_grob_fahrlaessig_herbeigefuehrt(s: Schenkung) kind empirical {
    label de official "Der Schenker hat seine Bedürftigkeit vorsätzlich oder durch grobe Fahrlässigkeit herbeigeführt (§ 529 Absatz 1)";
    label en unofficial "the donor caused his neediness intentionally or by gross negligence (§ 529 (1))";
}
pub relation rueckforderungsanspruch_ausgeschlossen(s: Schenkung) kind institutional {
    label de official "Der Anspruch auf Herausgabe des Geschenkes ist ausgeschlossen (§ 529)";
    label en unofficial "the claim for return of the gift is excluded (§ 529)";
}
pub relation rueckforderungsanspruch_528(s: Schenkung) kind institutional {
    label de official "Der Schenker kann von dem Beschenkten die Herausgabe des Geschenkes nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung fordern (§ 528 Absatz 1 Satz 1)";
    label en unofficial "the donor may demand return of the gift from the donee under the rules on unjust enrichment (§ 528 (1) sentence 1)";
}

@source(BGB_P529) {
    rule Rueckforderungsfrist529Ereignis(f: Frist, t: Date) strict {
        label de official "Die Zehnjahresfrist läuft von der Leistung des geschenkten Gegenstandes an (§ 529 Absatz 1, § 187 Absatz 2)";
        label en unofficial "the ten-year period runs from delivery of the object given (§ 529 (1), § 187 (2))";
        when ruckforderungsfrist_529(f) and leistung_des_geschenkten_gegenstandes_am(f, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
    rule Rueckforderungsfrist529Dauer(f: Frist) strict {
        label de official "Der Anspruch ist ausgeschlossen, wenn zur Zeit des Eintritts der Bedürftigkeit seit der Leistung des geschenkten Gegenstandes zehn Jahre verstrichen sind (§ 529 Absatz 1)";
        label en unofficial "the claim is excluded where, at the time the neediness arose, ten years had elapsed since delivery of the object given (§ 529 (1))";
        when ruckforderungsfrist_529(f);
        then de.bgb.fristen::frist_dauer_kalender(f, 10 calendar_year);
    }
    rule AusschlussWegenSelbstverschuldeterBeduerftigkeit(s: Schenkung) strict {
        label de official "Der Anspruch auf Herausgabe des Geschenkes ist ausgeschlossen, wenn der Schenker seine Bedürftigkeit vorsätzlich oder durch grobe Fahrlässigkeit herbeigeführt hat (§ 529 Absatz 1)";
        label en unofficial "the claim for return of the gift is excluded where the donor caused his neediness intentionally or by gross negligence (§ 529 (1))";
        when schenkung_liegt_vor(s) and beduerftigkeit_vorsaetzlich_oder_grob_fahrlaessig_herbeigefuehrt(s);
        then rueckforderungsanspruch_ausgeschlossen(s);
    }
    rule AusschlussWegenZeitablaufs(s: Schenkung, f: Frist, beduerftig: Date, ende: Date) strict {
        label de official "Der Anspruch ist ausgeschlossen, wenn zur Zeit des Eintritts der Bedürftigkeit seit der Leistung des geschenkten Gegenstandes zehn Jahre verstrichen sind (§ 529 Absatz 1)";
        label en unofficial "the claim is excluded where, at the time the neediness arose, ten years had elapsed since delivery of the object given (§ 529 (1))";
        when schenkung_liegt_vor(s) and ruckforderungsfrist_529(f)
            and beduerftigkeit_eingetreten_am(s, beduerftig)
            and de.bgb.fristen::frist_ende_kalender(f, ende) and beduerftig > ende;
        then rueckforderungsanspruch_ausgeschlossen(s);
    }
}
@source(BGB_P528)
rule RueckforderungWegenVerarmung(s: Schenkung) strict {
    label de official "Soweit der Schenker nach der Vollziehung der Schenkung außerstande ist, seinen angemessenen Unterhalt zu bestreiten und seine gesetzlichen Unterhaltspflichten zu erfüllen, kann er von dem Beschenkten die Herausgabe des Geschenkes nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung fordern (§ 528 Absatz 1 Satz 1)";
    label en unofficial "in so far as, after execution of the gift, the donor is unable to provide his reasonable maintenance and meet his statutory maintenance obligations, he may demand return of the gift from the donee under the rules on unjust enrichment (§ 528 (1) sentence 1)";
    when schenkung_liegt_vor(s) and schenker_kann_unterhalt_nicht_bestreiten(s)
        and not_known(rueckforderungsanspruch_ausgeschlossen(s));
    then rueckforderungsanspruch_528(s);
}

// § 530, § 531, § 532, § 533, § 534: Widerruf wegen groben Undanks.

@source(BGB_P530)
pub external judgment relation grober_undank(s: Schenkung) {
    authority Court;
    label de official "Der Beschenkte macht sich durch eine schwere Verfehlung gegen den Schenker oder einen nahen Angehörigen des Schenkers groben Undanks schuldig (§ 530 Absatz 1)";
    label en unofficial "the donee is guilty of gross ingratitude through a serious wrong against the donor or a close relative of the donor (§ 530 (1))";
}
pub relation schenker_hat_verziehen(s: Schenkung) kind empirical {
    label de official "Der Schenker hat dem Beschenkten verziehen (§ 532 Satz 1)";
    label en unofficial "the donor has forgiven the donee (§ 532 sentence 1)";
}
pub relation beschenkter_verstorben(s: Schenkung) kind empirical {
    label de official "Der Beschenkte ist verstorben — nach seinem Tode ist der Widerruf nicht mehr zulässig (§ 532 Satz 2)";
    label en unofficial "the donee has died — after his death revocation is no longer admissible (§ 532 sentence 2)";
}
pub relation widerrufsfrist_532(f: Frist) kind empirical {
    key(f);
    label de official "Jahresfrist des § 532 Satz 1: ab dem Zeitpunkt, in welchem der Widerrufsberechtigte von dem Eintritt der Voraussetzungen seines Rechts Kenntnis erlangt hat";
    label en unofficial "the one-year period of § 532 sentence 1: from the time when the person entitled to revoke learned that the requirements of his right had arisen";
}
pub relation kenntnis_vom_widerrufsgrund_am(f: Frist, tag: Date) kind empirical {
    key(f);
    label de official "Tag, an dem der Widerrufsberechtigte von dem Eintritt der Voraussetzungen seines Rechts Kenntnis erlangt hat — festgestellte Tatsache des Falls (§ 532 Satz 1)";
    label en unofficial "day on which the person entitled to revoke learned that the requirements of his right had arisen — an established fact of the case (§ 532 sentence 1)";
}
pub relation widerruf_erklaert_am(s: Schenkung, tag: Date) kind empirical {
    key(s);
    label de official "Tag, an dem der Widerruf gegenüber dem Beschenkten erklärt wurde (§ 531 Absatz 1)";
    label en unofficial "day on which revocation was declared to the donee (§ 531 (1))";
}
pub relation pflicht_oder_anstandsschenkung(s: Schenkung) kind empirical {
    label de official "Schenkung, durch die einer sittlichen Pflicht oder einer auf den Anstand zu nehmenden Rücksicht entsprochen wird (§ 534)";
    label en unofficial "a gift made in compliance with a moral duty or in consideration of decency (§ 534)";
}
pub relation widerruf_ausgeschlossen(s: Schenkung) kind institutional {
    label de official "Der Widerruf der Schenkung ist ausgeschlossen (§§ 532, 534)";
    label en unofficial "revocation of the gift is excluded (§§ 532, 534)";
}
pub relation schenkung_widerrufen(s: Schenkung) kind institutional {
    label de official "Die Schenkung ist widerrufen (§ 530 Absatz 1, § 531 Absatz 1)";
    label en unofficial "the gift has been revoked (§ 530 (1), § 531 (1))";
}
pub relation herausgabe_nach_widerruf(s: Schenkung) kind institutional {
    label de official "Ist die Schenkung widerrufen, so kann die Herausgabe des Geschenks nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung gefordert werden (§ 531 Absatz 2)";
    label en unofficial "where the gift has been revoked, its return may be demanded under the rules on unjust enrichment (§ 531 (2))";
}

@source(BGB_P532) {
    rule Widerrufsfrist532Ereignis(f: Frist, t: Date) strict {
        label de official "Die Jahresfrist läuft von dem Zeitpunkt an, in welchem der Widerrufsberechtigte von dem Eintritt der Voraussetzungen seines Rechts Kenntnis erlangt hat (§ 532 Satz 1, § 187 Absatz 2)";
        label en unofficial "the one-year period runs from the time when the person entitled to revoke learned that the requirements of his right had arisen (§ 532 sentence 1, § 187 (2))";
        when widerrufsfrist_532(f) and kenntnis_vom_widerrufsgrund_am(f, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
    rule Widerrufsfrist532Dauer(f: Frist) strict {
        label de official "Der Widerruf ist ausgeschlossen, wenn seit dem Zeitpunkt der Kenntnis ein Jahr verstrichen ist (§ 532 Satz 1)";
        label en unofficial "revocation is excluded where one year has elapsed since the time of knowledge (§ 532 sentence 1)";
        when widerrufsfrist_532(f);
        then de.bgb.fristen::frist_dauer_kalender(f, 1 calendar_year);
    }
    rule WiderrufAusgeschlossenNachVerzeihung(s: Schenkung) strict {
        label de official "Der Widerruf ist ausgeschlossen, wenn der Schenker dem Beschenkten verziehen hat (§ 532 Satz 1)";
        label en unofficial "revocation is excluded where the donor has forgiven the donee (§ 532 sentence 1)";
        when schenkung_liegt_vor(s) and schenker_hat_verziehen(s);
        then widerruf_ausgeschlossen(s);
    }
    rule WiderrufAusgeschlossenNachJahresfrist(s: Schenkung, f: Frist, erklaert: Date, ende: Date) strict {
        label de official "Der Widerruf ist ausgeschlossen, wenn seit dem Zeitpunkt, in welchem der Widerrufsberechtigte von dem Eintritt der Voraussetzungen seines Rechts Kenntnis erlangt hat, ein Jahr verstrichen ist (§ 532 Satz 1)";
        label en unofficial "revocation is excluded where one year has elapsed since the person entitled to revoke learned that the requirements of his right had arisen (§ 532 sentence 1)";
        when schenkung_liegt_vor(s) and widerrufsfrist_532(f) and widerruf_erklaert_am(s, erklaert)
            and de.bgb.fristen::frist_ende(f, ende) and erklaert > ende;
        then widerruf_ausgeschlossen(s);
    }
    rule WiderrufAusgeschlossenNachTodDesBeschenkten(s: Schenkung) strict {
        label de official "Nach dem Tode des Beschenkten ist der Widerruf nicht mehr zulässig (§ 532 Satz 2)";
        label en unofficial "after the donee's death revocation is no longer admissible (§ 532 sentence 2)";
        when schenkung_liegt_vor(s) and beschenkter_verstorben(s);
        then widerruf_ausgeschlossen(s);
    }
}
@source(BGB_P534)
rule PflichtUndAnstandsschenkungen(s: Schenkung) strict {
    label de official "Schenkungen, durch die einer sittlichen Pflicht oder einer auf den Anstand zu nehmenden Rücksicht entsprochen wird, unterliegen nicht der Rückforderung und dem Widerruf (§ 534)";
    label en unofficial "gifts made in compliance with a moral duty or in consideration of decency are not subject to reclaim or revocation (§ 534)";
    when schenkung_liegt_vor(s) and pflicht_oder_anstandsschenkung(s);
    then widerruf_ausgeschlossen(s);
}
@source(BGB_P530)
rule WiderrufWegenGrobenUndanks(s: Schenkung, erklaert: Date) strict {
    label de official "Eine Schenkung kann widerrufen werden, wenn sich der Beschenkte durch eine schwere Verfehlung gegen den Schenker oder einen nahen Angehörigen des Schenkers groben Undanks schuldig macht; der Widerruf erfolgt durch Erklärung gegenüber dem Beschenkten (§ 530 Absatz 1, § 531 Absatz 1)";
    label en unofficial "a gift may be revoked where the donee is guilty of gross ingratitude through a serious wrong against the donor or a close relative; revocation is effected by declaration to the donee (§ 530 (1), § 531 (1))";
    when schenkung_liegt_vor(s) and grober_undank(s) and widerruf_erklaert_am(s, erklaert)
        and not_known(widerruf_ausgeschlossen(s));
    then schenkung_widerrufen(s);
}
@source(BGB_P531)
rule HerausgabeNachWiderruf(s: Schenkung) strict {
    label de official "Ist die Schenkung widerrufen, so kann die Herausgabe des Geschenks nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung gefordert werden (§ 531 Absatz 2)";
    label en unofficial "where the gift has been revoked, its return may be demanded under the rules on unjust enrichment (§ 531 (2))";
    when schenkung_widerrufen(s);
    then herausgabe_nach_widerruf(s);
}
