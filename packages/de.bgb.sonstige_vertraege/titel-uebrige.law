// DIE ÜBRIGEN TITEL DES ABSCHNITTS 8
// Titel 2 Teilzeit-Wohnrechteverträge (§§ 481–487), Titel 6 Leihe (§§ 598–606),
// Titel 7 Sachdarlehen (§§ 607–609), Titel 10 Mäklervertrag (§§ 652–656d),
// Titel 11 Auslobung (§§ 657–661a), Titel 13 Geschäftsführung ohne Auftrag
// (§§ 677–687), Titel 14 Verwahrung (§§ 688–700), Titel 15 Einbringung von
// Sachen bei Gastwirten (§§ 701–704), Titel 19 Spiel, Wette (§§ 762–763),
// Titel 21 Vergleich (§ 779), Titel 22 Schuldversprechen (§§ 780–782),
// Titel 23 Anweisung (§§ 783–792), Titel 24 Schuldverschreibung auf den
// Inhaber (§§ 793–794, 796–801, 803–808), Titel 25 Vorlegung von Sachen
// (§§ 809–811).
//
// Teil des Pakets BG-08 (`package.law`).
//
// DIE ANWEISUNG (§§ 783–792, D-08-09) führt drei Rollen — Anweisender,
// Angewiesener, Anweisungsempfänger — über einen einzigen Urkundentyp
// `Anweisung`; die Aushändigung an den Empfänger (§ 783) ist die zentrale
// Tatsache, von der Ermächtigung, Annahme, Widerruf und Übertragung
// abhängen.
//
// „GILT ENTSPRECHEND" BEI INHABERKARTEN (§ 807, D-08-10): eine Karte oder
// Marke ohne Gläubigerbezeichnung, die unter verpflichtungswilligen
// Umständen ausgegeben wird, erfüllt denselben Tatbestand
// `schuldverschreibung_ausgestellt`, den §§ 793, 794, 796, 797 lesen — kein
// zweiter Regelsatz (Muster D-08-07).
//
// § 802 ZAHLUNGSSPERRE bleibt SOURCE_ONLY: die Hemmung der Vorlegungsfrist
// setzt eine Fristen-Mechanik voraus, die `de.bgb.fristen` nur für
// `Anspruch`-Verjährung (§§ 203–209), nicht für den `Frist`-Typ dieses
// Pakets kennt (D-Q08-2, `BG-08-TODO-2`).
//
// DIE HAFTUNGSGRENZE DES GASTWIRTS (§ 702 Absatz 1) ist die einzige
// dreistufige Geldformel dieses Titelbündels: das HUNDERTFACHE des
// Beherbergungspreises für einen Tag, mindestens 600 Euro, höchstens 3 500
// Euro; für Geld, Wertpapiere und Kostbarkeiten tritt an die Stelle von 3 500
// Euro der Betrag von 800 Euro. Das Hundertfache ist ein eigener Schluss
// (`hundertfacher_tagespreis`), die drei Stufen sind drei Regeln mit
// Variablenvergleich — keine Rechnung im Guard.
//
// DREI FRISTEN. § 606 (sechs Monate), § 801 Absatz 1 (30 Jahre Vorlegungsfrist)
// und § 801 Absatz 2 (vier Jahre bei Zins-, Renten- und Gewinnanteilscheinen,
// beginnend mit dem SCHLUSS des Jahres). Zeilen in DEADLINES.json unter BG-08.

language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";

// ==================================================================================================
// TITEL 2 — TEILZEIT-WOHNRECHTEVERTRÄGE (§§ 481–487)
// ==================================================================================================

pub entity Teilzeitwohnrechtevertrag {
    label de official "Teilzeit-Wohnrechtevertrag, Vertrag über ein langfristiges Urlaubsprodukt, Vermittlungsvertrag oder Tauschsystemvertrag (§§ 481, 481a, 481b)";
    label en unofficial "timeshare contract, long-term holiday product contract, resale contract or exchange system contract (§§ 481, 481a, 481b)";
}

// § 137 maintenance witnesses for the executable prohibitions in this title.
pub relation violation_486_anzahlung(t: Teilzeitwohnrechtevertrag, p: Person) kind derived {
    label de official "Zahlung trotz Verbots nach § 486 gefordert";
    label en unofficial "payment demanded in violation of § 486";
}
@source(BGB_P486)
rule Violation486Anzahlung(t: Teilzeitwohnrechtevertrag, p: Person, tag: Date) strict {
    label de official "Der Unternehmer fordert oder nimmt vor Ablauf der Widerrufsfrist eine Zahlung entgegen (§ 486 Absatz 1)";
    label en unofficial "the trader demands or accepts payment before expiry of the withdrawal period (§ 486 (1))";
    when unternehmer_486(t, p) and zahlung_486_gefordert_am(t, tag);
    then violation_486_anzahlung(t, p);
}
@source(BGB_P486)
rule Maintenance486AnzahlungRule(t: Teilzeitwohnrechtevertrag, p: Person, beginn: Date) strict {
    label de official "Das Zahlungsverbot nach § 486 Absatz 1 bleibt ab seinem Beginn bestehen";
    label en unofficial "the payment prohibition under § 486 (1) remains in force from its start";
    when unternehmer_486(t, p) and widerrufsrecht_485(t)
      and not_known(widerrufsfrist_abgelaufen_485(t))
      and verbotsbeginn_486_am(t, beginn);
    then duty Maintenance486Anzahlung {
        bearer p;
        goal maintenance {
            condition not violation_486_anzahlung(t, p);
            window [beginn, infinity);
        }
    };
}

pub relation violation_487_abweichung(t: Teilzeitwohnrechtevertrag, p: Person) kind derived {
    label de official "Nachteilige Abweichung trotz Verbots nach § 487 vereinbart";
    label en unofficial "detrimental deviation agreed in violation of § 487";
}
@source(BGB_P487)
rule Violation487Abweichung(t: Teilzeitwohnrechtevertrag, p: Person, tag: Date) strict {
    label de official "Von den Vorschriften des Titels wird zum Nachteil des Verbrauchers abgewichen (§ 487)";
    label en unofficial "the provisions of the title are departed from to the consumer's detriment (§ 487)";
    when verbraucher_487(t, p) and abweichung_487_vereinbart_am(t, tag);
    then violation_487_abweichung(t, p);
}
@source(BGB_P487)
rule Maintenance487AbweichungRule(t: Teilzeitwohnrechtevertrag, p: Person, beginn: Date) strict {
    label de official "Das Abweichungsverbot nach § 487 bleibt ab seinem Beginn bestehen";
    label en unofficial "the prohibition on detrimental deviations under § 487 remains in force from its start";
    when verbraucher_487(t, p) and verbotsbeginn_487_am(t, beginn);
    then duty Maintenance487Abweichung {
        bearer p;
        goal maintenance {
            condition not violation_487_abweichung(t, p);
            window [beginn, infinity);
        }
    };
}

pub relation violation_482_werbung(t: Teilzeitwohnrechtevertrag, p: Person) kind derived {
    label de official "Recht trotz Verbots nach § 482 als Geldanlage beworben";
    label en unofficial "right advertised as investment in violation of § 482";
}
@source(BGB_P482)
rule Violation482Werbung(t: Teilzeitwohnrechtevertrag, p: Person, tag: Date) strict {
    label de official "Das Recht wird als Geldanlage beworben oder verkauft (§ 482 Absatz 3)";
    label en unofficial "the right is advertised or sold as a financial investment (§ 482 (3))";
    when unternehmer_486(t, p) and werbung_482_erfolgt_am(t, tag);
    then violation_482_werbung(t, p);
}
@source(BGB_P482)
rule Maintenance482WerbungRule(t: Teilzeitwohnrechtevertrag, p: Person, beginn: Date) strict {
    label de official "Das Verbot der Werbung als Geldanlage nach § 482 Absatz 3 bleibt ab seinem Beginn bestehen";
    label en unofficial "the prohibition on advertising as an investment under § 482 (3) remains in force from its start";
    when unternehmer_486(t, p) and werbeverbot_482_beginn_am(t, beginn);
    then duty Maintenance482Werbung {
        bearer p;
        goal maintenance {
            condition not violation_482_werbung(t, p);
            window [beginn, infinity);
        }
    };
}

pub relation violation_603_vertragswidriger_gebrauch(l: Leihe, p: Person) kind derived {
    label de official "Sache trotz Verbots nach § 603 vertragswidrig überlassen";
    label en unofficial "thing lent in violation of § 603";
}
@source(BGB_P603)
rule Violation603VertragswidrigerGebrauch(l: Leihe, p: Person, tag: Date) strict {
    label de official "Die Sache wird entgegen dem Vertrag gebraucht oder einem Dritten überlassen (§ 603)";
    label en unofficial "the thing is used contrary to the contract or lent to a third party (§ 603)";
    when entleiher(l, p) and vertragswidriger_gebrauch_603_am(l, tag);
    then violation_603_vertragswidriger_gebrauch(l, p);
}
@source(BGB_P603)
rule Maintenance603VertragswidrigerGebrauchRule(l: Leihe, p: Person, beginn: Date) strict {
    label de official "Das Verbot des vertragswidrigen Gebrauchs nach § 603 bleibt ab seinem Beginn bestehen";
    label en unofficial "the prohibition on use contrary to the contract under § 603 remains in force from its start";
    when entleiher(l, p) and leihvertrag_geschlossen(l)
      and verbotsbeginn_603_am(l, beginn);
    then duty Maintenance603VertragswidrigerGebrauch {
        bearer p;
        goal maintenance {
            condition not violation_603_vertragswidriger_gebrauch(l, p);
            window [beginn, infinity);
        }
    };
}

pub relation violation_655d_nebenentgelt(m: Maklervertrag, p: Person) kind derived {
    label de official "Nebenentgelt trotz Verbots nach § 655d vereinbart";
    label en unofficial "ancillary fee agreed in violation of § 655d";
}
@source(BGB_P655d)
rule Violation655dNebenentgelt(m: Maklervertrag, p: Person, tag: Date) strict {
    label de official "Ein Nebenentgelt für eine vermittlungsbezogene Leistung wird vereinbart (§ 655d)";
    label en unofficial "an ancillary fee for a brokerage-related service is agreed (§ 655d)";
    when vermittler_655d(m, p) and nebenentgelt_655d_vereinbart_am(m, tag);
    then violation_655d_nebenentgelt(m, p);
}
@source(BGB_P655d)
rule Maintenance655dNebenentgeltRule(m: Maklervertrag, p: Person, beginn: Date) strict {
    label de official "Das Verbot des Nebenentgelts nach § 655d bleibt ab seinem Beginn bestehen";
    label en unofficial "the prohibition on ancillary fees under § 655d remains in force from its start";
    when vermittler_655d(m, p) and nebenentgelt_fuer_vermittlungsbezogene_leistung_vereinbart_655d(m)
      and verbotsbeginn_655d_am(m, beginn);
    then duty Maintenance655dNebenentgelt {
        bearer p;
        goal maintenance {
            condition not violation_655d_nebenentgelt(m, p);
            window [beginn, infinity);
        }
    };
}

pub relation violation_655e_abweichung(m: Maklervertrag, p: Person) kind derived {
    label de official "Nachteilige Abweichung trotz Verbots nach § 655e vereinbart";
    label en unofficial "detrimental deviation agreed in violation of § 655e";
}
@source(BGB_P655e)
rule Violation655eAbweichung(m: Maklervertrag, p: Person, tag: Date) strict {
    label de official "Von den Vorschriften über den Maklervertrag wird zum Nachteil des Verbrauchers abgewichen (§ 655e)";
    label en unofficial "the brokerage-contract provisions are departed from to the consumer's detriment (§ 655e)";
    when verbraucher_655e(m, p) and abweichung_655e_vereinbart_am(m, tag);
    then violation_655e_abweichung(m, p);
}
@source(BGB_P655e)
rule Maintenance655eAbweichungRule(m: Maklervertrag, p: Person, beginn: Date) strict {
    label de official "Das Abweichungsverbot nach § 655e bleibt ab seinem Beginn bestehen";
    label en unofficial "the prohibition on detrimental deviations under § 655e remains in force from its start";
    when verbraucher_655e(m, p) and verbotsbeginn_655e_am(m, beginn);
    then duty Maintenance655eAbweichung {
        bearer p;
        goal maintenance {
            condition not violation_655e_abweichung(m, p);
            window [beginn, infinity);
        }
    };
}

pub relation teilzeitwohnrechtevertrag_geschlossen(t: Teilzeitwohnrechtevertrag) kind empirical {
    label de official "Ein Teilzeit-Wohnrechtevertrag, ein Vertrag über ein langfristiges Urlaubsprodukt, ein Vermittlungsvertrag oder ein Tauschsystemvertrag zwischen Unternehmer und Verbraucher ist geschlossen (§§ 481–481b, § 485)";
    label en unofficial "a timeshare, long-term holiday product, resale or exchange system contract between a trader and a consumer has been concluded (§§ 481–481b, § 485)";
}
pub relation widerrufsrecht_485(t: Teilzeitwohnrechtevertrag) kind institutional {
    label de official "Dem Verbraucher steht ein Widerrufsrecht nach § 355 zu (§ 485)";
    label en unofficial "the consumer has a right of withdrawal under § 355 (§ 485)";
}
pub relation widerrufsfrist_abgelaufen_485(t: Teilzeitwohnrechtevertrag) kind empirical {
    label de official "Die Widerrufsfrist ist abgelaufen (§ 486 Absatz 1)";
    label en unofficial "the withdrawal period has expired (§ 486 (1))";
}
pub relation anzahlungsverbot(t: Teilzeitwohnrechtevertrag) kind institutional {
    label de official "Der Unternehmer darf Zahlungen des Verbrauchers vor Ablauf der Widerrufsfrist nicht fordern oder annehmen (§ 486 Absatz 1)";
    label en unofficial "the trader may not demand or accept payments from the consumer before the withdrawal period expires (§ 486 (1))";
}
pub relation vermittlungsvertrag(t: Teilzeitwohnrechtevertrag) kind empirical {
    label de official "Der Vertrag ist ein Vermittlungsvertrag (§ 481b Absatz 1, § 486 Absatz 2)";
    label en unofficial "the contract is a resale contract (§ 481b (1), § 486 (2))";
}
pub relation pflichten_aus_vermittlungsvertrag_erfuellt_oder_beendet(t: Teilzeitwohnrechtevertrag) kind empirical {
    label de official "Der Unternehmer hat seine Pflichten aus dem Vermittlungsvertrag erfüllt oder die Vertragsbeziehung ist beendet (§ 486 Absatz 2)";
    label en unofficial "the trader has performed his obligations under the resale contract or the contractual relationship has ended (§ 486 (2))";
}
pub relation zahlungsverbot_vermittlungsvertrag(t: Teilzeitwohnrechtevertrag) kind institutional {
    label de official "Es dürfen keine Zahlungen des Verbrauchers im Zusammenhang mit einem Vermittlungsvertrag gefordert oder angenommen werden (§ 486 Absatz 2)";
    label en unofficial "no payments from the consumer may be demanded or accepted in connection with a resale contract (§ 486 (2))";
}
pub relation abweichung_zum_nachteil_des_verbrauchers(t: Teilzeitwohnrechtevertrag) kind empirical {
    label de official "Von den Vorschriften dieses Titels wird zum Nachteil des Verbrauchers abgewichen oder sie werden durch anderweitige Gestaltungen umgangen (§ 487)";
    label en unofficial "the provisions of this title are departed from to the consumer's detriment or circumvented by other arrangements (§ 487)";
}
pub relation abweichung_unwirksam_487(t: Teilzeitwohnrechtevertrag) kind institutional {
    label de official "Von den Vorschriften dieses Titels darf nicht zum Nachteil des Verbrauchers abgewichen werden; sie finden auch Anwendung, wenn sie durch anderweitige Gestaltungen umgangen werden (§ 487)";
    label en unofficial "the provisions of this title may not be departed from to the consumer's detriment; they also apply where circumvented by other arrangements (§ 487)";
}

@source(BGB_P485)
rule Widerrufsrecht485(t: Teilzeitwohnrechtevertrag) strict {
    label de official "Dem Verbraucher steht bei einem Teilzeit-Wohnrechtevertrag, einem Vertrag über ein langfristiges Urlaubsprodukt, einem Vermittlungsvertrag oder einem Tauschsystemvertrag ein Widerrufsrecht nach § 355 zu (§ 485)";
    label en unofficial "the consumer has a right of withdrawal under § 355 in the case of a timeshare, long-term holiday product, resale or exchange system contract (§ 485)";
    when teilzeitwohnrechtevertrag_geschlossen(t);
    then widerrufsrecht_485(t);
}
pub relation verbraucher_485(t: Teilzeitwohnrechtevertrag, p: Person) kind empirical {
    label de official "Verbraucher nach § 485";
    label en unofficial "consumer under § 485";
}
pub relation widerruf_485_ausgeuebt_am(t: Teilzeitwohnrechtevertrag, tag: Date) kind empirical {
    label de official "Der Verbraucher hat den Widerruf erklärt (§ 485)";
    label en unofficial "the consumer exercised withdrawal (§ 485)";
}
pub relation widerrufsrecht_485_beginn_am(t: Teilzeitwohnrechtevertrag, tag: Date) kind empirical {
    label de official "Beginn des Widerrufsrechts nach § 485";
    label en unofficial "start of the withdrawal right under § 485";
}
@source(BGB_P485)
rule Position485Widerruf(t: Teilzeitwohnrechtevertrag, p: Person, beginn: Date) strict {
    label de official "Der Verbraucher ist berechtigt, den Vertrag zu widerrufen (§ 485)";
    label en unofficial "The consumer has the liberty to withdraw from the contract (§ 485)";
    when verbraucher_485(t, p) and widerrufsrecht_485(t)
     and widerrufsrecht_485_beginn_am(t, beginn);
    then liberty Liberty485Widerruf {
        holder p;
        action widerruf_485_ausgeuebt_am(t, beginn);
        window [beginn, infinity);
    };
}
@source(BGB_P486) {
    rule Anzahlungsverbot486(t: Teilzeitwohnrechtevertrag) strict {
        label de official "Der Unternehmer darf Zahlungen des Verbrauchers vor Ablauf der Widerrufsfrist nicht fordern oder annehmen (§ 486 Absatz 1)";
        label en unofficial "the trader may not demand or accept payments from the consumer before the withdrawal period expires (§ 486 (1))";
        when widerrufsrecht_485(t) and not_known(widerrufsfrist_abgelaufen_485(t));
        then anzahlungsverbot(t);
    }
    rule ZahlungsverbotVermittlungsvertrag(t: Teilzeitwohnrechtevertrag) strict {
        label de official "Es dürfen keine Zahlungen des Verbrauchers im Zusammenhang mit einem Vermittlungsvertrag gefordert oder angenommen werden, bis der Unternehmer seine Pflichten erfüllt hat oder die Vertragsbeziehung beendet ist (§ 486 Absatz 2)";
        label en unofficial "no payments may be demanded or accepted in connection with a resale contract until the trader has performed his obligations or the relationship has ended (§ 486 (2))";
        when vermittlungsvertrag(t) and not_known(pflichten_aus_vermittlungsvertrag_erfuellt_oder_beendet(t));
        then zahlungsverbot_vermittlungsvertrag(t);
    }
}
pub relation unternehmer_486(t: Teilzeitwohnrechtevertrag, p: Person) kind empirical {
    label de official "Unternehmer nach § 486";
    label en unofficial "trader under § 486";
}
pub relation zahlung_486_gefordert_am(t: Teilzeitwohnrechtevertrag, tag: Date) kind empirical {
    label de official "Der Unternehmer hat eine Zahlung gefordert oder angenommen (§ 486)";
    label en unofficial "the trader demanded or accepted a payment (§ 486)";
}
pub relation verbotsbeginn_486_am(t: Teilzeitwohnrechtevertrag, tag: Date) kind empirical {
    label de official "Beginn des Anzahlungsverbots nach § 486";
    label en unofficial "start of the advance payment prohibition under § 486";
}
@source(BGB_P486)
rule Position486Anzahlung(t: Teilzeitwohnrechtevertrag, p: Person, beginn: Date) strict {
    label de official "Dem Unternehmer ist es verboten, vor Ablauf der Widerrufsfrist Zahlungen zu fordern oder anzunehmen (§ 486 Absatz 1)";
    label en unofficial "The trader is prohibited from demanding or accepting payments before expiry of the withdrawal period (§ 486 (1))";
    when unternehmer_486(t, p) and widerrufsrecht_485(t)
     and not_known(widerrufsfrist_abgelaufen_485(t))
     and verbotsbeginn_486_am(t, beginn);
    then prohibition Prohibition486Anzahlung {
        bearer p;
        action zahlung_486_gefordert_am(t, beginn);
        window [beginn, infinity);
    };
}
@source(BGB_P487)
rule AbweichendeVereinbarungenUnwirksam(t: Teilzeitwohnrechtevertrag) strict {
    label de official "Von den Vorschriften dieses Titels darf nicht zum Nachteil des Verbrauchers abgewichen werden; die Vorschriften finden auch Anwendung, wenn sie durch anderweitige Gestaltungen umgangen werden (§ 487)";
    label en unofficial "the provisions of this title may not be departed from to the consumer's detriment; they also apply where circumvented by other arrangements (§ 487)";
    when teilzeitwohnrechtevertrag_geschlossen(t) and abweichung_zum_nachteil_des_verbrauchers(t);
    then abweichung_unwirksam_487(t);
}

// --- §§ 482 Absatz 3, 483 Absatz 3, 484 Absatz 1, 486a: Verbot, Sprache, Form, Ratenzahlung (D-08-15) ---
//
// Die vorvertraglichen Informationspflichten der §§ 482 Absatz 1, 2, 482a und
// 483 Absatz 1, 2 verweisen auf Artikel 242 EGBGB und bleiben aus demselben
// Grund wie § 491a (D-08-14) SOURCE_ONLY. Ausgeführt sind die Normen OHNE
// Verweisungskette: das Verbot des § 482 Absatz 3, die Nichtigkeitsfolge des
// § 483 Absatz 3, die Schriftform des § 484 Absatz 1 und die beiden
// Zweiwochenfristen des § 486a.

pub relation als_geldanlage_beworben_oder_verkauft(t: Teilzeitwohnrechtevertrag) kind empirical {
    label de official "Ein Teilzeit-Wohnrecht oder ein Recht aus einem Vertrag über ein langfristiges Urlaubsprodukt wird als Geldanlage beworben oder verkauft (§ 482 Absatz 3)";
    label en unofficial "a timeshare or a right under a long-term holiday product contract is advertised or sold as a financial investment (§ 482 (3))";
}
pub relation verbot_der_werbung_als_geldanlage_verletzt(t: Teilzeitwohnrechtevertrag) kind institutional {
    label de official "Das Verbot, ein Teilzeit-Wohnrecht oder ein Recht aus einem Vertrag über ein langfristiges Urlaubsprodukt als Geldanlage zu bewerben oder zu verkaufen, ist verletzt (§ 482 Absatz 3)";
    label en unofficial "the prohibition on advertising or selling a timeshare or a right under a long-term holiday product contract as a financial investment has been breached (§ 482 (3))";
}
pub relation sprachvorgaben_483_nicht_eingehalten(t: Teilzeitwohnrechtevertrag) kind empirical {
    label de official "Der Vertrag entspricht nicht den Sprachvorgaben des § 483 Absatz 1 Sätze 1, 2 oder Absatz 2 (§ 483 Absatz 3)";
    label en unofficial "the contract does not comply with the language requirements of § 483 (1) sentences 1, 2 or (2) (§ 483 (3))";
}
pub relation vertrag_nichtig_483(t: Teilzeitwohnrechtevertrag) kind institutional {
    label de official "Der Vertrag ist nichtig (§ 483 Absatz 3)";
    label en unofficial "the contract is void (§ 483 (3))";
}
pub relation schriftform_484_eingehalten(t: Teilzeitwohnrechtevertrag) kind empirical {
    label de official "Der Vertrag ist schriftlich abgeschlossen, soweit nicht eine strengere Form vorgeschrieben ist (§ 484 Absatz 1)";
    label en unofficial "the contract has been concluded in writing, unless a stricter form is prescribed (§ 484 (1))";
}
pub relation formwirksamkeit_484(t: Teilzeitwohnrechtevertrag) kind institutional {
    label de official "Der Vertrag genügt dem Formerfordernis des § 484 Absatz 1 (§ 484 Absatz 1)";
    label en unofficial "the contract satisfies the formal requirement of § 484 (1) (§ 484 (1))";
}
pub relation langfristiges_urlaubsprodukt(t: Teilzeitwohnrechtevertrag) kind empirical {
    label de official "Der Vertrag ist ein Vertrag über ein langfristiges Urlaubsprodukt (§ 481a, § 486a)";
    label en unofficial "the contract is a long-term holiday product contract (§ 481a, § 486a)";
}
pub relation zahlungsaufforderungsfrist_486a(f: Frist) kind empirical {
    key(f);
    label de official "Die Zahlungsaufforderung für den jährlichen Teilbetrag muss dem Verbraucher mindestens zwei Wochen vor Fälligkeit zugehen (§ 486a Absatz 1 Satz 4)";
    label en unofficial "the payment request for the annual instalment must reach the consumer at least two weeks before it falls due (§ 486a (1) sentence 4)";
}
pub relation faelligkeit_des_teilbetrags_am_486a(f: Frist, tag: Date) kind empirical {
    key(f);
    label de official "Tag der Fälligkeit des jährlichen Teilbetrags (§ 486a Absatz 1 Satz 4)";
    label en unofficial "day the annual instalment falls due (§ 486a (1) sentence 4)";
}
pub relation zahlungsaufforderung_zugegangen_am_486a(f: Frist, tag: Date) kind empirical {
    key(f);
    label de official "Tag des Zugangs der Zahlungsaufforderung beim Verbraucher (§ 486a Absatz 1 Satz 4)";
    label en unofficial "day the payment request reaches the consumer (§ 486a (1) sentence 4)";
}
pub relation zahlungsaufforderung_rechtzeitig_486a(f: Frist) kind institutional {
    key(f);
    label de official "Die Zahlungsaufforderung ist rechtzeitig zugegangen, mindestens zwei Wochen vor Fälligkeit (§ 486a Absatz 1 Satz 4)";
    label en unofficial "the payment request reached the consumer in time, at least two weeks before the due date (§ 486a (1) sentence 4)";
}
pub relation kuendigungsfrist_486a(f: Frist) kind empirical {
    key(f);
    label de official "Der Verbraucher kann den Vertrag innerhalb von zwei Wochen ab Zugang der Zahlungsaufforderung zum Fälligkeitstermin des zweiten Teilbetrags kündigen (§ 486a Absatz 2)";
    label en unofficial "the consumer may terminate the contract within two weeks of receiving the payment request for the second instalment's due date (§ 486a (2))";
}
pub relation zweiter_teilbetrag_zahlungsaufforderung_zugegangen_am_486a(f: Frist, tag: Date) kind empirical {
    key(f);
    label de official "Tag des Zugangs der Zahlungsaufforderung zum zweiten Teilbetrag (§ 486a Absatz 2)";
    label en unofficial "day the payment request for the second instalment is received (§ 486a (2))";
}

@source(BGB_P482)
rule VerbotDerWerbungAlsGeldanlage482(t: Teilzeitwohnrechtevertrag) strict {
    label de official "Ein Teilzeit-Wohnrecht oder ein Recht aus einem Vertrag über ein langfristiges Urlaubsprodukt darf nicht als Geldanlage beworben oder verkauft werden (§ 482 Absatz 3)";
    label en unofficial "a timeshare or a right under a long-term holiday product contract may not be advertised or sold as a financial investment (§ 482 (3))";
    when als_geldanlage_beworben_oder_verkauft(t);
    then verbot_der_werbung_als_geldanlage_verletzt(t);
}
pub relation verbraucher_487(t: Teilzeitwohnrechtevertrag, p: Person) kind empirical {
    label de official "Verbraucher nach § 487";
    label en unofficial "consumer under § 487";
}
pub relation abweichung_487_vereinbart_am(t: Teilzeitwohnrechtevertrag, tag: Date) kind empirical {
    label de official "Eine abweichende Vereinbarung wurde zum Nachteil des Verbrauchers vereinbart (§ 487)";
    label en unofficial "a detrimental deviation was agreed against the consumer (§ 487)";
}
pub relation verbotsbeginn_487_am(t: Teilzeitwohnrechtevertrag, tag: Date) kind empirical {
    label de official "Beginn des Abweichungsverbots nach § 487";
    label en unofficial "start of the deviation prohibition under § 487";
}
@source(BGB_P487)
rule Position487Abweichung(t: Teilzeitwohnrechtevertrag, p: Person, beginn: Date) strict {
    label de official "Es ist verboten, zum Nachteil des Verbrauchers von den Vorschriften abzuweichen (§ 487)";
    label en unofficial "It is prohibited to depart from these provisions to the consumer's detriment (§ 487)";
    when verbraucher_487(t, p) and verbotsbeginn_487_am(t, beginn);
    then prohibition Prohibition487Abweichung {
        bearer p;
        action abweichung_487_vereinbart_am(t, beginn);
        window [beginn, infinity);
    };
}
pub relation werbung_482_erfolgt_am(t: Teilzeitwohnrechtevertrag, tag: Date) kind empirical {
    label de official "Das Teilzeit-Wohnrecht wurde als Geldanlage beworben (§ 482)";
    label en unofficial "the timeshare was advertised as an investment (§ 482)";
}
pub relation werbeverbot_482_beginn_am(t: Teilzeitwohnrechtevertrag, tag: Date) kind empirical {
    label de official "Beginn des Werbeverbots nach § 482";
    label en unofficial "start of the advertising prohibition under § 482";
}
@source(BGB_P482)
rule Position482Werbung(t: Teilzeitwohnrechtevertrag, p: Person, beginn: Date) strict {
    label de official "Dem Unternehmer ist es verboten, das Recht als Geldanlage zu bewerben oder zu verkaufen (§ 482 Absatz 3)";
    label en unofficial "The trader is prohibited from advertising or selling the right as an investment (§ 482 (3))";
    when unternehmer_486(t, p) and werbeverbot_482_beginn_am(t, beginn);
    then prohibition Prohibition482Werbung {
        bearer p;
        action werbung_482_erfolgt_am(t, beginn);
        window [beginn, infinity);
    };
}
@source(BGB_P483)
rule NichtigkeitBeiSprachverstoss483(t: Teilzeitwohnrechtevertrag) strict {
    label de official "Verträge, die den Sprachvorgaben des § 483 Absatz 1 Sätze 1, 2 oder Absatz 2 nicht entsprechen, sind nichtig (§ 483 Absatz 3)";
    label en unofficial "contracts that do not comply with the language requirements of § 483 (1) sentences 1, 2 or (2) are void (§ 483 (3))";
    when teilzeitwohnrechtevertrag_geschlossen(t) and sprachvorgaben_483_nicht_eingehalten(t);
    then vertrag_nichtig_483(t);
}
@source(BGB_P484)
rule Schriftform484(t: Teilzeitwohnrechtevertrag) strict {
    label de official "Der Teilzeit-Wohnrechtevertrag, der Vertrag über ein langfristiges Urlaubsprodukt, der Vermittlungsvertrag oder der Tauschsystemvertrag bedarf der schriftlichen Form, soweit nicht in anderen Vorschriften eine strengere Form vorgeschrieben ist (§ 484 Absatz 1)";
    label en unofficial "the timeshare, long-term holiday product, resale or exchange system contract must be in writing unless another provision requires a stricter form (§ 484 (1))";
    when teilzeitwohnrechtevertrag_geschlossen(t) and schriftform_484_eingehalten(t);
    then formwirksamkeit_484(t);
}
@source(BGB_P486a) {
    rule ZahlungsaufforderungRechtzeitig486a(f: Frist, faellig: Date, zugegangen: Date) strict {
        label de official "Die Zahlungsaufforderung muss dem Verbraucher mindestens zwei Wochen vor Fälligkeit des jährlichen Teilbetrags zugehen (§ 486a Absatz 1 Satz 4)";
        label en unofficial "the payment request must reach the consumer at least two weeks before the annual instalment falls due (§ 486a (1) sentence 4)";
        when zahlungsaufforderungsfrist_486a(f) and faelligkeit_des_teilbetrags_am_486a(f, faellig)
            and zahlungsaufforderung_zugegangen_am_486a(f, zugegangen)
            and add_calendar_period(zugegangen, 2 calendar_week) <= faellig;
        then zahlungsaufforderung_rechtzeitig_486a(f);
    }
    rule KuendigungsfristBeginn486a(f: Frist, t: Date) strict {
        label de official "Die Zweiwochenfrist zur Kündigung läuft ab Zugang der Zahlungsaufforderung zum Fälligkeitstermin des zweiten Teilbetrags (§ 486a Absatz 2, § 187 Absatz 1)";
        label en unofficial "the two-week period for termination runs from receipt of the payment request for the second instalment's due date (§ 486a (2), § 187 (1))";
        when kuendigungsfrist_486a(f) and zweiter_teilbetrag_zahlungsaufforderung_zugegangen_am_486a(f, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
    rule KuendigungsfristDauer486a(f: Frist) strict {
        label de official "Ab dem Zeitpunkt, der für die Zahlung des zweiten Teilbetrags vorgesehen ist, kann der Verbraucher den Vertrag innerhalb von zwei Wochen ab Zugang der Zahlungsaufforderung kündigen (§ 486a Absatz 2)";
        label en unofficial "from the time set for payment of the second instalment, the consumer may terminate the contract within two weeks of receiving the payment request (§ 486a (2))";
        when kuendigungsfrist_486a(f);
        then de.bgb.fristen::frist_dauer_kalender(f, 2 calendar_week);
    }
}
pub relation unternehmer_486a(f: Frist, p: Person) kind empirical {
    label de official "Unternehmer für die Zahlungsaufforderung nach § 486a";
    label en unofficial "trader responsible for the payment request under § 486a";
}
pub relation zahlungsaufforderung_486a_gesendet_am(f: Frist, tag: Date) kind empirical {
    label de official "Der Unternehmer hat die Zahlungsaufforderung gesendet (§ 486a)";
    label en unofficial "the trader sent the payment request (§ 486a)";
}
@source(BGB_P486a)
rule Position486aAufforderung(f: Frist, p: Person, beginn: Date) strict {
    label de official "Der Unternehmer ist verpflichtet, die Zahlungsaufforderung rechtzeitig zu senden (§ 486a Absatz 1 Satz 4)";
    label en unofficial "The trader is obliged to send the payment request in time (§ 486a (1) sentence 4)";
    when unternehmer_486a(f, p) and zahlungsaufforderungsfrist_486a(f)
     and faelligkeit_des_teilbetrags_am_486a(f, beginn);
    then duty Duty486aAufforderung {
        bearer p;
        achieve zahlungsaufforderung_486a_gesendet_am(f, beginn) during [beginn, infinity);
    };
}

// ==================================================================================================
// TITEL 6 — LEIHE (§§ 598–606) und TITEL 7 — SACHDARLEHEN (§§ 607–609)
// ==================================================================================================

pub entity Leihe {
    label de official "Leihvertrag (§ 598)";
    label en unofficial "contract of gratuitous loan (§ 598)";
}

pub relation verleiher(l: Leihe, p: Person) kind empirical {
    key(l);
    label de official "Verleiher (§ 598)";
    label en unofficial "lender for use (§ 598)";
}
pub relation entleiher(l: Leihe, p: Person) kind empirical {
    key(l);
    label de official "Entleiher (§ 598)";
    label en unofficial "borrower for use (§ 598)";
}
pub relation leihvertrag_geschlossen(l: Leihe) kind empirical {
    label de official "Der Leihvertrag über eine Sache ist geschlossen (§ 598)";
    label en unofficial "the contract of gratuitous loan of a thing has been concluded (§ 598)";
}
pub relation pflicht_gebrauch_unentgeltlich_zu_gestatten(l: Leihe, p: Person) kind institutional {
    label de official "Durch den Leihvertrag wird der Verleiher einer Sache verpflichtet, dem Entleiher den Gebrauch der Sache unentgeltlich zu gestatten (§ 598)";
    label en unofficial "by the contract of gratuitous loan the lender is obliged to permit the borrower to use the thing free of charge (§ 598)";
}
pub relation verleiher_haftet_nur_fuer_vorsatz_und_grobe_fahrlaessigkeit(l: Leihe) kind institutional {
    label de official "Der Verleiher hat nur Vorsatz und grobe Fahrlässigkeit zu vertreten (§ 599)";
    label en unofficial "the lender is responsible only for intent and gross negligence (§ 599)";
}
pub relation mangel_arglistig_verschwiegen_600(l: Leihe) kind empirical {
    label de official "Der Verleiher hat arglistig einen Mangel im Recht oder einen Fehler der verliehenen Sache verschwiegen (§ 600)";
    label en unofficial "the lender fraudulently concealed a defect of title or a defect of the thing lent (§ 600)";
}
pub relation schadensersatzanspruch_des_entleihers(l: Leihe) kind institutional {
    label de official "Der Verleiher ist verpflichtet, dem Entleiher den aus dem arglistig verschwiegenen Mangel entstehenden Schaden zu ersetzen (§ 600)";
    label en unofficial "the lender must compensate the borrower for the damage arising from the fraudulently concealed defect (§ 600)";
}
pub relation gewoehnliche_erhaltungskosten(l: Leihe, betrag: Money) kind empirical {
    key(l);
    label de official "Gewöhnliche Kosten der Erhaltung der geliehenen Sache, bei der Leihe eines Tieres insbesondere die Fütterungskosten (§ 601 Absatz 1)";
    label en unofficial "ordinary costs of maintaining the thing lent, in the case of an animal in particular the cost of feeding (§ 601 (1))";
}
pub relation entleiher_traegt_erhaltungskosten(l: Leihe, betrag: Money) kind institutional {
    label de official "Der Entleiher hat die gewöhnlichen Kosten der Erhaltung der geliehenen Sache zu tragen (§ 601 Absatz 1)";
    label en unofficial "the borrower must bear the ordinary costs of maintaining the thing lent (§ 601 (1))";
}
pub relation veraenderung_durch_vertragsmaessigen_gebrauch(l: Leihe) kind empirical {
    label de official "Veränderungen oder Verschlechterungen der geliehenen Sache, die durch den vertragsmäßigen Gebrauch herbeigeführt werden (§ 602)";
    label en unofficial "changes or deterioration of the thing lent brought about by use in conformity with the contract (§ 602)";
}
pub relation entleiher_hat_nicht_zu_vertreten(l: Leihe) kind institutional {
    label de official "Veränderungen oder Verschlechterungen, die durch den vertragsmäßigen Gebrauch herbeigeführt werden, hat der Entleiher nicht zu vertreten (§ 602)";
    label en unofficial "the borrower is not responsible for changes or deterioration brought about by use in conformity with the contract (§ 602)";
}
pub enum Kuendigungsgrund605 {
    label de official "Kündigungsgrund des Verleihers (§ 605)";
    label en unofficial "ground on which the lender may terminate (§ 605)";
    NichtVorhergesehenerBedarf,
    VertragswidrigerGebrauch,
    TodDesEntleihers
}
pub relation kuendigungsgrund_605_eingetreten(l: Leihe, grund: Kuendigungsgrund605) kind empirical {
    label de official "Ein Kündigungsgrund des § 605 ist eingetreten";
    label en unofficial "a ground for termination under § 605 has arisen";
}
pub relation verleiher_kann_kuendigen(l: Leihe) kind institutional {
    label de official "Der Verleiher kann die Leihe kündigen (§ 605)";
    label en unofficial "the lender may terminate the gratuitous loan (§ 605)";
}
pub relation verjaehrungsfrist_606(f: Frist) kind empirical {
    key(f);
    label de official "Kurze Verjährung des § 606: sechs Monate für die Ersatzansprüche des Verleihers wegen Veränderungen oder Verschlechterungen und die Ansprüche des Entleihers auf Verwendungsersatz";
    label en unofficial "the short limitation of § 606: six months for the lender's claims for changes or deterioration and the borrower's claims for reimbursement of outlays";
}
pub relation ruecknahme_der_sache_am(f: Frist, tag: Date) kind empirical {
    key(f);
    label de official "Tag, an dem der Verleiher die Sache zurückerhält beziehungsweise die Leihe endet — Beginn der Verjährung (§ 606 in Verbindung mit § 548 Absatz 1 Satz 2, Absatz 2)";
    label en unofficial "day on which the lender recovers the thing or the loan ends — start of the limitation period (§ 606 in conjunction with § 548 (1) sentence 2, (2))";
}

@source(BGB_P598)
rule PflichtenBeiDerLeihe(l: Leihe, p: Person) strict {
    label de official "Durch den Leihvertrag wird der Verleiher einer Sache verpflichtet, dem Entleiher den Gebrauch der Sache unentgeltlich zu gestatten (§ 598)";
    label en unofficial "by the contract of gratuitous loan the lender is obliged to permit the borrower to use the thing free of charge (§ 598)";
    when leihvertrag_geschlossen(l) and verleiher(l, p);
    then pflicht_gebrauch_unentgeltlich_zu_gestatten(l, p);
}
@source(BGB_P599)
rule HaftungDesVerleihers(l: Leihe) strict {
    label de official "Der Verleiher hat nur Vorsatz und grobe Fahrlässigkeit zu vertreten (§ 599)";
    label en unofficial "the lender is responsible only for intent and gross negligence (§ 599)";
    when leihvertrag_geschlossen(l);
    then verleiher_haftet_nur_fuer_vorsatz_und_grobe_fahrlaessigkeit(l);
}
pub relation verleiher_599(l: Leihe, p: Person) kind empirical {
    label de official "Verleiher nach § 599";
    label en unofficial "lender under § 599";
}
pub relation haftungsbegrenzung_599_berufen_am(l: Leihe, tag: Date) kind empirical {
    label de official "Der Verleiher hat sich auf die Haftungsbegrenzung berufen (§ 599)";
    label en unofficial "the lender invoked the limitation of liability (§ 599)";
}
pub relation haftungsbeginn_599_am(l: Leihe, tag: Date) kind empirical {
    label de official "Beginn der Haftungsbegrenzung nach § 599";
    label en unofficial "start of the limitation of liability under § 599";
}
@source(BGB_P599)
rule Position599Haftung(l: Leihe, p: Person, beginn: Date) strict {
    label de official "Der Verleiher ist berechtigt, sich auf Vorsatz und grobe Fahrlässigkeit als Haftungsmaßstab zu berufen (§ 599)";
    label en unofficial "The lender has the liberty to invoke the intent and gross negligence liability standard (§ 599)";
    when verleiher_599(l, p) and leihvertrag_geschlossen(l)
     and haftungsbeginn_599_am(l, beginn);
    then liberty Liberty599Haftung {
        holder p;
        action haftungsbegrenzung_599_berufen_am(l, beginn);
        window [beginn, infinity);
    };
}
@source(BGB_P600)
rule Maengelhaftung600(l: Leihe) strict {
    label de official "Verschweigt der Verleiher arglistig einen Mangel im Recht oder einen Fehler der verliehenen Sache, so ist er verpflichtet, dem Entleiher den daraus entstehenden Schaden zu ersetzen (§ 600)";
    label en unofficial "where the lender fraudulently conceals a defect of title or of the thing lent he must compensate the borrower for the resulting damage (§ 600)";
    when leihvertrag_geschlossen(l) and mangel_arglistig_verschwiegen_600(l);
    then schadensersatzanspruch_des_entleihers(l);
}
@source(BGB_P601)
rule Verwendungsersatz601(l: Leihe, betrag: Money) strict {
    label de official "Der Entleiher hat die gewöhnlichen Kosten der Erhaltung der geliehenen Sache, bei der Leihe eines Tieres insbesondere die Fütterungskosten, zu tragen (§ 601 Absatz 1)";
    label en unofficial "the borrower must bear the ordinary costs of maintaining the thing lent, in the case of an animal in particular the cost of feeding (§ 601 (1))";
    when leihvertrag_geschlossen(l) and gewoehnliche_erhaltungskosten(l, betrag);
    then entleiher_traegt_erhaltungskosten(l, betrag);
}
pub relation erhaltungskosten_601_getragen_am(l: Leihe, betrag: Money, tag: Date) kind empirical {
    label de official "Der Entleiher hat die Erhaltungskosten getragen (§ 601)";
    label en unofficial "the borrower bore the maintenance costs (§ 601)";
}
pub relation erhaltungspflicht_601_beginn_am(l: Leihe, tag: Date) kind empirical {
    label de official "Beginn der Erhaltungspflicht nach § 601";
    label en unofficial "start of maintenance duty under § 601";
}
@source(BGB_P601)
rule Position601Erhaltungskosten(l: Leihe, p: Person, betrag: Money, beginn: Date) strict {
    label de official "Der Entleiher ist verpflichtet, die gewöhnlichen Erhaltungskosten zu tragen (§ 601 Absatz 1)";
    label en unofficial "The borrower is obliged to bear ordinary maintenance costs (§ 601 (1))";
    when entleiher(l, p) and leihvertrag_geschlossen(l)
     and gewoehnliche_erhaltungskosten(l, betrag)
     and erhaltungspflicht_601_beginn_am(l, beginn);
    then duty Duty601Erhaltungskosten {
        bearer p;
        achieve erhaltungskosten_601_getragen_am(l, betrag, beginn) during [beginn, infinity);
    };
}
@source(BGB_P602)
rule AbnutzungDerSache(l: Leihe) strict {
    label de official "Veränderungen oder Verschlechterungen der geliehenen Sache, die durch den vertragsmäßigen Gebrauch herbeigeführt werden, hat der Entleiher nicht zu vertreten (§ 602)";
    label en unofficial "the borrower is not responsible for changes or deterioration of the thing lent brought about by use in conformity with the contract (§ 602)";
    when leihvertrag_geschlossen(l) and veraenderung_durch_vertragsmaessigen_gebrauch(l);
    then entleiher_hat_nicht_zu_vertreten(l);
}
pub relation entleiher_602(l: Leihe, p: Person) kind empirical {
    label de official "Entleiher nach § 602";
    label en unofficial "borrower under § 602";
}
pub relation haftung_602_abwehr_am(l: Leihe, tag: Date) kind empirical {
    label de official "Der Entleiher hat die Haftung für vertragsgemäße Abnutzung abgewehrt (§ 602)";
    label en unofficial "the borrower invoked the exclusion of liability for ordinary use (§ 602)";
}
pub relation haftungsausschluss_602_beginn_am(l: Leihe, tag: Date) kind empirical {
    label de official "Beginn des Haftungsausschlusses nach § 602";
    label en unofficial "start of the exclusion of liability under § 602";
}
@source(BGB_P602)
rule Position602Abnutzung(l: Leihe, p: Person, beginn: Date) strict {
    label de official "Der Entleiher ist berechtigt, die Haftung für vertragsgemäße Abnutzung abzuwehren (§ 602)";
    label en unofficial "The borrower has the liberty to invoke the exclusion of liability for ordinary use (§ 602)";
    when entleiher_602(l, p) and leihvertrag_geschlossen(l)
     and veraenderung_durch_vertragsmaessigen_gebrauch(l)
     and haftungsausschluss_602_beginn_am(l, beginn);
    then liberty Liberty602Abnutzung {
        holder p;
        action haftung_602_abwehr_am(l, beginn);
        window [beginn, infinity);
    };
}
// §§ 603–604 Absatz 1 (D-08-18): Beschränkung des Gebrauchs, Verbot der
// Gebrauchsüberlassung ohne Erlaubnis und die Rückgabepflicht nach Ablauf
// einer bestimmten Leihzeit. § 604 Absatz 2–4 (Rückgabe nach Zweckerreichung,
// vorzeitige Rückforderung, Rückforderung vom Dritten) bleiben Grenze: der
// Zeitpunkt „nachdem der Entleiher den sich aus dem Zweck der Leihe
// ergebenden Gebrauch gemacht hat" ist ein Wertungsmoment ohne im Text
// genannten harten Anhaltspunkt — Kanal §47.3/`adjudicated`, hier nicht neu
// eingeführt, um keinen zweiten Kanal für denselben Sachverhalt wie § 604a
// zu öffnen. § 604 Absatz 5 (Verjährungsbeginn des Rückgabeanspruchs) bleibt
// Grenze: die dafür maßgebliche Verjährungsfrist ist die regelmäßige des
// § 195/§ 199, die außerhalb dieses Pakets liegt.
pub relation leihzeit_bestimmt_bis(l: Leihe, tag: Date) kind empirical {
    key(l);
    label de official "Für die Leihe ist eine bestimmte Zeit vereinbart, nach deren Ablauf die Sache zurückzugeben ist (§ 604 Absatz 1)";
    label en unofficial "a fixed period has been agreed for the loan, after whose expiry the thing is to be returned (§ 604 (1))";
}
pub relation gebrauch_einem_dritten_ueberlassen_603(l: Leihe) kind empirical {
    label de official "Der Entleiher überlässt den Gebrauch der Sache einem Dritten (§ 603 Satz 2)";
    label en unofficial "the borrower allows a third party to use the thing (§ 603 sentence 2)";
}
pub relation erlaubnis_des_verleihers_603(l: Leihe) kind empirical {
    label de official "Der Verleiher hat die Überlassung des Gebrauchs an einen Dritten erlaubt (§ 603 Satz 2)";
    label en unofficial "the lender has permitted the transfer of use to a third party (§ 603 sentence 2)";
}
pub relation vertragswidriger_gebrauch_603(l: Leihe) kind institutional {
    label de official "Der Entleiher macht von der geliehenen Sache einen nicht vertragsmäßigen Gebrauch, indem er sie einem Dritten ohne Erlaubnis des Verleihers überlässt (§ 603)";
    label en unofficial "the borrower makes non-contractual use of the thing lent by allowing a third party to use it without the lender's permission (§ 603)";
}
pub relation rueckgabepflicht_604_abs1(l: Leihe, tag: Date) kind institutional {
    label de official "Der Entleiher ist verpflichtet, die geliehene Sache nach dem Ablauf der für die Leihe bestimmten Zeit zurückzugeben (§ 604 Absatz 1)";
    label en unofficial "the borrower must return the thing lent after the expiry of the fixed period agreed for the loan (§ 604 (1))";
}
pub relation sache_zurueckgegeben_am_604(l: Leihe, tag: Date) kind empirical {
    label de official "Der Entleiher hat die geliehene Sache zurückgegeben (§ 604 Absatz 1)";
    label en unofficial "the borrower returned the thing lent (§ 604 (1))";
}
@source(BGB_P604)
rule Position604Rueckgabe(l: Leihe, ent: Person, ver: Person, tag: Date) strict {
    label de official "Der Entleiher ist verpflichtet, die geliehene Sache nach Ablauf der Leihzeit zurückzugeben (§ 604 Absatz 1)";
    label en unofficial "The borrower is obliged to return the thing after the fixed loan period (§ 604 (1))";
    when leihvertrag_geschlossen(l) and entleiher(l, ent) and verleiher(l, ver)
     and leihzeit_bestimmt_bis(l, tag);
    then duty Duty604Rueckgabe {
        bearer ent;
        beneficiary ver;
        achieve sache_zurueckgegeben_am_604(l, tag) during [tag, infinity);
    };
}
@source(BGB_P603)
rule VertragswidrigerGebrauch603(l: Leihe) strict {
    label de official "Der Entleiher darf von der geliehenen Sache keinen anderen als den vertragsmäßigen Gebrauch machen; ohne die Erlaubnis des Verleihers ist er nicht berechtigt, den Gebrauch der Sache einem Dritten zu überlassen (§ 603)";
    label en unofficial "the borrower may not use the thing lent otherwise than in conformity with the contract; without the lender's permission he is not entitled to allow a third party to use it (§ 603)";
    when leihvertrag_geschlossen(l) and gebrauch_einem_dritten_ueberlassen_603(l) and not_known(erlaubnis_des_verleihers_603(l));
    then vertragswidriger_gebrauch_603(l);
}
pub relation vertragswidriger_gebrauch_603_am(l: Leihe, tag: Date) kind empirical {
    label de official "Der Entleiher hat die Sache vertragswidrig überlassen (§ 603)";
    label en unofficial "the borrower made non-contractual use of the thing (§ 603)";
}
pub relation verbotsbeginn_603_am(l: Leihe, tag: Date) kind empirical {
    label de official "Beginn des Verbots vertragswidriger Überlassung (§ 603)";
    label en unofficial "start of the prohibition under § 603";
}
@source(BGB_P603)
rule Position603VertragswidrigerGebrauch(l: Leihe, p: Person, beginn: Date) strict {
    label de official "Dem Entleiher ist es verboten, die Sache ohne Erlaubnis einem Dritten zu überlassen (§ 603)";
    label en unofficial "The borrower is prohibited from allowing a third party to use the thing without permission (§ 603)";
    when entleiher(l, p) and leihvertrag_geschlossen(l)
     and verbotsbeginn_603_am(l, beginn);
    then prohibition Prohibition603VertragswidrigerGebrauch {
        bearer p;
        action vertragswidriger_gebrauch_603_am(l, beginn);
        window [beginn, infinity];
    };
}
@source(BGB_P604)
rule Rueckgabepflicht604Abs1(l: Leihe, tag: Date) strict {
    label de official "Der Entleiher ist verpflichtet, die geliehene Sache nach dem Ablauf der für die Leihe bestimmten Zeit zurückzugeben (§ 604 Absatz 1)";
    label en unofficial "the borrower must return the thing lent after the expiry of the fixed period agreed for the loan (§ 604 (1))";
    when leihvertrag_geschlossen(l) and leihzeit_bestimmt_bis(l, tag);
    then rueckgabepflicht_604_abs1(l, tag);
}

@source(BGB_P605)
rule Kuendigungsrecht605(l: Leihe, grund: Kuendigungsgrund605) strict {
    label de official "Der Verleiher kann die Leihe kündigen, wenn er infolge eines nicht vorhergesehenen Umstandes der Sache bedarf, wenn der Entleiher einen vertragswidrigen Gebrauch macht oder wenn der Entleiher stirbt (§ 605)";
    label en unofficial "the lender may terminate the loan where he needs the thing owing to an unforeseen circumstance, where the borrower uses it contrary to the contract, or where the borrower dies (§ 605)";
    when leihvertrag_geschlossen(l) and kuendigungsgrund_605_eingetreten(l, grund);
    then verleiher_kann_kuendigen(l);
}
pub relation verleiher_605(l: Leihe, p: Person) kind empirical {
    label de official "Verleiher nach § 605";
    label en unofficial "lender under § 605";
}
pub relation kuendigung_605_ausgeuebt_am(l: Leihe, tag: Date) kind empirical {
    label de official "Der Verleiher hat die Leihe gekündigt (§ 605)";
    label en unofficial "the lender terminated the loan (§ 605)";
}
pub relation kuendigungsrecht_605_beginn_am(l: Leihe, tag: Date) kind empirical {
    label de official "Beginn des Kündigungsrechts nach § 605";
    label en unofficial "start of the termination right under § 605";
}
@source(BGB_P605)
rule Position605Kuendigung(l: Leihe, p: Person, beginn: Date) strict {
    label de official "Der Verleiher ist berechtigt, die Leihe aus wichtigem Grund zu kündigen (§ 605)";
    label en unofficial "The lender has the liberty to terminate the loan for a statutory reason (§ 605)";
    when verleiher_605(l, p) and leihvertrag_geschlossen(l)
     and kuendigungsrecht_605_beginn_am(l, beginn);
    then liberty Liberty605Kuendigung {
        holder p;
        action kuendigung_605_ausgeuebt_am(l, beginn);
        window [beginn, infinity);
    };
}
@source(BGB_P606) {
    rule Verjaehrungsfrist606Ereignis(f: Frist, t: Date) strict {
        label de official "Die sechsmonatige Verjährung beginnt mit dem Zeitpunkt, in dem der Verleiher die Sache zurückerhält (§ 606, § 548 Absatz 1 Satz 2)";
        label en unofficial "the six-month limitation begins when the lender recovers the thing (§ 606, § 548 (1) sentence 2)";
        when verjaehrungsfrist_606(f) and ruecknahme_der_sache_am(f, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
    rule Verjaehrungsfrist606Dauer(f: Frist) strict {
        label de official "Die Ersatzansprüche des Verleihers wegen Veränderungen oder Verschlechterungen der verliehenen Sache sowie die Ansprüche des Entleihers auf Ersatz von Verwendungen verjähren in sechs Monaten (§ 606)";
        label en unofficial "the lender's claims for changes or deterioration of the thing lent and the borrower's claims for reimbursement of outlays become time-barred in six months (§ 606)";
        when verjaehrungsfrist_606(f);
        then de.bgb.fristen::frist_dauer_kalender(f, 6 calendar_month);
    }
}

pub entity Sachdarlehen {
    label de official "Sachdarlehensvertrag (§ 607 Absatz 1)";
    label en unofficial "contract for the loan of things (§ 607 (1))";
}
pub relation sachdarlehensvertrag_geschlossen(sd: Sachdarlehen) kind empirical {
    label de official "Der Sachdarlehensvertrag über eine vertretbare Sache ist geschlossen (§ 607 Absatz 1 Satz 1)";
    label en unofficial "the contract for the loan of a fungible thing has been concluded (§ 607 (1) sentence 1)";
}
pub relation ueberlassung_von_geld(sd: Sachdarlehen) kind empirical {
    label de official "Gegenstand ist die Überlassung von Geld — auf sie finden die Vorschriften des Titels 7 keine Anwendung (§ 607 Absatz 2)";
    label en unofficial "the subject matter is the provision of money — the provisions of title 7 do not apply to it (§ 607 (2))";
}
pub relation pflicht_zur_ueberlassung_der_sache(sd: Sachdarlehen) kind institutional {
    label de official "Durch den Sachdarlehensvertrag wird der Darlehensgeber verpflichtet, dem Darlehensnehmer eine vereinbarte vertretbare Sache zu überlassen (§ 607 Absatz 1 Satz 1)";
    label en unofficial "by the contract for the loan of things the lender is obliged to provide the borrower with an agreed fungible thing (§ 607 (1) sentence 1)";
}
pub relation pflicht_zur_rueckerstattung_gleicher_art(sd: Sachdarlehen) kind institutional {
    label de official "Der Darlehensnehmer ist zur Zahlung eines Darlehensentgelts und bei Fälligkeit zur Rückerstattung von Sachen gleicher Art, Güte und Menge verpflichtet (§ 607 Absatz 1 Satz 2)";
    label en unofficial "the borrower must pay a loan fee and, when due, return things of the same kind, quality and quantity (§ 607 (1) sentence 2)";
}
@source(BGB_P607) {
    rule PflichtenBeimSachdarlehen(sd: Sachdarlehen) strict {
        label de official "Durch den Sachdarlehensvertrag wird der Darlehensgeber verpflichtet, dem Darlehensnehmer eine vereinbarte vertretbare Sache zu überlassen; die Vorschriften finden keine Anwendung auf die Überlassung von Geld (§ 607)";
        label en unofficial "by the contract for the loan of things the lender must provide an agreed fungible thing; the provisions do not apply to the provision of money (§ 607)";
        when sachdarlehensvertrag_geschlossen(sd) and not_known(ueberlassung_von_geld(sd));
        then pflicht_zur_ueberlassung_der_sache(sd);
    }
    rule RueckerstattungGleicherArt(sd: Sachdarlehen) strict {
        label de official "Der Darlehensnehmer ist zur Zahlung eines Darlehensentgelts und bei Fälligkeit zur Rückerstattung von Sachen gleicher Art, Güte und Menge verpflichtet (§ 607 Absatz 1 Satz 2)";
        label en unofficial "the borrower must pay a loan fee and, when due, return things of the same kind, quality and quantity (§ 607 (1) sentence 2)";
        when pflicht_zur_ueberlassung_der_sache(sd);
        then pflicht_zur_rueckerstattung_gleicher_art(sd);
    }
}

// §§ 608–609 (D-08-18): Fälligkeit kraft Kündigung bei unbestimmter Zeit
// (§ 608 Absatz 1 setzt die Kündigung voraus, Absatz 2 erlaubt sie jederzeit,
// soweit nichts anderes vereinbart ist) und die späteste Fälligkeit des
// Entgelts bei Rückerstattung (§ 609). § 610 ist entfallen (kein Normtext).
pub relation rueckerstattungszeit_unbestimmt_608(sd: Sachdarlehen) kind empirical {
    label de official "Für die Rückerstattung der überlassenen Sache ist eine Zeit nicht bestimmt (§ 608 Absatz 1)";
    label en unofficial "no time has been fixed for the return of the thing provided (§ 608 (1))";
}
pub relation abweichende_vereinbarung_608(sd: Sachdarlehen) kind empirical {
    label de official "Es ist ein anderes als die jederzeitige Kündbarkeit vereinbart (§ 608 Absatz 2)";
    label en unofficial "something other than termination at any time has been agreed (§ 608 (2))";
}
pub relation kuendigung_608_erklaert(sd: Sachdarlehen) kind empirical {
    label de official "Der Darlehensgeber oder der Darlehensnehmer kündigt den auf unbestimmte Zeit abgeschlossenen Sachdarlehensvertrag (§ 608 Absatz 2)";
    label en unofficial "the lender or the borrower terminates the sachdarlehen contract concluded for an indefinite period (§ 608 (2))";
}
pub relation faelligkeit_haengt_von_kuendigung_ab_608(sd: Sachdarlehen) kind institutional {
    label de official "Die Fälligkeit der Rückerstattung hängt davon ab, dass der Darlehensgeber oder der Darlehensnehmer kündigt (§ 608 Absatz 1)";
    label en unofficial "maturity of the return obligation depends on the lender or the borrower giving notice (§ 608 (1))";
}
pub relation kuendigung_608_wirksam(sd: Sachdarlehen) kind institutional {
    label de official "Der auf unbestimmte Zeit abgeschlossene Sachdarlehensvertrag kann ganz oder teilweise gekündigt werden (§ 608 Absatz 2)";
    label en unofficial "the sachdarlehen contract concluded for an indefinite period may be terminated in whole or in part (§ 608 (2))";
}
pub relation entgelt_faellig_spaetestens_bei_rueckerstattung_609(sd: Sachdarlehen) kind institutional {
    label de official "Ein Entgelt hat der Darlehensnehmer spätestens bei Rückerstattung der überlassenen Sache zu bezahlen (§ 609)";
    label en unofficial "the borrower must pay any fee at the latest upon return of the thing provided (§ 609)";
}
@source(BGB_P608) {
    rule FaelligkeitHaengtVonKuendigungAb608(sd: Sachdarlehen) strict {
        label de official "Ist für die Rückerstattung der überlassenen Sache eine Zeit nicht bestimmt, hängt die Fälligkeit davon ab, dass der Darlehensgeber oder der Darlehensnehmer kündigt (§ 608 Absatz 1)";
        label en unofficial "where no time has been fixed for the return of the thing provided, maturity depends on the lender or the borrower giving notice (§ 608 (1))";
        when sachdarlehensvertrag_geschlossen(sd) and rueckerstattungszeit_unbestimmt_608(sd);
        then faelligkeit_haengt_von_kuendigung_ab_608(sd);
    }
    rule KuendigungJederzeitMoeglich608(sd: Sachdarlehen) strict {
        label de official "Ein auf unbestimmte Zeit abgeschlossener Sachdarlehensvertrag kann, soweit nicht ein anderes vereinbart ist, jederzeit vom Darlehensgeber oder Darlehensnehmer ganz oder teilweise gekündigt werden (§ 608 Absatz 2)";
        label en unofficial "unless otherwise agreed, a sachdarlehen contract concluded for an indefinite period may be terminated in whole or in part by the lender or the borrower at any time (§ 608 (2))";
        when faelligkeit_haengt_von_kuendigung_ab_608(sd) and kuendigung_608_erklaert(sd) and not_known(abweichende_vereinbarung_608(sd));
        then kuendigung_608_wirksam(sd);
    }
}
@source(BGB_P609)
rule EntgeltSpaetestensBeiRueckerstattung609(sd: Sachdarlehen) strict {
    label de official "Ein Entgelt hat der Darlehensnehmer spätestens bei Rückerstattung der überlassenen Sache zu bezahlen (§ 609)";
    label en unofficial "the borrower must pay any fee at the latest upon return of the thing provided (§ 609)";
    when pflicht_zur_rueckerstattung_gleicher_art(sd);
    then entgelt_faellig_spaetestens_bei_rueckerstattung_609(sd);
}

// ==================================================================================================
// TITEL 10 — MÄKLERVERTRAG (§§ 652–656d)
// ==================================================================================================

pub entity Maklervertrag {
    label de official "Maklervertrag (§ 652 Absatz 1)";
    label en unofficial "brokerage contract (§ 652 (1))";
}

pub relation makler(m: Maklervertrag, p: Person) kind empirical {
    key(m);
    label de official "Makler (§ 652 Absatz 1)";
    label en unofficial "broker (§ 652 (1))";
}
pub relation maklerlohn_versprochen(m: Maklervertrag, betrag: Money) kind empirical {
    key(m);
    label de official "Versprochener Maklerlohn für den Nachweis der Gelegenheit zum Abschluss eines Vertrags oder für die Vermittlung eines Vertrags (§ 652 Absatz 1 Satz 1)";
    label en unofficial "brokerage fee promised for evidencing the opportunity to conclude a contract or for procuring a contract (§ 652 (1) sentence 1)";
}
pub relation vertrag_infolge_des_nachweises_zustande_gekommen(m: Maklervertrag) kind empirical {
    label de official "Der Vertrag ist infolge des Nachweises oder infolge der Vermittlung des Maklers zustande gekommen (§ 652 Absatz 1 Satz 1)";
    label en unofficial "the contract came about as a result of the broker's evidence or procurement (§ 652 (1) sentence 1)";
}
pub relation aufschiebende_bedingung_noch_nicht_eingetreten(m: Maklervertrag) kind empirical {
    label de official "Der Vertrag ist unter einer aufschiebenden Bedingung geschlossen und die Bedingung ist noch nicht eingetreten (§ 652 Absatz 1 Satz 2)";
    label en unofficial "the contract was concluded subject to a condition precedent which has not yet occurred (§ 652 (1) sentence 2)";
}
pub relation auch_fuer_den_anderen_teil_taetig(m: Maklervertrag) kind empirical {
    label de official "Der Makler ist dem Inhalt des Vertrags zuwider auch für den anderen Teil tätig gewesen (§ 654)";
    label en unofficial "contrary to the content of the contract the broker also acted for the other party (§ 654)";
}
pub relation lohnanspruch_des_maklers(m: Maklervertrag, betrag: Money) kind institutional {
    label de official "Der Auftraggeber ist zur Entrichtung des Maklerlohnes verpflichtet (§ 652 Absatz 1 Satz 1)";
    label en unofficial "the principal is obliged to pay the brokerage fee (§ 652 (1) sentence 1)";
}
pub relation lohnanspruch_verwirkt(m: Maklervertrag) kind institutional {
    label de official "Der Anspruch auf den Maklerlohn und den Ersatz von Aufwendungen ist ausgeschlossen (§ 654)";
    label en unofficial "the claim to the brokerage fee and to reimbursement of outlays is excluded (§ 654)";
}
@source(BGB_P655)
pub external judgment relation unverhaeltnismaessig_hoher_maklerlohn(m: Maklervertrag) {
    authority Court;
    label de official "Für den Nachweis der Gelegenheit zum Abschluss eines Dienstvertrags oder für die Vermittlung eines solchen Vertrags ist ein unverhältnismäßig hoher Maklerlohn vereinbart worden (§ 655 Satz 1)";
    label en unofficial "a disproportionately high brokerage fee has been agreed for evidencing the opportunity to conclude a contract of service or for procuring such a contract (§ 655 sentence 1)";
}
pub relation lohn_bereits_entrichtet(m: Maklervertrag) kind empirical {
    label de official "Der Maklerlohn ist bereits entrichtet — nach der Entrichtung ist die Herabsetzung ausgeschlossen (§ 655 Satz 2)";
    label en unofficial "the brokerage fee has already been paid — after payment the reduction is excluded (§ 655 sentence 2)";
}
pub relation herabsetzung_auf_angemessenen_betrag(m: Maklervertrag) kind institutional {
    label de official "Der Maklerlohn kann auf Antrag des Schuldners durch Urteil auf den angemessenen Betrag herabgesetzt werden (§ 655 Satz 1)";
    label en unofficial "the brokerage fee may be reduced by judgment to a reasonable amount on the debtor's application (§ 655 sentence 1)";
}
pub relation heiratsvermittlung(m: Maklervertrag) kind empirical {
    label de official "Versprechen eines Lohnes für den Nachweis der Gelegenheit zur Eingehung einer Ehe oder für die Vermittlung des Zustandekommens einer Ehe (§ 656 Absatz 1 Satz 1)";
    label en unofficial "promise of a fee for evidencing the opportunity to enter into a marriage or for procuring a marriage (§ 656 (1) sentence 1)";
}
pub relation keine_verbindlichkeit_begruendet(m: Maklervertrag) kind institutional {
    label de official "Durch das Versprechen wird eine Verbindlichkeit nicht begründet (§ 656 Absatz 1 Satz 1)";
    label en unofficial "the promise does not create an obligation (§ 656 (1) sentence 1)";
}
pub relation kaufvertrag_wohnung_oder_einfamilienhaus(m: Maklervertrag) kind empirical {
    label de official "Der Maklervertrag hat den Nachweis der Gelegenheit zum Abschluss eines Kaufvertrags über eine Wohnung oder ein Einfamilienhaus oder die Vermittlung eines solchen Vertrags zum Gegenstand (§ 656a, § 656c Absatz 1 Satz 1)";
    label en unofficial "the brokerage contract concerns evidencing the opportunity to conclude, or procuring, a contract of sale of a flat or single-family house (§ 656a, § 656c (1) sentence 1)";
}
pub relation kaeufer_ist_verbraucher(m: Maklervertrag) kind empirical {
    label de official "Der Käufer ist Verbraucher — persönlicher Anwendungsbereich der §§ 656c und 656d (§ 656b)";
    label en unofficial "the purchaser is a consumer — scope of application of §§ 656c and 656d (§ 656b)";
}
pub relation textform_eingehalten_656a(m: Maklervertrag) kind empirical {
    label de official "Der Maklervertrag ist in Textform geschlossen (§ 656a)";
    label en unofficial "the brokerage contract has been concluded in text form (§ 656a)";
}
pub relation maklervertrag_formgueltig(m: Maklervertrag) kind institutional {
    label de official "Der Maklervertrag genügt der Textform (§ 656a)";
    label en unofficial "the brokerage contract complies with the text form requirement (§ 656a)";
}
pub relation lohn_von_beiden_parteien_versprochen(m: Maklervertrag, betrag_kaeufer: Money, betrag_verkaeufer: Money) kind empirical {
    key(m);
    label de official "Der Makler lässt sich von beiden Parteien des Kaufvertrags einen Maklerlohn versprechen; die beiden versprochenen Beträge (§ 656c Absatz 1 Satz 1)";
    label en unofficial "the broker has both parties to the contract of sale promise a fee; the two promised amounts (§ 656c (1) sentence 1)";
}
pub relation maklervertrag_unwirksam_656c(m: Maklervertrag) kind institutional {
    label de official "Ein Maklervertrag, der von § 656c Absatz 1 Satz 1 und 2 abweicht, ist unwirksam (§ 656c Absatz 2 Satz 1)";
    label en unofficial "a brokerage contract departing from § 656c (1) sentences 1 and 2 is void (§ 656c (2) sentence 1)";
}
pub relation lohnverpflichtung_in_gleicher_hoehe(m: Maklervertrag) kind institutional {
    label de official "Die Parteien verpflichten sich in gleicher Höhe — nur so kann sich der Makler von beiden Parteien einen Maklerlohn versprechen lassen (§ 656c Absatz 1 Satz 1)";
    label en unofficial "the parties undertake in equal amounts — only thus may the broker have both parties promise a fee (§ 656c (1) sentence 1)";
}

@source(BGB_P652) {
    rule LohnanspruchEntsteht(m: Maklervertrag, betrag: Money) strict {
        label de official "Wer für den Nachweis der Gelegenheit zum Abschluss eines Vertrags oder für die Vermittlung eines Vertrags einen Maklerlohn verspricht, ist zur Entrichtung des Lohnes nur verpflichtet, wenn der Vertrag infolge des Nachweises oder der Vermittlung zustande kommt (§ 652 Absatz 1 Satz 1)";
        label en unofficial "a person promising a brokerage fee for evidencing the opportunity to conclude a contract or for procuring a contract owes the fee only where the contract comes about as a result of that evidence or procurement (§ 652 (1) sentence 1)";
        when maklerlohn_versprochen(m, betrag) and vertrag_infolge_des_nachweises_zustande_gekommen(m)
            and not_known(aufschiebende_bedingung_noch_nicht_eingetreten(m))
            and not_known(lohnanspruch_verwirkt(m));
        then lohnanspruch_des_maklers(m, betrag);
    }
}
@source(BGB_P654)
rule VerwirkungDesLohnanspruchs(m: Maklervertrag) strict {
    label de official "Der Anspruch auf den Maklerlohn und den Ersatz von Aufwendungen ist ausgeschlossen, wenn der Makler dem Inhalt des Vertrags zuwider auch für den anderen Teil tätig gewesen ist (§ 654)";
    label en unofficial "the claim to the brokerage fee and to reimbursement of outlays is excluded where, contrary to the content of the contract, the broker also acted for the other party (§ 654)";
    when auch_fuer_den_anderen_teil_taetig(m);
    then lohnanspruch_verwirkt(m);
}
@source(BGB_P655)
rule HerabsetzungDesMaklerlohns(m: Maklervertrag) strict {
    label de official "Ist ein unverhältnismäßig hoher Maklerlohn vereinbart worden, so kann er auf Antrag des Schuldners durch Urteil auf den angemessenen Betrag herabgesetzt werden; nach der Entrichtung des Lohnes ist die Herabsetzung ausgeschlossen (§ 655)";
    label en unofficial "where a disproportionately high brokerage fee has been agreed it may be reduced by judgment to a reasonable amount on the debtor's application; after payment the reduction is excluded (§ 655)";
    when unverhaeltnismaessig_hoher_maklerlohn(m) and not_known(lohn_bereits_entrichtet(m));
    then herabsetzung_auf_angemessenen_betrag(m);
}
@source(BGB_P656)
rule HeiratsvermittlungOhneVerbindlichkeit(m: Maklervertrag) strict {
    label de official "Durch das Versprechen eines Lohnes für den Nachweis der Gelegenheit zur Eingehung einer Ehe oder für die Vermittlung des Zustandekommens einer Ehe wird eine Verbindlichkeit nicht begründet (§ 656 Absatz 1 Satz 1)";
    label en unofficial "the promise of a fee for evidencing the opportunity to enter into a marriage or for procuring a marriage does not create an obligation (§ 656 (1) sentence 1)";
    when heiratsvermittlung(m);
    then keine_verbindlichkeit_begruendet(m);
}
@source(BGB_P656a)
rule TextformDesMaklervertrags(m: Maklervertrag) strict {
    label de official "Ein Maklervertrag, der den Nachweis der Gelegenheit zum Abschluss eines Kaufvertrags über eine Wohnung oder ein Einfamilienhaus oder die Vermittlung eines solchen Vertrags zum Gegenstand hat, bedarf der Textform (§ 656a)";
    label en unofficial "a brokerage contract concerning the evidencing or procuring of a contract of sale of a flat or single-family house requires text form (§ 656a)";
    when kaufvertrag_wohnung_oder_einfamilienhaus(m) and textform_eingehalten_656a(m);
    then maklervertrag_formgueltig(m);
}
@source(BGB_P656c) {
    rule ProvisionsteilungInGleicherHoehe(m: Maklervertrag, bk: Money, bv: Money) strict {
        label de official "Lässt sich der Makler von beiden Parteien des Kaufvertrags über eine Wohnung oder ein Einfamilienhaus einen Maklerlohn versprechen, so kann dies nur in der Weise erfolgen, dass sich die Parteien in gleicher Höhe verpflichten (§ 656c Absatz 1 Satz 1)";
        label en unofficial "where the broker has both parties to a contract of sale of a flat or single-family house promise a fee, this may be done only in such a way that the parties undertake in equal amounts (§ 656c (1) sentence 1)";
        when kaufvertrag_wohnung_oder_einfamilienhaus(m) and kaeufer_ist_verbraucher(m)
            and lohn_von_beiden_parteien_versprochen(m, bk, bv) and bk == bv;
        then lohnverpflichtung_in_gleicher_hoehe(m);
    }
    rule MaklervertragUnwirksamBeiUngleicherProvision(m: Maklervertrag, bk: Money, bv: Money) strict {
        label de official "Ein Maklervertrag, der von Absatz 1 Satz 1 und 2 abweicht, ist unwirksam (§ 656c Absatz 2 Satz 1)";
        label en unofficial "a brokerage contract departing from (1) sentences 1 and 2 is void (§ 656c (2) sentence 1)";
        when kaufvertrag_wohnung_oder_einfamilienhaus(m) and kaeufer_ist_verbraucher(m)
            and lohn_von_beiden_parteien_versprochen(m, bk, bv) and bk != bv;
        then maklervertrag_unwirksam_656c(m);
    }
}

// § 653 Maklerlohn: stillschweigende Vereinbarung nach den Umständen
// (Absatz 1) und Höhe nach Taxe/üblichem Lohn (Absatz 2). §§ 655b–655e
// (D-08-22): Darlehensvermittlungsvertrag — Schriftform mit Nichtigkeitsfolge,
// Vergütung nur nach Leistung und Widerrufsfristablauf (Umschuldung: nur wenn
// effektiver Jahreszins nicht steigt), Nebenentgelte-Verbot mit gedeckelter
// Auslagenerstattung, Abweichungsverbot zum Nachteil samt Umgehungsschutz.
// § 656b bleibt Grenze: reiner persönlicher Anwendungsbereich der §§ 656c/d
// ohne eigene Rechtsfolge — sein Inhalt ist bereits als Tatbestandsmerkmal
// `kaeufer_ist_verbraucher` in den § 656c-Regeln verdrahtet.
pub relation leistung_nur_gegen_verguetung_zu_erwarten_653(m: Maklervertrag) kind empirical {
    label de official "Die dem Makler übertragene Leistung ist den Umständen nach nur gegen eine Vergütung zu erwarten (§ 653 Absatz 1)";
    label en unofficial "the service entrusted to the broker can, given the circumstances, only be expected against remuneration (§ 653 (1))";
}
pub relation maklerlohn_653_stillschweigend_vereinbart(m: Maklervertrag) kind institutional {
    label de official "Ein Maklerlohn gilt als stillschweigend vereinbart (§ 653 Absatz 1)";
    label en unofficial "a brokerage fee is deemed tacitly agreed (§ 653 (1))";
}
pub relation hoehe_der_verguetung_653_nicht_bestimmt(m: Maklervertrag) kind empirical {
    label de official "Die Höhe der Vergütung ist nicht bestimmt (§ 653 Absatz 2)";
    label en unofficial "the amount of the remuneration has not been fixed (§ 653 (2))";
}
pub relation taxmaessiger_lohn_653(m: Maklervertrag, betrag: Money) kind empirical {
    key(m);
    label de official "Taxmäßiger Lohn bei Bestehen einer Taxe (§ 653 Absatz 2)";
    label en unofficial "the fee under a fixed schedule of fees, where one exists (§ 653 (2))";
}
pub relation ueblicher_lohn_653(m: Maklervertrag, betrag: Money) kind empirical {
    key(m);
    label de official "Üblicher Lohn in Ermangelung einer Taxe (§ 653 Absatz 2)";
    label en unofficial "the customary fee in the absence of a fixed schedule (§ 653 (2))";
}
pub relation lohn_653_als_vereinbart_anzusehen(m: Maklervertrag, betrag: Money) kind institutional {
    label de official "Der taxmäßige oder, in Ermangelung einer Taxe, der übliche Lohn ist als vereinbart anzusehen (§ 653 Absatz 2)";
    label en unofficial "the fee under the schedule, or in its absence the customary fee, is deemed agreed (§ 653 (2))";
}
@source(BGB_P653) {
    rule Maklerlohn653StillschweigendVereinbart(m: Maklervertrag) strict {
        label de official "Ein Maklerlohn gilt als stillschweigend vereinbart, wenn die dem Makler übertragene Leistung den Umständen nach nur gegen eine Vergütung zu erwarten ist (§ 653 Absatz 1)";
        label en unofficial "a brokerage fee is deemed tacitly agreed where the service entrusted to the broker can, given the circumstances, only be expected against remuneration (§ 653 (1))";
        when leistung_nur_gegen_verguetung_zu_erwarten_653(m);
        then maklerlohn_653_stillschweigend_vereinbart(m);
    }
    rule LohnhoeheNachTaxe653(m: Maklervertrag, betrag: Money) strict {
        label de official "Ist die Höhe der Vergütung nicht bestimmt, so ist bei dem Bestehen einer Taxe der taxmäßige Lohn als vereinbart anzusehen (§ 653 Absatz 2)";
        label en unofficial "where the amount of remuneration is not fixed, the fee under a schedule of fees, where one exists, is deemed agreed (§ 653 (2))";
        when hoehe_der_verguetung_653_nicht_bestimmt(m) and taxmaessiger_lohn_653(m, betrag);
        then lohn_653_als_vereinbart_anzusehen(m, betrag);
    }
    rule LohnhoeheUeblicherLohn653(m: Maklervertrag, betrag: Money) strict {
        label de official "Ist die Höhe der Vergütung nicht bestimmt, so ist in Ermangelung einer Taxe der übliche Lohn als vereinbart anzusehen (§ 653 Absatz 2)";
        label en unofficial "where the amount of remuneration is not fixed and no schedule of fees exists, the customary fee is deemed agreed (§ 653 (2))";
        when hoehe_der_verguetung_653_nicht_bestimmt(m) and not_known(taxmaessiger_lohn_653(m, betrag)) and ueblicher_lohn_653(m, betrag);
        then lohn_653_als_vereinbart_anzusehen(m, betrag);
    }
}

pub relation darlehensvermittlungsvertrag_mit_verbraucher_655b(m: Maklervertrag) kind empirical {
    label de official "Es ist ein Darlehensvermittlungsvertrag mit einem Verbraucher geschlossen worden (§ 655b Absatz 1)";
    label en unofficial "a loan-brokerage contract has been concluded with a consumer (§ 655b (1))";
}
pub relation schriftform_655b_eingehalten(m: Maklervertrag) kind empirical {
    label de official "Der Darlehensvermittlungsvertrag ist in schriftlicher Form geschlossen und nicht mit dem Antrag auf Hingabe des Darlehens verbunden (§ 655b Absatz 1 Satz 1, 2)";
    label en unofficial "the loan-brokerage contract has been concluded in writing and not combined with the application for the loan (§ 655b (1) sentence 1, 2)";
}
pub relation vorvertragliche_pflichten_655b_erfuellt(m: Maklervertrag) kind empirical {
    label de official "Die Pflichten aus Artikel 247 § 13 Absatz 2 und § 13b Absatz 1, 3 EGBGB sind vor Vertragsschluss erfüllt worden (§ 655b Absatz 2)";
    label en unofficial "the duties under Article 247 § 13 (2) and § 13b (1), (3) EGBGB have been fulfilled before conclusion (§ 655b (2))";
}
pub relation darlehensvermittlungsvertrag_655b_nichtig(m: Maklervertrag) kind institutional {
    label de official "Der Darlehensvermittlungsvertrag mit einem Verbraucher ist nichtig (§ 655b Absatz 2)";
    label en unofficial "the loan-brokerage contract with a consumer is void (§ 655b (2))";
}
@source(BGB_P655b) {
    rule DarlehensvermittlungsvertragNichtigBeiFormmangel655b(m: Maklervertrag) strict {
        label de official "Ein Darlehensvermittlungsvertrag mit einem Verbraucher, der den Anforderungen der Schriftform nicht genügt, ist nichtig (§ 655b Absatz 2)";
        label en unofficial "a loan-brokerage contract with a consumer that does not satisfy the written-form requirement is void (§ 655b (2))";
        when darlehensvermittlungsvertrag_mit_verbraucher_655b(m) and not_known(schriftform_655b_eingehalten(m));
        then darlehensvermittlungsvertrag_655b_nichtig(m);
    }
    rule DarlehensvermittlungsvertragNichtigBeiFehlendenVorvertraglichenPflichten655b(m: Maklervertrag) strict {
        label de official "Ein Darlehensvermittlungsvertrag mit einem Verbraucher, vor dessen Abschluss die vorvertraglichen Pflichten nicht erfüllt worden sind, ist nichtig (§ 655b Absatz 2)";
        label en unofficial "a loan-brokerage contract with a consumer before whose conclusion the pre-contractual duties were not fulfilled is void (§ 655b (2))";
        when darlehensvermittlungsvertrag_mit_verbraucher_655b(m) and not_known(vorvertragliche_pflichten_655b_erfuellt(m));
        then darlehensvermittlungsvertrag_655b_nichtig(m);
    }
}

pub relation darlehen_infolge_vermittlung_geleistet_655c(m: Maklervertrag) kind empirical {
    label de official "Infolge der Vermittlung, des Nachweises oder der sonstigen Tätigkeit des Darlehensvermittlers wird das Darlehen an den Verbraucher geleistet (§ 655c Satz 1)";
    label en unofficial "as a result of the intermediary's procurement, evidence or other activity the loan is disbursed to the consumer (§ 655c sentence 1)";
}
pub relation widerruf_nach_355_nicht_mehr_moeglich_655c(m: Maklervertrag) kind empirical {
    label de official "Ein Widerruf des Verbrauchers nach § 355 ist nicht mehr möglich (§ 655c Satz 1)";
    label en unofficial "revocation by the consumer under § 355 is no longer possible (§ 655c sentence 1)";
}
pub relation umschuldung_mit_wissen_des_vermittlers_655c(m: Maklervertrag) kind empirical {
    label de official "Der Verbraucherdarlehensvertrag dient mit Wissen des Darlehensvermittlers der vorzeitigen Ablösung eines anderen Darlehens (Umschuldung) (§ 655c Satz 2)";
    label en unofficial "with the intermediary's knowledge, the consumer loan contract serves the early discharge of another loan (refinancing) (§ 655c sentence 2)";
}
pub relation effektiver_jahreszins_bei_umschuldung_erhoeht_sich_655c(m: Maklervertrag) kind empirical {
    label de official "Der effektive Jahreszins erhöht sich gegenüber dem abzulösenden Darlehen (§ 655c Satz 2)";
    label en unofficial "the annual percentage rate of charge increases compared with the loan being discharged (§ 655c sentence 2)";
}
pub relation verguetungsanspruch_655c(m: Maklervertrag) kind institutional {
    label de official "Der Verbraucher ist zur Zahlung der Vergütung verpflichtet (§ 655c Satz 1, 2)";
    label en unofficial "the consumer must pay the remuneration (§ 655c sentence 1, 2)";
}
@source(BGB_P655c) {
    rule Verguetungsanspruch655cAllgemein(m: Maklervertrag) strict {
        label de official "Der Verbraucher ist zur Zahlung der Vergütung nur verpflichtet, wenn infolge der Vermittlung das Darlehen geleistet wird und ein Widerruf nach § 355 nicht mehr möglich ist (§ 655c Satz 1)";
        label en unofficial "the consumer must pay the remuneration only where the loan has been disbursed as a result of the procurement and revocation under § 355 is no longer possible (§ 655c sentence 1)";
        when darlehen_infolge_vermittlung_geleistet_655c(m) and widerruf_nach_355_nicht_mehr_moeglich_655c(m)
            and not_known(umschuldung_mit_wissen_des_vermittlers_655c(m));
        then verguetungsanspruch_655c(m);
    }
    rule Verguetungsanspruch655cBeiUmschuldungOhneErhoehung(m: Maklervertrag) strict {
        label de official "Dient der Verbraucherdarlehensvertrag mit Wissen des Darlehensvermittlers der Umschuldung, entsteht ein Anspruch auf die Vergütung nur, wenn sich der effektive Jahreszins nicht erhöht (§ 655c Satz 2)";
        label en unofficial "where the contract serves refinancing with the intermediary's knowledge, the remuneration claim arises only if the annual percentage rate of charge does not increase (§ 655c sentence 2)";
        when darlehen_infolge_vermittlung_geleistet_655c(m) and widerruf_nach_355_nicht_mehr_moeglich_655c(m)
            and umschuldung_mit_wissen_des_vermittlers_655c(m) and not_known(effektiver_jahreszins_bei_umschuldung_erhoeht_sich_655c(m));
        then verguetungsanspruch_655c(m);
    }
}

pub relation nebenentgelt_fuer_vermittlungsbezogene_leistung_vereinbart_655d(m: Maklervertrag) kind empirical {
    label de official "Für Leistungen im Zusammenhang mit der Vermittlung oder dem Nachweis ist außer der Vergütung nach § 655c und einem Beratungsentgelt ein weiteres Entgelt vereinbart worden (§ 655d Satz 1)";
    label en unofficial "in connection with the procurement or evidence a fee other than the § 655c remuneration and any advisory fee has been agreed (§ 655d sentence 1)";
}
pub relation nebenentgelt_655d_unzulaessig(m: Maklervertrag) kind institutional {
    label de official "Ein solches Entgelt darf nicht vereinbart werden (§ 655d Satz 1)";
    label en unofficial "such a fee may not be agreed (§ 655d sentence 1)";
}
pub relation erforderliche_auslagen_vereinbart_655d(m: Maklervertrag, betrag: Money) kind empirical {
    key(m);
    label de official "Vereinbarte Erstattung dem Darlehensvermittler entstandener, erforderlicher Auslagen (§ 655d Satz 2)";
    label en unofficial "agreed reimbursement of necessary outlays incurred by the intermediary (§ 655d sentence 2)";
}
pub relation mitgeteilter_hoechstbetrag_655d(m: Maklervertrag, betrag: Money) kind empirical {
    key(m);
    label de official "Dem Verbraucher gemäß Artikel 247 § 13 Absatz 2 Satz 1 Nummer 4 EGBGB mitgeteilter Höchstbetrag der Auslagen (§ 655d Satz 3)";
    label en unofficial "the maximum amount of outlays communicated to the consumer under Article 247 § 13 (2) sentence 1 no. 4 EGBGB (§ 655d sentence 3)";
}
pub relation auslagenanspruch_655d_unwirksam(m: Maklervertrag) kind institutional {
    label de official "Der Anspruch auf Auslagenerstattung ist unwirksam, soweit er den mitgeteilten Höchstbetrag übersteigt (§ 655d Satz 3)";
    label en unofficial "the claim to reimbursement of outlays is ineffective in so far as it exceeds the communicated maximum amount (§ 655d sentence 3)";
}
@source(BGB_P655d) {
    rule Nebenentgelt655dUnzulaessig(m: Maklervertrag) strict {
        label de official "Der Darlehensvermittler darf für Leistungen, die mit der Vermittlung zusammenhängen, außer der Vergütung nach § 655c und eines Beratungsentgelts ein Entgelt nicht vereinbaren (§ 655d Satz 1)";
        label en unofficial "the intermediary may not agree a fee for services connected with the procurement other than the § 655c remuneration and any advisory fee (§ 655d sentence 1)";
        when nebenentgelt_fuer_vermittlungsbezogene_leistung_vereinbart_655d(m);
        then nebenentgelt_655d_unzulaessig(m);
    }
    rule Auslagenanspruch655dUnwirksamUeberHoechstbetrag(m: Maklervertrag, betrag: Money, hoechstbetrag: Money) strict {
        label de official "Der Anspruch auf Erstattung erforderlicher Auslagen darf die dem Verbraucher mitgeteilten Höchstbeträge nicht übersteigen (§ 655d Satz 3)";
        label en unofficial "the claim to reimbursement of necessary outlays may not exceed the maximum amounts communicated to the consumer (§ 655d sentence 3)";
        when erforderliche_auslagen_vereinbart_655d(m, betrag) and mitgeteilter_hoechstbetrag_655d(m, hoechstbetrag) and betrag > hoechstbetrag;
        then auslagenanspruch_655d_unwirksam(m);
    }
}
pub relation nebenentgelt_655d_vereinbart_am(m: Maklervertrag, tag: Date) kind empirical {
    label de official "Der Darlehensvermittler hat das unzulässige Nebenentgelt vereinbart (§ 655d)";
    label en unofficial "the intermediary agreed the impermissible ancillary fee (§ 655d)";
}
pub relation verbotsbeginn_655d_am(m: Maklervertrag, tag: Date) kind empirical {
    label de official "Beginn des Verbots des Nebenentgelts nach § 655d";
    label en unofficial "start of the ancillary fee prohibition under § 655d";
}
pub relation vermittler_655d(m: Maklervertrag, p: Person) kind empirical {
    label de official "Darlehensvermittler nach § 655d";
    label en unofficial "credit intermediary under § 655d";
}
@source(BGB_P655d)
rule Position655dNebenentgelt(m: Maklervertrag, p: Person, beginn: Date) strict {
    label de official "Dem Darlehensvermittler ist es verboten, ein unzulässiges Nebenentgelt zu vereinbaren (§ 655d)";
    label en unofficial "The credit intermediary is prohibited from agreeing an impermissible ancillary fee (§ 655d)";
    when vermittler_655d(m, p) and nebenentgelt_fuer_vermittlungsbezogene_leistung_vereinbart_655d(m)
     and verbotsbeginn_655d_am(m, beginn);
    then prohibition Prohibition655dNebenentgelt {
        bearer p;
        action nebenentgelt_655d_vereinbart_am(m, beginn);
        window [beginn, infinity);
    };
}

pub relation abweichung_zum_nachteil_des_verbrauchers_655e_vereinbart(m: Maklervertrag) kind empirical {
    label de official "Es ist eine Abweichung von den Vorschriften der §§ 655a bis 655d zum Nachteil des Verbrauchers vereinbart oder durch anderweitige Gestaltung umgangen worden (§ 655e Absatz 1)";
    label en unofficial "a deviation from §§ 655a to 655d to the disadvantage of the consumer has been agreed or circumvented by another arrangement (§ 655e (1))";
}
pub relation abweichung_655e_unwirksam(m: Maklervertrag) kind institutional {
    label de official "Die Abweichung ist unwirksam (§ 655e Absatz 1)";
    label en unofficial "the deviation is ineffective (§ 655e (1))";
}
@source(BGB_P655e)
rule Abweichung655eZumNachteilUnwirksam(m: Maklervertrag) strict {
    label de official "Von den Vorschriften dieses Untertitels darf nicht zum Nachteil des Verbrauchers abgewichen werden; die Vorschriften finden auch Anwendung, wenn sie durch anderweitige Gestaltungen umgangen werden (§ 655e Absatz 1)";
    label en unofficial "these provisions may not be deviated from to the consumer's disadvantage; they also apply where circumvented by another arrangement (§ 655e (1))";
    when abweichung_zum_nachteil_des_verbrauchers_655e_vereinbart(m);
    then abweichung_655e_unwirksam(m);
}
pub relation verbraucher_655e(m: Maklervertrag, p: Person) kind empirical {
    label de official "Verbraucher nach § 655e";
    label en unofficial "consumer under § 655e";
}
pub relation abweichung_655e_vereinbart_am(m: Maklervertrag, tag: Date) kind empirical {
    label de official "Eine Abweichung zum Nachteil des Verbrauchers wurde vereinbart (§ 655e)";
    label en unofficial "a deviation to the consumer's disadvantage was agreed (§ 655e)";
}
pub relation verbotsbeginn_655e_am(m: Maklervertrag, tag: Date) kind empirical {
    label de official "Beginn des Abweichungsverbots nach § 655e";
    label en unofficial "start of the deviation prohibition under § 655e";
}
@source(BGB_P655e)
rule Position655eAbweichung(m: Maklervertrag, p: Person, beginn: Date) strict {
    label de official "Es ist verboten, zum Nachteil des Verbrauchers von den Vorschriften abzuweichen (§ 655e)";
    label en unofficial "It is prohibited to depart from these provisions to the consumer's disadvantage (§ 655e)";
    when verbraucher_655e(m, p) and verbotsbeginn_655e_am(m, beginn);
    then prohibition Prohibition655eAbweichung {
        bearer p;
        action abweichung_655e_vereinbart_am(m, beginn);
        window [beginn, infinity);
    };
}

pub relation nur_eine_partei_maklervertrag_geschlossen_656d(m: Maklervertrag, betrag_beauftragende_partei: Money) kind empirical {
    key(m);
    label de official "Nur eine Partei des Kaufvertrags über eine Wohnung oder ein Einfamilienhaus hat einen Maklervertrag abgeschlossen; von ihr geschuldeter Maklerlohn (§ 656d Absatz 1 Satz 1)";
    label en unofficial "only one party to the sale of a flat or single-family house has concluded a brokerage contract; the fee owed by it (§ 656d (1) sentence 1)";
}
pub relation andere_partei_soll_zahlen_656d(m: Maklervertrag, betrag_andere_partei: Money) kind empirical {
    key(m);
    label de official "Vereinbarung, die die andere Partei zur Zahlung oder Erstattung von Maklerlohn verpflichtet; vereinbarter Betrag (§ 656d Absatz 1 Satz 1)";
    label en unofficial "agreement obliging the other party to pay or reimburse brokerage fee; the agreed amount (§ 656d (1) sentence 1)";
}
pub relation vereinbarung_656d_wirksam(m: Maklervertrag) kind institutional {
    label de official "Die Vereinbarung, die die andere Partei zur Zahlung oder Erstattung von Maklerlohn verpflichtet, ist wirksam (§ 656d Absatz 1 Satz 1)";
    label en unofficial "the agreement obliging the other party to pay or reimburse brokerage fee is effective (§ 656d (1) sentence 1)";
}
pub relation beauftragende_partei_hat_gezahlt_656d(m: Maklervertrag) kind empirical {
    label de official "Die Partei, die den Maklervertrag abgeschlossen hat, ist ihrer Verpflichtung zur Zahlung des Maklerlohns nachgekommen und ein Nachweis hierüber ist erbracht (§ 656d Absatz 1 Satz 2)";
    label en unofficial "the party that concluded the brokerage contract has fulfilled its obligation to pay the fee and proof of this has been furnished (§ 656d (1) sentence 2)";
}
pub relation anspruch_gegen_andere_partei_656d_faellig(m: Maklervertrag) kind institutional {
    label de official "Der Anspruch gegen die andere Partei ist fällig (§ 656d Absatz 1 Satz 2)";
    label en unofficial "the claim against the other party is due (§ 656d (1) sentence 2)";
}
@source(BGB_P656d) {
    rule Vereinbarung656dWirksamBeiGleicherHoehe(m: Maklervertrag, betrag: Money, andere_betrag: Money) strict {
        label de official "Eine Vereinbarung, die die andere Partei zur Zahlung oder Erstattung von Maklerlohn verpflichtet, ist nur wirksam, wenn die Partei, die den Maklervertrag abgeschlossen hat, zur Zahlung des Maklerlohns mindestens in gleicher Höhe verpflichtet bleibt (§ 656d Absatz 1 Satz 1)";
        label en unofficial "an agreement obliging the other party to pay or reimburse brokerage fee is effective only where the contracting party remains obliged to pay a fee of at least the same amount (§ 656d (1) sentence 1)";
        when nur_eine_partei_maklervertrag_geschlossen_656d(m, betrag) and andere_partei_soll_zahlen_656d(m, andere_betrag) and betrag >= andere_betrag;
        then vereinbarung_656d_wirksam(m);
    }
    rule AnspruchGegenAnderePartei656dFaelligNachZahlung(m: Maklervertrag) strict {
        label de official "Der Anspruch gegen die andere Partei wird erst fällig, wenn die Partei, die den Maklervertrag abgeschlossen hat, ihrer Verpflichtung zur Zahlung des Maklerlohns nachgekommen ist und sie oder der Makler einen Nachweis hierüber erbringt (§ 656d Absatz 1 Satz 2)";
        label en unofficial "the claim against the other party becomes due only once the contracting party has fulfilled its obligation to pay the fee and it or the broker furnishes proof of this (§ 656d (1) sentence 2)";
        when vereinbarung_656d_wirksam(m) and beauftragende_partei_hat_gezahlt_656d(m);
        then anspruch_gegen_andere_partei_656d_faellig(m);
    }
}

// ==================================================================================================
// TITEL 11 — AUSLOBUNG (§§ 657–661a)
// ==================================================================================================

pub entity Auslobung {
    label de official "Auslobung (§ 657)";
    label en unofficial "public promise of a reward (§ 657)";
}
pub relation belohnung_oeffentlich_ausgesetzt(al: Auslobung, betrag: Money) kind empirical {
    key(al);
    label de official "Durch öffentliche Bekanntmachung ausgesetzte Belohnung für die Vornahme einer Handlung (§ 657)";
    label en unofficial "reward offered by public notice for the performance of an act (§ 657)";
}
pub relation handlung_vorgenommen_am(al: Auslobung, p: Person, tag: Date) kind empirical {
    label de official "Tag, an dem eine Person die Handlung vorgenommen hat (§ 657, § 659 Absatz 1)";
    label en unofficial "day on which a person performed the act (§ 657, § 659 (1))";
}
pub relation auslobung_wirksam_widerrufen(al: Auslobung) kind empirical {
    label de official "Die Auslobung ist vor Vornahme der Handlung in derselben Weise wie die Auslobung oder durch besondere Mitteilung widerrufen worden (§ 658 Absatz 1)";
    label en unofficial "the promise was revoked before performance of the act in the same manner as the promise or by special notice (§ 658 (1))";
}
pub relation auf_widerruflichkeit_verzichtet(al: Auslobung) kind empirical {
    label de official "Auf die Widerruflichkeit ist in der Auslobung verzichtet worden; ein Verzicht liegt im Zweifel in der Bestimmung einer Frist für die Vornahme der Handlung (§ 658 Absatz 2)";
    label en unofficial "revocability was waived in the promise; in case of doubt a waiver lies in the setting of a period for performing the act (§ 658 (2))";
}
pub relation anspruch_auf_belohnung(al: Auslobung, p: Person, betrag: Money) kind institutional {
    label de official "Der Auslobende ist verpflichtet, die Belohnung demjenigen zu entrichten, welcher die Handlung vorgenommen hat (§ 657)";
    label en unofficial "the promisor must pay the reward to the person who performed the act (§ 657)";
}
pub relation frueheste_vornahme_am(al: Auslobung, tag: Date) kind derived {
    key(al);
    label de official "Tag der frühesten Vornahme der Handlung — Bezugsgröße des § 659 Absatz 1";
    label en unofficial "day of the earliest performance of the act — reference point of § 659 (1)";
}
pub relation gewinnzusage_an_verbraucher(al: Auslobung, unternehmer: Person, verbraucher: Person, preis: Money) kind empirical {
    label de official "Ein Unternehmer sendet einem Verbraucher eine Gewinnzusage oder vergleichbare Mitteilung und erweckt durch die Gestaltung den Eindruck, dass der Verbraucher einen Preis gewonnen hat (§ 661a)";
    label en unofficial "a trader sends a consumer a prize notification or comparable communication and, by its presentation, creates the impression that the consumer has won a prize (§ 661a)";
}
pub relation anspruch_auf_den_preis_661a(unternehmer: Person, verbraucher: Person, preis: Money) kind institutional {
    label de official "Der Unternehmer hat dem Verbraucher den Preis zu leisten (§ 661a)";
    label en unofficial "the trader must give the consumer the prize (§ 661a)";
}

@source(BGB_P657)
rule BindendesVersprechen(al: Auslobung, p: Person, betrag: Money, tag: Date) strict {
    label de official "Wer durch öffentliche Bekanntmachung eine Belohnung für die Vornahme einer Handlung aussetzt, ist verpflichtet, die Belohnung demjenigen zu entrichten, welcher die Handlung vorgenommen hat, auch wenn dieser nicht mit Rücksicht auf die Auslobung gehandelt hat (§ 657)";
    label en unofficial "a person who by public notice offers a reward for the performance of an act must pay the reward to the person who performed it, even where that person did not act with a view to the promise (§ 657)";
    when belohnung_oeffentlich_ausgesetzt(al, betrag) and handlung_vorgenommen_am(al, p, tag)
        and frueheste_vornahme_am(al, tag) and not_known(auslobung_wirksam_widerrufen(al));
    then anspruch_auf_belohnung(al, p, betrag);
}
pub relation belohnung_657_entrichtet_am(al: Auslobung, p: Person, betrag: Money, tag: Date) kind empirical {
    label de official "Der Auslobende hat die Belohnung entrichtet (§ 657)";
    label en unofficial "the promisor paid the reward (§ 657)";
}
pub relation belohnungspflicht_657_beginn_am(al: Auslobung, tag: Date) kind empirical {
    label de official "Beginn der Belohnungspflicht nach § 657";
    label en unofficial "start of the reward duty under § 657";
}
@source(BGB_P657)
rule Position657Belohnung(al: Auslobung, p: Person, betrag: Money, beginn: Date) strict {
    label de official "Der Auslobende ist verpflichtet, dem Handelnden die Belohnung zu entrichten (§ 657)";
    label en unofficial "The promisor is obliged to pay the reward to the person who performed the act (§ 657)";
    when belohnung_oeffentlich_ausgesetzt(al, betrag) and handlung_vorgenommen_am(al, p, beginn)
     and belohnungspflicht_657_beginn_am(al, beginn);
    then duty Duty657Belohnung {
        bearer al;
        beneficiary p;
        achieve belohnung_657_entrichtet_am(al, p, betrag, beginn) during [beginn, infinity);
    };
}
@source(BGB_P659)
rule FruehesteVornahme(al: Auslobung, p: Person, tag: Date) strict {
    label de official "Ist die Handlung, für welche die Belohnung ausgesetzt ist, mehrmals vorgenommen worden, so gebührt die Belohnung demjenigen, welcher die Handlung zuerst vorgenommen hat (§ 659 Absatz 1)";
    label en unofficial "where the act for which the reward was offered has been performed several times, the reward is due to the person who performed it first (§ 659 (1))";
    when handlung_vorgenommen_am(al, p, tag);
    then frueheste_vornahme_am(al, (min all t: Date for q: Person where handlung_vorgenommen_am(al, q, t)));
}
@source(BGB_P661a)
rule Gewinnzusage661a(al: Auslobung, unternehmer: Person, verbraucher: Person, preis: Money) strict {
    label de official "Ein Unternehmer, der Gewinnzusagen oder vergleichbare Mitteilungen an Verbraucher sendet und durch die Gestaltung dieser Zusendungen den Eindruck erweckt, dass der Verbraucher einen Preis gewonnen hat, hat dem Verbraucher diesen Preis zu leisten (§ 661a)";
    label en unofficial "a trader who sends consumers prize notifications or comparable communications and by their presentation creates the impression that the consumer has won a prize must give the consumer that prize (§ 661a)";
    when gewinnzusage_an_verbraucher(al, unternehmer, verbraucher, preis);
    then anspruch_auf_den_preis_661a(unternehmer, verbraucher, preis);
}
pub relation unternehmer_661a(al: Auslobung, p: Person) kind empirical {
    label de official "Unternehmer nach § 661a";
    label en unofficial "trader under § 661a";
}
pub relation preis_661a_geleistet_am(al: Auslobung, tag: Date) kind empirical {
    label de official "Der Unternehmer hat den zugesagten Preis geleistet (§ 661a)";
    label en unofficial "the trader delivered the promised prize (§ 661a)";
}
pub relation leistungspflicht_661a_beginn_am(al: Auslobung, tag: Date) kind empirical {
    label de official "Beginn der Leistungspflicht nach § 661a";
    label en unofficial "start of the performance duty under § 661a";
}
@source(BGB_P661a)
rule Position661aGewinnzusage(al: Auslobung, p: Person, beginn: Date) strict {
    label de official "Der Unternehmer ist verpflichtet, dem Verbraucher den zugesagten Preis zu leisten (§ 661a)";
    label en unofficial "The trader is obliged to give the consumer the promised prize (§ 661a)";
    when unternehmer_661a(al, p) and leistungspflicht_661a_beginn_am(al, beginn);
    then duty Duty661aGewinnzusage {
        bearer p;
        achieve preis_661a_geleistet_am(al, beginn) during [beginn, infinity);
    };
}

// §§ 658, 660, 661 (D-08-24): Widerruf der Auslobung vor Vornahme mit
// Formerfordernis (§ 658 Absatz 1), Verweigerungsrecht bei nicht anerkannter
// Verteilung (§ 660 Absatz 2 — Absatz 1 bleibt Grenze: Verteilung nach
// billigem Ermessen ist eine gerichtliche Wertung ohne im Text genannten
// Anhaltspunkt, Kanal §47.3, hier nicht als eigenes Prädikat modelliert, um
// den Verweigerungsrecht-Mechanismus nicht an eine unspezifizierte
// Ermessensentscheidung zu koppeln), Gültigkeit des Preisausschreibens nur
// bei bestimmter Bewerbungsfrist und die Eigentumsübertragung nur bei
// ausdrücklicher Bestimmung (§ 661 Absatz 1, 4).
pub relation widerruf_der_auslobung_erklaert_658(al: Auslobung) kind empirical {
    label de official "Der Auslobende hat die Auslobung vor Vornahme der Handlung widerrufen (§ 658 Absatz 1 Satz 1)";
    label en unofficial "the promisor has revoked the promise before performance of the act (§ 658 (1) sentence 1)";
}
pub relation widerruf_658_formgerecht_bekannt_gemacht(al: Auslobung) kind empirical {
    label de official "Der Widerruf ist in derselben Weise wie die Auslobung bekannt gemacht worden oder durch besondere Mitteilung erfolgt (§ 658 Absatz 1 Satz 2)";
    label en unofficial "the revocation was made known in the same manner as the promise, or by special notice (§ 658 (1) sentence 2)";
}
pub relation widerruf_658_wirksam(al: Auslobung) kind institutional {
    label de official "Der Widerruf der Auslobung ist wirksam (§ 658 Absatz 1)";
    label en unofficial "the revocation of the promise is effective (§ 658 (1))";
}
@source(BGB_P658)
rule Widerruf658WirksamBeiForm(al: Auslobung) strict {
    label de official "Die Auslobung kann bis zur Vornahme der Handlung widerrufen werden; der Widerruf ist nur wirksam, wenn er in derselben Weise wie die Auslobung bekannt gemacht wird oder durch besondere Mitteilung erfolgt (§ 658 Absatz 1)";
    label en unofficial "the promise may be revoked before performance of the act; revocation is effective only if made known in the same manner as the promise or by special notice (§ 658 (1))";
    when widerruf_der_auslobung_erklaert_658(al) and widerruf_658_formgerecht_bekannt_gemacht(al)
        and not_known(auf_widerruflichkeit_verzichtet(al));
    then widerruf_658_wirksam(al);
}
pub relation widerruf_658_ausgeuebt_am(al: Auslobung, tag: Date) kind empirical {
    label de official "Der Auslobende hat die Auslobung widerrufen (§ 658)";
    label en unofficial "the promisor exercised revocation (§ 658)";
}
pub relation auslobender(al: Auslobung, p: Person) kind empirical {
    label de official "Auslobender nach § 658";
    label en unofficial "promisor under § 658";
}
pub relation widerrufsrecht_658_beginn_am(al: Auslobung, tag: Date) kind empirical {
    label de official "Beginn des Widerrufsrechts nach § 658";
    label en unofficial "start of revocation right under § 658";
}
@source(BGB_P658)
rule Position658Widerruf(al: Auslobung, p: Person, beginn: Date) strict {
    label de official "Der Auslobende ist berechtigt, die Auslobung vor der Handlung zu widerrufen (§ 658)";
    label en unofficial "The promisor has the liberty to revoke the promise before performance (§ 658)";
    when auslobender(al, p) and widerrufsrecht_658_beginn_am(al, beginn);
    then liberty Liberty658Widerruf {
        holder p;
        action widerruf_658_ausgeuebt_am(al, beginn);
        window [beginn, infinity];
    };
}

pub relation verteilung_des_auslobenden_nicht_anerkannt_660(al: Auslobung) kind empirical {
    label de official "Die Verteilung der Belohnung durch den Auslobenden wird von einem der Beteiligten nicht als verbindlich anerkannt (§ 660 Absatz 2 Satz 1)";
    label en unofficial "the distribution of the reward made by the promisor is not accepted as binding by one of those involved (§ 660 (2) sentence 1)";
}
pub relation streit_ueber_berechtigung_660_beigelegt(al: Auslobung) kind empirical {
    label de official "Die Beteiligten haben den Streit über ihre Berechtigung unter sich ausgetragen (§ 660 Absatz 2 Satz 1)";
    label en unofficial "those involved have settled the dispute about their entitlement among themselves (§ 660 (2) sentence 1)";
}
pub relation erfuellung_660_verweigerbar(al: Auslobung) kind institutional {
    label de official "Der Auslobende ist berechtigt, die Erfüllung zu verweigern, bis die Beteiligten den Streit über ihre Berechtigung unter sich ausgetragen haben (§ 660 Absatz 2 Satz 1)";
    label en unofficial "the promisor is entitled to refuse performance until those involved have settled the dispute about their entitlement among themselves (§ 660 (2) sentence 1)";
}
@source(BGB_P660)
rule Erfuellung660VerweigerbarBeiNichtanerkennung(al: Auslobung) strict {
    label de official "Wird die Verteilung des Auslobenden von einem der Beteiligten nicht als verbindlich anerkannt, so ist der Auslobende berechtigt, die Erfüllung zu verweigern, bis die Beteiligten den Streit über ihre Berechtigung unter sich ausgetragen haben (§ 660 Absatz 2 Satz 1)";
    label en unofficial "where the promisor's distribution is not accepted as binding by one of those involved, the promisor may refuse performance until those involved have settled the dispute about their entitlement among themselves (§ 660 (2) sentence 1)";
    when verteilung_des_auslobenden_nicht_anerkannt_660(al) and not_known(streit_ueber_berechtigung_660_beigelegt(al));
    then erfuellung_660_verweigerbar(al);
}

pub relation auslobung_hat_preisbewerbung_zum_gegenstand_661(al: Auslobung) kind empirical {
    label de official "Die Auslobung hat eine Preisbewerbung zum Gegenstand (§ 661 Absatz 1)";
    label en unofficial "the promise has a prize competition as its subject matter (§ 661 (1))";
}
pub relation frist_fuer_bewerbung_bestimmt_661(al: Auslobung) kind empirical {
    label de official "In der Bekanntmachung ist eine Frist für die Bewerbung bestimmt (§ 661 Absatz 1)";
    label en unofficial "the notice fixes a period for entries (§ 661 (1))";
}
pub relation preisausschreiben_661_gueltig(al: Auslobung) kind institutional {
    label de official "Das Preisausschreiben ist gültig (§ 661 Absatz 1)";
    label en unofficial "the prize competition is valid (§ 661 (1))";
}
pub relation uebertragung_des_eigentums_661_bestimmt(al: Auslobung) kind empirical {
    label de official "Der Auslobende hat in der Auslobung bestimmt, dass die Übertragung des Eigentums an dem Werk erfolgen soll (§ 661 Absatz 4)";
    label en unofficial "the promisor has specified in the promise that ownership of the work is to be transferred (§ 661 (4))";
}
pub relation anspruch_auf_eigentumsuebertragung_661(al: Auslobung) kind institutional {
    label de official "Der Auslobende kann die Übertragung des Eigentums an dem Werk verlangen (§ 661 Absatz 4)";
    label en unofficial "the promisor may demand transfer of ownership of the work (§ 661 (4))";
}
@source(BGB_P661) {
    rule Preisausschreiben661GueltigMitFrist(al: Auslobung) strict {
        label de official "Eine Auslobung, die eine Preisbewerbung zum Gegenstand hat, ist nur gültig, wenn in der Bekanntmachung eine Frist für die Bewerbung bestimmt wird (§ 661 Absatz 1)";
        label en unofficial "a promise having a prize competition as its subject matter is valid only if the notice fixes a period for entries (§ 661 (1))";
        when auslobung_hat_preisbewerbung_zum_gegenstand_661(al) and frist_fuer_bewerbung_bestimmt_661(al);
        then preisausschreiben_661_gueltig(al);
    }
    rule AnspruchAufEigentumsuebertragung661(al: Auslobung) strict {
        label de official "Die Übertragung des Eigentums an dem Werk kann der Auslobende nur verlangen, wenn er in der Auslobung bestimmt hat, dass die Übertragung erfolgen soll (§ 661 Absatz 4)";
        label en unofficial "the promisor may demand transfer of ownership of the work only where the promise specifies that the transfer is to take place (§ 661 (4))";
        when uebertragung_des_eigentums_661_bestimmt(al);
        then anspruch_auf_eigentumsuebertragung_661(al);
    }
}

// ==================================================================================================
// TITEL 13 — GESCHÄFTSFÜHRUNG OHNE AUFTRAG (§§ 677–687)
// ==================================================================================================

pub entity Geschaeftsfuehrung {
    label de official "Geschäftsführung ohne Auftrag (§ 677)";
    label en unofficial "benevolent intervention in another's affairs (§ 677)";
}
pub relation geschaeftsfuehrer(gf: Geschaeftsfuehrung, p: Person) kind empirical {
    key(gf);
    label de official "Geschäftsführer: wer ein Geschäft für einen anderen besorgt, ohne von ihm beauftragt oder ihm gegenüber sonst dazu berechtigt zu sein (§ 677)";
    label en unofficial "intervener: a person who attends to another's business without being mandated by him or otherwise entitled to do so (§ 677)";
}
pub relation geschaeftsherr(gf: Geschaeftsfuehrung, p: Person) kind empirical {
    key(gf);
    label de official "Geschäftsherr (§ 677)";
    label en unofficial "principal (§ 677)";
}
pub relation geschaeft_fuer_einen_anderen_besorgt(gf: Geschaeftsfuehrung) kind empirical {
    label de official "Der Geschäftsführer besorgt ein Geschäft für einen anderen, ohne von ihm beauftragt oder sonst dazu berechtigt zu sein (§ 677)";
    label en unofficial "the intervener attends to another's business without being mandated or otherwise entitled (§ 677)";
}
@source(BGB_P683)
pub external judgment relation uebernahme_entspricht_interesse_und_willen(gf: Geschaeftsfuehrung) {
    authority Court;
    label de official "Die Übernahme der Geschäftsführung entspricht dem Interesse und dem wirklichen oder dem mutmaßlichen Willen des Geschäftsherrn (§ 683 Satz 1)";
    label en unofficial "the assumption of the intervention accords with the principal's interest and his actual or presumed intention (§ 683 sentence 1)";
}
pub relation oeffentliches_interesse_oder_unterhaltspflicht_679(gf: Geschaeftsfuehrung) kind empirical {
    label de official "Ohne die Geschäftsführung würde eine Pflicht des Geschäftsherrn, deren Erfüllung im öffentlichen Interesse liegt, oder eine gesetzliche Unterhaltspflicht nicht rechtzeitig erfüllt werden (§ 679)";
    label en unofficial "without the intervention a duty of the principal whose performance is in the public interest, or a statutory maintenance obligation, would not be performed in time (§ 679)";
}
pub relation aufwendung_des_geschaeftsfuehrers(gf: Geschaeftsfuehrung, betrag: Money) kind empirical {
    key(gf);
    label de official "Aufwendung des Geschäftsführers (§ 683 Satz 1, § 670)";
    label en unofficial "the intervener's expense (§ 683 sentence 1, § 670)";
}
pub relation keine_ersatzabsicht(gf: Geschaeftsfuehrung) kind empirical {
    label de official "Der Geschäftsführer hatte nicht die Absicht, von dem Geschäftsherrn Ersatz zu verlangen (§ 685 Absatz 1)";
    label en unofficial "the intervener did not intend to claim reimbursement from the principal (§ 685 (1))";
}
pub relation aufwendungsersatz_683(gf: Geschaeftsfuehrung, betrag: Money) kind institutional {
    label de official "Der Geschäftsführer kann wie ein Beauftragter Ersatz seiner Aufwendungen verlangen (§ 683 Satz 1)";
    label en unofficial "the intervener may claim reimbursement of his expenses like a mandatary (§ 683 sentence 1)";
}
pub relation uebernahme_widerspricht_dem_willen(gf: Geschaeftsfuehrung) kind empirical {
    label de official "Die Übernahme der Geschäftsführung steht mit dem wirklichen oder dem mutmaßlichen Willen des Geschäftsherrn in Widerspruch und der Geschäftsführer musste dies erkennen (§ 678)";
    label en unofficial "the assumption of the intervention conflicts with the principal's actual or presumed intention and the intervener had to recognise this (§ 678)";
}
pub relation schadensersatzpflicht_678(gf: Geschaeftsfuehrung) kind institutional {
    label de official "Der Geschäftsführer ist dem Geschäftsherrn zum Ersatz des aus der Geschäftsführung entstehenden Schadens auch dann verpflichtet, wenn ihm ein sonstiges Verschulden nicht zur Last fällt (§ 678)";
    label en unofficial "the intervener must compensate the principal for the damage arising from the intervention even where no other fault is attributable to him (§ 678)";
}
pub relation gefahrabwendung_bezweckt(gf: Geschaeftsfuehrung) kind empirical {
    label de official "Die Geschäftsführung bezweckt die Abwendung einer dem Geschäftsherrn drohenden dringenden Gefahr (§ 680)";
    label en unofficial "the intervention is intended to avert an imminent danger threatening the principal (§ 680)";
}
pub relation haftung_nur_vorsatz_und_grobe_fahrlaessigkeit_680(gf: Geschaeftsfuehrung) kind institutional {
    label de official "Der Geschäftsführer hat nur Vorsatz und grobe Fahrlässigkeit zu vertreten (§ 680)";
    label en unofficial "the intervener is responsible only for intent and gross negligence (§ 680)";
}
pub relation eigengeschaeftsfuehrung_in_gutem_glauben(gf: Geschaeftsfuehrung) kind empirical {
    label de official "Jemand besorgt ein fremdes Geschäft in der Meinung, dass es sein eigenes sei (§ 687 Absatz 1)";
    label en unofficial "a person attends to another's business believing it to be his own (§ 687 (1))";
}
pub relation vorschriften_677_bis_686_nicht_anwendbar(gf: Geschaeftsfuehrung) kind institutional {
    label de official "Die Vorschriften der §§ 677 bis 686 finden keine Anwendung (§ 687 Absatz 1)";
    label en unofficial "§§ 677 to 686 do not apply (§ 687 (1))";
}

@source(BGB_P678)
rule GeschaeftsfuehrungGegenDenWillen(gf: Geschaeftsfuehrung) strict {
    label de official "Steht die Übernahme der Geschäftsführung mit dem wirklichen oder dem mutmaßlichen Willen des Geschäftsherrn in Widerspruch und musste der Geschäftsführer dies erkennen, so ist er dem Geschäftsherrn zum Ersatz des aus der Geschäftsführung entstehenden Schadens auch dann verpflichtet, wenn ihm ein sonstiges Verschulden nicht zur Last fällt (§ 678)";
    label en unofficial "where the assumption of the intervention conflicts with the principal's actual or presumed intention and the intervener had to recognise this, he must compensate the principal for the resulting damage even absent other fault (§ 678)";
    when geschaeft_fuer_einen_anderen_besorgt(gf) and uebernahme_widerspricht_dem_willen(gf)
        and not_known(oeffentliches_interesse_oder_unterhaltspflicht_679(gf));
    then schadensersatzpflicht_678(gf);
}
@source(BGB_P680)
rule GeschaeftsfuehrungZurGefahrenabwehr(gf: Geschaeftsfuehrung) strict {
    label de official "Bezweckt die Geschäftsführung die Abwendung einer dem Geschäftsherrn drohenden dringenden Gefahr, so hat der Geschäftsführer nur Vorsatz und grobe Fahrlässigkeit zu vertreten (§ 680)";
    label en unofficial "where the intervention is intended to avert an imminent danger threatening the principal, the intervener is responsible only for intent and gross negligence (§ 680)";
    when geschaeft_fuer_einen_anderen_besorgt(gf) and gefahrabwendung_bezweckt(gf);
    then haftung_nur_vorsatz_und_grobe_fahrlaessigkeit_680(gf);
}
pub relation geschaeftsfuehrer_680(gf: Geschaeftsfuehrung, p: Person) kind empirical {
    label de official "Geschäftsführer nach § 680";
    label en unofficial "intervener under § 680";
}
pub relation haftungsbegrenzung_680_berufen_am(gf: Geschaeftsfuehrung, tag: Date) kind empirical {
    label de official "Der Geschäftsführer hat sich auf die Haftungsbegrenzung berufen (§ 680)";
    label en unofficial "the intervener invoked the limitation of liability (§ 680)";
}
pub relation haftungsbeginn_680_am(gf: Geschaeftsfuehrung, tag: Date) kind empirical {
    label de official "Beginn der Haftungsbegrenzung nach § 680";
    label en unofficial "start of the limitation of liability under § 680";
}
@source(BGB_P680)
rule Position680Haftung(gf: Geschaeftsfuehrung, p: Person, beginn: Date) strict {
    label de official "Der Geschäftsführer ist berechtigt, sich bei Gefahrenabwehr auf Vorsatz und grobe Fahrlässigkeit zu berufen (§ 680)";
    label en unofficial "The intervener has the liberty to invoke the intent and gross negligence standard in averting danger (§ 680)";
    when geschaeftsfuehrer_680(gf, p) and geschaeft_fuer_einen_anderen_besorgt(gf)
     and gefahrabwendung_bezweckt(gf) and haftungsbeginn_680_am(gf, beginn);
    then liberty Liberty680Haftung {
        holder p;
        action haftungsbegrenzung_680_berufen_am(gf, beginn);
        window [beginn, infinity);
    };
}
@source(BGB_P683) {
    rule AufwendungsersatzBeiInteressengemaesserUebernahme(gf: Geschaeftsfuehrung, betrag: Money) strict {
        label de official "Entspricht die Übernahme der Geschäftsführung dem Interesse und dem wirklichen oder dem mutmaßlichen Willen des Geschäftsherrn, so kann der Geschäftsführer wie ein Beauftragter Ersatz seiner Aufwendungen verlangen (§ 683 Satz 1)";
        label en unofficial "where the assumption of the intervention accords with the principal's interest and actual or presumed intention, the intervener may claim reimbursement of his expenses like a mandatary (§ 683 sentence 1)";
        when geschaeft_fuer_einen_anderen_besorgt(gf) and uebernahme_entspricht_interesse_und_willen(gf)
            and aufwendung_des_geschaeftsfuehrers(gf, betrag) and not_known(keine_ersatzabsicht(gf));
        then aufwendungsersatz_683(gf, betrag);
    }
    rule AufwendungsersatzTrotzEntgegenstehendenWillens(gf: Geschaeftsfuehrung, betrag: Money) strict {
        label de official "In den Fällen des § 679 steht der Anspruch dem Geschäftsführer zu, auch wenn die Übernahme der Geschäftsführung mit dem Willen des Geschäftsherrn in Widerspruch steht (§ 683 Satz 2)";
        label en unofficial "in the cases of § 679 the claim accrues to the intervener even where the assumption of the intervention conflicts with the principal's intention (§ 683 sentence 2)";
        when geschaeft_fuer_einen_anderen_besorgt(gf) and oeffentliches_interesse_oder_unterhaltspflicht_679(gf)
            and aufwendung_des_geschaeftsfuehrers(gf, betrag) and not_known(keine_ersatzabsicht(gf));
        then aufwendungsersatz_683(gf, betrag);
    }
}
@source(BGB_P687)
rule UnechteGeschaeftsfuehrung(gf: Geschaeftsfuehrung) strict {
    label de official "Die Vorschriften der §§ 677 bis 686 finden keine Anwendung, wenn jemand ein fremdes Geschäft in der Meinung besorgt, dass es sein eigenes sei (§ 687 Absatz 1)";
    label en unofficial "§§ 677 to 686 do not apply where a person attends to another's business believing it to be his own (§ 687 (1))";
    when eigengeschaeftsfuehrung_in_gutem_glauben(gf);
    then vorschriften_677_bis_686_nicht_anwendbar(gf);
}

// §§ 677, 679, 681, 682, 684, 685, 686 (D-08-25): die restlichen Pflichten
// und Vermutungen der Geschäftsführung ohne Auftrag.
pub relation pflichtgemaesse_geschaeftsfuehrung_geschuldet_677(gf: Geschaeftsfuehrung) kind institutional {
    label de official "Der Geschäftsführer hat das Geschäft so zu führen, wie das Interesse des Geschäftsherrn mit Rücksicht auf dessen wirklichen oder mutmaßlichen Willen es erfordert (§ 677)";
    label en unofficial "the intervener must conduct the business as the principal's interest, having regard to his actual or presumed intention, requires (§ 677)";
}
@source(BGB_P677)
rule PflichtgemaesseGeschaeftsfuehrung677(gf: Geschaeftsfuehrung) strict {
    label de official "Wer ein Geschäft für einen anderen besorgt, ohne von ihm beauftragt oder ihm gegenüber sonst dazu berechtigt zu sein, hat das Geschäft so zu führen, wie das Interesse des Geschäftsherrn mit Rücksicht auf dessen wirklichen oder mutmaßlichen Willen es erfordert (§ 677)";
    label en unofficial "a person who attends to another's business without being mandated or otherwise entitled must conduct it as the principal's interest, having regard to his actual or presumed intention, requires (§ 677)";
    when geschaeft_fuer_einen_anderen_besorgt(gf);
    then pflichtgemaesse_geschaeftsfuehrung_geschuldet_677(gf);
}
pub relation geschaeftsfuehrung_ordentlich_am(gf: Geschaeftsfuehrung, tag: Date) kind empirical {
    label de official "Der Geschäftsführer hat das Geschäft pflichtgemäß geführt (§ 677)";
    label en unofficial "the intervener conducted the business properly (§ 677)";
}
pub relation geschaeftsfuehrung_beginn_am(gf: Geschaeftsfuehrung, tag: Date) kind empirical {
    label de official "Beginn der Geschäftsführung ohne Auftrag (§§ 677, 681)";
    label en unofficial "start of management without mandate (§§ 677, 681)";
}
@source(BGB_P677)
rule Position677PflichtgemaesseGeschaeftsfuehrung(gf: Geschaeftsfuehrung, p: Person, beginn: Date) strict {
    label de official "Der Geschäftsführer ist verpflichtet, das Geschäft pflichtgemäß zu führen (§ 677)";
    label en unofficial "The intervener is obliged to conduct the business properly (§ 677)";
    when geschaeft_fuer_einen_anderen_besorgt(gf) and geschaeftsfuehrer(gf, p)
     and geschaeftsfuehrung_beginn_am(gf, beginn);
    then duty Duty677PflichtgemaesseGeschaeftsfuehrung {
        bearer p;
        achieve geschaeftsfuehrung_ordentlich_am(gf, beginn) during [beginn, infinity);
    };
}

pub relation entgegenstehender_wille_679_unbeachtlich(gf: Geschaeftsfuehrung) kind institutional {
    label de official "Ein der Geschäftsführung entgegenstehender Wille des Geschäftsherrn kommt nicht in Betracht (§ 679)";
    label en unofficial "an intention of the principal opposing the intervention is disregarded (§ 679)";
}
@source(BGB_P679)
rule EntgegenstehenderWille679Unbeachtlich(gf: Geschaeftsfuehrung) strict {
    label de official "Ein der Geschäftsführung entgegenstehender Wille des Geschäftsherrn kommt nicht in Betracht, wenn ohne die Geschäftsführung eine Pflicht des Geschäftsherrn, deren Erfüllung im öffentlichen Interesse liegt, oder eine gesetzliche Unterhaltspflicht nicht rechtzeitig erfüllt werden würde (§ 679)";
    label en unofficial "an opposing intention of the principal is disregarded where, without the intervention, a duty of the principal whose performance is in the public interest, or a statutory maintenance obligation, would not be performed in time (§ 679)";
    when oeffentliches_interesse_oder_unterhaltspflicht_679(gf);
    then entgegenstehender_wille_679_unbeachtlich(gf);
}

pub relation anzeigepflicht_681(gf: Geschaeftsfuehrung, p: Person) kind institutional {
    label de official "Der Geschäftsführer hat die Übernahme der Geschäftsführung dem Geschäftsherrn anzuzeigen (§ 681 Satz 1)";
    label en unofficial "the intervener must notify the principal of the assumption of the intervention (§ 681 sentence 1)";
}
pub relation auftragsrecht_666_668_entsprechend_681(gf: Geschaeftsfuehrung) kind institutional {
    label de official "Auf die Verpflichtungen des Geschäftsführers finden die für einen Beauftragten geltenden Vorschriften der §§ 666 bis 668 entsprechende Anwendung (§ 681 Satz 2)";
    label en unofficial "the intervener's obligations are governed correspondingly by §§ 666 to 668, which apply to a mandatary (§ 681 sentence 2)";
}
@source(BGB_P681) {
    rule Anzeigepflicht681(gf: Geschaeftsfuehrung, p: Person) strict {
        label de official "Der Geschäftsführer hat die Übernahme der Geschäftsführung, sobald es tunlich ist, dem Geschäftsherrn anzuzeigen (§ 681 Satz 1)";
        label en unofficial "the intervener must, as soon as practicable, notify the principal of the assumption of the intervention (§ 681 sentence 1)";
        when geschaeft_fuer_einen_anderen_besorgt(gf) and geschaeftsherr(gf, p);
        then anzeigepflicht_681(gf, p);
    }
    rule Auftragsrecht666668Entsprechend681(gf: Geschaeftsfuehrung) strict {
        label de official "Im Übrigen finden auf die Verpflichtungen des Geschäftsführers die für einen Beauftragten geltenden Vorschriften der §§ 666 bis 668 entsprechende Anwendung (§ 681 Satz 2)";
        label en unofficial "otherwise the intervener's obligations are governed correspondingly by §§ 666 to 668, which apply to a mandatary (§ 681 sentence 2)";
        when geschaeft_fuer_einen_anderen_besorgt(gf);
        then auftragsrecht_666_668_entsprechend_681(gf);
    }
}
pub relation anzeige_681_erfolgt_am(gf: Geschaeftsfuehrung, tag: Date) kind empirical {
    label de official "Der Geschäftsführer hat die Übernahme angezeigt (§ 681)";
    label en unofficial "the intervener notified the assumption (§ 681)";
}
@source(BGB_P681)
rule Position681Anzeige(gf: Geschaeftsfuehrung, p: Person, beginn: Date) strict {
    label de official "Der Geschäftsführer ist verpflichtet, die Übernahme der Geschäftsführung anzuzeigen (§ 681 Satz 1)";
    label en unofficial "The intervener is obliged to notify the assumption of the intervention (§ 681 sentence 1)";
    when geschaeft_fuer_einen_anderen_besorgt(gf) and geschaeftsfuehrer(gf, p)
     and geschaeftsfuehrung_beginn_am(gf, beginn);
    then duty Duty681Anzeige {
        bearer p;
        achieve anzeige_681_erfolgt_am(gf, beginn) during [beginn, infinity);
    };
}

pub relation geschaeftsfuehrer_geschaeftsunfaehig_oder_beschraenkt_682(gf: Geschaeftsfuehrung) kind empirical {
    label de official "Der Geschäftsführer ist geschäftsunfähig oder in der Geschäftsfähigkeit beschränkt (§ 682)";
    label en unofficial "the intervener lacks capacity to contract or has limited capacity (§ 682)";
}
pub relation haftung_682_beschraenkt_auf_delikt_und_bereicherung(gf: Geschaeftsfuehrung) kind institutional {
    label de official "Der Geschäftsführer ist nur nach den Vorschriften über den Schadensersatz wegen unerlaubter Handlungen und über die Herausgabe einer ungerechtfertigten Bereicherung verantwortlich (§ 682)";
    label en unofficial "the intervener is liable only under the rules on damages for tort and on the return of unjust enrichment (§ 682)";
}
@source(BGB_P682)
rule Haftung682BeiFehlenderGeschaeftsfaehigkeit(gf: Geschaeftsfuehrung) strict {
    label de official "Ist der Geschäftsführer geschäftsunfähig oder in der Geschäftsfähigkeit beschränkt, so ist er nur nach den Vorschriften über den Schadensersatz wegen unerlaubter Handlungen und über die Herausgabe einer ungerechtfertigten Bereicherung verantwortlich (§ 682)";
    label en unofficial "where the intervener lacks capacity to contract or has limited capacity, he is liable only under the rules on damages for tort and on the return of unjust enrichment (§ 682)";
    when geschaeftsfuehrer_geschaeftsunfaehig_oder_beschraenkt_682(gf);
    then haftung_682_beschraenkt_auf_delikt_und_bereicherung(gf);
}

pub relation geschaeftsherr_genehmigt_684(gf: Geschaeftsfuehrung) kind empirical {
    label de official "Der Geschäftsherr genehmigt die Geschäftsführung (§ 684 Satz 2)";
    label en unofficial "the principal ratifies the intervention (§ 684 sentence 2)";
}
pub relation herausgabepflicht_684(gf: Geschaeftsfuehrung) kind institutional {
    label de official "Der Geschäftsherr ist verpflichtet, dem Geschäftsführer alles, was er durch die Geschäftsführung erlangt, nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung herauszugeben (§ 684 Satz 1)";
    label en unofficial "the principal must return to the intervener everything obtained through the intervention under the rules on unjust enrichment (§ 684 sentence 1)";
}
@source(BGB_P684) {
    rule Herausgabepflicht684OhneVoraussetzungenDes683(gf: Geschaeftsfuehrung) strict {
        label de official "Liegen die Voraussetzungen des § 683 nicht vor, so ist der Geschäftsherr verpflichtet, dem Geschäftsführer alles, was er durch die Geschäftsführung erlangt, nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung herauszugeben (§ 684 Satz 1)";
        label en unofficial "where the requirements of § 683 are not met, the principal must return to the intervener everything obtained through the intervention under the rules on unjust enrichment (§ 684 sentence 1)";
        when geschaeft_fuer_einen_anderen_besorgt(gf) and not_known(uebernahme_entspricht_interesse_und_willen(gf))
            and not_known(oeffentliches_interesse_oder_unterhaltspflicht_679(gf));
        then herausgabepflicht_684(gf);
    }
    rule Aufwendungsersatz684NachGenehmigung(gf: Geschaeftsfuehrung, betrag: Money) strict {
        label de official "Genehmigt der Geschäftsherr die Geschäftsführung, so steht dem Geschäftsführer der in § 683 bestimmte Anspruch zu (§ 684 Satz 2)";
        label en unofficial "where the principal ratifies the intervention, the intervener has the claim provided for in § 683 (§ 684 sentence 2)";
        when geschaeftsherr_genehmigt_684(gf) and aufwendung_des_geschaeftsfuehrers(gf, betrag) and not_known(keine_ersatzabsicht(gf));
        then aufwendungsersatz_683(gf, betrag);
    }
}
pub relation herausgabe_684_erfolgt_am(gf: Geschaeftsfuehrung, tag: Date) kind empirical {
    label de official "Der Geschäftsherr hat das Erlangte herausgegeben (§ 684)";
    label en unofficial "the principal returned what was obtained (§ 684)";
}
@source(BGB_P684)
rule Position684Herausgabe(gf: Geschaeftsfuehrung, p: Person, beginn: Date) strict {
    label de official "Der Geschäftsherr ist verpflichtet, das durch die Geschäftsführung Erlangte herauszugeben (§ 684 Satz 1)";
    label en unofficial "The principal is obliged to return what was obtained through the intervention (§ 684 sentence 1)";
    when geschaeft_fuer_einen_anderen_besorgt(gf) and geschaeftsherr(gf, p)
     and not_known(uebernahme_entspricht_interesse_und_willen(gf))
     and not_known(oeffentliches_interesse_oder_unterhaltspflicht_679(gf))
     and geschaeftsfuehrung_beginn_am(gf, beginn);
    then duty Duty684Herausgabe {
        bearer p;
        achieve herausgabe_684_erfolgt_am(gf, beginn) during [beginn, infinity);
    };
}

pub relation eltern_oder_voreltern_gewaehren_abkoemmlingen_unterhalt_685(gf: Geschaeftsfuehrung) kind empirical {
    label de official "Eltern oder Voreltern gewähren ihren Abkömmlingen oder diese jenen Unterhalt (§ 685 Absatz 2)";
    label en unofficial "parents or ascendants provide maintenance to their descendants, or vice versa (§ 685 (2))";
}
pub relation ersatzabsicht_685_ausdruecklich_nachgewiesen(gf: Geschaeftsfuehrung) kind empirical {
    label de official "Die Absicht, von dem Empfänger Ersatz zu verlangen, ist nachgewiesen (§ 685 Absatz 2)";
    label en unofficial "the intention to claim reimbursement from the recipient has been proven (§ 685 (2))";
}
@source(BGB_P685)
rule KeineErsatzabsichtVermutetBeiUnterhaltsgewaehrung685(gf: Geschaeftsfuehrung) strict {
    label de official "Gewähren Eltern oder Voreltern ihren Abkömmlingen oder diese jenen Unterhalt, so ist im Zweifel anzunehmen, dass die Absicht fehlt, von dem Empfänger Ersatz zu verlangen (§ 685 Absatz 2)";
    label en unofficial "where parents or ascendants provide maintenance to their descendants, or vice versa, it is presumed, in case of doubt, that there is no intention to claim reimbursement from the recipient (§ 685 (2))";
    when eltern_oder_voreltern_gewaehren_abkoemmlingen_unterhalt_685(gf) and not_known(ersatzabsicht_685_ausdruecklich_nachgewiesen(gf));
    then keine_ersatzabsicht(gf);
}

pub relation geschaeftsfuehrer_im_irrtum_ueber_geschaeftsherrn_686(gf: Geschaeftsfuehrung, p: Person) kind empirical {
    label de official "Der Geschäftsführer ist über die Person des Geschäftsherrn im Irrtum; wirklicher Geschäftsherr (§ 686)";
    label en unofficial "the intervener is mistaken about the identity of the principal; the actual principal (§ 686)";
}
pub relation wirklicher_geschaeftsherr_berechtigt_und_verpflichtet_686(gf: Geschaeftsfuehrung, p: Person) kind institutional {
    label de official "Der wirkliche Geschäftsherr wird aus der Geschäftsführung berechtigt und verpflichtet (§ 686)";
    label en unofficial "the actual principal acquires the rights and duties arising from the intervention (§ 686)";
}
@source(BGB_P686)
rule WirklicherGeschaeftsherrBerechtigtUndVerpflichtet686(gf: Geschaeftsfuehrung, p: Person) strict {
    label de official "Ist der Geschäftsführer über die Person des Geschäftsherrn im Irrtum, so wird der wirkliche Geschäftsherr aus der Geschäftsführung berechtigt und verpflichtet (§ 686)";
    label en unofficial "where the intervener is mistaken about the identity of the principal, the actual principal acquires the rights and duties arising from the intervention (§ 686)";
    when geschaeftsfuehrer_im_irrtum_ueber_geschaeftsherrn_686(gf, p);
    then wirklicher_geschaeftsherr_berechtigt_und_verpflichtet_686(gf, p);
}

// ==================================================================================================
// TITEL 14 — VERWAHRUNG (§§ 688–700)
// ==================================================================================================

pub entity Verwahrung {
    label de official "Verwahrungsvertrag (§ 688)";
    label en unofficial "contract of deposit (§ 688)";
}
pub relation verwahrer(vw: Verwahrung, p: Person) kind empirical {
    key(vw);
    label de official "Verwahrer (§ 688)";
    label en unofficial "depositary (§ 688)";
}
pub relation hinterleger(vw: Verwahrung, p: Person) kind empirical {
    key(vw);
    label de official "Hinterleger (§ 688)";
    label en unofficial "depositor (§ 688)";
}
pub relation bewegliche_sache_uebergeben(vw: Verwahrung) kind empirical {
    label de official "Dem Verwahrer ist von dem Hinterleger eine bewegliche Sache übergeben (§ 688)";
    label en unofficial "a movable thing has been handed over to the depositary by the depositor (§ 688)";
}
pub relation aufbewahrungspflicht(vw: Verwahrung, p: Person) kind institutional {
    label de official "Durch den Verwahrungsvertrag wird der Verwahrer verpflichtet, eine ihm von dem Hinterleger übergebene bewegliche Sache aufzubewahren (§ 688)";
    label en unofficial "by the contract of deposit the depositary is obliged to keep a movable thing handed over to him by the depositor (§ 688)";
}
pub relation verwahrung_beginn_am(vw: Verwahrung, tag: Date) kind empirical {
    label de official "Beginn der Aufbewahrungspflicht (§ 688)";
    label en unofficial "start of the safekeeping duty (§ 688)";
}
pub relation sache_aufbewahrt_am(vw: Verwahrung, tag: Date) kind empirical {
    label de official "Der Verwahrer hat die Sache aufbewahrt (§ 688)";
    label en unofficial "the depositary kept the thing (§ 688)";
}
@source(BGB_P688)
rule Position688Aufbewahrung(vw: Verwahrung, h: Person, w: Person, beginn: Date) strict {
    label de official "Der Verwahrer ist verpflichtet, die übergebene bewegliche Sache aufzubewahren (§ 688)";
    label en unofficial "The depositary is obliged to keep the movable thing handed over (§ 688)";
    when bewegliche_sache_uebergeben(vw) and verwahrer(vw, h) and hinterleger(vw, w)
     and verwahrung_beginn_am(vw, beginn);
    then duty Duty688Aufbewahrung {
        bearer h;
        beneficiary w;
        achieve sache_aufbewahrt_am(vw, beginn) during [beginn, infinity);
    };
}
pub relation unentgeltliche_verwahrung(vw: Verwahrung) kind empirical {
    label de official "Die Aufbewahrung ist unentgeltlich übernommen (§ 690)";
    label en unofficial "the safekeeping was assumed gratuitously (§ 690)";
}
pub relation sorgfalt_in_eigenen_angelegenheiten(vw: Verwahrung) kind institutional {
    label de official "Wird die Aufbewahrung unentgeltlich übernommen, so hat der Verwahrer nur für diejenige Sorgfalt einzustehen, welche er in eigenen Angelegenheiten anzuwenden pflegt (§ 690)";
    label en unofficial "where safekeeping is assumed gratuitously the depositary is answerable only for the care he customarily exercises in his own affairs (§ 690)";
}
pub relation hinterlegung_bei_dritten_gestattet(vw: Verwahrung) kind empirical {
    label de official "Die Hinterlegung der Sache bei einem Dritten ist gestattet (§ 691 Satz 2)";
    label en unofficial "depositing the thing with a third party is permitted (§ 691 sentence 2)";
}
pub relation nicht_berechtigt_bei_dritten_zu_hinterlegen(vw: Verwahrung) kind institutional {
    label de official "Der Verwahrer ist im Zweifel nicht berechtigt, die hinterlegte Sache bei einem Dritten zu hinterlegen (§ 691 Satz 1)";
    label en unofficial "in case of doubt the depositary is not entitled to deposit the thing with a third party (§ 691 sentence 1)";
}
pub relation aufwendung_zur_aufbewahrung(vw: Verwahrung, betrag: Money) kind empirical {
    key(vw);
    label de official "Aufwendung, die der Verwahrer zum Zwecke der Aufbewahrung gemacht hat (§ 693)";
    label en unofficial "expense incurred by the depositary for the purpose of safekeeping (§ 693)";
}
@source(BGB_P693)
pub external judgment relation aufwendung_erforderlich_693(vw: Verwahrung, betrag: Money) {
    authority Court;
    label de official "Der Verwahrer durfte die Aufwendung den Umständen nach für erforderlich halten (§ 693)";
    label en unofficial "the depositary was entitled in the circumstances to regard the expense as necessary (§ 693)";
}
pub relation aufwendungsersatz_693(vw: Verwahrung, betrag: Money) kind institutional {
    label de official "Der Hinterleger ist zum Ersatz der Aufwendungen verpflichtet (§ 693)";
    label en unofficial "the depositor must reimburse the expenses (§ 693)";
}
pub relation rueckforderung_verlangt(vw: Verwahrung) kind empirical {
    label de official "Der Hinterleger hat die hinterlegte Sache zurückgefordert (§ 695 Satz 1)";
    label en unofficial "the depositor has demanded the thing back (§ 695 sentence 1)";
}
pub relation rueckgabepflicht_695(vw: Verwahrung) kind institutional {
    label de official "Der Hinterleger kann die hinterlegte Sache jederzeit zurückfordern, auch wenn für die Aufbewahrung eine Zeit bestimmt ist (§ 695 Satz 1)";
    label en unofficial "the depositor may demand the thing back at any time, even where a period for safekeeping has been agreed (§ 695 sentence 1)";
}
pub relation hinterleger_sache_zurueckgefordert_am(vw: Verwahrung, tag: Date) kind empirical {
    label de official "Der Hinterleger hat die Sache zurückgefordert (§ 695 Satz 1)";
    label en unofficial "the depositor demanded the thing back (§ 695 sentence 1)";
}
@source(BGB_P695)
rule Position695Rueckforderung(vw: Verwahrung, h: Person, w: Person, beginn: Date) strict {
    label de official "Der Hinterleger ist berechtigt, die hinterlegte Sache jederzeit zurückzufordern (§ 695 Satz 1)";
    label en unofficial "The depositor has the liberty to demand the deposited thing back at any time (§ 695 sentence 1)";
    when bewegliche_sache_uebergeben(vw) and hinterleger(vw, h) and verwahrer(vw, w)
     and rueckforderung_verlangt(vw) and verwahrung_beginn_am(vw, beginn);
    then liberty Liberty695Rueckforderung {
        holder h;
        against w;
        action hinterleger_sache_zurueckgefordert_am(vw, beginn);
        window [beginn, infinity];
    };
}

@source(BGB_P688)
rule PflichtenBeiDerVerwahrung(vw: Verwahrung, p: Person) strict {
    label de official "Durch den Verwahrungsvertrag wird der Verwahrer verpflichtet, eine ihm von dem Hinterleger übergebene bewegliche Sache aufzubewahren (§ 688)";
    label en unofficial "by the contract of deposit the depositary is obliged to keep a movable thing handed over to him by the depositor (§ 688)";
    when bewegliche_sache_uebergeben(vw) and verwahrer(vw, p);
    then aufbewahrungspflicht(vw, p);
}
@source(BGB_P690)
rule HaftungBeiUnentgeltlicherVerwahrung(vw: Verwahrung) strict {
    label de official "Wird die Aufbewahrung unentgeltlich übernommen, so hat der Verwahrer nur für diejenige Sorgfalt einzustehen, welche er in eigenen Angelegenheiten anzuwenden pflegt (§ 690)";
    label en unofficial "where safekeeping is assumed gratuitously the depositary is answerable only for the care he customarily exercises in his own affairs (§ 690)";
    when bewegliche_sache_uebergeben(vw) and unentgeltliche_verwahrung(vw);
    then sorgfalt_in_eigenen_angelegenheiten(vw);
}
@source(BGB_P691)
rule HinterlegungBeiDritten(vw: Verwahrung) strict {
    label de official "Der Verwahrer ist im Zweifel nicht berechtigt, die hinterlegte Sache bei einem Dritten zu hinterlegen (§ 691 Satz 1)";
    label en unofficial "in case of doubt the depositary is not entitled to deposit the thing with a third party (§ 691 sentence 1)";
    when bewegliche_sache_uebergeben(vw) and not_known(hinterlegung_bei_dritten_gestattet(vw));
    then nicht_berechtigt_bei_dritten_zu_hinterlegen(vw);
}
@source(BGB_P693)
rule ErsatzVonAufwendungen693(vw: Verwahrung, betrag: Money) strict {
    label de official "Macht der Verwahrer zum Zwecke der Aufbewahrung Aufwendungen, die er den Umständen nach für erforderlich halten darf, so ist der Hinterleger zum Ersatz verpflichtet (§ 693)";
    label en unofficial "where the depositary incurs expenses for the purpose of safekeeping which he is entitled in the circumstances to regard as necessary, the depositor must reimburse him (§ 693)";
    when bewegliche_sache_uebergeben(vw) and aufwendung_zur_aufbewahrung(vw, betrag)
        and aufwendung_erforderlich_693(vw, betrag);
    then aufwendungsersatz_693(vw, betrag);
}
pub relation aufwendungen_693_ersetzt_am(vw: Verwahrung, betrag: Money, tag: Date) kind empirical {
    label de official "Der Hinterleger hat die Aufwendungen ersetzt (§ 693)";
    label en unofficial "the depositor reimbursed the expenses (§ 693)";
}
pub relation aufwendungsersatz_693_beginn_am(vw: Verwahrung, tag: Date) kind empirical {
    label de official "Beginn des Aufwendungsersatzes nach § 693";
    label en unofficial "start of reimbursement under § 693";
}
@source(BGB_P693)
rule Position693Aufwendungsersatz(vw: Verwahrung, p: Person, betrag: Money, beginn: Date) strict {
    label de official "Der Hinterleger ist verpflichtet, dem Verwahrer erforderliche Aufwendungen zu ersetzen (§ 693)";
    label en unofficial "The depositor is obliged to reimburse the depositary's necessary expenses (§ 693)";
    when hinterleger(vw, p) and bewegliche_sache_uebergeben(vw)
     and aufwendung_zur_aufbewahrung(vw, betrag)
     and aufwendung_erforderlich_693(vw, betrag)
     and aufwendungsersatz_693_beginn_am(vw, beginn);
    then duty Duty693Aufwendungsersatz {
        bearer p;
        achieve aufwendungen_693_ersetzt_am(vw, betrag, beginn) during [beginn, infinity);
    };
}
@source(BGB_P695)
rule RueckforderungsrechtDesHinterlegers(vw: Verwahrung) strict {
    label de official "Der Hinterleger kann die hinterlegte Sache jederzeit zurückfordern, auch wenn für die Aufbewahrung eine Zeit bestimmt ist (§ 695 Satz 1)";
    label en unofficial "the depositor may demand the deposited thing back at any time, even where a period for safekeeping has been agreed (§ 695 sentence 1)";
    when bewegliche_sache_uebergeben(vw) and rueckforderung_verlangt(vw);
    then rueckgabepflicht_695(vw);
}

// ==================================================================================================
// TITEL 15 — EINBRINGUNG VON SACHEN BEI GASTWIRTEN (§§ 701–704)
// ==================================================================================================

pub entity Gastaufnahme {
    label de official "Aufnahme eines Gastes zur Beherbergung durch einen Gastwirt (§ 701 Absatz 1)";
    label en unofficial "reception of a guest for accommodation by an innkeeper (§ 701 (1))";
}
pub relation gastwirt(ga: Gastaufnahme, p: Person) kind empirical {
    key(ga);
    label de official "Gastwirt, der gewerbsmäßig Fremde zur Beherbergung aufnimmt (§ 701 Absatz 1)";
    label en unofficial "innkeeper who receives strangers for accommodation on a commercial basis (§ 701 (1))";
}
pub relation gast(ga: Gastaufnahme, p: Person) kind empirical {
    key(ga);
    label de official "Im Betrieb des Gewerbes aufgenommener Gast (§ 701 Absatz 1)";
    label en unofficial "guest received in the course of the business (§ 701 (1))";
}
pub relation eingebrachte_sache_beschaedigt(ga: Gastaufnahme, schaden: Money) kind empirical {
    key(ga);
    label de official "Schaden durch Verlust, Zerstörung oder Beschädigung eingebrachter Sachen des Gastes (§ 701 Absatz 1, 2)";
    label en unofficial "damage through loss, destruction or damage of things brought in by the guest (§ 701 (1), (2))";
}
pub relation ausschlussgrund_701_abs3(ga: Gastaufnahme) kind empirical {
    label de official "Der Verlust, die Zerstörung oder die Beschädigung ist von dem Gast, einem Begleiter, einer vom Gast aufgenommenen Person, durch die Beschaffenheit der Sachen oder durch höhere Gewalt verursacht (§ 701 Absatz 3)";
    label en unofficial "the loss, destruction or damage was caused by the guest, a companion, a person received by the guest, by the nature of the things or by force majeure (§ 701 (3))";
}
pub relation fahrzeug_oder_lebendes_tier(ga: Gastaufnahme) kind empirical {
    label de official "Es handelt sich um ein Fahrzeug, um in einem Fahrzeug belassene Sachen oder um lebende Tiere — die Ersatzpflicht erstreckt sich darauf nicht (§ 701 Absatz 4)";
    label en unofficial "the matter concerns a vehicle, things left in a vehicle, or live animals — the duty to compensate does not extend to them (§ 701 (4))";
}
pub relation ersatzpflicht_des_gastwirts(ga: Gastaufnahme, schaden: Money) kind institutional {
    label de official "Der Gastwirt hat den Schaden zu ersetzen, der durch den Verlust, die Zerstörung oder die Beschädigung eingebrachter Sachen entsteht (§ 701 Absatz 1)";
    label en unofficial "the innkeeper must compensate the damage arising through loss, destruction or damage of things brought in (§ 701 (1))";
}
pub relation beherbergungspreis_fuer_einen_tag(ga: Gastaufnahme, betrag: Money) kind empirical {
    key(ga);
    label de official "Beherbergungspreis für einen Tag (§ 702 Absatz 1)";
    label en unofficial "accommodation price for one day (§ 702 (1))";
}
pub relation hundertfacher_tagespreis(ga: Gastaufnahme, betrag: Money) kind derived {
    key(ga);
    label de official "Das Hundertfache des Beherbergungspreises für einen Tag — Ausgangsgröße der Haftungsgrenze (§ 702 Absatz 1)";
    label en unofficial "one hundred times the daily accommodation price — starting quantity of the liability cap (§ 702 (1))";
}
pub relation geld_wertpapiere_oder_kostbarkeiten(ga: Gastaufnahme) kind empirical {
    label de official "Es handelt sich um Geld, Wertpapiere oder Kostbarkeiten — an die Stelle von 3 500 Euro tritt der Betrag von 800 Euro (§ 702 Absatz 1 Halbsatz 2)";
    label en unofficial "the matter concerns money, securities or valuables — EUR 800 takes the place of EUR 3,500 (§ 702 (1) second half-sentence)";
}
pub relation haftungshoechstbetrag_702(ga: Gastaufnahme, betrag: Money) kind derived {
    key(ga);
    label de official "Haftungshöchstbetrag des Gastwirts: das Hundertfache des Beherbergungspreises für einen Tag, mindestens 600 Euro, höchstens 3 500 Euro; für Geld, Wertpapiere und Kostbarkeiten höchstens 800 Euro (§ 702 Absatz 1)";
    label en unofficial "the innkeeper's cap on liability: one hundred times the daily accommodation price, at least EUR 600 and at most EUR 3,500; for money, securities and valuables at most EUR 800 (§ 702 (1))";
}
pub relation unbeschraenkte_haftung_702_abs2(ga: Gastaufnahme) kind empirical {
    label de official "Der Verlust, die Zerstörung oder die Beschädigung ist vom Gastwirt oder seinen Leuten verschuldet, oder es handelt sich um zur Aufbewahrung übernommene oder entgegen § 702 Absatz 3 abgelehnte Sachen (§ 702 Absatz 2)";
    label en unofficial "the loss, destruction or damage was caused by the innkeeper's fault or that of his people, or the things were taken into safekeeping or refused contrary to § 702 (3) (§ 702 (2))";
}
@source(BGB_P703)
pub external judgment relation unverzueglich_angezeigt_703(ga: Gastaufnahme) {
    authority Court;
    label de official "Der Gast hat dem Gastwirt unverzüglich, nachdem er von dem Verlust, der Zerstörung oder der Beschädigung Kenntnis erlangt hat, Anzeige gemacht (§ 703 Satz 1)";
    label en unofficial "the guest notified the innkeeper without undue delay after learning of the loss, destruction or damage (§ 703 sentence 1)";
}
pub relation anspruch_703_erloschen(ga: Gastaufnahme) kind institutional {
    label de official "Der dem Gast auf Grund der §§ 701, 702 zustehende Anspruch erlischt (§ 703 Satz 1)";
    label en unofficial "the guest's claim under §§ 701, 702 is extinguished (§ 703 sentence 1)";
}

@source(BGB_P701)
rule HaftungDesGastwirts(ga: Gastaufnahme, schaden: Money) strict {
    label de official "Ein Gastwirt, der gewerbsmäßig Fremde zur Beherbergung aufnimmt, hat den Schaden zu ersetzen, der durch den Verlust, die Zerstörung oder die Beschädigung von Sachen entsteht, die ein aufgenommener Gast eingebracht hat (§ 701 Absatz 1)";
    label en unofficial "an innkeeper who receives strangers for accommodation on a commercial basis must compensate the damage arising through loss, destruction or damage of things brought in by a received guest (§ 701 (1))";
    when eingebrachte_sache_beschaedigt(ga, schaden)
        and not_known(ausschlussgrund_701_abs3(ga)) and not_known(fahrzeug_oder_lebendes_tier(ga));
    then ersatzpflicht_des_gastwirts(ga, schaden);
}
pub relation gastschaden_701_ersetzt_am(ga: Gastaufnahme, schaden: Money, tag: Date) kind empirical {
    label de official "Der Gastwirt hat den Gastschaden ersetzt (§ 701)";
    label en unofficial "the innkeeper compensated the guest's loss (§ 701)";
}
pub relation gastschaden_701_beginn_am(ga: Gastaufnahme, tag: Date) kind empirical {
    label de official "Beginn der Ersatzpflicht nach § 701";
    label en unofficial "start of compensation duty under § 701";
}
@source(BGB_P701)
rule Position701Haftung(ga: Gastaufnahme, p: Person, schaden: Money, beginn: Date) strict {
    label de official "Der Gastwirt ist verpflichtet, den Schaden des Gastes zu ersetzen (§ 701 Absatz 1)";
    label en unofficial "The innkeeper is obliged to compensate the guest's loss (§ 701 (1))";
    when gastwirt(ga, p) and eingebrachte_sache_beschaedigt(ga, schaden)
     and not_known(ausschlussgrund_701_abs3(ga))
     and not_known(fahrzeug_oder_lebendes_tier(ga))
     and gastschaden_701_beginn_am(ga, beginn);
    then duty Duty701Haftung {
        bearer p;
        achieve gastschaden_701_ersetzt_am(ga, schaden, beginn) during [beginn, infinity);
    };
}
@source(BGB_P702) {
    rule HundertfacherTagespreis(ga: Gastaufnahme, tagespreis: Money) strict {
        label de official "Ausgangsgröße der Haftungsgrenze: das Hundertfache des Beherbergungspreises für einen Tag (§ 702 Absatz 1)";
        label en unofficial "starting quantity of the liability cap: one hundred times the daily accommodation price (§ 702 (1))";
        when beherbergungspreis_fuer_einen_tag(ga, tagespreis);
        then hundertfacher_tagespreis(ga, tagespreis * 100);
    }
    rule Haftungsgrenze702Mindestbetrag(ga: Gastaufnahme, hundert: Money) strict {
        label de official "Der Gastwirt haftet mindestens bis zu dem Betrag von 600 Euro (§ 702 Absatz 1)";
        label en unofficial "the innkeeper is liable at least up to the amount of EUR 600 (§ 702 (1))";
        when hundertfacher_tagespreis(ga, hundert) and hundert < 600.00 EUR;
        then haftungshoechstbetrag_702(ga, 600.00 EUR);
    }
    rule Haftungsgrenze702Hundertfaches(ga: Gastaufnahme, hundert: Money) strict {
        label de official "Der Gastwirt haftet bis zu einem Betrag, der dem Hundertfachen des Beherbergungspreises für einen Tag entspricht, solange dieser zwischen 600 Euro und 3 500 Euro liegt (§ 702 Absatz 1)";
        label en unofficial "the innkeeper is liable up to an amount equal to one hundred times the daily accommodation price, as long as that lies between EUR 600 and EUR 3,500 (§ 702 (1))";
        when hundertfacher_tagespreis(ga, hundert) and hundert >= 600.00 EUR and hundert <= 3500.00 EUR
            and not_known(geld_wertpapiere_oder_kostbarkeiten(ga));
        then haftungshoechstbetrag_702(ga, hundert);
    }
    rule Haftungsgrenze702Hoechstbetrag(ga: Gastaufnahme, hundert: Money) strict {
        label de official "Der Gastwirt haftet höchstens bis zu dem Betrag von 3 500 Euro (§ 702 Absatz 1)";
        label en unofficial "the innkeeper is liable at most up to the amount of EUR 3,500 (§ 702 (1))";
        when hundertfacher_tagespreis(ga, hundert) and hundert > 3500.00 EUR
            and not_known(geld_wertpapiere_oder_kostbarkeiten(ga));
        then haftungshoechstbetrag_702(ga, 3500.00 EUR);
    }
    rule Haftungsgrenze702Wertsachen(ga: Gastaufnahme, hundert: Money) strict {
        label de official "Für Geld, Wertpapiere und Kostbarkeiten tritt an die Stelle von 3 500 Euro der Betrag von 800 Euro (§ 702 Absatz 1 Halbsatz 2)";
        label en unofficial "for money, securities and valuables the amount of EUR 800 takes the place of EUR 3,500 (§ 702 (1) second half-sentence)";
        when geld_wertpapiere_oder_kostbarkeiten(ga) and hundertfacher_tagespreis(ga, hundert)
            and hundert > 800.00 EUR;
        then haftungshoechstbetrag_702(ga, 800.00 EUR);
    }
    rule Haftungsgrenze702WertsachenHundertfaches(ga: Gastaufnahme, hundert: Money) strict {
        label de official "Für Geld, Wertpapiere und Kostbarkeiten haftet der Gastwirt bis zum Hundertfachen des Beherbergungspreises, solange dieser 800 Euro nicht übersteigt und mindestens 600 Euro beträgt (§ 702 Absatz 1)";
        label en unofficial "for money, securities and valuables the innkeeper is liable up to one hundred times the daily price, as long as it does not exceed EUR 800 and is at least EUR 600 (§ 702 (1))";
        when geld_wertpapiere_oder_kostbarkeiten(ga) and hundertfacher_tagespreis(ga, hundert)
            and hundert >= 600.00 EUR and hundert <= 800.00 EUR;
        then haftungshoechstbetrag_702(ga, hundert);
    }
}
@source(BGB_P703)
rule ErloeschenDesSchadensersatzanspruchs(ga: Gastaufnahme, schaden: Money) strict {
    label de official "Der dem Gast auf Grund der §§ 701, 702 zustehende Anspruch erlischt, wenn nicht der Gast unverzüglich, nachdem er von dem Verlust, der Zerstörung oder der Beschädigung Kenntnis erlangt hat, dem Gastwirt Anzeige macht; dies gilt nicht bei zur Aufbewahrung übernommenen Sachen oder bei Verschulden des Gastwirts (§ 703)";
    label en unofficial "the guest's claim under §§ 701, 702 is extinguished unless he notifies the innkeeper without undue delay after learning of the loss, destruction or damage; this does not apply to things taken into safekeeping or where the innkeeper is at fault (§ 703)";
    when ersatzpflicht_des_gastwirts(ga, schaden) and not_known(unverzueglich_angezeigt_703(ga))
        and not_known(unbeschraenkte_haftung_702_abs2(ga));
    then anspruch_703_erloschen(ga);
}

// § 702a Erlass der Haftung (D-08-18): der Erlass der den Höchstbetrag nach
// § 702 Absatz 1 übersteigenden Haftung ist an Form (schriftlich, keine
// anderen Bestimmungen) und an zwei Ausschlussgründe geknüpft — Vorsatz/grobe
// Fahrlässigkeit des Gastwirts oder seiner Leute, oder eine Ablehnung der
// Aufbewahrung entgegen § 702 Absatz 3. Beide Ausschlussgründe sind eigene
// empirische Prädikate; das Ergebnis ist die Wirksamkeit des Erlasses.
@source(BGB_P702a)
pub external judgment relation erlass_der_haftung_erklaert_702a(ga: Gastaufnahme) {
    authority Court;
    label de official "Der Gast hat den Erlass der den Höchstbetrag nach § 702 Absatz 1 übersteigenden Haftung schriftlich erklärt, ohne dass die Erklärung andere Bestimmungen enthält (§ 702a Absatz 1 Satz 1, Absatz 2)";
    label en unofficial "the guest has declared in writing the waiver of the innkeeper's liability exceeding the § 702 (1) cap, without the declaration containing other provisions (§ 702a (1) sentence 1, (2))";
}
pub relation vorsatz_oder_grobe_fahrlaessigkeit_702a(ga: Gastaufnahme) kind empirical {
    label de official "Der Verlust, die Zerstörung oder die Beschädigung ist von dem Gastwirt oder von Leuten des Gastwirts vorsätzlich oder grob fahrlässig verursacht worden (§ 702a Absatz 1 Satz 2)";
    label en unofficial "the loss, destruction or damage was caused intentionally or through gross negligence by the innkeeper or the innkeeper's people (§ 702a (1) sentence 2)";
}
pub relation ablehnung_entgegen_702_abs3(ga: Gastaufnahme) kind empirical {
    label de official "Es handelt sich um Sachen, deren Übernahme zur Aufbewahrung der Gastwirt entgegen der Vorschrift des § 702 Absatz 3 abgelehnt hat (§ 702a Absatz 1 Satz 2)";
    label en unofficial "the matter concerns things whose acceptance for safekeeping the innkeeper refused contrary to § 702 (3) (§ 702a (1) sentence 2)";
}
pub relation erlass_unwirksam_702a(ga: Gastaufnahme) kind institutional {
    label de official "Der Erlass ist insoweit unwirksam (§ 702a Absatz 1 Satz 2)";
    label en unofficial "the waiver is ineffective to that extent (§ 702a (1) sentence 2)";
}
pub relation erlass_der_haftung_wirksam_702a(ga: Gastaufnahme) kind institutional {
    label de official "Der Erlass der den Höchstbetrag nach § 702 Absatz 1 übersteigenden Haftung ist wirksam (§ 702a)";
    label en unofficial "the waiver of the innkeeper's liability exceeding the § 702 (1) cap is effective (§ 702a)";
}
@source(BGB_P702a) {
    rule ErlassUnwirksamVorsatzGrobeFahrlaessigkeit702a(ga: Gastaufnahme) strict {
        label de official "Der Erlass kann nicht für vorsätzlich oder grob fahrlässig verursachte Schäden erklärt werden (§ 702a Absatz 1 Satz 2)";
        label en unofficial "the waiver cannot cover damage caused intentionally or through gross negligence (§ 702a (1) sentence 2)";
        when vorsatz_oder_grobe_fahrlaessigkeit_702a(ga);
        then erlass_unwirksam_702a(ga);
    }
    rule ErlassUnwirksamAblehnungEntgegen702Abs3(ga: Gastaufnahme) strict {
        label de official "Der Erlass kann nicht für Sachen erklärt werden, deren Aufbewahrung der Gastwirt entgegen § 702 Absatz 3 abgelehnt hat (§ 702a Absatz 1 Satz 2)";
        label en unofficial "the waiver cannot cover things whose safekeeping the innkeeper refused contrary to § 702 (3) (§ 702a (1) sentence 2)";
        when ablehnung_entgegen_702_abs3(ga);
        then erlass_unwirksam_702a(ga);
    }
    rule ErlassDerHaftungWirksam702a(ga: Gastaufnahme) strict {
        label de official "Der schriftlich und ohne andere Bestimmungen erklärte Erlass ist wirksam, wenn weder Vorsatz/grobe Fahrlässigkeit noch eine Ablehnung entgegen § 702 Absatz 3 vorliegt (§ 702a)";
        label en unofficial "a written waiver without other provisions is effective unless there is intent/gross negligence or a refusal contrary to § 702 (3) (§ 702a)";
        when erlass_der_haftung_erklaert_702a(ga) and not_known(erlass_unwirksam_702a(ga));
        then erlass_der_haftung_wirksam_702a(ga);
    }
}

// § 704 Pfandrecht des Gastwirts (D-08-18): Verweisungsnorm nach dem Muster
// D-08-07 — die entsprechende Anwendung der Vermieterpfandrechtsvorschriften
// (§ 562 Absatz 1 Satz 2, §§ 562a–562d) wird als ein Brücken-Prädikat
// abgebildet, ohne die Mietrecht-Mechanik dieses fremden Pakets neu
// herzuleiten (Miete ist hier nicht importiert).
@source(BGB_P704)
pub external judgment relation forderung_fuer_wohnung_und_leistungen_704(ga: Gastaufnahme) {
    authority Court;
    label de official "Der Gastwirt hat Forderungen für Wohnung und andere dem Gast zur Befriedigung seiner Bedürfnisse gewährte Leistungen, mit Einschluss der Auslagen (§ 704 Satz 1)";
    label en unofficial "the innkeeper has claims for accommodation and other services provided to satisfy the guest's needs, including outlays (§ 704 sentence 1)";
}
pub relation pfandrecht_des_gastwirts_704(ga: Gastaufnahme) kind institutional {
    label de official "Der Gastwirt hat ein Pfandrecht an den eingebrachten Sachen des Gastes (§ 704 Satz 1)";
    label en unofficial "the innkeeper has a lien on the guest's things brought in (§ 704 sentence 1)";
}
pub relation vermieterpfandrechtsvorschriften_entsprechend_704(ga: Gastaufnahme) kind institutional {
    label de official "Die für das Pfandrecht des Vermieters geltenden Vorschriften des § 562 Absatz 1 Satz 2 und der §§ 562a bis 562d finden entsprechende Anwendung (§ 704 Satz 2)";
    label en unofficial "the provisions on the landlord's lien in § 562 (1) sentence 2 and §§ 562a to 562d apply correspondingly (§ 704 sentence 2)";
}
@source(BGB_P704) {
    rule PfandrechtDesGastwirts704(ga: Gastaufnahme) strict {
        label de official "Für seine Forderungen für Wohnung und andere dem Gast zur Befriedigung seiner Bedürfnisse gewährte Leistungen hat der Gastwirt ein Pfandrecht an den eingebrachten Sachen des Gastes (§ 704 Satz 1)";
        label en unofficial "for claims for accommodation and other services provided to satisfy the guest's needs, the innkeeper has a lien on the guest's things brought in (§ 704 sentence 1)";
        when forderung_fuer_wohnung_und_leistungen_704(ga);
        then pfandrecht_des_gastwirts_704(ga);
    }
    rule VermieterpfandrechtsvorschriftenEntsprechend704(ga: Gastaufnahme) strict {
        label de official "Auf das Pfandrecht des Gastwirts finden die für das Pfandrecht des Vermieters geltenden Vorschriften entsprechende Anwendung (§ 704 Satz 2)";
        label en unofficial "the provisions on the landlord's lien apply correspondingly to the innkeeper's lien (§ 704 sentence 2)";
        when pfandrecht_des_gastwirts_704(ga);
        then vermieterpfandrechtsvorschriften_entsprechend_704(ga);
    }
}

// ==================================================================================================
// TITEL 23 — ANWEISUNG (§§ 783–792)
// ==================================================================================================

pub entity Anweisung {
    label de official "Anweisung (§ 783): Urkunde, in der der Anweisende den Angewiesenen anweist, Geld, Wertpapiere oder andere vertretbare Sachen an den Anweisungsempfänger zu leisten";
    label en unofficial "instruction (Anweisung, § 783): document by which the drawer instructs the drawee to render money, securities or other fungible things to the payee";
}

pub relation anweisung_dem_empfaenger_ausgehaendigt(a: Anweisung) kind empirical {
    key(a);
    label de official "Der Anweisende händigt die Anweisung dem Anweisungsempfänger aus (§ 783)";
    label en unofficial "the drawer hands the instruction to the payee (§ 783)";
}
pub relation anweisungsempfaenger_zur_erhebung_ermaechtigt(a: Anweisung) kind institutional {
    label de official "Der Anweisungsempfänger ist ermächtigt, die Leistung bei dem Angewiesenen im eigenen Namen zu erheben (§ 783)";
    label en unofficial "the payee is authorised to collect performance from the drawee in his own name (§ 783)";
}
pub relation angewiesener_zur_leistung_ermaechtigt(a: Anweisung) kind institutional {
    label de official "Der Angewiesene ist ermächtigt, für Rechnung des Anweisenden an den Anweisungsempfänger zu leisten (§ 783)";
    label en unofficial "the drawee is authorised to render performance to the payee for the drawer's account (§ 783)";
}
pub relation angewiesener_nimmt_an_durch_schriftlichen_vermerk(a: Anweisung) kind empirical {
    label de official "Der Angewiesene nimmt die Anweisung durch einen schriftlichen Vermerk auf der Anweisung an (§ 784 Absatz 1, 2 Satz 1)";
    label en unofficial "the drawee accepts the instruction by a written note on the instrument (§ 784 (1), (2) sentence 1)";
}
pub relation vermerk_vor_aushaendigung_gesetzt(a: Anweisung) kind empirical {
    label de official "Der Vermerk ist auf die Anweisung vor der Aushändigung an den Anweisungsempfänger gesetzt worden (§ 784 Absatz 2 Satz 2)";
    label en unofficial "the note was put on the instrument before it was handed to the payee (§ 784 (2) sentence 2)";
}
pub relation leistungspflicht_gegenueber_empfaenger_784(a: Anweisung) kind institutional {
    label de official "Der Angewiesene ist dem Anweisungsempfänger gegenüber zur Leistung verpflichtet (§ 784 Absatz 1 Satz 1)";
    label en unofficial "the drawee is obliged to perform towards the payee (§ 784 (1) sentence 1)";
}
pub relation annahme_wirksam_erst_mit_aushaendigung_784(a: Anweisung) kind institutional {
    label de official "Die Annahme wird dem Anweisungsempfänger gegenüber erst mit der Aushändigung der Anweisung wirksam (§ 784 Absatz 2 Satz 2)";
    label en unofficial "acceptance becomes effective towards the payee only when the instrument is handed to him (§ 784 (2) sentence 2)";
}
pub relation leistung_nur_zug_um_zug_gegen_aushaendigung_785(a: Anweisung) kind institutional {
    label de official "Der Angewiesene ist nur gegen Aushändigung der Anweisung zur Leistung verpflichtet (§ 785)";
    label en unofficial "the drawee is only obliged to perform against handing over the instrument (§ 785)";
}
pub relation angewiesener_ist_schuldner_des_anweisenden(a: Anweisung) kind empirical {
    label de official "Der Angewiesene ist Schuldner des Anweisenden (Anweisung auf Schuld, § 787)";
    label en unofficial "the drawee is a debtor of the drawer (instruction on a debt, § 787)";
}
pub relation leistung_bewirkt(a: Anweisung, betrag: Money) kind empirical {
    label de official "Der Angewiesene bewirkt die Leistung in Höhe des Betrags an den Anweisungsempfänger (§ 787 Absatz 1)";
    label en unofficial "the drawee renders performance of the amount to the payee (§ 787 (1))";
}
pub relation befreiung_von_schuld_787(a: Anweisung, betrag: Money) kind institutional {
    label de official "Der Angewiesene wird durch die Leistung in deren Höhe von seiner Schuld gegenüber dem Anweisenden befreit (§ 787 Absatz 1)";
    label en unofficial "the drawee is discharged from his debt towards the drawer to the extent of the performance (§ 787 (1))";
}
pub relation keine_annahme_oder_leistungspflicht_allein_aus_schuldnerstellung_787(a: Anweisung) kind institutional {
    label de official "Zur Annahme der Anweisung oder zur Leistung an den Anweisungsempfänger ist der Angewiesene dem Anweisenden gegenüber nicht schon deshalb verpflichtet, weil er dessen Schuldner ist (§ 787 Absatz 2)";
    label en unofficial "the drawee is not obliged, towards the drawer, to accept the instruction or to perform to the payee merely because he is the drawer's debtor (§ 787 (2))";
}
pub relation anweisung_zwecks_eigener_leistung_erteilt(a: Anweisung) kind empirical {
    label de official "Der Anweisende erteilt die Anweisung zu dem Zweck, um seinerseits eine Leistung an den Anweisungsempfänger zu bewirken (Valutaverhältnis, § 788)";
    label en unofficial "the drawer issues the instruction in order to render a performance of his own to the payee (underlying relationship, § 788)";
}
pub relation leistung_des_angewiesenen_an_empfaenger_bewirkt(a: Anweisung) kind empirical {
    label de official "Der Angewiesene bewirkt die Leistung an den Anweisungsempfänger (§ 788)";
    label en unofficial "the drawee renders the performance to the payee (§ 788)";
}
pub relation leistung_des_anweisenden_bewirkt_788(a: Anweisung) kind institutional {
    label de official "Die Leistung des Anweisenden an den Anweisungsempfänger wird erst mit der Leistung des Angewiesenen bewirkt (§ 788)";
    label en unofficial "the drawer's own performance to the payee is rendered only when the drawee performs (§ 788)";
}
pub relation angewiesener_verweigert_annahme_vor_leistungszeit(a: Anweisung) kind empirical {
    label de official "Der Angewiesene verweigert vor dem Eintritt der Leistungszeit die Annahme der Anweisung (§ 789 Satz 1)";
    label en unofficial "before the time for performance the drawee refuses to accept the instruction (§ 789 sentence 1)";
}
pub relation angewiesener_verweigert_leistung(a: Anweisung) kind empirical {
    label de official "Der Angewiesene verweigert die Leistung (§ 789 Satz 1)";
    label en unofficial "the drawee refuses to perform (§ 789 sentence 1)";
}
pub relation empfaenger_kann_oder_will_anweisung_nicht_geltend_machen(a: Anweisung) kind empirical {
    label de official "Der Anweisungsempfänger kann oder will die Anweisung nicht geltend machen (§ 789 Satz 2)";
    label en unofficial "the payee cannot or will not assert the instruction (§ 789 sentence 2)";
}
pub relation anzeigepflicht_789(a: Anweisung) kind institutional {
    label de official "Der Anweisungsempfänger hat dem Anweisenden unverzüglich Anzeige zu machen (§ 789)";
    label en unofficial "the payee must notify the drawer without undue delay (§ 789)";
}
pub relation angewiesener_hat_angenommen_oder_geleistet(a: Anweisung) kind empirical {
    label de official "Der Angewiesene hat die Anweisung dem Anweisungsempfänger gegenüber angenommen oder die Leistung bewirkt (§ 790 Satz 1)";
    label en unofficial "the drawee has accepted the instruction towards the payee or has rendered performance (§ 790 sentence 1)";
}
pub relation widerrufsrecht_790(a: Anweisung) kind institutional {
    label de official "Der Anweisende kann die Anweisung dem Angewiesenen gegenüber widerrufen — auch dann, wenn er damit einer ihm gegen den Anweisungsempfänger obliegenden Verpflichtung zuwiderhandelt (§ 790)";
    label en unofficial "the drawer may revoke the instruction towards the drawee — even where the revocation breaches an obligation owed to the payee (§ 790)";
}
pub relation tod_oder_geschaeftsunfaehigkeit_eines_beteiligten(a: Anweisung) kind empirical {
    label de official "Ein Beteiligter stirbt oder wird geschäftsunfähig (§ 791)";
    label en unofficial "one of the parties dies or becomes incapable of contracting (§ 791)";
}
pub relation anweisung_erlischt_nicht_791(a: Anweisung) kind institutional {
    label de official "Die Anweisung erlischt nicht durch den Tod oder den Eintritt der Geschäftsunfähigkeit eines der Beteiligten (§ 791)";
    label en unofficial "the instruction is not extinguished by the death or incapacity of one of the parties (§ 791)";
}
pub relation uebertragungsvertrag_mit_drittem_geschlossen(a: Anweisung, dritter: Person) kind empirical {
    label de official "Der Anweisungsempfänger schließt mit einem Dritten einen Vertrag über die Übertragung der Anweisung (§ 792 Absatz 1 Satz 1)";
    label en unofficial "the payee concludes a contract with a third party to transfer the instruction (§ 792 (1) sentence 1)";
}
pub relation uebertragungserklaerung_schriftlich(a: Anweisung, dritter: Person) kind empirical {
    label de official "Die Übertragungserklärung ist schriftlich abgegeben (§ 792 Absatz 1 Satz 2)";
    label en unofficial "the declaration of transfer is made in writing (§ 792 (1) sentence 2)";
}
pub relation anweisung_an_dritten_ausgehaendigt(a: Anweisung, dritter: Person) kind empirical {
    label de official "Die Anweisung wird dem Dritten ausgehändigt (§ 792 Absatz 1 Satz 3)";
    label en unofficial "the instrument is handed over to the third party (§ 792 (1) sentence 3)";
}
pub relation uebertragung_wirksam_792(a: Anweisung, dritter: Person) kind institutional {
    label de official "Der Anweisungsempfänger überträgt die Anweisung wirksam auf den Dritten, auch wenn sie noch nicht angenommen worden ist (§ 792 Absatz 1)";
    label en unofficial "the payee effectively transfers the instruction to the third party, even before it has been accepted (§ 792 (1))";
}
pub relation uebertragung_durch_anweisenden_ausgeschlossen(a: Anweisung) kind empirical {
    label de official "Der Anweisende schließt die Übertragung aus (§ 792 Absatz 2 Satz 1)";
    label en unofficial "the drawer excludes transfer (§ 792 (2) sentence 1)";
}
pub relation ausschluss_aus_anweisung_ersichtlich(a: Anweisung) kind empirical {
    label de official "Die Ausschließung ist aus der Anweisung zu entnehmen (§ 792 Absatz 2 Satz 2 Alternative 1)";
    label en unofficial "the exclusion appears from the instrument itself (§ 792 (2) sentence 2 alternative 1)";
}
pub relation ausschluss_dem_angewiesenen_mitgeteilt_vor_annahme_oder_leistung(a: Anweisung) kind empirical {
    label de official "Der Anweisende teilt die Ausschließung dem Angewiesenen mit, bevor dieser die Anweisung annimmt oder die Leistung bewirkt (§ 792 Absatz 2 Satz 2 Alternative 2)";
    label en unofficial "the drawer notifies the drawee of the exclusion before the drawee accepts the instruction or performs (§ 792 (2) sentence 2 alternative 2)";
}
pub relation ausschluss_wirksam_gegenueber_angewiesenem_792(a: Anweisung) kind institutional {
    label de official "Die Ausschließung der Übertragung ist dem Angewiesenen gegenüber wirksam (§ 792 Absatz 2)";
    label en unofficial "the exclusion of transfer is effective against the drawee (§ 792 (2))";
}
pub relation angewiesener_nimmt_gegenueber_erwerber_an(a: Anweisung, dritter: Person) kind empirical {
    label de official "Der Angewiesene nimmt die Anweisung dem Erwerber gegenüber an (§ 792 Absatz 3 Satz 1)";
    label en unofficial "the drawee accepts the instruction towards the acquirer (§ 792 (3) sentence 1)";
}
pub relation einwendungen_aus_verhaeltnis_zum_empfaenger_ausgeschlossen_792(a: Anweisung, dritter: Person) kind institutional {
    label de official "Der Angewiesene kann aus einem zwischen ihm und dem Anweisungsempfänger bestehenden Rechtsverhältnis dem Erwerber gegenüber Einwendungen nicht herleiten (§ 792 Absatz 3 Satz 1)";
    label en unofficial "the drawee cannot raise, against the acquirer, objections arising from a legal relationship between himself and the payee (§ 792 (3) sentence 1)";
}

@source(BGB_P783)
rule ErmaechtigungenAusDerAnweisung783(a: Anweisung) strict {
    label de official "Wird die Anweisung dem Anweisungsempfänger ausgehändigt, so ist dieser ermächtigt, die Leistung bei dem Angewiesenen im eigenen Namen zu erheben, und der Angewiesene ist ermächtigt, für Rechnung des Anweisenden an den Anweisungsempfänger zu leisten (§ 783)";
    label en unofficial "once the instruction is handed to the payee, he is authorised to collect performance from the drawee in his own name, and the drawee is authorised to render performance to the payee for the drawer's account (§ 783)";
    when anweisung_dem_empfaenger_ausgehaendigt(a);
    then anweisungsempfaenger_zur_erhebung_ermaechtigt(a);
}
@source(BGB_P783)
rule AngewiesenerErmaechtigt783(a: Anweisung) strict {
    label de official "Der Angewiesene ist ermächtigt, für Rechnung des Anweisenden an den Anweisungsempfänger zu leisten (§ 783)";
    label en unofficial "the drawee is authorised to render performance to the payee for the drawer's account (§ 783)";
    when anweisung_dem_empfaenger_ausgehaendigt(a);
    then angewiesener_zur_leistung_ermaechtigt(a);
}
@source(BGB_P784) {
    rule AnnahmeBegruendetLeistungspflicht784(a: Anweisung) strict {
        label de official "Nimmt der Angewiesene die Anweisung an, so ist er dem Anweisungsempfänger gegenüber zur Leistung verpflichtet (§ 784 Absatz 1 Satz 1)";
        label en unofficial "if the drawee accepts the instruction, he is obliged to perform towards the payee (§ 784 (1) sentence 1)";
        when angewiesener_nimmt_an_durch_schriftlichen_vermerk(a);
        then leistungspflicht_gegenueber_empfaenger_784(a);
    }
    rule AnnahmeVorAushaendigungErstMitAushaendigungWirksam784(a: Anweisung) strict {
        label de official "Ist der Vermerk auf die Anweisung vor der Aushändigung an den Anweisungsempfänger gesetzt worden, so wird die Annahme diesem gegenüber erst mit der Aushändigung wirksam (§ 784 Absatz 2 Satz 2)";
        label en unofficial "where the note was put on the instrument before it was handed to the payee, acceptance becomes effective towards him only upon handover (§ 784 (2) sentence 2)";
        when vermerk_vor_aushaendigung_gesetzt(a) and anweisung_dem_empfaenger_ausgehaendigt(a);
        then annahme_wirksam_erst_mit_aushaendigung_784(a);
    }
}
@source(BGB_P785)
rule LeistungspflichtNurGegenAushaendigung785(a: Anweisung) strict {
    label de official "Der Angewiesene ist nur gegen Aushändigung der Anweisung zur Leistung verpflichtet (§ 785)";
    label en unofficial "the drawee is only obliged to perform against handing over the instrument (§ 785)";
    when anweisung_dem_empfaenger_ausgehaendigt(a);
    then leistung_nur_zug_um_zug_gegen_aushaendigung_785(a);
}
@source(BGB_P787) {
    rule BefreiungBeiAnweisungAufSchuld787(a: Anweisung, betrag: Money) strict {
        label de official "Im Falle einer Anweisung auf Schuld wird der Angewiesene durch die Leistung in deren Höhe von der Schuld befreit (§ 787 Absatz 1)";
        label en unofficial "in the case of an instruction on a debt, the drawee is discharged from the debt to the extent of the performance (§ 787 (1))";
        when angewiesener_ist_schuldner_des_anweisenden(a) and leistung_bewirkt(a, betrag);
        then befreiung_von_schuld_787(a, betrag);
    }
    rule KeineVerpflichtungAusSchuldnerstellung787(a: Anweisung) strict {
        label de official "Zur Annahme der Anweisung oder zur Leistung an den Anweisungsempfänger ist der Angewiesene dem Anweisenden gegenüber nicht schon deshalb verpflichtet, weil er Schuldner des Anweisenden ist (§ 787 Absatz 2)";
        label en unofficial "the drawee is not obliged, towards the drawer, to accept the instruction or perform to the payee merely because he is the drawer's debtor (§ 787 (2))";
        when angewiesener_ist_schuldner_des_anweisenden(a);
        then keine_annahme_oder_leistungspflicht_allein_aus_schuldnerstellung_787(a);
    }
}
@source(BGB_P788)
rule LeistungsbewirkungImValutaverhaeltnis788(a: Anweisung) strict {
    label de official "Erteilt der Anweisende die Anweisung, um seinerseits eine Leistung an den Anweisungsempfänger zu bewirken, so wird diese Leistung, auch wenn der Angewiesene die Anweisung annimmt, erst mit der Leistung des Angewiesenen an den Anweisungsempfänger bewirkt (§ 788)";
    label en unofficial "where the drawer issues the instruction to render a performance of his own to the payee, that performance — even if the drawee accepts the instruction — is rendered only when the drawee performs to the payee (§ 788)";
    when anweisung_zwecks_eigener_leistung_erteilt(a) and leistung_des_angewiesenen_an_empfaenger_bewirkt(a);
    then leistung_des_anweisenden_bewirkt_788(a);
}
@source(BGB_P789) {
    rule AnzeigepflichtBeiVerweigerterAnnahme789(a: Anweisung) strict {
        label de official "Verweigert der Angewiesene vor dem Eintritt der Leistungszeit die Annahme der Anweisung, so hat der Anweisungsempfänger dem Anweisenden unverzüglich Anzeige zu machen (§ 789 Satz 1)";
        label en unofficial "where the drawee refuses to accept the instruction before the time for performance, the payee must notify the drawer without undue delay (§ 789 sentence 1)";
        when angewiesener_verweigert_annahme_vor_leistungszeit(a);
        then anzeigepflicht_789(a);
    }
    rule AnzeigepflichtBeiVerweigerterLeistung789(a: Anweisung) strict {
        label de official "Verweigert der Angewiesene die Leistung, so hat der Anweisungsempfänger dem Anweisenden unverzüglich Anzeige zu machen (§ 789 Satz 1)";
        label en unofficial "where the drawee refuses to perform, the payee must notify the drawer without undue delay (§ 789 sentence 1)";
        when angewiesener_verweigert_leistung(a);
        then anzeigepflicht_789(a);
    }
    rule AnzeigepflichtBeiNichtGeltendmachen789(a: Anweisung) strict {
        label de official "Kann oder will der Anweisungsempfänger die Anweisung nicht geltend machen, so hat er dem Anweisenden unverzüglich Anzeige zu machen (§ 789 Satz 2)";
        label en unofficial "where the payee cannot or will not assert the instruction, he must notify the drawer without undue delay (§ 789 sentence 2)";
        when empfaenger_kann_oder_will_anweisung_nicht_geltend_machen(a);
        then anzeigepflicht_789(a);
    }
}
pub relation anzeige_789_erfolgt_am(a: Anweisung, tag: Date) kind empirical {
    label de official "Der Anweisungsempfänger hat den Anweisenden angezeigt (§ 789)";
    label en unofficial "the payee notified the drawer (§ 789)";
}
pub relation anzeige_789_beginn_am(a: Anweisung, tag: Date) kind empirical {
    label de official "Beginn der Anzeigepflicht nach § 789";
    label en unofficial "start of the notification duty under § 789";
}
pub relation anweisungsempfaenger_789(a: Anweisung, p: Person) kind empirical {
    label de official "Anweisungsempfänger nach § 789";
    label en unofficial "payee under § 789";
}
@source(BGB_P789)
rule Position789AnzeigeAnnahme(a: Anweisung, p: Person, beginn: Date) strict {
    label de official "Der Anweisungsempfänger ist verpflichtet, die Verweigerung der Annahme anzuzeigen (§ 789)";
    label en unofficial "The payee is obliged to notify refusal to accept (§ 789)";
    when anweisungsempfaenger_789(a, p) and angewiesener_verweigert_annahme_vor_leistungszeit(a)
     and anzeige_789_beginn_am(a, beginn);
    then duty Duty789AnzeigeAnnahme {
        bearer p;
        achieve anzeige_789_erfolgt_am(a, beginn) during [beginn, infinity);
    };
}
@source(BGB_P789)
rule Position789AnzeigeLeistung(a: Anweisung, p: Person, beginn: Date) strict {
    label de official "Der Anweisungsempfänger ist verpflichtet, die Verweigerung der Leistung anzuzeigen (§ 789)";
    label en unofficial "The payee is obliged to notify refusal to perform (§ 789)";
    when anweisungsempfaenger_789(a, p) and angewiesener_verweigert_leistung(a)
     and anzeige_789_beginn_am(a, beginn);
    then duty Duty789AnzeigeLeistung {
        bearer p;
        achieve anzeige_789_erfolgt_am(a, beginn) during [beginn, infinity);
    };
}
@source(BGB_P790)
rule WiderrufDerAnweisung790(a: Anweisung) strict {
    label de official "Der Anweisende kann die Anweisung dem Angewiesenen gegenüber widerrufen, solange nicht der Angewiesene sie dem Anweisungsempfänger gegenüber angenommen oder die Leistung bewirkt hat (§ 790 Satz 1)";
    label en unofficial "the drawer may revoke the instruction towards the drawee as long as the drawee has not accepted it towards the payee or rendered performance (§ 790 sentence 1)";
    when anweisung_dem_empfaenger_ausgehaendigt(a) and not_known(angewiesener_hat_angenommen_oder_geleistet(a));
    then widerrufsrecht_790(a);
}
@source(BGB_P791)
rule AnweisungErlischtNichtBeiTodOderGeschaeftsunfaehigkeit791(a: Anweisung) strict {
    label de official "Die Anweisung erlischt nicht durch den Tod oder den Eintritt der Geschäftsunfähigkeit eines der Beteiligten (§ 791)";
    label en unofficial "the instruction is not extinguished by the death or incapacity of one of the parties (§ 791)";
    when anweisung_dem_empfaenger_ausgehaendigt(a) and tod_oder_geschaeftsunfaehigkeit_eines_beteiligten(a);
    then anweisung_erlischt_nicht_791(a);
}
@source(BGB_P792) {
    rule UebertragungDerAnweisung792(a: Anweisung, dritter: Person) strict {
        label de official "Der Anweisungsempfänger kann die Anweisung durch Vertrag mit einem Dritten auf diesen übertragen, auch wenn sie noch nicht angenommen worden ist; die Übertragungserklärung bedarf der schriftlichen Form, und die Aushändigung der Anweisung an den Dritten ist erforderlich (§ 792 Absatz 1)";
        label en unofficial "the payee may transfer the instruction to a third party by contract, even before it has been accepted; the declaration of transfer must be in writing, and the instrument must be handed over to the third party (§ 792 (1))";
        when uebertragungsvertrag_mit_drittem_geschlossen(a, dritter) and uebertragungserklaerung_schriftlich(a, dritter)
            and anweisung_an_dritten_ausgehaendigt(a, dritter);
        then uebertragung_wirksam_792(a, dritter);
    }
    rule AusschlussErsichtlichAusAnweisung792(a: Anweisung) strict {
        label de official "Die Ausschließung der Übertragung ist dem Angewiesenen gegenüber wirksam, wenn sie aus der Anweisung zu entnehmen ist (§ 792 Absatz 2)";
        label en unofficial "the exclusion of transfer is effective against the drawee where it appears from the instrument itself (§ 792 (2))";
        when uebertragung_durch_anweisenden_ausgeschlossen(a) and ausschluss_aus_anweisung_ersichtlich(a);
        then ausschluss_wirksam_gegenueber_angewiesenem_792(a);
    }
    rule AusschlussMitgeteiltVorAnnahmeOderLeistung792(a: Anweisung) strict {
        label de official "Die Ausschließung der Übertragung ist dem Angewiesenen gegenüber wirksam, wenn sie ihm vom Anweisenden mitgeteilt wird, bevor er die Anweisung annimmt oder die Leistung bewirkt (§ 792 Absatz 2)";
        label en unofficial "the exclusion of transfer is effective against the drawee where the drawer notifies him of it before he accepts the instruction or performs (§ 792 (2))";
        when uebertragung_durch_anweisenden_ausgeschlossen(a) and ausschluss_dem_angewiesenen_mitgeteilt_vor_annahme_oder_leistung(a);
        then ausschluss_wirksam_gegenueber_angewiesenem_792(a);
    }
    rule EinwendungsausschlussBeiAnnahmeGegenueberErwerber792(a: Anweisung, dritter: Person) strict {
        label de official "Nimmt der Angewiesene die Anweisung dem Erwerber gegenüber an, so kann er aus einem zwischen ihm und dem Anweisungsempfänger bestehenden Rechtsverhältnis Einwendungen nicht herleiten (§ 792 Absatz 3 Satz 1)";
        label en unofficial "if the drawee accepts the instruction towards the acquirer, he cannot raise objections arising from a legal relationship between himself and the payee (§ 792 (3) sentence 1)";
        when angewiesener_nimmt_gegenueber_erwerber_an(a, dritter);
        then einwendungen_aus_verhaeltnis_zum_empfaenger_ausgeschlossen_792(a, dritter);
    }
}

// ==================================================================================================
// TITEL 18 — LEIBRENTE (§§ 759–761, D-08-23)
// ==================================================================================================

pub entity Leibrentenversprechen {
    label de official "Vertrag, durch den eine Leibrente versprochen wird (§ 759 Absatz 1)";
    label en unofficial "contract promising a life annuity (§ 759 (1))";
}
pub relation leibrente_versprochen(lr: Leibrentenversprechen) kind empirical {
    label de official "Es ist eine Leibrente versprochen worden (§ 759 Absatz 1)";
    label en unofficial "a life annuity has been promised (§ 759 (1))";
}
pub relation abweichende_dauer_vereinbart_759(lr: Leibrentenversprechen) kind empirical {
    label de official "Es ist eine von der Lebensdauer des Gläubigers abweichende Dauer vereinbart (§ 759 Absatz 1)";
    label en unofficial "a duration other than the creditor's lifetime has been agreed (§ 759 (1))";
}
pub relation rente_fuer_lebensdauer_geschuldet_759(lr: Leibrentenversprechen) kind institutional {
    label de official "Die Rente ist im Zweifel für die Lebensdauer des Gläubigers zu entrichten (§ 759 Absatz 1)";
    label en unofficial "in case of doubt, the annuity must be paid for the creditor's lifetime (§ 759 (1))";
}
pub relation abweichender_betrag_vereinbart_759(lr: Leibrentenversprechen) kind empirical {
    label de official "Es ist vereinbart, dass der bestimmte Betrag nicht der Jahresbetrag ist (§ 759 Absatz 2)";
    label en unofficial "it has been agreed that the fixed amount is not the annual amount (§ 759 (2))";
}
pub relation betrag_ist_jahresbetrag_759(lr: Leibrentenversprechen) kind institutional {
    label de official "Der für die Rente bestimmte Betrag ist im Zweifel der Jahresbetrag der Rente (§ 759 Absatz 2)";
    label en unofficial "in case of doubt the amount fixed for the annuity is its annual amount (§ 759 (2))";
}
@source(BGB_P759) {
    rule RenteFuerLebensdauerImZweifel759(lr: Leibrentenversprechen) strict {
        label de official "Wer zur Gewährung einer Leibrente verpflichtet ist, hat die Rente im Zweifel für die Lebensdauer des Gläubigers zu entrichten (§ 759 Absatz 1)";
        label en unofficial "a person obliged to grant a life annuity must, in case of doubt, pay it for the creditor's lifetime (§ 759 (1))";
        when leibrente_versprochen(lr) and not_known(abweichende_dauer_vereinbart_759(lr));
        then rente_fuer_lebensdauer_geschuldet_759(lr);
    }
    rule BetragIstJahresbetragImZweifel759(lr: Leibrentenversprechen) strict {
        label de official "Der für die Rente bestimmte Betrag ist im Zweifel der Jahresbetrag der Rente (§ 759 Absatz 2)";
        label en unofficial "in case of doubt the amount fixed for the annuity is its annual amount (§ 759 (2))";
        when leibrente_versprochen(lr) and not_known(abweichender_betrag_vereinbart_759(lr));
        then betrag_ist_jahresbetrag_759(lr);
    }
}
pub relation rente_759_entrichtet_am(lr: Leibrentenversprechen, tag: Date) kind empirical {
    label de official "Die Leibrente wurde entrichtet (§ 759)";
    label en unofficial "the life annuity was paid (§ 759)";
}
pub relation rente_759_beginn_am(lr: Leibrentenversprechen, tag: Date) kind empirical {
    label de official "Beginn der Rentenleistung nach § 759";
    label en unofficial "start of annuity payments under § 759";
}
pub relation rentenschuldner_759(lr: Leibrentenversprechen, p: Person) kind empirical {
    label de official "Rentenschuldner nach § 759";
    label en unofficial "annuity debtor under § 759";
}
@source(BGB_P759)
rule Position759Rente(lr: Leibrentenversprechen, p: Person, beginn: Date) strict {
    label de official "Der Rentenschuldner ist verpflichtet, die Leibrente für die Lebensdauer des Gläubigers zu entrichten (§ 759)";
    label en unofficial "The annuity debtor is obliged to pay the life annuity for the creditor's lifetime (§ 759)";
    when rentenschuldner_759(lr, p) and leibrente_versprochen(lr)
     and not_known(abweichende_dauer_vereinbart_759(lr))
     and rente_759_beginn_am(lr, beginn);
    then duty Duty759Rente {
        bearer p;
        achieve rente_759_entrichtet_am(lr, beginn) during [beginn, infinity);
    };
}

pub relation geldrente_vereinbart_760(lr: Leibrentenversprechen) kind empirical {
    label de official "Es ist eine Geldrente vereinbart (§ 760 Absatz 2 Satz 1)";
    label en unofficial "a money annuity has been agreed (§ 760 (2) sentence 1)";
}
pub relation vorauszahlungszeitraum_geldrente_760(lr: Leibrentenversprechen, monate: Integer) kind institutional {
    label de official "Zeitraum, für den eine Geldrente vorauszuzahlen ist, in Monaten (§ 760 Absatz 2 Satz 1)";
    label en unofficial "period for which a money annuity must be paid in advance, in months (§ 760 (2) sentence 1)";
}
pub relation glaeubiger_hat_beginn_des_zeitabschnitts_erlebt_760(lr: Leibrentenversprechen) kind empirical {
    label de official "Der Gläubiger hat den Beginn des Zeitabschnitts erlebt, für den die Rente im Voraus zu entrichten ist (§ 760 Absatz 3)";
    label en unofficial "the creditor has lived to see the beginning of the period for which the annuity is to be paid in advance (§ 760 (3))";
}
pub relation voller_betrag_des_zeitabschnitts_gebuehrt_760(lr: Leibrentenversprechen) kind institutional {
    label de official "Dem Gläubiger gebührt der volle auf den Zeitabschnitt entfallende Betrag (§ 760 Absatz 3)";
    label en unofficial "the creditor is entitled to the full amount pertaining to that period (§ 760 (3))";
}
@source(BGB_P760) {
    rule Vorauszahlungszeitraum760DreiMonate(lr: Leibrentenversprechen) strict {
        label de official "Eine Geldrente ist für drei Monate vorauszuzahlen (§ 760 Absatz 2 Satz 1)";
        label en unofficial "a money annuity must be paid three months in advance (§ 760 (2) sentence 1)";
        when geldrente_vereinbart_760(lr);
        then vorauszahlungszeitraum_geldrente_760(lr, 3);
    }
    rule VollerBetragBeiErlebtemZeitabschnittsbeginn760(lr: Leibrentenversprechen) strict {
        label de official "Hat der Gläubiger den Beginn des Zeitabschnitts erlebt, für den die Rente im Voraus zu entrichten ist, so gebührt ihm der volle auf den Zeitabschnitt entfallende Betrag (§ 760 Absatz 3)";
        label en unofficial "where the creditor has lived to see the beginning of the period for which the annuity is to be paid in advance, he is entitled to the full amount pertaining to that period (§ 760 (3))";
        when glaeubiger_hat_beginn_des_zeitabschnitts_erlebt_760(lr);
        then voller_betrag_des_zeitabschnitts_gebuehrt_760(lr);
    }
}

pub relation schriftliche_erteilung_761_eingehalten(lr: Leibrentenversprechen) kind empirical {
    label de official "Das Leibrentenversprechen ist schriftlich erteilt worden (§ 761 Satz 1)";
    label en unofficial "the promise of a life annuity has been given in writing (§ 761 sentence 1)";
}
pub relation andere_form_761_vorgeschrieben(lr: Leibrentenversprechen) kind empirical {
    label de official "Eine andere Form ist für das Leibrentenversprechen vorgeschrieben (§ 761 Satz 1)";
    label en unofficial "a different form is prescribed for the promise of a life annuity (§ 761 sentence 1)";
}
pub relation leibrentenversprechen_761_formgueltig(lr: Leibrentenversprechen) kind institutional {
    label de official "Das Leibrentenversprechen genügt der erforderlichen Form (§ 761 Satz 1)";
    label en unofficial "the promise of a life annuity satisfies the required form (§ 761 sentence 1)";
}
@source(BGB_P761)
rule Leibrentenversprechen761FormgueltigDurchSchrift(lr: Leibrentenversprechen) strict {
    label de official "Zur Gültigkeit eines Vertrags, durch den eine Leibrente versprochen wird, ist, soweit nicht eine andere Form vorgeschrieben ist, schriftliche Erteilung des Versprechens erforderlich (§ 761 Satz 1)";
    label en unofficial "for the validity of a contract promising a life annuity, written form is required unless another form is prescribed (§ 761 sentence 1)";
    when schriftliche_erteilung_761_eingehalten(lr) and not_known(andere_form_761_vorgeschrieben(lr));
    then leibrentenversprechen_761_formgueltig(lr);
}

// ==================================================================================================
// TITEL 19 — SPIEL, WETTE (§§ 762–763); TITEL 21 VERGLEICH (§ 779);
// TITEL 22 SCHULDVERSPRECHEN (§§ 780–782); TITEL 24 INHABERSCHULDVERSCHREIBUNG
// (§§ 793, 801); TITEL 25 VORLEGUNG VON SACHEN (§§ 809–811)
// ==================================================================================================

pub entity Rechtsgeschaeft {
    label de official "Einzelnes Rechtsgeschäft der Titel 19, 21, 22, 24 und 25 (Spiel, Wette, Vergleich, Schuldversprechen, Schuldverschreibung, Vorlegung)";
    label en unofficial "individual transaction of titles 19, 21, 22, 24 and 25 (game, wager, settlement, promise of debt, bearer bond, production of things)";
}

pub relation spiel_oder_wette(rg: Rechtsgeschaeft) kind empirical {
    label de official "Spiel oder Wette (§ 762 Absatz 1 Satz 1)";
    label en unofficial "game or wager (§ 762 (1) sentence 1)";
}
pub relation staatlich_genehmigte_lotterie(rg: Rechtsgeschaeft) kind empirical {
    label de official "Lotterie- oder Ausspielvertrag, bei dem die Lotterie oder die Ausspielung staatlich genehmigt ist (§ 763 Satz 1)";
    label en unofficial "lottery or raffle contract where the lottery or raffle is licensed by the State (§ 763 sentence 1)";
}
pub relation unvollkommene_verbindlichkeit(rg: Rechtsgeschaeft) kind institutional {
    label de official "Durch Spiel oder durch Wette wird eine Verbindlichkeit nicht begründet; das Geleistete kann nicht deshalb zurückgefordert werden, weil eine Verbindlichkeit nicht bestanden hat (§ 762 Absatz 1)";
    label en unofficial "a game or wager does not create an obligation; what has been rendered cannot be reclaimed on the ground that no obligation existed (§ 762 (1))";
}
pub relation lotterievertrag_verbindlich(rg: Rechtsgeschaeft) kind institutional {
    label de official "Ein Lotterievertrag oder ein Ausspielvertrag ist verbindlich, wenn die Lotterie oder die Ausspielung staatlich genehmigt ist (§ 763 Satz 1)";
    label en unofficial "a lottery or raffle contract is binding where the lottery or raffle is licensed by the State (§ 763 sentence 1)";
}
pub relation vergleich_geschlossen(rg: Rechtsgeschaeft) kind empirical {
    label de official "Vertrag, durch den der Streit oder die Ungewissheit der Parteien über ein Rechtsverhältnis im Wege gegenseitigen Nachgebens beseitigt wird (§ 779 Absatz 1)";
    label en unofficial "contract by which the parties' dispute or uncertainty about a legal relationship is removed by mutual concession (§ 779 (1))";
}
pub relation zugrunde_gelegter_sachverhalt_unrichtig(rg: Rechtsgeschaeft) kind empirical {
    label de official "Der nach dem Inhalt des Vertrags als feststehend zugrunde gelegte Sachverhalt entspricht der Wirklichkeit nicht und der Streit oder die Ungewissheit wäre bei Kenntnis der Sachlage nicht entstanden (§ 779 Absatz 1)";
    label en unofficial "the facts assumed as established under the contract do not correspond to reality and the dispute or uncertainty would not have arisen had the true position been known (§ 779 (1))";
}
pub relation vergleich_unwirksam(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Vergleich ist unwirksam (§ 779 Absatz 1)";
    label en unofficial "the settlement is void (§ 779 (1))";
}
pub relation schuldversprechen_oder_anerkenntnis(rg: Rechtsgeschaeft) kind empirical {
    label de official "Selbständiges Schuldversprechen oder Schuldanerkenntnis (§§ 780, 781)";
    label en unofficial "independent promise of debt or acknowledgement of debt (§§ 780, 781)";
}
pub relation schriftlich_erteilt(rg: Rechtsgeschaeft) kind empirical {
    label de official "Das Versprechen beziehungsweise die Anerkennungserklärung ist schriftlich erteilt (§ 780 Satz 1, § 781 Satz 1)";
    label en unofficial "the promise or the acknowledgement has been given in writing (§ 780 sentence 1, § 781 sentence 1)";
}
pub relation in_elektronischer_form_erteilt(rg: Rechtsgeschaeft) kind empirical {
    label de official "Das Versprechen beziehungsweise die Anerkennungserklärung ist in elektronischer Form erteilt — nach § 780 Satz 2, § 781 Satz 2 ausgeschlossen";
    label en unofficial "the promise or acknowledgement was given in electronic form — excluded by § 780 sentence 2, § 781 sentence 2";
}
pub relation auf_grund_abrechnung_oder_vergleich_erteilt(rg: Rechtsgeschaeft) kind empirical {
    label de official "Das Schuldversprechen oder Schuldanerkenntnis ist auf Grund einer Abrechnung oder im Wege des Vergleichs erteilt — die schriftliche Form ist dann nicht erforderlich (§ 782)";
    label en unofficial "the promise or acknowledgement was given on the basis of an account or by way of settlement — written form is then not required (§ 782)";
}
pub relation schuldversprechen_gueltig(rg: Rechtsgeschaeft) kind institutional {
    label de official "Das Schuldversprechen oder Schuldanerkenntnis ist gültig (§§ 780, 781, 782)";
    label en unofficial "the promise or acknowledgement of debt is valid (§§ 780, 781, 782)";
}
pub relation vorlegungsfrist_801(f: Frist) kind empirical {
    key(f);
    label de official "Vorlegungsfrist des § 801 Absatz 1 Satz 1: 30 Jahre nach dem Eintritt der für die Leistung bestimmten Zeit";
    label en unofficial "the presentation period of § 801 (1) sentence 1: 30 years after the time determined for performance";
}
pub relation leistungszeit_eingetreten_am(f: Frist, tag: Date) kind empirical {
    key(f);
    label de official "Tag, an dem die für die Leistung bestimmte Zeit eingetreten ist (§ 801 Absatz 1 Satz 1)";
    label en unofficial "day on which the time determined for performance arrived (§ 801 (1) sentence 1)";
}
pub relation vorlegungsfrist_zinsschein_801(f: Frist) kind empirical {
    key(f);
    label de official "Vorlegungsfrist des § 801 Absatz 2 Satz 1: vier Jahre bei Zins-, Renten- und Gewinnanteilscheinen, beginnend mit dem Schluss des Jahres, in welchem die für die Leistung bestimmte Zeit eintritt";
    label en unofficial "the presentation period of § 801 (2) sentence 1: four years for interest, annuity and dividend coupons, beginning with the end of the year in which the time determined for performance arrives";
}
pub relation schluss_des_jahres_der_leistungszeit(f: Frist, tag: Date) kind empirical {
    key(f);
    label de official "Schluss des Jahres, in welchem die für die Leistung bestimmte Zeit eintritt (§ 801 Absatz 2 Satz 2)";
    label en unofficial "end of the year in which the time determined for performance arrives (§ 801 (2) sentence 2)";
}
pub relation schuldverschreibung_mit_vorlegungsfrist(rg: Rechtsgeschaeft, f: Frist) kind empirical {
    key(rg);
    label de official "Schuldverschreibung auf den Inhaber und die für sie laufende Vorlegungsfrist (§ 801 Absatz 1, 2)";
    label en unofficial "bearer bond and the presentation period running for it (§ 801 (1), (2))";
}
pub relation urkunde_rechtzeitig_vorgelegt(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Urkunde ist vor dem Ablauf der Vorlegungsfrist dem Aussteller zur Einlösung vorgelegt worden; der Vorlegung steht die gerichtliche Geltendmachung gleich (§ 801 Absatz 1 Sätze 1, 3)";
    label en unofficial "the instrument was presented to the issuer for redemption before the presentation period expired; judicial assertion of the claim is equivalent to presentation (§ 801 (1) sentences 1, 3)";
}
pub relation anspruch_aus_schuldverschreibung_erloschen(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Anspruch aus einer Schuldverschreibung auf den Inhaber erlischt (§ 801 Absatz 1 Satz 1)";
    label en unofficial "the claim under a bearer bond is extinguished (§ 801 (1) sentence 1)";
}
pub relation rechtliches_interesse_an_einsicht(rg: Rechtsgeschaeft, p: Person) kind empirical {
    label de official "Jemand hat ein rechtliches Interesse daran, eine in fremdem Besitz befindliche Urkunde einzusehen, und die Urkunde ist in seinem Interesse errichtet oder beurkundet ein ihn betreffendes Rechtsverhältnis (§ 810)";
    label en unofficial "a person has a legal interest in inspecting a document in another's possession and the document was drawn up in his interest or records a legal relationship concerning him (§ 810)";
}
pub relation anspruch_auf_einsicht(rg: Rechtsgeschaeft, p: Person) kind institutional {
    label de official "Der Berechtigte kann von dem Besitzer die Gestattung der Einsicht verlangen (§ 810)";
    label en unofficial "the entitled person may demand that the possessor permit inspection (§ 810)";
}

// --- Titel 24, Fortsetzung: Schuldverschreibung auf den Inhaber (§§ 793, 794, 796–800, 803–808) ---

pub relation schuldverschreibung_ausgestellt(rg: Rechtsgeschaeft) kind empirical {
    label de official "Jemand hat eine Urkunde ausgestellt, in der er dem Inhaber der Urkunde eine Leistung verspricht (Schuldverschreibung auf den Inhaber, § 793 Absatz 1 Satz 1)";
    label en unofficial "a person has issued a document in which he promises performance to the bearer of the document (bearer bond, § 793 (1) sentence 1)";
}
pub relation inhaber_nicht_verfuegungsberechtigt(rg: Rechtsgeschaeft) kind empirical {
    label de official "Der Inhaber ist zur Verfügung über die Urkunde nicht berechtigt (§ 793 Absatz 1 Satz 1 Halbsatz 2)";
    label en unofficial "the bearer is not entitled to dispose of the document (§ 793 (1) sentence 1 second half-sentence)";
}
pub relation anspruch_auf_leistung_793(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Inhaber kann von dem Aussteller die Leistung nach Maßgabe des Versprechens verlangen (§ 793 Absatz 1 Satz 1)";
    label en unofficial "the bearer may demand performance from the issuer in accordance with the promise (§ 793 (1) sentence 1)";
}
pub relation leistung_an_inhaber_befreiend_793(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Aussteller wird auch durch die Leistung an einen nicht zur Verfügung berechtigten Inhaber befreit (§ 793 Absatz 1 Satz 2)";
    label en unofficial "the issuer is discharged even by performance to a bearer who is not entitled to dispose of the document (§ 793 (1) sentence 2)";
}
pub relation ohne_willen_in_verkehr_gelangt(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Urkunde ist dem Aussteller gestohlen worden oder verloren gegangen oder sonst ohne seinen Willen in den Verkehr gelangt (§ 794 Absatz 1)";
    label en unofficial "the document was stolen from, or lost by, the issuer or otherwise entered circulation without his consent (§ 794 (1))";
}
pub relation haftung_trotz_unfreiwilligen_umlaufs_794(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Aussteller wird aus der Schuldverschreibung auch dann verpflichtet, wenn sie ihm gestohlen worden oder verloren gegangen oder sonst ohne seinen Willen in den Verkehr gelangt ist (§ 794 Absatz 1)";
    label en unofficial "the issuer is bound by the bearer bond even where it was stolen, lost or otherwise entered circulation without his consent (§ 794 (1))";
}
pub relation ausgabe_nach_tod_oder_geschaeftsunfaehigkeit_794(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Urkunde wird ausgegeben, nachdem der Aussteller gestorben oder geschäftsunfähig geworden ist (§ 794 Absatz 2)";
    label en unofficial "the document is issued after the issuer has died or become incapable of contracting (§ 794 (2))";
}
pub relation wirksamkeit_unberuehrt_794(rg: Rechtsgeschaeft) kind institutional {
    label de official "Auf die Wirksamkeit der Schuldverschreibung auf den Inhaber ist es ohne Einfluss, dass sie ausgegeben wird, nachdem der Aussteller gestorben oder geschäftsunfähig geworden ist (§ 794 Absatz 2)";
    label en unofficial "the effectiveness of the bearer bond is unaffected by its issuance after the issuer has died or become incapable of contracting (§ 794 (2))";
}
pub relation einwendung_betrifft_gueltigkeit_der_ausstellung(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Einwendung betrifft die Gültigkeit der Ausstellung (§ 796)";
    label en unofficial "the objection concerns the validity of the issuance (§ 796)";
}
pub relation einwendung_ergibt_sich_aus_urkunde(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Einwendung ergibt sich aus der Urkunde (§ 796)";
    label en unofficial "the objection arises from the document itself (§ 796)";
}
pub relation einwendung_unmittelbar_gegen_inhaber_796(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Einwendung steht dem Aussteller unmittelbar gegen den Inhaber zu (§ 796)";
    label en unofficial "the issuer has the objection directly against the bearer (§ 796)";
}
pub relation einwendung_zulaessig_796(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Aussteller kann dem Inhaber der Schuldverschreibung nur solche Einwendungen entgegensetzen, welche die Gültigkeit der Ausstellung betreffen oder sich aus der Urkunde ergeben oder dem Aussteller unmittelbar gegen den Inhaber zustehen (§ 796)";
    label en unofficial "the issuer may raise against the bearer only objections concerning the validity of the issuance, arising from the document, or available to the issuer directly against the bearer (§ 796)";
}
pub relation urkunde_ausgehaendigt_797(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Schuldverschreibung wird dem Aussteller ausgehändigt (§ 797 Satz 1, 2)";
    label en unofficial "the document is handed over to the issuer (§ 797 sentences 1, 2)";
}
pub relation leistungspflicht_nur_gegen_aushaendigung_797(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Aussteller ist nur gegen Aushändigung der Schuldverschreibung zur Leistung verpflichtet (§ 797 Satz 1)";
    label en unofficial "the issuer is only obliged to perform against handing over the bearer bond (§ 797 sentence 1)";
}
pub relation eigentum_an_urkunde_erworben_797(rg: Rechtsgeschaeft) kind institutional {
    label de official "Mit der Aushändigung erwirbt der Aussteller das Eigentum an der Urkunde, auch wenn der Inhaber zur Verfügung über sie nicht berechtigt ist (§ 797 Satz 2)";
    label en unofficial "upon handover the issuer acquires ownership of the document, even where the bearer was not entitled to dispose of it (§ 797 sentence 2)";
}
pub relation urkunde_beschaedigt_oder_verunstaltet_zum_umlauf_ungeeignet(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Schuldverschreibung auf den Inhaber ist infolge einer Beschädigung oder einer Verunstaltung zum Umlauf nicht mehr geeignet (§ 798 Satz 1)";
    label en unofficial "the bearer bond has become unfit for circulation due to damage or disfigurement (§ 798 sentence 1)";
}
pub relation wesentlicher_inhalt_und_unterscheidungsmerkmale_erkennbar(rg: Rechtsgeschaeft) kind empirical {
    label de official "Der wesentliche Inhalt und die Unterscheidungsmerkmale der Urkunde sind noch mit Sicherheit erkennbar (§ 798 Satz 1)";
    label en unofficial "the essential content and distinguishing features of the document are still recognisable with certainty (§ 798 sentence 1)";
}
pub relation anspruch_auf_ersatzurkunde_798(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Inhaber kann von dem Aussteller die Erteilung einer neuen Schuldverschreibung auf den Inhaber gegen Aushändigung der beschädigten oder verunstalteten verlangen (§ 798 Satz 1)";
    label en unofficial "the bearer may demand a new bearer bond from the issuer against handing over the damaged or disfigured one (§ 798 sentence 1)";
}
pub relation kosten_der_ersatzurkunde_vom_inhaber_zu_tragen_798(rg: Rechtsgeschaeft) kind institutional {
    label de official "Die Kosten der Ersatzurkunde hat der Inhaber zu tragen und vorzuschießen (§ 798 Satz 2)";
    label en unofficial "the bearer bears and must advance the costs of the replacement document (§ 798 sentence 2)";
}
pub relation urkunde_abhanden_gekommen_oder_vernichtet_799(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Schuldverschreibung auf den Inhaber ist abhanden gekommen oder vernichtet (§ 799 Absatz 1 Satz 1)";
    label en unofficial "the bearer bond has been lost or destroyed (§ 799 (1) sentence 1)";
}
pub relation gegenteiliges_in_urkunde_bestimmt_799(rg: Rechtsgeschaeft) kind empirical {
    label de official "In der Urkunde ist das Gegenteil bestimmt (§ 799 Absatz 1 Satz 1 Halbsatz 2)";
    label en unofficial "the document provides otherwise (§ 799 (1) sentence 1 second half-sentence)";
}
pub relation zins_renten_oder_gewinnanteilschein_oder_sichtwechsel_799(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Urkunde ist ein Zins-, Renten- oder Gewinnanteilschein oder eine auf Sicht zahlbare unverzinsliche Schuldverschreibung (§ 799 Absatz 1 Satz 2)";
    label en unofficial "the document is an interest, annuity or dividend coupon, or a non-interest-bearing bond payable at sight (§ 799 (1) sentence 2)";
}
pub relation kraftloserklaerung_im_aufgebotsverfahren_moeglich_799(rg: Rechtsgeschaeft) kind institutional {
    label de official "Die Schuldverschreibung kann im Wege des Aufgebotsverfahrens für kraftlos erklärt werden (§ 799 Absatz 1 Satz 1)";
    label en unofficial "the bond may be declared void by way of public notice proceedings (§ 799 (1) sentence 1)";
}
pub relation verlangen_auf_auskunft_799(rg: Rechtsgeschaeft) kind empirical {
    label de official "Der bisherige Inhaber verlangt vom Aussteller die zur Erwirkung des Aufgebots oder der Zahlungssperre erforderliche Auskunft (§ 799 Absatz 2 Satz 1)";
    label en unofficial "the former bearer demands from the issuer the information needed to obtain the public notice or payment block (§ 799 (2) sentence 1)";
}
pub relation auskunfts_und_zeugnispflicht_799(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Aussteller ist verpflichtet, dem bisherigen Inhaber auf Verlangen die erforderliche Auskunft zu erteilen und die erforderlichen Zeugnisse auszustellen (§ 799 Absatz 2 Satz 1)";
    label en unofficial "the issuer must, on request, give the former bearer the necessary information and issue the necessary certificates (§ 799 (2) sentence 1)";
}
pub relation fuer_kraftlos_erklaert_800(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Schuldverschreibung auf den Inhaber ist für kraftlos erklärt (§ 800 Satz 1)";
    label en unofficial "the bearer bond has been declared void (§ 800 sentence 1)";
}
pub relation ausschliessungsbeschluss_erwirkt_800(rg: Rechtsgeschaeft, p: Person) kind empirical {
    label de official "Derjenige hat den Ausschließungsbeschluss erwirkt (§ 800 Satz 1)";
    label en unofficial "that person obtained the exclusion decision (§ 800 sentence 1)";
}
pub relation anspruch_auf_neue_urkunde_800(rg: Rechtsgeschaeft, p: Person) kind institutional {
    label de official "Wer den Ausschließungsbeschluss erwirkt hat, kann von dem Aussteller die Erteilung einer neuen Schuldverschreibung auf den Inhaber anstelle der für kraftlos erklärten verlangen (§ 800 Satz 1)";
    label en unofficial "the person who obtained the exclusion decision may demand a new bearer bond from the issuer in place of the one declared void (§ 800 sentence 1)";
}
pub relation inhaber_widerspricht_ausgabe_der_scheine(rg: Rechtsgeschaeft) kind empirical {
    label de official "Der Inhaber der Schuldverschreibung hat der Ausgabe neuer Zins- oder Rentenscheine widersprochen (§ 805 Satz 1)";
    label en unofficial "the bearer of the bond has objected to the issue of new interest or annuity coupons (§ 805 sentence 1)";
}
pub relation neue_scheine_duerfen_nicht_ausgegeben_werden_805(rg: Rechtsgeschaeft) kind institutional {
    label de official "Neue Zins- oder Rentenscheine dürfen an den Inhaber des Erneuerungsscheins nicht ausgegeben werden (§ 805 Satz 1)";
    label en unofficial "new interest or annuity coupons may not be issued to the holder of the renewal certificate (§ 805 sentence 1)";
}
pub relation inhaber_legt_schuldverschreibung_vor_805(rg: Rechtsgeschaeft) kind empirical {
    label de official "Der Inhaber der Schuldverschreibung legt diese vor (§ 805 Satz 2)";
    label en unofficial "the bearer of the bond presents it (§ 805 sentence 2)";
}
pub relation scheine_dem_inhaber_auszuhaendigen_805(rg: Rechtsgeschaeft) kind institutional {
    label de official "Die Scheine sind dem Inhaber der Schuldverschreibung auszuhändigen (§ 805 Satz 2)";
    label en unofficial "the coupons must be handed over to the bearer of the bond (§ 805 sentence 2)";
}
pub relation keine_pflicht_zur_umschreibung_806(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Aussteller ist zur Umschreibung der Schuldverschreibung auf den Namen eines bestimmten Berechtigten nicht verpflichtet (§ 806 Satz 2)";
    label en unofficial "the issuer is not obliged to convert the bearer bond into a registered bond for a specific person (§ 806 sentence 2)";
}
pub relation karte_oder_marke_ohne_glaeubigerbezeichnung(rg: Rechtsgeschaeft) kind empirical {
    label de official "Karten, Marken oder ähnliche Urkunden werden ausgegeben, in denen ein Gläubiger nicht bezeichnet ist (§ 807)";
    label en unofficial "cards, tokens or similar documents are issued that do not name a creditor (§ 807)";
}
pub relation umstaende_zeigen_verpflichtungswillen_gegenueber_inhaber(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Umstände der Ausgabe ergeben, dass der Aussteller dem Inhaber zu einer Leistung verpflichtet sein will (§ 807)";
    label en unofficial "the circumstances of issuance show that the issuer intends to be bound to perform to the bearer (§ 807)";
}
pub relation urkunde_mit_inhaberklausel_ausgegeben(rg: Rechtsgeschaeft) kind empirical {
    label de official "Eine Urkunde, in welcher der Gläubiger benannt ist, wird mit der Bestimmung ausgegeben, dass die versprochene Leistung an jeden Inhaber bewirkt werden kann (§ 808 Absatz 1 Satz 1)";
    label en unofficial "a document naming the creditor is issued with a clause that the promised performance may be rendered to any bearer (§ 808 (1) sentence 1)";
}
pub relation leistung_an_inhaber_befreiend_808(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Schuldner wird durch die Leistung an den Inhaber der Urkunde befreit (§ 808 Absatz 1 Satz 1)";
    label en unofficial "the debtor is discharged by performance to the bearer of the document (§ 808 (1) sentence 1)";
}
pub relation inhaber_nicht_berechtigt_leistung_zu_verlangen_808(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Inhaber ist nicht berechtigt, die Leistung zu verlangen (§ 808 Absatz 1 Satz 2)";
    label en unofficial "the bearer is not entitled to demand performance (§ 808 (1) sentence 2)";
}
pub relation leistungspflicht_nur_gegen_aushaendigung_808(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Schuldner ist nur gegen Aushändigung der Urkunde zur Leistung verpflichtet (§ 808 Absatz 2 Satz 1)";
    label en unofficial "the debtor is only obliged to perform against handing over the document (§ 808 (2) sentence 1)";
}
pub relation urkunde_abhanden_oder_vernichtet_808(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Urkunde des § 808 ist abhanden gekommen oder vernichtet (§ 808 Absatz 2 Satz 2)";
    label en unofficial "the document under § 808 has been lost or destroyed (§ 808 (2) sentence 2)";
}
pub relation anderes_in_urkunde_bestimmt_808(rg: Rechtsgeschaeft) kind empirical {
    label de official "In der Urkunde ist ein anderes bestimmt (§ 808 Absatz 2 Satz 2 Halbsatz 2)";
    label en unofficial "the document provides otherwise (§ 808 (2) sentence 2 second half-sentence)";
}
pub relation kraftloserklaerung_moeglich_808(rg: Rechtsgeschaeft) kind institutional {
    label de official "Die Urkunde kann im Wege des Aufgebotsverfahrens für kraftlos erklärt werden (§ 808 Absatz 2 Satz 2)";
    label en unofficial "the document may be declared void by way of public notice proceedings (§ 808 (2) sentence 2)";
}
pub relation verlust_von_schein_angezeigt_vor_fristablauf(rg: Rechtsgeschaeft) kind empirical {
    label de official "Ein Zins-, Renten- oder Gewinnanteilschein ist abhanden gekommen oder vernichtet, und der bisherige Inhaber hat den Verlust dem Aussteller vor dem Ablauf der Vorlegungsfrist angezeigt (§ 804 Absatz 1 Satz 1)";
    label en unofficial "an interest, annuity or dividend coupon has been lost or destroyed, and the former holder notified the issuer of the loss before the presentation period expired (§ 804 (1) sentence 1)";
}
pub relation schein_zur_einloesung_vorgelegt_oder_gerichtlich_geltend_gemacht(rg: Rechtsgeschaeft) kind empirical {
    label de official "Der abhanden gekommene Schein ist dem Aussteller zur Einlösung vorgelegt oder der Anspruch aus dem Schein ist gerichtlich geltend gemacht worden (§ 804 Absatz 1 Satz 2 Halbsatz 1)";
    label en unofficial "the lost coupon has been presented to the issuer for redemption or the claim under it has been judicially asserted (§ 804 (1) sentence 2 first half-sentence)";
}
pub relation vorlegung_oder_geltendmachung_nach_fristablauf(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Vorlegung oder die gerichtliche Geltendmachung ist erst nach dem Ablauf der Vorlegungsfrist erfolgt (§ 804 Absatz 1 Satz 2 Halbsatz 2)";
    label en unofficial "the presentation or judicial assertion occurred only after the presentation period had expired (§ 804 (1) sentence 2 second half-sentence)";
}
pub relation ausschluss_im_schein_vereinbart_804(rg: Rechtsgeschaeft) kind empirical {
    label de official "In dem Zins-, Renten- oder Gewinnanteilschein ist der Anspruch des Absatzes 1 ausgeschlossen (§ 804 Absatz 2)";
    label en unofficial "the coupon excludes the claim under paragraph 1 (§ 804 (2))";
}
pub relation anspruch_auf_leistung_nach_fristablauf_804(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der bisherige Inhaber kann nach dem Ablauf der Vorlegungsfrist die Leistung von dem Aussteller verlangen (§ 804 Absatz 1 Satz 1)";
    label en unofficial "after the presentation period expires the former holder may demand performance from the issuer (§ 804 (1) sentence 1)";
}
pub relation anspruch_ausgeschlossen_804(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Anspruch des Absatzes 1 ist ausgeschlossen (§ 804 Absatz 1 Satz 2)";
    label en unofficial "the claim under paragraph 1 is excluded (§ 804 (1) sentence 2)";
}
pub relation zinsscheine_ausgegeben(rg: Rechtsgeschaeft) kind empirical {
    label de official "Für eine Schuldverschreibung auf den Inhaber werden Zinsscheine ausgegeben (§ 803 Absatz 1)";
    label en unofficial "interest coupons are issued for a bearer bond (§ 803 (1))";
}
pub relation gegenteilige_bestimmung_der_zinsscheine(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Zinsscheine enthalten eine gegenteilige Bestimmung (§ 803 Absatz 1 Halbsatz 2)";
    label en unofficial "the coupons contain a provision to the contrary (§ 803 (1) second half-sentence)";
}
pub relation zinsscheine_bleiben_in_kraft_803(rg: Rechtsgeschaeft) kind institutional {
    label de official "Die Zinsscheine bleiben in Kraft, auch wenn die Hauptforderung erlischt oder die Verpflichtung zur Verzinsung aufgehoben oder geändert wird (§ 803 Absatz 1)";
    label en unofficial "the coupons remain in force even where the principal claim is extinguished or the obligation to pay interest is cancelled or altered (§ 803 (1))";
}
pub relation zinsscheine_bei_einloesung_nicht_zurueckgegeben_803(rg: Rechtsgeschaeft) kind empirical {
    label de official "Die Zinsscheine werden bei der Einlösung der Hauptschuldverschreibung nicht zurückgegeben (§ 803 Absatz 2)";
    label en unofficial "the coupons are not returned when the principal bond is redeemed (§ 803 (2))";
}
pub relation aussteller_darf_betrag_zurueckbehalten_803(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Aussteller ist berechtigt, den Betrag zurückzubehalten, den er für die nicht zurückgegebenen Zinsscheine zu zahlen verpflichtet ist (§ 803 Absatz 2)";
    label en unofficial "the issuer is entitled to withhold the amount he would owe for the coupons that were not returned (§ 803 (2))";
}

// --- Titel 25, Fortsetzung: Vorlegung von Sachen (§§ 809, 811) --------------------------------

pub relation rechtliches_interesse_an_besichtigung(rg: Rechtsgeschaeft, sache: Sache, p: Person) kind empirical {
    label de official "Jemand hat gegen den Besitzer einer Sache einen Anspruch in Ansehung der Sache oder will sich Gewissheit verschaffen, ob ihm ein solcher Anspruch zusteht, und die Besichtigung ist deshalb für ihn von Interesse (§ 809)";
    label en unofficial "a person has a claim against the possessor of a thing in respect of the thing, or wishes to ascertain whether such a claim exists, and inspection is therefore of interest to him (§ 809)";
}
pub relation anspruch_auf_besichtigung_809(rg: Rechtsgeschaeft, sache: Sache, p: Person) kind institutional {
    label de official "Der Berechtigte kann verlangen, dass der Besitzer ihm die Sache zur Besichtigung vorlegt oder die Besichtigung gestattet (§ 809)";
    label en unofficial "the entitled person may demand that the possessor present the thing for inspection or permit inspection (§ 809)";
}
pub relation vorlegungsverlangen_wichtiger_grund_fuer_anderen_ort(rg: Rechtsgeschaeft) kind empirical {
    label de official "Ein wichtiger Grund liegt vor, die Vorlegung an einem anderen Ort als dem Belegenheitsort zu verlangen (§ 811 Absatz 1 Satz 2)";
    label en unofficial "an important reason exists to demand presentation at a place other than where the thing is located (§ 811 (1) sentence 2)";
}
pub relation vorlegungsort_besichtigung_811(rg: Rechtsgeschaeft, sache: Sache, p: Person) kind institutional {
    label de official "Die Vorlegung zur Besichtigung hat an dem Orte zu erfolgen, an welchem sich die Sache befindet (§ 811 Absatz 1 Satz 1)";
    label en unofficial "presentation for inspection under § 809 must take place where the thing is located (§ 811 (1) sentence 1)";
}
pub relation gefahr_und_kosten_der_besichtigung_traegt_verlangenden_811(rg: Rechtsgeschaeft, sache: Sache, p: Person) kind institutional {
    label de official "Die Gefahr und die Kosten der Vorlegung zur Besichtigung hat derjenige zu tragen, welcher die Vorlegung verlangt (§ 811 Absatz 2 Satz 1)";
    label en unofficial "the risk and costs of presentation for inspection are borne by the person who demands it (§ 811 (2) sentence 1)";
}
pub relation vorlegungsort_einsicht_811(rg: Rechtsgeschaeft, p: Person) kind institutional {
    label de official "Die Vorlegung zur Einsicht hat an dem Orte zu erfolgen, an welchem sich die Urkunde befindet (§ 811 Absatz 1 Satz 1)";
    label en unofficial "presentation for inspection of a document under § 810 must take place where the document is located (§ 811 (1) sentence 1)";
}
pub relation gefahr_und_kosten_der_einsicht_traegt_verlangenden_811(rg: Rechtsgeschaeft, p: Person) kind institutional {
    label de official "Die Gefahr und die Kosten der Vorlegung zur Einsicht hat derjenige zu tragen, welcher die Vorlegung verlangt (§ 811 Absatz 2 Satz 1)";
    label en unofficial "the risk and costs of presentation for inspection of a document are borne by the person who demands it (§ 811 (2) sentence 1)";
}

@source(BGB_P762)
rule SpielUndWetteOhneVerbindlichkeit(rg: Rechtsgeschaeft) strict {
    label de official "Durch Spiel oder durch Wette wird eine Verbindlichkeit nicht begründet; das auf Grund des Spieles oder der Wette Geleistete kann nicht deshalb zurückgefordert werden, weil eine Verbindlichkeit nicht bestanden hat (§ 762 Absatz 1)";
    label en unofficial "a game or wager does not create an obligation; what has been rendered on the basis of the game or wager cannot be reclaimed on the ground that no obligation existed (§ 762 (1))";
    when spiel_oder_wette(rg) and not_known(staatlich_genehmigte_lotterie(rg));
    then unvollkommene_verbindlichkeit(rg);
}
@source(BGB_P763)
rule LotterievertragVerbindlich(rg: Rechtsgeschaeft) strict {
    label de official "Ein Lotterievertrag oder ein Ausspielvertrag ist verbindlich, wenn die Lotterie oder die Ausspielung staatlich genehmigt ist (§ 763 Satz 1)";
    label en unofficial "a lottery or raffle contract is binding where the lottery or raffle is licensed by the State (§ 763 sentence 1)";
    when staatlich_genehmigte_lotterie(rg);
    then lotterievertrag_verbindlich(rg);
}
@source(BGB_P779)
rule VergleichUnwirksamBeiUnrichtigerGrundlage(rg: Rechtsgeschaeft) strict {
    label de official "Ein Vergleich ist unwirksam, wenn der nach dem Inhalt des Vertrags als feststehend zugrunde gelegte Sachverhalt der Wirklichkeit nicht entspricht und der Streit oder die Ungewissheit bei Kenntnis der Sachlage nicht entstanden sein würde (§ 779 Absatz 1)";
    label en unofficial "a settlement is void where the facts assumed as established under the contract do not correspond to reality and the dispute or uncertainty would not have arisen had the true position been known (§ 779 (1))";
    when vergleich_geschlossen(rg) and zugrunde_gelegter_sachverhalt_unrichtig(rg);
    then vergleich_unwirksam(rg);
}
@source(BGB_P780) {
    rule SchuldversprechenSchriftform(rg: Rechtsgeschaeft) strict {
        label de official "Zur Gültigkeit eines Schuldversprechens oder Schuldanerkenntnisses ist schriftliche Erteilung erforderlich; die Erteilung in elektronischer Form ist ausgeschlossen (§ 780 Sätze 1, 2; § 781 Sätze 1, 2)";
        label en unofficial "the validity of a promise or acknowledgement of debt requires it to be given in writing; electronic form is excluded (§ 780 sentences 1, 2; § 781 sentences 1, 2)";
        when schuldversprechen_oder_anerkenntnis(rg) and schriftlich_erteilt(rg)
            and not_known(in_elektronischer_form_erteilt(rg));
        then schuldversprechen_gueltig(rg);
    }
}
pub relation zugrunde_liegendes_schuldverhaeltnis_andere_form_vorgeschrieben_781(rg: Rechtsgeschaeft) kind empirical {
    label de official "Für die Begründung des Schuldverhältnisses, dessen Bestehen anerkannt wird, ist eine andere Form vorgeschrieben (§ 781 Satz 3)";
    label en unofficial "a different form is prescribed for creating the obligation whose existence is acknowledged (§ 781 sentence 3)";
}
pub relation anerkennungsvertrag_781_bedarf_dieser_form(rg: Rechtsgeschaeft) kind institutional {
    label de official "Der Anerkennungsvertrag bedarf der für das zugrunde liegende Schuldverhältnis vorgeschriebenen Form (§ 781 Satz 3)";
    label en unofficial "the acknowledgement contract requires the form prescribed for the underlying obligation (§ 781 sentence 3)";
}
@source(BGB_P781)
rule Anerkennungsvertrag781FormAnAkzessorischesSchuldverhaeltnis(rg: Rechtsgeschaeft) strict {
    label de official "Ist für die Begründung des Schuldverhältnisses, dessen Bestehen anerkannt wird, eine andere Form vorgeschrieben, so bedarf der Anerkennungsvertrag dieser Form (§ 781 Satz 3)";
    label en unofficial "where a different form is prescribed for creating the obligation whose existence is acknowledged, the acknowledgement contract requires that form (§ 781 sentence 3)";
    when schuldversprechen_oder_anerkenntnis(rg) and zugrunde_liegendes_schuldverhaeltnis_andere_form_vorgeschrieben_781(rg);
    then anerkennungsvertrag_781_bedarf_dieser_form(rg);
}
@source(BGB_P782)
rule FormfreiheitBeiVergleich(rg: Rechtsgeschaeft) strict {
    label de official "Wird ein Schuldversprechen oder ein Schuldanerkenntnis auf Grund einer Abrechnung oder im Wege des Vergleichs erteilt, so ist die Beobachtung der in den §§ 780, 781 vorgeschriebenen schriftlichen Form nicht erforderlich (§ 782)";
    label en unofficial "where a promise or acknowledgement of debt is given on the basis of an account or by way of settlement, the written form prescribed by §§ 780, 781 need not be observed (§ 782)";
    when schuldversprechen_oder_anerkenntnis(rg) and auf_grund_abrechnung_oder_vergleich_erteilt(rg);
    then schuldversprechen_gueltig(rg);
}
@source(BGB_P801) {
    rule Vorlegungsfrist801Ereignis(f: Frist, t: Date) strict {
        label de official "Die dreißigjährige Vorlegungsfrist läuft vom Eintritt der für die Leistung bestimmten Zeit an (§ 801 Absatz 1 Satz 1, § 187 Absatz 2)";
        label en unofficial "the thirty-year presentation period runs from the arrival of the time determined for performance (§ 801 (1) sentence 1, § 187 (2))";
        when vorlegungsfrist_801(f) and leistungszeit_eingetreten_am(f, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
    rule Vorlegungsfrist801Dauer(f: Frist) strict {
        label de official "Der Anspruch aus einer Schuldverschreibung auf den Inhaber erlischt mit dem Ablauf von 30 Jahren nach dem Eintritt der für die Leistung bestimmten Zeit, wenn nicht die Urkunde vorher vorgelegt wird (§ 801 Absatz 1 Satz 1)";
        label en unofficial "the claim under a bearer bond is extinguished 30 years after the arrival of the time determined for performance unless the instrument is presented beforehand (§ 801 (1) sentence 1)";
        when vorlegungsfrist_801(f);
        then de.bgb.fristen::frist_dauer_kalender(f, 30 calendar_year);
    }
    rule VorlegungsfristZinsschein801Ereignis(f: Frist, t: Date) strict {
        label de official "Die vierjährige Vorlegungsfrist beginnt mit dem Schluss des Jahres, in welchem die für die Leistung bestimmte Zeit eintritt (§ 801 Absatz 2 Satz 2)";
        label en unofficial "the four-year presentation period begins at the end of the year in which the time determined for performance arrives (§ 801 (2) sentence 2)";
        when vorlegungsfrist_zinsschein_801(f) and schluss_des_jahres_der_leistungszeit(f, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
    rule VorlegungsfristZinsschein801Dauer(f: Frist) strict {
        label de official "Bei Zins-, Renten- und Gewinnanteilscheinen beträgt die Vorlegungsfrist vier Jahre (§ 801 Absatz 2 Satz 1)";
        label en unofficial "for interest, annuity and dividend coupons the presentation period is four years (§ 801 (2) sentence 1)";
        when vorlegungsfrist_zinsschein_801(f);
        then de.bgb.fristen::frist_dauer_kalender(f, 4 calendar_year);
    }
    rule AnspruchErloschenOhneVorlegung(rg: Rechtsgeschaeft, f: Frist) strict {
        label de official "Der Anspruch aus einer Schuldverschreibung auf den Inhaber erlischt mit dem Ablauf der Vorlegungsfrist, wenn nicht die Urkunde vor deren Ablauf dem Aussteller zur Einlösung vorgelegt wird (§ 801 Absatz 1 Satz 1)";
        label en unofficial "the claim under a bearer bond is extinguished on expiry of the presentation period unless the instrument is presented to the issuer for redemption before then (§ 801 (1) sentence 1)";
        when vorlegungsfrist_801(f) and schuldverschreibung_mit_vorlegungsfrist(rg, f)
            and not_known(urkunde_rechtzeitig_vorgelegt(rg));
        then anspruch_aus_schuldverschreibung_erloschen(rg);
    }
}
@source(BGB_P810)
rule EinsichtInUrkunden(rg: Rechtsgeschaeft, p: Person) strict {
    label de official "Wer ein rechtliches Interesse daran hat, eine in fremdem Besitz befindliche Urkunde einzusehen, kann von dem Besitzer die Gestattung der Einsicht verlangen, wenn die Urkunde in seinem Interesse errichtet oder in ihr ein ihn betreffendes Rechtsverhältnis beurkundet ist (§ 810)";
    label en unofficial "a person with a legal interest in inspecting a document in another's possession may demand that the possessor permit inspection where the document was drawn up in his interest or records a legal relationship concerning him (§ 810)";
    when rechtliches_interesse_an_einsicht(rg, p);
    then anspruch_auf_einsicht(rg, p);
}

@source(BGB_P793) {
    rule AnspruchAusSchuldverschreibung793(rg: Rechtsgeschaeft) strict {
        label de official "Hat jemand eine Urkunde ausgestellt, in der er dem Inhaber der Urkunde eine Leistung verspricht, so kann der Inhaber von ihm die Leistung nach Maßgabe des Versprechens verlangen, es sei denn, dass er zur Verfügung über die Urkunde nicht berechtigt ist (§ 793 Absatz 1 Satz 1)";
        label en unofficial "where a person has issued a document promising performance to its bearer, the bearer may demand performance in accordance with the promise, unless he is not entitled to dispose of the document (§ 793 (1) sentence 1)";
        when schuldverschreibung_ausgestellt(rg) and not_known(inhaber_nicht_verfuegungsberechtigt(rg));
        then anspruch_auf_leistung_793(rg);
    }
    rule BefreiendeLeistungTrotzNichtberechtigung793(rg: Rechtsgeschaeft) strict {
        label de official "Der Aussteller wird auch durch die Leistung an einen nicht zur Verfügung berechtigten Inhaber befreit (§ 793 Absatz 1 Satz 2)";
        label en unofficial "the issuer is discharged even by performance to a bearer not entitled to dispose of the document (§ 793 (1) sentence 2)";
        when schuldverschreibung_ausgestellt(rg);
        then leistung_an_inhaber_befreiend_793(rg);
    }
}
@source(BGB_P794) {
    rule HaftungTrotzUnfreiwilligenUmlaufs794(rg: Rechtsgeschaeft) strict {
        label de official "Der Aussteller wird aus einer Schuldverschreibung auf den Inhaber auch dann verpflichtet, wenn sie ihm gestohlen worden oder verloren gegangen oder wenn sie sonst ohne seinen Willen in den Verkehr gelangt ist (§ 794 Absatz 1)";
        label en unofficial "the issuer is bound by a bearer bond even where it was stolen from, or lost by, him, or otherwise entered circulation without his consent (§ 794 (1))";
        when schuldverschreibung_ausgestellt(rg) and ohne_willen_in_verkehr_gelangt(rg);
        then haftung_trotz_unfreiwilligen_umlaufs_794(rg);
    }
    rule WirksamkeitBeiAusgabeNachTodOderGeschaeftsunfaehigkeit794(rg: Rechtsgeschaeft) strict {
        label de official "Auf die Wirksamkeit einer Schuldverschreibung auf den Inhaber ist es ohne Einfluss, wenn die Urkunde ausgegeben wird, nachdem der Aussteller gestorben oder geschäftsunfähig geworden ist (§ 794 Absatz 2)";
        label en unofficial "the effectiveness of a bearer bond is unaffected by its being issued after the issuer has died or become incapable of contracting (§ 794 (2))";
        when schuldverschreibung_ausgestellt(rg) and ausgabe_nach_tod_oder_geschaeftsunfaehigkeit_794(rg);
        then wirksamkeit_unberuehrt_794(rg);
    }
}
@source(BGB_P796) {
    rule EinwendungBetrifftGueltigkeitDerAusstellung796(rg: Rechtsgeschaeft) strict {
        label de official "Der Aussteller kann dem Inhaber der Schuldverschreibung eine Einwendung entgegensetzen, welche die Gültigkeit der Ausstellung betrifft (§ 796)";
        label en unofficial "the issuer may raise against the bearer an objection concerning the validity of the issuance (§ 796)";
        when schuldverschreibung_ausgestellt(rg) and einwendung_betrifft_gueltigkeit_der_ausstellung(rg);
        then einwendung_zulaessig_796(rg);
    }
    rule EinwendungErgibtSichAusUrkunde796(rg: Rechtsgeschaeft) strict {
        label de official "Der Aussteller kann dem Inhaber der Schuldverschreibung eine Einwendung entgegensetzen, welche sich aus der Urkunde ergibt (§ 796)";
        label en unofficial "the issuer may raise against the bearer an objection arising from the document (§ 796)";
        when schuldverschreibung_ausgestellt(rg) and einwendung_ergibt_sich_aus_urkunde(rg);
        then einwendung_zulaessig_796(rg);
    }
    rule EinwendungUnmittelbarGegenInhaber796(rg: Rechtsgeschaeft) strict {
        label de official "Der Aussteller kann dem Inhaber der Schuldverschreibung eine Einwendung entgegensetzen, die ihm unmittelbar gegen den Inhaber zusteht (§ 796)";
        label en unofficial "the issuer may raise against the bearer an objection available to him directly against the bearer (§ 796)";
        when schuldverschreibung_ausgestellt(rg) and einwendung_unmittelbar_gegen_inhaber_796(rg);
        then einwendung_zulaessig_796(rg);
    }
}
@source(BGB_P797) {
    rule LeistungspflichtNurGegenAushaendigung797(rg: Rechtsgeschaeft) strict {
        label de official "Der Aussteller ist nur gegen Aushändigung der Schuldverschreibung zur Leistung verpflichtet (§ 797 Satz 1)";
        label en unofficial "the issuer is only obliged to perform against handing over the bearer bond (§ 797 sentence 1)";
        when schuldverschreibung_ausgestellt(rg);
        then leistungspflicht_nur_gegen_aushaendigung_797(rg);
    }
    rule EigentumserwerbMitAushaendigung797(rg: Rechtsgeschaeft) strict {
        label de official "Mit der Aushändigung erwirbt der Aussteller das Eigentum an der Urkunde, auch wenn der Inhaber zur Verfügung über sie nicht berechtigt ist (§ 797 Satz 2)";
        label en unofficial "upon handover the issuer acquires ownership of the document, even where the bearer was not entitled to dispose of it (§ 797 sentence 2)";
        when schuldverschreibung_ausgestellt(rg) and urkunde_ausgehaendigt_797(rg);
        then eigentum_an_urkunde_erworben_797(rg);
    }
}
@source(BGB_P798) {
    rule AnspruchAufErsatzurkunde798(rg: Rechtsgeschaeft) strict {
        label de official "Ist eine Schuldverschreibung auf den Inhaber infolge einer Beschädigung oder einer Verunstaltung zum Umlauf nicht mehr geeignet, so kann der Inhaber, sofern ihr wesentlicher Inhalt und ihre Unterscheidungsmerkmale noch mit Sicherheit erkennbar sind, von dem Aussteller die Erteilung einer neuen Schuldverschreibung gegen Aushändigung der beschädigten oder verunstalteten verlangen (§ 798 Satz 1)";
        label en unofficial "where a bearer bond has become unfit for circulation through damage or disfigurement, the bearer may, provided its essential content and distinguishing features remain identifiable with certainty, demand a new bearer bond from the issuer against handing over the damaged or disfigured one (§ 798 sentence 1)";
        when urkunde_beschaedigt_oder_verunstaltet_zum_umlauf_ungeeignet(rg) and wesentlicher_inhalt_und_unterscheidungsmerkmale_erkennbar(rg);
        then anspruch_auf_ersatzurkunde_798(rg);
    }
    rule KostenDerErsatzurkunde798(rg: Rechtsgeschaeft) strict {
        label de official "Die Kosten der Ersatzurkunde hat der Inhaber zu tragen und vorzuschießen (§ 798 Satz 2)";
        label en unofficial "the bearer bears and must advance the costs of the replacement document (§ 798 sentence 2)";
        when anspruch_auf_ersatzurkunde_798(rg);
        then kosten_der_ersatzurkunde_vom_inhaber_zu_tragen_798(rg);
    }
}
@source(BGB_P799) {
    rule KraftloserklaerungImAufgebotsverfahren799(rg: Rechtsgeschaeft) strict {
        label de official "Eine abhanden gekommene oder vernichtete Schuldverschreibung auf den Inhaber kann, wenn nicht in der Urkunde das Gegenteil bestimmt ist, im Wege des Aufgebotsverfahrens für kraftlos erklärt werden; ausgenommen sind Zins-, Renten- und Gewinnanteilscheine sowie die auf Sicht zahlbaren unverzinslichen Schuldverschreibungen (§ 799 Absatz 1)";
        label en unofficial "a lost or destroyed bearer bond may, unless the document provides otherwise, be declared void by way of public notice proceedings; interest, annuity and dividend coupons and non-interest-bearing bonds payable at sight are excepted (§ 799 (1))";
        when urkunde_abhanden_gekommen_oder_vernichtet_799(rg) and not_known(gegenteiliges_in_urkunde_bestimmt_799(rg))
            and not_known(zins_renten_oder_gewinnanteilschein_oder_sichtwechsel_799(rg));
        then kraftloserklaerung_im_aufgebotsverfahren_moeglich_799(rg);
    }
    rule AuskunftspflichtDesAusstellers799(rg: Rechtsgeschaeft) strict {
        label de official "Der Aussteller ist verpflichtet, dem bisherigen Inhaber auf Verlangen die zur Erwirkung des Aufgebots oder der Zahlungssperre erforderliche Auskunft zu erteilen und die erforderlichen Zeugnisse auszustellen (§ 799 Absatz 2 Satz 1)";
        label en unofficial "the issuer must, on request, give the former bearer the information needed to obtain the public notice or payment block and issue the necessary certificates (§ 799 (2) sentence 1)";
        when urkunde_abhanden_gekommen_oder_vernichtet_799(rg) and verlangen_auf_auskunft_799(rg);
        then auskunfts_und_zeugnispflicht_799(rg);
    }
}
@source(BGB_P800)
rule AnspruchAufNeueUrkunde800(rg: Rechtsgeschaeft, p: Person) strict {
    label de official "Ist eine Schuldverschreibung auf den Inhaber für kraftlos erklärt, so kann derjenige, welcher den Ausschließungsbeschluss erwirkt hat, von dem Aussteller die Erteilung einer neuen Schuldverschreibung auf den Inhaber anstelle der für kraftlos erklärten verlangen (§ 800 Satz 1)";
    label en unofficial "where a bearer bond has been declared void, the person who obtained the exclusion decision may demand a new bearer bond from the issuer in place of the one declared void (§ 800 sentence 1)";
    when fuer_kraftlos_erklaert_800(rg) and ausschliessungsbeschluss_erwirkt_800(rg, p);
    then anspruch_auf_neue_urkunde_800(rg, p);
}
@source(BGB_P803) {
    rule ZinsscheineBleibenInKraft803(rg: Rechtsgeschaeft) strict {
        label de official "Werden für eine Schuldverschreibung auf den Inhaber Zinsscheine ausgegeben, so bleiben die Scheine, sofern sie nicht eine gegenteilige Bestimmung enthalten, in Kraft, auch wenn die Hauptforderung erlischt oder die Verpflichtung zur Verzinsung aufgehoben oder geändert wird (§ 803 Absatz 1)";
        label en unofficial "where interest coupons are issued for a bearer bond, they remain in force, unless they provide otherwise, even where the principal claim is extinguished or the obligation to pay interest is cancelled or altered (§ 803 (1))";
        when zinsscheine_ausgegeben(rg) and not_known(gegenteilige_bestimmung_der_zinsscheine(rg));
        then zinsscheine_bleiben_in_kraft_803(rg);
    }
    rule AusstellerDarfBetragZurueckbehalten803(rg: Rechtsgeschaeft) strict {
        label de official "Werden Zinsscheine bei der Einlösung der Hauptschuldverschreibung nicht zurückgegeben, so ist der Aussteller berechtigt, den Betrag zurückzubehalten, den er für die Scheine zu zahlen verpflichtet ist (§ 803 Absatz 2)";
        label en unofficial "where the coupons are not returned when the principal bond is redeemed, the issuer is entitled to withhold the amount he would owe for them (§ 803 (2))";
        when zinsscheine_ausgegeben(rg) and zinsscheine_bei_einloesung_nicht_zurueckgegeben_803(rg);
        then aussteller_darf_betrag_zurueckbehalten_803(rg);
    }
}
@source(BGB_P804) {
    rule AnspruchNachAblaufDerVorlegungsfrist804(rg: Rechtsgeschaeft) strict {
        label de official "Ist ein Zins-, Renten- oder Gewinnanteilschein abhanden gekommen oder vernichtet und hat der bisherige Inhaber den Verlust dem Aussteller vor dem Ablauf der Vorlegungsfrist angezeigt, so kann der bisherige Inhaber nach dem Ablauf der Frist die Leistung von dem Aussteller verlangen (§ 804 Absatz 1 Satz 1)";
        label en unofficial "where an interest, annuity or dividend coupon has been lost or destroyed and the former holder notified the issuer before the presentation period expired, the former holder may demand performance from the issuer after the period expires (§ 804 (1) sentence 1)";
        when verlust_von_schein_angezeigt_vor_fristablauf(rg) and not_known(schein_zur_einloesung_vorgelegt_oder_gerichtlich_geltend_gemacht(rg))
            and not_known(ausschluss_im_schein_vereinbart_804(rg));
        then anspruch_auf_leistung_nach_fristablauf_804(rg);
    }
    rule AnspruchTrotzVorlegungBeiVorlegungNachFristablauf804(rg: Rechtsgeschaeft) strict {
        label de official "Der Anspruch ist nicht ausgeschlossen, wenn die Vorlegung oder die gerichtliche Geltendmachung erst nach dem Ablauf der Frist erfolgt ist (§ 804 Absatz 1 Satz 2 Halbsatz 2)";
        label en unofficial "the claim is not excluded where presentation or judicial assertion occurred only after the period had expired (§ 804 (1) sentence 2 second half-sentence)";
        when verlust_von_schein_angezeigt_vor_fristablauf(rg) and vorlegung_oder_geltendmachung_nach_fristablauf(rg);
        then anspruch_auf_leistung_nach_fristablauf_804(rg);
    }
    rule AnspruchAusgeschlossenBeiVorlegung804(rg: Rechtsgeschaeft) strict {
        label de official "Der Anspruch ist ausgeschlossen, wenn der abhanden gekommene Schein dem Aussteller zur Einlösung vorgelegt oder der Anspruch aus dem Schein gerichtlich geltend gemacht worden ist, es sei denn, dass die Vorlegung oder die gerichtliche Geltendmachung nach dem Ablauf der Frist erfolgt ist (§ 804 Absatz 1 Satz 2)";
        label en unofficial "the claim is excluded where the lost coupon has been presented to the issuer for redemption or the claim under it has been judicially asserted, unless that presentation or assertion occurred only after the period expired (§ 804 (1) sentence 2)";
        when verlust_von_schein_angezeigt_vor_fristablauf(rg) and schein_zur_einloesung_vorgelegt_oder_gerichtlich_geltend_gemacht(rg)
            and not_known(vorlegung_oder_geltendmachung_nach_fristablauf(rg));
        then anspruch_ausgeschlossen_804(rg);
    }
}
@source(BGB_P805) {
    rule VerbotDerAusgabeNeuerScheine805(rg: Rechtsgeschaeft) strict {
        label de official "Neue Zins- oder Rentenscheine für eine Schuldverschreibung auf den Inhaber dürfen an den Inhaber der zum Empfang der Scheine ermächtigenden Urkunde nicht ausgegeben werden, wenn der Inhaber der Schuldverschreibung der Ausgabe widersprochen hat (§ 805 Satz 1)";
        label en unofficial "new interest or annuity coupons for a bearer bond may not be issued to the holder of the renewal certificate where the bearer of the bond has objected to the issue (§ 805 sentence 1)";
        when inhaber_widerspricht_ausgabe_der_scheine(rg);
        then neue_scheine_duerfen_nicht_ausgegeben_werden_805(rg);
    }
    rule AushaendigungDerScheineAnInhaber805(rg: Rechtsgeschaeft) strict {
        label de official "Die Scheine sind dem Inhaber der Schuldverschreibung auszuhändigen, wenn er die Schuldverschreibung vorlegt (§ 805 Satz 2)";
        label en unofficial "the coupons must be handed over to the bearer of the bond where he presents the bond (§ 805 sentence 2)";
        when inhaber_widerspricht_ausgabe_der_scheine(rg) and inhaber_legt_schuldverschreibung_vor_805(rg);
        then scheine_dem_inhaber_auszuhaendigen_805(rg);
    }
}
@source(BGB_P806)
rule KeineUmschreibungspflicht806(rg: Rechtsgeschaeft) strict {
    label de official "Die Umschreibung einer auf den Inhaber lautenden Schuldverschreibung auf den Namen eines bestimmten Berechtigten kann nur durch den Aussteller erfolgen; der Aussteller ist zur Umschreibung nicht verpflichtet (§ 806)";
    label en unofficial "conversion of a bearer bond into a registered bond for a specific person can only be effected by the issuer; the issuer is not obliged to do so (§ 806)";
    when schuldverschreibung_ausgestellt(rg);
    then keine_pflicht_zur_umschreibung_806(rg);
}
@source(BGB_P807)
rule KarteOderMarkeAlsSchuldverschreibung807(rg: Rechtsgeschaeft) strict {
    label de official "Werden Karten, Marken oder ähnliche Urkunden, in denen ein Gläubiger nicht bezeichnet ist, von dem Aussteller unter Umständen ausgegeben, aus welchen sich ergibt, dass er dem Inhaber zu einer Leistung verpflichtet sein will, so finden die Vorschriften des § 793 Absatz 1 und der §§ 794, 796, 797 entsprechende Anwendung (§ 807)";
    label en unofficial "where cards, tokens or similar documents not naming a creditor are issued under circumstances showing that the issuer intends to be bound to perform to the bearer, §§ 793 (1), 794, 796 and 797 apply mutatis mutandis (§ 807)";
    when karte_oder_marke_ohne_glaeubigerbezeichnung(rg) and umstaende_zeigen_verpflichtungswillen_gegenueber_inhaber(rg);
    then schuldverschreibung_ausgestellt(rg);
}
@source(BGB_P808) {
    rule LeistungAnInhaberBefreiend808(rg: Rechtsgeschaeft) strict {
        label de official "Wird eine Urkunde, in welcher der Gläubiger benannt ist, mit der Bestimmung ausgegeben, dass die in der Urkunde versprochene Leistung an jeden Inhaber bewirkt werden kann, so wird der Schuldner durch die Leistung an den Inhaber der Urkunde befreit; der Inhaber ist nicht berechtigt, die Leistung zu verlangen (§ 808 Absatz 1)";
        label en unofficial "where a document naming the creditor is issued with a clause that the promised performance may be rendered to any bearer, the debtor is discharged by performance to the bearer; the bearer is not entitled to demand performance (§ 808 (1))";
        when urkunde_mit_inhaberklausel_ausgegeben(rg);
        then leistung_an_inhaber_befreiend_808(rg);
    }
    rule InhaberNichtBerechtigtLeistungZuVerlangen808(rg: Rechtsgeschaeft) strict {
        label de official "Der Inhaber ist nicht berechtigt, die Leistung zu verlangen (§ 808 Absatz 1 Satz 2)";
        label en unofficial "the bearer is not entitled to demand performance (§ 808 (1) sentence 2)";
        when urkunde_mit_inhaberklausel_ausgegeben(rg);
        then inhaber_nicht_berechtigt_leistung_zu_verlangen_808(rg);
    }
    rule LeistungspflichtNurGegenAushaendigung808(rg: Rechtsgeschaeft) strict {
        label de official "Der Schuldner ist nur gegen Aushändigung der Urkunde zur Leistung verpflichtet (§ 808 Absatz 2 Satz 1)";
        label en unofficial "the debtor is only obliged to perform against handing over the document (§ 808 (2) sentence 1)";
        when urkunde_mit_inhaberklausel_ausgegeben(rg);
        then leistungspflicht_nur_gegen_aushaendigung_808(rg);
    }
    rule KraftloserklaerungMoeglich808(rg: Rechtsgeschaeft) strict {
        label de official "Ist die Urkunde abhanden gekommen oder vernichtet, so kann sie, wenn nicht ein anderes bestimmt ist, im Wege des Aufgebotsverfahrens für kraftlos erklärt werden (§ 808 Absatz 2 Satz 2)";
        label en unofficial "where the document has been lost or destroyed, it may, unless otherwise provided, be declared void by way of public notice proceedings (§ 808 (2) sentence 2)";
        when urkunde_mit_inhaberklausel_ausgegeben(rg) and urkunde_abhanden_oder_vernichtet_808(rg)
            and not_known(anderes_in_urkunde_bestimmt_808(rg));
        then kraftloserklaerung_moeglich_808(rg);
    }
}
@source(BGB_P809)
rule BesichtigungEinerSache809(rg: Rechtsgeschaeft, sache: Sache, p: Person) strict {
    label de official "Wer gegen den Besitzer einer Sache einen Anspruch in Ansehung der Sache hat oder sich Gewissheit verschaffen will, ob ihm ein solcher Anspruch zusteht, kann, wenn die Besichtigung der Sache aus diesem Grunde für ihn von Interesse ist, verlangen, dass der Besitzer ihm die Sache zur Besichtigung vorlegt oder die Besichtigung gestattet (§ 809)";
    label en unofficial "a person who has a claim against the possessor of a thing in respect of the thing, or who wishes to ascertain whether such a claim exists, may, where inspection is of interest to him for that reason, demand that the possessor present the thing for inspection or permit inspection (§ 809)";
    when rechtliches_interesse_an_besichtigung(rg, sache, p);
    then anspruch_auf_besichtigung_809(rg, sache, p);
}
@source(BGB_P811) {
    rule VorlegungsortBesichtigung811(rg: Rechtsgeschaeft, sache: Sache, p: Person) strict {
        label de official "Die Vorlegung hat in den Fällen des § 809 an dem Orte zu erfolgen, an welchem sich die vorzulegende Sache befindet (§ 811 Absatz 1 Satz 1)";
        label en unofficial "presentation under § 809 must take place where the thing to be presented is located (§ 811 (1) sentence 1)";
        when anspruch_auf_besichtigung_809(rg, sache, p) and not_known(vorlegungsverlangen_wichtiger_grund_fuer_anderen_ort(rg));
        then vorlegungsort_besichtigung_811(rg, sache, p);
    }
    rule GefahrUndKostenDerBesichtigung811(rg: Rechtsgeschaeft, sache: Sache, p: Person) strict {
        label de official "Die Gefahr und die Kosten der Vorlegung zur Besichtigung hat derjenige zu tragen, welcher die Vorlegung verlangt (§ 811 Absatz 2 Satz 1)";
        label en unofficial "the risk and costs of presentation for inspection under § 809 are borne by the person who demands it (§ 811 (2) sentence 1)";
        when anspruch_auf_besichtigung_809(rg, sache, p);
        then gefahr_und_kosten_der_besichtigung_traegt_verlangenden_811(rg, sache, p);
    }
    rule VorlegungsortEinsicht811(rg: Rechtsgeschaeft, p: Person) strict {
        label de official "Die Vorlegung hat in den Fällen des § 810 an dem Orte zu erfolgen, an welchem sich die vorzulegende Urkunde befindet (§ 811 Absatz 1 Satz 1)";
        label en unofficial "presentation under § 810 must take place where the document to be presented is located (§ 811 (1) sentence 1)";
        when anspruch_auf_einsicht(rg, p) and not_known(vorlegungsverlangen_wichtiger_grund_fuer_anderen_ort(rg));
        then vorlegungsort_einsicht_811(rg, p);
    }
    rule GefahrUndKostenDerEinsicht811(rg: Rechtsgeschaeft, p: Person) strict {
        label de official "Die Gefahr und die Kosten der Vorlegung zur Einsicht hat derjenige zu tragen, welcher die Vorlegung verlangt (§ 811 Absatz 2 Satz 1)";
        label en unofficial "the risk and costs of presentation for inspection of a document under § 810 are borne by the person who demands it (§ 811 (2) sentence 1)";
        when anspruch_auf_einsicht(rg, p);
        then gefahr_und_kosten_der_einsicht_traegt_verlangenden_811(rg, p);
    }
    pub relation besitzer_811(rg: Rechtsgeschaeft, sache: Sache, p: Person) kind empirical {
        label de official "Besitzer der vorzulegenden Sache nach § 811";
        label en unofficial "possessor of the thing to be presented under § 811";
    }
    pub relation vorlegung_811_erfolgt_am(rg: Rechtsgeschaeft, sache: Sache, tag: Date) kind empirical {
        label de official "Die Sache wurde zur Besichtigung vorgelegt (§ 811)";
        label en unofficial "the thing was presented for inspection (§ 811)";
    }
    pub relation vorlegungspflicht_811_beginn_am(rg: Rechtsgeschaeft, tag: Date) kind empirical {
        label de official "Beginn der Vorlegungspflicht nach § 811";
        label en unofficial "start of the presentation duty under § 811";
    }
    @source(BGB_P811)
    rule Position811Vorlegung(rg: Rechtsgeschaeft, sache: Sache, p: Person, beginn: Date) strict {
        label de official "Der Besitzer ist verpflichtet, die Sache am Ort ihrer Belegenheit vorzulegen (§ 811)";
        label en unofficial "The possessor is obliged to present the thing where it is located (§ 811)";
        when besitzer_811(rg, sache, p) and anspruch_auf_besichtigung_809(rg, sache, p)
         and vorlegungspflicht_811_beginn_am(rg, beginn);
        then duty Duty811Vorlegung {
            bearer p;
            achieve vorlegung_811_erfolgt_am(rg, sache, beginn) during [beginn, infinity);
        };
    }
    pub relation verwahrer_692(vw: Verwahrung, p: Person) kind empirical {
        label de official "Verwahrer nach § 692";
        label en unofficial "depositary under § 692";
    }
    pub relation aenderung_692_angezeigt_am(vw: Verwahrung, tag: Date) kind empirical {
        label de official "Der Verwahrer hat die Änderung der Aufbewahrungsart angezeigt (§ 692)";
        label en unofficial "the depositary notified the change of storage method (§ 692)";
    }
    pub relation anzeigepflicht_692_beginn_am(vw: Verwahrung, tag: Date) kind empirical {
        label de official "Beginn der Anzeigepflicht nach § 692";
        label en unofficial "start of the notification duty under § 692";
    }
    @source(BGB_P692)
    rule Position692Anzeige(vw: Verwahrung, p: Person, beginn: Date) strict {
        label de official "Der Verwahrer ist verpflichtet, den Hinterleger vor Änderung der Aufbewahrung anzuzeigen (§ 692)";
        label en unofficial "The depositary is obliged to notify the depositor before changing storage (§ 692)";
        when verwahrer_692(vw, p) and anzeigepflicht_692_beginn_am(vw, beginn);
        then duty Duty692Anzeige {
            bearer p;
            achieve aenderung_692_angezeigt_am(vw, beginn) during [beginn, infinity);
        };
    }
    pub relation verwahrer_696(vw: Verwahrung, p: Person) kind empirical {
        label de official "Verwahrer nach § 696";
        label en unofficial "depositary under § 696";
    }
    pub relation ruecknahme_696_verlangt_am(vw: Verwahrung, tag: Date) kind empirical {
        label de official "Der Verwahrer hat die Rücknahme der hinterlegten Sache verlangt (§ 696)";
        label en unofficial "the depositary demanded return of the deposited thing (§ 696)";
    }
    pub relation ruecknahmerecht_696_beginn_am(vw: Verwahrung, tag: Date) kind empirical {
        label de official "Beginn des Rücknahmeverlangens nach § 696";
        label en unofficial "start of the return demand under § 696";
    }
    @source(BGB_P696)
    rule Position696Ruecknahme(vw: Verwahrung, p: Person, beginn: Date) strict {
        label de official "Der Verwahrer ist berechtigt, die Rücknahme der hinterlegten Sache zu verlangen (§ 696)";
        label en unofficial "The depositary has the liberty to demand return of the deposited thing (§ 696)";
        when verwahrer_696(vw, p) and ruecknahmerecht_696_beginn_am(vw, beginn);
        then liberty Liberty696Ruecknahme {
            holder p;
            action ruecknahme_696_verlangt_am(vw, beginn);
            window [beginn, infinity);
        };
    }
    pub relation hinterleger_699(vw: Verwahrung, p: Person) kind empirical {
        label de official "Hinterleger nach § 699";
        label en unofficial "depositor under § 699";
    }
    pub relation verguetung_699_entrichtet_am(vw: Verwahrung, tag: Date) kind empirical {
        label de official "Der Hinterleger hat die Vergütung entrichtet (§ 699)";
        label en unofficial "the depositor paid the remuneration (§ 699)";
    }
    pub relation verguetungspflicht_699_beginn_am(vw: Verwahrung, tag: Date) kind empirical {
        label de official "Beginn der Vergütungspflicht nach § 699";
        label en unofficial "start of the remuneration duty under § 699";
    }
    @source(BGB_P699)
    rule Position699Verguetung(vw: Verwahrung, p: Person, beginn: Date) strict {
        label de official "Der Hinterleger ist verpflichtet, die vereinbarte Vergütung zu entrichten (§ 699)";
        label en unofficial "The depositor is obliged to pay the agreed remuneration (§ 699)";
        when hinterleger_699(vw, p) and verguetungspflicht_699_beginn_am(vw, beginn);
        then duty Duty699Verguetung {
            bearer p;
            achieve verguetung_699_entrichtet_am(vw, beginn) during [beginn, infinity);
        };
    }
    pub relation verwahrer_697(vw: Verwahrung, p: Person) kind empirical {
        label de official "Verwahrer nach § 697";
        label en unofficial "depositary under § 697";
    }
    pub relation rueckgabe_697_erfolgt_am(vw: Verwahrung, tag: Date) kind empirical {
        label de official "Die hinterlegte Sache wurde am Aufbewahrungsort zurückgegeben (§ 697)";
        label en unofficial "the deposited thing was returned at the storage place (§ 697)";
    }
    pub relation rueckgabepflicht_697_beginn_am(vw: Verwahrung, tag: Date) kind empirical {
        label de official "Beginn der Rückgabepflicht nach § 697";
        label en unofficial "start of the return duty under § 697";
    }
    @source(BGB_P697)
    rule Position697Rueckgabe(vw: Verwahrung, p: Person, beginn: Date) strict {
        label de official "Der Verwahrer ist verpflichtet, die Sache am Aufbewahrungsort zurückzugeben (§ 697)";
        label en unofficial "The depositary is obliged to return the thing at the storage place (§ 697)";
        when verwahrer_697(vw, p) and rueckgabepflicht_697_beginn_am(vw, beginn);
        then duty Duty697Rueckgabe {
            bearer p;
            achieve rueckgabe_697_erfolgt_am(vw, beginn) during [beginn, infinity);
        };
    }
    pub relation verwahrer_698(vw: Verwahrung, p: Person) kind empirical {
        label de official "Verwahrer nach § 698";
        label en unofficial "depositary under § 698";
    }
    pub relation zins_698_entrichtet_am(vw: Verwahrung, tag: Date) kind empirical {
        label de official "Der Verwahrer hat Zinsen für verwendetes Geld entrichtet (§ 698)";
        label en unofficial "the depositary paid interest on money used (§ 698)";
    }
    pub relation zinszahlungspflicht_698_beginn_am(vw: Verwahrung, tag: Date) kind empirical {
        label de official "Beginn der Zinszahlungspflicht nach § 698";
        label en unofficial "start of the interest duty under § 698";
    }
    @source(BGB_P698)
    rule Position698Zinsen(vw: Verwahrung, p: Person, beginn: Date) strict {
        label de official "Der Verwahrer ist verpflichtet, für verwendetes Geld Zinsen zu entrichten (§ 698)";
        label en unofficial "The depositary is obliged to pay interest on money used (§ 698)";
        when verwahrer_698(vw, p) and zinszahlungspflicht_698_beginn_am(vw, beginn);
        then duty Duty698Zinsen {
            bearer p;
            achieve zins_698_entrichtet_am(vw, beginn) during [beginn, infinity);
        };
    }
    pub relation unternehmer_482a(t: Teilzeitwohnrechtevertrag, p: Person) kind empirical {
        label de official "Unternehmer nach § 482a";
        label en unofficial "trader under § 482a";
    }
    pub relation widerrufsbelehrung_482a_erteilt_am(t: Teilzeitwohnrechtevertrag, tag: Date) kind empirical {
        label de official "Der Unternehmer hat über das Widerrufsrecht und Anzahlungsverbot belehrt (§ 482a)";
        label en unofficial "the trader provided withdrawal and advance-payment information (§ 482a)";
    }
    pub relation belehrungspflicht_482a_beginn_am(t: Teilzeitwohnrechtevertrag, tag: Date) kind empirical {
        label de official "Beginn der Belehrungspflicht nach § 482a";
        label en unofficial "start of the information duty under § 482a";
    }
    @source(BGB_P482a)
    rule Position482aBelehrung(t: Teilzeitwohnrechtevertrag, p: Person, beginn: Date) strict {
        label de official "Der Unternehmer ist verpflichtet, den Verbraucher vor Vertragsschluss über Widerrufsrecht und Anzahlungsverbot zu belehren (§ 482a)";
        label en unofficial "The trader is obliged to inform the consumer about withdrawal and advance-payment prohibition before contracting (§ 482a)";
        when unternehmer_482a(t, p) and belehrungspflicht_482a_beginn_am(t, beginn);
        then duty Duty482aBelehrung {
            bearer p;
            achieve widerrufsbelehrung_482a_erteilt_am(t, beginn) during [beginn, infinity);
        };
    }
    pub relation geschaeftsbesorger_675a(a: Auftrag, p: Person) kind empirical {
        label de official "Geschäftsbesorger nach § 675a";
        label en unofficial "business agent under § 675a";
    }
    pub relation information_675a_bereitgestellt_am(a: Auftrag, tag: Date) kind empirical {
        label de official "Informationen über Entgelte und Auslagen wurden bereitgestellt (§ 675a)";
        label en unofficial "information about fees and expenses was provided (§ 675a)";
    }
    pub relation informationspflicht_675a_beginn_am(a: Auftrag, tag: Date) kind empirical {
        label de official "Beginn der Informationspflicht nach § 675a";
        label en unofficial "start of the information duty under § 675a";
    }
    @source(BGB_P675a)
    rule Position675aInformation(a: Auftrag, p: Person, beginn: Date) strict {
        label de official "Der Geschäftsbesorger ist verpflichtet, Informationen über Entgelte und Auslagen bereitzustellen (§ 675a)";
        label en unofficial "The business agent is obliged to provide information about fees and expenses (§ 675a)";
        when geschaeftsbesorger_675a(a, p) and informationspflicht_675a_beginn_am(a, beginn);
        then duty Duty675aInformation {
            bearer p;
            achieve information_675a_bereitgestellt_am(a, beginn) during [beginn, infinity);
        };
    }
    pub relation verguetung_689_geschuldet(vw: Verwahrung, p: Person) kind empirical {
        label de official "Vergütung für die Aufbewahrung ist nach § 689 geschuldet";
        label en unofficial "remuneration for safekeeping is owed under § 689";
    }
    pub relation verguetung_689_beginn_am(vw: Verwahrung, tag: Date) kind empirical {
        label de official "Beginn der Vergütungspflicht nach § 689";
        label en unofficial "start of the remuneration duty under § 689";
    }
    @source(BGB_P689)
    rule Position689Verguetung(vw: Verwahrung, p: Person, beginn: Date) strict {
        label de official "Der Verwahrer ist berechtigt, eine Vergütung für die Aufbewahrung zu verlangen, wenn sie nur gegen Vergütung zu erwarten ist (§ 689)";
        label en unofficial "The depositary has the liberty to demand remuneration where safekeeping is expected only for payment (§ 689)";
        when verwahrer(vw, p) and verguetung_689_geschuldet(vw, p)
         and verguetung_689_beginn_am(vw, beginn);
        then liberty Liberty689Verguetung {
            holder p;
            action verguetung_689_geschuldet(vw, p);
            window [beginn, infinity);
        };
    }
    pub relation darlehensgeber_504(d: Darlehen, p: Person) kind empirical {
        label de official "Darlehensgeber nach § 504";
        label en unofficial "lender under § 504";
    }
    pub relation information_504_erteilt_am(d: Darlehen, tag: Date) kind empirical {
        label de official "Der Darlehensgeber hat regelmäßig über die Überziehungsmöglichkeit informiert (§ 504)";
        label en unofficial "the lender provided regular information about the overdraft facility (§ 504)";
    }
    pub relation informationspflicht_504_beginn_am(d: Darlehen, tag: Date) kind empirical {
        label de official "Beginn der Informationspflicht nach § 504";
        label en unofficial "start of the information duty under § 504";
    }
    @source(BGB_P504)
    rule Position504Information(d: Darlehen, p: Person, beginn: Date) strict {
        label de official "Der Darlehensgeber ist verpflichtet, regelmäßig über die Überziehungsmöglichkeit zu informieren (§ 504)";
        label en unofficial "The lender is obliged to provide regular information about the overdraft facility (§ 504)";
        when darlehensgeber_504(d, p) and informationspflicht_504_beginn_am(d, beginn);
        then duty Duty504Information {
            bearer p;
            achieve information_504_erteilt_am(d, beginn) during [beginn, infinity);
        };
    }
    pub relation darlehensgeber_511(d: Darlehen, p: Person) kind empirical {
        label de official "Darlehensgeber nach § 511";
        label en unofficial "lender under § 511";
    }
    pub relation beratung_511_information_erteilt_am(d: Darlehen, tag: Date) kind empirical {
        label de official "Der Darlehensgeber hat vor der Beratung informiert und geprüft (§ 511)";
        label en unofficial "the lender informed and assessed before advice (§ 511)";
    }
    pub relation beratungspflicht_511_beginn_am(d: Darlehen, tag: Date) kind empirical {
        label de official "Beginn der Beratungspflicht nach § 511";
        label en unofficial "start of the advice duty under § 511";
    }
    @source(BGB_P511)
    rule Position511Beratung(d: Darlehen, p: Person, beginn: Date) strict {
        label de official "Der Darlehensgeber ist verpflichtet, vor individueller Empfehlung zu informieren und zu prüfen (§ 511)";
        label en unofficial "The lender is obliged to inform and assess before an individual recommendation (§ 511)";
        when darlehensgeber_511(d, p) and beratungspflicht_511_beginn_am(d, beginn);
        then duty Duty511Beratung {
            bearer p;
            achieve beratung_511_information_erteilt_am(d, beginn) during [beginn, infinity);
        };
    }
    pub relation verbraucher_512(d: Darlehen, p: Person) kind empirical {
        label de official "Verbraucher nach § 512";
        label en unofficial "consumer under § 512";
    }
