        label en unofficial "The buyer has the liberty to invoke the consumer scope of §§ 656c and 656d (§ 656b)";
        when kaeufer_656b(d, p) and schutzbereich_656b_beginn_am(d, beginn);
        then liberty Liberty656bVerbraucher {
            holder p;
            action verbraucherstatus_656b_festgestellt_am(d, beginn);
            window [beginn, infinity);
        };
    }
    pub relation eingetragene_gesellschaft_707b(g: Gesellschaft, p: Person) kind empirical {
        label de official "Eingetragene Gesellschaft nach § 707b";
        label en unofficial "registered company under § 707b";
    }
    pub relation registervorschriften_707b_eingehalten_am(g: Gesellschaft, tag: Date) kind empirical {
        label de official "Die anwendbaren Registervorschriften wurden eingehalten (§ 707b)";
        label en unofficial "the applicable register rules were followed (§ 707b)";
    }
    pub relation registerpflicht_707b_beginn_am(g: Gesellschaft, tag: Date) kind empirical {
        label de official "Beginn der registerrechtlichen Pflicht nach § 707b";
        label en unofficial "start of the register-law duty under § 707b";
    }
    @source(BGB_P707b)
    rule Position707bRegister(g: Gesellschaft, p: Person, beginn: Date) strict {
        label de official "Die eingetragene Gesellschaft ist verpflichtet, die anwendbaren Registervorschriften einzuhalten (§ 707b)";
        label en unofficial "The registered company is obliged to comply with the applicable register rules (§ 707b)";
        when eingetragene_gesellschaft_707b(g, p) and registerpflicht_707b_beginn_am(g, beginn);
        then duty Duty707bRegister {
            bearer p;
            achieve registervorschriften_707b_eingehalten_am(g, beginn) during [beginn, infinity);
        };
    }
    pub relation inhaber_798(rg: Rechtsgeschaeft, p: Person) kind empirical {
        label de official "Inhaber der Schuldverschreibung nach § 798";
        label en unofficial "bearer of the bond under § 798";
    }
    pub relation ersatzurkunde_798_verlangt_am(rg: Rechtsgeschaeft, tag: Date) kind empirical {
        label de official "Der Inhaber hat eine Ersatzurkunde verlangt (§ 798)";
        label en unofficial "the bearer demanded a replacement document (§ 798)";
    }
    pub relation ersatzurkunderecht_798_beginn_am(rg: Rechtsgeschaeft, tag: Date) kind empirical {
        label de official "Beginn des Rechts auf Ersatzurkunde nach § 798";
        label en unofficial "start of the replacement-document right under § 798";
    }
    @source(BGB_P798)
    rule Position798Ersatzurkunde(rg: Rechtsgeschaeft, p: Person, beginn: Date) strict {
        label de official "Der Inhaber ist berechtigt, eine Ersatzurkunde zu verlangen (§ 798)";
        label en unofficial "The bearer has the liberty to demand a replacement document (§ 798)";
        when inhaber_798(rg, p) and ersatzurkunderecht_798_beginn_am(rg, beginn);
        then liberty Liberty798Ersatzurkunde {
            holder p;
            action ersatzurkunde_798_verlangt_am(rg, beginn);
            window [beginn, infinity);
        };
    }
    pub relation aussteller_799(rg: Rechtsgeschaeft, p: Person) kind empirical {
        label de official "Aussteller nach § 799";
        label en unofficial "issuer under § 799";
    }
    pub relation auskunft_799_erteilt_am(rg: Rechtsgeschaeft, tag: Date) kind empirical {
        label de official "Der Aussteller hat Auskunft und Zeugnisse erteilt (§ 799)";
        label en unofficial "the issuer provided information and certificates (§ 799)";
    }
    pub relation auskunftspflicht_799_beginn_am(rg: Rechtsgeschaeft, tag: Date) kind empirical {
        label de official "Beginn der Auskunftspflicht nach § 799";
        label en unofficial "start of the information duty under § 799";
    }
    @source(BGB_P799)
    rule Position799Auskunft(rg: Rechtsgeschaeft, p: Person, beginn: Date) strict {
        label de official "Der Aussteller ist verpflichtet, dem bisherigen Inhaber Auskunft und Zeugnisse zu erteilen (§ 799)";
        label en unofficial "The issuer is obliged to provide information and certificates to the former bearer (§ 799)";
        when aussteller_799(rg, p) and auskunftspflicht_799_beginn_am(rg, beginn);
        then duty Duty799Auskunft {
            bearer p;
            achieve auskunft_799_erteilt_am(rg, beginn) during [beginn, infinity);
        };
    }
    pub relation aussteller_803(rg: Rechtsgeschaeft, p: Person) kind empirical {
        label de official "Aussteller nach § 803";
        label en unofficial "issuer under § 803";
    }
    pub relation betrag_803_zurueckbehalten_am(rg: Rechtsgeschaeft, tag: Date) kind empirical {
        label de official "Der Aussteller hat den Betrag zurückbehalten (§ 803)";
        label en unofficial "the issuer withheld the amount (§ 803)";
    }
    pub relation zurueckbehaltungsrecht_803_beginn_am(rg: Rechtsgeschaeft, tag: Date) kind empirical {
        label de official "Beginn des Zurückbehaltungsrechts nach § 803";
        label en unofficial "start of the withholding right under § 803";
    }
    @source(BGB_P803)
    rule Position803Zurueckbehaltung(rg: Rechtsgeschaeft, p: Person, beginn: Date) strict {
        label de official "Der Aussteller ist berechtigt, den Betrag für nicht zurückgegebene Zinsscheine zurückzubehalten (§ 803)";
        label en unofficial "The issuer has the liberty to withhold the amount for coupons not returned (§ 803)";
        when aussteller_803(rg, p) and zurueckbehaltungsrecht_803_beginn_am(rg, beginn);
        then liberty Liberty803Zurueckbehaltung {
            holder p;
            action betrag_803_zurueckbehalten_am(rg, beginn);
            window [beginn, infinity);
        };
    }
    pub relation berechtigter_809(rg: Rechtsgeschaeft, p: Person) kind empirical {
        label de official "Berechtigter nach § 809";
        label en unofficial "entitled person under § 809";
    }
    pub relation besichtigung_809_verlangt_am(rg: Rechtsgeschaeft, tag: Date) kind empirical {
        label de official "Der Berechtigte hat die Besichtigung verlangt (§ 809)";
        label en unofficial "the entitled person demanded inspection (§ 809)";
    }
    pub relation besichtigungsrecht_809_beginn_am(rg: Rechtsgeschaeft, tag: Date) kind empirical {
        label de official "Beginn des Besichtigungsrechts nach § 809";
        label en unofficial "start of the inspection right under § 809";
    }
    @source(BGB_P809)
    rule Position809Besichtigung(rg: Rechtsgeschaeft, p: Person, beginn: Date) strict {
        label de official "Der Berechtigte ist berechtigt, die Sache zur Besichtigung vorzulegen oder die Besichtigung zu verlangen (§ 809)";
        label en unofficial "The entitled person has the liberty to demand presentation or inspection of the thing (§ 809)";
        when berechtigter_809(rg, p) and besichtigungsrecht_809_beginn_am(rg, beginn);
        then liberty Liberty809Besichtigung {
            holder p;
            action besichtigung_809_verlangt_am(rg, beginn);
            window [beginn, infinity);
        };
    }
}
