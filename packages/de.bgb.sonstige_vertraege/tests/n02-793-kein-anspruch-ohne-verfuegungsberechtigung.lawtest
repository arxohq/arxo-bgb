language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu n01: ist der Inhaber zur Verfügung über die Urkunde nicht berechtigt, entfällt der Anspruch aus § 793 Absatz 1 Satz 1 — der Aussteller wird aber trotzdem befreiend leisten können (§ 793 Absatz 1 Satz 2).
test "§ 793 Absatz 1 Satz 1: kein Anspruch ohne Verfügungsberechtigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": schuldverschreibung_ausgestellt(entity_ref("urn:de:bgb:sv:n02:RG")) { origin case_input; }
        assert "f2": inhaber_nicht_verfuegungsberechtigt(entity_ref("urn:de:bgb:sv:n02:RG")) { origin case_input; }
    }
    evaluate truth(anspruch_auf_leistung_793(entity_ref("urn:de:bgb:sv:n02:RG")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(leistung_an_inhaber_befreiend_793(entity_ref("urn:de:bgb:sv:n02:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
