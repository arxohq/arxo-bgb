language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 732: Mehrheitsklausel vereinbart, drei von vier abgegebenen Stimmen stimmen der Auflösung zu — 4 × 3 = 12 ≥ 4 × 3 = 12, genau drei Viertel: der Auflösungsbeschluss ist gefasst.
test "§ 732: Auflösungsbeschluss mit genau drei Viertel der abgegebenen Stimmen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": mehrheitsklausel_vereinbart(entity_ref("urn:de:bgb:sv:l03:G")) { origin case_input; }
        assert "f2": aufloesungsbeschluss_732(entity_ref("urn:de:bgb:sv:l03:G"), "Auflösung") { origin case_input; }
        assert "f3": hat_abgestimmt(entity_ref("urn:de:bgb:sv:l03:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l03:A")) { origin case_input; }
        assert "f4": hat_abgestimmt(entity_ref("urn:de:bgb:sv:l03:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l03:B")) { origin case_input; }
        assert "f5": hat_abgestimmt(entity_ref("urn:de:bgb:sv:l03:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l03:C")) { origin case_input; }
        assert "f6": hat_abgestimmt(entity_ref("urn:de:bgb:sv:l03:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l03:D")) { origin case_input; }
        assert "f7": zugestimmt(entity_ref("urn:de:bgb:sv:l03:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l03:A")) { origin case_input; }
        assert "f8": zugestimmt(entity_ref("urn:de:bgb:sv:l03:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l03:B")) { origin case_input; }
        assert "f9": zugestimmt(entity_ref("urn:de:bgb:sv:l03:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l03:C")) { origin case_input; }
    }
    evaluate truth(aufloesungsbeschluss_732_gefasst(entity_ref("urn:de:bgb:sv:l03:G"), "Auflösung"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesellschaft_aufgeloest(entity_ref("urn:de:bgb:sv:l03:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
