language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu h12: genau zwei Monate unterschreiten die Grenze nicht — keine Unwirksamkeit.
test "§ 499 Absatz 1: eine Kündigungsfrist von zwei Monaten bleibt wirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kuendigungsrecht_des_darlehensgebers_vereinbart_499(entity_ref("urn:de:bgb:sv:h13:D")) { origin case_input; }
        assert "f2": kuendigungsfrist_des_darlehensgebers_499(entity_ref("urn:de:bgb:sv:h13:D"), 2) { origin case_input; }
    }
    evaluate truth(kuendigungsrechtsvereinbarung_499_unwirksam(entity_ref("urn:de:bgb:sv:h13:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
