language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 792 Absatz 2 Satz 2 Alternative 1: der Anweisende schließt die Übertragung aus, und die Ausschließung ist aus der Anweisung selbst zu entnehmen — sie wirkt gegenüber dem Angewiesenen.
test "§ 792 Absatz 2: Ausschluss der Übertragung, aus der Anweisung ersichtlich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": uebertragung_durch_anweisenden_ausgeschlossen(entity_ref("urn:de:bgb:sv:a06:A")) { origin case_input; }
        assert "f2": ausschluss_aus_anweisung_ersichtlich(entity_ref("urn:de:bgb:sv:a06:A")) { origin case_input; }
    }
    evaluate truth(ausschluss_wirksam_gegenueber_angewiesenem_792(entity_ref("urn:de:bgb:sv:a06:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
