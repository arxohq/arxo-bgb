language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 686: bei Irrtum über die Person des Geschäftsherrn wird der wirkliche Geschäftsherr berechtigt und verpflichtet.
test "§ 686: wirklicher Geschäftsherr wird berechtigt und verpflichtet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geschaeftsfuehrer_im_irrtum_ueber_geschaeftsherrn_686(entity_ref("urn:de:bgb:sv:go09:GF"), entity_ref("urn:de:bgb:sv:go09:HERR")) { origin case_input; }
    }
    evaluate truth(wirklicher_geschaeftsherr_berechtigt_und_verpflichtet_686(entity_ref("urn:de:bgb:sv:go09:GF"), entity_ref("urn:de:bgb:sv:go09:HERR")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
