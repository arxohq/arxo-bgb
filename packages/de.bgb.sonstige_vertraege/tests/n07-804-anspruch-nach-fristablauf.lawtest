language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 804 Absatz 1 Satz 1: der Verlust ist rechtzeitig angezeigt, der Schein wurde nicht vorgelegt — nach Fristablauf kann der bisherige Inhaber die Leistung verlangen.
test "§ 804 Absatz 1: Anspruch des bisherigen Inhabers nach Fristablauf" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": verlust_von_schein_angezeigt_vor_fristablauf(entity_ref("urn:de:bgb:sv:n07:RG")) { origin case_input; }
    }
    evaluate truth(anspruch_auf_leistung_nach_fristablauf_804(entity_ref("urn:de:bgb:sv:n07:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
