language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675r Absatz 1 Satz 2: Ausführung anhand der angegebenen Kundenkennung gilt als ordnungsgemäß.
test "§ 675r Absatz 1: Ausführung in Übereinstimmung mit der Kundenkennung ist ordnungsgemäß" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kundenkennung_angegeben_675r(entity_ref("urn:de:bgb:sv:z37:Z")) { origin case_input; }
        assert "f2": ausgefuehrt_in_uebereinstimmung_mit_kundenkennung_675r(entity_ref("urn:de:bgb:sv:z37:Z")) { origin case_input; }
    }
    evaluate truth(ordnungsgemaess_ausgefuehrt_675r(entity_ref("urn:de:bgb:sv:z37:Z")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
