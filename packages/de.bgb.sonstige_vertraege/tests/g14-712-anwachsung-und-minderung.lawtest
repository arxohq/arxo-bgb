language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 712 Absatz 1, 2: Anwachsung beim Ausscheiden eines Gesellschafters, Minderung beim Eintritt eines neuen Gesellschafters.
test "§ 712: Anwachsung bei Ausscheiden und Minderung bei Eintritt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g14:G"), entity_ref("urn:de:bgb:sv:g14:P")) { origin case_input; }
        assert "f2": ausscheidensgrund_eingetreten(entity_ref("urn:de:bgb:sv:g14:G"), entity_ref("urn:de:bgb:sv:g14:P"), TodDesGesellschafters) { origin case_input; }
        assert "f3": neuer_gesellschafter_tritt_ein_712(entity_ref("urn:de:bgb:sv:g14:G"), entity_ref("urn:de:bgb:sv:g14:N")) { origin case_input; }
    }
    evaluate truth(anwachsung_bei_ausscheiden_712(entity_ref("urn:de:bgb:sv:g14:G"), entity_ref("urn:de:bgb:sv:g14:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(minderung_der_anteile_bei_eintritt_712(entity_ref("urn:de:bgb:sv:g14:G"), entity_ref("urn:de:bgb:sv:g14:N")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
