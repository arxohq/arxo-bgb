language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675v Absatz 3 Nummer 1: der Zahler hat in betrügerischer Absicht gehandelt — er haftet in voller Höhe, nicht nur bis 50 Euro.
test "§ 675v Absatz 3 Nummer 1: volle Haftung bei betrügerischer Absicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": nicht_autorisierter_zahlungsvorgang(entity_ref("urn:de:bgb:sv:z03:Z")) { origin case_input; }
        assert "f2": zahlungsinstrument_abhandengekommen_oder_missbraucht(entity_ref("urn:de:bgb:sv:z03:Z")) { origin case_input; }
        assert "f3": zahler_in_betruegerischer_absicht(entity_ref("urn:de:bgb:sv:z03:Z")) { origin adjudicated; }
    }
    evaluate truth(haftung_des_zahlers_in_voller_hoehe(entity_ref("urn:de:bgb:sv:z03:Z")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
