language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu g08: Kündigung am 01.10.2026 erklärt — drei Monate später ist der 01.01.2027, dessen Kalenderjahr endet erst am 31.12.2027: die Mitgliedschaft endet zum Ablauf des FOLGEJAHRES.
test "§ 725 Absatz 1: Kündigung ab dem 1. Oktober endet zum 31.12. des Folgejahres" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kuendigung_erklaert_am(entity_ref("urn:de:bgb:sv:g09:F"), @2026-10-01) { origin case_input; }
    }
    evaluate truth(kalenderjahresende_der_kuendigung_725(entity_ref("urn:de:bgb:sv:g09:F"), @2027-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(kalenderjahresende_der_kuendigung_725(entity_ref("urn:de:bgb:sv:g09:F"), @2026-12-31));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
