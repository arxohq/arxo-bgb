language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675e Absatz 4: für Unternehmer vereinbarte Abweichung ist zulässig.
test "§ 675e Absatz 4: Abweichung für Unternehmer ist zulässig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kein_verbraucher_675e(entity_ref("urn:de:bgb:sv:z42:ZDV")) { origin case_input; }
        assert "f2": abweichung_675e_abs4_vereinbart(entity_ref("urn:de:bgb:sv:z42:ZDV")) { origin case_input; }
    }
    evaluate truth(abweichung_675e_abs4_zulaessig(entity_ref("urn:de:bgb:sv:z42:ZDV")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
