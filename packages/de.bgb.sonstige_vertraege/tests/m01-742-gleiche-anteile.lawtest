language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 742: drei Teilhaber, keine abweichenden Anteile bestimmt — im Zweifel gleiche Anteile, also 1/3.
test "§ 742: im Zweifel gleiche Anteile der Teilhaber" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": recht_steht_mehreren_gemeinschaftlich_zu(entity_ref("urn:de:bgb:sv:m01:GM")) { origin case_input; }
        assert "f2": teilhaber(entity_ref("urn:de:bgb:sv:m01:GM"), entity_ref("urn:de:bgb:sv:m01:A")) { origin case_input; }
        assert "f3": teilhaber(entity_ref("urn:de:bgb:sv:m01:GM"), entity_ref("urn:de:bgb:sv:m01:B")) { origin case_input; }
        assert "f4": teilhaber(entity_ref("urn:de:bgb:sv:m01:GM"), entity_ref("urn:de:bgb:sv:m01:C")) { origin case_input; }
    }
    evaluate truth(teilhaberanteil_bruch(entity_ref("urn:de:bgb:sv:m01:GM"), entity_ref("urn:de:bgb:sv:m01:A"), 1, 3));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
