language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675s Absatz 1 Satz 1: Zugang des Zahlungsauftrags am Mittwoch, 16.09.2026 — die Ausführungsfrist endet mit dem nächsten Geschäftstag, Donnerstag, 17.09.2026.
test "§ 675s Absatz 1: Ausführungsfrist von einem Geschäftstag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_TAG; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ausfuehrungsfrist_675s(entity_ref("urn:de:bgb:sv:z07:F")) { origin case_input; }
        assert "f2": zugang_des_zahlungsauftrags_am_675s(entity_ref("urn:de:bgb:sv:z07:F"), @2026-09-16) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sv:z07:F"), @2026-09-17));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
