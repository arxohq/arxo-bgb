language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675z Satz 2: ein nicht von § 675y erfasster Schaden ohne Vorsatz oder grobe Fahrlässigkeit — die Haftung kann auf 12 500 Euro begrenzt werden.
test "§ 675z: Haftungsbegrenzung ohne Vorsatz oder grobe Fahrlässigkeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": schaden_wegen_nicht_erfolgter_fehlerhafter_oder_verspaeteter_ausfuehrung_675z(entity_ref("urn:de:bgb:sv:z16:Z"), 20000.00 EUR) { origin case_input; }
    }
    evaluate truth(haftung_begrenzt_auf_12500_euro_675z(entity_ref("urn:de:bgb:sv:z16:Z")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
