language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu a03: hat der Angewiesene bereits angenommen oder geleistet, trägt § 790 Satz 1 das Widerrufsrecht nicht mehr.
test "§ 790: kein Widerrufsrecht nach Annahme oder Leistung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": anweisung_dem_empfaenger_ausgehaendigt(entity_ref("urn:de:bgb:sv:a04:A")) { origin case_input; }
        assert "f2": angewiesener_hat_angenommen_oder_geleistet(entity_ref("urn:de:bgb:sv:a04:A")) { origin case_input; }
    }
    evaluate truth(widerrufsrecht_790(entity_ref("urn:de:bgb:sv:a04:A")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
