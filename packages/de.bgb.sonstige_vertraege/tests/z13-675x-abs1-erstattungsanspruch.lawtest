language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675x Absatz 1 Satz 1: bei der Autorisierung wurde der genaue Betrag nicht angegeben und der Zahlungsbetrag übersteigt den erwartbaren Betrag — der Zahler hat einen Erstattungsanspruch.
test "§ 675x Absatz 1: Erstattungsanspruch ohne Angabe des genauen Betrags" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": betrag_bei_autorisierung_nicht_angegeben_675x(entity_ref("urn:de:bgb:sv:z13:Z")) { origin case_input; }
        assert "f2": zahlungsbetrag_uebersteigt_erwartbaren_betrag_675x(entity_ref("urn:de:bgb:sv:z13:Z")) { origin case_input; }
        assert "f3": rechtzeitig_geltend_gemacht_675x(entity_ref("urn:de:bgb:sv:z13:Z")) { origin case_input; }
    }
    evaluate truth(erstattungsanspruch_675x(entity_ref("urn:de:bgb:sv:z13:Z")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(erstattungsanspruch_ausgeschlossen_675x(entity_ref("urn:de:bgb:sv:z13:Z")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
