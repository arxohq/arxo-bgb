language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675v Absatz 2 Nummer 1: derselbe Fall wie z01, nur war der Verlust vor dem Zahlungsvorgang nicht bemerkbar — die 50-Euro-Haftung entfällt. Kanarienvogel „minus eine Bedingung".
test "§ 675v Absatz 2 Nummer 1: kein nicht bemerkbarer Verlust — keine Haftung bis 50 Euro" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": nicht_autorisierter_zahlungsvorgang(entity_ref("urn:de:bgb:sv:z02:Z")) { origin case_input; }
        assert "f2": zahlungsinstrument_abhandengekommen_oder_missbraucht(entity_ref("urn:de:bgb:sv:z02:Z")) { origin case_input; }
        assert "f3": verlust_nicht_bemerkbar(entity_ref("urn:de:bgb:sv:z02:Z")) { origin case_input; }
    }
    evaluate truth(haftung_des_zahlers_bis_50_euro(entity_ref("urn:de:bgb:sv:z02:Z"), 50.00 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
