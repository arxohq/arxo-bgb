language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 505 Absatz 2 Satz 1: Entgelt für geduldete Überziehung vereinbart, erhebliche Überziehung von mehr als einem Monat — der Darlehensgeber muss unverzüglich unterrichten.
test "§ 505 Absatz 2 Satz 1: Unterrichtungspflicht bei erheblicher Überziehung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": entgelt_fuer_geduldete_ueberziehung_vereinbart_505(entity_ref("urn:de:bgb:sv:v09:D")) { origin case_input; }
        assert "f2": erhebliche_ueberziehung_ueber_einen_monat_505(entity_ref("urn:de:bgb:sv:v09:D")) { origin case_input; }
    }
    evaluate truth(unterrichtungspflicht_505_abs2(entity_ref("urn:de:bgb:sv:v09:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
