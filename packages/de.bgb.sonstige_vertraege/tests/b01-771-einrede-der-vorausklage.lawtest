language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 771 Satz 1: der Gläubiger hat nicht erfolglos vollstreckt und kein Ausschlussgrund des § 773 liegt vor — die Einrede der Vorausklage steht dem Bürgen zu.
test "§ 771: Einrede der Vorausklage steht dem Bürgen zu" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": buergschaftserklaerung_abgegeben(entity_ref("urn:de:bgb:sv:b01:B")) { origin case_input; }
        assert "f2": buergschaftserklaerung_schriftlich_erteilt(entity_ref("urn:de:bgb:sv:b01:B")) { origin case_input; }
    }
    evaluate truth(einrede_der_vorausklage(entity_ref("urn:de:bgb:sv:b01:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
