language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 704: Forderung für Wohnung/Leistungen begründet das Pfandrecht, das seinerseits die
// entsprechende Anwendung der Vermieterpfandrechtsvorschriften auslöst (§ 704 Satz 1, 2).
test "§ 704: Pfandrecht des Gastwirts und entsprechende Vermieterpfandrechtsvorschriften" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": forderung_fuer_wohnung_und_leistungen_704(entity_ref("urn:de:bgb:sv:u14:GA")) { origin case_input; }
    }
    evaluate truth(vermieterpfandrechtsvorschriften_entsprechend_704(entity_ref("urn:de:bgb:sv:u14:GA")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
