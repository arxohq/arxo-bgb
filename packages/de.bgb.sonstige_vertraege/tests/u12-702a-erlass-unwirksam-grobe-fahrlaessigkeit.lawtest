language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu u11: grobe Fahrlässigkeit des Gastwirts sperrt den Erlass — kein Erzeuger für "wirksam".
test "§ 702a Absatz 1 Satz 2: der Erlass ist bei grober Fahrlässigkeit unwirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erlass_der_haftung_erklaert_702a(entity_ref("urn:de:bgb:sv:u12:GA")) { origin case_input; }
        assert "f2": vorsatz_oder_grobe_fahrlaessigkeit_702a(entity_ref("urn:de:bgb:sv:u12:GA")) { origin case_input; }
    }
    evaluate truth(erlass_der_haftung_wirksam_702a(entity_ref("urn:de:bgb:sv:u12:GA")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
