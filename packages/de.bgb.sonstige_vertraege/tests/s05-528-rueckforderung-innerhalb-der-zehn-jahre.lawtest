language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 528 Absatz 1 Satz 1: derselbe Fall wie s04, nur tritt die Bedürftigkeit am 01.05.2024 ein — innerhalb der Zehnjahresfrist; der Rückforderungsanspruch besteht.
test "§ 528: Rückforderung wegen Verarmung innerhalb der Zehnjahresfrist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zuwendung_bereichert_den_anderen(entity_ref("urn:de:bgb:sv:s05:S"), 90000.00 EUR) { origin case_input; }
        assert "f2": einigkeit_ueber_unentgeltlichkeit(entity_ref("urn:de:bgb:sv:s05:S")) { origin case_input; }
        assert "f3": ruckforderungsfrist_529(entity_ref("urn:de:bgb:sv:s05:F")) { origin case_input; }
        assert "f4": leistung_des_geschenkten_gegenstandes_am(entity_ref("urn:de:bgb:sv:s05:F"), @2014-06-01) { origin case_input; }
        assert "f5": beduerftigkeit_eingetreten_am(entity_ref("urn:de:bgb:sv:s05:S"), @2024-05-01) { origin adjudicated; }
        assert "f6": schenker_kann_unterhalt_nicht_bestreiten(entity_ref("urn:de:bgb:sv:s05:S")) { origin adjudicated; }
    }
    evaluate truth(rueckforderungsanspruch_528(entity_ref("urn:de:bgb:sv:s05:S")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
