language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 773 Absatz 1 Nummer 3: über das Vermögen des Hauptschuldners ist das Insolvenzverfahren eröffnet — die Einrede der Vorausklage ist ausgeschlossen.
test "§ 773 Absatz 1 Nummer 3: Insolvenz des Hauptschuldners schließt die Einrede aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": buergschaftserklaerung_abgegeben(entity_ref("urn:de:bgb:sv:b03:B")) { origin case_input; }
        assert "f2": buergschaftserklaerung_schriftlich_erteilt(entity_ref("urn:de:bgb:sv:b03:B")) { origin case_input; }
        assert "f3": insolvenzverfahren_ueber_hauptschuldner_eroeffnet(entity_ref("urn:de:bgb:sv:b03:B")) { origin case_input; }
    }
    evaluate truth(einrede_der_vorausklage_ausgeschlossen(entity_ref("urn:de:bgb:sv:b03:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
