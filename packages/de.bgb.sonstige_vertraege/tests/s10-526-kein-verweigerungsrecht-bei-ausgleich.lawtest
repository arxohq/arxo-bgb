language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu s09: ist der Fehlbetrag ausgeglichen, entfällt das Verweigerungsrecht.
test "§ 526: kein Verweigerungsrecht nach Ausgleich des Fehlbetrags" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": wert_der_zuwendung_526(entity_ref("urn:de:bgb:sv:s10:S"), 300.00 EUR) { origin case_input; }
        assert "f2": erforderliche_aufwendungen_zur_auflage_526(entity_ref("urn:de:bgb:sv:s10:S"), 500.00 EUR) { origin case_input; }
        assert "f3": fehlbetrag_526_ausgeglichen(entity_ref("urn:de:bgb:sv:s10:S")) { origin case_input; }
    }
    evaluate truth(vollziehung_526_verweigerbar(entity_ref("urn:de:bgb:sv:s10:S")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
