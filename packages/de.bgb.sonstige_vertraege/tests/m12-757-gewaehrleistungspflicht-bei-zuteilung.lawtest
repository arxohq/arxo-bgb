language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 757: wird bei der Aufhebung ein Gegenstand einem Teilhaber zugeteilt, haften die übrigen Teilhaber wie ein Verkäufer.
test "§ 757: Gewährleistungspflicht der übrigen Teilhaber bei Zuteilung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": recht_steht_mehreren_gemeinschaftlich_zu(entity_ref("urn:de:bgb:sv:m12:GM")) { origin case_input; }
        assert "f2": teilhaber(entity_ref("urn:de:bgb:sv:m12:GM"), entity_ref("urn:de:bgb:sv:m12:B")) { origin case_input; }
        assert "f3": gegenstand_einem_teilhaber_zugeteilt_757(entity_ref("urn:de:bgb:sv:m12:GM"), entity_ref("urn:de:bgb:sv:m12:A")) { origin case_input; }
    }
    evaluate truth(gewaehrleistungspflicht_757(entity_ref("urn:de:bgb:sv:m12:GM"), entity_ref("urn:de:bgb:sv:m12:A"), entity_ref("urn:de:bgb:sv:m12:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
