language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu z30: ohne die Inlandsklausel bleibt die Grenze bei 150 Euro — 180 Euro überschreitet sie.
test "§ 675i Absatz 1 Nummer 2: ohne Inlandsklausel überschreiten 180 Euro die 150-Euro-Grenze" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ausgabenobergrenze_kleinbetragsinstrument(entity_ref("urn:de:bgb:sv:z31:ZDV"), 180.00 EUR) { origin case_input; }
    }
    evaluate truth(kleinbetragsinstrument_675i(entity_ref("urn:de:bgb:sv:z31:ZDV")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
