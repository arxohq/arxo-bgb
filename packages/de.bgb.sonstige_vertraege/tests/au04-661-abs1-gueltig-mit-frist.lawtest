language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 661 Absatz 1: das Preisausschreiben ist gültig, wenn eine Bewerbungsfrist bestimmt ist.
test "§ 661 Absatz 1: Preisausschreiben ist mit bestimmter Frist gültig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": auslobung_hat_preisbewerbung_zum_gegenstand_661(entity_ref("urn:de:bgb:sv:au04:AL")) { origin case_input; }
        assert "f2": frist_fuer_bewerbung_bestimmt_661(entity_ref("urn:de:bgb:sv:au04:AL")) { origin case_input; }
    }
    evaluate truth(preisausschreiben_661_gueltig(entity_ref("urn:de:bgb:sv:au04:AL")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
