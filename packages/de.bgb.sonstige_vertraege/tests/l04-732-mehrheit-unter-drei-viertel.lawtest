language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu l03: nur zwei von vier abgegebenen Stimmen stimmen zu — 4 × 2 = 8 < 4 × 3 = 12, keine Dreiviertelmehrheit: der Beschluss ist nicht gefasst.
test "§ 732: kein Auflösungsbeschluss unter der Dreiviertelmehrheit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": mehrheitsklausel_vereinbart(entity_ref("urn:de:bgb:sv:l04:G")) { origin case_input; }
        assert "f2": aufloesungsbeschluss_732(entity_ref("urn:de:bgb:sv:l04:G"), "Auflösung") { origin case_input; }
        assert "f3": hat_abgestimmt(entity_ref("urn:de:bgb:sv:l04:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l04:A")) { origin case_input; }
        assert "f4": hat_abgestimmt(entity_ref("urn:de:bgb:sv:l04:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l04:B")) { origin case_input; }
        assert "f5": hat_abgestimmt(entity_ref("urn:de:bgb:sv:l04:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l04:C")) { origin case_input; }
        assert "f6": hat_abgestimmt(entity_ref("urn:de:bgb:sv:l04:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l04:D")) { origin case_input; }
        assert "f7": zugestimmt(entity_ref("urn:de:bgb:sv:l04:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l04:A")) { origin case_input; }
        assert "f8": zugestimmt(entity_ref("urn:de:bgb:sv:l04:G"), "Auflösung", entity_ref("urn:de:bgb:sv:l04:B")) { origin case_input; }
    }
    evaluate truth(aufloesungsbeschluss_732_gefasst(entity_ref("urn:de:bgb:sv:l04:G"), "Auflösung"));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
