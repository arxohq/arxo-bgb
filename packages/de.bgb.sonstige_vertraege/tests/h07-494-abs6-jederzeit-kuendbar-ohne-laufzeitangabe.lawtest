language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 494 Absatz 6 Satz 1: fehlende Laufzeit-/Kündigungsangabe macht den Darlehensnehmer jederzeit kündigungsberechtigt.
test "§ 494 Absatz 6: jederzeitige Kündigung ohne Laufzeit- oder Kündigungsangabe" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": angaben_zu_laufzeit_oder_kuendigungsrecht_fehlen_494(entity_ref("urn:de:bgb:sv:h07:D")) { origin case_input; }
    }
    evaluate truth(darlehensnehmer_494_jederzeit_kuendigungsberechtigt(entity_ref("urn:de:bgb:sv:h07:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
