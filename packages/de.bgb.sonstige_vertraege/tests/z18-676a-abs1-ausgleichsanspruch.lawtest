language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 676a Absatz 1: die Ursache der Haftung liegt im Verantwortungsbereich eines anderen Zahlungsdienstleisters — der zunächst haftende Zahlungsdienstleister hat einen Ausgleichsanspruch.
test "§ 676a Absatz 1: Ausgleichsanspruch gegen den verantwortlichen Dritten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ursache_im_verantwortungsbereich_eines_anderen_675u_675y_675z(entity_ref("urn:de:bgb:sv:z18:Z"), entity_ref("urn:de:bgb:sv:z18:D")) { origin case_input; }
    }
    evaluate truth(ausgleichsanspruch_676a(entity_ref("urn:de:bgb:sv:z18:Z"), entity_ref("urn:de:bgb:sv:z18:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
