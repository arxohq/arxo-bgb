language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 685 Absatz 2: bei Unterhaltsgewährung zwischen Eltern/Voreltern und Abkömmlingen wird im Zweifel keine Ersatzabsicht vermutet.
test "§ 685 Absatz 2: keine Ersatzabsicht bei Unterhaltsgewährung vermutet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": eltern_oder_voreltern_gewaehren_abkoemmlingen_unterhalt_685(entity_ref("urn:de:bgb:sv:go07:GF")) { origin case_input; }
    }
    evaluate truth(keine_ersatzabsicht(entity_ref("urn:de:bgb:sv:go07:GF")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
