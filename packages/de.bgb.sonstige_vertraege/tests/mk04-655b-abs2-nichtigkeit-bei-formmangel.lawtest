language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 655b Absatz 2: fehlende Schriftform und fehlende vorvertragliche Pflichterfüllung machen den Vertrag nichtig.
test "§ 655b Absatz 2: Nichtigkeit bei Formmangel und fehlenden vorvertraglichen Pflichten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": darlehensvermittlungsvertrag_mit_verbraucher_655b(entity_ref("urn:de:bgb:sv:mk04:M")) { origin case_input; }
    }
    evaluate truth(darlehensvermittlungsvertrag_655b_nichtig(entity_ref("urn:de:bgb:sv:mk04:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
