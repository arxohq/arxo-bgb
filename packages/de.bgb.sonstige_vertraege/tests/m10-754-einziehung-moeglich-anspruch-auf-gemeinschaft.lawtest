language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu m09: ist die Einziehung möglich, kann jeder Teilhaber gemeinschaftliche Einziehung verlangen statt Verkauf (§ 754 Satz 2).
test "§ 754 Satz 2: Anspruch auf gemeinschaftliche Einziehung, wenn möglich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": recht_steht_mehreren_gemeinschaftlich_zu(entity_ref("urn:de:bgb:sv:m10:GM")) { origin case_input; }
        assert "f2": teilhaber(entity_ref("urn:de:bgb:sv:m10:GM"), entity_ref("urn:de:bgb:sv:m10:A")) { origin case_input; }
        assert "f3": einziehung_moeglich_754(entity_ref("urn:de:bgb:sv:m10:GM")) { origin case_input; }
    }
    evaluate truth(anspruch_auf_gemeinschaftliche_einziehung_754(entity_ref("urn:de:bgb:sv:m10:GM"), entity_ref("urn:de:bgb:sv:m10:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
