language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 792 Absatz 1: schriftlicher Übertragungsvertrag mit dem Dritten und Aushändigung der Anweisung an ihn übertragen die Anweisung wirksam, auch vor Annahme.
test "§ 792 Absatz 1: Übertragung der Anweisung durch Vertrag mit dem Dritten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": uebertragungsvertrag_mit_drittem_geschlossen(entity_ref("urn:de:bgb:sv:a05:A"), entity_ref("urn:de:bgb:sv:a05:D")) { origin case_input; }
        assert "f2": uebertragungserklaerung_schriftlich(entity_ref("urn:de:bgb:sv:a05:A"), entity_ref("urn:de:bgb:sv:a05:D")) { origin case_input; }
        assert "f3": anweisung_an_dritten_ausgehaendigt(entity_ref("urn:de:bgb:sv:a05:A"), entity_ref("urn:de:bgb:sv:a05:D")) { origin case_input; }
    }
    evaluate truth(uebertragung_wirksam_792(entity_ref("urn:de:bgb:sv:a05:A"), entity_ref("urn:de:bgb:sv:a05:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
