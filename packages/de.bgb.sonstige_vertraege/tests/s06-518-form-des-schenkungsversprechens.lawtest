language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 518 Absatz 1 Satz 1: das Schenkungsversprechen ist weder notariell beurkundet noch ist die versprochene Leistung bewirkt — es ist nicht gültig. Kanarienvogel „minus eine Bedingung" zu s07.
test "§ 518 Absatz 1: Schenkungsversprechen ohne notarielle Beurkundung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": schenkungsversprechen(entity_ref("urn:de:bgb:sv:s06:S")) { origin case_input; }
    }
    evaluate truth(schenkungsversprechen_gueltig(entity_ref("urn:de:bgb:sv:s06:S")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
