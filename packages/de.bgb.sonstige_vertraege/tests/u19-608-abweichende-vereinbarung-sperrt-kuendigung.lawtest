language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu u18: eine abweichende Vereinbarung sperrt die jederzeitige Kündbarkeit (§ 608 Absatz 2 Halbsatz 1).
test "§ 608 Absatz 2: abweichende Vereinbarung schließt jederzeitige Kündigung aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": sachdarlehensvertrag_geschlossen(entity_ref("urn:de:bgb:sv:u19:SD")) { origin case_input; }
        assert "f2": rueckerstattungszeit_unbestimmt_608(entity_ref("urn:de:bgb:sv:u19:SD")) { origin case_input; }
        assert "f3": kuendigung_608_erklaert(entity_ref("urn:de:bgb:sv:u19:SD")) { origin case_input; }
        assert "f4": abweichende_vereinbarung_608(entity_ref("urn:de:bgb:sv:u19:SD")) { origin case_input; }
    }
    evaluate truth(kuendigung_608_wirksam(entity_ref("urn:de:bgb:sv:u19:SD")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
