language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 505 Absatz 3: verstößt der Unternehmer gegen Absatz 1 oder 2, kann er über die Rückzahlung des Darlehens hinaus keine Kosten und Zinsen verlangen.
test "§ 505 Absatz 3: kein Anspruch auf Kosten und Zinsen bei Verstoß" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": verstoss_gegen_absatz_1_oder_2_505(entity_ref("urn:de:bgb:sv:v11:D")) { origin case_input; }
    }
    evaluate truth(keine_kosten_und_zinsen_ueber_rueckzahlung_hinaus_505(entity_ref("urn:de:bgb:sv:v11:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
