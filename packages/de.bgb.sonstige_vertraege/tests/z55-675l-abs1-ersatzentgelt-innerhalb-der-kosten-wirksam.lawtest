language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu z54: genau die tatsächlichen Kosten (8 Euro) sind keine Überschreitung.
test "§ 675l Absatz 1: Ersatzentgelt in Höhe der Kosten bleibt wirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ersatzentgelt_vereinbart_675l(entity_ref("urn:de:bgb:sv:z55:ZDV"), 8.00 EUR) { origin case_input; }
        assert "f2": ersatzkosten_675l(entity_ref("urn:de:bgb:sv:z55:ZDV"), 8.00 EUR) { origin case_input; }
    }
    evaluate truth(ersatzentgelt_675l_unwirksam(entity_ref("urn:de:bgb:sv:z55:ZDV")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
