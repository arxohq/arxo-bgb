language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 730 Absatz 1: im Gesellschaftsvertrag ist die Auflösung durch den Tod eines Gesellschafters vereinbart, der Gesellschafter stirbt — die Gesellschaft ist aufgelöst, der Erbe hat unverzüglich anzuzeigen.
test "§ 730 Absatz 1: Auflösung durch den Tod eines Gesellschafters" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": aufloesung_bei_tod_vereinbart_730(entity_ref("urn:de:bgb:sv:l01:G")) { origin case_input; }
        assert "f2": gesellschafter_verstorben(entity_ref("urn:de:bgb:sv:l01:G"), entity_ref("urn:de:bgb:sv:l01:P")) { origin case_input; }
        assert "f3": erbe_des_gesellschafters(entity_ref("urn:de:bgb:sv:l01:G"), entity_ref("urn:de:bgb:sv:l01:P"), entity_ref("urn:de:bgb:sv:l01:E")) { origin case_input; }
    }
    evaluate truth(gesellschaft_aufgeloest_durch_tod_730(entity_ref("urn:de:bgb:sv:l01:G"), entity_ref("urn:de:bgb:sv:l01:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesellschaft_aufgeloest(entity_ref("urn:de:bgb:sv:l01:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anzeigepflicht_des_erben_730(entity_ref("urn:de:bgb:sv:l01:G"), entity_ref("urn:de:bgb:sv:l01:P"), entity_ref("urn:de:bgb:sv:l01:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
