language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 731 Absatz 1: wichtiger Grund festgestellt, Kündigung ohne Kündigungsfrist erklärt — die Kündigung ist wirksam und löst die Gesellschaft auf.
test "§ 731 Absatz 1: Kündigung aus wichtigem Grund ohne Frist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:l02:G"), entity_ref("urn:de:bgb:sv:l02:P")) { origin case_input; }
        assert "f2": wichtiger_grund_kuendigung_731(entity_ref("urn:de:bgb:sv:l02:G"), entity_ref("urn:de:bgb:sv:l02:P")) { origin adjudicated; }
        assert "f3": kuendigung_ohne_frist_erklaert_731(entity_ref("urn:de:bgb:sv:l02:G"), entity_ref("urn:de:bgb:sv:l02:P")) { origin case_input; }
    }
    evaluate truth(kuendigung_731_wirksam(entity_ref("urn:de:bgb:sv:l02:G"), entity_ref("urn:de:bgb:sv:l02:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesellschaft_aufgeloest(entity_ref("urn:de:bgb:sv:l02:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
