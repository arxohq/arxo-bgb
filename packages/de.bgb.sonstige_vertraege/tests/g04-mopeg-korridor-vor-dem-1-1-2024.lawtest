language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Korridor MoPeG: mit legal_time am 31.12.2023 sind die Regeln des Titel 16 noch nicht in Kraft — das Paket schweigt, statt die alte Fassung zu behaupten.
test "Titel 16 vor dem 1.1.2024: kein Anteil nach § 709 Absatz 3" {
    given {
        context { legal_time @2023-12-31; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g04:G"), entity_ref("urn:de:bgb:sv:g04:A")) { origin case_input; }
        assert "f2": gesellschafter(entity_ref("urn:de:bgb:sv:g04:G"), entity_ref("urn:de:bgb:sv:g04:B")) { origin case_input; }
    }
    evaluate truth(anteil_bruch(entity_ref("urn:de:bgb:sv:g04:G"), entity_ref("urn:de:bgb:sv:g04:A"), 1, 2));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
