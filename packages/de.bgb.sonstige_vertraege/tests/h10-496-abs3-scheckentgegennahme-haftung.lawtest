language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 496 Absatz 3 Satz 2, 4: entgegengenommener Scheck begründet die Haftung des Darlehensgebers für den Schaden.
test "§ 496 Absatz 3: Scheckentgegennahme begründet die Haftung des Darlehensgebers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": scheck_vom_darlehensgeber_entgegengenommen_496(entity_ref("urn:de:bgb:sv:h10:D")) { origin case_input; }
        assert "f2": schaden_aus_wechsel_oder_scheckbegebung_496(entity_ref("urn:de:bgb:sv:h10:D"), 50.00 EUR) { origin case_input; }
    }
    evaluate truth(haftung_des_darlehensgebers_496(entity_ref("urn:de:bgb:sv:h10:D"), 50.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
