language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 676b Absatz 2 Satz 1: Belastung am 01.02.2025, Unterrichtung am 05.03.2026 — nach dem Fristende 01.03.2026 (Sonntag, mit Verlegung 02.03.2026); Ansprüche und Einwendungen sind ausgeschlossen.
test "§ 676b Absatz 2: Unterrichtung nach Ablauf der Dreizehnmonatsfrist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": anzeigefrist_676b(entity_ref("urn:de:bgb:sv:z05:F")) { origin case_input; }
        assert "f2": tag_der_belastung(entity_ref("urn:de:bgb:sv:z05:F"), @2025-02-01) { origin case_input; }
        assert "f3": unterrichtung_erfolgt_am(entity_ref("urn:de:bgb:sv:z05:Z"), @2026-03-05) { origin case_input; }
    }
    evaluate truth(ansprueche_676b_ausgeschlossen(entity_ref("urn:de:bgb:sv:z05:Z")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
