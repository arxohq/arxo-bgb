language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 529 Absatz 1: Leistung des geschenkten Gegenstandes am 01.06.2014, Bedürftigkeit am 01.07.2024 eingetreten — nach Ablauf der Zehnjahresfrist (01.06.2024, Samstag; Verlegung auf Montag den 03.06.2024); der Rückforderungsanspruch ist ausgeschlossen.
test "§ 529 Absatz 1: Bedürftigkeit nach Ablauf der Zehnjahresfrist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zuwendung_bereichert_den_anderen(entity_ref("urn:de:bgb:sv:s04:S"), 90000.00 EUR) { origin case_input; }
        assert "f2": einigkeit_ueber_unentgeltlichkeit(entity_ref("urn:de:bgb:sv:s04:S")) { origin case_input; }
        assert "f3": ruckforderungsfrist_529(entity_ref("urn:de:bgb:sv:s04:F")) { origin case_input; }
        assert "f4": leistung_des_geschenkten_gegenstandes_am(entity_ref("urn:de:bgb:sv:s04:F"), @2014-06-01) { origin case_input; }
        assert "f5": beduerftigkeit_eingetreten_am(entity_ref("urn:de:bgb:sv:s04:S"), @2024-07-01) { origin adjudicated; }
        assert "f6": schenker_kann_unterhalt_nicht_bestreiten(entity_ref("urn:de:bgb:sv:s04:S")) { origin adjudicated; }
    }
    evaluate truth(rueckforderungsanspruch_528(entity_ref("urn:de:bgb:sv:s04:S")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
