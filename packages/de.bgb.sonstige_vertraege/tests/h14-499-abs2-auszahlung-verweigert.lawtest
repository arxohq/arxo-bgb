language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 499 Absatz 2 Satz 1: Auszahlung darf bei entsprechender Vereinbarung aus sachlichem Grund verweigert werden.
test "§ 499 Absatz 2: Auszahlung wird bei sachlichem Grund verweigert" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": auszahlung_ohne_bestimmte_rueckzahlungszeit_499(entity_ref("urn:de:bgb:sv:h14:D")) { origin case_input; }
        assert "f2": verweigerungsvereinbarung_499_abs2_getroffen(entity_ref("urn:de:bgb:sv:h14:D")) { origin case_input; }
        assert "f3": sachlicher_grund_fuer_verweigerung_499(entity_ref("urn:de:bgb:sv:h14:D")) { origin case_input; }
    }
    evaluate truth(auszahlung_499_verweigert(entity_ref("urn:de:bgb:sv:h14:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
