language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 721b Absatz 1, 2: der in Anspruch genommene Gesellschafter kann Einwendungen der Gesellschaft geltend machen und die Befriedigung verweigern, solange der Gesellschaft ein Gestaltungsrecht zusteht.
test "§ 721b: Einwendungen und Leistungsverweigerungsrecht des Gesellschafters" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g24:G"), entity_ref("urn:de:bgb:sv:g24:P")) { origin case_input; }
        assert "f2": einwendung_nicht_in_person_begruendet_721b(entity_ref("urn:de:bgb:sv:g24:G"), entity_ref("urn:de:bgb:sv:g24:P")) { origin case_input; }
        assert "f3": gesellschaft_hat_anfechtungs_oder_aufrechnungsrecht_721b(entity_ref("urn:de:bgb:sv:g24:G")) { origin case_input; }
    }
    evaluate truth(einwendung_geltend_machbar_721b(entity_ref("urn:de:bgb:sv:g24:G"), entity_ref("urn:de:bgb:sv:g24:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(leistungsverweigerungsrecht_721b(entity_ref("urn:de:bgb:sv:g24:G"), entity_ref("urn:de:bgb:sv:g24:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
