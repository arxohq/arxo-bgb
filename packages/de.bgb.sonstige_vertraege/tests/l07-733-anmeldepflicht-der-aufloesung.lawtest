language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 733 Absatz 1 Satz 1: eine aufgelöste, im Gesellschaftsregister eingetragene Gesellschaft ist von sämtlichen Gesellschaftern zur Eintragung der Auflösung anzumelden.
test "§ 733 Absatz 1: Anmeldepflicht der Auflösung bei eingetragener Gesellschaft" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": aufloesung_bei_tod_vereinbart_730(entity_ref("urn:de:bgb:sv:l07:G")) { origin case_input; }
        assert "f2": gesellschafter_verstorben(entity_ref("urn:de:bgb:sv:l07:G"), entity_ref("urn:de:bgb:sv:l07:P")) { origin case_input; }
        assert "f3": im_gesellschaftsregister_eingetragen(entity_ref("urn:de:bgb:sv:l07:G")) { origin case_input; }
    }
    evaluate truth(anmeldepflicht_der_aufloesung_733(entity_ref("urn:de:bgb:sv:l07:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
