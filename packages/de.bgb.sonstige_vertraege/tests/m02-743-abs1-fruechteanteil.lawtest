language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 743 Absatz 1: Früchte von 900,00 Euro, drei Teilhaber zu gleichen Anteilen — jedem gebühren 300,00 Euro.
test "§ 743 Absatz 1: Früchteanteil entsprechend dem Anteil" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": recht_steht_mehreren_gemeinschaftlich_zu(entity_ref("urn:de:bgb:sv:m02:GM")) { origin case_input; }
        assert "f2": teilhaber(entity_ref("urn:de:bgb:sv:m02:GM"), entity_ref("urn:de:bgb:sv:m02:A")) { origin case_input; }
        assert "f3": teilhaber(entity_ref("urn:de:bgb:sv:m02:GM"), entity_ref("urn:de:bgb:sv:m02:B")) { origin case_input; }
        assert "f4": teilhaber(entity_ref("urn:de:bgb:sv:m02:GM"), entity_ref("urn:de:bgb:sv:m02:C")) { origin case_input; }
        assert "f5": fruechte_des_gegenstands(entity_ref("urn:de:bgb:sv:m02:GM"), 900.00 EUR) { origin case_input; }
    }
    evaluate truth(fruechteanteil(entity_ref("urn:de:bgb:sv:m02:GM"), entity_ref("urn:de:bgb:sv:m02:A"), 300.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
