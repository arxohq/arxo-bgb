language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675i Absatz 1 Nummer 1: Einzelzahlungsvorgang bis genau 30 Euro macht das Instrument zum Kleinbetragsinstrument.
test "§ 675i Absatz 1 Nummer 1: genau 30 Euro je Zahlungsvorgang ist Kleinbetragsinstrument" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zahlungsvorgangsbetrag_kleinbetragsinstrument(entity_ref("urn:de:bgb:sv:z28:ZDV"), 30.00 EUR) { origin case_input; }
    }
    evaluate truth(kleinbetragsinstrument_675i(entity_ref("urn:de:bgb:sv:z28:ZDV")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
