language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675g Absatz 1: Angebot am 01.07.2026, Wirksamwerden am 01.09.2026 — genau zwei Monate, rechtzeitig.
test "§ 675g Absatz 1: Änderungsangebot genau zwei Monate vor Wirksamwerden ist rechtzeitig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": aenderung_vorgeschlagen_am_675g(entity_ref("urn:de:bgb:sv:z20:ZDV"), @2026-07-01) { origin case_input; }
        assert "f2": wirksamwerden_vorgeschlagen_am_675g(entity_ref("urn:de:bgb:sv:z20:ZDV"), @2026-09-01) { origin case_input; }
    }
    evaluate truth(aenderungsangebot_rechtzeitig_675g(entity_ref("urn:de:bgb:sv:z20:ZDV")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
