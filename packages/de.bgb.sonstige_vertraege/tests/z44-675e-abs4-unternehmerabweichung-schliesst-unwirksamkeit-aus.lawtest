language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu z43: bei zulässiger Unternehmerabweichung (§ 675e Absatz 4) ist die Abweichung NICHT unwirksam.
test "§ 675e Absatz 1: keine Unwirksamkeit bei zulässiger Unternehmerabweichung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": abweichung_zum_nachteil_des_nutzers_vereinbart_675e(entity_ref("urn:de:bgb:sv:z44:ZDV")) { origin case_input; }
        assert "f2": kein_verbraucher_675e(entity_ref("urn:de:bgb:sv:z44:ZDV")) { origin case_input; }
        assert "f3": abweichung_675e_abs4_vereinbart(entity_ref("urn:de:bgb:sv:z44:ZDV")) { origin case_input; }
    }
    evaluate truth(abweichung_675e_unwirksam(entity_ref("urn:de:bgb:sv:z44:ZDV")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
