language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675o Absatz 1 Satz 4: Entgeltanspruch bei berechtigter Ablehnung und vereinbartem Entgelt.
test "§ 675o Absatz 1: Entgeltanspruch bei berechtigter Ablehnung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": berechtigte_ablehnung_675o(entity_ref("urn:de:bgb:sv:z62:Z")) { origin case_input; }
        assert "f2": entgelt_fuer_berechtigte_ablehnung_vereinbart_675o(entity_ref("urn:de:bgb:sv:z62:Z"), 2.00 EUR) { origin case_input; }
    }
    evaluate truth(entgeltanspruch_fuer_ablehnung_675o(entity_ref("urn:de:bgb:sv:z62:Z"), 2.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
