language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675d Absatz 4 Nummer 1: Entgelt zulässig bei häufigerer Unterrichtung und angemessenem Entgelt.
test "§ 675d Absatz 4 Nummer 1: Entgelt zulässig bei häufigerer Unterrichtung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": unterrichtung_auf_verlangen_haeufiger_675d(entity_ref("urn:de:bgb:sv:z40:ZDV")) { origin case_input; }
        assert "f2": entgelt_fuer_unterrichtung_angemessen_675d(entity_ref("urn:de:bgb:sv:z40:ZDV")) { origin case_input; }
    }
    evaluate truth(entgelt_fuer_unterrichtung_zulaessig_675d(entity_ref("urn:de:bgb:sv:z40:ZDV")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
