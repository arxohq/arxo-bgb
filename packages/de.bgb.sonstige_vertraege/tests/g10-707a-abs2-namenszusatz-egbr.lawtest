language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 707a Absatz 2 Satz 1: mit der Eintragung ist die Gesellschaft verpflichtet, als Namenszusatz „eingetragene Gesellschaft bürgerlichen Rechts“ oder „eGbR“ zu führen.
test "§ 707a Absatz 2: Namenszusatz-Pflicht der eingetragenen Gesellschaft" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": im_gesellschaftsregister_eingetragen(entity_ref("urn:de:bgb:sv:g10:G")) { origin case_input; }
    }
    evaluate truth(namenszusatz_egbr_pflicht_707a(entity_ref("urn:de:bgb:sv:g10:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
