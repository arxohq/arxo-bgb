language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 499 Absatz 1: eine Kündigungsfrist von einem Monat unterschreitet die Zweimonatsgrenze und ist unwirksam.
test "§ 499 Absatz 1: eine Kündigungsfrist von einem Monat ist unwirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kuendigungsrecht_des_darlehensgebers_vereinbart_499(entity_ref("urn:de:bgb:sv:h12:D")) { origin case_input; }
        assert "f2": kuendigungsfrist_des_darlehensgebers_499(entity_ref("urn:de:bgb:sv:h12:D"), 1) { origin case_input; }
    }
    evaluate truth(kuendigungsrechtsvereinbarung_499_unwirksam(entity_ref("urn:de:bgb:sv:h12:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
