language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675u Satz 2: im Fall eines nicht autorisierten Zahlungsvorgangs über 780,00 Euro ist der Zahlungsdienstleister zur Erstattung des Zahlungsbetrags verpflichtet.
test "§ 675u: Erstattungspflicht des Zahlungsdienstleisters" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": nicht_autorisierter_zahlungsvorgang(entity_ref("urn:de:bgb:sv:z04:Z")) { origin case_input; }
        assert "f2": zahlungsbetrag(entity_ref("urn:de:bgb:sv:z04:Z"), 780.00 EUR) { origin case_input; }
    }
    evaluate truth(erstattungspflicht_675u(entity_ref("urn:de:bgb:sv:z04:Z"), 780.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
