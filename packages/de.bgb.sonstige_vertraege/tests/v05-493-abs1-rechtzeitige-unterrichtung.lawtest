language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 493 Absatz 1 Satz 1: Unterrichtung am 15.10.2026, Sollzinsbindung endet am 15.01.2027 — genau drei Monate vorher, rechtzeitig.
test "§ 493 Absatz 1: Unterrichtung genau drei Monate vor Ende der Sollzinsbindung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": entgeltlicher_darlehensvertrag(entity_ref("urn:de:bgb:sv:v05:D")) { origin case_input; }
        assert "f2": unternehmer_als_darlehensgeber(entity_ref("urn:de:bgb:sv:v05:D")) { origin case_input; }
        assert "f3": verbraucher_als_darlehensnehmer(entity_ref("urn:de:bgb:sv:v05:D")) { origin case_input; }
        assert "f4": sollzinsbindung_endet_vor_rueckzahlung_493(entity_ref("urn:de:bgb:sv:v05:D")) { origin case_input; }
        assert "f5": unterrichtung_erfolgt_am_493(entity_ref("urn:de:bgb:sv:v05:D"), @2026-10-15) { origin case_input; }
        assert "f6": ende_der_sollzinsbindung_am_493(entity_ref("urn:de:bgb:sv:v05:D"), @2027-01-15) { origin case_input; }
    }
    evaluate truth(unterrichtungspflicht_493_sollzinsbindung(entity_ref("urn:de:bgb:sv:v05:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(rechtzeitig_unterrichtet_493(entity_ref("urn:de:bgb:sv:v05:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
