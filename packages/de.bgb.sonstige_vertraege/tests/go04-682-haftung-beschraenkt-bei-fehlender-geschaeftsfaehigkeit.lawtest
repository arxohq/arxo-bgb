language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 682: fehlende oder beschränkte Geschäftsfähigkeit begrenzt die Haftung auf Delikts-/Bereicherungsrecht.
test "§ 682: Haftung beschränkt bei fehlender Geschäftsfähigkeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geschaeftsfuehrer_geschaeftsunfaehig_oder_beschraenkt_682(entity_ref("urn:de:bgb:sv:go04:GF")) { origin case_input; }
    }
    evaluate truth(haftung_682_beschraenkt_auf_delikt_und_bereicherung(entity_ref("urn:de:bgb:sv:go04:GF")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
