language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu u15: mit Erlaubnis des Verleihers ist die Überlassung an Dritte kein vertragswidriger Gebrauch.
test "§ 603: keine Vertragswidrigkeit bei Erlaubnis des Verleihers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": leihvertrag_geschlossen(entity_ref("urn:de:bgb:sv:u16:L")) { origin case_input; }
        assert "f2": gebrauch_einem_dritten_ueberlassen_603(entity_ref("urn:de:bgb:sv:u16:L")) { origin case_input; }
        assert "f3": erlaubnis_des_verleihers_603(entity_ref("urn:de:bgb:sv:u16:L")) { origin case_input; }
    }
    evaluate truth(vertragswidriger_gebrauch_603(entity_ref("urn:de:bgb:sv:u16:L")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
