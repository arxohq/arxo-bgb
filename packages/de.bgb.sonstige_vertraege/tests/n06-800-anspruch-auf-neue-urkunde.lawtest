language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 800 Satz 1: wer den Ausschließungsbeschluss erwirkt hat, kann vom Aussteller eine neue Schuldverschreibung anstelle der für kraftlos erklärten verlangen.
test "§ 800: Anspruch auf neue Urkunde nach Kraftloserklärung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": fuer_kraftlos_erklaert_800(entity_ref("urn:de:bgb:sv:n06:RG")) { origin case_input; }
        assert "f2": ausschliessungsbeschluss_erwirkt_800(entity_ref("urn:de:bgb:sv:n06:RG"), entity_ref("urn:de:bgb:sv:n06:P")) { origin case_input; }
    }
    evaluate truth(anspruch_auf_neue_urkunde_800(entity_ref("urn:de:bgb:sv:n06:RG"), entity_ref("urn:de:bgb:sv:n06:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
