language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 483 Absatz 3: der Vertrag entspricht nicht den Sprachvorgaben des § 483 Absatz 1, 2 — der Vertrag ist nichtig.
test "§ 483 Absatz 3: Nichtigkeit bei Sprachverstoß" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": teilzeitwohnrechtevertrag_geschlossen(entity_ref("urn:de:bgb:sv:w02:T")) { origin case_input; }
        assert "f2": sprachvorgaben_483_nicht_eingehalten(entity_ref("urn:de:bgb:sv:w02:T")) { origin case_input; }
    }
    evaluate truth(vertrag_nichtig_483(entity_ref("urn:de:bgb:sv:w02:T")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
