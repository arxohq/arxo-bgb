language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 725 Absatz 1: Kündigung am 15.09.2026 erklärt, die Dreimonatsfrist endet kalendarisch am 15.12.2026 (Dienstag, kein Feiertag).
test "§ 725 Absatz 1: drei Monate ab Erklärung der Kündigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kuendigungsfrist_725(entity_ref("urn:de:bgb:sv:g07:F")) { origin case_input; }
        assert "f2": kuendigung_erklaert_am(entity_ref("urn:de:bgb:sv:g07:F"), @2026-09-15) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sv:g07:F"), @2026-12-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
