language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 717 Absatz 1, 2: Einsichtsrecht jedes Gesellschafters; Auskunftspflicht der geschäftsführungsbefugten Gesellschafter.
test "§ 717: Einsichtsrecht und Auskunftspflicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g19:G"), entity_ref("urn:de:bgb:sv:g19:P")) { origin case_input; }
    }
    evaluate truth(einsichtsrecht_717(entity_ref("urn:de:bgb:sv:g19:G"), entity_ref("urn:de:bgb:sv:g19:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(auskunftspflicht_der_geschaeftsfuehrer_717(entity_ref("urn:de:bgb:sv:g19:G"), entity_ref("urn:de:bgb:sv:g19:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
