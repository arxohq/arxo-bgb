language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu l11: ist über das Vermögen der Gesellschaft das Insolvenzverfahren eröffnet, findet KEINE Liquidation nach § 735 statt (§ 735 Absatz 1 Satz 1 Halbsatz 2).
test "§ 735 Absatz 1: keine Liquidation bei eröffnetem Insolvenzverfahren" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": aufloesung_bei_tod_vereinbart_730(entity_ref("urn:de:bgb:sv:l12:G")) { origin case_input; }
        assert "f2": gesellschafter_verstorben(entity_ref("urn:de:bgb:sv:l12:G"), entity_ref("urn:de:bgb:sv:l12:P")) { origin case_input; }
        assert "f3": insolvenzverfahren_ueber_vermoegen_der_gesellschaft_eroeffnet_735(entity_ref("urn:de:bgb:sv:l12:G")) { origin case_input; }
    }
    evaluate truth(liquidation_findet_statt_735(entity_ref("urn:de:bgb:sv:l12:G")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
