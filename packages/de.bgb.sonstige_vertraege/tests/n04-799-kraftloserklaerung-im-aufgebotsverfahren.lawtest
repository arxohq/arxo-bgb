language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 799 Absatz 1: eine abhanden gekommene Schuldverschreibung, die kein Zins-, Renten- oder Gewinnanteilschein ist und für die die Urkunde nichts Gegenteiliges bestimmt, kann im Aufgebotsverfahren für kraftlos erklärt werden.
test "§ 799 Absatz 1: Kraftloserklärung einer gewöhnlichen Schuldverschreibung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": urkunde_abhanden_gekommen_oder_vernichtet_799(entity_ref("urn:de:bgb:sv:n04:RG")) { origin case_input; }
    }
    evaluate truth(kraftloserklaerung_im_aufgebotsverfahren_moeglich_799(entity_ref("urn:de:bgb:sv:n04:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
