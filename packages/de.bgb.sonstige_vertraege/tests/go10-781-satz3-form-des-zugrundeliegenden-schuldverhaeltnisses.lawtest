language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 781 Satz 3: der Anerkennungsvertrag bedarf der für das zugrunde liegende Schuldverhältnis vorgeschriebenen Form.
test "§ 781 Satz 3: Anerkennungsvertrag bedarf der akzessorischen Form" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": schuldversprechen_oder_anerkenntnis(entity_ref("urn:de:bgb:sv:go10:RG")) { origin case_input; }
        assert "f2": zugrunde_liegendes_schuldverhaeltnis_andere_form_vorgeschrieben_781(entity_ref("urn:de:bgb:sv:go10:RG")) { origin case_input; }
    }
    evaluate truth(anerkennungsvertrag_781_bedarf_dieser_form(entity_ref("urn:de:bgb:sv:go10:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
