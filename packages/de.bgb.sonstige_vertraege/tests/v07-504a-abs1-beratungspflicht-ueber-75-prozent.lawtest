language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 504a Absatz 1: Höchstbetrag 1 000 Euro, sechs Monate ununterbrochene Inanspruchnahme, Durchschnitt 800 Euro — über der Schwelle von 750,00 Euro (75 %): Beratungsangebotspflicht.
test "§ 504a Absatz 1: Beratungsangebotspflicht über der Siebzig-fünf-Prozent-Schwelle" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ununterbrochene_inanspruchnahme_sechs_monate_504a(entity_ref("urn:de:bgb:sv:v07:D")) { origin case_input; }
        assert "f2": vereinbarter_hoechstbetrag_504a(entity_ref("urn:de:bgb:sv:v07:D"), 1000.00 EUR) { origin case_input; }
        assert "f3": durchschnittliche_inanspruchnahme_504a(entity_ref("urn:de:bgb:sv:v07:D"), 800.00 EUR) { origin case_input; }
    }
    evaluate truth(schwelle_75_prozent_504a(entity_ref("urn:de:bgb:sv:v07:D"), 750.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(beratungsangebotspflicht_504a(entity_ref("urn:de:bgb:sv:v07:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
