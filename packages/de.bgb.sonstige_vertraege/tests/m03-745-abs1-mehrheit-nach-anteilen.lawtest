language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 745 Absatz 1 Satz 2: Anteile 1/2, 1/4, 1/4 auf dem gemeinsamen Nenner 4 (2, 1, 1). Die Teilhaber A und B stimmen zu: Summe 3, verdoppelt 6 > 4 — der Beschluss ist gefasst.
test "§ 745 Absatz 1: Stimmenmehrheit nach der Größe der Anteile" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": recht_steht_mehreren_gemeinschaftlich_zu(entity_ref("urn:de:bgb:sv:m03:GM")) { origin case_input; }
        assert "f2": teilhaber(entity_ref("urn:de:bgb:sv:m03:GM"), entity_ref("urn:de:bgb:sv:m03:A")) { origin case_input; }
        assert "f3": teilhaber(entity_ref("urn:de:bgb:sv:m03:GM"), entity_ref("urn:de:bgb:sv:m03:B")) { origin case_input; }
        assert "f4": teilhaber(entity_ref("urn:de:bgb:sv:m03:GM"), entity_ref("urn:de:bgb:sv:m03:C")) { origin case_input; }
        assert "f5": anteil_abweichend_vereinbart(entity_ref("urn:de:bgb:sv:m03:GM"), entity_ref("urn:de:bgb:sv:m03:A"), 1, 2) { origin case_input; }
        assert "f6": anteil_abweichend_vereinbart(entity_ref("urn:de:bgb:sv:m03:GM"), entity_ref("urn:de:bgb:sv:m03:B"), 1, 4) { origin case_input; }
        assert "f7": anteil_abweichend_vereinbart(entity_ref("urn:de:bgb:sv:m03:GM"), entity_ref("urn:de:bgb:sv:m03:C"), 1, 4) { origin case_input; }
        assert "f8": gemeinsamer_nenner(entity_ref("urn:de:bgb:sv:m03:GM"), 4) { origin case_input; }
        assert "f9": zaehler_auf_gemeinsamem_nenner(entity_ref("urn:de:bgb:sv:m03:GM"), entity_ref("urn:de:bgb:sv:m03:A"), 2) { origin case_input; }
        assert "f10": zaehler_auf_gemeinsamem_nenner(entity_ref("urn:de:bgb:sv:m03:GM"), entity_ref("urn:de:bgb:sv:m03:B"), 1) { origin case_input; }
        assert "f11": zaehler_auf_gemeinsamem_nenner(entity_ref("urn:de:bgb:sv:m03:GM"), entity_ref("urn:de:bgb:sv:m03:C"), 1) { origin case_input; }
        assert "f12": verwaltungsbeschluss(entity_ref("urn:de:bgb:sv:m03:GM"), "Dachsanierung") { origin case_input; }
        assert "f13": fuer_beschluss_gestimmt(entity_ref("urn:de:bgb:sv:m03:GM"), "Dachsanierung", entity_ref("urn:de:bgb:sv:m03:A")) { origin case_input; }
        assert "f14": fuer_beschluss_gestimmt(entity_ref("urn:de:bgb:sv:m03:GM"), "Dachsanierung", entity_ref("urn:de:bgb:sv:m03:B")) { origin case_input; }
    }
    evaluate truth(verwaltungsbeschluss_gefasst(entity_ref("urn:de:bgb:sv:m03:GM"), "Dachsanierung"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
