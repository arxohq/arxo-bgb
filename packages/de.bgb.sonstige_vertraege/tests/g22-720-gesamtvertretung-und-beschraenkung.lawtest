language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 720 Absatz 1, 3: Gesamtvertretungsbefugnis aller Gesellschafter; eine Beschränkung des Umfangs ist Dritten gegenüber unwirksam.
test "§ 720: Gesamtvertretung und unwirksame Beschränkung ggü. Dritten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g22:G"), entity_ref("urn:de:bgb:sv:g22:P")) { origin case_input; }
        assert "f2": beschraenkung_der_vertretungsbefugnis_vereinbart_720(entity_ref("urn:de:bgb:sv:g22:G")) { origin case_input; }
    }
    evaluate truth(gesamtvertretungsbefugnis_720(entity_ref("urn:de:bgb:sv:g22:G"), entity_ref("urn:de:bgb:sv:g22:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(beschraenkung_unwirksam_ggue_dritten_720(entity_ref("urn:de:bgb:sv:g22:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
