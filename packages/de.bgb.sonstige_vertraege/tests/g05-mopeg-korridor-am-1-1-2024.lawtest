language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Korridor MoPeG: am 1.1.2024 — dem ersten Tag des Fensters — gelten die Regeln des Titel 16; derselbe Fall wie g04 führt zum Anteil 1/2.
test "Titel 16 am 1.1.2024: Anteil nach § 709 Absatz 3 Satz 3" {
    given {
        context { legal_time @2024-01-01; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g05:G"), entity_ref("urn:de:bgb:sv:g05:A")) { origin case_input; }
        assert "f2": gesellschafter(entity_ref("urn:de:bgb:sv:g05:G"), entity_ref("urn:de:bgb:sv:g05:B")) { origin case_input; }
    }
    evaluate truth(anteil_bruch(entity_ref("urn:de:bgb:sv:g05:G"), entity_ref("urn:de:bgb:sv:g05:A"), 1, 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
