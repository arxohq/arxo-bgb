language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 711a Satz 1: die Rechte des Gesellschafters aus dem Gesellschaftsverhältnis sind nicht übertragbar.
test "§ 711a Satz 1: Übertragung der Gesellschafterrechte unwirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": uebertragung_der_rechte_versucht_711a(entity_ref("urn:de:bgb:sv:g12:G"), entity_ref("urn:de:bgb:sv:g12:P")) { origin case_input; }
    }
    evaluate truth(uebertragung_unwirksam_711a(entity_ref("urn:de:bgb:sv:g12:G"), entity_ref("urn:de:bgb:sv:g12:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
