language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu z34: Widerruf erst am vereinbarten Tag selbst (17.09.) — einen Tag zu spät.
test "§ 675p Absatz 3: Widerruf am vereinbarten Tag selbst ist zu spät" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zahlungsauftrag_widerrufen_am_675p(entity_ref("urn:de:bgb:sv:z35:Z"), @2026-09-17) { origin case_input; }
        assert "f2": vereinbarter_termin_675p(entity_ref("urn:de:bgb:sv:z35:Z"), @2026-09-17) { origin case_input; }
    }
    evaluate truth(widerruf_675p_rechtzeitig(entity_ref("urn:de:bgb:sv:z35:Z")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
