language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu mk05: bei Umschuldung mit erhöhtem effektivem Jahreszins entsteht kein Vergütungsanspruch.
test "§ 655c Satz 2: kein Vergütungsanspruch bei Umschuldung mit erhöhtem Jahreszins" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": darlehen_infolge_vermittlung_geleistet_655c(entity_ref("urn:de:bgb:sv:mk06:M")) { origin case_input; }
        assert "f2": widerruf_nach_355_nicht_mehr_moeglich_655c(entity_ref("urn:de:bgb:sv:mk06:M")) { origin case_input; }
        assert "f3": umschuldung_mit_wissen_des_vermittlers_655c(entity_ref("urn:de:bgb:sv:mk06:M")) { origin case_input; }
        assert "f4": effektiver_jahreszins_bei_umschuldung_erhoeht_sich_655c(entity_ref("urn:de:bgb:sv:mk06:M")) { origin case_input; }
    }
    evaluate truth(verguetungsanspruch_655c(entity_ref("urn:de:bgb:sv:mk06:M")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
