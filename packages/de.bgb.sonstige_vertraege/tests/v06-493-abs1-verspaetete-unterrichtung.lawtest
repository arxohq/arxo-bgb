language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu v05: Unterrichtung erst am 16.10.2026 — einen Tag zu spät für die Dreimonatsfrist vor dem 15.01.2027.
test "§ 493 Absatz 1: Unterrichtung einen Tag zu spät ist nicht rechtzeitig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": unterrichtung_erfolgt_am_493(entity_ref("urn:de:bgb:sv:v06:D"), @2026-10-16) { origin case_input; }
        assert "f2": ende_der_sollzinsbindung_am_493(entity_ref("urn:de:bgb:sv:v06:D"), @2027-01-15) { origin case_input; }
    }
    evaluate truth(rechtzeitig_unterrichtet_493(entity_ref("urn:de:bgb:sv:v06:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
