language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 798: die beschädigte Urkunde ist zum Umlauf ungeeignet, ihr wesentlicher Inhalt bleibt erkennbar — der Inhaber kann eine Ersatzurkunde verlangen und trägt deren Kosten.
test "§ 798: Anspruch auf Ersatzurkunde bei erkennbarem Inhalt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": urkunde_beschaedigt_oder_verunstaltet_zum_umlauf_ungeeignet(entity_ref("urn:de:bgb:sv:n03:RG")) { origin case_input; }
        assert "f2": wesentlicher_inhalt_und_unterscheidungsmerkmale_erkennbar(entity_ref("urn:de:bgb:sv:n03:RG")) { origin case_input; }
    }
    evaluate truth(anspruch_auf_ersatzurkunde_798(entity_ref("urn:de:bgb:sv:n03:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(kosten_der_ersatzurkunde_vom_inhaber_zu_tragen_798(entity_ref("urn:de:bgb:sv:n03:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
