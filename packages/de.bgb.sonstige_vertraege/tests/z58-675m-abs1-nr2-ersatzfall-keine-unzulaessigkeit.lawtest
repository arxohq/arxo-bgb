language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu z57: Ersatz eines bereits ausgegebenen Instruments ist ausgenommen — keine Unzulässigkeit.
test "§ 675m Absatz 1 Nummer 2: Ersatzfall schließt die Unzulässigkeit aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": unaufgeforderte_zusendung_675m(entity_ref("urn:de:bgb:sv:z58:ZDV")) { origin case_input; }
        assert "f2": ersatz_eines_ausgegebenen_instruments_675m(entity_ref("urn:de:bgb:sv:z58:ZDV")) { origin case_input; }
    }
    evaluate truth(unaufgeforderte_zusendung_675m_unzulaessig(entity_ref("urn:de:bgb:sv:z58:ZDV")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
