language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 709 Absatz 3 Satz 1: vereinbarte Beteiligungsverhältnisse gehen den Beitragswerten vor — trotz Werten 3 000 / 1 000 gilt die vereinbarte Hälfte.
test "§ 709 Absatz 3 Satz 1: vereinbartes Beteiligungsverhältnis verdrängt das Verhältnis der Beitragswerte" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g03:G"), entity_ref("urn:de:bgb:sv:g03:A")) { origin case_input; }
        assert "f2": gesellschafter(entity_ref("urn:de:bgb:sv:g03:G"), entity_ref("urn:de:bgb:sv:g03:B")) { origin case_input; }
        assert "f3": beteiligungsverhaeltnis_vereinbart(entity_ref("urn:de:bgb:sv:g03:G"), entity_ref("urn:de:bgb:sv:g03:A"), 1, 2) { origin case_input; }
        assert "f4": beteiligungsverhaeltnis_vereinbart(entity_ref("urn:de:bgb:sv:g03:G"), entity_ref("urn:de:bgb:sv:g03:B"), 1, 2) { origin case_input; }
        assert "f5": beitragswert_vereinbart(entity_ref("urn:de:bgb:sv:g03:G"), entity_ref("urn:de:bgb:sv:g03:A"), 3000) { origin case_input; }
        assert "f6": beitragswert_vereinbart(entity_ref("urn:de:bgb:sv:g03:G"), entity_ref("urn:de:bgb:sv:g03:B"), 1000) { origin case_input; }
    }
    evaluate truth(anteil_bruch(entity_ref("urn:de:bgb:sv:g03:G"), entity_ref("urn:de:bgb:sv:g03:A"), 1, 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
