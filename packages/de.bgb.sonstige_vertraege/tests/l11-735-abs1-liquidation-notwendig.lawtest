language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 735 Absatz 1 Satz 1: nach Auflösung der Gesellschaft findet die Liquidation statt, wenn kein Insolvenzverfahren über ihr Vermögen eröffnet ist.
test "§ 735 Absatz 1: Liquidationsnotwendigkeit nach Auflösung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": aufloesung_bei_tod_vereinbart_730(entity_ref("urn:de:bgb:sv:l11:G")) { origin case_input; }
        assert "f2": gesellschafter_verstorben(entity_ref("urn:de:bgb:sv:l11:G"), entity_ref("urn:de:bgb:sv:l11:P")) { origin case_input; }
    }
    evaluate truth(liquidation_findet_statt_735(entity_ref("urn:de:bgb:sv:l11:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
