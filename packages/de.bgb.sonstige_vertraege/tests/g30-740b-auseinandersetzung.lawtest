language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 740b Absatz 1: nach der Beendigung der nicht rechtsfähigen Gesellschaft findet die Auseinandersetzung unter den Gesellschaftern statt.
test "§ 740b Absatz 1: Auseinandersetzung nach Beendigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschaftsvertrag_geschlossen(entity_ref("urn:de:bgb:sv:g30:G")) { origin case_input; }
        assert "f2": zeitablauf_729(entity_ref("urn:de:bgb:sv:g30:G")) { origin case_input; }
    }
    evaluate truth(auseinandersetzung_740b(entity_ref("urn:de:bgb:sv:g30:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
