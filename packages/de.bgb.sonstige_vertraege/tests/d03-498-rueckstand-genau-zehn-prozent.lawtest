language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 498 Absatz 1 Satz 1 Nummer 1 Buchstabe b: Laufzeit bis drei Jahre, Nennbetrag 10 000 Euro, Rückstand genau 1 000 Euro — die Schwelle „mindestens 10 Prozent" ist erreicht.
test "§ 498: Rückstand genau an der Zehnprozentschwelle" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": entgeltlicher_darlehensvertrag(entity_ref("urn:de:bgb:sv:d03:D")) { origin case_input; }
        assert "f2": unternehmer_als_darlehensgeber(entity_ref("urn:de:bgb:sv:d03:D")) { origin case_input; }
        assert "f3": verbraucher_als_darlehensnehmer(entity_ref("urn:de:bgb:sv:d03:D")) { origin case_input; }
        assert "f4": nettodarlehensbetrag(entity_ref("urn:de:bgb:sv:d03:D"), 10000.00 EUR) { origin case_input; }
        assert "f5": teilzahlungsdarlehen(entity_ref("urn:de:bgb:sv:d03:D")) { origin case_input; }
        assert "f6": vertragslaufzeit_bis_drei_jahre(entity_ref("urn:de:bgb:sv:d03:D")) { origin case_input; }
        assert "f7": nennbetrag_des_darlehens(entity_ref("urn:de:bgb:sv:d03:D"), 10000.00 EUR) { origin case_input; }
        assert "f8": rueckstand(entity_ref("urn:de:bgb:sv:d03:D"), 1000.00 EUR) { origin case_input; }
        assert "f9": mit_zwei_aufeinander_folgenden_teilzahlungen_in_verzug(entity_ref("urn:de:bgb:sv:d03:D")) { origin case_input; }
        assert "f10": frist_erfolglos_verstrichen_498(entity_ref("urn:de:bgb:sv:d03:D")) { origin case_input; }
    }
    evaluate truth(kuendigung_wegen_zahlungsverzugs_zulaessig(entity_ref("urn:de:bgb:sv:d03:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
