language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu l05: ist im Gesellschaftsvertrag eine abweichende Liquidatorenbestellung vereinbart, ist der Gesellschafter NICHT kraft Gesetzes Liquidator — Liquidator ist die berufene andere Person.
test "§ 736 Absatz 4: abweichende Bestellung schließt § 736 Absatz 1 aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:l06:G"), entity_ref("urn:de:bgb:sv:l06:P")) { origin case_input; }
        assert "f2": abweichende_liquidatorenbestellung_vereinbart_736(entity_ref("urn:de:bgb:sv:l06:G")) { origin case_input; }
        assert "f3": liquidator_durch_vereinbarung_oder_beschluss_berufen_736(entity_ref("urn:de:bgb:sv:l06:G"), entity_ref("urn:de:bgb:sv:l06:D")) { origin case_input; }
    }
    evaluate truth(ist_liquidator(entity_ref("urn:de:bgb:sv:l06:G"), entity_ref("urn:de:bgb:sv:l06:P")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(ist_liquidator(entity_ref("urn:de:bgb:sv:l06:G"), entity_ref("urn:de:bgb:sv:l06:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
