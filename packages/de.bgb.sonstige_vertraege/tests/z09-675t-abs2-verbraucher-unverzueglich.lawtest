language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675t Absatz 2 Satz 1: zahlt ein Verbraucher Bargeld ein, macht der Zahlungsdienstleister den Betrag unverzüglich verfügbar.
test "§ 675t Absatz 2 Satz 1: unverzügliche Verfügbarmachung bei Verbraucherbareinzahlung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": bareinzahlung_durch_verbraucher_675t(entity_ref("urn:de:bgb:sv:z09:Z")) { origin case_input; }
    }
    evaluate truth(betrag_dem_zahlungsempfaenger_unverzueglich_verfuegbar_675t(entity_ref("urn:de:bgb:sv:z09:Z")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
