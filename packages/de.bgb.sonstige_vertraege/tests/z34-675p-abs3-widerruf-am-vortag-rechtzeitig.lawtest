language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675p Absatz 3: Widerruf am Geschäftstag vor dem vereinbarten Termin (16.09. für Termin 17.09.) ist rechtzeitig.
test "§ 675p Absatz 3: Widerruf am Vortag des vereinbarten Termins ist rechtzeitig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zahlungsauftrag_widerrufen_am_675p(entity_ref("urn:de:bgb:sv:z34:Z"), @2026-09-16) { origin case_input; }
        assert "f2": vereinbarter_termin_675p(entity_ref("urn:de:bgb:sv:z34:Z"), @2026-09-17) { origin case_input; }
    }
    evaluate truth(widerruf_675p_rechtzeitig(entity_ref("urn:de:bgb:sv:z34:Z")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
