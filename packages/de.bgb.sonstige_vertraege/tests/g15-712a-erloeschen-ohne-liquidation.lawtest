language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 712a Absatz 1: verbleibt nur noch ein Gesellschafter, erlischt die Gesellschaft ohne Liquidation; Gesamtrechtsnachfolge auf ihn.
test "§ 712a Absatz 1: Erlöschen ohne Liquidation und Gesamtrechtsnachfolge" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": nur_noch_ein_gesellschafter_712a(entity_ref("urn:de:bgb:sv:g15:G"), entity_ref("urn:de:bgb:sv:g15:P")) { origin case_input; }
    }
    evaluate truth(gesellschaft_erlischt_ohne_liquidation_712a(entity_ref("urn:de:bgb:sv:g15:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesamtrechtsnachfolge_712a(entity_ref("urn:de:bgb:sv:g15:G"), entity_ref("urn:de:bgb:sv:g15:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
