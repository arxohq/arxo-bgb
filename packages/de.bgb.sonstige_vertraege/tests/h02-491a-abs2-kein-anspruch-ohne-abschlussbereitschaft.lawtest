language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu h01: ist der Darlehensgeber zum Abschluss nicht bereit, entfällt der Anspruch.
test "§ 491a Absatz 2: kein Anspruch, solange der Darlehensgeber nicht abschlussbereit ist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": vertragsentwurf_verlangt_491a(entity_ref("urn:de:bgb:sv:h02:D")) { origin case_input; }
        assert "f2": darlehensgeber_zum_abschluss_nicht_bereit_491a(entity_ref("urn:de:bgb:sv:h02:D")) { origin case_input; }
    }
    evaluate truth(anspruch_auf_vertragsentwurf_491a(entity_ref("urn:de:bgb:sv:h02:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
