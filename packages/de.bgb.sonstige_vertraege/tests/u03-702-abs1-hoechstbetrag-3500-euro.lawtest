language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 702 Absatz 1: Beherbergungspreis 50,00 Euro — das Hundertfache sind 5 000,00 Euro und überschreitet den Höchstbetrag; der Gastwirt haftet bis 3 500,00 Euro.
test "§ 702 Absatz 1: das Hundertfache überschreitet den Höchstbetrag von 3 500 Euro" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": beherbergungspreis_fuer_einen_tag(entity_ref("urn:de:bgb:sv:u03:GA"), 50.00 EUR) { origin case_input; }
    }
    evaluate truth(haftungshoechstbetrag_702(entity_ref("urn:de:bgb:sv:u03:GA"), 3500.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
