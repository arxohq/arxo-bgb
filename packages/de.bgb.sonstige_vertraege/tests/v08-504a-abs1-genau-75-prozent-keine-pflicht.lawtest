language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu v07: Durchschnitt genau 750,00 Euro — die Schwelle wird nicht ÜBERSTIEGEN (§ 504a Absatz 1 Satz 1: „übersteigt"), keine Beratungsangebotspflicht.
test "§ 504a Absatz 1: genau 75 Prozent übersteigt die Schwelle nicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ununterbrochene_inanspruchnahme_sechs_monate_504a(entity_ref("urn:de:bgb:sv:v08:D")) { origin case_input; }
        assert "f2": vereinbarter_hoechstbetrag_504a(entity_ref("urn:de:bgb:sv:v08:D"), 1000.00 EUR) { origin case_input; }
        assert "f3": durchschnittliche_inanspruchnahme_504a(entity_ref("urn:de:bgb:sv:v08:D"), 750.00 EUR) { origin case_input; }
    }
    evaluate truth(beratungsangebotspflicht_504a(entity_ref("urn:de:bgb:sv:v08:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
