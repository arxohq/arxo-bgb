language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 736d Absatz 4 Satz 1: aus dem Vermögen der Gesellschaft in Liquidation sind zunächst die (fälligen, unstreitigen) Gläubiger zu befriedigen.
test "§ 736d Absatz 4: Gläubiger der Gesellschaft zuerst befriedigen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschaft_in_liquidation(entity_ref("urn:de:bgb:sv:l08:G")) { origin case_input; }
        assert "f2": glaeubiger_der_gesellschaft_736d(entity_ref("urn:de:bgb:sv:l08:G"), "Lieferantenrechnung", 2000.00 EUR) { origin case_input; }
    }
    evaluate truth(glaeubiger_zu_befriedigen_736d(entity_ref("urn:de:bgb:sv:l08:G"), "Lieferantenrechnung", 2000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
