language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675v Absatz 1: nicht autorisierter Zahlungsvorgang mit gestohlenem Zahlungsinstrument, kein Ausschlussgrund — der Zahler haftet bis 50 Euro.
test "§ 675v Absatz 1: Haftung des Zahlers bis 50 Euro" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": nicht_autorisierter_zahlungsvorgang(entity_ref("urn:de:bgb:sv:z01:Z")) { origin case_input; }
        assert "f2": zahlungsinstrument_abhandengekommen_oder_missbraucht(entity_ref("urn:de:bgb:sv:z01:Z")) { origin case_input; }
    }
    evaluate truth(haftung_des_zahlers_bis_50_euro(entity_ref("urn:de:bgb:sv:z01:Z"), 50.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
