language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 656d Absatz 1 Satz 2: Fälligkeit erst nach Zahlung durch die beauftragende Partei und Nachweis.
test "§ 656d Absatz 1: Fälligkeit gegen die andere Partei erst nach Zahlung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": nur_eine_partei_maklervertrag_geschlossen_656d(entity_ref("urn:de:bgb:sv:mk12:M"), 3000.00 EUR) { origin case_input; }
        assert "f2": andere_partei_soll_zahlen_656d(entity_ref("urn:de:bgb:sv:mk12:M"), 3000.00 EUR) { origin case_input; }
        assert "f3": beauftragende_partei_hat_gezahlt_656d(entity_ref("urn:de:bgb:sv:mk12:M")) { origin case_input; }
    }
    evaluate truth(anspruch_gegen_andere_partei_656d_faellig(entity_ref("urn:de:bgb:sv:mk12:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
