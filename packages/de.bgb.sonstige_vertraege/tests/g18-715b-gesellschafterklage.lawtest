language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 715b Absatz 1 Satz 1: der geschäftsführungsbefugte Gesellschafter unterlässt pflichtwidrig die Geltendmachung — jeder andere Gesellschafter darf im eigenen Namen klagen.
test "§ 715b Absatz 1: Gesellschafterklagebefugnis bei pflichtwidrigem Unterlassen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g18:G"), entity_ref("urn:de:bgb:sv:g18:P")) { origin case_input; }
        assert "f2": geschaeftsfuehrer_unterlaesst_pflichtwidrig_715b(entity_ref("urn:de:bgb:sv:g18:G"), entity_ref("urn:de:bgb:sv:g18:B")) { origin case_input; }
    }
    evaluate truth(gesellschafterklagebefugnis_715b(entity_ref("urn:de:bgb:sv:g18:G"), entity_ref("urn:de:bgb:sv:g18:P"), entity_ref("urn:de:bgb:sv:g18:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
