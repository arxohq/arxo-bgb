language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 656c Absatz 2 Satz 1: derselbe Fall wie u09, aber der Verkäufer verspricht nur 5 950,00 Euro — der Maklervertrag weicht von Absatz 1 ab und ist unwirksam.
test "§ 656c Absatz 2: ungleiche Provision macht den Maklervertrag unwirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kaufvertrag_wohnung_oder_einfamilienhaus(entity_ref("urn:de:bgb:sv:u10:M")) { origin case_input; }
        assert "f2": kaeufer_ist_verbraucher(entity_ref("urn:de:bgb:sv:u10:M")) { origin case_input; }
        assert "f3": lohn_von_beiden_parteien_versprochen(entity_ref("urn:de:bgb:sv:u10:M"), 11900.00 EUR, 5950.00 EUR) { origin case_input; }
    }
    evaluate truth(maklervertrag_unwirksam_656c(entity_ref("urn:de:bgb:sv:u10:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
