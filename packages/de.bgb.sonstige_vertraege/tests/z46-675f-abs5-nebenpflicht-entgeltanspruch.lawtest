language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675f Absatz 5 Satz 2: Entgeltanspruch für Nebenpflicht nur bei Zulassung, Vereinbarung und Angemessenheit.
test "§ 675f Absatz 5: Entgeltanspruch für zugelassene, vereinbarte und angemessene Nebenpflicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": nebenpflicht_entgelt_zugelassen_und_vereinbart_675f(entity_ref("urn:de:bgb:sv:z46:ZDV")) { origin case_input; }
        assert "f2": nebenpflicht_entgelt_angemessen_675f(entity_ref("urn:de:bgb:sv:z46:ZDV")) { origin case_input; }
    }
    evaluate truth(entgeltanspruch_fuer_nebenpflicht_675f(entity_ref("urn:de:bgb:sv:z46:ZDV")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
