language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// §§ 755, 756: Gesamtschuld nach § 748 und Teilhaberschuld werden bei der Aufhebung aus dem gemeinschaftlichen Gegenstand berichtigt.
test "§§ 755, 756: Berichtigung von Gesamtschuld und Teilhaberschuld" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": recht_steht_mehreren_gemeinschaftlich_zu(entity_ref("urn:de:bgb:sv:m11:GM")) { origin case_input; }
        assert "f2": teilhaber(entity_ref("urn:de:bgb:sv:m11:GM"), entity_ref("urn:de:bgb:sv:m11:A")) { origin case_input; }
        assert "f3": gesamtschuldnerische_haftung_748_755(entity_ref("urn:de:bgb:sv:m11:GM"), 1000.00 EUR) { origin case_input; }
        assert "f4": forderung_gegen_anderen_teilhaber_756(entity_ref("urn:de:bgb:sv:m11:GM"), entity_ref("urn:de:bgb:sv:m11:A"), entity_ref("urn:de:bgb:sv:m11:B"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(berichtigungsanspruch_755(entity_ref("urn:de:bgb:sv:m11:GM"), entity_ref("urn:de:bgb:sv:m11:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(berichtigungsanspruch_756(entity_ref("urn:de:bgb:sv:m11:GM"), entity_ref("urn:de:bgb:sv:m11:A"), entity_ref("urn:de:bgb:sv:m11:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
