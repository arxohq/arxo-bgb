language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 681: Anzeigepflicht des Geschäftsführers gegenüber dem Geschäftsherrn; §§ 666-668 gelten entsprechend.
test "§ 681: Anzeigepflicht und entsprechende Anwendung der §§ 666-668" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geschaeft_fuer_einen_anderen_besorgt(entity_ref("urn:de:bgb:sv:go03:GF")) { origin case_input; }
        assert "f2": geschaeftsherr(entity_ref("urn:de:bgb:sv:go03:GF"), entity_ref("urn:de:bgb:sv:go03:HERR")) { origin case_input; }
    }
    evaluate truth(anzeigepflicht_681(entity_ref("urn:de:bgb:sv:go03:GF"), entity_ref("urn:de:bgb:sv:go03:HERR")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
