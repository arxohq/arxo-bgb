language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 534: die Schenkung entspricht einer sittlichen Pflicht — sie unterliegt weder der Rückforderung noch dem Widerruf, auch bei festgestelltem groben Undank.
test "§ 534: Pflicht- und Anstandsschenkungen sind vom Widerruf ausgenommen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zuwendung_bereichert_den_anderen(entity_ref("urn:de:bgb:sv:s03:S"), 1200.00 EUR) { origin case_input; }
        assert "f2": einigkeit_ueber_unentgeltlichkeit(entity_ref("urn:de:bgb:sv:s03:S")) { origin case_input; }
        assert "f3": grober_undank(entity_ref("urn:de:bgb:sv:s03:S")) { origin adjudicated; }
        assert "f4": pflicht_oder_anstandsschenkung(entity_ref("urn:de:bgb:sv:s03:S")) { origin case_input; }
        assert "f5": widerruf_erklaert_am(entity_ref("urn:de:bgb:sv:s03:S"), @2026-05-05) { origin case_input; }
    }
    evaluate truth(schenkung_widerrufen(entity_ref("urn:de:bgb:sv:s03:S")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
