language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu mk02: ohne Taxe gilt der übliche Lohn als vereinbart.
test "§ 653 Absatz 2: üblicher Lohn in Ermangelung einer Taxe" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": hoehe_der_verguetung_653_nicht_bestimmt(entity_ref("urn:de:bgb:sv:mk03:M")) { origin case_input; }
        assert "f2": ueblicher_lohn_653(entity_ref("urn:de:bgb:sv:mk03:M"), 400.00 EUR) { origin case_input; }
    }
    evaluate truth(lohn_653_als_vereinbart_anzusehen(entity_ref("urn:de:bgb:sv:mk03:M"), 400.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
