language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675t Absatz 2 Satz 2: Entgegennahme der Bareinzahlung Freitag 18.09.2026 — bei einem Nichtverbraucher endet die Frist am nächsten Geschäftstag, Montag 21.09.2026 (Wochenende übersprungen).
test "§ 675t Absatz 2 Satz 2: ein Geschäftstag bei Nichtverbraucher, über das Wochenende" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_TAG; calendar KALENDER_BUNDESWEIT; }
        assert "f1": bareinzahlungsfrist_675t(entity_ref("urn:de:bgb:sv:z10:F")) { origin case_input; }
        assert "f2": bareinzahlung_entgegengenommen_am_675t(entity_ref("urn:de:bgb:sv:z10:F"), @2026-09-18) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sv:z10:F"), @2026-09-21));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
