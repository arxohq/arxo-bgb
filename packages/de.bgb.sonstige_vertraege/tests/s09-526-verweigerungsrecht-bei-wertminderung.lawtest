language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 526 Satz 1: Wert der Zuwendung (300 Euro) unter den erforderlichen Aufwendungen (500 Euro) begründet ein Verweigerungsrecht.
test "§ 526: Verweigerungsrecht bei Wert der Zuwendung unter den Aufwendungen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": wert_der_zuwendung_526(entity_ref("urn:de:bgb:sv:s09:S"), 300.00 EUR) { origin case_input; }
        assert "f2": erforderliche_aufwendungen_zur_auflage_526(entity_ref("urn:de:bgb:sv:s09:S"), 500.00 EUR) { origin case_input; }
    }
    evaluate truth(vollziehung_526_verweigerbar(entity_ref("urn:de:bgb:sv:s09:S")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
