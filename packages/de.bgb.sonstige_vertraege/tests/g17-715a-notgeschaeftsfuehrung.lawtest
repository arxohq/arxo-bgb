language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 715a Satz 1: alle geschäftsführungsbefugten Gesellschafter sind verhindert, Gefahr bei Aufschub — jeder Gesellschafter kann das Geschäft vornehmen.
test "§ 715a: Notgeschäftsführungsbefugnis bei Verhinderung und Gefahr" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g17:G"), entity_ref("urn:de:bgb:sv:g17:P")) { origin case_input; }
        assert "f2": alle_geschaeftsfuehrungsbefugten_verhindert_715a(entity_ref("urn:de:bgb:sv:g17:G")) { origin case_input; }
        assert "f3": gefahr_bei_aufschub_715a(entity_ref("urn:de:bgb:sv:g17:G")) { origin case_input; }
    }
    evaluate truth(notgeschaeftsfuehrungsbefugnis_715a(entity_ref("urn:de:bgb:sv:g17:G"), entity_ref("urn:de:bgb:sv:g17:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
