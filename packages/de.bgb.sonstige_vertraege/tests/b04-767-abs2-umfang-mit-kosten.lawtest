language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 767 Absatz 2: Hauptverbindlichkeit 10 000 Euro zuzüglich 500 Euro Kosten der Rechtsverfolgung — die Bürgschaftsschuld beträgt 10 500 Euro.
test "§ 767 Absatz 2: die Bürgschaftsschuld umfasst die Kosten der Rechtsverfolgung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": buergschaftserklaerung_abgegeben(entity_ref("urn:de:bgb:sv:b04:B")) { origin case_input; }
        assert "f2": buergschaftserklaerung_schriftlich_erteilt(entity_ref("urn:de:bgb:sv:b04:B")) { origin case_input; }
        assert "f3": bestand_der_hauptverbindlichkeit(entity_ref("urn:de:bgb:sv:b04:B"), 10000.00 EUR) { origin case_input; }
        assert "f4": zu_ersetzende_kosten(entity_ref("urn:de:bgb:sv:b04:B"), 500.00 EUR) { origin case_input; }
    }
    evaluate truth(buergschaftsschuld(entity_ref("urn:de:bgb:sv:b04:B"), 10500.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
