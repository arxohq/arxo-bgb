language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu n07: wird der verlorene Schein dem Aussteller vor Fristablauf zur Einlösung vorgelegt, ist der Anspruch des bisherigen Inhabers ausgeschlossen (§ 804 Absatz 1 Satz 2).
test "§ 804 Absatz 1 Satz 2: Anspruch ausgeschlossen bei rechtzeitiger Vorlegung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": verlust_von_schein_angezeigt_vor_fristablauf(entity_ref("urn:de:bgb:sv:n08:RG")) { origin case_input; }
        assert "f2": schein_zur_einloesung_vorgelegt_oder_gerichtlich_geltend_gemacht(entity_ref("urn:de:bgb:sv:n08:RG")) { origin case_input; }
    }
    evaluate truth(anspruch_ausgeschlossen_804(entity_ref("urn:de:bgb:sv:n08:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anspruch_auf_leistung_nach_fristablauf_804(entity_ref("urn:de:bgb:sv:n08:RG")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
