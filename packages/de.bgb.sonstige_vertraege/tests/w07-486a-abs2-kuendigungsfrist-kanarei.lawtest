language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu w06: dasselbe Fristende einen Tag früher behauptet — nicht das berechnete Ende.
test "§ 486a Absatz 2: Kanarei — ein Tag vor dem berechneten Fristende ist nicht das Fristende" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kuendigungsfrist_486a(entity_ref("urn:de:bgb:sv:w07:F")) { origin case_input; }
        assert "f2": zweiter_teilbetrag_zahlungsaufforderung_zugegangen_am_486a(entity_ref("urn:de:bgb:sv:w07:F"), @2026-09-01) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sv:w07:F"), @2026-09-14));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
