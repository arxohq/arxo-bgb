language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 805 Satz 1: widerspricht der Inhaber der Ausgabe, dürfen keine neuen Zins- oder Rentenscheine an den Inhaber des Erneuerungsscheins ausgegeben werden.
test "§ 805: Verbot der Ausgabe neuer Scheine bei Widerspruch" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": inhaber_widerspricht_ausgabe_der_scheine(entity_ref("urn:de:bgb:sv:n09:RG")) { origin case_input; }
    }
    evaluate truth(neue_scheine_duerfen_nicht_ausgegeben_werden_805(entity_ref("urn:de:bgb:sv:n09:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
