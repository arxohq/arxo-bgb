language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 653 Absatz 2: bei Bestehen einer Taxe ist der taxmäßige Lohn als vereinbart anzusehen.
test "§ 653 Absatz 2: taxmäßiger Lohn ist als vereinbart anzusehen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": hoehe_der_verguetung_653_nicht_bestimmt(entity_ref("urn:de:bgb:sv:mk02:M")) { origin case_input; }
        assert "f2": taxmaessiger_lohn_653(entity_ref("urn:de:bgb:sv:mk02:M"), 500.00 EUR) { origin case_input; }
    }
    evaluate truth(lohn_653_als_vereinbart_anzusehen(entity_ref("urn:de:bgb:sv:mk02:M"), 500.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
