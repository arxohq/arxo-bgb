language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675i Absatz 1 Nummer 2, Satz 3: bei rein inländischer Nutzung erhöht sich die Ausgabenobergrenze auf 200 Euro.
test "§ 675i Absatz 1 Nummer 2 Satz 3: 180 Euro Ausgabenobergrenze bei reiner Inlandsnutzung bleibt Kleinbetragsinstrument" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ausgabenobergrenze_kleinbetragsinstrument(entity_ref("urn:de:bgb:sv:z30:ZDV"), 180.00 EUR) { origin case_input; }
        assert "f2": nur_inlaendische_zahlungsvorgaenge_675i(entity_ref("urn:de:bgb:sv:z30:ZDV")) { origin case_input; }
    }
    evaluate truth(kleinbetragsinstrument_675i(entity_ref("urn:de:bgb:sv:z30:ZDV")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
