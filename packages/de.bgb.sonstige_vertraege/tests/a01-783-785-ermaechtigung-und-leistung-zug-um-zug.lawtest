language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 783: die Aushändigung der Anweisung an den Anweisungsempfänger ermächtigt ihn zur Erhebung und den Angewiesenen zur Leistung; § 785: der Angewiesene ist nur gegen Aushändigung zur Leistung verpflichtet.
test "§ 783, § 785: Aushändigung der Anweisung begründet beide Ermächtigungen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": anweisung_dem_empfaenger_ausgehaendigt(entity_ref("urn:de:bgb:sv:a01:A")) { origin case_input; }
    }
    evaluate truth(anweisungsempfaenger_zur_erhebung_ermaechtigt(entity_ref("urn:de:bgb:sv:a01:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(angewiesener_zur_leistung_ermaechtigt(entity_ref("urn:de:bgb:sv:a01:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(leistung_nur_zug_um_zug_gegen_aushaendigung_785(entity_ref("urn:de:bgb:sv:a01:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
