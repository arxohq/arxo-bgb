language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu z07: in Papierform ausgelöst — die Frist verlängert sich um einen weiteren Geschäftstag; Zugang Mittwoch 16.09.2026, Ende Freitag 18.09.2026.
test "§ 675s Absatz 1 Satz 3: zwei Geschäftstage bei Papierform" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_TAG; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ausfuehrungsfrist_675s(entity_ref("urn:de:bgb:sv:z08:F")) { origin case_input; }
        assert "f2": zugang_des_zahlungsauftrags_am_675s(entity_ref("urn:de:bgb:sv:z08:F"), @2026-09-16) { origin case_input; }
        assert "f3": in_papierform_ausgeloest_675s(entity_ref("urn:de:bgb:sv:z08:F")) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sv:z08:F"), @2026-09-18));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sv:z08:F"), @2026-09-17));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
