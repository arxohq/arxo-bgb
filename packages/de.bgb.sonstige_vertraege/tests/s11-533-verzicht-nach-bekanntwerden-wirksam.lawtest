language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 533: Verzicht auf das Widerrufsrecht ist wirksam, wenn der Undank dem Berechtigten bereits bekannt geworden ist.
test "§ 533: Verzicht nach Bekanntwerden des Undanks ist wirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": verzicht_auf_widerrufsrecht_erklaert_533(entity_ref("urn:de:bgb:sv:s11:S")) { origin case_input; }
        assert "f2": undank_dem_widerrufsberechtigten_bekannt_geworden_533(entity_ref("urn:de:bgb:sv:s11:S")) { origin case_input; }
    }
    evaluate truth(verzicht_533_wirksam(entity_ref("urn:de:bgb:sv:s11:S")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
