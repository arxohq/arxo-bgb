language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 489 Absatz 1 Nummer 2: vollständiger Empfang am 01.03.2016 — die Zehnjahresfrist endet kalendarisch am 01.03.2026 (Sonntag; § 193 verlegt bei der Kalenderfrist über frist_ende auf Montag, den 02.03.2026).
test "§ 489 Absatz 1 Nummer 2: zehn Jahre nach dem vollständigen Empfang, Fristende mit Verlegung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zehnjahresfrist_489(entity_ref("urn:de:bgb:sv:d08:F")) { origin case_input; }
        assert "f2": vollstaendiger_empfang_am(entity_ref("urn:de:bgb:sv:d08:F"), @2016-03-01) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sv:d08:F"), @2026-03-02));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
