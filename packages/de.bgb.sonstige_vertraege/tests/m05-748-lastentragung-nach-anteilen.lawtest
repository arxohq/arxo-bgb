language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 748: Lasten und Kosten von 1 200,00 Euro, Anteil des Teilhabers 1/4 — er trägt 300,00 Euro.
test "§ 748: Lasten- und Kostentragung nach dem Verhältnis des Anteils" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": recht_steht_mehreren_gemeinschaftlich_zu(entity_ref("urn:de:bgb:sv:m05:GM")) { origin case_input; }
        assert "f2": teilhaber(entity_ref("urn:de:bgb:sv:m05:GM"), entity_ref("urn:de:bgb:sv:m05:A")) { origin case_input; }
        assert "f3": teilhaber(entity_ref("urn:de:bgb:sv:m05:GM"), entity_ref("urn:de:bgb:sv:m05:B")) { origin case_input; }
        assert "f4": anteil_abweichend_vereinbart(entity_ref("urn:de:bgb:sv:m05:GM"), entity_ref("urn:de:bgb:sv:m05:A"), 1, 4) { origin case_input; }
        assert "f5": anteil_abweichend_vereinbart(entity_ref("urn:de:bgb:sv:m05:GM"), entity_ref("urn:de:bgb:sv:m05:B"), 3, 4) { origin case_input; }
        assert "f6": lasten_und_kosten(entity_ref("urn:de:bgb:sv:m05:GM"), 1200.00 EUR) { origin case_input; }
    }
    evaluate truth(lastenanteil(entity_ref("urn:de:bgb:sv:m05:GM"), entity_ref("urn:de:bgb:sv:m05:A"), 300.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
