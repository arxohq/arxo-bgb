language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 763 Satz 1: derselbe Vertrag, aber die Lotterie ist staatlich genehmigt — der Vertrag ist verbindlich, § 762 greift nicht. Kanarienvogel „minus eine Bedingung" zu u07.
test "§ 763: staatlich genehmigte Lotterie ist verbindlich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": spiel_oder_wette(entity_ref("urn:de:bgb:sv:u08:RG")) { origin case_input; }
        assert "f2": staatlich_genehmigte_lotterie(entity_ref("urn:de:bgb:sv:u08:RG")) { origin case_input; }
    }
    evaluate truth(unvollkommene_verbindlichkeit(entity_ref("urn:de:bgb:sv:u08:RG")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
