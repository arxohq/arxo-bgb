language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 725 Absatz 1: Kündigung am 15.09.2026 erklärt (vor dem 1. Oktober) — drei Monate später ist der 15.12.2026, dessen Kalenderjahr endet am 31.12.2026: die Mitgliedschaft endet zum Ablauf desselben Jahres.
test "§ 725 Absatz 1: Kündigung vor dem 1. Oktober endet zum 31.12. desselben Jahres" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kuendigung_erklaert_am(entity_ref("urn:de:bgb:sv:g08:F"), @2026-09-15) { origin case_input; }
    }
    evaluate truth(kalenderjahresende_der_kuendigung_725(entity_ref("urn:de:bgb:sv:g08:F"), @2026-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
