language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 754: solange die gemeinschaftliche Forderung noch nicht eingezogen werden kann, ist ihr Verkauf zulässig.
test "§ 754 Satz 1: Verkauf der Forderung zulässig, solange nicht einziehbar" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": recht_steht_mehreren_gemeinschaftlich_zu(entity_ref("urn:de:bgb:sv:m09:GM")) { origin case_input; }
        assert "f2": forderung_noch_nicht_einziehbar_754(entity_ref("urn:de:bgb:sv:m09:GM")) { origin case_input; }
    }
    evaluate truth(verkauf_der_forderung_zulaessig_754(entity_ref("urn:de:bgb:sv:m09:GM")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
