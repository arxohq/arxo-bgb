language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu go07: ist die Ersatzabsicht ausdrücklich nachgewiesen, greift die Vermutung nicht.
test "§ 685 Absatz 2: Vermutung entfällt bei nachgewiesener Ersatzabsicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": eltern_oder_voreltern_gewaehren_abkoemmlingen_unterhalt_685(entity_ref("urn:de:bgb:sv:go08:GF")) { origin case_input; }
        assert "f2": ersatzabsicht_685_ausdruecklich_nachgewiesen(entity_ref("urn:de:bgb:sv:go08:GF")) { origin case_input; }
    }
    evaluate truth(keine_ersatzabsicht(entity_ref("urn:de:bgb:sv:go08:GF")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
