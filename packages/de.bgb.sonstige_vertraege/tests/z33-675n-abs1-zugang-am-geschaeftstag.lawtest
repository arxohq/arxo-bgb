language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675n Absatz 1: Zugang an einem Geschäftstag macht den Zahlungsauftrag an diesem Tag wirksam.
test "§ 675n Absatz 1: Zugang an einem Geschäftstag macht den Auftrag wirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zahlungsauftrag_zugegangen_am_675n(entity_ref("urn:de:bgb:sv:z33:Z"), @2026-09-15) { origin case_input; }
        assert "f2": zugangstag_ist_geschaeftstag_675n(entity_ref("urn:de:bgb:sv:z33:Z")) { origin case_input; }
    }
    evaluate truth(zahlungsauftrag_wirksam_675n(entity_ref("urn:de:bgb:sv:z33:Z"), @2026-09-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
