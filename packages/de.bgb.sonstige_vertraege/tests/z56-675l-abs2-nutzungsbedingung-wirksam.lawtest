language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675l Absatz 2: sachliche, verhältnismäßige und nicht benachteiligende Bedingungen sind wirksam.
test "§ 675l Absatz 2: sachliche Nutzungsbedingungen sind wirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": nutzungsbedingung_675l_vereinbart(entity_ref("urn:de:bgb:sv:z56:ZDV")) { origin case_input; }
        assert "f2": nutzungsbedingung_675l_sachlich_verhaeltnismaessig_nicht_benachteiligend(entity_ref("urn:de:bgb:sv:z56:ZDV")) { origin case_input; }
    }
    evaluate truth(nutzungsbedingung_675l_wirksam(entity_ref("urn:de:bgb:sv:z56:ZDV")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
