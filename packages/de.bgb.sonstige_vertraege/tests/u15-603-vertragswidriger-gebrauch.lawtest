language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 603: Überlassung an einen Dritten ohne Erlaubnis des Verleihers ist vertragswidriger Gebrauch.
test "§ 603: Gebrauchsüberlassung an Dritte ohne Erlaubnis des Verleihers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": leihvertrag_geschlossen(entity_ref("urn:de:bgb:sv:u15:L")) { origin case_input; }
        assert "f2": gebrauch_einem_dritten_ueberlassen_603(entity_ref("urn:de:bgb:sv:u15:L")) { origin case_input; }
    }
    evaluate truth(vertragswidriger_gebrauch_603(entity_ref("urn:de:bgb:sv:u15:L")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
