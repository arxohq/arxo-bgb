language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675h Absatz 2 Satz 2: die Kündigungsfrist des Dienstleisters darf zwei Monate nicht unterschreiten.
test "§ 675h Absatz 2: ein Monat Kündigungsfrist des Dienstleisters ist unwirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": dienstleister_kuendigungsfrist_vereinbart_675h(entity_ref("urn:de:bgb:sv:z25:ZDV"), 1) { origin case_input; }
    }
    evaluate truth(dienstleister_kuendigungsfrist_675h_unwirksam(entity_ref("urn:de:bgb:sv:z25:ZDV")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
