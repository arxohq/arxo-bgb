language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu z13: macht der Zahler den Anspruch nicht innerhalb von acht Wochen ab der Belastung geltend, ist der Anspruch ausgeschlossen (§ 675x Absatz 4).
test "§ 675x Absatz 4: Erstattungsanspruch ausgeschlossen ohne rechtzeitige Geltendmachung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": betrag_bei_autorisierung_nicht_angegeben_675x(entity_ref("urn:de:bgb:sv:z14:Z")) { origin case_input; }
        assert "f2": zahlungsbetrag_uebersteigt_erwartbaren_betrag_675x(entity_ref("urn:de:bgb:sv:z14:Z")) { origin case_input; }
    }
    evaluate truth(erstattungsanspruch_ausgeschlossen_675x(entity_ref("urn:de:bgb:sv:z14:Z")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
