language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 606: der Verleiher erhält die Sache am 15.03.2026 zurück — die sechsmonatige Verjährung endet kalendarisch am 15.09.2026 (Dienstag, keine Verlegung).
test "§ 606: sechs Monate ab Rücknahme der geliehenen Sache" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": verjaehrungsfrist_606(entity_ref("urn:de:bgb:sv:u05:F")) { origin case_input; }
        assert "f2": ruecknahme_der_sache_am(entity_ref("urn:de:bgb:sv:u05:F"), @2026-03-15) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sv:u05:F"), @2026-09-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
