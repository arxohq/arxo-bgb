language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 751 Satz 2: der Gläubiger hat die Pfändung des Anteils eines Teilhabers erwirkt, der Schuldtitel ist nicht bloß vorläufig vollstreckbar — er kann die Aufhebung ohne Rücksicht auf die Ausschlussvereinbarung verlangen.
test "§ 751 Satz 2: Aufhebungsanspruch des pfändenden Gläubigers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": glaeubiger_hat_pfaendung_erwirkt_751(entity_ref("urn:de:bgb:sv:m08:GM"), entity_ref("urn:de:bgb:sv:m08:A"), entity_ref("urn:de:bgb:sv:m08:G")) { origin case_input; }
        assert "f2": schuldtitel_nicht_bloss_vorlaeufig_vollstreckbar_751(entity_ref("urn:de:bgb:sv:m08:GM"), entity_ref("urn:de:bgb:sv:m08:G")) { origin case_input; }
    }
    evaluate truth(aufhebungsanspruch_des_glaeubigers_751(entity_ref("urn:de:bgb:sv:m08:GM"), entity_ref("urn:de:bgb:sv:m08:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
