language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 505 Absatz 2 Satz 2: ununterbrochene Überziehung über drei Monate, durchschnittlicher Überziehungsbetrag 600 Euro über der Hälfte des Geldeingangs (1 000 Euro / 2 = 500,00 Euro) — § 504a gilt entsprechend.
test "§ 505 Absatz 2 Satz 2: Beratungspflicht entsprechend über der Hälfte des Geldeingangs" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": entgelt_fuer_geduldete_ueberziehung_vereinbart_505(entity_ref("urn:de:bgb:sv:v10:D")) { origin case_input; }
        assert "f2": ununterbrochene_ueberziehung_ueber_drei_monate_505(entity_ref("urn:de:bgb:sv:v10:D")) { origin case_input; }
        assert "f3": durchschnittlicher_ueberziehungsbetrag_505(entity_ref("urn:de:bgb:sv:v10:D"), 600.00 EUR) { origin case_input; }
        assert "f4": durchschnittlicher_monatlicher_geldeingang_505(entity_ref("urn:de:bgb:sv:v10:D"), 1000.00 EUR) { origin case_input; }
    }
    evaluate truth(haelfte_des_geldeingangs_505(entity_ref("urn:de:bgb:sv:v10:D"), 500.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(beratungspflicht_504a_entsprechend_505(entity_ref("urn:de:bgb:sv:v10:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
