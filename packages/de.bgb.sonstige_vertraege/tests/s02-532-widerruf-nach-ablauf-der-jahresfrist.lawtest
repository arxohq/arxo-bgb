language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 532 Satz 1: derselbe Fall wie s01, nur der Widerruf wird am 15.01.2027 erklärt — nach dem Fristende 10.01.2027 (Sonntag, mit Verlegung 11.01.2027); der Widerruf ist ausgeschlossen.
test "§ 532: Widerruf nach Ablauf der Jahresfrist ist ausgeschlossen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zuwendung_bereichert_den_anderen(entity_ref("urn:de:bgb:sv:s02:S"), 25000.00 EUR) { origin case_input; }
        assert "f2": einigkeit_ueber_unentgeltlichkeit(entity_ref("urn:de:bgb:sv:s02:S")) { origin case_input; }
        assert "f3": grober_undank(entity_ref("urn:de:bgb:sv:s02:S")) { origin adjudicated; }
        assert "f4": widerrufsfrist_532(entity_ref("urn:de:bgb:sv:s02:F")) { origin case_input; }
        assert "f5": kenntnis_vom_widerrufsgrund_am(entity_ref("urn:de:bgb:sv:s02:F"), @2026-01-10) { origin adjudicated; }
        assert "f6": widerruf_erklaert_am(entity_ref("urn:de:bgb:sv:s02:S"), @2027-01-15) { origin case_input; }
    }
    evaluate truth(schenkung_widerrufen(entity_ref("urn:de:bgb:sv:s02:S")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
