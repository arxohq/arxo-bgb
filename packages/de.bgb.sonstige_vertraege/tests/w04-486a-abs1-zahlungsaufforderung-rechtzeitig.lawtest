language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 486a Absatz 1 Satz 4: Zugang der Zahlungsaufforderung am 01.09.2026, Fälligkeit am 15.09.2026 — genau zwei Wochen vorher, rechtzeitig.
test "§ 486a Absatz 1: Zahlungsaufforderung genau zwei Wochen vor Fälligkeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zahlungsaufforderungsfrist_486a(entity_ref("urn:de:bgb:sv:w04:F")) { origin case_input; }
        assert "f2": faelligkeit_des_teilbetrags_am_486a(entity_ref("urn:de:bgb:sv:w04:F"), @2026-09-15) { origin case_input; }
        assert "f3": zahlungsaufforderung_zugegangen_am_486a(entity_ref("urn:de:bgb:sv:w04:F"), @2026-09-01) { origin case_input; }
    }
    evaluate truth(zahlungsaufforderung_rechtzeitig_486a(entity_ref("urn:de:bgb:sv:w04:F")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
