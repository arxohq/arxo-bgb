language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 807: eine Karte ohne Gläubigerbezeichnung, unter verpflichtungswilligen Umständen ausgegeben, wird wie eine Schuldverschreibung auf den Inhaber behandelt — § 793 Absatz 1 findet entsprechende Anwendung.
test "§ 807: Inhaberkarte als Schuldverschreibung, § 793 entsprechend" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": karte_oder_marke_ohne_glaeubigerbezeichnung(entity_ref("urn:de:bgb:sv:n10:RG")) { origin case_input; }
        assert "f2": umstaende_zeigen_verpflichtungswillen_gegenueber_inhaber(entity_ref("urn:de:bgb:sv:n10:RG")) { origin case_input; }
    }
    evaluate truth(anspruch_auf_leistung_793(entity_ref("urn:de:bgb:sv:n10:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
