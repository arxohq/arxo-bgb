language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu h15: wissentliches Vorenthalten oder Fälschen schließt das Kündigungsverbot aus.
test "§ 499 Absatz 3: wissentliches Vorenthalten schließt das Kündigungsverbot aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": angaben_vor_vertragsschluss_unvollstaendig_499(entity_ref("urn:de:bgb:sv:h16:D")) { origin case_input; }
        assert "f2": darlehensnehmer_hat_wissentlich_informationen_vorenthalten_oder_gefaelscht_499(entity_ref("urn:de:bgb:sv:h16:D")) { origin case_input; }
    }
    evaluate truth(kuendigung_499_wegen_unvollstaendiger_angaben_unzulaessig(entity_ref("urn:de:bgb:sv:h16:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
