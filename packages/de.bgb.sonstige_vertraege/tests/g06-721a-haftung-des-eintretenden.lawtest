language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 721a Satz 1: der Eintretende haftet für die VOR seinem Eintritt begründeten Verbindlichkeiten — Verbindlichkeit vom 10.01.2025, Eintritt am 01.03.2025.
test "§ 721a: der eintretende Gesellschafter haftet für die vor seinem Eintritt begründete Verbindlichkeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g06:G"), entity_ref("urn:de:bgb:sv:g06:N")) { origin case_input; }
        assert "f2": eingetreten_am(entity_ref("urn:de:bgb:sv:g06:G"), entity_ref("urn:de:bgb:sv:g06:N"), @2025-03-01) { origin case_input; }
        assert "f3": verbindlichkeit_der_gesellschaft(entity_ref("urn:de:bgb:sv:g06:G"), "Werklohn Dachdecker") { origin case_input; }
        assert "f4": verbindlichkeit_begruendet_am(entity_ref("urn:de:bgb:sv:g06:G"), "Werklohn Dachdecker", @2025-01-10) { origin case_input; }
    }
    evaluate truth(haftet_persoenlich_als_gesamtschuldner(entity_ref("urn:de:bgb:sv:g06:G"), entity_ref("urn:de:bgb:sv:g06:N"), "Werklohn Dachdecker"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
