language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 719 Absatz 1, 2: Teilnahme am Rechtsverkehr mit Zustimmung aller lässt die Gesellschaft ggü. Dritten entstehen; eine spätere Entstehung ist Dritten gegenüber unwirksam.
test "§ 719: Entstehung ggü. Dritten und Unwirksamkeit späterer Entstehung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": teilnahme_am_rechtsverkehr_mit_zustimmung_aller_719(entity_ref("urn:de:bgb:sv:g21:G")) { origin case_input; }
        assert "f2": spaeterer_zeitpunkt_vereinbart_719(entity_ref("urn:de:bgb:sv:g21:G")) { origin case_input; }
    }
    evaluate truth(gesellschaft_entstanden_ggue_dritten_719(entity_ref("urn:de:bgb:sv:g21:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(vereinbarung_unwirksam_ggue_dritten_719(entity_ref("urn:de:bgb:sv:g21:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
