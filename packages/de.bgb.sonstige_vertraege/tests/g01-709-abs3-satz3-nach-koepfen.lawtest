language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 709 Absatz 3 Satz 3: weder Beteiligungsverhältnisse noch Werte der Beiträge vereinbart — drei Gesellschafter, jeder Anteil 1/3.
test "§ 709 Absatz 3 Satz 3: gleicher Anteil nach Köpfen bei drei Gesellschaftern" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g01:G"), entity_ref("urn:de:bgb:sv:g01:A")) { origin case_input; }
        assert "f2": gesellschafter(entity_ref("urn:de:bgb:sv:g01:G"), entity_ref("urn:de:bgb:sv:g01:B")) { origin case_input; }
        assert "f3": gesellschafter(entity_ref("urn:de:bgb:sv:g01:G"), entity_ref("urn:de:bgb:sv:g01:C")) { origin case_input; }
    }
    evaluate truth(anteil_bruch(entity_ref("urn:de:bgb:sv:g01:G"), entity_ref("urn:de:bgb:sv:g01:A"), 1, 3));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
