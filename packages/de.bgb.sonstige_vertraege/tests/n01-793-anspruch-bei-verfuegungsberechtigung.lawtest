language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 793 Absatz 1 Satz 1: der Inhaber einer Schuldverschreibung auf den Inhaber kann, wenn er zur Verfügung über die Urkunde berechtigt ist, vom Aussteller die versprochene Leistung verlangen.
test "§ 793 Absatz 1: Anspruch des verfügungsberechtigten Inhabers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": schuldverschreibung_ausgestellt(entity_ref("urn:de:bgb:sv:n01:RG")) { origin case_input; }
    }
    evaluate truth(anspruch_auf_leistung_793(entity_ref("urn:de:bgb:sv:n01:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
