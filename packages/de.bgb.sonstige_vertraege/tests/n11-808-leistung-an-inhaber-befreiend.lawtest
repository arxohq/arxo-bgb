language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 808 Absatz 1: bei einer Urkunde mit Namensnennung und Inhaberklausel wird der Schuldner durch Leistung an den Inhaber befreit; der Inhaber selbst kann die Leistung nicht verlangen.
test "§ 808 Absatz 1: befreiende Leistung an den Inhaber der Namenspapiere" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": urkunde_mit_inhaberklausel_ausgegeben(entity_ref("urn:de:bgb:sv:n11:RG")) { origin case_input; }
    }
    evaluate truth(leistung_an_inhaber_befreiend_808(entity_ref("urn:de:bgb:sv:n11:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(inhaber_nicht_berechtigt_leistung_zu_verlangen_808(entity_ref("urn:de:bgb:sv:n11:RG")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
