language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 518 Absatz 2: derselbe Fall wie s06, nur die versprochene Leistung ist bewirkt — der Mangel der Form ist geheilt.
test "§ 518 Absatz 2: Heilung des Formmangels durch Bewirkung der versprochenen Leistung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": schenkungsversprechen(entity_ref("urn:de:bgb:sv:s07:S")) { origin case_input; }
        assert "f2": versprochene_leistung_bewirkt(entity_ref("urn:de:bgb:sv:s07:S")) { origin case_input; }
    }
    evaluate truth(schenkungsversprechen_gueltig(entity_ref("urn:de:bgb:sv:s07:S")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
