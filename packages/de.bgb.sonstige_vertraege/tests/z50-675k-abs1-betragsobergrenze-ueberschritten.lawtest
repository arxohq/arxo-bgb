language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675k Absatz 1: der genutzte Betrag (600 Euro) überschreitet die vereinbarte Obergrenze (500 Euro).
test "§ 675k Absatz 1: Nutzungsbetrag überschreitet die vereinbarte Obergrenze" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": betragsobergrenze_vereinbart_675k(entity_ref("urn:de:bgb:sv:z50:ZDV"), 500.00 EUR) { origin case_input; }
        assert "f2": nutzungsbetrag_675k(entity_ref("urn:de:bgb:sv:z50:ZDV"), 600.00 EUR) { origin case_input; }
    }
    evaluate truth(betragsobergrenze_675k_ueberschritten(entity_ref("urn:de:bgb:sv:z50:ZDV")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
