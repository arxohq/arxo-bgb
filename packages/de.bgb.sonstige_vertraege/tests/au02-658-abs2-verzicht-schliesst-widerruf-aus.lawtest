language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu au01: ist auf die Widerruflichkeit verzichtet worden, ist der Widerruf nicht wirksam.
test "§ 658 Absatz 2: Verzicht auf Widerruflichkeit schließt den Widerruf aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": widerruf_der_auslobung_erklaert_658(entity_ref("urn:de:bgb:sv:au02:AL")) { origin case_input; }
        assert "f2": widerruf_658_formgerecht_bekannt_gemacht(entity_ref("urn:de:bgb:sv:au02:AL")) { origin case_input; }
        assert "f3": auf_widerruflichkeit_verzichtet(entity_ref("urn:de:bgb:sv:au02:AL")) { origin case_input; }
    }
    evaluate truth(widerruf_658_wirksam(entity_ref("urn:de:bgb:sv:au02:AL")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
