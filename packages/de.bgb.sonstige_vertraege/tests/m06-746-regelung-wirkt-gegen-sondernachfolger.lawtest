language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 746: die Teilhaber haben Verwaltung und Benutzung geregelt — die Bestimmung wirkt auch gegen Sondernachfolger.
test "§ 746: Regelung wirkt gegen Sondernachfolger" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": recht_steht_mehreren_gemeinschaftlich_zu(entity_ref("urn:de:bgb:sv:m06:GM")) { origin case_input; }
        assert "f2": verwaltung_und_benutzung_geregelt(entity_ref("urn:de:bgb:sv:m06:GM")) { origin case_input; }
    }
    evaluate truth(regelung_wirkt_gegen_sondernachfolger_746(entity_ref("urn:de:bgb:sv:m06:GM")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
