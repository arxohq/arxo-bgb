language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 722 Absatz 1, 2: gegen die Gesellschaft gerichteter Vollstreckungstitel erforderlich für das Gesellschaftsvermögen; er reicht nicht für die Gesellschafter.
test "§ 722: Zwangsvollstreckung nur mit eigenem Titel gegen die Gesellschaft" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g25:G"), entity_ref("urn:de:bgb:sv:g25:P")) { origin case_input; }
        assert "f2": vollstreckungstitel_gegen_gesellschaft_722(entity_ref("urn:de:bgb:sv:g25:G")) { origin case_input; }
        assert "f3": vollstreckungstitel_nur_gegen_gesellschaft_722(entity_ref("urn:de:bgb:sv:g25:G")) { origin case_input; }
    }
    evaluate truth(zwangsvollstreckung_in_gesellschaftsvermoegen_zulaessig_722(entity_ref("urn:de:bgb:sv:g25:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(keine_zwangsvollstreckung_gegen_gesellschafter_722(entity_ref("urn:de:bgb:sv:g25:G"), entity_ref("urn:de:bgb:sv:g25:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
