language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 736d Absatz 6: verbleibendes Vermögen 9 000 Euro, Anteile 2/3 und 1/3 (vereinbartes Beteiligungsverhältnis) — Verteilung 6 000,00 / 3 000,00 Euro, eine Rundung (D-08-01).
test "§ 736d Absatz 6: Verteilung des Überschusses nach dem Verhältnis der Anteile" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:l10:G"), entity_ref("urn:de:bgb:sv:l10:A")) { origin case_input; }
        assert "f2": gesellschafter(entity_ref("urn:de:bgb:sv:l10:G"), entity_ref("urn:de:bgb:sv:l10:B")) { origin case_input; }
        assert "f3": beteiligungsverhaeltnis_vereinbart(entity_ref("urn:de:bgb:sv:l10:G"), entity_ref("urn:de:bgb:sv:l10:A"), 2, 3) { origin case_input; }
        assert "f4": beteiligungsverhaeltnis_vereinbart(entity_ref("urn:de:bgb:sv:l10:G"), entity_ref("urn:de:bgb:sv:l10:B"), 1, 3) { origin case_input; }
        assert "f5": gesellschaft_in_liquidation(entity_ref("urn:de:bgb:sv:l10:G")) { origin case_input; }
        assert "f6": verbleibendes_vermoegen_nach_beitragsrueckerstattung_736d(entity_ref("urn:de:bgb:sv:l10:G"), 9000.00 EUR) { origin case_input; }
    }
    evaluate truth(verteilungsanspruch_nach_anteil_736d(entity_ref("urn:de:bgb:sv:l10:G"), entity_ref("urn:de:bgb:sv:l10:A"), 6000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verteilungsanspruch_nach_anteil_736d(entity_ref("urn:de:bgb:sv:l10:G"), entity_ref("urn:de:bgb:sv:l10:B"), 3000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
