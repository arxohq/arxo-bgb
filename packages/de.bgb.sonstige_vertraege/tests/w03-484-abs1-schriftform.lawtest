language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 484 Absatz 1: der Vertrag ist schriftlich abgeschlossen — Formwirksamkeit.
test "§ 484 Absatz 1: Formwirksamkeit bei schriftlichem Vertrag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": teilzeitwohnrechtevertrag_geschlossen(entity_ref("urn:de:bgb:sv:w03:T")) { origin case_input; }
        assert "f2": schriftform_484_eingehalten(entity_ref("urn:de:bgb:sv:w03:T")) { origin case_input; }
    }
    evaluate truth(formwirksamkeit_484(entity_ref("urn:de:bgb:sv:w03:T")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
