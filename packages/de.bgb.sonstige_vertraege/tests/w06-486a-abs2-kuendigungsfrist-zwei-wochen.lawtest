language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 486a Absatz 2: Zugang der Zahlungsaufforderung zum zweiten Teilbetrag am Dienstag, 01.09.2026 — die Kündigungsfrist von zwei Wochen endet am Dienstag, 15.09.2026 (Werktag, keine Verlegung).
test "§ 486a Absatz 2: Kündigungsfrist von zwei Wochen ab Zugang" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kuendigungsfrist_486a(entity_ref("urn:de:bgb:sv:w06:F")) { origin case_input; }
        assert "f2": zweiter_teilbetrag_zahlungsaufforderung_zugegangen_am_486a(entity_ref("urn:de:bgb:sv:w06:F"), @2026-09-01) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sv:w06:F"), @2026-09-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
