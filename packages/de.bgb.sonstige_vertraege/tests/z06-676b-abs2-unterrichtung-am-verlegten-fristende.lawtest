language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 676b Absatz 2 Satz 1: derselbe Fall wie z05, nur erfolgt die Unterrichtung am 02.03.2026 — dem nach § 193 verlegten Fristende; die Ansprüche bleiben erhalten.
test "§ 676b Absatz 2: Unterrichtung am verlegten Fristende ist rechtzeitig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": anzeigefrist_676b(entity_ref("urn:de:bgb:sv:z06:F")) { origin case_input; }
        assert "f2": tag_der_belastung(entity_ref("urn:de:bgb:sv:z06:F"), @2025-02-01) { origin case_input; }
        assert "f3": unterrichtung_erfolgt_am(entity_ref("urn:de:bgb:sv:z06:Z"), @2026-03-02) { origin case_input; }
    }
    evaluate truth(ansprueche_676b_ausgeschlossen(entity_ref("urn:de:bgb:sv:z06:Z")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
