language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 655d Satz 3: Auslagen von 60 Euro übersteigen den mitgeteilten Höchstbetrag von 50 Euro.
test "§ 655d Satz 3: Auslagenanspruch über dem mitgeteilten Höchstbetrag ist unwirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": erforderliche_auslagen_vereinbart_655d(entity_ref("urn:de:bgb:sv:mk08:M"), 60.00 EUR) { origin case_input; }
        assert "f2": mitgeteilter_hoechstbetrag_655d(entity_ref("urn:de:bgb:sv:mk08:M"), 50.00 EUR) { origin case_input; }
    }
    evaluate truth(auslagenanspruch_655d_unwirksam(entity_ref("urn:de:bgb:sv:mk08:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
