language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 713: Beiträge, erworbene Rechte und begründete Verbindlichkeiten sind Vermögen der Gesellschaft.
test "§ 713: Gesellschaftsvermögen umfasst Beiträge, Rechte und Verbindlichkeiten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": beitrag_geschuldet(entity_ref("urn:de:bgb:sv:g16:G"), entity_ref("urn:de:bgb:sv:g16:P")) { origin case_input; }
        assert "f2": erworbene_rechte_713(entity_ref("urn:de:bgb:sv:g16:G")) { origin case_input; }
        assert "f3": gegen_die_gesellschaft_begruendete_verbindlichkeiten_713(entity_ref("urn:de:bgb:sv:g16:G")) { origin case_input; }
    }
    evaluate truth(gesellschaftsvermoegen_umfasst_713(entity_ref("urn:de:bgb:sv:g16:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
