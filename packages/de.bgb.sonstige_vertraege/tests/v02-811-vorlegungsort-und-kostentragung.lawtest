language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 811 Absatz 1, 2: ohne wichtigen Grund für einen anderen Ort hat die Vorlegung dort zu erfolgen, wo sich die Sache befindet; Gefahr und Kosten trägt, wer sie verlangt.
test "§ 811: Vorlegungsort am Belegenheitsort, Kosten beim Verlangenden" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": rechtliches_interesse_an_besichtigung(entity_ref("urn:de:bgb:sv:v02:RG"), entity_ref("urn:de:bgb:sv:v02:S"), entity_ref("urn:de:bgb:sv:v02:P")) { origin case_input; }
    }
    evaluate truth(vorlegungsort_besichtigung_811(entity_ref("urn:de:bgb:sv:v02:RG"), entity_ref("urn:de:bgb:sv:v02:S"), entity_ref("urn:de:bgb:sv:v02:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gefahr_und_kosten_der_besichtigung_traegt_verlangenden_811(entity_ref("urn:de:bgb:sv:v02:RG"), entity_ref("urn:de:bgb:sv:v02:S"), entity_ref("urn:de:bgb:sv:v02:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
