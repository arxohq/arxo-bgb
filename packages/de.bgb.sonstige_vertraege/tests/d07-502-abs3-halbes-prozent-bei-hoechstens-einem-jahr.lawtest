language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 502 Absatz 3 Nummer 1: derselbe Betrag, aber der Zeitraum bis zur vereinbarten Rückzahlung überschreitet ein Jahr nicht — die Obergrenze beträgt 0,5 Prozent, also 100,00 Euro.
test "§ 502 Absatz 3: Obergrenze von einem halben Prozent bei höchstens einem Jahr Restlaufzeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": entgeltlicher_darlehensvertrag(entity_ref("urn:de:bgb:sv:d07:D")) { origin case_input; }
        assert "f2": unternehmer_als_darlehensgeber(entity_ref("urn:de:bgb:sv:d07:D")) { origin case_input; }
        assert "f3": verbraucher_als_darlehensnehmer(entity_ref("urn:de:bgb:sv:d07:D")) { origin case_input; }
        assert "f4": nettodarlehensbetrag(entity_ref("urn:de:bgb:sv:d07:D"), 25000.00 EUR) { origin case_input; }
        assert "f5": vorzeitig_zurueckgezahlter_betrag(entity_ref("urn:de:bgb:sv:d07:D"), 20000.00 EUR) { origin case_input; }
        assert "f6": zeitraum_bis_vereinbarter_rueckzahlung_hoechstens_ein_jahr(entity_ref("urn:de:bgb:sv:d07:D")) { origin case_input; }
    }
    evaluate truth(hoechstbetrag_502(entity_ref("urn:de:bgb:sv:d07:D"), 100.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
