language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 726: Kündigung durch den Privatgläubiger am 15.09.2026 (vor dem 1. Oktober) — dieselbe Dreimonats-zum-Kalenderjahresende-Mechanik wie § 725 (Ultimo D-08-17): Ende 31.12.2026.
test "§ 726: Kündigungsfrist des Privatgläubigers, Kalenderjahresende wie § 725" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": privatglaeubiger_voraussetzungen_726(entity_ref("urn:de:bgb:sv:g26:G"), entity_ref("urn:de:bgb:sv:g26:P"), entity_ref("urn:de:bgb:sv:g26:GL")) { origin case_input; }
        assert "f2": kuendigungsfrist_726(entity_ref("urn:de:bgb:sv:g26:F")) { origin case_input; }
        assert "f3": kuendigung_erklaert_am(entity_ref("urn:de:bgb:sv:g26:F"), @2026-09-15) { origin case_input; }
    }
    evaluate truth(kuendigung_726_wirksam(entity_ref("urn:de:bgb:sv:g26:G"), entity_ref("urn:de:bgb:sv:g26:P"), entity_ref("urn:de:bgb:sv:g26:GL")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(kalenderjahresende_der_kuendigung_725(entity_ref("urn:de:bgb:sv:g26:F"), @2026-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
