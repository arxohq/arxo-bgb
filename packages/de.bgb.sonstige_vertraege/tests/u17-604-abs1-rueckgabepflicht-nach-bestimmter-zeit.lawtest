language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 604 Absatz 1: bei bestimmter Leihzeit entsteht die Rückgabepflicht nach deren Ablauf.
test "§ 604 Absatz 1: Rückgabepflicht nach Ablauf der bestimmten Leihzeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": leihvertrag_geschlossen(entity_ref("urn:de:bgb:sv:u17:L")) { origin case_input; }
        assert "f2": leihzeit_bestimmt_bis(entity_ref("urn:de:bgb:sv:u17:L"), @2026-10-01) { origin case_input; }
    }
    evaluate truth(rueckgabepflicht_604_abs1(entity_ref("urn:de:bgb:sv:u17:L"), @2026-10-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
