language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 684 Satz 2: Genehmigung der Geschäftsführung begründet den Aufwendungsersatzanspruch des § 683.
test "§ 684 Satz 2: Aufwendungsersatz nach Genehmigung durch den Geschäftsherrn" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": geschaeftsherr_genehmigt_684(entity_ref("urn:de:bgb:sv:go06:GF")) { origin case_input; }
        assert "f2": aufwendung_des_geschaeftsfuehrers(entity_ref("urn:de:bgb:sv:go06:GF"), 250.00 EUR) { origin case_input; }
    }
    evaluate truth(aufwendungsersatz_683(entity_ref("urn:de:bgb:sv:go06:GF"), 250.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
