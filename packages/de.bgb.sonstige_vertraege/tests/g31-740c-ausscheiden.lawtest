language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 740c Absatz 1: auf das Ausscheiden eines Gesellschafters aus der nicht rechtsfähigen Gesellschaft sind die §§ 723 bis 728a entsprechend anzuwenden.
test "§ 740c Absatz 1: Ausscheiden aus der nicht rechtsfähigen Gesellschaft" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschaftsvertrag_geschlossen(entity_ref("urn:de:bgb:sv:g31:G")) { origin case_input; }
        assert "f2": gesellschafter(entity_ref("urn:de:bgb:sv:g31:G"), entity_ref("urn:de:bgb:sv:g31:P")) { origin case_input; }
        assert "f3": ausscheidensgrund_eingetreten(entity_ref("urn:de:bgb:sv:g31:G"), entity_ref("urn:de:bgb:sv:g31:P"), TodDesGesellschafters) { origin case_input; }
    }
    evaluate truth(ausscheiden_740c(entity_ref("urn:de:bgb:sv:g31:G"), entity_ref("urn:de:bgb:sv:g31:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
