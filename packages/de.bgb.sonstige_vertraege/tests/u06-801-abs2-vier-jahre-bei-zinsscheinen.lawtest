language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 801 Absatz 2: die Vorlegungsfrist für Zinsscheine beträgt vier Jahre ab dem Schluss des Jahres — vom 31.12.2022 an endet sie am 31.12.2026 (Donnerstag, keine Verlegung).
test "§ 801 Absatz 2: vier Jahre Vorlegungsfrist bei Zinsscheinen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": vorlegungsfrist_zinsschein_801(entity_ref("urn:de:bgb:sv:u06:F")) { origin case_input; }
        assert "f2": schluss_des_jahres_der_leistungszeit(entity_ref("urn:de:bgb:sv:u06:F"), @2022-12-31) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:sv:u06:F"), @2026-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
