language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675h Absatz 3 Satz 2: im Voraus gezahlte Entgelte für die Zeit nach Vertragsbeendigung sind anteilig zu erstatten.
test "§ 675h Absatz 3: im Voraus gezahltes Entgelt ist anteilig zu erstatten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": im_voraus_gezahltes_entgelt_675h(entity_ref("urn:de:bgb:sv:z27:ZDV"), 12.00 EUR) { origin case_input; }
    }
    evaluate truth(entgelt_anteilig_zu_erstatten_675h(entity_ref("urn:de:bgb:sv:z27:ZDV"), 12.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
