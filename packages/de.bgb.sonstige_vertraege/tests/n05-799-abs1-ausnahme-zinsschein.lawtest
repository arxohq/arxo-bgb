language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu n04: § 799 Absatz 1 Satz 2 nimmt Zins-, Renten- und Gewinnanteilscheine von der Kraftloserklärung im Aufgebotsverfahren aus.
test "§ 799 Absatz 1 Satz 2: keine Kraftloserklärung bei Zinsschein" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": urkunde_abhanden_gekommen_oder_vernichtet_799(entity_ref("urn:de:bgb:sv:n05:RG")) { origin case_input; }
        assert "f2": zins_renten_oder_gewinnanteilschein_oder_sichtwechsel_799(entity_ref("urn:de:bgb:sv:n05:RG")) { origin case_input; }
    }
    evaluate truth(kraftloserklaerung_im_aufgebotsverfahren_moeglich_799(entity_ref("urn:de:bgb:sv:n05:RG")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
