language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu v01: ist der Darlehensgeber auch ohne den Erwerb weiterer Finanzprodukte zum Abschluss bereit, liegt kein Kopplungsgeschäft vor (§ 492a Absatz 1 Satz 2).
test "§ 492a Absatz 1 Satz 2: kein Kopplungsgeschäft bei Abschlussbereitschaft ohne Erwerb" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": entgeltlicher_darlehensvertrag(entity_ref("urn:de:bgb:sv:v02:D")) { origin case_input; }
        assert "f2": unternehmer_als_darlehensgeber(entity_ref("urn:de:bgb:sv:v02:D")) { origin case_input; }
        assert "f3": verbraucher_als_darlehensnehmer(entity_ref("urn:de:bgb:sv:v02:D")) { origin case_input; }
        assert "f4": grundpfandrechtlich_besichert_oder_immobilienzweck(entity_ref("urn:de:bgb:sv:v02:D")) { origin case_input; }
        assert "f5": kopplungsgeschaeft_verlangt_492a(entity_ref("urn:de:bgb:sv:v02:D")) { origin case_input; }
        assert "f6": bereit_ohne_weitere_produkte_492a(entity_ref("urn:de:bgb:sv:v02:D")) { origin case_input; }
    }
    evaluate truth(kopplungsgeschaeft_492a(entity_ref("urn:de:bgb:sv:v02:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
