language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 520: Rentenversprechen erlischt mit dem Tode des Schenkers, wenn sich aus dem Versprechen nichts anderes ergibt.
test "§ 520: Verbindlichkeit erlischt mit dem Tode des Schenkers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": rentenversprechen_520(entity_ref("urn:de:bgb:sv:s08:S")) { origin case_input; }
        assert "f2": schenker_verstorben_520(entity_ref("urn:de:bgb:sv:s08:S")) { origin case_input; }
    }
    evaluate truth(verbindlichkeit_520_erloschen(entity_ref("urn:de:bgb:sv:s08:S")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
