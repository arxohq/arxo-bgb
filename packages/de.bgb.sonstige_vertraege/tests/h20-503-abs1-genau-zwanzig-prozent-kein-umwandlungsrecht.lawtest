language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// Kanarei zu h19: genau 20 Prozent Wertsteigerung überschreitet die Schwelle nicht ("mehr als 20 Prozent").
test "§ 503 Absatz 1: genau 20 Prozent Wertsteigerung begründet kein Umwandlungsrecht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": immobiliardarlehen_in_fremdwaehrung_503(entity_ref("urn:de:bgb:sv:h20:D")) { origin case_input; }
        assert "f2": wertsteigerung_503_in_prozent(entity_ref("urn:de:bgb:sv:h20:D"), 20.0) { origin case_input; }
    }
    evaluate truth(umwandlungsrecht_503_besteht(entity_ref("urn:de:bgb:sv:h20:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
