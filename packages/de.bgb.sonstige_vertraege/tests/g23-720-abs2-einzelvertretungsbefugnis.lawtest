language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 720 Absatz 2: die zur Gesamtvertretung befugten Gesellschafter ermächtigen einen von ihnen zu bestimmten Geschäften.
test "§ 720 Absatz 2: Einzelvertretungsbefugnis für bestimmte Geschäfte" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ermaechtigung_zu_bestimmten_geschaeften_720(entity_ref("urn:de:bgb:sv:g23:G"), entity_ref("urn:de:bgb:sv:g23:P")) { origin case_input; }
    }
    evaluate truth(einzelvertretungsbefugnis_fuer_geschaeft_720(entity_ref("urn:de:bgb:sv:g23:G"), entity_ref("urn:de:bgb:sv:g23:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
