language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 492b Absatz 1 Nummer 1: das Kopplungsgeschäft ist zulässig, weil es an ein Zahlungs- oder Sparkonto zur Kapitalansammlung anknüpft — trotz § 492a Absatz 1 keine Nichtigkeit der gekoppelten Geschäfte.
test "§ 492b Absatz 1: zulässiges Kopplungsgeschäft schließt Nichtigkeit aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": entgeltlicher_darlehensvertrag(entity_ref("urn:de:bgb:sv:v03:D")) { origin case_input; }
        assert "f2": unternehmer_als_darlehensgeber(entity_ref("urn:de:bgb:sv:v03:D")) { origin case_input; }
        assert "f3": verbraucher_als_darlehensnehmer(entity_ref("urn:de:bgb:sv:v03:D")) { origin case_input; }
        assert "f4": grundpfandrechtlich_besichert_oder_immobilienzweck(entity_ref("urn:de:bgb:sv:v03:D")) { origin case_input; }
        assert "f5": kopplungsgeschaeft_verlangt_492a(entity_ref("urn:de:bgb:sv:v03:D")) { origin case_input; }
        assert "f6": zahlungs_oder_sparkonto_grund_492b(entity_ref("urn:de:bgb:sv:v03:D")) { origin case_input; }
    }
    evaluate truth(kopplungsgeschaeft_492a(entity_ref("urn:de:bgb:sv:v03:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(zulaessiges_kopplungsgeschaeft_492b(entity_ref("urn:de:bgb:sv:v03:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(nichtigkeit_der_gekoppelten_geschaefte_492a(entity_ref("urn:de:bgb:sv:v03:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
