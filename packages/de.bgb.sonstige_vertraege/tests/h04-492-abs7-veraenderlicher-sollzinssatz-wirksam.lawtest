language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 492 Absatz 7: veränderlicher Sollzinssatz mit objektivem, überprüfbarem Index ist wirksam vereinbart.
test "§ 492 Absatz 7: veränderlicher Sollzinssatz mit tauglichem Index ist wirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": veraenderlicher_sollzinssatz_492_vereinbart(entity_ref("urn:de:bgb:sv:h04:D")) { origin case_input; }
        assert "f2": index_objektiv_eindeutig_verfuegbar_ueberpruefbar_492(entity_ref("urn:de:bgb:sv:h04:D")) { origin case_input; }
    }
    evaluate truth(vereinbarung_veraenderlicher_sollzinssatz_492_wirksam(entity_ref("urn:de:bgb:sv:h04:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
