language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675y Absatz 1 Satz 1: der vom Zahler ausgelöste Zahlungsauftrag über 450 Euro wird fehlerhaft ausgeführt — der Zahler kann die ungekürzte Erstattung verlangen.
test "§ 675y Absatz 1: Erstattungsanspruch bei fehlerhafter Ausführung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zahlungsvorgang_vom_zahler_ausgeloest_675y(entity_ref("urn:de:bgb:sv:z15:Z")) { origin case_input; }
        assert "f2": nicht_erfolgte_oder_fehlerhafte_ausfuehrung_675y(entity_ref("urn:de:bgb:sv:z15:Z")) { origin case_input; }
        assert "f3": zahlungsbetrag(entity_ref("urn:de:bgb:sv:z15:Z"), 450.00 EUR) { origin case_input; }
    }
    evaluate truth(erstattungsanspruch_675y(entity_ref("urn:de:bgb:sv:z15:Z"), 450.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
