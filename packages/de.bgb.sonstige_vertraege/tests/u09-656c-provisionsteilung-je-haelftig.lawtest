language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 656c Absatz 1 Satz 1: Kaufvertrag über ein Einfamilienhaus, Käufer ist Verbraucher, beide Parteien versprechen je 11 900,00 Euro — die Verpflichtung in gleicher Höhe ist erfüllt.
test "§ 656c Absatz 1: Maklerlohn von beiden Parteien in gleicher Höhe" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kaufvertrag_wohnung_oder_einfamilienhaus(entity_ref("urn:de:bgb:sv:u09:M")) { origin case_input; }
        assert "f2": kaeufer_ist_verbraucher(entity_ref("urn:de:bgb:sv:u09:M")) { origin case_input; }
        assert "f3": lohn_von_beiden_parteien_versprochen(entity_ref("urn:de:bgb:sv:u09:M"), 11900.00 EUR, 11900.00 EUR) { origin case_input; }
    }
    evaluate truth(lohnverpflichtung_in_gleicher_hoehe(entity_ref("urn:de:bgb:sv:u09:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
