language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 491 Absatz 2 Satz 2 Nummer 1: 199,99 Euro — einen Cent unter der Schwelle, die Ausnahme greift, kein Allgemein-Verbraucherdarlehensvertrag.
test "§ 491 Absatz 2: Nettodarlehensbetrag einen Cent unter 200 Euro — kein Verbraucherdarlehensvertrag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": entgeltlicher_darlehensvertrag(entity_ref("urn:de:bgb:sv:d02:D")) { origin case_input; }
        assert "f2": unternehmer_als_darlehensgeber(entity_ref("urn:de:bgb:sv:d02:D")) { origin case_input; }
        assert "f3": verbraucher_als_darlehensnehmer(entity_ref("urn:de:bgb:sv:d02:D")) { origin case_input; }
        assert "f4": nettodarlehensbetrag(entity_ref("urn:de:bgb:sv:d02:D"), 199.99 EUR) { origin case_input; }
    }
    evaluate truth(allgemein_verbraucherdarlehensvertrag(entity_ref("urn:de:bgb:sv:d02:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
