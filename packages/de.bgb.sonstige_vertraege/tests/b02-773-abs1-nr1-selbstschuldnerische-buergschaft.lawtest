language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 773 Absatz 1 Nummer 1: derselbe Fall wie b01, nur der Verzicht auf die Einrede kommt hinzu — die Einrede ist ausgeschlossen. Kanarienvogel „minus eine Bedingung".
test "§ 773 Absatz 1 Nummer 1: Verzicht schließt die Einrede der Vorausklage aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": buergschaftserklaerung_abgegeben(entity_ref("urn:de:bgb:sv:b02:B")) { origin case_input; }
        assert "f2": buergschaftserklaerung_schriftlich_erteilt(entity_ref("urn:de:bgb:sv:b02:B")) { origin case_input; }
        assert "f3": auf_einrede_der_vorausklage_verzichtet(entity_ref("urn:de:bgb:sv:b02:B")) { origin case_input; }
    }
    evaluate truth(einrede_der_vorausklage(entity_ref("urn:de:bgb:sv:b02:B")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
