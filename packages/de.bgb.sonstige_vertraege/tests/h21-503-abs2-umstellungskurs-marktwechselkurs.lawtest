language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 503 Absatz 2 Satz 1: Umstellung zu dem am Antragstag geltenden Marktwechselkurs.
test "§ 503 Absatz 2: Umstellung zum Marktwechselkurs am Tag des Antrags" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": antrag_auf_umstellung_503_gestellt_am(entity_ref("urn:de:bgb:sv:h21:D"), @2026-09-10) { origin case_input; }
        assert "f2": marktwechselkurs_am_503(entity_ref("urn:de:bgb:sv:h21:D"), @2026-09-10, 1.08) { origin case_input; }
    }
    evaluate truth(umstellungskurs_503(entity_ref("urn:de:bgb:sv:h21:D"), 1.08));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
