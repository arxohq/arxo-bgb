language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 675t Absatz 1 Satz 2: der Zahlungsbetrag geht am 16.09.2026 beim Zahlungsdienstleister des Empfängers ein — das Wertstellungsdatum ist spätestens dieser Tag.
test "§ 675t Absatz 1: Wertstellungsdatum spätestens der Eingangstag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": zahlungseingang_beim_zdl_des_empfaengers_am_675t(entity_ref("urn:de:bgb:sv:z11:Z"), @2026-09-16) { origin case_input; }
    }
    evaluate truth(wertstellungsdatum_spaetestens_675t(entity_ref("urn:de:bgb:sv:z11:Z"), @2026-09-16));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
