language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 709 Absatz 3 Satz 2: keine Beteiligungsverhältnisse, aber Werte der Beiträge 3 000 / 1 000 / 1 000 — Anteil des ersten Gesellschafters 3000/5000.
test "§ 709 Absatz 3 Satz 2: Anteil nach dem Verhältnis der vereinbarten Beitragswerte" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesellschafter(entity_ref("urn:de:bgb:sv:g02:G"), entity_ref("urn:de:bgb:sv:g02:A")) { origin case_input; }
        assert "f2": gesellschafter(entity_ref("urn:de:bgb:sv:g02:G"), entity_ref("urn:de:bgb:sv:g02:B")) { origin case_input; }
        assert "f3": gesellschafter(entity_ref("urn:de:bgb:sv:g02:G"), entity_ref("urn:de:bgb:sv:g02:C")) { origin case_input; }
        assert "f4": beitragswert_vereinbart(entity_ref("urn:de:bgb:sv:g02:G"), entity_ref("urn:de:bgb:sv:g02:A"), 3000) { origin case_input; }
        assert "f5": beitragswert_vereinbart(entity_ref("urn:de:bgb:sv:g02:G"), entity_ref("urn:de:bgb:sv:g02:B"), 1000) { origin case_input; }
        assert "f6": beitragswert_vereinbart(entity_ref("urn:de:bgb:sv:g02:G"), entity_ref("urn:de:bgb:sv:g02:C"), 1000) { origin case_input; }
    }
    evaluate truth(anteil_bruch(entity_ref("urn:de:bgb:sv:g02:G"), entity_ref("urn:de:bgb:sv:g02:A"), 3000, 5000));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
