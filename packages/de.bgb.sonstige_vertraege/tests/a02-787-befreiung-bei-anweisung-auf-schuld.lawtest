language "law.core" version "0.2";
package de.bgb.sonstige_vertraege version "0.1.0";
namespace "urn:de:corpus:clir:bgb-sonstige-vertraege";
// § 787 Absatz 1: der Angewiesene ist Schuldner des Anweisenden und bewirkt 3 000 Euro an den Anweisungsempfänger — er wird in dieser Höhe von seiner Schuld befreit.
test "§ 787 Absatz 1: Befreiung bei Anweisung auf Schuld" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_SONSTIGE_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": angewiesener_ist_schuldner_des_anweisenden(entity_ref("urn:de:bgb:sv:a02:A")) { origin case_input; }
        assert "f2": leistung_bewirkt(entity_ref("urn:de:bgb:sv:a02:A"), 3000.00 EUR) { origin case_input; }
    }
    evaluate truth(befreiung_von_schuld_787(entity_ref("urn:de:bgb:sv:a02:A"), 3000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
