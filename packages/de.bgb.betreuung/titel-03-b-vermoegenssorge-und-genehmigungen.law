// BÜRGERLICHES GESETZBUCH, BUCH 4 ABSCHNITT 3 TITEL 3 — RECHTLICHE BETREUUNG
// (§§ 1835–1860: Vermögensverzeichnis, Geldanlage, Genehmigungspflichten,
// Befreiungen). Nach D-14-03/D-14-06 mit Regelmaschinerie ausgeführt: §§ 1835,
// 1836, 1837, 1838, 1839, 1840, 1841, 1842, 1843, 1844, 1845, 1846, 1847,
// 1848, 1849, 1850, 1851, 1852, 1853, 1854, 1855, 1856, 1857, 1858 (Absatz 1,
// 2; Absatz 3 bleibt offen — Schwebezustand mit Fristenhemmung), 1859, 1860
// (Absatz 1, 4; Absätze 2, 3, 5 bleiben offen). TASKS.json BG-14-TODO-1.

language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";

// § 1835: Vermögensverzeichnis.

pub relation vermoegensverwaltung_gehoert_zum_aufgabenkreis(b: Person, betreuter: Person) kind empirical {
    label de official "Die Verwaltung des Vermögens des Betreuten gehört zum Aufgabenkreis des Betreuers (§ 1835 Absatz 1 Satz 1)";
    label en unofficial "administering the represented person's assets falls within the custodian's scope (§ 1835 (1) sentence 1)";
}
pub relation vermoegensverzeichnis_pflicht(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat zum Zeitpunkt seiner Bestellung ein Vermögensverzeichnis zu erstellen und dem Betreuungsgericht mit Versicherung der Richtigkeit und Vollständigkeit einzureichen (§ 1835 Absatz 1 Satz 1)";
    label en unofficial "on appointment, the custodian must draw up an inventory of assets and submit it to the custody court with an assurance of accuracy and completeness (§ 1835 (1) sentence 1)";
}
@source(BGB_P1835)
rule VermoegensverzeichnisPflicht(b: Person, betreuter: Person) strict {
    label de official "Soweit die Vermögensverwaltung zum Aufgabenkreis gehört, hat der Betreuer ein Vermögensverzeichnis zu erstellen und einzureichen (§ 1835 Absatz 1 Satz 1)";
    label en unofficial "so far as asset administration falls within their scope, the custodian must draw up and submit an inventory of assets (§ 1835 (1) sentence 1)";
    when gesetzlicher_vertreter(b, betreuter) and vermoegensverwaltung_gehoert_zum_aufgabenkreis(b, betreuter);
    then vermoegensverzeichnis_pflicht(b, betreuter);
}
pub relation vermoegensverzeichnis_ungenuegend(b: Person, betreuter: Person) kind empirical {
    label de official "Das eingereichte Vermögensverzeichnis ist ungenügend (§ 1835 Absatz 5)";
    label en unofficial "the submitted inventory of assets is insufficient (§ 1835 (5))";
}
pub relation aufnahme_durch_behoerde_oder_notar_anordenbar(b: Person, betreuter: Person) kind institutional {
    label de official "Das Betreuungsgericht kann anordnen, dass das Vermögensverzeichnis durch die Betreuungsbehörde oder einen Notar aufgenommen wird (§ 1835 Absatz 5)";
    label en unofficial "the custody court may order that the inventory be taken by the custodianship authority or a notary (§ 1835 (5))";
}
@source(BGB_P1835)
rule AufnahmeDurchBehoerdeOderNotar(b: Person, betreuter: Person) strict {
    label de official "Ist das eingereichte Vermögensverzeichnis ungenügend, kann das Betreuungsgericht anordnen, dass es durch die zuständige Betreuungsbehörde oder einen Notar aufgenommen wird (§ 1835 Absatz 5)";
    label en unofficial "if the submitted inventory is insufficient, the custody court may order it to be taken by the competent custodianship authority or a notary (§ 1835 (5))";
    when vermoegensverzeichnis_ungenuegend(b, betreuter);
    then aufnahme_durch_behoerde_oder_notar_anordenbar(b, betreuter);
}

// § 1836: Trennungsgebot — Ausnahme für gemeinschaftliches Vermögen, sofern
// das Betreuungsgericht nichts anderes anordnet (Absatz 1); Verwendungsverbot
// mit Ausnahme bei ehrenamtlicher Betreuung und Vereinbarung (Absatz 2).

pub relation gemeinschaftliches_vermoegen_besteht(b: Person, betreuter: Person) kind empirical {
    label de official "Bei Bestellung des Betreuers bestehendes oder während der Betreuung hinzukommendes gemeinschaftliches Vermögen des Betreuers und des Betreuten (§ 1836 Absatz 1 Satz 2)";
    label en unofficial "common property of the custodian and the represented person existing at appointment or accruing during the custodianship (§ 1836 (1) sentence 2)";
}
pub relation gericht_ordnet_andere_behandlung_des_gemeinschaftlichen_vermoegens_an(b: Person, betreuter: Person) kind empirical {
    label de official "Das Betreuungsgericht ordnet für das gemeinschaftliche Vermögen etwas anderes an (§ 1836 Absatz 1 Satz 2)";
    label en unofficial "the custody court orders something else for the common property (§ 1836 (1) sentence 2)";
}
pub relation trennungsgebot_ausgenommen_1836(b: Person, betreuter: Person) kind institutional {
    label de official "Das Trennungsgebot gilt nicht für das gemeinschaftliche Vermögen (§ 1836 Absatz 1 Satz 2)";
    label en unofficial "the separation duty does not apply to the common property (§ 1836 (1) sentence 2)";
}
@source(BGB_P1836)
rule TrennungsgebotAusgenommenBeiGemeinschaftlichemVermoegen(b: Person, betreuter: Person) strict {
    label de official "Für gemeinschaftliches Vermögen des Betreuers und des Betreuten gilt das Trennungsgebot nicht, wenn das Betreuungsgericht nichts anderes anordnet (§ 1836 Absatz 1 Satz 2)";
    label en unofficial "the separation duty does not apply to common property of the custodian and the represented person, unless the custody court orders otherwise (§ 1836 (1) sentence 2)";
    when gemeinschaftliches_vermoegen_besteht(b, betreuter) and not_known(gericht_ordnet_andere_behandlung_des_gemeinschaftlichen_vermoegens_an(b, betreuter));
    then trennungsgebot_ausgenommen_1836(b, betreuter);
}
pub relation vermoegen_getrennt_zu_halten_pflicht(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat das Vermögen des Betreuten getrennt von seinem eigenen Vermögen zu halten (§ 1836 Absatz 1 Satz 1)";
    label en unofficial "the custodian must keep the represented person's assets separate from their own (§ 1836 (1) sentence 1)";
}
@source(BGB_P1836)
rule TrennungsgebotGrundsatz(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer hat das Vermögen des Betreuten getrennt von seinem eigenen Vermögen zu halten, soweit nicht die Ausnahme für gemeinschaftliches Vermögen greift (§ 1836 Absatz 1 Satz 1)";
    label en unofficial "the custodian must keep the represented person's assets separate from their own unless the common-property exception applies (§ 1836 (1) sentence 1)";
    when gesetzlicher_vertreter(b, betreuter) and vermoegensverwaltung_gehoert_zum_aufgabenkreis(b, betreuter) and not_known(trennungsgebot_ausgenommen_1836(b, betreuter));
    then vermoegen_getrennt_zu_halten_pflicht(b, betreuter);
}
pub relation betreuung_ehrenamtlich_und_verwendungsvereinbarung(b: Person, betreuter: Person) kind empirical {
    label de official "Die Betreuung wird ehrenamtlich geführt, und zwischen dem Betreuten und dem Betreuer besteht eine Vereinbarung über die Verwendung des Vermögens (§ 1836 Absatz 2 Satz 2)";
    label en unofficial "the custodianship is held on an honorary basis, and the represented person and the custodian have an agreement on the use of the assets (§ 1836 (2) sentence 2)";
}
pub relation vermoegen_fuer_sich_verwenden_verboten(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer darf das Vermögen des Betreuten nicht für sich verwenden (§ 1836 Absatz 2 Satz 1)";
    label en unofficial "the custodian may not use the represented person's assets for themselves (§ 1836 (2) sentence 1)";
}
@source(BGB_P1836)
rule VerwendungsverbotGrundsatz(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer darf das Vermögen des Betreuten nicht für sich verwenden, es sei denn, die Betreuung wird ehrenamtlich geführt und eine Verwendungsvereinbarung besteht (§ 1836 Absatz 2 Satz 1, 2)";
    label en unofficial "the custodian may not use the represented person's assets for themselves, unless the custodianship is honorary and a use agreement exists (§ 1836 (2) sentences 1, 2)";
    when gesetzlicher_vertreter(b, betreuter) and vermoegensverwaltung_gehoert_zum_aufgabenkreis(b, betreuter) and not_known(betreuung_ehrenamtlich_und_verwendungsvereinbarung(b, betreuter));
    then vermoegen_fuer_sich_verwenden_verboten(b, betreuter);
}

// § 1837: Vermögensverwaltung nach den Anordnungen des Erblassers oder Zuwendenden.

pub relation erwerb_von_todes_wegen_oder_unentgeltliche_zuwendung(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreute erwirbt Vermögen von Todes wegen oder ihm wird unentgeltlich durch Zuwendung auf den Todesfall oder unter Lebenden von einem Dritten Vermögen zugewendet (§ 1837 Absatz 1)";
    label en unofficial "the represented person acquires property on death, or property is gratuitously conferred on them on death or inter vivos by a third party (§ 1837 (1))";
}
pub relation anordnungen_des_erblassers_oder_zuwendenden_getroffen(b: Person, betreuter: Person) kind empirical {
    label de official "Der Erblasser hat durch letztwillige Verfügung oder der Dritte hat bei der Zuwendung Anordnungen getroffen, die sich an den Betreuer richten (§ 1837 Absatz 1)";
    label en unofficial "the testator by testamentary disposition, or the third party when making the gift, gave directions addressed to the custodian (§ 1837 (1))";
}
pub relation verwaltung_nach_anordnungen_pflicht(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat das so erworbene Vermögen nach den Anordnungen des Erblassers oder des Zuwendenden zu verwalten (§ 1837 Absatz 1)";
    label en unofficial "the custodian must administer the property so acquired in accordance with the testator's or donor's directions (§ 1837 (1))";
}
@source(BGB_P1837)
rule VerwaltungNachAnordnungenPflicht(b: Person, betreuter: Person) strict {
    label de official "Erwirbt der Betreute Vermögen von Todes wegen oder durch unentgeltliche Zuwendung und sind Anordnungen des Erblassers oder Zuwendenden getroffen, hat der Betreuer das Vermögen danach zu verwalten (§ 1837 Absatz 1)";
    label en unofficial "where the represented person acquires property on death or by gratuitous disposition and the testator or donor gave directions, the custodian must administer the property accordingly (§ 1837 (1))";
    when gesetzlicher_vertreter(b, betreuter) and erwerb_von_todes_wegen_oder_unentgeltliche_zuwendung(b, betreuter) and anordnungen_des_erblassers_oder_zuwendenden_getroffen(b, betreuter);
    then verwaltung_nach_anordnungen_pflicht(b, betreuter);
}

// § 1838: Pflichten des Betreuers in Vermögensangelegenheiten — Anzeigepflicht
// bei Abweichung von §§ 1839–1843 (Absatz 2 Satz 1).

pub relation wahrnehmung_weicht_von_1839_bis_1843_ab(b: Person, betreuter: Person) kind empirical {
    label de official "Die nach § 1838 Absatz 1 Satz 1 gebotene Wahrnehmung der Vermögensangelegenheiten weicht von den in den §§ 1839 bis 1843 festgelegten Grundsätzen ab (§ 1838 Absatz 2 Satz 1)";
    label en unofficial "attending to the asset affairs as required by § 1838 (1) sentence 1 departs from the principles laid down in §§ 1839 to 1843 (§ 1838 (2) sentence 1)";
}
pub relation anzeigepflicht_abweichung_1838(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat die Abweichung von den §§ 1839 bis 1843 dem Betreuungsgericht unverzüglich unter Darlegung der Wünsche des Betreuten anzuzeigen (§ 1838 Absatz 2 Satz 1)";
    label en unofficial "the custodian must notify the custody court of the departure from §§ 1839 to 1843 without delay, setting out the represented person's wishes (§ 1838 (2) sentence 1)";
}
@source(BGB_P1838)
rule AnzeigepflichtAbweichung1838(b: Person, betreuter: Person) strict {
    label de official "Weicht die gebotene Wahrnehmung der Vermögensangelegenheiten von den §§ 1839 bis 1843 ab, hat der Betreuer dies dem Betreuungsgericht unverzüglich anzuzeigen (§ 1838 Absatz 2 Satz 1)";
    label en unofficial "where the required attention to the asset affairs departs from §§ 1839 to 1843, the custodian must notify the custody court without delay (§ 1838 (2) sentence 1)";
    when gesetzlicher_vertreter(b, betreuter) and wahrnehmung_weicht_von_1839_bis_1843_ab(b, betreuter);
    then anzeigepflicht_abweichung_1838(b, betreuter);
}

// § 1839: Bereithaltung von Verfügungsgeld.

pub relation geld_fuer_ausgaben_des_betreuten_benoetigt(b: Person, betreuter: Person, betrag: Money) kind empirical {
    label de official "Geld des Betreuten, das der Betreuer für dessen Ausgaben benötigt (Verfügungsgeld) (§ 1839 Absatz 1 Satz 1)";
    label en unofficial "money of the represented person which the custodian needs for their expenses (funds for disposal) (§ 1839 (1) sentence 1)";
}
pub relation verfuegungsgeld_auf_girokonto_bereitzuhalten(b: Person, betreuter: Person, betrag: Money) kind institutional {
    label de official "Das Verfügungsgeld ist auf einem Girokonto des Betreuten bei einem Kreditinstitut bereitzuhalten (§ 1839 Absatz 1 Satz 1)";
    label en unofficial "funds for disposal must be kept available in a current account of the represented person at a credit institution (§ 1839 (1) sentence 1)";
}
@source(BGB_P1839)
rule VerfuegungsgeldAufGirokonto(b: Person, betreuter: Person, betrag: Money) strict {
    label de official "Geld des Betreuten, das der Betreuer für dessen Ausgaben benötigt, hat er auf einem Girokonto bei einem Kreditinstitut bereitzuhalten (§ 1839 Absatz 1 Satz 1)";
    label en unofficial "money the custodian needs for the represented person's expenses must be kept available in a current account at a credit institution (§ 1839 (1) sentence 1)";
    when gesetzlicher_vertreter(b, betreuter) and geld_fuer_ausgaben_des_betreuten_benoetigt(b, betreuter, betrag);
    then verfuegungsgeld_auf_girokonto_bereitzuhalten(b, betreuter, betrag);
}

// § 1841: Anlagepflicht.

pub relation geld_nicht_fuer_ausgaben_benoetigt(b: Person, betreuter: Person, betrag: Money) kind empirical {
    label de official "Geld des Betreuten, das nicht für Ausgaben nach § 1839 benötigt wird (Anlagegeld) (§ 1841 Absatz 1)";
    label en unofficial "money of the represented person not needed for expenses under § 1839 (funds for investment) (§ 1841 (1))";
}
pub relation anlagegeld_anzulegen(b: Person, betreuter: Person, betrag: Money) kind institutional {
    label de official "Der Betreuer hat das Anlagegeld anzulegen (§ 1841 Absatz 1)";
    label en unofficial "the custodian must invest the funds for investment (§ 1841 (1))";
}
@source(BGB_P1841)
rule AnlagepflichtGeld(b: Person, betreuter: Person, betrag: Money) strict {
    label de official "Geld des Betreuten, das nicht für Ausgaben nach § 1839 benötigt wird, hat der Betreuer anzulegen (§ 1841 Absatz 1)";
    label en unofficial "the custodian must invest money of the represented person not needed for expenses under § 1839 (§ 1841 (1))";
    when gesetzlicher_vertreter(b, betreuter) and geld_nicht_fuer_ausgaben_benoetigt(b, betreuter, betrag);
    then anlagegeld_anzulegen(b, betreuter, betrag);
}
pub relation anlage_auf_verzinslichem_anlagekonto(b: Person, betreuter: Person, betrag: Money) kind empirical {
    label de official "Der Betreuer legt das Anlagegeld auf einem zur verzinslichen Anlage geeigneten Konto (Anlagekonto) an (§ 1841 Absatz 2)";
    label en unofficial "the custodian invests the funds in an interest-bearing account suitable for investment (investment account) (§ 1841 (2))";
}
pub relation anlage_ordnungsgemaess_1841(b: Person, betreuter: Person, betrag: Money) kind institutional {
    label de official "Die Anlage entspricht § 1841 Absatz 2: kein Genehmigungserfordernis nach § 1848";
    label en unofficial "the investment matches § 1841 (2): no approval requirement under § 1848";
}
@source(BGB_P1841)
rule AnlageOrdnungsgemaess(b: Person, betreuter: Person, betrag: Money) strict {
    label de official "Legt der Betreuer das Anlagegeld auf einem Anlagekonto im Sinne des § 1841 Absatz 2 an, entspricht dies dem Regelfall des Gesetzes (§ 1841 Absatz 2)";
    label en unofficial "where the custodian invests the funds in an account under § 1841 (2), this matches the statutory default case (§ 1841 (2))";
    when anlagegeld_anzulegen(b, betreuter, betrag) and anlage_auf_verzinslichem_anlagekonto(b, betreuter, betrag);
    then anlage_ordnungsgemaess_1841(b, betreuter, betrag);
}

// § 1840: Bargeldloser Zahlungsverkehr — Ausnahmen: übliche Barzahlungen im
// Geschäftsverkehr (Nummer 1), Auszahlungen an den Betreuten (Nummer 2).

pub relation zahlungsverkehr_fuer_betreuten(b: Person, betreuter: Person) kind empirical {
    label de official "Zahlungsverkehr, den der Betreuer für den Betreuten durchführt (§ 1840 Absatz 1)";
    label en unofficial "payment transactions the custodian carries out for the represented person (§ 1840 (1))";
}
pub relation im_geschaeftsverkehr_uebliche_barzahlung(b: Person, betreuter: Person) kind empirical {
    label de official "Im Geschäftsverkehr übliche Barzahlung (§ 1840 Absatz 2 Nummer 1)";
    label en unofficial "cash payment customary in business dealings (§ 1840 (2) no. 1)";
}
pub relation auszahlung_an_den_betreuten(b: Person, betreuter: Person) kind empirical {
    label de official "Auszahlung an den Betreuten (§ 1840 Absatz 2 Nummer 2)";
    label en unofficial "payment made to the represented person (§ 1840 (2) no. 2)";
}
pub relation bargeldlos_durchzufuehren_pflicht(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat den Zahlungsverkehr für den Betreuten bargeldlos unter Verwendung des Girokontos nach § 1839 Absatz 1 Satz 1 durchzuführen (§ 1840 Absatz 1)";
    label en unofficial "the custodian must carry out payment transactions for the represented person cashlessly using the current account under § 1839 (1) sentence 1 (§ 1840 (1))";
}
@source(BGB_P1840)
rule BargeldloserZahlungsverkehrPflicht(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer hat den Zahlungsverkehr bargeldlos durchzuführen, es sei denn, es handelt sich um eine im Geschäftsverkehr übliche Barzahlung oder eine Auszahlung an den Betreuten (§ 1840 Absatz 1, 2)";
    label en unofficial "the custodian must carry out payment transactions cashlessly, unless it is a cash payment customary in business dealings or a payment made to the represented person (§ 1840 (1), (2))";
    when gesetzlicher_vertreter(b, betreuter) and zahlungsverkehr_fuer_betreuten(b, betreuter)
        and not_known(im_geschaeftsverkehr_uebliche_barzahlung(b, betreuter))
        and not_known(auszahlung_an_den_betreuten(b, betreuter));
    then bargeldlos_durchzufuehren_pflicht(b, betreuter);
}

// § 1842: Voraussetzungen für das Kreditinstitut — Sicherungseinrichtung.

pub relation geldanlage_nach_1839_oder_1841abs2_bei_kreditinstitut(b: Person, betreuter: Person) kind empirical {
    label de official "Geldanlage nach § 1839 oder § 1841 Absatz 2 bei einem Kreditinstitut (§ 1842)";
    label en unofficial "investment of money under § 1839 or § 1841 (2) with a credit institution (§ 1842)";
}
pub relation kreditinstitut_muss_sicherungseinrichtung_angehoeren(b: Person, betreuter: Person) kind institutional {
    label de official "Das Kreditinstitut muss einer für die jeweilige Anlage ausreichenden Sicherungseinrichtung angehören (§ 1842)";
    label en unofficial "the credit institution must belong to a protection scheme sufficient for the respective investment (§ 1842)";
}
@source(BGB_P1842)
rule SicherungseinrichtungErforderlich(b: Person, betreuter: Person) strict {
    label de official "Legt der Betreuer Geld nach § 1839 oder § 1841 Absatz 2 bei einem Kreditinstitut an, muss dieses einer ausreichenden Sicherungseinrichtung angehören (§ 1842)";
    label en unofficial "where the custodian invests money under § 1839 or § 1841 (2) with a credit institution, that institution must belong to a sufficient protection scheme (§ 1842)";
    when gesetzlicher_vertreter(b, betreuter) and geldanlage_nach_1839_oder_1841abs2_bei_kreditinstitut(b, betreuter);
    then kreditinstitut_muss_sicherungseinrichtung_angehoeren(b, betreuter);
}

// § 1843: Depotverwahrung und Hinterlegung von Wertpapieren — Ausnahme
// Absatz 3 (nach den Umständen des Einzelfalls nicht geboten, Kanal §47.3).

pub relation wertpapiere_des_betreuten_depotgesetz(b: Person, betreuter: Person) kind empirical {
    label de official "Wertpapiere des Betreuten im Sinne des § 1 Absatz 1 und 2 des Depotgesetzes (§ 1843 Absatz 1)";
    label en unofficial "securities of the represented person within the meaning of § 1 (1), (2) Depot Act (§ 1843 (1))";
}
pub relation depotverwahrungspflicht_grundsatz(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat die Wertpapiere bei einem Kreditinstitut in Einzel- oder Sammelverwahrung verwahren zu lassen (§ 1843 Absatz 1)";
    label en unofficial "the custodian must have the securities held in individual or collective safe custody at a credit institution (§ 1843 (1))";
}
@source(BGB_P1843)
rule DepotverwahrungspflichtGrundsatz(b: Person, betreuter: Person) strict {
    label de official "Für Wertpapiere des Betreuten im Sinne des § 1 Absatz 1, 2 Depotgesetz besteht die Pflicht zur Depotverwahrung (§ 1843 Absatz 1)";
    label en unofficial "for the represented person's securities under § 1 (1), (2) Depot Act, a duty of safe custody exists (§ 1843 (1))";
    when gesetzlicher_vertreter(b, betreuter) and wertpapiere_des_betreuten_depotgesetz(b, betreuter);
    then depotverwahrungspflicht_grundsatz(b, betreuter);
}
@source(BGB_P1843)
pub external judgment relation depotverwahrung_nach_umstaenden_nicht_geboten(b: Person, betreuter: Person) {
    authority Court;
    label de official "Depotverwahrung oder Hinterlegung ist nach den Umständen des Einzelfalls unter Berücksichtigung der Art der Wertpapiere zur Sicherung des Vermögens des Betreuten nicht geboten (§ 1843 Absatz 3)";
    label en unofficial "safe custody or deposit is, given the circumstances of the case and the kind of securities, not required to secure the represented person's assets (§ 1843 (3))";
}
pub relation depotverwahrungspflicht_entfaellt(b: Person, betreuter: Person) kind institutional {
    label de official "Die Pflicht zur Depotverwahrung oder Hinterlegung besteht nicht (§ 1843 Absatz 3)";
    label en unofficial "the duty of safe custody or deposit does not exist (§ 1843 (3))";
}
@source(BGB_P1843)
rule DepotverwahrungspflichtEntfaelltNachUmstaenden(b: Person, betreuter: Person) strict {
    label de official "Ist die Depotverwahrung oder Hinterlegung nach den Umständen des Einzelfalls nicht geboten, besteht die Pflicht nicht (§ 1843 Absatz 3)";
    label en unofficial "where safe custody or deposit is not required given the circumstances of the case, the duty does not exist (§ 1843 (3))";
    when depotverwahrungspflicht_grundsatz(b, betreuter) and depotverwahrung_nach_umstaenden_nicht_geboten(b, betreuter);
    then depotverwahrungspflicht_entfaellt(b, betreuter);
}

// § 1844: Hinterlegung von Wertgegenständen auf Anordnung des
// Betreuungsgerichts — die Anordnung selbst ist eine gerichtliche
// Entscheidung (origin adjudicated im Fall).

pub relation hinterlegung_von_wertgegenstaenden_angeordnet(b: Person, betreuter: Person) kind empirical {
    label de official "Das Betreuungsgericht ordnet an, dass der Betreuer Wertgegenstände des Betreuten bei einer Hinterlegungsstelle oder einer anderen geeigneten Stelle hinterlegt (§ 1844)";
    label en unofficial "the custody court orders that the custodian deposit the represented person's valuables with a deposit office or another suitable body (§ 1844)";
}
pub relation wertgegenstaende_hinterlegungspflicht(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat die Wertgegenstände entsprechend der gerichtlichen Anordnung zu hinterlegen (§ 1844)";
    label en unofficial "the custodian must deposit the valuables in accordance with the court's order (§ 1844)";
}
@source(BGB_P1844)
rule WertgegenstaendeHinterlegungspflicht(b: Person, betreuter: Person) strict {
    label de official "Ordnet das Betreuungsgericht die Hinterlegung von Wertgegenständen des Betreuten an, hat der Betreuer sie zu hinterlegen (§ 1844)";
    label en unofficial "where the custody court orders the deposit of the represented person's valuables, the custodian must deposit them (§ 1844)";
    when gesetzlicher_vertreter(b, betreuter) and hinterlegung_von_wertgegenstaenden_angeordnet(b, betreuter);
    then wertgegenstaende_hinterlegungspflicht(b, betreuter);
}

// § 1845: Sperrvereinbarung.

pub relation sperrvereinbarung_fuer_anlage_1841abs2(b: Person, betreuter: Person, betrag: Money) kind empirical {
    label de official "Der Betreuer hat mit dem Kreditinstitut vereinbart, dass er über eine Geldanlage nach § 1841 Absatz 2 nur mit Genehmigung des Betreuungsgerichts verfügen kann (§ 1845 Absatz 1 Satz 1)";
    label en unofficial "the custodian has agreed with the credit institution that they may only dispose of an investment under § 1841 (2) with the custody court's approval (§ 1845 (1) sentence 1)";
}
pub relation sperrvereinbarung_pflicht(b: Person, betreuter: Person, betrag: Money) kind institutional {
    label de official "Für Geldanlagen im Sinne des § 1841 Absatz 2 hat der Betreuer eine Sperrvereinbarung mit dem Kreditinstitut zu treffen (§ 1845 Absatz 1 Satz 1)";
    label en unofficial "for investments under § 1841 (2) the custodian must conclude a blocking agreement with the credit institution (§ 1845 (1) sentence 1)";
}
@source(BGB_P1845)
rule SperrvereinbarungPflicht(b: Person, betreuter: Person, betrag: Money) strict {
    label de official "Für Geldanlagen des Betreuten im Sinne von § 1841 Absatz 2 hat der Betreuer zu vereinbaren, dass er über die Anlage nur mit Genehmigung des Betreuungsgerichts verfügen kann (§ 1845 Absatz 1 Satz 1)";
    label en unofficial "for the represented person's investments under § 1841 (2) the custodian must agree they may only dispose of the investment with the custody court's approval (§ 1845 (1) sentence 1)";
    when anlage_auf_verzinslichem_anlagekonto(b, betreuter, betrag);
    then sperrvereinbarung_pflicht(b, betreuter, betrag);
}
pub relation verfuegung_ueber_gesperrte_anlage_genehmigungsbeduerftig(b: Person, betreuter: Person, betrag: Money) kind institutional {
    label de official "Über die gesperrte Anlage kann der Betreuer nur mit Genehmigung des Betreuungsgerichts verfügen (§ 1845 Absatz 1 Satz 1)";
    label en unofficial "the custodian may only dispose of the blocked investment with the custody court's approval (§ 1845 (1) sentence 1)";
}
@source(BGB_P1845)
rule VerfuegungUeberGesperrteAnlageGenehmigungsbeduerftig(b: Person, betreuter: Person, betrag: Money) strict {
    label de official "Ist eine Sperrvereinbarung getroffen, bedarf die Verfügung über die Anlage der Genehmigung des Betreuungsgerichts (§ 1845 Absatz 1 Satz 1)";
    label en unofficial "once a blocking agreement is in place, disposing of the investment requires the custody court's approval (§ 1845 (1) sentence 1)";
    when sperrvereinbarung_fuer_anlage_1841abs2(b, betreuter, betrag);
    then verfuegung_ueber_gesperrte_anlage_genehmigungsbeduerftig(b, betreuter, betrag);
}

// § 1846: Anzeigepflichten bei der Geld- und Vermögensverwaltung — Absatz 1
// Nummer 1 (Girokonto) und Nummer 2 (Anlagekonto), die an die bereits
// modellierten Konten-Relationen der §§ 1839, 1841 anknüpfen.

pub relation girokonto_fuer_betreuten_eroeffnet(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer eröffnet ein Girokonto für den Betreuten (§ 1846 Absatz 1 Nummer 1)";
    label en unofficial "the custodian opens a current account for the represented person (§ 1846 (1) no. 1)";
}
pub relation anlagekonto_fuer_betreuten_eroeffnet(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer eröffnet ein Anlagekonto für den Betreuten (§ 1846 Absatz 1 Nummer 2)";
    label en unofficial "the custodian opens an investment account for the represented person (§ 1846 (1) no. 2)";
}
pub relation anzeigepflicht_kontoeroeffnung_1846(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat die Kontoeröffnung dem Betreuungsgericht unverzüglich anzuzeigen (§ 1846 Absatz 1)";
    label en unofficial "the custodian must notify the custody court of the account opening without delay (§ 1846 (1))";
}
@source(BGB_P1846)
rule AnzeigepflichtKontoeroeffnung1846(b: Person, betreuter: Person) strict {
    label de official "Eröffnet der Betreuer ein Girokonto oder ein Anlagekonto für den Betreuten, hat er dies dem Betreuungsgericht unverzüglich anzuzeigen (§ 1846 Absatz 1 Nummer 1, 2)";
    label en unofficial "where the custodian opens a current or investment account for the represented person, they must notify the custody court without delay (§ 1846 (1) no. 1, 2)";
    when gesetzlicher_vertreter(b, betreuter) and (girokonto_fuer_betreuten_eroeffnet(b, betreuter) or anlagekonto_fuer_betreuten_eroeffnet(b, betreuter));
    then anzeigepflicht_kontoeroeffnung_1846(b, betreuter);
}

// § 1847: Anzeigepflicht für Erwerbsgeschäfte — Beginn eines neuen und
// Aufgabe eines bestehenden Erwerbsgeschäfts.

pub relation neues_erwerbsgeschaeft_im_namen_des_betreuten_begonnen(b: Person, betreuter: Person) kind empirical {
    label de official "Beginn eines neuen Erwerbsgeschäfts im Namen des Betreuten (§ 1847)";
    label en unofficial "commencement of a new business venture in the represented person's name (§ 1847)";
}
pub relation bestehendes_erwerbsgeschaeft_des_betreuten_aufgegeben(b: Person, betreuter: Person) kind empirical {
    label de official "Aufgabe eines bestehenden Erwerbsgeschäfts des Betreuten (§ 1847)";
    label en unofficial "cessation of an existing business venture of the represented person (§ 1847)";
}
pub relation anzeigepflicht_erwerbsgeschaeft_1847(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat Beginn, Art und Umfang eines neuen Erwerbsgeschäfts oder die Aufgabe eines bestehenden Erwerbsgeschäfts des Betreuten beim Betreuungsgericht anzuzeigen (§ 1847)";
    label en unofficial "the custodian must notify the custody court of the start, nature and extent of a new business venture or of the cessation of an existing one (§ 1847)";
}
@source(BGB_P1847)
rule AnzeigepflichtErwerbsgeschaeft1847(b: Person, betreuter: Person) strict {
    label de official "Beginnt der Betreuer im Namen des Betreuten ein neues Erwerbsgeschäft oder gibt er ein bestehendes auf, hat er dies dem Betreuungsgericht anzuzeigen (§ 1847)";
    label en unofficial "where the custodian begins a new business venture in the represented person's name, or ends an existing one, they must notify the custody court (§ 1847)";
    when gesetzlicher_vertreter(b, betreuter) and (neues_erwerbsgeschaeft_im_namen_des_betreuten_begonnen(b, betreuter) or bestehendes_erwerbsgeschaeft_des_betreuten_aufgegeben(b, betreuter));
    then anzeigepflicht_erwerbsgeschaeft_1847(b, betreuter);
}

// § 1848: Genehmigung einer anderen Anlegung von Geld.

pub relation geld_anders_als_auf_anlagekonto_angelegt(b: Person, betreuter: Person, betrag: Money) kind empirical {
    label de official "Der Betreuer legt Anlagegeld anders als auf einem Anlagekonto gemäß § 1841 Absatz 2 an (§ 1848)";
    label en unofficial "the custodian invests funds otherwise than in an account under § 1841 (2) (§ 1848)";
}
pub relation genehmigung_1848_erforderlich(b: Person, betreuter: Person, betrag: Money) kind institutional {
    label de official "Der Betreuer bedarf der Genehmigung des Betreuungsgerichts (§ 1848)";
    label en unofficial "the custodian requires the custody court's approval (§ 1848)";
}
@source(BGB_P1848)
rule Genehmigung1848(b: Person, betreuter: Person, betrag: Money) strict {
    label de official "Der Betreuer bedarf der Genehmigung des Betreuungsgerichts, wenn er Anlagegeld anders als auf einem Anlagekonto gemäß § 1841 Absatz 2 anlegt (§ 1848)";
    label en unofficial "the custodian requires the custody court's approval where they invest funds otherwise than in an account under § 1841 (2) (§ 1848)";
    when gesetzlicher_vertreter(b, betreuter) and geld_anders_als_auf_anlagekonto_angelegt(b, betreuter, betrag);
    then genehmigung_1848_erforderlich(b, betreuter, betrag);
}

// § 1849: Genehmigung bei Verfügung über Rechte und Wertpapiere — Schwellenwerte in Euro.

pub relation verfuegung_ueber_geldleistungsrecht(b: Person, betreuter: Person, zahlungsanspruch: Money) kind empirical {
    label de official "Verfügung über ein Recht, kraft dessen der Betreute eine Geldleistung verlangen kann (§ 1849 Absatz 1 Satz 1 Nummer 1)";
    label en unofficial "disposal of a right under which the represented person can demand a monetary payment (§ 1849 (1) sentence 1 no. 1)";
}
pub relation genehmigung_1849_erforderlich(b: Person, betreuter: Person, zahlungsanspruch: Money) kind institutional {
    label de official "Der Betreuer bedarf der Genehmigung des Betreuungsgerichts (§ 1849 Absatz 1)";
    label en unofficial "the custodian requires the custody court's approval (§ 1849 (1))";
}
@source(BGB_P1849)
rule Genehmigung1849ErforderlichUeber3000Euro(b: Person, betreuter: Person, zahlungsanspruch: Money) strict {
    label de official "Der Betreuer bedarf der Genehmigung zur Verfügung über ein Geldleistungsrecht, wenn der Zahlungsanspruch 3 000 Euro übersteigt (§ 1849 Absatz 1 Satz 1 Nummer 1, Absatz 2 Satz 1 Nummer 1 Buchstabe a)";
    label en unofficial "the custodian requires approval to dispose of a monetary-payment right where the claim exceeds EUR 3,000 (§ 1849 (1) sentence 1 no. 1, (2) sentence 1 no. 1 (a))";
    when gesetzlicher_vertreter(b, betreuter) and verfuegung_ueber_geldleistungsrecht(b, betreuter, zahlungsanspruch) and zahlungsanspruch > 3000.00 EUR;
    then genehmigung_1849_erforderlich(b, betreuter, zahlungsanspruch);
}

// § 1850: Genehmigung für Rechtsgeschäfte über Grundstücke und Schiffe.

pub relation verfuegung_ueber_grundstueck_oder_grundstuecksrecht(b: Person, betreuter: Person) kind empirical {
    label de official "Verfügung über ein Grundstück oder ein Recht an einem Grundstück, sofern nicht bereits nach § 1833 Absatz 3 Satz 1 Nummer 4 genehmigungsbedürftig (§ 1850 Nummer 1)";
    label en unofficial "disposal of land or a right in land, unless approval is already required under § 1833 (3) sentence 1 no. 4 (§ 1850 no. 1)";
}
pub relation genehmigung_1850_erforderlich(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer bedarf der Genehmigung des Betreuungsgerichts zur Verfügung über ein Grundstück (§ 1850 Nummer 1)";
    label en unofficial "the custodian requires the custody court's approval to dispose of land (§ 1850 no. 1)";
}
@source(BGB_P1850)
rule Genehmigung1850Grundstuecksverfuegung(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer bedarf der Genehmigung des Betreuungsgerichts zur Verfügung über ein Grundstück oder ein Recht an einem Grundstück, sofern die Genehmigung nicht bereits nach § 1833 Absatz 3 Satz 1 Nummer 4 erforderlich ist (§ 1850 Nummer 1)";
    label en unofficial "the custodian requires the custody court's approval to dispose of land or a right in land, unless approval is already required under § 1833 (3) sentence 1 no. 4 (§ 1850 no. 1)";
    when gesetzlicher_vertreter(b, betreuter) and verfuegung_ueber_grundstueck_oder_grundstuecksrecht(b, betreuter) and not_known(genehmigung_1833_erforderlich(b, betreuter));
    then genehmigung_1850_erforderlich(b, betreuter);
}

// § 1851: Genehmigung für erbrechtliche Rechtsgeschäfte — geschlossener
// Katalog von neun Nummern; hier Nummer 1 (Ausschlagung/Verzicht) und
// Nummer 3 (Verfügung über den Erbteil) als Regel je Nummer (D-14-06 Block 2);
// ein Rechtsgeschäft außerhalb des Katalogs (m15) bleibt NEITHER, weil keine
// Nummer feuert — kein Ausschluss-, sondern ein reines Enumerationsprädikat.

pub relation ausschlagung_erbschaft_vermaechtnis_oder_verzicht(b: Person, betreuter: Person) kind empirical {
    label de official "Ausschlagung einer Erbschaft oder eines Vermächtnisses, Verzicht auf ein Vermächtnis oder einen Pflichtteilsanspruch, Auseinandersetzungsvertrag (§ 1851 Nummer 1)";
    label en unofficial "disclaiming an inheritance or legacy, waiving a legacy or compulsory-portion claim, or a partition agreement (§ 1851 no. 1)";
}
pub relation verfuegung_ueber_erbteil_oder_ausscheiden_aus_erbengemeinschaft(b: Person, betreuter: Person) kind empirical {
    label de official "Verfügung über den Anteil des Betreuten an einer Erbschaft oder Vereinbarung über das Ausscheiden aus der Erbengemeinschaft (§ 1851 Nummer 3)";
    label en unofficial "disposal of the represented person's share in an estate, or agreement on leaving the community of heirs (§ 1851 no. 3)";
}
pub relation genehmigung_1851_erforderlich(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer bedarf der Genehmigung des Betreuungsgerichts für das erbrechtliche Rechtsgeschäft (§ 1851)";
    label en unofficial "the custodian requires the custody court's approval for the succession-law transaction (§ 1851)";
}
@source(BGB_P1851)
rule Genehmigung1851ErforderlichNr1UndNr3(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer bedarf der Genehmigung zur Ausschlagung/zum Verzicht oder zur Verfügung über den Erbteil/zum Ausscheiden aus der Erbengemeinschaft (§ 1851 Nummer 1, 3)";
    label en unofficial "the custodian requires approval to disclaim/waive, or to dispose of the estate share/leave the community of heirs (§ 1851 no. 1, 3)";
    when gesetzlicher_vertreter(b, betreuter) and (ausschlagung_erbschaft_vermaechtnis_oder_verzicht(b, betreuter) or verfuegung_ueber_erbteil_oder_ausscheiden_aus_erbengemeinschaft(b, betreuter));
    then genehmigung_1851_erforderlich(b, betreuter);
}

// § 1852: Genehmigung für handels- und gesellschaftsrechtliche Rechtsgeschäfte
// — geschlossener Katalog von drei Nummern.

pub relation erwerb_oder_veraeusserung_von_erwerbsgeschaeft_oder_gesellschaftsanteil(b: Person, betreuter: Person) kind empirical {
    label de official "Erwerb oder Veräußerung eines Erwerbsgeschäfts oder eines Anteils an einer Personen- oder Kapitalgesellschaft, die ein Erwerbsgeschäft betreibt (§ 1852 Nummer 1)";
    label en unofficial "acquisition or disposal of a business venture or of a share in a partnership or corporation operating a business venture (§ 1852 no. 1)";
}
pub relation gesellschaftsvertrag_zum_betrieb_eines_erwerbsgeschaefts(b: Person, betreuter: Person) kind empirical {
    label de official "Gesellschaftsvertrag, der zum Betrieb eines Erwerbsgeschäfts eingegangen wird (§ 1852 Nummer 2)";
    label en unofficial "articles of association entered into to operate a business venture (§ 1852 no. 2)";
}
pub relation erteilung_einer_prokura(b: Person, betreuter: Person) kind empirical {
    label de official "Erteilung einer Prokura (§ 1852 Nummer 3)";
    label en unofficial "granting of a commercial power of attorney (Prokura) (§ 1852 no. 3)";
}
pub relation genehmigung_1852_erforderlich(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer bedarf der Genehmigung des Betreuungsgerichts für das handels-/gesellschaftsrechtliche Rechtsgeschäft (§ 1852)";
    label en unofficial "the custodian requires the custody court's approval for the commercial-/company-law transaction (§ 1852)";
}
@source(BGB_P1852)
rule Genehmigung1852Erforderlich(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer bedarf der Genehmigung zum Erwerb/zur Veräußerung eines Erwerbsgeschäfts oder Gesellschaftsanteils, zu einem Gesellschaftsvertrag zum Betrieb eines Erwerbsgeschäfts oder zur Erteilung einer Prokura (§ 1852 Nummer 1–3)";
    label en unofficial "the custodian requires approval to acquire/dispose of a business venture or company share, to enter a company agreement to operate a business venture, or to grant a Prokura (§ 1852 no. 1–3)";
    when gesetzlicher_vertreter(b, betreuter) and (erwerb_oder_veraeusserung_von_erwerbsgeschaeft_oder_gesellschaftsanteil(b, betreuter) or gesellschaftsvertrag_zum_betrieb_eines_erwerbsgeschaefts(b, betreuter) or erteilung_einer_prokura(b, betreuter));
    then genehmigung_1852_erforderlich(b, betreuter);
}

// § 1853: Genehmigung bei Verträgen über wiederkehrende Leistungen — Nummer 1
// mit Ausnahme (Satz 2: eigene, nachteilsfreie vorzeitige Kündigungsmöglichkeit),
// Nummer 2 ohne Ausnahme.

pub relation vertrag_ueber_wiederkehrende_leistungen_ueber_vier_jahre(b: Person, betreuter: Person) kind empirical {
    label de official "Miet- oder Pachtvertrag oder anderer Vertrag über wiederkehrende Leistungen, der länger als vier Jahre dauern soll (§ 1853 Satz 1 Nummer 1)";
    label en unofficial "lease or other contract for recurring performance intended to last longer than four years (§ 1853 sentence 1 no. 1)";
}
pub relation betreuter_kann_ohne_nachteile_vorzeitig_kuendigen(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreute kann das Vertragsverhältnis ohne eigene Nachteile vorzeitig kündigen (§ 1853 Satz 2)";
    label en unofficial "the represented person can terminate the contractual relationship early without their own detriment (§ 1853 sentence 2)";
}
pub relation pachtvertrag_gewerblich_oder_land_forstwirtschaftlich(b: Person, betreuter: Person) kind empirical {
    label de official "Pachtvertrag über einen gewerblichen oder land- oder forstwirtschaftlichen Betrieb (§ 1853 Satz 1 Nummer 2)";
    label en unofficial "lease of a commercial, agricultural or forestry enterprise (§ 1853 sentence 1 no. 2)";
}
pub relation genehmigung_1853_erforderlich(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer bedarf der Genehmigung des Betreuungsgerichts für den Vertrag über wiederkehrende Leistungen (§ 1853)";
    label en unofficial "the custodian requires the custody court's approval for the contract for recurring performance (§ 1853)";
}
@source(BGB_P1853)
rule Genehmigung1853Nr1MitAusnahme(b: Person, betreuter: Person) strict {
    label de official "Bei einem länger als vier Jahre dauernden Vertrag über wiederkehrende Leistungen bedarf der Betreuer der Genehmigung, es sei denn, der Betreute kann ohne eigene Nachteile vorzeitig kündigen (§ 1853 Satz 1 Nummer 1, Satz 2)";
    label en unofficial "for a contract for recurring performance intended to last longer than four years the custodian requires approval, unless the represented person can terminate early without detriment (§ 1853 sentence 1 no. 1, sentence 2)";
    when gesetzlicher_vertreter(b, betreuter) and vertrag_ueber_wiederkehrende_leistungen_ueber_vier_jahre(b, betreuter) and not_known(betreuter_kann_ohne_nachteile_vorzeitig_kuendigen(b, betreuter));
    then genehmigung_1853_erforderlich(b, betreuter);
}
@source(BGB_P1853)
rule Genehmigung1853Nr2(b: Person, betreuter: Person) strict {
    label de official "Für einen Pachtvertrag über einen gewerblichen oder land- oder forstwirtschaftlichen Betrieb bedarf der Betreuer der Genehmigung (§ 1853 Satz 1 Nummer 2)";
    label en unofficial "for a lease of a commercial, agricultural or forestry enterprise the custodian requires approval (§ 1853 sentence 1 no. 2)";
    when gesetzlicher_vertreter(b, betreuter) and pachtvertrag_gewerblich_oder_land_forstwirtschaftlich(b, betreuter);
    then genehmigung_1853_erforderlich(b, betreuter);
}

// § 1854: Genehmigung für sonstige Rechtsgeschäfte — Nummer 6 mit Euro-Schwelle, Nummer 8 Schenkungsverbot.

pub relation vergleich_oder_schiedsvereinbarung(b: Person, betreuter: Person, streitwert: Money) kind empirical {
    label de official "Vergleich oder auf ein Schiedsverfahren gerichtete Vereinbarung (§ 1854 Nummer 6)";
    label en unofficial "settlement or agreement directed at arbitration proceedings (§ 1854 no. 6)";
}
pub relation vergleich_entspricht_gerichtlichem_vorschlag(b: Person, betreuter: Person, streitwert: Money) kind empirical {
    label de official "Der Vergleich entspricht einem schriftlichen oder protokollierten gerichtlichen Vergleichsvorschlag (§ 1854 Nummer 6 Halbsatz 2)";
    label en unofficial "the settlement matches a written or recorded judicial settlement proposal (§ 1854 no. 6 second half-sentence)";
}
pub relation genehmigung_1854_vergleich_erforderlich(b: Person, betreuter: Person, streitwert: Money) kind institutional {
    label de official "Der Betreuer bedarf der Genehmigung des Betreuungsgerichts zum Vergleich oder zur Schiedsvereinbarung (§ 1854 Nummer 6)";
    label en unofficial "the custodian requires the custody court's approval for the settlement or arbitration agreement (§ 1854 no. 6)";
}
@source(BGB_P1854)
rule Genehmigung1854VergleichErforderlich(b: Person, betreuter: Person, streitwert: Money) strict {
    label de official "Der Betreuer bedarf der Genehmigung zu einem Vergleich oder einer Schiedsvereinbarung, es sei denn, der Streitgegenstand ist in Geld schätzbar und übersteigt nicht 6 000 Euro oder der Vergleich entspricht einem gerichtlichen Vergleichsvorschlag (§ 1854 Nummer 6)";
    label en unofficial "the custodian requires approval for a settlement or arbitration agreement, unless the amount in dispute is monetarily assessable and does not exceed EUR 6,000, or the settlement matches a judicial settlement proposal (§ 1854 no. 6)";
    when gesetzlicher_vertreter(b, betreuter) and vergleich_oder_schiedsvereinbarung(b, betreuter, streitwert)
        and streitwert > 6000.00 EUR
        and not_known(vergleich_entspricht_gerichtlichem_vorschlag(b, betreuter, streitwert));
    then genehmigung_1854_vergleich_erforderlich(b, betreuter, streitwert);
}
pub relation schenkung_oder_unentgeltliche_zuwendung(b: Person, betreuter: Person) kind empirical {
    label de official "Schenkung oder unentgeltliche Zuwendung durch den Betreuer im Namen des Betreuten (§ 1854 Nummer 8)";
    label en unofficial "gift or gratuitous disposition made by the custodian in the represented person's name (§ 1854 no. 8)";
}
pub relation angemessen_nach_lebensverhaeltnissen_oder_gelegenheitsgeschenk(b: Person, betreuter: Person) kind empirical {
    label de official "Die Zuwendung ist nach den Lebensverhältnissen des Betreuten angemessen oder als Gelegenheitsgeschenk üblich (§ 1854 Nummer 8 Halbsatz 2)";
    label en unofficial "the disposition is reasonable given the represented person's circumstances or customary as an occasional gift (§ 1854 no. 8 second half-sentence)";
}
pub relation genehmigung_1854_schenkung_erforderlich(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer bedarf der Genehmigung des Betreuungsgerichts zur Schenkung oder unentgeltlichen Zuwendung (§ 1854 Nummer 8)";
    label en unofficial "the custodian requires the custody court's approval for the gift or gratuitous disposition (§ 1854 no. 8)";
}
@source(BGB_P1854)
rule Genehmigung1854SchenkungErforderlich(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer bedarf der Genehmigung zu einer Schenkung oder unentgeltlichen Zuwendung, es sei denn, diese ist angemessen oder als Gelegenheitsgeschenk üblich (§ 1854 Nummer 8)";
    label en unofficial "the custodian requires approval for a gift or gratuitous disposition, unless it is reasonable or customary as an occasional gift (§ 1854 no. 8)";
    when gesetzlicher_vertreter(b, betreuter) and schenkung_oder_unentgeltliche_zuwendung(b, betreuter) and not_known(angemessen_nach_lebensverhaeltnissen_oder_gelegenheitsgeschenk(b, betreuter));
    then genehmigung_1854_schenkung_erforderlich(b, betreuter);
}

// § 1855: Erklärung der Genehmigung — nur dem Betreuer gegenüber wirksam.

pub relation genehmigungserklaerung_gegenueber_betreuer_abgegeben(b: Person, betreuter: Person) kind empirical {
    label de official "Das Betreuungsgericht erklärt die Genehmigung dem Betreuer gegenüber (§ 1855)";
    label en unofficial "the custody court declares the approval to the custodian (§ 1855)";
}
pub relation genehmigungserklaerung_wirksam_1855(b: Person, betreuter: Person) kind institutional {
    label de official "Die Erklärung der Genehmigung ist wirksam (§ 1855)";
    label en unofficial "the declaration of approval is effective (§ 1855)";
}
@source(BGB_P1855)
rule GenehmigungserklaerungWirksamGegenueberBetreuer(b: Person, betreuter: Person) strict {
    label de official "Erklärt das Betreuungsgericht die Genehmigung dem Betreuer gegenüber, ist die Erklärung wirksam (§ 1855)";
    label en unofficial "where the custody court declares the approval to the custodian, the declaration is effective (§ 1855)";
    when gesetzlicher_vertreter(b, betreuter) and genehmigungserklaerung_gegenueber_betreuer_abgegeben(b, betreuter);
    then genehmigungserklaerung_wirksam_1855(b, betreuter);
}
pub relation genehmigungserklaerung_gegenueber_dritten_abgegeben(b: Person, betreuter: Person, dritter: Person) kind empirical {
    label de official "Das Betreuungsgericht erklärt die Genehmigung einem Dritten, nicht dem Betreuer gegenüber (§ 1855)";
    label en unofficial "the custody court declares the approval to a third party rather than the custodian (§ 1855)";
}
pub relation genehmigungserklaerung_unwirksam_1855(b: Person, betreuter: Person, dritter: Person) kind institutional {
    label de official "Die Genehmigung kann nur dem Betreuer gegenüber erklärt werden; die Erklärung gegenüber dem Dritten ist unwirksam (§ 1855)";
    label en unofficial "approval can only be declared to the custodian; a declaration to the third party is not effective (§ 1855)";
}
@source(BGB_P1855)
rule GenehmigungserklaerungUnwirksamGegenueberDritten(b: Person, betreuter: Person, dritter: Person) strict {
    label de official "Erklärt das Betreuungsgericht die Genehmigung einem Dritten statt dem Betreuer, ist die Erklärung unwirksam, weil sie nur dem Betreuer gegenüber erklärt werden kann (§ 1855)";
    label en unofficial "where the custody court declares the approval to a third party instead of the custodian, the declaration is ineffective because approval can only be declared to the custodian (§ 1855)";
    when gesetzlicher_vertreter(b, betreuter) and genehmigungserklaerung_gegenueber_dritten_abgegeben(b, betreuter, dritter);
    then genehmigungserklaerung_unwirksam_1855(b, betreuter, dritter);
}

// § 1856: Nachträgliche Genehmigung — die Zwei-Monats-Frist der Mitteilung.

pub relation vertrag_ohne_erforderliche_genehmigung_geschlossen(b: Person, betreuter: Person, andererteil: Person) kind empirical {
    label de official "Der Betreuer schließt einen Vertrag ohne die erforderliche Genehmigung des Betreuungsgerichts (§ 1856 Absatz 1 Satz 1)";
    label en unofficial "the custodian concludes a contract without the required approval of the custody court (§ 1856 (1) sentence 1)";
}
pub relation wirksamkeit_haengt_von_nachtraeglicher_genehmigung_ab(b: Person, betreuter: Person, andererteil: Person) kind institutional {
    label de official "Die Wirksamkeit des Vertrags hängt von der nachträglichen Genehmigung des Betreuungsgerichts ab (§ 1856 Absatz 1 Satz 1)";
    label en unofficial "the contract's effectiveness depends on the custody court's subsequent approval (§ 1856 (1) sentence 1)";
}
@source(BGB_P1856)
rule WirksamkeitHaengtVonNachtraeglicherGenehmigungAb(b: Person, betreuter: Person, andererteil: Person) strict {
    label de official "Schließt der Betreuer einen Vertrag ohne die erforderliche Genehmigung, hängt dessen Wirksamkeit von der nachträglichen Genehmigung ab (§ 1856 Absatz 1 Satz 1)";
    label en unofficial "where the custodian concludes a contract without the required approval, its effectiveness depends on subsequent approval (§ 1856 (1) sentence 1)";
    when vertrag_ohne_erforderliche_genehmigung_geschlossen(b, betreuter, andererteil);
    then wirksamkeit_haengt_von_nachtraeglicher_genehmigung_ab(b, betreuter, andererteil);
}

pub relation aufforderung_zur_mitteilung_der_genehmigung(f: Frist) kind empirical {
    key(f);
    label de official "Frist, binnen deren nach Aufforderung des anderen Teils die Mitteilung der Genehmigung erfolgen kann: bis zum Ablauf des zweiten Monats nach Empfang der Aufforderung (§ 1856 Absatz 2 Satz 1)";
    label en unofficial "period within which, following the other party's request, notice of the approval may be given: until the end of the second month after receipt of the request (§ 1856 (2) sentence 1)";
}
pub relation aufforderung_empfangen_am(f: Frist, tag: Date) kind empirical {
    key(f);
    label de official "Tag des Empfangs der Aufforderung des anderen Teils zur Mitteilung, ob die Genehmigung erteilt sei (§ 1856 Absatz 2 Satz 1)";
    label en unofficial "day the other party's request for notice on whether approval was given was received (§ 1856 (2) sentence 1)";
}
@source(BGB_P1856) {
    rule MitteilungsfristEreignis(f: Frist, t: Date) strict {
        label de official "Die Frist beginnt mit dem Empfang der Aufforderung (§ 1856 Absatz 2 Satz 1)";
        label en unofficial "the period begins on receipt of the request (§ 1856 (2) sentence 1)";
        when aufforderung_zur_mitteilung_der_genehmigung(f) and aufforderung_empfangen_am(f, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
    rule MitteilungsfristDauer(f: Frist) strict {
        label de official "Die Mitteilung der Genehmigung kann nur bis zum Ablauf des zweiten Monats nach Empfang der Aufforderung erfolgen (§ 1856 Absatz 2 Satz 1)";
        label en unofficial "notice of approval may only be given until the end of the second month after receipt of the request (§ 1856 (2) sentence 1)";
        when aufforderung_zur_mitteilung_der_genehmigung(f);
        then de.bgb.fristen::frist_dauer_kalender(f, 2 calendar_month);
    }
}
pub relation genehmigung_gilt_als_verweigert(b: Person, betreuter: Person, andererteil: Person, f: Frist) kind institutional {
    label de official "Wird die Genehmigung nicht binnen der Frist mitgeteilt, gilt sie als verweigert (§ 1856 Absatz 2 Satz 1 Halbsatz 2)";
    label en unofficial "if approval is not communicated within the period, it is deemed refused (§ 1856 (2) sentence 1 second half-sentence)";
}
@source(BGB_P1856)
rule GenehmigungGiltAlsVerweigertNachFristablauf(b: Person, betreuter: Person, andererteil: Person, f: Frist, e: Date) strict {
    label de official "Wird die Genehmigung nicht mitgeteilt, so gilt sie nach Ablauf des zweiten Monats nach Empfang der Aufforderung als verweigert (§ 1856 Absatz 2 Satz 1 Halbsatz 2)";
    label en unofficial "if the approval is not communicated, it is deemed refused after the end of the second month following receipt of the request (§ 1856 (2) sentence 1 second half-sentence)";
    when vertrag_betrifft_frist_1856(f, b, betreuter, andererteil) and de.bgb.fristen::frist_ende(f, e) and not_known(genehmigung_mitgeteilt_bis(f, e));
    then genehmigung_gilt_als_verweigert(b, betreuter, andererteil, f);
}
pub relation vertrag_betrifft_frist_1856(f: Frist, b: Person, betreuter: Person, andererteil: Person) kind empirical {
    key(f);
    label de official "Die Mitteilungsfrist nach § 1856 Absatz 2 betrifft diesen Vertrag";
    label en unofficial "the notice period under § 1856 (2) concerns this contract";
}
pub relation genehmigung_mitgeteilt_bis(f: Frist, tag: Date) kind empirical {
    label de official "Mitteilung der Genehmigung durch den Betreuer, eingegangen bis zu diesem Tag (§ 1856 Absatz 2 Satz 1)";
    label en unofficial "notice of the approval by the custodian, received by this day (§ 1856 (2) sentence 1)";
}

// § 1857: Widerrufsrecht des Vertragspartners — Ausnahme, wenn der andere
// Teil das Fehlen der Genehmigung bei Vertragsschluss kannte.

pub relation betreuer_behauptet_wahrheitswidrig_genehmigung(b: Person, betreuter: Person, andererteil: Person) kind empirical {
    label de official "Der Betreuer behauptet dem anderen Teil gegenüber wahrheitswidrig die Genehmigung des Betreuungsgerichts (§ 1857)";
    label en unofficial "the custodian falsely claims to the other party that the custody court's approval was given (§ 1857)";
}
pub relation andererteil_kannte_fehlende_genehmigung_bei_abschluss(b: Person, betreuter: Person, andererteil: Person) kind empirical {
    label de official "Dem anderen Teil war das Fehlen der Genehmigung bei Abschluss des Vertrags bekannt (§ 1857)";
    label en unofficial "the other party knew of the lack of approval when the contract was concluded (§ 1857)";
}
pub relation widerrufsrecht_1857(b: Person, betreuter: Person, andererteil: Person) kind institutional {
    label de official "Der andere Teil ist bis zur Mitteilung der nachträglichen Genehmigung zum Widerruf berechtigt (§ 1857)";
    label en unofficial "the other party is entitled to revoke until notice of the subsequent approval (§ 1857)";
}
@source(BGB_P1857)
rule Widerrufsrecht1857(b: Person, betreuter: Person, andererteil: Person) strict {
    label de official "Behauptet der Betreuer wahrheitswidrig die Genehmigung, ist der andere Teil zum Widerruf berechtigt, es sei denn, ihm war das Fehlen der Genehmigung bei Abschluss bekannt (§ 1857)";
    label en unofficial "where the custodian falsely claims approval, the other party may revoke unless they knew of its absence at conclusion (§ 1857)";
    when gesetzlicher_vertreter(b, betreuter) and betreuer_behauptet_wahrheitswidrig_genehmigung(b, betreuter, andererteil) and not_known(andererteil_kannte_fehlende_genehmigung_bei_abschluss(b, betreuter, andererteil));
    then widerrufsrecht_1857(b, betreuter, andererteil);
}

// § 1858: Einseitiges Rechtsgeschäft — Absatz 1 (ohne Genehmigung unwirksam),
// Absatz 2 (mit Genehmigung, aber nicht vorgelegt und unverzüglich
// zurückgewiesen — ebenfalls unwirksam). Absatz 3 (gegenüber Gericht/Behörde,
// Schwebezustand mit Fristenhemmung) bleibt SOURCE_ONLY dieser Sitzung.

pub relation einseitiges_rechtsgeschaeft_ohne_erforderliche_genehmigung(b: Person, betreuter: Person, empfaenger: Person) kind empirical {
    label de official "Der Betreuer nimmt ein einseitiges Rechtsgeschäft ohne die erforderliche Genehmigung des Betreuungsgerichts vor (§ 1858 Absatz 1)";
    label en unofficial "the custodian performs a unilateral juristic act without the custody court's required approval (§ 1858 (1))";
}
pub relation einseitiges_rechtsgeschaeft_unwirksam_1858(b: Person, betreuter: Person, empfaenger: Person) kind institutional {
    label de official "Das einseitige Rechtsgeschäft ist unwirksam (§ 1858)";
    label en unofficial "the unilateral juristic act is ineffective (§ 1858)";
}
@source(BGB_P1858)
rule EinseitigesRechtsgeschaeftUnwirksamOhneGenehmigung(b: Person, betreuter: Person, empfaenger: Person) strict {
    label de official "Ein einseitiges Rechtsgeschäft ohne die erforderliche Genehmigung des Betreuungsgerichts ist unwirksam (§ 1858 Absatz 1)";
    label en unofficial "a unilateral juristic act without the required approval of the custody court is ineffective (§ 1858 (1))";
    when gesetzlicher_vertreter(b, betreuter) and einseitiges_rechtsgeschaeft_ohne_erforderliche_genehmigung(b, betreuter, empfaenger);
    then einseitiges_rechtsgeschaeft_unwirksam_1858(b, betreuter, empfaenger);
}
pub relation genehmigung_nicht_vorgelegt_und_unverzueglich_zurueckgewiesen(b: Person, betreuter: Person, empfaenger: Person) kind empirical {
    label de official "Der Betreuer legt die Genehmigung nicht vor, und der andere weist das Rechtsgeschäft deshalb unverzüglich zurück (§ 1858 Absatz 2)";
    label en unofficial "the custodian does not produce the approval, and the other party rejects the act without delay for that reason (§ 1858 (2))";
}
@source(BGB_P1858)
rule EinseitigesRechtsgeschaeftUnwirksamOhneVorlage(b: Person, betreuter: Person, empfaenger: Person) strict {
    label de official "Legt der Betreuer trotz erteilter Genehmigung diese nicht vor und weist der andere das Rechtsgeschäft deshalb unverzüglich zurück, ist es unwirksam (§ 1858 Absatz 2)";
    label en unofficial "where the custodian, despite having approval, does not produce it and the other party rejects the act without delay for that reason, it is ineffective (§ 1858 (2))";
    when gesetzlicher_vertreter(b, betreuter) and genehmigung_nicht_vorgelegt_und_unverzueglich_zurueckgewiesen(b, betreuter, empfaenger);
    then einseitiges_rechtsgeschaeft_unwirksam_1858(b, betreuter, empfaenger);
}

// § 1859: Gesetzliche Befreiungen — Absatz 2 Satz 1 als geschlossener Katalog
// von fünf Ziffern (Regel je Nummer über "or", Muster Block 2); Absatz 1
// Nummer 1, 3 und Satz 2 als Folgen; Absatz 3 über die im Paket bereits
// vorhandene Gefährdungs-Relation des § 1821 Absatz 3 Nummer 1.

pub relation verwandter_gerader_linie(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer ist Verwandter des Betreuten in gerader Linie (§ 1859 Absatz 2 Satz 1 Nummer 1)";
    label en unofficial "the custodian is the represented person's relative in the direct line (§ 1859 (2) sentence 1 no. 1)";
}
pub relation geschwister_des_betreuten(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer ist Geschwister des Betreuten (§ 1859 Absatz 2 Satz 1 Nummer 2)";
    label en unofficial "the custodian is the represented person's sibling (§ 1859 (2) sentence 1 no. 2)";
}
pub relation ehegatte_des_betreuten(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer ist Ehegatte des Betreuten (§ 1859 Absatz 2 Satz 1 Nummer 3)";
    label en unofficial "the custodian is the represented person's spouse (§ 1859 (2) sentence 1 no. 3)";
}
pub relation betreuungsverein_oder_vereinsbetreuer(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer ist Betreuungsverein oder Vereinsbetreuer (§ 1859 Absatz 2 Satz 1 Nummer 4)";
    label en unofficial "the custodian is a custodianship association or association custodian (§ 1859 (2) sentence 1 no. 4)";
}
pub relation betreuungsbehoerde_oder_behoerdenbetreuer(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer ist Betreuungsbehörde oder Behördenbetreuer (§ 1859 Absatz 2 Satz 1 Nummer 5)";
    label en unofficial "the custodian is a custodianship authority or authority custodian (§ 1859 (2) sentence 1 no. 5)";
}
pub relation ist_befreiter_betreuer_kraft_gesetzes(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer ist kraft Gesetzes befreiter Betreuer (§ 1859 Absatz 2 Satz 1)";
    label en unofficial "the custodian is an exempted custodian by operation of law (§ 1859 (2) sentence 1)";
}
@source(BGB_P1859)
rule BefreiterBetreuerKraftGesetzes(b: Person, betreuter: Person) strict {
    label de official "Verwandte in gerader Linie, Geschwister, Ehegatten, der Betreuungsverein/-betreuer und die Betreuungsbehörde/der Behördenbetreuer sind kraft Gesetzes befreite Betreuer (§ 1859 Absatz 2 Satz 1 Nummer 1–5)";
    label en unofficial "relatives in the direct line, siblings, spouses, the custodianship association/custodian and the custodianship authority/custodian are exempted custodians by operation of law (§ 1859 (2) sentence 1 no. 1–5)";
    when gesetzlicher_vertreter(b, betreuter) and (
        verwandter_gerader_linie(b, betreuter)
        or geschwister_des_betreuten(b, betreuter)
        or ehegatte_des_betreuten(b, betreuter)
        or betreuungsverein_oder_vereinsbetreuer(b, betreuter)
        or betreuungsbehoerde_oder_behoerdenbetreuer(b, betreuter)
    );
    then ist_befreiter_betreuer_kraft_gesetzes(b, betreuter);
}
pub relation von_sperrvereinbarungspflicht_entbunden_1859(b: Person, betreuter: Person) kind institutional {
    label de official "Der befreite Betreuer ist von der Pflicht zur Sperrvereinbarung nach § 1845 entbunden (§ 1859 Absatz 1 Satz 1 Nummer 1)";
    label en unofficial "the exempted custodian is relieved of the duty to conclude a blocking agreement under § 1845 (§ 1859 (1) sentence 1 no. 1)";
}
pub relation von_rechnungslegungspflicht_entbunden_1859(b: Person, betreuter: Person) kind institutional {
    label de official "Der befreite Betreuer ist von der Pflicht zur Rechnungslegung nach § 1865 entbunden (§ 1859 Absatz 1 Satz 1 Nummer 3)";
    label en unofficial "the exempted custodian is relieved of the duty to render accounts under § 1865 (§ 1859 (1) sentence 1 no. 3)";
}
pub relation vermoegensuebersicht_jaehrlich_einzureichen_pflicht(b: Person, betreuter: Person) kind institutional {
    label de official "Der befreite Betreuer hat dem Betreuungsgericht jährlich eine Vermögensübersicht einzureichen (§ 1859 Absatz 1 Satz 2)";
    label en unofficial "the exempted custodian must submit an annual survey of assets to the custody court (§ 1859 (1) sentence 2)";
}
@source(BGB_P1859)
rule VonSperrvereinbarungspflichtEntbunden1859(b: Person, betreuter: Person) strict {
    label de official "Ein befreiter Betreuer ist von der Sperrvereinbarung nach § 1845 entbunden (§ 1859 Absatz 1 Satz 1 Nummer 1)";
    label en unofficial "an exempted custodian is relieved of the blocking agreement duty under § 1845 (§ 1859 (1) sentence 1 no. 1)";
    when ist_befreiter_betreuer_kraft_gesetzes(b, betreuter);
    then von_sperrvereinbarungspflicht_entbunden_1859(b, betreuter);
}
@source(BGB_P1859)
rule VonRechnungslegungspflichtEntbunden1859(b: Person, betreuter: Person) strict {
    label de official "Ein befreiter Betreuer ist von der Rechnungslegung nach § 1865 entbunden (§ 1859 Absatz 1 Satz 1 Nummer 3)";
    label en unofficial "an exempted custodian is relieved of the accounting duty under § 1865 (§ 1859 (1) sentence 1 no. 3)";
    when ist_befreiter_betreuer_kraft_gesetzes(b, betreuter);
    then von_rechnungslegungspflicht_entbunden_1859(b, betreuter);
}
@source(BGB_P1859)
rule VermoegensuebersichtPflicht1859(b: Person, betreuter: Person) strict {
    label de official "Ein befreiter Betreuer hat dem Betreuungsgericht jährlich eine Vermögensübersicht einzureichen (§ 1859 Absatz 1 Satz 2)";
    label en unofficial "an exempted custodian must submit an annual asset survey to the custody court (§ 1859 (1) sentence 2)";
    when ist_befreiter_betreuer_kraft_gesetzes(b, betreuter);
    then vermoegensuebersicht_jaehrlich_einzureichen_pflicht(b, betreuter);
}
pub relation befreiung_1859_aufzuheben(b: Person, betreuter: Person) kind institutional {
    label de official "Das Betreuungsgericht hat die Befreiung aufzuheben (§ 1859 Absatz 3)";
    label en unofficial "the custody court must revoke the exemption (§ 1859 (3))";
}
@source(BGB_P1859)
rule Befreiung1859AufzuhebenBeiGefaehrdung(b: Person, betreuter: Person) strict {
    label de official "Bei Fortgeltung der Befreiung droht eine Gefährdung im Sinne des § 1821 Absatz 3 Nummer 1 — das Betreuungsgericht hat die Befreiung aufzuheben (§ 1859 Absatz 3)";
    label en unofficial "where continuing the exemption would risk endangerment under § 1821 (3) no. 1, the custody court must revoke it (§ 1859 (3))";
    when ist_befreiter_betreuer_kraft_gesetzes(b, betreuter) and gefaehrdung_1821_abs3_nr1_liegt_vor(betreuter);
    then befreiung_1859_aufzuheben(b, betreuter);
}

// § 1860: Befreiungen auf Anordnung des Gerichts — Absatz 1 (Vermögenswert
// bis 6 000 Euro ohne Immobilien/Verbindlichkeiten) und Absatz 4 (keine
// Gefährdung im Sinne des § 1821 Absatz 3 Nummer 1 als Voraussetzung jeder
// Befreiung der Absätze 1–3).

pub relation antrag_auf_befreiung_1860abs1(b: Person, betreuter: Person) kind empirical {
    label de official "Antrag des Betreuers auf Befreiung von den Beschränkungen nach §§ 1841, 1845, 1848, 1849 Absatz 1 Satz 1 Nummer 1, 2, Satz 2 (§ 1860 Absatz 1)";
    label en unofficial "the custodian's application for exemption from the restrictions under §§ 1841, 1845, 1848, 1849 (1) sentence 1 no. 1, 2, sentence 2 (§ 1860 (1))";
}
pub relation vermoegenswert_ohne_immobilien_und_verbindlichkeiten(b: Person, betreuter: Person, vermoegenswert: Money) kind empirical {
    label de official "Wert des Vermögens des Betreuten ohne Berücksichtigung von Immobilien und Verbindlichkeiten (§ 1860 Absatz 1)";
    label en unofficial "value of the represented person's assets disregarding real property and liabilities (§ 1860 (1))";
}
pub relation befreiung_1860abs1_moeglich(b: Person, betreuter: Person, vermoegenswert: Money) kind institutional {
    label de official "Das Betreuungsgericht kann den Betreuer ganz oder teilweise befreien (§ 1860 Absatz 1)";
    label en unofficial "the custody court may exempt the custodian wholly or in part (§ 1860 (1))";
}
@source(BGB_P1860)
rule Befreiung1860Abs1BisSechstausendEuro(b: Person, betreuter: Person, vermoegenswert: Money) strict {
    label de official "Übersteigt der Vermögenswert des Betreuten ohne Immobilien und Verbindlichkeiten 6 000 Euro nicht und liegt keine Gefährdung im Sinne des § 1821 Absatz 3 Nummer 1 vor, kann das Betreuungsgericht auf Antrag befreien (§ 1860 Absatz 1, Absatz 4)";
    label en unofficial "where the represented person's assets, excluding real property and liabilities, do not exceed EUR 6,000 and there is no endangerment under § 1821 (3) no. 1, the custody court may on application grant exemption (§ 1860 (1), (4))";
    when gesetzlicher_vertreter(b, betreuter) and antrag_auf_befreiung_1860abs1(b, betreuter)
        and vermoegenswert_ohne_immobilien_und_verbindlichkeiten(b, betreuter, vermoegenswert)
        and vermoegenswert <= 6000.00 EUR
        and not_known(gefaehrdung_1821_abs3_nr1_liegt_vor(betreuter));
    then befreiung_1860abs1_moeglich(b, betreuter, vermoegenswert);
}
