// BÜRGERLICHES GESETZBUCH, BUCH 4 ABSCHNITT 3 TITEL 3 — RECHTLICHE BETREUUNG
// (§§ 1814–1834: Voraussetzungen, Umfang, Auswahl, Vertretung, Ausschluss,
// Einwilligungsvorbehalt, Haftung, Patientenverfügung, Sterilisation,
// Unterbringung, ärztliche Zwangsmaßnahme, Wohnraum, Umgang/Aufenthalt).
//
// Dies ist der bewertende Kern des Pakets: fast jeder Maßstab ist eine
// Wertung des Gerichts (Kanal §47.3, DECISION-0194) oder eine festgestellte
// Tatsache (`origin adjudicated`). Ein flacher Fall-Fakt „ist
// betreuungsbedürftig“ ist verboten.

language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";

// § 1814: Voraussetzungen der Betreuerbestellung.

pub relation krankheit_oder_behinderung(volljaehriger: Person) kind empirical {
    label de official "Krankheit oder Behinderung, auf der die rechtliche Unfähigkeit beruht, die Angelegenheiten ganz oder teilweise zu besorgen (§ 1814 Absatz 1) — festgestellte Tatsache, im Fall origin adjudicated";
    label en unofficial "illness or disability on which the legal inability to attend to one's affairs, wholly or in part, is based (§ 1814 (1)) — established fact, in the case origin adjudicated";
}
pub relation kann_angelegenheiten_rechtlich_nicht_besorgen(volljaehriger: Person) kind empirical {
    label de official "Der Volljährige kann seine Angelegenheiten ganz oder teilweise rechtlich nicht besorgen (§ 1814 Absatz 1)";
    label en unofficial "the adult cannot attend to their affairs, wholly or in part, in law (§ 1814 (1))";
}
pub relation voraussetzungen_der_betreuerbestellung_1814(volljaehriger: Person) kind institutional {
    label de official "Voraussetzungen des § 1814 Absatz 1 erfüllt: das Betreuungsgericht bestellt einen rechtlichen Betreuer";
    label en unofficial "the requirements of § 1814 (1) are met: the custody court appoints a legal custodian";
}
@source(BGB_P1814)
rule Voraussetzungen1814(volljaehriger: Person) strict {
    label de official "Kann ein Volljähriger seine Angelegenheiten ganz oder teilweise rechtlich nicht besorgen und beruht dies auf Krankheit oder Behinderung, bestellt das Betreuungsgericht einen Betreuer (§ 1814 Absatz 1)";
    label en unofficial "if an adult cannot attend to their affairs, wholly or in part, in law and this is due to illness or disability, the custody court appoints a custodian (§ 1814 (1))";
    when kann_angelegenheiten_rechtlich_nicht_besorgen(volljaehriger) and krankheit_oder_behinderung(volljaehriger);
    then voraussetzungen_der_betreuerbestellung_1814(volljaehriger);
}

@source(BGB_P1814)
pub external judgment relation gegen_freien_willen_bestellt(volljaehriger: Person) {
    authority Court;
    label de official "Der Betreuer würde gegen den freien Willen des Volljährigen bestellt (§ 1814 Absatz 2)";
    label en unofficial "the custodian would be appointed against the adult's free will (§ 1814 (2))";
}
pub relation betreuerbestellung_unzulaessig_gegen_freien_willen(volljaehriger: Person) kind institutional {
    label de official "Die Bestellung eines Betreuers ist unzulässig, weil sie gegen den freien Willen des Volljährigen erfolgen würde (§ 1814 Absatz 2)";
    label en unofficial "appointing a custodian is impermissible because it would be against the adult's free will (§ 1814 (2))";
}
@source(BGB_P1814)
rule BetreuerbestellungUnzulaessigGegenFreienWillen(volljaehriger: Person) strict {
    label de official "Gegen den freien Willen des Volljährigen darf ein Betreuer nicht bestellt werden (§ 1814 Absatz 2)";
    label en unofficial "a custodian may not be appointed against the adult's free will (§ 1814 (2))";
    when gegen_freien_willen_bestellt(volljaehriger);
    then betreuerbestellung_unzulaessig_gegen_freien_willen(volljaehriger);
}

@source(BGB_P1814)
pub external judgment relation betreuerbestellung_erforderlich(volljaehriger: Person) {
    authority Court;
    label de official "Die Bestellung eines Betreuers ist erforderlich; insbesondere nicht erforderlich, soweit ein Bevollmächtigter oder andere Hilfen ohne gesetzlichen Vertreter die Angelegenheiten gleichermaßen besorgen können (§ 1814 Absatz 3)";
    label en unofficial "appointing a custodian is necessary; in particular not necessary where an agent or other assistance without a statutory representative can equally attend to the affairs (§ 1814 (3))";
}
pub relation bevollmaechtigter_besorgt_gleichermassen(volljaehriger: Person, bevollmaechtigter: Person) kind empirical {
    label de official "Ein Bevollmächtigter, der nicht zu den in § 1816 Absatz 6 bezeichneten Personen gehört, kann die Angelegenheiten gleichermaßen besorgen (§ 1814 Absatz 3 Satz 2 Nummer 1)";
    label en unofficial "an agent not among the persons described in § 1816 (6) can equally attend to the affairs (§ 1814 (3) sentence 2 no. 1)";
}
pub relation andere_hilfe_ohne_vertreter_ausreichend(volljaehriger: Person) kind empirical {
    label de official "Andere Hilfen, bei denen kein gesetzlicher Vertreter bestellt wird, insbesondere sozialrechtliche Unterstützung, reichen aus (§ 1814 Absatz 3 Satz 2 Nummer 2)";
    label en unofficial "other assistance not requiring a statutory representative, in particular support based on social-law entitlements, suffices (§ 1814 (3) sentence 2 no. 2)";
}
pub relation antrag_des_volljaehrigen_auf_betreuerbestellung(volljaehriger: Person) kind empirical {
    label de official "Antrag des Volljährigen auf Bestellung eines Betreuers (§ 1814 Absatz 4 Satz 1)";
    label en unofficial "the adult's application for the appointment of a custodian (§ 1814 (4) sentence 1)";
}
pub relation nur_koerperliche_krankheit_oder_behinderung(volljaehriger: Person) kind empirical {
    label de official "Der Volljährige kann seine Angelegenheiten lediglich aufgrund einer körperlichen Krankheit oder Behinderung nicht besorgen (§ 1814 Absatz 4 Satz 2)";
    label en unofficial "the adult cannot attend to their affairs solely due to a physical illness or disability (§ 1814 (4) sentence 2)";
}
pub relation kann_willen_nicht_kundtun(volljaehriger: Person) kind empirical {
    label de official "Der Volljährige kann seinen Willen nicht kundtun (§ 1814 Absatz 4 Satz 2 Halbsatz 2)";
    label en unofficial "the adult cannot communicate their will (§ 1814 (4) sentence 2 second half-sentence)";
}
pub relation betreuerbestellung_ohne_antrag_unzulaessig(volljaehriger: Person) kind institutional {
    label de official "Ohne Antrag des Volljährigen ist die Bestellung unzulässig, weil nur körperliche Krankheit/Behinderung vorliegt und er seinen Willen kundtun kann (§ 1814 Absatz 4 Satz 2)";
    label en unofficial "without the adult's application, appointment is impermissible because only a physical illness/disability exists and they can communicate their will (§ 1814 (4) sentence 2)";
}
@source(BGB_P1814)
rule BetreuerbestellungOhneAntragUnzulaessigBeiKoerperlicherKrankheit(volljaehriger: Person) strict {
    label de official "Soweit der Volljährige seine Angelegenheiten lediglich aufgrund einer körperlichen Krankheit oder Behinderung nicht besorgen kann, darf ein Betreuer nur auf Antrag bestellt werden, es sei denn, er kann seinen Willen nicht kundtun (§ 1814 Absatz 4 Satz 2)";
    label en unofficial "where the adult cannot attend to their affairs solely due to a physical illness or disability, a custodian may be appointed only on application, unless they cannot communicate their will (§ 1814 (4) sentence 2)";
    when nur_koerperliche_krankheit_oder_behinderung(volljaehriger) and not_known(antrag_des_volljaehrigen_auf_betreuerbestellung(volljaehriger)) and not_known(kann_willen_nicht_kundtun(volljaehriger));
    then betreuerbestellung_ohne_antrag_unzulaessig(volljaehriger);
}

pub relation minderjaehriger_ueber_17(minderjaehriger: Person) kind empirical {
    label de official "Der Minderjährige hat das 17. Lebensjahr vollendet (§ 1814 Absatz 5 Satz 1)";
    label en unofficial "the minor has completed the 17th year of life (§ 1814 (5) sentence 1)";
}
@source(BGB_P1814)
pub external judgment relation betreuerbestellung_bei_volljaehrigkeit_erforderlich_sein_wird(minderjaehriger: Person) {
    authority Court;
    label de official "Es ist anzunehmen, dass die Bestellung eines Betreuers bei Eintritt der Volljährigkeit erforderlich sein wird (§ 1814 Absatz 5 Satz 1)";
    label en unofficial "it is to be assumed that appointing a custodian will be necessary upon attaining majority (§ 1814 (5) sentence 1)";
}
pub relation betreuerbestellung_fuer_minderjaehrigen_ab_17_zulaessig(minderjaehriger: Person) kind institutional {
    label de official "Ein Betreuer kann für den Minderjährigen bestellt werden, wirksam erst mit Eintritt der Volljährigkeit (§ 1814 Absatz 5)";
    label en unofficial "a custodian may be appointed for the minor, taking effect only upon attaining majority (§ 1814 (5))";
}
@source(BGB_P1814)
rule BetreuerbestellungFuerMinderjaehrigenAb17(minderjaehriger: Person) strict {
    label de official "Ein Betreuer kann auch für einen Minderjährigen bestellt werden, der das 17. Lebensjahr vollendet hat, wenn anzunehmen ist, dass die Bestellung bei Volljährigkeit erforderlich sein wird; wirksam erst mit Volljährigkeit (§ 1814 Absatz 5)";
    label en unofficial "a custodian may also be appointed for a minor who has completed the 17th year of life if it is assumed appointment will be necessary at majority; effective only upon majority (§ 1814 (5))";
    when minderjaehriger_ueber_17(minderjaehriger) and betreuerbestellung_bei_volljaehrigkeit_erforderlich_sein_wird(minderjaehriger);
    then betreuerbestellung_fuer_minderjaehrigen_ab_17_zulaessig(minderjaehriger);
}

pub relation betreuer_bestellt(b: Person, betreuter: Person) kind empirical {
    label de official "Das Betreuungsgericht hat den Betreuer bestellt (§ 1814) — festgestellte Tatsache, im Fall origin adjudicated";
    label en unofficial "the custody court has appointed the custodian (§ 1814) — established fact, in the case origin adjudicated";
}
@source(BGB_P1814)
rule GesetzlicherVertreterBetreuer(b: Person, betreuter: Person) strict {
    label de official "Mit der Bestellung im Rahmen seines Aufgabenkreises wird der Betreuer gesetzlicher Vertreter des Betreuten (§ 1814, § 1823)";
    label en unofficial "upon appointment, within their assigned scope, the custodian becomes the represented person's statutory representative (§ 1814, § 1823)";
    when betreuer_bestellt(b, betreuter);
    then gesetzlicher_vertreter(b, betreuter);
}

// § 1815: Umfang der Betreuung — Aufgabenbereiche und der Katalog der Absatz 2.

pub enum Aufgabenbereich {
    label de official "Aufgabenbereich, den das Betreuungsgericht ausdrücklich anordnen muss (§ 1815 Absatz 2)";
    label en unofficial "scope of assignment which the custody court must expressly order (§ 1815 (2))";
    FreiheitsentziehendeUnterbringung,
    FreiheitsentziehendeMassnahme,
    AufenthaltImAusland,
    UmgangsBestimmung,
    Telekommunikation,
    PostAnhalten
}
@source(BGB_P1815)
pub external judgment relation aufgabenbereich_rechtlich_erforderlich(b: Person, betreuter: Person, bereich: Aufgabenbereich) {
    authority Court;
    label de official "Ein Aufgabenbereich darf nur angeordnet werden, wenn und soweit dessen rechtliche Wahrnehmung durch einen Betreuer erforderlich ist (§ 1815 Absatz 1 Satz 3)";
    label en unofficial "a scope of assignment may only be ordered where and to the extent its legal exercise by a custodian is necessary (§ 1815 (1) sentence 3)";
}
pub relation aufgabenbereich_angeordnet(b: Person, betreuter: Person, bereich: Aufgabenbereich) kind institutional {
    label de official "Aufgabenbereich vom Betreuungsgericht angeordnet (§ 1815 Absatz 1 Satz 2)";
    label en unofficial "scope of assignment ordered by the custody court (§ 1815 (1) sentence 2)";
}
@source(BGB_P1815)
rule AufgabenbereichAnordnung(b: Person, betreuter: Person, bereich: Aufgabenbereich) strict {
    label de official "Ein Aufgabenbereich wird vom Betreuungsgericht angeordnet, wenn und soweit dessen rechtliche Wahrnehmung erforderlich ist (§ 1815 Absatz 1)";
    label en unofficial "a scope of assignment is ordered by the custody court where and to the extent its legal exercise is necessary (§ 1815 (1))";
    when aufgabenbereich_rechtlich_erforderlich(b, betreuter, bereich);
    then aufgabenbereich_angeordnet(b, betreuter, bereich);
}
pub relation betreuer_darf_entscheidung_treffen(b: Person, betreuter: Person, bereich: Aufgabenbereich) kind institutional {
    label de official "Der Betreuer darf diese Entscheidung nur treffen, weil sie als Aufgabenbereich ausdrücklich angeordnet worden ist (§ 1815 Absatz 2)";
    label en unofficial "the custodian may only take this decision because it has been expressly ordered as a scope of assignment (§ 1815 (2))";
}
@source(BGB_P1815)
rule BetreuerDarfNurBeiAusdruecklicherAnordnung(b: Person, betreuter: Person, bereich: Aufgabenbereich) strict {
    label de official "Folgende Entscheidungen darf der Betreuer nur treffen, wenn sie als Aufgabenbereich ausdrücklich angeordnet worden sind: Unterbringung nach § 1831 Absatz 1, freiheitsentziehende Maßnahme nach § 1831 Absatz 4, Aufenthalt im Ausland, Umgangsbestimmung, Telekommunikation, Postanhalten (§ 1815 Absatz 2)";
    label en unofficial "the custodian may only take the following decisions if expressly ordered as a scope of assignment: placement under § 1831 (1), a deprivation-of-liberty measure under § 1831 (4), residence abroad, determining contact, telecommunications, withholding post (§ 1815 (2))";
    when aufgabenbereich_angeordnet(b, betreuter, bereich);
    then betreuer_darf_entscheidung_treffen(b, betreuter, bereich);
}

pub relation kontrollbetreuer_voraussetzungen_1820_abs3(b: Person, betreuter: Person) kind empirical {
    label de official "Voraussetzungen des § 1820 Absatz 3 für die Übertragung der Aufgabenbereiche eines Kontrollbetreuers sind erfüllt (§ 1815 Absatz 3)";
    label en unofficial "the requirements of § 1820 (3) for assigning the scope of a supervisory custodian are met (§ 1815 (3))";
}
pub relation kontrollbetreuer_aufgabenbereich_uebertragen(b: Person, betreuter: Person) kind institutional {
    label de official "Aufgabenbereiche eines Kontrollbetreuers übertragen: Geltendmachung von Rechten gegenüber dem Bevollmächtigten sowie von Auskunfts- und Rechenschaftsansprüchen gegenüber Dritten (§ 1815 Absatz 3)";
    label en unofficial "scope of a supervisory custodian assigned: asserting the represented person's rights against the agent and information/accounting claims against third parties (§ 1815 (3))";
}
@source(BGB_P1815)
rule KontrollbetreuerAufgabenbereich(b: Person, betreuter: Person) strict {
    label de official "Einem Betreuer können unter den Voraussetzungen des § 1820 Absatz 3 die Aufgabenbereiche eines Kontrollbetreuers übertragen werden (§ 1815 Absatz 3)";
    label en unofficial "a custodian may, under the requirements of § 1820 (3), be assigned the scope of a supervisory custodian (§ 1815 (3))";
    when kontrollbetreuer_voraussetzungen_1820_abs3(b, betreuter);
    then kontrollbetreuer_aufgabenbereich_uebertragen(b, betreuter);
}

// § 1816: Eignung und Auswahl des Betreuers; Wünsche des Volljährigen — Wertungen.

@source(BGB_P1816)
pub external judgment relation zur_betreuungsfuehrung_geeignet(b: Person, betreuter: Person) {
    authority Court;
    label de official "Eignung, die Angelegenheiten im gerichtlich angeordneten Aufgabenkreis nach Maßgabe des § 1821 zu besorgen und den erforderlichen persönlichen Kontakt zu halten (§ 1816 Absatz 1)";
    label en unofficial "suitability to attend to the affairs within the court-ordered scope in accordance with § 1821, and to maintain the necessary personal contact (§ 1816 (1))";
}
pub relation volljaehriger_wuenscht_person_als_betreuer(volljaehriger: Person, gewuenschte: Person) kind empirical {
    label de official "Der Volljährige wünscht eine bestimmte Person als Betreuer (§ 1816 Absatz 2 Satz 1)";
    label en unofficial "the adult wishes a specific person to be appointed custodian (§ 1816 (2) sentence 1)";
}
pub relation wunsch_dem_betreuer_zu_entsprechen(volljaehriger: Person, gewuenschte: Person) kind institutional {
    label de official "Dem Wunsch des Volljährigen nach dieser Person als Betreuer ist zu entsprechen (§ 1816 Absatz 2 Satz 1)";
    label en unofficial "the adult's wish for this person to be appointed custodian must be honoured (§ 1816 (2) sentence 1)";
}
@source(BGB_P1816)
rule WunschEntsprechenSoweitGeeignet(volljaehriger: Person, gewuenschte: Person) strict {
    label de official "Wünscht der Volljährige eine Person als Betreuer, ist diesem Wunsch zu entsprechen, es sei denn, die gewünschte Person ist zur Führung der Betreuung nicht geeignet (§ 1816 Absatz 2 Satz 1)";
    label en unofficial "where the adult wishes a person to be appointed custodian, that wish must be honoured unless the wished-for person is unsuitable to conduct the custodianship (§ 1816 (2) sentence 1)";
    when volljaehriger_wuenscht_person_als_betreuer(volljaehriger, gewuenschte) and zur_betreuungsfuehrung_geeignet(gewuenschte, volljaehriger);
    then wunsch_dem_betreuer_zu_entsprechen(volljaehriger, gewuenschte);
}
pub relation volljaehriger_lehnt_person_als_betreuer_ab(volljaehriger: Person, abgelehnte: Person) kind empirical {
    label de official "Der Volljährige lehnt eine bestimmte Person als Betreuer ab, bezogen auf die Person des Betreuers (§ 1816 Absatz 2 Satz 2)";
    label en unofficial "the adult rejects a specific person as custodian, referring to that person specifically (§ 1816 (2) sentence 2)";
}
pub relation ablehnung_betrifft_bestellung_als_solche(volljaehriger: Person, abgelehnte: Person) kind empirical {
    label de official "Die Ablehnung bezieht sich nicht auf die Person des Betreuers, sondern auf die Bestellung eines Betreuers als solche (§ 1816 Absatz 2 Satz 2 Halbsatz 2)";
    label en unofficial "the rejection does not refer to the person of the custodian but to the appointment of any custodian as such (§ 1816 (2) sentence 2 second half-sentence)";
}
pub relation ablehnung_zu_beachten(volljaehriger: Person, abgelehnte: Person) kind institutional {
    label de official "Die Ablehnung dieser Person als Betreuer ist zu beachten (§ 1816 Absatz 2 Satz 2)";
    label en unofficial "the rejection of this person as custodian must be respected (§ 1816 (2) sentence 2)";
}
@source(BGB_P1816)
rule AblehnungZuBeachten(volljaehriger: Person, abgelehnte: Person) strict {
    label de official "Lehnt der Volljährige eine bestimmte Person als Betreuer ab, ist diesem Wunsch zu entsprechen, es sei denn, die Ablehnung bezieht sich auf die Bestellung eines Betreuers als solche (§ 1816 Absatz 2 Satz 2)";
    label en unofficial "where the adult rejects a specific person as custodian, that wish must be honoured, unless the rejection refers to the appointment of any custodian as such (§ 1816 (2) sentence 2)";
    when volljaehriger_lehnt_person_als_betreuer_ab(volljaehriger, abgelehnte) and not_known(ablehnung_betrifft_bestellung_als_solche(volljaehriger, abgelehnte));
    then ablehnung_zu_beachten(volljaehriger, abgelehnte);
}
pub relation betreuungsverfuegung_uebermittelt(volljaehriger: Person) kind empirical {
    label de official "Wer von der Einleitung des Betreuungsverfahrens Kenntnis erlangt und eine Betreuungsverfügung besitzt, hat sie dem Betreuungsgericht zu übermitteln (§ 1816 Absatz 2 Satz 4)";
    label en unofficial "whoever learns of the initiation of custodianship proceedings and holds a custodianship directive must transmit it to the custody court (§ 1816 (2) sentence 4)";
}

pub relation niemand_vorgeschlagen_oder_ungeeignet(volljaehriger: Person) kind empirical {
    label de official "Der Volljährige schlägt niemanden Geeigneten vor, oder die gewünschte Person ist nicht geeignet (§ 1816 Absatz 3)";
    label en unofficial "the adult proposes no suitable person, or the wished-for person is unsuitable (§ 1816 (3))";
}
@source(BGB_P1816)
pub external judgment relation familiaere_beziehungen_und_bindungen_massgeblich(b: Person, volljaehriger: Person) {
    authority Court;
    label de official "Bei der Auswahl sind die familiären Beziehungen, insbesondere zum Ehegatten, zu Eltern und zu Kindern, die persönlichen Bindungen sowie die Gefahr von Interessenkonflikten zu berücksichtigen (§ 1816 Absatz 3)";
    label en unofficial "the selection must have regard to family relationships, in particular to the spouse, parents and children, personal bonds, and the risk of conflicts of interest (§ 1816 (3))";
}

pub relation traeger_ist_abhaengigkeitsverhaeltnis(b: Person, volljaehriger: Person) kind empirical {
    label de official "Die Person steht zu einem Träger von Einrichtungen oder Diensten in der Versorgung des Volljährigen in einem Abhängigkeitsverhältnis oder einer anderen engen Beziehung (§ 1816 Absatz 6 Satz 1)";
    label en unofficial "the person stands in a relationship of dependency or another close relationship with a provider of institutions or services caring for the adult (§ 1816 (6) sentence 1)";
}
pub relation konkrete_interessenkollision_besteht_nicht(b: Person, volljaehriger: Person) kind empirical {
    label de official "Im Einzelfall besteht die konkrete Gefahr einer Interessenkollision nicht (§ 1816 Absatz 6 Satz 2)";
    label en unofficial "in the individual case there is no concrete risk of a conflict of interest (§ 1816 (6) sentence 2)";
}
pub relation nicht_zum_betreuer_bestellbar(b: Person) kind institutional {
    label de official "Person kann nicht zum Betreuer bestellt werden (§ 1816 Absatz 6, § 1818 Absatz 5)";
    label en unofficial "the person cannot be appointed custodian (§ 1816 (6), § 1818 (5))";
}
@source(BGB_P1816)
rule NichtBestellbarAbhaengigkeitsverhaeltnis(b: Person, volljaehriger: Person) defeasible {
    label de official "Eine Person, die zu einem Träger von Einrichtungen oder Diensten in der Versorgung des Volljährigen in einem Abhängigkeitsverhältnis oder einer anderen engen Beziehung steht, darf nicht zum Betreuer bestellt werden, es sei denn, im Einzelfall besteht keine konkrete Gefahr einer Interessenkollision (§ 1816 Absatz 6)";
    label en unofficial "a person in a relationship of dependency or another close relationship with a provider of institutions or services caring for the adult may not be appointed custodian, unless in the individual case there is no concrete risk of a conflict of interest (§ 1816 (6))";
    when traeger_ist_abhaengigkeitsverhaeltnis(b, volljaehriger) and not_known(konkrete_interessenkollision_besteht_nicht(b, volljaehriger));
    then nicht_zum_betreuer_bestellbar(b);
}

// § 1817: Mehrere Betreuer; Verhinderungsbetreuer; Ergänzungsbetreuer.

pub relation mehrere_betreuer_besser(betreuter: Person) kind empirical {
    label de official "Die Angelegenheiten des Betreuten können durch mehrere Betreuer besser besorgt werden (§ 1817 Absatz 1 Satz 1)";
    label en unofficial "the represented person's affairs can be better attended to by several custodians (§ 1817 (1) sentence 1)";
}
pub relation sterilisationsbetreuer_stets_zu_bestellen(betreuter: Person) kind institutional {
    label de official "Für die Entscheidung über die Einwilligung in eine Sterilisation ist stets ein besonderer Betreuer zu bestellen (Sterilisationsbetreuer) (§ 1817 Absatz 2)";
    label en unofficial "a special custodian must always be appointed to decide on consent to sterilisation (sterilisation custodian) (§ 1817 (2))";
}
pub relation sterilisation_in_erwaegung(betreuter: Person) kind empirical {
    label de official "Eine Sterilisation des Betreuten wird in Erwägung gezogen (§ 1817 Absatz 2)";
    label en unofficial "sterilisation of the represented person is being considered (§ 1817 (2))";
}
@source(BGB_P1817)
rule SterilisationsbetreuerStetsZuBestellen(betreuter: Person) strict {
    label de official "Für die Entscheidung über die Einwilligung in eine Sterilisation des Betreuten ist stets ein besonderer Betreuer zu bestellen (§ 1817 Absatz 2)";
    label en unofficial "a special custodian must always be appointed to decide on consent to sterilisation of the represented person (§ 1817 (2))";
    when sterilisation_in_erwaegung(betreuter);
    then sterilisationsbetreuer_stets_zu_bestellen(betreuter);
}
pub relation betreuer_aus_tatsaechlichen_gruenden_verhindert(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer ist aus tatsächlichen Gründen an der Besorgung der Angelegenheiten verhindert (§ 1817 Absatz 4)";
    label en unofficial "the custodian is factually prevented from attending to the affairs (§ 1817 (4))";
}
pub relation verhinderungsbetreuer_zulaessig(b: Person, betreuter: Person) kind institutional {
    label de official "Ein vorsorglicher Verhinderungsbetreuer kann bestellt werden (§ 1817 Absatz 4)";
    label en unofficial "a precautionary substitute custodian may be appointed (§ 1817 (4))";
}
@source(BGB_P1817)
rule VerhinderungsbetreuerBestellbar(b: Person, betreuter: Person) strict {
    label de official "Das Betreuungsgericht kann auch vorsorglich einen Verhinderungsbetreuer bestellen, der die Angelegenheiten besorgt, soweit der Betreuer aus tatsächlichen Gründen verhindert ist (§ 1817 Absatz 4 Satz 1)";
    label en unofficial "the custody court may also precautionarily appoint a substitute custodian to attend to the affairs so far as the custodian is factually prevented (§ 1817 (4) sentence 1)";
    when betreuer_aus_tatsaechlichen_gruenden_verhindert(b, betreuter);
    then verhinderungsbetreuer_zulaessig(b, betreuter);
}
pub relation betreuer_aus_rechtlichen_gruenden_gehindert(b: Person, betreuter: Person, angelegenheit: Text) kind empirical {
    label de official "Der Betreuer ist aus rechtlichen Gründen gehindert, einzelne Angelegenheiten des Betreuten zu besorgen (§ 1817 Absatz 5)";
    label en unofficial "the custodian is legally hindered from attending to individual matters of the represented person (§ 1817 (5))";
}
pub relation ergaenzungsbetreuer_zu_bestellen(b: Person, betreuter: Person, angelegenheit: Text) kind institutional {
    label de official "Für diese Angelegenheit ist ein Ergänzungsbetreuer zu bestellen (§ 1817 Absatz 5)";
    label en unofficial "a supplementary custodian must be appointed for this matter (§ 1817 (5))";
}
@source(BGB_P1817)
rule ErgaenzungsbetreuerBeiRechtlicherHinderung(b: Person, betreuter: Person, angelegenheit: Text) strict {
    label de official "Ist der Betreuer aus rechtlichen Gründen gehindert, einzelne Angelegenheiten zu besorgen, hat das Betreuungsgericht hierfür einen Ergänzungsbetreuer zu bestellen (§ 1817 Absatz 5)";
    label en unofficial "where the custodian is legally hindered from attending to individual matters, the custody court must appoint a supplementary custodian for them (§ 1817 (5))";
    when betreuer_aus_rechtlichen_gruenden_gehindert(b, betreuter, angelegenheit);
    then ergaenzungsbetreuer_zu_bestellen(b, betreuter, angelegenheit);
}

// § 1818: Betreuung durch Betreuungsverein oder Betreuungsbehörde.

pub relation volljaehriger_wuenscht_betreuungsverein(volljaehriger: Person, verein: Person) kind empirical {
    label de official "Der Volljährige wünscht die Bestellung eines anerkannten Betreuungsvereins als Betreuer (§ 1818 Absatz 1 Satz 1)";
    label en unofficial "the adult wishes a recognised custodianship association to be appointed custodian (§ 1818 (1) sentence 1)";
}
pub relation nicht_hinreichend_durch_natuerliche_personen_betreubar(volljaehriger: Person) kind empirical {
    label de official "Der Volljährige kann durch eine oder mehrere natürliche Personen nicht hinreichend betreut werden (§ 1818 Absatz 1 Satz 1)";
    label en unofficial "the adult cannot be adequately cared for by one or more natural persons (§ 1818 (1) sentence 1)";
}
pub relation verein_willigt_in_bestellung_ein(verein: Person) kind empirical {
    label de official "Die Bestellung des Betreuungsvereins bedarf dessen Einwilligung; sie liegt vor (§ 1818 Absatz 1 Satz 2)";
    label en unofficial "the association's appointment requires its consent; consent is given (§ 1818 (1) sentence 2)";
}
pub relation betreuungsverein_als_betreuer_bestellbar(volljaehriger: Person, verein: Person) kind institutional {
    label de official "Der Betreuungsverein kann zum Betreuer bestellt werden (§ 1818 Absatz 1)";
    label en unofficial "the custodianship association may be appointed custodian (§ 1818 (1))";
}
@source(BGB_P1818) {
    rule BetreuungsvereinBestellungAufWunsch(volljaehriger: Person, verein: Person) strict {
        label de official "Das Betreuungsgericht bestellt den anerkannten Betreuungsverein zum Betreuer, wenn der Volljährige dies wünscht und der Verein einwilligt (§ 1818 Absatz 1)";
        label en unofficial "the custody court appoints the recognised association custodian if the adult so wishes and the association consents (§ 1818 (1))";
        when volljaehriger_wuenscht_betreuungsverein(volljaehriger, verein) and verein_willigt_in_bestellung_ein(verein);
        then betreuungsverein_als_betreuer_bestellbar(volljaehriger, verein);
    }
    rule BetreuungsvereinBestellungBeiUnzureichenderNatuerlicherBetreuung(volljaehriger: Person, verein: Person) strict {
        label de official "Das Betreuungsgericht bestellt den anerkannten Betreuungsverein zum Betreuer, wenn der Volljährige durch natürliche Personen nicht hinreichend betreut werden kann und der Verein einwilligt (§ 1818 Absatz 1)";
        label en unofficial "the custody court appoints the recognised association custodian where the adult cannot be adequately cared for by natural persons and the association consents (§ 1818 (1))";
        when nicht_hinreichend_durch_natuerliche_personen_betreubar(volljaehriger) and verein_willigt_in_bestellung_ein(verein);
        then betreuungsverein_als_betreuer_bestellbar(volljaehriger, verein);
    }
}
pub relation weder_natuerliche_personen_noch_verein_ausreichend(volljaehriger: Person) kind empirical {
    label de official "Der Volljährige kann weder durch natürliche Personen noch durch einen Betreuungsverein hinreichend betreut werden (§ 1818 Absatz 4 Satz 1)";
    label en unofficial "the adult cannot be adequately cared for by natural persons or a custodianship association (§ 1818 (4) sentence 1)";
}
pub relation betreuungsbehoerde_zum_betreuer_bestellt(volljaehriger: Person, behoerde: Person) kind institutional {
    label de official "Die zuständige Betreuungsbehörde wird zum Betreuer bestellt (§ 1818 Absatz 4)";
    label en unofficial "the competent custodianship authority is appointed custodian (§ 1818 (4))";
}
pub relation zustaendige_betreuungsbehoerde(volljaehriger: Person, behoerde: Person) kind empirical {
    label de official "Für den Volljährigen zuständige Betreuungsbehörde (§ 1818 Absatz 4)";
    label en unofficial "the custodianship authority competent for the adult (§ 1818 (4))";
}
@source(BGB_P1818)
rule BetreuungsbehoerdeSubsidiaer(volljaehriger: Person, behoerde: Person) strict {
    label de official "Kann der Volljährige weder durch natürliche Personen noch durch einen Betreuungsverein hinreichend betreut werden, bestellt das Betreuungsgericht die zuständige Betreuungsbehörde zum Betreuer (§ 1818 Absatz 4 Satz 1)";
    label en unofficial "where the adult cannot be adequately cared for by natural persons or a custodianship association, the custody court appoints the competent custodianship authority as custodian (§ 1818 (4) sentence 1)";
    when weder_natuerliche_personen_noch_verein_ausreichend(volljaehriger) and zustaendige_betreuungsbehoerde(volljaehriger, behoerde);
    then betreuungsbehoerde_zum_betreuer_bestellt(volljaehriger, behoerde);
}
pub relation sterilisationseinwilligung_nicht_uebertragbar_1818(traeger: Person, betreuter: Person) kind institutional {
    label de official "Die Entscheidung über die Einwilligung in eine Sterilisation darf weder einem Betreuungsverein noch einer Betreuungsbehörde übertragen werden (§ 1818 Absatz 5)";
    label en unofficial "the decision on consent to sterilisation may not be assigned to a custodianship association or authority (§ 1818 (5))";
}
@source(BGB_P1818)
rule SterilisationEinwilligungNichtBeiVereinOderBehoerde(traeger: Person, betreuter: Person) strict {
    label de official "Die Entscheidung über die Einwilligung in eine Sterilisation darf weder einem Betreuungsverein noch einer Betreuungsbehörde übertragen werden (§ 1818 Absatz 5)";
    label en unofficial "the decision on consent to sterilisation may not be assigned to a custodianship association or authority (§ 1818 (5))";
    when betreuungsverein_als_betreuer_bestellbar(betreuter, traeger) or betreuungsbehoerde_zum_betreuer_bestellt(betreuter, traeger);
    then sterilisationseinwilligung_nicht_uebertragbar_1818(traeger, betreuter);
}

// § 1819: Übernahmepflicht; weitere Bestellungsvoraussetzungen.

@source(BGB_P1819)
pub external judgment relation betreuungsuebernahme_zumutbar(b: Person, betreuter: Person) {
    authority Court;
    label de official "Die Übernahme der Betreuung ist der ausgewählten Person unter Berücksichtigung ihrer familiären, beruflichen und sonstigen Verhältnisse zuzumuten (§ 1819 Absatz 1)";
    label en unofficial "assuming the custodianship can reasonably be expected of the selected person, having regard to their family, professional and other circumstances (§ 1819 (1))";
}
pub relation bereiterklaerung_zur_betreuungsuebernahme(b: Person, betreuter: Person) kind empirical {
    label de official "Die ausgewählte Person hat sich zur Übernahme der Betreuung bereit erklärt (§ 1819 Absatz 2)";
    label en unofficial "the selected person has declared readiness to assume the custodianship (§ 1819 (2))";
}
pub relation betreuerbestellung_zulaessig_1819(b: Person, betreuter: Person) kind institutional {
    label de official "Die ausgewählte Person darf zum Betreuer bestellt werden (§ 1819 Absatz 2)";
    label en unofficial "the selected person may be appointed custodian (§ 1819 (2))";
}
@source(BGB_P1819)
rule BetreuerbestellungErstNachBereiterklaerung(b: Person, betreuter: Person) strict {
    label de official "Die ausgewählte Person darf erst dann zum Betreuer bestellt werden, wenn sie sich zur Übernahme bereit erklärt hat (§ 1819 Absatz 2)";
    label en unofficial "the selected person may only be appointed custodian once they have declared readiness to assume the office (§ 1819 (2))";
    when bereiterklaerung_zur_betreuungsuebernahme(b, betreuter);
    then betreuerbestellung_zulaessig_1819(b, betreuter);
}

// § 1820: Vorsorgevollmacht und Kontrollbetreuung.

pub relation vollmachtgeber_kann_rechte_nicht_mehr_ausueben(vollmachtgeber: Person) kind empirical {
    label de official "Der Vollmachtgeber ist aufgrund Krankheit oder Behinderung nicht mehr in der Lage, seine Rechte gegenüber dem Bevollmächtigten auszuüben (§ 1820 Absatz 3 Nummer 1)";
    label en unofficial "the principal is, due to illness or disability, no longer able to exercise their rights against the agent (§ 1820 (3) no. 1)";
}
pub relation bevollmaechtigter_besorgt_nicht_wunschgemaess(vollmachtgeber: Person, bevollmaechtigter: Person) kind empirical {
    label de official "Konkrete Anhaltspunkte dafür, dass der Bevollmächtigte die Angelegenheiten nicht entsprechend der Vereinbarung oder dem erklärten oder mutmaßlichen Willen des Vollmachtgebers besorgt (§ 1820 Absatz 3 Nummer 2)";
    label en unofficial "concrete indications that the agent does not attend to the affairs in accordance with the agreement or the principal's expressed or presumed will (§ 1820 (3) no. 2)";
}
pub relation kontrollbetreuer_bestellung_erforderlich(vollmachtgeber: Person) kind institutional {
    label de official "Bestellung eines Kontrollbetreuers erforderlich (§ 1820 Absatz 3)";
    label en unofficial "appointment of a supervisory custodian is necessary (§ 1820 (3))";
}
@source(BGB_P1820)
rule KontrollbetreuerBestellungErforderlich(vollmachtgeber: Person, bevollmaechtigter: Person) strict {
    label de official "Das Betreuungsgericht bestellt einen Kontrollbetreuer, wenn der Vollmachtgeber seine Rechte gegenüber dem Bevollmächtigten nicht mehr ausüben kann und konkrete Anhaltspunkte für pflichtwidrige Wahrnehmung bestehen (§ 1820 Absatz 3)";
    label en unofficial "the custody court appoints a supervisory custodian where the principal can no longer exercise their rights against the agent and concrete indications of improper conduct exist (§ 1820 (3))";
    when vollmachtgeber_kann_rechte_nicht_mehr_ausueben(vollmachtgeber) and bevollmaechtigter_besorgt_nicht_wunschgemaess(vollmachtgeber, bevollmaechtigter);
    then kontrollbetreuer_bestellung_erforderlich(vollmachtgeber);
}
pub relation dringende_gefahr_durch_bevollmaechtigten(vollmachtgeber: Person, bevollmaechtigter: Person) kind empirical {
    label de official "Dringende Gefahr, dass der Bevollmächtigte nicht wunschgemäß handelt und dadurch Person oder Vermögen erheblich gefährdet (§ 1820 Absatz 4 Satz 1 Nummer 1)";
    label en unofficial "urgent risk that the agent will not act as wished, substantially endangering the principal's person or assets (§ 1820 (4) sentence 1 no. 1)";
}
pub relation bevollmaechtigter_behindert_betreuer(bevollmaechtigter: Person, betreuer: Person) kind empirical {
    label de official "Der Bevollmächtigte behindert den Betreuer bei der Wahrnehmung seiner Aufgaben (§ 1820 Absatz 4 Satz 1 Nummer 2)";
    label en unofficial "the agent obstructs the custodian in performing their duties (§ 1820 (4) sentence 1 no. 2)";
}
pub relation vollmacht_erteilt_von_an(vollmachtgeber: Person, bevollmaechtigter: Person) kind empirical {
    label de official "Der Vollmachtgeber hat dem Bevollmächtigten die Vollmacht erteilt (§ 1820 Absatz 4)";
    label en unofficial "the principal has granted the power of attorney to the agent (§ 1820 (4))";
}
pub relation ausuebungsverbot_und_urkundenherausgabe_anordenbar(vollmachtgeber: Person, bevollmaechtigter: Person) kind institutional {
    label de official "Das Betreuungsgericht kann anordnen, dass der Bevollmächtigte die Vollmacht nicht ausüben darf und die Vollmachtsurkunde herauszugeben hat (§ 1820 Absatz 4 Satz 1)";
    label en unofficial "the custody court may order that the agent may not exercise the power of attorney and must surrender the instrument (§ 1820 (4) sentence 1)";
}
@source(BGB_P1820) {
    rule AusuebungsverbotBeiDringenderGefahr(vollmachtgeber: Person, bevollmaechtigter: Person) strict {
        label de official "Ausübungsverbot und Herausgabeanordnung bei dringender Gefahr durch den Bevollmächtigten (§ 1820 Absatz 4 Satz 1 Nummer 1)";
        label en unofficial "prohibition and surrender order where there is urgent risk from the agent (§ 1820 (4) sentence 1 no. 1)";
        when dringende_gefahr_durch_bevollmaechtigten(vollmachtgeber, bevollmaechtigter);
        then ausuebungsverbot_und_urkundenherausgabe_anordenbar(vollmachtgeber, bevollmaechtigter);
    }
    rule AusuebungsverbotBeiBehinderungDesBetreuers(vollmachtgeber: Person, bevollmaechtigter: Person, betreuer: Person) strict {
        label de official "Ausübungsverbot und Herausgabeanordnung, wenn der Bevollmächtigte den Betreuer bei seiner Aufgabenwahrnehmung behindert (§ 1820 Absatz 4 Satz 1 Nummer 2)";
        label en unofficial "prohibition and surrender order where the agent obstructs the custodian in performing their duties (§ 1820 (4) sentence 1 no. 2)";
        when vollmacht_erteilt_von_an(vollmachtgeber, bevollmaechtigter) and bevollmaechtigter_behindert_betreuer(bevollmaechtigter, betreuer);
        then ausuebungsverbot_und_urkundenherausgabe_anordenbar(vollmachtgeber, bevollmaechtigter);
    }
}

// § 1821: Pflichten des Betreuers; Wünsche des Betreuten — der Wertungskern.

@source(BGB_P1821)
pub external judgment relation von_vertretungsmacht_nur_soweit_erforderlich_gebrauch(b: Person, betreuter: Person) {
    authority Court;
    label de official "Der Betreuer macht von seiner Vertretungsmacht nach § 1823 nur Gebrauch, soweit dies erforderlich ist (§ 1821 Absatz 1 Satz 2)";
    label en unofficial "the custodian exercises their power of representation under § 1823 only so far as necessary (§ 1821 (1) sentence 2)";
}
pub relation wunsch_des_betreuten_festgestellt(betreuter: Person, wunsch: Text) kind empirical {
    label de official "Der Betreuer hat den Wunsch des Betreuten festgestellt (§ 1821 Absatz 2 Satz 2)";
    label en unofficial "the custodian has ascertained the represented person's wish (§ 1821 (2) sentence 2)";
}
pub relation gefaehrdung_im_sinne_1821_abs3_nr1(betreuter: Person, wunsch: Text) kind empirical {
    label de official "Die Person des Betreuten oder dessen Vermögen würde durch den Wunsch erheblich gefährdet, und der Betreute kann diese Gefahr wegen Krankheit oder Behinderung nicht erkennen oder nicht danach handeln (§ 1821 Absatz 3 Nummer 1)";
    label en unofficial "the represented person or their assets would be substantially endangered by the wish, and due to illness or disability they cannot recognise this danger or act on that insight (§ 1821 (3) no. 1)";
}
pub relation wunsch_dem_betreuer_nicht_zuzumuten(betreuter: Person, wunsch: Text) kind empirical {
    label de official "Dem Betreuer ist die Erfüllung des Wunsches nicht zuzumuten (§ 1821 Absatz 3 Nummer 2)";
    label en unofficial "fulfilling the wish cannot reasonably be expected of the custodian (§ 1821 (3) no. 2)";
}
pub relation wunsch_ist_zu_entsprechen(betreuter: Person, wunsch: Text) kind institutional {
    label de official "Dem Wunsch des Betreuten ist zu entsprechen und der Betreute bei seiner Umsetzung rechtlich zu unterstützen (§ 1821 Absatz 2)";
    label en unofficial "the represented person's wish must be honoured, and they must be legally supported in implementing it (§ 1821 (2))";
}
@source(BGB_P1821)
rule WunschEntsprechenSoweitKeineGefaehrdungOderUnzumutbarkeit(betreuter: Person, wunsch: Text) strict {
    label de official "Den Wünschen des Betreuten hat der Betreuer zu entsprechen, es sei denn, die Person oder das Vermögen des Betreuten würde hierdurch erheblich gefährdet oder dies ist dem Betreuer nicht zuzumuten (§ 1821 Absatz 2, 3)";
    label en unofficial "the custodian must honour the represented person's wishes unless this would substantially endanger their person or assets, or cannot reasonably be expected of the custodian (§ 1821 (2), (3))";
    when wunsch_des_betreuten_festgestellt(betreuter, wunsch)
        and not_known(gefaehrdung_im_sinne_1821_abs3_nr1(betreuter, wunsch))
        and not_known(wunsch_dem_betreuer_nicht_zuzumuten(betreuter, wunsch));
    then wunsch_ist_zu_entsprechen(betreuter, wunsch);
}
@source(BGB_P1821)
pub external judgment relation mutmasslicher_wille_des_betreuten(betreuter: Person, wille: Text) {
    authority Court;
    label de official "Mutmaßlicher Wille des Betreuten, aufgrund konkreter Anhaltspunkte ermittelt — insbesondere frühere Äußerungen, ethische oder religiöse Überzeugungen und sonstige persönliche Wertvorstellungen (§ 1821 Absatz 4)";
    label en unofficial "the represented person's presumed will, ascertained from concrete indications — in particular earlier statements, ethical or religious convictions and other personal values (§ 1821 (4))";
}

// § 1822: Auskunftspflicht gegenüber nahestehenden Angehörigen.

pub relation auskunft_ueber_lebensumstaende_verlangt(b: Person, betreuter: Person, verlangende: Person) kind empirical {
    label de official "Nahestehende Angehörige oder sonstige Vertrauenspersonen verlangen Auskunft über die persönlichen Lebensumstände des Betreuten (§ 1822)";
    label en unofficial "close relatives or other persons of trust demand information on the represented person's personal circumstances (§ 1822)";
}
pub relation auskunft_entspricht_wunsch_oder_mutmasslichem_willen(b: Person, betreuter: Person, verlangende: Person) kind empirical {
    label de official "Die Auskunft entspricht einem nach § 1821 Absatz 2 bis 4 zu beachtenden Wunsch oder dem mutmaßlichen Willen des Betreuten und ist dem Betreuer zuzumuten (§ 1822)";
    label en unofficial "the disclosure corresponds to a wish to be respected under § 1821 (2) to (4) or the represented person's presumed will, and can reasonably be expected of the custodian (§ 1822)";
}
pub relation auskunftspflicht_1822(b: Person, betreuter: Person, verlangende: Person) kind institutional {
    label de official "Auskunftspflicht des Betreuers gegenüber nahestehenden Angehörigen (§ 1822)";
    label en unofficial "the custodian's duty to inform close relatives (§ 1822)";
}
@source(BGB_P1822)
rule Auskunftspflicht1822(b: Person, betreuter: Person, verlangende: Person) strict {
    label de official "Der Betreuer hat auf Verlangen Auskunft über die persönlichen Lebensumstände zu erteilen, soweit dies einem zu beachtenden Wunsch oder dem mutmaßlichen Willen entspricht und ihm zuzumuten ist (§ 1822)";
    label en unofficial "the custodian must, on request, disclose the represented person's personal circumstances so far as this matches a wish to be respected or their presumed will and is reasonable for the custodian (§ 1822)";
    when auskunft_ueber_lebensumstaende_verlangt(b, betreuter, verlangende) and auskunft_entspricht_wunsch_oder_mutmasslichem_willen(b, betreuter, verlangende);
    then auskunftspflicht_1822(b, betreuter, verlangende);
}

// § 1823: Vertretungsmacht des Betreuers.

pub relation vertretung_1823(b: Person, betreuter: Person, aufgabenkreis: Text) kind institutional {
    label de official "Im Aufgabenkreis kann der Betreuer den Betreuten gerichtlich und außergerichtlich vertreten (§ 1823)";
    label en unofficial "within their scope, the custodian may represent the represented person in and out of court (§ 1823)";
}
@source(BGB_P1823)
rule VertretungsmachtImAufgabenkreis(b: Person, betreuter: Person, aufgabenkreis: Text) strict {
    label de official "In seinem Aufgabenkreis kann der Betreuer den Betreuten gerichtlich und außergerichtlich vertreten (§ 1823)";
    label en unofficial "within their scope, the custodian may represent the represented person in and out of court (§ 1823)";
    when betreuer_bestellt(b, betreuter) and aufgabenkreis_umfasst(b, betreuter, aufgabenkreis);
    then vertretung_1823(b, betreuter, aufgabenkreis);
}
pub relation aufgabenkreis_umfasst(b: Person, betreuter: Person, aufgabenkreis: Text) kind empirical {
    label de official "Der gerichtlich angeordnete Aufgabenkreis des Betreuers umfasst diese Angelegenheit (§ 1815 Absatz 1)";
    label en unofficial "the custodian's court-ordered scope covers this matter (§ 1815 (1))";
}

// § 1824: Ausschluss der Vertretungsmacht — Insichgeschäfte und deren Prozesse.

pub relation rechtsgeschaeft_mit_ehegatten_oder_verwandtem_gerader_linie(b: Person, betreuter: Person, geschaeftspartner: Person) kind empirical {
    label de official "Rechtsgeschäft zwischen Ehegatten oder Verwandtem gerader Linie des Betreuers einerseits und dem Betreuten andererseits (§ 1824 Absatz 1 Nummer 1)";
    label en unofficial "a transaction between the custodian's spouse or lineal relative on the one hand and the represented person on the other (§ 1824 (1) no. 1)";
}
pub relation ausschliesslich_erfuellung_einer_verbindlichkeit(b: Person, betreuter: Person, geschaeftspartner: Person) kind empirical {
    label de official "Das Rechtsgeschäft besteht ausschließlich in der Erfüllung einer Verbindlichkeit (§ 1824 Absatz 1 Nummer 1 Halbsatz 2)";
    label en unofficial "the transaction consists exclusively in the performance of an obligation (§ 1824 (1) no. 1 second half-sentence)";
}
pub relation vertretung_ausgeschlossen_1824(b: Person, betreuter: Person, geschaeftspartner: Person) kind institutional {
    label de official "Der Betreuer kann den Betreuten bei diesem Rechtsgeschäft nicht vertreten (§ 1824 Absatz 1)";
    label en unofficial "the custodian cannot represent the represented person in this transaction (§ 1824 (1))";
}
@source(BGB_P1824)
rule AusschlussVertretungMitNahestehendem(b: Person, betreuter: Person, geschaeftspartner: Person) strict {
    label de official "Der Betreuer kann den Betreuten nicht vertreten bei einem Rechtsgeschäft zwischen seinem Ehegatten oder einem Verwandten in gerader Linie einerseits und dem Betreuten andererseits, außer bei ausschließlicher Erfüllung einer Verbindlichkeit (§ 1824 Absatz 1 Nummer 1)";
    label en unofficial "the custodian cannot represent the represented person in a transaction between the custodian's spouse or a lineal relative and the represented person, except where it consists exclusively in performing an obligation (§ 1824 (1) no. 1)";
    when rechtsgeschaeft_mit_ehegatten_oder_verwandtem_gerader_linie(b, betreuter, geschaeftspartner) and not_known(ausschliesslich_erfuellung_einer_verbindlichkeit(b, betreuter, geschaeftspartner));
    then vertretung_ausgeschlossen_1824(b, betreuter, geschaeftspartner);
}
pub relation rechtsgeschaeft_ueber_gesicherte_forderung_gegen_betreuer(b: Person, betreuter: Person) kind empirical {
    label de official "Rechtsgeschäft über die Übertragung/Belastung einer durch Pfandrecht, Hypothek, Schiffshypothek oder Bürgschaft gesicherten Forderung des Betreuten gegen den Betreuer, oder deren Aufhebung/Minderung (§ 1824 Absatz 1 Nummer 2)";
    label en unofficial "a transaction transferring or encumbering a claim of the represented person against the custodian secured by lien, mortgage, ship mortgage or suretyship, or removing/reducing that security (§ 1824 (1) no. 2)";
}
@source(BGB_P1824)
rule AusschlussVertretungGesicherteForderung(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer kann den Betreuten nicht vertreten bei einem Rechtsgeschäft über die Sicherheit einer Forderung des Betreuten gegen ihn selbst (§ 1824 Absatz 1 Nummer 2)";
    label en unofficial "the custodian cannot represent the represented person in a transaction concerning the security of a claim of the represented person against the custodian themself (§ 1824 (1) no. 2)";
    when rechtsgeschaeft_ueber_gesicherte_forderung_gegen_betreuer(b, betreuter);
    then vertretung_ausgeschlossen_1824(b, betreuter, b);
}
pub relation rechtsstreit_zwischen_nahestehendem_und_betreutem(b: Person, betreuter: Person, gegenpartei: Person) kind empirical {
    label de official "Rechtsstreit zwischen den in § 1824 Absatz 1 Nummer 1 bezeichneten Personen und dem Betreuten, oder über eine Angelegenheit nach Nummer 2 (§ 1824 Absatz 1 Nummer 3)";
    label en unofficial "litigation between the persons described in § 1824 (1) no. 1 and the represented person, or concerning a matter under no. 2 (§ 1824 (1) no. 3)";
}
@source(BGB_P1824)
rule AusschlussVertretungRechtsstreit(b: Person, betreuter: Person, gegenpartei: Person) strict {
    label de official "Der Betreuer kann den Betreuten in diesem Rechtsstreit nicht vertreten (§ 1824 Absatz 1 Nummer 3)";
    label en unofficial "the custodian cannot represent the represented person in this litigation (§ 1824 (1) no. 3)";
    when rechtsstreit_zwischen_nahestehendem_und_betreutem(b, betreuter, gegenpartei);
    then vertretung_ausgeschlossen_1824(b, betreuter, gegenpartei);
}

// § 1825: Einwilligungsvorbehalt.

@source(BGB_P1825)
pub external judgment relation zur_abwendung_erheblicher_gefahr_erforderlich_1825(b: Person, betreuter: Person) {
    authority Court;
    label de official "Ein Einwilligungsvorbehalt ist zur Abwendung einer erheblichen Gefahr für die Person oder das Vermögen des Betreuten erforderlich (§ 1825 Absatz 1 Satz 1)";
    label en unofficial "a consent requirement is necessary to avert a substantial danger to the represented person's person or assets (§ 1825 (1) sentence 1)";
}
pub relation gegen_freien_willen_1825(betreuter: Person) kind empirical {
    label de official "Der Einwilligungsvorbehalt würde gegen den freien Willen des Volljährigen angeordnet (§ 1825 Absatz 1 Satz 2)";
    label en unofficial "the consent requirement would be ordered against the adult's free will (§ 1825 (1) sentence 2)";
}
pub relation einwilligungsvorbehalt_angeordnet(b: Person, betreuter: Person) kind institutional {
    label de official "Einwilligungsvorbehalt angeordnet (§ 1825 Absatz 1)";
    label en unofficial "consent requirement ordered (§ 1825 (1))";
}
@source(BGB_P1825)
rule EinwilligungsvorbehaltAnordnung(b: Person, betreuter: Person) strict {
    label de official "Das Betreuungsgericht ordnet den Einwilligungsvorbehalt an, soweit dies zur Abwendung einer erheblichen Gefahr erforderlich ist und nicht gegen den freien Willen des Volljährigen erfolgt (§ 1825 Absatz 1)";
    label en unofficial "the custody court orders the consent requirement so far as necessary to avert a substantial danger and not against the adult's free will (§ 1825 (1))";
    when zur_abwendung_erheblicher_gefahr_erforderlich_1825(b, betreuter) and not_known(gegen_freien_willen_1825(betreuter));
    then einwilligungsvorbehalt_angeordnet(b, betreuter);
}
pub relation willenserklaerung_auf_eheschliessung_gerichtet(betreuter: Person) kind empirical {
    label de official "Willenserklärung, die auf Eingehung einer Ehe gerichtet ist (§ 1825 Absatz 2 Nummer 1)";
    label en unofficial "a declaration of intent directed at entering marriage (§ 1825 (2) no. 1)";
}
pub relation verfuegung_von_todes_wegen(betreuter: Person) kind empirical {
    label de official "Verfügung von Todes wegen (§ 1825 Absatz 2 Nummer 2)";
    label en unofficial "a disposition on death (§ 1825 (2) no. 2)";
}
pub relation einwilligungsvorbehalt_erstreckt_sich_nicht_darauf(betreuter: Person) kind institutional {
    label de official "Ein Einwilligungsvorbehalt kann sich hierauf nicht erstrecken (§ 1825 Absatz 2)";
    label en unofficial "a consent requirement cannot extend to this (§ 1825 (2))";
}
@source(BGB_P1825) {
    rule EinwilligungsvorbehaltNichtBeiEheschliessung(betreuter: Person) strict {
        label de official "Ein Einwilligungsvorbehalt erstreckt sich nicht auf Willenserklärungen, die auf Eingehung einer Ehe gerichtet sind (§ 1825 Absatz 2 Nummer 1)";
        label en unofficial "a consent requirement does not extend to declarations directed at entering marriage (§ 1825 (2) no. 1)";
        when willenserklaerung_auf_eheschliessung_gerichtet(betreuter);
        then einwilligungsvorbehalt_erstreckt_sich_nicht_darauf(betreuter);
    }
    rule EinwilligungsvorbehaltNichtBeiVerfuegungVonTodesWegen(betreuter: Person) strict {
        label de official "Ein Einwilligungsvorbehalt erstreckt sich nicht auf Verfügungen von Todes wegen (§ 1825 Absatz 2 Nummer 2)";
        label en unofficial "a consent requirement does not extend to dispositions on death (§ 1825 (2) no. 2)";
        when verfuegung_von_todes_wegen(betreuter);
        then einwilligungsvorbehalt_erstreckt_sich_nicht_darauf(betreuter);
    }
}
pub relation willenserklaerung_lediglich_rechtlicher_vorteil(betreuter: Person) kind empirical {
    label de official "Die Willenserklärung bringt dem Betreuten lediglich einen rechtlichen Vorteil (§ 1825 Absatz 3 Satz 1)";
    label en unofficial "the declaration brings the represented person only a legal advantage (§ 1825 (3) sentence 1)";
}
pub relation einwilligung_trotz_vorbehalt_entbehrlich(betreuter: Person) kind institutional {
    label de official "Trotz Einwilligungsvorbehalts ist die Einwilligung des Betreuers entbehrlich (§ 1825 Absatz 3)";
    label en unofficial "despite a consent requirement, the custodian's consent is dispensable (§ 1825 (3))";
}
@source(BGB_P1825)
rule EinwilligungEntbehrlichBeiRechtlichemVorteil(betreuter: Person) strict {
    label de official "Ist ein Einwilligungsvorbehalt angeordnet, bedarf der Betreute dennoch nicht der Einwilligung, wenn die Willenserklärung ihm lediglich einen rechtlichen Vorteil bringt (§ 1825 Absatz 3 Satz 1)";
    label en unofficial "though a consent requirement is ordered, the represented person still does not need consent where the declaration brings them only a legal advantage (§ 1825 (3) sentence 1)";
    when willenserklaerung_lediglich_rechtlicher_vorteil(betreuter);
    then einwilligung_trotz_vorbehalt_entbehrlich(betreuter);
}

// § 1826: Haftung des Betreuers.

pub relation pflichtverletzung_des_betreuers(b: Person, betreuter: Person) kind empirical {
    label de official "Pflichtverletzung des Betreuers, aus der dem Betreuten ein Schaden entsteht (§ 1826 Absatz 1 Satz 1)";
    label en unofficial "the custodian's breach of duty causing the represented person a loss (§ 1826 (1) sentence 1)";
}
pub relation betreuer_hat_pflichtverletzung_zu_vertreten(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer hat die Pflichtverletzung zu vertreten (§ 1826 Absatz 1 Satz 2)";
    label en unofficial "the custodian is responsible for the breach of duty (§ 1826 (1) sentence 2)";
}
pub relation betreuer_haftet_fuer_schaden(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer ist dem Betreuten für den aus der Pflichtverletzung entstehenden Schaden verantwortlich (§ 1826 Absatz 1)";
    label en unofficial "the custodian is liable to the represented person for the loss arising from the breach of duty (§ 1826 (1))";
}
@source(BGB_P1826)
rule HaftungDesBetreuers(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer ist dem Betreuten für den aus einer von ihm zu vertretenden Pflichtverletzung entstehenden Schaden verantwortlich (§ 1826 Absatz 1)";
    label en unofficial "the custodian is liable to the represented person for loss arising from a breach of duty for which they are responsible (§ 1826 (1))";
    when pflichtverletzung_des_betreuers(b, betreuter) and betreuer_hat_pflichtverletzung_zu_vertreten(b, betreuter);
    then betreuer_haftet_fuer_schaden(b, betreuter);
}
pub relation mehrere_betreuer_nebeneinander_verantwortlich(betreuter: Person) kind institutional {
    label de official "Mehrere Betreuer haften als Gesamtschuldner (§ 1826 Absatz 2)";
    label en unofficial "several custodians are liable as joint debtors (§ 1826 (2))";
}
@source(BGB_P1826)
rule GesamtschuldnerischeHaftungMehrererBetreuer(b1: Person, b2: Person, betreuter: Person) strict {
    label de official "Sind für den Schaden mehrere Betreuer nebeneinander verantwortlich, haften sie als Gesamtschuldner (§ 1826 Absatz 2)";
    label en unofficial "where several custodians are jointly responsible for the loss, they are liable as joint debtors (§ 1826 (2))";
    when betreuer_haftet_fuer_schaden(b1, betreuter) and betreuer_haftet_fuer_schaden(b2, betreuter) and b1 != b2;
    then mehrere_betreuer_nebeneinander_verantwortlich(betreuter);
}

// § 1827: Patientenverfügung; Behandlungswünsche oder mutmaßlicher Wille — Wertungskern.

pub relation patientenverfuegung_vorhanden(betreuter: Person) kind empirical {
    label de official "Der Betreute hat als einwilligungsfähiger Volljähriger eine schriftliche Patientenverfügung errichtet (§ 1827 Absatz 1 Satz 1)";
    label en unofficial "the represented person, while capable of consenting as an adult, has made a written advance directive (§ 1827 (1) sentence 1)";
}
@source(BGB_P1827)
pub external judgment relation festlegungen_treffen_auf_aktuelle_situation_zu(betreuter: Person) {
    authority Court;
    label de official "Die Festlegungen der Patientenverfügung treffen auf die aktuelle Lebens- und Behandlungssituation zu (§ 1827 Absatz 1 Satz 1)";
    label en unofficial "the directive's stipulations apply to the current living and treatment situation (§ 1827 (1) sentence 1)";
}
pub relation dem_patientenwillen_ausdruck_und_geltung_zu_verschaffen(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat dem Willen des Betreuten Ausdruck und Geltung zu verschaffen (§ 1827 Absatz 1 Satz 2)";
    label en unofficial "the custodian must give expression and effect to the represented person's will (§ 1827 (1) sentence 2)";
}
@source(BGB_P1827)
rule PatientenwilleGeltendMachen(b: Person, betreuter: Person) strict {
    label de official "Prüft der Betreuer, dass die Festlegungen der Patientenverfügung auf die aktuelle Situation zutreffen, hat er dem Willen des Betreuten Ausdruck und Geltung zu verschaffen (§ 1827 Absatz 1)";
    label en unofficial "once the custodian confirms the directive's stipulations apply to the current situation, they must give expression and effect to the represented person's will (§ 1827 (1))";
    when gesetzlicher_vertreter(b, betreuter) and patientenverfuegung_vorhanden(betreuter) and festlegungen_treffen_auf_aktuelle_situation_zu(betreuter);
    then dem_patientenwillen_ausdruck_und_geltung_zu_verschaffen(b, betreuter);
}
@source(BGB_P1827)
pub external judgment relation behandlungswuensche_oder_mutmasslicher_wille_1827(betreuter: Person) {
    authority Court;
    label de official "Behandlungswünsche oder mutmaßlicher Wille des Betreuten, aufgrund konkreter Anhaltspunkte ermittelt (§ 1827 Absatz 2)";
    label en unofficial "the represented person's treatment wishes or presumed will, ascertained from concrete indications (§ 1827 (2))";
}
pub relation entscheidung_ueber_einwilligung_nach_behandlungswunsch(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer entscheidet auf Grundlage der Behandlungswünsche oder des mutmaßlichen Willens, ob er in die ärztliche Maßnahme einwilligt oder sie untersagt (§ 1827 Absatz 2)";
    label en unofficial "the custodian decides, on the basis of the treatment wishes or presumed will, whether to consent to or refuse the medical measure (§ 1827 (2))";
}
@source(BGB_P1827)
rule EntscheidungOhnePatientenverfuegung(b: Person, betreuter: Person) strict {
    label de official "Liegt keine Patientenverfügung vor oder treffen ihre Festlegungen nicht auf die aktuelle Situation zu, entscheidet der Betreuer nach den Behandlungswünschen oder dem mutmaßlichen Willen (§ 1827 Absatz 2)";
    label en unofficial "where no directive exists or its stipulations do not apply to the current situation, the custodian decides on the basis of the treatment wishes or presumed will (§ 1827 (2))";
    when gesetzlicher_vertreter(b, betreuter) and behandlungswuensche_oder_mutmasslicher_wille_1827(betreuter) and not_known(festlegungen_treffen_auf_aktuelle_situation_zu(betreuter));
    then entscheidung_ueber_einwilligung_nach_behandlungswunsch(b, betreuter);
}

// § 1828: Gespräch zur Feststellung des Patientenwillens.

pub relation aerztliche_massnahme_indiziert(patient: Person, arzt: Person) kind empirical {
    label de official "Der behandelnde Arzt hält eine ärztliche Maßnahme im Hinblick auf Gesamtzustand und Prognose für indiziert (§ 1828 Absatz 1 Satz 1)";
    label en unofficial "the treating physician considers a medical measure indicated in view of the overall condition and prognosis (§ 1828 (1) sentence 1)";
}
pub relation eroerterung_zwischen_arzt_und_betreuer(patient: Person, arzt: Person, b: Person) kind institutional {
    label de official "Arzt und Betreuer erörtern die Maßnahme unter Berücksichtigung des Patientenwillens als Grundlage der Entscheidung nach § 1827 (§ 1828 Absatz 1)";
    label en unofficial "the physician and custodian discuss the measure, having regard to the patient's will, as the basis for the decision under § 1827 (§ 1828 (1))";
}
@source(BGB_P1828)
rule EroerterungArztUndBetreuer(patient: Person, arzt: Person, b: Person) strict {
    label de official "Der behandelnde Arzt und der Betreuer erörtern die indizierte Maßnahme unter Berücksichtigung des Patientenwillens (§ 1828 Absatz 1)";
    label en unofficial "the treating physician and the custodian discuss the indicated measure having regard to the patient's will (§ 1828 (1))";
    when aerztliche_massnahme_indiziert(patient, arzt) and gesetzlicher_vertreter(b, patient);
    then eroerterung_zwischen_arzt_und_betreuer(patient, arzt, b);
}

// § 1829: Genehmigung des Betreuungsgerichts bei ärztlichen Maßnahmen.

pub relation begruendete_todes_oder_schwerschadensgefahr_bei_massnahme(b: Person, betreuter: Person) kind empirical {
    label de official "Begründete Gefahr, dass der Betreute aufgrund der Maßnahme stirbt oder einen schweren und länger dauernden gesundheitlichen Schaden erleidet (§ 1829 Absatz 1 Satz 1)";
    label en unofficial "a well-founded risk that the represented person will die or suffer serious, lasting health damage as a result of the measure (§ 1829 (1) sentence 1)";
}
pub relation einwilligung_des_betreuers_in_massnahme(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer willigt in die Untersuchung, Heilbehandlung oder den ärztlichen Eingriff ein (§ 1829 Absatz 1)";
    label en unofficial "the custodian consents to the examination, treatment or medical procedure (§ 1829 (1))";
}
pub relation genehmigung_1829_erforderlich(b: Person, betreuter: Person) kind institutional {
    label de official "Die Einwilligung des Betreuers bedarf der Genehmigung des Betreuungsgerichts (§ 1829 Absatz 1 Satz 1)";
    label en unofficial "the custodian's consent requires the custody court's approval (§ 1829 (1) sentence 1)";
}
@source(BGB_P1829)
rule Genehmigung1829Erforderlich(b: Person, betreuter: Person) strict {
    label de official "Die Einwilligung des Betreuers in eine Maßnahme mit begründeter Todes- oder Schwerschadensgefahr bedarf der Genehmigung des Betreuungsgerichts (§ 1829 Absatz 1)";
    label en unofficial "the custodian's consent to a measure carrying a well-founded risk of death or serious lasting damage requires the custody court's approval (§ 1829 (1))";
    when einwilligung_des_betreuers_in_massnahme(b, betreuter) and begruendete_todes_oder_schwerschadensgefahr_bei_massnahme(b, betreuter);
    then genehmigung_1829_erforderlich(b, betreuter);
}
pub relation aufschub_gefahr_verbunden_1829(b: Person, betreuter: Person) kind empirical {
    label de official "Mit dem Aufschub der Maßnahme ist Gefahr verbunden (§ 1829 Absatz 1 Satz 2)";
    label en unofficial "delaying the measure would entail danger (§ 1829 (1) sentence 2)";
}
pub relation massnahme_ohne_genehmigung_zulaessig_1829(b: Person, betreuter: Person) kind institutional {
    label de official "Ohne die Genehmigung darf die Maßnahme durchgeführt werden, weil mit dem Aufschub Gefahr verbunden ist (§ 1829 Absatz 1 Satz 2)";
    label en unofficial "the measure may be carried out without approval because delay would entail danger (§ 1829 (1) sentence 2)";
}
@source(BGB_P1829)
rule MassnahmeOhneGenehmigungBeiGefahrImVerzug(b: Person, betreuter: Person) strict {
    label de official "Ohne die Genehmigung darf die Maßnahme nur durchgeführt werden, wenn mit dem Aufschub Gefahr verbunden ist (§ 1829 Absatz 1 Satz 2)";
    label en unofficial "without approval, the measure may only be carried out if delay entails danger (§ 1829 (1) sentence 2)";
    when genehmigung_1829_erforderlich(b, betreuter) and aufschub_gefahr_verbunden_1829(b, betreuter);
    then massnahme_ohne_genehmigung_zulaessig_1829(b, betreuter);
}
@source(BGB_P1829)
pub external judgment relation entspricht_willen_des_betreuten_1829(b: Person, betreuter: Person) {
    authority Court;
    label de official "Die Einwilligung, Nichteinwilligung oder der Widerruf entspricht dem Willen des Betreuten (§ 1829 Absatz 3)";
    label en unofficial "the consent, non-consent or revocation corresponds to the represented person's will (§ 1829 (3))";
}
pub relation genehmigung_1829_zu_erteilen(b: Person, betreuter: Person) kind institutional {
    label de official "Die Genehmigung ist zu erteilen (§ 1829 Absatz 3)";
    label en unofficial "the approval must be granted (§ 1829 (3))";
}
@source(BGB_P1829)
rule GenehmigungZuErteilenBeiUebereinstimmungMitWillen(b: Person, betreuter: Person) strict {
    label de official "Die Genehmigung ist zu erteilen, wenn die Einwilligung, Nichteinwilligung oder der Widerruf dem Willen des Betreuten entspricht (§ 1829 Absatz 3)";
    label en unofficial "the approval must be granted where the consent, non-consent or revocation corresponds to the represented person's will (§ 1829 (3))";
    when genehmigung_1829_erforderlich(b, betreuter) and entspricht_willen_des_betreuten_1829(b, betreuter);
    then genehmigung_1829_zu_erteilen(b, betreuter);
}

// § 1830: Sterilisation — closed list of five cumulative conditions.

pub relation sterilisation_entspricht_natuerlichem_willen(betreuter: Person) kind empirical {
    label de official "Die Sterilisation entspricht dem natürlichen Willen des Betreuten (§ 1830 Absatz 1 Nummer 1)";
    label en unofficial "the sterilisation corresponds to the represented person's natural will (§ 1830 (1) no. 1)";
}
pub relation betreuter_bleibt_dauerhaft_einwilligungsunfaehig(betreuter: Person) kind empirical {
    label de official "Der Betreute wird auf Dauer einwilligungsunfähig bleiben (§ 1830 Absatz 1 Nummer 2)";
    label en unofficial "the represented person will remain permanently incapable of consent (§ 1830 (1) no. 2)";
}
pub relation ohne_sterilisation_schwangerschaft_anzunehmen(betreuter: Person) kind empirical {
    label de official "Es ist anzunehmen, dass es ohne die Sterilisation zu einer Schwangerschaft kommen würde (§ 1830 Absatz 1 Nummer 3)";
    label en unofficial "it is to be assumed that pregnancy would occur without the sterilisation (§ 1830 (1) no. 3)";
}
pub relation schwangerschaft_gefaehrdet_leben_oder_gesundheit_unabwendbar(betreuter: Person) kind empirical {
    label de official "Infolge der Schwangerschaft wäre eine Lebensgefahr oder eine schwerwiegende Beeinträchtigung des körperlichen oder seelischen Gesundheitszustands zu erwarten, nicht auf zumutbare Weise abwendbar (§ 1830 Absatz 1 Nummer 4)";
    label en unofficial "the pregnancy would foreseeably endanger life or seriously impair physical or mental health, and this cannot reasonably be averted (§ 1830 (1) no. 4)";
}
pub relation schwangerschaft_nicht_durch_andere_zumutbare_mittel_verhinderbar(betreuter: Person) kind empirical {
    label de official "Die Schwangerschaft kann nicht durch andere zumutbare Mittel verhindert werden (§ 1830 Absatz 1 Nummer 5)";
    label en unofficial "the pregnancy cannot be prevented by other reasonable means (§ 1830 (1) no. 5)";
}
pub relation sterilisationseinwilligung_zulaessig(sb: Person, betreuter: Person) kind institutional {
    label de official "Die Einwilligung des Sterilisationsbetreuers ist zulässig (§ 1830 Absatz 1)";
    label en unofficial "the sterilisation custodian's consent is permissible (§ 1830 (1))";
}
pub relation sterilisationsbetreuer_bestellt(sb: Person, betreuter: Person) kind empirical {
    label de official "Der besondere Sterilisationsbetreuer nach § 1817 Absatz 2 ist bestellt";
    label en unofficial "the special sterilisation custodian under § 1817 (2) has been appointed";
}
@source(BGB_P1830)
rule SterilisationseinwilligungZulaessig(sb: Person, betreuter: Person) strict {
    label de official "Die Einwilligung eines Sterilisationsbetreuers ist nur zulässig, wenn alle fünf Voraussetzungen des § 1830 Absatz 1 kumulativ vorliegen";
    label en unofficial "the sterilisation custodian's consent is only permissible where all five requirements of § 1830 (1) are cumulatively met";
    when sterilisationsbetreuer_bestellt(sb, betreuter)
        and sterilisation_entspricht_natuerlichem_willen(betreuter)
        and betreuter_bleibt_dauerhaft_einwilligungsunfaehig(betreuter)
        and ohne_sterilisation_schwangerschaft_anzunehmen(betreuter)
        and schwangerschaft_gefaehrdet_leben_oder_gesundheit_unabwendbar(betreuter)
        and schwangerschaft_nicht_durch_andere_zumutbare_mittel_verhinderbar(betreuter);
    then sterilisationseinwilligung_zulaessig(sb, betreuter);
}

pub relation sterilisationsgenehmigung_wirksam_am(sb: Person, betreuter: Person, f: Frist) kind empirical {
    key(f);
    label de official "Frist von zwei Wochen ab Wirksamkeit der Genehmigung, vor deren Ablauf die Sterilisation nicht durchgeführt werden darf (§ 1830 Absatz 2 Satz 2)";
    label en unofficial "two-week period from the approval taking effect, before whose expiry the sterilisation may not be carried out (§ 1830 (2) sentence 2)";
}
@source(BGB_P1830) {
    rule SterilisationswartefristEreignis(f: Frist, t: Date) strict {
        label de official "Die Wartefrist beginnt mit der Wirksamkeit der Genehmigung (§ 1830 Absatz 2 Satz 2)";
        label en unofficial "the waiting period begins when the approval takes effect (§ 1830 (2) sentence 2)";
        when sterilisationsgenehmigung_wirksam_am(_, _, f) and genehmigung_wirksam_am(f, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
    rule SterilisationswartefristDauer(f: Frist) strict {
        label de official "Die Sterilisation darf erst zwei Wochen nach Wirksamkeit der Genehmigung durchgeführt werden (§ 1830 Absatz 2 Satz 2)";
        label en unofficial "the sterilisation may only be carried out two weeks after the approval takes effect (§ 1830 (2) sentence 2)";
        when sterilisationsgenehmigung_wirksam_am(_, _, f);
        then de.bgb.fristen::frist_dauer_tage(f, 14 calendar_day);
    }
}
pub relation genehmigung_wirksam_am(f: Frist, tag: Date) kind empirical {
    key(f);
    label de official "Tag, an dem die Genehmigung des Betreuungsgerichts zur Sterilisation wirksam wird (§ 1830 Absatz 2 Satz 1)";
    label en unofficial "day on which the custody court's approval of the sterilisation takes effect (§ 1830 (2) sentence 1)";
}
pub relation sterilisation_vor_fristablauf_unzulaessig(sb: Person, betreuter: Person, f: Frist) kind institutional {
    label de official "Die Sterilisation vor Ablauf der Zwei-Wochen-Frist ist unzulässig (§ 1830 Absatz 2 Satz 2)";
    label en unofficial "carrying out the sterilisation before the two-week period expires is impermissible (§ 1830 (2) sentence 2)";
}
@source(BGB_P1830)
rule SterilisationVorFristablaufUnzulaessig(sb: Person, betreuter: Person, f: Frist, vorgesehener_tag: Date, e: Date) strict {
    label de official "Die Sterilisation darf erst zwei Wochen nach Wirksamkeit der Genehmigung durchgeführt werden; vorher ist sie unzulässig (§ 1830 Absatz 2 Satz 2)";
    label en unofficial "the sterilisation may only be carried out two weeks after the approval takes effect; before that it is impermissible (§ 1830 (2) sentence 2)";
    when sterilisationsgenehmigung_wirksam_am(sb, betreuter, f) and de.bgb.fristen::frist_ende(f, e) and sterilisation_vorgesehen_am(f, vorgesehener_tag) and vorgesehener_tag < e;
    then sterilisation_vor_fristablauf_unzulaessig(sb, betreuter, f);
}
pub relation sterilisation_vorgesehen_am(f: Frist, tag: Date) kind empirical {
    label de official "Tag, an dem die Sterilisation vorgenommen werden soll";
    label en unofficial "day on which the sterilisation is scheduled to be performed";
}

// § 1831: Freiheitsentziehende Unterbringung und freiheitsentziehende Maßnahmen.

pub relation gefahr_selbsttoetung_oder_erheblicher_gesundheitsschaden(betreuter: Person) kind empirical {
    label de official "Gefahr, dass sich der Betreute aufgrund psychischer Krankheit oder geistiger/seelischer Behinderung selbst tötet oder erheblichen gesundheitlichen Schaden zufügt (§ 1831 Absatz 1 Nummer 1)";
    label en unofficial "risk that, due to mental illness or intellectual/psychological disability, the represented person will kill themself or cause themself serious health damage (§ 1831 (1) no. 1)";
}
pub relation massnahme_nur_mit_unterbringung_durchfuehrbar(betreuter: Person) kind empirical {
    label de official "Eine Untersuchung, Heilbehandlung oder ärztlicher Eingriff zur Abwendung eines drohenden erheblichen gesundheitlichen Schadens ist notwendig, ohne Unterbringung nicht durchführbar, und der Betreute erkennt die Notwendigkeit nicht oder handelt nicht danach (§ 1831 Absatz 1 Nummer 2)";
    label en unofficial "an examination, treatment or procedure to avert imminent serious health damage is necessary, cannot be carried out without placement, and the represented person cannot recognise this necessity or act on it (§ 1831 (1) no. 2)";
}
pub relation unterbringung_erforderlich(betreuter: Person) kind institutional {
    label de official "Die freiheitsentziehende Unterbringung ist erforderlich und deshalb zulässig, soweit im Übrigen genehmigt (§ 1831 Absatz 1)";
    label en unofficial "the deprivation-of-liberty placement is necessary and therefore permissible, subject to approval (§ 1831 (1))";
}
@source(BGB_P1831) {
    rule UnterbringungErforderlichSelbstgefaehrdung(betreuter: Person) strict {
        label de official "Die Unterbringung ist erforderlich bei Gefahr der Selbsttötung oder erheblichen Gesundheitsschadens (§ 1831 Absatz 1 Nummer 1)";
        label en unofficial "placement is necessary where there is a risk of suicide or serious self-inflicted health damage (§ 1831 (1) no. 1)";
        when gefahr_selbsttoetung_oder_erheblicher_gesundheitsschaden(betreuter);
        then unterbringung_erforderlich(betreuter);
    }
    rule UnterbringungErforderlichHeilbehandlung(betreuter: Person) strict {
        label de official "Die Unterbringung ist erforderlich, wenn eine notwendige Maßnahme ohne sie nicht durchführbar ist (§ 1831 Absatz 1 Nummer 2)";
        label en unofficial "placement is necessary where a required measure cannot be carried out without it (§ 1831 (1) no. 2)";
        when massnahme_nur_mit_unterbringung_durchfuehrbar(betreuter);
        then unterbringung_erforderlich(betreuter);
    }
}
pub relation unterbringung_durch_betreuer(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer bringt den Betreuten mit Freiheitsentziehung unter (§ 1831 Absatz 1)";
    label en unofficial "the custodian places the represented person with deprivation of liberty (§ 1831 (1))";
}
pub relation unterbringungsgenehmigung_erteilt(b: Person, betreuter: Person) kind empirical {
    label de official "Das Betreuungsgericht hat die Unterbringung genehmigt (§ 1831 Absatz 2 Satz 1) — festgestellte Tatsache, im Fall origin adjudicated";
    label en unofficial "the custody court has approved the placement (§ 1831 (2) sentence 1) — established fact, in the case origin adjudicated";
}
pub relation unterbringung_zulaessig(b: Person, betreuter: Person) kind institutional {
    label de official "Die Unterbringung ist zulässig (§ 1831 Absatz 1, 2)";
    label en unofficial "the placement is permissible (§ 1831 (1), (2))";
}
@source(BGB_P1831)
rule UnterbringungZulaessigMitGenehmigung(b: Person, betreuter: Person) strict {
    label de official "Die Unterbringung ist nur zulässig, solange sie erforderlich ist und das Betreuungsgericht sie genehmigt hat (§ 1831 Absatz 1, 2 Satz 1)";
    label en unofficial "placement is only permissible so long as it is necessary and the custody court has approved it (§ 1831 (1), (2) sentence 1)";
    when unterbringung_durch_betreuer(b, betreuter) and unterbringung_erforderlich(betreuter) and unterbringungsgenehmigung_erteilt(b, betreuter);
    then unterbringung_zulaessig(b, betreuter);
}
pub relation aufschub_gefahr_verbunden_1831(b: Person, betreuter: Person) kind empirical {
    label de official "Mit dem Aufschub der Unterbringung ist Gefahr verbunden (§ 1831 Absatz 2 Satz 2)";
    label en unofficial "delaying the placement would entail danger (§ 1831 (2) sentence 2)";
}
@source(BGB_P1831)
rule UnterbringungZulaessigOhneGenehmigungBeiGefahrImVerzug(b: Person, betreuter: Person) strict {
    label de official "Ohne die Genehmigung ist die Unterbringung nur zulässig, wenn mit dem Aufschub Gefahr verbunden ist; die Genehmigung ist unverzüglich nachzuholen (§ 1831 Absatz 2 Satz 2)";
    label en unofficial "without approval, placement is only permissible where delay entails danger; approval must be obtained without delay afterwards (§ 1831 (2) sentence 2)";
    when unterbringung_durch_betreuer(b, betreuter) and unterbringung_erforderlich(betreuter) and aufschub_gefahr_verbunden_1831(b, betreuter);
    then unterbringung_zulaessig(b, betreuter);
}
pub relation voraussetzungen_der_unterbringung_weggefallen(b: Person, betreuter: Person) kind empirical {
    label de official "Die Voraussetzungen der Unterbringung sind weggefallen (§ 1831 Absatz 3 Satz 1)";
    label en unofficial "the requirements for the placement have ceased to exist (§ 1831 (3) sentence 1)";
}
pub relation betreuer_hat_unterbringung_zu_beenden(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat die Unterbringung zu beenden und dies dem Betreuungsgericht unverzüglich anzuzeigen (§ 1831 Absatz 3)";
    label en unofficial "the custodian must end the placement and notify the custody court without delay (§ 1831 (3))";
}
@source(BGB_P1831)
rule BeendigungDerUnterbringung(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer hat die Unterbringung zu beenden, wenn ihre Voraussetzungen weggefallen sind (§ 1831 Absatz 3 Satz 1)";
    label en unofficial "the custodian must end the placement once its requirements have ceased to exist (§ 1831 (3) sentence 1)";
    when voraussetzungen_der_unterbringung_weggefallen(b, betreuter);
    then betreuer_hat_unterbringung_zu_beenden(b, betreuter);
}
pub relation freiheitsentziehung_durch_mechanische_vorrichtung_oder_medikament(b: Person, betreuter: Person) kind empirical {
    label de official "Dem Betreuten soll in einer Einrichtung über einen längeren Zeitraum oder regelmäßig durch mechanische Vorrichtungen, Medikamente oder auf andere Weise die Freiheit entzogen werden (§ 1831 Absatz 4)";
    label en unofficial "the represented person, while in an institution, is to have their liberty taken away over a longer period or regularly by mechanical devices, medication or other means (§ 1831 (4))";
}
pub relation absaetze_1_bis_3_entsprechend_anwendbar_1831abs4(b: Person, betreuter: Person) kind institutional {
    label de official "Die Absätze 1 bis 3 gelten für diese Maßnahme entsprechend (§ 1831 Absatz 4)";
    label en unofficial "paragraphs 1 to 3 apply correspondingly to this measure (§ 1831 (4))";
}
@source(BGB_P1831)
rule Absatz4EntsprechendeAnwendung(b: Person, betreuter: Person) strict {
    label de official "Absätze 1 bis 3 gelten entsprechend für die dauerhafte oder regelmäßige Freiheitsentziehung durch mechanische Vorrichtungen, Medikamente oder auf andere Weise (§ 1831 Absatz 4)";
    label en unofficial "paragraphs 1 to 3 apply correspondingly to the sustained or regular deprivation of liberty by mechanical devices, medication or other means (§ 1831 (4))";
    when freiheitsentziehung_durch_mechanische_vorrichtung_oder_medikament(b, betreuter);
    then absaetze_1_bis_3_entsprechend_anwendbar_1831abs4(b, betreuter);
}

// § 1832: Ärztliche Zwangsmaßnahmen — sieben kumulative Voraussetzungen.

pub relation notwendig_zur_abwendung_drohenden_erheblichen_gesundheitsschadens(betreuter: Person) kind empirical {
    label de official "Die ärztliche Zwangsmaßnahme ist notwendig, um einen drohenden erheblichen gesundheitlichen Schaden abzuwenden (§ 1832 Absatz 1 Nummer 1)";
    label en unofficial "the forced medical measure is necessary to avert imminent serious health damage (§ 1832 (1) no. 1)";
}
pub relation kann_notwendigkeit_nicht_erkennen_wegen_krankheit(betreuter: Person) kind empirical {
    label de official "Der Betreute kann die Notwendigkeit der ärztlichen Maßnahme wegen psychischer Krankheit oder geistiger/seelischer Behinderung nicht erkennen oder nicht danach handeln (§ 1832 Absatz 1 Nummer 2)";
    label en unofficial "due to mental illness or intellectual/psychological disability, the represented person cannot recognise the necessity of the medical measure or act on it (§ 1832 (1) no. 2)";
}
pub relation entspricht_1827_willen(betreuter: Person) kind empirical {
    label de official "Die ärztliche Zwangsmaßnahme entspricht dem nach § 1827 zu beachtenden Willen des Betreuten (§ 1832 Absatz 1 Nummer 3)";
    label en unofficial "the forced medical measure corresponds to the represented person's will as to be respected under § 1827 (§ 1832 (1) no. 3)";
}
pub relation ernsthaft_versucht_zu_ueberzeugen(betreuter: Person) kind empirical {
    label de official "Zuvor wurde ernsthaft, mit dem nötigen Zeitaufwand und ohne unzulässigen Druck versucht, den Betreuten zu überzeugen (§ 1832 Absatz 1 Nummer 4)";
    label en unofficial "a serious prior attempt, taking the necessary time and without impermissible pressure, was made to convince the represented person (§ 1832 (1) no. 4)";
}
pub relation kein_milderes_mittel_verfuegbar(betreuter: Person) kind empirical {
    label de official "Der drohende erhebliche gesundheitliche Schaden kann durch keine andere, weniger belastende Maßnahme abgewendet werden (§ 1832 Absatz 1 Nummer 5)";
    label en unofficial "the imminent serious health damage cannot be averted by any other, less burdensome measure (§ 1832 (1) no. 5)";
}
pub relation nutzen_ueberwiegt_beeintraechtigung_deutlich(betreuter: Person) kind empirical {
    label de official "Der zu erwartende Nutzen überwiegt die zu erwartenden Beeinträchtigungen deutlich (§ 1832 Absatz 1 Nummer 6)";
    label en unofficial "the expected benefit clearly outweighs the expected impairments (§ 1832 (1) no. 6)";
}
pub relation durchfuehrung_im_geeigneten_krankenhaus(betreuter: Person) kind empirical {
    label de official "Die Maßnahme wird im Rahmen eines stationären Aufenthalts in einem Krankenhaus mit gesicherter medizinischer Versorgung einschließlich Nachbehandlung durchgeführt (§ 1832 Absatz 1 Nummer 7)";
    label en unofficial "the measure is carried out during an inpatient stay in a hospital with assured medical care including necessary aftercare (§ 1832 (1) no. 7)";
}
pub relation aerztliche_zwangsmassnahme_einwilligungsfaehig(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer kann in die ärztliche Zwangsmaßnahme einwilligen (§ 1832 Absatz 1)";
    label en unofficial "the custodian may consent to the forced medical measure (§ 1832 (1))";
}
@source(BGB_P1832)
rule AerztlicheZwangsmassnahmeEinwilligungsfaehig(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer kann in die ärztliche Zwangsmaßnahme nur einwilligen, wenn alle sieben Voraussetzungen des § 1832 Absatz 1 kumulativ vorliegen";
    label en unofficial "the custodian may only consent to the forced medical measure where all seven requirements of § 1832 (1) are cumulatively met";
    when gesetzlicher_vertreter(b, betreuter)
        and notwendig_zur_abwendung_drohenden_erheblichen_gesundheitsschadens(betreuter)
        and kann_notwendigkeit_nicht_erkennen_wegen_krankheit(betreuter)
        and entspricht_1827_willen(betreuter)
        and ernsthaft_versucht_zu_ueberzeugen(betreuter)
        and kein_milderes_mittel_verfuegbar(betreuter)
        and nutzen_ueberwiegt_beeintraechtigung_deutlich(betreuter)
        and durchfuehrung_im_geeigneten_krankenhaus(betreuter);
    then aerztliche_zwangsmassnahme_einwilligungsfaehig(b, betreuter);
}
pub relation zwangsmassnahmengenehmigung_erteilt(b: Person, betreuter: Person) kind empirical {
    label de official "Das Betreuungsgericht hat die Einwilligung in die ärztliche Zwangsmaßnahme genehmigt (§ 1832 Absatz 2) — festgestellte Tatsache, im Fall origin adjudicated";
    label en unofficial "the custody court has approved the consent to the forced medical measure (§ 1832 (2)) — established fact, in the case origin adjudicated";
}
pub relation aerztliche_zwangsmassnahme_zulaessig(b: Person, betreuter: Person) kind institutional {
    label de official "Die ärztliche Zwangsmaßnahme ist zulässig (§ 1832 Absatz 1, 2)";
    label en unofficial "the forced medical measure is permissible (§ 1832 (1), (2))";
}
@source(BGB_P1832)
rule AerztlicheZwangsmassnahmeZulaessig(b: Person, betreuter: Person) strict {
    label de official "Die Einwilligung in die ärztliche Zwangsmaßnahme bedarf der Genehmigung des Betreuungsgerichts; erst mit ihr ist die Maßnahme zulässig (§ 1832 Absatz 2)";
    label en unofficial "consent to the forced medical measure requires the custody court's approval; only then is the measure permissible (§ 1832 (2))";
    when aerztliche_zwangsmassnahme_einwilligungsfaehig(b, betreuter) and zwangsmassnahmengenehmigung_erteilt(b, betreuter);
    then aerztliche_zwangsmassnahme_zulaessig(b, betreuter);
}
pub relation voraussetzungen_der_zwangsmassnahme_weggefallen(b: Person, betreuter: Person) kind empirical {
    label de official "Die Voraussetzungen der ärztlichen Zwangsmaßnahme sind weggefallen (§ 1832 Absatz 3 Satz 1)";
    label en unofficial "the requirements for the forced medical measure have ceased to exist (§ 1832 (3) sentence 1)";
}
pub relation betreuer_hat_einwilligung_zu_widerrufen(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer hat die Einwilligung zu widerrufen und den Widerruf dem Betreuungsgericht unverzüglich anzuzeigen (§ 1832 Absatz 3)";
    label en unofficial "the custodian must revoke the consent and notify the custody court of the revocation without delay (§ 1832 (3))";
}
@source(BGB_P1832)
rule WiderrufDerEinwilligungBeiWegfall(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer hat die Einwilligung in die ärztliche Zwangsmaßnahme zu widerrufen, wenn ihre Voraussetzungen weggefallen sind (§ 1832 Absatz 3 Satz 1)";
    label en unofficial "the custodian must revoke consent to the forced medical measure once its requirements have ceased to exist (§ 1832 (3) sentence 1)";
    when voraussetzungen_der_zwangsmassnahme_weggefallen(b, betreuter);
    then betreuer_hat_einwilligung_zu_widerrufen(b, betreuter);
}

// § 1833: Aufgabe von Wohnraum des Betreuten.

pub relation aufgabe_von_selbst_genutztem_wohnraum(b: Person, betreuter: Person) kind empirical {
    label de official "Der Betreuer beabsichtigt oder bewirkt die Aufgabe von vom Betreuten selbst genutztem Wohnraum (§ 1833 Absatz 1)";
    label en unofficial "the custodian intends or effects giving up housing used by the represented person themself (§ 1833 (1))";
}
pub relation finanzierung_trotz_ausschoepfung_nicht_moeglich(betreuter: Person) kind empirical {
    label de official "Eine Finanzierung des Wohnraums ist trotz Ausschöpfung aller verfügbaren Ressourcen nicht möglich (§ 1833 Absatz 1 Satz 2 Alternative 1)";
    label en unofficial "financing the housing is not possible despite exhausting all available resources (§ 1833 (1) sentence 2 alternative 1)";
}
pub relation haeusliche_versorgung_fuehrt_zu_erheblicher_gefaehrdung(betreuter: Person) kind empirical {
    label de official "Eine häusliche Versorgung würde trotz umfassender Zuhilfenahme ambulanter Dienste zu einer erheblichen gesundheitlichen Gefährdung führen (§ 1833 Absatz 1 Satz 2 Alternative 2)";
    label en unofficial "at-home care would, despite comprehensive use of outpatient services, lead to substantial health risk (§ 1833 (1) sentence 2 alternative 2)";
}
pub relation gefaehrdung_1821_abs3_nr1_liegt_vor(betreuter: Person) kind institutional {
    label de official "Eine Gefährdung im Sinne des § 1821 Absatz 3 Nummer 1 liegt vor (§ 1833 Absatz 1 Satz 2)";
    label en unofficial "a danger within the meaning of § 1821 (3) no. 1 exists (§ 1833 (1) sentence 2)";
}
@source(BGB_P1833) {
    rule GefaehrdungBeiFinanzierungsunmoeglichkeit(betreuter: Person) strict {
        label de official "Eine Gefährdung im Sinne des § 1821 Absatz 3 Nummer 1 liegt vor, wenn die Finanzierung des Wohnraums trotz Ausschöpfung aller Ressourcen nicht möglich ist (§ 1833 Absatz 1 Satz 2)";
        label en unofficial "a danger under § 1821 (3) no. 1 exists where financing the housing is impossible despite exhausting all resources (§ 1833 (1) sentence 2)";
        when finanzierung_trotz_ausschoepfung_nicht_moeglich(betreuter);
        then gefaehrdung_1821_abs3_nr1_liegt_vor(betreuter);
    }
    rule GefaehrdungBeiUnzureichenderHaeuslicherVersorgung(betreuter: Person) strict {
        label de official "Eine Gefährdung liegt vor, wenn die häusliche Versorgung trotz umfassender ambulanter Hilfen zu einer erheblichen gesundheitlichen Gefährdung führen würde (§ 1833 Absatz 1 Satz 2)";
        label en unofficial "a danger exists where at-home care would, despite comprehensive outpatient assistance, lead to substantial health risk (§ 1833 (1) sentence 2)";
        when haeusliche_versorgung_fuehrt_zu_erheblicher_gefaehrdung(betreuter);
        then gefaehrdung_1821_abs3_nr1_liegt_vor(betreuter);
    }
}
pub relation genehmigung_1833_erforderlich(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer bedarf bei vom Betreuten selbst genutztem Wohnraum der Genehmigung des Betreuungsgerichts zur Kündigung, Aufhebung, Vermietung oder Grundstücksverfügung (§ 1833 Absatz 3)";
    label en unofficial "for housing used by the represented person themself, the custodian requires the custody court's approval to terminate, end, let out or dispose of the property (§ 1833 (3))";
}
pub relation vormund_oder_betreuer_kuendigt_selbst_genutzten_wohnraum(b: Person, betreuter: Person) kind empirical {
    label de official "Der gesetzliche Vertreter beabsichtigt die Kündigung, eine auf Vertragsaufhebung gerichtete Erklärung, die Vermietung oder eine damit verbundene Grundstücksverfügung betreffend vom Betreuten selbst genutzten Wohnraum (§ 1833 Absatz 3)";
    label en unofficial "the statutory representative intends termination, a declaration aiming at rescission, letting out, or a related disposition of the property concerning housing used by the represented person themself (§ 1833 (3))";
}
@source(BGB_P1833)
rule Genehmigung1833Erforderlich(b: Person, betreuter: Person) strict {
    label de official "Der Betreuer bedarf bei vom Betreuten selbst genutztem Wohnraum der Genehmigung des Betreuungsgerichts (§ 1833 Absatz 3)";
    label en unofficial "for housing used by the represented person themself, the custodian requires the custody court's approval (§ 1833 (3))";
    when vormund_oder_betreuer_kuendigt_selbst_genutzten_wohnraum(b, betreuter);
    then genehmigung_1833_erforderlich(b, betreuter);
}

// § 1834: Bestimmung des Umgangs und des Aufenthalts des Betreuten.

pub relation betreuter_wuenscht_umgangsbestimmung(betreuter: Person) kind empirical {
    label de official "Der Betreute wünscht die Bestimmung des Umgangs mit anderen Personen (§ 1834 Absatz 1 Alternative 1)";
    label en unofficial "the represented person wishes contact with other persons to be determined (§ 1834 (1) alternative 1)";
}
pub relation umgang_droht_konkrete_gefaehrdung(betreuter: Person) kind empirical {
    label de official "Dem Betreuten droht durch den Umgang eine konkrete Gefährdung im Sinne des § 1821 Absatz 3 Nummer 1 (§ 1834 Absatz 1 Alternative 2)";
    label en unofficial "the represented person faces a concrete danger under § 1821 (3) no. 1 from the contact (§ 1834 (1) alternative 2)";
}
pub relation betreuer_darf_umgang_bestimmen(b: Person, betreuter: Person) kind institutional {
    label de official "Der Betreuer darf den Umgang mit Wirkung für und gegen Dritte bestimmen (§ 1834 Absatz 1)";
    label en unofficial "the custodian may determine contact with effect for and against third parties (§ 1834 (1))";
}
@source(BGB_P1834) {
    rule UmgangsbestimmungAufWunsch(b: Person, betreuter: Person) strict {
        label de official "Der Betreuer darf den Umgang bestimmen, wenn der Betreute dies wünscht (§ 1834 Absatz 1 Alternative 1)";
        label en unofficial "the custodian may determine contact where the represented person wishes it (§ 1834 (1) alternative 1)";
        when betreuer_bestellt(b, betreuter) and betreuter_wuenscht_umgangsbestimmung(betreuter);
        then betreuer_darf_umgang_bestimmen(b, betreuter);
    }
    rule UmgangsbestimmungBeiGefaehrdung(b: Person, betreuter: Person) strict {
        label de official "Der Betreuer darf den Umgang bestimmen, wenn dem Betreuten dadurch eine konkrete Gefährdung droht (§ 1834 Absatz 1 Alternative 2)";
        label en unofficial "the custodian may determine contact where the represented person faces a concrete danger from it (§ 1834 (1) alternative 2)";
        when betreuer_bestellt(b, betreuter) and umgang_droht_konkrete_gefaehrdung(betreuter);
        then betreuer_darf_umgang_bestimmen(b, betreuter);
    }
}
pub relation aufenthaltsbestimmung_umfasst_herausgabe(b: Person, betreuter: Person) kind institutional {
    label de official "Die Bestimmung des Aufenthalts umfasst das Recht, den Aufenthalt mit Wirkung für und gegen Dritte zu bestimmen und, falls erforderlich, die Herausgabe zu verlangen (§ 1834 Absatz 2)";
    label en unofficial "determining residence includes the right to fix it with effect for and against third parties and, if necessary, to demand surrender (§ 1834 (2))";
}
@source(BGB_P1834)
rule AufenthaltsbestimmungUmfasstHerausgabe(b: Person, betreuter: Person) strict {
    label de official "Die Bestimmung des Aufenthalts umfasst das Recht, ihn mit Wirkung für und gegen Dritte zu bestimmen und, falls erforderlich, die Herausgabe des Betreuten zu verlangen (§ 1834 Absatz 2)";
    label en unofficial "determining residence includes the right to fix it with effect for and against third parties and, if necessary, to demand the represented person's surrender (§ 1834 (2))";
    when betreuer_darf_aufenthalt_bestimmen(b, betreuter);
    then aufenthaltsbestimmung_umfasst_herausgabe(b, betreuter);
}
pub relation betreuer_darf_aufenthalt_bestimmen(b: Person, betreuter: Person) kind empirical {
    label de official "Der Aufgabenbereich des Betreuers umfasst die Bestimmung des Aufenthalts des Betreuten (§ 1815 Absatz 2 Nummer 3, § 1834 Absatz 2)";
    label en unofficial "the custodian's scope covers determining the represented person's residence (§ 1815 (2) no. 3, § 1834 (2))";
}
