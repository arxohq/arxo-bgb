language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";

pub relation position_trigger_1773(m: Person, tag: Date) kind empirical { label de official "Voraussetzungen der Vormundschaft nach § 1773"; label en unofficial "guardianship requirements under § 1773"; }
pub relation position_trigger_1775(m1: Person, m2: Person, tag: Date) kind empirical { label de official "Geschwistervormundschaft nach § 1775"; label en unofficial "sibling guardianship under § 1775"; }
pub relation position_trigger_1776(p: Person, m: Person, tag: Date) kind empirical { label de official "Zusätzlicher Pfleger nach § 1776"; label en unofficial "additional curator under § 1776"; }
pub relation position_trigger_1777(pp: Person, m: Person, tag: Date) kind empirical { label de official "Pflegeperson als Pfleger nach § 1777"; label en unofficial "carer as curator under § 1777"; }

@source(BGB_P1773)
rule PositionVormundschaft1773(m: Person, tag: Date) strict { label de official "Die Vormundschaft ist anzuordnen (§ 1773)"; label en unofficial "guardianship must be ordered (§ 1773)"; when position_trigger_1773(m, tag); then duty Vormundschaft1773 { bearer m; achieve vormundschaft_voraussetzungen_erfuellt(m) during [tag, infinity); }; }
@source(BGB_P1775)
rule PositionGeschwister1775(m1: Person, m2: Person, tag: Date) strict { label de official "Für Geschwister soll nur ein Vormund bestellt werden (§ 1775)"; label en unofficial "only one guardian should be appointed for siblings (§ 1775)"; when position_trigger_1775(m1, m2, tag); then liberty Geschwister1775 { holder m1; action position_trigger_1775(m1, m2, tag); window [tag, infinity); }; }
@source(BGB_P1776)
rule PositionPfleger1776(p: Person, m: Person, tag: Date) strict { label de official "Ein zusätzlicher Pfleger kann bestellt werden (§ 1776)"; label en unofficial "an additional curator may be appointed (§ 1776)"; when position_trigger_1776(p, m, tag); then liberty Pfleger1776 { holder p; action position_trigger_1776(p, m, tag); window [tag, infinity); }; }
@source(BGB_P1777)
rule PositionPflegeperson1777(pp: Person, m: Person, tag: Date) strict { label de official "Die Pflegeperson kann als Pfleger bestellt werden (§ 1777)"; label en unofficial "the carer may be appointed curator (§ 1777)"; when position_trigger_1777(pp, m, tag); then liberty Pflegeperson1777 { holder pp; action position_trigger_1777(pp, m, tag); window [tag, infinity); }; }
