language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";

pub relation position_trigger_1778(v: Person, m: Person, tag: Date) kind empirical { label de official "Auswahl des Vormunds nach § 1778"; label en unofficial "selection of guardian under § 1778"; }
pub relation position_trigger_1779(v: Person, m: Person, tag: Date) kind empirical { label de official "Eignung des Vormunds nach § 1779"; label en unofficial "guardian suitability under § 1779"; }
pub relation position_trigger_1780(v: Person, m: Person, tag: Date) kind empirical { label de official "Bestellung des Vormunds nach § 1780"; label en unofficial "appointment of guardian under § 1780"; }
pub relation position_trigger_1781(v: Person, m: Person, tag: Date) kind empirical { label de official "Mitwirkung des Jugendamts nach § 1781"; label en unofficial "youth office participation under § 1781"; }
pub relation position_trigger_1783(v: Person, m: Person, tag: Date) kind empirical { label de official "Bestellungsverfahren nach § 1783"; label en unofficial "appointment procedure under § 1783"; }
pub relation position_trigger_1784(v: Person, m: Person, tag: Date) kind empirical { label de official "Ausschluss des Vormunds nach § 1784"; label en unofficial "guardian exclusion under § 1784"; }
pub relation position_trigger_1785(v: Person, m: Person, tag: Date) kind empirical { label de official "Vergütung des Vormunds nach § 1785"; label en unofficial "guardian remuneration under § 1785"; }
pub relation position_trigger_1786(v: Person, m: Person, tag: Date) kind empirical { label de official "Bestellung eines weiteren Vormunds nach § 1786"; label en unofficial "appointment of additional guardian under § 1786"; }

@source(BGB_P1778)
rule PositionAuswahl1778(v: Person, m: Person, tag: Date) strict { label de official "Der geeignete Vormund darf ausgewählt werden (§ 1778)"; label en unofficial "the suitable guardian may be selected (§ 1778)"; when position_trigger_1778(v, m, tag); then liberty Auswahl1778 { holder v; action position_trigger_1778(v, m, tag); window [tag, infinity); }; }
@source(BGB_P1779)
rule PositionEignung1779(v: Person, m: Person, tag: Date) strict { label de official "Der Vormund muss geeignet sein (§ 1779)"; label en unofficial "the guardian must be suitable (§ 1779)"; when position_trigger_1779(v, m, tag); then liberty Eignung1779 { holder v; action position_trigger_1779(v, m, tag); window [tag, infinity); }; }
@source(BGB_P1780)
rule PositionBestellung1780(v: Person, m: Person, tag: Date) strict { label de official "Der Vormund wird durch das Familiengericht bestellt (§ 1780)"; label en unofficial "the guardian is appointed by the family court (§ 1780)"; when position_trigger_1780(v, m, tag); then liberty Bestellung1780 { holder v; action position_trigger_1780(v, m, tag); window [tag, infinity); }; }
@source(BGB_P1781)
rule PositionMitwirkung1781(v: Person, m: Person, tag: Date) strict { label de official "Das Jugendamt wirkt bei der Vormundschaft mit (§ 1781)"; label en unofficial "the youth office participates in guardianship (§ 1781)"; when position_trigger_1781(v, m, tag); then liberty Mitwirkung1781 { holder v; action position_trigger_1781(v, m, tag); window [tag, infinity); }; }
@source(BGB_P1783)
rule PositionVerfahren1783(v: Person, m: Person, tag: Date) strict { label de official "Das Bestellungsverfahren wird durchgeführt (§ 1783)"; label en unofficial "the appointment procedure is conducted (§ 1783)"; when position_trigger_1783(v, m, tag); then liberty Verfahren1783 { holder v; action position_trigger_1783(v, m, tag); window [tag, infinity); }; }
@source(BGB_P1784)
rule PositionAusschluss1784(v: Person, m: Person, tag: Date) strict { label de official "Der ausgeschlossene Vormund darf nicht bestellt werden (§ 1784)"; label en unofficial "an excluded guardian must not be appointed (§ 1784)"; when position_trigger_1784(v, m, tag); then liberty Ausschluss1784 { holder v; action position_trigger_1784(v, m, tag); window [tag, infinity); }; }
@source(BGB_P1785)
rule PositionVerguetung1785(v: Person, m: Person, tag: Date) strict { label de official "Der Vormund darf Vergütung verlangen (§ 1785)"; label en unofficial "the guardian may claim remuneration (§ 1785)"; when position_trigger_1785(v, m, tag); then liberty Verguetung1785 { holder v; action position_trigger_1785(v, m, tag); window [tag, infinity); }; }
@source(BGB_P1786)
rule PositionWeitere1786(v: Person, m: Person, tag: Date) strict { label de official "Ein weiterer Vormund darf bestellt werden (§ 1786)"; label en unofficial "an additional guardian may be appointed (§ 1786)"; when position_trigger_1786(v, m, tag); then liberty Weitere1786 { holder v; action position_trigger_1786(v, m, tag); window [tag, infinity); }; }
