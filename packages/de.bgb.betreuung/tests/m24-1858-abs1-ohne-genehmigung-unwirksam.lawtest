language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1858 Absatz 1: einseitiges Rechtsgeschäft ohne erforderliche Genehmigung — unwirksam.
test "§ 1858 Absatz 1: Unwirksamkeit ohne Genehmigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m24:B"), entity_ref("urn:de:bgb:bt:m24:X")) { origin case_input; }
        assert "f2": einseitiges_rechtsgeschaeft_ohne_erforderliche_genehmigung(entity_ref("urn:de:bgb:bt:m24:B"), entity_ref("urn:de:bgb:bt:m24:X"), entity_ref("urn:de:bgb:bt:m24:E")) { origin case_input; }
    }
    evaluate truth(einseitiges_rechtsgeschaeft_unwirksam_1858(entity_ref("urn:de:bgb:bt:m24:B"), entity_ref("urn:de:bgb:bt:m24:X"), entity_ref("urn:de:bgb:bt:m24:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
