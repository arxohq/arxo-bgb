language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1867: dringende Gründe, Betreuer bestellt aber an Pflichterfüllung gehindert — einstweilige Maßnahmen geschuldet.
test "§ 1867: einstweilige Maßnahmen bei gehindertem Betreuer" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": dringende_gruende_fuer_betreuerbestellungsvoraussetzungen(entity_ref("urn:de:bgb:bt:m40:V")) { origin case_input; }
        assert "f2": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m40:B"), entity_ref("urn:de:bgb:bt:m40:V")) { origin case_input; }
        assert "f3": betreuer_an_pflichterfuellung_gehindert(entity_ref("urn:de:bgb:bt:m40:V"), entity_ref("urn:de:bgb:bt:m40:B")) { origin case_input; }
    }
    evaluate truth(einstweilige_massnahmen_pflicht_1867(entity_ref("urn:de:bgb:bt:m40:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
