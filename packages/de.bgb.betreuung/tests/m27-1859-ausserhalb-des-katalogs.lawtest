language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1859 Absatz 2: ein Betreuer, der zu keiner der fünf Ziffern gehört (z. B. ein fremder Berufsbetreuer ohne Verwandtschaft), ist nicht kraft Gesetzes befreit.
test "§ 1859 Absatz 2: außerhalb des Katalogs keine gesetzliche Befreiung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m27:B"), entity_ref("urn:de:bgb:bt:m27:X")) { origin case_input; }
    }
    evaluate truth(ist_befreiter_betreuer_kraft_gesetzes(entity_ref("urn:de:bgb:bt:m27:B"), entity_ref("urn:de:bgb:bt:m27:X")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
