language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1875 Absatz 1: ehrenamtliche Betreuung — Vergütung nach diesem Untertitel.
test "§ 1875 Absatz 1: Vergütung nach dem Untertitel bei Ehrenamt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m50:B"), entity_ref("urn:de:bgb:bt:m50:X")) { origin case_input; }
        assert "f2": betreuung_ehrenamtlich_gefuehrt(entity_ref("urn:de:bgb:bt:m50:B"), entity_ref("urn:de:bgb:bt:m50:X")) { origin case_input; }
    }
    evaluate truth(verguetung_nach_untertitel_anwendbar_1875(entity_ref("urn:de:bgb:bt:m50:B"), entity_ref("urn:de:bgb:bt:m50:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
