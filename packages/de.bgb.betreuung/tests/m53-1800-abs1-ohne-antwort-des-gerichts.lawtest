language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1800 Absatz 1, Gegenprobe: ohne Antwort des Gerichts fragt die Wertung, statt zu schweigen (DECISION-0194).
test "§ 1800 Absatz 1: ohne Antwort des Gerichts fragt die Wertung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate truth(rechtsgeschaeft_widerspricht_1798abs1_grundsaetzen_nicht(entity_ref("urn:de:bgb:bt:m53:V"), entity_ref("urn:de:bgb:bt:m53:M")));
    expect evaluation_status == REQUIRES_JUDGMENT;
}
