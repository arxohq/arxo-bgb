language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1836 Absatz 1 Satz 1: kein gemeinschaftliches Vermögen — Trennungsgebot greift uneingeschränkt.
test "§ 1836 Absatz 1: Trennungsgebot ohne gemeinschaftliches Vermögen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m01:B"), entity_ref("urn:de:bgb:bt:m01:X")) { origin case_input; }
        assert "f2": vermoegensverwaltung_gehoert_zum_aufgabenkreis(entity_ref("urn:de:bgb:bt:m01:B"), entity_ref("urn:de:bgb:bt:m01:X")) { origin case_input; }
    }
    evaluate truth(vermoegen_getrennt_zu_halten_pflicht(entity_ref("urn:de:bgb:bt:m01:B"), entity_ref("urn:de:bgb:bt:m01:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
