language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1836 Absatz 2 Satz 2: ehrenamtliche Betreuung mit Verwendungsvereinbarung — Verwendungsverbot entfällt.
test "§ 1836 Absatz 2: Ausnahme bei ehrenamtlicher Betreuung mit Verwendungsvereinbarung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m04:B"), entity_ref("urn:de:bgb:bt:m04:X")) { origin case_input; }
        assert "f2": vermoegensverwaltung_gehoert_zum_aufgabenkreis(entity_ref("urn:de:bgb:bt:m04:B"), entity_ref("urn:de:bgb:bt:m04:X")) { origin case_input; }
        assert "f3": betreuung_ehrenamtlich_und_verwendungsvereinbarung(entity_ref("urn:de:bgb:bt:m04:B"), entity_ref("urn:de:bgb:bt:m04:X")) { origin case_input; }
    }
    evaluate truth(vermoegen_fuer_sich_verwenden_verboten(entity_ref("urn:de:bgb:bt:m04:B"), entity_ref("urn:de:bgb:bt:m04:X")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
