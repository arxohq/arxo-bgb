language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1863 Absatz 3, andere Seite: Jahresbericht erstattet genau am verlegten Fristende (11.01.2027, Montag) — nicht überfällig.
test "§ 1863 Absatz 3: Jahresbericht erstattet am verlegten letzten Tag der Frist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": betreuung_uebernommen_am(entity_ref("urn:de:bgb:bt:j04:B"), entity_ref("urn:de:bgb:bt:j04:X"), @2026-01-10) { origin case_input; }
        assert "f2": jahresbericht_faellig_am(entity_ref("urn:de:bgb:bt:j04:B"), entity_ref("urn:de:bgb:bt:j04:X"), entity_ref("urn:de:bgb:bt:j04:F")) { origin case_input; }
        assert "f3": jahresberichtsfrist_ereignistag(entity_ref("urn:de:bgb:bt:j04:F"), @2026-01-10) { origin case_input; }
        assert "f4": jahresbericht_dem_betreuungsgericht_erstattet_am(entity_ref("urn:de:bgb:bt:j04:F"), @2027-01-11) { origin case_input; }
    }
    evaluate truth(jahresbericht_ueberfaellig(entity_ref("urn:de:bgb:bt:j04:B"), entity_ref("urn:de:bgb:bt:j04:X"), entity_ref("urn:de:bgb:bt:j04:F")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
