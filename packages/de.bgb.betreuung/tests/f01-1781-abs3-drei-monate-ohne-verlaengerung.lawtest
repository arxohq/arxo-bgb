language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1781 Absatz 3 Satz 1: Bestellung des vorläufigen Vormunds am 10.01.2026 (Samstag); die Dreimonatsfrist endet kalendarisch am 10.04.2026 — einem Freitag, kein Feiertag, keine Verlegung.
test "§ 1781 Absatz 3: drei Monate ab Bestellung des vorläufigen Vormunds, ohne Verlängerung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": vormundbestellungsfrist_1781(entity_ref("urn:de:bgb:bt:f01:F")) { origin case_input; }
        assert "f2": vorlaeufige_vormundbestellung_am(entity_ref("urn:de:bgb:bt:f01:F"), @2026-01-10) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:bt:f01:F"), @2026-04-10));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
