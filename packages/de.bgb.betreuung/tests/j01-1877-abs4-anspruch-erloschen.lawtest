language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1877 Absatz 4 Satz 1: Anspruch entstanden am 15.01.2026; die Fünfzehn-Monats-Frist endet kalendarisch am 15.04.2027 (Donnerstag, keine Verlegung). Ohne gerichtliche Geltendmachung bis dahin erlischt der Anspruch.
test "§ 1877 Absatz 4: Aufwendungsersatzanspruch erlischt nach fünfzehn Monaten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:bt:j01:A"), @2026-01-15) { origin case_input; }
        assert "f2": aufwendungsersatzfrist_betrifft_anspruch(entity_ref("urn:de:bgb:bt:j01:F"), entity_ref("urn:de:bgb:bt:j01:A")) { origin case_input; }
        assert "f3": aufwendungsersatzfrist_1877(entity_ref("urn:de:bgb:bt:j01:F")) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:bt:j01:F"), @2027-04-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(aufwendungsersatzanspruch_erloschen(entity_ref("urn:de:bgb:bt:j01:A"), entity_ref("urn:de:bgb:bt:j01:F")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
