language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1783 Absatz 1 Nummer 5, andere Seite: dieselbe Aufforderung, aber Bereiterklärung am letzten Tag der Frist (02.02.2026) — kein Übergehen nach dieser Nummer.
test "§ 1783 Absatz 1 Nummer 5: Bereiterklärung am letzten Tag der Frist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_TAG; calendar KALENDER_BUNDESWEIT; }
        assert "f1": massgebliche_elterliche_benennung(entity_ref("urn:de:bgb:bt:f04:B"), entity_ref("urn:de:bgb:bt:f04:M")) { origin case_input; }
        assert "f2": aufforderungsfrist_1783(entity_ref("urn:de:bgb:bt:f04:F")) { origin case_input; }
        assert "f3": aufforderung_durch_familiengericht_am(entity_ref("urn:de:bgb:bt:f04:F"), @2026-01-05) { origin case_input; }
        assert "f4": betrifft_person_1783(entity_ref("urn:de:bgb:bt:f04:F"), entity_ref("urn:de:bgb:bt:f04:B"), entity_ref("urn:de:bgb:bt:f04:M")) { origin case_input; }
        assert "f5": bereitschaftserklaerung_vor(entity_ref("urn:de:bgb:bt:f04:F"), @2026-02-02) { origin case_input; }
    }
    evaluate truth(benannte_person_uebergangen(entity_ref("urn:de:bgb:bt:f04:B"), entity_ref("urn:de:bgb:bt:f04:M")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
