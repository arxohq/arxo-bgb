language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1875 Absatz 2: beruflicher Betreuer — Vergütung nach dem VBVG (externer Eingang, nur die Anwendbarkeit wird formalisiert).
test "§ 1875 Absatz 2: Vergütung nach VBVG bei beruflichem Betreuer" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m51:B"), entity_ref("urn:de:bgb:bt:m51:X")) { origin case_input; }
        assert "f2": betreuer_beruflich_oder_verein_oder_behoerde_1875(entity_ref("urn:de:bgb:bt:m51:B")) { origin case_input; }
    }
    evaluate truth(verguetung_nach_vbvg_anwendbar_1875(entity_ref("urn:de:bgb:bt:m51:B"), entity_ref("urn:de:bgb:bt:m51:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
