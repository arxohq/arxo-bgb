language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1840 Absatz 2 Nummer 1: im Geschäftsverkehr übliche Barzahlung — die bargeldlose Pflicht des Absatzes 1 entfällt.
test "§ 1840 Absatz 2 Nummer 1: Ausnahme für im Geschäftsverkehr übliche Barzahlung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m08:B"), entity_ref("urn:de:bgb:bt:m08:X")) { origin case_input; }
        assert "f2": zahlungsverkehr_fuer_betreuten(entity_ref("urn:de:bgb:bt:m08:B"), entity_ref("urn:de:bgb:bt:m08:X")) { origin case_input; }
        assert "f3": im_geschaeftsverkehr_uebliche_barzahlung(entity_ref("urn:de:bgb:bt:m08:B"), entity_ref("urn:de:bgb:bt:m08:X")) { origin case_input; }
    }
    evaluate truth(bargeldlos_durchzufuehren_pflicht(entity_ref("urn:de:bgb:bt:m08:B"), entity_ref("urn:de:bgb:bt:m08:X")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
