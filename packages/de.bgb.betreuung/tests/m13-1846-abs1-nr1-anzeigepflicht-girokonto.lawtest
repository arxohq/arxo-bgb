language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1846 Absatz 1 Nummer 1: Eröffnung eines Girokontos für den Betreuten.
test "§ 1846 Absatz 1 Nummer 1: Anzeigepflicht bei Eröffnung eines Girokontos" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m13:B"), entity_ref("urn:de:bgb:bt:m13:X")) { origin case_input; }
        assert "f2": girokonto_fuer_betreuten_eroeffnet(entity_ref("urn:de:bgb:bt:m13:B"), entity_ref("urn:de:bgb:bt:m13:X")) { origin case_input; }
    }
    evaluate truth(anzeigepflicht_kontoeroeffnung_1846(entity_ref("urn:de:bgb:bt:m13:B"), entity_ref("urn:de:bgb:bt:m13:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
