language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1806: die Vormundschaft endet, wenn die Voraussetzungen des § 1773 nicht mehr gegeben sind — ausdrücklicher Fall-Eingang, kein Schluss aus Schweigen.
test "§ 1806: Ende der Vormundschaft bei Wegfall der Voraussetzungen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": voraussetzungen_1773_weggefallen(entity_ref("urn:de:bgb:bt:v05:M")) { origin case_input; }
    }
    evaluate truth(vormundschaft_endet(entity_ref("urn:de:bgb:bt:v05:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
