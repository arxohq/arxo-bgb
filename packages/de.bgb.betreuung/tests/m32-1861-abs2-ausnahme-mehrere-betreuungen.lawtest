language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1861 Absatz 2 Satz 2: der Betreuer führt mehr als eine Betreuung — keine mündliche Verpflichtung nach Satz 1 geschuldet.
test "§ 1861 Absatz 2: keine Pflicht bei mehreren Betreuungen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m32:B"), entity_ref("urn:de:bgb:bt:m32:X")) { origin case_input; }
        assert "f2": ehrenamtlicher_betreuer_neu_bestellt(entity_ref("urn:de:bgb:bt:m32:B"), entity_ref("urn:de:bgb:bt:m32:X")) { origin case_input; }
        assert "f3": betreuer_fuehrt_mehr_als_eine_betreuung_oder_kuerzlich(entity_ref("urn:de:bgb:bt:m32:B")) { origin case_input; }
    }
    evaluate truth(muendliche_verpflichtung_und_unterrichtung_pflicht(entity_ref("urn:de:bgb:bt:m32:B"), entity_ref("urn:de:bgb:bt:m32:X")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
