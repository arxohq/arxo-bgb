language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1878 Absatz 4, andere Seite: gerichtliche Geltendmachung am letzten Tag der Sechs-Monats-Frist — kein Erlöschen.
test "§ 1878 Absatz 4: rechtzeitige gerichtliche Geltendmachung der Aufwandspauschale" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": aufwandspauschalenfrist_betrifft_anspruch(entity_ref("urn:de:bgb:bt:k02:F"), entity_ref("urn:de:bgb:bt:k02:A")) { origin case_input; }
        assert "f2": aufwandspauschalenfrist_1878(entity_ref("urn:de:bgb:bt:k02:F")) { origin case_input; }
        assert "f3": jahresende_der_entstehung(entity_ref("urn:de:bgb:bt:k02:F"), @2026-12-31) { origin case_input; }
        assert "f4": aufwandspauschale_gerichtlich_geltend_gemacht_bis(entity_ref("urn:de:bgb:bt:k02:F"), @2027-06-30) { origin case_input; }
    }
    evaluate truth(aufwandspauschalenanspruch_erloschen(entity_ref("urn:de:bgb:bt:k02:A"), entity_ref("urn:de:bgb:bt:k02:F")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
