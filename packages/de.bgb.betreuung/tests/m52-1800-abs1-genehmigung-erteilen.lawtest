language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1800 Absatz 1: Rechtsgeschäft widerspricht den Grundsätzen des § 1798 Absatz 1 nicht — Genehmigung wird erteilt.
test "§ 1800 Absatz 1: Genehmigung ohne Widerspruch zu § 1798 Absatz 1" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m52:V"), entity_ref("urn:de:bgb:bt:m52:M")) { origin case_input; }
        assert "f2": rechtsgeschaeft_widerspricht_1798abs1_grundsaetzen_nicht(entity_ref("urn:de:bgb:bt:m52:V"), entity_ref("urn:de:bgb:bt:m52:M")) { origin adjudicated; }
    }
    evaluate truth(genehmigung_1800_zu_erteilen(entity_ref("urn:de:bgb:bt:m52:V"), entity_ref("urn:de:bgb:bt:m52:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
