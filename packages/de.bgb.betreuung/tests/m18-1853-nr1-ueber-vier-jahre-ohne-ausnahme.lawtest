language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1853 Satz 1 Nummer 1: Mietvertrag über mehr als vier Jahre, keine vorzeitige Kündigungsmöglichkeit — Genehmigung erforderlich.
test "§ 1853 Nummer 1: Genehmigung ohne Kündigungsmöglichkeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m18:B"), entity_ref("urn:de:bgb:bt:m18:X")) { origin case_input; }
        assert "f2": vertrag_ueber_wiederkehrende_leistungen_ueber_vier_jahre(entity_ref("urn:de:bgb:bt:m18:B"), entity_ref("urn:de:bgb:bt:m18:X")) { origin case_input; }
    }
    evaluate truth(genehmigung_1853_erforderlich(entity_ref("urn:de:bgb:bt:m18:B"), entity_ref("urn:de:bgb:bt:m18:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
