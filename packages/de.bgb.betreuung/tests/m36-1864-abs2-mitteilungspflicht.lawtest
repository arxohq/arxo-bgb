language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1864 Absatz 2 Satz 1: wesentliche Änderung eingetreten — unverzügliche Mitteilungspflicht.
test "§ 1864 Absatz 2: Mitteilungspflicht bei wesentlicher Änderung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m36:B"), entity_ref("urn:de:bgb:bt:m36:X")) { origin case_input; }
        assert "f2": wesentliche_aenderung_der_verhaeltnisse_eingetreten(entity_ref("urn:de:bgb:bt:m36:B"), entity_ref("urn:de:bgb:bt:m36:X")) { origin case_input; }
    }
    evaluate truth(mitteilungspflicht_wesentliche_aenderung_1864(entity_ref("urn:de:bgb:bt:m36:B"), entity_ref("urn:de:bgb:bt:m36:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
