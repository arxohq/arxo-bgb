language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1862 Absatz 2: Anhaltspunkte für pflichtwidrige Wunschmissachtung, keine Ausnahme — persönliche Anhörung geschuldet.
test "§ 1862 Absatz 2: persönliche Anhörung bei Anhaltspunkten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m33:B"), entity_ref("urn:de:bgb:bt:m33:X")) { origin case_input; }
        assert "f2": anhaltspunkte_fuer_pflichtwidrige_wunschmissachtung(entity_ref("urn:de:bgb:bt:m33:B"), entity_ref("urn:de:bgb:bt:m33:X")) { origin case_input; }
    }
    evaluate truth(persoenliche_anhoerung_pflicht_1862(entity_ref("urn:de:bgb:bt:m33:B"), entity_ref("urn:de:bgb:bt:m33:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
