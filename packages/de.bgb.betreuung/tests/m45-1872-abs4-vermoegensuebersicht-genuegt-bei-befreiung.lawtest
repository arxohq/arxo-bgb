language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1872 Absatz 4: Betreuer war nach § 1859 befreit (Verwandter gerader Linie) — Vermögensübersicht genügt, keine Schlussrechnungspflicht.
test "§ 1872 Absatz 4: Vermögensübersicht genügt bei befreitem Betreuer" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m45:B"), entity_ref("urn:de:bgb:bt:m45:X")) { origin case_input; }
        assert "f2": betreuerwechsel_1872(entity_ref("urn:de:bgb:bt:m45:B"), entity_ref("urn:de:bgb:bt:m45:X"), entity_ref("urn:de:bgb:bt:m45:N")) { origin case_input; }
        assert "f3": verwandter_gerader_linie(entity_ref("urn:de:bgb:bt:m45:B"), entity_ref("urn:de:bgb:bt:m45:X")) { origin case_input; }
    }
    evaluate truth(vermoegensuebersicht_statt_schlussrechnung_genuegt_1872(entity_ref("urn:de:bgb:bt:m45:B"), entity_ref("urn:de:bgb:bt:m45:X"), entity_ref("urn:de:bgb:bt:m45:N")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(schlussrechnungspflicht_1872(entity_ref("urn:de:bgb:bt:m45:B"), entity_ref("urn:de:bgb:bt:m45:X"), entity_ref("urn:de:bgb:bt:m45:N")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
