language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1838 Absatz 2 Satz 1: Wahrnehmung der Vermögensangelegenheiten weicht von §§ 1839–1843 ab.
test "§ 1838 Absatz 2: Anzeigepflicht bei Abweichung von den §§ 1839–1843" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m06:B"), entity_ref("urn:de:bgb:bt:m06:X")) { origin case_input; }
        assert "f2": wahrnehmung_weicht_von_1839_bis_1843_ab(entity_ref("urn:de:bgb:bt:m06:B"), entity_ref("urn:de:bgb:bt:m06:X")) { origin case_input; }
    }
    evaluate truth(anzeigepflicht_abweichung_1838(entity_ref("urn:de:bgb:bt:m06:B"), entity_ref("urn:de:bgb:bt:m06:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
