language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1872 Absatz 3: Betreuerwechsel, kein befreiter Betreuer — Schlussrechnungspflicht.
test "§ 1872 Absatz 3: Schlussrechnungspflicht bei Wechsel ohne Befreiung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m44:B"), entity_ref("urn:de:bgb:bt:m44:X")) { origin case_input; }
        assert "f2": betreuerwechsel_1872(entity_ref("urn:de:bgb:bt:m44:B"), entity_ref("urn:de:bgb:bt:m44:X"), entity_ref("urn:de:bgb:bt:m44:N")) { origin case_input; }
    }
    evaluate truth(schlussrechnungspflicht_1872(entity_ref("urn:de:bgb:bt:m44:B"), entity_ref("urn:de:bgb:bt:m44:X"), entity_ref("urn:de:bgb:bt:m44:N")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
