language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1859 Absatz 2 Satz 1 Nummer 1: Verwandter gerader Linie — kraft Gesetzes befreiter Betreuer, entbunden von Sperrvereinbarung und Rechnungslegung, mit Vermögensübersichtspflicht.
test "§ 1859 Absatz 2 Nummer 1: Verwandter gerader Linie ist befreiter Betreuer" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m26:B"), entity_ref("urn:de:bgb:bt:m26:X")) { origin case_input; }
        assert "f2": verwandter_gerader_linie(entity_ref("urn:de:bgb:bt:m26:B"), entity_ref("urn:de:bgb:bt:m26:X")) { origin case_input; }
    }
    evaluate truth(von_sperrvereinbarungspflicht_entbunden_1859(entity_ref("urn:de:bgb:bt:m26:B"), entity_ref("urn:de:bgb:bt:m26:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(vermoegensuebersicht_jaehrlich_einzureichen_pflicht(entity_ref("urn:de:bgb:bt:m26:B"), entity_ref("urn:de:bgb:bt:m26:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
