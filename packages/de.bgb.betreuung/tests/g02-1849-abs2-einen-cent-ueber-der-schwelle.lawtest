language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1849, andere Seite der Schwelle: 3 000,01 Euro übersteigen 3 000 Euro — Genehmigung erforderlich.
test "§ 1849: Zahlungsanspruch einen Cent über der 3 000-Euro-Schwelle" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:g02:B"), entity_ref("urn:de:bgb:bt:g02:X")) { origin case_input; }
        assert "f2": verfuegung_ueber_geldleistungsrecht(entity_ref("urn:de:bgb:bt:g02:B"), entity_ref("urn:de:bgb:bt:g02:X"), 3000.01 EUR) { origin case_input; }
    }
    evaluate truth(genehmigung_1849_erforderlich(entity_ref("urn:de:bgb:bt:g02:B"), entity_ref("urn:de:bgb:bt:g02:X"), 3000.01 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
