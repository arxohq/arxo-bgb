language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1807 mit § 1872 Absatz 4: Vormundwechsel, Vormund war nach § 1801 Absatz 1 oder 3 befreit — Vermögensübersicht genügt statt Schlussrechnung.
test "§ 1807: Vermögensübersicht genügt bei nach § 1801 befreitem Vormund" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m55:V"), entity_ref("urn:de:bgb:bt:m55:M")) { origin case_input; }
        assert "f2": betreuerwechsel_1872(entity_ref("urn:de:bgb:bt:m55:V"), entity_ref("urn:de:bgb:bt:m55:M"), entity_ref("urn:de:bgb:bt:m55:N")) { origin case_input; }
        assert "f3": vormund_befreit_gemaess_1801abs1_oder_3(entity_ref("urn:de:bgb:bt:m55:V"), entity_ref("urn:de:bgb:bt:m55:M")) { origin case_input; }
    }
    evaluate truth(vermoegensuebersicht_statt_schlussrechnung_genuegt_1872(entity_ref("urn:de:bgb:bt:m55:V"), entity_ref("urn:de:bgb:bt:m55:M"), entity_ref("urn:de:bgb:bt:m55:N")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
