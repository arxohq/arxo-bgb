language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1860 Absatz 1: Vermögenswert einen Cent über 6 000 Euro — Befreiung nach Absatz 1 nicht möglich.
test "§ 1860 Absatz 1: keine Befreiung einen Cent über der 6 000-Euro-Schwelle" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m30:B"), entity_ref("urn:de:bgb:bt:m30:X")) { origin case_input; }
        assert "f2": antrag_auf_befreiung_1860abs1(entity_ref("urn:de:bgb:bt:m30:B"), entity_ref("urn:de:bgb:bt:m30:X")) { origin case_input; }
        assert "f3": vermoegenswert_ohne_immobilien_und_verbindlichkeiten(entity_ref("urn:de:bgb:bt:m30:B"), entity_ref("urn:de:bgb:bt:m30:X"), 6000.01 EUR) { origin case_input; }
    }
    evaluate truth(befreiung_1860abs1_moeglich(entity_ref("urn:de:bgb:bt:m30:B"), entity_ref("urn:de:bgb:bt:m30:X"), 6000.01 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
