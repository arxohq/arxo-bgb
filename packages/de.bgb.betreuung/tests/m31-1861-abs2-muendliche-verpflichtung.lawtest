language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1861 Absatz 2: neu bestellter ehrenamtlicher Betreuer ohne Vorbetreuungen — mündliche Verpflichtung und Unterrichtung geschuldet.
test "§ 1861 Absatz 2: mündliche Verpflichtung und Unterrichtung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m31:B"), entity_ref("urn:de:bgb:bt:m31:X")) { origin case_input; }
        assert "f2": ehrenamtlicher_betreuer_neu_bestellt(entity_ref("urn:de:bgb:bt:m31:B"), entity_ref("urn:de:bgb:bt:m31:X")) { origin case_input; }
    }
    evaluate truth(muendliche_verpflichtung_und_unterrichtung_pflicht(entity_ref("urn:de:bgb:bt:m31:B"), entity_ref("urn:de:bgb:bt:m31:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
