language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";

test "§§ 1773, 1775, 1776, 1777: Vormundschaftspositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.betreuung::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1773(entity_ref("urn:test:m1773"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1775(entity_ref("urn:test:m1775a"), entity_ref("urn:test:m1775b"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1776(entity_ref("urn:test:p1776"), entity_ref("urn:test:m1776"), @2026-01-01) { origin case_input; }
 assert "d": position_trigger_1777(entity_ref("urn:test:p1777"), entity_ref("urn:test:m1777"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Vormundschaft1773, ACTIVE); expect position(Geschwister1775, ACTIVE); expect position(Pfleger1776, ACTIVE); expect position(Pflegeperson1777, ACTIVE);
}

test "§§ 1773, 1775, 1776, 1777: Vormundschaftspositionen bestätigt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.betreuung::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1773(entity_ref("urn:test:m1773"), @2026-01-01) { origin case_input; }
 assert "ag": vormundschaft_voraussetzungen_erfuellt(entity_ref("urn:test:m1773")) { origin case_input; }
 assert "b": position_trigger_1775(entity_ref("urn:test:m1775a"), entity_ref("urn:test:m1775b"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1776(entity_ref("urn:test:p1776"), entity_ref("urn:test:m1776"), @2026-01-01) { origin case_input; }
 assert "d": position_trigger_1777(entity_ref("urn:test:p1777"), entity_ref("urn:test:m1777"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Vormundschaft1773, SATISFIED); expect position(Geschwister1775, ACTIVE); expect position(Pfleger1776, ACTIVE); expect position(Pflegeperson1777, ACTIVE);
}
