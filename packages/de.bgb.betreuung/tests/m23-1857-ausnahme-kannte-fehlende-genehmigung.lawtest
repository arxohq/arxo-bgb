language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1857: der andere Teil kannte das Fehlen der Genehmigung bei Vertragsschluss — kein Widerrufsrecht.
test "§ 1857: kein Widerrufsrecht bei Kenntnis des anderen Teils" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m23:B"), entity_ref("urn:de:bgb:bt:m23:X")) { origin case_input; }
        assert "f2": betreuer_behauptet_wahrheitswidrig_genehmigung(entity_ref("urn:de:bgb:bt:m23:B"), entity_ref("urn:de:bgb:bt:m23:X"), entity_ref("urn:de:bgb:bt:m23:D")) { origin case_input; }
        assert "f3": andererteil_kannte_fehlende_genehmigung_bei_abschluss(entity_ref("urn:de:bgb:bt:m23:B"), entity_ref("urn:de:bgb:bt:m23:X"), entity_ref("urn:de:bgb:bt:m23:D")) { origin case_input; }
    }
    evaluate truth(widerrufsrecht_1857(entity_ref("urn:de:bgb:bt:m23:B"), entity_ref("urn:de:bgb:bt:m23:X"), entity_ref("urn:de:bgb:bt:m23:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
