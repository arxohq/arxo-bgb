language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1844: das Betreuungsgericht ordnet die Hinterlegung von Wertgegenständen an (gerichtliche Entscheidung, origin adjudicated).
test "§ 1844: Hinterlegungspflicht nach gerichtlicher Anordnung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m12:B"), entity_ref("urn:de:bgb:bt:m12:X")) { origin case_input; }
        assert "f2": hinterlegung_von_wertgegenstaenden_angeordnet(entity_ref("urn:de:bgb:bt:m12:B"), entity_ref("urn:de:bgb:bt:m12:X")) { origin adjudicated; }
    }
    evaluate truth(wertgegenstaende_hinterlegungspflicht(entity_ref("urn:de:bgb:bt:m12:B"), entity_ref("urn:de:bgb:bt:m12:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
