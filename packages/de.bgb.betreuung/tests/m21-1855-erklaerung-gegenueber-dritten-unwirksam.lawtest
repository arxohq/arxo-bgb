language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1855: Erklärung der Genehmigung gegenüber einem Dritten (nicht dem Betreuer) — unwirksam.
test "§ 1855: Erklärung gegenüber einem Dritten ist unwirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m21:B"), entity_ref("urn:de:bgb:bt:m21:X")) { origin case_input; }
        assert "f2": genehmigungserklaerung_gegenueber_dritten_abgegeben(entity_ref("urn:de:bgb:bt:m21:B"), entity_ref("urn:de:bgb:bt:m21:X"), entity_ref("urn:de:bgb:bt:m21:D")) { origin case_input; }
    }
    evaluate truth(genehmigungserklaerung_unwirksam_1855(entity_ref("urn:de:bgb:bt:m21:B"), entity_ref("urn:de:bgb:bt:m21:X"), entity_ref("urn:de:bgb:bt:m21:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
