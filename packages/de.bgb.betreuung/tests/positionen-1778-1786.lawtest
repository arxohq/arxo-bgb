language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";

test "§§ 1778–1786: Vormundschaftspositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.betreuung::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1778(entity_ref("urn:test:v1778"), entity_ref("urn:test:m1778"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1779(entity_ref("urn:test:v1779"), entity_ref("urn:test:m1779"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1780(entity_ref("urn:test:v1780"), entity_ref("urn:test:m1780"), @2026-01-01) { origin case_input; }
 assert "d": position_trigger_1781(entity_ref("urn:test:v1781"), entity_ref("urn:test:m1781"), @2026-01-01) { origin case_input; }
 assert "e": position_trigger_1783(entity_ref("urn:test:v1783"), entity_ref("urn:test:m1783"), @2026-01-01) { origin case_input; }
 assert "f": position_trigger_1784(entity_ref("urn:test:v1784"), entity_ref("urn:test:m1784"), @2026-01-01) { origin case_input; }
 assert "g": position_trigger_1785(entity_ref("urn:test:v1785"), entity_ref("urn:test:m1785"), @2026-01-01) { origin case_input; }
 assert "h": position_trigger_1786(entity_ref("urn:test:v1786"), entity_ref("urn:test:m1786"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Auswahl1778, ACTIVE); expect position(Eignung1779, ACTIVE); expect position(Bestellung1780, ACTIVE); expect position(Mitwirkung1781, ACTIVE); expect position(Verfahren1783, ACTIVE); expect position(Ausschluss1784, ACTIVE); expect position(Verguetung1785, ACTIVE); expect position(Weitere1786, ACTIVE);
}

test "§§ 1778–1786: Vormundschaftspositionen bestätigt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.betreuung::KALENDER_BUNDESWEIT; }
