language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1858 Absatz 2: Genehmigung vorhanden, aber nicht vorgelegt, und der andere weist deshalb unverzüglich zurück — unwirksam.
test "§ 1858 Absatz 2: Unwirksamkeit bei fehlender Vorlage und Zurückweisung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m25:B"), entity_ref("urn:de:bgb:bt:m25:X")) { origin case_input; }
        assert "f2": genehmigung_nicht_vorgelegt_und_unverzueglich_zurueckgewiesen(entity_ref("urn:de:bgb:bt:m25:B"), entity_ref("urn:de:bgb:bt:m25:X"), entity_ref("urn:de:bgb:bt:m25:E")) { origin case_input; }
    }
    evaluate truth(einseitiges_rechtsgeschaeft_unwirksam_1858(entity_ref("urn:de:bgb:bt:m25:B"), entity_ref("urn:de:bgb:bt:m25:X"), entity_ref("urn:de:bgb:bt:m25:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
