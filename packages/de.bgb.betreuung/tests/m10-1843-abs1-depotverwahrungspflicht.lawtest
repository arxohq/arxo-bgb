language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1843 Absatz 1: Wertpapiere im Sinne des § 1 Absatz 1, 2 Depotgesetz — Depotverwahrungspflicht.
test "§ 1843 Absatz 1: Depotverwahrungspflicht für Wertpapiere" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m10:B"), entity_ref("urn:de:bgb:bt:m10:X")) { origin case_input; }
        assert "f2": wertpapiere_des_betreuten_depotgesetz(entity_ref("urn:de:bgb:bt:m10:B"), entity_ref("urn:de:bgb:bt:m10:X")) { origin case_input; }
    }
    evaluate truth(depotverwahrungspflicht_grundsatz(entity_ref("urn:de:bgb:bt:m10:B"), entity_ref("urn:de:bgb:bt:m10:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
