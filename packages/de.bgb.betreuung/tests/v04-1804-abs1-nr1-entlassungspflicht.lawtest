language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1804 Absatz 1 Nummer 1: Gefährdung des Mündelwohls durch Fortführung des Amtes zwingt zur Entlassung.
test "§ 1804 Absatz 1 Nummer 1: Entlassungspflicht bei Gefährdung des Mündelwohls" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": fortfuehrung_gefaehrdet_muendelwohl(entity_ref("urn:de:bgb:bt:v04:V"), entity_ref("urn:de:bgb:bt:v04:M")) { origin adjudicated; }
    }
    evaluate truth(vormund_zu_entlassen(entity_ref("urn:de:bgb:bt:v04:V"), entity_ref("urn:de:bgb:bt:v04:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
