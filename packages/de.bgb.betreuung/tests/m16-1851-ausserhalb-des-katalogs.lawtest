language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1851: ein gewöhnlicher Kaufvertrag über eine bewegliche Sache des Alltags ist kein erbrechtliches Rechtsgeschäft des Katalogs — keine der neun Nummern greift, keine Genehmigungspflicht nach § 1851.
test "§ 1851: außerhalb des Katalogs kein Genehmigungserfordernis" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m16:B"), entity_ref("urn:de:bgb:bt:m16:X")) { origin case_input; }
    }
    evaluate truth(genehmigung_1851_erforderlich(entity_ref("urn:de:bgb:bt:m16:B"), entity_ref("urn:de:bgb:bt:m16:X")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
