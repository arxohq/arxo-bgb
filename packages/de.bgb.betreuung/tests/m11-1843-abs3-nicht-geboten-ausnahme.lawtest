language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1843 Absatz 3: nach den Umständen des Einzelfalls ist die Depotverwahrung nicht geboten (Kanal §47.3, Wertung des Gerichts) — Pflicht entfällt.
test "§ 1843 Absatz 3: Depotverwahrungspflicht entfällt nach den Umständen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m11:B"), entity_ref("urn:de:bgb:bt:m11:X")) { origin case_input; }
        assert "f2": wertpapiere_des_betreuten_depotgesetz(entity_ref("urn:de:bgb:bt:m11:B"), entity_ref("urn:de:bgb:bt:m11:X")) { origin case_input; }
        assert "f3": depotverwahrung_nach_umstaenden_nicht_geboten(entity_ref("urn:de:bgb:bt:m11:B"), entity_ref("urn:de:bgb:bt:m11:X")) { origin adjudicated; }
    }
    evaluate truth(depotverwahrungspflicht_entfaellt(entity_ref("urn:de:bgb:bt:m11:B"), entity_ref("urn:de:bgb:bt:m11:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
