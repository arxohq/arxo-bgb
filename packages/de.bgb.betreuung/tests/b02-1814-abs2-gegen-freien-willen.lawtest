language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1814 Absatz 2: gegen den freien Willen des Volljährigen darf kein Betreuer bestellt werden — Wertung des Gerichts (§47.3), hier mit beantworteter Frage.
test "§ 1814 Absatz 2: Bestellung gegen den freien Willen ist unzulässig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gegen_freien_willen_bestellt(entity_ref("urn:de:bgb:bt:b02:V")) { origin adjudicated; }
    }
    evaluate truth(betreuerbestellung_unzulaessig_gegen_freien_willen(entity_ref("urn:de:bgb:bt:b02:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
