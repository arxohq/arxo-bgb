language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1859 Absatz 3: Gefährdung im Sinne des § 1821 Absatz 3 Nummer 1 festgestellt — die Befreiung ist aufzuheben.
test "§ 1859 Absatz 3: Aufhebung der Befreiung bei festgestellter Gefährdung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m28:B"), entity_ref("urn:de:bgb:bt:m28:X")) { origin case_input; }
        assert "f2": verwandter_gerader_linie(entity_ref("urn:de:bgb:bt:m28:B"), entity_ref("urn:de:bgb:bt:m28:X")) { origin case_input; }
        assert "f3": gefaehrdung_1821_abs3_nr1_liegt_vor(entity_ref("urn:de:bgb:bt:m28:X")) { origin adjudicated; }
    }
    evaluate truth(befreiung_1859_aufzuheben(entity_ref("urn:de:bgb:bt:m28:B"), entity_ref("urn:de:bgb:bt:m28:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
