language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1842: Geldanlage nach § 1839 oder § 1841 Absatz 2 bei einem Kreditinstitut.
test "§ 1842: Kreditinstitut muss ausreichender Sicherungseinrichtung angehören" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m09:B"), entity_ref("urn:de:bgb:bt:m09:X")) { origin case_input; }
        assert "f2": geldanlage_nach_1839_oder_1841abs2_bei_kreditinstitut(entity_ref("urn:de:bgb:bt:m09:B"), entity_ref("urn:de:bgb:bt:m09:X")) { origin case_input; }
    }
    evaluate truth(kreditinstitut_muss_sicherungseinrichtung_angehoeren(entity_ref("urn:de:bgb:bt:m09:B"), entity_ref("urn:de:bgb:bt:m09:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
