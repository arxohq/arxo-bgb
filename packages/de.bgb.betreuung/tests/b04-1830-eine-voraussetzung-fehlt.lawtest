language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1830 Absatz 1, Kanarienvogel «minus eine Voraussetzung»: dieselben Tatsachen wie b03, aber ohne Nummer 5 (kein anderes zumutbares Mittel) — die kumulativ verlangte Einwilligung bleibt unzulässig.
test "§ 1830 Absatz 1: fehlende fünfte Voraussetzung schließt die Einwilligung aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": sterilisationsbetreuer_bestellt(entity_ref("urn:de:bgb:bt:b04:SB"), entity_ref("urn:de:bgb:bt:b04:X")) { origin case_input; }
        assert "f2": sterilisation_entspricht_natuerlichem_willen(entity_ref("urn:de:bgb:bt:b04:X")) { origin adjudicated; }
        assert "f3": betreuter_bleibt_dauerhaft_einwilligungsunfaehig(entity_ref("urn:de:bgb:bt:b04:X")) { origin adjudicated; }
        assert "f4": ohne_sterilisation_schwangerschaft_anzunehmen(entity_ref("urn:de:bgb:bt:b04:X")) { origin adjudicated; }
        assert "f5": schwangerschaft_gefaehrdet_leben_oder_gesundheit_unabwendbar(entity_ref("urn:de:bgb:bt:b04:X")) { origin adjudicated; }
    }
    evaluate truth(sterilisationseinwilligung_zulaessig(entity_ref("urn:de:bgb:bt:b04:SB"), entity_ref("urn:de:bgb:bt:b04:X")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
