language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1814 Absatz 1: Krankheit oder Behinderung, aufgrund derer der Volljährige seine Angelegenheiten rechtlich nicht besorgen kann.
test "§ 1814 Absatz 1: Voraussetzungen der Betreuerbestellung erfüllt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": kann_angelegenheiten_rechtlich_nicht_besorgen(entity_ref("urn:de:bgb:bt:b01:V")) { origin adjudicated; }
        assert "f2": krankheit_oder_behinderung(entity_ref("urn:de:bgb:bt:b01:V")) { origin adjudicated; }
    }
    evaluate truth(voraussetzungen_der_betreuerbestellung_1814(entity_ref("urn:de:bgb:bt:b01:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
