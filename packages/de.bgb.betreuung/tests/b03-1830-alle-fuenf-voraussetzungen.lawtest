language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1830 Absatz 1: alle fünf kumulativen Voraussetzungen der Sterilisationseinwilligung liegen vor.
test "§ 1830 Absatz 1: alle fünf Voraussetzungen der Sterilisationseinwilligung erfüllt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": sterilisationsbetreuer_bestellt(entity_ref("urn:de:bgb:bt:b03:SB"), entity_ref("urn:de:bgb:bt:b03:X")) { origin case_input; }
        assert "f2": sterilisation_entspricht_natuerlichem_willen(entity_ref("urn:de:bgb:bt:b03:X")) { origin adjudicated; }
        assert "f3": betreuter_bleibt_dauerhaft_einwilligungsunfaehig(entity_ref("urn:de:bgb:bt:b03:X")) { origin adjudicated; }
        assert "f4": ohne_sterilisation_schwangerschaft_anzunehmen(entity_ref("urn:de:bgb:bt:b03:X")) { origin adjudicated; }
        assert "f5": schwangerschaft_gefaehrdet_leben_oder_gesundheit_unabwendbar(entity_ref("urn:de:bgb:bt:b03:X")) { origin adjudicated; }
        assert "f6": schwangerschaft_nicht_durch_andere_zumutbare_mittel_verhinderbar(entity_ref("urn:de:bgb:bt:b03:X")) { origin adjudicated; }
    }
    evaluate truth(sterilisationseinwilligung_zulaessig(entity_ref("urn:de:bgb:bt:b03:SB"), entity_ref("urn:de:bgb:bt:b03:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
