language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1783 Absatz 1 Nummer 5: Aufforderung am 05.01.2026 (Montag); vier Wochen (§ 187 Abs. 1: Tag nicht mitgerechnet) enden am 02.02.2026 — ebenfalls ein Montag, keine Verlegung. Keine Bereiterklärung bis dahin: die benannte Person darf übergangen werden.
test "§ 1783 Absatz 1 Nummer 5: keine Bereiterklärung binnen vier Wochen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_TAG; calendar KALENDER_BUNDESWEIT; }
        assert "f1": massgebliche_elterliche_benennung(entity_ref("urn:de:bgb:bt:f03:B"), entity_ref("urn:de:bgb:bt:f03:M")) { origin case_input; }
        assert "f2": aufforderungsfrist_1783(entity_ref("urn:de:bgb:bt:f03:F")) { origin case_input; }
        assert "f3": aufforderung_durch_familiengericht_am(entity_ref("urn:de:bgb:bt:f03:F"), @2026-01-05) { origin case_input; }
        assert "f4": betrifft_person_1783(entity_ref("urn:de:bgb:bt:f03:F"), entity_ref("urn:de:bgb:bt:f03:B"), entity_ref("urn:de:bgb:bt:f03:M")) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:bt:f03:F"), @2026-02-02));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(benannte_person_uebergangen(entity_ref("urn:de:bgb:bt:f03:B"), entity_ref("urn:de:bgb:bt:f03:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
