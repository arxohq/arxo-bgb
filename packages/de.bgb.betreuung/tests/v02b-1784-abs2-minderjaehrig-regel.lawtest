language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1784 Absatz 2 Nummer 1: Minderjährigkeit ist ein Regelausschluss — schwächer als Absatz 1, andere Kopfrelation.
test "§ 1784 Absatz 2 Nummer 1: Minderjährigkeit als Regelausschluss" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": minderjaehrig(entity_ref("urn:de:bgb:bt:v02b:P")) { origin case_input; }
    }
    evaluate truth(regelmaessig_nicht_zum_vormund_zu_bestellen(entity_ref("urn:de:bgb:bt:v02b:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(nicht_zum_vormund_bestellbar(entity_ref("urn:de:bgb:bt:v02b:P")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
