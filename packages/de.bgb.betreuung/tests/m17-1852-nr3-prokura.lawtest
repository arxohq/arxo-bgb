language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1852 Nummer 3: Erteilung einer Prokura.
test "§ 1852 Nummer 3: Genehmigung zur Erteilung einer Prokura" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m17:B"), entity_ref("urn:de:bgb:bt:m17:X")) { origin case_input; }
        assert "f2": erteilung_einer_prokura(entity_ref("urn:de:bgb:bt:m17:B"), entity_ref("urn:de:bgb:bt:m17:X")) { origin case_input; }
    }
    evaluate truth(genehmigung_1852_erforderlich(entity_ref("urn:de:bgb:bt:m17:B"), entity_ref("urn:de:bgb:bt:m17:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
