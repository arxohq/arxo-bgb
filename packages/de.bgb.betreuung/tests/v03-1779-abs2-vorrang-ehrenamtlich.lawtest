language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1779 Absatz 2 Satz 1: eine geeignete und bereite ehrenamtliche Person hat Vorrang.
test "§ 1779 Absatz 2: Vorrang des ehrenamtlichen Vormunds" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": ehrenamtlich_geeignet_und_bereit(entity_ref("urn:de:bgb:bt:v03:V"), entity_ref("urn:de:bgb:bt:v03:M")) { origin case_input; }
    }
    evaluate truth(vorrang_des_ehrenamtlichen_vormunds(entity_ref("urn:de:bgb:bt:v03:V"), entity_ref("urn:de:bgb:bt:v03:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
