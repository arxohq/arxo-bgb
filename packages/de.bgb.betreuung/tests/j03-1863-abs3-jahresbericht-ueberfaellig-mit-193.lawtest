language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1863 Absatz 3 Satz 1: Übernahme der Betreuung am 10.01.2026 (Samstag); die Jahresfrist endet kalendarisch am 10.01.2027 — einem Sonntag — und wird durch § 193 auf Montag, den 11.01.2027, verlegt (die cross-package Regel de.bgb.fristen::Verlegung193). Kein Jahresbericht bis dahin: er ist überfällig.
test "§ 1863 Absatz 3: Jahresbericht überfällig nach Verlegung des Sonntags auf Montag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": betreuung_uebernommen_am(entity_ref("urn:de:bgb:bt:j03:B"), entity_ref("urn:de:bgb:bt:j03:X"), @2026-01-10) { origin case_input; }
        assert "f2": jahresbericht_faellig_am(entity_ref("urn:de:bgb:bt:j03:B"), entity_ref("urn:de:bgb:bt:j03:X"), entity_ref("urn:de:bgb:bt:j03:F")) { origin case_input; }
        assert "f3": jahresberichtsfrist_ereignistag(entity_ref("urn:de:bgb:bt:j03:F"), @2026-01-10) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:bt:j03:F"), @2027-01-11));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(jahresbericht_ueberfaellig(entity_ref("urn:de:bgb:bt:j03:B"), entity_ref("urn:de:bgb:bt:j03:X"), entity_ref("urn:de:bgb:bt:j03:F")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
