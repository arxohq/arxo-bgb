language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1851 Nummer 1: Ausschlagung einer Erbschaft — Genehmigung erforderlich.
test "§ 1851 Nummer 1: Genehmigung zur Ausschlagung einer Erbschaft" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m15:B"), entity_ref("urn:de:bgb:bt:m15:X")) { origin case_input; }
        assert "f2": ausschlagung_erbschaft_vermaechtnis_oder_verzicht(entity_ref("urn:de:bgb:bt:m15:B"), entity_ref("urn:de:bgb:bt:m15:X")) { origin case_input; }
    }
    evaluate truth(genehmigung_1851_erforderlich(entity_ref("urn:de:bgb:bt:m15:B"), entity_ref("urn:de:bgb:bt:m15:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
