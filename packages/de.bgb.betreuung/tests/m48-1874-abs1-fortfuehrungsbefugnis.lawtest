language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1874 Absatz 1: keine Kenntnis der Beendigung — Fortführungsbefugnis.
test "§ 1874 Absatz 1: Fortführungsbefugnis ohne Kenntnis der Beendigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m48:B"), entity_ref("urn:de:bgb:bt:m48:X")) { origin case_input; }
        assert "f2": betreuer_kennt_beendigung_nicht_und_muss_sie_nicht_kennen(entity_ref("urn:de:bgb:bt:m48:B"), entity_ref("urn:de:bgb:bt:m48:X")) { origin case_input; }
    }
    evaluate truth(fortfuehrungsbefugnis_1874(entity_ref("urn:de:bgb:bt:m48:B"), entity_ref("urn:de:bgb:bt:m48:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
