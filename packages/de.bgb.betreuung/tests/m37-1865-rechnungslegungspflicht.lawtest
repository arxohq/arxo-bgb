language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1865: Vermögensverwaltung gehört zum Aufgabenkreis — jährliche Rechnungslegungspflicht.
test "§ 1865: jährliche Rechnungslegungspflicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m37:B"), entity_ref("urn:de:bgb:bt:m37:X")) { origin case_input; }
        assert "f2": vermoegensverwaltung_gehoert_zum_aufgabenkreis(entity_ref("urn:de:bgb:bt:m37:B"), entity_ref("urn:de:bgb:bt:m37:X")) { origin case_input; }
    }
    evaluate truth(rechnungslegungspflicht_1865(entity_ref("urn:de:bgb:bt:m37:B"), entity_ref("urn:de:bgb:bt:m37:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
