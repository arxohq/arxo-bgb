language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1847: Beginn eines neuen Erwerbsgeschäfts im Namen des Betreuten.
test "§ 1847: Anzeigepflicht bei Beginn eines neuen Erwerbsgeschäfts" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m14:B"), entity_ref("urn:de:bgb:bt:m14:X")) { origin case_input; }
        assert "f2": neues_erwerbsgeschaeft_im_namen_des_betreuten_begonnen(entity_ref("urn:de:bgb:bt:m14:B"), entity_ref("urn:de:bgb:bt:m14:X")) { origin case_input; }
    }
    evaluate truth(anzeigepflicht_erwerbsgeschaeft_1847(entity_ref("urn:de:bgb:bt:m14:B"), entity_ref("urn:de:bgb:bt:m14:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
