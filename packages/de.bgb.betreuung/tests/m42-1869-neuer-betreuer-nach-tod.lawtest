language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1869: Betreuer verstorben — neuer Betreuer zu bestellen.
test "§ 1869: neuer Betreuer nach Tod des Betreuers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m42:B"), entity_ref("urn:de:bgb:bt:m42:X")) { origin case_input; }
        assert "f2": betreuer_verstorben(entity_ref("urn:de:bgb:bt:m42:B")) { origin case_input; }
    }
    evaluate truth(neuer_betreuer_zu_bestellen_pflicht(entity_ref("urn:de:bgb:bt:m42:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
