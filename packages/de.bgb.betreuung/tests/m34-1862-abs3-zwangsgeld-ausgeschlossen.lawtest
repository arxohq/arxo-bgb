language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1862 Absatz 3 Satz 3: Betreuer ist die Betreuungsbehörde — kein Zwangsgeld.
test "§ 1862 Absatz 3: kein Zwangsgeld gegen die Betreuungsbehörde" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m34:B"), entity_ref("urn:de:bgb:bt:m34:X")) { origin case_input; }
        assert "f2": betreuer_ist_behoerde_oder_verein_1862(entity_ref("urn:de:bgb:bt:m34:B")) { origin case_input; }
    }
    evaluate truth(zwangsgeld_gegen_betreuer_ausgeschlossen_1862(entity_ref("urn:de:bgb:bt:m34:B"), entity_ref("urn:de:bgb:bt:m34:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
