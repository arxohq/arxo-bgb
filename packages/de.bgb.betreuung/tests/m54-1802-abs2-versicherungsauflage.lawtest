language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1802 Absatz 2 Satz 4: Familiengericht gibt Versicherung auf — Pflicht des Vormunds, sie abzuschließen.
test "§ 1802 Absatz 2: Versicherungsauflagenpflicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m54:V"), entity_ref("urn:de:bgb:bt:m54:M")) { origin case_input; }
        assert "f2": gericht_ordnet_versicherungsauflage_an(entity_ref("urn:de:bgb:bt:m54:V"), entity_ref("urn:de:bgb:bt:m54:M")) { origin adjudicated; }
    }
    evaluate truth(vormund_hat_versicherung_abzuschliessen(entity_ref("urn:de:bgb:bt:m54:V"), entity_ref("urn:de:bgb:bt:m54:M")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
