language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1873 Absatz 2: Betreuerwechsel — Prüfungspflicht des Gerichts.
test "§ 1873 Absatz 2: Prüfungspflicht bei Betreuerwechsel" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": betreuerwechsel_1872(entity_ref("urn:de:bgb:bt:m47:B"), entity_ref("urn:de:bgb:bt:m47:X"), entity_ref("urn:de:bgb:bt:m47:N")) { origin case_input; }
    }
    evaluate truth(pruefungspflicht_schlussrechnung_oder_uebersicht_1873(entity_ref("urn:de:bgb:bt:m47:B"), entity_ref("urn:de:bgb:bt:m47:X"), entity_ref("urn:de:bgb:bt:m47:N")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
