language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1837 Absatz 1: Erwerb von Todes wegen mit Anordnungen des Erblassers.
test "§ 1837 Absatz 1: Verwaltungspflicht nach den Anordnungen des Erblassers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m05:B"), entity_ref("urn:de:bgb:bt:m05:X")) { origin case_input; }
        assert "f2": erwerb_von_todes_wegen_oder_unentgeltliche_zuwendung(entity_ref("urn:de:bgb:bt:m05:B"), entity_ref("urn:de:bgb:bt:m05:X")) { origin case_input; }
        assert "f3": anordnungen_des_erblassers_oder_zuwendenden_getroffen(entity_ref("urn:de:bgb:bt:m05:B"), entity_ref("urn:de:bgb:bt:m05:X")) { origin case_input; }
    }
    evaluate truth(verwaltung_nach_anordnungen_pflicht(entity_ref("urn:de:bgb:bt:m05:B"), entity_ref("urn:de:bgb:bt:m05:X")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
