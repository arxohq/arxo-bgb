language "law.core" version "0.2";
package de.bgb.betreuung version "0.1.0";
namespace "urn:de:corpus:clir:bgb-betreuung";
// § 1857: der Betreuer behauptet wahrheitswidrig die Genehmigung; der andere Teil kannte das Fehlen nicht — Widerrufsrecht.
test "§ 1857: Widerrufsrecht bei wahrheitswidriger Behauptung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_BETREUUNG_KALENDER; calendar KALENDER_BUNDESWEIT; }
        assert "f1": gesetzlicher_vertreter(entity_ref("urn:de:bgb:bt:m22:B"), entity_ref("urn:de:bgb:bt:m22:X")) { origin case_input; }
        assert "f2": betreuer_behauptet_wahrheitswidrig_genehmigung(entity_ref("urn:de:bgb:bt:m22:B"), entity_ref("urn:de:bgb:bt:m22:X"), entity_ref("urn:de:bgb:bt:m22:D")) { origin case_input; }
    }
    evaluate truth(widerrufsrecht_1857(entity_ref("urn:de:bgb:bt:m22:B"), entity_ref("urn:de:bgb:bt:m22:X"), entity_ref("urn:de:bgb:bt:m22:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
