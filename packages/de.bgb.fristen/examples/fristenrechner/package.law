language "law.core" version "0.2";
package examples.de.bgb.fristenrechner version "0.1.0";
namespace "urn:law:examples:de:bgb:fristenrechner";

import de.bgb.fristen version "0.1.0";
import de.bgb.core version "0.1.0";

// Case packages resolve deadline policies locally (§86/§168.2). Parameters
// repeat the two BGB policies: day periods under § 187 (1) / § 188 (1)
// (`next_day`, roll to the next working day) and calendar periods under
// § 188 (2) and (3) (`same_day`, no roll, last day of the month). § 193
// for calendar periods is computed in the canon (`Verlegung193`).
deadline policy BGB_FRISTEN_TAG {
    start_count next_day;
    include_end true;
    roll next_working_day;
}

deadline policy BGB_FRISTEN_KALENDER {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

// EIGHT FILES. No norm is written here.
//
// Day-count dossiers use TAG in their own context. The live page carries
// one §86 policy (KALENDER): month-end, year-end, Höchstfrist and age.
