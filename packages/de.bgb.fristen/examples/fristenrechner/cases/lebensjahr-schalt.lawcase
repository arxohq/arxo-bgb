language "law.core" version "0.2";
package examples.de.bgb.fristenrechner version "0.1.0";
namespace "urn:law:examples:de:bgb:fristenrechner";

case LebensjahrSchalt {
    context {
        deadline_policy examples.de.bgb.fristenrechner::BGB_FRISTEN_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2026-09-17;
        knowledge_time @2026-09-17T09:00:00Z;
        decision_time @2026-09-17T09:00:00Z;
        timezone "Europe/Berlin";
    }
    const f: de.bgb.fristen::Frist = entity_ref("urn:de:bgb:p3:frist");
    const a: de.bgb.core::Anspruch = entity_ref("urn:de:bgb:p3:anspruch");
    const p: de.bgb.core::Person = entity_ref("urn:de:bgb:p3:person");
    assert "g": de.bgb.fristen::geburtstag(p, @2000-02-29) { origin case_input; }
    assert "n": de.bgb.fristen::lebensjahr_gefragt(p, 25 calendar_year) { origin case_input; }
}
