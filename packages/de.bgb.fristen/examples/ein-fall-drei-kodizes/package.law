language "law.core" version "0.2";
package examples.de.bgb.ein_fall_drei_kodizes version "0.1.0";
namespace "urn:law:examples:de:bgb:ein-fall-drei-kodizes";

import de.bgb.ius_privatum version "0.1.0";
import de.bgb.fristen version "0.1.0";
import de.bgb.core version "0.1.0";
import fr.code_civil version "0.1.0";
import unidroit.picc_limitation version "0.1.0";
import unidroit.picc version "0.1.0";
import doctrine.ius_privatum version "0.1.0";

// One policy per case (§168.2). Names copy the three canons.
deadline policy BGB_FRISTEN_KALENDER {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

deadline policy OECD_CODE_CIVIL_PRESCRIPTION {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

deadline policy PICC_LIMITATION {
    start_count next_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}
