language "law.core" version "0.2";
package examples.de.bgb.ein_fall_drei_kodizes version "0.1.0";
namespace "urn:law:examples:de:bgb:ein-fall-drei-kodizes";

case ZweiJahre_PICC {
    context {
        deadline_policy examples.de.bgb.ein_fall_drei_kodizes::PICC_LIMITATION;
        legal_time @2016-06-01;
        knowledge_time @2016-06-01T12:00:00Z;
        decision_time @2016-06-01T12:00:00Z;
        timezone "UTC";
    }
    assert "right": unidroit.picc_limitation::right_of(entity_ref("urn:p12:right"), entity_ref("urn:p12:contract"), entity_ref("urn:p12:obligee"), entity_ref("urn:p12:obligor")) { origin case_input; }
    assert "governed": unidroit.picc_limitation::right_governed_by_principles(entity_ref("urn:p12:right")) { origin case_input; }
    assert "persona-ee": unidroit.picc_limitation::persona_of_party(entity_ref("urn:p12:obligee"), entity_ref("urn:p12:persona:g")) { origin case_input; }
    assert "persona-or": unidroit.picc_limitation::persona_of_party(entity_ref("urn:p12:obligor"), entity_ref("urn:p12:persona:s")) { origin case_input; }
    assert "causa": unidroit.picc_limitation::causa_of_right(entity_ref("urn:p12:right"), entity_ref("urn:p12:causa")) { origin case_input; }
    assert "petitio": doctrine.ius_privatum::petitio(entity_ref("urn:p12:causa"), entity_ref("urn:p12:persona:g"), entity_ref("urn:p12:persona:s")) { origin case_input; }
}
