language "law.core" version "0.2";
package examples.de.bgb.ein_fall_drei_kodizes version "0.1.0";
namespace "urn:law:examples:de:bgb:ein-fall-drei-kodizes";

case FuenfJahre_BGB {
    context {
        deadline_policy examples.de.bgb.ein_fall_drei_kodizes::BGB_FRISTEN_KALENDER;
        calendar "urn:de:corpus:clir:bgb-fristen#KALENDER_BUNDESWEIT";
        legal_time @2016-01-02;
        knowledge_time @2016-01-02T12:00:00Z;
        decision_time @2016-01-02T12:00:00Z;
        timezone "Europe/Berlin";
    }
    const a: de.bgb.core::Anspruch = entity_ref("urn:p12:anspruch");
    const g: de.bgb.core::Person = entity_ref("urn:p12:person:g");
    const s: de.bgb.core::Person = entity_ref("urn:p12:person:s");
    assert "entstanden": de.bgb.core::anspruch_entstanden_am(a, @2010-03-15) { origin case_input; }
    assert "kenntnis": de.bgb.fristen::kenntnis_erlangt_am(a, @2010-03-15) { origin adjudicated; }
    assert "keine-hemmung": de.bgb.fristen::keine_hemmung(a) { origin case_input; }
    assert "einrede": de.bgb.fristen::schuldner_beruft_sich_auf_verjaehrung(a) { origin case_input; }
    assert "inhaber": de.bgb.core::anspruchsinhaber(a, g) { origin case_input; }
    assert "gegner": de.bgb.core::anspruchsgegner(a, s) { origin case_input; }
    assert "persona-g": de.bgb.ius_privatum::persona_of(g, entity_ref("urn:p12:persona:g")) { origin case_input; }
    assert "persona-s": de.bgb.ius_privatum::persona_of(s, entity_ref("urn:p12:persona:s")) { origin case_input; }
    assert "causa": de.bgb.ius_privatum::causa_of_anspruch(a, entity_ref("urn:p12:causa")) { origin case_input; }
    assert "petitio": doctrine.ius_privatum::petitio(entity_ref("urn:p12:causa"), entity_ref("urn:p12:persona:g"), entity_ref("urn:p12:persona:s")) { origin case_input; }
}
