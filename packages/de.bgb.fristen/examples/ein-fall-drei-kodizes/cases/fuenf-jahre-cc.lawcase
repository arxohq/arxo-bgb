language "law.core" version "0.2";
package examples.de.bgb.ein_fall_drei_kodizes version "0.1.0";
namespace "urn:law:examples:de:bgb:ein-fall-drei-kodizes";

case FuenfJahre_CC {
    context {
        deadline_policy examples.de.bgb.ein_fall_drei_kodizes::OECD_CODE_CIVIL_PRESCRIPTION;
        legal_time @2016-01-02;
        knowledge_time @2016-01-02T12:00:00Z;
        decision_time @2016-01-02T12:00:00Z;
        timezone "UTC";
    }
    assert "exigible": fr.code_civil::creance_exigible_depuis(entity_ref("urn:p12:causa"), @2010-03-15) { origin case_input; }
    assert "connaissance": fr.code_civil::titulaire_connait_les_faits_le(entity_ref("urn:p12:causa"), @2010-03-15) { origin case_input; }
    assert "action": fr.code_civil::action_introduite_le(entity_ref("urn:p12:causa"), @2016-01-02) { origin case_input; }
    assert "sans-interruption": fr.code_civil::prescription_non_interrompue(entity_ref("urn:p12:causa")) { origin case_input; }
    assert "petitio": doctrine.ius_privatum::petitio(entity_ref("urn:p12:causa"), entity_ref("urn:p12:persona:g"), entity_ref("urn:p12:persona:s")) { origin case_input; }
}
