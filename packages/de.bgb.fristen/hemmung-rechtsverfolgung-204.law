// § 204 Abs. 1 Nr. 1–14 (Nr. 1a weggefallen): Aufschlüsselung des
// Hemmungsgrundes `Rechtsverfolgung` (package.law, `Hemmungsgrund`-Enum,
// NICHT geändert) nach den 15 Einzeltatbeständen. Jede Regel speist
// denselben bestehenden Kopf `hemmungsgrund(a, Rechtsverfolgung)`, den die
// bestehende Regel `VerjaehrungNachHemmungDurchRechtsverfolgung` bereits
// verarbeitet — kein neuer Kopf, kein Hub-Eingriff, alle 15 Regeln teilen
// dasselbe `@source(BGB_P204)` (ein Fragment für den ganzen Paragraphen).
//
// § 204 Abs. 2 Satz 1 (Ende sechs Monate nach Beendigung) und Satz 2
// (Stillstand: letzte Verfahrenshandlung an der Stelle der Beendigung)
// stehen als EIGENSTÄNDIGE, informative Berechnung
// `hemmung_204_ende_berechnet`: sie lesen keinen bestehenden Kopf und
// schreiben nicht in `hemmung` (Hub-Schutz — `hemmung` bleibt im Pilot
// Falleingabe, D-04). Satz 3 (Wiederbetreiben setzt die Hemmung erneut in
// Gang) ist NICHT modelliert — TODO (README).

pub enum Paragraph204Grund {
    label de official "Einzeltatbestand der Hemmung durch Rechtsverfolgung (§ 204 Abs. 1 Nr. 1–14)";
    label en unofficial "individual ground for suspension by prosecution of rights (§ 204 (1) nos. 1-14)";
    Nr1Klageerhebung,
    Nr2VereinfachtesVerfahrenUnterhaltMinderjaehriger,
    Nr3MahnbescheidOderEuropaeischerZahlungsbefehl,
    Nr4Streitbeilegungsstelle,
    Nr5AufrechnungImProzess,
    Nr6Streitverkuendung,
    Nr6aMusterverfahrenBekanntmachung,
    Nr7SelbstaendigesBeweisverfahren,
    Nr8VereinbartesBegutachtungsverfahren,
    Nr9ArrestEinstweiligeVerfuegungOderAnordnung,
    Nr10InsolvenzOderSchifffahrtsrechtlichesVerteilungsverfahren,
    Nr10aVollstreckungssperre,
    Nr11SchiedsrichterlichesVerfahren,
    Nr12AntragBeiBehoerde,
    Nr13AntragBeiHoeheremGericht,
    Nr14Prozesskostenhilfe
}

pub relation paragraph204_grund(a: Anspruch, grund: Paragraph204Grund) kind empirical {
    key(a);
    label de official "Einzeltatbestand des § 204 Abs. 1, aus dem die Hemmung durch Rechtsverfolgung folgt";
    label en unofficial "individual ground of § 204 (1) from which suspension by prosecution of rights follows";
}

@source(BGB_P204)
rule Paragraph204Nr1(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Erhebung der Klage auf Leistung oder auf Feststellung des Anspruchs, auf Erteilung der Vollstreckungsklausel oder auf Erlass des Vollstreckungsurteils (§ 204 Abs. 1 Nr. 1)";
    label en unofficial "Limitation is suspended by bringing an action for performance or declaration of the claim, for the grant of an enforcement clause, or for an enforcement judgment (§ 204 (1) no. 1)";
    when paragraph204_grund(a, Nr1Klageerhebung);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr2(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Zustellung des Antrags im vereinfachten Verfahren über den Unterhalt Minderjähriger (§ 204 Abs. 1 Nr. 2)";
    label en unofficial "Limitation is suspended by service of the application in the simplified procedure for maintenance of minors (§ 204 (1) no. 2)";
    when paragraph204_grund(a, Nr2VereinfachtesVerfahrenUnterhaltMinderjaehriger);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr3(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Zustellung des Mahnbescheids im Mahnverfahren oder des Europäischen Zahlungsbefehls im Europäischen Mahnverfahren (§ 204 Abs. 1 Nr. 3)";
    label en unofficial "Limitation is suspended by service of the payment order in the dunning procedure or the European order for payment in the European order for payment procedure (§ 204 (1) no. 3)";
    when paragraph204_grund(a, Nr3MahnbescheidOderEuropaeischerZahlungsbefehl);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr4(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Veranlassung der Bekanntgabe eines Antrags bei einer staatlichen oder staatlich anerkannten Streitbeilegungsstelle, oder bei einer anderen Streitbeilegungsstelle im Einvernehmen mit dem Antragsgegner (§ 204 Abs. 1 Nr. 4)";
    label en unofficial "Limitation is suspended by causing notification of an application to a state or state-recognised dispute resolution body, or to another such body with the respondent's agreement (§ 204 (1) no. 4)";
    when paragraph204_grund(a, Nr4Streitbeilegungsstelle);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr5(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Geltendmachung der Aufrechnung des Anspruchs im Prozess (§ 204 Abs. 1 Nr. 5)";
    label en unofficial "Limitation is suspended by asserting set-off of the claim in proceedings (§ 204 (1) no. 5)";
    when paragraph204_grund(a, Nr5AufrechnungImProzess);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr6(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Zustellung der Streitverkündung (§ 204 Abs. 1 Nr. 6)";
    label en unofficial "Limitation is suspended by service of a third-party notice (§ 204 (1) no. 6)";
    when paragraph204_grund(a, Nr6Streitverkuendung);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr6a(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die öffentliche Bekanntmachung des Vorlagebeschlusses in einem Musterverfahren, wenn die Ansprüche zum Musterverfahren angemeldet werden (§ 204 Abs. 1 Nr. 6a)";
    label en unofficial "Limitation is suspended by public notice of the referral order in a model proceeding, if the claims are registered for the model proceeding (§ 204 (1) no. 6a)";
    when paragraph204_grund(a, Nr6aMusterverfahrenBekanntmachung);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr7(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Zustellung des Antrags auf Durchführung eines selbständigen Beweisverfahrens (§ 204 Abs. 1 Nr. 7)";
    label en unofficial "Limitation is suspended by service of the application for independent evidentiary proceedings (§ 204 (1) no. 7)";
    when paragraph204_grund(a, Nr7SelbstaendigesBeweisverfahren);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr8(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch den Beginn eines vereinbarten Begutachtungsverfahrens (§ 204 Abs. 1 Nr. 8)";
    label en unofficial "Limitation is suspended by the commencement of an agreed expert evaluation procedure (§ 204 (1) no. 8)";
    when paragraph204_grund(a, Nr8VereinbartesBegutachtungsverfahren);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr9(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Zustellung des Antrags auf Erlass eines Arrests, einer einstweiligen Verfügung oder einer einstweiligen Anordnung, oder dessen Einreichung, wenn rechtzeitig zugestellt (§ 204 Abs. 1 Nr. 9)";
    label en unofficial "Limitation is suspended by service of the application for an attachment, an interim injunction or an interim order, or by its filing if timely served (§ 204 (1) no. 9)";
    when paragraph204_grund(a, Nr9ArrestEinstweiligeVerfuegungOderAnordnung);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr10(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Anmeldung des Anspruchs im Insolvenzverfahren oder im schifffahrtsrechtlichen Verteilungsverfahren (§ 204 Abs. 1 Nr. 10)";
    label en unofficial "Limitation is suspended by registering the claim in insolvency proceedings or in maritime distribution proceedings (§ 204 (1) no. 10)";
    when paragraph204_grund(a, Nr10InsolvenzOderSchifffahrtsrechtlichesVerteilungsverfahren);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr10a(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Anordnung einer Vollstreckungssperre nach dem Unternehmensstabilisierungs- und -restrukturierungsgesetz (§ 204 Abs. 1 Nr. 10a)";
    label en unofficial "Limitation is suspended by an order staying enforcement under the Business Stabilisation and Restructuring Act (§ 204 (1) no. 10a)";
    when paragraph204_grund(a, Nr10aVollstreckungssperre);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr11(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch den Beginn des schiedsrichterlichen Verfahrens (§ 204 Abs. 1 Nr. 11)";
    label en unofficial "Limitation is suspended by the commencement of arbitral proceedings (§ 204 (1) no. 11)";
    when paragraph204_grund(a, Nr11SchiedsrichterlichesVerfahren);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr12(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Einreichung des Antrags bei einer Behörde, wenn die Zulässigkeit der Klage von deren Vorentscheidung abhängt und rechtzeitig Klage erhoben wird (§ 204 Abs. 1 Nr. 12)";
    label en unofficial "Limitation is suspended by filing the application with an authority, if the admissibility of the action depends on its preliminary decision and an action is timely brought (§ 204 (1) no. 12)";
    when paragraph204_grund(a, Nr12AntragBeiBehoerde);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr13(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Einreichung des Antrags bei dem höheren Gericht, das das zuständige Gericht zu bestimmen hat, wenn rechtzeitig Klage erhoben oder der Antrag gestellt wird (§ 204 Abs. 1 Nr. 13)";
    label en unofficial "Limitation is suspended by filing the application with the higher court empowered to determine the competent court, if an action is timely brought or the application is timely made (§ 204 (1) no. 13)";
    when paragraph204_grund(a, Nr13AntragBeiHoeheremGericht);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204)
rule Paragraph204Nr14(a: Anspruch) strict {
    label de official "Die Verjährung wird gehemmt durch die Veranlassung der Bekanntgabe des erstmaligen Antrags auf Gewährung von Prozesskostenhilfe oder Verfahrenskostenhilfe; wird die Bekanntgabe demnächst veranlasst, tritt die Hemmung bereits mit der Einreichung ein (§ 204 Abs. 1 Nr. 14)";
    label en unofficial "Limitation is suspended by causing notification of the first application for legal aid; if notification is caused promptly, suspension occurs already upon filing (§ 204 (1) no. 14)";
    when paragraph204_grund(a, Nr14Prozesskostenhilfe);
    then hemmungsgrund(a, Rechtsverfolgung);
}

// --- § 204 Abs. 2: Ende der Hemmung -----------------------------------------------------------------

pub relation verfahren_beendet_oder_letzte_verfahrenshandlung_am(a: Anspruch, tag: Date) kind empirical {
    key(a);
    label de official "Tag der rechtskräftigen Entscheidung oder anderweitigen Beendigung des Verfahrens (§ 204 Abs. 2 Satz 1); gerät das Verfahren in Stillstand, tritt an dessen Stelle der Tag der letzten Verfahrenshandlung (§ 204 Abs. 2 Satz 2)";
    label en unofficial "day of the final decision or other termination of the proceedings (§ 204 (2) sentence 1); if the proceedings come to a standstill, the day of the last procedural act takes its place (§ 204 (2) sentence 2)";
}
pub relation hemmung_204_ende_berechnet(a: Anspruch, tag: Date) kind institutional {
    key(a);
    label de official "Ende der Hemmung nach § 204 Abs. 2: sechs Monate nach der Beendigung oder, bei Stillstand, nach der letzten Verfahrenshandlung — informative Berechnung, nicht automatisch in `hemmung` übernommen (Pilot-Grenze D-04)";
    label en unofficial "end of the suspension under § 204 (2): six months after termination or, in case of standstill, after the last procedural act — an informative computation, not automatically fed into `hemmung` (pilot boundary D-04)";
}

// --- § 204a Abs. 1 Nr. 3, 4: Verbraucherverbandsklagen ----------------------------------------------
//
// Nr. 1 (einstweilige Verfügung gegen Unternehmer nach UKlaG/UWG, Stelle
// nach § 3 Abs. 1 Satz 1 UKlaG) und Nr. 2 (Klage zur Durchsetzung
// desselben Unterlassungsanspruchs) bleiben GRENZE: beide setzen die
// Anspruchsverknüpfung „aufgrund der Zuwiderhandlung, gegen die sich der
// Unterlassungsanspruch richtet" voraus, für die dieses Paket keine
// Entität hat (Unterlassungsanspruch selbst liegt in Fachpaketen). Nr. 3
// und 4 sind demgegenüber durch EINE Falleingabe (Anmeldung zum
// Verbandsklageregister) vollständig bestimmt.

pub enum Paragraph204aGrund {
    label de official "Einzeltatbestand der Hemmung durch Verbraucherverbandsklagen (§ 204a Abs. 1 Nr. 3, 4)";
    label en unofficial "individual ground for suspension by consumer association actions (§ 204a (1) nos. 3, 4)";
    Nr3Musterfeststellungsklage,
    Nr4Abhilfeklage
}

pub relation paragraph204a_grund(a: Anspruch, grund: Paragraph204aGrund) kind empirical {
    key(a);
    label de official "Einzeltatbestand des § 204a Abs. 1 Nr. 3 oder 4";
    label en unofficial "individual ground of § 204a (1) no. 3 or 4";
}
pub relation anmeldung_zum_verbandsklageregister(a: Anspruch) kind empirical {
    label de official "die Verbraucher melden ihren Anspruch zum Verbandsklageregister an (§ 204a Abs. 1 Nr. 3, 4)";
    label en unofficial "the consumers register their claim in the collective action register (§ 204a (1) nos. 3, 4)";
}

@source(BGB_P204a)
rule Paragraph204aNr3(a: Anspruch) strict {
    label de official "Die Verjährung von Ansprüchen von Verbrauchern gegen Unternehmer wird auch gehemmt durch die Erhebung einer Musterfeststellungsklage für Ansprüche, denen derselbe Lebenssachverhalt zugrunde liegt, wenn die Verbraucher ihren Anspruch zum Verbandsklageregister anmelden (§ 204a Abs. 1 Satz 1 Nr. 3)";
    label en unofficial "Limitation of consumers' claims against businesses is also suspended by bringing a model declaratory action for claims arising from the same facts, if the consumers register their claim in the collective action register (§ 204a (1) sentence 1 no. 3)";
    when paragraph204a_grund(a, Nr3Musterfeststellungsklage) and anmeldung_zum_verbandsklageregister(a);
    then hemmungsgrund(a, Rechtsverfolgung);
}
@source(BGB_P204a)
rule Paragraph204aNr4(a: Anspruch) strict {
    label de official "Die Verjährung von Ansprüchen von Verbrauchern gegen Unternehmer wird auch gehemmt durch die Erhebung einer Abhilfeklage für Ansprüche, die deren Gegenstand sind, wenn die Verbraucher ihren Anspruch zum Verbandsklageregister anmelden (§ 204a Abs. 1 Satz 1 Nr. 4)";
    label en unofficial "Limitation of consumers' claims against businesses is also suspended by bringing a redress action for claims that are its subject, if the consumers register their claim in the collective action register (§ 204a (1) sentence 1 no. 4)";
    when paragraph204a_grund(a, Nr4Abhilfeklage) and anmeldung_zum_verbandsklageregister(a);
    then hemmungsgrund(a, Rechtsverfolgung);
}

@source(BGB_P204)
rule Para204Abs2Ende(a: Anspruch, tag: Date) strict {
    label de official "Die Hemmung nach Absatz 1 endet sechs Monate nach der rechtskräftigen Entscheidung oder anderweitigen Beendigung des eingeleiteten Verfahrens; gerät das Verfahren in Stillstand, tritt an die Stelle der Beendigung die letzte Verfahrenshandlung (§ 204 Abs. 2 Satz 1, 2) — Monatsschritt (§ 188 Abs. 2)";
    label en unofficial "Suspension under paragraph (1) ends six months after the final decision or other termination of the proceedings initiated; if the proceedings come to a standstill, the last procedural act takes the place of termination (§ 204 (2) sentences 1, 2) — month step (§ 188 (2))";
    when verfahren_beendet_oder_letzte_verfahrenshandlung_am(a, tag);
    then hemmung_204_ende_berechnet(a, add_calendar_period(tag, 6 calendar_month));
}
