// DEONTISCHE POSITIONEN — VERJÄHRUNG (§§ 194–216)
// Normative positions are triggered by dated case facts; the calculation
// rules remain separate in the existing fristen layer.

pub relation leistungsverweigerung_214_beginn_am(a: Anspruch, p: de.bgb.core::Person, tag: Date) kind empirical {
    key(a);
    label de official "Beginn des Rechts des Schuldners zur Leistungsverweigerung nach § 214";
    label en unofficial "start of the debtor's right to refuse performance under § 214";
}
@source(BGB_P214)
rule PositionLeistungsverweigerung214(a: Anspruch, p: de.bgb.core::Person, tag: Date) strict {
    label de official "Der Schuldner darf die Leistung wegen Verjährung verweigern (§ 214 Abs. 1)";
    label en unofficial "The debtor may refuse performance because of limitation (§ 214 (1))";
    when leistungsverweigerung_214_beginn_am(a, p, tag);
    then liberty LibertyLeistungsverweigerung214 {
        holder p;
        action leistungsverweigerung_214_beginn_am(a, p, tag);
        window [tag, infinity);
    };
}

pub relation aufrechnung_215_beginn_am(a: Anspruch, p: de.bgb.core::Person, tag: Date) kind empirical {
    key(a);
    label de official "Beginn des Rechts zur Aufrechnung trotz Verjährung nach § 215";
    label en unofficial "start of the right to set off despite limitation under § 215";
}
@source(BGB_P215)
rule PositionAufrechnung215(a: Anspruch, p: de.bgb.core::Person, tag: Date) strict {
    label de official "Der Berechtigte darf trotz Verjährung aufrechnen (§ 215)";
    label en unofficial "The entitled party may set off despite limitation (§ 215)";
    when aufrechnung_215_beginn_am(a, p, tag);
    then liberty LibertyAufrechnung215 {
        holder p;
        action aufrechnung_215_beginn_am(a, p, tag);
        window [tag, infinity);
    };
}

pub relation befriedigung_216_beginn_am(a: Anspruch, p: de.bgb.core::Person, tag: Date) kind empirical {
    key(a);
    label de official "Beginn des Rechts zur Befriedigung aus dem Sicherungsgegenstand nach § 216";
    label en unofficial "start of the right to seek satisfaction from collateral under § 216";
}
@source(BGB_P216)
rule PositionBefriedigung216(a: Anspruch, p: de.bgb.core::Person, tag: Date) strict {
    label de official "Der Gläubiger darf Befriedigung aus dem belasteten Gegenstand suchen (§ 216 Abs. 1)";
    label en unofficial "The creditor may seek satisfaction from the encumbered asset (§ 216 (1))";
    when befriedigung_216_beginn_am(a, p, tag);
    then liberty LibertyBefriedigung216 {
        holder p;
        action befriedigung_216_beginn_am(a, p, tag);
        window [tag, infinity);
    };
}


