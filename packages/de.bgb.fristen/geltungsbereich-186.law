// § 186: Geltungsbereich. Für die in Gesetzen, gerichtlichen Verfügungen
// und Rechtsgeschäften enthaltenen Frist- und Terminsbestimmungen gelten
// die Auslegungsvorschriften der §§ 187 bis 193. Die Mechanik des Pakets
// (TagesfristEnde, KalenderfristEnde, Verlegung193) wendet §§ 187–193
// bereits unbedingt auf jede `Frist` an; § 186 wird hier additiv als
// bestätigende Klassifikation der Quelle formalisiert — keine Änderung
// dieser bestehenden Regeln, keine neue Gate-Bedingung.

pub enum Fristquelle {
    label de official "Quelle der Frist- oder Terminsbestimmung (§ 186)";
    label en unofficial "source of the provision fixing the period or point in time (§ 186)";
    Gesetz,
    GerichtlicheVerfuegung,
    Rechtsgeschaeft
}

pub relation frist_quelle(f: Frist, quelle: Fristquelle) kind empirical {
    key(f);
    label de official "Quelle der Fristbestimmung: Gesetz, gerichtliche Verfügung oder Rechtsgeschäft (§ 186)";
    label en unofficial "source of the provision fixing the period: statute, court order, or legal transaction (§ 186)";
}
pub relation frist_unterliegt_auslegungsvorschriften_187_193(f: Frist) kind institutional {
    key(f);
    label de official "für die Fristbestimmung gelten die Auslegungsvorschriften der §§ 187 bis 193 (§ 186)";
    label en unofficial "the interpretation rules of §§ 187 to 193 apply to the provision fixing the period (§ 186)";
}

@source(BGB_P186)
rule Geltungsbereich186(f: Frist, q: Fristquelle) strict {
    label de official "Für die in Gesetzen, gerichtlichen Verfügungen und Rechtsgeschäften enthaltenen Frist- und Terminsbestimmungen gelten die Auslegungsvorschriften der §§ 187 bis 193 (§ 186)";
    label en unofficial "The interpretation rules of §§ 187 to 193 apply to provisions fixing periods or points in time contained in statutes, court orders and legal transactions (§ 186)";
    when frist_quelle(f, q);
    then frist_unterliegt_auslegungsvorschriften_187_193(f);
}
