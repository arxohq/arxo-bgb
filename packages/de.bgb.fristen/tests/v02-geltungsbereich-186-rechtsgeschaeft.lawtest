language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 186: eine in einem Rechtsgeschäft enthaltene Fristbestimmung unterliegt ebenfalls den §§ 187-193.
test "§ 186: eine in einem Rechtsgeschäft enthaltene Frist unterliegt den §§ 187-193" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_TAG; }
        assert "q": frist_quelle(entity_ref("urn:de:bgb:fristen:pilot:v02"), Rechtsgeschaeft) { origin case_input; }
    }
    evaluate truth(frist_unterliegt_auslegungsvorschriften_187_193(entity_ref("urn:de:bgb:fristen:pilot:v02")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
