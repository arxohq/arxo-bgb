language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// Kanarienvogel „minus eine Angabe": derselbe Fall wie so01, aber OHNE die
// ausdrückliche Angabe zur Hemmung. Beide Zwillinge des § 209 setzen eine
// solche Angabe voraus (`hemmungstage` oder `keine_hemmung`) — das Fehlen
// einer Angabe ist keine Verneinung (README, Konvention 6). Das Sonderfristende
// wird gerechnet, die gemeinsame Linie beginnt aber nicht: kein
// `verjaehrungsfrist_ende`, keine Wirkung der Verjährung.
test "Kanarie: ohne Angabe zur Hemmung erreicht die Sonderfrist die gemeinsame Linie nicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "b": sonderverjaehrung_beginn(entity_ref("urn:de:bgb:fristen:so06"), @2023-04-10) { origin case_input; }
        assert "d": sonderverjaehrung_dauer(entity_ref("urn:de:bgb:fristen:so06"), 2 calendar_year) { origin case_input; }
    }
    evaluate truth(sonderverjaehrungsfrist_ende(entity_ref("urn:de:bgb:fristen:so06"), @2025-04-10));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrungsfrist_ende(entity_ref("urn:de:bgb:fristen:so06"), @2025-04-10));
    expect truth_status == NEITHER;
    evaluate truth(verjaehrung_eingetreten_am(entity_ref("urn:de:bgb:fristen:so06"), @2025-04-10));
    expect truth_status == NEITHER;
}
