language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// Die im Paket selbst gerechnete besondere Frist des § 196 (zehn Jahre ab der
// Entstehung, § 200 Satz 1) erreicht mit den Zwillingen dieser Brücke nun
// ebenfalls §§ 209 und 214-218: Entstehung am 20. Mai 2016, Ende am 20. Mai
// 2026, ohne Hemmung; der Schuldner kann die Leistung verweigern (§ 214 Abs. 1).
test "§§ 196, 200, 209, 214: zehnjährige Frist ab Entstehung erreicht die Wirkung der Verjährung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:so05"), @2016-05-20) { origin case_input; }
        assert "g": anspruch_auf_grundstuecksrecht(entity_ref("urn:de:bgb:fristen:so05")) { origin case_input; }
        assert "h": keine_hemmung(entity_ref("urn:de:bgb:fristen:so05")) { origin case_input; }
    }
    evaluate truth(besondere_verjaehrungsfrist_ende(entity_ref("urn:de:bgb:fristen:so05"), @2026-05-20));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verjaehrungsfrist_ende(entity_ref("urn:de:bgb:fristen:so05"), @2026-05-20));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_eingetreten_am(entity_ref("urn:de:bgb:fristen:so05"), @2026-05-20));
    expect truth_status == TRUE_ONLY;
    evaluate truth(leistungsverweigerungsrecht_wegen_verjaehrung(entity_ref("urn:de:bgb:fristen:so05")));
    expect truth_status == TRUE_ONLY;
}
