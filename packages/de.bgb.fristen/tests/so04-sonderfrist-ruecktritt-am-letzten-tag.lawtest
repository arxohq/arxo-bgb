language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// Andere Seite der Grenze von so03: derselbe Sachverhalt, der Rücktritt wird
// aber AM 10. April 2025 erklärt — dem Tag, mit dessen Ablauf die Verjährung
// erst eintritt (§ 188 Abs. 1, 2). Der Rücktritt ist rechtzeitig und bleibt
// wirksam; § 218 Abs. 1 greift nicht. NEITHER, nicht FALSE: das Recht stellt
// die Unwirksamkeit nicht fest, es verneint sie nicht.
test "§§ 200, 218 Abs. 1: Rücktritt am letzten Tag der Sonderfrist bleibt wirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "b": sonderverjaehrung_beginn(entity_ref("urn:de:bgb:fristen:so04"), @2023-04-10) { origin case_input; }
        assert "d": sonderverjaehrung_dauer(entity_ref("urn:de:bgb:fristen:so04"), 2 calendar_year) { origin case_input; }
        assert "h": keine_hemmung(entity_ref("urn:de:bgb:fristen:so04")) { origin case_input; }
        assert "r": ruecktritt_erklaert_am(entity_ref("urn:de:bgb:fristen:so04"), @2025-04-10) { origin case_input; }
        assert "s": schuldner_beruft_sich_auf_verjaehrung(entity_ref("urn:de:bgb:fristen:so04")) { origin case_input; }
    }
    evaluate truth(verjaehrung_eingetreten_am(entity_ref("urn:de:bgb:fristen:so04"), @2025-04-10));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ruecktritt_unwirksam_wegen_verjaehrung(entity_ref("urn:de:bgb:fristen:so04")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
