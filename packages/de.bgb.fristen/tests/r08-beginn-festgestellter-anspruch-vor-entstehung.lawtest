language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 201: Rechtskraft (1. Januar 2020) liegt vor der Entstehung (15. März 2020) — Beginn nicht vor der Entstehung, also 15. März 2020.
test "§ 201: Beginn nicht vor der Entstehung, wenn die Rechtskraft früher liegt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:r08"), @2020-03-15) { origin case_input; }
        assert "g": dreissigjaehriger_grund(entity_ref("urn:de:bgb:fristen:pilot:r08"), RechtskraeftigFestgestellt) { origin case_input; }
        assert "r": rechtskraft_titel_oder_feststellung_am(entity_ref("urn:de:bgb:fristen:pilot:r08"), @2020-01-01) { origin case_input; }
    }
    evaluate truth(besondere_verjaehrungsfrist_beginn(entity_ref("urn:de:bgb:fristen:pilot:r08"), @2020-03-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
