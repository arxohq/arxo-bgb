language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 196: Anspruch auf Übertragung des Eigentums an einem Grundstück, entstanden am 15. März 2020, verjährt in zehn Jahren — Ende 15. März 2030.
test "§ 196: Anspruch auf ein Grundstücksrecht verjährt in zehn Jahren — Ende am 15. März 2030" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:r03"), @2020-03-15) { origin case_input; }
        assert "g": anspruch_auf_grundstuecksrecht(entity_ref("urn:de:bgb:fristen:pilot:r03")) { origin case_input; }
    }
    evaluate truth(besondere_verjaehrungsfrist_dauer(entity_ref("urn:de:bgb:fristen:pilot:r03"), 10 calendar_year));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(besondere_verjaehrungsfrist_beginn(entity_ref("urn:de:bgb:fristen:pilot:r03"), @2020-03-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(besondere_verjaehrungsfrist_ende(entity_ref("urn:de:bgb:fristen:pilot:r03"), @2030-03-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
