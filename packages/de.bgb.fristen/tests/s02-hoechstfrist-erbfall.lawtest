language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 199 Abs. 3a: Anspruch aus Erbfall, entstanden am 1. Juni 2015 — Höchstfrist endet 30 Jahre später, am 1. Juni 2045.
test "§ 199 Abs. 3a: Höchstfrist bei Erbfall endet 30 Jahre nach der Entstehung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "k": hoechstfrist_kategorie(entity_ref("urn:de:bgb:fristen:pilot:s02"), Erbfall) { origin case_input; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:s02"), @2015-06-01) { origin case_input; }
    }
    evaluate truth(hoechstfrist_ende(entity_ref("urn:de:bgb:fristen:pilot:s02"), @2045-06-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
