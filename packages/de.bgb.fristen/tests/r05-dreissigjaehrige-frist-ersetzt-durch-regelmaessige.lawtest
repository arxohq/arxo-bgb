language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 197 Abs. 2: rechtskräftig festgestellter Anspruch mit künftig regelmäßig wiederkehrenden Leistungen — regelmäßige Frist von drei statt 30 Jahren.
test "§ 197 Abs. 2: künftig regelmäßig wiederkehrende Leistungen ersetzen 30 Jahre durch die regelmäßige Frist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:r05"), @2020-03-15) { origin case_input; }
        assert "g": dreissigjaehriger_grund(entity_ref("urn:de:bgb:fristen:pilot:r05"), RechtskraeftigFestgestellt) { origin case_input; }
        assert "k": kuenftig_regelmaessig_wiederkehrende_leistung(entity_ref("urn:de:bgb:fristen:pilot:r05")) { origin case_input; }
    }
    evaluate truth(besondere_verjaehrungsfrist_dauer(entity_ref("urn:de:bgb:fristen:pilot:r05"), 3 calendar_year));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(besondere_verjaehrungsfrist_dauer(entity_ref("urn:de:bgb:fristen:pilot:r05"), 30 calendar_year));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
