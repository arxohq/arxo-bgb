language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 212 Abs. 1 Nr. 1: Abschlagszahlung am 15. Juni 2022 — die Verjährung beginnt erneut; mit dreijähriger Frist endet sie am 15. Juni 2025.
test "§ 212 Abs. 1 Nr. 1: Abschlagszahlung lässt die Verjährung am 15. Juni 2022 erneut beginnen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "a": anerkenntnis_durch(entity_ref("urn:de:bgb:fristen:pilot:x01"), Abschlagszahlung, @2022-06-15) { origin case_input; }
        assert "d": verjaehrungsfrist_dauer_nach_neubeginn(entity_ref("urn:de:bgb:fristen:pilot:x01"), 3 calendar_year) { origin case_input; }
    }
    evaluate truth(neubeginn_ereignis_am(entity_ref("urn:de:bgb:fristen:pilot:x01"), @2022-06-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_nach_neubeginn_am(entity_ref("urn:de:bgb:fristen:pilot:x01"), @2025-06-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_massgeblich_am(entity_ref("urn:de:bgb:fristen:pilot:x01"), @2025-06-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
