language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 187 Abs. 1, § 188 Abs. 1: Ereignis Freitag, 6. März 2026; 14 Tage, der Ereignistag zählt nicht: 7.–20. März; das Ende (Freitag) ist Werktag — keine Verlegung.
test "§§ 187 Abs. 1, 188 Abs. 1: Ereignisfrist von 14 Tagen endet am 20. März 2026" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_TAG; }
        assert "e": frist_ereignis(entity_ref("urn:de:bgb:fristen:pilot:f01"), @2026-03-06) { origin case_input; }
        assert "d": frist_dauer_tage(entity_ref("urn:de:bgb:fristen:pilot:f01"), 14 calendar_day) { origin case_input; }
    }
    evaluate truth(frist_ende(entity_ref("urn:de:bgb:fristen:pilot:f01"), @2026-03-20));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
