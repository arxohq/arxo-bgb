language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 189 Abs. 1: "ein Vierteljahr" = drei Monate. Ereignis Donnerstag, 15. Januar 2026; Ende Mittwoch, 15. April 2026 (Werktag, keine Verlegung).
test "§ 189 Abs. 1: ein Vierteljahr sind drei Monate — Ende am 15. April 2026" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": frist_ereignis(entity_ref("urn:de:bgb:fristen:pilot:q02"), @2026-01-15) { origin case_input; }
        assert "b": frist_dauer_benannt(entity_ref("urn:de:bgb:fristen:pilot:q02"), Vierteljahr) { origin case_input; }
    }
    evaluate truth(frist_dauer_kalender(entity_ref("urn:de:bgb:fristen:pilot:q02"), 3 calendar_month));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(frist_ende(entity_ref("urn:de:bgb:fristen:pilot:q02"), @2026-04-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
