language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 213: der wahlweise gegebene Anspruch b übernimmt die für a maßgebliche Verjährung (mit Neubeginn, wie x01, Ende 15. Juni 2025).
test "§ 213: der wahlweise gegebene Anspruch übernimmt die maßgebliche Verjährung des Grundanspruchs" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "a": anerkenntnis_durch(entity_ref("urn:de:bgb:fristen:pilot:x06a"), Abschlagszahlung, @2022-06-15) { origin case_input; }
        assert "d": verjaehrungsfrist_dauer_nach_neubeginn(entity_ref("urn:de:bgb:fristen:pilot:x06a"), 3 calendar_year) { origin case_input; }
        assert "w": wahlweise_anspruch(entity_ref("urn:de:bgb:fristen:pilot:x06a"), entity_ref("urn:de:bgb:fristen:pilot:x06b")) { origin case_input; }
    }
    evaluate truth(verjaehrung_massgeblich_am_wahlweise(entity_ref("urn:de:bgb:fristen:pilot:x06b"), @2025-06-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
