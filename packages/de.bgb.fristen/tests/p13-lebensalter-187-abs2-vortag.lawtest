language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 187 Abs. 2 Satz 2, § 188 Abs. 2: geboren am 15. April 2008 — das 18. Lebensjahr ist mit Ablauf des 14. April 2026 vollendet (der Tag vor dem 18. Geburtstag), nicht am 15. April.
test "§ 187 Abs. 2, § 188 Abs. 2: das 18. Lebensjahr ist mit Ablauf des Vortags des Geburtstags vollendet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "g": geburtstag(entity_ref("urn:de:bgb:fristen:pilot:person13"), @2008-04-15) { origin case_input; }
        assert "n": lebensjahr_gefragt(entity_ref("urn:de:bgb:fristen:pilot:person13"), 18 calendar_year) { origin case_input; }
    }
    evaluate truth(lebensjahr_vollendet_am(entity_ref("urn:de:bgb:fristen:pilot:person13"), 18 calendar_year, @2026-04-14));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(lebensjahr_vollendet_am(entity_ref("urn:de:bgb:fristen:pilot:person13"), 18 calendar_year, @2026-04-15));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
