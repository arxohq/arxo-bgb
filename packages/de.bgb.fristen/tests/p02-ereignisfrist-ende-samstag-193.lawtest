language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 193: Ereignis Sonnabend, 7. März 2026; 14 Tage ab dem 8. März enden Sonnabend, 21. März — nächster Werktag ist Montag, 23. März.
test "§ 193: Fristende am Sonnabend wird auf Montag, 23. März 2026 verlegt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_TAG; }
        assert "e": frist_ereignis(entity_ref("urn:de:bgb:fristen:pilot:f02"), @2026-03-07) { origin case_input; }
        assert "d": frist_dauer_tage(entity_ref("urn:de:bgb:fristen:pilot:f02"), 14 calendar_day) { origin case_input; }
    }
    evaluate truth(frist_ende(entity_ref("urn:de:bgb:fristen:pilot:f02"), @2026-03-23));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
