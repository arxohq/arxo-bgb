language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 212 Abs. 1 Nr. 2: Vollstreckungshandlung am 1. März 2023, keine Rückausnahme — Neubeginn.
test "§ 212 Abs. 1 Nr. 2: Vollstreckungshandlung lässt die Verjährung erneut beginnen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "v": vollstreckungshandlung_vorgenommen_oder_beantragt_am(entity_ref("urn:de:bgb:fristen:pilot:x02"), @2023-03-01) { origin case_input; }
        assert "d": verjaehrungsfrist_dauer_nach_neubeginn(entity_ref("urn:de:bgb:fristen:pilot:x02"), 3 calendar_year) { origin case_input; }
    }
    evaluate truth(neubeginn_ereignis_am(entity_ref("urn:de:bgb:fristen:pilot:x02"), @2023-03-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
