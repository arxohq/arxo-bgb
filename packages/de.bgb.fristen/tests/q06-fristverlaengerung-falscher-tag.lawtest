language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 190 (Gegenprobe): die neue Frist beginnt NICHT am Ablauf der vorigen Frist (21. statt 20. März) — die Norm stellt die richtige Berechnung nicht fest.
test "§ 190: falscher Ereignistag der neuen Frist — keine Feststellung nach § 190" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_TAG; }
        assert "ea": frist_ereignis(entity_ref("urn:de:bgb:fristen:pilot:q06a"), @2026-03-06) { origin case_input; }
        assert "da": frist_dauer_tage(entity_ref("urn:de:bgb:fristen:pilot:q06a"), 14 calendar_day) { origin case_input; }
        assert "v": frist_verlaengert_aus(entity_ref("urn:de:bgb:fristen:pilot:q06b"), entity_ref("urn:de:bgb:fristen:pilot:q06a")) { origin case_input; }
        assert "en": frist_ereignis(entity_ref("urn:de:bgb:fristen:pilot:q06b"), @2026-03-21) { origin case_input; }
    }
    evaluate truth(frist_verlaengerung_korrekt_berechnet(entity_ref("urn:de:bgb:fristen:pilot:q06b")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
