language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// Gesamtkopf ohne Neubeginn: die reguläre Verjährung (wie p06, Ende 31. Dezember 2023) bleibt maßgeblich.
test "ohne Neubeginn bleibt die reguläre Verjährung maßgeblich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:x05"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:x05"), @2020-03-15) { origin adjudicated; }
        assert "h": keine_hemmung(entity_ref("urn:de:bgb:fristen:pilot:x05")) { origin case_input; }
        assert "n": kein_neubeginn(entity_ref("urn:de:bgb:fristen:pilot:x05")) { origin case_input; }
    }
    evaluate truth(verjaehrung_massgeblich_am(entity_ref("urn:de:bgb:fristen:pilot:x05"), @2023-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
