language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 217: mit dem Hauptanspruch (verjährt am 31. Dezember 2023) verjährt auch der Anspruch auf die abhängende Nebenleistung.
test "§ 217: die Nebenleistung verjährt mit dem Hauptanspruch" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:u06h"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:u06h"), @2020-03-15) { origin adjudicated; }
        assert "hh": keine_hemmung(entity_ref("urn:de:bgb:fristen:pilot:u06h")) { origin case_input; }
        assert "n": nebenleistung_von(entity_ref("urn:de:bgb:fristen:pilot:u06n"), entity_ref("urn:de:bgb:fristen:pilot:u06h")) { origin case_input; }
    }
    evaluate truth(verjaehrung_eingetreten_am_nebenleistung(entity_ref("urn:de:bgb:fristen:pilot:u06n"), @2023-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
