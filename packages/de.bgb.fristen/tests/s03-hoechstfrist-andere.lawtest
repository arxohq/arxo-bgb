language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 199 Abs. 4: sonstiger Anspruch, entstanden am 10. Januar 2020 — Höchstfrist endet zehn Jahre später, am 10. Januar 2030.
test "§ 199 Abs. 4: Höchstfrist anderer Ansprüche endet zehn Jahre nach der Entstehung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "k": hoechstfrist_kategorie(entity_ref("urn:de:bgb:fristen:pilot:s03"), Andere) { origin case_input; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:s03"), @2020-01-10) { origin case_input; }
    }
    evaluate truth(hoechstfrist_ende(entity_ref("urn:de:bgb:fristen:pilot:s03"), @2030-01-10));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
