language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 210 Abs. 1 (Gegenprobe): Vertretungsmangel bereits am 1. Januar 2021 behoben — sechs Monate später (1. Juli 2021) liegt vor dem regulären Ende (31. Dezember 2023); die reguläre Frist bleibt maßgeblich.
test "§ 210 Abs. 1: liegt der Sechs-Monats-Zeitpunkt vor dem regulären Ende, bleibt dieses maßgeblich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:t02"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:t02"), @2020-03-15) { origin adjudicated; }
        assert "h": keine_hemmung(entity_ref("urn:de:bgb:fristen:pilot:t02")) { origin case_input; }
        assert "v": vertretungsmangel_behoben_am(entity_ref("urn:de:bgb:fristen:pilot:t02"), @2021-01-01) { origin case_input; }
    }
    evaluate truth(verjaehrung_eingetreten_am_mit_ablaufhemmung_210(entity_ref("urn:de:bgb:fristen:pilot:t02"), @2023-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
