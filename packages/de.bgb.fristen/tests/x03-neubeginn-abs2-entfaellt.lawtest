language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 212 Abs. 2: die Vollstreckungshandlung wird auf Antrag des Gläubigers aufgehoben — der Neubeginn gilt als nicht eingetreten.
test "§ 212 Abs. 2: Neubeginn entfällt bei Aufhebung der Vollstreckungshandlung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "v": vollstreckungshandlung_vorgenommen_oder_beantragt_am(entity_ref("urn:de:bgb:fristen:pilot:x03"), @2023-03-01) { origin case_input; }
        assert "auf": vollstreckungshandlung_aufgehoben_auf_antrag_oder_mangel(entity_ref("urn:de:bgb:fristen:pilot:x03")) { origin case_input; }
    }
    evaluate truth(neubeginn_ereignis_am(entity_ref("urn:de:bgb:fristen:pilot:x03"), @2023-03-01));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
