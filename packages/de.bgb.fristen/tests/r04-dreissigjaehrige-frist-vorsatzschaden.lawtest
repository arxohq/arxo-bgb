language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 197 Abs. 1 Nr. 1: Schadensersatzanspruch aus vorsätzlicher Verletzung, entstanden am 15. März 2020, verjährt in 30 Jahren — Ende 15. März 2050.
test "§ 197 Abs. 1 Nr. 1: Schadensersatzanspruch aus vorsätzlicher Verletzung verjährt in 30 Jahren" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:r04"), @2020-03-15) { origin case_input; }
        assert "g": dreissigjaehriger_grund(entity_ref("urn:de:bgb:fristen:pilot:r04"), VorsaetzlicheVerletzung) { origin case_input; }
    }
    evaluate truth(besondere_verjaehrungsfrist_dauer(entity_ref("urn:de:bgb:fristen:pilot:r04"), 30 calendar_year));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(besondere_verjaehrungsfrist_ende(entity_ref("urn:de:bgb:fristen:pilot:r04"), @2050-03-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
