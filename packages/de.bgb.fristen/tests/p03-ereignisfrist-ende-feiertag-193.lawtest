language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 193: Ereignis Freitag, 17. April 2026; 14 Tage ab dem 18. April enden Freitag, 1. Mai (Tag der Arbeit, bundesweit); Sonnabend und Sonntag folgen — nächster Werktag ist Montag, 4. Mai.
test "§ 193: Fristende am Feiertag (1. Mai) wird auf Montag, 4. Mai 2026 verlegt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_TAG; }
        assert "e": frist_ereignis(entity_ref("urn:de:bgb:fristen:pilot:f03"), @2026-04-17) { origin case_input; }
        assert "d": frist_dauer_tage(entity_ref("urn:de:bgb:fristen:pilot:f03"), 14 calendar_day) { origin case_input; }
    }
    evaluate truth(frist_ende(entity_ref("urn:de:bgb:fristen:pilot:f03"), @2026-05-04));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
