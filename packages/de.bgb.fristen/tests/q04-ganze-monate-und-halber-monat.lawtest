language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 189 Abs. 2: zwei ganze Monate und ein halber Monat — erst der Monatsschritt (Ereignis 10. Januar 2026 + 2 Monate = 10. März 2026), dann 15 Tage zuletzt gezählt: Ende 25. März 2026 (Werktag).
test "§ 189 Abs. 2: zwei Monate und ein halber Monat enden am 25. März 2026 — 15 Tage zuletzt gezählt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": frist_ereignis(entity_ref("urn:de:bgb:fristen:pilot:q04"), @2026-01-10) { origin case_input; }
        assert "m": frist_dauer_monate_und_halber_monat(entity_ref("urn:de:bgb:fristen:pilot:q04"), 2 calendar_month) { origin case_input; }
    }
    evaluate truth(frist_ende_kalender(entity_ref("urn:de:bgb:fristen:pilot:q04"), @2026-03-25));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(frist_ende(entity_ref("urn:de:bgb:fristen:pilot:q04"), @2026-03-25));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
