language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 192: Ende des Monats Februar 2026 = 28. Februar (Sonnabend); § 193 verlegt auf Montag, 2. März 2026 (1. März ist Sonntag).
test "§ 192 und § 193: Ende des Monats Februar 2026 verlegt auf den 2. März" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "r": monat_referenz(entity_ref("urn:de:bgb:fristen:pilot:q11"), @2026-02-10) { origin case_input; }
        assert "b": frist_dauer_monatsbezeichnung(entity_ref("urn:de:bgb:fristen:pilot:q11"), Ende) { origin case_input; }
    }
    evaluate truth(frist_ende_kalender(entity_ref("urn:de:bgb:fristen:pilot:q11"), @2026-02-28));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(frist_ende(entity_ref("urn:de:bgb:fristen:pilot:q11"), @2026-03-02));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
