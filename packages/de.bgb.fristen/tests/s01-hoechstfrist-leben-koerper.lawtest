language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 199 Abs. 2: Schadensersatz aus Körperverletzung, Begehung am 1. Mai 2010 — Höchstfrist endet 30 Jahre später, am 1. Mai 2040.
test "§ 199 Abs. 2: Höchstfrist bei Körperverletzung endet 30 Jahre nach der Begehung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "k": hoechstfrist_kategorie(entity_ref("urn:de:bgb:fristen:pilot:s01"), LebenKoerperGesundheitFreiheit) { origin case_input; }
        assert "h": begehung_pflichtverletzung_oder_ereignis_am(entity_ref("urn:de:bgb:fristen:pilot:s01"), @2010-05-01) { origin case_input; }
    }
    evaluate truth(hoechstfrist_ende(entity_ref("urn:de:bgb:fristen:pilot:s01"), @2040-05-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
