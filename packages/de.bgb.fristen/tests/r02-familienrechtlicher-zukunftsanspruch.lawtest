language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 194 Abs. 2 Nr. 2: familienrechtlicher Zukunftsanspruch unterliegt nicht der Verjährung.
test "§ 194 Abs. 2 Nr. 2: familienrechtlicher Zukunftsanspruch ist von der Verjährung ausgeschlossen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "f": familienrechtlicher_zukunftsanspruch(entity_ref("urn:de:bgb:fristen:pilot:r02")) { origin case_input; }
    }
    evaluate truth(verjaehrung_ausgeschlossen(entity_ref("urn:de:bgb:fristen:pilot:r02")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
