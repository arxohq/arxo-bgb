language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 211: reguläre Verjährung endet 31. Dezember 2023; Erbschaft erst am 1. November 2024 angenommen — frühestens 1. Mai 2025 ist maßgeblich.
test "§ 211: die Ablaufhemmung im Nachlassfall verschiebt die Verjährung auf den 1. Mai 2025" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:t03"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:t03"), @2020-03-15) { origin adjudicated; }
        assert "h": keine_hemmung(entity_ref("urn:de:bgb:fristen:pilot:t03")) { origin case_input; }
        assert "n": nachlassvertretung_moeglich_am(entity_ref("urn:de:bgb:fristen:pilot:t03"), @2024-11-01) { origin case_input; }
    }
    evaluate truth(verjaehrung_eingetreten_am_mit_ablaufhemmung_211(entity_ref("urn:de:bgb:fristen:pilot:t03"), @2025-05-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
