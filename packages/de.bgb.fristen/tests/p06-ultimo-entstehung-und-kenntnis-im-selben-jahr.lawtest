language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// §§ 195, 199 Abs. 1: Anspruch entstanden und Kenntnis am 15. März 2020 — Beginn mit dem Schluss des Jahres 2020 (31. Dezember 2020), drei Jahre: Ablauf des 31. Dezember 2023; keine Hemmung.
test "§§ 195, 199 Abs. 1: Verjährung beginnt am 31. Dezember 2020 und tritt mit Ablauf des 31. Dezember 2023 ein" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:a06"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:a06"), @2020-03-15) { origin adjudicated; }
        assert "h": keine_hemmung(entity_ref("urn:de:bgb:fristen:pilot:a06")) { origin case_input; }
    }
    evaluate truth(regelmaessige_verjaehrung_beginn(entity_ref("urn:de:bgb:fristen:pilot:a06"), @2020-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(regelmaessige_verjaehrungsfrist_ende(entity_ref("urn:de:bgb:fristen:pilot:a06"), @2023-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_eingetreten_am(entity_ref("urn:de:bgb:fristen:pilot:a06"), @2023-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
