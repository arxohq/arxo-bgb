language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 204 Abs. 2 Satz 1: Beendigung des Verfahrens am 1. Mai 2023 — Hemmung endet sechs Monate später, am 1. November 2023.
test "§ 204 Abs. 2: die Hemmung endet sechs Monate nach der Beendigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "b": verfahren_beendet_oder_letzte_verfahrenshandlung_am(entity_ref("urn:de:bgb:fristen:pilot:y04"), @2023-05-01) { origin case_input; }
    }
    evaluate truth(hemmung_204_ende_berechnet(entity_ref("urn:de:bgb:fristen:pilot:y04"), @2023-11-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
