language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 210 Abs. 1: reguläre Verjährung endet 31. Dezember 2023 (wie p06); Vertretungsmangel erst am 1. November 2024 behoben — frühestens 1. Mai 2025 (sechs Monate später) ist maßgeblich.
test "§ 210 Abs. 1: die Ablaufhemmung verschiebt die Verjährung auf den 1. Mai 2025" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:t01"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:t01"), @2020-03-15) { origin adjudicated; }
        assert "h": keine_hemmung(entity_ref("urn:de:bgb:fristen:pilot:t01")) { origin case_input; }
        assert "v": vertretungsmangel_behoben_am(entity_ref("urn:de:bgb:fristen:pilot:t01"), @2024-11-01) { origin case_input; }
    }
    evaluate truth(verjaehrung_eingetreten_am(entity_ref("urn:de:bgb:fristen:pilot:t01"), @2023-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ablaufhemmung_210_frueheste(entity_ref("urn:de:bgb:fristen:pilot:t01"), @2025-05-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_eingetreten_am_mit_ablaufhemmung_210(entity_ref("urn:de:bgb:fristen:pilot:t01"), @2025-05-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
