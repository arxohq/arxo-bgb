language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 215: der Anspruch war am 1. Juni 2023 (vor Verjährungseintritt 31. Dezember 2023) noch nicht verjährt — Aufrechnung zulässig.
test "§ 215: Aufrechnung bleibt zulässig, wenn der Anspruch beim erstmaligen Aufrechnenkönnen noch nicht verjährt war" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:u03"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:u03"), @2020-03-15) { origin adjudicated; }
        assert "h": keine_hemmung(entity_ref("urn:de:bgb:fristen:pilot:u03")) { origin case_input; }
        assert "a": anspruch_erstmals_aufrechenbar_oder_leistungsverweigerung_moeglich_am(entity_ref("urn:de:bgb:fristen:pilot:u03"), @2023-06-01) { origin case_input; }
    }
    evaluate truth(aufrechnung_trotz_verjaehrung_zulaessig(entity_ref("urn:de:bgb:fristen:pilot:u03")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
