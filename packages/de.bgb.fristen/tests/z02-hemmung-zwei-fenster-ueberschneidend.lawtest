language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 209: zwei sich überschneidende Fenster (1. März-30. April und 1. April-31. Mai 2022, je 61 Tage, Überschneidung 30 Tage) — Vereinigung 92 Tage; Ende verschiebt sich auf den 1. April 2024.
test "§ 209: zwei sich überschneidende Hemmungsfenster ergeben 92 Tage Vereinigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:z02"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:z02"), @2020-03-15) { origin adjudicated; }
        assert "f": hemmung_zwei_fenster(entity_ref("urn:de:bgb:fristen:pilot:z02"), @2022-03-01, @2022-04-30, @2022-04-01, @2022-05-31) { origin case_input; }
        assert "g": hemmungsgrund(entity_ref("urn:de:bgb:fristen:pilot:z02"), Rechtsverfolgung) { origin case_input; }
    }
    evaluate truth(ueberlappungstage(entity_ref("urn:de:bgb:fristen:pilot:z02"), 30));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(fenstertage_gesamt(entity_ref("urn:de:bgb:fristen:pilot:z02"), 92));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_eingetreten_am(entity_ref("urn:de:bgb:fristen:pilot:z02"), @2024-04-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
