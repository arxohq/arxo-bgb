language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 202 Abs. 2: eine vereinbarte Frist von 31 Jahren liegt über 30 Jahren hinaus — unzulässig.
test "§ 202 Abs. 2: Vereinbarung von 31 Jahren liegt über der Grenze von 30 Jahren" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "v": vereinbarung_ueber_verjaehrung(entity_ref("urn:de:bgb:fristen:pilot:r10")) { origin case_input; }
        assert "j": vereinbarte_verjaehrungsfrist_jahre(entity_ref("urn:de:bgb:fristen:pilot:r10"), 31) { origin case_input; }
    }
    evaluate truth(vereinbarung_ueber_verjaehrung_unzulaessig(entity_ref("urn:de:bgb:fristen:pilot:r10")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
