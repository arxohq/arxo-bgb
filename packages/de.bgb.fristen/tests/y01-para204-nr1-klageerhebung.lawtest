language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 204 Abs. 1 Nr. 1: Klageerhebung hemmt die Verjährung durch Rechtsverfolgung — wie p08, Hemmung 1. März bis 30. April 2022, regelmäßiges Ende 31. Dezember 2023 verschiebt sich auf den 1. März 2024.
test "§ 204 Abs. 1 Nr. 1: Klageerhebung ist Hemmung durch Rechtsverfolgung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:y01"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:y01"), @2020-03-15) { origin adjudicated; }
        assert "h": hemmung(entity_ref("urn:de:bgb:fristen:pilot:y01"), @2022-03-01, @2022-04-30) { origin case_input; }
        assert "g": paragraph204_grund(entity_ref("urn:de:bgb:fristen:pilot:y01"), Nr1Klageerhebung) { origin case_input; }
    }
    evaluate truth(hemmungsgrund(entity_ref("urn:de:bgb:fristen:pilot:y01"), Rechtsverfolgung));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrung_eingetreten_am(entity_ref("urn:de:bgb:fristen:pilot:y01"), @2024-03-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
