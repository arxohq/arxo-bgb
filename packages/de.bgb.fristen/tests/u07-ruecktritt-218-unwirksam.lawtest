language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 218 Abs. 1: der Rücktritt wegen des verjährten Nacherfüllungsanspruchs ist unwirksam, wenn sich der Schuldner auf die Verjährung beruft.
test "§ 218 Abs. 1: der Rücktritt ist unwirksam, wenn der Schuldner sich auf die Verjährung beruft" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:u07"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:u07"), @2020-03-15) { origin adjudicated; }
        assert "h": keine_hemmung(entity_ref("urn:de:bgb:fristen:pilot:u07")) { origin case_input; }
        assert "r": ruecktritt_erklaert_wegen(entity_ref("urn:de:bgb:fristen:pilot:u07")) { origin case_input; }
        assert "b": schuldner_beruft_sich_auf_verjaehrung(entity_ref("urn:de:bgb:fristen:pilot:u07")) { origin case_input; }
    }
    evaluate truth(ruecktritt_unwirksam_wegen_verjaehrung(entity_ref("urn:de:bgb:fristen:pilot:u07")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
