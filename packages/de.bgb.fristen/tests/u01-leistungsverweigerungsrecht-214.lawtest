language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 214 Abs. 1: nach Eintritt der Verjährung (wie p06, 31. Dezember 2023) ist der Schuldner berechtigt, die Leistung zu verweigern.
test "§ 214 Abs. 1: nach Verjährung besteht das Leistungsverweigerungsrecht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:u01"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:u01"), @2020-03-15) { origin adjudicated; }
        assert "h": keine_hemmung(entity_ref("urn:de:bgb:fristen:pilot:u01")) { origin case_input; }
    }
    evaluate truth(leistungsverweigerungsrecht_wegen_verjaehrung(entity_ref("urn:de:bgb:fristen:pilot:u01")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
