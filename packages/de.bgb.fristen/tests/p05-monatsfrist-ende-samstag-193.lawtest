language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 188 Abs. 2 und § 193: Ereignis Donnerstag, 30. April 2026, ein Monat — kalendarisches Ende Sonnabend, 30. Mai; nächster Werktag Montag, 1. Juni 2026.
test "§ 188 Abs. 2 und § 193: Monatsfrist vom 30. April endet am 1. Juni 2026" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": frist_ereignis(entity_ref("urn:de:bgb:fristen:pilot:f05"), @2026-04-30) { origin case_input; }
        assert "d": frist_dauer_kalender(entity_ref("urn:de:bgb:fristen:pilot:f05"), 1 calendar_month) { origin case_input; }
    }
    evaluate truth(frist_ende(entity_ref("urn:de:bgb:fristen:pilot:f05"), @2026-06-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
