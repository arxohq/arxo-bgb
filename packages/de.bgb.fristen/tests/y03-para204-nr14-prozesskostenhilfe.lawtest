language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 204 Abs. 1 Nr. 14: Antrag auf Prozesskostenhilfe hemmt die Verjährung durch Rechtsverfolgung.
test "§ 204 Abs. 1 Nr. 14: Prozesskostenhilfeantrag ist Hemmung durch Rechtsverfolgung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "g": paragraph204_grund(entity_ref("urn:de:bgb:fristen:pilot:y03"), Nr14Prozesskostenhilfe) { origin case_input; }
    }
    evaluate truth(hemmungsgrund(entity_ref("urn:de:bgb:fristen:pilot:y03"), Rechtsverfolgung));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
