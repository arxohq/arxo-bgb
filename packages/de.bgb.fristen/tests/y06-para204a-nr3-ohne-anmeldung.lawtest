language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 204a Abs. 1 Nr. 3 (Gegenprobe): ohne Anmeldung zum Verbandsklageregister keine Feststellung der Hemmung.
test "§ 204a Abs. 1 Nr. 3: ohne Anmeldung keine Feststellung der Hemmung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "g": paragraph204a_grund(entity_ref("urn:de:bgb:fristen:pilot:y06"), Nr3Musterfeststellungsklage) { origin case_input; }
    }
    evaluate truth(hemmungsgrund(entity_ref("urn:de:bgb:fristen:pilot:y06"), Rechtsverfolgung));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
