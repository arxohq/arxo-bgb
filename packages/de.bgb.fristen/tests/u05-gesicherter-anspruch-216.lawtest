language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 216 Abs. 1: trotz Verjährung des durch Hypothek gesicherten Anspruchs kann der Gläubiger Befriedigung aus dem Grundstück suchen.
test "§ 216 Abs. 1: Befriedigung aus dem Sicherungsgegenstand bleibt trotz Verjährung zulässig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:u05"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:u05"), @2020-03-15) { origin adjudicated; }
        assert "h": keine_hemmung(entity_ref("urn:de:bgb:fristen:pilot:u05")) { origin case_input; }
        assert "g": dinglich_gesicherter_anspruch(entity_ref("urn:de:bgb:fristen:pilot:u05")) { origin case_input; }
    }
    evaluate truth(befriedigung_aus_sicherungsgegenstand_trotz_verjaehrung_zulaessig(entity_ref("urn:de:bgb:fristen:pilot:u05")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
