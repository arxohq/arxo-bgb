language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 202 Abs. 2 (Gegenprobe): eine Vereinbarung von genau 30 Jahren liegt NICHT über der Grenze hinaus — keine Feststellung der Unzulässigkeit nach Absatz 2.
test "§ 202 Abs. 2: Vereinbarung von genau 30 Jahren ist nicht über die Grenze hinaus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "v": vereinbarung_ueber_verjaehrung(entity_ref("urn:de:bgb:fristen:pilot:r11")) { origin case_input; }
        assert "j": vereinbarte_verjaehrungsfrist_jahre(entity_ref("urn:de:bgb:fristen:pilot:r11"), 30) { origin case_input; }
    }
    evaluate truth(vereinbarung_ueber_verjaehrung_unzulaessig(entity_ref("urn:de:bgb:fristen:pilot:r11")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
