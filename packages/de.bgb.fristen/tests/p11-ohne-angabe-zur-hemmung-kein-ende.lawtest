language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// Fehlen einer Angabe ist keine Verneinung: ohne hemmung und ohne keine_hemmung bleibt das Ende der Verjährungsfrist offen (NEITHER), die regelmäßige Frist ist gleichwohl berechnet.
test "ohne Angabe zur Hemmung: regelmäßige Frist berechnet, Ende der Verjährungsfrist offen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "e": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:fristen:pilot:a11"), @2020-03-15) { origin case_input; }
        assert "k": kenntnis_erlangt_am(entity_ref("urn:de:bgb:fristen:pilot:a11"), @2020-03-15) { origin adjudicated; }
    }
    evaluate truth(regelmaessige_verjaehrungsfrist_ende(entity_ref("urn:de:bgb:fristen:pilot:a11"), @2023-12-31));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verjaehrungsfrist_ende(entity_ref("urn:de:bgb:fristen:pilot:a11"), @2023-12-31));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
