language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 189 Abs. 1: "ein halber Monat" = 15 Tage, als Tagesfrist gerechnet (§ 188 Abs. 1). Ereignis Donnerstag, 15. Januar 2026; Ende Freitag, 30. Januar 2026 (Werktag).
test "§ 189 Abs. 1: ein halber Monat sind 15 Tage — Ende am 30. Januar 2026" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_TAG; }
        assert "e": frist_ereignis(entity_ref("urn:de:bgb:fristen:pilot:q03"), @2026-01-15) { origin case_input; }
        assert "b": frist_dauer_benannt(entity_ref("urn:de:bgb:fristen:pilot:q03"), HalberMonat) { origin case_input; }
    }
    evaluate truth(frist_dauer_tage(entity_ref("urn:de:bgb:fristen:pilot:q03"), 15 calendar_day));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(frist_ende(entity_ref("urn:de:bgb:fristen:pilot:q03"), @2026-01-30));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
