language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 212 Abs. 3: dem Antrag auf Vollstreckungshandlung wurde nicht stattgegeben — der Neubeginn gilt als nicht eingetreten.
test "§ 212 Abs. 3: Neubeginn entfällt, wenn dem Antrag nicht stattgegeben wird" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "v": vollstreckungshandlung_vorgenommen_oder_beantragt_am(entity_ref("urn:de:bgb:fristen:pilot:x04"), @2023-03-01) { origin case_input; }
        assert "n": vollstreckungsantrag_nicht_erfolgreich_oder_zurueckgenommen(entity_ref("urn:de:bgb:fristen:pilot:x04")) { origin case_input; }
    }
    evaluate truth(neubeginn_ereignis_am(entity_ref("urn:de:bgb:fristen:pilot:x04"), @2023-03-01));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
