language "law.core" version "0.2";
package de.bgb.fristen version "0.1.0";
namespace "urn:de:corpus:clir:bgb-fristen";
// § 194 Abs. 2 Nr. 1: Ansprüche aus einem nicht verjährbaren Verbrechen unterliegen nicht der Verjährung.
test "§ 194 Abs. 2 Nr. 1: Anspruch aus nicht verjährbarem Verbrechen ist von der Verjährung ausgeschlossen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_FRISTEN_KALENDER; }
        assert "v": anspruch_aus_nicht_verjaehrbarem_verbrechen(entity_ref("urn:de:bgb:fristen:pilot:r01")) { origin case_input; }
    }
    evaluate truth(verjaehrung_ausgeschlossen(entity_ref("urn:de:bgb:fristen:pilot:r01")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
