// Словарь: вход — kind empirical, выход — kind derived.

language "law.core" version "0.2";
package calc.kinship version "0.1.0";
namespace "urn:law:calc:kinship";

// --- Вход ------------------------------------------------------------------------

pub relation family_degree_count(family: Family, policy: DegreeCount) kind empirical {
    label ru official "политика счёта степеней: римский либо канонический";
}
pub relation family_adoption_effect(family: Family, policy: AdoptionEffect) kind empirical {
    label ru official "политика усыновления: заменяет кровную ветвь либо добавляет";
}
pub relation family_depth_cap(family: Family, cap: Integer) kind empirical {
    label ru official "предел глубины предков, до которого считается родство";
}
pub relation parent_edge(family: Family, parent: Actor, child: Actor, kind: EdgeKind) kind empirical {
    label ru official "родительская связь: кровная либо по усыновлению";
}
pub relation spouse_edge(family: Family, first: Actor, second: Actor) kind empirical {
    label ru official "супруги (связь подаётся в одну сторону, читается в обе)";
}

// --- Выход: годность -------------------------------------------------------------

pub relation family_defect(family: Family, defect: KinshipDefect) kind derived {
    label ru official "дефект семьи";
}
relation family_declared(family: Family) kind derived {
    label ru official "семья упомянута входом и подлежит проверке";
}
pub relation family_wellformed(family: Family) kind derived {
    label ru official "семья пригодна к вычислению родства";
}

// --- Выход: граф ---------------------------------------------------------------------

pub relation member(family: Family, person: Actor) kind derived {
    label ru official "лицо участвует в графе семьи";
}
pub relation effective_parent(family: Family, parent: Actor, child: Actor) kind derived {
    label ru official "действующая родительская связь с учётом политики усыновления";
}
pub relation ancestor_or_self(family: Family, ancestor: Actor, person: Actor, depth: Integer) kind derived {
    label ru official "предок лица на данной глубине; глубина 0 — само лицо";
}
pub relation spouses(family: Family, first: Actor, second: Actor) kind derived {
    label ru official "супруги, в обе стороны";
}

// --- Выход: степень и линия -----------------------------------------------------------

relation degree_candidate(family: Family, first: Actor, second: Actor, degree: Integer) kind derived {
    label ru official "степень через одного из общих предков по политике счёта";
}
pub relation kin_degree(family: Family, first: Actor, second: Actor, degree: Integer) kind derived {
    key(family, first, second);
    label ru official "степень родства по политике счёта: наименьшая по всем общим предкам";
}
pub relation kin_line(family: Family, first: Actor, second: Actor, line: Line) kind derived {
    label ru official "линия родства: второе лицо — предок первого (восходящая), потомок (нисходящая) либо боковая";
}

// --- Выход: именованные родственники -----------------------------------------------------

pub relation parent(family: Family, parent: Actor, person: Actor) kind derived {
    label ru official "родитель (действующая связь)";
}
pub relation child(family: Family, child: Actor, person: Actor) kind derived {
    label ru official "ребёнок";
}
pub relation grandparent(family: Family, grandparent: Actor, person: Actor) kind derived {
    label ru official "дед или бабка";
}
pub relation grandchild(family: Family, grandchild: Actor, person: Actor) kind derived {
    label ru official "внук или внучка";
}
pub relation great_grandparent(family: Family, ancestor: Actor, person: Actor) kind derived {
    label ru official "прадед или прабабка";
}
pub relation full_sibling(family: Family, sibling: Actor, person: Actor) kind derived {
    label ru official "полнородный брат или сестра: общие оба родителя";
}
pub relation half_sibling(family: Family, sibling: Actor, person: Actor) kind derived {
    label ru official "неполнородный брат или сестра: общий один родитель";
}
pub relation sibling(family: Family, sibling: Actor, person: Actor) kind derived {
    label ru official "брат или сестра, полнородный либо неполнородный";
}
pub relation uncle_or_aunt(family: Family, relative: Actor, person: Actor) kind derived {
    label ru official "родной дядя или тётя: брат или сестра родителя";
}
pub relation nephew_or_niece(family: Family, relative: Actor, person: Actor) kind derived {
    label ru official "родной племянник или племянница: ребёнок брата или сестры";
}
pub relation cousin(family: Family, relative: Actor, person: Actor) kind derived {
    label ru official "двоюродный брат или сестра: ребёнок дяди или тёти";
}
pub relation cousin_grandchild(family: Family, relative: Actor, person: Actor) kind derived {
    label ru official "двоюродный внук или внучка: внук брата или сестры";
}
pub relation great_uncle_or_aunt(family: Family, relative: Actor, person: Actor) kind derived {
    label ru official "двоюродный дед или бабка: брат или сестра деда либо бабки";
}
pub relation cousin_great_grandchild(family: Family, relative: Actor, person: Actor) kind derived {
    label ru official "двоюродный правнук или правнучка: правнук брата или сестры";
}
pub relation cousin_nephew_or_niece(family: Family, relative: Actor, person: Actor) kind derived {
    label ru official "двоюродный племянник или племянница: ребёнок двоюродного брата или сестры";
}
pub relation cousin_uncle_or_aunt(family: Family, relative: Actor, person: Actor) kind derived {
    label ru official "двоюродный дядя или тётя: двоюродный брат или сестра родителя";
}
