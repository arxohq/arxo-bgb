language "law.core" version "0.2";
package calc.kinship version "0.1.0";
namespace "urn:law:calc:kinship";

// Сценарии calc.kinship (каталог P28, DECISION-0217). Одна семья четырёх
// поколений: GG,GGm → G,GU; G,Gm → P1,P2; P1,P1w → A,S; P1,Q → H; A → C → GC;
// S → N → NN → NNN; P2 → X → XC; GU → CU; A ⚭ W; усыновление A → AD (кровный BP).

// Родитель по действующей связи.
test "urn:query:calc-kinship-named-01-parent" {
    given {
        assert "f1": family_degree_count(entity_ref("urn:calc:kinship:test:family"), Roman) { origin case_input; }
        assert "f2": family_adoption_effect(entity_ref("urn:calc:kinship:test:family"), ReplacesBlood) { origin case_input; }
        assert "f3": family_depth_cap(entity_ref("urn:calc:kinship:test:family"), 6) { origin case_input; }
        assert "f4": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:GG"), entity_ref("urn:calc:kinship:test:G"), Blood) { origin case_input; }
        assert "f5": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:GGm"), entity_ref("urn:calc:kinship:test:G"), Blood) { origin case_input; }
        assert "f6": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:GG"), entity_ref("urn:calc:kinship:test:GU"), Blood) { origin case_input; }
        assert "f7": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:GGm"), entity_ref("urn:calc:kinship:test:GU"), Blood) { origin case_input; }
        assert "f8": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:G"), entity_ref("urn:calc:kinship:test:P1"), Blood) { origin case_input; }
        assert "f9": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:Gm"), entity_ref("urn:calc:kinship:test:P1"), Blood) { origin case_input; }
        assert "f10": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:G"), entity_ref("urn:calc:kinship:test:P2"), Blood) { origin case_input; }
        assert "f11": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:Gm"), entity_ref("urn:calc:kinship:test:P2"), Blood) { origin case_input; }
        assert "f12": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:P1"), entity_ref("urn:calc:kinship:test:A"), Blood) { origin case_input; }
        assert "f13": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:P1w"), entity_ref("urn:calc:kinship:test:A"), Blood) { origin case_input; }
        assert "f14": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:P1"), entity_ref("urn:calc:kinship:test:S"), Blood) { origin case_input; }
        assert "f15": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:P1w"), entity_ref("urn:calc:kinship:test:S"), Blood) { origin case_input; }
        assert "f16": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:P1"), entity_ref("urn:calc:kinship:test:H"), Blood) { origin case_input; }
        assert "f17": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:Q"), entity_ref("urn:calc:kinship:test:H"), Blood) { origin case_input; }
        assert "f18": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:A"), entity_ref("urn:calc:kinship:test:C"), Blood) { origin case_input; }
        assert "f19": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:C"), entity_ref("urn:calc:kinship:test:GC"), Blood) { origin case_input; }
        assert "f20": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:S"), entity_ref("urn:calc:kinship:test:N"), Blood) { origin case_input; }
        assert "f21": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:N"), entity_ref("urn:calc:kinship:test:NN"), Blood) { origin case_input; }
        assert "f22": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:NN"), entity_ref("urn:calc:kinship:test:NNN"), Blood) { origin case_input; }
        assert "f23": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:P2"), entity_ref("urn:calc:kinship:test:X"), Blood) { origin case_input; }
        assert "f24": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:X"), entity_ref("urn:calc:kinship:test:XC"), Blood) { origin case_input; }
        assert "f25": parent_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:GU"), entity_ref("urn:calc:kinship:test:CU"), Blood) { origin case_input; }
        assert "f26": spouse_edge(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:A"), entity_ref("urn:calc:kinship:test:W")) { origin case_input; }
    }
    evaluate truth(parent(entity_ref("urn:calc:kinship:test:family"), entity_ref("urn:calc:kinship:test:P1"), entity_ref("urn:calc:kinship:test:A")));
    expect evaluation_status == COMPUTED;
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
    expect applied(Parent);
}

