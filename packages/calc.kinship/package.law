// calc.kinship — родство по конечному графу: степени, линии, полнородность,
// именованные родственники (DECISION-0123, каталог P28; DECISION-0206
// пункт 5, DECISION-0217).
//
// ЧТО ЭТОТ ПАКЕТ ДЕЛАЕТ. Ему передают СЕМЬЮ (`Family`) — конечный граф лиц
// с рёбрами «родитель → ребёнок» (кровное или по усыновлению) и «супруги»,
// две политики (счёт степеней; действие усыновления) и предел глубины. Он
// возвращает действующие родительские связи, предков с глубиной, степень и
// линию родства между парой лиц, полнородность братьев и сестёр и
// именованных родственников до шестой очереди наследования: дед, прадед,
// дядя, племянник, двоюродный брат, двоюродный внук и правнук, двоюродный
// дед, двоюродный племянник, двоюродный дядя.
//
// ЧЕГО ОН НЕ ЗНАЕТ. Кто наследует, кому запрещён брак, кто «близкий
// родственник» в конкретном законе — всё это предметный пакет
// (DECISION-0123 §2). Пакет не знает и правопорядка: римский счёт (число
// рождений по обеим ветвям до общего предка) и канонический (длина длинной
// ветви) — значения перечисления, которое называет потребитель; усыновление
// либо ЗАМЕНЯЕТ кровную ветвь (ГК РК, статья 1060), либо ДОБАВЛЯЕТ её —
// тоже политика входом, умолчания нет.
//
// ЛИЦА — СТАНДАРТНЫЙ `Actor`. У вычислителя нет своей сущности лица:
// потребители держат лиц хабами (у KZ — `CivilParticipant : Actor`
// Гражданского кодекса с тридцатью восемью импортёрами), и подтипом чужой
// сущности их не сделать. Стандартный тип принимает любого потомка, и мост
// не требует ни правки хаба, ни сущности-двойника.
//
// ТОЖДЕСТВО ЛИЦ — ЧЕРЕЗ ГЛУБИНУ 0. Неравенство сущностей в теле правила вне
// v1-подмножества (проба P25, DECISION-0213), поэтому «a и b — одно лицо»
// выражено как `ancestor_or_self(f, a, b, 0)`, а «разные» — счётом таких
// фактов нулём в стратуме выше рекурсии.
//
// ПРЕДЕЛ ГЛУБИНЫ — ВХОД. Рекурсия по предкам ограничена `family_depth_cap`;
// цикл в данных (лицо — свой предок глубже нуля) — названный дефект, и
// предел делает вывод конечным даже на дефектном графе.

language "law.core" version "0.2";
package calc.kinship version "0.1.0";
namespace "urn:law:calc:kinship";

pub entity Family { label ru official "семья: конечный граф лиц с политиками счёта"; }

pub enum EdgeKind {
    label ru official "вид родительской связи";
    Blood,
    Adoptive
}

pub enum DegreeCount {
    label ru official "способ счёта степени родства";
    Roman,
    Canonical
}

pub enum AdoptionEffect {
    label ru official "действие усыновления на кровную ветвь";
    ReplacesBlood,
    AddsBranch
}

pub enum Line {
    label ru official "линия родства";
    Ascending,
    Descending,
    Collateral
}

pub enum KinshipDefect {
    label ru official "дефект семьи, снимающий вычисление";
    DegreeCountMissing,
    DegreeCountAmbiguous,
    AdoptionEffectMissing,
    AdoptionEffectAmbiguous,
    DepthCapMissing,
    DepthCapAmbiguous,
    DepthCapNotPositive,
    SelfParent,
    CycleDetected
}
