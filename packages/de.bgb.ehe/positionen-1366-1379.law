language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

pub relation position_trigger_1366(ehe: Ehe, g: Rechtsgeschaeft, dritter: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Genehmigung des Ehevertrags (§ 1366)"; label en unofficial "case input for ratification under § 1366"; }
pub relation genehmigung_1366_geschuldet(ehe: Ehe, g: Rechtsgeschaeft) kind empirical { label de official "Die Genehmigung des Vertrags ist zu erklären (§ 1366)"; label en unofficial "Ratification of the contract must be declared (§ 1366)"; }
pub relation position_trigger_1367(ehe: Ehe, g: Rechtsgeschaeft, handelnder: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum unwirksamen einseitigen Rechtsgeschäft (§ 1367)"; label en unofficial "case input for an ineffective unilateral transaction (§ 1367)"; }
pub relation rechtsgeschaeft_1367_unwirksam(ehe: Ehe, g: Rechtsgeschaeft) kind empirical { label de official "Das einseitige Rechtsgeschäft ist ohne Zustimmung unwirksam (§ 1367)"; label en unofficial "The unilateral transaction is ineffective without consent (§ 1367)"; }
pub relation position_trigger_1379(ehe: Ehe, berechtigter: Person, verpflichteter: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Vermögensauskunft (§ 1379)"; label en unofficial "case input for asset information (§ 1379)"; }
pub relation auskunft_1379_geschuldet(ehe: Ehe, verpflichteter: Person, berechtigter: Person) kind empirical { label de official "Auskunft über das Vermögen ist geschuldet (§ 1379)"; label en unofficial "information about assets is owed (§ 1379)"; }

@source(BGB_P1366)
rule PositionGenehmigung1366(ehe: Ehe, g: Rechtsgeschaeft, dritter: Person, tag: Date) strict { label de official "Der Vertrag ist bis zur Genehmigung schwebend unwirksam; die Genehmigung ist zu erklären (§ 1366)"; label en unofficial "The contract is provisionally ineffective until ratification, which must be declared (§ 1366)"; when position_trigger_1366(ehe, g, dritter, tag); then duty Genehmigung1366 { bearer dritter; achieve genehmigung_1366_geschuldet(ehe, g) during [tag, infinity); }; }
@source(BGB_P1367)
rule PositionUnwirksamkeit1367(ehe: Ehe, g: Rechtsgeschaeft, handelnder: Person, tag: Date) strict { label de official "Das einseitige Rechtsgeschäft ist ohne Einwilligung unwirksam (§ 1367)"; label en unofficial "The unilateral transaction is ineffective without consent (§ 1367)"; when position_trigger_1367(ehe, g, handelnder, tag); then duty Unwirksamkeit1367 { bearer handelnder; achieve rechtsgeschaeft_1367_unwirksam(ehe, g) during [tag, infinity); }; }
@source(BGB_P1379)
rule PositionAuskunft1379(ehe: Ehe, berechtigter: Person, verpflichteter: Person, tag: Date) strict { label de official "Der Ehegatte muss auf Verlangen Auskunft über sein Vermögen erteilen (§ 1379)"; label en unofficial "The spouse must provide information about assets on demand (§ 1379)"; when position_trigger_1379(ehe, berechtigter, verpflichteter, tag); then duty Auskunft1379 { bearer verpflichteter; beneficiary berechtigter; achieve auskunft_1379_geschuldet(ehe, verpflichteter, berechtigter) during [tag, infinity); }; }
