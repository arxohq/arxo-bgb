language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1302: die Verjährungsfrist der Ansprüche der §§ 1298 bis 1301 beginnt mit der Auflösung des Verlöbnisses — hier am 12.03.2025. Das Paket leitet NUR den Beginn her; die Länge der Frist steht in den §§ 195, 199 (de.bgb.fristen) und wird hier nicht wiederholt.
test "§ 1302: Verjährungsbeginn mit der Auflösung des Verlöbnisses" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": verlobte(entity_ref("urn:de:bgb:ehe:v04:V"), entity_ref("urn:de:bgb:ehe:v04:A"), entity_ref("urn:de:bgb:ehe:v04:B")) { origin case_input; }
        assert "f2": verloebnis_aufgeloest_am(entity_ref("urn:de:bgb:ehe:v04:V"), @2025-03-12) { origin case_input; }
    }
    evaluate truth(verjaehrungsbeginn_des_verloebnisanspruchs(entity_ref("urn:de:bgb:ehe:v04:V"), @2025-03-12));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
