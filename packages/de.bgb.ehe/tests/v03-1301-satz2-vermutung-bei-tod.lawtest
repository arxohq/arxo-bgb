language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1301 Satz 2: die Eheschließung unterbleibt, weil A gestorben ist. Im Zweifel ist anzunehmen, dass die Rückforderung ausgeschlossen sein soll; der Fall behauptet keinen Vorbehalt, die Vermutung hält. Der Herausgabeanspruch des B gegen A aus Satz 1 wird durch die vorrangige Ausnahmeregel verdrängt.
test "§ 1301 Satz 2: Auflösung durch Tod schließt die Rückforderung aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": verlobte(entity_ref("urn:de:bgb:ehe:v03:V"), entity_ref("urn:de:bgb:ehe:v03:A"), entity_ref("urn:de:bgb:ehe:v03:B")) { origin case_input; }
        assert "f2": eheschliessung_unterbleibt(entity_ref("urn:de:bgb:ehe:v03:V")) { origin case_input; }
        assert "f3": verloebnis_durch_tod_aufgeloest(entity_ref("urn:de:bgb:ehe:v03:V"), entity_ref("urn:de:bgb:ehe:v03:A")) { origin case_input; }
        assert "f4": geschenk_oder_zeichen_des_verloebnisses(entity_ref("urn:de:bgb:ehe:v03:V"), entity_ref("urn:de:bgb:ehe:v03:B"), entity_ref("urn:de:bgb:ehe:v03:A"), entity_ref("urn:de:bgb:ehe:v03:R")) { origin case_input; }
    }
    evaluate truth(rueckforderung_ausgeschlossen(entity_ref("urn:de:bgb:ehe:v03:V"), entity_ref("urn:de:bgb:ehe:v03:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(herausgabeanspruch_nach_1301(entity_ref("urn:de:bgb:ehe:v03:V"), entity_ref("urn:de:bgb:ehe:v03:B"), entity_ref("urn:de:bgb:ehe:v03:A"), entity_ref("urn:de:bgb:ehe:v03:R")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
