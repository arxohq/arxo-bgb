language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1371 Abs. 1: Zugewinngemeinschaft durch den Tod des Ehegatten D beendet — der Erbteil des überlebenden S erhöht sich um ein Viertel; für den Verstorbenen selbst nicht.
test "§ 1371 Abs. 1: Erhöhung des Erbteils des überlebenden Ehegatten bei Zugewinngemeinschaft" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:pilot:g03:EHE"), entity_ref("urn:de:bgb:pilot:g03:D"), entity_ref("urn:de:bgb:pilot:g03:S")) { origin case_input; }
        assert "f2": kein_ehevertrag(entity_ref("urn:de:bgb:pilot:g03:EHE")) { origin case_input; }
        assert "f3": gueterstand_durch_tod_beendet(entity_ref("urn:de:bgb:pilot:g03:EHE"), entity_ref("urn:de:bgb:pilot:g03:D")) { origin case_input; }
    }
    evaluate truth(erhoehung_des_erbteils_1371(entity_ref("urn:de:bgb:pilot:g03:EHE"), entity_ref("urn:de:bgb:pilot:g03:S")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(erhoehung_des_erbteils_1371(entity_ref("urn:de:bgb:pilot:g03:EHE"), entity_ref("urn:de:bgb:pilot:g03:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
