language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// §§ 1416 bis 1418: die Ehegatten haben durch Ehevertrag Gütergemeinschaft vereinbart. Der Hausrat wird kraft Gesetzes Gesamtgut, ohne durch Rechtsgeschäft übertragen zu werden (§ 1416 Abs. 1, 2); der nicht übertragbare Anspruch ist Sondergut (§ 1417 Abs. 2); der durch Ehevertrag zum Vorbehaltsgut erklärte Gegenstand ist Vorbehaltsgut (§ 1418 Abs. 2 Nr. 1). Jeder Ehegatte kann vom anderen die Mitwirkung zur Grundbuchberichtigung verlangen (§ 1416 Abs. 3).
test "§§ 1416–1418: Gesamtgut, Sondergut, Vorbehaltsgut" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:gg01:E"), entity_ref("urn:de:bgb:ehe:gg01:A"), entity_ref("urn:de:bgb:ehe:gg01:B")) { origin case_input; }
        assert "f2": ehevertrag_gueterstand(entity_ref("urn:de:bgb:ehe:gg01:E"), Guetergemeinschaft) { origin case_input; }
        assert "f3": gesamtgutsgegenstand(entity_ref("urn:de:bgb:ehe:gg01:E"), entity_ref("urn:de:bgb:ehe:gg01:S1")) { origin case_input; }
        assert "f4": nicht_uebertragbarer_gegenstand(entity_ref("urn:de:bgb:ehe:gg01:E"), entity_ref("urn:de:bgb:ehe:gg01:A"), entity_ref("urn:de:bgb:ehe:gg01:S2")) { origin case_input; }
        assert "f5": durch_ehevertrag_zum_vorbehaltsgut_erklaert(entity_ref("urn:de:bgb:ehe:gg01:E"), entity_ref("urn:de:bgb:ehe:gg01:B"), entity_ref("urn:de:bgb:ehe:gg01:S3")) { origin case_input; }
    }
    evaluate truth(gueterstand(entity_ref("urn:de:bgb:ehe:gg01:E"), Guetergemeinschaft));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gesamtgut(entity_ref("urn:de:bgb:ehe:gg01:E"), entity_ref("urn:de:bgb:ehe:gg01:S1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(sondergut(entity_ref("urn:de:bgb:ehe:gg01:E"), entity_ref("urn:de:bgb:ehe:gg01:A"), entity_ref("urn:de:bgb:ehe:gg01:S2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(vorbehaltsgut(entity_ref("urn:de:bgb:ehe:gg01:E"), entity_ref("urn:de:bgb:ehe:gg01:B"), entity_ref("urn:de:bgb:ehe:gg01:S3")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(grundbuchberichtigung_verlangbar(entity_ref("urn:de:bgb:ehe:gg01:E"), entity_ref("urn:de:bgb:ehe:gg01:A"), entity_ref("urn:de:bgb:ehe:gg01:S1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
