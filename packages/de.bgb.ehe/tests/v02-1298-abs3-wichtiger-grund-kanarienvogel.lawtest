language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// Kanarienvogel zu v01: derselbe Sachverhalt, aber das Gericht hat einen wichtigen Grund für den Rücktritt festgestellt (§ 1298 Abs. 3). Die Ersatzpflicht tritt dann NICHT ein — die Ausnahmeregel geht der Regel des Absatzes 1 vor (priority WichtigerGrundVorErsatzpflichtDesAnderenVerlobten).
test "§ 1298 Abs. 3: der wichtige Grund schließt die Ersatzpflicht aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": verlobte(entity_ref("urn:de:bgb:ehe:v02:V"), entity_ref("urn:de:bgb:ehe:v02:A"), entity_ref("urn:de:bgb:ehe:v02:B")) { origin case_input; }
        assert "f2": ruecktritt_vom_verloebnis(entity_ref("urn:de:bgb:ehe:v02:V"), entity_ref("urn:de:bgb:ehe:v02:A")) { origin case_input; }
        assert "f3": aufwendungen_in_erwartung_der_ehe(entity_ref("urn:de:bgb:ehe:v02:V"), entity_ref("urn:de:bgb:ehe:v02:B")) { origin case_input; }
        assert "f4": aufwendungen_den_umstaenden_nach_angemessen(entity_ref("urn:de:bgb:ehe:v02:V"), entity_ref("urn:de:bgb:ehe:v02:B")) { origin adjudicated; }
        assert "f5": wichtiger_grund_fuer_den_ruecktritt(entity_ref("urn:de:bgb:ehe:v02:V"), entity_ref("urn:de:bgb:ehe:v02:A")) { origin adjudicated; }
    }
    evaluate truth(ersatzpflicht_nach_1298(entity_ref("urn:de:bgb:ehe:v02:V"), entity_ref("urn:de:bgb:ehe:v02:A"), entity_ref("urn:de:bgb:ehe:v02:B")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
