language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// Korridor 2009, zweite Seite: § 1378 Abs. 2 Satz 2 erhöht die Obergrenze in den Fällen des § 1375 Abs. 2 Satz 1 um den dem Endvermögen hinzuzurechnenden Betrag. A hat 20 000,00 € bei Beendigung und hat 30 000,00 € illoyal weggegeben (Nr. 1); sein Endvermögen ist daher 50 000,00 €, sein Zugewinn 50 000,00 €, die Hälfte 25 000,00 €. Nach Satz 1 allein wäre die Forderung auf 20 000,00 € gekappt; mit der Erhöhung des Satzes 2 beträgt die Grenze 50 000,00 € und die Forderung volle 25 000,00 €.
test "§ 1378 Abs. 2 Satz 2: die Obergrenze steigt um die illoyale Minderung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:A"), entity_ref("urn:de:bgb:ehe:t02:B")) { origin case_input; }
        assert "f2": kein_ehevertrag(entity_ref("urn:de:bgb:ehe:t02:E")) { origin case_input; }
        assert "f3": gueterstand_beendet_am(entity_ref("urn:de:bgb:ehe:t02:E"), @2025-09-30) { origin case_input; }
        assert "f4": gueterstand_auf_andere_weise_als_durch_tod_beendet(entity_ref("urn:de:bgb:ehe:t02:E")) { origin case_input; }
        assert "f5": vermoegen_beim_eintritt_des_gueterstands(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:A"), 0.00 EUR) { origin case_input; }
        assert "f6": vermoegen_beim_eintritt_des_gueterstands(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:B"), 0.00 EUR) { origin case_input; }
        assert "f7": vermoegen_bei_beendigung_des_gueterstands(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:A"), 20000.00 EUR) { origin case_input; }
        assert "f8": vermoegen_bei_beendigung_des_gueterstands(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:B"), 0.00 EUR) { origin case_input; }
        assert "f9": keine_hinzurechnung_zum_anfangsvermoegen(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:A")) { origin case_input; }
        assert "f10": keine_hinzurechnung_zum_anfangsvermoegen(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:B")) { origin case_input; }
        assert "f11": keine_illoyale_minderung(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:B")) { origin case_input; }
        assert "f12": illoyale_vermoegensminderung(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:A"), 30000.00 EUR, 1) { origin case_input; }
    }
    evaluate truth(endvermoegen(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:A"), 50000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(obergrenze_der_ausgleichsforderung(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:A"), 50000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ausgleichsforderung(entity_ref("urn:de:bgb:ehe:t02:E"), entity_ref("urn:de:bgb:ehe:t02:B"), entity_ref("urn:de:bgb:ehe:t02:A"), 25000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
