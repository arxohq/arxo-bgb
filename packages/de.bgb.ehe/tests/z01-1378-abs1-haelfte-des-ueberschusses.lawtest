language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// §§ 1373, 1378 Abs. 1: A hat ein Anfangsvermögen von 50 000,00 € und ein Endvermögen von 200 000,01 €, also einen Zugewinn von 150 000,01 €; B hat 20 000,00 € und 30 000,00 €, also 10 000,00 €. Der Überschuss beträgt 140 000,01 €, die Hälfte 70 000,005 € — kaufmännisch auf den Cent 70 000,01 € (EIN `div_round` je Forderung, Ledger D-12-06). Die Obergrenze des Absatzes 2 (200 000,01 €) ist nicht erreicht.
test "§ 1378 Abs. 1: die Hälfte des Überschusses, einmal kaufmännisch gerundet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:A"), entity_ref("urn:de:bgb:ehe:z01:B")) { origin case_input; }
        assert "f2": kein_ehevertrag(entity_ref("urn:de:bgb:ehe:z01:E")) { origin case_input; }
        assert "f3": gueterstand_beendet_am(entity_ref("urn:de:bgb:ehe:z01:E"), @2025-09-30) { origin case_input; }
        assert "f4": gueterstand_auf_andere_weise_als_durch_tod_beendet(entity_ref("urn:de:bgb:ehe:z01:E")) { origin case_input; }
        assert "f5": vermoegen_beim_eintritt_des_gueterstands(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:A"), 50000.00 EUR) { origin case_input; }
        assert "f6": vermoegen_beim_eintritt_des_gueterstands(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:B"), 20000.00 EUR) { origin case_input; }
        assert "f7": vermoegen_bei_beendigung_des_gueterstands(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:A"), 200000.01 EUR) { origin case_input; }
        assert "f8": vermoegen_bei_beendigung_des_gueterstands(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:B"), 30000.00 EUR) { origin case_input; }
        assert "f9": keine_hinzurechnung_zum_anfangsvermoegen(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:A")) { origin case_input; }
        assert "f10": keine_hinzurechnung_zum_anfangsvermoegen(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:B")) { origin case_input; }
        assert "f11": keine_illoyale_minderung(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:A")) { origin case_input; }
        assert "f12": keine_illoyale_minderung(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:B")) { origin case_input; }
    }
    evaluate truth(zugewinn(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:A"), 150000.01 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(zugewinn(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:B"), 10000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ueberschuss(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:B"), entity_ref("urn:de:bgb:ehe:z01:A"), 140000.01 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ausgleichsforderung(entity_ref("urn:de:bgb:ehe:z01:E"), entity_ref("urn:de:bgb:ehe:z01:B"), entity_ref("urn:de:bgb:ehe:z01:A"), 70000.01 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
