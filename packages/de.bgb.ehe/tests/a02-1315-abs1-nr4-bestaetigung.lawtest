language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1315 Abs. 1 Nr. 4: derselbe Sachverhalt wie a01, aber der getäuschte Ehegatte hat nach Entdeckung der Täuschung zu erkennen gegeben, dass er die Ehe fortsetzen will. Die Aufhebung ist damit ausgeschlossen; die Bestätigung eines Geschäftsunfähigen wäre unwirksam (Satz 2), Geschäftsunfähigkeit behauptet der Fall nicht.
test "§ 1315 Abs. 1 Nr. 4: die Bestätigung schließt die Aufhebung aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:a02:E"), entity_ref("urn:de:bgb:ehe:a02:A"), entity_ref("urn:de:bgb:ehe:a02:B")) { origin case_input; }
        assert "f2": eheschliessung_am(entity_ref("urn:de:bgb:ehe:a02:E"), @2024-02-10) { origin case_input; }
        assert "f3": arglistige_taeuschung_ueber_wesentliche_umstaende(entity_ref("urn:de:bgb:ehe:a02:E"), entity_ref("urn:de:bgb:ehe:a02:A")) { origin adjudicated; }
        assert "f4": bestaetigung_erklaert(entity_ref("urn:de:bgb:ehe:a02:E"), entity_ref("urn:de:bgb:ehe:a02:A"), Arglistige_Taeuschung_1314_Abs_2_Nr_3) { origin case_input; }
    }
    evaluate truth(aufhebung_ausgeschlossen(entity_ref("urn:de:bgb:ehe:a02:E"), Arglistige_Taeuschung_1314_Abs_2_Nr_3));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
