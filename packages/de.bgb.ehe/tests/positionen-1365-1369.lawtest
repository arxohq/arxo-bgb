language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

test "§§ 1365, 1368, 1369: Ehegattenrechte aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.ehe::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1365(entity_ref("urn:ehe:e1365"), entity_ref("urn:ehe:g1365"), entity_ref("urn:ehe:p1365"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1369(entity_ref("urn:ehe:e1369"), entity_ref("urn:ehe:g1369"), entity_ref("urn:ehe:p1369"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1368(entity_ref("urn:ehe:e1368"), entity_ref("urn:ehe:g1368"), entity_ref("urn:ehe:p1368"), entity_ref("urn:ehe:d1368"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Zustimmung1365, ACTIVE); expect position(Zustimmung1369, ACTIVE); expect position(Geltendmachung1368, ACTIVE);
}

test "§§ 1365, 1368, 1369: Ehegattenrechte geschützt und ausgeübt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.ehe::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1365(entity_ref("urn:ehe:e1365"), entity_ref("urn:ehe:g1365"), entity_ref("urn:ehe:p1365"), @2026-01-01) { origin case_input; }
 assert "ag": verfuegung_1365_unwirksam_ohne_zustimmung(entity_ref("urn:ehe:e1365"), entity_ref("urn:ehe:g1365")) { origin case_input; }
 assert "b": position_trigger_1369(entity_ref("urn:ehe:e1369"), entity_ref("urn:ehe:g1369"), entity_ref("urn:ehe:p1369"), @2026-01-01) { origin case_input; }
 assert "bg": haushaltsverfuegung_1369_unwirksam_ohne_zustimmung(entity_ref("urn:ehe:e1369"), entity_ref("urn:ehe:g1369")) { origin case_input; }
 assert "c": position_trigger_1368(entity_ref("urn:ehe:e1368"), entity_ref("urn:ehe:g1368"), entity_ref("urn:ehe:p1368"), entity_ref("urn:ehe:d1368"), @2026-01-01) { origin case_input; }
 assert "cg": unwirksamkeit_1368_ausuebbar(entity_ref("urn:ehe:e1368"), entity_ref("urn:ehe:g1368"), entity_ref("urn:ehe:d1368")) { origin case_input; } }
 evaluate positions();
 expect position(Zustimmung1365, ACTIVE); expect position(Zustimmung1369, ACTIVE); expect position(Geltendmachung1368, ACTIVE);
