language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1298 Abs. 1 Satz 1: A tritt vom Verlöbnis zurück; B hat in Erwartung der Ehe Aufwendungen gemacht, und das Gericht hat sie als den Umständen nach angemessen festgestellt (Abs. 2). Ein wichtiger Grund für den Rücktritt (Abs. 3) ist nicht festgestellt, daher bleibt die Ersatzpflicht bestehen.
test "§ 1298: Ersatzpflicht des zurückgetretenen Verlobten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": verlobte(entity_ref("urn:de:bgb:ehe:v01:V"), entity_ref("urn:de:bgb:ehe:v01:A"), entity_ref("urn:de:bgb:ehe:v01:B")) { origin case_input; }
        assert "f2": ruecktritt_vom_verloebnis(entity_ref("urn:de:bgb:ehe:v01:V"), entity_ref("urn:de:bgb:ehe:v01:A")) { origin case_input; }
        assert "f3": aufwendungen_in_erwartung_der_ehe(entity_ref("urn:de:bgb:ehe:v01:V"), entity_ref("urn:de:bgb:ehe:v01:B")) { origin case_input; }
        assert "f4": aufwendungen_den_umstaenden_nach_angemessen(entity_ref("urn:de:bgb:ehe:v01:V"), entity_ref("urn:de:bgb:ehe:v01:B")) { origin adjudicated; }
    }
    evaluate truth(ersatzpflicht_nach_1298(entity_ref("urn:de:bgb:ehe:v01:V"), entity_ref("urn:de:bgb:ehe:v01:A"), entity_ref("urn:de:bgb:ehe:v01:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
