language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1408 Abs. 1, § 1414: durch Ehevertrag vereinbarte Gütertrennung; bei Gütertrennung keine Erhöhung nach § 1371 Abs. 1.
test "§ 1408, § 1414: Gütertrennung durch Ehevertrag — keine Erhöhung nach § 1371 Abs. 1" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:pilot:g02:EHE"), entity_ref("urn:de:bgb:pilot:g02:D"), entity_ref("urn:de:bgb:pilot:g02:S")) { origin case_input; }
        assert "f2": ehevertrag_gueterstand(entity_ref("urn:de:bgb:pilot:g02:EHE"), Guetertrennung) { origin case_input; }
        assert "f3": gueterstand_durch_tod_beendet(entity_ref("urn:de:bgb:pilot:g02:EHE"), entity_ref("urn:de:bgb:pilot:g02:D")) { origin case_input; }
    }
    evaluate truth(gueterstand(entity_ref("urn:de:bgb:pilot:g02:EHE"), Guetertrennung));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gueterstand(entity_ref("urn:de:bgb:pilot:g02:EHE"), Zugewinngemeinschaft));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(erhoehung_des_erbteils_1371(entity_ref("urn:de:bgb:pilot:g02:EHE"), entity_ref("urn:de:bgb:pilot:g02:S")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
