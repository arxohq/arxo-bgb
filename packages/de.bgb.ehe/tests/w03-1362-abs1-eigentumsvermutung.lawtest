language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1362 Abs. 1 Satz 1: der Gläubiger des Ehegatten A nimmt die Vermutung in Anspruch; die bewegliche Sache befindet sich im Besitz des A. Der Fall behauptet keinen Gegenbeweis, die Vermutung hält. § 1362 Abs. 2 greift daneben für die zum persönlichen Gebrauch des B bestimmte Sache.
test "§ 1362 Abs. 1: die Sache gehört im Verhältnis zum Gläubiger dem Schuldner" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:w03:E"), entity_ref("urn:de:bgb:ehe:w03:A"), entity_ref("urn:de:bgb:ehe:w03:B")) { origin case_input; }
        assert "f2": schuldner_eines_glaeubigers(entity_ref("urn:de:bgb:ehe:w03:E"), entity_ref("urn:de:bgb:ehe:w03:A")) { origin case_input; }
        assert "f3": bewegliche_sache_im_besitz_eines_ehegatten(entity_ref("urn:de:bgb:ehe:w03:E"), entity_ref("urn:de:bgb:ehe:w03:A"), entity_ref("urn:de:bgb:ehe:w03:S")) { origin case_input; }
        assert "f4": zum_persoenlichen_gebrauch_bestimmt(entity_ref("urn:de:bgb:ehe:w03:E"), entity_ref("urn:de:bgb:ehe:w03:B"), entity_ref("urn:de:bgb:ehe:w03:T")) { origin case_input; }
    }
    evaluate truth(eigentum_des_schuldners_vermutet(entity_ref("urn:de:bgb:ehe:w03:E"), entity_ref("urn:de:bgb:ehe:w03:A"), entity_ref("urn:de:bgb:ehe:w03:S")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(eigentum_des_gebrauchers_vermutet(entity_ref("urn:de:bgb:ehe:w03:E"), entity_ref("urn:de:bgb:ehe:w03:B"), entity_ref("urn:de:bgb:ehe:w03:T")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
