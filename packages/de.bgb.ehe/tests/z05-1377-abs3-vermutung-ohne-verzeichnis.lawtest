language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1377 Abs. 3: für A ist kein Verzeichnis des Anfangsvermögens aufgenommen; es wird daher vermutet, dass sein Endvermögen seinen Zugewinn darstellt — das Anfangsvermögen ist null. Der Fall behauptet keinen Gegenbeweis, die Vermutung hält. Für B haben die Ehegatten ein Verzeichnis gemeinsam festgestellt (Abs. 1): es wird als richtig vermutet.
test "§ 1377: die beiden Vermutungen des Verzeichnisses" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:A"), entity_ref("urn:de:bgb:ehe:z05:B")) { origin case_input; }
        assert "f2": kein_ehevertrag(entity_ref("urn:de:bgb:ehe:z05:E")) { origin case_input; }
        assert "f3": gueterstand_beendet_am(entity_ref("urn:de:bgb:ehe:z05:E"), @2025-09-30) { origin case_input; }
        assert "f4": gueterstand_auf_andere_weise_als_durch_tod_beendet(entity_ref("urn:de:bgb:ehe:z05:E")) { origin case_input; }
        assert "f5": vermoegen_beim_eintritt_des_gueterstands(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:A"), 0.00 EUR) { origin case_input; }
        assert "f6": vermoegen_beim_eintritt_des_gueterstands(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:B"), 20000.00 EUR) { origin case_input; }
        assert "f7": vermoegen_bei_beendigung_des_gueterstands(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:A"), 90000.00 EUR) { origin case_input; }
        assert "f8": vermoegen_bei_beendigung_des_gueterstands(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:B"), 30000.00 EUR) { origin case_input; }
        assert "f9": keine_hinzurechnung_zum_anfangsvermoegen(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:A")) { origin case_input; }
        assert "f10": keine_hinzurechnung_zum_anfangsvermoegen(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:B")) { origin case_input; }
        assert "f11": keine_illoyale_minderung(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:A")) { origin case_input; }
        assert "f12": keine_illoyale_minderung(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:B")) { origin case_input; }
        assert "f13": kein_verzeichnis_aufgenommen(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:A")) { origin case_input; }
        assert "f14": verzeichnis_des_anfangsvermoegens(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:B")) { origin case_input; }
    }
    evaluate truth(endvermoegen_ist_zugewinn_vermutet(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verzeichnis_richtig_vermutet(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(zugewinn(entity_ref("urn:de:bgb:ehe:z05:E"), entity_ref("urn:de:bgb:ehe:z05:A"), 90000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
