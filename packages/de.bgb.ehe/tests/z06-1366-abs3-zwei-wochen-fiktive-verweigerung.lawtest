language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1366 Abs. 3 Satz 2: der Dritte fordert am Montag, dem 02.06.2025, zur Beschaffung der Genehmigung auf. Die Zweiwochenfrist endet mit Ablauf des Montags, 16.06.2025 (§ 188 Abs. 2, same_day); § 193 verschiebt nichts, weil der 16.06.2025 ein Werktag ist. Am 17.06.2025 ist die Genehmigung nicht erklärt und gilt als verweigert — der Vertrag ist unwirksam (Abs. 4).
test "§ 1366 Abs. 3: nach zwei Wochen gilt die Genehmigung als verweigert" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:z06:E"), entity_ref("urn:de:bgb:ehe:z06:A"), entity_ref("urn:de:bgb:ehe:z06:B")) { origin case_input; }
        assert "f2": kein_ehevertrag(entity_ref("urn:de:bgb:ehe:z06:E")) { origin case_input; }
        assert "f3": aufforderung_zur_genehmigung_empfangen_am(entity_ref("urn:de:bgb:ehe:z06:E"), entity_ref("urn:de:bgb:ehe:z06:G"), @2025-06-02) { origin case_input; }
        assert "f4": genehmigungsfrist(entity_ref("urn:de:bgb:ehe:z06:E"), entity_ref("urn:de:bgb:ehe:z06:G"), entity_ref("urn:de:bgb:ehe:z06:F")) { origin case_input; }
        assert "f5": bewertungstag(entity_ref("urn:de:bgb:ehe:z06:E"), @2025-06-17) { origin case_input; }
    }
    evaluate truth(letzter_tag_der_genehmigungsfrist(entity_ref("urn:de:bgb:ehe:z06:E"), entity_ref("urn:de:bgb:ehe:z06:G"), @2025-06-16));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(genehmigung_gilt_als_verweigert(entity_ref("urn:de:bgb:ehe:z06:E"), entity_ref("urn:de:bgb:ehe:z06:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(rechtsgeschaeft_unwirksam(entity_ref("urn:de:bgb:ehe:z06:E"), entity_ref("urn:de:bgb:ehe:z06:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
