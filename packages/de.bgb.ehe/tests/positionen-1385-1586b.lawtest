language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

test "§§ 1385, 1390, 1585b, 1586a, 1586b: Eheansprüche aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.ehe::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1385(entity_ref("urn:ehe:e1385"), entity_ref("urn:ehe:p1385"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1390(entity_ref("urn:ehe:e1390"), entity_ref("urn:ehe:p1390"), entity_ref("urn:ehe:d1390"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1585b(entity_ref("urn:ehe:e1585b"), entity_ref("urn:ehe:p1585b"), @2026-01-01) { origin case_input; }
 assert "d": position_trigger_1586a(entity_ref("urn:ehe:e1586a"), entity_ref("urn:ehe:p1586a"), entity_ref("urn:ehe:q1586a"), @2026-01-01) { origin case_input; }
 assert "e": position_trigger_1586b(entity_ref("urn:ehe:e1586b"), entity_ref("urn:ehe:h1586b"), entity_ref("urn:ehe:p1586b"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Ausgleich1385, ACTIVE); expect position(Wertersatz1390, ACTIVE); expect position(Unterhalt1585b, ACTIVE); expect position(Wiederaufleben1586a, ACTIVE); expect position(Erbenhaftung1586b, ACTIVE);
}

test "§§ 1385, 1390, 1585b, 1586a, 1586b: Eheansprüche erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.ehe::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1385(entity_ref("urn:ehe:e1385"), entity_ref("urn:ehe:p1385"), @2026-01-01) { origin case_input; }
 assert "ag": ausgleich_1385_ausuebbar(entity_ref("urn:ehe:e1385"), entity_ref("urn:ehe:p1385")) { origin case_input; }
 assert "b": position_trigger_1390(entity_ref("urn:ehe:e1390"), entity_ref("urn:ehe:p1390"), entity_ref("urn:ehe:d1390"), @2026-01-01) { origin case_input; }
 assert "bg": wertersatz_1390_geschuldet(entity_ref("urn:ehe:e1390"), entity_ref("urn:ehe:d1390"), entity_ref("urn:ehe:p1390")) { origin case_input; }
 assert "c": position_trigger_1585b(entity_ref("urn:ehe:e1585b"), entity_ref("urn:ehe:p1585b"), @2026-01-01) { origin case_input; }
 assert "cg": unterhalt_1585b_geschuldet(entity_ref("urn:ehe:e1585b"), entity_ref("urn:ehe:p1585b")) { origin case_input; }
 assert "d": position_trigger_1586a(entity_ref("urn:ehe:e1586a"), entity_ref("urn:ehe:p1586a"), entity_ref("urn:ehe:q1586a"), @2026-01-01) { origin case_input; }
 assert "dg": unterhalt_1586a_geschuldet(entity_ref("urn:ehe:e1586a"), entity_ref("urn:ehe:q1586a"), entity_ref("urn:ehe:p1586a")) { origin case_input; }
 assert "e": position_trigger_1586b(entity_ref("urn:ehe:e1586b"), entity_ref("urn:ehe:h1586b"), entity_ref("urn:ehe:p1586b"), @2026-01-01) { origin case_input; }
 assert "eg": haftung_1586b_geschuldet(entity_ref("urn:ehe:e1586b"), entity_ref("urn:ehe:h1586b"), entity_ref("urn:ehe:p1586b")) { origin case_input; } }
 evaluate positions();
 expect position(Ausgleich1385, ACTIVE); expect position(Wertersatz1390, SATISFIED); expect position(Unterhalt1585b, SATISFIED); expect position(Wiederaufleben1586a, SATISFIED); expect position(Erbenhaftung1586b, SATISFIED);
}
