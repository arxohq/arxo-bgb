language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// Kanarienvogel zu w01: „minus ein Merkmal“ — derselbe Sachverhalt, aber die Ehegatten leben getrennt. Absatz 1 gilt dann nicht (§ 1357 Abs. 3): B wird nicht mitverpflichtet. Zugleich zeigt der Fall die Kehrseite des Getrenntlebens: der Trennungsunterhalt des § 1361 Abs. 1 entsteht.
test "§ 1357 Abs. 3: bei Getrenntleben keine Mitverpflichtung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:w02:E"), entity_ref("urn:de:bgb:ehe:w02:A"), entity_ref("urn:de:bgb:ehe:w02:B")) { origin case_input; }
        assert "f2": geschaeft_zur_deckung_des_lebensbedarfs(entity_ref("urn:de:bgb:ehe:w02:E"), entity_ref("urn:de:bgb:ehe:w02:A")) { origin case_input; }
        assert "f3": geschaeft_angemessen_zur_deckung_des_lebensbedarfs(entity_ref("urn:de:bgb:ehe:w02:E"), entity_ref("urn:de:bgb:ehe:w02:A")) { origin adjudicated; }
        assert "f4": getrennt_lebend(entity_ref("urn:de:bgb:ehe:w02:E")) { origin case_input; }
        assert "f5": trennungsunterhalt_angemessen(entity_ref("urn:de:bgb:ehe:w02:E"), entity_ref("urn:de:bgb:ehe:w02:B"), 1200.00 EUR) { origin adjudicated; }
    }
    evaluate truth(mitverpflichtet_aus_dem_geschaeft(entity_ref("urn:de:bgb:ehe:w02:E"), entity_ref("urn:de:bgb:ehe:w02:B"), entity_ref("urn:de:bgb:ehe:w02:A")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(trennungsunterhalt_geschuldet(entity_ref("urn:de:bgb:ehe:w02:E"), entity_ref("urn:de:bgb:ehe:w02:A"), entity_ref("urn:de:bgb:ehe:w02:B"), 1200.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
