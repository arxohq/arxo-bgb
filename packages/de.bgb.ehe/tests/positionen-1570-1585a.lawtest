language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

test "§§ 1570, 1580, 1585a: Unterhaltspositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.ehe::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1570(entity_ref("urn:ehe:e1570"), entity_ref("urn:ehe:p1570"), entity_ref("urn:ehe:q1570"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1580(entity_ref("urn:ehe:e1580"), entity_ref("urn:ehe:p1580"), entity_ref("urn:ehe:q1580"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1585a(entity_ref("urn:ehe:e1585a"), entity_ref("urn:ehe:p1585a"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Betreuungsunterhalt1570, ACTIVE); expect position(Auskunft1580, ACTIVE); expect position(Sicherheit1585a, ACTIVE);
}

test "§§ 1570, 1580, 1585a: Unterhaltspositionen erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.ehe::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1570(entity_ref("urn:ehe:e1570"), entity_ref("urn:ehe:p1570"), entity_ref("urn:ehe:q1570"), @2026-01-01) { origin case_input; }
 assert "ag": unterhalt_1570_geschuldet(entity_ref("urn:ehe:e1570"), entity_ref("urn:ehe:q1570"), entity_ref("urn:ehe:p1570")) { origin case_input; }
 assert "b": position_trigger_1580(entity_ref("urn:ehe:e1580"), entity_ref("urn:ehe:p1580"), entity_ref("urn:ehe:q1580"), @2026-01-01) { origin case_input; }
 assert "bg": auskunft_1580_geschuldet(entity_ref("urn:ehe:e1580"), entity_ref("urn:ehe:q1580"), entity_ref("urn:ehe:p1580")) { origin case_input; }
 assert "c": position_trigger_1585a(entity_ref("urn:ehe:e1585a"), entity_ref("urn:ehe:p1585a"), @2026-01-01) { origin case_input; }
 assert "cg": sicherheit_1585a_geschuldet(entity_ref("urn:ehe:e1585a"), entity_ref("urn:ehe:p1585a")) { origin case_input; } }
 evaluate positions();
 expect position(Betreuungsunterhalt1570, SATISFIED); expect position(Auskunft1580, SATISFIED); expect position(Sicherheit1585a, SATISFIED);
}
