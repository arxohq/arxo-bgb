language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1317 Abs. 1 Satz 1: bei arglistiger Täuschung beträgt die Antragsfrist EIN JAHR und beginnt mit der Entdeckung der Täuschung (Satz 2) — hier am 03.06.2024. Das kalendarische Ende ist der 03.06.2025, ein Dienstag; § 193 verschiebt nichts. Der Antrag vom 03.06.2025 ist damit rechtzeitig gestellt.
test "§ 1317 Abs. 1: Antrag am letzten Tag der Jahresfrist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:a03:E"), entity_ref("urn:de:bgb:ehe:a03:A"), entity_ref("urn:de:bgb:ehe:a03:B")) { origin case_input; }
        assert "f2": eheschliessung_am(entity_ref("urn:de:bgb:ehe:a03:E"), @2023-01-20) { origin case_input; }
        assert "f3": arglistige_taeuschung_ueber_wesentliche_umstaende(entity_ref("urn:de:bgb:ehe:a03:E"), entity_ref("urn:de:bgb:ehe:a03:A")) { origin adjudicated; }
        assert "f4": entdeckung_oder_aufhoeren_am(entity_ref("urn:de:bgb:ehe:a03:E"), entity_ref("urn:de:bgb:ehe:a03:A"), @2024-06-03) { origin case_input; }
        assert "f5": antragsfrist_1317(entity_ref("urn:de:bgb:ehe:a03:E"), entity_ref("urn:de:bgb:ehe:a03:A"), Arglistige_Taeuschung_1314_Abs_2_Nr_3, entity_ref("urn:de:bgb:ehe:a03:F")) { origin case_input; }
        assert "f6": aufhebungsantrag_gestellt_am(entity_ref("urn:de:bgb:ehe:a03:E"), entity_ref("urn:de:bgb:ehe:a03:A"), @2025-06-03) { origin case_input; }
    }
    evaluate truth(letzter_tag_der_antragsfrist(entity_ref("urn:de:bgb:ehe:a03:E"), entity_ref("urn:de:bgb:ehe:a03:A"), Arglistige_Taeuschung_1314_Abs_2_Nr_3, @2025-06-03));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(antrag_verfristet(entity_ref("urn:de:bgb:ehe:a03:E"), entity_ref("urn:de:bgb:ehe:a03:A"), Arglistige_Taeuschung_1314_Abs_2_Nr_3));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
