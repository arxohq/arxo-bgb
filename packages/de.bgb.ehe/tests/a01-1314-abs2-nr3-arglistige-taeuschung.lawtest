language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1314 Abs. 2 Nr. 3: das Gericht hat die arglistige Täuschung über wesentliche Umstände festgestellt. Weder betraf die Täuschung Vermögensverhältnisse noch wurde sie von einem Dritten ohne Wissen des anderen Ehegatten verübt (Halbsatz 2) — die Ehe ist aufhebbar, und nach § 1316 Abs. 1 Nr. 2 ist der getäuschte Ehegatte antragsberechtigt.
test "§ 1314 Abs. 2 Nr. 3: Aufhebbarkeit wegen arglistiger Täuschung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:a01:E"), entity_ref("urn:de:bgb:ehe:a01:A"), entity_ref("urn:de:bgb:ehe:a01:B")) { origin case_input; }
        assert "f2": eheschliessung_am(entity_ref("urn:de:bgb:ehe:a01:E"), @2024-02-10) { origin case_input; }
        assert "f3": arglistige_taeuschung_ueber_wesentliche_umstaende(entity_ref("urn:de:bgb:ehe:a01:E"), entity_ref("urn:de:bgb:ehe:a01:A")) { origin adjudicated; }
        assert "f4": bestaetigungsberechtigter_ehegatte(entity_ref("urn:de:bgb:ehe:a01:E"), entity_ref("urn:de:bgb:ehe:a01:A"), Arglistige_Taeuschung_1314_Abs_2_Nr_3) { origin case_input; }
    }
    evaluate truth(ehe_aufhebbar(entity_ref("urn:de:bgb:ehe:a01:E"), Arglistige_Taeuschung_1314_Abs_2_Nr_3));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(antragsberechtigt(entity_ref("urn:de:bgb:ehe:a01:E"), entity_ref("urn:de:bgb:ehe:a01:A"), Arglistige_Taeuschung_1314_Abs_2_Nr_3));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
