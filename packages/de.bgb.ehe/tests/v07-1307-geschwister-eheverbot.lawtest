language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1307 Satz 1: A und B sind vollbürtige Geschwister — beide stammen von M und V ab. Der Grad wird von calc.kinship gerechnet (römische Zählung, § 1589 Abs. 1 Satz 3); das Eheverbot folgt unmittelbar. Die Ehe ist nach § 1314 Abs. 1 Nr. 2 aufhebbar.
test "§ 1307: Ehe zwischen vollbürtigen Geschwistern" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:v07:E"), entity_ref("urn:de:bgb:ehe:v07:A"), entity_ref("urn:de:bgb:ehe:v07:B")) { origin case_input; }
        assert "f2": familie_der_ehe(entity_ref("urn:de:bgb:ehe:v07:E"), entity_ref("urn:de:bgb:ehe:v07:F")) { origin case_input; }
        assert "f3": eheschliessung_am(entity_ref("urn:de:bgb:ehe:v07:E"), @2025-06-01) { origin case_input; }
        assert "f4": calc.kinship::parent_edge(entity_ref("urn:de:bgb:ehe:v07:F"), entity_ref("urn:de:bgb:ehe:v07:M"), entity_ref("urn:de:bgb:ehe:v07:A"), calc.kinship::Blood) { origin case_input; }
        assert "f5": calc.kinship::parent_edge(entity_ref("urn:de:bgb:ehe:v07:F"), entity_ref("urn:de:bgb:ehe:v07:M"), entity_ref("urn:de:bgb:ehe:v07:B"), calc.kinship::Blood) { origin case_input; }
        assert "f6": calc.kinship::parent_edge(entity_ref("urn:de:bgb:ehe:v07:F"), entity_ref("urn:de:bgb:ehe:v07:VA"), entity_ref("urn:de:bgb:ehe:v07:A"), calc.kinship::Blood) { origin case_input; }
        assert "f7": calc.kinship::parent_edge(entity_ref("urn:de:bgb:ehe:v07:F"), entity_ref("urn:de:bgb:ehe:v07:VA"), entity_ref("urn:de:bgb:ehe:v07:B"), calc.kinship::Blood) { origin case_input; }
        assert "f8": calc.kinship::family_degree_count(entity_ref("urn:de:bgb:ehe:v07:F"), calc.kinship::Roman) { origin case_input; }
        assert "f9": calc.kinship::family_adoption_effect(entity_ref("urn:de:bgb:ehe:v07:F"), calc.kinship::ReplacesBlood) { origin case_input; }
        assert "f10": calc.kinship::family_depth_cap(entity_ref("urn:de:bgb:ehe:v07:F"), 12) { origin case_input; }
    }
    evaluate truth(eheverbot(entity_ref("urn:de:bgb:ehe:v07:E"), "§ 1307 Satz 1: vollbürtige Geschwister"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ehe_aufhebbar(entity_ref("urn:de:bgb:ehe:v07:E"), Verwandtschaft_1307));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
