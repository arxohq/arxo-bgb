language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1360b: A leistet zum Unterhalt der Familie einen höheren Beitrag, als ihm obliegt. Im Zweifel ist anzunehmen, dass er keinen Ersatz verlangen will; der Fall behauptet keinen Vorbehalt, die Vermutung hält. Zugleich zeigt der Fall § 1360 Satz 2: dem B ist die Haushaltsführung überlassen, er erfüllt seine Beitragspflicht dadurch.
test "§ 1360b: Zuvielleistung ohne Ersatzabsicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:w05:E"), entity_ref("urn:de:bgb:ehe:w05:A"), entity_ref("urn:de:bgb:ehe:w05:B")) { origin case_input; }
        assert "f2": hoeherer_beitrag_zum_familienunterhalt(entity_ref("urn:de:bgb:ehe:w05:E"), entity_ref("urn:de:bgb:ehe:w05:A")) { origin case_input; }
        assert "f3": haushaltsfuehrung_ueberlassen(entity_ref("urn:de:bgb:ehe:w05:E"), entity_ref("urn:de:bgb:ehe:w05:B")) { origin case_input; }
    }
    evaluate truth(kein_ersatz_fuer_zuvielleistung(entity_ref("urn:de:bgb:ehe:w05:E"), entity_ref("urn:de:bgb:ehe:w05:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(unterhaltspflicht_durch_haushaltsfuehrung_erfuellt(entity_ref("urn:de:bgb:ehe:w05:E"), entity_ref("urn:de:bgb:ehe:w05:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(zum_familienunterhalt_verpflichtet(entity_ref("urn:de:bgb:ehe:w05:E"), entity_ref("urn:de:bgb:ehe:w05:A"), entity_ref("urn:de:bgb:ehe:w05:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
