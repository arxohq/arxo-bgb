language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1357 Abs. 1: A besorgt ein Geschäft zur Deckung des Lebensbedarfs der Familie, und das Gericht hat die Angemessenheit festgestellt. Der Fall behauptet weder abweichende Umstände (Satz 2) noch Getrenntleben (Abs. 3) noch eine Beschränkung (Abs. 2) — B wird daher mitberechtigt und mitverpflichtet.
test "§ 1357 Abs. 1: beide Ehegatten werden berechtigt und verpflichtet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:w01:E"), entity_ref("urn:de:bgb:ehe:w01:A"), entity_ref("urn:de:bgb:ehe:w01:B")) { origin case_input; }
        assert "f2": geschaeft_zur_deckung_des_lebensbedarfs(entity_ref("urn:de:bgb:ehe:w01:E"), entity_ref("urn:de:bgb:ehe:w01:A")) { origin case_input; }
        assert "f3": geschaeft_angemessen_zur_deckung_des_lebensbedarfs(entity_ref("urn:de:bgb:ehe:w01:E"), entity_ref("urn:de:bgb:ehe:w01:A")) { origin adjudicated; }
    }
    evaluate truth(mitverpflichtet_aus_dem_geschaeft(entity_ref("urn:de:bgb:ehe:w01:E"), entity_ref("urn:de:bgb:ehe:w01:B"), entity_ref("urn:de:bgb:ehe:w01:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
