language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// Kanarienvogel zu u01: derselbe Sachverhalt am 16.07.2027, einen Tag nach Ablauf der drei Jahre. Die Verlängerung setzt die Billigkeit voraus (§ 1570 Abs. 1 Satz 2, Abs. 2) — das Gericht hat sie nicht festgestellt, und der Anspruch besteht nicht. Der Fall zeigt zugleich, dass die Antwort des Gerichts fehlen DARF: der Kopf bleibt NEITHER und fragt das Gericht.
test "§ 1570 Abs. 1 Satz 2: nach drei Jahren nur, soweit es der Billigkeit entspricht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:u02:E"), entity_ref("urn:de:bgb:ehe:u02:A"), entity_ref("urn:de:bgb:ehe:u02:B")) { origin case_input; }
        assert "f2": kein_ehevertrag(entity_ref("urn:de:bgb:ehe:u02:E")) { origin case_input; }
        assert "f3": geschiedener_ehegatte(entity_ref("urn:de:bgb:ehe:u02:E"), entity_ref("urn:de:bgb:ehe:u02:B")) { origin case_input; }
        assert "f4": gemeinschaftliches_kind(entity_ref("urn:de:bgb:ehe:u02:E"), entity_ref("urn:de:bgb:ehe:u02:K")) { origin case_input; }
        assert "f5": geburt_des_kindes_am(entity_ref("urn:de:bgb:ehe:u02:E"), entity_ref("urn:de:bgb:ehe:u02:K"), @2024-07-15) { origin case_input; }
        assert "f6": betreuungsfrist_1570(entity_ref("urn:de:bgb:ehe:u02:E"), entity_ref("urn:de:bgb:ehe:u02:K"), entity_ref("urn:de:bgb:ehe:u02:F")) { origin case_input; }
        assert "f7": pflege_oder_erziehung_des_kindes(entity_ref("urn:de:bgb:ehe:u02:E"), entity_ref("urn:de:bgb:ehe:u02:B"), entity_ref("urn:de:bgb:ehe:u02:K")) { origin case_input; }
        assert "f8": bewertungstag(entity_ref("urn:de:bgb:ehe:u02:E"), @2027-07-16) { origin case_input; }
        assert "f9": not verlaengerung_der_betreuung_billig(entity_ref("urn:de:bgb:ehe:u02:E"), entity_ref("urn:de:bgb:ehe:u02:B")) { origin adjudicated; }
    }
    evaluate truth(nachehelicher_unterhaltsanspruch(entity_ref("urn:de:bgb:ehe:u02:E"), entity_ref("urn:de:bgb:ehe:u02:B"), entity_ref("urn:de:bgb:ehe:u02:A"), Kindesbetreuung_1570));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
