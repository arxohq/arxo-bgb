language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// Kanarienvogel zu a03: derselbe Sachverhalt, aber der Antrag wird einen Tag später gestellt (04.06.2025). Die Jahresfrist des § 1317 Abs. 1 ist mit Ablauf des 03.06.2025 verstrichen — der Antrag kann nicht mehr gestellt werden.
test "§ 1317 Abs. 1: einen Tag nach Ablauf der Jahresfrist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:a04:E"), entity_ref("urn:de:bgb:ehe:a04:A"), entity_ref("urn:de:bgb:ehe:a04:B")) { origin case_input; }
        assert "f2": eheschliessung_am(entity_ref("urn:de:bgb:ehe:a04:E"), @2023-01-20) { origin case_input; }
        assert "f3": arglistige_taeuschung_ueber_wesentliche_umstaende(entity_ref("urn:de:bgb:ehe:a04:E"), entity_ref("urn:de:bgb:ehe:a04:A")) { origin adjudicated; }
        assert "f4": entdeckung_oder_aufhoeren_am(entity_ref("urn:de:bgb:ehe:a04:E"), entity_ref("urn:de:bgb:ehe:a04:A"), @2024-06-03) { origin case_input; }
        assert "f5": antragsfrist_1317(entity_ref("urn:de:bgb:ehe:a04:E"), entity_ref("urn:de:bgb:ehe:a04:A"), Arglistige_Taeuschung_1314_Abs_2_Nr_3, entity_ref("urn:de:bgb:ehe:a04:F")) { origin case_input; }
        assert "f6": aufhebungsantrag_gestellt_am(entity_ref("urn:de:bgb:ehe:a04:E"), entity_ref("urn:de:bgb:ehe:a04:A"), @2025-06-04) { origin case_input; }
    }
    evaluate truth(antrag_verfristet(entity_ref("urn:de:bgb:ehe:a04:E"), entity_ref("urn:de:bgb:ehe:a04:A"), Arglistige_Taeuschung_1314_Abs_2_Nr_3));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
