language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1566 Abs. 2: die Ehegatten leben seit dem 01.03.2024 getrennt; die Dreijahresfrist endet mit Ablauf des 01.03.2027 (ein Montag). Am 02.03.2027 wird das Scheitern unwiderlegbar vermutet — OHNE Antrag oder Zustimmung des anderen Ehegatten. Zugleich zeigt der Fall § 1567 Abs. 2: ein kurzer Versöhnungsversuch unterbricht die Frist nicht.
test "§ 1566 Abs. 2: drei Jahre Getrenntleben, Versöhnungsversuch unschädlich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:s03:E"), entity_ref("urn:de:bgb:ehe:s03:A"), entity_ref("urn:de:bgb:ehe:s03:B")) { origin case_input; }
        assert "f2": kein_ehevertrag(entity_ref("urn:de:bgb:ehe:s03:E")) { origin case_input; }
        assert "f3": trennung_am(entity_ref("urn:de:bgb:ehe:s03:E"), @2024-03-01) { origin case_input; }
        assert "f4": trennungsfrist_drei_jahre(entity_ref("urn:de:bgb:ehe:s03:E"), entity_ref("urn:de:bgb:ehe:s03:F")) { origin case_input; }
        assert "f5": bewertungstag(entity_ref("urn:de:bgb:ehe:s03:E"), @2027-03-02) { origin case_input; }
        assert "f6": versoehnungsversuch(entity_ref("urn:de:bgb:ehe:s03:E")) { origin case_input; }
        assert "f7": keine_haeusliche_gemeinschaft(entity_ref("urn:de:bgb:ehe:s03:E")) { origin case_input; }
        assert "f8": lebensgemeinschaft_erkennbar_abgelehnt(entity_ref("urn:de:bgb:ehe:s03:E"), entity_ref("urn:de:bgb:ehe:s03:A")) { origin case_input; }
    }
    evaluate truth(letzter_tag_der_trennungsfrist(entity_ref("urn:de:bgb:ehe:s03:E"), "drei Jahre (§ 1566 Abs. 2)", @2027-03-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(scheitern_unwiderleglich_vermutet(entity_ref("urn:de:bgb:ehe:s03:E"), "§ 1566 Abs. 2: drei Jahre Getrenntleben"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(getrenntleben(entity_ref("urn:de:bgb:ehe:s03:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(versoehnungsversuch_unterbricht_die_frist_nicht(entity_ref("urn:de:bgb:ehe:s03:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
