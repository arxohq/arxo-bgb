language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

test "§§ 1303, 1306, 1307: Eheverbote aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.ehe::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1303(entity_ref("urn:ehe:e1303"), entity_ref("urn:ehe:p1303"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1306(entity_ref("urn:ehe:e1306"), entity_ref("urn:ehe:p1306"), entity_ref("urn:ehe:d1306"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1307(entity_ref("urn:ehe:e1307"), entity_ref("urn:ehe:p1307"), entity_ref("urn:ehe:q1307"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Eheverbot1303, ACTIVE); expect position(Eheverbot1306, ACTIVE); expect position(Eheverbot1307, ACTIVE);
}

test "§§ 1303, 1306, 1307: Eheverbote erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.ehe::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1303(entity_ref("urn:ehe:e1303"), entity_ref("urn:ehe:p1303"), @2026-01-01) { origin case_input; }
 assert "ag": eheverbot_1303_geschuldet(entity_ref("urn:ehe:e1303")) { origin case_input; }
 assert "b": position_trigger_1306(entity_ref("urn:ehe:e1306"), entity_ref("urn:ehe:p1306"), entity_ref("urn:ehe:d1306"), @2026-01-01) { origin case_input; }
 assert "bg": eheverbot_1306_geschuldet(entity_ref("urn:ehe:e1306")) { origin case_input; }
 assert "c": position_trigger_1307(entity_ref("urn:ehe:e1307"), entity_ref("urn:ehe:p1307"), entity_ref("urn:ehe:q1307"), @2026-01-01) { origin case_input; }
 assert "cg": eheverbot_1307_geschuldet(entity_ref("urn:ehe:e1307")) { origin case_input; } }
 evaluate positions();
 expect position(Eheverbot1303, SATISFIED); expect position(Eheverbot1306, SATISFIED); expect position(Eheverbot1307, SATISFIED);
}
