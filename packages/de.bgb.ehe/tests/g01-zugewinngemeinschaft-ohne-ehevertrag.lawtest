language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1363 Abs. 1: ohne Ehevertrag leben die Ehegatten in der Zugewinngemeinschaft — ausdrückliche Angabe kein_ehevertrag.
test "§ 1363 Abs. 1: gesetzlicher Güterstand ohne Ehevertrag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:pilot:g01:EHE"), entity_ref("urn:de:bgb:pilot:g01:D"), entity_ref("urn:de:bgb:pilot:g01:S")) { origin case_input; }
        assert "f2": kein_ehevertrag(entity_ref("urn:de:bgb:pilot:g01:EHE")) { origin case_input; }
    }
    evaluate truth(gueterstand(entity_ref("urn:de:bgb:pilot:g01:EHE"), Zugewinngemeinschaft));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(gueterstand(entity_ref("urn:de:bgb:pilot:g01:EHE"), Guetertrennung));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
