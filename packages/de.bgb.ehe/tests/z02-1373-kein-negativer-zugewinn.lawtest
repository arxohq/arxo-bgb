language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1373: Zugewinn ist der Betrag, um den das Endvermögen das Anfangsvermögen ÜBERSTEIGT. A hat 60 000,00 € Anfangs- und 40 000,00 € Endvermögen — sein Zugewinn ist NULL, nicht minus 20 000,00 €. Die zweite Regel mit umgekehrter Garde ersetzt ein `max`, das der Text nicht kennt. B hat 10 000,00 € Zugewinn, der Überschuss geht daher zugunsten des A: 5 000,00 €.
test "§ 1373: ein negativer Zugewinn ist keiner" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:z02:E"), entity_ref("urn:de:bgb:ehe:z02:A"), entity_ref("urn:de:bgb:ehe:z02:B")) { origin case_input; }
        assert "f2": kein_ehevertrag(entity_ref("urn:de:bgb:ehe:z02:E")) { origin case_input; }
        assert "f3": gueterstand_beendet_am(entity_ref("urn:de:bgb:ehe:z02:E"), @2025-09-30) { origin case_input; }
        assert "f4": gueterstand_auf_andere_weise_als_durch_tod_beendet(entity_ref("urn:de:bgb:ehe:z02:E")) { origin case_input; }
        assert "f5": vermoegen_beim_eintritt_des_gueterstands(entity_ref("urn:de:bgb:ehe:z02:E"), entity_ref("urn:de:bgb:ehe:z02:A"), 60000.00 EUR) { origin case_input; }
        assert "f6": vermoegen_beim_eintritt_des_gueterstands(entity_ref("urn:de:bgb:ehe:z02:E"), entity_ref("urn:de:bgb:ehe:z02:B"), 20000.00 EUR) { origin case_input; }
        assert "f7": vermoegen_bei_beendigung_des_gueterstands(entity_ref("urn:de:bgb:ehe:z02:E"), entity_ref("urn:de:bgb:ehe:z02:A"), 40000.00 EUR) { origin case_input; }
        assert "f8": vermoegen_bei_beendigung_des_gueterstands(entity_ref("urn:de:bgb:ehe:z02:E"), entity_ref("urn:de:bgb:ehe:z02:B"), 30000.00 EUR) { origin case_input; }
        assert "f9": keine_hinzurechnung_zum_anfangsvermoegen(entity_ref("urn:de:bgb:ehe:z02:E"), entity_ref("urn:de:bgb:ehe:z02:A")) { origin case_input; }
        assert "f10": keine_hinzurechnung_zum_anfangsvermoegen(entity_ref("urn:de:bgb:ehe:z02:E"), entity_ref("urn:de:bgb:ehe:z02:B")) { origin case_input; }
        assert "f11": keine_illoyale_minderung(entity_ref("urn:de:bgb:ehe:z02:E"), entity_ref("urn:de:bgb:ehe:z02:A")) { origin case_input; }
        assert "f12": keine_illoyale_minderung(entity_ref("urn:de:bgb:ehe:z02:E"), entity_ref("urn:de:bgb:ehe:z02:B")) { origin case_input; }
    }
    evaluate truth(zugewinn(entity_ref("urn:de:bgb:ehe:z02:E"), entity_ref("urn:de:bgb:ehe:z02:A"), 0.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ausgleichsforderung(entity_ref("urn:de:bgb:ehe:z02:E"), entity_ref("urn:de:bgb:ehe:z02:A"), entity_ref("urn:de:bgb:ehe:z02:B"), 5000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
