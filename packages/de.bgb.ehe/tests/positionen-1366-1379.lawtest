language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

test "§§ 1366, 1367, 1379: Ehegattenauskunft aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.ehe::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1366(entity_ref("urn:ehe:e1366"), entity_ref("urn:ehe:g1366"), entity_ref("urn:ehe:d1366"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1367(entity_ref("urn:ehe:e1367"), entity_ref("urn:ehe:g1367"), entity_ref("urn:ehe:p1367"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1379(entity_ref("urn:ehe:e1379"), entity_ref("urn:ehe:p1379"), entity_ref("urn:ehe:q1379"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Genehmigung1366, ACTIVE); expect position(Unwirksamkeit1367, ACTIVE); expect position(Auskunft1379, ACTIVE);
}

test "§§ 1366, 1367, 1379: Ehegattenauskunft erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.ehe::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1366(entity_ref("urn:ehe:e1366"), entity_ref("urn:ehe:g1366"), entity_ref("urn:ehe:d1366"), @2026-01-01) { origin case_input; }
 assert "ag": genehmigung_1366_geschuldet(entity_ref("urn:ehe:e1366"), entity_ref("urn:ehe:g1366")) { origin case_input; }
 assert "b": position_trigger_1367(entity_ref("urn:ehe:e1367"), entity_ref("urn:ehe:g1367"), entity_ref("urn:ehe:p1367"), @2026-01-01) { origin case_input; }
 assert "bg": rechtsgeschaeft_1367_unwirksam(entity_ref("urn:ehe:e1367"), entity_ref("urn:ehe:g1367")) { origin case_input; }
 assert "c": position_trigger_1379(entity_ref("urn:ehe:e1379"), entity_ref("urn:ehe:p1379"), entity_ref("urn:ehe:q1379"), @2026-01-01) { origin case_input; }
 assert "cg": auskunft_1379_geschuldet(entity_ref("urn:ehe:e1379"), entity_ref("urn:ehe:q1379"), entity_ref("urn:ehe:p1379")) { origin case_input; } }
 evaluate positions();
 expect position(Genehmigung1366, SATISFIED); expect position(Unwirksamkeit1367, SATISFIED); expect position(Auskunft1379, SATISFIED);
}
