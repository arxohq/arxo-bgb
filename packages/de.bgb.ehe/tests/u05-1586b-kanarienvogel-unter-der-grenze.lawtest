language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// Kanarienvogel zu u04 auf der anderen Seite der Grenze: derselbe Sachverhalt, aber der fiktive Pflichtteil beträgt 5 000,00 €. Der volle Unterhalt von 2 400,00 € bleibt darunter, und der Erbe haftet in voller Höhe — die Grenze des § 1586b Abs. 1 Satz 3 wird nicht wirksam.
test "§ 1586b Abs. 1: unterhalb des fiktiven Pflichtteils haftet der Erbe voll" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:u05:E"), entity_ref("urn:de:bgb:ehe:u05:A"), entity_ref("urn:de:bgb:ehe:u05:B")) { origin case_input; }
        assert "f2": kein_ehevertrag(entity_ref("urn:de:bgb:ehe:u05:E")) { origin case_input; }
        assert "f3": geschiedener_ehegatte(entity_ref("urn:de:bgb:ehe:u05:E"), entity_ref("urn:de:bgb:ehe:u05:B")) { origin case_input; }
        assert "f4": ehelicher_bedarf(entity_ref("urn:de:bgb:ehe:u05:E"), entity_ref("urn:de:bgb:ehe:u05:B"), 2400.00 EUR) { origin case_input; }
        assert "f5": einkuenfte_aus_angemessener_erwerbstaetigkeit(entity_ref("urn:de:bgb:ehe:u05:E"), entity_ref("urn:de:bgb:ehe:u05:B"), 900.00 EUR) { origin case_input; }
        assert "f6": tod_des_verpflichteten(entity_ref("urn:de:bgb:ehe:u05:E"), entity_ref("urn:de:bgb:ehe:u05:A")) { origin case_input; }
        assert "f7": erbe_des_verpflichteten(entity_ref("urn:de:bgb:ehe:u05:E"), entity_ref("urn:de:bgb:ehe:u05:A"), entity_ref("urn:de:bgb:ehe:u05:ERBE")) { origin case_input; }
        assert "f8": fiktiver_pflichtteil(entity_ref("urn:de:bgb:ehe:u05:E"), entity_ref("urn:de:bgb:ehe:u05:B"), 5000.00 EUR) { origin case_input; }
    }
    evaluate truth(haftung_des_erben(entity_ref("urn:de:bgb:ehe:u05:E"), entity_ref("urn:de:bgb:ehe:u05:ERBE"), entity_ref("urn:de:bgb:ehe:u05:B"), 2400.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
