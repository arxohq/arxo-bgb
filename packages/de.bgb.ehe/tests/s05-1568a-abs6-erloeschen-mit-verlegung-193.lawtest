language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// § 1568a Abs. 6: die Endentscheidung in der Scheidungssache wird am 11.04.2025 rechtskräftig. Die Jahresfrist endet kalendarisch am 11.04.2026 — einem SAMSTAG. Der Anspruch ist innerhalb der Frist RECHTSHÄNGIG ZU MACHEN, daher tritt nach § 193 der nächste Werktag an die Stelle: Montag, der 13.04.2026. Am 14.04.2026 ist der Anspruch erloschen, weil er nicht vorher rechtshängig gemacht worden ist.
test "§ 1568a Abs. 6: Erlöschen ein Jahr nach Rechtskraft, § 193 verlegt auf den Montag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; deadline_policy BGB_EHE_KALENDER; }
        assert "f1": ehegatten(entity_ref("urn:de:bgb:ehe:s05:E"), entity_ref("urn:de:bgb:ehe:s05:A"), entity_ref("urn:de:bgb:ehe:s05:B")) { origin case_input; }
        assert "f2": kein_ehevertrag(entity_ref("urn:de:bgb:ehe:s05:E")) { origin case_input; }
        assert "f3": scheidungsurteil_rechtskraeftig_am(entity_ref("urn:de:bgb:ehe:s05:E"), @2025-04-11) { origin case_input; }
        assert "f4": eintrittsfrist_1568a(entity_ref("urn:de:bgb:ehe:s05:E"), entity_ref("urn:de:bgb:ehe:s05:F")) { origin case_input; }
        assert "f5": bewertungstag(entity_ref("urn:de:bgb:ehe:s05:E"), @2026-04-14) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::frist_ende_kalender(entity_ref("urn:de:bgb:ehe:s05:F"), @2026-04-11));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(de.bgb.fristen::frist_ende(entity_ref("urn:de:bgb:ehe:s05:F"), @2026-04-13));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anspruch_auf_eintritt_erloschen(entity_ref("urn:de:bgb:ehe:s05:E"), entity_ref("urn:de:bgb:ehe:s05:A")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ehe_geschieden_am(entity_ref("urn:de:bgb:ehe:s05:E"), @2025-04-11));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
