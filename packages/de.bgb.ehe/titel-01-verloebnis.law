// TITEL 1 — VERLÖBNIS (§§ 1297–1302)
//
// Der Titel gibt dem Verlöbnis gerade KEINE Erfüllungswirkung (§ 1297) und
// knüpft an den Rücktritt einen Ersatzanspruch (§§ 1298, 1299), an das
// Unterbleiben der Eheschließung einen Rückgabeanspruch (§ 1301) und an die
// Auflösung den Beginn der Verjährung (§ 1302).
//
// DREI KANÄLE DER WERTUNG (DECISION-0194). „Den Umständen nach angemessen“
// (§ 1298 Abs. 2) und „ein wichtiger Grund“ (§ 1298 Abs. 3, § 1299) sind
// Wertungen und stehen im Urteilskanal §47.3; die Antwort des Gerichts darf
// auch VERNEINEND sein. „Im Zweifel ist anzunehmen“ (§ 1301 Satz 2) ist eine
// Vermutung §146 mit ausdrücklichem Gegenbeweis.
//
// GRENZE (§ 1301 Satz 1). Der Umfang der Herausgabe richtet sich „nach den
// Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung“
// (§§ 812 ff., Paket `de.bgb.bereicherung_delikt`). Diese Verweisung wird
// NICHT nachgebaut: das Paket leitet den Anspruch dem Grunde nach her und
// sagt in der Marke, wohin der Umfang gehört (Ledger D-12-05).

language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// --- Eingänge des Falls ---------------------------------------------------------------------------

pub entity Verloebnis {
    label de official "Verlöbnis: das Versprechen, die Ehe miteinander einzugehen (§§ 1297–1302)";
    label en unofficial "engagement: the promise to marry each other (§§ 1297–1302)";
}

pub relation verlobte(v: Verloebnis, erster: Person, zweiter: Person) kind empirical {
    key(v);
    label de official "Die Verlobten dieses Verlöbnisses (Angabe in einer Richtung, gelesen in beiden)";
    label en unofficial "the engaged persons of this engagement (stated in one direction, read in both)";
}
pub relation verlobter(v: Verloebnis, p: Person) kind derived {
    label de official "Person ist Verlobter dieses Verlöbnisses";
    label en unofficial "person is one of the engaged persons of this engagement";
}
pub relation anderer_verlobter(v: Verloebnis, p: Person, anderer: Person) kind derived {
    label de official "der andere Verlobte";
    label en unofficial "the other engaged person";
}
relation antrag_auf_eingehung_der_ehe_gestellt(v: Verloebnis, antragsteller: Person) kind empirical {
    label de official "Ein Verlobter stellt aus dem Verlöbnis einen Antrag auf Eingehung der Ehe (§ 1297 Abs. 1)";
    label en unofficial "one engaged person applies, on the basis of the engagement, for the marriage to be entered into (§ 1297 (1))";
}
relation strafversprechen_fuer_den_fall_des_unterbleibens(v: Verloebnis, versprechender: Person) kind empirical {
    label de official "Versprechen einer Strafe für den Fall, dass die Eingehung der Ehe unterbleibt (§ 1297 Abs. 2)";
    label en unofficial "promise of a penalty in case the marriage is not entered into (§ 1297 (2))";
}
pub relation ruecktritt_vom_verloebnis(v: Verloebnis, zurueckgetretener: Person) kind empirical {
    label de official "Ein Verlobter tritt von dem Verlöbnis zurück (§ 1298 Abs. 1 Satz 1)";
    label en unofficial "one engaged person withdraws from the engagement (§ 1298 (1) sentence 1)";
}
relation aufwendungen_in_erwartung_der_ehe(v: Verloebnis, geschaedigter: Person) kind empirical {
    label de official "Der Geschädigte hat in Erwartung der Ehe Aufwendungen gemacht oder Verbindlichkeiten eingegangen (§ 1298 Abs. 1 Satz 1)";
    label en unofficial "the injured person made expenditures or incurred liabilities in expectation of the marriage (§ 1298 (1) sentence 1)";
}
relation sonstige_massnahme_in_erwartung_der_ehe(v: Verloebnis, geschaedigter: Person) kind empirical {
    label de official "Der andere Verlobte hat in Erwartung der Ehe sonstige sein Vermögen oder seine Erwerbsstellung berührende Maßnahmen getroffen (§ 1298 Abs. 1 Satz 2)";
    label en unofficial "the other engaged person took other measures affecting his assets or his earning position in expectation of the marriage (§ 1298 (1) sentence 2)";
}
relation elternteil_des_verlobten(v: Verloebnis, verlobter_person: Person, elternteil: Person) kind empirical {
    label de official "Elternteil eines Verlobten (§ 1298 Abs. 1 Satz 1: „dessen Eltern“)";
    label en unofficial "parent of an engaged person (§ 1298 (1) sentence 1: 'his parents')";
}
relation anstelle_der_eltern_gehandelt(v: Verloebnis, verlobter_person: Person, dritter: Person) kind empirical {
    label de official "Dritte Person, die anstelle der Eltern gehandelt hat (§ 1298 Abs. 1 Satz 1)";
    label en unofficial "third person who acted in place of the parents (§ 1298 (1) sentence 1)";
}
relation verschulden_das_einen_wichtigen_grund_bildet(v: Verloebnis, veranlasser: Person) kind empirical {
    label de official "Ein Verlobter veranlasst den Rücktritt des anderen durch ein Verschulden, das einen wichtigen Grund für den Rücktritt bildet (§ 1299)";
    label en unofficial "one engaged person causes the other's withdrawal by fault constituting a serious ground for withdrawal (§ 1299)";
}
relation eheschliessung_unterbleibt(v: Verloebnis) kind empirical {
    label de official "Die Eheschließung unterbleibt (§ 1301 Satz 1)";
    label en unofficial "the marriage is not entered into (§ 1301 sentence 1)";
}
relation geschenk_oder_zeichen_des_verloebnisses(v: Verloebnis, geber: Person, empfaenger: Person, sache: de.bgb.core::Sache) kind empirical {
    label de official "Was ein Verlobter dem anderen geschenkt oder zum Zeichen des Verlöbnisses gegeben hat (§ 1301 Satz 1)";
    label en unofficial "what one engaged person gave the other as a gift or as a token of the engagement (§ 1301 sentence 1)";
}
relation verloebnis_durch_tod_aufgeloest(v: Verloebnis, verstorbener: Person) kind empirical {
    label de official "Das Verlöbnis ist durch den Tod eines der Verlobten aufgelöst (§ 1301 Satz 2)";
    label en unofficial "the engagement has been dissolved by the death of one of the engaged persons (§ 1301 sentence 2)";
}
relation rueckforderung_ausdruecklich_vorbehalten(v: Verloebnis, geber: Person) kind empirical {
    label de official "Gegenbeweis zur Zweifelsregel des § 1301 Satz 2: die Rückforderung ist gerade nicht ausgeschlossen (ausdrückliche Angabe des Falls; das Schweigen des Falls ist keine Verneinung)";
    label en unofficial "rebuttal of the doubt rule of § 1301 sentence 2: restitution is precisely not excluded (explicit input; silence of the case is not a denial)";
}
pub relation verloebnis_aufgeloest_am(v: Verloebnis, tag: Date) kind empirical {
    key(v);
    label de official "Tag der Auflösung des Verlöbnisses (§ 1302: mit ihr beginnt die Verjährungsfrist)";
    label en unofficial "day of the dissolution of the engagement (§ 1302: the limitation period begins with it)";
}
relation verloebnisfrist(v: Verloebnis, f: Frist) kind empirical {
    key(v);
    label de official "Frist, deren Lauf § 1302 an die Auflösung des Verlöbnisses knüpft";
    label en unofficial "period whose running § 1302 attaches to the dissolution of the engagement";
}

// --- Kanäle der Wertung (§47.3) --------------------------------------------------------------------

pub external judgment relation aufwendungen_den_umstaenden_nach_angemessen(v: Verloebnis, geschaedigter: Person) {
    authority Court;
    label de official "§ 1298 Abs. 2. Der Schaden ist nur insoweit zu ersetzen, als die Aufwendungen, die Eingehung der Verbindlichkeiten und die sonstigen Maßnahmen den Umständen nach angemessen waren";
    label en unofficial "§ 1298 (2). Damage is to be compensated only in so far as the expenditures, the incurring of liabilities and the other measures were reasonable in the circumstances";
}
pub external judgment relation wichtiger_grund_fuer_den_ruecktritt(v: Verloebnis, zurueckgetretener: Person) {
    authority Court;
    label de official "§ 1298 Abs. 3. Die Ersatzpflicht tritt nicht ein, wenn ein wichtiger Grund für den Rücktritt vorliegt";
    label en unofficial "§ 1298 (3). The duty to compensate does not arise if there is a serious ground for the withdrawal";
}

// --- Ergebnisse des Titels --------------------------------------------------------------------------

relation kein_antrag_auf_eingehung_der_ehe(v: Verloebnis, antragsteller: Person) kind institutional {
    label de official "Aus einem Verlöbnis kann kein Antrag auf Eingehung der Ehe gestellt werden (§ 1297 Abs. 1): der gestellte Antrag ist aus dem Verlöbnis nicht begründet";
    label en unofficial "No application for the marriage to be entered into may be based on an engagement (§ 1297 (1))";
}
relation strafversprechen_nichtig(v: Verloebnis, versprechender: Person) kind institutional {
    label de official "Das Versprechen einer Strafe für den Fall, dass die Eingehung der Ehe unterbleibt, ist nichtig (§ 1297 Abs. 2)";
    label en unofficial "The promise of a penalty in case the marriage is not entered into is void (§ 1297 (2))";
}
pub relation ersatzpflicht_nach_1298(v: Verloebnis, pflichtiger: Person, berechtigter: Person) kind institutional {
    label de official "Ersatzpflicht des zurückgetretenen Verlobten für den Schaden aus Aufwendungen, Verbindlichkeiten und sonstigen Maßnahmen in Erwartung der Ehe (§ 1298 Abs. 1, 2); der Umfang folgt den §§ 249 ff. und ist nicht Gegenstand dieses Pakets";
    label en unofficial "Duty of the withdrawing person to compensate the damage from expenditures, liabilities and other measures made in expectation of the marriage (§ 1298 (1), (2))";
}
relation ersatzpflicht_nach_1299(v: Verloebnis, pflichtiger: Person, berechtigter: Person) kind institutional {
    label de official "Wer den Rücktritt des anderen durch ein Verschulden veranlasst, das einen wichtigen Grund für den Rücktritt bildet, ist nach Maßgabe des § 1298 Abs. 1, 2 zum Schadensersatz verpflichtet (§ 1299)";
    label en unofficial "A person who causes the other's withdrawal by fault constituting a serious ground is liable in damages under § 1298 (1), (2) (§ 1299)";
}
relation herausgabeanspruch_nach_1301(v: Verloebnis, berechtigter: Person, verpflichteter: Person, sache: de.bgb.core::Sache) kind institutional {
    label de official "Unterbleibt die Eheschließung, so kann jeder Verlobte von dem anderen die Herausgabe des Geschenkten oder zum Zeichen des Verlöbnisses Gegebenen nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung fordern (§ 1301 Satz 1); der Umfang folgt den §§ 812 ff. (de.bgb.bereicherung_delikt) und wird hier nicht nachgebaut";
    label en unofficial "If the marriage is not entered into, each engaged person may demand from the other the return of what was given, under the rules on unjust enrichment (§ 1301 sentence 1)";
}
relation rueckforderung_ausgeschlossen(v: Verloebnis, geber: Person) kind institutional {
    label de official "Im Zweifel ist anzunehmen, dass die Rückforderung ausgeschlossen sein soll, wenn das Verlöbnis durch den Tod eines der Verlobten aufgelöst wird (§ 1301 Satz 2)";
    label en unofficial "In case of doubt it is to be assumed that restitution is excluded if the engagement is dissolved by the death of one of the engaged persons (§ 1301 sentence 2)";
}
pub relation verjaehrungsbeginn_des_verloebnisanspruchs(v: Verloebnis, tag: Date) kind institutional {
    key(v);
    label de official "Die Verjährungsfrist der in den §§ 1298 bis 1301 bestimmten Ansprüche beginnt mit der Auflösung des Verlöbnisses (§ 1302)";
    label en unofficial "The limitation period of the claims determined in §§ 1298 to 1301 begins with the dissolution of the engagement (§ 1302)";
}

// --- Regeln -------------------------------------------------------------------------------------------

@source(BGB_P1297) {
    rule VerlobterErster(v: Verloebnis, a: Person, b: Person) strict {
        label de official "Das Verlöbnis besteht zwischen zwei Personen: erster Verlobter";
        label en unofficial "The engagement exists between two persons: first engaged person";
        when verlobte(v, a, b);
        then verlobter(v, a);
    }
    rule VerlobterZweiter(v: Verloebnis, a: Person, b: Person) strict {
        label de official "Das Verlöbnis besteht zwischen zwei Personen: zweiter Verlobter";
        label en unofficial "The engagement exists between two persons: second engaged person";
        when verlobte(v, a, b);
        then verlobter(v, b);
    }
    rule AndererVerlobterVonErstem(v: Verloebnis, a: Person, b: Person) strict {
        label de official "Der andere Verlobte des ersten ist der zweite";
        label en unofficial "The other engaged person of the first is the second";
        when verlobte(v, a, b);
        then anderer_verlobter(v, a, b);
    }
    rule AndererVerlobterVonZweitem(v: Verloebnis, a: Person, b: Person) strict {
        label de official "Der andere Verlobte des zweiten ist der erste";
        label en unofficial "The other engaged person of the second is the first";
        when verlobte(v, a, b);
        then anderer_verlobter(v, b, a);
    }
    rule KeinAntragAusDemVerloebnis(v: Verloebnis, a: Person) strict {
        label de official "Aus einem Verlöbnis kann kein Antrag auf Eingehung der Ehe gestellt werden (§ 1297 Abs. 1)";
        label en unofficial "No application for the marriage to be entered into may be based on an engagement (§ 1297 (1))";
        when antrag_auf_eingehung_der_ehe_gestellt(v, a);
        then kein_antrag_auf_eingehung_der_ehe(v, a);
    }
    rule StrafversprechenNichtig(v: Verloebnis, a: Person) strict {
        label de official "Das Versprechen einer Strafe für den Fall, dass die Eingehung der Ehe unterbleibt, ist nichtig (§ 1297 Abs. 2)";
        label en unofficial "The promise of a penalty in case the marriage is not entered into is void (§ 1297 (2))";
        when strafversprechen_fuer_den_fall_des_unterbleibens(v, a);
        then strafversprechen_nichtig(v, a);
    }
}

// § 1298 Abs. 1 nennt VIER Berechtigte (der andere Verlobte, dessen Eltern,
// Dritte anstelle der Eltern) und zwei Schadensarten (Satz 1 Aufwendungen und
// Verbindlichkeiten, Satz 2 sonstige Maßnahmen — nur zugunsten des anderen
// Verlobten). Je Kopf eine Regel, wie es der Text auszählt. Abs. 2 ist
// Voraussetzung jeder von ihnen, Abs. 3 der Defeater.

@source(BGB_P1298) {
    rule ErsatzpflichtGegenueberDemAnderenVerlobten(v: Verloebnis, r: Person, g: Person) defeasible {
        label de official "Tritt ein Verlobter von dem Verlöbnis zurück, so hat er dem anderen Verlobten den Schaden zu ersetzen, der daraus entstanden ist, dass dieser in Erwartung der Ehe Aufwendungen gemacht hat oder Verbindlichkeiten eingegangen ist (§ 1298 Abs. 1 Satz 1), soweit sie den Umständen nach angemessen waren (Abs. 2)";
        label en unofficial "If one engaged person withdraws, he must compensate the other for the damage arising from expenditures or liabilities incurred in expectation of the marriage (§ 1298 (1) sentence 1), in so far as reasonable ((2))";
        when ruecktritt_vom_verloebnis(v, r) and anderer_verlobter(v, r, g)
         and aufwendungen_in_erwartung_der_ehe(v, g)
         and aufwendungen_den_umstaenden_nach_angemessen(v, g);
        then ersatzpflicht_nach_1298(v, r, g);
    }
    rule ErsatzpflichtFuerSonstigeMassnahmen(v: Verloebnis, r: Person, g: Person) defeasible {
        label de official "Dem anderen Verlobten hat der Zurückgetretene auch den Schaden zu ersetzen, den dieser dadurch erleidet, dass er in Erwartung der Ehe sonstige sein Vermögen oder seine Erwerbsstellung berührende Maßnahmen getroffen hat (§ 1298 Abs. 1 Satz 2), soweit sie den Umständen nach angemessen waren (Abs. 2)";
        label en unofficial "The withdrawing person must also compensate the other for damage from other measures affecting his assets or earning position (§ 1298 (1) sentence 2), in so far as reasonable ((2))";
        when ruecktritt_vom_verloebnis(v, r) and anderer_verlobter(v, r, g)
         and sonstige_massnahme_in_erwartung_der_ehe(v, g)
         and aufwendungen_den_umstaenden_nach_angemessen(v, g);
        then ersatzpflicht_nach_1298(v, r, g);
    }
    rule ErsatzpflichtGegenueberDenEltern(v: Verloebnis, r: Person, a: Person, e: Person) defeasible {
        label de official "Der Zurückgetretene hat auch den Eltern des anderen Verlobten den Schaden zu ersetzen, der daraus entstanden ist, dass sie in Erwartung der Ehe Aufwendungen gemacht haben oder Verbindlichkeiten eingegangen sind (§ 1298 Abs. 1 Satz 1), soweit sie den Umständen nach angemessen waren (Abs. 2)";
        label en unofficial "The withdrawing person must also compensate the parents of the other engaged person (§ 1298 (1) sentence 1), in so far as reasonable ((2))";
        when ruecktritt_vom_verloebnis(v, r) and anderer_verlobter(v, r, a)
         and elternteil_des_verlobten(v, a, e) and aufwendungen_in_erwartung_der_ehe(v, e)
         and aufwendungen_den_umstaenden_nach_angemessen(v, e);
        then ersatzpflicht_nach_1298(v, r, e);
    }
    rule ErsatzpflichtGegenueberDrittenAnstelleDerEltern(v: Verloebnis, r: Person, a: Person, d: Person) defeasible {
        label de official "Der Zurückgetretene hat auch dritten Personen, welche anstelle der Eltern gehandelt haben, den Schaden zu ersetzen (§ 1298 Abs. 1 Satz 1), soweit die Aufwendungen den Umständen nach angemessen waren (Abs. 2)";
        label en unofficial "The withdrawing person must also compensate third persons who acted in place of the parents (§ 1298 (1) sentence 1), in so far as reasonable ((2))";
        when ruecktritt_vom_verloebnis(v, r) and anderer_verlobter(v, r, a)
         and anstelle_der_eltern_gehandelt(v, a, d) and aufwendungen_in_erwartung_der_ehe(v, d)
         and aufwendungen_den_umstaenden_nach_angemessen(v, d);
        then ersatzpflicht_nach_1298(v, r, d);
    }
    rule KeineErsatzpflichtBeiWichtigemGrund(v: Verloebnis, r: Person, g: Person) defeasible {
        label de official "Die Ersatzpflicht tritt nicht ein, wenn ein wichtiger Grund für den Rücktritt vorliegt (§ 1298 Abs. 3)";
        label en unofficial "The duty to compensate does not arise if there is a serious ground for the withdrawal (§ 1298 (3))";
        when wichtiger_grund_fuer_den_ruecktritt(v, r) and ruecktritt_vom_verloebnis(v, r)
         and verlobter(v, g);
        then not ersatzpflicht_nach_1298(v, r, g);
    }
    priority WichtigerGrundVorErsatzpflichtDesAnderenVerlobten {
        prefer KeineErsatzpflichtBeiWichtigemGrund over ErsatzpflichtGegenueberDemAnderenVerlobten;
        reason lex_specialis;
        label de official "§ 1298 Abs. 3 ist die Ausnahme zu Abs. 1 Satz 1";
        label en unofficial "§ 1298 (3) is the exception to (1) sentence 1";
    }
    priority WichtigerGrundVorErsatzpflichtFuerSonstigeMassnahmen {
        prefer KeineErsatzpflichtBeiWichtigemGrund over ErsatzpflichtFuerSonstigeMassnahmen;
        reason lex_specialis;
        label de official "§ 1298 Abs. 3 ist die Ausnahme zu Abs. 1 Satz 2";
        label en unofficial "§ 1298 (3) is the exception to (1) sentence 2";
    }
    priority WichtigerGrundVorErsatzpflichtDerEltern {
        prefer KeineErsatzpflichtBeiWichtigemGrund over ErsatzpflichtGegenueberDenEltern;
        reason lex_specialis;
        label de official "§ 1298 Abs. 3 ist die Ausnahme auch zugunsten gegenüber den Eltern";
        label en unofficial "§ 1298 (3) is the exception also as regards the parents";
    }
    priority WichtigerGrundVorErsatzpflichtDritter {
        prefer KeineErsatzpflichtBeiWichtigemGrund over ErsatzpflichtGegenueberDrittenAnstelleDerEltern;
        reason lex_specialis;
        label de official "§ 1298 Abs. 3 ist die Ausnahme auch gegenüber dritten Personen";
        label en unofficial "§ 1298 (3) is the exception also as regards third persons";
    }
}

@source(BGB_P1299)
rule ErsatzpflichtDesVeranlassers(v: Verloebnis, veranlasser: Person, r: Person) strict {
    label de official "Veranlasst ein Verlobter den Rücktritt des anderen durch ein Verschulden, das einen wichtigen Grund für den Rücktritt bildet, so ist er nach Maßgabe des § 1298 Abs. 1, 2 zum Schadensersatz verpflichtet (§ 1299)";
    label en unofficial "If one engaged person causes the other's withdrawal by fault constituting a serious ground for withdrawal, he is liable in damages under § 1298 (1), (2) (§ 1299)";
    when verschulden_das_einen_wichtigen_grund_bildet(v, veranlasser)
     and anderer_verlobter(v, veranlasser, r) and ruecktritt_vom_verloebnis(v, r);
    then ersatzpflicht_nach_1299(v, veranlasser, r);
}

@source(BGB_P1301) {
    rule HerausgabeDerGeschenke(v: Verloebnis, geber: Person, empfaenger: Person, s: de.bgb.core::Sache) defeasible {
        label de official "Unterbleibt die Eheschließung, so kann jeder Verlobte von dem anderen die Herausgabe desjenigen, was er ihm geschenkt oder zum Zeichen des Verlöbnisses gegeben hat, nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung fordern (§ 1301 Satz 1)";
        label en unofficial "If the marriage is not entered into, each engaged person may demand from the other the return of what he gave him as a gift or token of the engagement, under the rules on unjust enrichment (§ 1301 sentence 1)";
        when eheschliessung_unterbleibt(v) and geschenk_oder_zeichen_des_verloebnisses(v, geber, empfaenger, s);
        then herausgabeanspruch_nach_1301(v, geber, empfaenger, s);
    }
    presumption RueckforderungBeiTodAusgeschlossen(v: Verloebnis, geber: Person) {
        label de official "Im Zweifel ist anzunehmen, dass die Rückforderung ausgeschlossen sein soll, wenn das Verlöbnis durch den Tod eines der Verlobten aufgelöst wird (§ 1301 Satz 2)";
        label en unofficial "In case of doubt it is to be assumed that restitution is to be excluded if the engagement is dissolved by the death of one of the engaged persons (§ 1301 sentence 2)";
        when eheschliessung_unterbleibt(v) and verlobter(v, geber);
        presume rueckforderung_ausgeschlossen(v, geber);
        unless rueckforderung_ausdruecklich_vorbehalten(v, geber);
    }
    rule KeineHerausgabeBeiAusgeschlossenerRueckforderung(v: Verloebnis, geber: Person, empfaenger: Person, s: de.bgb.core::Sache) defeasible {
        label de official "Ist die Rückforderung nach § 1301 Satz 2 ausgeschlossen, so besteht der Anspruch aus Satz 1 nicht";
        label en unofficial "If restitution is excluded under § 1301 sentence 2, the claim under sentence 1 does not exist";
        when rueckforderung_ausgeschlossen(v, geber) and verloebnis_durch_tod_aufgeloest(v, empfaenger)
         and geschenk_oder_zeichen_des_verloebnisses(v, geber, empfaenger, s);
        then not herausgabeanspruch_nach_1301(v, geber, empfaenger, s);
    }
    priority AusgeschlosseneRueckforderungVorHerausgabe {
        prefer KeineHerausgabeBeiAusgeschlossenerRueckforderung over HerausgabeDerGeschenke;
        reason lex_specialis;
        label de official "§ 1301 Satz 2 ist die Ausnahme zu Satz 1";
        label en unofficial "§ 1301 sentence 2 is the exception to sentence 1";
    }
}

// § 1302 sagt NUR, wann die Verjährungsfrist beginnt — nicht, wie lang sie ist
// (das ist § 195, Paket `de.bgb.fristen`). Die Regel schreibt deshalb das
// Ereignis in den Fristenknoten und leitet den Beginn her; die Dauer kommt aus
// dem Fall (Ledger D-12-04).

@source(BGB_P1302) {
    rule VerjaehrungsbeginnMitDerAufloesung(v: Verloebnis, t: Date) strict {
        label de official "Die Verjährungsfrist der in den §§ 1298 bis 1301 bestimmten Ansprüche beginnt mit der Auflösung des Verlöbnisses (§ 1302)";
        label en unofficial "The limitation period of the claims determined in §§ 1298 to 1301 begins with the dissolution of the engagement (§ 1302)";
        when verloebnis_aufgeloest_am(v, t);
        then verjaehrungsbeginn_des_verloebnisanspruchs(v, t);
    }
    rule VerloebnisfristEreignis(v: Verloebnis, f: Frist, t: Date) strict {
        label de official "Maßgebend für den Anfang der Frist ist die Auflösung des Verlöbnisses (§ 1302 in Verbindung mit § 187)";
        label en unofficial "Decisive for the beginning of the period is the dissolution of the engagement (§ 1302 together with § 187)";
        when verloebnisfrist(v, f) and verjaehrungsbeginn_des_verloebnisanspruchs(v, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
}
