language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

pub relation position_trigger_1365(ehe: Ehe, g: Rechtsgeschaeft, anderer: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Zustimmung bei Verfügung über das Vermögen im Ganzen (§ 1365)"; label en unofficial "case input for consent to a disposition of all assets (§ 1365)"; }
pub relation verfuegung_1365_unwirksam_ohne_zustimmung(ehe: Ehe, g: Rechtsgeschaeft) kind empirical { label de official "Die Verfügung über das Vermögen im Ganzen ist ohne Zustimmung unwirksam (§ 1365)"; label en unofficial "The disposition of all assets is ineffective without consent (§ 1365)"; }
pub relation position_trigger_1369(ehe: Ehe, g: Rechtsgeschaeft, anderer: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Zustimmung bei Haushaltsgegenständen (§ 1369)"; label en unofficial "case input for consent to a household-object disposition (§ 1369)"; }
pub relation haushaltsverfuegung_1369_unwirksam_ohne_zustimmung(ehe: Ehe, g: Rechtsgeschaeft) kind empirical { label de official "Die Verfügung über Haushaltsgegenstände ist ohne Zustimmung unwirksam (§ 1369)"; label en unofficial "The household-object disposition is ineffective without consent (§ 1369)"; }
pub relation position_trigger_1368(ehe: Ehe, g: Rechtsgeschaeft, anderer: Person, dritter: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur gerichtlichen Geltendmachung der Unwirksamkeit (§ 1368)"; label en unofficial "case input for judicial assertion of ineffectiveness (§ 1368)"; }
pub relation unwirksamkeit_1368_ausuebbar(ehe: Ehe, g: Rechtsgeschaeft, dritter: Person) kind empirical { label de official "Der andere Ehegatte darf die Unwirksamkeitsrechte gegen den Dritten geltend machen (§ 1368)"; label en unofficial "The other spouse may assert the ineffectiveness rights against the third party (§ 1368)"; }

@source(BGB_P1365)
rule PositionZustimmung1365(ehe: Ehe, g: Rechtsgeschaeft, anderer: Person, tag: Date) strict { label de official "Die Verfügung über das Vermögen im Ganzen bedarf der Zustimmung des anderen Ehegatten (§ 1365)"; label en unofficial "Disposition of all assets requires the other spouse's consent (§ 1365)"; when position_trigger_1365(ehe, g, anderer, tag); then immunity Zustimmung1365 { holder anderer; against g; protected_effect verfuegung_1365_unwirksam_ohne_zustimmung(ehe, g); window [tag, infinity); }; }
@source(BGB_P1369)
rule PositionZustimmung1369(ehe: Ehe, g: Rechtsgeschaeft, anderer: Person, tag: Date) strict { label de official "Die Verfügung über Haushaltsgegenstände bedarf der Zustimmung des anderen Ehegatten (§ 1369)"; label en unofficial "Disposition of household objects requires the other spouse's consent (§ 1369)"; when position_trigger_1369(ehe, g, anderer, tag); then immunity Zustimmung1369 { holder anderer; against g; protected_effect haushaltsverfuegung_1369_unwirksam_ohne_zustimmung(ehe, g); window [tag, infinity); }; }
@source(BGB_P1368)
rule PositionGeltendmachung1368(ehe: Ehe, g: Rechtsgeschaeft, anderer: Person, dritter: Person, tag: Date) strict { label de official "Der andere Ehegatte darf die Rechte aus der Unwirksamkeit gegen den Dritten geltend machen (§ 1368)"; label en unofficial "The other spouse may assert the rights arising from ineffectiveness against the third party (§ 1368)"; when position_trigger_1368(ehe, g, anderer, dritter, tag); then power Geltendmachung1368 { holder anderer; over g; exercise unwirksamkeit_1368_ausuebbar(ehe, g, dritter); valid_when unwirksamkeit_1368_ausuebbar(ehe, g, dritter); effect create(unwirksamkeit_1368_ausuebbar(ehe, g, dritter)); window [tag, infinity); }; }
