// TITEL 4 — WIRKUNGEN DER EHE IM ALLGEMEINEN (§§ 1353–1362)
//
// Der Titel enthält vier ganz verschiedene Maschinen, und das Paket hält sie
// auseinander: die eheliche Lebensgemeinschaft (§§ 1353, 1356, 1359), das
// NAMENSRECHT (§§ 1355–1355b), die VERTRETUNG (§§ 1357, 1358) und den
// FAMILIENUNTERHALT samt Getrenntleben (§§ 1360–1362).
//
// NAMENSRECHT. Das Paket rechnet KEINE Namen (Muster D-13-07): welcher String
// am Ende im Register steht, ist keine Rechtsfolge, die eine Regel erzeugen
// könnte. Formalisiert sind die BEDINGUNGEN der Erklärungen — wer welchen
// Namen bestimmen darf, wann öffentliche Beglaubigung nötig ist, wann ein
// Begleitname ausgeschlossen ist (§ 1355a Abs. 2: „wenn der Ehename aus
// mehreren Namen besteht“), und dass der Widerruf eine erneute Erklärung
// sperrt (§ 1355a Abs. 4 Satz 3).
//
// § 1360a Abs. 3 verweist auf die §§ 1613 bis 1615 des Pakets
// `de.bgb.verwandtschaft` (BG-13, in HEAD). Der Verweis wird nicht
// nachgebaut: die Regel stellt fest, DASS die Vorschriften entsprechend
// anzuwenden sind, und nennt sie in ihrer Marke.
//
// § 1362 ist die einzige echte Vermutung des Titels und steht als
// `presumption` mit ausdrücklichem Gegenbeweis: Abs. 1 Satz 2 (Getrenntleben
// und Besitz des Nichtschuldners) ist die vom Text selbst benannte Ausnahme.

language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

// --- Eingänge des Falls ---------------------------------------------------------------------------

pub relation getrennt_lebend(ehe: Ehe) kind empirical {
    label de official "Die Ehegatten leben getrennt (§ 1567 Abs. 1; gelesen von §§ 1357 Abs. 3, 1358 Abs. 3 Nr. 1, 1361, 1361a, 1361b, 1362 Abs. 1 Satz 2)";
    label en unofficial "the spouses live apart (§ 1567 (1); read by §§ 1357 (3), 1358 (3) no. 1, 1361, 1361a, 1361b, 1362 (1) sentence 2)";
}
relation herstellung_der_gemeinschaft_verlangt(ehe: Ehe, verlangender: Person) kind empirical {
    label de official "Ein Ehegatte verlangt vom anderen die Herstellung der ehelichen Lebensgemeinschaft (§ 1353 Abs. 2)";
    label en unofficial "a spouse demands from the other the restoration of the marital community (§ 1353 (2))";
}
relation ehename_bestimmt(ehe: Ehe) kind empirical {
    label de official "Die Ehegatten haben einen gemeinsamen Familiennamen (Ehenamen) bestimmt (§ 1355 Abs. 1 Satz 1)";
    label en unofficial "the spouses have determined a common family name (married name) (§ 1355 (1) sentence 1)";
}
relation erklaerung_bei_der_eheschliessung_abgegeben(ehe: Ehe, p: Person) kind empirical {
    label de official "Die Erklärung ist bei der Eheschließung abgegeben worden (§ 1355 Abs. 4 Satz 1, § 1355a Abs. 3, § 1355b Abs. 2)";
    label en unofficial "the declaration was made at the marriage ceremony (§ 1355 (4) sentence 1, § 1355a (3), § 1355b (2))";
}
relation erklaerung_oeffentlich_beglaubigt(ehe: Ehe, p: Person) kind empirical {
    label de official "Die Erklärung ist öffentlich beglaubigt (§ 1355 Abs. 4 Satz 2, Abs. 5 Satz 2, § 1355a Abs. 3, § 1355b Abs. 2)";
    label en unofficial "the declaration has been publicly certified (§ 1355 (4) sentence 2, (5) sentence 2, § 1355a (3), § 1355b (2))";
}
relation ehename_besteht_aus_mehreren_namen(ehe: Ehe) kind empirical {
    label de official "Der Ehename besteht aus mehreren Namen (§ 1355a Abs. 2)";
    label en unofficial "the married name consists of several names (§ 1355a (2))";
}
relation begleitname_erklaert(ehe: Ehe, p: Person) kind empirical {
    label de official "Der Ehegatte, dessen Name nicht Ehename wird, hat dem Ehenamen einen Begleitnamen vorangestellt oder angefügt (§ 1355a Abs. 1 Satz 1)";
    label en unofficial "the spouse whose name does not become the married name has added an accompanying name (§ 1355a (1) sentence 1)";
}
relation begleitname_widerrufen(ehe: Ehe, p: Person) kind empirical {
    label de official "Die Erklärung über den Begleitnamen ist gegenüber dem Standesamt widerrufen worden (§ 1355a Abs. 4 Satz 1)";
    label en unofficial "the declaration on the accompanying name has been revoked before the registry office (§ 1355a (4) sentence 1)";
}
relation erneute_erklaerung_begleitname(ehe: Ehe, p: Person) kind empirical {
    label de official "Nach dem Widerruf wird erneut eine Erklärung nach § 1355a Abs. 1 Satz 1 abgegeben (§ 1355a Abs. 4 Satz 3)";
    label en unofficial "after the revocation a renewed declaration under § 1355a (1) sentence 1 is made (§ 1355a (4) sentence 3)";
}
relation geschlechtsangepasste_form_erklaert(ehe: Ehe, p: Person) kind empirical {
    label de official "Der Ehegatte hat erklärt, den Ehenamen in einer seinem Geschlecht angepassten Form zu führen (§ 1355b Abs. 1)";
    label en unofficial "the spouse declared that he bears the married name in a form adapted to his gender (§ 1355b (1))";
}
relation voraussetzung_der_anpassung_erfuellt(ehe: Ehe, p: Person) kind empirical {
    label de official "Eine der drei Voraussetzungen des § 1355b Abs. 1 Nr. 1 bis 3 ist erfüllt (sorbische Tradition oder ausländische Rechtsordnung)";
    label en unofficial "one of the three requirements of § 1355b (1) nos. 1 to 3 is met (Sorbian tradition or foreign legal system)";
}
relation anpassung_widerrufen(ehe: Ehe, p: Person) kind empirical {
    label de official "Die Erklärung nach § 1355b Abs. 1 ist widerrufen worden (§ 1355b Abs. 3 Satz 1)";
    label en unofficial "the declaration under § 1355b (1) has been revoked ((3) sentence 1)";
}
relation haushaltsfuehrung_ueberlassen(ehe: Ehe, p: Person) kind empirical {
    label de official "Die Haushaltsführung ist einem der Ehegatten überlassen (§ 1356 Abs. 1 Satz 2, § 1360 Satz 2)";
    label en unofficial "the running of the household is left to one of the spouses (§ 1356 (1) sentence 2, § 1360 sentence 2)";
}
relation geschaeft_zur_deckung_des_lebensbedarfs(ehe: Ehe, handelnder: Person) kind empirical {
    label de official "Ein Ehegatte besorgt ein Geschäft zur Deckung des Lebensbedarfs der Familie (§ 1357 Abs. 1 Satz 1)";
    label en unofficial "a spouse transacts business to meet the family's living needs (§ 1357 (1) sentence 1)";
}
relation aus_den_umstaenden_ergibt_sich_anderes(ehe: Ehe, handelnder: Person) kind empirical {
    label de official "Aus den Umständen ergibt sich etwas anderes als die Berechtigung und Verpflichtung beider Ehegatten (§ 1357 Abs. 1 Satz 2 Halbsatz 2)";
    label en unofficial "the circumstances indicate otherwise than that both spouses are entitled and obliged (§ 1357 (1) sentence 2)";
}
relation beschraenkung_der_berechtigung(ehe: Ehe, beschraenkender: Person, beschraenkter: Person) kind empirical {
    label de official "Ein Ehegatte beschränkt oder schließt die Berechtigung des anderen aus, Geschäfte mit Wirkung für ihn zu besorgen (§ 1357 Abs. 2 Satz 1)";
    label en unofficial "a spouse restricts or excludes the other's power to transact business with effect for him (§ 1357 (2) sentence 1)";
}
relation eintragung_im_gueterrechtsregister(ehe: Ehe) kind empirical {
    label de official "Das Vorhandensein des Ehevertrags oder der Beschränkung ist im Güterrechtsregister eingetragen oder dem Dritten bekannt (§ 1412) — äußerer Eingang des Falls";
    label en unofficial "the existence of the marriage contract or the restriction is registered or known to the third party (§ 1412) — external input";
}
relation gesundheitssorge_rechtlich_nicht_besorgbar(ehe: Ehe, vertretener: Person) kind empirical {
    label de official "Ein Ehegatte kann aufgrund von Bewusstlosigkeit oder Krankheit seine Angelegenheiten der Gesundheitssorge rechtlich nicht besorgen (§ 1358 Abs. 1)";
    label en unofficial "a spouse cannot legally attend to his health-care affairs because of unconsciousness or illness (§ 1358 (1))";
}
relation vertretung_abgelehnt_oder_bevollmaechtigt(ehe: Ehe, vertretener: Person) kind empirical {
    label de official "Dem vertretenden Ehegatten oder dem Arzt ist bekannt, dass der vertretene Ehegatte die Vertretung ablehnt oder jemanden bevollmächtigt hat (§ 1358 Abs. 3 Nr. 2)";
    label en unofficial "it is known that the represented spouse rejects the representation or has authorised another person (§ 1358 (3) no. 2)";
}
relation betreuer_mit_gesundheitssorge_bestellt(ehe: Ehe, vertretener: Person) kind empirical {
    label de official "Für den vertretenen Ehegatten ist ein Betreuer bestellt, dessen Aufgabenkreis die Gesundheitssorge umfasst (§ 1358 Abs. 3 Nr. 3, Abs. 5)";
    label en unofficial "a custodian whose remit covers health care has been appointed for the represented spouse (§ 1358 (3) no. 3, (5))";
}
relation aerztliche_bestaetigung_am(ehe: Ehe, vertretener: Person, tag: Date) kind empirical {
    label de official "Zeitpunkt, zu dem die Voraussetzungen des § 1358 Abs. 1 nach ärztlicher Feststellung spätestens eingetreten sind (§ 1358 Abs. 4 Satz 1 Nr. 1)";
    label en unofficial "point in time at which the requirements of § 1358 (1) arose at the latest according to the physician's finding ((4) sentence 1 no. 1)";
}
relation vertretungsfrist_1358(ehe: Ehe, vertretener: Person, f: Frist) kind empirical {
    label de official "Sechsmonatsfrist des § 1358 Abs. 3 Nr. 4";
    label en unofficial "six-month period of § 1358 (3) no. 4";
}
relation sorgfalt_in_eigenen_angelegenheiten_beachtet(ehe: Ehe, p: Person) kind empirical {
    label de official "Der Ehegatte hat diejenige Sorgfalt angewandt, welche er in eigenen Angelegenheiten anzuwenden pflegt (§ 1359)";
    label en unofficial "the spouse applied the care which he customarily applies in his own affairs (§ 1359)";
}
relation pflichtverletzung_aus_dem_ehelichen_verhaeltnis(ehe: Ehe, p: Person) kind empirical {
    label de official "Der Ehegatte hat eine sich aus dem ehelichen Verhältnis ergebende Verpflichtung verletzt (§ 1359)";
    label en unofficial "the spouse breached an obligation arising from the marital relationship (§ 1359)";
}
relation hoeherer_beitrag_zum_familienunterhalt(ehe: Ehe, leistender: Person) kind empirical {
    label de official "Ein Ehegatte leistet zum Unterhalt der Familie einen höheren Beitrag, als ihm obliegt (§ 1360b)";
    label en unofficial "a spouse contributes more to the family's maintenance than he is obliged to (§ 1360b)";
}
relation ersatz_ausdruecklich_vorbehalten(ehe: Ehe, leistender: Person) kind empirical {
    label de official "Gegenbeweis zur Zweifelsregel des § 1360b: der Leistende hat den Ersatz ausdrücklich vorbehalten (ausdrückliche Angabe des Falls)";
    label en unofficial "rebuttal of the doubt rule of § 1360b: the payer expressly reserved reimbursement (explicit input)";
}
relation kosten_eines_rechtsstreits_nicht_tragbar(ehe: Ehe, p: Person) kind empirical {
    label de official "Ein Ehegatte ist nicht in der Lage, die Kosten eines Rechtsstreits zu tragen, der eine persönliche Angelegenheit betrifft, oder die Kosten der Verteidigung in einem Strafverfahren (§ 1360a Abs. 4)";
    label en unofficial "a spouse is unable to bear the costs of legal proceedings in a personal matter or of a criminal defence (§ 1360a (4))";
}
relation scheidungsverfahren_rechtshaengig_seit(ehe: Ehe, tag: Date) kind empirical {
    key(ehe);
    label de official "Tag des Eintritts der Rechtshängigkeit des Scheidungsantrags (§ 1361 Abs. 1 Satz 2, § 1384)";
    label en unofficial "day on which the divorce application became pending (§ 1361 (1) sentence 2, § 1384)";
}
relation nicht_erwerbstaetiger_ehegatte(ehe: Ehe, p: Person) kind empirical {
    label de official "Der Ehegatte ist nicht erwerbstätig (§ 1361 Abs. 2)";
    label en unofficial "the spouse is not gainfully employed (§ 1361 (2))";
}
relation haushaltsgegenstand_im_eigentum(ehe: Ehe, eigentuemer: Person, sache: de.bgb.core::Sache) kind empirical {
    label de official "Haushaltsgegenstand, der einem Ehegatten gehört (§ 1361a Abs. 1 Satz 1)";
    label en unofficial "household object belonging to one spouse (§ 1361a (1) sentence 1)";
}
relation haushaltsgegenstand_im_gemeinsamen_eigentum(ehe: Ehe, sache: de.bgb.core::Sache) kind empirical {
    label de official "Haushaltsgegenstand, der den Ehegatten gemeinsam gehört (§ 1361a Abs. 2)";
    label en unofficial "household object belonging to the spouses jointly (§ 1361a (2))";
}
relation auszug_aus_der_ehewohnung_am(ehe: Ehe, ausgezogener: Person, tag: Date) kind empirical {
    label de official "Tag des Auszugs eines Ehegatten aus der Ehewohnung nach der Trennung (§ 1361b Abs. 4)";
    label en unofficial "day on which a spouse moved out of the matrimonial home after the separation (§ 1361b (4))";
}
relation rueckkehrabsicht_bekundet(ehe: Ehe, ausgezogener: Person) kind empirical {
    label de official "Der ausgezogene Ehegatte hat dem anderen gegenüber eine ernstliche Rückkehrabsicht bekundet (§ 1361b Abs. 4)";
    label en unofficial "the spouse who moved out declared a serious intention to return (§ 1361b (4))";
}
relation rueckkehrfrist_1361b(ehe: Ehe, ausgezogener: Person, f: Frist) kind empirical {
    label de official "Sechsmonatsfrist des § 1361b Abs. 4";
    label en unofficial "six-month period of § 1361b (4)";
}
relation bewegliche_sache_im_besitz_eines_ehegatten(ehe: Ehe, besitzer: Person, sache: de.bgb.core::Sache) kind empirical {
    label de official "Bewegliche Sache im Besitz eines oder beider Ehegatten (§ 1362 Abs. 1 Satz 1); Inhaber- und blankoindossierte Orderpapiere stehen ihnen gleich (Satz 3)";
    label en unofficial "movable thing in the possession of one or both spouses (§ 1362 (1) sentence 1); bearer and blank-endorsed order papers are treated alike (sentence 3)";
}
relation schuldner_eines_glaeubigers(ehe: Ehe, schuldner: Person) kind empirical {
    label de official "Ehegatte, dessen Gläubiger die Vermutung des § 1362 Abs. 1 für sich in Anspruch nimmt";
    label en unofficial "spouse whose creditor invokes the presumption of § 1362 (1)";
}
relation zum_persoenlichen_gebrauch_bestimmt(ehe: Ehe, p: Person, sache: de.bgb.core::Sache) kind empirical {
    label de official "Sache, die ausschließlich zum persönlichen Gebrauch eines Ehegatten bestimmt ist (§ 1362 Abs. 2)";
    label en unofficial "thing intended exclusively for the personal use of one spouse (§ 1362 (2))";
}
relation eigentum_des_anderen_ehegatten_nachgewiesen(ehe: Ehe, schuldner: Person, sache: de.bgb.core::Sache) kind empirical {
    label de official "Gegenbeweis zur Eigentumsvermutung des § 1362 Abs. 1 Satz 1 (ausdrückliche Angabe des Falls)";
    label en unofficial "rebuttal of the presumption of ownership of § 1362 (1) sentence 1 (explicit input)";
}

// --- Kanäle der Wertung (§47.3) --------------------------------------------------------------------

pub external judgment relation verlangen_als_missbrauch_oder_ehe_gescheitert(ehe: Ehe, verlangender: Person) {
    authority Court;
    label de official "§ 1353 Abs. 2. Das Verlangen nach Herstellung der Gemeinschaft stellt sich als Missbrauch des Rechts dar oder die Ehe ist gescheitert";
    label en unofficial "§ 1353 (2). The demand for restoration of the community amounts to an abuse of right, or the marriage has broken down";
}
pub external judgment relation geschaeft_angemessen_zur_deckung_des_lebensbedarfs(ehe: Ehe, handelnder: Person) {
    authority Court;
    label de official "§ 1357 Abs. 1 Satz 1. Das Geschäft dient der ANGEMESSENEN Deckung des Lebensbedarfs der Familie";
    label en unofficial "§ 1357 (1) sentence 1. The transaction serves the APPROPRIATE meeting of the family's living needs";
}
pub external judgment relation kein_ausreichender_grund_fuer_die_beschraenkung(ehe: Ehe, beschraenkender: Person) {
    authority Court;
    label de official "§ 1357 Abs. 2 Satz 1 Halbsatz 2. Für die Beschränkung oder Ausschließung besteht kein ausreichender Grund; das Familiengericht hat sie auf Antrag aufzuheben";
    label en unofficial "§ 1357 (2) sentence 1. There is no sufficient ground for the restriction; the family court must revoke it on application";
}
pub external judgment relation angemessener_unterhalt_der_familie(ehe: Ehe, betrag_angemessen: Money) {
    authority Court;
    label de official "§ 1360a Abs. 1. Der angemessene Unterhalt der Familie umfasst alles, was nach den Verhältnissen der Ehegatten erforderlich ist — die Höhe bestimmt das Gericht nach den Verhältnissen des Falls";
    label en unofficial "§ 1360a (1). Appropriate family maintenance covers everything required according to the spouses' circumstances — the amount is set by the court";
}
pub external judgment relation vorschuss_entspricht_der_billigkeit(ehe: Ehe, pflichtiger: Person, berechtigter: Person) {
    authority Court;
    label de official "§ 1360a Abs. 4 Satz 1. Der Vorschuss auf die Prozesskosten entspricht der Billigkeit";
    label en unofficial "§ 1360a (4) sentence 1. The advance on the costs of the proceedings is equitable";
}
pub external judgment relation trennungsunterhalt_angemessen(ehe: Ehe, berechtigter: Person, betrag: Money) {
    authority Court;
    label de official "§ 1361 Abs. 1 Satz 1. Der nach den Lebensverhältnissen und den Erwerbs- und Vermögensverhältnissen der Ehegatten angemessene Unterhalt";
    label en unofficial "§ 1361 (1) sentence 1. The maintenance appropriate to the standard of living and to the earning and property circumstances of the spouses";
}
pub external judgment relation erwerbstaetigkeit_kann_erwartet_werden(ehe: Ehe, berechtigter: Person) {
    authority Court;
    label de official "§ 1361 Abs. 2. Von dem nicht erwerbstätigen Ehegatten kann nach seinen persönlichen Verhältnissen und den wirtschaftlichen Verhältnissen beider Ehegatten erwartet werden, seinen Unterhalt durch eine Erwerbstätigkeit selbst zu verdienen";
    label en unofficial "§ 1361 (2). It can be expected of the non-employed spouse to earn his own maintenance";
}
pub external judgment relation ueberlassung_des_haushaltsgegenstands_billig(ehe: Ehe, verlangender: Person) {
    authority Court;
    label de official "§ 1361a Abs. 1 Satz 2, Abs. 2. Der andere Ehegatte benötigt den Gegenstand zur Führung eines abgesonderten Haushalts und die Überlassung entspricht der Billigkeit; gemeinsame Gegenstände werden nach Billigkeit verteilt";
    label en unofficial "§ 1361a (1) sentence 2, (2). The other spouse needs the object for a separate household and the transfer is equitable";
}
pub external judgment relation ueberlassung_der_ehewohnung_zur_vermeidung_unbilliger_haerte(ehe: Ehe, verlangender: Person) {
    authority Court;
    label de official "§ 1361b Abs. 1 Satz 1. Die Überlassung der Ehewohnung ist auch unter Berücksichtigung der Belange des anderen Ehegatten notwendig, um eine unbillige Härte zu vermeiden";
    label en unofficial "§ 1361b (1) sentence 1. The transfer of the matrimonial home is necessary to avoid inequitable hardship";
}
pub external judgment relation vorsaetzliche_verletzung_oder_drohung(ehe: Ehe, taeter: Person, verletzter: Person) {
    authority Court;
    label de official "§ 1361b Abs. 2 Satz 1. Der Ehegatte hat den anderen widerrechtlich und vorsätzlich am Körper, an der Gesundheit, der Freiheit oder der sexuellen Selbstbestimmung verletzt oder mit einer solchen Verletzung oder der Verletzung des Lebens widerrechtlich gedroht";
    label en unofficial "§ 1361b (2) sentence 1. The spouse unlawfully and intentionally injured the other or unlawfully threatened such injury";
}
pub external judgment relation keine_weiteren_verletzungen_zu_besorgen(ehe: Ehe, taeter: Person) {
    authority Court;
    label de official "§ 1361b Abs. 2 Satz 2. Es sind keine weiteren Verletzungen und widerrechtlichen Drohungen zu besorgen, und dem verletzten Ehegatten ist das weitere Zusammenleben zuzumuten";
    label en unofficial "§ 1361b (2) sentence 2. No further injuries or unlawful threats are to be feared and further cohabitation is reasonable for the injured spouse";
}

// --- Ergebnisse -------------------------------------------------------------------------------------

pub relation zur_ehelichen_lebensgemeinschaft_verpflichtet(ehe: Ehe, p: Person, anderer: Person) kind institutional {
    label de official "Die Ehegatten sind einander zur ehelichen Lebensgemeinschaft verpflichtet; sie tragen füreinander Verantwortung (§ 1353 Abs. 1 Satz 2)";
    label en unofficial "The spouses are mutually bound to matrimonial cohabitation; they bear responsibility for each other (§ 1353 (1) sentence 2)";
}
relation herstellungsverlangen_nicht_zu_folgen(ehe: Ehe, verpflichteter: Person) kind institutional {
    label de official "Ein Ehegatte ist nicht verpflichtet, dem Verlangen des anderen nach Herstellung der Gemeinschaft Folge zu leisten (§ 1353 Abs. 2)";
    label en unofficial "A spouse is not bound to comply with the other's demand for restoration of the community (§ 1353 (2))";
}
relation fuehrt_eigenen_namen_fort(ehe: Ehe, p: Person) kind institutional {
    label de official "Bestimmen die Ehegatten keinen Ehenamen, so führen sie ihre zur Zeit der Eheschließung geführten Namen auch nach der Eheschließung (§ 1355 Abs. 1 Satz 3)";
    label en unofficial "If the spouses determine no married name, they continue to bear the names they bore at the time of the marriage (§ 1355 (1) sentence 3)";
}
relation namenserklaerung_wirksam(ehe: Ehe, p: Person, gegenstand: Text) kind institutional {
    label de official "Die Erklärung über den Namen ist in der vorgeschriebenen Form abgegeben (§ 1355 Abs. 4, Abs. 5 Satz 2, § 1355a Abs. 3, § 1355b Abs. 2)";
    label en unofficial "The declaration on the name has been made in the prescribed form (§ 1355 (4), (5) sentence 2, § 1355a (3), § 1355b (2))";
}
relation begleitname_ausgeschlossen(ehe: Ehe, p: Person) kind institutional {
    label de official "Ein Begleitname ist ausgeschlossen, wenn der Ehename aus mehreren Namen besteht (§ 1355a Abs. 2), und nach einem Widerruf ist eine erneute Erklärung nicht zulässig (Abs. 4 Satz 3)";
    label en unofficial "An accompanying name is excluded where the married name consists of several names (§ 1355a (2)); after revocation a renewed declaration is inadmissible ((4) sentence 3)";
}
relation haushaltsleitung_in_eigener_verantwortung(ehe: Ehe, p: Person) kind institutional {
    label de official "Ist die Haushaltsführung einem der Ehegatten überlassen, so leitet dieser den Haushalt in eigener Verantwortung (§ 1356 Abs. 1 Satz 2)";
    label en unofficial "Where the running of the household is left to one spouse, he runs it on his own responsibility (§ 1356 (1) sentence 2)";
}
relation zur_erwerbstaetigkeit_berechtigt(ehe: Ehe, p: Person) kind institutional {
    label de official "Beide Ehegatten sind berechtigt, erwerbstätig zu sein; bei Wahl und Ausübung ist die gebotene Rücksicht zu nehmen (§ 1356 Abs. 2)";
    label en unofficial "Both spouses are entitled to be gainfully employed; due regard is to be had in choosing and pursuing it (§ 1356 (2))";
}
pub relation mitverpflichtet_aus_dem_geschaeft(ehe: Ehe, mitverpflichteter: Person, handelnder: Person) kind institutional {
    label de official "Durch Geschäfte zur angemessenen Deckung des Lebensbedarfs der Familie werden BEIDE Ehegatten berechtigt und verpflichtet (§ 1357 Abs. 1)";
    label en unofficial "By transactions to meet the family's living needs BOTH spouses are entitled and obliged (§ 1357 (1))";
}
relation beschraenkung_aufzuheben(ehe: Ehe, beschraenkender: Person) kind institutional {
    label de official "Besteht für die Beschränkung oder Ausschließung kein ausreichender Grund, so hat das Familiengericht sie auf Antrag aufzuheben (§ 1357 Abs. 2 Satz 1 Halbsatz 2)";
    label en unofficial "If there is no sufficient ground for the restriction, the family court must revoke it on application (§ 1357 (2) sentence 1)";
}
relation beschraenkung_wirkt_gegen_dritte(ehe: Ehe, beschraenkter: Person) kind institutional {
    label de official "Dritten gegenüber wirkt die Beschränkung oder Ausschließung nur nach Maßgabe des § 1412 (§ 1357 Abs. 2 Satz 2)";
    label en unofficial "As against third parties the restriction takes effect only under § 1412 (§ 1357 (2) sentence 2)";
}
pub relation vertretungsrecht_in_der_gesundheitssorge(ehe: Ehe, vertretender: Person, vertretener: Person) kind institutional {
    label de official "Der andere Ehegatte ist berechtigt, für den vertretenen Ehegatten in Angelegenheiten der Gesundheitssorge zu handeln (§ 1358 Abs. 1 Nr. 1 bis 4)";
    label en unofficial "The other spouse is entitled to act for the represented spouse in health-care matters (§ 1358 (1) nos. 1 to 4)";
}
relation schweigepflicht_entbunden(ehe: Ehe, vertretender: Person, vertretener: Person) kind institutional {
    label de official "Die behandelnden Ärzte sind gegenüber dem vertretenden Ehegatten von ihrer Schweigepflicht entbunden (§ 1358 Abs. 2 Satz 1)";
    label en unofficial "The treating physicians are released from their duty of confidentiality towards the representing spouse (§ 1358 (2) sentence 1)";
}
relation letzter_tag_der_vertretungsfrist(ehe: Ehe, vertretener: Person, tag: Date) kind institutional {
    label de official "Letzter Tag der Sechsmonatsfrist des § 1358 Abs. 3 Nr. 4, gerechnet vom ärztlich festgestellten Zeitpunkt an";
    label en unofficial "Last day of the six-month period of § 1358 (3) no. 4, counted from the point in time established by the physician";
}
relation haftung_nur_fuer_eigenuebliche_sorgfalt(ehe: Ehe, p: Person) kind institutional {
    label de official "Die Ehegatten haben bei der Erfüllung der sich aus dem ehelichen Verhältnis ergebenden Verpflichtungen einander nur für diejenige Sorgfalt einzustehen, welche sie in eigenen Angelegenheiten anzuwenden pflegen (§ 1359)";
    label en unofficial "In performing obligations arising from the marital relationship the spouses are answerable to each other only for the care they customarily apply in their own affairs (§ 1359)";
}
pub relation zum_familienunterhalt_verpflichtet(ehe: Ehe, pflichtiger: Person, berechtigter: Person) kind institutional {
    label de official "Die Ehegatten sind einander verpflichtet, durch ihre Arbeit und mit ihrem Vermögen die Familie angemessen zu unterhalten (§ 1360 Satz 1)";
    label en unofficial "The spouses are mutually bound to maintain the family appropriately by their work and with their assets (§ 1360 sentence 1)";
}
relation unterhaltspflicht_durch_haushaltsfuehrung_erfuellt(ehe: Ehe, p: Person) kind institutional {
    label de official "Ist einem Ehegatten die Haushaltsführung überlassen, so erfüllt er seine Verpflichtung, durch Arbeit zum Unterhalt der Familie beizutragen, in der Regel durch die Führung des Haushalts (§ 1360 Satz 2)";
    label en unofficial "Where the running of the household is left to a spouse, he as a rule fulfils his duty to contribute by work through running the household (§ 1360 sentence 2)";
}
relation unterhalt_im_voraus_zur_verfuegung_zu_stellen(ehe: Ehe, pflichtiger: Person) kind institutional {
    label de official "Die Ehegatten sind einander verpflichtet, die zum gemeinsamen Unterhalt der Familie erforderlichen Mittel für einen angemessenen Zeitraum IM VORAUS zur Verfügung zu stellen (§ 1360a Abs. 2 Satz 2)";
    label en unofficial "The spouses must make available IN ADVANCE the means required for the family's joint maintenance for an appropriate period (§ 1360a (2) sentence 2)";
}
relation vorschriften_1613_bis_1615_anwendbar(ehe: Ehe) kind institutional {
    label de official "Die für die Unterhaltspflicht der Verwandten geltenden Vorschriften der §§ 1613 bis 1615 (de.bgb.verwandtschaft) sind entsprechend anzuwenden (§ 1360a Abs. 3)";
    label en unofficial "The provisions of §§ 1613 to 1615 on relatives' maintenance apply mutatis mutandis (§ 1360a (3))";
}
relation prozesskostenvorschuss_geschuldet(ehe: Ehe, pflichtiger: Person, berechtigter: Person) kind institutional {
    label de official "Der andere Ehegatte ist verpflichtet, die Kosten eines Rechtsstreits oder der Verteidigung in einem Strafverfahren vorzuschießen, soweit dies der Billigkeit entspricht (§ 1360a Abs. 4)";
    label en unofficial "The other spouse must advance the costs of proceedings or of a criminal defence in so far as equitable (§ 1360a (4))";
}
relation kein_ersatz_fuer_zuvielleistung(ehe: Ehe, leistender: Person) kind institutional {
    label de official "Leistet ein Ehegatte zum Unterhalt der Familie einen höheren Beitrag als ihm obliegt, so ist im Zweifel anzunehmen, dass er nicht beabsichtigt, Ersatz zu verlangen (§ 1360b)";
    label en unofficial "If a spouse contributes more than he owes, it is presumed in case of doubt that he does not intend to claim reimbursement (§ 1360b)";
}
pub relation trennungsunterhalt_geschuldet(ehe: Ehe, pflichtiger: Person, berechtigter: Person, betrag: Money) kind institutional {
    label de official "Leben die Ehegatten getrennt, so kann ein Ehegatte von dem anderen den angemessenen Unterhalt verlangen (§ 1361 Abs. 1 Satz 1)";
    label en unofficial "Where the spouses live apart, a spouse may demand appropriate maintenance from the other (§ 1361 (1) sentence 1)";
}
relation altersvorsorgekosten_gehoeren_zum_trennungsunterhalt(ehe: Ehe, berechtigter: Person) kind institutional {
    label de official "Ist ein Scheidungsverfahren rechtshängig, so gehören zum Unterhalt vom Eintritt der Rechtshängigkeit an auch die Kosten einer angemessenen Versicherung für den Fall des Alters sowie der verminderten Erwerbsfähigkeit (§ 1361 Abs. 1 Satz 2)";
    label en unofficial "Once divorce proceedings are pending, maintenance also covers the costs of appropriate old-age and disability insurance (§ 1361 (1) sentence 2)";
}
relation auf_eigene_erwerbstaetigkeit_verweisbar(ehe: Ehe, berechtigter: Person) kind institutional {
    label de official "Der nicht erwerbstätige Ehegatte kann darauf verwiesen werden, seinen Unterhalt durch eine Erwerbstätigkeit selbst zu verdienen (§ 1361 Abs. 2)";
    label en unofficial "The non-employed spouse may be referred to earning his own maintenance (§ 1361 (2))";
}
relation trennungsunterhalt_monatlich_im_voraus(ehe: Ehe, pflichtiger: Person) kind institutional {
    label de official "Der laufende Unterhalt ist durch Zahlung einer Geldrente zu gewähren; die Rente ist monatlich im Voraus zu zahlen, und der volle Monatsbetrag ist auch dann geschuldet, wenn der Berechtigte im Laufe des Monats stirbt (§ 1361 Abs. 4 Sätze 1 bis 3)";
    label en unofficial "Current maintenance is to be paid as a money annuity monthly in advance; the full monthly amount is owed even if the entitled person dies during the month (§ 1361 (4))";
}
relation herausgabe_des_haushaltsgegenstands(ehe: Ehe, verlangender: Person, sache: de.bgb.core::Sache) kind institutional {
    label de official "Leben die Ehegatten getrennt, so kann jeder von ihnen die ihm gehörenden Haushaltsgegenstände von dem anderen herausverlangen (§ 1361a Abs. 1 Satz 1)";
    label en unofficial "Where the spouses live apart, each may demand from the other the household objects belonging to him (§ 1361a (1) sentence 1)";
}
relation ueberlassung_zum_gebrauch(ehe: Ehe, verpflichteter: Person, beguenstigter: Person, sache: de.bgb.core::Sache) kind institutional {
    label de official "Der Eigentümer ist verpflichtet, den Gegenstand dem anderen Ehegatten zum Gebrauch zu überlassen, soweit dieser ihn zur Führung eines abgesonderten Haushalts benötigt und die Überlassung der Billigkeit entspricht (§ 1361a Abs. 1 Satz 2); gemeinsame Gegenstände werden nach Billigkeit verteilt (Abs. 2)";
    label en unofficial "The owner must leave the object to the other spouse for use in so far as needed for a separate household and equitable (§ 1361a (1) sentence 2, (2))";
}
relation eigentumsverhaeltnisse_unberuehrt(ehe: Ehe) kind institutional {
    label de official "Die Eigentumsverhältnisse bleiben unberührt, sofern die Ehegatten nichts anderes vereinbaren (§ 1361a Abs. 4)";
    label en unofficial "The ownership relations remain unaffected unless the spouses agree otherwise (§ 1361a (4))";
}
relation ehewohnung_zur_alleinigen_benutzung_zu_ueberlassen(ehe: Ehe, verpflichteter: Person, beguenstigter: Person) kind institutional {
    label de official "Ein Ehegatte kann verlangen, dass ihm der andere die Ehewohnung oder einen Teil zur alleinigen Benutzung überlässt (§ 1361b Abs. 1 Satz 1); bei vorsätzlicher Verletzung ist in der Regel die GESAMTE Wohnung zu überlassen (Abs. 2 Satz 1)";
    label en unofficial "A spouse may demand that the other leave him the matrimonial home or part of it for sole use (§ 1361b (1) sentence 1); after intentional injury, as a rule the WHOLE home ((2) sentence 1)";
}
relation nutzungsrecht_nicht_zu_vereiteln(ehe: Ehe, verpflichteter: Person) kind institutional {
    label de official "Der andere hat alles zu unterlassen, was geeignet ist, die Ausübung des Nutzungsrechts zu erschweren oder zu vereiteln (§ 1361b Abs. 3 Satz 1)";
    label en unofficial "The other must refrain from anything apt to impede or frustrate the exercise of the right of use (§ 1361b (3) sentence 1)";
}
relation alleiniges_nutzungsrecht_unwiderleglich_ueberlassen(ehe: Ehe, ausgezogener: Person) kind institutional {
    label de official "Hat der ausgezogene Ehegatte binnen sechs Monaten nach seinem Auszug eine ernstliche Rückkehrabsicht nicht bekundet, so wird UNWIDERLEGLICH vermutet, dass er dem verbliebenen Ehegatten das alleinige Nutzungsrecht überlassen hat (§ 1361b Abs. 4)";
    label en unofficial "If the spouse who moved out has not declared a serious intention to return within six months, it is IRREBUTTABLY presumed that he left the sole right of use to the other (§ 1361b (4))";
}
pub relation eigentum_des_schuldners_vermutet(ehe: Ehe, schuldner: Person, sache: de.bgb.core::Sache) kind institutional {
    label de official "Zugunsten der Gläubiger eines der Ehegatten wird vermutet, dass die im Besitz eines oder beider Ehegatten befindlichen beweglichen Sachen dem Schuldner gehören (§ 1362 Abs. 1 Satz 1)";
    label en unofficial "In favour of the creditors of one spouse it is presumed that the movable things in the possession of one or both belong to the debtor (§ 1362 (1) sentence 1)";
}
relation vermutung_des_1362_ausgeschlossen(ehe: Ehe, schuldner: Person, sache: de.bgb.core::Sache) kind institutional {
    label de official "Die Eigentumsvermutung des § 1362 Abs. 1 Satz 1 gilt nicht: die Ehegatten leben getrennt und die Sache befindet sich im Besitz des Ehegatten, der nicht Schuldner ist (§ 1362 Abs. 1 Satz 2)";
    label en unofficial "The presumption of ownership of § 1362 (1) sentence 1 does not apply: the spouses live apart and the thing is possessed by the non-debtor spouse ((1) sentence 2)";
}
pub relation eigentum_des_gebrauchers_vermutet(ehe: Ehe, p: Person, sache: de.bgb.core::Sache) kind institutional {
    label de official "Für die ausschließlich zum persönlichen Gebrauch eines Ehegatten bestimmten Sachen wird vermutet, dass sie dem Ehegatten gehören, für dessen Gebrauch sie bestimmt sind (§ 1362 Abs. 2)";
    label en unofficial "Things intended exclusively for the personal use of one spouse are presumed to belong to that spouse (§ 1362 (2))";
}

// --- Regeln -------------------------------------------------------------------------------------------

@source(BGB_P1353) {
    rule EhelicheLebensgemeinschaft(ehe: Ehe, a: Person, b: Person) strict {
        label de official "Die Ehegatten sind einander zur ehelichen Lebensgemeinschaft verpflichtet; sie tragen füreinander Verantwortung (§ 1353 Abs. 1 Satz 2)";
        label en unofficial "The spouses are mutually bound to matrimonial cohabitation; they bear responsibility for each other (§ 1353 (1) sentence 2)";
        when ehegatte(ehe, a) and anderer_ehegatte(ehe, a, b);
        then zur_ehelichen_lebensgemeinschaft_verpflichtet(ehe, a, b);
    }
    rule KeineFolgepflichtBeiMissbrauchOderScheitern(ehe: Ehe, verlangender: Person, verpflichteter: Person) strict {
        label de official "Ein Ehegatte ist nicht verpflichtet, dem Verlangen des anderen nach Herstellung der Gemeinschaft Folge zu leisten, wenn sich das Verlangen als Missbrauch seines Rechts darstellt oder wenn die Ehe gescheitert ist (§ 1353 Abs. 2)";
        label en unofficial "A spouse need not comply with the demand for restoration where it amounts to an abuse of right or where the marriage has broken down (§ 1353 (2))";
        when herstellung_der_gemeinschaft_verlangt(ehe, verlangender)
         and verlangen_als_missbrauch_oder_ehe_gescheitert(ehe, verlangender)
         and anderer_ehegatte(ehe, verlangender, verpflichteter);
        then herstellungsverlangen_nicht_zu_folgen(ehe, verpflichteter);
    }
}

@source(BGB_P1355) {
    rule KeinEhenameKeinNamenswechsel(ehe: Ehe, p: Person) strict {
        label de official "Bestimmen die Ehegatten keinen Ehenamen, so führen sie ihre zur Zeit der Eheschließung geführten Namen auch nach der Eheschließung (§ 1355 Abs. 1 Satz 3)";
        label en unofficial "If no married name is determined, the spouses continue to bear the names borne at the time of the marriage (§ 1355 (1) sentence 3)";
        when ehegatte(ehe, p) and not_known(ehename_bestimmt(ehe));
        then fuehrt_eigenen_namen_fort(ehe, p);
    }
    rule EhenamenserklaerungBeiDerEheschliessung(ehe: Ehe, p: Person) strict {
        label de official "Die Bestimmung des Ehenamens SOLL bei der Eheschließung erfolgen (§ 1355 Abs. 4 Satz 1): dann bedarf sie keiner öffentlichen Beglaubigung";
        label en unofficial "The determination of the married name SHOULD be made at the marriage ceremony (§ 1355 (4) sentence 1): no public certification is then required";
        when ehename_bestimmt(ehe) and erklaerung_bei_der_eheschliessung_abgegeben(ehe, p);
        then namenserklaerung_wirksam(ehe, p, "§ 1355 Abs. 2: Bestimmung des Ehenamens");
    }
    rule SpaetereEhenamenserklaerungBedarfDerBeglaubigung(ehe: Ehe, p: Person) strict {
        label de official "Wird die Erklärung später abgegeben, so muss sie öffentlich beglaubigt werden (§ 1355 Abs. 4 Satz 2); dasselbe gilt für die Erklärung des verwitweten oder geschiedenen Ehegatten (Abs. 5 Satz 2)";
        label en unofficial "If the declaration is made later, it must be publicly certified (§ 1355 (4) sentence 2; (5) sentence 2)";
        when ehename_bestimmt(ehe) and erklaerung_oeffentlich_beglaubigt(ehe, p)
         and not_known(erklaerung_bei_der_eheschliessung_abgegeben(ehe, p));
        then namenserklaerung_wirksam(ehe, p, "§ 1355 Abs. 4 Satz 2: spätere Erklärung mit öffentlicher Beglaubigung");
    }
}

@source(BGB_P1355a) {
    rule BegleitnameWirksamErklaert(ehe: Ehe, p: Person) strict {
        label de official "Der Ehegatte, dessen Name nicht Ehename wird, kann dem Ehenamen einen Begleitnamen voranstellen oder anfügen (§ 1355a Abs. 1 Satz 1); dies gilt nicht, wenn der Ehename aus mehreren Namen besteht (Abs. 2), und nach einem Widerruf ist eine erneute Erklärung nicht zulässig (Abs. 4 Satz 3)";
        label en unofficial "The spouse whose name does not become the married name may add an accompanying name (§ 1355a (1) sentence 1); not so where the married name consists of several names ((2)), and after revocation no renewed declaration is admissible ((4) sentence 3)";
        when begleitname_erklaert(ehe, p) and not_known(ehename_besteht_aus_mehreren_namen(ehe))
         and not_known(begleitname_widerrufen(ehe, p));
        then namenserklaerung_wirksam(ehe, p, "§ 1355a Abs. 1: Begleitname");
    }
    rule BegleitnameBeiMehrgliedrigemEhenamenAusgeschlossen(ehe: Ehe, p: Person) strict {
        label de official "Absatz 1 gilt nicht, wenn der Ehename aus mehreren Namen besteht (§ 1355a Abs. 2)";
        label en unofficial "Subsection (1) does not apply where the married name consists of several names (§ 1355a (2))";
        when begleitname_erklaert(ehe, p) and ehename_besteht_aus_mehreren_namen(ehe);
        then begleitname_ausgeschlossen(ehe, p);
    }
    rule ErneuteErklaerungNachWiderrufUnzulaessig(ehe: Ehe, p: Person) strict {
        label de official "Im Fall des Widerrufs ist eine erneute Erklärung nach Absatz 1 Satz 1 nicht zulässig (§ 1355a Abs. 4 Satz 3)";
        label en unofficial "In case of revocation a renewed declaration under (1) sentence 1 is inadmissible (§ 1355a (4) sentence 3)";
        when begleitname_widerrufen(ehe, p) and erneute_erklaerung_begleitname(ehe, p);
        then begleitname_ausgeschlossen(ehe, p);
    }
}

@source(BGB_P1355b) {
    rule GeschlechtsangepassteForm(ehe: Ehe, p: Person) strict {
        label de official "Jeder Ehegatte kann bestimmen, dass er den Ehenamen in einer seinem Geschlecht angepassten Form führt, wenn eine der Voraussetzungen des § 1355b Abs. 1 Nr. 1 bis 3 erfüllt ist; nach einem Widerruf ist eine erneute Erklärung nicht zulässig (Abs. 3 Satz 3)";
        label en unofficial "Each spouse may declare that he bears the married name in a form adapted to his gender under § 1355b (1) nos. 1 to 3; after revocation a renewed declaration is inadmissible ((3) sentence 3)";
        when geschlechtsangepasste_form_erklaert(ehe, p) and voraussetzung_der_anpassung_erfuellt(ehe, p)
         and not_known(anpassung_widerrufen(ehe, p));
        then namenserklaerung_wirksam(ehe, p, "§ 1355b Abs. 1: geschlechtsangepasste Form des Ehenamens");
    }
}

@source(BGB_P1356) {
    rule HaushaltsleitungInEigenerVerantwortung(ehe: Ehe, p: Person) strict {
        label de official "Ist die Haushaltsführung einem der Ehegatten überlassen, so leitet dieser den Haushalt in eigener Verantwortung (§ 1356 Abs. 1 Satz 2)";
        label en unofficial "Where the household is left to one spouse, he runs it on his own responsibility (§ 1356 (1) sentence 2)";
        when haushaltsfuehrung_ueberlassen(ehe, p);
        then haushaltsleitung_in_eigener_verantwortung(ehe, p);
    }
    rule BeideZurErwerbstaetigkeitBerechtigt(ehe: Ehe, p: Person) strict {
        label de official "Beide Ehegatten sind berechtigt, erwerbstätig zu sein (§ 1356 Abs. 2 Satz 1)";
        label en unofficial "Both spouses are entitled to be gainfully employed (§ 1356 (2) sentence 1)";
        when ehegatte(ehe, p);
        then zur_erwerbstaetigkeit_berechtigt(ehe, p);
    }
}

@source(BGB_P1357) {
    rule MitverpflichtungAusSchluesselgewalt(ehe: Ehe, handelnder: Person, anderer: Person) strict {
        label de official "Jeder Ehegatte ist berechtigt, Geschäfte zur angemessenen Deckung des Lebensbedarfs der Familie mit Wirkung auch für den anderen Ehegatten zu besorgen; durch solche Geschäfte werden beide Ehegatten berechtigt und verpflichtet, es sei denn, dass sich aus den Umständen etwas anderes ergibt (§ 1357 Abs. 1); Absatz 1 gilt nicht, wenn die Ehegatten getrennt leben (Abs. 3)";
        label en unofficial "Each spouse may transact business to meet the family's living needs with effect also for the other; both are then entitled and obliged unless the circumstances indicate otherwise (§ 1357 (1)); (1) does not apply where the spouses live apart ((3))";
        when geschaeft_zur_deckung_des_lebensbedarfs(ehe, handelnder)
         and geschaeft_angemessen_zur_deckung_des_lebensbedarfs(ehe, handelnder)
         and anderer_ehegatte(ehe, handelnder, anderer)
         and not_known(aus_den_umstaenden_ergibt_sich_anderes(ehe, handelnder))
         and not_known(getrennt_lebend(ehe))
         and not_known(beschraenkung_der_berechtigung(ehe, anderer, handelnder));
        then mitverpflichtet_aus_dem_geschaeft(ehe, anderer, handelnder);
    }
    rule BeschraenkungAufzuheben(ehe: Ehe, beschraenkender: Person, beschraenkter: Person) strict {
        label de official "Besteht für die Beschränkung oder Ausschließung kein ausreichender Grund, so hat das Familiengericht sie auf Antrag aufzuheben (§ 1357 Abs. 2 Satz 1 Halbsatz 2)";
        label en unofficial "If there is no sufficient ground for the restriction, the family court must revoke it on application (§ 1357 (2) sentence 1)";
        when beschraenkung_der_berechtigung(ehe, beschraenkender, beschraenkter)
         and kein_ausreichender_grund_fuer_die_beschraenkung(ehe, beschraenkender);
        then beschraenkung_aufzuheben(ehe, beschraenkender);
    }
    rule BeschraenkungGegenueberDritten(ehe: Ehe, beschraenkender: Person, beschraenkter: Person) strict {
        label de official "Dritten gegenüber wirkt die Beschränkung oder Ausschließung nur nach Maßgabe des § 1412 (§ 1357 Abs. 2 Satz 2)";
        label en unofficial "As against third parties the restriction takes effect only under § 1412 (§ 1357 (2) sentence 2)";
        when beschraenkung_der_berechtigung(ehe, beschraenkender, beschraenkter)
         and eintragung_im_gueterrechtsregister(ehe);
        then beschraenkung_wirkt_gegen_dritte(ehe, beschraenkter);
    }
}

@source(BGB_P1358) {
    rule VertretungInDerGesundheitssorge(ehe: Ehe, vertretender: Person, vertretener: Person) strict {
        label de official "Kann ein Ehegatte aufgrund von Bewusstlosigkeit oder Krankheit seine Angelegenheiten der Gesundheitssorge rechtlich nicht besorgen, ist der andere Ehegatte berechtigt, für ihn zu handeln (§ 1358 Abs. 1 Nr. 1 bis 4); die Berechtigung besteht nicht in den Fällen des Absatzes 3 Nr. 1 bis 3";
        label en unofficial "Where a spouse cannot legally attend to his health-care affairs, the other may act for him (§ 1358 (1)); not in the cases of (3) nos. 1 to 3";
        when gesundheitssorge_rechtlich_nicht_besorgbar(ehe, vertretener)
         and anderer_ehegatte(ehe, vertretener, vertretender)
         and not_known(getrennt_lebend(ehe))
         and not_known(vertretung_abgelehnt_oder_bevollmaechtigt(ehe, vertretener))
         and not_known(betreuer_mit_gesundheitssorge_bestellt(ehe, vertretener));
        then vertretungsrecht_in_der_gesundheitssorge(ehe, vertretender, vertretener);
    }
    rule SchweigepflichtEntbunden(ehe: Ehe, vertretender: Person, vertretener: Person) strict {
        label de official "Unter den Voraussetzungen des Absatzes 1 sind behandelnde Ärzte gegenüber dem vertretenden Ehegatten von ihrer Schweigepflicht entbunden (§ 1358 Abs. 2 Satz 1)";
        label en unofficial "Under the conditions of (1) the treating physicians are released from confidentiality towards the representing spouse (§ 1358 (2) sentence 1)";
        when vertretungsrecht_in_der_gesundheitssorge(ehe, vertretender, vertretener);
        then schweigepflicht_entbunden(ehe, vertretender, vertretener);
    }
    rule VertretungsfristEreignis(ehe: Ehe, vertretener: Person, f: Frist, t: Date) strict {
        label de official "Die Frist des § 1358 Abs. 3 Nr. 4 läuft von dem durch den Arzt festgestellten Zeitpunkt an (Abs. 4 Satz 1 Nr. 1)";
        label en unofficial "The period of § 1358 (3) no. 4 runs from the point in time established by the physician ((4) sentence 1 no. 1)";
        when vertretungsfrist_1358(ehe, vertretener, f) and aerztliche_bestaetigung_am(ehe, vertretener, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
    rule VertretungsfristDauer(ehe: Ehe, vertretener: Person, f: Frist) strict {
        label de official "Die Berechtigungen bestehen nicht, wenn mehr als SECHS MONATE seit dem festgestellten Zeitpunkt vergangen sind (§ 1358 Abs. 3 Nr. 4)";
        label en unofficial "The powers do not exist once more than SIX MONTHS have passed since the established point in time (§ 1358 (3) no. 4)";
        when vertretungsfrist_1358(ehe, vertretener, f);
        then de.bgb.fristen::frist_dauer_kalender(f, 6 calendar_month);
    }
    rule LetzterTagDerVertretungsfrist(ehe: Ehe, vertretener: Person, f: Frist, e: Date) strict {
        label de official "Letzter Tag der Sechsmonatsfrist des § 1358 Abs. 3 Nr. 4: die Frist misst VERSTRICHENE ZEIT und wird nicht nach § 193 verlegt";
        label en unofficial "Last day of the six-month period of § 1358 (3) no. 4: the period measures ELAPSED TIME and is not rolled under § 193";
        when vertretungsfrist_1358(ehe, vertretener, f) and de.bgb.fristen::frist_ende_kalender(f, e);
        then letzter_tag_der_vertretungsfrist(ehe, vertretener, e);
    }
}

@source(BGB_P1359)
rule EigenuebicheSorgfalt(ehe: Ehe, p: Person) strict {
    label de official "Die Ehegatten haben bei der Erfüllung der sich aus dem ehelichen Verhältnis ergebenden Verpflichtungen einander nur für diejenige Sorgfalt einzustehen, welche sie in eigenen Angelegenheiten anzuwenden pflegen (§ 1359)";
    label en unofficial "In performing obligations arising from the marital relationship the spouses answer to each other only for the care customary in their own affairs (§ 1359)";
    when pflichtverletzung_aus_dem_ehelichen_verhaeltnis(ehe, p)
     and sorgfalt_in_eigenen_angelegenheiten_beachtet(ehe, p);
    then haftung_nur_fuer_eigenuebliche_sorgfalt(ehe, p);
}

@source(BGB_P1360) {
    rule FamilienunterhaltVerpflichtung(ehe: Ehe, a: Person, b: Person) strict {
        label de official "Die Ehegatten sind einander verpflichtet, durch ihre Arbeit und mit ihrem Vermögen die Familie angemessen zu unterhalten (§ 1360 Satz 1)";
        label en unofficial "The spouses are mutually bound to maintain the family appropriately by their work and assets (§ 1360 sentence 1)";
        when ehegatte(ehe, a) and anderer_ehegatte(ehe, a, b) and not_known(getrennt_lebend(ehe));
        then zum_familienunterhalt_verpflichtet(ehe, a, b);
    }
    rule HaushaltsfuehrungErfuelltDieUnterhaltspflicht(ehe: Ehe, p: Person) strict {
        label de official "Ist einem Ehegatten die Haushaltsführung überlassen, so erfüllt er seine Verpflichtung, durch Arbeit zum Unterhalt der Familie beizutragen, in der Regel durch die Führung des Haushalts (§ 1360 Satz 2)";
        label en unofficial "Where the household is left to a spouse, he as a rule fulfils his duty to contribute by work through running it (§ 1360 sentence 2)";
        when haushaltsfuehrung_ueberlassen(ehe, p);
        then unterhaltspflicht_durch_haushaltsfuehrung_erfuellt(ehe, p);
    }
}

@source(BGB_P1360a) {
    rule UnterhaltImVoraus(ehe: Ehe, a: Person, b: Person) strict {
        label de official "Die Ehegatten sind einander verpflichtet, die zum gemeinsamen Unterhalt der Familie erforderlichen Mittel für einen angemessenen Zeitraum im Voraus zur Verfügung zu stellen (§ 1360a Abs. 2 Satz 2)";
        label en unofficial "The spouses must make available in advance the means required for the family's joint maintenance (§ 1360a (2) sentence 2)";
        when zum_familienunterhalt_verpflichtet(ehe, a, b);
        then unterhalt_im_voraus_zur_verfuegung_zu_stellen(ehe, a);
    }
    rule Verweisung1613Bis1615(ehe: Ehe, a: Person, b: Person) strict {
        label de official "Die für die Unterhaltspflicht der Verwandten geltenden Vorschriften der §§ 1613 bis 1615 sind entsprechend anzuwenden (§ 1360a Abs. 3); sie stehen in `de.bgb.verwandtschaft` und werden hier nicht nachgebaut";
        label en unofficial "§§ 1613 to 1615 on relatives' maintenance apply mutatis mutandis (§ 1360a (3)); they live in `de.bgb.verwandtschaft` and are not rebuilt here";
        when zum_familienunterhalt_verpflichtet(ehe, a, b);
        then vorschriften_1613_bis_1615_anwendbar(ehe);
    }
    rule Prozesskostenvorschuss(ehe: Ehe, berechtigter: Person, pflichtiger: Person) strict {
        label de official "Ist ein Ehegatte nicht in der Lage, die Kosten eines Rechtsstreits zu tragen, der eine persönliche Angelegenheit betrifft, so ist der andere Ehegatte verpflichtet, ihm diese Kosten vorzuschießen, soweit dies der Billigkeit entspricht; das Gleiche gilt für die Kosten der Verteidigung in einem Strafverfahren (§ 1360a Abs. 4)";
        label en unofficial "Where a spouse cannot bear the costs of proceedings in a personal matter, the other must advance them in so far as equitable (§ 1360a (4))";
        when kosten_eines_rechtsstreits_nicht_tragbar(ehe, berechtigter)
         and anderer_ehegatte(ehe, berechtigter, pflichtiger)
         and vorschuss_entspricht_der_billigkeit(ehe, pflichtiger, berechtigter);
        then prozesskostenvorschuss_geschuldet(ehe, pflichtiger, berechtigter);
    }
}

@source(BGB_P1360b) {
    presumption ZuvielleistungOhneErsatzabsicht(ehe: Ehe, leistender: Person) {
        label de official "Leistet ein Ehegatte zum Unterhalt der Familie einen höheren Beitrag als ihm obliegt, so ist im Zweifel anzunehmen, dass er nicht beabsichtigt, von dem anderen Ehegatten Ersatz zu verlangen (§ 1360b)";
        label en unofficial "If a spouse contributes more than he owes, it is presumed in case of doubt that he does not intend to claim reimbursement (§ 1360b)";
        when hoeherer_beitrag_zum_familienunterhalt(ehe, leistender);
        presume kein_ersatz_fuer_zuvielleistung(ehe, leistender);
        unless ersatz_ausdruecklich_vorbehalten(ehe, leistender);
    }
}

@source(BGB_P1361) {
    rule TrennungsunterhaltGeschuldet(ehe: Ehe, berechtigter: Person, pflichtiger: Person, betrag: Money) strict {
        label de official "Leben die Ehegatten getrennt, so kann ein Ehegatte von dem anderen den nach den Lebensverhältnissen und den Erwerbs- und Vermögensverhältnissen der Ehegatten angemessenen Unterhalt verlangen (§ 1361 Abs. 1 Satz 1)";
        label en unofficial "Where the spouses live apart, a spouse may demand from the other the maintenance appropriate to their circumstances (§ 1361 (1) sentence 1)";
        when getrennt_lebend(ehe) and trennungsunterhalt_angemessen(ehe, berechtigter, betrag)
         and anderer_ehegatte(ehe, berechtigter, pflichtiger);
        then trennungsunterhalt_geschuldet(ehe, pflichtiger, berechtigter, betrag);
    }
    rule AltersvorsorgeAbRechtshaengigkeit(ehe: Ehe, berechtigter: Person, pflichtiger: Person, betrag: Money, rh: Date) strict {
        label de official "Ist zwischen den getrennt lebenden Ehegatten ein Scheidungsverfahren rechtshängig, so gehören zum Unterhalt vom Eintritt der Rechtshängigkeit an auch die Kosten einer angemessenen Versicherung für den Fall des Alters sowie der verminderten Erwerbsfähigkeit (§ 1361 Abs. 1 Satz 2)";
        label en unofficial "Once the divorce proceedings are pending, maintenance also covers appropriate old-age and reduced-capacity insurance (§ 1361 (1) sentence 2)";
        when trennungsunterhalt_geschuldet(ehe, pflichtiger, berechtigter, betrag)
         and scheidungsverfahren_rechtshaengig_seit(ehe, rh);
        then altersvorsorgekosten_gehoeren_zum_trennungsunterhalt(ehe, berechtigter);
    }
    rule VerweisungAufEigeneErwerbstaetigkeit(ehe: Ehe, berechtigter: Person) strict {
        label de official "Der nicht erwerbstätige Ehegatte kann nur dann darauf verwiesen werden, seinen Unterhalt durch eine Erwerbstätigkeit selbst zu verdienen, wenn dies von ihm nach seinen persönlichen und den wirtschaftlichen Verhältnissen beider Ehegatten erwartet werden kann (§ 1361 Abs. 2)";
        label en unofficial "The non-employed spouse may be referred to earning his own maintenance only where this can be expected of him (§ 1361 (2))";
        when getrennt_lebend(ehe) and nicht_erwerbstaetiger_ehegatte(ehe, berechtigter)
         and erwerbstaetigkeit_kann_erwartet_werden(ehe, berechtigter);
        then auf_eigene_erwerbstaetigkeit_verweisbar(ehe, berechtigter);
    }
    rule GeldrenteMonatlichImVoraus(ehe: Ehe, pflichtiger: Person, berechtigter: Person, betrag: Money) strict {
        label de official "Der laufende Unterhalt ist durch Zahlung einer Geldrente zu gewähren; die Rente ist monatlich im Voraus zu zahlen; der Verpflichtete schuldet den vollen Monatsbetrag auch dann, wenn der Berechtigte im Laufe des Monats stirbt (§ 1361 Abs. 4 Sätze 1 bis 3)";
        label en unofficial "Current maintenance is paid as a money annuity monthly in advance; the full monthly amount is owed even if the entitled person dies during the month (§ 1361 (4))";
        when trennungsunterhalt_geschuldet(ehe, pflichtiger, berechtigter, betrag);
        then trennungsunterhalt_monatlich_im_voraus(ehe, pflichtiger);
    }
}

@source(BGB_P1361a) {
    rule HerausgabeDerEigenenHaushaltsgegenstaende(ehe: Ehe, eigentuemer: Person, s: de.bgb.core::Sache) strict {
        label de official "Leben die Ehegatten getrennt, so kann jeder von ihnen die ihm gehörenden Haushaltsgegenstände von dem anderen Ehegatten herausverlangen (§ 1361a Abs. 1 Satz 1)";
        label en unofficial "Where the spouses live apart, each may demand from the other the household objects belonging to him (§ 1361a (1) sentence 1)";
        when getrennt_lebend(ehe) and haushaltsgegenstand_im_eigentum(ehe, eigentuemer, s);
        then herausgabe_des_haushaltsgegenstands(ehe, eigentuemer, s);
    }
    rule UeberlassungZumGebrauch(ehe: Ehe, eigentuemer: Person, beguenstigter: Person, s: de.bgb.core::Sache) strict {
        label de official "Der Eigentümer ist jedoch verpflichtet, den Gegenstand dem anderen Ehegatten zum Gebrauch zu überlassen, soweit dieser ihn zur Führung eines abgesonderten Haushalts benötigt und die Überlassung nach den Umständen des Falles der Billigkeit entspricht (§ 1361a Abs. 1 Satz 2)";
        label en unofficial "The owner must however leave the object to the other for use in so far as needed for a separate household and equitable (§ 1361a (1) sentence 2)";
        when getrennt_lebend(ehe) and haushaltsgegenstand_im_eigentum(ehe, eigentuemer, s)
         and anderer_ehegatte(ehe, eigentuemer, beguenstigter)
         and ueberlassung_des_haushaltsgegenstands_billig(ehe, beguenstigter);
        then ueberlassung_zum_gebrauch(ehe, eigentuemer, beguenstigter, s);
    }
    rule VerteilungGemeinsamerGegenstaende(ehe: Ehe, a: Person, b: Person, s: de.bgb.core::Sache) strict {
        label de official "Haushaltsgegenstände, die den Ehegatten gemeinsam gehören, werden zwischen ihnen nach den Grundsätzen der Billigkeit verteilt; können sich die Ehegatten nicht einigen, so entscheidet das zuständige Gericht (§ 1361a Abs. 2, 3)";
        label en unofficial "Household objects owned jointly are distributed between them on equitable principles; if they cannot agree, the competent court decides (§ 1361a (2), (3))";
        when getrennt_lebend(ehe) and haushaltsgegenstand_im_gemeinsamen_eigentum(ehe, s)
         and ehegatten(ehe, a, b) and ueberlassung_des_haushaltsgegenstands_billig(ehe, a);
        then ueberlassung_zum_gebrauch(ehe, b, a, s);
    }
    rule EigentumsverhaeltnisseUnberuehrt(ehe: Ehe, eigentuemer: Person, s: de.bgb.core::Sache) strict {
        label de official "Die Eigentumsverhältnisse bleiben unberührt, sofern die Ehegatten nichts anderes vereinbaren (§ 1361a Abs. 4)";
        label en unofficial "The ownership relations remain unaffected unless the spouses agree otherwise (§ 1361a (4))";
        when getrennt_lebend(ehe) and haushaltsgegenstand_im_eigentum(ehe, eigentuemer, s);
        then eigentumsverhaeltnisse_unberuehrt(ehe);
    }
}

@source(BGB_P1361b) {
    rule UeberlassungDerEhewohnung(ehe: Ehe, verlangender: Person, verpflichteter: Person) strict {
        label de official "Leben die Ehegatten voneinander getrennt oder will einer von ihnen getrennt leben, so kann ein Ehegatte verlangen, dass ihm der andere die Ehewohnung oder einen Teil zur alleinigen Benutzung überlässt, soweit dies notwendig ist, um eine unbillige Härte zu vermeiden (§ 1361b Abs. 1 Satz 1)";
        label en unofficial "Where the spouses live apart, a spouse may demand that the other leave him the matrimonial home for sole use in so far as necessary to avoid inequitable hardship (§ 1361b (1) sentence 1)";
        when ueberlassung_der_ehewohnung_zur_vermeidung_unbilliger_haerte(ehe, verlangender)
         and anderer_ehegatte(ehe, verlangender, verpflichteter);
        then ehewohnung_zur_alleinigen_benutzung_zu_ueberlassen(ehe, verpflichteter, verlangender);
    }
    rule GesamteWohnungNachVorsaetzlicherVerletzung(ehe: Ehe, taeter: Person, verletzter: Person) strict {
        label de official "Hat der Ehegatte, gegen den sich der Antrag richtet, den anderen widerrechtlich und vorsätzlich verletzt oder mit einer solchen Verletzung gedroht, ist in der Regel die GESAMTE Wohnung zur alleinigen Benutzung zu überlassen; der Anspruch ist nur ausgeschlossen, wenn keine weiteren Verletzungen zu besorgen sind (§ 1361b Abs. 2)";
        label en unofficial "Where the respondent unlawfully and intentionally injured or threatened the other, as a rule the WHOLE home is to be left for sole use; excluded only if no further injuries are to be feared (§ 1361b (2))";
        when vorsaetzliche_verletzung_oder_drohung(ehe, taeter, verletzter)
         and not_known(keine_weiteren_verletzungen_zu_besorgen(ehe, taeter));
        then ehewohnung_zur_alleinigen_benutzung_zu_ueberlassen(ehe, taeter, verletzter);
    }
    rule NutzungsrechtNichtZuVereiteln(ehe: Ehe, verpflichteter: Person, beguenstigter: Person) strict {
        label de official "Wurde einem Ehegatten die Ehewohnung ganz oder zum Teil überlassen, so hat der andere alles zu unterlassen, was geeignet ist, die Ausübung dieses Nutzungsrechts zu erschweren oder zu vereiteln (§ 1361b Abs. 3 Satz 1)";
        label en unofficial "Where the home has been left to a spouse, the other must refrain from impeding or frustrating the right of use (§ 1361b (3) sentence 1)";
        when ehewohnung_zur_alleinigen_benutzung_zu_ueberlassen(ehe, verpflichteter, beguenstigter);
        then nutzungsrecht_nicht_zu_vereiteln(ehe, verpflichteter);
    }
    rule RueckkehrfristEreignis(ehe: Ehe, ausgezogener: Person, f: Frist, t: Date) strict {
        label de official "Die Frist des § 1361b Abs. 4 läuft vom Auszug an";
        label en unofficial "The period of § 1361b (4) runs from the moving out";
        when rueckkehrfrist_1361b(ehe, ausgezogener, f) and auszug_aus_der_ehewohnung_am(ehe, ausgezogener, t);
        then de.bgb.fristen::frist_ereignis(f, t);
    }
    rule RueckkehrfristDauer(ehe: Ehe, ausgezogener: Person, f: Frist) strict {
        label de official "Die Frist beträgt SECHS MONATE nach dem Auszug (§ 1361b Abs. 4)";
        label en unofficial "The period is SIX MONTHS after the moving out (§ 1361b (4))";
        when rueckkehrfrist_1361b(ehe, ausgezogener, f);
        then de.bgb.fristen::frist_dauer_kalender(f, 6 calendar_month);
    }
    rule UnwiderleglicheUeberlassungDesNutzungsrechts(ehe: Ehe, ausgezogener: Person, f: Frist, e: Date, bewertung: Date) strict {
        label de official "Ist nach der Trennung ein Ehegatte aus der Ehewohnung ausgezogen und hat er binnen sechs Monaten nach seinem Auszug eine ernstliche Rückkehrabsicht nicht bekundet, so wird unwiderleglich vermutet, dass er dem verbliebenen Ehegatten das alleinige Nutzungsrecht überlassen hat (§ 1361b Abs. 4) — eine UNWIDERLEGLICHE Vermutung ist eine Regel, keine `presumption`";
        label en unofficial "If the spouse who moved out has not declared a serious intention to return within six months, it is irrebuttably presumed that he left the sole right of use to the other (§ 1361b (4)) — an irrebuttable presumption is a rule, not a `presumption`";
        when rueckkehrfrist_1361b(ehe, ausgezogener, f) and de.bgb.fristen::frist_ende_kalender(f, e)
         and bewertungstag(ehe, bewertung) and bewertung > e
         and not_known(rueckkehrabsicht_bekundet(ehe, ausgezogener));
        then alleiniges_nutzungsrecht_unwiderleglich_ueberlassen(ehe, ausgezogener);
    }
}

@source(BGB_P1362) {
    presumption EigentumDesSchuldnersVermutet(ehe: Ehe, schuldner: Person, s: de.bgb.core::Sache) {
        label de official "Zugunsten der Gläubiger eines der Ehegatten wird vermutet, dass die im Besitz eines oder beider Ehegatten befindlichen beweglichen Sachen dem Schuldner gehören (§ 1362 Abs. 1 Satz 1)";
        label en unofficial "In favour of the creditors of one spouse it is presumed that movable things in the possession of one or both belong to the debtor (§ 1362 (1) sentence 1)";
        when schuldner_eines_glaeubigers(ehe, schuldner)
         and bewegliche_sache_im_besitz_eines_ehegatten(ehe, schuldner, s);
        presume eigentum_des_schuldners_vermutet(ehe, schuldner, s);
        unless eigentum_des_anderen_ehegatten_nachgewiesen(ehe, schuldner, s);
    }
    rule VermutungGiltNichtBeiGetrenntlebenUndFremdbesitz(ehe: Ehe, schuldner: Person, nichtschuldner: Person, s: de.bgb.core::Sache) strict {
        label de official "Diese Vermutung gilt nicht, wenn die Ehegatten getrennt leben und sich die Sachen im Besitz des Ehegatten befinden, der nicht Schuldner ist (§ 1362 Abs. 1 Satz 2)";
        label en unofficial "This presumption does not apply where the spouses live apart and the things are in the possession of the spouse who is not the debtor (§ 1362 (1) sentence 2)";
        when getrennt_lebend(ehe) and schuldner_eines_glaeubigers(ehe, schuldner)
         and anderer_ehegatte(ehe, schuldner, nichtschuldner)
         and bewegliche_sache_im_besitz_eines_ehegatten(ehe, nichtschuldner, s);
        then vermutung_des_1362_ausgeschlossen(ehe, schuldner, s);
    }
    presumption EigentumDesGebrauchersVermutet(ehe: Ehe, p: Person, s: de.bgb.core::Sache) {
        label de official "Für die ausschließlich zum persönlichen Gebrauch eines Ehegatten bestimmten Sachen wird im Verhältnis der Ehegatten zueinander und zu den Gläubigern vermutet, dass sie dem Ehegatten gehören, für dessen Gebrauch sie bestimmt sind (§ 1362 Abs. 2)";
        label en unofficial "Things intended exclusively for the personal use of a spouse are presumed, between the spouses and towards the creditors, to belong to that spouse (§ 1362 (2))";
        when zum_persoenlichen_gebrauch_bestimmt(ehe, p, s);
        presume eigentum_des_gebrauchers_vermutet(ehe, p, s);
        unless eigentum_des_anderen_ehegatten_nachgewiesen(ehe, p, s);
    }
}
