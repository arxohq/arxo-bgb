// TITEL 6, UNTERTITEL 2 — VERTRAGLICHES GÜTERRECHT, ALLGEMEINE VORSCHRIFTEN
// (§§ 1408–1414) UND DIE WAHL-ZUGEWINNGEMEINSCHAFT (§ 1519)
//
// § 1408 Abs. 1 und § 1414 stehen im `package.law` (eingefrorene Fläche des
// Piloten B1: aus ihnen folgt der Güterstand). Hier stehen die übrigen Sätze:
// die Grenze der Vertragsfreiheit (§ 1409), die FORM (§ 1410), die Verträge
// Betreuter (§ 1411), die Wirkung gegenüber Dritten (§ 1412), der Widerruf
// der Vermögensverwaltung (§ 1413) und der deutsch-französische Güterstand
// der Wahl-Zugewinngemeinschaft (§ 1519).
//
// § 1412 IST DER ANGELPUNKT DES VERKEHRSSCHUTZES. Der Text macht die
// Einwendung aus einem Ehevertrag davon abhängig, dass der Dritte den Vertrag
// KANNTE oder ihn infolge grober Fahrlässigkeit nicht kannte — und zwar je
// nach Angriffsziel zu verschiedenen ZEITPUNKTEN: bei einem Rechtsgeschäft im
// Zeitpunkt seiner Vornahme (Nr. 1), bei einem Urteil im Zeitpunkt des
// Eintritts der Rechtshängigkeit (Nr. 2). Zwei Nummern, zwei Regeln.
//
// § 1411 GREIFT NICHT ZUM BETREUUNGSRECHT HINÜBER. Ob ein Einwilligungs-
// vorbehalt angeordnet und ob die Genehmigung des Betreuungsgerichts erteilt
// ist, weiß `de.bgb.betreuung` (BG-14); beide sind hier EINGÄNGE des Falls,
// keine Brücke (Ledger D-12-09).
//
// § 1519 verweist auf das Abkommen vom 4. Februar 2010 zwischen Deutschland
// und Frankreich. Der Inhalt des Abkommens ist NICHT Teil des BGB und wird
// nicht nachgebaut; formalisiert ist die Verweisung selbst und die beiden
// Sätze, die das BGB dazu sagt (§ 1368 gilt entsprechend, § 1412 nicht).

language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

pub entity Ehevertrag {
    label de official "Ehevertrag: Vertrag, durch den die Ehegatten ihre güterrechtlichen Verhältnisse regeln (§ 1408 Abs. 1)";
    label en unofficial "marriage contract: contract by which the spouses regulate their property relations (§ 1408 (1))";
}

// --- Eingänge des Falls ---------------------------------------------------------------------------

pub relation ehevertrag_der_ehe(ehe: Ehe, v: Ehevertrag) kind empirical {
    key(ehe);
    label de official "Ehevertrag dieser Ehe (§ 1408 Abs. 1)";
    label en unofficial "marriage contract of this marriage (§ 1408 (1))";
}
relation vereinbarung_ueber_den_versorgungsausgleich(v: Ehevertrag) kind empirical {
    label de official "Die Ehegatten schließen in dem Ehevertrag Vereinbarungen über den Versorgungsausgleich (§ 1408 Abs. 2)";
    label en unofficial "the spouses make agreements on the equalisation of pension rights in the contract (§ 1408 (2))";
}
relation verweisung_auf_nicht_mehr_geltendes_oder_auslaendisches_recht(v: Ehevertrag) kind empirical {
    label de official "Der Güterstand soll durch Verweisung auf nicht mehr geltendes oder ausländisches Recht bestimmt werden (§ 1409)";
    label en unofficial "the property regime is to be determined by reference to law no longer in force or to foreign law (§ 1409)";
}
pub relation notarielle_niederschrift_bei_gleichzeitiger_anwesenheit(v: Ehevertrag) kind empirical {
    label de official "Der Ehevertrag ist bei gleichzeitiger Anwesenheit beider Teile zur Niederschrift eines Notars geschlossen (§ 1410)";
    label en unofficial "the marriage contract was concluded before a notary in the simultaneous presence of both parties (§ 1410)";
}
relation betreuter_ehegatte(v: Ehevertrag, p: Person) kind empirical {
    label de official "Ein Ehegatte steht unter Betreuung (§ 1411 Abs. 1 Satz 1) — Eingang des Falls; das Betreuungsrecht steht in `de.bgb.betreuung`";
    label en unofficial "a spouse is under custodianship (§ 1411 (1) sentence 1) — input of the case";
}
relation einwilligungsvorbehalt_angeordnet(v: Ehevertrag, p: Person) kind empirical {
    label de official "Für diese Angelegenheit ist ein Einwilligungsvorbehalt angeordnet (§ 1411 Abs. 1 Satz 1)";
    label en unofficial "a reservation of consent has been ordered for this matter (§ 1411 (1) sentence 1)";
}
relation zustimmung_des_betreuers(v: Ehevertrag, p: Person) kind empirical {
    label de official "Der Betreuer hat dem Ehevertrag zugestimmt (§ 1411 Abs. 1 Satz 1)";
    label en unofficial "the custodian consented to the marriage contract (§ 1411 (1) sentence 1)";
}
relation genehmigung_des_betreuungsgerichts(v: Ehevertrag) kind empirical {
    label de official "Das Betreuungsgericht hat die Zustimmung des Betreuers oder den Vertragsschluss genehmigt (§ 1411 Abs. 1 Satz 2, Abs. 2 Satz 2) — festgestellte Tatsache, im Fall mit `origin adjudicated`";
    label en unofficial "the custodianship court approved the custodian's consent or the conclusion ((1) sentence 2, (2) sentence 2) — established fact";
}
relation zugewinnausgleich_ausgeschlossen_oder_eingeschraenkt(v: Ehevertrag) kind empirical {
    label de official "Der Ausgleich des Zugewinns wird ausgeschlossen oder eingeschränkt (§ 1411 Abs. 1 Satz 2, § 1414 Satz 2)";
    label en unofficial "the equalisation of accrued gains is excluded or restricted ((1) sentence 2, § 1414 sentence 2)";
}
relation guetergemeinschaft_vereinbart_oder_aufgehoben(v: Ehevertrag) kind empirical {
    label de official "Gütergemeinschaft wird vereinbart oder aufgehoben (§ 1411 Abs. 1 Satz 2, Abs. 2 Satz 1, § 1414 Satz 2)";
    label en unofficial "community of property is agreed or abolished ((1) sentence 2, (2) sentence 1, § 1414 sentence 2)";
}
relation geschaeftsunfaehiger_ehegatte(v: Ehevertrag, p: Person) kind empirical {
    label de official "Ein Ehegatte ist geschäftsunfähig; für ihn schließt der Betreuer den Ehevertrag (§ 1411 Abs. 2 Satz 1)";
    label en unofficial "a spouse lacks capacity; the custodian concludes the contract for him ((2) sentence 1)";
}
relation geschaeftsfaehiger_betreuter(v: Ehevertrag, p: Person) kind empirical {
    label de official "Der Betreute ist geschäftsfähig; für ihn kann der Betreuer keinen Ehevertrag schließen (§ 1411 Abs. 1 Satz 3)";
    label en unofficial "the person under custodianship has capacity; the custodian cannot conclude a contract for him ((1) sentence 3)";
}
relation gesetzlicher_gueterstand_ausgeschlossen_oder_geaendert(ehe: Ehe) kind empirical {
    label de official "Die Ehegatten haben den gesetzlichen Güterstand ausgeschlossen oder geändert oder eine Vereinbarung über den Güterstand aufgehoben oder geändert (§ 1412 Satz 1, § 1414 Satz 1)";
    label en unofficial "the spouses have excluded or altered the statutory regime or cancelled or altered an agreement on the regime (§ 1412 sentence 1, § 1414 sentence 1)";
}
relation dritter_kannte_den_ehevertrag_bei_vornahme(ehe: Ehe, dritter: Person) kind empirical {
    label de official "Das Vorhandensein eines Ehevertrages war dem Dritten bei Vornahme des Rechtsgeschäfts bekannt oder infolge grober Fahrlässigkeit unbekannt geblieben (§ 1412 Nr. 1)";
    label en unofficial "the existence of a marriage contract was known to the third party at the time of the transaction or unknown through gross negligence (§ 1412 no. 1)";
}
relation dritter_kannte_den_ehevertrag_bei_rechtshaengigkeit(ehe: Ehe, dritter: Person) kind empirical {
    label de official "Das Vorhandensein eines Ehevertrages war dem Dritten bei dem Eintritt der Rechtshängigkeit des Rechtsstreits bekannt oder infolge grober Fahrlässigkeit unbekannt geblieben (§ 1412 Nr. 2)";
    label en unofficial "the existence of a marriage contract was known to the third party when the proceedings became pending or unknown through gross negligence (§ 1412 no. 2)";
}
relation rechtsgeschaeft_mit_dem_dritten(ehe: Ehe, handelnder: Person, dritter: Person) kind empirical {
    label de official "Rechtsgeschäft, das zwischen einem der Ehegatten und dem Dritten vorgenommen worden ist (§ 1412 Nr. 1)";
    label en unofficial "transaction concluded between one of the spouses and the third party (§ 1412 no. 1)";
}
relation rechtskraeftiges_urteil_gegen_den_ehegatten(ehe: Ehe, betroffener: Person, dritter: Person) kind empirical {
    label de official "Rechtskräftiges Urteil, das zwischen einem der Ehegatten und dem Dritten ergangen ist (§ 1412 Nr. 2)";
    label en unofficial "final judgment given between one of the spouses and the third party (§ 1412 no. 2)";
}
relation vermoegensverwaltung_ueberlassen(ehe: Ehe, ueberlassender: Person, verwalter: Person) kind empirical {
    label de official "Ein Ehegatte überlässt sein Vermögen der Verwaltung des anderen Ehegatten (§ 1413)";
    label en unofficial "a spouse leaves his assets to the administration of the other spouse (§ 1413)";
}
relation widerrufsrecht_durch_ehevertrag_ausgeschlossen(ehe: Ehe, ueberlassender: Person) kind empirical {
    label de official "Das Recht, die Überlassung jederzeit zu widerrufen, ist durch Ehevertrag ausgeschlossen oder eingeschränkt (§ 1413)";
    label en unofficial "the right to revoke the transfer at any time has been excluded or restricted by marriage contract (§ 1413)";
}
relation widerruf_aus_wichtigem_grund(ehe: Ehe, ueberlassender: Person) kind empirical {
    label de official "Der Widerruf erfolgt aus wichtigem Grunde (§ 1413 Halbsatz 2)";
    label en unofficial "the revocation is made for a serious reason (§ 1413)";
}
relation wahl_zugewinngemeinschaft_vereinbart(ehe: Ehe, v: Ehevertrag) kind empirical {
    label de official "Die Ehegatten vereinbaren durch Ehevertrag den Güterstand der Wahl-Zugewinngemeinschaft (§ 1519 Satz 1)";
    label en unofficial "the spouses agree by marriage contract on the regime of the elective community of accrued gains (§ 1519 sentence 1)";
}

// --- Ergebnisse -------------------------------------------------------------------------------------

pub relation ehevertrag_formwirksam(v: Ehevertrag) kind institutional {
    label de official "Der Ehevertrag ist in der Form des § 1410 geschlossen: bei gleichzeitiger Anwesenheit beider Teile zur Niederschrift eines Notars";
    label en unofficial "The marriage contract was concluded in the form of § 1410";
}
pub relation ehevertrag_formunwirksam(v: Ehevertrag) kind institutional {
    label de official "Der Ehevertrag genügt der Form des § 1410 nicht";
    label en unofficial "The marriage contract does not satisfy the form of § 1410";
}
relation gueterstandsbestimmung_unzulaessig(v: Ehevertrag) kind institutional {
    label de official "Der Güterstand kann nicht durch Verweisung auf nicht mehr geltendes oder ausländisches Recht bestimmt werden (§ 1409)";
    label en unofficial "The property regime cannot be determined by reference to law no longer in force or to foreign law (§ 1409)";
}
relation versorgungsausgleich_nach_versausglg(v: Ehevertrag) kind institutional {
    label de official "Schließen die Ehegatten Vereinbarungen über den Versorgungsausgleich, so sind insoweit die §§ 6 und 8 des Versorgungsausgleichsgesetzes anzuwenden (§ 1408 Abs. 2) — ein äußeres Gesetz, das dieses Paket nicht nachbaut";
    label en unofficial "Where the spouses agree on the equalisation of pension rights, §§ 6 and 8 of the Pension Rights Equalisation Act apply (§ 1408 (2)) — an external act not rebuilt here";
}
relation ehevertrag_des_betreuten_wirksam(v: Ehevertrag, p: Person) kind institutional {
    label de official "Der Betreute hat den Ehevertrag mit Zustimmung seines Betreuers und, soweit erforderlich, mit Genehmigung des Betreuungsgerichts geschlossen (§ 1411 Abs. 1)";
    label en unofficial "The person under custodianship concluded the contract with his custodian's consent and, where required, the court's approval (§ 1411 (1))";
}
relation betreuer_kann_keinen_ehevertrag_schliessen(v: Ehevertrag, p: Person) kind institutional {
    label de official "Für einen geschäftsfähigen Betreuten kann der Betreuer keinen Ehevertrag schließen (§ 1411 Abs. 1 Satz 3); für einen geschäftsunfähigen Ehegatten kann er Gütergemeinschaft nicht vereinbaren oder aufheben (Abs. 2 Satz 1)";
    label en unofficial "For a person under custodianship who has capacity the custodian cannot conclude a contract ((1) sentence 3); for one lacking capacity he cannot agree or abolish community of property ((2) sentence 1)";
}
pub relation einwendung_gegen_den_dritten_moeglich(ehe: Ehe, dritter: Person, gegenstand: Text) kind institutional {
    label de official "Die Ehegatten können aus dem Ehevertrag gegenüber dem Dritten Einwendungen herleiten (§ 1412 Nr. 1, 2)";
    label en unofficial "The spouses may derive objections against the third party from the marriage contract (§ 1412 nos. 1, 2)";
}
relation ueberlassung_jederzeit_widerruflich(ehe: Ehe, ueberlassender: Person) kind institutional {
    label de official "Das Recht, die Überlassung der Vermögensverwaltung jederzeit zu widerrufen, besteht; ein Widerruf aus wichtigem Grunde bleibt auch bei vertraglichem Ausschluss zulässig (§ 1413)";
    label en unofficial "The right to revoke the transfer of administration at any time exists; revocation for a serious reason remains admissible even if contractually excluded (§ 1413)";
}
relation wahl_zugewinngemeinschaft_gilt(ehe: Ehe) kind institutional {
    label de official "Vereinbaren die Ehegatten durch Ehevertrag den Güterstand der Wahl-Zugewinngemeinschaft, so gelten die Vorschriften des Abkommens vom 4. Februar 2010 zwischen der Bundesrepublik Deutschland und der Französischen Republik; § 1368 gilt entsprechend, § 1412 ist nicht anzuwenden (§ 1519)";
    label en unofficial "Where the spouses agree on the elective community of accrued gains, the provisions of the Franco-German Agreement of 4 February 2010 apply; § 1368 applies accordingly, § 1412 does not (§ 1519)";
}

// --- Regeln -------------------------------------------------------------------------------------------

@source(BGB_P1408)
rule VersorgungsausgleichImEhevertrag(v: Ehevertrag) strict {
    label de official "Schließen die Ehegatten in einem Ehevertrag Vereinbarungen über den Versorgungsausgleich, so sind insoweit die §§ 6 und 8 des Versorgungsausgleichsgesetzes anzuwenden (§ 1408 Abs. 2)";
    label en unofficial "Where the spouses agree in the contract on pension-rights equalisation, §§ 6 and 8 of the Pension Rights Equalisation Act apply (§ 1408 (2))";
    when vereinbarung_ueber_den_versorgungsausgleich(v);
    then versorgungsausgleich_nach_versausglg(v);
}

@source(BGB_P1409)
rule KeineVerweisungAufFremdesRecht(v: Ehevertrag) strict {
    label de official "Der Güterstand kann nicht durch Verweisung auf nicht mehr geltendes oder ausländisches Recht bestimmt werden (§ 1409)";
    label en unofficial "The property regime cannot be determined by reference to law no longer in force or to foreign law (§ 1409)";
    when verweisung_auf_nicht_mehr_geltendes_oder_auslaendisches_recht(v);
    then gueterstandsbestimmung_unzulaessig(v);
}

@source(BGB_P1410) {
    rule FormDesEhevertrags(v: Ehevertrag) strict {
        label de official "Der Ehevertrag muss bei gleichzeitiger Anwesenheit beider Teile zur Niederschrift eines Notars geschlossen werden (§ 1410)";
        label en unofficial "The marriage contract must be concluded before a notary in the simultaneous presence of both parties (§ 1410)";
        when notarielle_niederschrift_bei_gleichzeitiger_anwesenheit(v);
        then ehevertrag_formwirksam(v);
    }
    rule FormmangelDesEhevertrags(ehe: Ehe, v: Ehevertrag) strict {
        label de official "Fehlt die notarielle Niederschrift bei gleichzeitiger Anwesenheit, so ist die Form des § 1410 nicht gewahrt";
        label en unofficial "Without the notarial record in simultaneous presence the form of § 1410 is not observed";
        when ehevertrag_der_ehe(ehe, v)
         and not_known(notarielle_niederschrift_bei_gleichzeitiger_anwesenheit(v));
        then ehevertrag_formunwirksam(v);
    }
}

@source(BGB_P1411) {
    rule EhevertragDesBetreutenMitZustimmung(v: Ehevertrag, p: Person) strict {
        label de official "Ein Betreuter kann einen Ehevertrag nur mit Zustimmung seines Betreuers schließen, soweit für diese Angelegenheit ein Einwilligungsvorbehalt angeordnet ist (§ 1411 Abs. 1 Satz 1)";
        label en unofficial "A person under custodianship may conclude a marriage contract only with his custodian's consent where a reservation of consent has been ordered ((1) sentence 1)";
        when betreuter_ehegatte(v, p) and einwilligungsvorbehalt_angeordnet(v, p)
         and zustimmung_des_betreuers(v, p)
         and not_known(zugewinnausgleich_ausgeschlossen_oder_eingeschraenkt(v))
         and not_known(guetergemeinschaft_vereinbart_oder_aufgehoben(v));
        then ehevertrag_des_betreuten_wirksam(v, p);
    }
    rule EhevertragDesBetreutenMitGerichtlicherGenehmigung(v: Ehevertrag, p: Person) strict {
        label de official "Die Zustimmung des Betreuers bedarf der Genehmigung des Betreuungsgerichts, wenn der Ausgleich des Zugewinns ausgeschlossen oder eingeschränkt oder wenn Gütergemeinschaft vereinbart oder aufgehoben wird (§ 1411 Abs. 1 Satz 2)";
        label en unofficial "The custodian's consent requires the court's approval where the equalisation is excluded or restricted or community of property is agreed or abolished ((1) sentence 2)";
        when betreuter_ehegatte(v, p) and einwilligungsvorbehalt_angeordnet(v, p)
         and zustimmung_des_betreuers(v, p) and genehmigung_des_betreuungsgerichts(v);
        then ehevertrag_des_betreuten_wirksam(v, p);
    }
    rule KeinEhevertragFuerDenGeschaeftsfaehigenBetreuten(v: Ehevertrag, p: Person) strict {
        label de official "Für einen geschäftsfähigen Betreuten kann der Betreuer keinen Ehevertrag schließen (§ 1411 Abs. 1 Satz 3)";
        label en unofficial "For a person under custodianship who has capacity the custodian cannot conclude a marriage contract ((1) sentence 3)";
        when geschaeftsfaehiger_betreuter(v, p);
        then betreuer_kann_keinen_ehevertrag_schliessen(v, p);
    }
    rule KeineGuetergemeinschaftFuerDenGeschaeftsunfaehigen(v: Ehevertrag, p: Person) strict {
        label de official "Für einen geschäftsunfähigen Ehegatten schließt der Betreuer den Ehevertrag; Gütergemeinschaft kann er nicht vereinbaren oder aufheben, und er kann den Ehevertrag nur mit Genehmigung des Betreuungsgerichts schließen (§ 1411 Abs. 2)";
        label en unofficial "For a spouse lacking capacity the custodian concludes the contract; he cannot agree or abolish community of property and needs the court's approval ((2))";
        when geschaeftsunfaehiger_ehegatte(v, p) and guetergemeinschaft_vereinbart_oder_aufgehoben(v);
        then betreuer_kann_keinen_ehevertrag_schliessen(v, p);
    }
}

@source(BGB_P1412) {
    rule EinwendungGegenEinRechtsgeschaeft(ehe: Ehe, handelnder: Person, dritter: Person) strict {
        label de official "Haben die Ehegatten den gesetzlichen Güterstand ausgeschlossen oder geändert, so können sie hieraus einem Dritten gegenüber Einwendungen gegen ein Rechtsgeschäft nur herleiten, wenn das Vorhandensein eines Ehevertrages dem Dritten BEI VORNAHME des Rechtsgeschäfts bekannt gewesen oder infolge grober Fahrlässigkeit unbekannt geblieben ist (§ 1412 Nr. 1)";
        label en unofficial "Objections against a transaction may be derived only where the existence of the contract was known to the third party AT THE TIME OF THE TRANSACTION or unknown through gross negligence (§ 1412 no. 1)";
        when gesetzlicher_gueterstand_ausgeschlossen_oder_geaendert(ehe)
         and rechtsgeschaeft_mit_dem_dritten(ehe, handelnder, dritter)
         and dritter_kannte_den_ehevertrag_bei_vornahme(ehe, dritter);
        then einwendung_gegen_den_dritten_moeglich(ehe, dritter, "§ 1412 Nr. 1: Rechtsgeschäft zwischen einem Ehegatten und dem Dritten");
    }
    rule EinwendungGegenEinUrteil(ehe: Ehe, betroffener: Person, dritter: Person) strict {
        label de official "Gegen ein rechtskräftiges Urteil können die Ehegatten Einwendungen nur herleiten, wenn das Vorhandensein eines Ehevertrages dem Dritten BEI DEM EINTRITT DER RECHTSHÄNGIGKEIT bekannt gewesen oder infolge grober Fahrlässigkeit unbekannt geblieben ist (§ 1412 Nr. 2)";
        label en unofficial "Objections against a final judgment may be derived only where the existence of the contract was known to the third party WHEN THE PROCEEDINGS BECAME PENDING or unknown through gross negligence (§ 1412 no. 2)";
        when gesetzlicher_gueterstand_ausgeschlossen_oder_geaendert(ehe)
         and rechtskraeftiges_urteil_gegen_den_ehegatten(ehe, betroffener, dritter)
         and dritter_kannte_den_ehevertrag_bei_rechtshaengigkeit(ehe, dritter);
        then einwendung_gegen_den_dritten_moeglich(ehe, dritter, "§ 1412 Nr. 2: rechtskräftiges Urteil zwischen einem Ehegatten und dem Dritten");
    }
}

@source(BGB_P1413) {
    rule WiderrufDerVermoegensverwaltung(ehe: Ehe, ueberlassender: Person, verwalter: Person) strict {
        label de official "Überlässt ein Ehegatte sein Vermögen der Verwaltung des anderen Ehegatten, so kann das Recht, die Überlassung jederzeit zu widerrufen, nur durch Ehevertrag ausgeschlossen oder eingeschränkt werden (§ 1413 Halbsatz 1)";
        label en unofficial "Where a spouse leaves his assets to the other's administration, the right to revoke at any time may be excluded or restricted only by marriage contract (§ 1413)";
        when vermoegensverwaltung_ueberlassen(ehe, ueberlassender, verwalter)
         and not_known(widerrufsrecht_durch_ehevertrag_ausgeschlossen(ehe, ueberlassender));
        then ueberlassung_jederzeit_widerruflich(ehe, ueberlassender);
    }
    rule WiderrufAusWichtigemGrundeBleibtZulaessig(ehe: Ehe, ueberlassender: Person, verwalter: Person) strict {
        label de official "Ein Widerruf aus wichtigem Grunde bleibt gleichwohl zulässig (§ 1413 Halbsatz 2) — auch dann, wenn das Widerrufsrecht durch Ehevertrag ausgeschlossen ist";
        label en unofficial "Revocation for a serious reason remains admissible nonetheless (§ 1413) — even where the right has been excluded by contract";
        when vermoegensverwaltung_ueberlassen(ehe, ueberlassender, verwalter)
         and widerruf_aus_wichtigem_grund(ehe, ueberlassender);
        then ueberlassung_jederzeit_widerruflich(ehe, ueberlassender);
    }
}

@source(BGB_P1414)
rule GuetertrennungAuchBeiAusschlussDesZugewinnausgleichs(ehe: Ehe, v: Ehevertrag) strict {
    label de official "Gütertrennung tritt auch ein, wenn der Ausgleich des Zugewinns ausgeschlossen oder die Gütergemeinschaft aufgehoben wird (§ 1414 Satz 2), falls sich nicht aus dem Ehevertrag etwas anderes ergibt (Satz 1)";
    label en unofficial "Separation of property also takes effect where the equalisation is excluded or the community of property abolished (§ 1414 sentence 2), unless the contract provides otherwise";
    when ehevertrag_der_ehe(ehe, v) and zugewinnausgleich_ausgeschlossen_oder_eingeschraenkt(v)
     and not_known(ehevertrag_gueterstand(ehe, Guetergemeinschaft));
    then gueterstand(ehe, Guetertrennung);
}

@source(BGB_P1519)
rule WahlZugewinngemeinschaft(ehe: Ehe, v: Ehevertrag) strict {
    label de official "Vereinbaren die Ehegatten durch Ehevertrag den Güterstand der Wahl-Zugewinngemeinschaft, so gelten die Vorschriften des Abkommens vom 4. Februar 2010 zwischen der Bundesrepublik Deutschland und der Französischen Republik über den Güterstand der Wahl-Zugewinngemeinschaft; § 1368 gilt entsprechend; § 1412 ist nicht anzuwenden (§ 1519)";
    label en unofficial "Where the spouses agree on the elective community of accrued gains, the Franco-German Agreement of 4 February 2010 applies; § 1368 applies accordingly; § 1412 does not (§ 1519)";
    when wahl_zugewinngemeinschaft_vereinbart(ehe, v);
    then wahl_zugewinngemeinschaft_gilt(ehe);
}
