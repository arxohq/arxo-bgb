language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

pub relation position_trigger_1303(ehe: Ehe, eheschliessender: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum Eheverbot vor Volljährigkeit (§ 1303)"; label en unofficial "case input for the marriage prohibition before majority (§ 1303)"; }
pub relation eheverbot_1303_geschuldet(ehe: Ehe) kind empirical { label de official "Die Eheschließung vor Volljährigkeit ist zu unterlassen (§ 1303)"; label en unofficial "Marriage before majority must be withheld (§ 1303)"; }
pub relation position_trigger_1306(ehe: Ehe, eheschliessender: Person, dritte_person: Person, tag: Date) kind empirical { label de official "Eingang des Eheverbots bei bestehender Ehe oder Lebenspartnerschaft (§ 1306)"; label en unofficial "case input for the prohibition where a prior marriage or partnership exists (§ 1306)"; }
pub relation eheverbot_1306_geschuldet(ehe: Ehe) kind empirical { label de official "Die Eheschließung trotz bestehender Ehe oder Lebenspartnerschaft ist zu unterlassen (§ 1306)"; label en unofficial "Marriage despite a prior marriage or partnership must be withheld (§ 1306)"; }
pub relation position_trigger_1307(ehe: Ehe, eheschliessender: Person, anderer: Person, tag: Date) kind empirical { label de official "Eingang des Verwandtschafts-Eheverbots (§ 1307)"; label en unofficial "case input for the kinship marriage prohibition (§ 1307)"; }
pub relation eheverbot_1307_geschuldet(ehe: Ehe) kind empirical { label de official "Die Eheschließung zwischen verbotenen Verwandten ist zu unterlassen (§ 1307)"; label en unofficial "Marriage between prohibited relatives must be withheld (§ 1307)"; }

@source(BGB_P1303)
rule PositionEheverbot1303(ehe: Ehe, eheschliessender: Person, tag: Date) strict { label de official "Die Eheschließung vor Volljährigkeit ist zu unterlassen (§ 1303)"; label en unofficial "Marriage before majority must be withheld (§ 1303)"; when position_trigger_1303(ehe, eheschliessender, tag); then duty Eheverbot1303 { bearer eheschliessender; achieve eheverbot_1303_geschuldet(ehe) during [tag, infinity); }; }
@source(BGB_P1306)
rule PositionEheverbot1306(ehe: Ehe, eheschliessender: Person, dritte_person: Person, tag: Date) strict { label de official "Die Eheschließung trotz bestehender Ehe oder Lebenspartnerschaft ist zu unterlassen (§ 1306)"; label en unofficial "Marriage despite a prior marriage or partnership must be withheld (§ 1306)"; when position_trigger_1306(ehe, eheschliessender, dritte_person, tag); then duty Eheverbot1306 { bearer eheschliessender; achieve eheverbot_1306_geschuldet(ehe) during [tag, infinity); }; }
@source(BGB_P1307)
rule PositionEheverbot1307(ehe: Ehe, eheschliessender: Person, anderer: Person, tag: Date) strict { label de official "Die Eheschließung zwischen verbotenen Verwandten ist zu unterlassen (§ 1307)"; label en unofficial "Marriage between prohibited relatives must be withheld (§ 1307)"; when position_trigger_1307(ehe, eheschliessender, anderer, tag); then duty Eheverbot1307 { bearer eheschliessender; achieve eheverbot_1307_geschuldet(ehe) during [tag, infinity); }; }
