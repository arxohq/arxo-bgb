language "law.core" version "0.2";
package de.bgb.ehe version "0.1.0";
namespace "urn:de:corpus:clir:bgb-ehe";

pub relation position_trigger_1385(ehe: Ehe, berechtigter: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum vorzeitigen Zugewinnausgleich (§ 1385)"; label en unofficial "case input for premature equalisation (§ 1385)"; }
pub relation ausgleich_1385_ausuebbar(ehe: Ehe, berechtigter: Person) kind empirical { label de official "Der berechtigte Ehegatte darf vorzeitigen Ausgleich verlangen (§ 1385)"; label en unofficial "The entitled spouse may claim premature equalisation (§ 1385)"; }
pub relation position_trigger_1390(ehe: Ehe, berechtigter: Person, dritter: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum Wertersatz gegen den Dritten (§ 1390)"; label en unofficial "case input for value compensation against the third party (§ 1390)"; }
pub relation wertersatz_1390_geschuldet(ehe: Ehe, dritter: Person, berechtigter: Person) kind empirical { label de official "Wertersatz an den ausgleichsberechtigten Ehegatten ist geschuldet (§ 1390)"; label en unofficial "Value compensation to the entitled spouse is owed (§ 1390)"; }
pub relation position_trigger_1585b(ehe: Ehe, berechtigter: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum rückständigen Unterhalt (§ 1585b)"; label en unofficial "case input for past maintenance (§ 1585b)"; }
pub relation unterhalt_1585b_geschuldet(ehe: Ehe, berechtigter: Person) kind empirical { label de official "Unterhalt für die Vergangenheit ist geschuldet (§ 1585b)"; label en unofficial "past maintenance is owed (§ 1585b)"; }
pub relation position_trigger_1586a(ehe: Ehe, berechtigter: Person, pflichtiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum Wiederaufleben des Unterhalts (§ 1586a)"; label en unofficial "case input for revival of maintenance (§ 1586a)"; }
pub relation unterhalt_1586a_geschuldet(ehe: Ehe, pflichtiger: Person, berechtigter: Person) kind empirical { label de official "Wiederauflebender Unterhalt ist geschuldet (§ 1586a)"; label en unofficial "revived maintenance is owed (§ 1586a)"; }
pub relation position_trigger_1586b(ehe: Ehe, erbe: Person, berechtigter: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Erbenhaftung für Unterhalt (§ 1586b)"; label en unofficial "case input for heir liability for maintenance (§ 1586b)"; }
pub relation haftung_1586b_geschuldet(ehe: Ehe, erbe: Person, berechtigter: Person) kind empirical { label de official "Der Erbe haftet für den Unterhalt bis zur gesetzlichen Grenze (§ 1586b)"; label en unofficial "The heir is liable for maintenance up to the statutory cap (§ 1586b)"; }

@source(BGB_P1385)
rule PositionAusgleich1385(ehe: Ehe, berechtigter: Person, tag: Date) strict { label de official "Der berechtigte Ehegatte darf vorzeitigen Zugewinnausgleich verlangen (§ 1385)"; label en unofficial "The entitled spouse may claim premature equalisation (§ 1385)"; when position_trigger_1385(ehe, berechtigter, tag); then power Ausgleich1385 { holder berechtigter; over ehe; exercise ausgleich_1385_ausuebbar(ehe, berechtigter); valid_when ausgleich_1385_ausuebbar(ehe, berechtigter); effect create(ausgleich_1385_ausuebbar(ehe, berechtigter)); window [tag, infinity); }; }
@source(BGB_P1390)
rule PositionWertersatz1390(ehe: Ehe, berechtigter: Person, dritter: Person, tag: Date) strict { label de official "Der Dritte schuldet Wertersatz an den ausgleichsberechtigten Ehegatten (§ 1390)"; label en unofficial "The third party owes value compensation to the entitled spouse (§ 1390)"; when position_trigger_1390(ehe, berechtigter, dritter, tag); then duty Wertersatz1390 { bearer dritter; beneficiary berechtigter; achieve wertersatz_1390_geschuldet(ehe, dritter, berechtigter) during [tag, infinity); }; }
@source(BGB_P1585b)
rule PositionUnterhalt1585b(ehe: Ehe, berechtigter: Person, tag: Date) strict { label de official "Der Berechtigte kann Unterhalt für die Vergangenheit verlangen (§ 1585b)"; label en unofficial "The entitled spouse may claim past maintenance (§ 1585b)"; when position_trigger_1585b(ehe, berechtigter, tag); then duty Unterhalt1585b { bearer berechtigter; achieve unterhalt_1585b_geschuldet(ehe, berechtigter) during [tag, infinity); }; }
@source(BGB_P1586a)
rule PositionWiederaufleben1586a(ehe: Ehe, berechtigter: Person, pflichtiger: Person, tag: Date) strict { label de official "Der frühere Ehegatte schuldet wiederauflebenden Unterhalt (§ 1586a)"; label en unofficial "The former spouse owes revived maintenance (§ 1586a)"; when position_trigger_1586a(ehe, berechtigter, pflichtiger, tag); then duty Wiederaufleben1586a { bearer pflichtiger; beneficiary berechtigter; achieve unterhalt_1586a_geschuldet(ehe, pflichtiger, berechtigter) during [tag, infinity); }; }
@source(BGB_P1586b)
rule PositionErbenhaftung1586b(ehe: Ehe, erbe: Person, berechtigter: Person, tag: Date) strict { label de official "Der Erbe haftet für die Unterhaltspflicht als Nachlassverbindlichkeit (§ 1586b)"; label en unofficial "The heir is liable for the maintenance duty as an estate liability (§ 1586b)"; when position_trigger_1586b(ehe, erbe, berechtigter, tag); then duty Erbenhaftung1586b { bearer erbe; beneficiary berechtigter; achieve haftung_1586b_geschuldet(ehe, erbe, berechtigter) during [tag, infinity); }; }
