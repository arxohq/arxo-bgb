@source(BGB_P826)
rule PositionSchadensersatz826(h: Handlung, ersatzpflichtiger: Person, verletzter: Person, tag: Date) defeasible {
    label de official "Der sittenwidrig Schädigende hat den Schaden zu ersetzen (§ 826)";
    label en unofficial "The person intentionally causing immoral damage must compensate it (§ 826)";
    when schadensersatzpflicht(h, ersatzpflichtiger, verletzter);
    when handlungstag(h, tag);
    then duty Schadensersatz826 {
        bearer ersatzpflichtiger;
        beneficiary verletzter;
        achieve schadensersatzpflicht(h, ersatzpflichtiger, verletzter) during [tag, infinity);
    };
}

@source(BGB_P254)
rule PositionGeminderterErsatz254(h: Handlung, dritter: Person, betrag: Money, tag: Date) defeasible {
    label de official "Der Ersatzanspruch des Dritten ist nach Mitverschulden gemindert (§ 254)";
    label en unofficial "The third party's compensation claim is reduced for contributory fault (§ 254)";
    when geminderter_ersatzanspruch_dritter(h, dritter, betrag);
    when handlungstag(h, tag);
    then duty GeminderterErsatz254 {
        bearer dritter;
        beneficiary dritter;
        achieve geminderter_ersatzanspruch_dritter(h, dritter, betrag) during [tag, infinity);
    };
}

@source(BGB_P249)
rule PositionDeliktischerSchadensersatz249(h: Handlung, betrag: Money, tag: Date) defeasible {
    label de official "Der deliktische Schadensersatz ist nach §§249 ff. zu leisten";
    label en unofficial "Tort damages must be paid as quantified under §§249 et seq.";
    when deliktischer_schadensersatz(h, betrag);
    when handlungstag(h, tag);
    then duty DeliktischerSchadensersatz249 {
        bearer h;
        beneficiary h;
        achieve deliktischer_schadensersatz(h, betrag) during [tag, infinity);
    };
}
