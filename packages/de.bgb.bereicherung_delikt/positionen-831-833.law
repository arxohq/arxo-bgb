@source(BGB_P831)
rule PositionHaftung831(h: Handlung, gh: Person, d: Person, tag: Date) defeasible {
    label de official "Der Geschäftsherr hat dem geschädigten Dritten den Schaden zu ersetzen (§ 831)";
    label en unofficial "The principal must compensate the injured third party (§ 831)";
    when geschaeftsherr(h, gh) and geschaedigter_dritter(h, d);
    when handlungstag(h, tag);
    then duty Duty831Geschaeftsherr {
        bearer gh;
        beneficiary d;
        achieve haftung_831(h, gh, d) during [tag, infinity);
    };
}

@source(BGB_P832)
rule PositionHaftung832(h: Handlung, a: Person, d: Person, tag: Date) defeasible {
    label de official "Der Aufsichtspflichtige hat dem geschädigten Dritten den Schaden zu ersetzen (§ 832)";
    label en unofficial "The supervisor must compensate the injured third party (§ 832)";
    when aufsichtspflichtiger_kraft_gesetzes(h, a) and geschaedigter_dritter(h, d);
    when handlungstag(h, tag);
    then duty Duty832Aufsichtspflichtiger {
        bearer a;
        beneficiary d;
        achieve haftung_832(h, a, d) during [tag, infinity);
    };
}

@source(BGB_P833)
rule PositionHaftung833(h: Handlung, p: Person, d: Person, tag: Date) defeasible {
    label de official "Der Tierhalter hat dem Verletzten den Schaden zu ersetzen (§ 833)";
    label en unofficial "The animal keeper must compensate the injured person (§ 833)";
    when tierhalter(h, p) and verletzter(h, d);
    when handlungstag(h, tag);
    then duty Duty833Tierhalter {
        bearer p;
        beneficiary d;
        achieve haftung_833(h, p, d) during [tag, infinity);
    };
}
