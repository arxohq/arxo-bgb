pub relation billigkeitshaftung_829_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der Ersatzpflicht aus Billigkeit nach § 829";
    label en unofficial "start of equity-based liability under § 829";
}
@source(BGB_P829)
rule PositionBilligkeitshaftung829(h: Handlung, s: Person, v: Person, tag: Date) defeasible {
    label de official "Der Handelnde hat aus Billigkeit den Schaden des Verletzten zu ersetzen (§ 829)";
    label en unofficial "The actor must compensate the injured person on grounds of equity (§ 829)";
    when handelnder(h, s) and verletzter(h, v)
     and billigkeitshaftung_829_beginn_am(h, tag);
    then liberty Liberty829Billigkeitshaftung {
        holder s;
        action billigkeitshaftung_829_beginn_am(h, tag);
        window [tag, infinity);
    };
}

pub relation mitverantwortlich_830_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der Mitverantwortlichkeit nach § 830";
    label en unofficial "start of joint responsibility under § 830";
}
@source(BGB_P830)
rule PositionMithaftung830(h: Handlung, p: Person, v: Person, tag: Date) defeasible {
    label de official "Der Beteiligte haftet dem Verletzten als Mittäter oder Gehilfe (§ 830)";
    label en unofficial "The participant is liable to the injured person as joint tortfeasor or accessory (§ 830)";
    when beteiligter(h, p) and verletzter(h, v)
     and mitverantwortlich_830_beginn_am(h, tag);
    then liberty Liberty830Mithaftung {
        holder p;
        action mitverantwortlich_830_beginn_am(h, tag);
        window [tag, infinity);
    };
}

pub relation gesamtschuld_840_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der Gesamtschuld nach § 840";
    label en unofficial "start of joint and several liability under § 840";
}
@source(BGB_P840)
rule PositionGesamtschuld840(h: Handlung, p: Person, tag: Date) defeasible {
    label de official "Mehrere Verantwortliche haften als Gesamtschuldner (§ 840)";
    label en unofficial "Several responsible persons are jointly and severally liable (§ 840)";
    when nebeneinander_verantwortlich(h, p)
     and gesamtschuld_840_beginn_am(h, tag);
    then liberty Liberty840Gesamtschuld {
        holder p;
        action gesamtschuld_840_beginn_am(h, tag);
        window [tag, infinity);
    };
}
