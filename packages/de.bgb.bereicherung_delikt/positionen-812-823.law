@source(BGB_P812)
rule PositionHerausgabe812(b: Bereicherung, tag: Date) defeasible {
    label de official "Der Bereicherte hat das Erlangte herauszugeben (§ 812)";
    label en unofficial "The enriched person must surrender what was obtained (§ 812)";
    when herausgabepflicht(b);
    when leistungstag(b, tag);
    then duty Herausgabe812 {
        bearer b;
        beneficiary b;
        achieve herausgabepflicht(b) during [tag, infinity);
    };
}

@source(BGB_P823)
rule PositionSchadensersatz823(h: Handlung, ersatzpflichtiger: Person, verletzter: Person, tag: Date) defeasible {
    label de official "Der Schädiger hat den aus der unerlaubten Handlung entstandenen Schaden zu ersetzen (§ 823)";
    label en unofficial "The tortfeasor must compensate the damage arising from the tort (§ 823)";
    when schadensersatzpflicht(h, ersatzpflichtiger, verletzter);
    when handlungstag(h, tag);
    then duty Schadensersatz823 {
        bearer ersatzpflichtiger;
        beneficiary verletzter;
        achieve schadensersatzpflicht(h, ersatzpflichtiger, verletzter) during [tag, infinity);
    };
}
