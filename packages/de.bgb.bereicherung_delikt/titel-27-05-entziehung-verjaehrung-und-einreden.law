// --- Titel 27, fünfter Teil: Entziehung einer Sache, Verwendungen,
// --- befreiende Leistung, Restschadensersatz und Arglisteinrede
// --- (§§ 848–853; § 847 weggefallen)
//
// DIE EINZIGE VERJÄHRUNG DIESES PAKETS steht in § 852 Satz 2: zehn Jahre von
// der Entstehung des Anspruchs an, ohne Rücksicht auf die Entstehung dreißig
// Jahre von der Begehung der Verletzungshandlung oder dem sonstigen, den
// Schaden auslösenden Ereignis an. Beide Fristen laufen NEBENEINANDER; der
// Anspruch ist mit dem FRÜHEREN der beiden Enden verjährt. Gerechnet wird mit
// dem Kalenderschritt des § 188 Abs. 2 unter der Politik BGB_DELIKT_JAHR;
// Zeilen in DEADLINES.json, Abschnitt BG-09. Die regelmäßige Verjährung des
// Schadensersatzanspruchs selbst (§§ 195, 199) und ihre dreißigjährige
// Höchstfrist für Leben, Körper, Gesundheit und Freiheit (§ 199 Abs. 2)
// stehen bei de.bgb.fristen und werden hier NICHT wiederholt.

// --- § 848 Haftung für Zufall bei Entziehung einer Sache ------------------------------------------

pub relation sache_durch_unerlaubte_handlung_entzogen(h: Handlung, s: Sache) kind empirical {
    key(h);
    label de official "eine Sache wurde einem anderen durch eine unerlaubte Handlung entzogen (§ 848)";
    label en unofficial "a thing was taken from another by a tort (§ 848)";
}
pub relation zufaelliger_untergang_oder_verschlechterung(h: Handlung) kind empirical {
    label de official "zufälliger Untergang, aus einem anderen Grunde eintretende zufällige Unmöglichkeit der Herausgabe oder zufällige Verschlechterung der Sache (§ 848)";
    label en unofficial "accidental destruction, accidental impossibility of restitution for another reason, or accidental deterioration of the thing (§ 848)";
}
pub relation auch_ohne_entziehung_eingetreten(h: Handlung) kind empirical {
    label de official "der Untergang, die anderweitige Unmöglichkeit der Herausgabe oder die Verschlechterung würde auch ohne die Entziehung eingetreten sein (§ 848 Halbsatz 2) — ausdrückliche Angabe des Falls";
    label en unofficial "the destruction, the impossibility of restitution or the deterioration would have occurred even without the taking (§ 848 half-sentence 2) — express statement of the case";
}
pub relation wertminderung_oder_wert(h: Handlung, betrag: Money) kind empirical {
    key(h);
    label de official "zu ersetzender Wert der entzogenen Sache oder Wertminderung der beschädigten Sache (§ 849)";
    label en unofficial "value of the thing taken, or diminution in value of the thing damaged, to be compensated (§ 849)";
}
pub relation wertbestimmungstag(h: Handlung, tag: Date) kind empirical {
    key(h);
    label de official "Zeitpunkt, welcher der Bestimmung des Wertes zugrunde gelegt wird (§ 849)";
    label en unofficial "point in time on which the determination of value is based (§ 849)";
}
pub relation verwendungen_auf_die_sache(h: Handlung) kind empirical {
    label de official "der zur Herausgabe einer entzogenen Sache Verpflichtete macht Verwendungen auf die Sache (§ 850)";
    label en unofficial "the person obliged to return a thing taken makes outlays on it (§ 850)";
}
pub relation ersatz_an_besitzer_geleistet(h: Handlung, p: Person) kind empirical {
    label de official "der Ersatzpflichtige hat den Ersatz an denjenigen geleistet, in dessen Besitz sich die Sache zur Zeit der Entziehung oder Beschädigung befunden hat (§ 851)";
    label en unofficial "the liable party rendered compensation to the person in whose possession the thing was at the time of the taking or damage (§ 851)";
}
pub relation bewegliche_sache(h: Handlung) kind empirical {
    label de official "die entzogene oder beschädigte Sache ist beweglich (§ 851)";
    label en unofficial "the thing taken or damaged is movable (§ 851)";
}
pub relation recht_des_dritten_bekannt(h: Handlung) kind empirical {
    label de official "dem Ersatzpflichtigen ist das Recht des Dritten bekannt (§ 851 Halbsatz 2) — festgestellte Tatsache";
    label en unofficial "the right of the third party is known to the liable party (§ 851 half-sentence 2) — established fact";
}
@source(BGB_P851)
pub external judgment relation recht_des_dritten_grob_fahrlaessig_unbekannt(h: Handlung) {
    authority Court;
    label de official "§ 851. Das Recht des Dritten ist dem Ersatzpflichtigen infolge grober Fahrlässigkeit unbekannt";
    label en unofficial "§ 851. The right of the third party is unknown to the liable party as a result of gross negligence";
}

pub relation haftung_fuer_zufall(h: Handlung) kind institutional {
    label de official "Verantwortlichkeit auch für den zufälligen Untergang, die zufällige Unmöglichkeit der Herausgabe oder die zufällige Verschlechterung (§ 848)";
    label en unofficial "responsibility also for accidental destruction, accidental impossibility of restitution or accidental deterioration (§ 848)";
}
pub relation zinsanspruch_ab(h: Handlung, tag: Date) kind institutional {
    key(h);
    label de official "der Verletzte kann Zinsen des zu ersetzenden Betrags von diesem Zeitpunkt an verlangen (§ 849); den Zinssatz nennt § 849 nicht";
    label en unofficial "the injured party may claim interest on the amount to be compensated from this time (§ 849); § 849 does not name the rate";
}
pub relation verwendungsrechte_wie_besitzer(h: Handlung) kind institutional {
    label de official "dem Verpflichteten stehen dem Verletzten gegenüber die Rechte zu, die der Besitzer dem Eigentümer gegenüber wegen Verwendungen hat (§ 850) — Inhalt dieser Rechte: de.bgb.besitz_eigentum";
    label en unofficial "the obligor has against the injured party the rights a possessor has against the owner in respect of outlays (§ 850) — the content of those rights: de.bgb.besitz_eigentum";
}
pub relation befreiende_wirkung(h: Handlung) kind institutional {
    label de official "die Leistung an den früheren Besitzer wirkt befreiend (§ 851); der Ausnahmesatz knüpft allein an die Kenntnis des Ersatzpflichtigen an und bindet deshalb nur die Handlung";
    label en unofficial "payment to the former possessor has discharging effect (§ 851); the exception depends solely on the liable party's knowledge and therefore binds only the act";
}
pub relation befreiende_leistung(h: Handlung, p: Person) kind institutional {
    label de official "der Ersatzpflichtige wird durch die Leistung an den früheren Besitzer befreit (§ 851)";
    label en unofficial "the liable party is discharged by rendering compensation to the former possessor (§ 851)";
}

@source(BGB_P848)
rule Zufallshaftung848(h: Handlung, s: Sache) defeasible {
    label de official "Wer zur Rückgabe einer Sache verpflichtet ist, die er einem anderen durch eine unerlaubte Handlung entzogen hat, ist auch für den zufälligen Untergang, eine aus einem anderen Grunde eintretende zufällige Unmöglichkeit der Herausgabe oder eine zufällige Verschlechterung der Sache verantwortlich, es sei denn, dass dies auch ohne die Entziehung eingetreten sein würde (§ 848)";
    label en unofficial "A person obliged to return a thing he took from another by a tort is also responsible for its accidental destruction, for an accidental impossibility of restitution arising for another reason, or for its accidental deterioration, unless this would have occurred even without the taking (§ 848)";
    when sache_durch_unerlaubte_handlung_entzogen(h, s) and zufaelliger_untergang_oder_verschlechterung(h);
    unless auch_ohne_entziehung_eingetreten(h);
    then haftung_fuer_zufall(h);
}

@source(BGB_P849)
rule Verzinsung849(h: Handlung, betrag: Money, tag: Date) defeasible {
    label de official "Ist wegen der Entziehung einer Sache der Wert oder wegen der Beschädigung einer Sache die Wertminderung zu ersetzen, so kann der Verletzte Zinsen des zu ersetzenden Betrags von dem Zeitpunkt an verlangen, welcher der Bestimmung des Wertes zugrunde gelegt wird (§ 849)";
    label en unofficial "Where the value of a thing taken, or the diminution in value of a thing damaged, is to be compensated, the injured party may claim interest on that amount from the time on which the determination of value is based (§ 849)";
    when ersatzpflicht_dem_grunde_nach(h) and wertminderung_oder_wert(h, betrag) and wertbestimmungstag(h, tag);
    then zinsanspruch_ab(h, tag);
}

@source(BGB_P850)
rule Verwendungen850(h: Handlung, s: Sache) defeasible {
    label de official "Macht der zur Herausgabe einer entzogenen Sache Verpflichtete Verwendungen auf die Sache, so stehen ihm dem Verletzten gegenüber die Rechte zu, die der Besitzer dem Eigentümer gegenüber wegen Verwendungen hat (§ 850)";
    label en unofficial "If the person obliged to return a thing taken makes outlays on it, he has against the injured party the rights a possessor has against the owner in respect of outlays (§ 850)";
    when sache_durch_unerlaubte_handlung_entzogen(h, s) and verwendungen_auf_die_sache(h);
    then verwendungsrechte_wie_besitzer(h);
}

@source(BGB_P851)
rule BefreiendeLeistung851(h: Handlung) defeasible {
    label de official "Leistet der wegen der Entziehung oder Beschädigung einer beweglichen Sache zum Schadensersatz Verpflichtete den Ersatz an denjenigen, in dessen Besitz sich die Sache zur Zeit der Entziehung oder der Beschädigung befunden hat, so wird er durch die Leistung auch dann befreit, wenn ein Dritter Eigentümer der Sache war oder ein sonstiges Recht an der Sache hatte, es sei denn, dass ihm das Recht des Dritten bekannt oder infolge grober Fahrlässigkeit unbekannt ist (§ 851)";
    label en unofficial "If the person liable for the taking or damaging of a movable thing renders compensation to the person in whose possession the thing was at that time, he is discharged even if a third party was owner of the thing or had another right in it, unless the third party's right was known to him or unknown as a result of gross negligence (§ 851)";
    when bewegliche_sache(h);
    unless recht_des_dritten_bekannt(h);
    unless recht_des_dritten_grob_fahrlaessig_unbekannt(h);
    then befreiende_wirkung(h);
}

@source(BGB_P851)
rule BefreiungDesErsatzpflichtigen851(h: Handlung, p: Person) defeasible {
    label de official "Der Ersatzpflichtige wird durch die Leistung an denjenigen befreit, in dessen Besitz sich die Sache zur Zeit der Entziehung oder der Beschädigung befunden hat (§ 851)";
    label en unofficial "The liable party is discharged by rendering compensation to the person in whose possession the thing was at the time of the taking or damage (§ 851)";
    when befreiende_wirkung(h) and ersatz_an_besitzer_geleistet(h, p);
    then befreiende_leistung(h, p);
}

// --- § 852 Herausgabeanspruch nach Eintritt der Verjährung ----------------------------------------

pub relation etwas_auf_kosten_des_verletzten_erlangt(h: Handlung) kind empirical {
    label de official "der Ersatzpflichtige hat durch die unerlaubte Handlung auf Kosten des Verletzten etwas erlangt (§ 852 Satz 1)";
    label en unofficial "through the tort the liable party obtained something at the expense of the injured party (§ 852 sentence 1)";
}
pub relation schadensersatzanspruch(h: Handlung, a: Anspruch) kind empirical {
    key(h);
    label de official "der Anspruch auf Ersatz des aus der unerlaubten Handlung entstandenen Schadens, dessen Verjährung § 852 Satz 1 voraussetzt";
    label en unofficial "the claim to compensation for the damage arising from the tort whose limitation § 852 sentence 1 presupposes";
}
pub relation restanspruch_entstanden_am(h: Handlung, tag: Date) kind empirical {
    key(h);
    label de official "Tag der Entstehung des Herausgabeanspruchs des § 852 Satz 1 (§ 852 Satz 2 Alternative 1)";
    label en unofficial "day on which the claim for restitution under § 852 sentence 1 arose (§ 852 sentence 2 alternative 1)";
}

pub relation restschadensersatzanspruch(h: Handlung, ersatzpflichtiger: Person, verletzter: Person) kind institutional {
    label de official "Herausgabepflicht nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung auch nach Eintritt der Verjährung des Ersatzanspruchs (§ 852 Satz 1)";
    label en unofficial "duty of restitution under the rules on unjust enrichment even after the compensation claim has become time-barred (§ 852 sentence 1)";
}
pub relation restanspruch_frist_zehn_jahre(h: Handlung, tag: Date) kind institutional {
    key(h);
    label de official "Ende der zehnjährigen Frist von der Entstehung des Anspruchs an (§ 852 Satz 2 Alternative 1; § 188 Abs. 2)";
    label en unofficial "end of the ten-year period running from the day the claim arose (§ 852 sentence 2 alternative 1; § 188 (2))";
}
pub relation restanspruch_frist_dreissig_jahre(h: Handlung, tag: Date) kind institutional {
    key(h);
    label de official "Ende der dreißigjährigen Frist von der Begehung der Verletzungshandlung an (§ 852 Satz 2 Alternative 2; § 188 Abs. 2)";
    label en unofficial "end of the thirty-year period running from the commission of the injuring act (§ 852 sentence 2 alternative 2; § 188 (2))";
}
pub relation restanspruch_verjaehrt_am(h: Handlung, tag: Date) kind institutional {
    key(h);
    label de official "Tag, mit dessen Ablauf der Herausgabeanspruch des § 852 verjährt: das frühere der beiden Fristenden (§ 852 Satz 2)";
    label en unofficial "day at whose end the claim under § 852 becomes time-barred: the earlier of the two period ends (§ 852 sentence 2)";
}

@source(BGB_P852)
rule Restschadensersatz852Satz1(h: Handlung, a: Anspruch, s: Person, v: Person, tag: Date) defeasible {
    label de official "Hat der Ersatzpflichtige durch eine unerlaubte Handlung auf Kosten des Verletzten etwas erlangt, so ist er auch nach Eintritt der Verjährung des Anspruchs auf Ersatz des Schadens zur Herausgabe nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung verpflichtet (§ 852 Satz 1)";
    label en unofficial "If through a tort the liable party obtained something at the expense of the injured party, he must make restitution under the rules on unjust enrichment even after the compensation claim has become time-barred (§ 852 sentence 1)";
    when etwas_auf_kosten_des_verletzten_erlangt(h) and schadensersatzanspruch(h, a)
     and de.bgb.fristen::verjaehrung_eingetreten_am(a, tag)
     and handelnder(h, s) and verletzter(h, v);
    then restschadensersatzanspruch(h, s, v);
}

@source(BGB_P852)
rule Restanspruch852ZehnJahre(h: Handlung, e: Date) strict {
    label de official "Dieser Anspruch verjährt in zehn Jahren von seiner Entstehung an (§ 852 Satz 2 Alternative 1) — Jahresschritt nach § 188 Abs. 2, Politik BGB_DELIKT_JAHR";
    label en unofficial "This claim becomes time-barred ten years after it arose (§ 852 sentence 2 alternative 1) — annual step under § 188 (2), policy BGB_DELIKT_JAHR";
    when etwas_auf_kosten_des_verletzten_erlangt(h) and restanspruch_entstanden_am(h, e);
    then restanspruch_frist_zehn_jahre(h, add_calendar_period(e, 10 calendar_year));
}
@source(BGB_P852)
rule Restanspruch852DreissigJahre(h: Handlung, b: Date) strict {
    label de official "Ohne Rücksicht auf die Entstehung verjährt der Anspruch in 30 Jahren von der Begehung der Verletzungshandlung oder dem sonstigen, den Schaden auslösenden Ereignis an (§ 852 Satz 2 Alternative 2)";
    label en unofficial "Irrespective of when it arose, the claim becomes time-barred thirty years after the commission of the injuring act or the other event causing the damage (§ 852 sentence 2 alternative 2)";
    when etwas_auf_kosten_des_verletzten_erlangt(h) and handlungstag(h, b);
    then restanspruch_frist_dreissig_jahre(h, add_calendar_period(b, 30 calendar_year));
}
@source(BGB_P852)
rule Restanspruch852VerjaehrtZehnJahre(h: Handlung, z: Date, d: Date) strict {
    label de official "Der Herausgabeanspruch verjährt mit dem früheren der beiden Fristenden: hier endet die zehnjährige Frist nicht später als die dreißigjährige (§ 852 Satz 2)";
    label en unofficial "The claim becomes time-barred at the earlier of the two period ends: here the ten-year period ends no later than the thirty-year period (§ 852 sentence 2)";
    when restanspruch_frist_zehn_jahre(h, z) and restanspruch_frist_dreissig_jahre(h, d) and z <= d;
    then restanspruch_verjaehrt_am(h, z);
}
@source(BGB_P852)
rule Restanspruch852VerjaehrtDreissigJahre(h: Handlung, z: Date, d: Date) strict {
    label de official "Der Herausgabeanspruch verjährt mit dem früheren der beiden Fristenden: hier endet die dreißigjährige Frist früher als die zehnjährige (§ 852 Satz 2)";
    label en unofficial "The claim becomes time-barred at the earlier of the two period ends: here the thirty-year period ends before the ten-year period (§ 852 sentence 2)";
    when restanspruch_frist_zehn_jahre(h, z) and restanspruch_frist_dreissig_jahre(h, d) and d < z;
    then restanspruch_verjaehrt_am(h, d);
}

// --- § 853 Arglisteinrede --------------------------------------------------------------------------

pub relation forderung_durch_unerlaubte_handlung_erlangt(h: Handlung) kind empirical {
    label de official "jemand erlangt durch eine von ihm begangene unerlaubte Handlung eine Forderung gegen den Verletzten (§ 853)";
    label en unofficial "a person obtains a claim against the injured party through a tort committed by him (§ 853)";
}
pub relation arglisteinrede(h: Handlung, verletzter: Person) kind institutional {
    label de official "der Verletzte kann die Erfüllung auch dann verweigern, wenn der Anspruch auf Aufhebung der Forderung verjährt ist (§ 853)";
    label en unofficial "the injured party may refuse performance even if the claim for cancellation of the debt is time-barred (§ 853)";
}

@source(BGB_P853)
rule Arglisteinrede853(h: Handlung, v: Person) strict {
    label de official "Erlangt jemand durch eine von ihm begangene unerlaubte Handlung eine Forderung gegen den Verletzten, so kann der Verletzte die Erfüllung auch dann verweigern, wenn der Anspruch auf Aufhebung der Forderung verjährt ist (§ 853)";
    label en unofficial "If a person obtains a claim against the injured party through a tort committed by him, the injured party may refuse performance even if the claim for cancellation is time-barred (§ 853)";
    when forderung_durch_unerlaubte_handlung_erlangt(h) and verletzter(h, v);
    then arglisteinrede(h, v);
}
