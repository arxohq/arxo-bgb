pub relation gebaeudehaftung_836_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der Gebäudehaftung nach § 836";
    label en unofficial "start of building liability under § 836";
}
@source(BGB_P836)
rule PositionGebaeudehaftung836(h: Handlung, b: Person, v: Person, tag: Date) defeasible {
    label de official "Der Grundstücksbesitzer haftet dem Verletzten für den Gebäudeschaden (§ 836)";
    label en unofficial "The land possessor is liable to the injured person for building damage (§ 836)";
    when eigenbesitzer_des_grundstuecks(h, b) and verletzter(h, v)
     and gebaeudehaftung_836_beginn_am(h, tag);
    then liberty LibertyGebaeudehaftung836 {
        holder b;
        action gebaeudehaftung_836_beginn_am(h, tag);
        window [tag, infinity);
    };
}

pub relation gebaeudehaftung_837_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der Gebäudehaftung des Fremdgrundstücksbesitzers nach § 837";
    label en unofficial "start of building liability of the possessor on another's land under § 837";
}
@source(BGB_P837)
rule PositionGebaeudehaftung837(h: Handlung, g: Person, v: Person, tag: Date) defeasible {
    label de official "Der Gebäudebesitzer auf fremdem Grundstück haftet dem Verletzten (§ 837)";
    label en unofficial "The building possessor on another's land is liable to the injured person (§ 837)";
    when gebaeudebesitzer_auf_fremdem_grundstueck(h, g) and verletzter(h, v)
     and gebaeudehaftung_837_beginn_am(h, tag);
    then liberty LibertyGebaeudehaftung837 {
        holder g;
        action gebaeudehaftung_837_beginn_am(h, tag);
        window [tag, infinity);
    };
}

pub relation gebaeudehaftung_838_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der Haftung des Unterhaltungspflichtigen nach § 838";
    label en unofficial "start of maintenance person's liability under § 838";
}
@source(BGB_P838)
rule PositionGebaeudehaftung838(h: Handlung, u: Person, v: Person, tag: Date) defeasible {
    label de official "Der Unterhaltungspflichtige haftet dem Verletzten (§ 838)";
    label en unofficial "The maintenance person is liable to the injured person (§ 838)";
    when unterhaltungspflichtiger(h, u) and verletzter(h, v)
     and gebaeudehaftung_838_beginn_am(h, tag);
    then liberty LibertyGebaeudehaftung838 {
        holder u;
        action gebaeudehaftung_838_beginn_am(h, tag);
        window [tag, infinity);
    };
}
