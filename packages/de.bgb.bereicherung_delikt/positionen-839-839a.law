pub relation amtshaftung_839_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der Amtshaftung nach § 839";
    label en unofficial "start of official liability under § 839";
}
@source(BGB_P839)
rule PositionAmtshaftung839(h: Handlung, b: Person, d: Person, tag: Date) defeasible {
    label de official "Der Beamte hat dem Dritten den Amtspflichtschaden zu ersetzen (§ 839)";
    label en unofficial "The official must compensate the third party for the official-duty damage (§ 839)";
    when beamter(h, b) and geschaedigter_dritter(h, d)
     and amtshaftung_839_beginn_am(h, tag);
    then liberty LibertyAmtshaftung839 {
        holder b;
        action amtshaftung_839_beginn_am(h, tag);
        window [tag, infinity);
    };
}

pub relation amtshaftung_839_fahrlaessig_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der subsidiären Amtshaftung wegen Fahrlässigkeit nach § 839";
    label en unofficial "start of subsidiary negligent official liability under § 839";
}
@source(BGB_P839)
rule PositionAmtshaftung839Fahrlaessig(h: Handlung, b: Person, d: Person, tag: Date) defeasible {
    label de official "Der fahrlässig handelnde Beamte kann subsidiär in Anspruch genommen werden (§ 839)";
    label en unofficial "The negligent official may be held subsidiarily liable (§ 839)";
    when beamter(h, b) and geschaedigter_dritter(h, d)
     and amtshaftung_839_fahrlaessig_beginn_am(h, tag);
    then liberty LibertyAmtshaftung839Fahrlaessig {
        holder b;
        action amtshaftung_839_fahrlaessig_beginn_am(h, tag);
        window [tag, infinity);
    };
}

pub relation sachverstaendigenhaftung_839a_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der Sachverständigenhaftung nach § 839a";
    label en unofficial "start of court-expert liability under § 839a";
}
@source(BGB_P839a)
rule PositionSachverstaendigenhaftung839a(h: Handlung, s: Person, b: Person, tag: Date) defeasible {
    label de official "Der gerichtliche Sachverständige haftet dem Verfahrensbeteiligten (§ 839a)";
    label en unofficial "The court-appointed expert is liable to the party (§ 839a)";
    when gerichtlicher_sachverstaendiger(h, s) and verfahrensbeteiligter(h, b)
     and sachverstaendigenhaftung_839a_beginn_am(h, tag);
    then liberty LibertySachverstaendigenhaftung839a {
        holder s;
        action sachverstaendigenhaftung_839a_beginn_am(h, tag);
        window [tag, infinity);
    };
}
