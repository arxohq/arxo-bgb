@source(BGB_P844)
rule PositionBeerdigung844(h: Handlung, p: Person, betrag: Money, tag: Date) defeasible {
    label de official "Der Ersatzpflichtige hat die Beerdigungskosten dem Kostenträger zu ersetzen (§ 844)";
    label en unofficial "The liable person must reimburse funeral costs to the person bearing them (§ 844)";
    when toetung(h) and beerdigungskostenpflichtiger(h, p) and beerdigungskosten(h, betrag);
    when handlungstag(h, tag);
    then duty Duty844Beerdigung {
        bearer p;
        beneficiary p;
        achieve ersatzanspruch_dritter(h, p, betrag) during [tag, infinity);
    };
}

@source(BGB_P845)
rule PositionEntgangeneDienste845(h: Handlung, p: Person, betrag: Money, tag: Date) defeasible {
    label de official "Der Ersatzpflichtige hat dem Dritten entgangene Dienste durch Geldrente zu ersetzen (§ 845)";
    label en unofficial "The liable person must compensate the third party for lost services by annuity (§ 845)";
    when dienstverpflichtung_kraft_gesetzes(h, p) and wert_der_entgehenden_dienste(h, p, betrag);
    when handlungstag(h, tag);
    then duty Duty845EntgangeneDienste {
        bearer p;
        beneficiary p;
        achieve ersatzanspruch_dritter(h, p, betrag) during [tag, infinity);
    };
}

@source(BGB_P844)
rule PositionHinterbliebenengeld844(h: Handlung, p: Person, betrag: Money, tag: Date) defeasible {
    label de official "Der Ersatzpflichtige hat dem Hinterbliebenen eine angemessene Entschädigung für seelisches Leid zu leisten (§ 844)";
    label en unofficial "The liable person must pay the surviving dependant reasonable compensation for mental suffering (§ 844)";
    when toetung(h) and hinterbliebener(h, p)
     and naeheverhaeltnis_festgestellt(h, p)
     and angemessene_entschaedigung_in_geld(h, p, betrag);
    when handlungstag(h, tag);
    then duty Duty844Hinterbliebenengeld {
        bearer p;
        beneficiary p;
        achieve hinterbliebenengeld(h, p, betrag) during [tag, infinity);
    };
}
