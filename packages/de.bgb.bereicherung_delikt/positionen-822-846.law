pub relation herausgabe_822_beginn_am(b: Bereicherung, tag: Date) kind empirical {
    label de official "Beginn der Herausgabe durch den Dritten nach § 822";
    label en unofficial "start of the third party's handover under § 822";
}
@source(BGB_P822)
rule PositionHerausgabe822(b: Bereicherung, d: Person, g: Person, tag: Date) defeasible {
    label de official "Der Dritte hat die unentgeltlich erhaltene Bereicherung herauszugeben (§ 822)";
    label en unofficial "The third party must hand over the enrichment received gratuitously (§ 822)";
    when unentgeltlich_zugewendet_an(b, d) and entreicherter(b, g)
     and herausgabe_822_beginn_am(b, tag);
    then liberty Liberty822Herausgabe {
        holder d;
        action herausgabe_822_beginn_am(b, tag);
        window [tag, infinity);
    };
}

pub relation ausgleich_841_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der alleinigen Innenverpflichtung nach § 841";
    label en unofficial "start of sole internal liability under § 841";
}
@source(BGB_P841)
rule PositionAusgleich841(h: Handlung, a: Person, tag: Date) defeasible {
    label de official "Der Geschäftsführer trägt im Innenverhältnis allein die Verpflichtung (§ 841)";
    label en unofficial "The manager alone bears the internal liability (§ 841)";
    when geschaeftsfuehrer_des_841(h, a) and ausgleich_841_beginn_am(h, tag);
    then liberty Liberty841Ausgleich {
        holder a;
        action ausgleich_841_beginn_am(h, tag);
        window [tag, infinity);
    };
}

pub relation minderung_846_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der Minderung des Drittanspruchs nach § 846";
    label en unofficial "start of the third party claim reduction under § 846";
}
@source(BGB_P846)
rule PositionMinderung846(h: Handlung, d: Person, tag: Date) defeasible {
    label de official "Der Drittanspruch wird wegen Mitverschuldens gemindert (§ 846)";
    label en unofficial "The third party claim is reduced for contributory fault (§ 846)";
    when verschulden_des_verletzten_mitgewirkt(h) and verletzter(h, d)
     and minderung_846_beginn_am(h, tag);
    then liberty Liberty846Minderung {
        holder d;
        action minderung_846_beginn_am(h, tag);
        window [tag, infinity);
    };
}
