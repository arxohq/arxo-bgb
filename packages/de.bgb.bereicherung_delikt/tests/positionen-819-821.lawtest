language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";

test "§§ 819 bis 821: Rechtsfolgen aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "p819": empfaenger(entity_ref("urn:de:bgb:bereicherung:b819"), entity_ref("urn:de:bgb:person:p819")) { origin case_input; }
        assert "s819": verschaerfte_haftung_819_beginn_am(entity_ref("urn:de:bgb:bereicherung:b819"), @2026-06-01) { origin case_input; }
        assert "p820": empfaenger(entity_ref("urn:de:bgb:bereicherung:b820"), entity_ref("urn:de:bgb:person:p820")) { origin case_input; }
        assert "s820": zinspflicht_820_beginn_am(entity_ref("urn:de:bgb:bereicherung:b820"), @2026-06-02) { origin case_input; }
        assert "p821": empfaenger(entity_ref("urn:de:bgb:bereicherung:b821"), entity_ref("urn:de:bgb:person:p821")) { origin case_input; }
        assert "v821": verbindlichkeit_ohne_rechtlichen_grund_eingegangen(entity_ref("urn:de:bgb:bereicherung:b821")) { origin case_input; }
        assert "s821": einrede_821_beginn_am(entity_ref("urn:de:bgb:bereicherung:b821"), @2026-06-03) { origin case_input; }
    }
    evaluate positions();
    expect position(Liberty819VerschaerfteHaftung, ACTIVE);
    expect position(Liberty820Zinsen, ACTIVE);
    expect position(Liberty821Einrede, ACTIVE);
}

test "§§ 819 bis 821: ohne Voraussetzungen keine Position" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(Liberty819VerschaerfteHaftung, ACTIVE);
    expect not position(Liberty820Zinsen, ACTIVE);
    expect not position(Liberty821Einrede, ACTIVE);
}
