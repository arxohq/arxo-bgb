language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// Abwesenheit ist keine Verneinung: ohne Angabe zur Entreicherung bleibt der geschuldete Betrag offen, obwohl die Wertersatzpflicht feststeht. Mit ausdrücklicher Verneinung wäre der volle Wert geschuldet — Kanarienvogel zu b06.
test "§ 818 Abs. 3: ohne Angabe zur Entreicherung bleibt der geschuldete Betrag offen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": leistung_erbracht(entity_ref("urn:de:bgb:bd:b07")) { origin case_input; }
        assert "f2": etwas_erlangt(entity_ref("urn:de:bgb:bd:b07")) { origin case_input; }
        assert "f3": ohne_rechtlichen_grund(entity_ref("urn:de:bgb:bd:b07")) { origin case_input; }
        assert "f4": herausgabe_nicht_moeglich(entity_ref("urn:de:bgb:bd:b07")) { origin case_input; }
        assert "f5": wert_des_erlangten(entity_ref("urn:de:bgb:bd:b07"), 10000.00 EUR) { origin case_input; }
    }
    evaluate truth(wertersatzpflicht(entity_ref("urn:de:bgb:bd:b07"), 10000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(geschuldeter_betrag(entity_ref("urn:de:bgb:bd:b07"), 10000.00 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
