language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// Negativer Fall zu § 254: kein Mitverschulden des V festgestellt (ausdrückliche Angabe) — der volle Schaden von 10.000,00 € bleibt zu ersetzen (§ 254 Abs. 1 im Umkehrschluss, de.bgb.schuldrecht_at::OhneMitverschuldenVollerErsatz).
test "Querschnitt: ohne festgestelltes Mitverschulden bleibt der volle Ersatz von 10.000,00 €" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": verletzung_koerper(entity_ref("urn:de:bgb:bd:q02")) { origin case_input; }
        assert "f2": kein_rechtfertigungsgrund(entity_ref("urn:de:bgb:bd:q02")) { origin case_input; }
        assert "f3": kausal_verursacht(entity_ref("urn:de:bgb:bd:q02")) { origin case_input; }
        assert "f4": handelnder(entity_ref("urn:de:bgb:bd:q02"), entity_ref("urn:de:bgb:bd:q02:S")) { origin case_input; }
        assert "f5": verletzter(entity_ref("urn:de:bgb:bd:q02"), entity_ref("urn:de:bgb:bd:q02:V")) { origin case_input; }
        assert "j1": fahrlaessigkeit(entity_ref("urn:de:bgb:bd:q02")) { origin adjudicated; }
        assert "j2": not vorsatz(entity_ref("urn:de:bgb:bd:q02")) { origin adjudicated; }
        assert "f6": schaden_fuer_249(entity_ref("urn:de:bgb:bd:q02"), entity_ref("urn:de:bgb:bd:q02:Sch")) { origin case_input; }
        assert "f7": de.bgb.schuldrecht_at::zum_schadensersatz_verpflichtet(entity_ref("urn:de:bgb:bd:q02:Sch"), entity_ref("urn:de:bgb:bd:q02:S")) { origin case_input; }
        assert "f8": de.bgb.schuldrecht_at::geschaedigter(entity_ref("urn:de:bgb:bd:q02:Sch"), entity_ref("urn:de:bgb:bd:q02:V")) { origin case_input; }
        assert "f9": de.bgb.schuldrecht_at::schadensbetrag(entity_ref("urn:de:bgb:bd:q02:Sch"), 10000.00 EUR) { origin case_input; }
        assert "f10": de.bgb.schuldrecht_at::kein_entgangener_gewinn_geltend_gemacht(entity_ref("urn:de:bgb:bd:q02:Sch")) { origin case_input; }
        assert "f11": de.bgb.schuldrecht_at::kein_mitverschulden_festgestellt(entity_ref("urn:de:bgb:bd:q02:Sch"), entity_ref("urn:de:bgb:bd:q02:V")) { origin case_input; }
    }
    evaluate truth(de.bgb.schuldrecht_at::ersatzbetrag_nach_mitverschulden(entity_ref("urn:de:bgb:bd:q02:Sch"), 10000.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(deliktischer_schadensersatz(entity_ref("urn:de:bgb:bd:q02"), 10000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect applied(DeliktischerSchadensersatzDerHoeheNach);
    evaluate truth(deliktischer_schadensersatz(entity_ref("urn:de:bgb:bd:q02"), 7500.00 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
