language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";

test "§§ 822, 841 und 846: Rechtsfolgen aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "d822": unentgeltlich_zugewendet_an(entity_ref("urn:de:bgb:bereicherung:b822"), entity_ref("urn:de:bgb:person:d822")) { origin case_input; }
        assert "g822": entreicherter(entity_ref("urn:de:bgb:bereicherung:b822"), entity_ref("urn:de:bgb:person:g822")) { origin case_input; }
        assert "b822": herausgabe_822_beginn_am(entity_ref("urn:de:bgb:bereicherung:b822"), @2026-06-01) { origin case_input; }
        assert "a841": geschaeftsfuehrer_des_841(entity_ref("urn:de:bgb:handlung:h841"), entity_ref("urn:de:bgb:person:a841")) { origin case_input; }
        assert "b841": ausgleich_841_beginn_am(entity_ref("urn:de:bgb:handlung:h841"), @2026-06-02) { origin case_input; }
        assert "v846": verschulden_des_verletzten_mitgewirkt(entity_ref("urn:de:bgb:handlung:h846")) { origin case_input; }
        assert "p846": verletzter(entity_ref("urn:de:bgb:handlung:h846"), entity_ref("urn:de:bgb:person:d846")) { origin case_input; }
        assert "b846": minderung_846_beginn_am(entity_ref("urn:de:bgb:handlung:h846"), @2026-06-03) { origin case_input; }
    }
    evaluate positions();
    expect position(Liberty822Herausgabe, ACTIVE);
    expect position(Liberty841Ausgleich, ACTIVE);
    expect position(Liberty846Minderung, ACTIVE);
}

test "§§ 822, 841 und 846: ohne Voraussetzungen keine Position" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(Liberty822Herausgabe, ACTIVE);
    expect not position(Liberty841Ausgleich, ACTIVE);
    expect not position(Liberty846Minderung, ACTIVE);
}
