language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";

test "§§ 831 bis 833: Haftungspflichten aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "h831": geschaeftsherr(entity_ref("urn:de:bgb:handlung:h831"), entity_ref("urn:de:bgb:person:gh")) { origin case_input; }
        assert "d831": geschaedigter_dritter(entity_ref("urn:de:bgb:handlung:h831"), entity_ref("urn:de:bgb:person:d831")) { origin case_input; }
        assert "h832": aufsichtspflichtiger_kraft_gesetzes(entity_ref("urn:de:bgb:handlung:h832"), entity_ref("urn:de:bgb:person:a")) { origin case_input; }
        assert "d832": geschaedigter_dritter(entity_ref("urn:de:bgb:handlung:h832"), entity_ref("urn:de:bgb:person:d832")) { origin case_input; }
        assert "h833": tierhalter(entity_ref("urn:de:bgb:handlung:h833"), entity_ref("urn:de:bgb:person:p")) { origin case_input; }
        assert "d833": verletzter(entity_ref("urn:de:bgb:handlung:h833"), entity_ref("urn:de:bgb:person:d833")) { origin case_input; }
        assert "t831": handlungstag(entity_ref("urn:de:bgb:handlung:h831"), @2026-06-01) { origin case_input; }
        assert "t832": handlungstag(entity_ref("urn:de:bgb:handlung:h832"), @2026-06-02) { origin case_input; }
        assert "t833": handlungstag(entity_ref("urn:de:bgb:handlung:h833"), @2026-06-03) { origin case_input; }
    }
    evaluate positions();
    expect position(Duty831Geschaeftsherr, ACTIVE);
    expect position(Duty832Aufsichtspflichtiger, ACTIVE);
    expect position(Duty833Tierhalter, ACTIVE);
}

test "§§ 831 bis 833: ohne Haftungsgrund keine Position" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(Duty831Geschaeftsherr, ACTIVE);
    expect not position(Duty832Aufsichtspflichtiger, ACTIVE);
    expect not position(Duty833Tierhalter, ACTIVE);
}
