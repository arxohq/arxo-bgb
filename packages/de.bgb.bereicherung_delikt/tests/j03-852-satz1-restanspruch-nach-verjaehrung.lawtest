language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 852 Satz 1: der Ersatzanspruch ist am 10. März 2018 entstanden, im selben Jahr hat der Gläubiger Kenntnis erlangt; die regelmäßige Verjährung läuft vom Schluss des Jahres (§ 199 Abs. 1) drei Jahre und tritt mit Ablauf des 31. Dezember 2021 ein (de.bgb.fristen). Von da an bleibt die Herausgabepflicht nach Bereicherungsrecht.
test "§ 852 Satz 1: nach Eintritt der Verjährung bleibt der Herausgabeanspruch" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": etwas_auf_kosten_des_verletzten_erlangt(entity_ref("urn:de:bgb:bd:j03")) { origin case_input; }
        assert "f2": schadensersatzanspruch(entity_ref("urn:de:bgb:bd:j03"), entity_ref("urn:de:bgb:bd:j03:A")) { origin case_input; }
        assert "f3": handelnder(entity_ref("urn:de:bgb:bd:j03"), entity_ref("urn:de:bgb:bd:j03:S")) { origin case_input; }
        assert "f4": verletzter(entity_ref("urn:de:bgb:bd:j03"), entity_ref("urn:de:bgb:bd:j03:V")) { origin case_input; }
        assert "f5": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:bd:j03:A"), @2018-03-10) { origin case_input; }
        assert "f6": de.bgb.fristen::kenntnis_erlangt_am(entity_ref("urn:de:bgb:bd:j03:A"), @2018-03-10) { origin adjudicated; }
        assert "f7": de.bgb.fristen::keine_hemmung(entity_ref("urn:de:bgb:bd:j03:A")) { origin case_input; }
    }
    evaluate truth(de.bgb.fristen::verjaehrung_eingetreten_am(entity_ref("urn:de:bgb:bd:j03:A"), @2021-12-31));
    expect truth_status == TRUE_ONLY;
    evaluate truth(restschadensersatzanspruch(entity_ref("urn:de:bgb:bd:j03"), entity_ref("urn:de:bgb:bd:j03:S"), entity_ref("urn:de:bgb:bd:j03:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
