language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";

test "§§ 813, 816 und 817: Herausgabe und Rückforderung aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "l813": leistender_813(entity_ref("urn:de:bgb:bereicherung:b813"), entity_ref("urn:de:bgb:person:performer")) { origin case_input; }
        assert "g813": rueckforderungsgrund_813(entity_ref("urn:de:bgb:bereicherung:b813")) { origin case_input; }
        assert "n816": verfuegung_eines_nichtberechtigten(entity_ref("urn:de:bgb:bereicherung:b816")) { origin case_input; }
        assert "e816": herausgabe_816_beteiligte(entity_ref("urn:de:bgb:bereicherung:b816"), entity_ref("urn:de:bgb:person:recipient"), entity_ref("urn:de:bgb:person:entitled")) { origin case_input; }
        assert "h816": herausgabe_816_beginn_am(entity_ref("urn:de:bgb:bereicherung:b816"), @2026-06-02) { origin case_input; }
        assert "e817": herausgabe_817_empfaenger(entity_ref("urn:de:bgb:bereicherung:b817"), entity_ref("urn:de:bgb:person:recipient817")) { origin case_input; }
        assert "v817": verstoss_des_empfaengers(entity_ref("urn:de:bgb:bereicherung:b817")) { origin case_input; }
        assert "x817": etwas_erlangt(entity_ref("urn:de:bgb:bereicherung:b817")) { origin case_input; }
        assert "h817": herausgabe_817_beginn_am(entity_ref("urn:de:bgb:bereicherung:b817"), @2026-06-03) { origin case_input; }
        assert "t813": leistungstag(entity_ref("urn:de:bgb:bereicherung:b813"), @2026-06-01) { origin case_input; }
        assert "t816": leistungstag(entity_ref("urn:de:bgb:bereicherung:b816"), @2026-06-02) { origin case_input; }
        assert "t817": leistungstag(entity_ref("urn:de:bgb:bereicherung:b817"), @2026-06-03) { origin case_input; }
    }
    evaluate positions();
    expect position(Liberty813Rueckforderung, ACTIVE);
    expect position(Liberty816Herausgabe, ACTIVE);
    expect position(Liberty817Herausgabe, ACTIVE);
}

test "§§ 813, 816 und 817: ohne Voraussetzungen keine Position" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(Liberty813Rueckforderung, ACTIVE);
    expect not position(Liberty816Herausgabe, ACTIVE);
    expect not position(Liberty817Herausgabe, ACTIVE);
}
