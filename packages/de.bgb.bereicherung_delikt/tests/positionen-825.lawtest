language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";

test "§ 825: Ersatzpflicht aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "s": handelnder(entity_ref("urn:de:bgb:handlung:h825"), entity_ref("urn:de:bgb:person:inducer")) { origin case_input; }
        assert "v": verletzter(entity_ref("urn:de:bgb:handlung:h825"), entity_ref("urn:de:bgb:person:injured")) { origin case_input; }
        assert "b": haftung_825_beginn_am(entity_ref("urn:de:bgb:handlung:h825"), @2026-06-01) { origin case_input; }
    }
    evaluate positions();
    expect position(LibertyHaftung825, ACTIVE);
}

test "§ 825: ohne Voraussetzungen keine Position" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(LibertyHaftung825, ACTIVE);
}
