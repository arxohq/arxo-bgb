language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";

test "§§ 839 und 839a: Amtshaftung aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "b839": beamter(entity_ref("urn:de:bgb:handlung:h839"), entity_ref("urn:de:bgb:person:b839")) { origin case_input; }
        assert "d839": geschaedigter_dritter(entity_ref("urn:de:bgb:handlung:h839"), entity_ref("urn:de:bgb:person:d839")) { origin case_input; }
        assert "a839": amtshaftung_839_beginn_am(entity_ref("urn:de:bgb:handlung:h839"), @2026-06-01) { origin case_input; }
        assert "bf839": beamter(entity_ref("urn:de:bgb:handlung:h839f"), entity_ref("urn:de:bgb:person:bf839")) { origin case_input; }
        assert "df839": geschaedigter_dritter(entity_ref("urn:de:bgb:handlung:h839f"), entity_ref("urn:de:bgb:person:df839")) { origin case_input; }
        assert "af839": amtshaftung_839_fahrlaessig_beginn_am(entity_ref("urn:de:bgb:handlung:h839f"), @2026-06-02) { origin case_input; }
        assert "s839a": gerichtlicher_sachverstaendiger(entity_ref("urn:de:bgb:handlung:h839a"), entity_ref("urn:de:bgb:person:expert")) { origin case_input; }
        assert "p839a": verfahrensbeteiligter(entity_ref("urn:de:bgb:handlung:h839a"), entity_ref("urn:de:bgb:person:party")) { origin case_input; }
        assert "a839a": sachverstaendigenhaftung_839a_beginn_am(entity_ref("urn:de:bgb:handlung:h839a"), @2026-06-03) { origin case_input; }
    }
    evaluate positions();
    expect position(LibertyAmtshaftung839, ACTIVE);
    expect position(LibertyAmtshaftung839Fahrlaessig, ACTIVE);
    expect position(LibertySachverstaendigenhaftung839a, ACTIVE);
}

test "§§ 839 und 839a: ohne Voraussetzungen keine Position" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(LibertyAmtshaftung839, ACTIVE);
    expect not position(LibertyAmtshaftung839Fahrlaessig, ACTIVE);
    expect not position(LibertySachverstaendigenhaftung839a, ACTIVE);
}
