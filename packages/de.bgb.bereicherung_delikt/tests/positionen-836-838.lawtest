language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";

test "§§ 836 bis 838: Gebäudehaftung aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "b836": eigenbesitzer_des_grundstuecks(entity_ref("urn:de:bgb:handlung:h836"), entity_ref("urn:de:bgb:person:b836")) { origin case_input; }
        assert "v836": verletzter(entity_ref("urn:de:bgb:handlung:h836"), entity_ref("urn:de:bgb:person:v836")) { origin case_input; }
        assert "t836": gebaeudehaftung_836_beginn_am(entity_ref("urn:de:bgb:handlung:h836"), @2026-06-01) { origin case_input; }
        assert "b837": gebaeudebesitzer_auf_fremdem_grundstueck(entity_ref("urn:de:bgb:handlung:h837"), entity_ref("urn:de:bgb:person:b837")) { origin case_input; }
        assert "v837": verletzter(entity_ref("urn:de:bgb:handlung:h837"), entity_ref("urn:de:bgb:person:v837")) { origin case_input; }
        assert "t837": gebaeudehaftung_837_beginn_am(entity_ref("urn:de:bgb:handlung:h837"), @2026-06-02) { origin case_input; }
        assert "u838": unterhaltungspflichtiger(entity_ref("urn:de:bgb:handlung:h838"), entity_ref("urn:de:bgb:person:u838")) { origin case_input; }
        assert "v838": verletzter(entity_ref("urn:de:bgb:handlung:h838"), entity_ref("urn:de:bgb:person:v838")) { origin case_input; }
        assert "t838": gebaeudehaftung_838_beginn_am(entity_ref("urn:de:bgb:handlung:h838"), @2026-06-03) { origin case_input; }
    }
    evaluate positions();
    expect position(LibertyGebaeudehaftung836, ACTIVE);
    expect position(LibertyGebaeudehaftung837, ACTIVE);
    expect position(LibertyGebaeudehaftung838, ACTIVE);
}

test "§§ 836 bis 838: ohne Haftungsgrund keine Position" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(LibertyGebaeudehaftung836, ACTIVE);
    expect not position(LibertyGebaeudehaftung837, ACTIVE);
    expect not position(LibertyGebaeudehaftung838, ACTIVE);
}
