language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 812 Abs. 2: als Leistung gilt auch die durch Vertrag erfolgte Anerkennung des Bestehens oder Nichtbestehens eines Schuldverhältnisses — ohne eigene Leistungshandlung entsteht die Leistungskondiktion.
test "§ 812 Abs. 2: das vertragliche Anerkenntnis gilt als Leistung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": anerkenntnis_durch_vertrag(entity_ref("urn:de:bgb:bd:b05")) { origin case_input; }
        assert "f2": etwas_erlangt(entity_ref("urn:de:bgb:bd:b05")) { origin case_input; }
        assert "f3": ohne_rechtlichen_grund(entity_ref("urn:de:bgb:bd:b05")) { origin case_input; }
    }
    evaluate truth(leistung(entity_ref("urn:de:bgb:bd:b05")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(AnerkenntnisGiltAlsLeistung);
    evaluate truth(herausgabepflicht_leistung(entity_ref("urn:de:bgb:bd:b05")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
