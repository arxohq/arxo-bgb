language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 812 Abs. 1 Satz 1 Alternative 1: geleistet ohne rechtlichen Grund. Ohne Ausschluss der §§ 814, 817 Satz 2 ist der Anspruch durchsetzbar.
test "§ 812 Abs. 1 Satz 1: Leistungskondiktion ohne rechtlichen Grund" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": leistung_erbracht(entity_ref("urn:de:bgb:bd:b01")) { origin case_input; }
        assert "f2": etwas_erlangt(entity_ref("urn:de:bgb:bd:b01")) { origin case_input; }
        assert "f3": ohne_rechtlichen_grund(entity_ref("urn:de:bgb:bd:b01")) { origin case_input; }
        assert "f4": empfaenger(entity_ref("urn:de:bgb:bd:b01"), entity_ref("urn:de:bgb:bd:b01:E")) { origin case_input; }
        assert "f5": entreicherter(entity_ref("urn:de:bgb:bd:b01"), entity_ref("urn:de:bgb:bd:b01:L")) { origin case_input; }
    }
    evaluate truth(herausgabepflicht_leistung(entity_ref("urn:de:bgb:bd:b01")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(bereicherungsanspruch(entity_ref("urn:de:bgb:bd:b01")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
