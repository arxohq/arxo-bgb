language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 853: der Schädiger hat durch die unerlaubte Handlung eine Forderung gegen den Verletzten erlangt — der Verletzte kann die Erfüllung auch dann verweigern, wenn der Anspruch auf Aufhebung der Forderung verjährt ist.
test "§ 853: Arglisteinrede gegen die erschlichene Forderung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": forderung_durch_unerlaubte_handlung_erlangt(entity_ref("urn:de:bgb:bd:j04")) { origin case_input; }
        assert "f2": verletzter(entity_ref("urn:de:bgb:bd:j04"), entity_ref("urn:de:bgb:bd:j04:V")) { origin case_input; }
    }
    evaluate truth(arglisteinrede(entity_ref("urn:de:bgb:bd:j04"), entity_ref("urn:de:bgb:bd:j04:V")));
    expect truth_status == TRUE_ONLY;
    expect applied(Arglisteinrede853);
    expect evaluation_status == COMPUTED;
}
