language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 832 Abs. 1: die beaufsichtigungsbedürftige Person ist minderjährig und hat einem Dritten widerrechtlich Schaden zugefügt; das Gericht hat beide Entlastungsgründe des Satzes 2 verneint.
test "§ 832 Abs. 1: der kraft Gesetzes Aufsichtspflichtige haftet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": aufsichtspflichtiger_kraft_gesetzes(entity_ref("urn:de:bgb:bd:p03"), entity_ref("urn:de:bgb:bd:p03:A")) { origin case_input; }
        assert "f2": beaufsichtigung_wegen_minderjaehrigkeit_erforderlich(entity_ref("urn:de:bgb:bd:p03")) { origin case_input; }
        assert "f3": kein_rechtfertigungsgrund(entity_ref("urn:de:bgb:bd:p03")) { origin case_input; }
        assert "f4": geschaedigter_dritter(entity_ref("urn:de:bgb:bd:p03"), entity_ref("urn:de:bgb:bd:p03:D")) { origin case_input; }
        assert "f5": kausal_verursacht(entity_ref("urn:de:bgb:bd:p03")) { origin case_input; }
        assert "j1": not aufsichtspflicht_genuegt(entity_ref("urn:de:bgb:bd:p03")) { origin adjudicated; }
        assert "j2": not schaden_auch_bei_gehoeriger_aufsicht_entstanden(entity_ref("urn:de:bgb:bd:p03")) { origin adjudicated; }
    }
    evaluate truth(aufsichtsbeduerftigkeit(entity_ref("urn:de:bgb:bd:p03")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(haftung_832(entity_ref("urn:de:bgb:bd:p03"), entity_ref("urn:de:bgb:bd:p03:A"), entity_ref("urn:de:bgb:bd:p03:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
