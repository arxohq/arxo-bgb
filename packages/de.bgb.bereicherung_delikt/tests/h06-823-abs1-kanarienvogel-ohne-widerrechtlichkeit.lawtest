language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// Kanarienvogel zu h01: minus EIN Merkmal. Ohne die ausdrückliche Angabe, dass kein Rechtfertigungsgrund vorliegt, entsteht kein Haftungsgrund — Abwesenheit einer Angabe ist keine Verneinung.
test "§ 823 Abs. 1: ohne Angabe zur Widerrechtlichkeit kein Haftungsgrund" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": verletzung_koerper(entity_ref("urn:de:bgb:bd:h06")) { origin case_input; }
        assert "f3": kausal_verursacht(entity_ref("urn:de:bgb:bd:h06")) { origin case_input; }
        assert "f4": handelnder(entity_ref("urn:de:bgb:bd:h06"), entity_ref("urn:de:bgb:bd:h06:S")) { origin case_input; }
        assert "f5": verletzter(entity_ref("urn:de:bgb:bd:h06"), entity_ref("urn:de:bgb:bd:h06:V")) { origin case_input; }
        assert "j1": fahrlaessigkeit(entity_ref("urn:de:bgb:bd:h06")) { origin adjudicated; }
        assert "j2": not vorsatz(entity_ref("urn:de:bgb:bd:h06")) { origin adjudicated; }
    }
    evaluate truth(rechtsgutverletzung(entity_ref("urn:de:bgb:bd:h06")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(haftungsgrund_823_abs1(entity_ref("urn:de:bgb:bd:h06")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
