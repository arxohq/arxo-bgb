language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 844 Abs. 3 Satz 2: der Hinterbliebene war der Ehegatte des Getöteten — das besondere persönliche Näheverhältnis wird vermutet und ist hier nicht widerlegt. Die Höhe der Entschädigung für das seelische Leid bestimmt das Gericht (12.000,00 €).
test "§ 844 Abs. 3: vermutetes Näheverhältnis des Ehegatten trägt das Hinterbliebenengeld" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": verletzung_leben(entity_ref("urn:de:bgb:bd:d02")) { origin case_input; }
        assert "f2": kein_rechtfertigungsgrund(entity_ref("urn:de:bgb:bd:d02")) { origin case_input; }
        assert "f3": kausal_verursacht(entity_ref("urn:de:bgb:bd:d02")) { origin case_input; }
        assert "f4": handelnder(entity_ref("urn:de:bgb:bd:d02"), entity_ref("urn:de:bgb:bd:d02:S")) { origin case_input; }
        assert "f5": verletzter(entity_ref("urn:de:bgb:bd:d02"), entity_ref("urn:de:bgb:bd:d02:V")) { origin case_input; }
        assert "f6": toetung(entity_ref("urn:de:bgb:bd:d02")) { origin case_input; }
        assert "j1": fahrlaessigkeit(entity_ref("urn:de:bgb:bd:d02")) { origin adjudicated; }
        assert "j2": not vorsatz(entity_ref("urn:de:bgb:bd:d02")) { origin adjudicated; }
        assert "f7": hinterbliebener(entity_ref("urn:de:bgb:bd:d02"), entity_ref("urn:de:bgb:bd:d02:H")) { origin case_input; }
        assert "f8": hinterbliebener_ehegatte(entity_ref("urn:de:bgb:bd:d02"), entity_ref("urn:de:bgb:bd:d02:H")) { origin case_input; }
        assert "j3": not kein_besonderes_naeheverhaeltnis(entity_ref("urn:de:bgb:bd:d02"), entity_ref("urn:de:bgb:bd:d02:H")) { origin adjudicated; }
        assert "j4": not naeheverhaeltnis_festgestellt(entity_ref("urn:de:bgb:bd:d02"), entity_ref("urn:de:bgb:bd:d02:H")) { origin adjudicated; }
        assert "j5": angemessene_entschaedigung_in_geld(entity_ref("urn:de:bgb:bd:d02"), entity_ref("urn:de:bgb:bd:d02:H"), 12000.00 EUR) { origin adjudicated; }
    }
    evaluate truth(naeheverhaeltnis_grund(entity_ref("urn:de:bgb:bd:d02"), entity_ref("urn:de:bgb:bd:d02:H")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(besonderes_naeheverhaeltnis(entity_ref("urn:de:bgb:bd:d02"), entity_ref("urn:de:bgb:bd:d02:H")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(hinterbliebenengeld(entity_ref("urn:de:bgb:bd:d02"), entity_ref("urn:de:bgb:bd:d02:H"), 12000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
