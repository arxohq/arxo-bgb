language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 823 Abs. 2 Satz 1: Verstoß gegen ein Schutzgesetz, das den Verstoß nur bei Verschulden kennt — die Ersatzpflicht folgt aus dem Verstoß selbst. Das Schutzgesetz ist fremdes Recht und kommt als Eingabe des Falls herein.
test "§ 823 Abs. 2: Verstoß gegen ein verschuldensabhängiges Schutzgesetz" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": schutzgesetzverstoss(entity_ref("urn:de:bgb:bd:h03"), entity_ref("urn:de:bgb:bd:h03:G")) { origin case_input; }
        assert "f2": verstoss_nur_mit_verschulden_moeglich(entity_ref("urn:de:bgb:bd:h03:G")) { origin case_input; }
        assert "f3": kausal_verursacht(entity_ref("urn:de:bgb:bd:h03")) { origin case_input; }
        assert "f4": handelnder(entity_ref("urn:de:bgb:bd:h03"), entity_ref("urn:de:bgb:bd:h03:S")) { origin case_input; }
        assert "f5": verletzter(entity_ref("urn:de:bgb:bd:h03"), entity_ref("urn:de:bgb:bd:h03:V")) { origin case_input; }
        assert "j1": not vorsatz(entity_ref("urn:de:bgb:bd:h03")) { origin adjudicated; }
        assert "j2": not fahrlaessigkeit(entity_ref("urn:de:bgb:bd:h03")) { origin adjudicated; }
    }
    evaluate truth(haftungsgrund_823_abs2(entity_ref("urn:de:bgb:bd:h03")));
    expect truth_status == TRUE_ONLY;
    expect applied(Haftung823Abs2VerschuldensabhaengigesSchutzgesetz);
    evaluate truth(schadensersatzpflicht(entity_ref("urn:de:bgb:bd:h03"), entity_ref("urn:de:bgb:bd:h03:S"), entity_ref("urn:de:bgb:bd:h03:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
