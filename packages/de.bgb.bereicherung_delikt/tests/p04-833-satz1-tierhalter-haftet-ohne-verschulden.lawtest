language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 833 Satz 1: ein Tier hat den Körper eines Menschen verletzt. Der Tierhalter haftet ohne Verschulden; das Tier ist kein Nutztier, die Entlastung des Satzes 2 ist nicht eröffnet.
test "§ 833 Satz 1: der Tierhalter haftet ohne Verschulden" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": tier_der_handlung(entity_ref("urn:de:bgb:bd:p04"), entity_ref("urn:de:bgb:bd:p04:T")) { origin case_input; }
        assert "f2": koerper_durch_tier_verletzt(entity_ref("urn:de:bgb:bd:p04")) { origin case_input; }
        assert "f3": tierhalter(entity_ref("urn:de:bgb:bd:p04"), entity_ref("urn:de:bgb:bd:p04:H")) { origin case_input; }
        assert "f4": verletzter(entity_ref("urn:de:bgb:bd:p04"), entity_ref("urn:de:bgb:bd:p04:V")) { origin case_input; }
    }
    evaluate truth(tierschaden(entity_ref("urn:de:bgb:bd:p04")));
    expect truth_status == TRUE_ONLY;
    expect applied(Tierschaden833Koerper);
    evaluate truth(haftung_833(entity_ref("urn:de:bgb:bd:p04"), entity_ref("urn:de:bgb:bd:p04:H"), entity_ref("urn:de:bgb:bd:p04:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
