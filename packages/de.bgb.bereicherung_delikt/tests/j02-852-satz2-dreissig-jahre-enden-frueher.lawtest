language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// Andere Seite des § 852 Satz 2: die Verletzungshandlung liegt am 15. Januar 1990 (dreißig Jahre → 15. Januar 2020), der Anspruch ist erst am 1. Juni 2015 entstanden (zehn Jahre → 1. Juni 2025). „Ohne Rücksicht auf die Entstehung“: die dreißigjährige Frist endet früher.
test "§ 852 Satz 2: die dreißigjährige Frist endet früher als die zehnjährige" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": etwas_auf_kosten_des_verletzten_erlangt(entity_ref("urn:de:bgb:bd:j02")) { origin case_input; }
        assert "f2": restanspruch_entstanden_am(entity_ref("urn:de:bgb:bd:j02"), @2015-06-01) { origin case_input; }
        assert "f3": handlungstag(entity_ref("urn:de:bgb:bd:j02"), @1990-01-15) { origin case_input; }
    }
    evaluate truth(restanspruch_frist_dreissig_jahre(entity_ref("urn:de:bgb:bd:j02"), @2020-01-15));
    expect truth_status == TRUE_ONLY;
    evaluate truth(restanspruch_verjaehrt_am(entity_ref("urn:de:bgb:bd:j02"), @2020-01-15));
    expect truth_status == TRUE_ONLY;
    expect applied(Restanspruch852VerjaehrtDreissigJahre);
    expect evaluation_status == COMPUTED;
}
