language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 824 Abs. 2: die Unwahrheit war dem Mitteilenden unbekannt und das Gericht hat ein berechtigtes Interesse an der Mitteilung festgestellt — die Ersatzpflicht des Absatzes 1 tritt nicht ein.
test "§ 824 Abs. 2: berechtigtes Interesse schließt die Ersatzpflicht aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": unwahre_tatsache_behauptet_oder_verbreitet(entity_ref("urn:de:bgb:bd:h05")) { origin case_input; }
        assert "f2": unwahrheit_dem_mitteilenden_unbekannt(entity_ref("urn:de:bgb:bd:h05")) { origin case_input; }
        assert "f3": kausal_verursacht(entity_ref("urn:de:bgb:bd:h05")) { origin case_input; }
        assert "j1": geeignet_kredit_zu_gefaehrden(entity_ref("urn:de:bgb:bd:h05")) { origin adjudicated; }
        assert "j2": unwahrheit_kennen_muessen(entity_ref("urn:de:bgb:bd:h05")) { origin adjudicated; }
        assert "j3": berechtigtes_interesse_an_der_mitteilung(entity_ref("urn:de:bgb:bd:h05")) { origin adjudicated; }
    }
    evaluate truth(ausschluss_824_abs2(entity_ref("urn:de:bgb:bd:h05")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(haftungsgrund_824(entity_ref("urn:de:bgb:bd:h05")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
