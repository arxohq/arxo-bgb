language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 844 Abs. 1: im Falle der Tötung hat der Ersatzpflichtige die Kosten der Beerdigung demjenigen zu ersetzen, welchem die Verpflichtung obliegt, sie zu tragen — hier 6.500,00 €.
test "§ 844 Abs. 1: Beerdigungskosten des Verpflichteten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": verletzung_leben(entity_ref("urn:de:bgb:bd:d01")) { origin case_input; }
        assert "f2": kein_rechtfertigungsgrund(entity_ref("urn:de:bgb:bd:d01")) { origin case_input; }
        assert "f3": kausal_verursacht(entity_ref("urn:de:bgb:bd:d01")) { origin case_input; }
        assert "f4": handelnder(entity_ref("urn:de:bgb:bd:d01"), entity_ref("urn:de:bgb:bd:d01:S")) { origin case_input; }
        assert "f5": verletzter(entity_ref("urn:de:bgb:bd:d01"), entity_ref("urn:de:bgb:bd:d01:V")) { origin case_input; }
        assert "f6": toetung(entity_ref("urn:de:bgb:bd:d01")) { origin case_input; }
        assert "j1": fahrlaessigkeit(entity_ref("urn:de:bgb:bd:d01")) { origin adjudicated; }
        assert "j2": not vorsatz(entity_ref("urn:de:bgb:bd:d01")) { origin adjudicated; }
        assert "f7": beerdigungskostenpflichtiger(entity_ref("urn:de:bgb:bd:d01"), entity_ref("urn:de:bgb:bd:d01:D")) { origin case_input; }
        assert "f8": beerdigungskosten(entity_ref("urn:de:bgb:bd:d01"), 6500.00 EUR) { origin case_input; }
    }
    evaluate truth(ersatzpflicht_dem_grunde_nach(entity_ref("urn:de:bgb:bd:d01")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(ersatzanspruch_dritter(entity_ref("urn:de:bgb:bd:d01"), entity_ref("urn:de:bgb:bd:d01:D"), 6500.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect applied(Beerdigungskosten844Abs1);
    expect evaluation_status == COMPUTED;
}
