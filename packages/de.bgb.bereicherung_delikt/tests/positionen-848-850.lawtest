language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";

test "§§ 848 bis 850: Rechtsfolgen aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "p848": verpflichteter_848(entity_ref("urn:de:bgb:handlung:h848"), entity_ref("urn:de:bgb:person:p848")) { origin case_input; }
        assert "v849": verletzter(entity_ref("urn:de:bgb:handlung:h849"), entity_ref("urn:de:bgb:person:v849")) { origin case_input; }
        assert "w849": wertminderung_oder_wert(entity_ref("urn:de:bgb:handlung:h849"), 1000.00 EUR) { origin case_input; }
        assert "d849": wertbestimmungstag(entity_ref("urn:de:bgb:handlung:h849"), @2026-06-02) { origin case_input; }
        assert "p850": verpflichteter_850(entity_ref("urn:de:bgb:handlung:h850"), entity_ref("urn:de:bgb:person:p850")) { origin case_input; }
        assert "t848": handlungstag(entity_ref("urn:de:bgb:handlung:h848"), @2026-06-01) { origin case_input; }
        assert "t850": handlungstag(entity_ref("urn:de:bgb:handlung:h850"), @2026-06-03) { origin case_input; }
    }
    evaluate positions();
    expect position(Duty848Zufallshaftung, ACTIVE);
    expect position(Liberty849Zinsanspruch, ACTIVE);
    expect position(Liberty850Verwendungen, ACTIVE);
}

test "§§ 848 bis 850: ohne Voraussetzungen keine Position" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(Duty848Zufallshaftung, ACTIVE);
    expect not position(Liberty849Zinsanspruch, ACTIVE);
    expect not position(Liberty850Verwendungen, ACTIVE);
}
