language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";

test "§§ 834, 842 und 843: Ersatzpflichten aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "a834": tieraufseher_durch_vertrag(entity_ref("urn:de:bgb:handlung:h834"), entity_ref("urn:de:bgb:person:a834")) { origin case_input; }
        assert "d834": geschaedigter_dritter(entity_ref("urn:de:bgb:handlung:h834"), entity_ref("urn:de:bgb:person:d834")) { origin case_input; }
        assert "p842": gegen_die_person_gerichtete_handlung(entity_ref("urn:de:bgb:handlung:h842")) { origin case_input; }
        assert "n842": nachteil_fuer_erwerb_oder_fortkommen(entity_ref("urn:de:bgb:handlung:h842")) { origin case_input; }
        assert "v842": verletzter(entity_ref("urn:de:bgb:handlung:h842"), entity_ref("urn:de:bgb:person:v842")) { origin case_input; }
        assert "e843": erwerbsfaehigkeit_aufgehoben_oder_gemindert(entity_ref("urn:de:bgb:handlung:h843")) { origin case_input; }
        assert "v843": verletzter(entity_ref("urn:de:bgb:handlung:h843"), entity_ref("urn:de:bgb:person:v843")) { origin case_input; }
        assert "r843": rentenbetrag(entity_ref("urn:de:bgb:handlung:h843"), 1000.00 EUR) { origin case_input; }
        assert "t834": handlungstag(entity_ref("urn:de:bgb:handlung:h834"), @2026-06-01) { origin case_input; }
        assert "t842": handlungstag(entity_ref("urn:de:bgb:handlung:h842"), @2026-06-02) { origin case_input; }
        assert "t843": handlungstag(entity_ref("urn:de:bgb:handlung:h843"), @2026-06-03) { origin case_input; }
    }
    evaluate positions();
    expect position(Duty834Tieraufseher, ACTIVE);
    expect position(Duty842Erwerbsnachteile, ACTIVE);
    expect position(Duty843Geldrente, ACTIVE);
}

test "§§ 834, 842 und 843: ohne Voraussetzungen keine Position" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(Duty834Tieraufseher, ACTIVE);
    expect not position(Duty842Erwerbsnachteile, ACTIVE);
    expect not position(Duty843Geldrente, ACTIVE);
}
