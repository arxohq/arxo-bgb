language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 826: „gegen die guten Sitten verstoßende Weise“ und Vorsatz sind beides Wertungen des Gerichts; beide sind beantwortet.
test "§ 826: sittenwidrige vorsätzliche Schädigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": schaden_zugefuegt(entity_ref("urn:de:bgb:bd:h04")) { origin case_input; }
        assert "f2": handelnder(entity_ref("urn:de:bgb:bd:h04"), entity_ref("urn:de:bgb:bd:h04:S")) { origin case_input; }
        assert "f3": verletzter(entity_ref("urn:de:bgb:bd:h04"), entity_ref("urn:de:bgb:bd:h04:V")) { origin case_input; }
        assert "j1": gegen_die_guten_sitten_verstossend(entity_ref("urn:de:bgb:bd:h04")) { origin adjudicated; }
        assert "j2": vorsatz(entity_ref("urn:de:bgb:bd:h04")) { origin adjudicated; }
        assert "j3": not fahrlaessigkeit(entity_ref("urn:de:bgb:bd:h04")) { origin adjudicated; }
    }
    evaluate truth(haftungsgrund_826(entity_ref("urn:de:bgb:bd:h04")));
    expect truth_status == TRUE_ONLY;
    expect applied(Haftung826);
    evaluate truth(schadensersatzpflicht(entity_ref("urn:de:bgb:bd:h04"), entity_ref("urn:de:bgb:bd:h04:S"), entity_ref("urn:de:bgb:bd:h04:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
