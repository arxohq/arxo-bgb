language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 815 Alternative 1: der Eintritt des Erfolgs war von Anfang an unmöglich und der Leistende hat dies gewusst. Der Ausschluss trifft NUR die Zweckverfehlungskondiktion.
test "§ 815: von Anfang an unmöglicher Erfolg schließt die Rückforderung aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": leistung_erbracht(entity_ref("urn:de:bgb:bd:b04")) { origin case_input; }
        assert "f2": etwas_erlangt(entity_ref("urn:de:bgb:bd:b04")) { origin case_input; }
        assert "f3": bezweckter_erfolg_nicht_eingetreten(entity_ref("urn:de:bgb:bd:b04")) { origin case_input; }
        assert "f4": erfolgseintritt_von_anfang_an_unmoeglich_und_gewusst(entity_ref("urn:de:bgb:bd:b04")) { origin adjudicated; }
        assert "jx0": not verstoss_des_empfaengers(entity_ref("urn:de:bgb:bd:b04")) { origin adjudicated; }
        assert "jx1": not verstoss_des_leistenden(entity_ref("urn:de:bgb:bd:b04")) { origin adjudicated; }
    }
    evaluate truth(ausschluss_815(entity_ref("urn:de:bgb:bd:b04")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(bereicherungsanspruch_zweckverfehlung(entity_ref("urn:de:bgb:bd:b04")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
