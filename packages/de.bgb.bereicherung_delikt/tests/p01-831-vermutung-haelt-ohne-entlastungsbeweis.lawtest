language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 831 Abs. 1: der Verrichtungsgehilfe hat einem Dritten in Ausführung der Verrichtung widerrechtlich Schaden zugefügt. Das Gericht hat BEIDE Entlastungsgründe des Satzes 2 verneint — die vermutete Ersatzpflicht des Geschäftsherrn bleibt bestehen.
test "§ 831 Abs. 1: ohne Entlastungsbeweis haftet der Geschäftsherr" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": verrichtungsgehilfe(entity_ref("urn:de:bgb:bd:p01"), entity_ref("urn:de:bgb:bd:p01:G")) { origin case_input; }
        assert "f2": geschaeftsherr(entity_ref("urn:de:bgb:bd:p01"), entity_ref("urn:de:bgb:bd:p01:GH")) { origin case_input; }
        assert "f3": in_ausfuehrung_der_verrichtung(entity_ref("urn:de:bgb:bd:p01")) { origin case_input; }
        assert "f4": kein_rechtfertigungsgrund(entity_ref("urn:de:bgb:bd:p01")) { origin case_input; }
        assert "f5": geschaedigter_dritter(entity_ref("urn:de:bgb:bd:p01"), entity_ref("urn:de:bgb:bd:p01:D")) { origin case_input; }
        assert "f6": kausal_verursacht(entity_ref("urn:de:bgb:bd:p01")) { origin case_input; }
        assert "j1": not sorgfalt_bei_auswahl_und_leitung_beobachtet(entity_ref("urn:de:bgb:bd:p01")) { origin adjudicated; }
        assert "j2": not schaden_auch_bei_sorgfalt_entstanden_831(entity_ref("urn:de:bgb:bd:p01")) { origin adjudicated; }
    }
    evaluate truth(verrichtungshaftungslage(entity_ref("urn:de:bgb:bd:p01")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(haftung_des_geschaeftsherrn(entity_ref("urn:de:bgb:bd:p01")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(haftung_831(entity_ref("urn:de:bgb:bd:p01"), entity_ref("urn:de:bgb:bd:p01:GH"), entity_ref("urn:de:bgb:bd:p01:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
