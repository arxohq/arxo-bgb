language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 812 Abs. 1 Satz 2 Alternative 2: der bezweckte Erfolg ist nicht eingetreten. § 815 greift nicht: die Unmöglichkeit von Anfang an ist nicht festgestellt, und das Gericht hat verneint, dass der Leistende den Erfolg wider Treu und Glauben verhindert hat.
test "§ 812 Abs. 1 Satz 2: Zweckverfehlung ohne Ausschluss des § 815" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": leistung_erbracht(entity_ref("urn:de:bgb:bd:b03")) { origin case_input; }
        assert "f2": etwas_erlangt(entity_ref("urn:de:bgb:bd:b03")) { origin case_input; }
        assert "f3": bezweckter_erfolg_nicht_eingetreten(entity_ref("urn:de:bgb:bd:b03")) { origin case_input; }
        assert "j1": not erfolgseintritt_wider_treu_und_glauben_verhindert(entity_ref("urn:de:bgb:bd:b03")) { origin adjudicated; }
        assert "jx0": not verstoss_des_empfaengers(entity_ref("urn:de:bgb:bd:b03")) { origin adjudicated; }
        assert "jx1": not verstoss_des_leistenden(entity_ref("urn:de:bgb:bd:b03")) { origin adjudicated; }
    }
    evaluate truth(herausgabepflicht_zweckverfehlung(entity_ref("urn:de:bgb:bd:b03")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(bereicherungsanspruch_zweckverfehlung(entity_ref("urn:de:bgb:bd:b03")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect judgment_requests(0);
}
