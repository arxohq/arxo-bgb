language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// § 836 Abs. 2: der Besitz endete am 10. März 2025, der Einsturz trat am 10. März 2026 ein — der letzte Tag der Jahresfrist (§ 188 Abs. 2). Der frühere Besitzer ist verantwortlich, beide Entlastungsgründe hat das Gericht verneint.
test "§ 836 Abs. 2: Einsturz am letzten Tag des Jahres nach Besitzende" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": einsturz_oder_abloesung(entity_ref("urn:de:bgb:bd:p06")) { origin case_input; }
        assert "f2": folge_fehlerhafter_errichtung_oder_mangelhafter_unterhaltung(entity_ref("urn:de:bgb:bd:p06")) { origin case_input; }
        assert "f3": kausal_verursacht(entity_ref("urn:de:bgb:bd:p06")) { origin case_input; }
        assert "f4": frueherer_besitzer(entity_ref("urn:de:bgb:bd:p06"), entity_ref("urn:de:bgb:bd:p06:F")) { origin case_input; }
        assert "f5": besitz_beendet_am(entity_ref("urn:de:bgb:bd:p06"), @2025-03-10) { origin case_input; }
        assert "f6": handlungstag(entity_ref("urn:de:bgb:bd:p06"), @2026-03-10) { origin case_input; }
        assert "f7": verletzter(entity_ref("urn:de:bgb:bd:p06"), entity_ref("urn:de:bgb:bd:p06:V")) { origin case_input; }
        assert "j1": not frueherer_besitzer_hat_sorgfalt_beobachtet(entity_ref("urn:de:bgb:bd:p06")) { origin adjudicated; }
        assert "j2": not spaeterer_besitzer_haette_gefahr_abwenden_koennen(entity_ref("urn:de:bgb:bd:p06")) { origin adjudicated; }
        assert "j3": not sorgfalt_zur_abwendung_der_gefahr_beobachtet(entity_ref("urn:de:bgb:bd:p06")) { origin adjudicated; }
    }
    evaluate truth(verantwortlichkeit_frueherer_besitzer(entity_ref("urn:de:bgb:bd:p06")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(haftung_836(entity_ref("urn:de:bgb:bd:p06"), entity_ref("urn:de:bgb:bd:p06:F"), entity_ref("urn:de:bgb:bd:p06:V")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
