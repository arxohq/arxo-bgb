language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";

test "§ 812: drei Kondiktionen aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "p812": leistungskondiktion_812_beteiligte(entity_ref("urn:de:bgb:bereicherung:b812"), entity_ref("urn:de:bgb:person:recipient"), entity_ref("urn:de:bgb:person:performer")) { origin case_input; }
        assert "l812": leistungskondiktion_812_beginn_am(entity_ref("urn:de:bgb:bereicherung:b812"), @2026-06-01) { origin case_input; }
        assert "n812": nichtleistungskondiktion_812_beginn_am(entity_ref("urn:de:bgb:bereicherung:b812n"), @2026-06-02) { origin case_input; }
        assert "z812": zweckverfehlung_812_beginn_am(entity_ref("urn:de:bgb:bereicherung:b812z"), @2026-06-03) { origin case_input; }
        assert "pn812": leistungskondiktion_812_beteiligte(entity_ref("urn:de:bgb:bereicherung:b812n"), entity_ref("urn:de:bgb:person:recipient"), entity_ref("urn:de:bgb:person:performer")) { origin case_input; }
        assert "pz812": leistungskondiktion_812_beteiligte(entity_ref("urn:de:bgb:bereicherung:b812z"), entity_ref("urn:de:bgb:person:recipient"), entity_ref("urn:de:bgb:person:performer")) { origin case_input; }
    }
    evaluate positions();
    expect position(LibertyLeistungskondiktion812, ACTIVE);
    expect position(LibertyNichtleistungskondiktion812, ACTIVE);
    expect position(LibertyZweckverfehlung812, ACTIVE);
}

test "§ 812: ohne Kondiktion keine Position" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(LibertyLeistungskondiktion812, ACTIVE);
    expect not position(LibertyNichtleistungskondiktion812, ACTIVE);
    expect not position(LibertyZweckverfehlung812, ACTIVE);
}
