language "law.core" version "0.2";
package de.bgb.bereicherung_delikt version "0.1.0";
namespace "urn:de:corpus:clir:bgb-bereicherung-delikt";
// Andere Seite der Jahresfrist des § 836 Abs. 2: Einsturz am 11. März 2026, einen Tag nach dem Ende der Frist — der frühere Besitzer ist nicht verantwortlich.
test "§ 836 Abs. 2: Einsturz einen Tag nach Ablauf des Jahres" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; deadline_policy BGB_DELIKT_JAHR; calendar KALENDER_BUNDESWEIT; }
        assert "f1": einsturz_oder_abloesung(entity_ref("urn:de:bgb:bd:p07")) { origin case_input; }
        assert "f2": folge_fehlerhafter_errichtung_oder_mangelhafter_unterhaltung(entity_ref("urn:de:bgb:bd:p07")) { origin case_input; }
        assert "f3": kausal_verursacht(entity_ref("urn:de:bgb:bd:p07")) { origin case_input; }
        assert "f4": frueherer_besitzer(entity_ref("urn:de:bgb:bd:p07"), entity_ref("urn:de:bgb:bd:p07:F")) { origin case_input; }
        assert "f5": besitz_beendet_am(entity_ref("urn:de:bgb:bd:p07"), @2025-03-10) { origin case_input; }
        assert "f6": handlungstag(entity_ref("urn:de:bgb:bd:p07"), @2026-03-11) { origin case_input; }
        assert "f7": verletzter(entity_ref("urn:de:bgb:bd:p07"), entity_ref("urn:de:bgb:bd:p07:V")) { origin case_input; }
        assert "j1": not frueherer_besitzer_hat_sorgfalt_beobachtet(entity_ref("urn:de:bgb:bd:p07")) { origin adjudicated; }
        assert "j2": not spaeterer_besitzer_haette_gefahr_abwenden_koennen(entity_ref("urn:de:bgb:bd:p07")) { origin adjudicated; }
        assert "j3": not sorgfalt_zur_abwendung_der_gefahr_beobachtet(entity_ref("urn:de:bgb:bd:p07")) { origin adjudicated; }
    }
    evaluate truth(gebaeudehaftungslage(entity_ref("urn:de:bgb:bd:p07")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(verantwortlichkeit_frueherer_besitzer(entity_ref("urn:de:bgb:bd:p07")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
