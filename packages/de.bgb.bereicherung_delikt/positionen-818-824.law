@source(BGB_P818)
rule PositionWertersatz818(b: Bereicherung, wert: Money, tag: Date) defeasible {
    label de official "Der Bereicherte hat bei fehlender Herausgabemöglichkeit Wertersatz zu leisten (§ 818)";
    label en unofficial "The enriched person must compensate the value where surrender is impossible (§ 818)";
    when wertersatzpflicht(b, wert);
    when leistungstag(b, tag);
    then duty Wertersatz818 {
        bearer b;
        beneficiary b;
        achieve wertersatzpflicht(b, wert) during [tag, infinity);
    };
}

@source(BGB_P824)
rule PositionSchadensersatz824(h: Handlung, ersatzpflichtiger: Person, verletzter: Person, tag: Date) defeasible {
    label de official "Derjenige, der durch eine unwahre Tatsachenbehauptung schädigt, hat den Schaden zu ersetzen (§ 824)";
    label en unofficial "A person causing damage by a false assertion of fact must compensate the damage (§ 824)";
    when schadensersatzpflicht(h, ersatzpflichtiger, verletzter);
    when handlungstag(h, tag);
    then duty Schadensersatz824 {
        bearer ersatzpflichtiger;
        beneficiary verletzter;
        achieve schadensersatzpflicht(h, ersatzpflichtiger, verletzter) during [tag, infinity);
    };
}
