pub relation haftung_825_beginn_am(h: Handlung, tag: Date) kind empirical {
    label de official "Beginn der Ersatzpflicht nach § 825";
    label en unofficial "start of the compensation duty under § 825";
}
@source(BGB_P825)
rule PositionHaftung825(h: Handlung, s: Person, v: Person, tag: Date) defeasible {
    label de official "Der Bestimmende hat dem anderen den Schaden aus sexuellen Handlungen zu ersetzen (§ 825)";
    label en unofficial "The person inducing the act must compensate the other for the resulting damage (§ 825)";
    when handelnder(h, s) and verletzter(h, v)
     and haftung_825_beginn_am(h, tag);
    then liberty LibertyHaftung825 {
        holder s;
        action haftung_825_beginn_am(h, tag);
        window [tag, infinity);
    };
}
