pub relation verpflichteter_848(h: Handlung, p: Person) kind empirical {
    label de official "Zur Rückgabe der entzogenen Sache Verpflichteter nach § 848";
    label en unofficial "person obliged to return the taken thing under § 848";
}
@source(BGB_P848)
rule PositionZufallshaftung848(h: Handlung, p: Person, tag: Date) defeasible {
    label de official "Der zur Rückgabe Verpflichtete haftet für den zufälligen Untergang oder die Verschlechterung (§ 848)";
    label en unofficial "The person obliged to return is liable for accidental destruction or deterioration (§ 848)";
    when verpflichteter_848(h, p) and handlungstag(h, tag);
    then duty Duty848Zufallshaftung {
        bearer p;
        achieve haftung_fuer_zufall(h) during [tag, infinity);
    };
}

@source(BGB_P849)
rule PositionZinsanspruch849(h: Handlung, v: Person, betrag: Money, tag: Date) defeasible {
    label de official "Der Verletzte kann Zinsen des zu ersetzenden Betrags verlangen (§ 849)";
    label en unofficial "The injured person may claim interest on the amount to be compensated (§ 849)";
    when verletzter(h, v) and wertminderung_oder_wert(h, betrag)
     and wertbestimmungstag(h, tag);
    then liberty Liberty849Zinsanspruch {
        holder v;
        action zinsanspruch_ab(h, tag);
        window [tag, infinity);
    };
}

pub relation verpflichteter_850(h: Handlung, p: Person) kind empirical {
    label de official "Zur Herausgabe Verpflichteter mit Verwendungen nach § 850";
    label en unofficial "person obliged to return who made outlays under § 850";
}
@source(BGB_P850)
rule PositionVerwendungen850(h: Handlung, p: Person, tag: Date) defeasible {
    label de official "Dem zur Herausgabe Verpflichteten stehen Rechte wegen Verwendungen zu (§ 850)";
    label en unofficial "The person obliged to return has rights regarding outlays (§ 850)";
    when verpflichteter_850(h, p) and handlungstag(h, tag);
    then liberty Liberty850Verwendungen {
        holder p;
        action verwendungsrechte_wie_besitzer(h);
        window [tag, infinity);
    };
}
