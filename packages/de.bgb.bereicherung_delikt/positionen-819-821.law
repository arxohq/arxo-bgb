pub relation verschaerfte_haftung_819_beginn_am(b: Bereicherung, tag: Date) kind empirical {
    label de official "Beginn der verschärften Haftung nach § 819";
    label en unofficial "start of aggravated liability under § 819";
}
@source(BGB_P819)
rule PositionHaftung819(b: Bereicherung, p: Person, tag: Date) defeasible {
    label de official "Der Empfänger haftet verschärft ab Kenntnis des Mangels (§ 819)";
    label en unofficial "The recipient is subject to aggravated liability from knowledge of the defect (§ 819)";
    when empfaenger(b, p) and verschaerfte_haftung_819_beginn_am(b, tag);
    then liberty Liberty819VerschaerfteHaftung {
        holder p;
        action verschaerfte_haftung_819_beginn_am(b, tag);
        window [tag, infinity);
    };
}

pub relation zinspflicht_820_beginn_am(b: Bereicherung, tag: Date) kind empirical {
    label de official "Beginn der Zinspflicht nach § 820";
    label en unofficial "start of the interest duty under § 820";
}
@source(BGB_P820)
rule PositionZinsen820(b: Bereicherung, p: Person, tag: Date) defeasible {
    label de official "Der Empfänger hat ab Kenntnis Zinsen zu entrichten (§ 820)";
    label en unofficial "The recipient must pay interest from knowledge (§ 820)";
    when empfaenger(b, p) and zinspflicht_820_beginn_am(b, tag);
    then liberty Liberty820Zinsen {
        holder p;
        action zinspflicht_820_beginn_am(b, tag);
        window [tag, infinity);
    };
}

pub relation einrede_821_beginn_am(b: Bereicherung, tag: Date) kind empirical {
    label de official "Beginn der Einrede der Bereicherung nach § 821";
    label en unofficial "start of the enrichment defence under § 821";
}
@source(BGB_P821)
rule PositionEinrede821(b: Bereicherung, p: Person, tag: Date) defeasible {
    label de official "Der Schuldner darf die Erfüllung ohne Rechtsgrund verweigern (§ 821)";
    label en unofficial "The debtor has the liberty to refuse performance without legal ground (§ 821)";
    when empfaenger(b, p) and verbindlichkeit_ohne_rechtlichen_grund_eingegangen(b)
     and einrede_821_beginn_am(b, tag);
    then liberty Liberty821Einrede {
        holder p;
        action einrede_821_beginn_am(b, tag);
        window [tag, infinity);
    };
}
