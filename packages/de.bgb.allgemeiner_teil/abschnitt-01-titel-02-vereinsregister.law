// BUCH 1 ABSCHNITT 1 TITEL 2 UNTERTITEL 1 — EINTRAGUNG IN DAS VEREINSREGISTER
// (§§ 55–79a; §§ 61–63 weggefallen und nicht im geltenden Text)
//
// DAS REGISTER SELBST FÜHRT DIESES PAKET NICHT. Eintragungen, Anmeldungen
// und Bescheinigungen sind Eingänge des Falls; die Vorschriften sagen, WAS
// einzutragen, anzumelden und zurückzuweisen ist, und daran hängen die
// Rechtsfolgen (§§ 68, 70, 71: Vertrauensschutz und Wirksamkeit).
//
// § 55a (maschinelles Register), § 79 Abs. 2–5 (automatisiertes Abrufverfahren)
// und § 79a (Datenschutz-Grundverordnung im Registerverfahren) betreffen die
// EINRICHTUNG des Registers durch die Länder; ihre Rechtsfolgen stehen hier
// nur so weit, wie der Text sie an Tatsachen des Falls knüpft.

language "law.core" version "0.2";
package de.bgb.allgemeiner_teil version "0.1.0";
namespace "urn:de:corpus:clir:bgb-allgemeiner-teil";

pub relation registergericht(v: Verein, o: Ort) kind institutional {
    label de official "das Amtsgericht, in dessen Bezirk der Verein seinen Sitz hat, führt das Vereinsregister (§ 55, § 29, § 37 Abs. 2 Satz 2)";
    label en unofficial "the local court in whose district the association has its seat keeps the register (§ 55)";
}
pub relation mitgliederzahl(v: Verein, zahl: Integer) kind empirical {
    key(v);
    label de official "Zahl der Mitglieder des Vereins (§§ 56, 59 Abs. 3, 72, 73)";
    label en unofficial "number of members of the association (§§ 56, 59 (3), 72, 73)";
}
pub relation satzung_enthaelt_zweck(v: Verein) kind empirical {
    label de official "die Satzung enthält den Zweck des Vereins (§ 57 Abs. 1)";
    label en unofficial "the articles state the purpose of the association (§ 57 (1))";
}
pub relation satzung_enthaelt_namen(v: Verein) kind empirical {
    label de official "die Satzung enthält den Namen des Vereins (§ 57 Abs. 1)";
    label en unofficial "the articles state the name of the association (§ 57 (1))";
}
pub relation satzung_ergibt_eintragungswillen(v: Verein) kind empirical {
    label de official "aus der Satzung ergibt sich, dass der Verein eingetragen werden soll (§ 57 Abs. 1)";
    label en unofficial "the articles show that the association is to be registered (§ 57 (1))";
}
pub relation satzung_enthaelt_sollbestimmung(v: Verein, nummer: Integer) kind empirical {
    label de official "die Satzung enthält die Bestimmung nach § 58 Nr. 1–4 (Eintritt und Austritt, Beiträge, Bildung des Vorstands, Berufung der Mitgliederversammlung)";
    label en unofficial "the articles contain the provision under § 58 nos. 1–4";
}
pub relation anmeldung_durch_den_vorstand(v: Verein) kind empirical {
    label de official "der Vorstand hat den Verein zur Eintragung angemeldet (§ 59 Abs. 1)";
    label en unofficial "the board has applied for registration of the association (§ 59 (1))";
}
pub relation abschriften_beigefuegt(v: Verein) kind empirical {
    label de official "der Anmeldung sind Abschriften der Satzung und der Urkunden über die Bestellung des Vorstands beigefügt (§ 59 Abs. 2)";
    label en unofficial "copies of the articles and of the documents on the appointment of the board are attached (§ 59 (2))";
}
pub relation satzung_von_sieben_mitgliedern_unterzeichnet(v: Verein) kind empirical {
    label de official "die Satzung ist von mindestens sieben Mitgliedern unterzeichnet und enthält die Angabe des Tages der Errichtung (§ 59 Abs. 3)";
    label en unofficial "the articles are signed by at least seven members and state the day of establishment (§ 59 (3))";
}
pub relation name_unterscheidet_sich_deutlich(v: Verein) kind empirical {
    label de official "der Name unterscheidet sich von den Namen der am selben Ort bestehenden eingetragenen Vereine deutlich (§ 57 Abs. 2) — festgestellte Tatsache des Registergerichts";
    label en unofficial "the name is clearly distinguishable from those of registered associations in the same place (§ 57 (2))";
}
pub relation eintragung_soll_erfolgen(v: Verein) kind institutional {
    label de official "die Eintragung soll erfolgen (§ 56: mindestens sieben Mitglieder)";
    label en unofficial "the entry should be made (§ 56: at least seven members)";
}
pub relation mindesterfordernisse_erfuellt(v: Verein) kind institutional {
    label de official "die Mindesterfordernisse an die Vereinssatzung sind erfüllt (§ 57 Abs. 1)";
    label en unofficial "the minimum requirements for the articles are met (§ 57 (1))";
}
pub relation sollinhalt_erfuellt(v: Verein) kind institutional {
    label de official "die Satzung enthält die Sollbestimmungen des § 58";
    label en unofficial "the articles contain the provisions listed in § 58";
}
pub relation anmeldung_zurueckzuweisen(v: Verein) kind institutional {
    label de official "die Anmeldung ist unter Angabe der Gründe von dem Amtsgericht zurückzuweisen (§ 60)";
    label en unofficial "the application is to be refused by the local court, stating the reasons (§ 60)";
}
pub relation eintragungsinhalt(v: Verein, gegenstand: Vereinsregistereintrag) kind institutional {
    label de official "Gegenstand, der bei der Eintragung anzugeben oder einzutragen ist (§§ 64, 71, 74, 75, 76)";
    label en unofficial "matter to be stated or entered in the register (§§ 64, 71, 74, 75, 76)";
}
pub relation namenszusatz_eingetragener_verein(v: Verein) kind institutional {
    label de official "mit der Eintragung erhält der Name des Vereins den Zusatz „eingetragener Verein“ (§ 65)";
    label en unofficial "on entry the name of the association receives the suffix „eingetragener Verein“ (§ 65)";
}
pub relation aufbewahrung_der_dokumente(v: Verein) kind institutional {
    label de official "die mit einer Anmeldung eingereichten Dokumente werden vom Amtsgericht aufbewahrt (§ 66)";
    label en unofficial "documents submitted with an application are kept by the local court (§ 66)";
}

@source(BGB_P55)
rule ZustaendigkeitDesRegistergerichts(v: Verein, o: Ort) strict {
    label de official "Die Eintragung eines Vereins der in § 21 bezeichneten Art in das Vereinsregister hat bei dem Amtsgericht zu geschehen, in dessen Bezirk der Verein seinen Sitz hat (§ 55)";
    label en unofficial "Entry of an association under § 21 is made at the local court in whose district it has its seat (§ 55)";
    when verein_zweck(v, NichtWirtschaftlich) and sitz_des_vereins(v, o);
    then registergericht(v, o);
}

@source(BGB_P55a)
rule MaschinellGefuehrtesVereinsregister(v: Verein, t: Date) strict {
    label de official "Das maschinell geführte Vereinsregister tritt an die Stelle des bisherigen Registers; eine Eintragung wird wirksam, sobald sie in den Datenspeicher aufgenommen ist und auf Dauer inhaltlich unverändert lesbar wiedergegeben werden kann (§ 55a Abs. 2, 3)";
    label en unofficial "The electronically kept register replaces the former one; an entry becomes effective once recorded in the data store and permanently reproducible (§ 55a (2), (3))";
    when eingetragen_im_vereinsregister_am(v, t);
    then eintragungsinhalt(v, NameUndSitz);
}

@source(BGB_P56)
rule MindestmitgliederzahlSieben(v: Verein, n: Integer) strict {
    label de official "Die Eintragung soll nur erfolgen, wenn die Zahl der Mitglieder mindestens sieben beträgt (§ 56)";
    label en unofficial "The entry should be made only if the number of members is at least seven (§ 56)";
    when mitgliederzahl(v, n) and n >= 7;
    then eintragung_soll_erfolgen(v);
}

@source(BGB_P57)
rule MindesterfordernisseDerSatzung(v: Verein, o: Ort) strict {
    label de official "Die Satzung muss den Zweck, den Namen und den Sitz des Vereins enthalten und ergeben, dass der Verein eingetragen werden soll (§ 57 Abs. 1)";
    label en unofficial "The articles must state purpose, name and seat and show that the association is to be registered (§ 57 (1))";
    when satzung_enthaelt_zweck(v)
        and satzung_enthaelt_namen(v)
        and satzung_bestimmt_sitz(v, o)
        and satzung_ergibt_eintragungswillen(v);
    then mindesterfordernisse_erfuellt(v);
}

@source(BGB_P58)
rule SollinhaltDerSatzung(v: Verein) strict {
    label de official "Die Satzung soll Bestimmungen enthalten über den Eintritt und Austritt der Mitglieder, über Beiträge, über die Bildung des Vorstands und über die Berufung der Mitgliederversammlung (§ 58 Nr. 1–4)";
    label en unofficial "The articles should contain provisions on admission and withdrawal, contributions, formation of the board and calling of the general meeting (§ 58)";
    when satzung_enthaelt_sollbestimmung(v, 1)
        and satzung_enthaelt_sollbestimmung(v, 2)
        and satzung_enthaelt_sollbestimmung(v, 3)
        and satzung_enthaelt_sollbestimmung(v, 4);
    then sollinhalt_erfuellt(v);
}

@source(BGB_P59)
rule AnmeldungZurEintragung(v: Verein) strict {
    label de official "Der Vorstand hat den Verein zur Eintragung anzumelden; der Anmeldung sind Abschriften der Satzung und der Urkunden über die Bestellung des Vorstands beizufügen; die Satzung soll von mindestens sieben Mitgliedern unterzeichnet sein und die Angabe des Tages der Errichtung enthalten (§ 59)";
    label en unofficial "The board applies for registration, attaching copies of the articles and appointment documents; the articles should be signed by at least seven members (§ 59)";
    when anmeldung_durch_den_vorstand(v)
        and abschriften_beigefuegt(v)
        and satzung_von_sieben_mitgliedern_unterzeichnet(v);
    then eintragungsinhalt(v, TagDerErrichtungDerSatzung);
}

@source(BGB_P60)
rule ZurueckweisungWegenZuWenigerMitglieder(v: Verein, n: Integer) strict {
    label de official "Die Anmeldung ist, wenn den Erfordernissen der §§ 56 bis 59 nicht genügt ist, von dem Amtsgericht unter Angabe der Gründe zurückzuweisen (§ 60) — Erfordernis des § 56";
    label en unofficial "The application is refused if the requirements of §§ 56 to 59 are not met (§ 60) — requirement of § 56";
    when anmeldung_durch_den_vorstand(v) and mitgliederzahl(v, n) and n < 7;
    then anmeldung_zurueckzuweisen(v);
}

@source(BGB_P60)
rule ZurueckweisungWegenUnvollstaendigerSatzung(v: Verein) strict {
    label de official "Die Anmeldung ist zurückzuweisen, wenn den Erfordernissen des § 57 nicht genügt ist (§ 60)";
    label en unofficial "The application is refused if the requirements of § 57 are not met (§ 60)";
    when anmeldung_durch_den_vorstand(v) and not_known(mindesterfordernisse_erfuellt(v));
    then anmeldung_zurueckzuweisen(v);
}

@source(BGB_P64)
rule InhaltDerEintragung(v: Verein, t: Date) strict {
    label de official "Bei der Eintragung sind der Name und der Sitz des Vereins, der Tag der Errichtung der Satzung, die Mitglieder des Vorstands und ihre Vertretungsmacht anzugeben (§ 64)";
    label en unofficial "On entry the name and seat, the day of establishment of the articles, the board members and their authority are to be stated (§ 64)";
    when eingetragen_im_vereinsregister_am(v, t);
    then eintragungsinhalt(v, VorstandUndVertretungsmacht);
}

@source(BGB_P65)
rule Namenszusatz(v: Verein, t: Date) strict {
    label de official "Mit der Eintragung erhält der Name des Vereins den Zusatz „eingetragener Verein“ (§ 65)";
    label en unofficial "On entry the name receives the suffix „eingetragener Verein“ (§ 65)";
    when eingetragen_im_vereinsregister_am(v, t);
    then namenszusatz_eingetragener_verein(v);
}

@source(BGB_P66)
rule AufbewahrungDerDokumente(v: Verein) strict {
    label de official "Die mit einer Anmeldung eingereichten Dokumente werden vom Amtsgericht aufbewahrt (§ 66)";
    label en unofficial "Documents submitted with an application are kept by the local court (§ 66)";
    when anmeldung_durch_den_vorstand(v);
    then aufbewahrung_der_dokumente(v);
}

pub relation kein_bekanntmachungsblatt_bestimmt(v: Verein) kind empirical {
    label de official "der Verein hat in der Satzung kein Blatt für Bekanntmachungen bestimmt oder das bestimmte Blatt hat sein Erscheinen eingestellt (§ 50a)";
    label en unofficial "the association has designated no gazette for notices or the designated gazette has ceased publication (§ 50a)";
}
pub relation bekanntmachungsblatt_des_amtsgerichts(v: Verein) kind institutional {
    label de official "Bekanntmachungen des Vereins sind in dem Blatt zu veröffentlichen, welches für Bekanntmachungen des Amtsgerichts bestimmt ist, in dessen Bezirk der Verein seinen Sitz hat (§ 50a)";
    label en unofficial "notices are to be published in the gazette designated for notices of the local court of the seat (§ 50a)";
}

@source(BGB_P50a)
rule BekanntmachungsblattDesAmtsgerichts(v: Verein) strict {
    label de official "Hat ein Verein in der Satzung kein Blatt für Bekanntmachungen bestimmt oder hat das bestimmte Bekanntmachungsblatt sein Erscheinen eingestellt, sind Bekanntmachungen des Vereins in dem Blatt zu veröffentlichen, welches für Bekanntmachungen des Amtsgerichts bestimmt ist, in dessen Bezirk der Verein seinen Sitz hat (§ 50a)";
    label en unofficial "Where no gazette is designated or it has ceased publication, notices are published in the gazette of the local court of the seat (§ 50a)";
    when kein_bekanntmachungsblatt_bestimmt(v);
    then bekanntmachungsblatt_des_amtsgerichts(v);
}

// §§ 67–71 Änderungen, Vertrauensschutz.
pub relation vorstandsaenderung(v: Verein, p: Person) kind empirical {
    label de official "Änderung des Vorstands (§ 67 Abs. 1)";
    label en unofficial "change of the board (§ 67 (1))";
}
pub relation vorstandsaenderung_eingetragen_am(v: Verein, p: Person, tag: Date) kind empirical {
    label de official "Tag der Eintragung der Vorstandsänderung im Vereinsregister (§ 68 Satz 1)";
    label en unofficial "day on which the change of board was entered in the register (§ 68 sentence 1)";
}
pub relation aenderung_dem_dritten_bekannt(v: Verein, dritter: Person) kind empirical {
    label de official "dem Dritten ist die Änderung des Vorstands bekannt (§ 68 Satz 1) — festgestellte Tatsache";
    label en unofficial "the third party knows of the change of board (§ 68 sentence 1) — established fact";
}
pub relation unkenntnis_beruht_auf_fahrlaessigkeit(v: Verein, dritter: Person) kind empirical {
    label de official "die Unkenntnis des Dritten von der eingetragenen Änderung beruht auf Fahrlässigkeit (§ 68 Satz 2) — festgestellte Tatsache";
    label en unofficial "the third party's ignorance of the entered change is due to negligence (§ 68 sentence 2)";
}
pub relation rechtsgeschaeft_mit_bisherigem_vorstand_am(v: Verein, dritter: Person, tag: Date) kind empirical {
    label de official "Tag des Rechtsgeschäfts zwischen den bisherigen Mitgliedern des Vorstands und einem Dritten (§ 68 Satz 1)";
    label en unofficial "day of the transaction between the former board members and a third party (§ 68 sentence 1)";
}
pub relation aenderung_dem_dritten_entgegenzusetzen(v: Verein, dritter: Person) kind institutional {
    label de official "die Änderung des Vorstands kann dem Dritten entgegengesetzt werden (§ 68)";
    label en unofficial "the change of board may be raised against the third party (§ 68)";
}
pub relation nachweis_durch_zeugnis(v: Verein) kind institutional {
    label de official "der Nachweis, dass der Vorstand aus den im Register eingetragenen Personen besteht, wird Behörden gegenüber durch ein Zeugnis des Amtsgerichts über die Eintragung geführt (§ 69)";
    label en unofficial "proof that the board consists of the registered persons is furnished to authorities by a certificate of the local court (§ 69)";
}
pub relation satzungsaenderung_eingetragen_am(b: Beschluss, tag: Date) kind empirical {
    key(b);
    label de official "Tag der Eintragung der Satzungsänderung in das Vereinsregister (§ 71 Abs. 1 Satz 1)";
    label en unofficial "day on which the amendment of the articles was entered in the register (§ 71 (1))";
}
pub relation bescheinigung_der_mitgliederzahl_verlangt(v: Verein) kind empirical {
    label de official "das Amtsgericht verlangt eine schriftliche Bescheinigung über die Zahl der Vereinsmitglieder (§ 72)";
    label en unofficial "the local court demands a written certificate of the number of members (§ 72)";
}
pub relation bescheinigungspflicht(v: Verein) kind institutional {
    label de official "der Vorstand hat dem Amtsgericht auf dessen Verlangen jederzeit eine schriftliche Bescheinigung über die Zahl der Vereinsmitglieder einzureichen (§ 72)";
    label en unofficial "the board must at any time submit to the court a written certificate of the number of members (§ 72)";
}

@source(BGB_P67)
rule AnmeldungDerVorstandsaenderung(v: Verein, p: Person) strict {
    label de official "Jede Änderung des Vorstands ist von dem Vorstand zur Eintragung anzumelden; der Anmeldung ist eine Abschrift der Urkunde über die Änderung beizufügen; die Eintragung gerichtlich bestellter Vorstandsmitglieder erfolgt von Amts wegen (§ 67)";
    label en unofficial "Every change of the board must be filed for entry; entries of court-appointed members are made ex officio (§ 67)";
    when vorstandsaenderung(v, p);
    then eintragungsinhalt(v, VorstandUndVertretungsmacht);
}

@source(BGB_P68)
rule VertrauensschutzDurchVereinsregister(v: Verein, d: Person, tg: Date, te: Date) strict {
    label de official "Wird zwischen den bisherigen Mitgliedern des Vorstands und einem Dritten ein Rechtsgeschäft vorgenommen, so kann die Änderung des Vorstands dem Dritten nur entgegengesetzt werden, wenn sie zur Zeit der Vornahme des Rechtsgeschäfts im Vereinsregister eingetragen oder dem Dritten bekannt ist (§ 68 Satz 1)";
    label en unofficial "A change of board may be raised against a third party only if entered at the time of the transaction or known to them (§ 68 sentence 1)";
    when rechtsgeschaeft_mit_bisherigem_vorstand_am(v, d, tg)
        and vorstandsaenderung_eingetragen_am(v, _, te)
        and te <= tg
        and unkenntnis_beruht_auf_fahrlaessigkeit(v, d);
    then aenderung_dem_dritten_entgegenzusetzen(v, d);
}

@source(BGB_P68)
rule VertrauensschutzBeiKenntnis(v: Verein, d: Person, tg: Date) strict {
    label de official "Die Änderung kann dem Dritten auch dann entgegengesetzt werden, wenn sie ihm bekannt ist (§ 68 Satz 1)";
    label en unofficial "The change may also be raised against the third party if it is known to them (§ 68 sentence 1)";
    when rechtsgeschaeft_mit_bisherigem_vorstand_am(v, d, tg) and aenderung_dem_dritten_bekannt(v, d);
    then aenderung_dem_dritten_entgegenzusetzen(v, d);
}

@source(BGB_P69)
rule NachweisDesVereinsvorstands(v: Verein, t: Date) strict {
    label de official "Der Nachweis, dass der Vorstand aus den im Register eingetragenen Personen besteht, wird Behörden gegenüber durch ein Zeugnis des Amtsgerichts über die Eintragung geführt (§ 69)";
    label en unofficial "Proof of the board's composition is furnished to authorities by a court certificate (§ 69)";
    when eingetragen_im_vereinsregister_am(v, t);
    then nachweis_durch_zeugnis(v);
}

@source(BGB_P70)
rule VertrauensschutzBeiBeschraenkterVertretungsmacht(v: Verein, d: Person, tg: Date, te: Date) strict {
    label de official "Die Vorschriften des § 68 gelten auch für Bestimmungen, die den Umfang der Vertretungsmacht des Vorstands beschränken oder die Vertretungsmacht abweichend von § 26 Absatz 2 Satz 1 regeln (§ 70)";
    label en unofficial "§ 68 also applies to provisions restricting the board's authority or regulating it differently from § 26 (2) (§ 70)";
    when satzung_beschraenkt_vertretungsmacht(v)
        and rechtsgeschaeft_mit_bisherigem_vorstand_am(v, d, tg)
        and vorstandsaenderung_eingetragen_am(v, _, te)
        and te <= tg;
    then aenderung_dem_dritten_entgegenzusetzen(v, d);
}

@source(BGB_P71)
rule SatzungsaenderungWirdMitEintragungWirksam(b: Beschluss, t: Date) strict {
    label de official "Änderungen der Satzung bedürfen zu ihrer Wirksamkeit der Eintragung in das Vereinsregister (§ 71 Abs. 1 Satz 1)";
    label en unofficial "Amendments of the articles require entry in the register to be effective (§ 71 (1))";
    when beschluss_enthaelt_satzungsaenderung(b)
        and beschluss_angenommen(b)
        and satzungsaenderung_eingetragen_am(b, t);
    then satzungsaenderung_wirksam(b);
}

@source(BGB_P72)
rule BescheinigungDerMitgliederzahl(v: Verein) strict {
    label de official "Der Vorstand hat dem Amtsgericht auf dessen Verlangen jederzeit eine schriftliche Bescheinigung über die Zahl der Vereinsmitglieder einzureichen (§ 72)";
    label en unofficial "On demand the board must at any time submit a written certificate of the number of members (§ 72)";
    when bescheinigung_der_mitgliederzahl_verlangt(v);
    then bescheinigungspflicht(v);
}

// § 73 Unterschreiten der Mindestmitgliederzahl; Dreimonatsfrist.
pub relation mitgliederzahl_unter_drei_seit(v: Verein, tag: Date) kind empirical {
    key(v);
    label de official "Tag, an dem die Zahl der Vereinsmitglieder unter drei herabgesunken ist (§ 73)";
    label en unofficial "day on which the number of members fell below three (§ 73)";
}
pub relation antragsfrist_73(v: Verein, f: Frist) kind empirical {
    key(v);
    label de official "Frist der drei Monate, binnen deren der Vorstand den Antrag zu stellen hat (§ 73)";
    label en unofficial "the three-month period within which the board must apply (§ 73)";
}
pub relation antrag_des_vorstands_am(v: Verein, tag: Date) kind empirical {
    key(v);
    label de official "Tag des Antrags des Vorstands auf Entziehung der Rechtsfähigkeit (§ 73)";
    label en unofficial "day of the board's application for deprivation of legal capacity (§ 73)";
}
pub relation antragsfrist_73_ende(v: Verein, tag: Date) kind institutional {
    key(v);
    label de official "Tag, mit dessen Ablauf die Dreimonatsfrist des § 73 endet (§§ 187 Abs. 1, 188 Abs. 2, 193)";
    label en unofficial "day at whose end the three-month period of § 73 ends";
}
pub relation entziehung_von_amts_wegen(v: Verein) kind institutional {
    label de official "wird der Antrag nicht binnen drei Monaten gestellt, so hat das Amtsgericht von Amts wegen nach Anhörung des Vorstands dem Verein die Rechtsfähigkeit zu entziehen (§ 73)";
    label en unofficial "if no application is made within three months, the court withdraws legal capacity ex officio after hearing the board (§ 73)";
}

@source(BGB_P73)
rule AntragsfristEreignis73(v: Verein, f: Frist, d: Date) strict {
    label de official "Sinkt die Zahl der Vereinsmitglieder unter drei herab, so hat das Amtsgericht auf Antrag des Vorstands zu handeln (§ 73) — Ereignis der Frist ist das Absinken";
    label en unofficial "If the number of members falls below three, the court acts on the board's application (§ 73) — the event is the fall";
    when antragsfrist_73(v, f) and mitgliederzahl_unter_drei_seit(v, d);
    then de.bgb.fristen::frist_ereignis(f, d);
}

@source(BGB_P73)
rule AntragsfristDauer73(v: Verein, f: Frist, d: Date) strict {
    label de official "Die Frist des § 73 beträgt drei Monate (§ 188 Abs. 2)";
    label en unofficial "The period of § 73 is three months (§ 188 (2))";
    when antragsfrist_73(v, f) and mitgliederzahl_unter_drei_seit(v, d);
    then de.bgb.fristen::frist_dauer_kalender(f, 3 calendar_month);
}

@source(BGB_P73)
rule AntragsfristEnde73(v: Verein, f: Frist, e: Date) strict {
    label de official "Das Ende der Dreimonatsfrist berechnet sich nach den §§ 187 Abs. 1, 188 Abs. 2 und 193 (de.bgb.fristen)";
    label en unofficial "The end of the three-month period is computed under §§ 187 (1), 188 (2) and 193";
    when antragsfrist_73(v, f) and de.bgb.fristen::frist_ende(f, e);
    then antragsfrist_73_ende(v, e);
}

@source(BGB_P73)
rule EntziehungVonAmtsWegenNachFristablauf(v: Verein, e: Date, a: Date) strict {
    label de official "Wird der Antrag nicht binnen drei Monaten gestellt, so hat das Amtsgericht von Amts wegen nach Anhörung des Vorstands dem Verein die Rechtsfähigkeit zu entziehen (§ 73)";
    label en unofficial "If the application is not made within three months, the court withdraws legal capacity ex officio (§ 73)";
    when antragsfrist_73_ende(v, e) and antrag_des_vorstands_am(v, a) and a > e;
    then entziehung_von_amts_wegen(v);
}

@source(BGB_P73)
rule EntziehungAufAntragDesVorstands(v: Verein, e: Date, a: Date) strict {
    label de official "Sinkt die Zahl der Vereinsmitglieder unter drei herab, so hat das Amtsgericht auf Antrag des Vorstands dem Verein die Rechtsfähigkeit zu entziehen (§ 73)";
    label en unofficial "If the number of members falls below three, the court withdraws legal capacity on the board's application (§ 73)";
    when antragsfrist_73_ende(v, e) and antrag_des_vorstands_am(v, a) and a <= e;
    then rechtsfaehigkeit_entzogen(v);
}

// §§ 74–79a Eintragungen bei Auflösung, Insolvenz und Liquidation; Einsicht.
pub relation insolvenzvermerk_von_amts_wegen(v: Verein) kind empirical {
    label de official "die Eröffnung des Insolvenzverfahrens, die rechtskräftige Abweisung mangels Masse und die Auflösung nach § 42 Absatz 2 Satz 1 sind von Amts wegen einzutragen (§ 75 Abs. 1)";
    label en unofficial "the opening of insolvency proceedings and related matters are entered ex officio (§ 75 (1))";
}
pub relation liquidatoren_angemeldet(v: Verein) kind empirical {
    label de official "die Liquidatoren und ihre Vertretungsmacht sind zur Eintragung angemeldet (§ 76 Abs. 2)";
    label en unofficial "the liquidators and their authority have been filed for entry (§ 76 (2))";
}
pub relation anmeldung_oeffentlich_beglaubigt(v: Verein) kind empirical {
    label de official "die Anmeldung ist mittels öffentlich beglaubigter Erklärung abgegeben (§ 77 Abs. 1)";
    label en unofficial "the application was made by publicly certified declaration (§ 77 (1))";
}
pub relation anmeldung_wirksam(v: Verein) kind institutional {
    label de official "die Anmeldung zum Vereinsregister ist formgerecht (§ 77)";
    label en unofficial "the application to the register is in due form (§ 77)";
}
pub relation pflicht_aus_den_paragraphen_67_bis_76_verletzt(v: Verein, p: Person) kind empirical {
    label de official "ein Mitglied des Vorstands oder ein Liquidator befolgt die Vorschriften des § 67 Abs. 1, des § 71 Abs. 1, des § 72, des § 74 Abs. 2, des § 75 Absatz 2 oder des § 76 nicht (§ 78)";
    label en unofficial "a board member or liquidator fails to comply with §§ 67 (1), 71 (1), 72, 74 (2), 75 (2) or 76 (§ 78)";
}
pub relation zwangsgeld_zulaessig(v: Verein, p: Person) kind institutional {
    label de official "das Amtsgericht kann die Befolgung durch Festsetzung von Zwangsgeld anhalten (§ 78)";
    label en unofficial "the local court may enforce compliance by imposing a coercive fine (§ 78)";
}
pub relation einsicht_verlangt(v: Verein, p: Person) kind empirical {
    label de official "eine Person verlangt Einsicht in das Vereinsregister oder eine Abschrift (§ 79 Abs. 1)";
    label en unofficial "a person requests inspection of the register or a copy (§ 79 (1))";
}
pub relation einsicht_gestattet(v: Verein, p: Person) kind institutional {
    label de official "die Einsicht des Vereinsregisters sowie der eingereichten Dokumente ist jedem gestattet; von den Eintragungen kann eine Abschrift verlangt werden (§ 79 Abs. 1)";
    label en unofficial "inspection of the register and the documents submitted is permitted to everyone; copies may be requested (§ 79 (1))";
}
pub relation nutzer_gefaehrdet_die_abrufeinrichtung(v: Verein, p: Person) kind empirical {
    label de official "der Nutzer gefährdet die Funktionsfähigkeit der Abrufeinrichtung, überschreitet die zulässige Einsicht oder missbraucht übermittelte Daten (§ 79 Abs. 4)";
    label en unofficial "the user endangers the retrieval facility, exceeds permitted inspection or misuses data (§ 79 (4))";
}
pub relation ausschluss_vom_abrufverfahren(v: Verein, p: Person) kind institutional {
    label de official "die zuständige Stelle kann den Nutzer von der Teilnahme am automatisierten Abrufverfahren ausschließen (§ 79 Abs. 4)";
    label en unofficial "the competent body may exclude the user from the automated retrieval procedure (§ 79 (4))";
}
pub relation auskunftspflicht_ueber_offenlegung(v: Verein, p: Person) kind institutional {
    label de official "das Registergericht ist nicht verpflichtet, über die Offenlegung personenbezogener Daten an Dritte Auskunft zu erteilen; das Widerspruchsrecht nach Artikel 21 der Verordnung (EU) 2016/679 ist nicht anzuwenden (§ 79a Abs. 1 Satz 2, Abs. 3)";
    label en unofficial "the register court need not give information on disclosure to third parties; the right to object under Article 21 GDPR does not apply (§ 79a (1), (3))";
}

@source(BGB_P74)
rule EintragungDerAufloesung(v: Verein) strict {
    label de official "Die Auflösung des Vereins sowie die Entziehung der Rechtsfähigkeit ist in das Vereinsregister einzutragen; wird der Verein durch Beschluss der Mitgliederversammlung aufgelöst, so hat der Vorstand die Auflösung zur Eintragung anzumelden (§ 74 Abs. 1, 2)";
    label en unofficial "Dissolution and deprivation of legal capacity are entered in the register; the board files a dissolution by resolution (§ 74 (1), (2))";
    when verein_aufgeloest(v);
    then eintragungsinhalt(v, Aufloesung);
}

@source(BGB_P74)
rule EintragungDerEntziehung(v: Verein) strict {
    label de official "Die Entziehung der Rechtsfähigkeit ist in das Vereinsregister einzutragen (§ 74 Abs. 1)";
    label en unofficial "The deprivation of legal capacity is entered in the register (§ 74 (1))";
    when rechtsfaehigkeit_entzogen(v);
    then eintragungsinhalt(v, EntziehungDerRechtsfaehigkeit);
}

@source(BGB_P75)
rule EintragungenBeiInsolvenz(v: Verein) strict {
    label de official "Die Eröffnung des Insolvenzverfahrens und der Beschluss, durch den die Eröffnung mangels Masse rechtskräftig abgewiesen worden ist, sowie die Auflösung des Vereins nach § 42 Absatz 2 Satz 1 sind von Amts wegen einzutragen (§ 75 Abs. 1)";
    label en unofficial "The opening of insolvency proceedings and related decisions are entered ex officio (§ 75 (1))";
    when insolvenzvermerk_von_amts_wegen(v);
    then eintragungsinhalt(v, Insolvenzvermerk);
}

@source(BGB_P75)
rule EintragungDerFortsetzung(v: Verein) strict {
    label de official "Wird der Verein durch Beschluss der Mitgliederversammlung nach § 42 Absatz 1 Satz 2 fortgesetzt, so hat der Vorstand die Fortsetzung zur Eintragung anzumelden (§ 75 Abs. 2)";
    label en unofficial "Where the association is continued by resolution, the board files the continuation for entry (§ 75 (2))";
    when verein_fortgesetzt(v);
    then eintragungsinhalt(v, FortsetzungDesVereins);
}

@source(BGB_P76)
rule EintragungDerLiquidatoren(v: Verein) strict {
    label de official "Bei der Liquidation des Vereins sind die Liquidatoren und ihre Vertretungsmacht in das Vereinsregister einzutragen; das Gleiche gilt für die Beendigung des Vereins nach der Liquidation (§ 76 Abs. 1)";
    label en unofficial "On liquidation the liquidators and their authority are entered, as is the termination after liquidation (§ 76 (1))";
    when liquidation_erforderlich(v);
    then eintragungsinhalt(v, Liquidatoren);
}

@source(BGB_P77)
rule FormDerAnmeldung(v: Verein) strict {
    label de official "Die Anmeldungen zum Vereinsregister sind von Mitgliedern des Vorstands sowie von den Liquidatoren mittels öffentlich beglaubigter Erklärung abzugeben; die öffentliche Beglaubigung mittels Videokommunikation gemäß § 40a des Beurkundungsgesetzes ist zulässig (§ 77)";
    label en unofficial "Applications to the register are made by board members or liquidators by publicly certified declaration; video certification is permitted (§ 77)";
    when anmeldung_durch_den_vorstand(v) and anmeldung_oeffentlich_beglaubigt(v);
    then anmeldung_wirksam(v);
}

@source(BGB_P78)
rule ZwangsgeldGegenVorstandsmitglieder(v: Verein, p: Person) strict {
    label de official "Das Amtsgericht kann die Mitglieder des Vorstands zur Befolgung der Vorschriften des § 67 Abs. 1, des § 71 Abs. 1, des § 72, des § 74 Abs. 2, des § 75 Absatz 2 und des § 76 durch Festsetzung von Zwangsgeld anhalten; in gleicher Weise können die Liquidatoren zur Befolgung des § 76 angehalten werden (§ 78)";
    label en unofficial "The local court may enforce compliance by board members and liquidators by imposing a coercive fine (§ 78)";
    when pflicht_aus_den_paragraphen_67_bis_76_verletzt(v, p);
    then zwangsgeld_zulaessig(v, p);
}

@source(BGB_P79)
rule EinsichtIstJedemGestattet(v: Verein, p: Person) strict {
    label de official "Die Einsicht des Vereinsregisters sowie der von dem Verein bei dem Amtsgericht eingereichten Dokumente ist jedem gestattet; von den Eintragungen kann eine Abschrift verlangt werden, die auf Verlangen zu beglaubigen ist (§ 79 Abs. 1)";
    label en unofficial "Inspection of the register and the submitted documents is permitted to everyone; copies may be requested and certified (§ 79 (1))";
    when einsicht_verlangt(v, p);
    then einsicht_gestattet(v, p);
}

@source(BGB_P79)
rule AusschlussVomAbrufverfahren(v: Verein, p: Person) strict {
    label de official "Die zuständige Stelle kann einen Nutzer, der die Funktionsfähigkeit der Abrufeinrichtung gefährdet, die zulässige Einsicht überschreitet oder übermittelte Daten missbraucht, von der Teilnahme am automatisierten Abrufverfahren ausschließen; dasselbe gilt bei drohender Überschreitung oder drohendem Missbrauch (§ 79 Abs. 4)";
    label en unofficial "The competent body may exclude a user who endangers the facility, exceeds inspection or misuses data (§ 79 (4))";
    when nutzer_gefaehrdet_die_abrufeinrichtung(v, p);
    then ausschluss_vom_abrufverfahren(v, p);
}

@source(BGB_P79a)
rule DatenschutzImRegisterverfahren(v: Verein, p: Person) strict {
    label de official "Die Rechte nach Artikel 15 der Verordnung (EU) 2016/679 werden durch Einsicht in das Register gewährt; das Registergericht ist nicht verpflichtet, über die Offenlegung an Dritte Auskunft zu erteilen, und das Widerspruchsrecht nach Artikel 21 ist nicht anzuwenden (§ 79a Abs. 1, 3)";
    label en unofficial "Rights under Article 15 GDPR are granted by inspection; the court need not inform about disclosure and Article 21 does not apply (§ 79a (1), (3))";
    when einsicht_gestattet(v, p);
    then auskunftspflicht_ueber_offenlegung(v, p);
}
