    label en unofficial "The third party may rely on authority based on the announcement (§ 171)";
    when kundgebung_vollmacht_171_beginn_am(vm, d, tag);
    then liberty LibertyKundgebungVollmacht171 {
        holder d;
        action kundgebung_vollmacht_171_beginn_am(vm, d, tag);
        window [tag, infinity);
    };
}

