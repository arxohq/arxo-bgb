    label de official "Der Vertreter muss das Insichgeschäft ohne Gestattung unterlassen (§ 181)";
    label en unofficial "The representative must refrain from self-dealing without permission (§ 181)";
    when insichgeschaeft_181_beginn_am(r, p, tag);
    then duty DutyInsichgeschaeft181 {
        bearer p;
        achieve insichgeschaeft_181_unterlassen(r, p) during [tag, infinity);
    };
}

