    label en unofficial "the conditional right was preserved during suspense under § 160";
}
@source(BGB_P160)
rule PositionSchwebezeit160(r: Rechtsgeschaeft, p: Person, tag: Date) defeasible {
    label de official "Der andere Teil muss das bedingte Recht während der Schwebezeit wahren (§ 160)";
    label en unofficial "The other party must preserve the conditional right during suspense (§ 160)";
    when schwebezeit_160_beginn_am(r, p, tag);
    then duty DutySchwebezeit160 {
        bearer p;
        achieve schwebezeit_160_recht_gewahrt(r, p) during [tag, infinity);
    };
}

