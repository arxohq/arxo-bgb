    key(r);
    label de official "Beginn der Pflicht zur Beachtung des Widerrufs der Einwilligung nach § 183";
    label en unofficial "start of the duty to respect revocation of consent under § 183";
}
pub relation einwilligung_183_unwirksam(r: Rechtsgeschaeft, p: Person) kind institutional {
    label de official "Die vorherige Einwilligung ist nach § 183 unwirksam";
    label en unofficial "the prior consent is ineffective under § 183";
}
@source(BGB_P183)
rule PositionWiderrufEinwilligung183(r: Rechtsgeschaeft, p: Person, tag: Date) defeasible {
    label de official "Die Partei muss den Widerruf der vorherigen Einwilligung beachten (§ 183)";
    label en unofficial "The party must respect revocation of prior consent (§ 183)";
    when widerruf_einwilligung_183_beginn_am(r, p, tag);
    then duty DutyWiderrufEinwilligung183 {
        bearer p;
        achieve einwilligung_183_unwirksam(r, p) during [tag, infinity);
    };
}

