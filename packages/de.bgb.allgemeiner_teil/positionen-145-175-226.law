pub relation kenntnis_erloeschen_173_beachtet(vm: Vollmacht, d: Person) kind institutional {
    label de official "Die Kenntnis des Erlöschens der Vollmacht ist nach § 173 beachtet";
    label en unofficial "knowledge of the lapse of authority is respected under § 173";
}
@source(BGB_P173)
rule PositionKenntnisErloeschen173(vm: Vollmacht, d: Person, tag: Date) defeasible {
    label de official "Der Dritte muss das Erlöschen der Vollmacht bei Kenntnis beachten (§ 173)";
    label en unofficial "The third party must respect the lapse of authority when aware of it (§ 173)";
    when kenntnis_erloeschen_173_beginn_am(vm, d, tag);
    then duty DutyKenntnisErloeschen173 {
        bearer d;
        achieve kenntnis_erloeschen_173_beachtet(vm, d) during [tag, infinity);
    };
}

