    label en unofficial "the unilateral transaction is not undertaken without authority under § 180";
}
@source(BGB_P180)
rule PositionVertretungEinseitig180(r: Rechtsgeschaeft, p: Person, tag: Date) defeasible {
    label de official "Der Vertreter muss einseitige Rechtsgeschäfte ohne Vertretungsmacht unterlassen (§ 180)";
    label en unofficial "The representative must refrain from unilateral acts without authority (§ 180)";
    when vertretung_einseitig_180_beginn_am(r, p, tag);
    then duty DutyVertretungEinseitig180 {
        bearer p;
        achieve vertretung_einseitig_180_unterlassen(r, p) during [tag, infinity);
    };
