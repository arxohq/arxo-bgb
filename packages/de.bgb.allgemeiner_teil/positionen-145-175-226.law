    label de official "Der Vertretene darf das Rechtsgeschäft rückwirkend genehmigen (§ 184)";
    label en unofficial "The principal may approve the transaction retroactively (§ 184)";
    when genehmigung_184_beginn_am(r, p, tag);
    then liberty LibertyGenehmigung184 {
        holder p;
        action genehmigung_184_beginn_am(r, p, tag);
