rule PositionBestaetigung141(r: Rechtsgeschaeft, p: Person, tag: Date) defeasible {
    label de official "Die Partei muss nach Bestätigung des nichtigen Vertrags die vertragsgemäße Leistung gewähren (§ 141)";
    label en unofficial "The party must grant contractual performance after confirming the void contract (§ 141)";
    when bestaetigung_141_beginn_am(r, p, tag);
    then duty DutyBestaetigung141 {
        bearer p;
        achieve leistung_141_geschuldet(r, p) during [tag, infinity);
    };
}

