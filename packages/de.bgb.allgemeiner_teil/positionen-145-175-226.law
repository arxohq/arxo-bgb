}
@source(BGB_P169)
rule PositionErloscheneVollmacht169(vm: Vollmacht, d: Person, tag: Date) defeasible {
    label de official "Der Dritte muss eine erloschene Vollmacht bei Kenntnis ihres Erlöschens unberücksichtigt lassen (§ 169)";
    label en unofficial "The third party must disregard lapsed authority when aware of its lapse (§ 169)";
    when erloschene_vollmacht_169_beginn_am(vm, d, tag);
    then duty DutyErloscheneVollmacht169 {
        bearer d;
        achieve vollmacht_169_nicht_genutzt(vm, d) during [tag, infinity);
    };
}

pub relation vollmacht_dritter_170_beginn_am(vm: Vollmacht, d: Person, tag: Date) kind empirical {
    key(vm);
    label de official "Beginn des Vertrauensschutzes des Dritten bei Vollmachtserteilung nach § 170";
    label en unofficial "start of the third party's reliance protection after authority grant under § 170";
}
@source(BGB_P170)
rule PositionVollmachtDritter170(vm: Vollmacht, d: Person, tag: Date) defeasible {
    label de official "Der Dritte darf auf die fortbestehende Vollmacht vertrauen, bis ihm das Erlöschen angezeigt wird (§ 170)";
    label en unofficial "The third party may rely on continuing authority until notified of its lapse (§ 170)";
    when vollmacht_dritter_170_beginn_am(vm, d, tag);
    then liberty LibertyVollmachtDritter170 {
        holder d;
        action vollmacht_dritter_170_beginn_am(vm, d, tag);
        window [tag, infinity);
    };
}

