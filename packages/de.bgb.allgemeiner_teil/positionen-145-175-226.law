    label de official "Beginn des Rechts zur Erklärung der Zustimmung nach § 182";
    label en unofficial "start of the power to declare consent under § 182";
}
@source(BGB_P182)
rule PositionZustimmung182(r: Rechtsgeschaeft, p: Person, tag: Date) defeasible {
    label de official "Der Zustimmungsberechtigte darf die Zustimmung erklären (§ 182)";
    label en unofficial "The person entitled to consent may declare consent (§ 182)";
    when zustimmung_182_beginn_am(r, p, tag);
    then liberty LibertyZustimmung182 {
        holder p;
        action zustimmung_182_beginn_am(r, p, tag);
        window [tag, infinity);
    };
