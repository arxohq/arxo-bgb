    label en unofficial "The principal may revoke the authority unless revocation is excluded (§ 168)";
    when widerruf_vollmacht_168_beginn_am(vm, p, tag);
    then liberty LibertyWiderrufVollmacht168 {
        holder p;
        action widerruf_vollmacht_168_beginn_am(vm, p, tag);
        window [tag, infinity);
    };
