pub relation bindung_antrag_145_beginn_am(a: Antrag, p: Person, tag: Date) kind empirical {
    key(a);
    label de official "Beginn der Bindung des Antragenden an den Antrag (§ 145)";
    label en unofficial "start of the offeror's being bound by the offer (§ 145)";
}
@source(BGB_P145)
rule PositionBindungAntrag145(a: Antrag, p: Person, tag: Date) defeasible {
    label de official "Der Antragende ist an den Antrag gebunden (§ 145)";
    label en unofficial "The offeror is bound by the offer (§ 145)";
    when antragender(a, p) and bindung_antrag_145_beginn_am(a, p, tag);
    then liberty LibertyBindungAntrag145 {
        holder p;
        action bindung_antrag_145_beginn_am(a, p, tag);
        window [tag, infinity);
    };
}

