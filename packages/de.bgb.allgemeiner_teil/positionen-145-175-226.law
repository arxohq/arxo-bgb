    label en unofficial "the representative's knowledge is imputed under § 166";
}
@source(BGB_P166)
rule PositionKenntnisVertreter166(r: Rechtsgeschaeft, v: Person, tag: Date) defeasible {
    label de official "Die Partei muss die Kenntnis des Vertreters gegen sich gelten lassen (§ 166)";
    label en unofficial "The party must accept the representative's knowledge as imputed (§ 166)";
    when kenntnis_vertreter_166_beginn_am(r, v, tag);
    then duty DutyKenntnisVertreter166 {
        bearer v;
        achieve kenntnis_vertreter_166_zugerechnet(r, v) during [tag, infinity);
    };
}

