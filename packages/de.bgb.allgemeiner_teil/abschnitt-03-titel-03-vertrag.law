// BUCH 1 ABSCHNITT 3 TITEL 3 — VERTRAG (§§ 145–157)
//
// KANÄLE (DECISION-0194). Der Zeitpunkt, „in welchem der Antragende den
// Eingang der Antwort unter regelmäßigen Umständen erwarten darf“ (§ 147
// Abs. 2), die Verkehrssitte des § 151 Satz 1, die Annahme des § 155 und die
// Auslegung nach Treu und Glauben mit Rücksicht auf die Verkehrssitte
// (§ 157) sind WERTUNGEN des Gerichts; der Zugang und seine Tage sind
// festgestellte Tatsachen.
//
// FRIST DES § 148. Der Antragende bestimmt entweder einen TAG (dann gilt er
// unmittelbar) oder eine DAUER; die Dauer rechnet `de.bgb.fristen` vom Zugang
// des Antrags (§ 187 Abs. 1, § 188 Abs. 2, § 193) — Zeile in DEADLINES.json.

language "law.core" version "0.2";
package de.bgb.allgemeiner_teil version "0.1.0";
namespace "urn:de:corpus:clir:bgb-allgemeiner-teil";

pub entity Antrag {
    label de official "Antrag auf Schließung eines Vertrags (§ 145)";
    label en unofficial "offer to conclude a contract (§ 145)";
}
pub entity Annahme {
    label de official "Annahme des Antrags (§§ 146–151)";
    label en unofficial "acceptance of the offer (§§ 146–151)";
}

pub relation antragender(a: Antrag, p: Person) kind empirical {
    key(a);
    label de official "der Antragende (§ 145)";
    label en unofficial "the offeror (§ 145)";
}
pub relation antragsempfaenger(a: Antrag, p: Person) kind empirical {
    key(a);
    label de official "derjenige, dem der Antrag gemacht wird (§ 145)";
    label en unofficial "the person to whom the offer is made (§ 145)";
}
pub relation antrag_des_vertrags(v: Rechtsgeschaeft, a: Antrag) kind empirical {
    key(v);
    label de official "Antrag, aus dem der Vertrag hervorgehen soll (§ 145)";
    label en unofficial "offer from which the contract is to arise (§ 145)";
}
pub relation annahme_des_antrags(a: Antrag, an: Annahme) kind empirical {
    label de official "Annahme dieses Antrags (§§ 146–151)";
    label en unofficial "acceptance of this offer (§§ 146–151)";
}
pub relation antrag_zugegangen_am(a: Antrag, tag: Date) kind empirical {
    key(a);
    label de official "Tag, an dem der Antrag dem Empfänger zugeht (§ 130 Abs. 1, § 147 Abs. 2) — festgestellte Tatsache";
    label en unofficial "day on which the offer reaches the addressee (§ 130 (1), § 147 (2)) — established fact";
}
pub relation annahme_zugegangen_am(an: Annahme, tag: Date) kind empirical {
    key(an);
    label de official "Tag, an dem die Annahmeerklärung dem Antragenden zugeht (§§ 147–150) — festgestellte Tatsache";
    label en unofficial "day on which the acceptance reaches the offeror (§§ 147–150) — established fact";
}
pub relation gebundenheit_ausgeschlossen(a: Antrag) kind empirical {
    label de official "der Antragende hat die Gebundenheit ausgeschlossen (§ 145 Halbsatz 2)";
    label en unofficial "the offeror has excluded being bound (§ 145)";
}
pub relation antrag_abgelehnt(a: Antrag) kind empirical {
    label de official "der Antrag ist dem Antragenden gegenüber abgelehnt worden (§ 146)";
    label en unofficial "the offer has been rejected towards the offeror (§ 146)";
}
pub relation antrag_unter_anwesenden(a: Antrag) kind empirical {
    label de official "der Antrag ist einem Anwesenden oder mittels Fernsprechers oder einer sonstigen technischen Einrichtung von Person zu Person gemacht (§ 147 Abs. 1)";
    label en unofficial "the offer was made to a person present or person-to-person by telephone or similar means (§ 147 (1))";
}
pub relation sofort_angenommen(a: Antrag) kind empirical {
    label de official "der einem Anwesenden gemachte Antrag ist sofort angenommen worden (§ 147 Abs. 1 Satz 1)";
    label en unofficial "the offer made to a person present was accepted immediately (§ 147 (1))";
}
pub relation annahmefrist_bestimmt_bis(a: Antrag, tag: Date) kind empirical {
    key(a);
    label de official "der Antragende hat für die Annahme einen Tag bestimmt, bis zu dem sie erfolgen kann (§ 148)";
    label en unofficial "the offeror fixed a day by which acceptance may be made (§ 148)";
}
pub relation annahmefrist_148(a: Antrag, f: Frist) kind empirical {
    key(a);
    label de official "vom Antragenden nach Dauer bestimmte Annahmefrist (§ 148), gerechnet vom Zugang des Antrags";
    label en unofficial "acceptance period fixed by duration (§ 148), counted from receipt of the offer";
}
pub relation annahmefrist_dauer(a: Antrag, dauer: Quantity) kind empirical {
    key(a);
    label de official "Dauer der vom Antragenden bestimmten Annahmefrist in Wochen, Monaten oder Jahren (§ 148, § 188 Abs. 2)";
    label en unofficial "duration of the acceptance period fixed by the offeror (§ 148, § 188 (2))";
}
pub relation annahmefrist_ende(a: Antrag, tag: Date) kind institutional {
    key(a);
    label de official "Tag, mit dessen Ablauf die Annahmefrist endet (§§ 147, 148 mit §§ 187, 188, 193)";
    label en unofficial "day at whose end the period for acceptance ends (§§ 147, 148 with §§ 187, 188, 193)";
}
pub relation annahme_rechtzeitig(a: Antrag, an: Annahme) kind institutional {
    label de official "die Annahme ist rechtzeitig erfolgt (§§ 147–149)";
    label en unofficial "the acceptance was made in time (§§ 147–149)";
}
pub relation annahme_verspaetet(a: Antrag, an: Annahme) kind institutional {
    label de official "die Annahme ist verspätet (§§ 147, 148, 150 Abs. 1)";
    label en unofficial "the acceptance is late (§§ 147, 148, 150 (1))";
}
pub relation antrag_erloschen(a: Antrag) kind institutional {
    label de official "der Antrag ist erloschen (§ 146)";
    label en unofficial "the offer has lapsed (§ 146)";
}
pub relation vertrag_zustande_gekommen(v: Rechtsgeschaeft) kind institutional {
    label de official "der Vertrag ist zustande gekommen (§§ 145–157)";
    label en unofficial "the contract has been concluded (§§ 145–157)";
}
pub relation neuer_antrag(an: Annahme) kind institutional {
    label de official "die verspätete oder abändernde Annahme gilt als neuer Antrag (§ 150)";
    label en unofficial "a late or modifying acceptance counts as a new offer (§ 150)";
}
pub relation antrag_bindend(a: Antrag) kind institutional {
    label de official "der Antragende ist an den Antrag gebunden (§ 145)";
    label en unofficial "the offeror is bound by the offer (§ 145)";
}

@source(BGB_P145)
rule BindungAnDenAntrag(a: Antrag) strict {
    label de official "Wer einem anderen die Schließung eines Vertrags anträgt, ist an den Antrag gebunden, es sei denn, dass er die Gebundenheit ausgeschlossen hat (§ 145)";
    label en unofficial "A person who offers to another to conclude a contract is bound by the offer unless they excluded being bound (§ 145)";
    when antrag_zugegangen_am(a, _) and not gebundenheit_ausgeschlossen(a);
    then antrag_bindend(a);
}

@source(BGB_P146)
rule AntragErlischtDurchAblehnung(a: Antrag) strict {
    label de official "Der Antrag erlischt, wenn er dem Antragenden gegenüber abgelehnt wird (§ 146)";
    label en unofficial "The offer lapses if it is rejected towards the offeror (§ 146)";
    when antrag_abgelehnt(a);
    then antrag_erloschen(a);
}

@source(BGB_P146)
rule AntragErlischtDurchVerspaeteteAnnahme(a: Antrag, an: Annahme) strict {
    label de official "Der Antrag erlischt, wenn er nicht dem Antragenden gegenüber nach den §§ 147 bis 149 rechtzeitig angenommen wird (§ 146)";
    label en unofficial "The offer lapses if it is not accepted in time under §§ 147 to 149 (§ 146)";
    when annahme_verspaetet(a, an);
    then antrag_erloschen(a);
}

@source(BGB_P147)
pub external judgment relation regelmaessige_annahmefrist_endet_am(a: Antrag, tag: Date) {
    authority Court;
    label de official "§ 147 Abs. 2: Zeitpunkt, in welchem der Antragende den Eingang der Antwort unter regelmäßigen Umständen erwarten darf";
    label en unofficial "§ 147 (2): the time at which the offeror may expect the answer to arrive under ordinary circumstances";
}

@source(BGB_P147)
rule AnnahmeUnterAnwesendenNurSofort(a: Antrag, an: Annahme) strict {
    label de official "Der einem Anwesenden gemachte Antrag kann nur sofort angenommen werden; dies gilt auch von einem mittels Fernsprechers oder einer sonstigen technischen Einrichtung von Person zu Person gemachten Antrag (§ 147 Abs. 1)";
    label en unofficial "An offer made to a person present may be accepted only immediately; the same applies to person-to-person telephone offers (§ 147 (1))";
    when antrag_unter_anwesenden(a) and annahme_des_antrags(a, an) and sofort_angenommen(a);
    then annahme_rechtzeitig(a, an);
}

@source(BGB_P147)
rule VerspaeteteAnnahmeUnterAnwesenden(a: Antrag, an: Annahme) strict {
    label de official "Die nicht sofort erklärte Annahme eines einem Anwesenden gemachten Antrags ist verspätet (§ 147 Abs. 1)";
    label en unofficial "An acceptance of an offer to a person present that is not immediate is late (§ 147 (1))";
    when antrag_unter_anwesenden(a) and annahme_des_antrags(a, an) and not sofort_angenommen(a);
    then annahme_verspaetet(a, an);
}

@source(BGB_P147)
rule AnnahmefristUnterAbwesenden(a: Antrag, tag: Date) strict {
    label de official "Der einem Abwesenden gemachte Antrag kann nur bis zu dem Zeitpunkt angenommen werden, in welchem der Antragende den Eingang der Antwort unter regelmäßigen Umständen erwarten darf (§ 147 Abs. 2)";
    label en unofficial "An offer to an absent party may be accepted only up to the time the offeror may expect the answer under ordinary circumstances (§ 147 (2))";
    when regelmaessige_annahmefrist_endet_am(a, tag) and not antrag_unter_anwesenden(a);
    then annahmefrist_ende(a, tag);
}

@source(BGB_P148)
rule BestimmteAnnahmefristAlsTag(a: Antrag, tag: Date) strict {
    label de official "Hat der Antragende für die Annahme des Antrags eine Frist bestimmt, so kann die Annahme nur innerhalb der Frist erfolgen (§ 148) — vom Antragenden genannter Tag";
    label en unofficial "Where the offeror has fixed a period for acceptance, acceptance may only occur within it (§ 148) — day named by the offeror";
    when annahmefrist_bestimmt_bis(a, tag);
    then annahmefrist_ende(a, tag);
}

@source(BGB_P148)
rule BestimmteAnnahmefristEreignis(a: Antrag, f: Frist, d: Date) strict {
    label de official "Die nach Dauer bestimmte Annahmefrist läuft vom Zugang des Antrags (§ 148 mit § 187 Abs. 1)";
    label en unofficial "A period for acceptance fixed by duration runs from receipt of the offer (§ 148 with § 187 (1))";
    when annahmefrist_148(a, f) and antrag_zugegangen_am(a, d);
    then de.bgb.fristen::frist_ereignis(f, d);
}

@source(BGB_P148)
rule BestimmteAnnahmefristDauer(a: Antrag, f: Frist, dauer: Quantity) strict {
    label de official "Die Dauer der Annahmefrist bestimmt der Antragende (§ 148); gerechnet wird sie nach § 188 Abs. 2";
    label en unofficial "The offeror fixes the duration of the period for acceptance (§ 148); it is computed under § 188 (2)";
    when annahmefrist_148(a, f) and annahmefrist_dauer(a, dauer);
    then de.bgb.fristen::frist_dauer_kalender(f, dauer);
}

@source(BGB_P148)
rule BestimmteAnnahmefristEnde(a: Antrag, f: Frist, e: Date) strict {
    label de official "Das Ende der Annahmefrist berechnet sich nach den §§ 187 Abs. 1, 188 Abs. 2 und 193 (de.bgb.fristen)";
    label en unofficial "The end of the period for acceptance is computed under §§ 187 (1), 188 (2) and 193";
    when annahmefrist_148(a, f) and de.bgb.fristen::frist_ende(f, e);
    then annahmefrist_ende(a, e);
}

@source(BGB_P148)
rule AnnahmeInnerhalbDerFristRechtzeitig(a: Antrag, an: Annahme, e: Date, z: Date) strict {
    label de official "Die innerhalb der Frist zugegangene Annahme ist rechtzeitig (§§ 147 Abs. 2, 148)";
    label en unofficial "An acceptance reaching the offeror within the period is timely (§§ 147 (2), 148)";
    when annahme_des_antrags(a, an) and annahmefrist_ende(a, e) and annahme_zugegangen_am(an, z) and z <= e;
    then annahme_rechtzeitig(a, an);
}

@source(BGB_P148)
rule AnnahmeNachFristVerspaetet(a: Antrag, an: Annahme, e: Date, z: Date) strict {
    label de official "Die nach dem Ablauf der Frist zugegangene Annahme ist verspätet (§§ 147 Abs. 2, 148, 150 Abs. 1)";
    label en unofficial "An acceptance reaching the offeror after the period is late (§§ 147 (2), 148, 150 (1))";
    when annahme_des_antrags(a, an) and annahmefrist_ende(a, e) and annahme_zugegangen_am(an, z) and z > e;
    then annahme_verspaetet(a, an);
}

// § 149 Verspätet zugegangene Annahmeerklärung.
pub relation rechtzeitig_abgesendet_erkennbar(an: Annahme) kind empirical {
    label de official "die verspätet zugegangene Annahmeerklärung ist dergestalt abgesendet worden, dass sie bei regelmäßiger Beförderung rechtzeitig zugegangen wäre, und der Antragende musste dies erkennen (§ 149 Satz 1)";
    label en unofficial "the late acceptance was dispatched so that it would have arrived in time under ordinary conveyance, and the offeror had to recognise this (§ 149 sentence 1)";
}
pub relation verspaetungsanzeige_erfolgt(an: Annahme) kind empirical {
    label de official "der Antragende hat die Verspätung dem Annehmenden angezeigt (§ 149 Satz 1)";
    label en unofficial "the offeror notified the acceptor of the delay (§ 149 sentence 1)";
}

@source(BGB_P149)
pub external judgment relation verspaetungsanzeige_unverzueglich(an: Annahme) {
    authority Court;
    label de official "§ 149 Satz 1: die Anzeige der Verspätung ist unverzüglich nach dem Empfang der Erklärung erfolgt";
    label en unofficial "§ 149 sentence 1: the notice of delay was given without undue delay after receipt of the declaration";
}

@source(BGB_P149)
rule AnnahmeGiltAlsNichtVerspaetet(a: Antrag, an: Annahme) strict {
    label de official "Verzögert der Antragende die Absendung der Anzeige, so gilt die Annahme als nicht verspätet (§ 149 Satz 2)";
    label en unofficial "If the offeror delays sending the notice, the acceptance is deemed not to be late (§ 149 sentence 2)";
    when annahme_des_antrags(a, an)
        and rechtzeitig_abgesendet_erkennbar(an)
        and not verspaetungsanzeige_erfolgt(an);
    then annahme_rechtzeitig(a, an);
}

@source(BGB_P149)
rule AnnahmeBleibtVerspaetetNachRechtzeitigerAnzeige(a: Antrag, an: Annahme) strict {
    label de official "Zeigt der Antragende die Verspätung unverzüglich an, so bleibt es bei der Verspätung (§ 149 Satz 1)";
    label en unofficial "If the offeror gives notice of the delay without undue delay, the acceptance remains late (§ 149 sentence 1)";
    when annahme_des_antrags(a, an)
        and rechtzeitig_abgesendet_erkennbar(an)
        and verspaetungsanzeige_erfolgt(an)
        and verspaetungsanzeige_unverzueglich(an);
    then annahme_verspaetet(a, an);
}

// § 150 Verspätete und abändernde Annahme.
pub relation annahme_unter_aenderungen(an: Annahme) kind empirical {
    label de official "die Annahme erfolgt unter Erweiterungen, Einschränkungen oder sonstigen Änderungen (§ 150 Abs. 2)";
    label en unofficial "the acceptance is made with extensions, restrictions or other modifications (§ 150 (2))";
}

@source(BGB_P150)
rule VerspaeteteAnnahmeIstNeuerAntrag(a: Antrag, an: Annahme) strict {
    label de official "Die verspätete Annahme eines Antrags gilt als neuer Antrag (§ 150 Abs. 1)";
    label en unofficial "A late acceptance of an offer counts as a new offer (§ 150 (1))";
    when annahme_verspaetet(a, an);
    then neuer_antrag(an);
}

@source(BGB_P150)
rule AbaenderndeAnnahmeIstAblehnungMitNeuemAntrag(a: Antrag, an: Annahme) strict {
    label de official "Eine Annahme unter Erweiterungen, Einschränkungen oder sonstigen Änderungen gilt als Ablehnung verbunden mit einem neuen Antrag (§ 150 Abs. 2)";
    label en unofficial "An acceptance with extensions, restrictions or modifications counts as a rejection combined with a new offer (§ 150 (2))";
    when annahme_des_antrags(a, an) and annahme_unter_aenderungen(an);
    then neuer_antrag(an);
}

@source(BGB_P150)
rule AbaenderndeAnnahmeLaesstAntragErloeschen(a: Antrag, an: Annahme) strict {
    label de official "Die abändernde Annahme gilt als Ablehnung; damit erlischt der Antrag (§ 150 Abs. 2 mit § 146)";
    label en unofficial "A modifying acceptance counts as a rejection, so the offer lapses (§ 150 (2) with § 146)";
    when annahme_des_antrags(a, an) and annahme_unter_aenderungen(an);
    then antrag_erloschen(a);
}

// § 151 Annahme ohne Erklärung gegenüber dem Antragenden.
@source(BGB_P151)
pub external judgment relation erklaerung_nach_verkehrssitte_nicht_zu_erwarten(a: Antrag) {
    authority Court;
    label de official "§ 151 Satz 1: eine Erklärung der Annahme gegenüber dem Antragenden ist nach der Verkehrssitte nicht zu erwarten";
    label en unofficial "§ 151 sentence 1: according to common usage a declaration of acceptance to the offeror is not to be expected";
}

pub relation auf_erklaerung_verzichtet(a: Antrag) kind empirical {
    label de official "der Antragende hat auf die Erklärung der Annahme verzichtet (§ 151 Satz 1)";
    label en unofficial "the offeror has waived the declaration of acceptance (§ 151 sentence 1)";
}
pub relation annahme_betaetigt(a: Antrag, an: Annahme) kind empirical {
    label de official "der Antrag ist angenommen worden, ohne dass die Annahme dem Antragenden gegenüber erklärt wurde (§ 151 Satz 1)";
    label en unofficial "the offer was accepted without the acceptance being declared to the offeror (§ 151 sentence 1)";
}

@source(BGB_P151)
rule AnnahmeOhneErklaerungNachVerkehrssitte(v: Rechtsgeschaeft, a: Antrag, an: Annahme) strict {
    label de official "Der Vertrag kommt durch die Annahme des Antrags zustande, ohne dass die Annahme dem Antragenden gegenüber erklärt zu werden braucht, wenn eine solche Erklärung nach der Verkehrssitte nicht zu erwarten ist (§ 151 Satz 1)";
    label en unofficial "The contract is formed by acceptance without a declaration to the offeror where such a declaration is not to be expected under common usage (§ 151 sentence 1)";
    when antrag_des_vertrags(v, a)
        and annahme_des_antrags(a, an)
        and annahme_betaetigt(a, an)
        and erklaerung_nach_verkehrssitte_nicht_zu_erwarten(a);
    then vertrag_zustande_gekommen(v);
}

@source(BGB_P151)
rule AnnahmeOhneErklaerungBeiVerzicht(v: Rechtsgeschaeft, a: Antrag, an: Annahme) strict {
    label de official "Der Vertrag kommt auch dann ohne Erklärung gegenüber dem Antragenden zustande, wenn dieser auf sie verzichtet hat (§ 151 Satz 1)";
    label en unofficial "The contract is also formed without a declaration where the offeror has waived it (§ 151 sentence 1)";
    when antrag_des_vertrags(v, a)
        and annahme_des_antrags(a, an)
        and annahme_betaetigt(a, an)
        and auf_erklaerung_verzichtet(a);
    then vertrag_zustande_gekommen(v);
}

// § 152 Annahme bei notarieller Beurkundung.
pub relation annahme_notariell_beurkundet(an: Annahme) kind empirical {
    label de official "die Annahme ist nach § 128 notariell beurkundet worden, ohne dass beide Teile gleichzeitig anwesend waren (§ 152 Satz 1)";
    label en unofficial "the acceptance was notarially recorded under § 128 without both parties being present at the same time (§ 152 sentence 1)";
}

@source(BGB_P152)
rule VertragMitBeurkundungDerAnnahme(v: Rechtsgeschaeft, a: Antrag, an: Annahme) strict {
    label de official "Wird ein Vertrag notariell beurkundet, ohne dass beide Teile gleichzeitig anwesend sind, so kommt der Vertrag mit der nach § 128 erfolgten Beurkundung der Annahme zustande, wenn nicht ein anderes bestimmt ist (§ 152 Satz 1)";
    label en unofficial "Where a contract is notarially recorded without both parties present, it is formed upon the notarial recording of the acceptance (§ 152 sentence 1)";
    when antrag_des_vertrags(v, a) and annahme_des_antrags(a, an) and annahme_notariell_beurkundet(an);
    then vertrag_zustande_gekommen(v);
}

// Zustandekommen durch rechtzeitige Annahme (§§ 145–148 im Zusammenspiel).
@source(BGB_P145, BGB_P147)
rule VertragDurchRechtzeitigeAnnahme(v: Rechtsgeschaeft, a: Antrag, an: Annahme) strict {
    label de official "Der Vertrag kommt zustande, wenn der bindende Antrag rechtzeitig angenommen wird (§§ 145–148)";
    label en unofficial "The contract is formed when a binding offer is accepted in time (§§ 145–148)";
    when antrag_des_vertrags(v, a)
        and antrag_bindend(a)
        and annahme_rechtzeitig(a, an)
        and not annahme_unter_aenderungen(an);
    then vertrag_zustande_gekommen(v);
}

// § 153 Tod oder Geschäftsunfähigkeit des Antragenden.
pub relation antragender_stirbt_oder_wird_geschaeftsunfaehig(a: Antrag) kind empirical {
    label de official "der Antragende stirbt vor der Annahme oder wird geschäftsunfähig (§ 153)";
    label en unofficial "the offeror dies before acceptance or loses capacity (§ 153)";
}
pub relation anderer_wille_des_antragenden_anzunehmen(a: Antrag) kind empirical {
    label de official "ein anderer Wille des Antragenden ist anzunehmen (§ 153 Halbsatz 2) — Angabe des Falls";
    label en unofficial "a different intention of the offeror is to be assumed (§ 153) — case input";
}

@source(BGB_P153)
rule TodDesAntragendenHindertNicht(v: Rechtsgeschaeft, a: Antrag, an: Annahme) strict {
    label de official "Das Zustandekommen des Vertrags wird nicht dadurch gehindert, dass der Antragende vor der Annahme stirbt oder geschäftsunfähig wird, es sei denn, dass ein anderer Wille des Antragenden anzunehmen ist (§ 153)";
    label en unofficial "Formation is not prevented by the offeror's death or loss of capacity before acceptance, unless a different intention is to be assumed (§ 153)";
    when antrag_des_vertrags(v, a)
        and antragender_stirbt_oder_wird_geschaeftsunfaehig(a)
        and annahme_rechtzeitig(a, an)
        and not anderer_wille_des_antragenden_anzunehmen(a);
    then vertrag_zustande_gekommen(v);
}

// §§ 154, 155 Einigungsmangel.
pub entity Vertragspunkt {
    label de official "Punkt eines Vertrags, über den eine Vereinbarung getroffen werden soll (§§ 154, 155)";
    label en unofficial "point of a contract on which agreement is to be reached (§§ 154, 155)";
}
pub relation einigung_ueber_punkt_gefordert(v: Rechtsgeschaeft, punkt: Vertragspunkt) kind empirical {
    label de official "nach der Erklärung auch nur einer Partei soll über diesen Punkt eine Vereinbarung getroffen werden (§ 154 Abs. 1 Satz 1)";
    label en unofficial "according to the declaration of even one party, agreement is to be reached on this point (§ 154 (1))";
}
pub relation einigung_ueber_punkt_erzielt(v: Rechtsgeschaeft, punkt: Vertragspunkt) kind empirical {
    label de official "die Parteien haben sich über diesen Punkt geeinigt (§ 154 Abs. 1)";
    label en unofficial "the parties have agreed on this point (§ 154 (1))";
}
pub relation beurkundung_verabredet(v: Rechtsgeschaeft) kind empirical {
    label de official "eine Beurkundung des beabsichtigten Vertrags ist verabredet worden (§ 154 Abs. 2)";
    label en unofficial "a recording of the intended contract has been agreed (§ 154 (2))";
}
pub relation beurkundung_erfolgt(v: Rechtsgeschaeft) kind empirical {
    label de official "die verabredete Beurkundung ist erfolgt (§ 154 Abs. 2)";
    label en unofficial "the agreed recording has taken place (§ 154 (2))";
}
pub relation vertrag_im_zweifel_nicht_geschlossen(v: Rechtsgeschaeft) kind institutional {
    label de official "der Vertrag ist im Zweifel nicht geschlossen (§ 154)";
    label en unofficial "in case of doubt the contract is not concluded (§ 154)";
}
pub relation versteckter_einigungsmangel(v: Rechtsgeschaeft, punkt: Vertragspunkt) kind empirical {
    label de official "die Parteien, die den Vertrag als geschlossen ansehen, haben sich über einen Punkt, über den eine Vereinbarung getroffen werden sollte, in Wirklichkeit nicht geeinigt (§ 155)";
    label en unofficial "the parties who regard the contract as concluded have in fact not agreed on a point on which agreement was to be reached (§ 155)";
}
pub relation vereinbartes_gilt(v: Rechtsgeschaeft) kind institutional {
    label de official "das Vereinbarte gilt (§ 155)";
    label en unofficial "what was agreed applies (§ 155)";
}

@source(BGB_P154)
rule OffenerEinigungsmangel(v: Rechtsgeschaeft, punkt: Vertragspunkt) strict {
    label de official "Solange nicht die Parteien sich über alle Punkte eines Vertrags geeinigt haben, über die nach der Erklärung auch nur einer Partei eine Vereinbarung getroffen werden soll, ist im Zweifel der Vertrag nicht geschlossen (§ 154 Abs. 1 Satz 1)";
    label en unofficial "As long as the parties have not agreed on all points on which agreement is to be reached, the contract is in case of doubt not concluded (§ 154 (1))";
    when einigung_ueber_punkt_gefordert(v, punkt) and not einigung_ueber_punkt_erzielt(v, punkt);
    then vertrag_im_zweifel_nicht_geschlossen(v);
}

@source(BGB_P154)
rule FehlendeVerabredeteBeurkundung(v: Rechtsgeschaeft) strict {
    label de official "Ist eine Beurkundung des beabsichtigten Vertrags verabredet worden, so ist im Zweifel der Vertrag nicht geschlossen, bis die Beurkundung erfolgt ist (§ 154 Abs. 2)";
    label en unofficial "If a recording of the intended contract was agreed, in case of doubt the contract is not concluded until the recording is made (§ 154 (2))";
    when beurkundung_verabredet(v) and not beurkundung_erfolgt(v);
    then vertrag_im_zweifel_nicht_geschlossen(v);
}

@source(BGB_P155)
pub external judgment relation vertrag_auch_ohne_diesen_punkt_geschlossen(v: Rechtsgeschaeft, punkt: Vertragspunkt) {
    authority Court;
    label de official "§ 155: es ist anzunehmen, dass der Vertrag auch ohne eine Bestimmung über diesen Punkt geschlossen sein würde";
    label en unofficial "§ 155: it is to be assumed that the contract would have been concluded even without a provision on this point";
}

@source(BGB_P155)
rule VersteckterEinigungsmangel(v: Rechtsgeschaeft, punkt: Vertragspunkt) strict {
    label de official "Haben sich die Parteien bei einem Vertrag, den sie als geschlossen ansehen, über einen Punkt in Wirklichkeit nicht geeinigt, so gilt das Vereinbarte, sofern anzunehmen ist, dass der Vertrag auch ohne eine Bestimmung über diesen Punkt geschlossen sein würde (§ 155)";
    label en unofficial "Where the parties have in fact not agreed on a point, what was agreed applies if the contract would have been concluded without a provision on that point (§ 155)";
    when versteckter_einigungsmangel(v, punkt) and vertrag_auch_ohne_diesen_punkt_geschlossen(v, punkt);
    then vereinbartes_gilt(v);
}

@source(BGB_P155)
rule VersteckterEinigungsmangelOhneAnnahme(v: Rechtsgeschaeft, punkt: Vertragspunkt) strict {
    label de official "Ist nicht anzunehmen, dass der Vertrag auch ohne eine Bestimmung über diesen Punkt geschlossen sein würde, so gilt das Vereinbarte nicht (§ 155 im Umkehrschluss)";
    label en unofficial "If it is not to be assumed that the contract would have been concluded without a provision on that point, what was agreed does not apply (§ 155 a contrario)";
    when versteckter_einigungsmangel(v, punkt) and not vertrag_auch_ohne_diesen_punkt_geschlossen(v, punkt);
    then not vereinbartes_gilt(v);
}

// § 156 Versteigerung.
pub relation versteigerung(v: Rechtsgeschaeft) kind empirical {
    label de official "der Vertrag wird bei einer Versteigerung geschlossen (§ 156)";
    label en unofficial "the contract is concluded at an auction (§ 156)";
}
pub relation zuschlag_erteilt(v: Rechtsgeschaeft) kind empirical {
    label de official "der Zuschlag ist erteilt worden (§ 156 Satz 1)";
    label en unofficial "the knock-down has been made (§ 156 sentence 1)";
}
pub relation uebergebot_abgegeben(a: Antrag) kind empirical {
    label de official "ein Übergebot ist abgegeben worden (§ 156 Satz 2)";
    label en unofficial "a higher bid has been made (§ 156 sentence 2)";
}
pub relation versteigerung_ohne_zuschlag_geschlossen(a: Antrag) kind empirical {
    label de official "die Versteigerung ist ohne Erteilung des Zuschlags geschlossen worden (§ 156 Satz 2)";
    label en unofficial "the auction was closed without a knock-down (§ 156 sentence 2)";
}

@source(BGB_P156)
rule VertragBeiVersteigerungDurchZuschlag(v: Rechtsgeschaeft) strict {
    label de official "Bei einer Versteigerung kommt der Vertrag erst durch den Zuschlag zustande (§ 156 Satz 1)";
    label en unofficial "At an auction the contract is formed only by the knock-down (§ 156 sentence 1)";
    when versteigerung(v) and zuschlag_erteilt(v);
    then vertrag_zustande_gekommen(v);
}

@source(BGB_P156)
rule GebotErlischtDurchUebergebot(a: Antrag) strict {
    label de official "Ein Gebot erlischt, wenn ein Übergebot abgegeben wird (§ 156 Satz 2)";
    label en unofficial "A bid lapses when a higher bid is made (§ 156 sentence 2)";
    when uebergebot_abgegeben(a);
    then antrag_erloschen(a);
}

@source(BGB_P156)
rule GebotErlischtOhneZuschlag(a: Antrag) strict {
    label de official "Ein Gebot erlischt, wenn die Versteigerung ohne Erteilung des Zuschlags geschlossen wird (§ 156 Satz 2)";
    label en unofficial "A bid lapses when the auction is closed without a knock-down (§ 156 sentence 2)";
    when versteigerung_ohne_zuschlag_geschlossen(a);
    then antrag_erloschen(a);
}

// § 157 Auslegung von Verträgen.
@source(BGB_P157)
pub external judgment relation auslegung_nach_treu_und_glauben(v: Rechtsgeschaeft, inhalt: Erklaerungsinhalt) {
    authority Court;
    label de official "§ 157: Verträge sind so auszulegen, wie Treu und Glauben mit Rücksicht auf die Verkehrssitte es erfordern";
    label en unofficial "§ 157: contracts are to be interpreted as required by good faith with regard to common usage";
}

pub relation vertragsinhalt(v: Rechtsgeschaeft, inhalt: Erklaerungsinhalt) kind institutional {
    label de official "Inhalt, mit dem der Vertrag gilt (§ 157)";
    label en unofficial "content with which the contract applies (§ 157)";
}

@source(BGB_P157)
rule VertragsauslegungNachTreuUndGlauben(v: Rechtsgeschaeft, i: Erklaerungsinhalt) strict {
    label de official "Verträge sind so auszulegen, wie Treu und Glauben mit Rücksicht auf die Verkehrssitte es erfordern (§ 157)";
    label en unofficial "Contracts are to be interpreted as good faith with regard to common usage requires (§ 157)";
    when vertrag_zustande_gekommen(v) and auslegung_nach_treu_und_glauben(v, i);
    then vertragsinhalt(v, i);
}
