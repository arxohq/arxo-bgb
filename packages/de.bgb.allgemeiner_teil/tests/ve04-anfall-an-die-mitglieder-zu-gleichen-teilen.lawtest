language "law.core" version "0.2";
package de.bgb.allgemeiner_teil version "0.1.0";
namespace "urn:de:corpus:clir:bgb-allgemeiner-teil";
// § 45 Abs. 3: der Verein diente nach der Satzung ausschließlich den Interessen seiner Mitglieder und bestimmt keine Anfallberechtigten; das Vermögen fällt an die drei bei der Auflösung vorhandenen Mitglieder zu gleichen Teilen — je ein Drittel (Brüche als Paare ganzer Zahlen, keine Rundung).
test "§ 45 Abs. 3: das Vermögen fällt an die drei Mitglieder zu je einem Drittel" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.allgemeiner_teil::KALENDER_BUNDESWEIT; deadline_policy BGB_ALLGEMEINER_TEIL_KALENDER; }
        assert "a1": insolvenzverfahren_eroeffnet(entity_ref("urn:de:bgb:at:ve04:verein")) { origin case_input; }
        assert "a2": keine_bestimmung_der_anfallberechtigten(entity_ref("urn:de:bgb:at:ve04:verein")) { origin case_input; }
        assert "a3": diente_ausschliesslich_den_interessen_der_mitglieder(entity_ref("urn:de:bgb:at:ve04:verein")) { origin case_input; }
        assert "m1": vereinsmitglied(entity_ref("urn:de:bgb:at:ve04:verein"), entity_ref("urn:de:bgb:at:ve04:m01")) { origin case_input; }
        assert "m2": vereinsmitglied(entity_ref("urn:de:bgb:at:ve04:verein"), entity_ref("urn:de:bgb:at:ve04:m02")) { origin case_input; }
        assert "m3": vereinsmitglied(entity_ref("urn:de:bgb:at:ve04:verein"), entity_ref("urn:de:bgb:at:ve04:m03")) { origin case_input; }
    }
    evaluate truth(verein_aufgeloest(entity_ref("urn:de:bgb:at:ve04:verein")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anteil_am_vereinsvermoegen(entity_ref("urn:de:bgb:at:ve04:verein"), entity_ref("urn:de:bgb:at:ve04:m01"), 1, 3));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anteil_am_vereinsvermoegen(entity_ref("urn:de:bgb:at:ve04:verein"), entity_ref("urn:de:bgb:at:ve04:m01"), 1, 2));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
