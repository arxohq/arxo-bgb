language "law.core" version "0.2";
package de.bgb.allgemeiner_teil version "0.1.0";
namespace "urn:de:corpus:clir:bgb-allgemeiner-teil";
// § 32 Abs. 1 Satz 3: fünf Ja-Stimmen, vier Nein-Stimmen, drei Enthaltungen bei zwölf Mitgliedern. Nach der Lesart, die die Enthaltung nicht als abgegebene Stimme zählt, ist der Beschluss angenommen (5 > 4); nach der anderen Lesart nicht (5 ist nicht mehr als die Hälfte von 12). Beide Lesarten stehen nebeneinander (§152, Gruppe any_of), und der Beschluss ist nach der ersten angenommen.
test "§ 32 Abs. 1 Satz 3: fünf Ja gegen vier Nein bei drei Enthaltungen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.allgemeiner_teil::KALENDER_BUNDESWEIT; deadline_policy BGB_ALLGEMEINER_TEIL_KALENDER; }
        assert "b1": beschluss_des_vereins(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:verein")) { origin case_input; }
        assert "b2": beschlussgegenstand_bei_berufung_bezeichnet(entity_ref("urn:de:bgb:at:ve01:beschluss")) { origin case_input; }
        assert "b3": satzung_ohne_abweichung(entity_ref("urn:de:bgb:at:ve01:verein"), Mitgliederversammlung32) { origin case_input; }
        assert "j1": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m01"), Ja) { origin case_input; }
        assert "j2": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m02"), Ja) { origin case_input; }
        assert "j3": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m03"), Ja) { origin case_input; }
        assert "j4": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m04"), Ja) { origin case_input; }
        assert "j5": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m05"), Ja) { origin case_input; }
        assert "n1": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m06"), Nein) { origin case_input; }
        assert "n2": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m07"), Nein) { origin case_input; }
        assert "n3": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m08"), Nein) { origin case_input; }
        assert "n4": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m09"), Nein) { origin case_input; }
        assert "e1": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m10"), Enthaltung) { origin case_input; }
        assert "e2": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m11"), Enthaltung) { origin case_input; }
        assert "e3": stimme(entity_ref("urn:de:bgb:at:ve01:beschluss"), entity_ref("urn:de:bgb:at:ve01:m12"), Enthaltung) { origin case_input; }
    }
    evaluate truth(beschluss_gueltig(entity_ref("urn:de:bgb:at:ve01:beschluss")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(beschluss_angenommen(entity_ref("urn:de:bgb:at:ve01:beschluss")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
