language "law.core" version "0.2";
package de.bgb.allgemeiner_teil version "0.1.0";
namespace "urn:de:corpus:clir:bgb-allgemeiner-teil";
// §§ 97, 98 Nr. 2: bei einem Landgut ist das zum Wirtschaftsbetrieb bestimmte Gerät dem wirtschaftlichen Zweck der Hauptsache zu dienen bestimmt — das sagt das Gesetz selbst, eine Wertung des Gerichts ist dafür nicht nötig. Mit dem räumlichen Verhältnis ist der Traktor Zubehör (§ 97 Abs. 1).
test "§§ 97, 98 Nr. 2: der zum Wirtschaftsbetrieb bestimmte Traktor ist Zubehör des Landguts" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.allgemeiner_teil::KALENDER_BUNDESWEIT; deadline_policy BGB_ALLGEMEINER_TEIL_KALENDER; }
        assert "l": landgut(entity_ref("urn:de:bgb:at:s02:gut")) { origin case_input; }
        assert "g": zum_wirtschaftsbetrieb_bestimmtes_geraet_vieh_erzeugnis_duenger(entity_ref("urn:de:bgb:at:s02:traktor"), entity_ref("urn:de:bgb:at:s02:gut")) { origin case_input; }
        assert "b": beweglich(entity_ref("urn:de:bgb:at:s02:traktor")) { origin case_input; }
        assert "r": raeumliches_verhaeltnis_zur_hauptsache(entity_ref("urn:de:bgb:at:s02:traktor"), entity_ref("urn:de:bgb:at:s02:gut")) { origin case_input; }
        assert "v": not im_verkehr_nicht_als_zubehoer_angesehen(entity_ref("urn:de:bgb:at:s02:traktor"), entity_ref("urn:de:bgb:at:s02:gut")) { origin adjudicated; }
    }
    evaluate truth(dient_dem_wirtschaftlichen_zweck(entity_ref("urn:de:bgb:at:s02:traktor"), entity_ref("urn:de:bgb:at:s02:gut")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(zubehoer(entity_ref("urn:de:bgb:at:s02:traktor"), entity_ref("urn:de:bgb:at:s02:gut")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
