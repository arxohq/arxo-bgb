test "§§ 145, 175 und 226: ohne Tatsachen nicht vorhanden" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.allgemeiner_teil::KALENDER_BUNDESWEIT; }
    }
    evaluate positions();
    expect not position(LibertyBindungAntrag145, ACTIVE);
    expect not position(LibertyRueckgabeVollmachtsurkunde175, ACTIVE);
    expect not position(LibertySchikaneverbot226, ACTIVE);
    expect not position(LibertyBeseitigungNamensrecht12, ACTIVE);
    expect not position(LibertyUnterlassungNamensrecht12, ACTIVE);
    expect not position(LibertyWiderruf109, ACTIVE);
