language "law.core" version "0.2";
package de.bgb.allgemeiner_teil version "0.1.0";
namespace "urn:de:corpus:clir:bgb-allgemeiner-teil";
// § 138 Abs. 2: die Ausbeutung der Zwangslage ist festgestellt, das auffällige Missverhältnis bewertet das Gericht (DECISION-0194, Kanal §47.3). Ohne diese Antwort bleibt der Wucher offen und die Frage geht an das Gericht.
test "§ 138 Abs. 2: ohne die Bewertung des Missverhältnisses bleibt der Wucher offen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.allgemeiner_teil::KALENDER_BUNDESWEIT; deadline_policy BGB_ALLGEMEINER_TEIL_KALENDER; }
        assert "a": ausbeutung_einer_schwaeche(entity_ref("urn:de:bgb:at:r05:vertrag")) { origin adjudicated; }
    }
    evaluate truth(wucher(entity_ref("urn:de:bgb:at:r05:vertrag")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(auffaelliges_missverhaeltnis, Court);
}
