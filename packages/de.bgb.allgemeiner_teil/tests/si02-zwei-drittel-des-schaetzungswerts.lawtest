language "law.core" version "0.2";
package de.bgb.allgemeiner_teil version "0.1.0";
namespace "urn:de:corpus:clir:bgb-allgemeiner-teil";
// § 237 Satz 1: mit einer beweglichen Sache kann Sicherheit nur in Höhe von zwei Dritteln des Schätzungswerts geleistet werden: 1 000,00 € × 2 / 3 = 666,666… €, einmal auf den Cent gerundet 666,67 € (Politik des Pakets).
test "§ 237 Satz 1: zwei Drittel des Schätzungswerts, einmal auf den Cent gerundet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.allgemeiner_teil::KALENDER_BUNDESWEIT; deadline_policy BGB_ALLGEMEINER_TEIL_KALENDER; }
        assert "a1": bewegliche_sache_als_sicherheit(entity_ref("urn:de:bgb:at:si02:sicherheit")) { origin case_input; }
        assert "a2": schaetzungswert(entity_ref("urn:de:bgb:at:si02:sicherheit"), 1000.00 EUR) { origin case_input; }
    }
    evaluate truth(sicherheit_hoechstens_in_hoehe_von(entity_ref("urn:de:bgb:at:si02:sicherheit"), 666.67 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(sicherheit_hoechstens_in_hoehe_von(entity_ref("urn:de:bgb:at:si02:sicherheit"), 666.66 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
