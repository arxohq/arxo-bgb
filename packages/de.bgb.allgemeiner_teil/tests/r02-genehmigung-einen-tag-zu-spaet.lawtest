language "law.core" version "0.2";
package de.bgb.allgemeiner_teil version "0.1.0";
namespace "urn:de:corpus:clir:bgb-allgemeiner-teil";
// Derselbe Fall wie r01, die Genehmigung wird aber einen Tag später erklärt (Dienstag, 17. März 2026). Sie gilt als verweigert (§ 108 Abs. 2 Satz 2); der Vertrag ist unwirksam.
test "§ 108 Abs. 2 Satz 2: die einen Tag später erklärte Genehmigung gilt als verweigert" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.allgemeiner_teil::KALENDER_BUNDESWEIT; deadline_policy BGB_ALLGEMEINER_TEIL_KALENDER; }
        assert "g": de.bgb.fristen::geburtstag(entity_ref("urn:de:bgb:at:r02:minderjaehriger"), @2012-01-10) { origin case_input; }
        assert "e1": erklaerender(entity_ref("urn:de:bgb:at:r02:we"), entity_ref("urn:de:bgb:at:r02:minderjaehriger")) { origin case_input; }
        assert "e2": erklaerung_abgegeben_am(entity_ref("urn:de:bgb:at:r02:we"), @2026-02-20) { origin case_input; }
        assert "e3": erklaerung_gehoert_zu(entity_ref("urn:de:bgb:at:r02:we"), entity_ref("urn:de:bgb:at:r02:vertrag")) { origin case_input; }
        assert "e4": geschaeftsart(entity_ref("urn:de:bgb:at:r02:vertrag"), Vertrag) { origin case_input; }
        assert "j1": not lediglich_rechtlicher_vorteil(entity_ref("urn:de:bgb:at:r02:we")) { origin adjudicated; }
        assert "e5": not einwilligung_des_vertreters(entity_ref("urn:de:bgb:at:r02:we")) { origin case_input; }
        assert "f1": genehmigungsfrist(entity_ref("urn:de:bgb:at:r02:vertrag"), entity_ref("urn:de:bgb:at:r02:frist")) { origin case_input; }
        assert "f2": aufforderung_zur_genehmigung_empfangen_am(entity_ref("urn:de:bgb:at:r02:vertrag"), @2026-02-28) { origin case_input; }
        assert "f3": genehmigung_erklaert_am(entity_ref("urn:de:bgb:at:r02:vertrag"), @2026-03-17) { origin case_input; }
    }
    evaluate truth(genehmigung_verweigert(entity_ref("urn:de:bgb:at:r02:vertrag")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(unwirksam(entity_ref("urn:de:bgb:at:r02:vertrag")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wirksam(entity_ref("urn:de:bgb:at:r02:vertrag")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
