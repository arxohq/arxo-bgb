language "law.core" version "0.2";
package de.bgb.allgemeiner_teil version "0.1.0";
namespace "urn:de:corpus:clir:bgb-allgemeiner-teil";
// § 33 Abs. 1 Satz 1: neun Ja-Stimmen und drei Nein-Stimmen sind genau drei Viertel der abgegebenen Stimmen (9 × 4 = 36 = 12 × 3) — der Beschluss über die Satzungsänderung ist angenommen. Wirksam wird die Änderung erst mit der Eintragung (§ 71 Abs. 1 Satz 1).
test "§§ 33 Abs. 1, 71 Abs. 1: drei Viertel genau erreicht, Wirksamkeit mit der Eintragung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.allgemeiner_teil::KALENDER_BUNDESWEIT; deadline_policy BGB_ALLGEMEINER_TEIL_KALENDER; }
        assert "b1": beschluss_des_vereins(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:verein")) { origin case_input; }
        assert "b2": beschlussgegenstand_bei_berufung_bezeichnet(entity_ref("urn:de:bgb:at:ve02:beschluss")) { origin case_input; }
        assert "b3": beschluss_enthaelt_satzungsaenderung(entity_ref("urn:de:bgb:at:ve02:beschluss")) { origin case_input; }
        assert "b4": not beschluss_aendert_den_zweck(entity_ref("urn:de:bgb:at:ve02:beschluss")) { origin case_input; }
        assert "b5": satzung_ohne_abweichung(entity_ref("urn:de:bgb:at:ve02:verein"), Satzungsaenderung33) { origin case_input; }
        assert "j1": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m01"), Ja) { origin case_input; }
        assert "j2": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m02"), Ja) { origin case_input; }
        assert "j3": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m03"), Ja) { origin case_input; }
        assert "j4": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m04"), Ja) { origin case_input; }
        assert "j5": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m05"), Ja) { origin case_input; }
        assert "j6": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m06"), Ja) { origin case_input; }
        assert "j7": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m07"), Ja) { origin case_input; }
        assert "j8": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m08"), Ja) { origin case_input; }
        assert "j9": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m09"), Ja) { origin case_input; }
        assert "n1": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m10"), Nein) { origin case_input; }
        assert "n2": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m11"), Nein) { origin case_input; }
        assert "n3": stimme(entity_ref("urn:de:bgb:at:ve02:beschluss"), entity_ref("urn:de:bgb:at:ve02:m12"), Nein) { origin case_input; }
        assert "e1": satzungsaenderung_eingetragen_am(entity_ref("urn:de:bgb:at:ve02:beschluss"), @2026-04-20) { origin case_input; }
    }
    evaluate truth(beschluss_angenommen(entity_ref("urn:de:bgb:at:ve02:beschluss")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(satzungsaenderung_wirksam(entity_ref("urn:de:bgb:at:ve02:beschluss")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
