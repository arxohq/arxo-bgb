language "law.core" version "0.2";
package de.bgb.allgemeiner_teil version "0.1.0";
namespace "urn:de:corpus:clir:bgb-allgemeiner-teil";
// § 110: der Minderjährige bewirkt die vertragsmäßige Leistung mit Mitteln, die ihm zu freier Verfügung überlassen worden sind — der ohne Zustimmung geschlossene Vertrag gilt als von Anfang an wirksam.
test "§ 110: der mit überlassenen Mitteln bewirkte Vertrag ist von Anfang an wirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.allgemeiner_teil::KALENDER_BUNDESWEIT; deadline_policy BGB_ALLGEMEINER_TEIL_KALENDER; }
        assert "g": de.bgb.fristen::geburtstag(entity_ref("urn:de:bgb:at:r03:minderjaehriger"), @2012-01-10) { origin case_input; }
        assert "e1": erklaerender(entity_ref("urn:de:bgb:at:r03:we"), entity_ref("urn:de:bgb:at:r03:minderjaehriger")) { origin case_input; }
        assert "e2": erklaerung_abgegeben_am(entity_ref("urn:de:bgb:at:r03:we"), @2026-02-20) { origin case_input; }
        assert "e3": erklaerung_gehoert_zu(entity_ref("urn:de:bgb:at:r03:we"), entity_ref("urn:de:bgb:at:r03:vertrag")) { origin case_input; }
        assert "e4": geschaeftsart(entity_ref("urn:de:bgb:at:r03:vertrag"), Vertrag) { origin case_input; }
        assert "j1": not lediglich_rechtlicher_vorteil(entity_ref("urn:de:bgb:at:r03:we")) { origin adjudicated; }
        assert "e5": not einwilligung_des_vertreters(entity_ref("urn:de:bgb:at:r03:we")) { origin case_input; }
        assert "l": leistung_mit_ueberlassenen_mitteln_bewirkt(entity_ref("urn:de:bgb:at:r03:vertrag")) { origin case_input; }
    }
    evaluate truth(schwebend_unwirksam(entity_ref("urn:de:bgb:at:r03:vertrag")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wirksam(entity_ref("urn:de:bgb:at:r03:vertrag")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
