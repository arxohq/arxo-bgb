// BUCH 1 ABSCHNITT 1 TITEL 2 UNTERTITEL 2 UND 3 — STIFTUNGEN (§§ 80–88) UND
// JURISTISCHE PERSONEN DES ÖFFENTLICHEN RECHTS (§ 89)
//
// FRISTEN (DEADLINES.json, BG-03): § 86c Abs. 3 und § 86e Abs. 2 (ein Monat
// vor Antrag bzw. Entscheidung), § 86g Satz 1 (ein Monat für die
// Bekanntmachung) und Satz 3 (Ablauf des zweiten Tages nach der
// Veröffentlichung), § 86h Nr. 1 (sechs Monate für die Anmeldung des
// Anspruchs). Gerechnet werden sie von `de.bgb.fristen`.
//
// KANÄLE (DECISION-0194). „Gesichert erscheint“ (§ 82, § 85 Abs. 1 Satz 3,
// § 86 Nr. 3), „das Gemeinwohl gefährden“ (§ 82, § 85 Abs. 1 Nr. 2, § 87a
// Abs. 2 Nr. 2), „wesentlich verändert“ (§ 85 Abs. 2), „im Wesentlichen
// übereinstimmen“ (§ 86 Nr. 2) und die Sorgfalt des ordentlichen
// Geschäftsführers (§ 84a Abs. 2) sind WERTUNGEN der Behörde bzw. des
// Gerichts; Anerkennung, Genehmigung und ihre Unanfechtbarkeit sind
// festgestellte Tatsachen.

language "law.core" version "0.2";
package de.bgb.allgemeiner_teil version "0.1.0";
namespace "urn:de:corpus:clir:bgb-allgemeiner-teil";

pub entity Stiftung : Person {
    label de official "Stiftung: mit einem Vermögen zur dauernden und nachhaltigen Erfüllung eines vom Stifter vorgegebenen Zwecks ausgestattete, mitgliederlose juristische Person (§ 80 Abs. 1 Satz 1)";
    label en unofficial "foundation: a membered-less legal person endowed with assets for the lasting and sustainable fulfilment of a purpose (§ 80 (1))";
}

pub enum Stiftungsart {
    label de official "Stiftung auf unbestimmte Zeit oder Verbrauchsstiftung (§ 80 Abs. 1 Satz 2)";
    label en unofficial "foundation for an indefinite period or consumption foundation (§ 80 (1) sentence 2)";
    AufUnbestimmteZeit,
    Verbrauchsstiftung
}
pub enum Satzungsbestimmung {
    label de official "Mindestbestimmungen der Stiftungssatzung (§ 81 Abs. 1 Nr. 1, Abs. 2)";
    label en unofficial "minimum provisions of the articles of a foundation (§ 81 (1), (2))";
    Zweck,
    Name,
    Sitz,
    BildungDesVorstands,
    ZeitDerErrichtung,
    VerwendungDesStiftungsvermoegens
}

pub relation stifter(s: Stiftung, p: Person) kind empirical {
    key(s);
    label de official "der Stifter (§§ 80, 81, 81a, 82a, 83 Abs. 2)";
    label en unofficial "the founder (§§ 80, 81, 81a, 82a, 83 (2))";
}
pub relation stiftungsart(s: Stiftung, art: Stiftungsart) kind empirical {
    key(s);
    label de official "Art der Stiftung (§ 80 Abs. 1 Satz 2)";
    label en unofficial "kind of foundation (§ 80 (1) sentence 2)";
}
pub relation stiftungsgeschaeft_errichtet(s: Stiftung) kind empirical {
    label de official "das Stiftungsgeschäft ist errichtet (§ 80 Abs. 2 Satz 1)";
    label en unofficial "the act of endowment has been made (§ 80 (2))";
}
pub relation stiftungssatzung_enthaelt(s: Stiftung, bestimmung: Satzungsbestimmung) kind empirical {
    label de official "die Satzung der Stiftung enthält diese Bestimmung (§ 81 Abs. 1 Nr. 1, Abs. 2)";
    label en unofficial "the articles of the foundation contain this provision (§ 81 (1), (2))";
}
pub relation vermoegen_gewidmet(s: Stiftung) kind empirical {
    label de official "der Stifter hat zur Erfüllung des Stiftungszwecks ein Vermögen gewidmet (§ 81 Abs. 1 Nr. 2)";
    label en unofficial "the founder has dedicated assets to the purpose of the foundation (§ 81 (1) no. 2)";
}
pub relation stiftungsgeschaeft_in_schriftlicher_form(s: Stiftung) kind empirical {
    label de official "das Stiftungsgeschäft bedarf der schriftlichen Form und ist in ihr errichtet oder in einer Verfügung von Todes wegen enthalten (§ 81 Abs. 3)";
    label en unofficial "the act of endowment is in written form or contained in a disposition upon death (§ 81 (3))";
}
pub relation anerkennung_durch_behoerde_am(s: Stiftung, tag: Date) kind empirical {
    key(s);
    label de official "Tag der Anerkennung der Stiftung durch die zuständige Behörde des Landes (§ 80 Abs. 2 Satz 1) — festgestellte Tatsache";
    label en unofficial "day of recognition of the foundation by the competent authority of the Land (§ 80 (2)) — established fact";
}
pub relation anerkennung_beantragt(s: Stiftung) kind empirical {
    label de official "die Anerkennung ist bei der zuständigen Behörde des Landes beantragt (§ 81a Satz 2)";
    label en unofficial "recognition has been applied for with the competent authority (§ 81a sentence 2)";
}
pub relation widerruf_des_stiftungsgeschaefts(s: Stiftung) kind empirical {
    label de official "der Stifter widerruft das Stiftungsgeschäft (§ 81a Satz 1)";
    label en unofficial "the founder revokes the act of endowment (§ 81a sentence 1)";
}
pub relation widerruf_durch_den_erben(s: Stiftung) kind empirical {
    label de official "der Erbe des Stifters erklärt den Widerruf (§ 81a Satz 3)";
    label en unofficial "the founder's heir declares the revocation (§ 81a sentence 3)";
}
pub relation notar_mit_antragstellung_betraut(s: Stiftung) kind empirical {
    label de official "der Stifter hat im Falle der notariellen Beurkundung den Notar mit der Antragstellung betraut (§ 81a Satz 3)";
    label en unofficial "the founder entrusted the notary with filing the application (§ 81a sentence 3)";
}
pub relation zeit_der_verbrauchsstiftung_jahre(s: Stiftung, jahre: Integer) kind empirical {
    key(s);
    label de official "Zeit, für die die Verbrauchsstiftung errichtet wird, in Jahren (§ 81 Abs. 2 Nr. 1, § 82 Satz 2)";
    label en unofficial "period for which the consumption foundation is established, in years (§ 81 (2), § 82 sentence 2)";
}

@source(BGB_P82)
pub external judgment relation dauernde_erfuellung_gesichert(s: Stiftung) {
    authority Court;
    label de official "§ 82 Satz 1: die dauernde und nachhaltige Erfüllung des Stiftungszwecks erscheint gesichert";
    label en unofficial "§ 82 sentence 1: the lasting and sustainable fulfilment of the purpose appears assured";
}

@source(BGB_P82)
pub external judgment relation gemeinwohl_gefaehrdet(s: Stiftung) {
    authority Court;
    label de official "§ 82 Satz 1 Halbsatz 2, § 85 Abs. 1 Nr. 2, § 87a Abs. 2 Nr. 2: die Stiftung oder der Stiftungszweck gefährdet das Gemeinwohl";
    label en unofficial "§ 82, § 85 (1) no. 2, § 87a (2) no. 2: the foundation or its purpose endangers the common good";
}

pub relation stiftung_besteht(s: Stiftung) kind institutional {
    label de official "die Stiftung ist entstanden (§ 80 Abs. 2) — ohne Tag, für die Prüfung des Widerrufs nach § 81a";
    label en unofficial "the foundation has come into existence (§ 80 (2)) — without the day, for the test under § 81a";
}
pub relation stiftung_anzuerkennen(s: Stiftung) kind institutional {
    label de official "die Stiftung ist anzuerkennen (§ 82)";
    label en unofficial "the foundation is to be recognised (§ 82)";
}
pub relation stiftung_entstanden_am(s: Stiftung, tag: Date) kind institutional {
    key(s);
    label de official "Tag, mit dem die Stiftung entstanden ist (§ 80 Abs. 2)";
    label en unofficial "day on which the foundation came into existence (§ 80 (2))";
}
pub relation widerruf_zulaessig(s: Stiftung) kind institutional {
    label de official "der Widerruf des Stiftungsgeschäfts ist zulässig (§ 81a)";
    label en unofficial "revocation of the act of endowment is permitted (§ 81a)";
}
pub relation uebertragungspflicht_des_stifters(s: Stiftung, p: Person) kind institutional {
    label de official "ist die Stiftung anerkannt, so ist der Stifter verpflichtet, das gewidmete Vermögen auf die Stiftung zu übertragen (§ 82a Satz 1)";
    label en unofficial "once recognised, the founder must transfer the dedicated assets to the foundation (§ 82a sentence 1)";
}

@source(BGB_P80)
rule EntstehungDerStiftung(s: Stiftung, t: Date) strict {
    label de official "Zur Entstehung der Stiftung sind das Stiftungsgeschäft und die Anerkennung der Stiftung durch die zuständige Behörde des Landes erforderlich (§ 80 Abs. 2 Satz 1)";
    label en unofficial "The foundation comes into existence through the act of endowment and recognition by the competent authority (§ 80 (2))";
    when stiftungsgeschaeft_errichtet(s) and anerkennung_durch_behoerde_am(s, t);
    then stiftung_entstanden_am(s, t);
}

@source(BGB_P80)
rule RechtsfaehigkeitDerStiftung(s: Stiftung, t: Date) strict {
    label de official "Die Stiftung ist eine mitgliederlose juristische Person; sie entsteht mit der Anerkennung (§ 80 Abs. 1 Satz 1, Abs. 2 Satz 1)";
    label en unofficial "The foundation is a legal person without members and comes into existence upon recognition (§ 80 (1), (2))";
    when stiftung_entstanden_am(s, t);
    then rechtsfaehig_seit(s, t);
}

@source(BGB_P80)
rule StiftungBesteht(s: Stiftung, t: Date) strict {
    label de official "Die mit der Anerkennung entstandene Stiftung besteht (§ 80 Abs. 2)";
    label en unofficial "The foundation recognised under § 80 (2) exists";
    when stiftung_entstanden_am(s, t);
    then stiftung_besteht(s);
}

@source(BGB_P81)
rule StiftungsgeschaeftMitSatzung(s: Stiftung) strict {
    label de official "Im Stiftungsgeschäft muss der Stifter der Stiftung eine Satzung geben, die mindestens Bestimmungen über den Zweck, den Namen, den Sitz und die Bildung des Vorstands enthält, und ein Vermögen widmen; das Stiftungsgeschäft bedarf der schriftlichen Form (§ 81 Abs. 1, 3)";
    label en unofficial "In the act of endowment the founder must give articles containing purpose, name, seat and formation of the board, and dedicate assets; written form is required (§ 81 (1), (3))";
    when stiftungssatzung_enthaelt(s, Zweck)
        and stiftungssatzung_enthaelt(s, Name)
        and stiftungssatzung_enthaelt(s, Sitz)
        and stiftungssatzung_enthaelt(s, BildungDesVorstands)
        and vermoegen_gewidmet(s)
        and stiftungsgeschaeft_in_schriftlicher_form(s);
    then stiftungsgeschaeft_errichtet(s);
}

@source(BGB_P81)
rule SatzungDerVerbrauchsstiftung(s: Stiftung) strict {
    label de official "Die Satzung einer Verbrauchsstiftung muss zusätzlich die Festlegung der Zeit, für die die Stiftung errichtet wird, und Bestimmungen zur Verwendung des Stiftungsvermögens enthalten (§ 81 Abs. 2)";
    label en unofficial "The articles of a consumption foundation must additionally state the period and provisions on the use of the assets (§ 81 (2))";
    when stiftungsart(s, Verbrauchsstiftung)
        and stiftungssatzung_enthaelt(s, ZeitDerErrichtung)
        and stiftungssatzung_enthaelt(s, VerwendungDesStiftungsvermoegens);
    then stiftungsgeschaeft_errichtet(s);
}

@source(BGB_P81a)
rule WiderrufBisZurAnerkennung(s: Stiftung) strict {
    label de official "Bis zur Anerkennung der Stiftung ist der Stifter zum Widerruf des Stiftungsgeschäfts berechtigt (§ 81a Satz 1)";
    label en unofficial "Until recognition the founder may revoke the act of endowment (§ 81a sentence 1)";
    when widerruf_des_stiftungsgeschaefts(s) and not_known(stiftung_besteht(s));
    then widerruf_zulaessig(s);
}

@source(BGB_P81a)
rule ErbeOhneWiderrufsrecht(s: Stiftung) strict {
    label de official "Der Erbe des Stifters ist zum Widerruf des Stiftungsgeschäfts nicht berechtigt, wenn der Stifter den Antrag auf Anerkennung gestellt oder im Falle der notariellen Beurkundung den Notar mit der Antragstellung betraut hat (§ 81a Satz 3)";
    label en unofficial "The founder's heir may not revoke where the founder applied for recognition or entrusted the notary with the application (§ 81a sentence 3)";
    when widerruf_durch_den_erben(s) and anerkennung_beantragt(s);
    then not widerruf_zulaessig(s);
}

@source(BGB_P81a)
rule ErbeOhneWiderrufsrechtBeiNotar(s: Stiftung) strict {
    label de official "Dasselbe gilt, wenn der Stifter im Falle der notariellen Beurkundung des Stiftungsgeschäfts den Notar mit der Antragstellung betraut hat (§ 81a Satz 3)";
    label en unofficial "The same applies where the founder entrusted the notary with the application (§ 81a sentence 3)";
    when widerruf_durch_den_erben(s) and notar_mit_antragstellung_betraut(s);
    then not widerruf_zulaessig(s);
}

@source(BGB_P82)
rule AnerkennungDerStiftung(s: Stiftung) strict {
    label de official "Die Stiftung ist anzuerkennen, wenn das Stiftungsgeschäft den Anforderungen des § 81 Absatz 1 bis 3 genügt und die dauernde und nachhaltige Erfüllung des Stiftungszwecks gesichert erscheint, es sei denn, die Stiftung würde das Gemeinwohl gefährden (§ 82 Satz 1)";
    label en unofficial "The foundation is to be recognised where the act of endowment meets § 81 (1)–(3) and lasting fulfilment appears assured, unless it endangers the common good (§ 82 sentence 1)";
    when stiftungsgeschaeft_errichtet(s)
        and dauernde_erfuellung_gesichert(s)
        and not gemeinwohl_gefaehrdet(s);
    then stiftung_anzuerkennen(s);
}

@source(BGB_P82)
rule VerbrauchsstiftungMitZehnJahren(s: Stiftung, jahre: Integer) strict {
    label de official "Bei einer Verbrauchsstiftung erscheint die dauernde Erfüllung des Stiftungszwecks gesichert, wenn die in der Satzung bestimmte Zeit mindestens zehn Jahre umfasst (§ 82 Satz 2)";
    label en unofficial "For a consumption foundation, lasting fulfilment appears assured where the period in the articles covers at least ten years (§ 82 sentence 2)";
    when stiftungsart(s, Verbrauchsstiftung)
        and zeit_der_verbrauchsstiftung_jahre(s, jahre)
        and jahre >= 10
        and stiftungsgeschaeft_errichtet(s)
        and not gemeinwohl_gefaehrdet(s);
    then stiftung_anzuerkennen(s);
}

@source(BGB_P82a)
rule UebertragungDesGewidmetenVermoegens(s: Stiftung, p: Person, t: Date) strict {
    label de official "Ist die Stiftung anerkannt, so ist der Stifter verpflichtet, das gewidmete Vermögen auf die Stiftung zu übertragen; Rechte, zu deren Übertragung eine Abtretung genügt, gehen mit der Anerkennung auf die Stiftung über (§ 82a)";
    label en unofficial "Once recognised, the founder must transfer the dedicated assets; rights transferable by assignment pass upon recognition (§ 82a)";
    when stiftung_entstanden_am(s, t) and stifter(s, p);
    then uebertragungspflicht_des_stifters(s, p);
}

// §§ 83–84c Verfassung, Vermögen, Organe.
pub relation stifterwille_zum_ausdruck_gekommen(s: Stiftung, inhalt: Text) kind empirical {
    label de official "der bei der Errichtung der Stiftung zum Ausdruck gekommene, hilfsweise der mutmaßliche Wille des Stifters (§ 83 Abs. 2)";
    label en unofficial "the founder's intention expressed at the establishment, in the alternative their presumed intention (§ 83 (2))";
}
pub relation stifterwille_zu_beachten(s: Stiftung, inhalt: Text) kind institutional {
    label de official "die Stiftungsorgane und die Behörden haben den Willen des Stifters zu beachten (§ 83 Abs. 2)";
    label en unofficial "the organs and the authorities must observe the founder's intention (§ 83 (2))";
}
pub relation verwaltung_im_inland(s: Stiftung) kind empirical {
    label de official "die Verwaltung der Stiftung wird im Inland geführt (§ 83a)";
    label en unofficial "the administration of the foundation is conducted within the country (§ 83a)";
}
pub relation verwaltungssitz_im_ausland(s: Stiftung) kind empirical {
    label de official "der Verwaltungssitz der Stiftung wurde im Ausland begründet (§ 87a Abs. 2 Nr. 3)";
    label en unofficial "the administrative seat of the foundation was established abroad (§ 87a (2) no. 3)";
}
pub relation verwaltungssitz_pflicht_erfuellt(s: Stiftung) kind institutional {
    label de official "die Verwaltung der Stiftung ist im Inland zu führen (§ 83a)";
    label en unofficial "the administration of the foundation must be conducted within the country (§ 83a)";
}
pub relation grundstockvermoegen(s: Stiftung, betrag: Money) kind empirical {
    key(s);
    label de official "Grundstockvermögen der Stiftung (§ 83b Abs. 1, 2)";
    label en unofficial "endowment capital of the foundation (§ 83b (1), (2))";
}
pub relation sonstiges_vermoegen(s: Stiftung, betrag: Money) kind empirical {
    key(s);
    label de official "sonstiges Vermögen der Stiftung (§ 83b Abs. 1)";
    label en unofficial "other assets of the foundation (§ 83b (1))";
}
pub relation zustiftung(s: Stiftung, betrag: Money) kind empirical {
    label de official "der Stiftung zugewendetes Vermögen, das vom Zuwendenden dazu bestimmt wurde, Teil des Grundstockvermögens zu werden (§ 83b Abs. 2 Nr. 2)";
    label en unofficial "assets given to the foundation and designated to become part of the endowment capital (§ 83b (2) no. 2)";
}
pub relation getrennte_verwaltung_des_stiftungsvermoegens(s: Stiftung) kind institutional {
    label de official "das Stiftungsvermögen ist getrennt von fremdem Vermögen zu verwalten; mit ihm darf nur der Stiftungszweck erfüllt werden (§ 83b Abs. 4)";
    label en unofficial "the assets are to be administered separately and used only for the foundation's purpose (§ 83b (4))";
}
pub relation grundstockvermoegen_ungeschmaelert_zu_erhalten(s: Stiftung) kind institutional {
    label de official "das Grundstockvermögen ist ungeschmälert zu erhalten; der Stiftungszweck ist mit den Nutzungen zu erfüllen (§ 83c Abs. 1)";
    label en unofficial "the endowment capital must be preserved undiminished; the purpose is fulfilled from its yields (§ 83c (1))";
}
pub relation satzung_erlaubt_verbrauch_eines_teils(s: Stiftung) kind empirical {
    label de official "durch die Satzung ist bestimmt, dass die Stiftung einen Teil des Grundstockvermögens verbrauchen darf (§ 83c Abs. 2 Satz 1)";
    label en unofficial "the articles permit the foundation to consume part of the endowment capital (§ 83c (2))";
}
pub relation pflicht_zur_aufstockung(s: Stiftung) kind institutional {
    label de official "in einer solchen Satzungsbestimmung muss die Stiftung verpflichtet werden, das Grundstockvermögen in absehbarer Zeit wieder aufzustocken (§ 83c Abs. 2 Satz 2)";
    label en unofficial "such a provision must oblige the foundation to replenish the capital within a foreseeable period (§ 83c (2))";
}
pub relation stiftungsvorstandsmitglied(s: Stiftung, p: Person) kind empirical {
    label de official "Mitglied des Vorstands der Stiftung (§ 84)";
    label en unofficial "member of the board of the foundation (§ 84)";
}
pub relation weiteres_organ(s: Stiftung, organ: Text) kind empirical {
    label de official "in der Satzung vorgesehenes weiteres Organ (§ 84 Abs. 4)";
    label en unofficial "further organ provided for in the articles (§ 84 (4))";
}
pub relation vertretung_der_stiftung(s: Stiftung, p: Person) kind institutional {
    label de official "der Vorstand vertritt die Stiftung gerichtlich und außergerichtlich; er hat die Stellung eines gesetzlichen Vertreters (§ 84 Abs. 2 Satz 1)";
    label en unofficial "the board represents the foundation in and out of court as its legal representative (§ 84 (2))";
}
pub relation organmitglied_unentgeltlich(s: Stiftung, p: Person) kind institutional {
    label de official "Organmitglieder sind unentgeltlich tätig (§ 84a Abs. 1 Satz 2)";
    label en unofficial "organ members serve without remuneration (§ 84a (1) sentence 2)";
}
pub relation satzung_weicht_von_84a_ab(s: Stiftung) kind empirical {
    label de official "durch die Satzung ist von § 84a Abs. 1 Sätze 1 und 2 abgewichen (§ 84a Abs. 1 Satz 3)";
    label en unofficial "the articles deviate from § 84a (1) sentences 1 and 2 (§ 84a (1) sentence 3)";
}
pub relation organmitglied_stimmberechtigt_nicht(s: Stiftung, p: Person) kind institutional {
    label de official "ein Organmitglied ist nicht stimmberechtigt, wenn die Beschlussfassung ein Rechtsgeschäft mit ihm oder einen Rechtsstreit zwischen ihm und der Stiftung betrifft (§ 84b Satz 2)";
    label en unofficial "an organ member has no vote where the resolution concerns a transaction with them or litigation (§ 84b sentence 2)";
}
pub relation beschlussfassung_des_organs_betrifft_mitglied(s: Stiftung, p: Person) kind empirical {
    label de official "die Beschlussfassung betrifft die Vornahme eines Rechtsgeschäfts mit dem Organmitglied oder einen Rechtsstreit zwischen ihm und der Stiftung (§ 84b Satz 2)";
    label en unofficial "the resolution concerns a transaction with the organ member or litigation with the foundation (§ 84b sentence 2)";
}
pub relation organmitglieder_fehlen(s: Stiftung) kind empirical {
    label de official "der Vorstand oder ein anderes Organ kann seine Aufgaben nicht wahrnehmen, weil Mitglieder des Organs fehlen, und der Fall ist dringend (§ 84c Abs. 1 Satz 1)";
    label en unofficial "the board or another organ cannot act because members are lacking, and the case is urgent (§ 84c (1))";
}
pub relation notmassnahmen_der_behoerde(s: Stiftung) kind institutional {
    label de official "die nach Landesrecht zuständige Behörde hat in dringenden Fällen notwendige Maßnahmen zu treffen, um die Handlungsfähigkeit des Organs zu gewährleisten (§ 84c Abs. 1)";
    label en unofficial "the competent authority must take necessary measures in urgent cases to ensure the organ can act (§ 84c (1))";
}
pub relation verguetung_des_bestellten_organmitglieds(s: Stiftung, p: Person) kind institutional {
    label de official "die Behörde kann einem von ihr bestellten Organmitglied eine angemessene Vergütung auf Kosten der Stiftung bewilligen (§ 84c Abs. 2)";
    label en unofficial "the authority may grant an appointed organ member reasonable remuneration at the foundation's expense (§ 84c (2))";
}

@source(BGB_P83)
rule StifterwilleIstZuBeachten(s: Stiftung, inhalt: Text) strict {
    label de official "Die Stiftungsorgane haben bei ihrer Tätigkeit für die Stiftung und die zuständigen Behörden haben bei der Aufsicht den bei der Errichtung zum Ausdruck gekommenen, hilfsweise den mutmaßlichen Willen des Stifters zu beachten (§ 83 Abs. 2)";
    label en unofficial "The organs and supervising authorities must observe the founder's expressed, alternatively presumed, intention (§ 83 (2))";
    when stifterwille_zum_ausdruck_gekommen(s, inhalt);
    then stifterwille_zu_beachten(s, inhalt);
}

@source(BGB_P83a)
rule VerwaltungImInland(s: Stiftung) strict {
    label de official "Die Verwaltung der Stiftung ist im Inland zu führen (§ 83a)";
    label en unofficial "The administration of the foundation must be conducted within the country (§ 83a)";
    when verwaltung_im_inland(s);
    then verwaltungssitz_pflicht_erfuellt(s);
}

@source(BGB_P83b)
rule GetrennteVerwaltungDesStiftungsvermoegens(s: Stiftung, g: Money) strict {
    label de official "Das Stiftungsvermögen ist getrennt von fremdem Vermögen zu verwalten; mit dem Stiftungsvermögen darf nur der Stiftungszweck erfüllt werden (§ 83b Abs. 4)";
    label en unofficial "The foundation's assets are administered separately and used only for its purpose (§ 83b (4))";
    when grundstockvermoegen(s, g);
    then getrennte_verwaltung_des_stiftungsvermoegens(s);
}

@source(BGB_P83c)
rule ErhaltungDesGrundstockvermoegens(s: Stiftung, g: Money) strict {
    label de official "Das Grundstockvermögen ist ungeschmälert zu erhalten; der Stiftungszweck ist mit den Nutzungen des Grundstockvermögens zu erfüllen (§ 83c Abs. 1)";
    label en unofficial "The endowment capital must be preserved undiminished and the purpose fulfilled from its yields (§ 83c (1))";
    when stiftungsart(s, AufUnbestimmteZeit) and grundstockvermoegen(s, g);
    then grundstockvermoegen_ungeschmaelert_zu_erhalten(s);
}

@source(BGB_P83c)
rule AufstockungspflichtBeiVerbrauch(s: Stiftung) strict {
    label de official "Durch die Satzung kann bestimmt werden, dass die Stiftung einen Teil des Grundstockvermögens verbrauchen darf; in einer solchen Satzungsbestimmung muss die Stiftung verpflichtet werden, das Grundstockvermögen in absehbarer Zeit wieder um den verbrauchten Teil aufzustocken (§ 83c Abs. 2)";
    label en unofficial "The articles may permit consuming part of the capital; they must then oblige the foundation to replenish it (§ 83c (2))";
    when satzung_erlaubt_verbrauch_eines_teils(s);
    then pflicht_zur_aufstockung(s);
}

@source(BGB_P84)
rule VorstandVertrittDieStiftung(s: Stiftung, p: Person) strict {
    label de official "Die Stiftung muss einen Vorstand haben; der Vorstand vertritt die Stiftung gerichtlich und außergerichtlich und hat die Stellung eines gesetzlichen Vertreters (§ 84 Abs. 1, 2)";
    label en unofficial "The foundation must have a board which represents it in and out of court as legal representative (§ 84 (1), (2))";
    when stiftungsvorstandsmitglied(s, p);
    then vertretung_der_stiftung(s, p);
}

@source(BGB_P84a)
rule OrganmitgliederUnentgeltlich(s: Stiftung, p: Person) strict {
    label de official "Auf die Tätigkeit eines Organmitglieds für die Stiftung sind die §§ 664 bis 670 entsprechend anzuwenden; Organmitglieder sind unentgeltlich tätig, soweit die Satzung nichts anderes bestimmt (§ 84a Abs. 1)";
    label en unofficial "Organ members serve without remuneration unless the articles provide otherwise (§ 84a (1))";
    when stiftungsvorstandsmitglied(s, p) and not satzung_weicht_von_84a_ab(s);
    then organmitglied_unentgeltlich(s, p);
}

@source(BGB_P84a)
pub external judgment relation sorgfalt_eines_ordentlichen_geschaeftsfuehrers_verletzt(s: Stiftung, p: Person) {
    authority Court;
    label de official "§ 84a Abs. 2: das Organmitglied hat bei der Führung der Geschäfte die Sorgfalt eines ordentlichen Geschäftsführers nicht angewendet; eine Pflichtverletzung liegt nicht vor, wenn es unter Beachtung der gesetzlichen und satzungsgemäßen Vorgaben vernünftigerweise annehmen durfte, auf der Grundlage angemessener Informationen zum Wohle der Stiftung zu handeln";
    label en unofficial "§ 84a (2): the organ member failed to apply the care of a prudent manager; no breach where they could reasonably assume to act for the foundation's good on adequate information";
}

pub relation pflichtverletzung_des_organmitglieds(s: Stiftung, p: Person) kind institutional {
    label de official "Pflichtverletzung des Organmitglieds (§ 84a Abs. 2)";
    label en unofficial "breach of duty by the organ member (§ 84a (2))";
}

@source(BGB_P84a)
rule PflichtverletzungDesOrganmitglieds(s: Stiftung, p: Person) strict {
    label de official "Das Mitglied eines Organs hat bei der Führung der Geschäfte der Stiftung die Sorgfalt eines ordentlichen Geschäftsführers anzuwenden (§ 84a Abs. 2 Satz 1)";
    label en unofficial "An organ member must apply the care of a prudent manager when conducting the foundation's business (§ 84a (2))";
    when stiftungsvorstandsmitglied(s, p) and sorgfalt_eines_ordentlichen_geschaeftsfuehrers_verletzt(s, p);
    then pflichtverletzung_des_organmitglieds(s, p);
}

@source(BGB_P84b)
rule StimmverbotInStiftungsorganen(s: Stiftung, p: Person) strict {
    label de official "Ein Organmitglied ist nicht stimmberechtigt, wenn die Beschlussfassung die Vornahme eines Rechtsgeschäfts mit ihm oder die Einleitung oder Erledigung eines Rechtsstreits zwischen ihm und der Stiftung betrifft (§ 84b Satz 2)";
    label en unofficial "An organ member has no vote where the resolution concerns a transaction with them or litigation with the foundation (§ 84b sentence 2)";
    when beschlussfassung_des_organs_betrifft_mitglied(s, p);
    then organmitglied_stimmberechtigt_nicht(s, p);
}

@source(BGB_P84c)
rule NotmassnahmenBeiFehlendenOrganmitgliedern(s: Stiftung) strict {
    label de official "Wenn der Vorstand oder ein anderes Organ der Stiftung seine Aufgaben nicht wahrnehmen kann, weil Mitglieder des Organs fehlen, hat die nach Landesrecht zuständige Behörde in dringenden Fällen auf Antrag eines Beteiligten oder von Amts wegen notwendige Maßnahmen zu treffen (§ 84c Abs. 1)";
    label en unofficial "Where an organ cannot act because members are lacking, the competent authority must take necessary measures in urgent cases (§ 84c (1))";
    when organmitglieder_fehlen(s);
    then notmassnahmen_der_behoerde(s);
}

@source(BGB_P84c)
rule VerguetungDesBestelltenOrganmitglieds(s: Stiftung, p: Person, g: Money) strict {
    label de official "Die Behörde kann einem von ihr bestellten Organmitglied bei oder nach der Bestellung eine angemessene Vergütung auf Kosten der Stiftung bewilligen, wenn das Vermögen der Stiftung sowie der Umfang und die Bedeutung der Aufgabe dies rechtfertigen (§ 84c Abs. 2)";
    label en unofficial "The authority may grant an appointed organ member reasonable remuneration at the foundation's expense (§ 84c (2))";
    when notmassnahmen_der_behoerde(s) and stiftungsvorstandsmitglied(s, p) and grundstockvermoegen(s, g);
    then verguetung_des_bestellten_organmitglieds(s, p);
}

// §§ 85, 85a Satzungsänderungen.
@source(BGB_P85)
pub external judgment relation zweck_nicht_mehr_dauernd_erfuellbar(s: Stiftung) {
    authority Court;
    label de official "§ 85 Abs. 1 Satz 1 Nr. 1: der Stiftungszweck kann nicht mehr dauernd und nachhaltig erfüllt werden; das liegt insbesondere vor, wenn die Stiftung keine ausreichenden Mittel hat und solche in absehbarer Zeit auch nicht erwerben kann";
    label en unofficial "§ 85 (1) no. 1: the purpose can no longer be fulfilled lastingly, in particular for lack of sufficient means";
}

@source(BGB_P85)
pub external judgment relation verhaeltnisse_wesentlich_veraendert(s: Stiftung) {
    authority Court;
    label de official "§ 85 Abs. 2 Satz 1: die Verhältnisse haben sich nach Errichtung der Stiftung wesentlich verändert und die Änderung ist erforderlich, um die Stiftung anzupassen";
    label en unofficial "§ 85 (2): circumstances have changed materially since establishment and the amendment is necessary to adapt the foundation";
}

pub relation satzungsaenderung_der_stiftung(s: Stiftung, b: Beschluss) kind empirical {
    label de official "Beschluss des zuständigen Stiftungsorgans über eine Satzungsänderung (§ 85a Abs. 1 Satz 1)";
    label en unofficial "resolution of the competent organ on an amendment of the articles (§ 85a (1))";
}
pub relation aenderung_betrifft_den_zweck(b: Beschluss) kind empirical {
    label de official "die Satzungsänderung gibt der Stiftung einen anderen Zweck oder beschränkt den Zweck erheblich (§ 85 Abs. 1 Satz 1)";
    label en unofficial "the amendment gives the foundation a different purpose or substantially restricts it (§ 85 (1))";
}
pub relation aenderung_betrifft_praegende_bestimmung(b: Beschluss) kind empirical {
    label de official "die Satzungsänderung betrifft eine prägende Bestimmung der Stiftungsverfassung: Name, Sitz, Art und Weise der Zweckerfüllung, Verwaltung des Grundstockvermögens (§ 85 Abs. 2)";
    label en unofficial "the amendment concerns a defining provision: name, seat, manner of fulfilling the purpose, administration of the capital (§ 85 (2))";
}
pub relation aenderung_dient_der_zweckerfuellung(b: Beschluss) kind empirical {
    label de official "die Änderung sonstiger Bestimmungen dient der Erfüllung des Stiftungszwecks (§ 85 Abs. 3)";
    label en unofficial "the amendment of other provisions serves the fulfilment of the purpose (§ 85 (3))";
}
pub relation stifter_hat_aenderungen_ausgeschlossen(s: Stiftung) kind empirical {
    label de official "der Stifter hat im Stiftungsgeschäft Satzungsänderungen nach den Absätzen 1 bis 3 ausgeschlossen oder beschränkt (§ 85 Abs. 4 Satz 1)";
    label en unofficial "the founder excluded or restricted amendments under (1)–(3) in the act of endowment (§ 85 (4))";
}
pub relation genehmigung_der_satzungsaenderung(b: Beschluss) kind empirical {
    label de official "die nach Landesrecht zuständige Behörde hat die Satzungsänderung genehmigt (§ 85a Abs. 1 Satz 2)";
    label en unofficial "the competent authority has approved the amendment (§ 85a (1) sentence 2)";
}
pub relation satzungsaenderung_zulaessig(s: Stiftung, b: Beschluss) kind institutional {
    label de official "die Satzungsänderung ist zulässig (§ 85)";
    label en unofficial "the amendment of the articles is permitted (§ 85)";
}
pub relation satzungsaenderung_der_stiftung_wirksam(s: Stiftung, b: Beschluss) kind institutional {
    label de official "die Satzungsänderung der Stiftung ist wirksam (§ 85a Abs. 1)";
    label en unofficial "the amendment of the foundation's articles is effective (§ 85a (1))";
}

@source(BGB_P85)
rule ZweckaenderungBeiUnmoeglichkeit(s: Stiftung, b: Beschluss) strict {
    label de official "Durch Satzungsänderung kann der Stiftung ein anderer Zweck gegeben oder der Zweck erheblich beschränkt werden, wenn der Stiftungszweck nicht mehr dauernd und nachhaltig erfüllt werden kann (§ 85 Abs. 1 Satz 1 Nr. 1)";
    label en unofficial "The purpose may be changed or substantially restricted where it can no longer be fulfilled lastingly (§ 85 (1) no. 1)";
    when satzungsaenderung_der_stiftung(s, b)
        and aenderung_betrifft_den_zweck(b)
        and zweck_nicht_mehr_dauernd_erfuellbar(s)
        and not stifter_hat_aenderungen_ausgeschlossen(s);
    then satzungsaenderung_zulaessig(s, b);
}

@source(BGB_P85)
rule ZweckaenderungBeiGemeinwohlgefaehrdung(s: Stiftung, b: Beschluss) strict {
    label de official "Durch Satzungsänderung kann der Zweck geändert werden, wenn der Stiftungszweck das Gemeinwohl gefährdet (§ 85 Abs. 1 Satz 1 Nr. 2)";
    label en unofficial "The purpose may be changed where it endangers the common good (§ 85 (1) no. 2)";
    when satzungsaenderung_der_stiftung(s, b)
        and aenderung_betrifft_den_zweck(b)
        and gemeinwohl_gefaehrdet(s)
        and not stifter_hat_aenderungen_ausgeschlossen(s);
    then satzungsaenderung_zulaessig(s, b);
}

@source(BGB_P85)
rule AenderungPraegenderBestimmungen(s: Stiftung, b: Beschluss) strict {
    label de official "Durch Satzungsänderung können prägende Bestimmungen der Stiftungsverfassung geändert werden, wenn sich die Verhältnisse nach Errichtung der Stiftung wesentlich verändert haben und eine solche Änderung erforderlich ist (§ 85 Abs. 2 Satz 1)";
    label en unofficial "Defining provisions may be amended where circumstances have changed materially and the amendment is necessary (§ 85 (2))";
    when satzungsaenderung_der_stiftung(s, b)
        and aenderung_betrifft_praegende_bestimmung(b)
        and verhaeltnisse_wesentlich_veraendert(s)
        and not stifter_hat_aenderungen_ausgeschlossen(s);
    then satzungsaenderung_zulaessig(s, b);
}

@source(BGB_P85)
rule AenderungSonstigerBestimmungen(s: Stiftung, b: Beschluss) strict {
    label de official "Durch Satzungsänderung können Bestimmungen, die nicht unter Absatz 1 oder Absatz 2 Satz 1 fallen, geändert werden, wenn dies der Erfüllung des Stiftungszwecks dient (§ 85 Abs. 3)";
    label en unofficial "Other provisions may be amended where this serves the fulfilment of the purpose (§ 85 (3))";
    when satzungsaenderung_der_stiftung(s, b)
        and aenderung_dient_der_zweckerfuellung(b)
        and not stifter_hat_aenderungen_ausgeschlossen(s);
    then satzungsaenderung_zulaessig(s, b);
}

@source(BGB_P85a)
rule SatzungsaenderungBedarfDerGenehmigung(s: Stiftung, b: Beschluss) strict {
    label de official "Die Satzung kann durch den Vorstand oder ein anderes durch die Satzung dazu bestimmtes Stiftungsorgan geändert werden; die Satzungsänderung bedarf der Genehmigung der nach Landesrecht zuständigen Behörde (§ 85a Abs. 1)";
    label en unofficial "The articles may be amended by the board or another designated organ; the amendment requires the authority's approval (§ 85a (1))";
    when satzungsaenderung_zulaessig(s, b) and genehmigung_der_satzungsaenderung(b);
    then satzungsaenderung_der_stiftung_wirksam(s, b);
}

// §§ 86–86h Zulegung und Zusammenlegung.
pub relation uebertragende_stiftung(vertrag: Rechtsgeschaeft, s: Stiftung) kind empirical {
    label de official "übertragende Stiftung der Zulegung oder Zusammenlegung (§§ 86, 86a)";
    label en unofficial "transferring foundation in a merger by absorption or consolidation (§§ 86, 86a)";
}
pub relation uebernehmende_stiftung(vertrag: Rechtsgeschaeft, s: Stiftung) kind empirical {
    label de official "übernehmende Stiftung der Zulegung oder Zusammenlegung (§§ 86, 86a)";
    label en unofficial "receiving foundation (§§ 86, 86a)";
}

@source(BGB_P86)
pub external judgment relation zwecke_stimmen_im_wesentlichen_ueberein(vertrag: Rechtsgeschaeft) {
    authority Court;
    label de official "§ 86 Nr. 2: der Zweck der übertragenden Stiftung stimmt im Wesentlichen mit einem Zweck der übernehmenden Stiftung überein";
    label en unofficial "§ 86 no. 2: the purpose of the transferring foundation substantially corresponds to a purpose of the receiving foundation";
}

@source(BGB_P86)
pub external judgment relation erfuellung_nach_zulegung_gesichert(vertrag: Rechtsgeschaeft) {
    authority Court;
    label de official "§ 86 Nr. 3, § 86a Nr. 2: es erscheint gesichert, dass die übernehmende Stiftung ihren Zweck auch nach der Zulegung oder Zusammenlegung im Wesentlichen in gleicher Weise dauernd und nachhaltig erfüllen kann";
    label en unofficial "§ 86 no. 3, § 86a no. 2: it appears assured that the receiving foundation can continue to fulfil its purpose in substantially the same way";
}

pub relation rechte_der_leistungsberechtigten_gewahrt(vertrag: Rechtsgeschaeft) kind empirical {
    label de official "die Rechte von Personen, für die in der Satzung Ansprüche auf Stiftungsleistungen begründet sind, werden gewahrt (§ 86 Nr. 4, § 86a Nr. 3)";
    label en unofficial "the rights of persons entitled to benefits under the articles are preserved (§ 86 no. 4, § 86a no. 3)";
}
pub relation satzungsaenderung_reicht_nicht_aus(vertrag: Rechtsgeschaeft) kind empirical {
    label de official "eine Satzungsänderung nach § 85 Absatz 2 bis 4 reicht nicht aus, um die übertragende Stiftung an die veränderten Verhältnisse anzupassen (§ 86 Nr. 1, § 86a Nr. 1)";
    label en unofficial "an amendment under § 85 (2)–(4) does not suffice to adapt the transferring foundation (§ 86 no. 1, § 86a no. 1)";
}
pub relation zulegung_zulaessig(vertrag: Rechtsgeschaeft) kind institutional {
    label de official "die Zulegung ist zulässig (§ 86)";
    label en unofficial "the merger by absorption is permitted (§ 86)";
}
pub relation zusammenlegung_zulaessig(vertrag: Rechtsgeschaeft) kind institutional {
    label de official "die Zusammenlegung ist zulässig (§ 86a)";
    label en unofficial "the consolidation is permitted (§ 86a)";
}
pub relation zulegungsvertrag_geschlossen(vertrag: Rechtsgeschaeft) kind empirical {
    label de official "die Stiftungen haben einen Zulegungs- oder Zusammenlegungsvertrag geschlossen (§ 86b Abs. 1 Satz 1)";
    label en unofficial "the foundations concluded a merger or consolidation contract (§ 86b (1))";
}
pub relation genehmigung_des_vertrags_durch_behoerde(vertrag: Rechtsgeschaeft) kind empirical {
    label de official "die für die übernehmende Stiftung zuständige Behörde hat den Vertrag genehmigt (§ 86b Abs. 1 Satz 2)";
    label en unofficial "the authority competent for the receiving foundation approved the contract (§ 86b (1))";
}
pub relation zustimmung_der_uebernehmenden_stiftung(vertrag: Rechtsgeschaeft) kind empirical {
    label de official "die übernehmende Stiftung stimmt einer Zulegung durch die Behörde zu (§ 86b Abs. 2 Satz 2)";
    label en unofficial "the receiving foundation consents to an official merger (§ 86b (2))";
}
pub relation vertrag_enthaelt_namen_und_sitze(vertrag: Rechtsgeschaeft) kind empirical {
    label de official "der Vertrag enthält die Angabe des jeweiligen Namens und Sitzes der beteiligten Stiftungen (§ 86c Abs. 1 Nr. 1)";
    label en unofficial "the contract states the names and seats of the foundations involved (§ 86c (1) no. 1)";
}
pub relation vertrag_enthaelt_vermoegensuebertragung(vertrag: Rechtsgeschaeft) kind empirical {
    label de official "der Vertrag enthält die Vereinbarung, dass das Stiftungsvermögen als Ganzes übertragen wird und das Grundstockvermögen Teil des Grundstockvermögens der übernehmenden Stiftung wird (§ 86c Abs. 1 Nr. 2)";
    label en unofficial "the contract provides for the transfer of the assets as a whole (§ 86c (1) no. 2)";
}
pub relation vertrag_in_schriftlicher_form(vertrag: Rechtsgeschaeft) kind empirical {
    label de official "der Zulegungs- oder Zusammenlegungsvertrag ist in schriftlicher Form geschlossen (§ 86d)";
    label en unofficial "the contract was concluded in written form (§ 86d)";
}
pub relation vertrag_wirksam_geschlossen(vertrag: Rechtsgeschaeft) kind institutional {
    label de official "der Zulegungs- oder Zusammenlegungsvertrag ist formgerecht und inhaltlich vollständig (§§ 86c, 86d)";
    label en unofficial "the contract is in due form and complete in content (§§ 86c, 86d)";
}
pub relation genehmigung_unanfechtbar_am(vertrag: Rechtsgeschaeft, tag: Date) kind empirical {
    key(vertrag);
    label de official "Tag der Unanfechtbarkeit der Genehmigung oder der behördlichen Entscheidung (§ 86f Abs. 1, 2) — festgestellte Tatsache";
    label en unofficial "day on which the approval or decision became incontestable (§ 86f (1), (2)) — established fact";
}
pub relation vermoegen_geht_ueber_am(vertrag: Rechtsgeschaeft, tag: Date) kind institutional {
    key(vertrag);
    label de official "mit der Unanfechtbarkeit geht das Stiftungsvermögen der übertragenden Stiftung auf die übernehmende Stiftung über und die übertragende Stiftung erlischt (§ 86f Abs. 1)";
    label en unofficial "upon incontestability the assets pass to the receiving foundation and the transferring foundation ceases to exist (§ 86f (1))";
}
pub relation uebertragende_stiftung_erloschen(s: Stiftung) kind institutional {
    label de official "die übertragende Stiftung ist erloschen (§ 86f Abs. 1, 2)";
    label en unofficial "the transferring foundation has ceased to exist (§ 86f (1), (2))";
}
pub relation maengel_des_vertrags(vertrag: Rechtsgeschaeft) kind empirical {
    label de official "Mängel des Zulegungs- oder Zusammenlegungsvertrags (§ 86f Abs. 3)";
    label en unofficial "defects of the merger or consolidation contract (§ 86f (3))";
}
pub relation wirkungen_bleiben_unberuehrt(vertrag: Rechtsgeschaeft) kind institutional {
    label de official "Mängel des Vertrags lassen die Wirkungen der behördlichen Genehmigung unberührt (§ 86f Abs. 3)";
    label en unofficial "defects of the contract do not affect the effects of the official approval (§ 86f (3))";
}
pub relation bekanntmachungsfrist_86g(vertrag: Rechtsgeschaeft, f: Frist) kind empirical {
    key(vertrag);
    label de official "Monatsfrist für die Bekanntmachung der Zulegung oder Zusammenlegung im Bundesanzeiger (§ 86g Satz 1)";
    label en unofficial "one-month period for publishing the merger in the Federal Gazette (§ 86g sentence 1)";
}
pub relation bekanntmachungsfrist_86g_ende(vertrag: Rechtsgeschaeft, tag: Date) kind institutional {
    key(vertrag);
    label de official "Tag, mit dessen Ablauf die Monatsfrist des § 86g Satz 1 endet";
    label en unofficial "day at whose end the one-month period of § 86g sentence 1 ends";
}
pub relation anmeldefrist_86h(vertrag: Rechtsgeschaeft, f: Frist) kind empirical {
    key(vertrag);
    label de official "Frist der sechs Monate für die Anmeldung des Anspruchs bei der Stiftung (§ 86h Nr. 1)";
    label en unofficial "six-month period for registering the claim with the foundation (§ 86h no. 1)";
}
pub relation bekanntmachung_veroeffentlicht_am(vertrag: Rechtsgeschaeft, tag: Date) kind empirical {
    key(vertrag);
    label de official "Tag der Veröffentlichung der Bekanntmachung im Bundesanzeiger (§ 86g Sätze 1, 3, § 86h Nr. 1)";
    label en unofficial "day of publication of the notice in the Federal Gazette (§ 86g, § 86h no. 1)";
}
pub relation anmeldefrist_86h_ende(vertrag: Rechtsgeschaeft, tag: Date) kind institutional {
    key(vertrag);
    label de official "Tag, mit dessen Ablauf die Sechsmonatsfrist des § 86h Nr. 1 endet";
    label en unofficial "day at whose end the six-month period of § 86h no. 1 ends";
}
pub relation anspruch_angemeldet_am(vertrag: Rechtsgeschaeft, g: Person, tag: Date) kind empirical {
    label de official "Tag, an dem der Gläubiger den Anspruch nach Grund und Höhe schriftlich angemeldet hat (§ 86h Nr. 1)";
    label en unofficial "day on which the creditor registered the claim in writing (§ 86h no. 1)";
}
pub relation erfuellung_gefaehrdet_glaubhaft_gemacht(vertrag: Rechtsgeschaeft, g: Person) kind empirical {
    label de official "der Gläubiger hat mit der Anmeldung glaubhaft gemacht, dass die Erfüllung des Anspruchs aufgrund der Zulegung oder Zusammenlegung gefährdet ist (§ 86h Nr. 2)";
    label en unofficial "the creditor credibly showed that satisfaction of the claim is endangered by the merger (§ 86h no. 2)";
}
pub relation sicherheitsleistung_an_glaeubiger(vertrag: Rechtsgeschaeft, g: Person) kind institutional {
    label de official "die übernehmende Stiftung hat dem Gläubiger Sicherheit zu leisten (§ 86h)";
    label en unofficial "the receiving foundation must provide security to the creditor (§ 86h)";
}

@source(BGB_P86)
rule ZulegungZulaessig(vertrag: Rechtsgeschaeft, s: Stiftung) strict {
    label de official "Durch Übertragung ihres Stiftungsvermögens als Ganzes kann die übertragende Stiftung einer übernehmenden Stiftung zugelegt werden, wenn sich die Verhältnisse wesentlich verändert haben und eine Satzungsänderung nicht ausreicht, die Zwecke im Wesentlichen übereinstimmen, die Erfüllung gesichert erscheint und die Rechte der Leistungsberechtigten gewahrt werden (§ 86)";
    label en unofficial "A foundation may be merged into another where circumstances changed materially, amendment does not suffice, the purposes correspond, fulfilment is assured and rights are preserved (§ 86)";
    when uebertragende_stiftung(vertrag, s)
        and satzungsaenderung_reicht_nicht_aus(vertrag)
        and zwecke_stimmen_im_wesentlichen_ueberein(vertrag)
        and erfuellung_nach_zulegung_gesichert(vertrag)
        and rechte_der_leistungsberechtigten_gewahrt(vertrag);
    then zulegung_zulaessig(vertrag);
}

@source(BGB_P86a)
rule ZusammenlegungZulaessig(vertrag: Rechtsgeschaeft, s: Stiftung) strict {
    label de official "Mindestens zwei übertragende Stiftungen können durch Errichtung einer neuen Stiftung und Übertragung ihres jeweiligen Stiftungsvermögens als Ganzes zusammengelegt werden, wenn die Verhältnisse sich wesentlich verändert haben, eine Satzungsänderung nicht ausreicht, die Erfüllung gesichert erscheint und die Rechte der Leistungsberechtigten gewahrt werden (§ 86a)";
    label en unofficial "At least two foundations may be consolidated into a new one under the conditions of § 86a";
    when uebertragende_stiftung(vertrag, s)
        and satzungsaenderung_reicht_nicht_aus(vertrag)
        and erfuellung_nach_zulegung_gesichert(vertrag)
        and rechte_der_leistungsberechtigten_gewahrt(vertrag)
        and (count distinct x: Stiftung where uebertragende_stiftung(vertrag, x)) >= 2;
    then zusammenlegung_zulaessig(vertrag);
}

@source(BGB_P86b)
rule GenehmigungDesZulegungsvertrags(vertrag: Rechtsgeschaeft) strict {
    label de official "Stiftungen können durch Vertrag zugelegt oder zusammengelegt werden; der Vertrag bedarf der Genehmigung durch die für die übernehmende Stiftung nach Landesrecht zuständige Behörde (§ 86b Abs. 1)";
    label en unofficial "Foundations may merge by contract; the contract requires the approval of the authority competent for the receiving foundation (§ 86b (1))";
    when zulegungsvertrag_geschlossen(vertrag) and genehmigung_des_vertrags_durch_behoerde(vertrag);
    then vertrag_wirksam_geschlossen(vertrag);
}

@source(BGB_P86b)
rule BehoerdlicheZulegungMitZustimmung(vertrag: Rechtsgeschaeft) strict {
    label de official "Die Behörde kann Stiftungen zulegen oder zusammenlegen, wenn die Stiftungen die Zulegung nicht vereinbaren können; die übernehmende Stiftung muss einer Zulegung durch die Behörde zustimmen (§ 86b Abs. 2)";
    label en unofficial "The authority may merge foundations where they cannot agree; the receiving foundation must consent (§ 86b (2))";
    when zulegung_zulaessig(vertrag)
        and not zulegungsvertrag_geschlossen(vertrag)
        and zustimmung_der_uebernehmenden_stiftung(vertrag);
    then vertrag_wirksam_geschlossen(vertrag);
}

@source(BGB_P86c)
rule InhaltDesZulegungsvertrags(vertrag: Rechtsgeschaeft) strict {
    label de official "Ein Zulegungsvertrag muss mindestens die Namen und Sitze der beteiligten Stiftungen sowie die Vereinbarung über die Übertragung des Stiftungsvermögens als Ganzes enthalten (§ 86c Abs. 1)";
    label en unofficial "A merger contract must contain at least the names and seats and the agreement on the transfer of the assets as a whole (§ 86c (1))";
    when zulegungsvertrag_geschlossen(vertrag)
        and vertrag_enthaelt_namen_und_sitze(vertrag)
        and vertrag_enthaelt_vermoegensuebertragung(vertrag);
    then vertrag_wirksam_geschlossen(vertrag);
}

@source(BGB_P86d)
rule FormDesZulegungsvertrags(vertrag: Rechtsgeschaeft) strict {
    label de official "Zulegungsverträge und Zusammenlegungsverträge bedürfen nur der schriftlichen Form; insbesondere § 311b Absatz 1 bis 3 ist nicht anzuwenden (§ 86d)";
    label en unofficial "Merger and consolidation contracts require only written form; § 311b (1)–(3) does not apply (§ 86d)";
    when zulegungsvertrag_geschlossen(vertrag) and vertrag_in_schriftlicher_form(vertrag);
    then form_gewahrt(vertrag, SchriftlicheForm);
}

@source(BGB_P86e)
rule BehoerdlicheEntscheidungUeberZulegung(vertrag: Rechtsgeschaeft) strict {
    label de official "Auf den Inhalt der Entscheidungen über die Zulegung oder Zusammenlegung durch die Behörde ist § 86c Absatz 1 und 2 entsprechend anzuwenden; die Behörde hat die Leistungsberechtigten mindestens einen Monat vor der Entscheidung anzuhören (§ 86e)";
    label en unofficial "§ 86c (1), (2) applies to official decisions; the authority must hear the beneficiaries at least one month before deciding (§ 86e)";
    when zulegung_zulaessig(vertrag) and not zulegungsvertrag_geschlossen(vertrag);
    then vertrag_wirksam_geschlossen(vertrag);
}

@source(BGB_P86f)
rule WirkungenDerZulegung(vertrag: Rechtsgeschaeft, s: Stiftung, t: Date) strict {
    label de official "Mit der Unanfechtbarkeit der Genehmigung des Zulegungsvertrags oder der Entscheidung über die Zulegung geht das Stiftungsvermögen der übertragenden Stiftung auf die übernehmende Stiftung über und erlischt die übertragende Stiftung (§ 86f Abs. 1)";
    label en unofficial "Upon incontestability the assets pass to the receiving foundation and the transferring foundation ceases to exist (§ 86f (1))";
    when vertrag_wirksam_geschlossen(vertrag)
        and uebertragende_stiftung(vertrag, s)
        and genehmigung_unanfechtbar_am(vertrag, t);
    then vermoegen_geht_ueber_am(vertrag, t);
}

@source(BGB_P86f)
rule UebertragendeStiftungErlischt(vertrag: Rechtsgeschaeft, s: Stiftung, t: Date) strict {
    label de official "Mit der Unanfechtbarkeit erlischt die übertragende Stiftung (§ 86f Abs. 1, 2)";
    label en unofficial "Upon incontestability the transferring foundation ceases to exist (§ 86f (1), (2))";
    when vermoegen_geht_ueber_am(vertrag, t) and uebertragende_stiftung(vertrag, s);
    then uebertragende_stiftung_erloschen(s);
}

@source(BGB_P86f)
rule MaengelBeruehrenDieWirkungenNicht(vertrag: Rechtsgeschaeft, t: Date) strict {
    label de official "Mängel des Zulegungsvertrags oder des Zusammenlegungsvertrags lassen die Wirkungen der behördlichen Genehmigung unberührt (§ 86f Abs. 3)";
    label en unofficial "Defects of the contract do not affect the effects of the official approval (§ 86f (3))";
    when vermoegen_geht_ueber_am(vertrag, t) and maengel_des_vertrags(vertrag);
    then wirkungen_bleiben_unberuehrt(vertrag);
}

@source(BGB_P86g)
rule BekanntmachungsfristEreignis86g(vertrag: Rechtsgeschaeft, f: Frist, t: Date) strict {
    label de official "Die übernehmende Stiftung hat die Zulegung oder die Zusammenlegung innerhalb eines Monats nach dem Zeitpunkt, zu dem die Wirkungen eingetreten sind, im Bundesanzeiger bekannt zu machen (§ 86g Satz 1) — Ereignis ist der Eintritt der Wirkungen";
    label en unofficial "The receiving foundation must publish the merger within one month of the effects arising (§ 86g sentence 1)";
    when bekanntmachungsfrist_86g(vertrag, f) and vermoegen_geht_ueber_am(vertrag, t);
    then de.bgb.fristen::frist_ereignis(f, t);
}

@source(BGB_P86g)
rule BekanntmachungsfristDauer86g(vertrag: Rechtsgeschaeft, f: Frist, t: Date) strict {
    label de official "Die Frist des § 86g Satz 1 beträgt einen Monat (§ 188 Abs. 2)";
    label en unofficial "The period of § 86g sentence 1 is one month (§ 188 (2))";
    when bekanntmachungsfrist_86g(vertrag, f) and vermoegen_geht_ueber_am(vertrag, t);
    then de.bgb.fristen::frist_dauer_kalender(f, 1 calendar_month);
}

@source(BGB_P86g)
rule BekanntmachungsfristEnde86g(vertrag: Rechtsgeschaeft, f: Frist, e: Date) strict {
    label de official "Das Ende der Monatsfrist des § 86g Satz 1 berechnet sich nach den §§ 187 Abs. 1, 188 Abs. 2 und 193 (de.bgb.fristen)";
    label en unofficial "The end of the one-month period of § 86g is computed under §§ 187 (1), 188 (2), 193";
    when bekanntmachungsfrist_86g(vertrag, f) and de.bgb.fristen::frist_ende(f, e);
    then bekanntmachungsfrist_86g_ende(vertrag, e);
}

@source(BGB_P86h)
rule AnmeldefristEreignis86h(vertrag: Rechtsgeschaeft, f: Frist, t: Date) strict {
    label de official "Der Gläubiger muss den Anspruch binnen sechs Monaten nach dem Tag, an dem die Zulegung oder Zusammenlegung bekanntgemacht wurde, bei der Stiftung schriftlich anmelden (§ 86h Nr. 1) — Ereignis ist der Tag der Bekanntmachung";
    label en unofficial "The creditor must register the claim within six months of the day the merger was published (§ 86h no. 1)";
    when anmeldefrist_86h(vertrag, f) and bekanntmachung_veroeffentlicht_am(vertrag, t);
    then de.bgb.fristen::frist_ereignis(f, t);
}

@source(BGB_P86h)
rule AnmeldefristDauer86h(vertrag: Rechtsgeschaeft, f: Frist, t: Date) strict {
    label de official "Die Frist des § 86h Nr. 1 beträgt sechs Monate (§ 188 Abs. 2)";
    label en unofficial "The period of § 86h no. 1 is six months (§ 188 (2))";
    when anmeldefrist_86h(vertrag, f) and bekanntmachung_veroeffentlicht_am(vertrag, t);
    then de.bgb.fristen::frist_dauer_kalender(f, 6 calendar_month);
}

@source(BGB_P86h)
rule AnmeldefristEnde86h(vertrag: Rechtsgeschaeft, f: Frist, e: Date) strict {
    label de official "Das Ende der Sechsmonatsfrist des § 86h Nr. 1 berechnet sich nach den §§ 187 Abs. 1, 188 Abs. 2 und 193 (de.bgb.fristen)";
    label en unofficial "The end of the six-month period of § 86h is computed under §§ 187 (1), 188 (2), 193";
    when anmeldefrist_86h(vertrag, f) and de.bgb.fristen::frist_ende(f, e);
    then anmeldefrist_86h_ende(vertrag, e);
}

@source(BGB_P86h)
rule SicherheitFuerRechtzeitigAngemeldetenAnspruch(vertrag: Rechtsgeschaeft, g: Person, e: Date, a: Date) strict {
    label de official "Die übernehmende Stiftung hat einem Gläubiger für einen vor dem Zeitpunkt der Wirkungen entstandenen Anspruch, dessen Erfüllung noch nicht verlangt werden kann, Sicherheit zu leisten, wenn der Gläubiger den Anspruch binnen sechs Monaten nach der Bekanntmachung anmeldet und glaubhaft macht, dass die Erfüllung gefährdet ist (§ 86h)";
    label en unofficial "The receiving foundation must provide security where the creditor registers the claim within six months and shows its satisfaction is endangered (§ 86h)";
    when anmeldefrist_86h_ende(vertrag, e)
        and anspruch_angemeldet_am(vertrag, g, a)
        and a <= e
        and erfuellung_gefaehrdet_glaubhaft_gemacht(vertrag, g);
    then sicherheitsleistung_an_glaeubiger(vertrag, g);
}

// §§ 87–87c Auflösung, Aufhebung, Vermögensanfall.
pub relation stiftung_aufgeloest(s: Stiftung) kind institutional {
    label de official "die Stiftung ist aufgelöst (§§ 87, 87b)";
    label en unofficial "the foundation is dissolved (§§ 87, 87b)";
}
pub relation stiftung_aufgehoben(s: Stiftung) kind institutional {
    label de official "die Stiftung ist von der Behörde aufgehoben (§ 87a)";
    label en unofficial "the foundation has been abolished by the authority (§ 87a)";
}
pub relation zeit_der_verbrauchsstiftung_abgelaufen(s: Stiftung) kind empirical {
    label de official "die Zeit, für die die Verbrauchsstiftung errichtet wurde, ist abgelaufen (§ 87 Abs. 2)";
    label en unofficial "the period for which the consumption foundation was established has expired (§ 87 (2))";
}
pub relation genehmigung_der_aufloesung(s: Stiftung) kind empirical {
    label de official "die nach Landesrecht zuständige Behörde hat die Auflösung genehmigt (§ 87 Abs. 3)";
    label en unofficial "the competent authority approved the dissolution (§ 87 (3))";
}
pub relation organ_entscheidet_nicht_rechtzeitig(s: Stiftung) kind empirical {
    label de official "das zuständige Organ entscheidet über die Auflösung nicht rechtzeitig bzw. nicht unverzüglich (§ 87a Abs. 1, Abs. 2 Nr. 1)";
    label en unofficial "the competent organ does not decide on dissolution in time (§ 87a (1), (2) no. 1)";
}
pub relation insolvenzverfahren_ueber_stiftung_eroeffnet(s: Stiftung) kind empirical {
    label de official "über das Vermögen der Stiftung ist das Insolvenzverfahren eröffnet oder die Eröffnung mangels Masse rechtskräftig abgewiesen worden (§ 87b)";
    label en unofficial "insolvency proceedings over the foundation were opened or refused for lack of assets (§ 87b)";
}
pub relation satzung_bestimmt_anfallberechtigten_der_stiftung(s: Stiftung, p: Person) kind empirical {
    label de official "die Satzung bestimmt die Anfallberechtigten des Stiftungsvermögens (§ 87c Abs. 1 Satz 1)";
    label en unofficial "the articles determine the persons entitled to the assets (§ 87c (1))";
}
pub relation keine_bestimmung_der_anfallberechtigten_der_stiftung(s: Stiftung) kind empirical {
    label de official "es fehlt an der Bestimmung der Anfallberechtigten durch oder aufgrund der Satzung (§ 87c Abs. 1 Satz 3) — ausdrückliche Angabe des Falls";
    label en unofficial "there is no determination of the persons entitled by or under the articles (§ 87c (1)) — explicit case input";
}
pub relation sitzland_der_stiftung(s: Stiftung, land: Ort) kind empirical {
    key(s);
    label de official "Land, in dem die Stiftung ihren Sitz hatte (§ 87c Abs. 1 Satz 3)";
    label en unofficial "Land in which the foundation had its seat (§ 87c (1))";
}
pub relation stiftungsvermoegen_faellt_an(s: Stiftung, p: Person) kind institutional {
    label de official "das Stiftungsvermögen fällt an diesen Anfallberechtigten (§ 87c Abs. 1)";
    label en unofficial "the foundation's assets pass to this person (§ 87c (1))";
}
pub relation stiftungsvermoegen_faellt_an_den_fiskus(s: Stiftung, land: Ort) kind institutional {
    label de official "das Stiftungsvermögen fällt an den Fiskus des Landes, in dem die Stiftung ihren Sitz hatte (§ 87c Abs. 1 Satz 3)";
    label en unofficial "the assets pass to the treasury of the Land where the foundation had its seat (§ 87c (1))";
}
pub relation kirchliche_stiftung(s: Stiftung) kind empirical {
    label de official "die Stiftung ist eine kirchliche Stiftung oder ihr nach Landesgesetz gleichgestellt (§ 88)";
    label en unofficial "the foundation is an ecclesiastical foundation or equivalent under Land law (§ 88)";
}
pub relation landesrecht_bleibt_unberuehrt(s: Stiftung) kind institutional {
    label de official "die Vorschriften der Landesgesetze über die kirchlichen Stiftungen bleiben unberührt (§ 88)";
    label en unofficial "the provisions of Land law on ecclesiastical foundations remain unaffected (§ 88)";
}

@source(BGB_P87)
rule AufloesungDurchDieStiftungsorgane(s: Stiftung) strict {
    label de official "Der Vorstand soll die Stiftung auflösen, wenn die Stiftung ihren Zweck endgültig nicht mehr dauernd und nachhaltig erfüllen kann; die Auflösung bedarf der Genehmigung der zuständigen Behörde (§ 87 Abs. 1, 3)";
    label en unofficial "The board shall dissolve the foundation where it can definitively no longer fulfil its purpose; approval is required (§ 87 (1), (3))";
    when zweck_nicht_mehr_dauernd_erfuellbar(s) and genehmigung_der_aufloesung(s);
    then stiftung_aufgeloest(s);
}

@source(BGB_P87)
rule AufloesungDerVerbrauchsstiftung(s: Stiftung) strict {
    label de official "Eine Verbrauchsstiftung ist aufzulösen, wenn die Zeit, für die sie errichtet wurde, abgelaufen ist (§ 87 Abs. 2)";
    label en unofficial "A consumption foundation is to be dissolved once the period for which it was established has expired (§ 87 (2))";
    when stiftungsart(s, Verbrauchsstiftung) and zeit_der_verbrauchsstiftung_abgelaufen(s) and genehmigung_der_aufloesung(s);
    then stiftung_aufgeloest(s);
}

@source(BGB_P87a)
rule AufhebungDurchDieBehoerde(s: Stiftung) strict {
    label de official "Die nach Landesrecht zuständige Behörde soll eine Stiftung aufheben, wenn die Voraussetzungen des § 87 Absatz 1 Satz 1 vorliegen und ein Tätigwerden der Behörde erforderlich ist, weil das zuständige Organ über die Auflösung nicht rechtzeitig entscheidet (§ 87a Abs. 1)";
    label en unofficial "The authority shall abolish a foundation where § 87 (1) applies and the organ does not decide in time (§ 87a (1))";
    when zweck_nicht_mehr_dauernd_erfuellbar(s) and organ_entscheidet_nicht_rechtzeitig(s);
    then stiftung_aufgehoben(s);
}

@source(BGB_P87a)
rule AufhebungBeiGemeinwohlgefaehrdung(s: Stiftung) strict {
    label de official "Die Behörde hat die Stiftung aufzuheben, wenn die Stiftung das Gemeinwohl gefährdet und die Gefährdung nicht auf andere Weise beseitigt werden kann (§ 87a Abs. 2 Nr. 2)";
    label en unofficial "The authority must abolish the foundation where it endangers the common good and this cannot be removed otherwise (§ 87a (2) no. 2)";
    when gemeinwohl_gefaehrdet(s);
    then stiftung_aufgehoben(s);
}

@source(BGB_P87a)
rule AufhebungBeiVerwaltungssitzImAusland(s: Stiftung) strict {
    label de official "Die Behörde hat die Stiftung aufzuheben, wenn der Verwaltungssitz im Ausland begründet wurde und die Behörde die Verlegung ins Inland nicht innerhalb angemessener Zeit erreichen kann (§ 87a Abs. 2 Nr. 3)";
    label en unofficial "The authority must abolish the foundation where its administrative seat was established abroad and cannot be moved back in reasonable time (§ 87a (2) no. 3)";
    when verwaltungssitz_im_ausland(s);
    then stiftung_aufgehoben(s);
}

@source(BGB_P87b)
rule AufloesungDerStiftungBeiInsolvenz(s: Stiftung) strict {
    label de official "Die Stiftung wird durch die Eröffnung des Insolvenzverfahrens und mit der Rechtskraft des Beschlusses, durch den die Eröffnung mangels Masse abgewiesen worden ist, aufgelöst (§ 87b)";
    label en unofficial "The foundation is dissolved by the opening of insolvency proceedings or the final refusal for lack of assets (§ 87b)";
    when insolvenzverfahren_ueber_stiftung_eroeffnet(s);
    then stiftung_aufgeloest(s);
}

@source(BGB_P87c)
rule VermoegensanfallNachSatzung(s: Stiftung, p: Person) strict {
    label de official "Mit der Auflösung oder Aufhebung der Stiftung fällt das Stiftungsvermögen an die in der Satzung bestimmten Anfallberechtigten (§ 87c Abs. 1 Satz 1)";
    label en unofficial "On dissolution or abolition the assets pass to the persons determined by the articles (§ 87c (1))";
    when stiftung_aufgeloest(s) and satzung_bestimmt_anfallberechtigten_der_stiftung(s, p);
    then stiftungsvermoegen_faellt_an(s, p);
}

@source(BGB_P87c)
rule VermoegensanfallAnDenFiskus(s: Stiftung, land: Ort) strict {
    label de official "Fehlt es an der Bestimmung der Anfallberechtigten durch oder aufgrund der Satzung, fällt das Stiftungsvermögen an den Fiskus des Landes, in dem die Stiftung ihren Sitz hatte (§ 87c Abs. 1 Satz 3)";
    label en unofficial "Absent a determination, the assets pass to the treasury of the Land where the foundation had its seat (§ 87c (1))";
    when stiftung_aufgeloest(s)
        and keine_bestimmung_der_anfallberechtigten_der_stiftung(s)
        and sitzland_der_stiftung(s, land);
    then stiftungsvermoegen_faellt_an_den_fiskus(s, land);
}

@source(BGB_P88)
rule KirchlicheStiftungen(s: Stiftung) strict {
    label de official "Die Vorschriften der Landesgesetze über die kirchlichen Stiftungen bleiben unberührt, insbesondere die Vorschriften zur Beteiligung, Zuständigkeit und Anfallsberechtigung der Kirchen (§ 88)";
    label en unofficial "The provisions of Land law on ecclesiastical foundations remain unaffected (§ 88)";
    when kirchliche_stiftung(s);
    then landesrecht_bleibt_unberuehrt(s);
}

// § 89 Juristische Personen des öffentlichen Rechts.
pub relation juristische_person_des_oeffentlichen_rechts(p: Person) kind empirical {
    label de official "Fiskus, Körperschaft, Stiftung oder Anstalt des öffentlichen Rechts (§ 89)";
    label en unofficial "treasury, corporation, foundation or institution under public law (§ 89)";
}
pub relation organhaftung_entsprechend(p: Person, geschaedigter: Person) kind institutional {
    label de official "die Vorschrift des § 31 findet auf den Fiskus sowie auf die Körperschaften, Stiftungen und Anstalten des öffentlichen Rechts entsprechende Anwendung (§ 89 Abs. 1)";
    label en unofficial "§ 31 applies mutatis mutandis to the treasury and public-law corporations, foundations and institutions (§ 89 (1))";
}

@source(BGB_P89)
rule OrganhaftungDerOeffentlichenHand(p: Person, g: Person) strict {
    label de official "Die Vorschrift des § 31 findet auf den Fiskus sowie auf die Körperschaften, Stiftungen und Anstalten des öffentlichen Rechts entsprechende Anwendung; das Gleiche gilt, soweit bei ihnen das Insolvenzverfahren zulässig ist, von der Vorschrift des § 42 Abs. 2 (§ 89)";
    label en unofficial "§ 31 applies mutatis mutandis to public-law entities; the same holds for § 42 (2) where insolvency proceedings are admissible (§ 89)";
    when juristische_person_des_oeffentlichen_rechts(p) and schaden_in_ausfuehrung_der_verrichtungen_oeffentlich(p, g);
    then organhaftung_entsprechend(p, g);
}

pub relation schaden_in_ausfuehrung_der_verrichtungen_oeffentlich(p: Person, geschaedigter: Person) kind empirical {
    label de official "ein verfassungsmäßig berufener Vertreter der juristischen Person des öffentlichen Rechts hat einem Dritten in Ausführung der ihm zustehenden Verrichtungen Schaden zugefügt (§ 89 Abs. 1 mit § 31)";
    label en unofficial "a constitutionally appointed representative of the public-law entity caused damage to a third party in the execution of their duties (§ 89 (1) with § 31)";
}
