language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";

pub relation position_trigger_871(s: Sache, mittelbar: Person, dritter: Person, tag: Date) kind empirical { label de official "Eingang des Falls nach § 871"; label en unofficial "case input under § 871"; }
pub relation mittelbarer_besitz_871_geschuldet(s: Sache, mittelbar: Person, dritter: Person) kind empirical { label de official "Der mittelbare Besitz des Dritten ist festzustellen (§ 871)"; label en unofficial "The third party's indirect possession is established (§ 871)"; }
pub relation position_trigger_886(v: Vormerkung, betroffener: Person, glaeubiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls auf Beseitigung der Vormerkung (§ 886)"; label en unofficial "case input for removal of a priority notice (§ 886)"; }
pub relation beseitigung_886_geschuldet(v: Vormerkung, betroffener: Person, glaeubiger: Person) kind empirical { label de official "Die Beseitigung der Vormerkung ist geschuldet (§ 886)"; label en unofficial "Removal of the priority notice is owed (§ 886)"; }
pub relation position_trigger_894(r: Recht, berechtigter: Person, betroffener: Person, tag: Date) kind empirical { label de official "Eingang des Falls auf Grundbuchberichtigung (§ 894)"; label en unofficial "case input for land-register correction (§ 894)"; }
pub relation berichtigung_894_geschuldet(r: Recht, berechtigter: Person, betroffener: Person) kind empirical { label de official "Die Zustimmung zur Berichtigung ist geschuldet (§ 894)"; label en unofficial "Consent to correction is owed (§ 894)"; }
pub relation position_trigger_915(g: Grundstueck, berechtigter: Person, nachbar: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum Abkauf des Notwegs (§ 915)"; label en unofficial "case input for purchase of the necessary way (§ 915)"; }
pub relation abkauf_915_ausuebbar(g: Grundstueck, berechtigter: Person, nachbar: Person) kind empirical { label de official "Der Berechtigte kann den Abkauf verlangen (§ 915)"; label en unofficial "The entitled party may demand purchase (§ 915)"; }
pub relation position_trigger_918(g: Grundstueck, eigentuemer: Person, nachbar: Person, tag: Date) kind empirical { label de official "Eingang des Falls nach § 918 Abs. 2"; label en unofficial "case input under § 918 (2)"; }
pub relation duldung_918_geschuldet(g: Grundstueck, eigentuemer: Person, nachbar: Person) kind empirical { label de official "Die Duldung des Notwegs ist geschuldet (§ 918 Abs. 2)"; label en unofficial "Tolerance of the necessary way is owed (§ 918 (2))"; }

@source(BGB_P871)
rule PositionMittelbarerBesitz871(s: Sache, mittelbar: Person, dritter: Person, tag: Date) strict { label de official "Der Dritte ist mittelbarer Besitzer (§ 871)"; label en unofficial "The third party is an indirect possessor (§ 871)"; when position_trigger_871(s, mittelbar, dritter, tag); then duty MittelbarerBesitz871 { bearer dritter; achieve mittelbarer_besitz_871_geschuldet(s, mittelbar, dritter) during [tag, infinity); }; }
@source(BGB_P886)
rule PositionBeseitigung886(v: Vormerkung, betroffener: Person, glaeubiger: Person, tag: Date) strict { label de official "Der Gläubiger hat die Vormerkung zu beseitigen (§ 886)"; label en unofficial "The beneficiary must remove the priority notice (§ 886)"; when position_trigger_886(v, betroffener, glaeubiger, tag); then duty Beseitigung886 { bearer glaeubiger; beneficiary betroffener; achieve beseitigung_886_geschuldet(v, betroffener, glaeubiger) during [tag, infinity); }; }
@source(BGB_P894)
rule PositionBerichtigung894(r: Recht, berechtigter: Person, betroffener: Person, tag: Date) strict { label de official "Der Betroffene hat der Grundbuchberichtigung zuzustimmen (§ 894)"; label en unofficial "The affected person must consent to register correction (§ 894)"; when position_trigger_894(r, berechtigter, betroffener, tag); then duty Berichtigung894 { bearer betroffener; beneficiary berechtigter; achieve berichtigung_894_geschuldet(r, berechtigter, betroffener) during [tag, infinity); }; }
@source(BGB_P915)
rule PositionAbkauf915(g: Grundstueck, berechtigter: Person, nachbar: Person, tag: Date) strict { label de official "Der Berechtigte hat die Befugnis zum Abkauf nach § 915"; label en unofficial "The entitled party has the power to demand purchase under § 915"; when position_trigger_915(g, berechtigter, nachbar, tag); then power Abkauf915 { holder berechtigter; over g; exercise abkauf_915_ausuebbar(g, berechtigter, nachbar); valid_when abkauf_915_ausuebbar(g, berechtigter, nachbar); effect create(abkauf_915_ausuebbar(g, berechtigter, nachbar)); window [tag, infinity); }; }
@source(BGB_P918)
rule PositionDuldung918(g: Grundstueck, eigentuemer: Person, nachbar: Person, tag: Date) strict { label de official "Der Eigentümer hat den Notweg zu dulden (§ 918 Abs. 2)"; label en unofficial "The owner must tolerate the necessary way (§ 918 (2))"; when position_trigger_918(g, eigentuemer, nachbar, tag); then duty Duldung918 { bearer eigentuemer; beneficiary nachbar; achieve duldung_918_geschuldet(g, eigentuemer, nachbar) during [tag, infinity); }; }
