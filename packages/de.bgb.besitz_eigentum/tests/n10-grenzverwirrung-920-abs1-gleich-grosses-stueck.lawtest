language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 920 Abs. 1 Satz 2: kann der Besitzstand nicht festgestellt werden, ist jedem Grundstück ein gleich großes Stück der streitigen Fläche zuzuteilen. Kanarei zu n09: statt Besitzstand feststellbar ist er hier NICHT feststellbar.
test "§ 920 Abs. 1 Satz 2: gleich großes Stück ohne feststellbaren Besitzstand" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": beteiligte_grundstuecke_am_grenzstreit(entity_ref("urn:de:bgb:be:n10:streit"), entity_ref("urn:de:bgb:be:n10:g1"), entity_ref("urn:de:bgb:be:n10:g2")) { origin case_input; }
        assert "f2": besitzstand_nicht_feststellbar(entity_ref("urn:de:bgb:be:n10:streit")) { origin adjudicated; }
    }
    evaluate truth(gleich_grosses_stueck_je_grundstueck(entity_ref("urn:de:bgb:be:n10:streit")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(grenze_nach_besitzstand_massgeblich(entity_ref("urn:de:bgb:be:n10:streit")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
