language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 1003 Abs. 1 Satz 2: das Befriedigungsrecht besteht nicht, wenn die Genehmigung rechtzeitig erfolgt. Kanarei zu eb10: gleiche Fristangaben, zusätzlich "f3" kippt die Erwartung.
test "§ 1003 Abs. 1: Befriedigungsrecht ausgeschlossen bei rechtzeitiger Genehmigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": aufforderung_zur_erklaerung_mit_betrag_am(entity_ref("urn:de:bgb:be:eb11:sache"), entity_ref("urn:de:bgb:be:eb11:B"), @2026-03-01, 400.00 EUR) { origin case_input; }
        assert "f2": vom_besitzer_bestimmte_frist_abgelaufen_am(entity_ref("urn:de:bgb:be:eb11:sache"), entity_ref("urn:de:bgb:be:eb11:B"), @2026-04-01) { origin case_input; }
        assert "f3": genehmigung_rechtzeitig_erfolgt(entity_ref("urn:de:bgb:be:eb11:sache"), entity_ref("urn:de:bgb:be:eb11:B")) { origin case_input; }
    }
    evaluate truth(befriedigungsrecht_aus_der_sache(entity_ref("urn:de:bgb:be:eb11:sache"), entity_ref("urn:de:bgb:be:eb11:B")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
