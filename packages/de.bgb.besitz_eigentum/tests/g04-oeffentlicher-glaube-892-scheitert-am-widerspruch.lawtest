language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// Gegenstück zu g03: ist gegen die Richtigkeit des Grundbuchs ein Widerspruch eingetragen, so greift der öffentliche Glaube nicht (§ 892 Abs. 1 Satz 1).
test "§ 892 Abs. 1: eingetragener Widerspruch schließt den öffentlichen Glauben aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": recht_am_grundstueck(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:grundstueck")) { origin case_input; }
        assert "f2": im_grundbuch_eingetragen_fuer(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:P")) { origin adjudicated; }
        assert "f3": eingetragen_am(entity_ref("urn:de:bgb:be:g:recht"), @2020-03-02) { origin adjudicated; }
        assert "f4": eingetragen_in_abteilung(entity_ref("urn:de:bgb:be:g:recht"), 3) { origin adjudicated; }
        assert "f5": erwerb_durch_rechtsgeschaeft(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:Q")) { origin case_input; }
        assert "f6": widerspruch_gegen_die_richtigkeit_eingetragen(entity_ref("urn:de:bgb:be:g:recht")) { origin adjudicated; }
    }
    evaluate truth(guter_glaube_ausgeschlossen(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:Q")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(inhalt_des_grundbuchs_gilt_als_richtig(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:Q")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
