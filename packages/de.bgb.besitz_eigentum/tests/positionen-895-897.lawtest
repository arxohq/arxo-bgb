language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";

test "§ 895: Voreintragung aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "t": position_trigger_895(entity_ref("urn:de:bgb:be:r895"), entity_ref("urn:de:bgb:be:p895"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(Voreintragung895, ACTIVE);
}

test "§ 895: Voreintragung erfüllt" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "t": position_trigger_895(entity_ref("urn:de:bgb:be:r895"), entity_ref("urn:de:bgb:be:p895"), @2026-01-01) { origin case_input; }
        assert "g": voreintragung_895_geschuldet(entity_ref("urn:de:bgb:be:r895"), entity_ref("urn:de:bgb:be:p895")) { origin case_input; }
    }
    evaluate positions();
    expect position(Voreintragung895, SATISFIED);
}

