language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 885 Abs. 1 Satz 1: die Eintragung der Vormerkung erfolgt auf Grund einer Bewilligung — eine Glaubhaftmachung der Gefährdung ist dafür nicht nötig (Satz 1, 2 gelten nur für die einstweilige Verfügung, hier irrelevant).
test "§ 885 Abs. 1: Vormerkung auf Grund der Bewilligung eintragbar" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": bewilligung_der_vormerkung(entity_ref("urn:de:bgb:be:gb11:v")) { origin case_input; }
    }
    evaluate truth(vormerkung_eintragbar(entity_ref("urn:de:bgb:be:gb11:v")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
