language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 1004 Abs. 1, 2: der Eigentümer kann die Beseitigung verlangen, es sei denn, er ist zur Duldung verpflichtet. Hier speist die Duldungspflicht des § 906 Abs. 2 den Ausschluss des § 1004 Abs. 2.
test "§ 1004 Abs. 2: die Duldungspflicht aus § 906 schließt den Beseitigungsanspruch aus" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": zufuehrung_von_einem_anderen_grundstueck(entity_ref("urn:de:bgb:be:n:immission"), entity_ref("urn:de:bgb:be:n:quelle"), entity_ref("urn:de:bgb:be:n:ziel")) { origin case_input; }
        assert "f2": eigentuemer_vor_dem_vorgang(entity_ref("urn:de:bgb:be:n:ziel"), entity_ref("urn:de:bgb:be:n:Z")) { origin case_input; }
        assert "f3": eigentuemer_vor_dem_vorgang(entity_ref("urn:de:bgb:be:n:quelle"), entity_ref("urn:de:bgb:be:n:B")) { origin case_input; }
        assert "f4": eigentum_in_anderer_weise_beeintraechtigt(entity_ref("urn:de:bgb:be:n:immission"), entity_ref("urn:de:bgb:be:n:ziel"), entity_ref("urn:de:bgb:be:n:B")) { origin case_input; }
        assert "j1": benutzung_ortsueblich(entity_ref("urn:de:bgb:be:n:immission")) { origin adjudicated; }
        assert "j2": keine_wirtschaftlich_zumutbaren_massnahmen(entity_ref("urn:de:bgb:be:n:immission")) { origin adjudicated; }
    }
    evaluate truth(zur_duldung_verpflichtet(entity_ref("urn:de:bgb:be:n:immission")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(beseitigungsanspruch(entity_ref("urn:de:bgb:be:n:immission"), entity_ref("urn:de:bgb:be:n:Z"), entity_ref("urn:de:bgb:be:n:B")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
