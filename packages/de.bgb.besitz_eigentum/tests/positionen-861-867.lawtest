language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";

test "§ 861: Wiedereinräumung aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "t": position_trigger_861(entity_ref("urn:de:bgb:be:t861"), entity_ref("urn:de:bgb:be:g861"), entity_ref("urn:de:bgb:be:o861"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(Wiedereinraeumung861, ACTIVE);
}

test "§ 861: Wiedereinräumung erfüllt" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "t": position_trigger_861(entity_ref("urn:de:bgb:be:t861"), entity_ref("urn:de:bgb:be:g861"), entity_ref("urn:de:bgb:be:o861"), @2026-01-01) { origin case_input; }
        assert "g": wiedereinraeumung_861_geschuldet(entity_ref("urn:de:bgb:be:t861"), entity_ref("urn:de:bgb:be:g861"), entity_ref("urn:de:bgb:be:o861")) { origin case_input; }
    }
    evaluate positions();
    expect position(Wiedereinraeumung861, SATISFIED);
}

