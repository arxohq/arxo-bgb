language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 923 Abs. 1: Früchte und Baum gebühren den Nachbarn zu gleichen Teilen — Bruch (1, 2). § 919 Abs. 3: die Kosten der Abmarkung tragen die Beteiligten zu gleichen Teilen; bei zwei Beteiligten ist das (1, 2).
test "§§ 919 Abs. 3, 923 Abs. 1: zu gleichen Teilen als exakter Bruch" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": grenzbaum_auf_der_grenze(entity_ref("urn:de:bgb:be:n:baum"), entity_ref("urn:de:bgb:be:n:gst-a"), entity_ref("urn:de:bgb:be:n:nachbar-gst")) { origin case_input; }
        assert "f2": eigentuemer_vor_dem_vorgang(entity_ref("urn:de:bgb:be:n:gst-a"), entity_ref("urn:de:bgb:be:n:EA")) { origin case_input; }
        assert "f3": eigentuemer_vor_dem_vorgang(entity_ref("urn:de:bgb:be:n:nachbar-gst"), entity_ref("urn:de:bgb:be:n:EB")) { origin case_input; }
        assert "f4": grenzzeichen_zu_errichten_oder_wiederherzustellen(entity_ref("urn:de:bgb:be:n:gst-a"), entity_ref("urn:de:bgb:be:n:nachbar-gst")) { origin case_input; }
        assert "f5": zahl_der_beteiligten(entity_ref("urn:de:bgb:be:n:gst-a"), 2) { origin case_input; }
    }
    evaluate truth(miteigentumsanteil(entity_ref("urn:de:bgb:be:n:baum"), entity_ref("urn:de:bgb:be:n:EA"), 1, 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(miteigentumsquote(entity_ref("urn:de:bgb:be:n:baum"), entity_ref("urn:de:bgb:be:n:EA"), 1 / 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anspruch_auf_mitwirkung_bei_der_abmarkung(entity_ref("urn:de:bgb:be:n:gst-a"), entity_ref("urn:de:bgb:be:n:EA"), entity_ref("urn:de:bgb:be:n:EB")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(kostenanteil_bruch(entity_ref("urn:de:bgb:be:n:gst-a"), entity_ref("urn:de:bgb:be:n:EB"), 1, 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(nachbarrechtlicher_anspruch_unverjaehrbar(entity_ref("urn:de:bgb:be:n:gst-a"), entity_ref("urn:de:bgb:be:n:EA"), entity_ref("urn:de:bgb:be:n:EB")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
