language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 859 Abs. 3 mit der Antwort des Gerichts (origin adjudicated): die Wiederbemächtigung ist sofort nach der Entziehung erfolgt — die Befugnis steht fest, weitere Urteilsanfragen bleiben nicht offen.
test "§ 859 Abs. 3: Entsetzung nach der Wertung des Gerichts" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": besitzlage_sache(entity_ref("urn:de:bgb:be:g:besitz-a"), entity_ref("urn:de:bgb:be:g:grundstueck")) { origin case_input; }
        assert "f2": besitzlage_person(entity_ref("urn:de:bgb:be:g:besitz-a"), entity_ref("urn:de:bgb:be:b:A")) { origin case_input; }
        assert "f3": tatsaechliche_gewalt_erlangt_am(entity_ref("urn:de:bgb:be:g:besitz-a"), @2020-04-01) { origin case_input; }
        assert "f4": uebt_die_gewalt_fuer_sich_aus(entity_ref("urn:de:bgb:be:g:besitz-a")) { origin case_input; }
        assert "f5": tat_betrifft_besitz(entity_ref("urn:de:bgb:be:g:tat"), entity_ref("urn:de:bgb:be:g:besitz-a")) { origin case_input; }
        assert "f6": taeter(entity_ref("urn:de:bgb:be:g:tat"), entity_ref("urn:de:bgb:be:b:B")) { origin case_input; }
        assert "f7": besitzentziehung(entity_ref("urn:de:bgb:be:g:tat")) { origin case_input; }
        assert "f8": ohne_willen_des_besitzers(entity_ref("urn:de:bgb:be:g:tat")) { origin case_input; }
        assert "f9": keine_gesetzliche_gestattung(entity_ref("urn:de:bgb:be:g:tat")) { origin case_input; }
        assert "f10": grundstueck_betroffen(entity_ref("urn:de:bgb:be:g:tat")) { origin case_input; }
        assert "f11": veruebt_am(entity_ref("urn:de:bgb:be:g:tat"), @2026-06-01) { origin case_input; }
        assert "j1": sofort_nach_der_entziehung(entity_ref("urn:de:bgb:be:g:tat")) { origin adjudicated; }
    }
    evaluate truth(selbsthilfe_entsetzung_befugt(entity_ref("urn:de:bgb:be:b:A"), entity_ref("urn:de:bgb:be:g:tat")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect judgment_requests(0);
}
