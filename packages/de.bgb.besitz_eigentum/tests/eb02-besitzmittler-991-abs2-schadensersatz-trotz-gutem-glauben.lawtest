language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 991 Abs. 2: war der Besitzer bei Erwerb des Besitzes in gutem Glauben, haftet er trotzdem für den in § 989 bezeichneten Schaden, soweit er dem mittelbaren Besitzer verantwortlich ist.
test "§ 991 Abs. 2: Schadensersatzhaftung trotz guten Glaubens" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": besitzmittler_leitet_recht_von(entity_ref("urn:de:bgb:be:eb02:sache"), entity_ref("urn:de:bgb:be:eb02:B"), entity_ref("urn:de:bgb:be:eb02:M")) { origin case_input; }
        assert "f2": besitzer_bei_besitzerwerb_in_gutem_glauben(entity_ref("urn:de:bgb:be:eb02:sache"), entity_ref("urn:de:bgb:be:eb02:B")) { origin case_input; }
        assert "f3": besitzer_verantwortlich_gegenueber_mittelbarem(entity_ref("urn:de:bgb:be:eb02:sache"), entity_ref("urn:de:bgb:be:eb02:B"), entity_ref("urn:de:bgb:be:eb02:M")) { origin case_input; }
        assert "f4": sache_verschlechtert_untergegangen_oder_nicht_herausgebbar(entity_ref("urn:de:bgb:be:eb02:sache")) { origin case_input; }
        assert "f5": verschulden_des_besitzers(entity_ref("urn:de:bgb:be:eb02:sache"), entity_ref("urn:de:bgb:be:eb02:B")) { origin adjudicated; }
    }
    evaluate truth(schadensersatzpflicht_des_besitzers(entity_ref("urn:de:bgb:be:eb02:sache"), entity_ref("urn:de:bgb:be:eb02:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
