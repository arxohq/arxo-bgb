language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";

test "§ 904: Duldung aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "t": position_trigger_904(entity_ref("urn:de:bgb:be:s904"), entity_ref("urn:de:bgb:be:e904"), entity_ref("urn:de:bgb:be:i904"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(Duldung904, ACTIVE);
}

test "§ 904: Duldung erfüllt" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "t": position_trigger_904(entity_ref("urn:de:bgb:be:s904"), entity_ref("urn:de:bgb:be:e904"), entity_ref("urn:de:bgb:be:i904"), @2026-01-01) { origin case_input; }
        assert "g": duldung_904_geschuldet(entity_ref("urn:de:bgb:be:s904"), entity_ref("urn:de:bgb:be:e904"), entity_ref("urn:de:bgb:be:i904")) { origin case_input; }
    }
    evaluate positions();
    expect position(Duldung904, SATISFIED);
}

