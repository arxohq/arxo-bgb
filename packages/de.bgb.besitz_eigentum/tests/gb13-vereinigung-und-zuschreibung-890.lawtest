language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 890 Abs. 1: mehrere Grundstücke werden durch Eintragung als ein Grundstück vereinigt. Abs. 2: ein Grundstück wird durch Zuschreibung Bestandteil eines anderen.
test "§ 890 Abs. 1, 2: Vereinigung von Grundstücken und Zuschreibung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": grundstuecke_als_ein_grundstueck_eingetragen(entity_ref("urn:de:bgb:be:gb13:g1"), entity_ref("urn:de:bgb:be:gb13:g2"), entity_ref("urn:de:bgb:be:gb13:vereinigt")) { origin adjudicated; }
        assert "f2": grundstueck_einem_anderen_zugeschrieben(entity_ref("urn:de:bgb:be:gb13:teil"), entity_ref("urn:de:bgb:be:gb13:haupt")) { origin adjudicated; }
    }
    evaluate truth(grundstuecke_vereinigt(entity_ref("urn:de:bgb:be:gb13:vereinigt"), entity_ref("urn:de:bgb:be:gb13:g1"), entity_ref("urn:de:bgb:be:gb13:g2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(grundstueck_ist_bestandteil_durch_zuschreibung(entity_ref("urn:de:bgb:be:gb13:teil"), entity_ref("urn:de:bgb:be:gb13:haupt")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
