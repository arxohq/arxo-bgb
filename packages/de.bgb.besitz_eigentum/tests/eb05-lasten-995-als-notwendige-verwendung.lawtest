language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 995 Satz 1: Aufwendungen zur Bestreitung von Lasten der Sache gehören zu den notwendigen Verwendungen im Sinne des § 994 und begründen denselben Ersatzanspruch.
test "§ 995: Lasten gehören zu den notwendigen Verwendungen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": lastenaufwendung_gemacht(entity_ref("urn:de:bgb:be:eb05:sache"), entity_ref("urn:de:bgb:be:eb05:B")) { origin case_input; }
    }
    evaluate truth(notwendige_verwendung_gemacht(entity_ref("urn:de:bgb:be:eb05:sache"), entity_ref("urn:de:bgb:be:eb05:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verwendungsersatzanspruch(entity_ref("urn:de:bgb:be:eb05:sache"), entity_ref("urn:de:bgb:be:eb05:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
