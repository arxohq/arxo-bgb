language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 998: ist ein landwirtschaftliches Grundstück herauszugeben, hat der Eigentümer die Bestellungskosten für die noch nicht getrennten Früchte zu ersetzen, soweit sie ordnungsmäßig sind und den Fruchtwert nicht übersteigen.
test "§ 998: Ersatz der Bestellungskosten bei landwirtschaftlichem Grundstück" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": landwirtschaftliches_grundstueck_herauszugeben(entity_ref("urn:de:bgb:be:eb08:acker")) { origin case_input; }
        assert "f2": bestellungskosten_gemacht(entity_ref("urn:de:bgb:be:eb08:acker"), entity_ref("urn:de:bgb:be:eb08:B"), 600.00 EUR) { origin case_input; }
        assert "f3": bestellungskosten_ordnungsmaessig_und_wert_nicht_uebersteigend(entity_ref("urn:de:bgb:be:eb08:acker"), entity_ref("urn:de:bgb:be:eb08:B")) { origin case_input; }
    }
    evaluate truth(bestellungskostenersatzanspruch(entity_ref("urn:de:bgb:be:eb08:acker"), entity_ref("urn:de:bgb:be:eb08:B"), 600.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
