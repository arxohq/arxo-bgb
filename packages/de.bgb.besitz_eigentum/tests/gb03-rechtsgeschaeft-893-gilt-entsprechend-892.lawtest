language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 893: wird an den Eingetragenen auf Grund seines Rechts eine Leistung bewirkt, findet § 892 entsprechende Anwendung — der öffentliche Glaube trägt den Erwerb wie bei einem Rechtsgeschäft.
test "§ 893: Leistung an den Eingetragenen gilt als Erwerb durch Rechtsgeschäft (§ 892 entsprechend)" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": leistung_aufgrund_des_eingetragenen_rechts_bewirkt(entity_ref("urn:de:bgb:be:gb03:recht"), entity_ref("urn:de:bgb:be:gb03:Q")) { origin case_input; }
        assert "f2": keine_spaetere_einigung(entity_ref("urn:de:bgb:be:gb03:recht")) { origin case_input; }
    }
    evaluate truth(erwerb_durch_rechtsgeschaeft(entity_ref("urn:de:bgb:be:gb03:recht"), entity_ref("urn:de:bgb:be:gb03:Q")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(inhalt_des_grundbuchs_gilt_als_richtig(entity_ref("urn:de:bgb:be:gb03:recht"), entity_ref("urn:de:bgb:be:gb03:Q")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
