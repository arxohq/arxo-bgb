language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 951 Abs. 2 Satz 2: in den Fällen der §§ 946, 947 ist die Wegnahme nach § 997 auch zulässig, wenn die Verbindung NICHT vom Besitzer der Hauptsache bewirkt worden ist.
test "§ 951 Abs. 2 Satz 2: Wegnahmerecht auch ohne Besitz der Hauptsache" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": verbindung_nach_946_947_ohne_besitz_der_hauptsache(entity_ref("urn:de:bgb:be:vk03:sache"), entity_ref("urn:de:bgb:be:vk03:teil"), entity_ref("urn:de:bgb:be:vk03:D")) { origin case_input; }
    }
    evaluate truth(wegnahmerecht(entity_ref("urn:de:bgb:be:vk03:sache"), entity_ref("urn:de:bgb:be:vk03:teil"), entity_ref("urn:de:bgb:be:vk03:D")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
