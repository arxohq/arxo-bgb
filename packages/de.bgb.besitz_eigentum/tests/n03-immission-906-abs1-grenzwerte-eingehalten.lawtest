language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 906 Abs. 1 Satz 2: werden die in Gesetzen oder Rechtsverordnungen festgelegten Grenz- oder Richtwerte nicht überschritten, liegt „in der Regel“ eine unwesentliche Beeinträchtigung vor — widerlegliche Regel; die Werte selbst kommen aus dem Immissionsschutzrecht als Eingabe des Falls.
test "§ 906 Abs. 1: eingehaltene Grenzwerte — Duldungspflicht des Nachbarn" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": zufuehrung_von_einem_anderen_grundstueck(entity_ref("urn:de:bgb:be:n:immission"), entity_ref("urn:de:bgb:be:n:quelle"), entity_ref("urn:de:bgb:be:n:ziel")) { origin case_input; }
        assert "f2": eigentuemer_vor_dem_vorgang(entity_ref("urn:de:bgb:be:n:ziel"), entity_ref("urn:de:bgb:be:n:Z")) { origin case_input; }
        assert "f3": eigentuemer_vor_dem_vorgang(entity_ref("urn:de:bgb:be:n:quelle"), entity_ref("urn:de:bgb:be:n:B")) { origin case_input; }
        assert "f4": grenz_oder_richtwerte_nicht_ueberschritten(entity_ref("urn:de:bgb:be:n:immission")) { origin case_input; }
    }
    evaluate truth(unwesentliche_beeintraechtigung_vermutet(entity_ref("urn:de:bgb:be:n:immission")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == REQUIRES_JUDGMENT;
    evaluate truth(duldungspflicht_immission(entity_ref("urn:de:bgb:be:n:ziel"), entity_ref("urn:de:bgb:be:n:Z"), entity_ref("urn:de:bgb:be:n:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
