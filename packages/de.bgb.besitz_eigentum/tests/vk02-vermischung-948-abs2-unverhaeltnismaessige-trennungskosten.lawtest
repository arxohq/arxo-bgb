language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 948 Abs. 2: der Untrennbarkeit steht es gleich, wenn die Trennung mit unverhältnismäßigen Kosten verbunden wäre — dann gilt wie bei Abs. 1 § 947 entsprechend.
test "§ 948 Abs. 2: unverhältnismäßige Trennungskosten stehen der Untrennbarkeit gleich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": trennung_der_vermischten_sachen_unverhaeltnismaessig_teuer(entity_ref("urn:de:bgb:be:vk02:vb"), entity_ref("urn:de:bgb:be:vk02:sand")) { origin case_input; }
    }
    evaluate truth(vermischt_oder_vermengt_untrennbar(entity_ref("urn:de:bgb:be:vk02:vb"), entity_ref("urn:de:bgb:be:vk02:sand")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verbundene_sache(entity_ref("urn:de:bgb:be:vk02:vb"), entity_ref("urn:de:bgb:be:vk02:sand")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
