language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 956 Abs. 1 Satz 1: gestattet der Eigentümer einem anderen, sich Erzeugnisse anzueignen, und ist ihm der Besitz der Sache überlassen, erwirbt er mit der Trennung.
test "§ 956 Abs. 1: Erwerb bei Gestattung mit Besitzüberlassung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": erzeugnis_der_sache(entity_ref("urn:de:bgb:be:vk07:obst"), entity_ref("urn:de:bgb:be:vk07:garten")) { origin case_input; }
        assert "f2": gestattung_zur_aneignung_durch_eigentuemer(entity_ref("urn:de:bgb:be:vk07:obst"), entity_ref("urn:de:bgb:be:vk07:garten"), entity_ref("urn:de:bgb:be:vk07:G")) { origin case_input; }
        assert "f3": besitz_dem_gestatteten_ueberlassen(entity_ref("urn:de:bgb:be:vk07:obst"), entity_ref("urn:de:bgb:be:vk07:garten"), entity_ref("urn:de:bgb:be:vk07:G")) { origin case_input; }
        assert "f4": andere_zuordnung_nach_954_bis_957_vorrangig(entity_ref("urn:de:bgb:be:vk07:obst")) { origin case_input; }
    }
    evaluate truth(eigentum_an_erzeugnissen_erworben(entity_ref("urn:de:bgb:be:vk07:obst"), entity_ref("urn:de:bgb:be:vk07:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
