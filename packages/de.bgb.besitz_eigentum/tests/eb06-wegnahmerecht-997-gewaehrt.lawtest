language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 997 Abs. 1: hat der Besitzer mit der Sache eine andere Sache als wesentlichen Bestandteil verbunden, so kann er sie abtrennen und sich aneignen — hier ohne einen Ausschlussgrund des Abs. 2.
test "§ 997 Abs. 1: Wegnahmerecht des Besitzers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": verbindung_als_wesentlicher_bestandteil_durch_besitzer(entity_ref("urn:de:bgb:be:eb06:sache"), entity_ref("urn:de:bgb:be:eb06:teil"), entity_ref("urn:de:bgb:be:eb06:B")) { origin case_input; }
    }
    evaluate truth(wegnahmerecht(entity_ref("urn:de:bgb:be:eb06:sache"), entity_ref("urn:de:bgb:be:eb06:teil"), entity_ref("urn:de:bgb:be:eb06:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
