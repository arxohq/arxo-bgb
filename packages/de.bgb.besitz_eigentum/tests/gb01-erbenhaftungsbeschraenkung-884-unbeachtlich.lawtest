language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 884: soweit der Anspruch durch die Vormerkung gesichert ist, kann sich der Erbe des Verpflichteten nicht auf die Beschränkung seiner Haftung berufen.
test "§ 884: Erbenhaftungsbeschränkung ist unbeachtlich, soweit die Vormerkung sichert" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": vormerkung_sichert_anspruch(entity_ref("urn:de:bgb:be:gb01:v"), entity_ref("urn:de:bgb:be:gb01:G"), entity_ref("urn:de:bgb:be:gb01:V")) { origin case_input; }
        assert "f2": erbe_des_verpflichteten(entity_ref("urn:de:bgb:be:gb01:v"), entity_ref("urn:de:bgb:be:gb01:E")) { origin case_input; }
    }
    evaluate truth(beschraenkung_der_erbenhaftung_unbeachtlich(entity_ref("urn:de:bgb:be:gb01:v"), entity_ref("urn:de:bgb:be:gb01:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
