language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";

test "§ 919: Abmarkung aktiv" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "t": position_trigger_919(entity_ref("urn:de:bgb:be:g919"), entity_ref("urn:de:bgb:be:e919"), entity_ref("urn:de:bgb:be:n919"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(Abmarkung919, ACTIVE);
}

test "§ 919: Abmarkung erfüllt" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
        assert "t": position_trigger_919(entity_ref("urn:de:bgb:be:g919"), entity_ref("urn:de:bgb:be:e919"), entity_ref("urn:de:bgb:be:n919"), @2026-01-01) { origin case_input; }
        assert "g": abmarkung_919_geschuldet(entity_ref("urn:de:bgb:be:g919"), entity_ref("urn:de:bgb:be:e919"), entity_ref("urn:de:bgb:be:n919")) { origin case_input; }
    }
    evaluate positions();
    expect position(Abmarkung919, SATISFIED);
}

