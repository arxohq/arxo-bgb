language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";

test "§§ 888 und 899: Befugnisse aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_888(entity_ref("urn:be:v888"), entity_ref("urn:be:g888"), entity_ref("urn:be:e888"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_899(entity_ref("urn:be:r899"), entity_ref("urn:be:b899"), entity_ref("urn:be:t899"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Zustimmung888, ACTIVE); expect position(Widerspruch899, ACTIVE);
}

test "§§ 888 und 899: Befugnisse ausgeübt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_888(entity_ref("urn:be:v888"), entity_ref("urn:be:g888"), entity_ref("urn:be:e888"), @2026-01-01) { origin case_input; }
 assert "ae": zustimmung_888_ausuebbar(entity_ref("urn:be:v888"), entity_ref("urn:be:g888"), entity_ref("urn:be:e888")) { origin case_input; }
 assert "b": position_trigger_899(entity_ref("urn:be:r899"), entity_ref("urn:be:b899"), entity_ref("urn:be:t899"), @2026-01-01) { origin case_input; }
 assert "be": widerspruch_899_ausuebbar(entity_ref("urn:be:r899"), entity_ref("urn:be:b899"), entity_ref("urn:be:t899")) { origin case_input; } }
 evaluate positions();
 expect position(Zustimmung888, ACTIVE); expect position(Widerspruch899, ACTIVE);
}
