language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 887: ist der Vormerkungsgläubiger unbekannt und liegen die Voraussetzungen des § 1170 vor, kann er im Aufgebotsverfahren ausgeschlossen werden; mit Rechtskraft des Ausschließungsbeschlusses erlischt die Wirkung der Vormerkung.
test "§ 887: Ausschließung des unbekannten Gläubigers und Erlöschen der Vormerkungswirkung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": glaeubiger_der_vormerkung_unbekannt(entity_ref("urn:de:bgb:be:gb12:v")) { origin adjudicated; }
        assert "f2": voraussetzungen_des_1170_fuer_ausschliessung_liegen_vor(entity_ref("urn:de:bgb:be:gb12:v")) { origin case_input; }
        assert "f3": ausschliessungsbeschluss_rechtskraeftig_am(entity_ref("urn:de:bgb:be:gb12:v"), @2026-06-01) { origin adjudicated; }
    }
    evaluate truth(glaeubiger_im_aufgebotsverfahren_ausschliessbar(entity_ref("urn:de:bgb:be:gb12:v")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wirkung_der_vormerkung_erloschen_am(entity_ref("urn:de:bgb:be:gb12:v"), @2026-06-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
