language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 972: auf den Anspruch des § 970 findet § 1000 entsprechende Anwendung — der Finder kann die Herausgabe der Fundsache verweigern, bis er wegen seiner Aufwendungen befriedigt wird.
test "§ 972: Zurückbehaltungsrecht des Finders aus dem Aufwendungsersatzanspruch des § 970" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": fundsache(entity_ref("urn:de:bgb:be:f18:fund"), entity_ref("urn:de:bgb:be:f18:hund")) { origin case_input; }
        assert "f2": finder(entity_ref("urn:de:bgb:be:f18:fund"), entity_ref("urn:de:bgb:be:f18:F")) { origin case_input; }
        assert "f3": aufwendung_gemacht(entity_ref("urn:de:bgb:be:f18:fund"), 60.00 EUR) { origin case_input; }
        assert "f4": aufwendung_war_erforderlich(entity_ref("urn:de:bgb:be:f18:fund")) { origin case_input; }
    }
    evaluate truth(fundaufwendungsersatzanspruch(entity_ref("urn:de:bgb:be:f18:fund"), entity_ref("urn:de:bgb:be:f18:F"), 60.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verwendungsersatzanspruch(entity_ref("urn:de:bgb:be:f18:hund"), entity_ref("urn:de:bgb:be:f18:F")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(herausgabe_verweigerbar(entity_ref("urn:de:bgb:be:f18:hund"), entity_ref("urn:de:bgb:be:f18:F")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
