language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 950 Abs. 2: mit dem Erwerb des Eigentums an der neuen Sache durch Verarbeitung erlöschen die an dem Stoffe bestehenden Rechte Dritter.
test "§ 950 Abs. 2: Erlöschen der Rechte Dritter am Stoff bei Verarbeitung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": recht_dritter_an_sache(entity_ref("urn:de:bgb:be:rd03:stoff"), entity_ref("urn:de:bgb:be:rd03:dritter")) { origin case_input; }
        assert "f2": neue_sache_durch_verarbeitung(entity_ref("urn:de:bgb:be:rd03:vb"), entity_ref("urn:de:bgb:be:rd03:neu"), entity_ref("urn:de:bgb:be:rd03:hersteller")) { origin case_input; }
    }
    evaluate truth(eigentum_durch_verarbeitung_erworben(entity_ref("urn:de:bgb:be:rd03:neu"), entity_ref("urn:de:bgb:be:rd03:hersteller")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == REQUIRES_JUDGMENT;
    evaluate truth(recht_dritter_erloschen(entity_ref("urn:de:bgb:be:rd03:stoff"), entity_ref("urn:de:bgb:be:rd03:dritter")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
