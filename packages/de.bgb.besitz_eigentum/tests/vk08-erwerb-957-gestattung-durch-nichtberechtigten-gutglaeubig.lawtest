language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 957: § 956 gilt auch, wenn der Gestattende nicht berechtigt ist, solange der Gestattete gutgläubig ist.
test "§ 957: Erwerb bei Gestattung durch einen Nichtberechtigten, gutgläubig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": erzeugnis_der_sache(entity_ref("urn:de:bgb:be:vk08:obst"), entity_ref("urn:de:bgb:be:vk08:garten")) { origin case_input; }
        assert "f2": gestattung_von_nichtberechtigtem(entity_ref("urn:de:bgb:be:vk08:obst"), entity_ref("urn:de:bgb:be:vk08:garten"), entity_ref("urn:de:bgb:be:vk08:G")) { origin case_input; }
        assert "f3": erzeugnisse_in_besitz_genommen(entity_ref("urn:de:bgb:be:vk08:obst"), entity_ref("urn:de:bgb:be:vk08:G")) { origin case_input; }
        assert "f4": andere_zuordnung_nach_954_bis_957_vorrangig(entity_ref("urn:de:bgb:be:vk08:obst")) { origin case_input; }
    }
    evaluate truth(eigentum_an_erzeugnissen_erworben(entity_ref("urn:de:bgb:be:vk08:obst"), entity_ref("urn:de:bgb:be:vk08:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
