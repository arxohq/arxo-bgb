language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 886: steht dem von der Vormerkung Betroffenen eine dauernde Einrede gegen den gesicherten Anspruch zu, kann er vom Gläubiger die Beseitigung der Vormerkung verlangen.
test "§ 886: Beseitigungsanspruch bei dauernder Einrede gegen den gesicherten Anspruch" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": vormerkung_sichert_anspruch(entity_ref("urn:de:bgb:be:gb02:v"), entity_ref("urn:de:bgb:be:gb02:G"), entity_ref("urn:de:bgb:be:gb02:B")) { origin case_input; }
        assert "f2": dauernde_einrede_gegen_gesicherten_anspruch(entity_ref("urn:de:bgb:be:gb02:v"), entity_ref("urn:de:bgb:be:gb02:B")) { origin adjudicated; }
    }
    evaluate truth(beseitigungsanspruch_der_vormerkung(entity_ref("urn:de:bgb:be:gb02:v"), entity_ref("urn:de:bgb:be:gb02:B"), entity_ref("urn:de:bgb:be:gb02:G")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
