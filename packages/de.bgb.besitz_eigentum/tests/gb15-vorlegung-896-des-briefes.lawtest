language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 896: ist zur Berichtigung die Vorlegung eines Hypotheken-, Grundschuld- oder Rentenschuldbriefs erforderlich, kann der Begünstigte vom Besitzer des Briefes die Vorlegung beim Grundbuchamt verlangen.
test "§ 896: Anspruch auf Vorlegung des Briefes zur Berichtigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": wirkliche_rechtslage_weicht_ab(entity_ref("urn:de:bgb:be:gb15:recht")) { origin adjudicated; }
        assert "f2": recht_nicht_oder_nicht_richtig_eingetragen_fuer(entity_ref("urn:de:bgb:be:gb15:recht"), entity_ref("urn:de:bgb:be:gb15:berechtigter")) { origin case_input; }
        assert "f3": von_der_berichtigung_betroffen(entity_ref("urn:de:bgb:be:gb15:recht"), entity_ref("urn:de:bgb:be:gb15:betroffener")) { origin case_input; }
        assert "f4": vorlegung_des_briefes_zur_berichtigung_erforderlich(entity_ref("urn:de:bgb:be:gb15:recht")) { origin adjudicated; }
        assert "f5": besitzer_des_briefes(entity_ref("urn:de:bgb:be:gb15:recht"), entity_ref("urn:de:bgb:be:gb15:besitzer")) { origin case_input; }
    }
    evaluate truth(anspruch_auf_vorlegung_des_briefes(entity_ref("urn:de:bgb:be:gb15:recht"), entity_ref("urn:de:bgb:be:gb15:berechtigter"), entity_ref("urn:de:bgb:be:gb15:besitzer")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
