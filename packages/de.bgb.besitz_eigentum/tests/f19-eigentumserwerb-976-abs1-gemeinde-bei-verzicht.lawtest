language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 976 Abs. 1: verzichtet der Finder gegenüber der Behörde auf das Recht zum Erwerb, geht es mit dem Ablauf der Frist des § 973 auf die Gemeinde des Fundorts über — der Finder selbst erwirbt dann NICHT (Kanarei zu f07, wo ohne Verzicht der Finder erwirbt).
test "§ 976 Abs. 1: Eigentumserwerb der Gemeinde bei Verzicht des Finders" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": fundsache(entity_ref("urn:de:bgb:be:f19:fund"), entity_ref("urn:de:bgb:be:f19:mantel")) { origin case_input; }
        assert "f2": finder(entity_ref("urn:de:bgb:be:f19:fund"), entity_ref("urn:de:bgb:be:f19:F")) { origin case_input; }
        assert "f3": empfangsberechtigter(entity_ref("urn:de:bgb:be:f19:fund"), entity_ref("urn:de:bgb:be:f19:B")) { origin case_input; }
        assert "f4": wert_der_fundsache(entity_ref("urn:de:bgb:be:f19:fund"), 1000.00 EUR) { origin case_input; }
        assert "f5": fundsache_ist_kein_tier(entity_ref("urn:de:bgb:be:f19:fund")) { origin case_input; }
        assert "f6": fund_bei_der_behoerde_angezeigt_am(entity_ref("urn:de:bgb:be:f19:fund"), @2025-11-14) { origin adjudicated; }
        assert "f7": fundfrist(entity_ref("urn:de:bgb:be:f19:fund"), entity_ref("urn:de:bgb:be:f19:frist")) { origin case_input; }
        assert "f8": verzicht_des_finders_gegenueber_der_behoerde(entity_ref("urn:de:bgb:be:f19:fund")) { origin case_input; }
        assert "f9": gemeinde_des_fundorts(entity_ref("urn:de:bgb:be:f19:fund"), entity_ref("urn:de:bgb:be:f19:gemeinde")) { origin case_input; }
    }
    evaluate truth(eigentum_durch_fund_erworben(entity_ref("urn:de:bgb:be:f19:mantel"), entity_ref("urn:de:bgb:be:f19:gemeinde")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(eigentumserwerb_des_finders_am(entity_ref("urn:de:bgb:be:f19:fund"), entity_ref("urn:de:bgb:be:f19:F"), @2026-05-14));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
