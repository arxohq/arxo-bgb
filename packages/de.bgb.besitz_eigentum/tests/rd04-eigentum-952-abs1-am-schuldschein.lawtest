language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 952 Abs. 1 Satz 1: das Eigentum an dem über eine Forderung ausgestellten Schuldschein steht dem Gläubiger zu. Satz 2: das Recht eines Dritten an der Forderung erstreckt sich auf den Schuldschein.
test "§ 952 Abs. 1: Eigentum am Schuldschein und Erstreckung des Drittrechts" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": glaeubiger_der_forderung(entity_ref("urn:de:bgb:be:rd04:schuldschein"), entity_ref("urn:de:bgb:be:rd04:glaeubiger")) { origin case_input; }
        assert "f2": recht_dritter_an_der_forderung(entity_ref("urn:de:bgb:be:rd04:schuldschein"), entity_ref("urn:de:bgb:be:rd04:dritter")) { origin case_input; }
    }
    evaluate truth(eigentum_erworben(entity_ref("urn:de:bgb:be:rd04:schuldschein"), entity_ref("urn:de:bgb:be:rd04:glaeubiger")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(recht_dritter_erstreckt_sich_auf_die_urkunde(entity_ref("urn:de:bgb:be:rd04:schuldschein"), entity_ref("urn:de:bgb:be:rd04:dritter")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
