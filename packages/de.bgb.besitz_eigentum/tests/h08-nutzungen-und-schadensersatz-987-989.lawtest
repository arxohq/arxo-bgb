language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// §§ 987 Abs. 1, 989: von dem Eintritt der Rechtshängigkeit an hat der Besitzer die gezogenen Nutzungen herauszugeben und haftet für den Schaden, der auf seinem Verschulden beruht — das Verschulden ist Wertung des Gerichts (§47.3).
test "§§ 987, 989: Nutzungen und Schadensersatz nach Eintritt der Rechtshängigkeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": besitzlage_sache(entity_ref("urn:de:bgb:be:h:besitz"), entity_ref("urn:de:bgb:be:h:fahrrad")) { origin case_input; }
        assert "f2": besitzlage_person(entity_ref("urn:de:bgb:be:h:besitz"), entity_ref("urn:de:bgb:be:h:B")) { origin case_input; }
        assert "f3": tatsaechliche_gewalt_erlangt_am(entity_ref("urn:de:bgb:be:h:besitz"), @2026-01-10) { origin case_input; }
        assert "f4": uebt_die_gewalt_fuer_sich_aus(entity_ref("urn:de:bgb:be:h:besitz")) { origin case_input; }
        assert "f5": eigentuemer_vor_dem_vorgang(entity_ref("urn:de:bgb:be:h:fahrrad"), entity_ref("urn:de:bgb:be:h:E")) { origin case_input; }
        assert "f6": bewegliche_sache(entity_ref("urn:de:bgb:be:h:fahrrad")) { origin case_input; }
        assert "f7": rechtshaengigkeit_eingetreten_am(entity_ref("urn:de:bgb:be:h:fahrrad"), entity_ref("urn:de:bgb:be:h:B"), @2026-02-02) { origin adjudicated; }
        assert "f8": nutzungen_nach_rechtshaengigkeit_gezogen(entity_ref("urn:de:bgb:be:h:fahrrad"), entity_ref("urn:de:bgb:be:h:B")) { origin case_input; }
        assert "f9": sache_verschlechtert_untergegangen_oder_nicht_herausgebbar(entity_ref("urn:de:bgb:be:h:fahrrad")) { origin case_input; }
        assert "j1": verschulden_des_besitzers(entity_ref("urn:de:bgb:be:h:fahrrad"), entity_ref("urn:de:bgb:be:h:B")) { origin adjudicated; }
    }
    evaluate truth(nutzungsherausgabepflicht(entity_ref("urn:de:bgb:be:h:fahrrad"), entity_ref("urn:de:bgb:be:h:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(schadensersatzpflicht_des_besitzers(entity_ref("urn:de:bgb:be:h:fahrrad"), entity_ref("urn:de:bgb:be:h:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
