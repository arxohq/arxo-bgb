language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 920 Abs. 2: führt die Bestimmung nach Abs. 1 zu einem mit den ermittelten Umständen (insbesondere der feststehenden Größe) nicht übereinstimmenden Ergebnis, ist die Grenze nach Billigkeit zu ziehen — Wertung des Gerichts (§47.3).
test "§ 920 Abs. 2: Billigkeitskorrektur bei abweichender Grundstücksgröße" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": beteiligte_grundstuecke_am_grenzstreit(entity_ref("urn:de:bgb:be:n11:streit"), entity_ref("urn:de:bgb:be:n11:g1"), entity_ref("urn:de:bgb:be:n11:g2")) { origin case_input; }
        assert "f2": besitzstand_nicht_feststellbar(entity_ref("urn:de:bgb:be:n11:streit")) { origin adjudicated; }
        assert "j1": ergebnis_stimmt_mit_umstaenden_nicht_ueberein(entity_ref("urn:de:bgb:be:n11:streit")) { origin adjudicated; }
    }
    evaluate truth(gleich_grosses_stueck_je_grundstueck(entity_ref("urn:de:bgb:be:n11:streit")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(grenze_nach_billigkeit_zu_ziehen(entity_ref("urn:de:bgb:be:n11:streit")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
