language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// Gegenstück zu h05: ohne Duldungspflicht besteht der Beseitigungsanspruch; sind weitere Beeinträchtigungen zu besorgen (Wertung des Gerichts), tritt der Unterlassungsanspruch hinzu.
test "§ 1004 Abs. 1: Beseitigung und Unterlassung ohne Duldungspflicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": eigentum_in_anderer_weise_beeintraechtigt(entity_ref("urn:de:bgb:be:n:immission"), entity_ref("urn:de:bgb:be:n:ziel"), entity_ref("urn:de:bgb:be:n:B")) { origin case_input; }
        assert "f2": eigentuemer_vor_dem_vorgang(entity_ref("urn:de:bgb:be:n:ziel"), entity_ref("urn:de:bgb:be:n:Z")) { origin case_input; }
        assert "j1": weitere_beeintraechtigungen_zu_besorgen(entity_ref("urn:de:bgb:be:n:immission")) { origin adjudicated; }
    }
    evaluate truth(beseitigungsanspruch(entity_ref("urn:de:bgb:be:n:immission"), entity_ref("urn:de:bgb:be:n:Z"), entity_ref("urn:de:bgb:be:n:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(unterlassungsanspruch(entity_ref("urn:de:bgb:be:n:immission"), entity_ref("urn:de:bgb:be:n:Z"), entity_ref("urn:de:bgb:be:n:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
