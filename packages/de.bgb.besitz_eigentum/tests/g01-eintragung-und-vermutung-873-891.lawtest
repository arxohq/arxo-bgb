language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// §§ 873 Abs. 1, 891 Abs. 1: Einigung des Berechtigten mit dem Erwerber und Eintragung im Grundbuch; für den Eingetragenen wird vermutet, dass ihm das Recht zustehe.
test "§§ 873 Abs. 1, 891 Abs. 1: Rechtsänderung durch Einigung und Eintragung, Vermutung zugunsten des Eingetragenen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": recht_am_grundstueck(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:grundstueck")) { origin case_input; }
        assert "f2": im_grundbuch_eingetragen_fuer(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:P")) { origin adjudicated; }
        assert "f3": eingetragen_am(entity_ref("urn:de:bgb:be:g:recht"), @2020-03-02) { origin adjudicated; }
        assert "f4": eingetragen_in_abteilung(entity_ref("urn:de:bgb:be:g:recht"), 3) { origin adjudicated; }
        assert "f5": einigung_ueber_die_rechtsaenderung(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:Q"), entity_ref("urn:de:bgb:be:g:P"), @2020-02-20) { origin case_input; }
        assert "f6": erklaerung_notariell_beurkundet(entity_ref("urn:de:bgb:be:g:recht")) { origin case_input; }
    }
    evaluate truth(rechtsaenderung_eingetreten(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:Q"), entity_ref("urn:de:bgb:be:g:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(bindung_an_die_einigung(entity_ref("urn:de:bgb:be:g:recht")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(recht_steht_zu(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
