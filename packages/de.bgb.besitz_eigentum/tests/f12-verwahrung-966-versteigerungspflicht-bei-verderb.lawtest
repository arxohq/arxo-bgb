language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 966 Abs. 1: Verwahrungspflicht des Finders. Abs. 2 Satz 1: droht der Verderb der Sache, hat der Finder sie öffentlich versteigern zu lassen; Satz 2: Anzeige vor der Versteigerung; Satz 3: der Erlös tritt an die Stelle der Sache.
test "§ 966: Verwahrungspflicht und Versteigerungspflicht bei drohendem Verderb" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": fundsache(entity_ref("urn:de:bgb:be:f12:fund"), entity_ref("urn:de:bgb:be:f12:obst")) { origin case_input; }
        assert "f2": finder(entity_ref("urn:de:bgb:be:f12:fund"), entity_ref("urn:de:bgb:be:f12:F")) { origin case_input; }
        assert "f3": sache_verderb_zu_besorgen(entity_ref("urn:de:bgb:be:f12:fund")) { origin case_input; }
    }
    evaluate truth(verwahrungspflicht_des_finders(entity_ref("urn:de:bgb:be:f12:fund"), entity_ref("urn:de:bgb:be:f12:F")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(versteigerungspflicht_des_finders(entity_ref("urn:de:bgb:be:f12:fund")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anzeigepflicht_vor_versteigerung(entity_ref("urn:de:bgb:be:f12:fund")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(versteigerungserloes_ersetzt_die_sache(entity_ref("urn:de:bgb:be:f12:fund")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
