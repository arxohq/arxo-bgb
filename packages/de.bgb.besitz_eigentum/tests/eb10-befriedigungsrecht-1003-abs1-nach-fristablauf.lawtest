language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 1003 Abs. 1: nach dem Ablauf der vom Besitzer selbst bestimmten Frist ist der Besitzer berechtigt, Befriedigung aus der Sache zu suchen — die Länge der Frist ist keine Wertung, sondern eine Angabe des Besitzers (Ledger D-10-09).
test "§ 1003 Abs. 1: Befriedigungsrecht nach Ablauf der vom Besitzer bestimmten Frist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": aufforderung_zur_erklaerung_mit_betrag_am(entity_ref("urn:de:bgb:be:eb10:sache"), entity_ref("urn:de:bgb:be:eb10:B"), @2026-03-01, 400.00 EUR) { origin case_input; }
        assert "f2": vom_besitzer_bestimmte_frist_abgelaufen_am(entity_ref("urn:de:bgb:be:eb10:sache"), entity_ref("urn:de:bgb:be:eb10:B"), @2026-04-01) { origin case_input; }
    }
    evaluate truth(befriedigungsrecht_aus_der_sache(entity_ref("urn:de:bgb:be:eb10:sache"), entity_ref("urn:de:bgb:be:eb10:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
