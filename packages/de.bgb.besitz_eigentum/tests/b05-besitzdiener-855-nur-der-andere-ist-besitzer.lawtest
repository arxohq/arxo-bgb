language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 855: D übt die tatsächliche Gewalt über die Ladenkasse weisungsgebunden im Erwerbsgeschäft des H aus. Besitzer ist nur H; D ist Besitzdiener und nicht Besitzer.
test "§ 855: nur der Weisungsgebende ist Besitzer" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": besitzlage_sache(entity_ref("urn:de:bgb:be:d:besitz-d"), entity_ref("urn:de:bgb:be:d:kasse")) { origin case_input; }
        assert "f2": besitzlage_person(entity_ref("urn:de:bgb:be:d:besitz-d"), entity_ref("urn:de:bgb:be:d:D")) { origin case_input; }
        assert "f3": tatsaechliche_gewalt_erlangt_am(entity_ref("urn:de:bgb:be:d:besitz-d"), @2026-01-05) { origin case_input; }
        assert "f4": weisungsgebundene_ausuebung_fuer(entity_ref("urn:de:bgb:be:d:besitz-d"), entity_ref("urn:de:bgb:be:d:H")) { origin case_input; }
    }
    evaluate truth(besitzer(entity_ref("urn:de:bgb:be:d:kasse"), entity_ref("urn:de:bgb:be:d:H")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(besitzer(entity_ref("urn:de:bgb:be:d:kasse"), entity_ref("urn:de:bgb:be:d:D")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
