language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 984: Eigentum am Schatz wird zur Hälfte vom Entdecker und zur Hälfte vom Eigentümer der Sache erworben, in welcher der Schatz verborgen war — exakte Brüche (1, 2).
test "§ 984: Schatzfund — je zur Hälfte für Entdecker und Grundstückseigentümer" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": schatz_entdeckt(entity_ref("urn:de:bgb:be:f:schatz"), entity_ref("urn:de:bgb:be:f:D"), entity_ref("urn:de:bgb:be:f:acker")) { origin case_input; }
        assert "f2": eigentuemer_vor_dem_vorgang(entity_ref("urn:de:bgb:be:f:acker"), entity_ref("urn:de:bgb:be:f:G")) { origin case_input; }
    }
    evaluate truth(miteigentumsanteil(entity_ref("urn:de:bgb:be:f:schatz"), entity_ref("urn:de:bgb:be:f:D"), 1, 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(miteigentumsanteil(entity_ref("urn:de:bgb:be:f:schatz"), entity_ref("urn:de:bgb:be:f:G"), 1, 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(miteigentumsquote(entity_ref("urn:de:bgb:be:f:schatz"), entity_ref("urn:de:bgb:be:f:D"), 1 / 2));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
