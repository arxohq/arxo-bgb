language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 880 Abs. 2 Satz 2: soll eine Hypothek zurücktreten, ist zusätzlich die Zustimmung des Eigentümers erforderlich.
test "§ 880 Abs. 2: Rangänderung einer Hypothek mit Zustimmung des Eigentümers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": rangaenderung_vereinbart(entity_ref("urn:de:bgb:be:gb08:hypothek"), entity_ref("urn:de:bgb:be:gb08:vortretend")) { origin case_input; }
        assert "f2": rangaenderung_eingetragen(entity_ref("urn:de:bgb:be:gb08:hypothek"), entity_ref("urn:de:bgb:be:gb08:vortretend")) { origin adjudicated; }
        assert "f3": zuruecktretendes_recht_ist_hypothek_grundschuld_oder_rentenschuld(entity_ref("urn:de:bgb:be:gb08:hypothek")) { origin case_input; }
        assert "f4": zustimmung_des_eigentuemers_zur_rangaenderung(entity_ref("urn:de:bgb:be:gb08:hypothek"), entity_ref("urn:de:bgb:be:gb08:vortretend")) { origin case_input; }
    }
    evaluate truth(rang_geaendert(entity_ref("urn:de:bgb:be:gb08:hypothek"), entity_ref("urn:de:bgb:be:gb08:vortretend")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
