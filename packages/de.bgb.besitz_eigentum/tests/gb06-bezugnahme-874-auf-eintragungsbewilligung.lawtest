language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 874 Satz 1: bei der Eintragung eines Rechts kann zur näheren Bezeichnung des Inhalts auf die Eintragungsbewilligung Bezug genommen werden, soweit nicht das Gesetz ein anderes vorschreibt.
test "§ 874: Inhalt des Rechts wirksam durch Bezugnahme auf die Eintragungsbewilligung bestimmt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": bezugnahme_auf_eintragungsbewilligung(entity_ref("urn:de:bgb:be:gb06:recht")) { origin case_input; }
    }
    evaluate truth(inhalt_wirksam_durch_bezugnahme_bestimmt(entity_ref("urn:de:bgb:be:gb06:recht")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
