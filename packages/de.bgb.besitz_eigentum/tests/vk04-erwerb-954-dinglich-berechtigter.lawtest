language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 954: wer vermöge eines Rechts an einer fremden Sache befugt ist, sich Erzeugnisse anzueignen, erwirbt das Eigentum mit der Trennung — hier vorrangig vor § 953.
test "§ 954: Erwerb der Erzeugnisse durch den dinglich Berechtigten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": erzeugnis_der_sache(entity_ref("urn:de:bgb:be:vk04:holz"), entity_ref("urn:de:bgb:be:vk04:wald")) { origin case_input; }
        assert "f2": dinglich_berechtigt_zur_aneignung_der_erzeugnisse(entity_ref("urn:de:bgb:be:vk04:holz"), entity_ref("urn:de:bgb:be:vk04:wald"), entity_ref("urn:de:bgb:be:vk04:N")) { origin case_input; }
        assert "f3": andere_zuordnung_nach_954_bis_957_vorrangig(entity_ref("urn:de:bgb:be:vk04:holz")) { origin case_input; }
        assert "f4": eigentuemer_vor_dem_vorgang(entity_ref("urn:de:bgb:be:vk04:wald"), entity_ref("urn:de:bgb:be:vk04:E")) { origin case_input; }
    }
    evaluate truth(eigentum_an_erzeugnissen_erworben(entity_ref("urn:de:bgb:be:vk04:holz"), entity_ref("urn:de:bgb:be:vk04:N")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(eigentum_an_erzeugnissen_erworben(entity_ref("urn:de:bgb:be:vk04:holz"), entity_ref("urn:de:bgb:be:vk04:E")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
