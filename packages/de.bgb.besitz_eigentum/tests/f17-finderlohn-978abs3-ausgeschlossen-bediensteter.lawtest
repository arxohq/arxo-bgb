language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 978 Abs. 3 Satz 1 in Verbindung mit Abs. 2 Satz 3: der Anspruch gegen den nach § 981 Abs. 1 Berechtigten ist ausgeschlossen, wenn der Finder Bediensteter der Behörde oder der Verkehrsanstalt ist. Kanarei zu f16: gleiche Werte, zusätzlich "f7" (Bediensteter) kippt beide Erwartungen.
test "§ 978 Abs. 3: Finderlohn ausgeschlossen, weil der Finder Bediensteter ist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": berechtigter_nach_981(entity_ref("urn:de:bgb:be:f17:fund"), entity_ref("urn:de:bgb:be:f17:gemeinde")) { origin adjudicated; }
        assert "f2": wert_der_fundsache(entity_ref("urn:de:bgb:be:f17:fund"), 400.00 EUR) { origin case_input; }
        assert "f3": fundsache_ist_kein_tier(entity_ref("urn:de:bgb:be:f17:fund")) { origin case_input; }
        assert "f4": finder(entity_ref("urn:de:bgb:be:f17:fund"), entity_ref("urn:de:bgb:be:f17:F")) { origin case_input; }
        assert "f5": finderlohnanspruch_978abs3_entstanden_am(entity_ref("urn:de:bgb:be:f17:fund"), @2023-02-10) { origin case_input; }
        assert "f6": finderlohnfrist_978abs3(entity_ref("urn:de:bgb:be:f17:fund"), entity_ref("urn:de:bgb:be:f17:frist")) { origin case_input; }
        assert "f7": finder_ist_bediensteter(entity_ref("urn:de:bgb:be:f17:fund")) { origin case_input; }
    }
    evaluate truth(finderlohnanspruch_978abs3_ausgeschlossen(entity_ref("urn:de:bgb:be:f17:fund")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(finderlohnanspruch(entity_ref("urn:de:bgb:be:f17:fund"), entity_ref("urn:de:bgb:be:f17:gemeinde"), 10.00 EUR));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
