language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 880 Abs. 2 Satz 1: Einigung und Eintragung genügen, wenn das zurücktretende Recht keine Hypothek, Grundschuld oder Rentenschuld ist.
test "§ 880 Abs. 2: Rangänderung durch Einigung und Eintragung ohne Hypothek" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": rangaenderung_vereinbart(entity_ref("urn:de:bgb:be:gb07:zuruecktretend"), entity_ref("urn:de:bgb:be:gb07:vortretend")) { origin case_input; }
        assert "f2": rangaenderung_eingetragen(entity_ref("urn:de:bgb:be:gb07:zuruecktretend"), entity_ref("urn:de:bgb:be:gb07:vortretend")) { origin adjudicated; }
        assert "f3": keine_hypothek_grundschuld_oder_rentenschuld(entity_ref("urn:de:bgb:be:gb07:zuruecktretend")) { origin case_input; }
    }
    evaluate truth(rang_geaendert(entity_ref("urn:de:bgb:be:gb07:zuruecktretend"), entity_ref("urn:de:bgb:be:gb07:vortretend")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
