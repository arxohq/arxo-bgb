language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";

test "§§ 871, 886, 894, 915, 918: Positionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_871(entity_ref("urn:be:s871"), entity_ref("urn:be:m871"), entity_ref("urn:be:d871"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_886(entity_ref("urn:be:v886"), entity_ref("urn:be:b886"), entity_ref("urn:be:g886"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_894(entity_ref("urn:be:r894"), entity_ref("urn:be:b894"), entity_ref("urn:be:t894"), @2026-01-01) { origin case_input; }
 assert "d": position_trigger_915(entity_ref("urn:be:g915"), entity_ref("urn:be:b915"), entity_ref("urn:be:n915"), @2026-01-01) { origin case_input; }
 assert "e": position_trigger_918(entity_ref("urn:be:g918"), entity_ref("urn:be:e918"), entity_ref("urn:be:n918"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(MittelbarerBesitz871, ACTIVE); expect position(Beseitigung886, ACTIVE); expect position(Berichtigung894, ACTIVE); expect position(Abkauf915, ACTIVE); expect position(Duldung918, ACTIVE);
}

test "§§ 871, 886, 894, 915, 918: Pflichten erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_871(entity_ref("urn:be:s871"), entity_ref("urn:be:m871"), entity_ref("urn:be:d871"), @2026-01-01) { origin case_input; }
 assert "ag": mittelbarer_besitz_871_geschuldet(entity_ref("urn:be:s871"), entity_ref("urn:be:m871"), entity_ref("urn:be:d871")) { origin case_input; }
 assert "b": position_trigger_886(entity_ref("urn:be:v886"), entity_ref("urn:be:b886"), entity_ref("urn:be:g886"), @2026-01-01) { origin case_input; }
 assert "bg": beseitigung_886_geschuldet(entity_ref("urn:be:v886"), entity_ref("urn:be:b886"), entity_ref("urn:be:g886")) { origin case_input; }
 assert "c": position_trigger_894(entity_ref("urn:be:r894"), entity_ref("urn:be:b894"), entity_ref("urn:be:t894"), @2026-01-01) { origin case_input; }
 assert "cg": berichtigung_894_geschuldet(entity_ref("urn:be:r894"), entity_ref("urn:be:b894"), entity_ref("urn:be:t894")) { origin case_input; }
 assert "d": position_trigger_915(entity_ref("urn:be:g915"), entity_ref("urn:be:b915"), entity_ref("urn:be:n915"), @2026-01-01) { origin case_input; }
 assert "dg": abkauf_915_ausuebbar(entity_ref("urn:be:g915"), entity_ref("urn:be:b915"), entity_ref("urn:be:n915")) { origin case_input; }
 assert "e": position_trigger_918(entity_ref("urn:be:g918"), entity_ref("urn:be:e918"), entity_ref("urn:be:n918"), @2026-01-01) { origin case_input; }
 assert "eg": duldung_918_geschuldet(entity_ref("urn:be:g918"), entity_ref("urn:be:e918"), entity_ref("urn:be:n918")) { origin case_input; } }
 evaluate positions();
 expect position(MittelbarerBesitz871, SATISFIED); expect position(Beseitigung886, SATISFIED); expect position(Berichtigung894, SATISFIED); expect position(Abkauf915, ACTIVE); expect position(Duldung918, SATISFIED);
}
