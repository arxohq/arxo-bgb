language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 957 Halbsatz 2: der Erwerb ist ausgeschlossen, wenn der Gestattete bei der Ergreifung des Besitzes nicht in gutem Glauben ist. Kanarei zu vk08: gleiche Gestattung, zusätzlich "f5" kippt die Erwartung.
test "§ 957: Erwerb ausgeschlossen bei Bösgläubigkeit des Gestatteten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": erzeugnis_der_sache(entity_ref("urn:de:bgb:be:vk09:obst"), entity_ref("urn:de:bgb:be:vk09:garten")) { origin case_input; }
        assert "f2": gestattung_von_nichtberechtigtem(entity_ref("urn:de:bgb:be:vk09:obst"), entity_ref("urn:de:bgb:be:vk09:garten"), entity_ref("urn:de:bgb:be:vk09:G")) { origin case_input; }
        assert "f3": erzeugnisse_in_besitz_genommen(entity_ref("urn:de:bgb:be:vk09:obst"), entity_ref("urn:de:bgb:be:vk09:G")) { origin case_input; }
        assert "f4": andere_zuordnung_nach_954_bis_957_vorrangig(entity_ref("urn:de:bgb:be:vk09:obst")) { origin case_input; }
        assert "f5": gestatteter_boesglaeubig_oder_erfaehrt_rechtsmangel_vor_trennung(entity_ref("urn:de:bgb:be:vk09:obst"), entity_ref("urn:de:bgb:be:vk09:G")) { origin case_input; }
    }
    evaluate truth(eigentum_an_erzeugnissen_erworben(entity_ref("urn:de:bgb:be:vk09:obst"), entity_ref("urn:de:bgb:be:vk09:G")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
