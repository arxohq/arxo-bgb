language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 993 Abs. 1: der redliche Besitzer (keine der Voraussetzungen der §§ 987–992 liegt vor) hat Übermaßfrüchte nach Bereicherungsrecht herauszugeben.
test "§ 993 Abs. 1: Herausgabe von Übermaßfrüchten durch den redlichen Besitzer" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": fruechte_kein_ordnungsmaessiger_ertrag_gezogen(entity_ref("urn:de:bgb:be:eb04:sache"), entity_ref("urn:de:bgb:be:eb04:B")) { origin case_input; }
    }
    evaluate truth(uebermassfruechte_herausgabepflicht(entity_ref("urn:de:bgb:be:eb04:sache"), entity_ref("urn:de:bgb:be:eb04:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
