language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 991 Abs. 1: leitet der Besitzer sein Recht von einem mittelbaren Besitzer ab, so haftet er nach § 987 für die Nutzungen nur, wenn die Voraussetzungen des § 990 auch beim mittelbaren Besitzer vorliegen (hier: dessen Unredlichkeit beim Erwerb).
test "§ 991 Abs. 1: Nutzungshaftung des Besitzers nur bei Unredlichkeit des mittelbaren Besitzers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": besitzmittler_leitet_recht_von(entity_ref("urn:de:bgb:be:eb01:sache"), entity_ref("urn:de:bgb:be:eb01:B"), entity_ref("urn:de:bgb:be:eb01:M")) { origin case_input; }
        assert "f2": mittelbarer_bei_besitzerwerb_nicht_in_gutem_glauben(entity_ref("urn:de:bgb:be:eb01:sache"), entity_ref("urn:de:bgb:be:eb01:M")) { origin adjudicated; }
        assert "f3": nutzungen_nach_rechtshaengigkeit_gezogen(entity_ref("urn:de:bgb:be:eb01:sache"), entity_ref("urn:de:bgb:be:eb01:B")) { origin case_input; }
    }
    evaluate truth(nutzungsherausgabepflicht(entity_ref("urn:de:bgb:be:eb01:sache"), entity_ref("urn:de:bgb:be:eb01:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
