language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 999 Abs. 1: der Besitzer kann für die Verwendungen eines Vorbesitzers, dessen Rechtsnachfolger er geworden ist, in demselben Umfang Ersatz verlangen, in welchem ihn der Vorbesitzer fordern könnte.
test "§ 999 Abs. 1: Ersatz von Verwendungen des Rechtsvorgängers" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": rechtsnachfolge_des_besitzers(entity_ref("urn:de:bgb:be:eb09:sache"), entity_ref("urn:de:bgb:be:eb09:N"), entity_ref("urn:de:bgb:be:eb09:V")) { origin case_input; }
        assert "f2": vorbesitzer_haette_verwendungsersatzanspruch(entity_ref("urn:de:bgb:be:eb09:sache"), entity_ref("urn:de:bgb:be:eb09:V")) { origin case_input; }
    }
    evaluate truth(verwendungsersatzanspruch(entity_ref("urn:de:bgb:be:eb09:sache"), entity_ref("urn:de:bgb:be:eb09:N")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
