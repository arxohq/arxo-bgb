language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 926 Abs. 1: im Zweifel wird angenommen, dass sich die Veräußerung des Grundstücks auf das Zubehör erstreckt — der Erwerber erlangt mit dem Grundstück auch das im Eigentum des Veräußerers stehende Zubehörstück.
test "§ 926 Abs. 1: Erwerb des Zubehörs im Zweifel mit dem Grundstück" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": eigentum_am_grundstueck_erworben(entity_ref("urn:de:bgb:be:gb04:grundstueck"), entity_ref("urn:de:bgb:be:gb04:K")) { origin case_input; }
        assert "f2": eigentuemer_vor_dem_vorgang(entity_ref("urn:de:bgb:be:gb04:grundstueck"), entity_ref("urn:de:bgb:be:gb04:V")) { origin case_input; }
        assert "f3": zubehoerstueck(entity_ref("urn:de:bgb:be:gb04:grundstueck"), entity_ref("urn:de:bgb:be:gb04:traktor")) { origin case_input; }
        assert "f4": zubehoer_gehoert_dem_veraeusserer_zur_zeit_des_erwerbs(entity_ref("urn:de:bgb:be:gb04:grundstueck"), entity_ref("urn:de:bgb:be:gb04:traktor")) { origin case_input; }
    }
    evaluate truth(einigkeit_ueber_erstreckung_auf_zubehoer(entity_ref("urn:de:bgb:be:gb04:grundstueck")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(eigentum_durch_zubehoerregel_erworben(entity_ref("urn:de:bgb:be:gb04:traktor"), entity_ref("urn:de:bgb:be:gb04:K")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
