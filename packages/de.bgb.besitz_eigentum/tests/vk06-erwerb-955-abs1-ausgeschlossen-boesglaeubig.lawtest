language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 955 Abs. 1 Satz 2: der Erwerb ist ausgeschlossen, wenn der Eigenbesitzer nicht zum Eigenbesitz berechtigt UND bei Erwerb des Eigenbesitzes bösgläubig war. Kanarei zu vk05: gleiche Besitzlage, zusätzlich "f7"/"f8" kippen beide Erwartungen.
test "§ 955 Abs. 1: Erwerb ausgeschlossen bei fehlendem Recht und Bösgläubigkeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": besitzlage_sache(entity_ref("urn:de:bgb:be:vk06:besitz"), entity_ref("urn:de:bgb:be:vk06:acker")) { origin case_input; }
        assert "f2": besitzlage_person(entity_ref("urn:de:bgb:be:vk06:besitz"), entity_ref("urn:de:bgb:be:vk06:P")) { origin case_input; }
        assert "f3": besitz_erworben_am(entity_ref("urn:de:bgb:be:vk06:besitz"), @2025-01-10) { origin case_input; }
        assert "f4": besitzt_als_ihm_gehoerend(entity_ref("urn:de:bgb:be:vk06:besitz")) { origin case_input; }
        assert "f5": erzeugnis_der_sache(entity_ref("urn:de:bgb:be:vk06:ernte"), entity_ref("urn:de:bgb:be:vk06:acker")) { origin case_input; }
        assert "f6": andere_zuordnung_nach_954_bis_957_vorrangig(entity_ref("urn:de:bgb:be:vk06:ernte")) { origin case_input; }
        assert "f7": eigenbesitzer_ohne_eigenbesitzrecht_oder_anderer_fruchtbezugsberechtigt(entity_ref("urn:de:bgb:be:vk06:acker")) { origin case_input; }
        assert "f8": eigenbesitzer_boesglaeubig_oder_erfaehrt_rechtsmangel_vor_trennung(entity_ref("urn:de:bgb:be:vk06:acker"), entity_ref("urn:de:bgb:be:vk06:P")) { origin case_input; }
    }
    evaluate truth(erwerb_durch_eigenbesitzer_955_ausgeschlossen(entity_ref("urn:de:bgb:be:vk06:acker"), entity_ref("urn:de:bgb:be:vk06:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(eigentum_an_erzeugnissen_erworben(entity_ref("urn:de:bgb:be:vk06:ernte"), entity_ref("urn:de:bgb:be:vk06:P")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
