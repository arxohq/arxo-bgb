language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 895: kann die Berichtigung erst erfolgen, nachdem das Recht des nach § 894 Verpflichteten eingetragen worden ist, hat dieser auf Verlangen sein Recht eintragen zu lassen.
test "§ 895: Pflicht zur Voreintragung des nach § 894 Verpflichteten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": wirkliche_rechtslage_weicht_ab(entity_ref("urn:de:bgb:be:gb14:recht")) { origin adjudicated; }
        assert "f2": recht_nicht_oder_nicht_richtig_eingetragen_fuer(entity_ref("urn:de:bgb:be:gb14:recht"), entity_ref("urn:de:bgb:be:gb14:berechtigter")) { origin case_input; }
        assert "f3": von_der_berichtigung_betroffen(entity_ref("urn:de:bgb:be:gb14:recht"), entity_ref("urn:de:bgb:be:gb14:betroffener")) { origin case_input; }
        assert "f4": berichtigung_setzt_voreintragung_voraus(entity_ref("urn:de:bgb:be:gb14:recht"), entity_ref("urn:de:bgb:be:gb14:betroffener")) { origin case_input; }
        assert "f5": voreintragung_verlangt(entity_ref("urn:de:bgb:be:gb14:recht"), entity_ref("urn:de:bgb:be:gb14:betroffener")) { origin case_input; }
    }
    evaluate truth(pflicht_zur_voreintragung(entity_ref("urn:de:bgb:be:gb14:recht"), entity_ref("urn:de:bgb:be:gb14:betroffener")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
