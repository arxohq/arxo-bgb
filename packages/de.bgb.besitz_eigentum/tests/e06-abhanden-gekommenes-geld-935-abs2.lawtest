language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 935 Abs. 2: auf Geld und Inhaberpapiere sowie auf Sachen aus öffentlicher Versteigerung findet Absatz 1 keine Anwendung — der gutgläubige Erwerb tritt trotz Abhandenkommens ein. Das Gericht hat die grobe Fahrlässigkeit ausdrücklich verneint (§ 932 Abs. 2, origin adjudicated mit `not`), deshalb bleibt kein Urteilskanal offen.
test "§ 935 Abs. 2: Geld und Inhaberpapiere — Erwerb trotz Abhandenkommens" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": veraeusserte_sache(entity_ref("urn:de:bgb:be:e:veraeusserung"), entity_ref("urn:de:bgb:be:e:geld")) { origin case_input; }
        assert "f2": veraeusserer(entity_ref("urn:de:bgb:be:e:veraeusserung"), entity_ref("urn:de:bgb:be:e:V")) { origin case_input; }
        assert "f3": erwerber(entity_ref("urn:de:bgb:be:e:veraeusserung"), entity_ref("urn:de:bgb:be:e:E")) { origin case_input; }
        assert "f4": bewegliche_sache(entity_ref("urn:de:bgb:be:e:geld")) { origin case_input; }
        assert "f5": einigung_ueber_den_eigentumsuebergang(entity_ref("urn:de:bgb:be:e:veraeusserung")) { origin case_input; }
        assert "f6": uebergabe_erfolgt(entity_ref("urn:de:bgb:be:e:veraeusserung")) { origin case_input; }
        assert "f7": veraeusserer_ist_nicht_eigentuemer(entity_ref("urn:de:bgb:be:e:veraeusserung")) { origin adjudicated; }
        assert "j2": abhanden_gekommen(entity_ref("urn:de:bgb:be:e:geld")) { origin adjudicated; }
        assert "f8": geld_oder_inhaberpapier_oder_oeffentliche_versteigerung(entity_ref("urn:de:bgb:be:e:geld")) { origin case_input; }
        assert "j9": not grob_fahrlaessige_unkenntnis_des_erwerbers(entity_ref("urn:de:bgb:be:e:veraeusserung")) { origin adjudicated; }
    }
    evaluate truth(gutglaeubiger_erwerb_ausgeschlossen(entity_ref("urn:de:bgb:be:e:veraeusserung")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    evaluate truth(eigentum_durch_uebereignung_erworben(entity_ref("urn:de:bgb:be:e:geld"), entity_ref("urn:de:bgb:be:e:E")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
