language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 992: hat sich der Besitzer durch verbotene Eigenmacht oder eine Straftat den Besitz verschafft, haftet er nach den Vorschriften über Schadensersatz wegen unerlaubter Handlungen — unabhängig von Rechtshängigkeit oder gutem Glauben.
test "§ 992: Haftung des deliktischen Besitzers unabhängig von Rechtshängigkeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": besitz_durch_verbotene_eigenmacht_oder_straftat_verschafft(entity_ref("urn:de:bgb:be:eb03:sache"), entity_ref("urn:de:bgb:be:eb03:B")) { origin case_input; }
    }
    evaluate truth(schadensersatzpflicht_des_besitzers(entity_ref("urn:de:bgb:be:eb03:sache"), entity_ref("urn:de:bgb:be:eb03:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
