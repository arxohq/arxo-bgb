language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 952 Abs. 2: das Gleiche gilt für Urkunden über andere Rechte, kraft deren eine Leistung gefordert werden kann, insbesondere für Hypotheken-, Grundschuld- und Rentenschuldbriefe.
test "§ 952 Abs. 2: Eigentum an einer Urkunde über ein anderes Recht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": berechtigter_der_urkunde_ueber_anderes_recht(entity_ref("urn:de:bgb:be:rd05:hypothekenbrief"), entity_ref("urn:de:bgb:be:rd05:berechtigter")) { origin case_input; }
    }
    evaluate truth(eigentum_erworben(entity_ref("urn:de:bgb:be:rd05:hypothekenbrief"), entity_ref("urn:de:bgb:be:rd05:berechtigter")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
