language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 978 Abs. 2 Satz 1, 2: beim Fund in einer Verkehrsanstalt besteht der Finderlohn in der Hälfte des Betrags nach § 971 Abs. 1 Satz 2 — bei einem Wert von 1.000 Euro also 20,00 Euro; die Schwelle von 50 Euro ist überschritten.
test "§ 978 Abs. 2: halber Finderlohn beim Fund in einer Verkehrsanstalt — 20,00 Euro" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": fundsache(entity_ref("urn:de:bgb:be:f:fund"), entity_ref("urn:de:bgb:be:f:mantel")) { origin case_input; }
        assert "f2": finder(entity_ref("urn:de:bgb:be:f:fund"), entity_ref("urn:de:bgb:be:f:F")) { origin case_input; }
        assert "f3": empfangsberechtigter(entity_ref("urn:de:bgb:be:f:fund"), entity_ref("urn:de:bgb:be:f:B")) { origin case_input; }
        assert "f4": wert_der_fundsache(entity_ref("urn:de:bgb:be:f:fund"), 1000.00 EUR) { origin case_input; }
        assert "f5": fundsache_ist_kein_tier(entity_ref("urn:de:bgb:be:f:fund")) { origin case_input; }
        assert "f6": fund_in_behoerde_oder_verkehrsanstalt(entity_ref("urn:de:bgb:be:f:fund")) { origin case_input; }
    }
    evaluate truth(ablieferungspflicht_des_finders(entity_ref("urn:de:bgb:be:f:fund"), entity_ref("urn:de:bgb:be:f:F")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(finderlohnanspruch(entity_ref("urn:de:bgb:be:f:fund"), entity_ref("urn:de:bgb:be:f:F"), 20.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
