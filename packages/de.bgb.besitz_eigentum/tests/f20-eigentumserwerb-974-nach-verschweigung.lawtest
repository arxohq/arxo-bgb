language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 974: wird der Empfangsberechtigte nach § 1003 aufgefordert und läuft die dafür bestimmte Frist ohne rechtzeitige Bereiterklärung ab, erwirbt der Finder das Eigentum.
test "§ 974: Eigentumserwerb des Finders nach Verschweigung des Empfangsberechtigten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": fundsache(entity_ref("urn:de:bgb:be:f20:fund"), entity_ref("urn:de:bgb:be:f20:uhr")) { origin case_input; }
        assert "f2": finder(entity_ref("urn:de:bgb:be:f20:fund"), entity_ref("urn:de:bgb:be:f20:F")) { origin case_input; }
        assert "f3": aufforderung_nach_1003_wegen_974(entity_ref("urn:de:bgb:be:f20:fund")) { origin case_input; }
        assert "f4": frist_zur_erklaerung_974_abgelaufen_am(entity_ref("urn:de:bgb:be:f20:fund"), @2026-05-01) { origin adjudicated; }
    }
    evaluate truth(eigentumserwerb_des_finders_am(entity_ref("urn:de:bgb:be:f20:fund"), entity_ref("urn:de:bgb:be:f20:F"), @2026-05-01));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(eigentum_durch_fund_erworben(entity_ref("urn:de:bgb:be:f20:uhr"), entity_ref("urn:de:bgb:be:f20:F")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
