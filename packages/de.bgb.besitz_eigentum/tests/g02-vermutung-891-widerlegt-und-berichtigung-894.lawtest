language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 891 Abs. 1 mit § 894: steht der Inhalt des Grundbuchs mit der wirklichen Rechtslage nicht im Einklang, so entfällt die Vermutung, und der wahre Berechtigte kann die Zustimmung zur Berichtigung verlangen.
test "§§ 891, 894: widerlegte Vermutung und Anspruch auf Berichtigung des Grundbuchs" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": recht_am_grundstueck(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:grundstueck")) { origin case_input; }
        assert "f2": im_grundbuch_eingetragen_fuer(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:P")) { origin adjudicated; }
        assert "f3": eingetragen_am(entity_ref("urn:de:bgb:be:g:recht"), @2020-03-02) { origin adjudicated; }
        assert "f4": eingetragen_in_abteilung(entity_ref("urn:de:bgb:be:g:recht"), 3) { origin adjudicated; }
        assert "f5": wirkliche_rechtslage_weicht_ab(entity_ref("urn:de:bgb:be:g:recht")) { origin adjudicated; }
        assert "f6": recht_nicht_oder_nicht_richtig_eingetragen_fuer(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:Q")) { origin adjudicated; }
        assert "f7": von_der_berichtigung_betroffen(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:P")) { origin case_input; }
    }
    evaluate truth(recht_steht_zu(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:P")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anspruch_auf_berichtigung(entity_ref("urn:de:bgb:be:g:recht"), entity_ref("urn:de:bgb:be:g:Q"), entity_ref("urn:de:bgb:be:g:P")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(anspruch_unverjaehrbar(entity_ref("urn:de:bgb:be:g:recht")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
