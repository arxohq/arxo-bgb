language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 949 Satz 1: erlischt nach den §§ 946 bis 948 das Eigentum an einer Sache ohne dass ein Ersatzgegenstand entsteht, so erlöschen auch die sonstigen an der Sache bestehenden Rechte Dritter.
test "§ 949 Satz 1: Erlöschen der Rechte Dritter ohne Ersatzgegenstand" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": recht_dritter_an_sache(entity_ref("urn:de:bgb:be:rd01:sache"), entity_ref("urn:de:bgb:be:rd01:dritter")) { origin case_input; }
        assert "f2": eigentum_an_s_erloschen_ohne_ersatzgegenstand(entity_ref("urn:de:bgb:be:rd01:sache")) { origin adjudicated; }
    }
    evaluate truth(recht_dritter_erloschen(entity_ref("urn:de:bgb:be:rd01:sache"), entity_ref("urn:de:bgb:be:rd01:dritter")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
