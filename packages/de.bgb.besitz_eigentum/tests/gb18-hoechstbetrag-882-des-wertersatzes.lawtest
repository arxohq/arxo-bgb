language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 882: der Höchstbetrag des Ersatzes für ein bei Zwangsversteigerung erlöschendes Recht kann bestimmt werden; die Bestimmung bedarf der Eintragung in das Grundbuch.
test "§ 882: Höchstbetrag des Wertersatzes wirksam bestimmt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": hoechstbetrag_des_wertersatzes_bestimmt(entity_ref("urn:de:bgb:be:gb18:recht"), 50000.00 EUR) { origin case_input; }
        assert "f2": hoechstbetrag_im_grundbuch_eingetragen(entity_ref("urn:de:bgb:be:gb18:recht")) { origin adjudicated; }
    }
    evaluate truth(hoechstbetrag_wirksam_bestimmt(entity_ref("urn:de:bgb:be:gb18:recht"), 50000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
