language "law.core" version "0.2";
package de.bgb.besitz_eigentum version "0.1.0";
namespace "urn:de:corpus:clir:bgb-besitz-eigentum";
// § 997 Abs. 2: das Wegnahmerecht ist ausgeschlossen, wenn dem Besitzer mindestens der Wert ersetzt wird, den der Bestandteil nach der Abtrennung für ihn haben würde. Kanarei zu eb06: gleiche Verbindung, zusätzlich "f2" kippt beide Erwartungen.
test "§ 997 Abs. 2: Wegnahmerecht ausgeschlossen bei Wertersatz" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.besitz_eigentum::KALENDER_BUNDESWEIT; deadline_policy BGB_BESITZ_EIGENTUM_KALENDER; }
        assert "f1": verbindung_als_wesentlicher_bestandteil_durch_besitzer(entity_ref("urn:de:bgb:be:eb07:sache"), entity_ref("urn:de:bgb:be:eb07:teil"), entity_ref("urn:de:bgb:be:eb07:B")) { origin case_input; }
        assert "f2": wert_wird_dem_besitzer_ersetzt(entity_ref("urn:de:bgb:be:eb07:sache"), entity_ref("urn:de:bgb:be:eb07:teil"), entity_ref("urn:de:bgb:be:eb07:B")) { origin case_input; }
    }
    evaluate truth(wegnahmerecht_ausgeschlossen(entity_ref("urn:de:bgb:be:eb07:sache"), entity_ref("urn:de:bgb:be:eb07:teil"), entity_ref("urn:de:bgb:be:eb07:B")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(wegnahmerecht(entity_ref("urn:de:bgb:be:eb07:sache"), entity_ref("urn:de:bgb:be:eb07:teil"), entity_ref("urn:de:bgb:be:eb07:B")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
