// --- Buch 3 Abschnitt 1: Besitz (§§ 854–872) ------------------------------------------------------
//
// Der Besitz ist eine Lage (§ 854): tatsächliche Gewalt einer Person über eine
// Sache. Ob die Gewalt für sich oder weisungsgebunden für einen anderen
// ausgeübt wird (§ 855), sagt der Fall ausdrücklich — das Fehlen der Angabe
// ist keine Verneinung. Der Besitzschutz der §§ 858–864 hängt an der Tat
// (verbotene Eigenmacht) und nicht am Recht zum Besitz: § 863 macht die
// petitorische Einwendung ausdrücklich unbeachtlich, und das Paket liest sie
// in den Anspruchsregeln auch nicht.
//
// „Sofort“ (§ 859 Abs. 3) und „weitere Störungen zu besorgen“ (§ 862 Abs. 1
// Satz 2) sind Wertungen des Gerichts (§47.3); „auf frischer Tat betroffen
// oder verfolgt“ und die Kenntnis der Fehlerhaftigkeit (§ 858 Abs. 2 Satz 2)
// sind festgestellte Tatsachen (origin adjudicated). Die Urteilsanfrage trägt
// jeweils eine STRIKTE Brückenregel, damit der Kanal nicht im widerleglichen
// Layer der Ausschlussgründe verschwindet (§111).

// --- Eingaben des Falls: Besitzlage ---------------------------------------------------------------

pub relation tatsaechliche_gewalt_erlangt_am(b: Besitz, tag: Date) kind empirical {
    key(b);
    label de official "Tag, an dem die tatsächliche Gewalt über die Sache erlangt worden ist (§ 854 Abs. 1)";
    label en unofficial "day on which physical control of the thing was obtained (§ 854 (1))";
}
pub relation einigung_ueber_den_besitzuebergang_am(b: Besitz, tag: Date) kind empirical {
    key(b);
    label de official "Tag der Einigung des bisherigen Besitzers und des Erwerbers über den Übergang des Besitzes (§ 854 Abs. 2)";
    label en unofficial "day of the agreement between the previous possessor and the acquirer on the transfer of possession (§ 854 (2))";
}
pub relation erwerber_kann_die_gewalt_ausueben(b: Besitz) kind empirical {
    label de official "der Erwerber ist in der Lage, die Gewalt über die Sache auszuüben (§ 854 Abs. 2)";
    label en unofficial "the acquirer is able to exercise control over the thing (§ 854 (2))";
}
pub relation uebt_die_gewalt_fuer_sich_aus(b: Besitz) kind empirical {
    label de official "die tatsächliche Gewalt wird für sich selbst ausgeübt — ausdrückliche Eingabe des Falls neben § 855";
    label en unofficial "physical control is exercised on one's own behalf — explicit case input alongside § 855";
}
pub relation weisungsgebundene_ausuebung_fuer(b: Besitz, anderer: Person) kind empirical {
    label de official "die tatsächliche Gewalt wird für einen anderen in dessen Haushalt, Erwerbsgeschäft oder einem ähnlichen Verhältnis ausgeübt, vermöge dessen den Weisungen des anderen Folge zu leisten ist (§ 855)";
    label en unofficial "control is exercised for another in that person's household or business or a similar relationship entailing compliance with their instructions (§ 855)";
}
pub relation teilbesitz(b: Besitz) kind empirical {
    label de official "die Besitzlage betrifft nur einen Teil einer Sache, insbesondere abgesonderte Wohnräume oder andere Räume (§ 865)";
    label en unofficial "the possession concerns only a part of a thing, in particular separate rooms (§ 865)";
}
pub relation mitbesitz(b: Besitz) kind empirical {
    label de official "mehrere besitzen die Sache gemeinschaftlich (§ 866)";
    label en unofficial "several persons possess the thing jointly (§ 866)";
}
pub relation besitzt_als_ihm_gehoerend(b: Besitz) kind empirical {
    label de official "die Sache wird als dem Besitzer gehörend besessen (§ 872)";
    label en unofficial "the thing is possessed as belonging to the possessor (§ 872)";
}
pub relation besitzmittlungsverhaeltnis_zu(b: Besitz, anderer: Person) kind empirical {
    label de official "der Besitzer besitzt als Nießbraucher, Pfandgläubiger, Pächter, Mieter, Verwahrer oder in einem ähnlichen Verhältnis, vermöge dessen er dem anderen gegenüber auf Zeit zum Besitz berechtigt oder verpflichtet ist (§ 868)";
    label en unofficial "the possessor possesses as usufructuary, pledgee, lessee, tenant, depositary or in a similar relationship entitling or obliging them towards the other for a time (§ 868)";
}
pub relation verhaeltnis_des_mittelbaren_besitzers_zu_drittem(s: Sache, mittelbar: Person, dritter: Person) kind empirical {
    label de official "der mittelbare Besitzer steht zu einem Dritten in einem Verhältnis der in § 868 bezeichneten Art (§ 871)";
    label en unofficial "the indirect possessor stands to a third party in a relationship of the kind described in § 868 (§ 871)";
}
pub relation herausgabeanspruch_abgetreten_an(s: Sache, erwerber: Person) kind empirical {
    label de official "der Anspruch auf Herausgabe der Sache ist abgetreten worden (§ 870, § 931)";
    label en unofficial "the claim to return of the thing has been assigned (§ 870, § 931)";
}
pub relation gewalt_aufgegeben_oder_verloren_am(b: Besitz, tag: Date) kind empirical {
    label de official "Tag, an dem der Besitzer die tatsächliche Gewalt über die Sache aufgegeben oder in anderer Weise verloren hat (§ 856 Abs. 1)";
    label en unofficial "day on which the possessor gave up or otherwise lost physical control of the thing (§ 856 (1))";
}
pub relation voruebergehende_verhinderung(b: Besitz) kind empirical {
    label de official "die Verhinderung in der Ausübung der Gewalt ist ihrer Natur nach vorübergehend (§ 856 Abs. 2) — festgestellte Tatsache";
    label en unofficial "the hindrance in exercising control is by its nature temporary (§ 856 (2)) — established fact";
}
pub relation erbe_des_besitzers(b: Besitz, erbe: Person) kind empirical {
    label de official "Erbe des Besitzers (§ 857) — festgestellte Tatsache (Erbschein, Nachlassgericht)";
    label en unofficial "heir of the possessor (§ 857) — established fact (certificate of inheritance)";
}

// --- Abgeleitete Besitzlagen (§§ 854–857, 865, 868–872) -------------------------------------------

pub relation besitz_erworben_am(b: Besitz, tag: Date) kind derived {
    key(b);
    label de official "Tag, an dem der Besitz erworben ist (§ 854 Abs. 1, Abs. 2)";
    label en unofficial "day on which possession was acquired (§ 854 (1), (2))";
}
pub relation besitz_beendet_am(b: Besitz, tag: Date) kind derived {
    label de official "Tag, mit dem der Besitz beendet ist (§ 856 Abs. 1); die ihrer Natur nach vorübergehende Verhinderung beendet ihn nicht (Abs. 2)";
    label en unofficial "day on which possession ends (§ 856 (1)); a temporary hindrance does not end it ((2))";
}

@source(BGB_P854) {
    rule BesitzerwerbDurchTatsaechlicheGewalt(b: Besitz, t: Date) strict {
        label de official "Der Besitz einer Sache wird durch die Erlangung der tatsächlichen Gewalt über die Sache erworben (§ 854 Abs. 1)";
        label en unofficial "Possession of a thing is acquired by obtaining physical control of it (§ 854 (1))";
        when tatsaechliche_gewalt_erlangt_am(b, t);
        then besitz_erworben_am(b, t);
    }
    rule BesitzerwerbDurchEinigung(b: Besitz, t: Date) strict {
        label de official "Die Einigung des bisherigen Besitzers und des Erwerbers genügt zum Erwerb, wenn der Erwerber in der Lage ist, die Gewalt über die Sache auszuüben (§ 854 Abs. 2)";
        label en unofficial "The agreement of the previous possessor and the acquirer suffices for acquisition if the acquirer is able to exercise control over the thing (§ 854 (2))";
        when einigung_ueber_den_besitzuebergang_am(b, t) and erwerber_kann_die_gewalt_ausueben(b);
        then besitz_erworben_am(b, t);
    }
    rule BesitzerIstWerDieGewaltFuerSichAusuebt(b: Besitz, s: Sache, p: Person, t: Date) strict {
        label de official "Besitzer ist, wer die tatsächliche Gewalt über die Sache für sich ausübt (§ 854 Abs. 1)";
        label en unofficial "The possessor is the person exercising physical control of the thing on their own behalf (§ 854 (1))";
        when besitz_erworben_am(b, t) and besitzlage_sache(b, s) and besitzlage_person(b, p)
            and uebt_die_gewalt_fuer_sich_aus(b);
        then besitzer(s, p);
    }
}

@source(BGB_P855)
rule NurDerWeisungsgebendeIstBesitzer(b: Besitz, s: Sache, anderer: Person, t: Date) strict {
    label de official "Übt jemand die tatsächliche Gewalt über eine Sache für einen anderen in dessen Haushalt oder Erwerbsgeschäft oder in einem ähnlichen Verhältnis aus, vermöge dessen er den sich auf die Sache beziehenden Weisungen des anderen Folge zu leisten hat, so ist nur der andere Besitzer (§ 855)";
    label en unofficial "If a person exercises control of a thing for another in that other's household or business or a similar relationship entailing compliance with their instructions, only the other is the possessor (§ 855)";
    when besitz_erworben_am(b, t) and besitzlage_sache(b, s) and weisungsgebundene_ausuebung_fuer(b, anderer);
    then besitzer(s, anderer);
}

@source(BGB_P856)
rule BeendigungDesBesitzes(b: Besitz, t: Date) defeasible {
    label de official "Der Besitz wird dadurch beendigt, dass der Besitzer die tatsächliche Gewalt über die Sache aufgibt oder in anderer Weise verliert (§ 856 Abs. 1); durch eine ihrer Natur nach vorübergehende Verhinderung in der Ausübung der Gewalt wird der Besitz nicht beendigt (Abs. 2)";
    label en unofficial "Possession ends when the possessor gives up or otherwise loses physical control (§ 856 (1)); a hindrance temporary by its nature does not end it ((2))";
    when gewalt_aufgegeben_oder_verloren_am(b, t);
    unless gewalt_aufgegeben_oder_verloren_am(b, t) and voruebergehende_verhinderung(b);
    then besitz_beendet_am(b, t);
}

@source(BGB_P857)
rule BesitzGehtAufDenErbenUeber(b: Besitz, s: Sache, erbe: Person, t: Date) strict {
    label de official "Der Besitz geht auf den Erben über (§ 857)";
    label en unofficial "Possession passes to the heir (§ 857)";
    when besitz_erworben_am(b, t) and besitzlage_sache(b, s) and erbe_des_besitzers(b, erbe);
    then besitzer(s, erbe);
}

@source(BGB_P865)
rule BesitzschutzDesTeilbesitzers(b: Besitz, s: Sache, p: Person, t: Date) strict {
    label de official "Die Vorschriften der §§ 858 bis 864 gelten auch zugunsten desjenigen, welcher nur einen Teil einer Sache, insbesondere abgesonderte Wohnräume oder andere Räume, besitzt (§ 865)";
    label en unofficial "§§ 858 to 864 also apply in favour of a person possessing only a part of a thing, in particular separate rooms (§ 865)";
    when besitz_erworben_am(b, t) and besitzlage_sache(b, s) and besitzlage_person(b, p) and teilbesitz(b);
    then besitzer(s, p);
}

@source(BGB_P868)
rule MittelbarerBesitz(b: Besitz, s: Sache, anderer: Person, t: Date) strict {
    label de official "Besitzt jemand eine Sache als Nießbraucher, Pfandgläubiger, Pächter, Mieter, Verwahrer oder in einem ähnlichen Verhältnis, vermöge dessen er einem anderen gegenüber auf Zeit zum Besitz berechtigt oder verpflichtet ist, so ist auch der andere Besitzer (mittelbarer Besitz) (§ 868)";
    label en unofficial "If a person possesses as usufructuary, pledgee, lessee, tenant, depositary or in a similar relationship, the other person is also a possessor (indirect possession) (§ 868)";
    when besitz_erworben_am(b, t) and besitzlage_sache(b, s) and besitzmittlungsverhaeltnis_zu(b, anderer);
    then mittelbarer_besitzer(s, anderer);
}

@source(BGB_P870)
rule UebertragungDesMittelbarenBesitzes(s: Sache, alt: Person, neu: Person) strict {
    label de official "Der mittelbare Besitz kann dadurch auf einen anderen übertragen werden, dass diesem der Anspruch auf Herausgabe der Sache abgetreten wird (§ 870)";
    label en unofficial "Indirect possession may be transferred by assigning the claim to return of the thing (§ 870)";
    when monotone(mittelbarer_besitzer(s, alt)) and herausgabeanspruch_abgetreten_an(s, neu);
    then mittelbarer_besitzer(s, neu);
}

@source(BGB_P871)
rule MehrstufigerMittelbarerBesitz(s: Sache, mittelbar: Person, dritter: Person) strict {
    label de official "Steht der mittelbare Besitzer zu einem Dritten in einem Verhältnis der in § 868 bezeichneten Art, so ist auch der Dritte mittelbarer Besitzer (§ 871)";
    label en unofficial "If the indirect possessor stands to a third party in a relationship of the kind described in § 868, the third party is also an indirect possessor (§ 871)";
    when monotone(mittelbarer_besitzer(s, mittelbar)) and verhaeltnis_des_mittelbaren_besitzers_zu_drittem(s, mittelbar, dritter);
    then mittelbarer_besitzer(s, dritter);
}

@source(BGB_P872)
rule Eigenbesitz(b: Besitz, s: Sache, p: Person, t: Date) strict {
    label de official "Wer eine Sache als ihm gehörend besitzt, ist Eigenbesitzer (§ 872)";
    label en unofficial "A person who possesses a thing as belonging to themselves is a proprietary possessor (§ 872)";
    when besitz_erworben_am(b, t) and besitzlage_sache(b, s) and besitzlage_person(b, p) and besitzt_als_ihm_gehoerend(b);
    then eigenbesitzer(s, p);
}

// --- Verbotene Eigenmacht und Besitzschutz (§§ 858–864, 866, 867, 869) ----------------------------

pub entity Tat {
    label de official "Tat, durch die der Besitz entzogen oder gestört wird (§ 858)";
    label en unofficial "act by which possession is taken away or disturbed (§ 858)";
}

pub relation tat_betrifft_besitz(t: Tat, b: Besitz) kind empirical {
    key(t);
    label de official "Besitzlage, der die Tat den Besitz entzieht oder die sie stört (§ 858 Abs. 1)";
    label en unofficial "possession which the act takes away or disturbs (§ 858 (1))";
}
pub relation taeter(t: Tat, p: Person) kind empirical {
    key(t);
    label de official "Täter der Entziehung oder Störung (§ 858 Abs. 1)";
    label en unofficial "person who takes away or disturbs possession (§ 858 (1))";
}
pub relation besitzentziehung(t: Tat) kind empirical {
    label de official "die Tat entzieht dem Besitzer den Besitz (§ 858 Abs. 1, § 861)";
    label en unofficial "the act deprives the possessor of possession (§ 858 (1), § 861)";
}
pub relation besitzstoerung(t: Tat) kind empirical {
    label de official "die Tat stört den Besitzer im Besitz (§ 858 Abs. 1, § 862)";
    label en unofficial "the act disturbs the possessor in possession (§ 858 (1), § 862)";
}
pub relation ohne_willen_des_besitzers(t: Tat) kind empirical {
    label de official "die Entziehung oder Störung geschieht ohne den Willen des Besitzers (§ 858 Abs. 1)";
    label en unofficial "the deprivation or disturbance occurs without the possessor's will (§ 858 (1))";
}
pub relation keine_gesetzliche_gestattung(t: Tat) kind empirical {
    label de official "das Gesetz gestattet die Entziehung oder die Störung nicht — ausdrückliche Eingabe des Falls (§ 858 Abs. 1: „sofern nicht das Gesetz … gestattet“)";
    label en unofficial "the law does not permit the deprivation or disturbance — explicit case input (§ 858 (1))";
}
pub relation veruebt_am(t: Tat, tag: Date) kind empirical {
    key(t);
    label de official "Tag der Verübung der verbotenen Eigenmacht (§ 864 Abs. 1)";
    label en unofficial "day on which the unlawful interference was committed (§ 864 (1))";
}
pub relation besitz_erlangt_durch(b: Besitz, t: Tat) kind empirical {
    label de official "der Besitz ist durch diese verbotene Eigenmacht erlangt (§ 858 Abs. 2 Satz 1)";
    label en unofficial "possession was obtained by this unlawful interference (§ 858 (2) sentence 1)";
}
pub relation besitznachfolger(neu: Besitz, vorgaenger: Besitz) kind empirical {
    label de official "Nachfolger im Besitz (§ 858 Abs. 2 Satz 2)";
    label en unofficial "successor in possession (§ 858 (2) sentence 2)";
}
pub relation erbe_des_vorgaengers_im_besitz(neu: Besitz) kind empirical {
    label de official "der Nachfolger im Besitz ist Erbe des Besitzers (§ 858 Abs. 2 Satz 2)";
    label en unofficial "the successor in possession is the heir of the possessor (§ 858 (2) sentence 2)";
}
pub relation kennt_die_fehlerhaftigkeit_bei_dem_erwerb(neu: Besitz) kind empirical {
    label de official "der Nachfolger kennt die Fehlerhaftigkeit des Besitzes seines Vorgängers bei dem Erwerb (§ 858 Abs. 2 Satz 2) — festgestellte Tatsache";
    label en unofficial "the successor knows of the defectiveness of the predecessor's possession at acquisition (§ 858 (2) sentence 2) — established fact";
}

pub relation verbotene_eigenmacht(t: Tat) kind derived {
    label de official "verbotene Eigenmacht (§ 858 Abs. 1)";
    label en unofficial "unlawful interference with possession (§ 858 (1))";
}
pub relation fehlerhafter_besitz(b: Besitz) kind derived {
    label de official "fehlerhafter Besitz (§ 858 Abs. 2)";
    label en unofficial "defective possession (§ 858 (2))";
}

@source(BGB_P858) {
    rule VerboteneEigenmachtDurchEntziehung(t: Tat) strict {
        label de official "Wer dem Besitzer ohne dessen Willen den Besitz entzieht, handelt, sofern nicht das Gesetz die Entziehung gestattet, widerrechtlich (verbotene Eigenmacht) (§ 858 Abs. 1)";
        label en unofficial "A person who deprives the possessor of possession against their will acts unlawfully unless the law permits it (§ 858 (1))";
        when besitzentziehung(t) and ohne_willen_des_besitzers(t) and keine_gesetzliche_gestattung(t);
        then verbotene_eigenmacht(t);
    }
    rule VerboteneEigenmachtDurchStoerung(t: Tat) strict {
        label de official "Wer den Besitzer ohne dessen Willen im Besitz stört, handelt, sofern nicht das Gesetz die Störung gestattet, widerrechtlich (verbotene Eigenmacht) (§ 858 Abs. 1)";
        label en unofficial "A person who disturbs the possessor against their will acts unlawfully unless the law permits it (§ 858 (1))";
        when besitzstoerung(t) and ohne_willen_des_besitzers(t) and keine_gesetzliche_gestattung(t);
        then verbotene_eigenmacht(t);
    }
    rule FehlerhafterBesitzDurchVerboteneEigenmacht(b: Besitz, t: Tat) strict {
        label de official "Der durch verbotene Eigenmacht erlangte Besitz ist fehlerhaft (§ 858 Abs. 2 Satz 1)";
        label en unofficial "Possession obtained by unlawful interference is defective (§ 858 (2) sentence 1)";
        when besitz_erlangt_durch(b, t) and verbotene_eigenmacht(t);
        then fehlerhafter_besitz(b);
    }
    rule FehlerhaftigkeitGegenDenErben(neu: Besitz, alt: Besitz) strict {
        label de official "Die Fehlerhaftigkeit muss der Nachfolger im Besitz gegen sich gelten lassen, wenn er Erbe des Besitzers ist (§ 858 Abs. 2 Satz 2)";
        label en unofficial "The successor must accept the defectiveness if they are the heir of the possessor (§ 858 (2) sentence 2)";
        when besitznachfolger(neu, alt) and monotone(fehlerhafter_besitz(alt)) and erbe_des_vorgaengers_im_besitz(neu);
        then fehlerhafter_besitz(neu);
    }
    rule FehlerhaftigkeitBeiKenntnis(neu: Besitz, alt: Besitz) strict {
        label de official "Die Fehlerhaftigkeit muss der Nachfolger im Besitz gegen sich gelten lassen, wenn er die Fehlerhaftigkeit des Besitzes seines Vorgängers bei dem Erwerb kennt (§ 858 Abs. 2 Satz 2)";
        label en unofficial "The successor must accept the defectiveness if they know of it at acquisition (§ 858 (2) sentence 2)";
        when besitznachfolger(neu, alt) and monotone(fehlerhafter_besitz(alt)) and kennt_die_fehlerhaftigkeit_bei_dem_erwerb(neu);
        then fehlerhafter_besitz(neu);
    }
}

// --- Selbsthilfe (§§ 859, 860) --------------------------------------------------------------------

pub external judgment relation sofort_nach_der_entziehung(t: Tat) {
    authority Court;
    label de official "§ 859 Abs. 3: der Besitzer hat sich des Besitzes sofort nach der Entziehung wieder bemächtigt — Wertung des Gerichts, kein Nullfristmaß";
    label en unofficial "§ 859 (3): the possessor retook possession immediately after the deprivation — evaluation by the court, not a zero period";
}
pub relation auf_frischer_tat_betroffen_oder_verfolgt(t: Tat) kind empirical {
    label de official "der Täter ist auf frischer Tat betroffen oder verfolgt (§ 859 Abs. 2) — festgestellte Tatsache";
    label en unofficial "the wrongdoer was caught in the act or pursued (§ 859 (2)) — established fact";
}
pub relation grundstueck_betroffen(t: Tat) kind empirical {
    label de official "die Tat betrifft den Besitz eines Grundstücks (§ 859 Abs. 3)";
    label en unofficial "the act concerns possession of land (§ 859 (3))";
}

pub relation selbsthilfe_abwehr_befugt(p: Person, t: Tat) kind derived {
    label de official "Befugnis, sich der verbotenen Eigenmacht mit Gewalt zu erwehren (§ 859 Abs. 1)";
    label en unofficial "power to defend oneself against unlawful interference by force (§ 859 (1))";
}
pub relation selbsthilfe_wiederabnahme_befugt(p: Person, t: Tat) kind derived {
    label de official "Befugnis, die weggenommene bewegliche Sache dem auf frischer Tat betroffenen oder verfolgten Täter mit Gewalt wieder abzunehmen (§ 859 Abs. 2)";
    label en unofficial "power to retake the movable thing by force from the wrongdoer caught in the act or pursued (§ 859 (2))";
}
pub relation selbsthilfe_entsetzung_befugt(p: Person, t: Tat) kind derived {
    label de official "Befugnis, sich des Besitzes eines Grundstücks durch Entsetzung des Täters wieder zu bemächtigen (§ 859 Abs. 3)";
    label en unofficial "power to retake possession of land by removing the wrongdoer (§ 859 (3))";
}

@source(BGB_P859) {
    rule SelbsthilfeGegenVerboteneEigenmacht(t: Tat, b: Besitz, p: Person) strict {
        label de official "Der Besitzer darf sich verbotener Eigenmacht mit Gewalt erwehren (§ 859 Abs. 1)";
        label en unofficial "The possessor may defend themselves against unlawful interference by force (§ 859 (1))";
        when verbotene_eigenmacht(t) and tat_betrifft_besitz(t, b) and besitzlage_person(b, p);
        then selbsthilfe_abwehr_befugt(p, t);
    }
    rule WiederabnahmeDerBeweglichenSache(t: Tat, b: Besitz, s: Sache, p: Person) strict {
        label de official "Wird eine bewegliche Sache dem Besitzer mittels verbotener Eigenmacht weggenommen, so darf er sie dem auf frischer Tat betroffenen oder verfolgten Täter mit Gewalt wieder abnehmen (§ 859 Abs. 2)";
        label en unofficial "If a movable thing is taken by unlawful interference, the possessor may retake it by force from the wrongdoer caught in the act or pursued (§ 859 (2))";
        when verbotene_eigenmacht(t) and besitzentziehung(t) and tat_betrifft_besitz(t, b)
            and besitzlage_sache(b, s) and bewegliche_sache(s) and besitzlage_person(b, p)
            and auf_frischer_tat_betroffen_oder_verfolgt(t);
        then selbsthilfe_wiederabnahme_befugt(p, t);
    }
    rule EntsetzungDesTaetersAufDemGrundstueck(t: Tat, b: Besitz, p: Person) strict {
        label de official "Wird dem Besitzer eines Grundstücks der Besitz durch verbotene Eigenmacht entzogen, so darf er sofort nach der Entziehung sich des Besitzes durch Entsetzung des Täters wieder bemächtigen (§ 859 Abs. 3)";
        label en unofficial "If a possessor of land is deprived of possession by unlawful interference, they may retake it immediately after the deprivation by removing the wrongdoer (§ 859 (3))";
        when verbotene_eigenmacht(t) and besitzentziehung(t) and grundstueck_betroffen(t)
            and tat_betrifft_besitz(t, b) and besitzlage_person(b, p)
            and sofort_nach_der_entziehung(t);
        then selbsthilfe_entsetzung_befugt(p, t);
    }
}

@source(BGB_P860)
rule SelbsthilfeDesBesitzdieners(t: Tat, h: Person, bd: Besitz, b: Besitz, s: Sache, diener: Person) strict {
    label de official "Zur Ausübung der dem Besitzer nach § 859 zustehenden Rechte ist auch derjenige befugt, welcher die tatsächliche Gewalt nach § 855 für den Besitzer ausübt (§ 860)";
    label en unofficial "The person exercising physical control for the possessor under § 855 is also entitled to exercise the rights under § 859 (§ 860)";
    when monotone(selbsthilfe_abwehr_befugt(h, t)) and tat_betrifft_besitz(t, b) and besitzlage_sache(b, s)
        and besitzlage_sache(bd, s) and besitzlage_person(bd, diener) and weisungsgebundene_ausuebung_fuer(bd, h);
    then selbsthilfe_abwehr_befugt(diener, t);
}

// --- Besitzschutzansprüche (§§ 861–864, 866, 869) -------------------------------------------------

pub relation besitz_des_gegners(t: Tat, b: Besitz) kind empirical {
    label de official "Besitzlage desjenigen, von dem die Wiedereinräumung oder die Beseitigung verlangt wird (§ 861 Abs. 1, § 862 Abs. 1)";
    label en unofficial "possession of the person from whom restoration or removal is demanded (§ 861 (1), § 862 (1))";
}
pub relation entzogener_besitz_fehlerhaft_gegenueber_gegner(t: Tat) kind empirical {
    label de official "der entzogene Besitz war dem gegenwärtigen Besitzer oder dessen Rechtsvorgänger gegenüber fehlerhaft (§ 861 Abs. 2, § 862 Abs. 2)";
    label en unofficial "the possession taken away was defective towards the present possessor or their predecessor (§ 861 (2), § 862 (2))";
}
pub relation entzogener_besitz_erlangt_am(t: Tat, tag: Date) kind empirical {
    key(t);
    label de official "Tag, an dem der entzogene oder gestörte Besitz erlangt worden ist (§ 861 Abs. 2, § 862 Abs. 2: „in dem letzten Jahre vor der Entziehung erlangt“)";
    label en unofficial "day on which the possession taken away or disturbed was obtained (§ 861 (2), § 862 (2))";
}
pub relation streit_um_die_grenzen_des_gebrauchs(t: Tat) kind empirical {
    label de official "der Streit betrifft die Grenzen des den einzelnen Mitbesitzern zustehenden Gebrauchs (§ 866)";
    label en unofficial "the dispute concerns the limits of the use to which each co-possessor is entitled (§ 866)";
}
pub relation recht_zum_besitz_des_gegners(t: Tat) kind empirical {
    label de official "der Entzieher oder Störer macht ein Recht zum Besitz oder zur Vornahme der störenden Handlung geltend (§ 863)";
    label en unofficial "the wrongdoer asserts a right to possession or to the disturbing act (§ 863)";
}
pub external judgment relation weitere_stoerungen_zu_besorgen(t: Tat) {
    authority Court;
    label de official "§ 862 Abs. 1 Satz 2: weitere Störungen sind zu besorgen — Wertung des Gerichts";
    label en unofficial "§ 862 (1) sentence 2: further disturbances are to be feared — evaluation by the court";
}

pub relation anspruch_auf_wiedereinraeumung(t: Tat, glaeubiger: Person, gegner: Person) kind derived {
    label de official "Anspruch auf Wiedereinräumung des Besitzes (§ 861 Abs. 1)";
    label en unofficial "claim to restoration of possession (§ 861 (1))";
}
pub relation anspruch_auf_beseitigung_der_stoerung(t: Tat, glaeubiger: Person, gegner: Person) kind derived {
    label de official "Anspruch auf Beseitigung der Störung (§ 862 Abs. 1 Satz 1)";
    label en unofficial "claim to removal of the disturbance (§ 862 (1) sentence 1)";
}
pub relation unterlassungsklage_voraussetzungen(t: Tat) kind derived {
    label de official "Voraussetzungen der Unterlassungsklage: verbotene Eigenmacht durch Störung und weitere zu besorgende Störungen (§ 862 Abs. 1 Satz 2) — strikte Brücke, die die Urteilsanfrage trägt";
    label en unofficial "conditions of the action for an injunction (§ 862 (1) sentence 2) — strict bridge carrying the judgment request";
}
pub relation anspruch_auf_unterlassung(t: Tat, glaeubiger: Person, gegner: Person) kind derived {
    label de official "Anspruch auf Unterlassung weiterer Störungen (§ 862 Abs. 1 Satz 2)";
    label en unofficial "claim for an injunction against further disturbance (§ 862 (1) sentence 2)";
}
pub relation besitzschutzanspruch_ausgeschlossen(t: Tat) kind derived {
    label de official "Ausschluss des Besitzschutzanspruchs (§ 861 Abs. 2, § 862 Abs. 2, § 866)";
    label en unofficial "exclusion of the possessory claim (§ 861 (2), § 862 (2), § 866)";
}
pub relation einwendung_nach_863_unbeachtlich(t: Tat) kind derived {
    label de official "Das Recht zum Besitz oder zur Vornahme der störenden Handlung kann nur zur Begründung der Behauptung geltend gemacht werden, dass die Entziehung oder die Störung nicht verbotene Eigenmacht sei (§ 863)";
    label en unofficial "A right to possession or to the disturbing act may be asserted only to support the contention that there was no unlawful interference (§ 863)";
}

@source(BGB_P861) {
    rule AusschlussWegenFehlerhaftenBesitzesImLetztenJahr(t: Tat, e: Date, v: Date) strict {
        label de official "Der Anspruch ist ausgeschlossen, wenn der entzogene Besitz dem gegenwärtigen Besitzer oder dessen Rechtsvorgänger gegenüber fehlerhaft war und in dem letzten Jahre vor der Entziehung erlangt worden ist (§ 861 Abs. 2) — Jahresfrist vom Tag der Besitzerlangung an (§§ 187 Abs. 1, 188 Abs. 2)";
        label en unofficial "The claim is excluded if the possession taken away was defective towards the present possessor or their predecessor and was obtained in the last year before the deprivation (§ 861 (2))";
        when entzogener_besitz_fehlerhaft_gegenueber_gegner(t) and entzogener_besitz_erlangt_am(t, e)
            and veruebt_am(t, v) and v <= add_calendar_period(e, 1 calendar_year);
        then besitzschutzanspruch_ausgeschlossen(t);
    }
    rule AnspruchWegenBesitzentziehung(t: Tat, b: Besitz, bg: Besitz, p: Person, gegner: Person) defeasible {
        label de official "Wird der Besitz durch verbotene Eigenmacht dem Besitzer entzogen, so kann dieser die Wiedereinräumung des Besitzes von demjenigen verlangen, welcher ihm gegenüber fehlerhaft besitzt (§ 861 Abs. 1)";
        label en unofficial "If possession is taken away by unlawful interference, the possessor may demand restoration from the person whose possession is defective towards them (§ 861 (1))";
        when verbotene_eigenmacht(t) and besitzentziehung(t) and tat_betrifft_besitz(t, b)
            and besitzlage_person(b, p) and besitz_des_gegners(t, bg) and fehlerhafter_besitz(bg)
            and besitzlage_person(bg, gegner);
        unless tat_betrifft_besitz(t, b) and besitzlage_person(b, p) and besitz_des_gegners(t, bg)
            and besitzlage_person(bg, gegner) and besitzschutzanspruch_ausgeschlossen(t);
        then anspruch_auf_wiedereinraeumung(t, p, gegner);
    }
}

@source(BGB_P862) {
    rule AnspruchWegenBesitzstoerung(t: Tat, b: Besitz, p: Person, gegner: Person) defeasible {
        label de official "Wird der Besitzer durch verbotene Eigenmacht im Besitz gestört, so kann er von dem Störer die Beseitigung der Störung verlangen (§ 862 Abs. 1 Satz 1)";
        label en unofficial "If the possessor is disturbed by unlawful interference, they may demand removal of the disturbance from the disturber (§ 862 (1) sentence 1)";
        when verbotene_eigenmacht(t) and besitzstoerung(t) and tat_betrifft_besitz(t, b)
            and besitzlage_person(b, p) and taeter(t, gegner);
        unless tat_betrifft_besitz(t, b) and besitzlage_person(b, p) and taeter(t, gegner)
            and besitzschutzanspruch_ausgeschlossen(t);
        then anspruch_auf_beseitigung_der_stoerung(t, p, gegner);
    }
    rule WeitereStoerungenSindZuBesorgen(t: Tat) strict {
        label de official "Sind weitere Störungen zu besorgen, so kann der Besitzer auf Unterlassung klagen (§ 862 Abs. 1 Satz 2) — die Besorgnis weiterer Störungen ist Wertung des Gerichts";
        label en unofficial "If further disturbances are to be feared, the possessor may sue for an injunction (§ 862 (1) sentence 2) — the fear of further disturbance is the court's evaluation";
        when verbotene_eigenmacht(t) and besitzstoerung(t) and weitere_stoerungen_zu_besorgen(t);
        then unterlassungsklage_voraussetzungen(t);
    }
    rule AnspruchAufUnterlassung(t: Tat, b: Besitz, p: Person, gegner: Person) defeasible {
        label de official "Sind weitere Störungen zu besorgen, so kann der Besitzer auf Unterlassung klagen (§ 862 Abs. 1 Satz 2)";
        label en unofficial "If further disturbances are to be feared, the possessor may sue for an injunction (§ 862 (1) sentence 2)";
        when unterlassungsklage_voraussetzungen(t) and tat_betrifft_besitz(t, b)
            and besitzlage_person(b, p) and taeter(t, gegner);
        unless tat_betrifft_besitz(t, b) and besitzlage_person(b, p) and taeter(t, gegner)
            and besitzschutzanspruch_ausgeschlossen(t);
        then anspruch_auf_unterlassung(t, p, gegner);
    }
    rule AusschlussWegenEigenerFehlerhaftigkeitBeiStoerung(t: Tat, e: Date, v: Date) strict {
        label de official "Der Anspruch ist ausgeschlossen, wenn der Besitzer dem Störer oder dessen Rechtsvorgänger gegenüber fehlerhaft besitzt und der Besitz in dem letzten Jahre vor der Störung erlangt worden ist (§ 862 Abs. 2)";
        label en unofficial "The claim is excluded if the possessor's possession is defective towards the disturber or their predecessor and was obtained in the last year before the disturbance (§ 862 (2))";
        when besitzstoerung(t) and entzogener_besitz_fehlerhaft_gegenueber_gegner(t)
            and entzogener_besitz_erlangt_am(t, e) and veruebt_am(t, v)
            and v <= add_calendar_period(e, 1 calendar_year);
        then besitzschutzanspruch_ausgeschlossen(t);
    }
}

@source(BGB_P863)
rule PetitorischeEinwendungUnbeachtlich(t: Tat) strict {
    label de official "Gegenüber den in den §§ 861, 862 bestimmten Ansprüchen kann ein Recht zum Besitz oder zur Vornahme der störenden Handlung nur zur Begründung der Behauptung geltend gemacht werden, dass die Entziehung oder die Störung des Besitzes nicht verbotene Eigenmacht sei (§ 863)";
    label en unofficial "Against the claims under §§ 861, 862 a right to possession or to the disturbing act may be asserted only to support the contention that there was no unlawful interference (§ 863)";
    when recht_zum_besitz_des_gegners(t) and verbotene_eigenmacht(t);
    then einwendung_nach_863_unbeachtlich(t);
}

@source(BGB_P866)
rule KeinBesitzschutzUnterMitbesitzern(t: Tat, b: Besitz, bg: Besitz, s: Sache) strict {
    label de official "Besitzen mehrere eine Sache gemeinschaftlich, so findet in ihrem Verhältnis zueinander ein Besitzschutz insoweit nicht statt, als es sich um die Grenzen des den einzelnen zustehenden Gebrauchs handelt (§ 866)";
    label en unofficial "If several persons possess a thing jointly, there is no possessory protection between them as regards the limits of each one's use (§ 866)";
    when tat_betrifft_besitz(t, b) and mitbesitz(b) and besitz_des_gegners(t, bg) and mitbesitz(bg)
        and besitzlage_sache(b, s) and besitzlage_sache(bg, s) and streit_um_die_grenzen_des_gebrauchs(t);
    then besitzschutzanspruch_ausgeschlossen(t);
}

@source(BGB_P869) {
    rule AnspruecheDesMittelbarenBesitzersBeiEntziehung(t: Tat, b: Besitz, s: Sache, m: Person, bg: Besitz, gegner: Person) defeasible {
        label de official "Wird gegen den Besitzer verbotene Eigenmacht verübt, so stehen die in den §§ 861, 862 bestimmten Ansprüche auch dem mittelbaren Besitzer zu (§ 869 Satz 1)";
        label en unofficial "If unlawful interference is committed against the possessor, the claims under §§ 861, 862 also belong to the indirect possessor (§ 869 sentence 1)";
        when verbotene_eigenmacht(t) and besitzentziehung(t) and tat_betrifft_besitz(t, b)
            and besitzlage_sache(b, s) and mittelbarer_besitzer(s, m)
            and besitz_des_gegners(t, bg) and fehlerhafter_besitz(bg) and besitzlage_person(bg, gegner);
        unless tat_betrifft_besitz(t, b) and besitzlage_sache(b, s) and mittelbarer_besitzer(s, m)
            and besitz_des_gegners(t, bg) and besitzlage_person(bg, gegner)
            and besitzschutzanspruch_ausgeschlossen(t);
        then anspruch_auf_wiedereinraeumung(t, m, gegner);
    }
    rule AnspruecheDesMittelbarenBesitzersBeiStoerung(t: Tat, b: Besitz, s: Sache, m: Person, gegner: Person) defeasible {
        label de official "Wird gegen den Besitzer verbotene Eigenmacht verübt, so stehen die in den §§ 861, 862 bestimmten Ansprüche auch dem mittelbaren Besitzer zu (§ 869 Satz 1)";
        label en unofficial "The claims under §§ 861, 862 also belong to the indirect possessor (§ 869 sentence 1)";
        when verbotene_eigenmacht(t) and besitzstoerung(t) and tat_betrifft_besitz(t, b)
            and besitzlage_sache(b, s) and mittelbarer_besitzer(s, m) and taeter(t, gegner);
        unless tat_betrifft_besitz(t, b) and besitzlage_sache(b, s) and mittelbarer_besitzer(s, m)
            and taeter(t, gegner) and besitzschutzanspruch_ausgeschlossen(t);
        then anspruch_auf_beseitigung_der_stoerung(t, m, gegner);
    }
}

// --- Verfolgungsrecht des Besitzers (§ 867) -------------------------------------------------------

pub relation sache_auf_fremdes_grundstueck_gelangt(s: Sache, g: Grundstueck) kind empirical {
    label de official "die Sache ist aus der Gewalt des Besitzers auf ein im Besitz eines anderen befindliches Grundstück gelangt (§ 867 Satz 1)";
    label en unofficial "the thing has passed out of the possessor's control onto land possessed by another (§ 867 sentence 1)";
}
pub relation inzwischen_in_besitz_genommen(s: Sache) kind empirical {
    label de official "die Sache ist inzwischen in Besitz genommen worden (§ 867 Satz 1 Halbsatz 2)";
    label en unofficial "the thing has meanwhile been taken into possession (§ 867 sentence 1)";
}
pub relation gestattungspflicht_aufsuchung(g: Grundstueck, verpflichteter: Person, berechtigter: Person, s: Sache) kind derived {
    label de official "Pflicht des Grundstücksbesitzers, dem Besitzer der Sache die Aufsuchung und die Wegschaffung zu gestatten (§ 867 Satz 1)";
    label en unofficial "duty of the possessor of the land to allow the possessor of the thing to search for and remove it (§ 867 sentence 1)";
}

@source(BGB_P867)
rule GestattungDerAufsuchungUndWegschaffung(s: Sache, g: Grundstueck, verpflichteter: Person, berechtigter: Person) defeasible {
    label de official "Ist eine Sache aus der Gewalt des Besitzers auf ein im Besitz eines anderen befindliches Grundstück gelangt, so hat ihm der Besitzer des Grundstücks die Aufsuchung und die Wegschaffung zu gestatten, sofern nicht die Sache inzwischen in Besitz genommen worden ist (§ 867 Satz 1)";
    label en unofficial "If a thing has passed onto land possessed by another, the possessor of the land must allow the search for and removal of it unless it has meanwhile been taken into possession (§ 867 sentence 1)";
    when sache_auf_fremdes_grundstueck_gelangt(s, g) and besitzer(g, verpflichteter) and besitzer(s, berechtigter);
    unless sache_auf_fremdes_grundstueck_gelangt(s, g) and besitzer(g, verpflichteter) and besitzer(s, berechtigter)
        and inzwischen_in_besitz_genommen(s);
    then gestattungspflicht_aufsuchung(g, verpflichteter, berechtigter, s);
}

// --- Erlöschen der Besitzansprüche (§ 864) --------------------------------------------------------

pub relation besitzschutzfrist(t: Tat, f: Frist) kind empirical {
    label de official "Frist des § 864 Abs. 1 für diese Tat — Bezeichnung der Frist, deren Ablauf `de.bgb.fristen` rechnet";
    label en unofficial "period of § 864 (1) for this act — handle of the period whose end `de.bgb.fristen` computes";
}
pub relation klage_erhoben_am(t: Tat, tag: Date) kind empirical {
    label de official "Tag, an dem der Anspruch im Wege der Klage geltend gemacht worden ist (§ 864 Abs. 1)";
    label en unofficial "day on which the claim was asserted by action (§ 864 (1))";
}
pub relation rechtskraeftig_festgestelltes_recht_an_der_sache(t: Tat, tag: Date) kind empirical {
    label de official "nach der Verübung der verbotenen Eigenmacht ist durch rechtskräftiges Urteil festgestellt, dass dem Täter ein Recht an der Sache zusteht, vermöge dessen er die Herstellung eines seiner Handlungsweise entsprechenden Besitzstands verlangen kann (§ 864 Abs. 2) — festgestellte Tatsache";
    label en unofficial "after the interference a final judgment established that the wrongdoer has a right to the thing entitling them to the state of possession corresponding to their conduct (§ 864 (2)) — established fact";
}
pub relation klage_vor_ablauf_erhoben(t: Tat) kind derived {
    label de official "der Anspruch ist vor dem Ablauf der Jahresfrist im Wege der Klage geltend gemacht worden (§ 864 Abs. 1)";
    label en unofficial "the claim was asserted by action before the one-year period expired (§ 864 (1))";
}
pub relation besitzanspruch_erloschen_am(t: Tat, tag: Date) kind derived {
    label de official "Tag, mit dessen Ablauf ein nach den §§ 861, 862 begründeter Anspruch erlischt (§ 864)";
    label en unofficial "day at whose end a claim under §§ 861, 862 is extinguished (§ 864)";
}

@source(BGB_P864) {
    rule ErloeschensfristEreignis(t: Tat, f: Frist, v: Date) strict {
        label de official "Ein nach den §§ 861, 862 begründeter Anspruch erlischt mit dem Ablauf eines Jahres nach der Verübung der verbotenen Eigenmacht (§ 864 Abs. 1) — Ereignis der Frist ist der Tag der Verübung (§ 187 Abs. 1)";
        label en unofficial "A claim under §§ 861, 862 expires one year after the interference (§ 864 (1)) — the event of the period is the day of the interference (§ 187 (1))";
        when besitzschutzfrist(t, f) and veruebt_am(t, v);
        then de.bgb.fristen::frist_ereignis(f, v);
    }
    rule ErloeschensfristDauer(t: Tat, f: Frist, v: Date) strict {
        label de official "Die Frist des § 864 Abs. 1 beträgt ein Jahr (§ 188 Abs. 2, Politik BGB_BESITZ_EIGENTUM_KALENDER)";
        label en unofficial "The period of § 864 (1) is one year (§ 188 (2))";
        when besitzschutzfrist(t, f) and veruebt_am(t, v);
        then de.bgb.fristen::frist_dauer_kalender(f, 1 calendar_year);
    }
    rule KlageVorAblaufDerJahresfrist(t: Tat, f: Frist, k: Date, ende: Date) strict {
        label de official "Der Anspruch erlischt nicht, wenn er vorher im Wege der Klage geltend gemacht wird (§ 864 Abs. 1)";
        label en unofficial "The claim does not expire if it is asserted by action before the end of the period (§ 864 (1))";
        when besitzschutzfrist(t, f) and klage_erhoben_am(t, k) and de.bgb.fristen::frist_ende(f, ende) and k <= ende;
        then klage_vor_ablauf_erhoben(t);
    }
    rule ErloeschenNachJahresfrist(t: Tat, f: Frist, ende: Date) defeasible {
        label de official "Ein nach den §§ 861, 862 begründeter Anspruch erlischt mit dem Ablauf eines Jahres nach der Verübung der verbotenen Eigenmacht, wenn nicht vorher der Anspruch im Wege der Klage geltend gemacht wird (§ 864 Abs. 1); § 193 verlegt das Ende auf den nächsten Werktag";
        label en unofficial "A claim under §§ 861, 862 expires one year after the interference unless asserted by action before (§ 864 (1)); § 193 moves the end to the next working day";
        when besitzschutzfrist(t, f) and de.bgb.fristen::frist_ende(f, ende);
        unless besitzschutzfrist(t, f) and de.bgb.fristen::frist_ende(f, ende) and klage_vor_ablauf_erhoben(t);
        then besitzanspruch_erloschen_am(t, ende);
    }
    rule ErloeschenDurchRechtskraeftigesUrteil(t: Tat, tag: Date) strict {
        label de official "Das Erlöschen tritt auch dann ein, wenn nach der Verübung der verbotenen Eigenmacht durch rechtskräftiges Urteil festgestellt wird, dass dem Täter ein Recht an der Sache zusteht, vermöge dessen er die Herstellung eines seiner Handlungsweise entsprechenden Besitzstands verlangen kann (§ 864 Abs. 2)";
        label en unofficial "Expiry also occurs if a final judgment establishes that the wrongdoer has a right to the thing entitling them to that state of possession (§ 864 (2))";
        when rechtskraeftig_festgestelltes_recht_an_der_sache(t, tag);
        then besitzanspruch_erloschen_am(t, tag);
    }
}
