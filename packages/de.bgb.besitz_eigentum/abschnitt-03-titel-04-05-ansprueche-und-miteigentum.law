// --- Buch 3 Abschnitt 3 Titel 4 und 5: Ansprüche aus dem Eigentum (§§ 985–1007) -------------------
// und Miteigentum (§§ 1008–1011)
//
// § 985 gibt dem Eigentümer die Herausgabe gegen den Besitzer; § 986 nimmt sie
// ihm, wenn der Besitzer ein Recht zum Besitz hat. Das Eigentümer-Besitzer-
// Verhältnis (§§ 987–1003) knüpft an ZWEI festgestellte Tatsachen an: den
// Eintritt der RECHTSHÄNGIGKEIT und die KENNTNIS des Besitzers (§ 990). Das
// Verschulden des § 989 und die Erhöhung des Wertes des § 996 sind Wertungen
// des Gerichts (§47.3).
//
// § 1002 ist eine KLAGEFRIST: der Verwendungsanspruch erlischt mit dem Ablauf
// eines Monats, bei einem Grundstück mit dem Ablauf von sechs Monaten nach der
// Herausgabe. Das Ende liest deshalb `frist_ende` mit der Verlegung des § 193
// (Ledger D-10-05); Hemmung und Ablaufhemmung nach § 1002 Abs. 2 (§§ 206, 210,
// 211) sind in diesem Schnitt nicht gerechnet (README, „Was das Paket nicht
// tut“).
//
// § 1004 Abs. 2 schließt den Beseitigungs- und Unterlassungsanspruch aus, wenn
// der Eigentümer zur Duldung verpflichtet ist: die Duldungspflichten der
// §§ 904, 906, 912 und 917 dieses Pakets speisen genau diesen Ausschluss.
//
// § 1006 ist eine widerlegliche Vermutung zugunsten des Besitzers; sie gilt
// nicht gegenüber einem früheren Besitzer, dem die Sache abhanden gekommen
// ist, es sei denn, es handelt sich um Geld oder Inhaberpapiere.

pub relation recht_zum_besitz_gegenueber_dem_eigentuemer(s: Sache, besitzer: Person) kind empirical {
    label de official "der Besitzer oder der mittelbare Besitzer, von dem er sein Recht ableitet, ist dem Eigentümer gegenüber zum Besitz berechtigt (§ 986 Abs. 1 Satz 1)";
    label en unofficial "the possessor, or the indirect possessor from whom they derive their right, is entitled to possession as against the owner (§ 986 (1) sentence 1)";
}
pub relation rechtshaengigkeit_eingetreten_am(s: Sache, besitzer: Person, tag: Date) kind empirical {
    label de official "Tag des Eintritts der Rechtshängigkeit des Herausgabeanspruchs (§ 987 Abs. 1, § 989) — festgestellte Tatsache";
    label en unofficial "day on which the claim for return became pending (§ 987 (1), § 989) — established fact";
}
pub relation nutzungen_nach_rechtshaengigkeit_gezogen(s: Sache, besitzer: Person) kind empirical {
    label de official "der Besitzer hat nach dem Eintritt der Rechtshängigkeit Nutzungen gezogen (§ 987 Abs. 1)";
    label en unofficial "the possessor has taken benefits after the claim became pending (§ 987 (1))";
}
pub relation besitzer_bei_besitzerwerb_nicht_in_gutem_glauben(s: Sache, besitzer: Person) kind empirical {
    label de official "der Besitzer war bei dem Erwerb des Besitzes nicht in gutem Glauben (§ 990 Abs. 1 Satz 1) — festgestellte Tatsache";
    label en unofficial "the possessor was not in good faith when acquiring possession (§ 990 (1) sentence 1) — established fact";
}
pub relation besitzer_erfaehrt_spaeter_vom_fehlenden_recht_am(s: Sache, besitzer: Person, tag: Date) kind empirical {
    label de official "Tag, an dem der Besitzer erfährt, dass er zum Besitz nicht berechtigt ist (§ 990 Abs. 1 Satz 2) — festgestellte Tatsache";
    label en unofficial "day on which the possessor learns that they are not entitled to possession (§ 990 (1) sentence 2) — established fact";
}
pub external judgment relation verschulden_des_besitzers(s: Sache, besitzer: Person) {
    authority Court;
    label de official "§ 989: die Verschlechterung, der Untergang oder die Unmöglichkeit der Herausgabe beruht auf dem Verschulden des Besitzers — Wertung des Gerichts";
    label en unofficial "§ 989: the deterioration, destruction or impossibility of return is due to the possessor's fault — evaluation by the court";
}
pub relation sache_verschlechtert_untergegangen_oder_nicht_herausgebbar(s: Sache) kind empirical {
    label de official "die Sache ist verschlechtert, untergegangen oder kann aus einem anderen Grunde nicht herausgegeben werden (§ 989)";
    label en unofficial "the thing has deteriorated, been destroyed or cannot be returned for another reason (§ 989)";
}
pub relation notwendige_verwendung_gemacht(s: Sache, besitzer: Person) kind empirical {
    label de official "der Besitzer hat auf die Sache notwendige Verwendungen gemacht (§ 994 Abs. 1 Satz 1)";
    label en unofficial "the possessor has made necessary outlays on the thing (§ 994 (1) sentence 1)";
}
pub relation gewoehnliche_erhaltungskosten_fuer_die_zeit_der_nutzungen(s: Sache, besitzer: Person) kind empirical {
    label de official "es handelt sich um gewöhnliche Erhaltungskosten für die Zeit, für welche dem Besitzer die Nutzungen verbleiben (§ 994 Abs. 1 Satz 2)";
    label en unofficial "the outlays are ordinary maintenance costs for the period in which the benefits remain with the possessor (§ 994 (1) sentence 2)";
}
pub relation andere_als_notwendige_verwendung_gemacht_am(s: Sache, besitzer: Person, tag: Date) kind empirical {
    label de official "Tag, an dem eine andere als notwendige Verwendung gemacht worden ist (§ 996)";
    label en unofficial "day on which an outlay other than a necessary one was made (§ 996)";
}
pub external judgment relation wert_der_sache_noch_erhoeht(s: Sache, besitzer: Person) {
    authority Court;
    label de official "§ 996: der Wert der Sache ist durch die Verwendung noch zu der Zeit erhöht, zu welcher der Eigentümer die Sache wiedererlangt — Wertung des Gerichts";
    label en unofficial "§ 996: the value of the thing is still increased by the outlay at the time the owner recovers it — evaluation by the court";
}
pub relation sache_durch_vorsaetzliche_unerlaubte_handlung_erlangt(s: Sache, besitzer: Person) kind empirical {
    label de official "der Besitzer hat die Sache durch eine vorsätzlich begangene unerlaubte Handlung erlangt (§ 1000 Satz 2) — festgestellte Tatsache";
    label en unofficial "the possessor obtained the thing by an intentional tort (§ 1000 sentence 2) — established fact";
}
pub relation eigentuemer_hat_die_sache_wiedererlangt(s: Sache) kind empirical {
    label de official "der Eigentümer hat die Sache wiedererlangt (§ 1001 Satz 1, § 1002 Abs. 1)";
    label en unofficial "the owner has recovered the thing (§ 1001 sentence 1, § 1002 (1))";
}
pub relation verwendungen_genehmigt(s: Sache) kind empirical {
    label de official "der Eigentümer hat die Verwendungen genehmigt (§ 1001 Satz 1, § 1002 Abs. 1)";
    label en unofficial "the owner has approved the outlays (§ 1001 sentence 1, § 1002 (1))";
}
pub relation herausgabe_an_den_eigentuemer_am(s: Sache, besitzer: Person, tag: Date) kind empirical {
    label de official "Tag, an dem der Besitzer die Sache dem Eigentümer herausgegeben hat (§ 1002 Abs. 1)";
    label en unofficial "day on which the possessor returned the thing to the owner (§ 1002 (1))";
}
pub relation verwendungsfrist(s: Sache, f: Frist) kind empirical {
    label de official "Frist des § 1002 für den Verwendungsanspruch an dieser Sache — Bezeichnung der Frist, deren Ablauf `de.bgb.fristen` rechnet";
    label en unofficial "period of § 1002 for the claim for outlays on this thing — handle of the period computed by `de.bgb.fristen`";
}
pub relation gerichtliche_geltendmachung_am(s: Sache, tag: Date) kind empirical {
    label de official "Tag der gerichtlichen Geltendmachung des Verwendungsanspruchs (§ 1002 Abs. 1)";
    label en unofficial "day on which the claim for outlays was asserted in court (§ 1002 (1))";
}
pub relation eigentum_in_anderer_weise_beeintraechtigt(e: Einwirkung, s: Sache, stoerer: Person) kind empirical {
    label de official "das Eigentum wird in anderer Weise als durch Entziehung oder Vorenthaltung des Besitzes beeinträchtigt (§ 1004 Abs. 1 Satz 1)";
    label en unofficial "ownership is impaired otherwise than by deprivation or withholding of possession (§ 1004 (1) sentence 1)";
}
pub external judgment relation weitere_beeintraechtigungen_zu_besorgen(e: Einwirkung) {
    authority Court;
    label de official "§ 1004 Abs. 1 Satz 2: weitere Beeinträchtigungen sind zu besorgen — Wertung des Gerichts";
    label en unofficial "§ 1004 (1) sentence 2: further impairments are to be feared — evaluation by the court";
}
pub relation frueherer_besitzer_der_sache(s: Sache, p: Person) kind empirical {
    label de official "wer eine bewegliche Sache im Besitz gehabt hat (§ 1006 Abs. 2, § 1007 Abs. 1)";
    label en unofficial "a person who has had possession of a movable (§ 1006 (2), § 1007 (1))";
}
pub relation dem_frueheren_besitzer_abhanden_gekommen(s: Sache, p: Person) kind empirical {
    label de official "die Sache ist dem früheren Besitzer gestohlen worden, verloren gegangen oder sonst abhanden gekommen (§ 1006 Abs. 1 Satz 2, § 1007 Abs. 2)";
    label en unofficial "the thing was stolen from, lost by or otherwise removed from the former possessor (§ 1006 (1) sentence 2, § 1007 (2))";
}
pub relation geld_oder_inhaberpapier(s: Sache) kind empirical {
    label de official "es handelt sich um Geld oder Inhaberpapiere (§ 1006 Abs. 1 Satz 2 Halbsatz 2, § 1007 Abs. 2 Satz 2)";
    label en unofficial "the case concerns money or bearer instruments (§ 1006 (1) sentence 2, § 1007 (2) sentence 2)";
}
pub relation besitzer_bei_besitzerwerb_boesglaeubig(s: Sache, besitzer: Person) kind empirical {
    label de official "der Besitzer war bei dem Erwerb des Besitzes nicht in gutem Glauben (§ 1007 Abs. 1) — festgestellte Tatsache";
    label en unofficial "the possessor was not in good faith when acquiring possession (§ 1007 (1)) — established fact";
}
pub relation frueherer_besitzer_hat_den_besitz_aufgegeben(s: Sache, p: Person) kind empirical {
    label de official "der frühere Besitzer hat den Besitz aufgegeben (§ 1007 Abs. 3 Satz 1)";
    label en unofficial "the former possessor gave up possession (§ 1007 (3) sentence 1)";
}

pub relation herausgabeanspruch_des_eigentuemers(s: Sache, eigentuemer: Person, besitzer: Person) kind derived {
    label de official "Der Eigentümer kann von dem Besitzer die Herausgabe der Sache verlangen (§ 985)";
    label en unofficial "The owner may demand the return of the thing from the possessor (§ 985)";
}
pub relation herausgabe_verweigerbar(s: Sache, besitzer: Person) kind derived {
    label de official "Der Besitzer kann die Herausgabe der Sache verweigern (§ 986 Abs. 1 Satz 1, § 1000 Satz 1)";
    label en unofficial "The possessor may refuse to return the thing (§ 986 (1) sentence 1, § 1000 sentence 1)";
}
pub relation nutzungsherausgabepflicht(s: Sache, besitzer: Person) kind derived {
    label de official "Der Besitzer hat dem Eigentümer die Nutzungen herauszugeben, die er nach dem Eintritt der Rechtshängigkeit zieht (§ 987 Abs. 1); dasselbe gilt für den bösgläubigen Besitzer von der Zeit des Besitzerwerbs oder der Kenntniserlangung an (§ 990 Abs. 1)";
    label en unofficial "The possessor must hand over benefits taken after the claim became pending (§ 987 (1)); the same applies to a possessor in bad faith from acquisition or knowledge (§ 990 (1))";
}
pub relation schadensersatzpflicht_des_besitzers(s: Sache, besitzer: Person) kind derived {
    label de official "Der Besitzer ist von dem Eintritt der Rechtshängigkeit an dem Eigentümer für den Schaden verantwortlich, der dadurch entsteht, dass infolge seines Verschuldens die Sache verschlechtert wird, untergeht oder aus einem anderen Grunde von ihm nicht herausgegeben werden kann (§ 989)";
    label en unofficial "From the time the claim becomes pending the possessor is liable for damage caused by their fault (§ 989)";
}
pub relation verwendungsersatzanspruch(s: Sache, besitzer: Person) kind derived {
    label de official "Der Besitzer kann für die auf die Sache gemachten notwendigen Verwendungen von dem Eigentümer Ersatz verlangen (§ 994 Abs. 1 Satz 1); für andere Verwendungen nur nach § 996";
    label en unofficial "The possessor may demand compensation for necessary outlays (§ 994 (1) sentence 1); for other outlays only under § 996";
}
pub relation verwendungsanspruch_geltend_zu_machen(s: Sache, besitzer: Person) kind derived {
    label de official "Der Besitzer kann den Anspruch auf den Ersatz der Verwendungen geltend machen, wenn der Eigentümer die Sache wiedererlangt oder die Verwendungen genehmigt (§ 1001 Satz 1)";
    label en unofficial "The possessor may assert the claim for outlays if the owner recovers the thing or approves the outlays (§ 1001 sentence 1)";
}
pub relation verwendungsanspruch_erloschen_am(s: Sache, besitzer: Person, tag: Date) kind derived {
    label de official "Tag, mit dessen Ablauf der Anspruch auf den Ersatz der Verwendungen erlischt (§ 1002 Abs. 1)";
    label en unofficial "day at whose end the claim for outlays lapses (§ 1002 (1))";
}
pub relation gerichtlich_geltend_gemacht_vor_ablauf(s: Sache) kind derived {
    label de official "die gerichtliche Geltendmachung ist vor dem Ablauf der Frist des § 1002 erfolgt";
    label en unofficial "the claim was asserted in court before the period of § 1002 expired";
}
pub relation beseitigungsanspruch(e: Einwirkung, eigentuemer: Person, stoerer: Person) kind derived {
    label de official "Anspruch auf Beseitigung der Beeinträchtigung (§ 1004 Abs. 1 Satz 1)";
    label en unofficial "claim to removal of the impairment (§ 1004 (1) sentence 1)";
}
pub relation unterlassungsanspruch(e: Einwirkung, eigentuemer: Person, stoerer: Person) kind derived {
    label de official "Anspruch auf Unterlassung weiterer Beeinträchtigungen (§ 1004 Abs. 1 Satz 2)";
    label en unofficial "claim for an injunction against further impairments (§ 1004 (1) sentence 2)";
}
pub relation zur_duldung_verpflichtet(e: Einwirkung) kind derived {
    label de official "der Eigentümer ist zur Duldung verpflichtet (§ 1004 Abs. 2, gespeist aus §§ 904, 906, 912, 917)";
    label en unofficial "the owner is obliged to tolerate (§ 1004 (2), fed by §§ 904, 906, 912, 917)";
}
pub relation eigentum_vermutet(s: Sache, p: Person) kind derived {
    label de official "Vermutung des Eigentums zugunsten des Besitzers einer beweglichen Sache (§ 1006 Abs. 1, Abs. 3)";
    label en unofficial "presumption of ownership in favour of the possessor of a movable (§ 1006 (1), (3))";
}
pub relation herausgabeanspruch_des_frueheren_besitzers(s: Sache, frueherer: Person, besitzer: Person) kind derived {
    label de official "Anspruch des früheren Besitzers auf Herausgabe (§ 1007 Abs. 1, Abs. 2)";
    label en unofficial "claim of the former possessor to the return of the thing (§ 1007 (1), (2))";
}

@source(BGB_P985)
rule HerausgabeanspruchDesEigentuemers(s: Sache, halter: Person, besitzer: Person) defeasible {
    label de official "Der Eigentümer kann von dem Besitzer die Herausgabe der Sache verlangen (§ 985)";
    label en unofficial "The owner may demand the return of the thing from the possessor (§ 985)";
    when eigentuemer(s, halter) and besitzer(s, besitzer);
    unless eigentuemer(s, halter) and besitzer(s, besitzer) and recht_zum_besitz_gegenueber_dem_eigentuemer(s, besitzer);
    then herausgabeanspruch_des_eigentuemers(s, halter, besitzer);
}

@source(BGB_P986)
rule EinwendungDesBesitzers(s: Sache, besitzer: Person) strict {
    label de official "Der Besitzer kann die Herausgabe der Sache verweigern, wenn er oder der mittelbare Besitzer, von dem er sein Recht zum Besitz ableitet, dem Eigentümer gegenüber zum Besitz berechtigt ist (§ 986 Abs. 1 Satz 1)";
    label en unofficial "The possessor may refuse return if they or the indirect possessor from whom they derive their right are entitled to possession as against the owner (§ 986 (1) sentence 1)";
    when recht_zum_besitz_gegenueber_dem_eigentuemer(s, besitzer);
    then herausgabe_verweigerbar(s, besitzer);
}

@source(BGB_P987)
rule NutzungenNachRechtshaengigkeit(s: Sache, besitzer: Person, tag: Date) strict {
    label de official "Der Besitzer hat dem Eigentümer die Nutzungen herauszugeben, die er nach dem Eintritt der Rechtshängigkeit zieht (§ 987 Abs. 1)";
    label en unofficial "The possessor must hand over to the owner the benefits taken after the claim became pending (§ 987 (1))";
    when rechtshaengigkeit_eingetreten_am(s, besitzer, tag) and nutzungen_nach_rechtshaengigkeit_gezogen(s, besitzer);
    then nutzungsherausgabepflicht(s, besitzer);
}

@source(BGB_P989)
rule SchadensersatzNachRechtshaengigkeit(s: Sache, besitzer: Person, tag: Date) strict {
    label de official "Der Besitzer ist von dem Eintritt der Rechtshängigkeit an dem Eigentümer für den Schaden verantwortlich, der dadurch entsteht, dass infolge seines Verschuldens die Sache verschlechtert wird, untergeht oder aus einem anderen Grunde von ihm nicht herausgegeben werden kann (§ 989)";
    label en unofficial "From the time the claim becomes pending the possessor is liable for damage caused by their fault (§ 989)";
    when rechtshaengigkeit_eingetreten_am(s, besitzer, tag)
        and sache_verschlechtert_untergegangen_oder_nicht_herausgebbar(s) and verschulden_des_besitzers(s, besitzer);
    then schadensersatzpflicht_des_besitzers(s, besitzer);
}

@source(BGB_P990) {
    rule HaftungDesBoesglaeubigenBesitzersAbErwerb(s: Sache, besitzer: Person) strict {
        label de official "War der Besitzer bei dem Erwerb des Besitzes nicht in gutem Glauben, so haftet er dem Eigentümer von der Zeit des Erwerbs an nach den §§ 987, 989 (§ 990 Abs. 1 Satz 1)";
        label en unofficial "If the possessor was not in good faith on acquiring possession, they are liable from that time under §§ 987, 989 (§ 990 (1) sentence 1)";
        when besitzer_bei_besitzerwerb_nicht_in_gutem_glauben(s, besitzer) and nutzungen_nach_rechtshaengigkeit_gezogen(s, besitzer);
        then nutzungsherausgabepflicht(s, besitzer);
    }
    rule HaftungAbSpaetererKenntnis(s: Sache, besitzer: Person, tag: Date) strict {
        label de official "Erfährt der Besitzer später, dass er zum Besitz nicht berechtigt ist, so haftet er in gleicher Weise von der Erlangung der Kenntnis an (§ 990 Abs. 1 Satz 2)";
        label en unofficial "If the possessor later learns that they are not entitled to possession, they are liable in the same way from that time (§ 990 (1) sentence 2)";
        when besitzer_erfaehrt_spaeter_vom_fehlenden_recht_am(s, besitzer, tag) and nutzungen_nach_rechtshaengigkeit_gezogen(s, besitzer);
        then nutzungsherausgabepflicht(s, besitzer);
    }
}

@source(BGB_P994)
rule ErsatzNotwendigerVerwendungen(s: Sache, besitzer: Person) defeasible {
    label de official "Der Besitzer kann für die auf die Sache gemachten notwendigen Verwendungen von dem Eigentümer Ersatz verlangen; die gewöhnlichen Erhaltungskosten sind ihm jedoch für die Zeit, für welche ihm die Nutzungen verbleiben, nicht zu ersetzen (§ 994 Abs. 1)";
    label en unofficial "The possessor may demand compensation for necessary outlays; ordinary maintenance costs are not compensated for the period in which the benefits remain with them (§ 994 (1))";
    when notwendige_verwendung_gemacht(s, besitzer);
    unless notwendige_verwendung_gemacht(s, besitzer) and gewoehnliche_erhaltungskosten_fuer_die_zeit_der_nutzungen(s, besitzer);
    then verwendungsersatzanspruch(s, besitzer);
}

@source(BGB_P996)
rule ErsatzNuetzlicherVerwendungen(s: Sache, besitzer: Person, verwendung: Date, rechtshaengig: Date) strict {
    label de official "Für andere als notwendige Verwendungen kann der Besitzer Ersatz nur insoweit verlangen, als sie vor dem Eintritt der Rechtshängigkeit und vor dem Beginn der in § 990 bestimmten Haftung gemacht werden und der Wert der Sache durch sie noch zu der Zeit erhöht ist, zu welcher der Eigentümer die Sache wiedererlangt (§ 996)";
    label en unofficial "For outlays other than necessary ones the possessor may demand compensation only if made before the claim became pending and before the liability under § 990 began, and if the value is still increased when the owner recovers the thing (§ 996)";
    when andere_als_notwendige_verwendung_gemacht_am(s, besitzer, verwendung)
        and rechtshaengigkeit_eingetreten_am(s, besitzer, rechtshaengig) and verwendung < rechtshaengig
        and wert_der_sache_noch_erhoeht(s, besitzer);
    then verwendungsersatzanspruch(s, besitzer);
}

@source(BGB_P1000)
rule ZurueckbehaltungsrechtDesBesitzers(s: Sache, besitzer: Person) defeasible {
    label de official "Der Besitzer kann die Herausgabe der Sache verweigern, bis er wegen der ihm zu ersetzenden Verwendungen befriedigt wird; das Zurückbehaltungsrecht steht ihm nicht zu, wenn er die Sache durch eine vorsätzlich begangene unerlaubte Handlung erlangt hat (§ 1000)";
    label en unofficial "The possessor may refuse return until compensated for the outlays; not so if they obtained the thing by an intentional tort (§ 1000)";
    when verwendungsersatzanspruch(s, besitzer);
    unless verwendungsersatzanspruch(s, besitzer) and sache_durch_vorsaetzliche_unerlaubte_handlung_erlangt(s, besitzer);
    then herausgabe_verweigerbar(s, besitzer);
}

@source(BGB_P1001) {
    rule GeltendmachungNachWiedererlangung(s: Sache, besitzer: Person) defeasible {
        label de official "Der Besitzer kann den Anspruch auf den Ersatz der Verwendungen nur geltend machen, wenn der Eigentümer die Sache wiedererlangt (§ 1001 Satz 1)";
        label en unofficial "The possessor may assert the claim for outlays only if the owner recovers the thing (§ 1001 sentence 1)";
        when verwendungsersatzanspruch(s, besitzer) and eigentuemer_hat_die_sache_wiedererlangt(s);
        then verwendungsanspruch_geltend_zu_machen(s, besitzer);
    }
    rule GeltendmachungNachGenehmigung(s: Sache, besitzer: Person) defeasible {
        label de official "Der Besitzer kann den Anspruch auf den Ersatz der Verwendungen geltend machen, wenn der Eigentümer die Verwendungen genehmigt (§ 1001 Satz 1)";
        label en unofficial "The possessor may assert the claim if the owner approves the outlays (§ 1001 sentence 1)";
        when verwendungsersatzanspruch(s, besitzer) and verwendungen_genehmigt(s);
        then verwendungsanspruch_geltend_zu_machen(s, besitzer);
    }
}

@source(BGB_P1002) {
    rule VerwendungsfristEreignis(s: Sache, besitzer: Person, f: Frist, tag: Date) strict {
        label de official "Gibt der Besitzer die Sache dem Eigentümer heraus, so erlischt der Anspruch auf den Ersatz der Verwendungen mit dem Ablauf eines Monats, bei einem Grundstück mit dem Ablauf von sechs Monaten nach der Herausgabe (§ 1002 Abs. 1) — Ereignis der Frist ist die Herausgabe (§ 187 Abs. 1)";
        label en unofficial "If the possessor returns the thing, the claim for outlays lapses one month, for land six months, after the return (§ 1002 (1)) — the event is the return (§ 187 (1))";
        when verwendungsfrist(s, f) and herausgabe_an_den_eigentuemer_am(s, besitzer, tag);
        then de.bgb.fristen::frist_ereignis(f, tag);
    }
    rule VerwendungsfristEinMonatBeiBeweglicherSache(s: Sache, besitzer: Person, f: Frist, tag: Date) strict {
        label de official "Der Anspruch erlischt mit dem Ablauf eines Monats nach der Herausgabe (§ 1002 Abs. 1) — bewegliche Sache";
        label en unofficial "The claim lapses one month after the return (§ 1002 (1)) — movable";
        when verwendungsfrist(s, f) and herausgabe_an_den_eigentuemer_am(s, besitzer, tag) and bewegliche_sache(s);
        then de.bgb.fristen::frist_dauer_kalender(f, 1 calendar_month);
    }
    rule VerwendungsfristSechsMonateBeiGrundstueck(g: Grundstueck, besitzer: Person, f: Frist, tag: Date) strict {
        label de official "Bei einem Grundstück erlischt der Anspruch mit dem Ablauf von sechs Monaten nach der Herausgabe (§ 1002 Abs. 1)";
        label en unofficial "For land the claim lapses six months after the return (§ 1002 (1))";
        when verwendungsfrist(g, f) and herausgabe_an_den_eigentuemer_am(g, besitzer, tag)
            and herausgabe_betrifft_ein_grundstueck(g);
        then de.bgb.fristen::frist_dauer_kalender(f, 6 calendar_month);
    }
    rule GerichtlicheGeltendmachungVorAblauf(s: Sache, f: Frist, k: Date, ende: Date) strict {
        label de official "Der Anspruch erlischt nicht, wenn vorher die gerichtliche Geltendmachung erfolgt (§ 1002 Abs. 1)";
        label en unofficial "The claim does not lapse if it is asserted in court before (§ 1002 (1))";
        when verwendungsfrist(s, f) and gerichtliche_geltendmachung_am(s, k) and de.bgb.fristen::frist_ende(f, ende) and k <= ende;
        then gerichtlich_geltend_gemacht_vor_ablauf(s);
    }
    rule ErloeschenDesVerwendungsanspruchs(s: Sache, besitzer: Person, f: Frist, tag: Date, ende: Date) defeasible {
        label de official "Gibt der Besitzer die Sache dem Eigentümer heraus, so erlischt der Anspruch auf den Ersatz der Verwendungen mit dem Ablauf eines Monats, bei einem Grundstück mit dem Ablauf von sechs Monaten nach der Herausgabe, wenn nicht vorher die gerichtliche Geltendmachung erfolgt oder der Eigentümer die Verwendungen genehmigt (§ 1002 Abs. 1); § 193 verlegt das Ende auf den nächsten Werktag";
        label en unofficial "The claim for outlays lapses one month (six months for land) after the return unless asserted in court before or approved by the owner (§ 1002 (1)); § 193 moves the end to the next working day";
        when verwendungsfrist(s, f) and herausgabe_an_den_eigentuemer_am(s, besitzer, tag)
            and de.bgb.fristen::frist_ende(f, ende);
        unless verwendungsfrist(s, f) and de.bgb.fristen::frist_ende(f, ende)
            and herausgabe_an_den_eigentuemer_am(s, besitzer, tag) and verwendungsanspruch_gehalten(s);
        then verwendungsanspruch_erloschen_am(s, besitzer, ende);
    }
    rule VerwendungsanspruchGehaltenDurchKlage(s: Sache) strict {
        label de official "Der Anspruch erlischt nicht, wenn vorher die gerichtliche Geltendmachung erfolgt (§ 1002 Abs. 1)";
        label en unofficial "The claim does not lapse if asserted in court before (§ 1002 (1))";
        when gerichtlich_geltend_gemacht_vor_ablauf(s);
        then verwendungsanspruch_gehalten(s);
    }
    rule VerwendungsanspruchGehaltenDurchGenehmigung(s: Sache) strict {
        label de official "Der Anspruch erlischt nicht, wenn der Eigentümer die Verwendungen genehmigt (§ 1002 Abs. 1)";
        label en unofficial "The claim does not lapse if the owner approves the outlays (§ 1002 (1))";
        when verwendungen_genehmigt(s);
        then verwendungsanspruch_gehalten(s);
    }
}

pub relation herausgabe_betrifft_ein_grundstueck(g: Grundstueck) kind empirical {
    label de official "die herausgegebene Sache ist ein Grundstück — ausdrückliche Angabe des Falls; sie scheidet die Monatsfrist von der Sechsmonatsfrist (§ 1002 Abs. 1)";
    label en unofficial "the thing returned is a plot of land — explicit case input separating the one-month from the six-month period (§ 1002 (1))";
}
pub relation verwendungsanspruch_gehalten(s: Sache) kind derived {
    label de official "der Verwendungsanspruch ist durch gerichtliche Geltendmachung oder Genehmigung gehalten (§ 1002 Abs. 1)";
    label en unofficial "the claim for outlays is preserved by judicial assertion or approval (§ 1002 (1))";
}

@source(BGB_P1004) {
    rule DuldungspflichtAusNotstand(e: Einwirkung, s: Sache, halter: Person, handelnder: Person) strict {
        label de official "Der Anspruch ist ausgeschlossen, wenn der Eigentümer zur Duldung verpflichtet ist (§ 1004 Abs. 2) — Duldungspflicht aus § 904 Satz 1";
        label en unofficial "The claim is excluded if the owner is obliged to tolerate (§ 1004 (2)) — duty under § 904 sentence 1";
        when einwirkung_auf_sache(e, s) and duldungspflicht_notstand(s, halter, handelnder);
        then zur_duldung_verpflichtet(e);
    }
    rule DuldungspflichtAusImmission(e: Einwirkung, quelle: Grundstueck, ziel: Grundstueck, halter: Person, benutzer: Person) defeasible {
        label de official "Der Anspruch ist ausgeschlossen, wenn der Eigentümer zur Duldung verpflichtet ist (§ 1004 Abs. 2) — Duldungspflicht aus § 906";
        label en unofficial "The claim is excluded if the owner is obliged to tolerate (§ 1004 (2)) — duty under § 906";
        when zufuehrung_von_einem_anderen_grundstueck(e, quelle, ziel) and duldungspflicht_immission(ziel, halter, benutzer);
        then zur_duldung_verpflichtet(e);
    }
    rule BeseitigungsanspruchDesEigentuemers(e: Einwirkung, s: Sache, halter: Person, stoerer: Person) defeasible {
        label de official "Wird das Eigentum in anderer Weise als durch Entziehung oder Vorenthaltung des Besitzes beeinträchtigt, so kann der Eigentümer von dem Störer die Beseitigung der Beeinträchtigung verlangen (§ 1004 Abs. 1 Satz 1); der Anspruch ist ausgeschlossen, wenn der Eigentümer zur Duldung verpflichtet ist (Abs. 2)";
        label en unofficial "If ownership is impaired otherwise than by deprivation of possession, the owner may demand removal from the disturber (§ 1004 (1) sentence 1); excluded if the owner must tolerate ((2))";
        when eigentum_in_anderer_weise_beeintraechtigt(e, s, stoerer) and eigentuemer(s, halter);
        unless eigentum_in_anderer_weise_beeintraechtigt(e, s, stoerer) and eigentuemer(s, halter) and zur_duldung_verpflichtet(e);
        then beseitigungsanspruch(e, halter, stoerer);
    }
    rule UnterlassungsanspruchDesEigentuemers(e: Einwirkung, s: Sache, halter: Person, stoerer: Person) defeasible {
        label de official "Sind weitere Beeinträchtigungen zu besorgen, so kann der Eigentümer auf Unterlassung klagen (§ 1004 Abs. 1 Satz 2)";
        label en unofficial "If further impairments are to be feared, the owner may sue for an injunction (§ 1004 (1) sentence 2)";
        when eigentum_in_anderer_weise_beeintraechtigt(e, s, stoerer) and eigentuemer(s, halter)
            and weitere_beeintraechtigungen_zu_besorgen(e);
        unless eigentum_in_anderer_weise_beeintraechtigt(e, s, stoerer) and eigentuemer(s, halter) and zur_duldung_verpflichtet(e);
        then unterlassungsanspruch(e, halter, stoerer);
    }
}

@source(BGB_P1006)
presumption VermutungDesEigentumsFuerDenBesitzer(s: Sache, p: Person) {
    label de official "Zugunsten des Besitzers einer beweglichen Sache wird vermutet, dass er Eigentümer der Sache sei; dies gilt jedoch nicht einem früheren Besitzer gegenüber, dem die Sache gestohlen worden, verloren gegangen oder sonst abhanden gekommen ist, es sei denn, dass es sich um Geld oder Inhaberpapiere handelt (§ 1006 Abs. 1)";
    label en unofficial "In favour of the possessor of a movable it is presumed that they are the owner; not as against a former possessor from whom the thing was stolen, lost or otherwise removed, unless it is money or bearer instruments (§ 1006 (1))";
    when besitzer(s, p) and bewegliche_sache(s);
    presume eigentum_vermutet(s, p);
    unless besitzer(s, p) and bewegliche_sache(s) and vermutung_des_1006_ausgeschlossen(s) then not eigentum_vermutet(s, p);
}

pub relation vermutung_des_1006_ausgeschlossen(s: Sache) kind derived {
    label de official "die Vermutung des § 1006 Abs. 1 Satz 1 gilt gegenüber dem früheren Besitzer nicht, dem die Sache abhanden gekommen ist (§ 1006 Abs. 1 Satz 2)";
    label en unofficial "the presumption of § 1006 (1) sentence 1 does not apply against a former possessor from whom the thing was removed (§ 1006 (1) sentence 2)";
}

@source(BGB_P1006)
rule VermutungGiltNichtGegenDenBestohlenenFrueherenBesitzer(s: Sache, frueherer: Person) defeasible {
    label de official "Die Vermutung gilt nicht einem früheren Besitzer gegenüber, dem die Sache gestohlen worden, verloren gegangen oder sonst abhanden gekommen ist, es sei denn, dass es sich um Geld oder Inhaberpapiere handelt (§ 1006 Abs. 1 Satz 2)";
    label en unofficial "The presumption does not apply against a former possessor from whom the thing was stolen, lost or otherwise removed, unless it is money or bearer instruments (§ 1006 (1) sentence 2)";
    when frueherer_besitzer_der_sache(s, frueherer) and dem_frueheren_besitzer_abhanden_gekommen(s, frueherer);
    unless frueherer_besitzer_der_sache(s, frueherer) and geld_oder_inhaberpapier(s);
    then vermutung_des_1006_ausgeschlossen(s);
}

@source(BGB_P1007) {
    rule HerausgabeGegenDenBoesglaeubigenBesitzer(s: Sache, frueherer: Person, besitzer: Person) defeasible {
        label de official "Wer eine bewegliche Sache im Besitz gehabt hat, kann von dem Besitzer die Herausgabe der Sache verlangen, wenn dieser bei dem Erwerb des Besitzes nicht in gutem Glauben war (§ 1007 Abs. 1); der Anspruch ist ausgeschlossen, wenn der frühere Besitzer den Besitz aufgegeben hat (Abs. 3 Satz 1)";
        label en unofficial "A person who has had possession of a movable may demand its return from a possessor who was not in good faith on acquiring possession (§ 1007 (1)); excluded if the former possessor gave up possession ((3) sentence 1)";
        when frueherer_besitzer_der_sache(s, frueherer) and bewegliche_sache(s) and besitzer(s, besitzer)
            and besitzer_bei_besitzerwerb_boesglaeubig(s, besitzer);
        unless frueherer_besitzer_der_sache(s, frueherer) and besitzer(s, besitzer)
            and frueherer_besitzer_hat_den_besitz_aufgegeben(s, frueherer);
        then herausgabeanspruch_des_frueheren_besitzers(s, frueherer, besitzer);
    }
    rule HerausgabeBeiAbhandenkommenAuchGegenDenGutglaeubigen(s: Sache, frueherer: Person, besitzer: Person) defeasible {
        label de official "Ist die Sache dem früheren Besitzer gestohlen worden, verloren gegangen oder sonst abhanden gekommen, so kann er die Herausgabe auch von einem gutgläubigen Besitzer verlangen; auf Geld und Inhaberpapiere findet diese Vorschrift keine Anwendung (§ 1007 Abs. 2)";
        label en unofficial "If the thing was stolen from, lost by or otherwise removed from the former possessor, they may demand its return even from a possessor in good faith; this does not apply to money and bearer instruments (§ 1007 (2))";
        when frueherer_besitzer_der_sache(s, frueherer) and bewegliche_sache(s) and besitzer(s, besitzer)
            and dem_frueheren_besitzer_abhanden_gekommen(s, frueherer);
        unless frueherer_besitzer_der_sache(s, frueherer) and besitzer(s, besitzer) and geld_oder_inhaberpapier(s);
        then herausgabeanspruch_des_frueheren_besitzers(s, frueherer, besitzer);
    }
}

// --- §§ 991–999, 1003: Besitzmittler, deliktischer und redlicher Besitzer, --------------------------
// Lasten, Wegnahmerecht, landwirtschaftliches Grundstück, Rechtsnachfolge, Befriedigungsrecht (Welle B6)
//
// § 1003 „angemessene Frist“ ist KEINE Wertung: der Besitzer selbst bestimmt
// die Frist («von ihm bestimmten angemessenen Frist») — ihr Ende ist eine
// Eingabe des Falls, kein Urteilskanal (Ledger D-10-09).

pub relation besitzmittler_leitet_recht_von(s: Sache, besitzer: Person, mittelbarer: Person) kind empirical {
    label de official "der Besitzer leitet das Recht zum Besitz von einem mittelbaren Besitzer ab (§ 991 Abs. 1)";
    label en unofficial "the possessor derives the right to possess from an indirect possessor (§ 991 (1))";
}
pub relation mittelbarer_bei_besitzerwerb_nicht_in_gutem_glauben(s: Sache, mittelbarer: Person) kind empirical {
    label de official "die Voraussetzungen des § 990 liegen auch bei dem mittelbaren Besitzer vor — er war beim Erwerb seines Besitzes nicht in gutem Glauben (§ 991 Abs. 1)";
    label en unofficial "the conditions of § 990 are also met by the indirect possessor — they were not in good faith on acquiring possession (§ 991 (1))";
}
pub relation rechtshaengigkeit_gegenueber_mittelbarem_eingetreten(s: Sache, mittelbarer: Person) kind empirical {
    label de official "dem mittelbaren Besitzer gegenüber ist die Rechtshängigkeit eingetreten (§ 991 Abs. 1)";
    label en unofficial "the claim became pending against the indirect possessor (§ 991 (1))";
}
pub relation besitzer_bei_besitzerwerb_in_gutem_glauben(s: Sache, besitzer: Person) kind empirical {
    label de official "der Besitzer war bei dem Erwerb des Besitzes in gutem Glauben — festgestellte Tatsache, das Fehlen der Angabe ist keine Verneinung (§ 991 Abs. 2)";
    label en unofficial "the possessor was in good faith on acquiring possession — established fact; its absence is not a denial (§ 991 (2))";
}
pub relation besitzer_verantwortlich_gegenueber_mittelbarem(s: Sache, besitzer: Person, mittelbarer: Person) kind empirical {
    label de official "der Besitzer ist dem mittelbaren Besitzer verantwortlich, soweit es um den in § 989 bezeichneten Schaden geht (§ 991 Abs. 2)";
    label en unofficial "the possessor is answerable to the indirect possessor for the damage described in § 989 (§ 991 (2))";
}

@source(BGB_P991) {
    rule NutzungshaftungBesitzmittlerBeiUnredlichkeit991(s: Sache, besitzer: Person, mittelbarer: Person) strict {
        label de official "Leitet der Besitzer das Recht zum Besitz von einem mittelbaren Besitzer ab, so findet § 990 in Ansehung der Nutzungen nur Anwendung, wenn die Voraussetzungen des § 990 auch bei dem mittelbaren Besitzer vorliegen (§ 991 Abs. 1)";
        label en unofficial "If the possessor derives the right to possess from an indirect possessor, § 990 applies to the benefits only if its conditions are also met by the indirect possessor (§ 991 (1))";
        when besitzmittler_leitet_recht_von(s, besitzer, mittelbarer)
            and mittelbarer_bei_besitzerwerb_nicht_in_gutem_glauben(s, mittelbarer)
            and nutzungen_nach_rechtshaengigkeit_gezogen(s, besitzer);
        then nutzungsherausgabepflicht(s, besitzer);
    }
    rule NutzungshaftungBesitzmittlerBeiRechtshaengigkeit991(s: Sache, besitzer: Person, mittelbarer: Person) strict {
        label de official "… oder diesem gegenüber die Rechtshängigkeit eingetreten ist (§ 991 Abs. 1)";
        label en unofficial "… or the claim became pending against the indirect possessor (§ 991 (1))";
        when besitzmittler_leitet_recht_von(s, besitzer, mittelbarer)
            and rechtshaengigkeit_gegenueber_mittelbarem_eingetreten(s, mittelbarer)
            and nutzungen_nach_rechtshaengigkeit_gezogen(s, besitzer);
        then nutzungsherausgabepflicht(s, besitzer);
    }
    rule SchadensersatzhaftungTrotzGutenGlaubens991(s: Sache, besitzer: Person, mittelbarer: Person) strict {
        label de official "War der Besitzer bei dem Erwerb des Besitzes in gutem Glauben, so hat er gleichwohl von dem Erwerb an den im § 989 bezeichneten Schaden dem Eigentümer gegenüber insoweit zu vertreten, als er dem mittelbaren Besitzer verantwortlich ist (§ 991 Abs. 2)";
        label en unofficial "If the possessor was in good faith on acquiring possession, they are still liable for the § 989 damage to the extent they are answerable to the indirect possessor (§ 991 (2))";
        when besitzmittler_leitet_recht_von(s, besitzer, mittelbarer) and besitzer_bei_besitzerwerb_in_gutem_glauben(s, besitzer)
            and besitzer_verantwortlich_gegenueber_mittelbarem(s, besitzer, mittelbarer)
            and sache_verschlechtert_untergegangen_oder_nicht_herausgebbar(s) and verschulden_des_besitzers(s, besitzer);
        then schadensersatzpflicht_des_besitzers(s, besitzer);
    }
}

pub relation besitz_durch_verbotene_eigenmacht_oder_straftat_verschafft(s: Sache, besitzer: Person) kind empirical {
    label de official "der Besitzer hat sich den Besitz durch verbotene Eigenmacht oder durch eine Straftat verschafft (§ 992)";
    label en unofficial "the possessor obtained possession by prohibited self-help or by a criminal offence (§ 992)";
}

@source(BGB_P992)
rule HaftungDesDeliktischenBesitzers992(s: Sache, besitzer: Person) strict {
    label de official "Hat sich der Besitzer durch verbotene Eigenmacht oder durch eine Straftat den Besitz verschafft, so haftet er dem Eigentümer nach den Vorschriften über den Schadensersatz wegen unerlaubter Handlungen (§ 992); der Umfang der Deliktshaftung selbst liegt bei `de.bgb.schuldrecht_at`/`de.bgb.bereicherung_delikt` (Brücke, Welle B6 folgend) — hier wird nur festgestellt, DASS die verschärfte Haftung statt der §§ 987–990 eingreift, unabhängig von Rechtshängigkeit und den Schranken des § 990";
    label en unofficial "If the possessor obtained possession by prohibited self-help or a criminal offence, they are liable under the tort provisions (§ 992); the extent of that tort liability belongs to `de.bgb.schuldrecht_at`/`de.bgb.bereicherung_delikt` (bridge, forthcoming) — this rule only establishes THAT the stricter regime applies instead of §§ 987–990, regardless of pendency or § 990's limits";
    when besitz_durch_verbotene_eigenmacht_oder_straftat_verschafft(s, besitzer);
    then schadensersatzpflicht_des_besitzers(s, besitzer);
}

pub relation fruechte_kein_ordnungsmaessiger_ertrag_gezogen(s: Sache, besitzer: Person) kind empirical {
    label de official "der redliche Besitzer hat gezogene Früchte erlangt, die nach den Regeln einer ordnungsmäßigen Wirtschaft nicht als Ertrag der Sache anzusehen sind (Übermaßfrüchte) — festgestellte Tatsache (§ 993 Abs. 1)";
    label en unofficial "the possessor in good faith has obtained fruits that, under the rules of proper management, are not to be regarded as the yield of the thing (excess fruits) — established fact (§ 993 (1))";
}
pub relation uebermassfruechte_herausgabepflicht(s: Sache, besitzer: Person) kind derived {
    label de official "der redliche Besitzer hat die Übermaßfrüchte nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung herauszugeben; im Übrigen ist er weder zur Herausgabe von Nutzungen noch zum Schadensersatz verpflichtet (§ 993 Abs. 1) — die Bereicherungshöhe bleibt bei `de.bgb.bereicherung_delikt` (Brücke, Welle B6 folgend)";
    label en unofficial "the possessor in good faith must surrender the excess fruits under unjust enrichment; otherwise they owe neither the benefits nor damages (§ 993 (1)) — the amount belongs to `de.bgb.bereicherung_delikt` (bridge, forthcoming)";
}

@source(BGB_P993)
rule HerausgabeVonUebermassfruechten993(s: Sache, besitzer: Person) strict {
    label de official "Liegen die in den §§ 987 bis 992 bezeichneten Voraussetzungen nicht vor, so hat der Besitzer die gezogenen Früchte, soweit sie nach den Regeln einer ordnungsmäßigen Wirtschaft nicht als Ertrag der Sache anzusehen sind, nach den Vorschriften über die Herausgabe einer ungerechtfertigten Bereicherung herauszugeben (§ 993 Abs. 1 Satz 1); die fehlende positive Feststellung eines der §§ 987–992 wird nicht unterstellt — der Fall benennt das redliche Übermaß ausdrücklich. Abs. 2 (§ 101 für die Zeit der Nutzungen) ist eine Verweisung außerhalb dieses Pakets (Grenze, `analysis/saetze.json`)";
    label en unofficial "If none of §§ 987 to 992 applies, the possessor must surrender fruits that are not proper yield under unjust enrichment (§ 993 (1) sentence 1); the case states the excess explicitly rather than the engine inferring the absence of §§ 987–992. (2) (§ 101 for the period of the benefits) is a cross-reference outside this package (boundary)";
    when fruechte_kein_ordnungsmaessiger_ertrag_gezogen(s, besitzer);
    then uebermassfruechte_herausgabepflicht(s, besitzer);
}

pub relation lastenaufwendung_gemacht(s: Sache, besitzer: Person) kind empirical {
    label de official "der Besitzer hat Aufwendungen zur Bestreitung von Lasten der Sache gemacht (§ 995 Satz 1)";
    label en unofficial "the possessor made expenses to discharge charges on the thing (§ 995 sentence 1)";
}

@source(BGB_P995)
rule LastenGehoerenZuDenNotwendigenVerwendungen995(s: Sache, besitzer: Person) strict {
    label de official "Zu den notwendigen Verwendungen im Sinne des § 994 gehören auch die Aufwendungen, die der Besitzer zur Bestreitung von Lasten der Sache macht (§ 995 Satz 1); Satz 2 (für die Zeit der Nutzungen nur außerordentliche, auf den Stammwert gelegte Lasten) teilt sich denselben Ausschluss wie § 994 Abs. 1 Satz 2 — `gewoehnliche_erhaltungskosten_fuer_die_zeit_der_nutzungen`, hier auf gewöhnliche Lasten gelesen, kein zweites Prädikat (Ledger D-10-09, Muster D-08-10 »gilt entsprechend«)";
    label en unofficial "Necessary outlays under § 994 also include expenses to discharge charges on the thing (§ 995 sentence 1); sentence 2 (only extraordinary charges tied to the capital value during the period of benefits) shares the same exclusion as § 994 (1) sentence 2 — reused, not duplicated";
    when lastenaufwendung_gemacht(s, besitzer);
    then notwendige_verwendung_gemacht(s, besitzer);
}

pub relation verbindung_als_wesentlicher_bestandteil_durch_besitzer(s: Sache, teil: Sache, besitzer: Person) kind empirical {
    label de official "der Besitzer hat mit der Sache eine andere Sache als wesentlichen Bestandteil verbunden (§ 997 Abs. 1 Satz 1)";
    label en unofficial "the possessor has connected another thing to the thing as an essential component (§ 997 (1) sentence 1)";
}
pub relation abtrennung_ohne_nutzen_fuer_den_besitzer(s: Sache, teil: Sache, besitzer: Person) kind empirical {
    label de official "die Abtrennung hat für den Besitzer keinen Nutzen — festgestellte Tatsache des Falls, wie die übrigen Bestimmungsgrößen dieses Titels (`notwendige_verwendung_gemacht`, `gewoehnliche_erhaltungskosten…`); kein Kanal §47.3 nötig, da nicht als eigenständig streitiges Gerichtsurteil, sondern als einfache Tatfrage geführt (§ 997 Abs. 2, Ledger D-10-09)";
    label en unofficial "separation has no benefit for the possessor — established case fact, treated like the other qualifying facts of this title (`notwendige_verwendung_gemacht`, `gewoehnliche_erhaltungskosten…`); no §47.3 channel needed here, run as a plain question of fact (§ 997 (2))";
}
pub relation wert_wird_dem_besitzer_ersetzt(s: Sache, teil: Sache, besitzer: Person) kind empirical {
    label de official "dem Besitzer wird mindestens der Wert ersetzt, den der Bestandteil nach der Abtrennung für ihn haben würde — Eingabe des Falls (§ 997 Abs. 2)";
    label en unofficial "the possessor is reimbursed at least the value the component would have for them after separation — case input (§ 997 (2))";
}
pub relation wegnahmerecht(s: Sache, teil: Sache, besitzer: Person) kind derived {
    label de official "Recht des Besitzers, den verbundenen wesentlichen Bestandteil abzutrennen und sich anzueignen (§ 997 Abs. 1)";
    label en unofficial "the possessor's right to separate the connected essential component and appropriate it (§ 997 (1))";
}
pub relation wegnahmerecht_ausgeschlossen(s: Sache, teil: Sache, besitzer: Person) kind derived {
    label de official "das Wegnahmerecht ist ausgeschlossen (§ 997 Abs. 2)";
    label en unofficial "the right to separate is excluded (§ 997 (2))";
}

@source(BGB_P997) {
    rule WegnahmerechtDesBesitzers997(s: Sache, teil: Sache, besitzer: Person) defeasible {
        label de official "Hat der Besitzer mit der Sache eine andere Sache als wesentlichen Bestandteil verbunden, so kann er sie abtrennen und sich aneignen (§ 997 Abs. 1 Satz 1); § 258 (Ausführungsart der Wegnahme) bleibt außerhalb dieses Pakets";
        label en unofficial "If the possessor has connected another thing to the thing as an essential component, they may separate and appropriate it (§ 997 (1) sentence 1); § 258 (manner of separation) stays outside this package";
        when verbindung_als_wesentlicher_bestandteil_durch_besitzer(s, teil, besitzer);
        unless verbindung_als_wesentlicher_bestandteil_durch_besitzer(s, teil, besitzer) and wegnahmerecht_ausgeschlossen(s, teil, besitzer);
        then wegnahmerecht(s, teil, besitzer);
    }
    rule WegnahmerechtAusgeschlossenOhneErsatzanspruch997(s: Sache, teil: Sache, besitzer: Person) strict {
        label de official "Das Recht zur Abtrennung ist ausgeschlossen, wenn der Besitzer nach § 994 Abs. 1 Satz 2 für die Verwendung Ersatz nicht verlangen kann (§ 997 Abs. 2)";
        label en unofficial "The right to separate is excluded if the possessor may not demand compensation under § 994 (1) sentence 2 (§ 997 (2))";
        when verbindung_als_wesentlicher_bestandteil_durch_besitzer(s, teil, besitzer)
            and gewoehnliche_erhaltungskosten_fuer_die_zeit_der_nutzungen(s, besitzer);
        then wegnahmerecht_ausgeschlossen(s, teil, besitzer);
    }
    rule WegnahmerechtAusgeschlossenOhneNutzen997(s: Sache, teil: Sache, besitzer: Person) strict {
        label de official "… oder die Abtrennung für ihn keinen Nutzen hat (§ 997 Abs. 2)";
        label en unofficial "… or separation has no benefit for the possessor (§ 997 (2))";
        when verbindung_als_wesentlicher_bestandteil_durch_besitzer(s, teil, besitzer)
            and abtrennung_ohne_nutzen_fuer_den_besitzer(s, teil, besitzer);
        then wegnahmerecht_ausgeschlossen(s, teil, besitzer);
    }
    rule WegnahmerechtAusgeschlossenBeiWertersatz997(s: Sache, teil: Sache, besitzer: Person) strict {
        label de official "… oder ihm mindestens der Wert ersetzt wird, den der Bestandteil nach der Abtrennung für ihn haben würde (§ 997 Abs. 2)";
        label en unofficial "… or the possessor is reimbursed at least the value the component would have after separation (§ 997 (2))";
        when verbindung_als_wesentlicher_bestandteil_durch_besitzer(s, teil, besitzer)
            and wert_wird_dem_besitzer_ersetzt(s, teil, besitzer);
        then wegnahmerecht_ausgeschlossen(s, teil, besitzer);
    }
}

pub relation landwirtschaftliches_grundstueck_herauszugeben(g: Grundstueck) kind empirical {
    label de official "ein landwirtschaftliches Grundstück ist herauszugeben (§ 998)";
    label en unofficial "an agricultural plot of land must be returned (§ 998)";
}
pub relation bestellungskosten_gemacht(g: Grundstueck, besitzer: Person, betrag: Money) kind empirical {
    key(g, besitzer);
    label de official "Kosten, die der Besitzer auf die noch nicht getrennten, jedoch nach den Regeln einer ordnungsmäßigen Wirtschaft vor dem Ende des Wirtschaftsjahrs zu trennenden Früchte verwendet hat (§ 998)";
    label en unofficial "costs the possessor spent on fruits not yet separated but due to be separated before the end of the farming year under proper management (§ 998)";
}
pub relation bestellungskosten_ordnungsmaessig_und_wert_nicht_uebersteigend(g: Grundstueck, besitzer: Person) kind empirical {
    label de official "die Kosten entsprechen einer ordnungsmäßigen Wirtschaft und übersteigen den Wert dieser Früchte nicht — Eingabe des Falls (§ 998)";
    label en unofficial "the costs correspond to proper management and do not exceed the value of those fruits — case input (§ 998)";
}
pub relation bestellungskostenersatzanspruch(g: Grundstueck, besitzer: Person, betrag: Money) kind derived {
    label de official "Anspruch des Besitzers gegen den Eigentümer auf Ersatz der Bestellungskosten (§ 998)";
    label en unofficial "the possessor's claim against the owner for the costs of cultivation (§ 998)";
}

@source(BGB_P998)
rule BestellungskostenBeiLandwirtschaftlichemGrundstueck998(g: Grundstueck, besitzer: Person, betrag: Money) strict {
    label de official "Ist ein landwirtschaftliches Grundstück herauszugeben, so hat der Eigentümer die Kosten, die der Besitzer auf die noch nicht getrennten Früchte verwendet hat, insoweit zu ersetzen, als sie einer ordnungsmäßigen Wirtschaft entsprechen und den Wert dieser Früchte nicht übersteigen (§ 998)";
    label en unofficial "If an agricultural plot must be returned, the owner must reimburse the costs the possessor spent on the not-yet-separated fruits, to the extent they correspond to proper management and do not exceed the value of those fruits (§ 998)";
    when landwirtschaftliches_grundstueck_herauszugeben(g) and bestellungskosten_gemacht(g, besitzer, betrag)
        and bestellungskosten_ordnungsmaessig_und_wert_nicht_uebersteigend(g, besitzer);
    then bestellungskostenersatzanspruch(g, besitzer, betrag);
}

pub relation rechtsnachfolge_des_besitzers(s: Sache, nachfolger: Person, vorbesitzer: Person) kind empirical {
    label de official "der Besitzer ist Rechtsnachfolger eines Vorbesitzers geworden — Eingabe des Falls (§ 999 Abs. 1)";
    label en unofficial "the possessor has become the legal successor of a previous possessor — case input (§ 999 (1))";
}
pub relation vorbesitzer_haette_verwendungsersatzanspruch(s: Sache, vorbesitzer: Person) kind empirical {
    label de official "der Vorbesitzer könnte, wenn er die Sache herauszugeben hätte, Ersatz seiner Verwendungen fordern — festgestellte Tatsache des Falls, nicht über den allgemeinen Anspruchskopf zurückgelesen (kein Zyklus über `verwendungsersatzanspruch`, LDC-E4102, Ledger D-10-09) (§ 999 Abs. 1)";
    label en unofficial "the predecessor could, if they had to return the thing, claim compensation for their outlays — established case fact, not read back through the general claim head to avoid a cycle over `verwendungsersatzanspruch` (§ 999 (1))";
}

@source(BGB_P999)
rule ErsatzVerwendungenDesRechtsvorgaengers999(s: Sache, nachfolger: Person, vorbesitzer: Person) strict {
    label de official "Der Besitzer kann für die Verwendungen eines Vorbesitzers, dessen Rechtsnachfolger er geworden ist, in demselben Umfang Ersatz verlangen, in welchem ihn der Vorbesitzer fordern könnte (§ 999 Abs. 1); die Verpflichtung des Eigentümers erstreckt sich auch auf Verwendungen vor seinem eigenen Eigentumserwerb (Abs. 2) — `verwendungsersatzanspruch(s, besitzer)` ist bereits eigentümerunabhängig formuliert (§985 ff.), Abs. 2 braucht keine eigene Regel (Ledger D-10-09)";
    label en unofficial "The possessor may claim compensation for a predecessor's outlays to the same extent the predecessor could (§ 999 (1)); the owner's duty also covers outlays made before the current owner acquired ownership ((2)) — `verwendungsersatzanspruch(s, besitzer)` is already owner-independent, (2) needs no separate rule";
    when rechtsnachfolge_des_besitzers(s, nachfolger, vorbesitzer) and vorbesitzer_haette_verwendungsersatzanspruch(s, vorbesitzer);
    then verwendungsersatzanspruch(s, nachfolger);
}

pub relation aufforderung_zur_erklaerung_mit_betrag_am(s: Sache, besitzer: Person, tag: Date, betrag: Money) kind empirical {
    label de official "der Besitzer fordert den Eigentümer unter Angabe des als Ersatz verlangten Betrags auf, sich zu erklären (§ 1003 Abs. 1 Satz 1)";
    label en unofficial "the possessor calls on the owner, stating the amount claimed, to declare themselves (§ 1003 (1) sentence 1)";
}
pub relation vom_besitzer_bestimmte_frist_abgelaufen_am(s: Sache, besitzer: Person, tag: Date) kind empirical {
    label de official "Ende der vom Besitzer selbst bestimmten Frist zur Erklärung — Eingabe des Falls, keine Wertung (§ 1003 Abs. 1 Satz 1, Ledger D-10-09)";
    label en unofficial "end of the period the possessor themselves set for the declaration — case input, no judgment (§ 1003 (1) sentence 1)";
}
pub relation genehmigung_rechtzeitig_erfolgt(s: Sache, besitzer: Person) kind empirical {
    label de official "die Genehmigung der Verwendungen ist rechtzeitig erfolgt (§ 1003 Abs. 1 Satz 2, Abs. 2)";
    label en unofficial "approval of the outlays occurred in time (§ 1003 (1) sentence 2, (2))";
}
pub relation anspruch_vor_ablauf_bestritten(s: Sache, besitzer: Person) kind empirical {
    label de official "der Eigentümer bestreitet den Anspruch vor dem Ablauf der Frist (§ 1003 Abs. 2 Satz 1)";
    label en unofficial "the owner disputes the claim before the period ends (§ 1003 (2) sentence 1)";
}
pub relation rechtskraeftige_feststellung_des_betrags_am(s: Sache, besitzer: Person, tag: Date) kind empirical {
    label de official "Tag der rechtskräftigen Feststellung des Betrags der Verwendungen (§ 1003 Abs. 2 Satz 1)";
    label en unofficial "day of the final, binding determination of the amount of the outlays (§ 1003 (2) sentence 1)";
}
pub relation zweite_aufforderungsfrist_nach_feststellung_abgelaufen_am(s: Sache, besitzer: Person, tag: Date) kind empirical {
    label de official "Ende der nach der rechtskräftigen Feststellung vom Besitzer bestimmten (erneuten) Frist zur Erklärung — Eingabe des Falls (§ 1003 Abs. 2 Satz 1)";
    label en unofficial "end of the (renewed) period the possessor set for the declaration after the final determination — case input (§ 1003 (2) sentence 1)";
}
pub relation befriedigungsrecht_aus_der_sache(s: Sache, besitzer: Person) kind derived {
    label de official "der Besitzer ist berechtigt, Befriedigung aus der Sache nach den Vorschriften über den Pfandverkauf, bei einem Grundstück nach den Vorschriften über die Zwangsvollstreckung in das unbewegliche Vermögen zu suchen (§ 1003 Abs. 1 Satz 2, Abs. 2)";
    label en unofficial "the possessor is entitled to seek satisfaction out of the thing under the rules on the sale of a pledge, or for land under the rules on compulsory execution against immovable property (§ 1003 (1) sentence 2, (2))";
}
// Dritter Anlauf (D-10-13): die frühere Fassung verteidigte Abs. 1 über einen
// gemeinsamen Ausschluss-Kopf (`befriedigungsrecht_1003abs1_ausgeschlossen`),
// der Genehmigung UND Bestreiten gleich behandelte; sobald ein Fall BEIDE
// Tatbestände zugleich belegte (Abs. 1- und Abs. 2-Fakten gemeinsam), ergab
// die Anfrage `NEITHER` statt der erwarteten Ableitung über Abs. 2 — zwei
// defeasible Produzenten desselben Kopfes ohne eigenes Prioritätsprädikat
// (§116). Lösung: phasengetrennte, positive Prämissen mit `not_known(...)`
// statt eines gemeinsamen Ausschluss-Kopfes — jede Phase prüft NUR die ihr
// eigene Voraussetzung plus die Abwesenheit der Genehmigung; Abs. 1 prüft
// zusätzlich die Abwesenheit des Bestreitens, damit beide Phasen bei
// gleichzeitig vorliegenden Fakten einander nicht kreuzen.

@source(BGB_P1003) {
    rule BefriedigungsrechtNachFristablauf1003(s: Sache, besitzer: Person, tag: Date, ende: Date, betrag: Money) defeasible {
        label de official "Nach dem Ablauf der vom Besitzer bestimmten angemessenen Frist ist der Besitzer berechtigt, Befriedigung aus der Sache zu suchen, wenn nicht die Genehmigung rechtzeitig erfolgt (§ 1003 Abs. 1); bestreitet der Eigentümer den Anspruch vor dem Ablauf, gilt stattdessen Abs. 2";
        label en unofficial "After expiry of the reasonable period the possessor set, they may seek satisfaction out of the thing unless approval occurred in time (§ 1003 (1)); if the owner disputes the claim before expiry, (2) applies instead";
        when aufforderung_zur_erklaerung_mit_betrag_am(s, besitzer, tag, betrag) and vom_besitzer_bestimmte_frist_abgelaufen_am(s, besitzer, ende)
            and not_known(genehmigung_rechtzeitig_erfolgt(s, besitzer)) and not_known(anspruch_vor_ablauf_bestritten(s, besitzer));
        then befriedigungsrecht_aus_der_sache(s, besitzer);
    }
    rule BefriedigungsrechtNachBestreitenUndFeststellung1003(s: Sache, besitzer: Person, festgestellt: Date, ende: Date) defeasible {
        label de official "Bestreitet der Eigentümer den Anspruch vor dem Ablauf der Frist, so kann sich der Besitzer aus der Sache erst dann befriedigen, wenn er nach rechtskräftiger Feststellung des Betrags den Eigentümer unter Bestimmung einer angemessenen Frist zur Erklärung aufgefordert hat und die Frist verstrichen ist; ausgeschlossen, wenn die Genehmigung rechtzeitig erfolgt (§ 1003 Abs. 2)";
        label en unofficial "If the owner disputes the claim before expiry, the possessor may only seek satisfaction after a final determination of the amount, a further call to declare, and expiry of that period; excluded if approval occurred in time (§ 1003 (2))";
        when anspruch_vor_ablauf_bestritten(s, besitzer) and rechtskraeftige_feststellung_des_betrags_am(s, besitzer, festgestellt)
            and zweite_aufforderungsfrist_nach_feststellung_abgelaufen_am(s, besitzer, ende)
            and not_known(genehmigung_rechtzeitig_erfolgt(s, besitzer));
        then befriedigungsrecht_aus_der_sache(s, besitzer);
    }
}

// --- Titel 5: Miteigentum nach Bruchteilen (§§ 1008, 1011) ----------------------------------------

pub relation anspruch_aus_dem_miteigentum(s: Sache, miteigentuemer: Person, dritter: Person) kind derived {
    label de official "Jeder Miteigentümer kann die Ansprüche aus dem Eigentum Dritten gegenüber in Ansehung der ganzen Sache geltend machen, den Anspruch auf Herausgabe jedoch nur in Gemäßheit des § 432 (§ 1011)";
    label en unofficial "Each co-owner may assert the claims arising from ownership against third parties in respect of the whole thing, but the claim for return only under § 432 (§ 1011)";
}

@source(BGB_P1008)
rule MiteigentumsquoteAlsBruch(s: Sache, p: Person, z: Integer, n: Integer) defeasible {
    label de official "Steht das Eigentum an einer Sache mehreren nach Bruchteilen zu, so gelten die Vorschriften der §§ 1009 bis 1011 (§ 1008); der Bruchteil als exakter Bruch";
    label en unofficial "Where ownership of a thing belongs to several persons in fractional shares, §§ 1009 to 1011 apply (§ 1008); the share as an exact fraction";
    when miteigentumsanteil(s, p, z, n);
    then miteigentumsquote(s, p, z / n);
}

@source(BGB_P1011)
rule AnspruecheJedesMiteigentuemers(s: Sache, p: Person, z: Integer, n: Integer, e: Einwirkung, stoerer: Person) defeasible {
    label de official "Jeder Miteigentümer kann die Ansprüche aus dem Eigentum Dritten gegenüber in Ansehung der ganzen Sache geltend machen (§ 1011)";
    label en unofficial "Each co-owner may assert the claims arising from ownership against third parties in respect of the whole thing (§ 1011)";
    when miteigentumsanteil(s, p, z, n) and eigentum_in_anderer_weise_beeintraechtigt(e, s, stoerer);
    then anspruch_aus_dem_miteigentum(s, p, stoerer);
}
