language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";
// вещное средство защиты без собственности истца — защита без права
test "urn:query:ius-privatum-04-remedium-sine-dominio" {
    given {
        context { decision_time @0161-06-01T12:00:00Z; knowledge_time @0161-06-01T12:00:00Z; legal_time @0161-06-01; timezone "UTC"; }
        assert "f0": remedium_datur(entity_ref("urn:gai:persona:aulus"), entity_ref("urn:gai:persona:numerius"), entity_ref("urn:gai:causa:1")) { origin case_input; }
        assert "f1": remedium_in_rem(entity_ref("urn:gai:persona:aulus"), entity_ref("urn:gai:persona:numerius"), entity_ref("urn:gai:causa:1")) { origin case_input; }
        assert "f2": causa_de_re(entity_ref("urn:gai:causa:1"), entity_ref("urn:gai:res:fundus")) { origin case_input; }
    }
    evaluate truth(remedium_sine_iure(entity_ref("urn:gai:persona:aulus"), entity_ref("urn:gai:persona:numerius"), entity_ref("urn:gai:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
