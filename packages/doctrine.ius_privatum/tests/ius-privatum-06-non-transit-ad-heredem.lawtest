language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";
// без перехода наследнику ничего не дано
test "urn:query:ius-privatum-06-non-transit-ad-heredem" {
    given {
        context { decision_time @0161-06-01T12:00:00Z; knowledge_time @0161-06-01T12:00:00Z; legal_time @0161-06-01; timezone "UTC"; }
        assert "f0": remedium_datur(entity_ref("urn:gai:persona:aulus"), entity_ref("urn:gai:persona:numerius"), entity_ref("urn:gai:causa:1")) { origin case_input; }
        assert "f1": heres_est(entity_ref("urn:gai:persona:heres"), entity_ref("urn:gai:persona:aulus")) { origin case_input; }
    }
    evaluate truth(ius_efficax(entity_ref("urn:gai:persona:heres"), entity_ref("urn:gai:persona:numerius"), entity_ref("urn:gai:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
