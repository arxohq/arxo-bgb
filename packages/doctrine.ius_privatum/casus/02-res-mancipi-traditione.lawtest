language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// КАЗУС 2. Тиций, квиритский собственник раба (res mancipi), продал его Сею и
// передал простой traditio, без манципации; Сей утратил владение, раб у Мевия.
// Сей требует раба у Мевия. Вопрос: защита без права — remedium_sine_iure:
// у Гая — да (actio Publiciana бонитарного собственника, IV.36), у Юстиниана,
// отменившего различие res mancipi, traditio даёт собственность — нет; прочим
// кодексам категория безразлична, traditio по купле переносит право.
// Ожидание NEITHER — сторож молчания: словарь сам по фактам казуса ничего не выводит,
// ответ даёт звено на слитом мире (раннер ius_privatum_casus, матрица casus/matrix.json).

test "urn:query:casus-02-res-mancipi-traditione" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "UTC"; }
        assert "f0": dominus_originarius(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:res:servus")) { origin case_input; }
        assert "f1": res_mancipi(entity_ref("urn:casus:res:servus")) { origin case_input; }
        assert "f2": venditio(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:res:servus")) { origin case_input; }
        assert "f3": traditio(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:res:servus")) { origin case_input; }
        assert "f4": pretium_solutum(entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:res:servus")) { origin case_input; }
        assert "f5": iusta_causa_possessionis(entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:res:servus")) { origin case_input; }
        assert "f6": possessor(entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:servus")) { origin case_input; }
        assert "f7": petitio(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:persona:maevius")) { origin case_input; }
        assert "f8": petitio_de_re(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:res:servus")) { origin case_input; }
    }
    evaluate truth(remedium_sine_iure(entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
