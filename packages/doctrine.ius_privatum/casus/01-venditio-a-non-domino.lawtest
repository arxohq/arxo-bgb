language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// КАЗУС 1. Тиций передал вещь Сею на хранение; Сей продал её Мевию, который
// уплатил цену и не знал, что Сей не собственник. Тиций требует вещь у Мевия.
// Вопрос: действенно ли право Тиция против Мевия (виндикация у добросовестного
// приобретателя, получившего вещь от того, кому собственник сам её доверил).
// Рим — да (nemo plus iuris), Code civil 2279 — нет (en fait de meubles…),
// BGB §932 — нет, ГК РК ст. 261 п. 1 — нет (вещь выбыла по воле собственника).
// Ожидание NEITHER — сторож молчания: словарь сам по фактам казуса ничего не выводит,
// ответ даёт звено на слитом мире (раннер ius_privatum_casus, матрица casus/matrix.json).

test "urn:query:casus-01-venditio-a-non-domino" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "UTC"; }
        assert "f0": dominus_originarius(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f1": res_mobilis(entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f2": res_a_domino_tradita(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f3": venditio(entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f4": traditio(entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f5": pretium_solutum(entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f6": bona_fides(entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f7": possessor(entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f8": petitio(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:maevius")) { origin case_input; }
        assert "f9": petitio_de_re(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:res:res")) { origin case_input; }
    }
    evaluate truth(ius_efficax(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
