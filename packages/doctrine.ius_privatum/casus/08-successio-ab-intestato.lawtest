language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// КАЗУС 8. Тиций умер без завещания, оставив сына Гая, состоявшего под его властью (in potestate — так казус называет сына семьи; кодексам без этой категории факт безразличен). Вопрос: Гай — наследник
// Тиция по этому праву. Гай III.1–2 (sui heredes), ГК РК ст. 1061 (первая
// очередь), Code civil 745, BGB §1924, Меджелле — наследование вне книги
// (граница).
// Ожидание NEITHER — сторож молчания: словарь сам по фактам казуса ничего не выводит,
// ответ даёт звено на слитом мире (раннер ius_privatum_casus, матрица casus/matrix.json).

test "urn:query:casus-08-successio-ab-intestato" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "UTC"; }
        assert "f0": mortuus(entity_ref("urn:casus:persona:titius")) { origin case_input; }
        assert "f1": sine_testamento(entity_ref("urn:casus:persona:titius")) { origin case_input; }
        assert "f2": filius(entity_ref("urn:casus:persona:gaius"), entity_ref("urn:casus:persona:titius")) { origin case_input; }
assert "f3": in_potestate(entity_ref("urn:casus:persona:gaius"), entity_ref("urn:casus:persona:titius")) { origin case_input; }
    }
    evaluate truth(heres_est(entity_ref("urn:casus:persona:gaius"), entity_ref("urn:casus:persona:titius")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
