language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// КАЗУС 10 (цепь возражений). Стороны позже условились, что взыскивать можно.
// Гай — replicatio возвращает иск (IV.126); где прощение долга прекратило
// обязательство, отзыв его не воскрешает — новое соглашение есть новое
// обязательство, а не это притязание.
// Ожидание NEITHER — сторож молчания: словарь сам по фактам казуса ничего не выводит,
// ответ даёт звено на слитом мире (раннер ius_privatum_casus, матрица casus/matrix.json).

test "urn:query:casus-10c-pactum-revocatum" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "UTC"; }
        assert "f0": contractus(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:causa:1")) { origin case_input; }
        assert "f1": pactum_de_non_petendo(entity_ref("urn:casus:causa:1")) { origin case_input; }
        assert "f2": pactum_de_petendo_postea(entity_ref("urn:casus:causa:1")) { origin case_input; }
        assert "f3": petitio(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seius")) { origin case_input; }
    }
    evaluate truth(ius_efficax(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
