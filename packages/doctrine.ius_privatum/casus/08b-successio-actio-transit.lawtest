language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// КАЗУС 8 (вторая половина). При жизни Тиций отдал вещь Сею на хранение; Сей не
// вернул. Наследник Гай требует. Вопрос: действенно ли право наследника —
// переходит ли иск из договора к наследнику. Гай IV.112: иски из договоров
// переходят; современные кодексы — универсальное правопреемство.
// Ожидание NEITHER — сторож молчания: словарь сам по фактам казуса ничего не выводит,
// ответ даёт звено на слитом мире (раннер ius_privatum_casus, матрица casus/matrix.json).

test "urn:query:casus-08b-successio-actio-transit" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "UTC"; }
        assert "f0": mortuus(entity_ref("urn:casus:persona:titius")) { origin case_input; }
        assert "f1": sine_testamento(entity_ref("urn:casus:persona:titius")) { origin case_input; }
        assert "f2": filius(entity_ref("urn:casus:persona:gaius"), entity_ref("urn:casus:persona:titius")) { origin case_input; }
assert "f3": in_potestate(entity_ref("urn:casus:persona:gaius"), entity_ref("urn:casus:persona:titius")) { origin case_input; }
        assert "f4": depositum(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f5": res_non_reddita(entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f6": contractus(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:causa:1")) { origin case_input; }
        assert "f7": petitio(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:persona:gaius"), entity_ref("urn:casus:persona:seius")) { origin case_input; }
    }
    evaluate truth(ius_efficax(entity_ref("urn:casus:persona:gaius"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
