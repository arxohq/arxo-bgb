language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// КАЗУС 11б. Сея обязалась по договору перед мужем Тицием; муж взыскивает.
// Вопрос: действенно ли право между супругами. Современные кодексы — да;
// у Гая книга IV прямого правила о супругах не даёт, а брак cum manu ставит жену
// in potestate — казус читается через `in_potestate` только там, где это
// фактом дела названо; здесь не названо.
// Ожидание NEITHER — сторож молчания: словарь сам по фактам казуса ничего не выводит,
// ответ даёт звено на слитом мире (раннер ius_privatum_casus, матрица casus/matrix.json).

test "urn:query:casus-11c-inter-coniuges" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "UTC"; }
        assert "f0": coniuges(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seia")) { origin case_input; }
        assert "f1": contractus(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seia"), entity_ref("urn:casus:causa:1")) { origin case_input; }
        assert "f2": petitio(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seia")) { origin case_input; }
    }
    evaluate truth(ius_efficax(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seia"), entity_ref("urn:casus:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
