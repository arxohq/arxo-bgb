language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// КАЗУС 4 (вторая половина). Те же факты; вопрос — голое ли это право. У Гая —
// да: обязательство из стипуляции стоит, средство защиты отнято эксцепцией;
// у кодексов, где заём реален, обязательства нет вовсе, и голого права нет.
// Ожидание NEITHER — сторож молчания: словарь сам по фактам казуса ничего не выводит,
// ответ даёт звено на слитом мире (раннер ius_privatum_casus, матрица casus/matrix.json).

test "urn:query:casus-04b-mutuum-non-numeratum-ius-nudum" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "UTC"; }
        assert "f0": stipulatio_de_mutuo(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:causa:1")) { origin case_input; }
        assert "f1": pecunia_non_numerata(entity_ref("urn:casus:causa:1")) { origin case_input; }
        assert "f2": petitio(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seius")) { origin case_input; }
    }
    evaluate truth(ius_nudum(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
