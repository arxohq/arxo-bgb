language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// КАЗУС 7б. Та же вещь, ноль полных лет владения — по эту сторону порога у
// всех: Тиций защищён везде. Пара к 7а: порог в один год различим.
// Ожидание NEITHER — сторож молчания: словарь сам по фактам казуса ничего не выводит,
// ответ даёт звено на слитом мире (раннер ius_privatum_casus, матрица casus/matrix.json).

test "urn:query:casus-07b-usucapio-mobilis-infra-annum" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "UTC"; }
        assert "f0": dominus_originarius(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f1": res_mobilis(entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f2": possessor(entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f3": iusta_causa_possessionis(entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f4": bona_fides(entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f5": possessio_continua_annos(entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res"), 0) { origin case_input; }
        assert "f6": petitio(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:maevius")) { origin case_input; }
        assert "f7": petitio_de_re(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:res:res")) { origin case_input; }
    }
    evaluate truth(ius_efficax(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
