language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// КАЗУС 6б. Стих, работник Тиция, причинил вред Сею при исполнении порученного.
// Сей требует с Тиция. У Гая свободный работник под властью не состоит и
// ноксального иска не даёт — против хозяина иска нет; BGB §831, Code civil 1384,
// ГК РК ст. 921 — есть.
// Ожидание NEITHER — сторож молчания: словарь сам по фактам казуса ничего не выводит,
// ответ даёт звено на слитом мире (раннер ius_privatum_casus, матрица casus/matrix.json).

test "urn:query:casus-06b-damnum-a-famulo" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "UTC"; }
        assert "f0": famulus(entity_ref("urn:casus:persona:stichus"), entity_ref("urn:casus:persona:titius")) { origin case_input; }
        assert "f1": damnum_datum(entity_ref("urn:casus:persona:stichus"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:causa:1")) { origin case_input; }
        assert "f2": petitio(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:persona:titius")) { origin case_input; }
    }
    evaluate truth(ius_efficax(entity_ref("urn:casus:persona:seius"), entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
