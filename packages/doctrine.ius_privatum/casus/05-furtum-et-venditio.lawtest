language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// КАЗУС 5. Стих похитил вещь у Тиция и продал её Мевию, который уплатил цену
// и о краже не знал. Тиций требует вещь у Мевия. Вопрос: действенно ли право
// Тиция. Здесь пять кодексов сходятся ПРОТИВ казуса 1: краденое виндицируется
// и у добросовестного (Рим — res furtiva не усукапируется; CC 2279 al. 2 —
// три года; BGB §935; ГК РК ст. 261 п. 1 — выбыла помимо воли).
// Ожидание NEITHER — сторож молчания: словарь сам по фактам казуса ничего не выводит,
// ответ даёт звено на слитом мире (раннер ius_privatum_casus, матрица casus/matrix.json).

test "urn:query:casus-05-furtum-et-venditio" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "UTC"; }
        assert "f0": dominus_originarius(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f1": res_mobilis(entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f2": furtum(entity_ref("urn:casus:persona:stichus"), entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f3": res_domino_ablata(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f4": venditio(entity_ref("urn:casus:persona:stichus"), entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f5": traditio(entity_ref("urn:casus:persona:stichus"), entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f6": pretium_solutum(entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f7": bona_fides(entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f8": possessor(entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:res:res")) { origin case_input; }
        assert "f9": petitio(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:maevius")) { origin case_input; }
        assert "f10": petitio_de_re(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:res:res")) { origin case_input; }
    }
    evaluate truth(ius_efficax(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:maevius"), entity_ref("urn:casus:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
