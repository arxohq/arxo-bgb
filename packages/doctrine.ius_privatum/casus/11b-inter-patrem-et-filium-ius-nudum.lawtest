language "law.core" version "0.1";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// КАЗУС 11а (вторая половина). Те же факты; голое ли право отца: у Гая — да
// (obligatio naturalis), у современных — нет, право действенно.
// Ожидание NEITHER — сторож молчания: словарь сам по фактам казуса ничего не выводит,
// ответ даёт звено на слитом мире (раннер ius_privatum_casus, матрица casus/matrix.json).

test "urn:query:casus-11b-inter-patrem-et-filium-ius-nudum" {
    given {
        context { decision_time @2026-01-01T12:00:00Z; knowledge_time @2026-01-01T12:00:00Z; legal_time @2026-01-01; timezone "UTC"; }
        assert "f0": in_potestate(entity_ref("urn:casus:persona:stichus"), entity_ref("urn:casus:persona:titius")) { origin case_input; }
        assert "f1": contractus(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:stichus"), entity_ref("urn:casus:causa:1")) { origin case_input; }
        assert "f2": petitio(entity_ref("urn:casus:causa:1"), entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:stichus")) { origin case_input; }
    }
    evaluate truth(ius_nudum(entity_ref("urn:casus:persona:titius"), entity_ref("urn:casus:persona:stichus"), entity_ref("urn:casus:causa:1")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
