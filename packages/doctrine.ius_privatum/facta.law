// ФАКТЫ КАЗУСОВ — входной словарь реестра §4 DECISION-0091.
//
// ЗАЧЕМ ВТОРОЙ МОДУЛЬ. Головы `package.law` — то, что КОДЕКС СООБЩАЕТ о
// положении сторон (dominium, obligatio, remedium_datur…): их пишет звено,
// читает словарь. Казус же задаётся ДО всякого кодекса — «вещь продана
// невладельцем добросовестному приобретателю», — и эти слова обязаны быть
// общими для пяти звеньев, иначе один казус придётся писать пять раз и
// сравнение сравнит пять разных дел. Здесь записаны ФАКТЫ казуса: чистые
// `kind empirical`, ни одного правила. Словарь сам по ним ничего не выводит
// (раннер `ius_privatum_casus` держит это нулевым звеном: на голом словаре
// каждый казус даёт NEITHER); выводит звено, чей мостовой модуль читает
// эти факты и переводит их в свои входы (Гай — `lis`, `causa_actionis`,
// `possidet`…), а свои выводы — в головы `package.law`.
//
// ПРАВИЛО РОСТА (DECISION-0091 §3, §9): факт заводится только под казус
// реестра `casus/`, который без него не записать, и ворота
// `check_casus_matrix` требуют, чтобы КАЖДЫЙ факт этого модуля утверждался
// хотя бы одним казусом — слово без казуса есть онтология, а не контракт.
// Факт не переименовывается и не сужается после того, как его читают два
// звена. Детали материального права (добросовестность, traditio, давность)
// стоят здесь как ФАКТЫ ДЕЛА, а не как понятия словаря: что из них следует —
// решает каждый кодекс своими нормами, и в этом весь предмет сравнения.
//
// ИМЕНА — латинские, как у голов словаря: они одинаково чужие всем пяти
// звеньям и не подсказывают ни одному из них его собственную догматику.

language "law.core" version "0.2";
package doctrine.ius_privatum version "0.1.0";
namespace "urn:doctrine:clir:ius-privatum";

// ---- тяжба ----------------------------------------------------------------------
pub relation petitio(causa: Causa, actor: Persona, reus: Persona) kind empirical { label ru-KZ unofficial "истец предъявляет к ответчику притязание — спорное отношение, о котором задаётся вопрос"; }
pub relation petitio_de_re(causa: Causa, res: Res) kind empirical { label ru-KZ unofficial "притязание направлено на вещь: истец требует её как свою либо требует её выдачи"; }
pub relation contractus(creditor: Persona, debitor: Persona, causa: Causa) kind empirical { label ru-KZ unofficial "должник обязался перед кредитором по договору, лежащему в основании притязания"; }

// ---- вещи и их судьба ---------------------------------------------------------------
pub relation res_mobilis(res: Res) kind empirical { label ru-KZ unofficial "вещь движимая"; }
pub relation res_immobilis(res: Res) kind empirical { label ru-KZ unofficial "вещь недвижимая: земля, строение"; }
pub relation res_mancipi(res: Res) kind empirical { label ru-KZ unofficial "вещь из числа res mancipi (италийская земля, рабы, вьючный скот, сельские сервитуты) — категория римского права; прочим кодексам безразлична"; }
pub relation dominus_originarius(dominus: Persona, res: Res) kind empirical { label ru-KZ unofficial "лицо было собственником вещи до событий казуса — исходная точка, от которой кодекс считает переход права"; }
pub relation possessor(possessor: Persona, res: Res) kind empirical { label ru-KZ unofficial "лицо фактически владеет вещью на день спора"; }
pub relation traditio(tradens: Persona, accipiens: Persona, res: Res) kind empirical { label ru-KZ unofficial "вещь фактически передана из рук в руки"; }
pub relation venditio(venditor: Persona, emptor: Persona, res: Res) kind empirical { label ru-KZ unofficial "продавец продал покупателю вещь (договор купли-продажи заключён)"; }
pub relation pretium_solutum(emptor: Persona, res: Res) kind empirical { label ru-KZ unofficial "покупатель уплатил цену: приобретение возмездно"; }
pub relation bona_fides(acquirens: Persona, res: Res) kind empirical { label ru-KZ unofficial "приобретатель добросовестен: не знал и не мог знать, что отчуждатель не вправе отчуждать вещь"; }
pub relation res_a_domino_tradita(dominus: Persona, accipiens: Persona, res: Res) kind empirical { label ru-KZ unofficial "собственник сам передал вещь этому лицу (на хранение, в пользование, для продажи): вещь выбыла из его владения по его воле"; }
pub relation res_domino_ablata(dominus: Persona, res: Res) kind empirical { label ru-KZ unofficial "вещь выбыла из владения собственника помимо его воли: похищена или утеряна"; }
pub relation furtum(fur: Persona, dominus: Persona, res: Res) kind empirical { label ru-KZ unofficial "лицо похитило вещь у собственника"; }
pub relation possessio_continua_annos(possessor: Persona, res: Res, anni: Integer) kind empirical { label ru-KZ unofficial "лицо непрерывно владеет вещью столько полных лет на день спора"; }
pub relation iusta_causa_possessionis(possessor: Persona, res: Res) kind empirical { label ru-KZ unofficial "владение приобретено по законному основанию (купля, дарение, наследство), а не захватом"; }

// ---- договоры ------------------------------------------------------------------------
pub relation depositum(deponens: Persona, depositarius: Persona, res: Res) kind empirical { label ru-KZ unofficial "вещь отдана на хранение"; }
pub relation res_non_reddita(depositarius: Persona, res: Res) kind empirical { label ru-KZ unofficial "хранитель вещь по требованию не вернул"; }
pub relation stipulatio_de_mutuo(creditor: Persona, debitor: Persona, causa: Causa) kind empirical { label ru-KZ unofficial "заём оформлен обещанием (стипуляцией, распиской, договором) вернуть сумму"; }
pub relation pecunia_non_numerata(causa: Causa) kind empirical { label ru-KZ unofficial "деньги по займу фактически не переданы (не отсчитаны)"; }
pub relation pactum_de_non_petendo(causa: Causa) kind empirical { label ru-KZ unofficial "кредитор неформально условился с должником не взыскивать"; }
pub relation pactum_de_petendo_postea(causa: Causa) kind empirical { label ru-KZ unofficial "стороны позже условились, что взыскивать можно: прежнее соглашение о невзыскании отозвано"; }

// ---- вред --------------------------------------------------------------------------------
pub relation damnum_datum(auctor: Persona, laesus: Persona, causa: Causa) kind empirical { label ru-KZ unofficial "лицо причинило потерпевшему вред противоправным действием"; }
pub relation in_potestate(subiectus: Persona, pater: Persona) kind empirical { label ru-KZ unofficial "лицо состоит под властью домовладыки (сын, раб) — категория римского права"; }
pub relation famulus(famulus: Persona, dominus: Persona) kind empirical { label ru-KZ unofficial "лицо — работник, слуга, служащий другого лица и действовало при исполнении порученного"; }
pub relation animal_domini(animal: Res, dominus: Persona) kind empirical { label ru-KZ unofficial "животное принадлежит этому лицу"; }
pub relation damnum_ab_animali(animal: Res, laesus: Persona, causa: Causa) kind empirical { label ru-KZ unofficial "животное причинило потерпевшему вред"; }

// ---- лица и семья ------------------------------------------------------------------------
pub relation mortuus(persona: Persona) kind empirical { label ru-KZ unofficial "лицо умерло"; }
pub relation sine_testamento(persona: Persona) kind empirical { label ru-KZ unofficial "лицо умерло без завещания"; }
pub relation filius(filius: Persona, parens: Persona) kind empirical { label ru-KZ unofficial "лицо — сын или дочь другого лица"; }
pub relation coniuges(maritus: Persona, uxor: Persona) kind empirical { label ru-KZ unofficial "лица состоят в браке"; }

// ---- время и прежняя тяжба -----------------------------------------------------------
pub relation actio_nata_ante_annos(causa: Causa, anni: Integer) kind empirical { label ru-KZ unofficial "притязание возникло (право на иск открылось) столько полных лет назад на день спора; срок дан длительностью, а не датой, чтобы один казус читался на любую дату права звена"; }
pub relation res_iudicata_de_eadem_re(causa: Causa) kind empirical { label ru-KZ unofficial "о том же притязании между теми же сторонами уже вынесено решение суда"; }
