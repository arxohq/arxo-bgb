language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

pub relation position_trigger_1183(h: Grundpfandrecht, eigentuemer: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Zustimmung des Eigentümers (§ 1183)"; }
pub relation aufhebung_1183_unwirksam(h: Grundpfandrecht) kind empirical { label de official "Die Aufhebung der Hypothek ist ohne Zustimmung des Eigentümers unwirksam (§ 1183)"; }
pub relation position_trigger_1189(h: Grundpfandrecht, eigentuemer: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Verfügung über die Hypothek (§ 1189)"; }
pub relation verfuegung_1189_ausuebbar(h: Grundpfandrecht, eigentuemer: Person) kind empirical { label de official "Der Eigentümer darf die Verfügung verlangen (§ 1189)"; }
pub relation position_trigger_1201(h: Grundpfandrecht, glaeubiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Ablösung (§ 1201)"; }
pub relation abloesung_1201_ausuebbar(h: Grundpfandrecht, glaeubiger: Person) kind empirical { label de official "Der Gläubiger darf die Ablösung verlangen (§ 1201)"; }
pub relation position_trigger_1219(pf: Pfandrecht, verpfaender: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Hinterlegung des Erlöses (§ 1219)"; }
pub relation hinterlegung_1219_geschuldet(pf: Pfandrecht, verpfaender: Person) kind empirical { label de official "Der Erlös ist auf Verlangen des Verpfänders zu hinterlegen (§ 1219)"; }
pub relation position_trigger_1233(pf: Pfandrecht, glaeubiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum Verkauf des Pfandes (§ 1233)"; }
pub relation verkauf_1233_geschuldet(pf: Pfandrecht, glaeubiger: Person) kind empirical { label de official "Der Verkauf des Pfandes ist nach den gesetzlichen Vorschriften zu bewirken (§ 1233)"; }
pub relation position_trigger_1235(pf: Pfandrecht, glaeubiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur öffentlichen Versteigerung (§ 1235)"; }
pub relation versteigerung_1235_geschuldet(pf: Pfandrecht, glaeubiger: Person) kind empirical { label de official "Der Verkauf des Pfandes ist öffentlich zu versteigern (§ 1235)"; }
pub relation position_trigger_1237(pf: Pfandrecht, eigentuemer: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur öffentlichen Bekanntmachung (§ 1237)"; }
pub relation bekanntmachung_1237_geschuldet(pf: Pfandrecht, eigentuemer: Person) kind empirical { label de official "Die Versteigerung ist öffentlich bekannt zu machen (§ 1237)"; }
pub relation position_trigger_1238(pf: Pfandrecht, glaeubiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur gesetzlichen Zahlungsbedingung (§ 1238)"; }
pub relation verkaufsbedingung_1238_geschuldet(pf: Pfandrecht, glaeubiger: Person) kind empirical { label de official "Der Verkauf muss die gesetzliche Zahlungsbedingung enthalten (§ 1238)"; }
pub relation position_trigger_1239(pf: Pfandrecht, eigentuemer: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum Gebot des Eigentümers (§ 1239)"; }
pub relation gebot_1239_ausuebbar(pf: Pfandrecht, eigentuemer: Person) kind empirical { label de official "Das Gebot des Eigentümers darf zurückgewiesen werden (§ 1239)"; }
pub relation position_trigger_1240(pf: Pfandrecht, glaeubiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum Mindestpreis (§ 1240)"; }
pub relation mindestpreis_1240_unzulaessig(pf: Pfandrecht) kind empirical { label de official "Das Pfand darf nicht unter dem Metallwert zugeschlagen werden (§ 1240)"; }
pub relation violation_mindestpreis_1240(pf: Pfandrecht) kind derived { label de official "Das Pfand wurde unter dem Metallwert zugeschlagen und verstößt gegen § 1240"; }
pub relation maintenance_mindestpreis_1240(pf: Pfandrecht) kind derived { label de official "Der Pfandgläubiger muss den Mindestpreis nach § 1240 einhalten"; }
pub relation position_trigger_1255(pf: Pfandrecht, dritter: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Zustimmung des Dritten (§ 1255)"; }
pub relation aufhebung_1255_unwirksam(pf: Pfandrecht) kind empirical { label de official "Die Aufhebung des belasteten Pfandrechts ist ohne Zustimmung unwirksam (§ 1255)"; }
pub relation position_trigger_1276(r: Recht, pfandglaeubiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Zustimmung des Pfandgläubigers (§ 1276)"; }
pub relation aufhebung_1276_unwirksam(r: Recht) kind empirical { label de official "Die Aufhebung des verpfändeten Rechts ist ohne Zustimmung unwirksam (§ 1276)"; }
pub relation position_trigger_1278(r: Recht, pfandglaeubiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Rückgabe der Sache (§ 1278)"; }
pub relation rueckgabe_1278_geschuldet(r: Recht, pfandglaeubiger: Person) kind empirical { label de official "Die Rückgabe der Sache lässt die Rechtsfolge des Pfandrechts eintreten (§ 1278)"; }
pub relation position_trigger_1281(r: Recht, schuldner: Person, glaeubiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur gemeinschaftlichen Leistung (§ 1281)"; }
pub relation gemeinschaftliche_leistung_1281_geschuldet(r: Recht, schuldner: Person, glaeubiger: Person) kind empirical { label de official "Die Leistung hat gemeinschaftlich an Pfandgläubiger und Gläubiger zu erfolgen (§ 1281)"; }

@source(BGB_P1183)
rule PositionZustimmung1183(h: Grundpfandrecht, eigentuemer: Person, tag: Date) strict { label de official "Die Aufhebung der Hypothek bedarf der Zustimmung des Eigentümers (§ 1183)"; label en unofficial "Cancellation of the mortgage requires the owner's consent (§ 1183)"; when position_trigger_1183(h, eigentuemer, tag); then immunity Zustimmung1183 { holder eigentuemer; against h; protected_effect aufhebung_1183_unwirksam(h); window [tag, infinity); }; }
@source(BGB_P1189)
rule PositionVerfuegung1189(h: Grundpfandrecht, eigentuemer: Person, tag: Date) strict { label de official "Der Eigentümer darf die Verfügung verlangen (§ 1189)"; label en unofficial "The owner may demand the disposition (§ 1189)"; when position_trigger_1189(h, eigentuemer, tag); then power Verfuegung1189 { holder eigentuemer; over h; exercise verfuegung_1189_ausuebbar(h, eigentuemer); valid_when verfuegung_1189_ausuebbar(h, eigentuemer); effect create(verfuegung_1189_ausuebbar(h, eigentuemer)); window [tag, infinity); }; }
@source(BGB_P1201)
rule PositionAbloesung1201(h: Grundpfandrecht, glaeubiger: Person, tag: Date) strict { label de official "Der Gläubiger darf die Ablösung verlangen (§ 1201)"; label en unofficial "The creditor may demand redemption (§ 1201)"; when position_trigger_1201(h, glaeubiger, tag); then power Abloesung1201 { holder glaeubiger; over h; exercise abloesung_1201_ausuebbar(h, glaeubiger); valid_when abloesung_1201_ausuebbar(h, glaeubiger); effect create(abloesung_1201_ausuebbar(h, glaeubiger)); window [tag, infinity); }; }
@source(BGB_P1219)
rule PositionHinterlegung1219(pf: Pfandrecht, verpfaender: Person, tag: Date) strict { label de official "Der Erlös ist auf Verlangen des Verpfänders zu hinterlegen (§ 1219)"; label en unofficial "The proceeds must be deposited at the pledgor's request (§ 1219)"; when position_trigger_1219(pf, verpfaender, tag); then duty Hinterlegung1219 { bearer verpfaender; achieve hinterlegung_1219_geschuldet(pf, verpfaender) during [tag, infinity); }; }
@source(BGB_P1233)
rule PositionVerkauf1233(pf: Pfandrecht, glaeubiger: Person, tag: Date) strict { label de official "Der Verkauf des Pfandes ist nach den gesetzlichen Vorschriften zu bewirken (§ 1233)"; label en unofficial "The pledge must be sold according to the statutory rules (§ 1233)"; when position_trigger_1233(pf, glaeubiger, tag); then duty Verkauf1233 { bearer glaeubiger; achieve verkauf_1233_geschuldet(pf, glaeubiger) during [tag, infinity); }; }
@source(BGB_P1235)
rule PositionVersteigerung1235(pf: Pfandrecht, glaeubiger: Person, tag: Date) strict { label de official "Der Verkauf des Pfandes ist öffentlich zu versteigern (§ 1235)"; label en unofficial "The pledge must be sold by public auction (§ 1235)"; when position_trigger_1235(pf, glaeubiger, tag); then duty Versteigerung1235 { bearer glaeubiger; achieve versteigerung_1235_geschuldet(pf, glaeubiger) during [tag, infinity); }; }
@source(BGB_P1237)
rule PositionBekanntmachung1237(pf: Pfandrecht, eigentuemer: Person, tag: Date) strict { label de official "Die Versteigerung ist öffentlich bekannt zu machen (§ 1237)"; label en unofficial "The auction must be publicly announced (§ 1237)"; when position_trigger_1237(pf, eigentuemer, tag); then duty Bekanntmachung1237 { bearer eigentuemer; achieve bekanntmachung_1237_geschuldet(pf, eigentuemer) during [tag, infinity); }; }
@source(BGB_P1238)
rule PositionVerkaufsbedingung1238(pf: Pfandrecht, glaeubiger: Person, tag: Date) strict { label de official "Der Verkauf muss die gesetzliche Zahlungsbedingung enthalten (§ 1238)"; label en unofficial "The sale must contain the statutory payment condition (§ 1238)"; when position_trigger_1238(pf, glaeubiger, tag); then duty Verkaufsbedingung1238 { bearer glaeubiger; achieve verkaufsbedingung_1238_geschuldet(pf, glaeubiger) during [tag, infinity); }; }
@source(BGB_P1239)
rule PositionGebot1239(pf: Pfandrecht, eigentuemer: Person, tag: Date) strict { label de official "Das Gebot des Eigentümers darf zurückgewiesen werden (§ 1239)"; label en unofficial "The owner's bid may be rejected (§ 1239)"; when position_trigger_1239(pf, eigentuemer, tag); then power Gebot1239 { holder eigentuemer; over pf; exercise gebot_1239_ausuebbar(pf, eigentuemer); valid_when gebot_1239_ausuebbar(pf, eigentuemer); effect create(gebot_1239_ausuebbar(pf, eigentuemer)); window [tag, infinity); }; }
@source(BGB_P1240)
rule PositionMindestpreis1240(pf: Pfandrecht, glaeubiger: Person, tag: Date) strict { label de official "Das Pfand darf nicht unter dem Metallwert zugeschlagen werden (§ 1240)"; label en unofficial "The pledge may not be awarded below the metal value (§ 1240)"; when position_trigger_1240(pf, glaeubiger, tag); then prohibition Mindestpreis1240 { bearer glaeubiger; action mindestpreis_1240_unzulaessig(pf); window [tag, infinity); }; }
@source(BGB_P1240)
rule ViolationMindestpreis1240(pf: Pfandrecht) strict {
    label de official "Das Pfand wurde unter dem Metallwert zugeschlagen und verstößt gegen § 1240";
    label en unofficial "The pledge was awarded below the metal value in violation of § 1240";
    when mindestpreis_1240_unzulaessig(pf);
    then violation_mindestpreis_1240(pf);
}
@source(BGB_P1240)
rule MaintenanceMindestpreis1240(pf: Pfandrecht, glaeubiger: Person, tag: Date) strict {
    label de official "Der Pfandgläubiger muss den Mindestpreis nach § 1240 einhalten";
    label en unofficial "The pledgee must maintain the minimum price required by § 1240";
    when position_trigger_1240(pf, glaeubiger, tag);
    then duty MaintenanceMindestpreis1240Duty {
        bearer glaeubiger;
        goal maintenance {
            condition not violation_mindestpreis_1240(pf);
            window [tag, infinity);
        }
    };
}
@source(BGB_P1255)
rule PositionZustimmung1255(pf: Pfandrecht, dritter: Person, tag: Date) strict { label de official "Die Aufhebung des belasteten Pfandrechts bedarf der Zustimmung des Dritten (§ 1255)"; label en unofficial "Cancellation of the encumbered pledge requires the third party's consent (§ 1255)"; when position_trigger_1255(pf, dritter, tag); then immunity Zustimmung1255 { holder dritter; against pf; protected_effect aufhebung_1255_unwirksam(pf); window [tag, infinity); }; }
@source(BGB_P1276)
rule PositionZustimmung1276(r: Recht, pfandglaeubiger: Person, tag: Date) strict { label de official "Die Aufhebung des verpfändeten Rechts bedarf der Zustimmung des Pfandgläubigers (§ 1276)"; label en unofficial "Cancellation of the pledged right requires the pledgee's consent (§ 1276)"; when position_trigger_1276(r, pfandglaeubiger, tag); then immunity Zustimmung1276 { holder pfandglaeubiger; against r; protected_effect aufhebung_1276_unwirksam(r); window [tag, infinity); }; }
@source(BGB_P1278)
rule PositionRueckgabe1278(r: Recht, pfandglaeubiger: Person, tag: Date) strict { label de official "Die Rückgabe der Sache lässt die Verweisung des Pfandrechts eintreten (§ 1278)"; label en unofficial "Return of the thing triggers the pledge's extinction rule (§ 1278)"; when position_trigger_1278(r, pfandglaeubiger, tag); then duty Rueckgabe1278 { bearer pfandglaeubiger; achieve rueckgabe_1278_geschuldet(r, pfandglaeubiger) during [tag, infinity); }; }
@source(BGB_P1281)
rule PositionGemeinschaftlicheLeistung1281(r: Recht, schuldner: Person, glaeubiger: Person, tag: Date) strict { label de official "Die Leistung hat gemeinschaftlich an Pfandgläubiger und Gläubiger zu erfolgen (§ 1281)"; label en unofficial "Performance must be made jointly to pledgee and creditor (§ 1281)"; when position_trigger_1281(r, schuldner, glaeubiger, tag); then duty GemeinschaftlicheLeistung1281 { bearer schuldner; beneficiary glaeubiger; achieve gemeinschaftliche_leistung_1281_geschuldet(r, schuldner, glaeubiger) during [tag, infinity); }; }
