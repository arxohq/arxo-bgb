// --- Buch 3 Abschnitt 7 Titel 1: öffentlicher Glaube, Nebenleistungen und
//     Papierhypotheken (§§ 1138–1140, 1150, 1158, 1159, 1188, 1189) -----------------------------
//
// § 1138 erstreckt die §§ 891 bis 899 des Nachbarpakets auf die Forderung und
// die Einreden; dieses Paket schreibt die Vorschriften nicht ab, es stellt die
// Erstreckung fest und liest den öffentlichen Glauben dort, wo er gilt.
//
// KALENDERVIERTELJAHR (§ 1145 Abs. 2, § 1158). Das Ende des Kalendervierteljahrs
// ist eine KALENDERTATSACHE, die der Fall trägt; das Ende des FOLGENDEN
// Vierteljahrs rechnet die Regel daraus mit dem Monatsschritt (§ 188 Abs. 3).

pub relation kalendervierteljahr_endet_am(h: Grundpfandrecht, tag: Date) kind empirical {
    key(h);
    label de official "letzter Tag des Kalendervierteljahrs, in welchem der Eigentümer von der Übertragung Kenntnis erlangt oder der Gläubiger befriedigt wird (§ 1145 Abs. 2 Satz 1, § 1158 Satz 1) — Kalendertatsache des Falls";
    label en unofficial "last day of the calendar quarter in which the owner learns of the assignment or the creditor is satisfied (§ 1145 (2) sentence 1, § 1158 sentence 1) — calendar fact of the case";
}
pub relation nebenleistung_faellig_am(h: Grundpfandrecht, tag: Date) kind empirical {
    key(h);
    label de official "Tag, an dem die Zinsen oder anderen Nebenleistungen fällig werden (§ 1145 Abs. 2, § 1158 Satz 1)";
    label en unofficial "day on which the interest or other ancillary payments fall due (§ 1145 (2), § 1158 sentence 1)";
}
pub relation forderung_auf_rueckstaende_gerichtet(h: Grundpfandrecht) kind empirical {
    label de official "die Forderung ist auf Rückstände von Zinsen oder anderen Nebenleistungen gerichtet (§ 1159 Abs. 1 Satz 1)";
    label en unofficial "the claim is directed at arrears of interest or other ancillary payments (§ 1159 (1) sentence 1)";
}
pub relation unrichtigkeit_geht_aus_dem_brief_hervor(h: Grundpfandrecht) kind empirical {
    label de official "die Unrichtigkeit des Grundbuchs geht aus dem Hypothekenbrief oder einem Vermerk auf dem Brief hervor (§ 1140 Satz 1)";
    label en unofficial "the incorrectness of the register is apparent from the certificate or a note on it (§ 1140 sentence 1)";
}
pub relation widerspruch_geht_aus_dem_brief_hervor(h: Grundpfandrecht) kind empirical {
    label de official "ein Widerspruch gegen die Richtigkeit des Grundbuchs geht aus dem Brief oder einem Vermerk auf dem Brief hervor (§ 1140 Satz 2)";
    label en unofficial "an objection to the correctness of the register is apparent from the certificate or a note on it (§ 1140 sentence 2)";
}
pub relation darlehen_nicht_hingegeben(h: Grundpfandrecht) kind empirical {
    label de official "die Hingabe des Darlehens, für das die Buchhypothek bestellt ist, ist unterblieben (§ 1139 Satz 1)";
    label en unofficial "the loan for which the register mortgage was created has not been paid out (§ 1139 sentence 1)";
}
pub relation hypothek_eingetragen_am(h: Grundpfandrecht, tag: Date) kind empirical {
    key(h);
    label de official "Tag der Eintragung der Hypothek in das Grundbuch (§ 1139 Satz 1)";
    label en unofficial "day on which the mortgage was registered (§ 1139 sentence 1)";
}
pub relation widerspruchsfrist_des_1139(h: Grundpfandrecht, f: Frist) kind empirical {
    key(h);
    label de official "Monatsfrist des § 1139 Satz 1, innerhalb deren der Eigentümer den Antrag auf Eintragung des Widerspruchs zu stellen hat";
    label en unofficial "one-month period of § 1139 sentence 1 within which the owner must file the application for registration of the objection";
}
pub relation antrag_auf_widerspruch_gestellt_am(h: Grundpfandrecht, tag: Date) kind empirical {
    key(h);
    label de official "Tag, an dem der Eigentümer den Antrag auf Eintragung des Widerspruchs an das Grundbuchamt gerichtet hat (§ 1139 Satz 1)";
    label en unofficial "day on which the owner filed the application for registration of the objection (§ 1139 sentence 1)";
}
pub relation widerspruch_innerhalb_des_monats_eingetragen(h: Grundpfandrecht) kind empirical {
    label de official "der Widerspruch ist innerhalb des Monats eingetragen worden (§ 1139 Satz 2)";
    label en unofficial "the objection was registered within the month (§ 1139 sentence 2)";
}
pub relation glaeubiger_verlangt_befriedigung_aus_dem_grundstueck(h: Grundpfandrecht) kind empirical {
    label de official "der Gläubiger verlangt Befriedigung aus dem Grundstück (§ 1150)";
    label en unofficial "the creditor demands satisfaction out of the land (§ 1150)";
}
pub relation abloesungsberechtigter_dritter(h: Grundpfandrecht, dritter: Person) kind empirical {
    label de official "Dritter, der nach § 268 zur Ablösung berechtigt ist (§ 1150)";
    label en unofficial "third party entitled to redeem under § 268 (§ 1150)";
}
pub relation vorlegungsfrist_des_801_verstrichen(h: Grundpfandrecht) kind empirical {
    label de official "die in § 801 bezeichnete Vorlegungsfrist ist verstrichen (§ 1188 Abs. 2 Satz 1)";
    label en unofficial "the period for presentation named in § 801 has expired (§ 1188 (2) sentence 1)";
}
pub relation schuldverschreibung_innerhalb_der_frist_vorgelegt(h: Grundpfandrecht) kind empirical {
    label de official "die Schuldverschreibung ist innerhalb der Frist vorgelegt oder der Anspruch aus der Urkunde gerichtlich geltend gemacht worden (§ 1188 Abs. 2 Satz 2)";
    label en unofficial "the bond was presented within the period or the claim under it was asserted in court (§ 1188 (2) sentence 2)";
}
pub relation verjaehrung_der_papierforderung_eingetreten(h: Grundpfandrecht) kind empirical {
    label de official "die Verjährung des Anspruchs aus der Urkunde ist eingetreten (§ 1188 Abs. 2 Satz 2)";
    label en unofficial "the claim under the instrument has become time-barred (§ 1188 (2) sentence 2)";
}
pub relation erklaerung_des_eigentuemers_ueber_die_bestellung(h: Grundpfandrecht) kind empirical {
    label de official "Erklärung des Eigentümers gegenüber dem Grundbuchamt, dass er die Hypothek bestelle (§ 1188 Abs. 1)";
    label en unofficial "declaration of the owner to the registry that they create the mortgage (§ 1188 (1))";
}
pub relation grundbuchvertreter_eingetragen(h: Grundpfandrecht, vertreter: Person) kind empirical {
    label de official "für den jeweiligen Gläubiger ist ein Vertreter im Grundbuch eingetragen (§ 1189 Abs. 1)";
    label en unofficial "a representative for the respective creditor is registered (§ 1189 (1))";
}
pub relation eigentuemer_kann_die_verfuegung_verlangen(h: Grundpfandrecht) kind empirical {
    label de official "der Eigentümer ist berechtigt, von dem Gläubiger eine Verfügung zu verlangen, zu welcher der Vertreter befugt ist (§ 1189 Abs. 2)";
    label en unofficial "the owner is entitled to demand from the creditor a disposition which the representative is empowered to make (§ 1189 (2))";
}

pub relation oeffentlicher_glaube_erstreckt_sich_auf_forderung_und_einreden(h: Grundpfandrecht) kind derived {
    label de official "die Vorschriften der §§ 891 bis 899 gelten für die Hypothek auch in Ansehung der Forderung und der dem Eigentümer nach § 1137 zustehenden Einreden (§ 1138)";
    label en unofficial "§§ 891 to 899 apply to the mortgage also as regards the claim and the owner's defences under § 1137 (§ 1138)";
}
pub relation berufung_auf_892_und_893_ausgeschlossen(h: Grundpfandrecht) kind derived {
    label de official "soweit die Unrichtigkeit des Grundbuchs aus dem Hypothekenbrief oder einem Vermerk hervorgeht, ist die Berufung auf die §§ 892, 893 ausgeschlossen (§ 1140 Satz 1)";
    label en unofficial "in so far as the incorrectness is apparent from the certificate or a note, reliance on §§ 892, 893 is excluded (§ 1140 sentence 1)";
}
pub relation briefvermerk_steht_eingetragenem_widerspruch_gleich(h: Grundpfandrecht) kind derived {
    label de official "ein aus dem Brief hervorgehender Widerspruch steht einem im Grundbuch eingetragenen Widerspruch gleich (§ 1140 Satz 2)";
    label en unofficial "an objection apparent from the certificate is equivalent to one registered in the land register (§ 1140 sentence 2)";
}
pub relation antrag_genuegt_fuer_die_eintragung_des_widerspruchs(h: Grundpfandrecht) kind derived {
    label de official "zur Eintragung des Widerspruchs genügt der vor dem Ablauf eines Monats nach der Eintragung der Hypothek gestellte Antrag des Eigentümers (§ 1139 Satz 1)";
    label en unofficial "the owner's application filed within one month of registration of the mortgage suffices for registration of the objection (§ 1139 sentence 1)";
}
pub relation widerspruch_wirkt_wie_gleichzeitig_eingetragen(h: Grundpfandrecht) kind derived {
    label de official "wird der Widerspruch innerhalb des Monats eingetragen, so hat die Eintragung die gleiche Wirkung, wie wenn der Widerspruch zugleich mit der Hypothek eingetragen worden wäre (§ 1139 Satz 2)";
    label en unofficial "if the objection is registered within the month, it has the same effect as if registered together with the mortgage (§ 1139 sentence 2)";
}
pub relation abloesungsrecht_des_dritten(h: Grundpfandrecht, dritter: Person) kind derived {
    label de official "verlangt der Gläubiger Befriedigung aus dem Grundstück, so finden die Vorschriften der §§ 268, 1144, 1145 entsprechende Anwendung (§ 1150)";
    label en unofficial "where the creditor demands satisfaction out of the land, §§ 268, 1144, 1145 apply accordingly (§ 1150)";
}
pub relation vorschriften_406_bis_408_anwendbar(h: Grundpfandrecht) kind derived {
    label de official "auf das Rechtsverhältnis zwischen dem Eigentümer und dem neuen Gläubiger finden die §§ 406 bis 408 Anwendung; der Gläubiger kann sich insoweit nicht auf § 892 berufen (§ 1158)";
    label en unofficial "§§ 406 to 408 apply to the relationship between owner and new creditor; the creditor may not rely on § 892 in that respect (§ 1158)";
}
pub relation uebertragung_nach_allgemeinen_vorschriften(h: Grundpfandrecht) kind derived {
    label de official "für Rückstände von Zinsen und anderen Nebenleistungen bestimmt sich die Übertragung nach den allgemeinen Vorschriften; § 892 findet auf sie keine Anwendung (§ 1159)";
    label en unofficial "for arrears of interest and other ancillary payments the assignment follows the general rules; § 892 does not apply to them (§ 1159)";
}
pub relation hypothek_fuer_inhaberschuldverschreibung_bestellt(h: Grundpfandrecht) kind derived {
    label de official "zur Bestellung einer Hypothek für die Forderung aus einer Schuldverschreibung auf den Inhaber genügt die Erklärung des Eigentümers gegenüber dem Grundbuchamt und die Eintragung (§ 1188 Abs. 1)";
    label en unofficial "to create a mortgage for a claim under a bearer bond the owner's declaration to the registry and registration suffice (§ 1188 (1))";
}
pub relation ausschliessung_nach_1170_zulaessig(h: Grundpfandrecht) kind derived {
    label de official "die Ausschließung des Gläubigers mit seinem Recht nach § 1170 ist bei der Inhaberschuldverschreibung nur zulässig, wenn die Vorlegungsfrist des § 801 verstrichen ist; ist die Urkunde innerhalb der Frist vorgelegt worden, erst mit der Verjährung (§ 1188 Abs. 2)";
    label en unofficial "exclusion under § 1170 is admissible for a bearer bond only once the period of § 801 has expired; if the instrument was presented within it, only upon limitation (§ 1188 (2))";
}
pub relation vertreter_kann_verfuegen_und_vertreten(h: Grundpfandrecht, vertreter: Person) kind derived {
    label de official "der eingetragene Vertreter kann mit Wirkung für und gegen jeden späteren Gläubiger bestimmte Verfügungen über die Hypothek treffen und den Gläubiger bei der Geltendmachung vertreten (§ 1189 Abs. 1)";
    label en unofficial "the registered representative may make certain dispositions with effect for and against every later creditor and represent the creditor in asserting the mortgage (§ 1189 (1))";
}
pub relation vornahme_der_verfuegung_vom_vertreter_verlangbar(h: Grundpfandrecht, vertreter: Person) kind derived {
    label de official "ist der Eigentümer berechtigt, von dem Gläubiger eine Verfügung zu verlangen, zu welcher der Vertreter befugt ist, so kann er die Vornahme von dem Vertreter verlangen (§ 1189 Abs. 2)";
    label en unofficial "where the owner may demand a disposition from the creditor that the representative is empowered to make, they may demand it from the representative (§ 1189 (2))";
}

@source(BGB_P1138)
rule OeffentlicherGlaubeAuchFuerForderungUndEinreden(h: Grundpfandrecht, r: Recht, p: Person) strict {
    label de official "Die Vorschriften der §§ 891 bis 899 gelten für die Hypothek auch in Ansehung der Forderung und der dem Eigentümer nach § 1137 zustehenden Einreden (§ 1138)";
    label en unofficial "§§ 891 to 899 apply to the mortgage also as regards the claim and the owner's defences under § 1137 (§ 1138)";
    when art_des_grundpfandrechts(h, Hypothek) and grundbuchblatt_des_eigentums(h, r)
        and de.bgb.besitz_eigentum::im_grundbuch_eingetragen_fuer(r, p);
    then oeffentlicher_glaube_erstreckt_sich_auf_forderung_und_einreden(h);
}

@source(BGB_P1139) {
    rule WiderspruchsfristEreignisEintragungDerHypothek(h: Grundpfandrecht, f: Frist, e: Date) strict {
        label de official "Die Monatsfrist des § 1139 Satz 1 läuft von der Eintragung der Hypothek an; der Tag der Eintragung wird nicht mitgerechnet (§ 187 Abs. 1)";
        label en unofficial "The one-month period of § 1139 sentence 1 runs from registration of the mortgage; the day of registration is not counted (§ 187 (1))";
        when widerspruchsfrist_des_1139(h, f) and hypothek_eingetragen_am(h, e);
        then de.bgb.fristen::frist_ereignis(f, e);
    }
    rule WiderspruchsfristDesEinenMonats(h: Grundpfandrecht, f: Frist) strict {
        label de official "Der Antrag muss vor dem Ablauf eines Monats nach der Eintragung der Hypothek gestellt werden (§ 1139 Satz 1) — Monatsschritt nach § 188 Abs. 2, 3";
        label en unofficial "The application must be filed within one month of registration of the mortgage (§ 1139 sentence 1) — month step under § 188 (2), (3)";
        when widerspruchsfrist_des_1139(h, f);
        then de.bgb.fristen::frist_dauer_kalender(f, 1 calendar_month);
    }
    rule AntragInnerhalbDerMonatsfristGenuegt(h: Grundpfandrecht, f: Frist, ende: Date, ta: Date) strict {
        label de official "Ist bei der Bestellung einer Hypothek für ein Darlehen die Erteilung des Briefes ausgeschlossen worden, so genügt zur Eintragung eines Widerspruchs, der sich darauf gründet, dass die Hingabe des Darlehens unterblieben sei, der von dem Eigentümer an das Grundbuchamt gerichtete Antrag, sofern er vor dem Ablauf eines Monats gestellt wird (§ 1139 Satz 1) — HANDLUNGSFRIST, Ende mit der Verlegung des § 193";
        label en unofficial "Where issue of the certificate was excluded for a loan mortgage, the owner's application to the registry suffices for registering an objection based on non-payment of the loan, provided it is filed within one month (§ 1139 sentence 1) — period for action, end with the transfer of § 193";
        when buchhypothek(h) and darlehen_nicht_hingegeben(h) and widerspruchsfrist_des_1139(h, f)
            and de.bgb.fristen::frist_ende(f, ende) and antrag_auf_widerspruch_gestellt_am(h, ta) and ta <= ende;
        then antrag_genuegt_fuer_die_eintragung_des_widerspruchs(h);
    }
    rule WiderspruchWirktWieGleichzeitigEingetragen(h: Grundpfandrecht) strict {
        label de official "Wird der Widerspruch innerhalb des Monats eingetragen, so hat die Eintragung die gleiche Wirkung, wie wenn der Widerspruch zugleich mit der Hypothek eingetragen worden wäre (§ 1139 Satz 2)";
        label en unofficial "If the objection is registered within the month, it has the same effect as if registered together with the mortgage (§ 1139 sentence 2)";
        when antrag_genuegt_fuer_die_eintragung_des_widerspruchs(h) and widerspruch_innerhalb_des_monats_eingetragen(h);
        then widerspruch_wirkt_wie_gleichzeitig_eingetragen(h);
    }
}

@source(BGB_P1140) {
    rule BerufungAufDenOeffentlichenGlaubenAusgeschlossen(h: Grundpfandrecht) strict {
        label de official "Soweit die Unrichtigkeit des Grundbuchs aus dem Hypothekenbrief oder einem Vermerk auf dem Brief hervorgeht, ist die Berufung auf die Vorschriften der §§ 892, 893 ausgeschlossen (§ 1140 Satz 1)";
        label en unofficial "In so far as the incorrectness of the register is apparent from the certificate or a note on it, reliance on §§ 892, 893 is excluded (§ 1140 sentence 1)";
        when briefhypothek(h) and unrichtigkeit_geht_aus_dem_brief_hervor(h);
        then berufung_auf_892_und_893_ausgeschlossen(h);
    }
    rule BriefvermerkStehtDemWiderspruchGleich(h: Grundpfandrecht) strict {
        label de official "Ein Widerspruch gegen die Richtigkeit des Grundbuchs, der aus dem Briefe oder einem Vermerk auf dem Briefe hervorgeht, steht einem im Grundbuch eingetragenen Widerspruch gleich (§ 1140 Satz 2)";
        label en unofficial "An objection apparent from the certificate or a note on it is equivalent to an objection registered in the land register (§ 1140 sentence 2)";
        when briefhypothek(h) and widerspruch_geht_aus_dem_brief_hervor(h);
        then briefvermerk_steht_eingetragenem_widerspruch_gleich(h);
    }
}

@source(BGB_P1150)
rule AbloesungsrechtDesDritten(h: Grundpfandrecht, dritter: Person) strict {
    label de official "Verlangt der Gläubiger Befriedigung aus dem Grundstück, so finden die Vorschriften der §§ 268, 1144, 1145 entsprechende Anwendung (§ 1150)";
    label en unofficial "Where the creditor demands satisfaction out of the land, §§ 268, 1144, 1145 apply accordingly (§ 1150)";
    when glaeubiger_verlangt_befriedigung_aus_dem_grundstueck(h) and abloesungsberechtigter_dritter(h, dritter);
    then abloesungsrecht_des_dritten(h, dritter);
}

@source(BGB_P1158)
rule NebenleistungenImLaufendenUndFolgendenVierteljahr(h: Grundpfandrecht, neuer: Person, quartalsende: Date, faellig: Date) strict {
    label de official "Soweit die Forderung auf Zinsen oder andere Nebenleistungen gerichtet ist, die nicht später als in dem Kalendervierteljahr, in welchem der Eigentümer von der Übertragung Kenntnis erlangt, oder dem folgenden Vierteljahr fällig werden, finden die §§ 406 bis 408 Anwendung; der Gläubiger kann sich insoweit nicht auf § 892 berufen (§ 1158)";
    label en unofficial "In so far as the claim is directed at interest or other ancillary payments falling due no later than in the calendar quarter in which the owner learns of the assignment, or the following quarter, §§ 406 to 408 apply; the creditor may not rely on § 892 (§ 1158)";
    when forderung_uebertragen_auf(h, neuer) and kalendervierteljahr_endet_am(h, quartalsende)
        and nebenleistung_faellig_am(h, faellig)
        and faellig <= month_end_of(add_calendar_period(month_start_of(quartalsende), 3 calendar_month));
    then vorschriften_406_bis_408_anwendbar(h);
}

@source(BGB_P1159)
rule RueckstaendeNachAllgemeinenVorschriften(h: Grundpfandrecht, neuer: Person) strict {
    label de official "Soweit die Forderung auf Rückstände von Zinsen oder anderen Nebenleistungen gerichtet ist, bestimmt sich die Übertragung sowie das Rechtsverhältnis zwischen dem Eigentümer und dem neuen Gläubiger nach den allgemeinen Vorschriften; § 892 findet auf diese Ansprüche keine Anwendung (§ 1159)";
    label en unofficial "In so far as the claim is directed at arrears of interest or other ancillary payments, the assignment and the relationship between owner and new creditor follow the general rules; § 892 does not apply (§ 1159)";
    when forderung_uebertragen_auf(h, neuer) and forderung_auf_rueckstaende_gerichtet(h);
    then uebertragung_nach_allgemeinen_vorschriften(h);
}

@source(BGB_P1188) {
    rule BestellungFuerInhaberschuldverschreibung(h: Grundpfandrecht, p: Person) strict {
        label de official "Zur Bestellung einer Hypothek für die Forderung aus einer Schuldverschreibung auf den Inhaber genügt die Erklärung des Eigentümers gegenüber dem Grundbuchamt, dass er die Hypothek bestelle, und die Eintragung in das Grundbuch (§ 1188 Abs. 1)";
        label en unofficial "To create a mortgage for a claim under a bearer bond the owner's declaration to the registry and registration suffice (§ 1188 (1))";
        when forderung_aus_inhaber_oder_orderpapier(h) and erklaerung_des_eigentuemers_ueber_die_bestellung(h)
            and glaeubiger_im_grundbuch_angegeben(h, p);
        then hypothek_fuer_inhaberschuldverschreibung_bestellt(h);
    }
    rule AusschliessungErstNachDerVorlegungsfrist(h: Grundpfandrecht) strict {
        label de official "Die Ausschließung des Gläubigers mit seinem Recht nach § 1170 ist nur zulässig, wenn die im § 801 bezeichnete Vorlegungsfrist verstrichen ist (§ 1188 Abs. 2 Satz 1)";
        label en unofficial "Exclusion of the creditor under § 1170 is admissible only once the period of presentation named in § 801 has expired (§ 1188 (2) sentence 1)";
        when forderung_aus_inhaber_oder_orderpapier(h) and vorlegungsfrist_des_801_verstrichen(h)
            and not schuldverschreibung_innerhalb_der_frist_vorgelegt(h);
        then ausschliessung_nach_1170_zulaessig(h);
    }
    rule AusschliessungNachVorlageErstMitDerVerjaehrung(h: Grundpfandrecht) strict {
        label de official "Ist innerhalb der Frist die Schuldverschreibung vorgelegt oder der Anspruch aus der Urkunde gerichtlich geltend gemacht worden, so kann die Ausschließung erst erfolgen, wenn die Verjährung eingetreten ist (§ 1188 Abs. 2 Satz 2)";
        label en unofficial "If the bond was presented within the period or the claim asserted in court, exclusion may follow only once the claim is time-barred (§ 1188 (2) sentence 2)";
        when forderung_aus_inhaber_oder_orderpapier(h) and schuldverschreibung_innerhalb_der_frist_vorgelegt(h)
            and verjaehrung_der_papierforderung_eingetreten(h);
        then ausschliessung_nach_1170_zulaessig(h);
    }
}

@source(BGB_P1189) {
    rule GrundbuchvertreterKannVerfuegen(h: Grundpfandrecht, vertreter: Person) strict {
        label de official "Bei einer Hypothek der im § 1187 bezeichneten Art kann für den jeweiligen Gläubiger ein Vertreter mit der Befugnis bestellt werden, mit Wirkung für und gegen jeden späteren Gläubiger bestimmte Verfügungen über die Hypothek zu treffen und den Gläubiger bei der Geltendmachung zu vertreten; zur Bestellung ist die Eintragung erforderlich (§ 1189 Abs. 1)";
        label en unofficial "For a mortgage of the kind named in § 1187 a representative may be appointed for the respective creditor with power to make certain dispositions with effect for and against every later creditor and to represent the creditor; registration is required (§ 1189 (1))";
        when forderung_aus_inhaber_oder_orderpapier(h) and grundbuchvertreter_eingetragen(h, vertreter);
        then vertreter_kann_verfuegen_und_vertreten(h, vertreter);
    }
    rule VornahmeVomVertreterVerlangbar(h: Grundpfandrecht, vertreter: Person) strict {
        label de official "Ist der Eigentümer berechtigt, von dem Gläubiger eine Verfügung zu verlangen, zu welcher der Vertreter befugt ist, so kann er die Vornahme der Verfügung von dem Vertreter verlangen (§ 1189 Abs. 2)";
        label en unofficial "Where the owner may demand from the creditor a disposition which the representative is empowered to make, they may demand its performance from the representative (§ 1189 (2))";
        when vertreter_kann_verfuegen_und_vertreten(h, vertreter) and eigentuemer_kann_die_verfuegung_verlangen(h);
        then vornahme_der_verfuegung_vom_vertreter_verlangbar(h, vertreter);
    }
}
