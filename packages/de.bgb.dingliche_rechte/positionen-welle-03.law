language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

pub relation position_trigger_1037(n: Niessbrauch, niesser: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum Verbot der Umgestaltung der Sache (§ 1037 Abs. 1)"; }
pub relation umgestaltung_1037_unzulaessig(n: Niessbrauch, niesser: Person) kind empirical { label de official "Der Nießbraucher darf die Sache nicht umgestalten (§ 1037 Abs. 1)"; }
pub relation violation_umgestaltung_1037(n: Niessbrauch, niesser: Person) kind derived { label de official "Der Nießbraucher hat die Sache entgegen § 1037 umgestaltet"; }
pub relation maintenance_umgestaltung_1037(n: Niessbrauch, niesser: Person) kind derived { label de official "Die Umgestaltung der Sache ist nach § 1037 zu unterlassen"; }
pub relation position_trigger_1043(n: Niessbrauch, niesser: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur außergewöhnlichen Ausbesserung (§ 1043)"; }
pub relation ausbesserung_1043_ausuebbar(n: Niessbrauch, niesser: Person) kind empirical { label de official "Der Nießbraucher darf die außergewöhnliche Ausbesserung selbst vornehmen (§ 1043)"; }
pub relation position_trigger_1049(n: Niessbrauch, niesser: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Wegnahme der Einrichtung (§ 1049 Abs. 2)"; }
pub relation wegnahme_1049_ausuebbar(n: Niessbrauch, niesser: Person) kind empirical { label de official "Der Nießbraucher darf die von ihm angebrachte Einrichtung wegnehmen (§ 1049 Abs. 2)"; }
pub relation position_trigger_1067(n: Niessbrauch, niesser: Person, besteller: Person, tag: Date) kind empirical { label de official "Eingang des Falls zum Wertersatz nach Beendigung (§ 1067)"; }
pub relation wertersatz_1067_geschuldet(n: Niessbrauch, niesser: Person, besteller: Person) kind empirical { label de official "Der Nießbraucher muss nach Beendigung Wertersatz leisten (§ 1067)"; }
pub relation position_trigger_1092(r: Recht, berechtigter: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Übertragung der Dienstbarkeit (§ 1092 Abs. 3)"; }
pub relation uebertragung_1092_ausuebbar(r: Recht, berechtigter: Person) kind empirical { label de official "Der Berechtigte darf die Dienstbarkeit übertragen (§ 1092 Abs. 3)"; }
pub relation position_trigger_1109(b: Belastung, berechtigter: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Bestimmung des herrschenden Grundstücks (§ 1109)"; }
pub relation bestimmung_1109_ausuebbar(b: Belastung, berechtigter: Person) kind empirical { label de official "Der Berechtigte darf die Verbindung des Rechts mit einem Grundstück bestimmen (§ 1109)"; }
pub relation position_trigger_1142(h: Grundpfandrecht, eigentuemer: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Befriedigung des Gläubigers (§ 1142)"; }
pub relation befriedigung_1142_ausuebbar(h: Grundpfandrecht, eigentuemer: Person) kind empirical { label de official "Der Eigentümer darf den Gläubiger befriedigen (§ 1142)"; }
pub relation position_trigger_1145(h: Grundpfandrecht, glaeubiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Aushändigung des Hypothekenbriefs (§ 1145)"; }
pub relation briefaushaendigung_1145_geschuldet(h: Grundpfandrecht, glaeubiger: Person) kind empirical { label de official "Der Gläubiger muss den Hypothekenbrief aushändigen (§ 1145)"; }
pub relation position_trigger_1166(h: Grundpfandrecht, schuldner: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Vorlage des Hypothekenbriefs (§ 1166)"; }
pub relation briefvorlage_1166_ausuebbar(h: Grundpfandrecht, schuldner: Person) kind empirical { label de official "Der Schuldner darf die Vorlage des Hypothekenbriefs verlangen (§ 1166)"; }
pub relation position_trigger_1168(h: Grundpfandrecht, erklaerender: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Verzichtserklärung (§ 1168)"; }
pub relation verzichtserklaerung_1168_geschuldet(h: Grundpfandrecht, erklaerender: Person) kind empirical { label de official "Der Verzicht ist nach § 1168 zu erklären"; }
pub relation position_trigger_1174(h: Grundpfandrecht, eigentuemer: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Teilübertragung (§ 1174)"; }
pub relation teilbetrag_1174_geschuldet(h: Grundpfandrecht, eigentuemer: Person) kind empirical { label de official "Der Eigentümer muss die Teilübertragung hinnehmen (§ 1174)"; }
pub relation position_trigger_1199(h: Grundpfandrecht, berechtigter: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Ablösungssumme (§ 1199 Abs. 2)"; }
pub relation abloesung_1199_geschuldet(h: Grundpfandrecht, berechtigter: Person) kind empirical { label de official "Der Berechtigte muss die Ablösungssumme beachten (§ 1199 Abs. 2)"; }

@source(BGB_P1037)
rule PositionUmgestaltung1037(n: Niessbrauch, niesser: Person, tag: Date) strict {
    label de official "Der Nießbraucher darf die Sache nicht umgestalten (§ 1037 Abs. 1)";
    label en unofficial "The usufructuary may not remodel the thing (§ 1037 (1))";
    when position_trigger_1037(n, niesser, tag);
    then prohibition Umgestaltung1037 {
        bearer niesser;
        action umgestaltung_1037_unzulaessig(n, niesser);
        window [tag, infinity);
    };
}

@source(BGB_P1037)
rule ViolationUmgestaltung1037(n: Niessbrauch, niesser: Person) strict {
    label de official "Der Nießbraucher hat die Sache umgestaltet und gegen § 1037 verstoßen";
    label en unofficial "The usufructuary remodelled the thing in violation of § 1037";
    when umgestaltung_1037_unzulaessig(n, niesser);
    then violation_umgestaltung_1037(n, niesser);
}

@source(BGB_P1037)
rule MaintenanceUmgestaltung1037(n: Niessbrauch, niesser: Person, tag: Date) strict {
    label de official "Der Nießbraucher muss die Umgestaltung der Sache unterlassen (§ 1037)";
    label en unofficial "The usufructuary must refrain from remodelling the thing (§ 1037)";
    when position_trigger_1037(n, niesser, tag);
    then duty MaintenanceUmgestaltung1037Duty {
        bearer niesser;
        goal maintenance {
            condition not violation_umgestaltung_1037(n, niesser);
            window [tag, infinity);
        }
    };
}

@source(BGB_P1043)
rule PositionAusbesserung1043(n: Niessbrauch, niesser: Person, tag: Date) strict {
    label de official "Der Nießbraucher darf die außergewöhnliche Ausbesserung selbst vornehmen (§ 1043)";
    label en unofficial "The usufructuary may perform the extraordinary repair (§ 1043)";
    when position_trigger_1043(n, niesser, tag);
    then power Ausbesserung1043 {
        holder niesser;
        over n;
        exercise ausbesserung_1043_ausuebbar(n, niesser);
        valid_when ausbesserung_1043_ausuebbar(n, niesser);
        effect create(ausbesserung_1043_ausuebbar(n, niesser));
        window [tag, infinity);
    };
}

@source(BGB_P1049)
rule PositionWegnahme1049(n: Niessbrauch, niesser: Person, tag: Date) strict {
    label de official "Der Nießbraucher darf die von ihm angebrachte Einrichtung wegnehmen (§ 1049 Abs. 2)";
    label en unofficial "The usufructuary may remove the installation they added (§ 1049 (2))";
    when position_trigger_1049(n, niesser, tag);
    then power Wegnahme1049 {
        holder niesser;
        over n;
        exercise wegnahme_1049_ausuebbar(n, niesser);
        valid_when wegnahme_1049_ausuebbar(n, niesser);
        effect create(wegnahme_1049_ausuebbar(n, niesser));
        window [tag, infinity);
    };
}

@source(BGB_P1067)
rule PositionWertersatz1067(n: Niessbrauch, niesser: Person, besteller: Person, tag: Date) strict {
    label de official "Der Nießbraucher muss nach Beendigung Wertersatz leisten (§ 1067)";
    label en unofficial "The usufructuary must provide value replacement after termination (§ 1067)";
    when position_trigger_1067(n, niesser, besteller, tag);
    then duty Wertersatz1067 {
        bearer niesser;
        beneficiary besteller;
        achieve wertersatz_1067_geschuldet(n, niesser, besteller) during [tag, infinity);
    };
}

@source(BGB_P1092)
rule PositionUebertragung1092(r: Recht, berechtigter: Person, tag: Date) strict {
    label de official "Der Berechtigte darf die Dienstbarkeit übertragen (§ 1092 Abs. 3)";
    label en unofficial "The entitled person may transfer the easement (§ 1092 (3))";
    when position_trigger_1092(r, berechtigter, tag);
    then power Uebertragung1092 {
        holder berechtigter;
        over r;
        exercise uebertragung_1092_ausuebbar(r, berechtigter);
        valid_when uebertragung_1092_ausuebbar(r, berechtigter);
        effect create(uebertragung_1092_ausuebbar(r, berechtigter));
        window [tag, infinity);
    };
}

@source(BGB_P1109)
rule PositionBestimmung1109(b: Belastung, berechtigter: Person, tag: Date) strict {
    label de official "Der Berechtigte darf die Verbindung des Rechts mit einem Grundstück bestimmen (§ 1109)";
    label en unofficial "The entitled person may determine the land to which the right is attached (§ 1109)";
    when position_trigger_1109(b, berechtigter, tag);
    then power Bestimmung1109 {
        holder berechtigter;
        over b;
        exercise bestimmung_1109_ausuebbar(b, berechtigter);
        valid_when bestimmung_1109_ausuebbar(b, berechtigter);
        effect create(bestimmung_1109_ausuebbar(b, berechtigter));
        window [tag, infinity);
    };
}

@source(BGB_P1142)
rule PositionBefriedigung1142(h: Grundpfandrecht, eigentuemer: Person, tag: Date) strict {
    label de official "Der Eigentümer darf den Gläubiger befriedigen (§ 1142)";
    label en unofficial "The owner may satisfy the creditor (§ 1142)";
    when position_trigger_1142(h, eigentuemer, tag);
    then power Befriedigung1142 {
        holder eigentuemer;
        over h;
        exercise befriedigung_1142_ausuebbar(h, eigentuemer);
        valid_when befriedigung_1142_ausuebbar(h, eigentuemer);
        effect create(befriedigung_1142_ausuebbar(h, eigentuemer));
        window [tag, infinity);
    };
}

@source(BGB_P1145)
rule PositionBriefaushaendigung1145(h: Grundpfandrecht, glaeubiger: Person, tag: Date) strict {
    label de official "Der Gläubiger muss den Hypothekenbrief aushändigen (§ 1145)";
    label en unofficial "The creditor must hand over the mortgage certificate (§ 1145)";
    when position_trigger_1145(h, glaeubiger, tag);
    then duty Briefaushaendigung1145 {
        bearer glaeubiger;
        achieve briefaushaendigung_1145_geschuldet(h, glaeubiger) during [tag, infinity);
    };
}

@source(BGB_P1166)
rule PositionBriefvorlage1166(h: Grundpfandrecht, schuldner: Person, tag: Date) strict {
    label de official "Der Schuldner darf die Vorlage des Hypothekenbriefs verlangen (§ 1166)";
    label en unofficial "The debtor may demand presentation of the mortgage certificate (§ 1166)";
    when position_trigger_1166(h, schuldner, tag);
    then power Briefvorlage1166 {
        holder schuldner;
        over h;
        exercise briefvorlage_1166_ausuebbar(h, schuldner);
        valid_when briefvorlage_1166_ausuebbar(h, schuldner);
        effect create(briefvorlage_1166_ausuebbar(h, schuldner));
        window [tag, infinity);
    };
}

@source(BGB_P1168)
rule PositionVerzichtserklaerung1168(h: Grundpfandrecht, erklaerender: Person, tag: Date) strict {
    label de official "Der Verzicht ist gegenüber dem Grundbuchamt oder Eigentümer zu erklären (§ 1168)";
    label en unofficial "The waiver must be declared to the land registry or owner (§ 1168)";
    when position_trigger_1168(h, erklaerender, tag);
    then duty Verzichtserklaerung1168 {
        bearer erklaerender;
        achieve verzichtserklaerung_1168_geschuldet(h, erklaerender) during [tag, infinity);
    };
}

@source(BGB_P1174)
rule PositionTeilbetrag1174(h: Grundpfandrecht, eigentuemer: Person, tag: Date) strict {
    label de official "Der Eigentümer muss die Teilübertragung hinnehmen (§ 1174)";
    label en unofficial "The owner must accept the partial transfer (§ 1174)";
    when position_trigger_1174(h, eigentuemer, tag);
    then duty Teilbetrag1174 {
        bearer eigentuemer;
        achieve teilbetrag_1174_geschuldet(h, eigentuemer) during [tag, infinity);
    };
}

@source(BGB_P1199)
rule PositionAbloesung1199(h: Grundpfandrecht, berechtigter: Person, tag: Date) strict {
    label de official "Der Berechtigte muss die Ablösungssumme beachten (§ 1199 Abs. 2)";
    label en unofficial "The entitled party must observe the redemption sum (§ 1199 (2))";
    when position_trigger_1199(h, berechtigter, tag);
    then duty Abloesung1199 {
        bearer berechtigter;
        achieve abloesung_1199_geschuldet(h, berechtigter) during [tag, infinity);
    };
}
