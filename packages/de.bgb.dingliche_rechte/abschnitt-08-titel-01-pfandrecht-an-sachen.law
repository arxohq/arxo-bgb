// --- Buch 3 Abschnitt 8 Titel 1: Pfandrecht an beweglichen Sachen (§§ 1204–1259) ------------------
//
// DAS PFANDRECHT IST EINE BESITZLAGE. Anders als das Grundpfandrecht entsteht
// es nicht durch Eintragung, sondern durch ÜBERGABE (§ 1205 Abs. 1 Satz 1).
// Besitz und Eigentum an der beweglichen Sache kommen aus dem Nachbarpaket
// (`de.bgb.besitz_eigentum::besitzer`, `::eigentuemer`, `::bewegliche_sache`);
// dieses Paket rechnet sie nicht nach. Der RANG richtet sich nach der ZEIT DER
// BESTELLUNG (§ 1209) — nicht nach dem Grundbuch; er wird hier aus dem Tag der
// Bestellung abgeleitet und nicht aus § 879 gelesen.
//
// AKZESSORIETÄT OHNE EIGENE GELDSUMME. Das Pfand haftet für die Forderung „in
// deren jeweiligem Bestand“ (§ 1210 Abs. 1). Ein zweites Geldfeld gibt es
// deshalb nicht: der Betrag steht am `Anspruch` der Nabe.
//
// DREI KANÄLE. „in erheblichem Maße“ (§ 1217 Abs. 1), „zu besorgender Verderb
// oder wesentliche Minderung des Wertes“ (§§ 1218, 1219), „angemessene Frist“
// (§ 1220 Abs. 1), „untunlich“ (§§ 1220, 1234, 1237, 1241), „billiges Ermessen“
// (§ 1246) sind Wertungen des Gerichts. Übergabe, Einigung, Anzeige, Androhung,
// Zuschlag und Kenntnis sind FESTGESTELLTE TATSACHEN des Falls.
//
// § 1234 Abs. 2 IST EINE WARTEFRIST MIT ADRESSATEN: innerhalb des Monats darf
// der Verpfänder noch befriedigen und den Verkauf abwenden (§ 1223 Abs. 2).
// Ihr Ende liest deshalb `frist_ende` MIT der Verlegung des § 193 — anders als
// die Enthaftungsfristen des Abschnitts 7 (Ledger D-11-04).

pub entity Pfandrecht : Belastung {
    label de official "Pfandrecht: Belastung einer beweglichen Sache oder eines Rechts zur Sicherung einer Forderung, kraft deren der Gläubiger Befriedigung aus ihr suchen darf (§ 1204 Abs. 1, § 1273 Abs. 1)";
    label en unofficial "pledge: encumbrance of a movable thing or of a right securing a claim, entitling the creditor to seek satisfaction from it (§ 1204 (1), § 1273 (1))";
}

// --- Eingaben des Falls -----------------------------------------------------------------------------

pub relation pfandglaeubiger(pf: Pfandrecht, p: Person) kind empirical {
    label de official "Gläubiger, zu dessen Gunsten das Pfandrecht besteht (§ 1204 Abs. 1)";
    label en unofficial "creditor in whose favour the pledge exists (§ 1204 (1))";
}
pub relation verpfaender(pf: Pfandrecht, p: Person) kind empirical {
    label de official "Verpfänder: wer das Pfandrecht bestellt (§ 1205 Abs. 1, § 1211, § 1223)";
    label en unofficial "pledgor: the person creating the pledge (§ 1205 (1), § 1211, § 1223)";
}
pub relation kuenftige_oder_bedingte_forderung_des_pfandes(pf: Pfandrecht) kind empirical {
    label de official "das Pfandrecht ist für eine künftige oder eine bedingte Forderung bestellt (§ 1204 Abs. 2, § 1209)";
    label en unofficial "the pledge is created for a future or conditional claim (§ 1204 (2), § 1209)";
}
pub relation einigung_ueber_das_pfandrecht(pf: Pfandrecht) kind empirical {
    label de official "Einigung des Eigentümers und des Gläubigers darüber, dass dem Gläubiger das Pfandrecht zustehen soll (§ 1205 Abs. 1 Satz 1)";
    label en unofficial "agreement of owner and creditor that the pledge is to belong to the creditor (§ 1205 (1) sentence 1)";
}
pub relation sache_dem_glaeubiger_uebergeben(pf: Pfandrecht) kind empirical {
    label de official "der Eigentümer hat die Sache dem Gläubiger übergeben (§ 1205 Abs. 1 Satz 1)";
    label en unofficial "the owner has handed the thing over to the creditor (§ 1205 (1) sentence 1)";
}
pub relation glaeubiger_bereits_im_besitz(pf: Pfandrecht) kind empirical {
    label de official "der Gläubiger ist bereits im Besitz der Sache; dann genügt die Einigung (§ 1205 Abs. 1 Satz 2)";
    label en unofficial "the creditor is already in possession; then the agreement suffices (§ 1205 (1) sentence 2)";
}
pub relation mittelbarer_besitz_uebertragen_und_verpfaendung_angezeigt(pf: Pfandrecht) kind empirical {
    label de official "der Eigentümer hat den mittelbaren Besitz auf den Pfandgläubiger übertragen und die Verpfändung dem Besitzer angezeigt (§ 1205 Abs. 2)";
    label en unofficial "the owner has transferred indirect possession to the pledgee and notified the possessor of the pledge (§ 1205 (2))";
}
pub relation mitbesitz_eingeraeumt_unter_mitverschluss(pf: Pfandrecht) kind empirical {
    label de official "dem Gläubiger ist Mitbesitz eingeräumt und die Sache befindet sich unter seinem Mitverschluss, oder die Herausgabe durch den Dritten kann nur gemeinschaftlich erfolgen (§ 1206)";
    label en unofficial "co-possession has been granted and the thing is under the creditor's joint lock, or a third party may release it only jointly (§ 1206)";
}
pub relation sache_gehoert_dem_verpfaender_nicht(pf: Pfandrecht) kind empirical {
    label de official "die Sache gehört dem Verpfänder nicht (§ 1207)";
    label en unofficial "the thing does not belong to the pledgor (§ 1207)";
}
pub relation kenntnis_vom_fehlenden_eigentum_des_verpfaenders(pf: Pfandrecht) kind empirical {
    label de official "dem Pfandgläubiger ist bekannt, dass die Sache dem Verpfänder nicht gehört (§ 1207 über § 932 Abs. 2, § 1248) — festgestellte Tatsache";
    label en unofficial "the pledgee knows that the thing does not belong to the pledgor (§ 1207 via § 932 (2), § 1248) — established fact";
}
pub relation pfandsache_abhanden_gekommen(pf: Pfandrecht) kind empirical {
    label de official "die Sache ist dem Eigentümer abhanden gekommen (§ 1207 über § 935)";
    label en unofficial "the thing was lost by or stolen from the owner (§ 1207 via § 935)";
}
pub relation recht_eines_dritten_an_der_pfandsache(pf: Pfandrecht, dritter: Person) kind empirical {
    label de official "die Sache ist mit dem Recht eines Dritten belastet (§ 1208 Satz 1)";
    label en unofficial "the thing is encumbered with a third party's right (§ 1208 sentence 1)";
}
pub relation bestellt_am(pf: Pfandrecht, tag: Date) kind empirical {
    key(pf);
    label de official "Zeit der Bestellung des Pfandrechts; sie ist auch dann für den Rang maßgebend, wenn das Pfandrecht für eine künftige oder bedingte Forderung bestellt ist (§ 1209)";
    label en unofficial "time of creation of the pledge; it governs rank even where the pledge is created for a future or conditional claim (§ 1209)";
}
pub relation nutzungspfand_vereinbart(pf: Pfandrecht) kind empirical {
    label de official "das Pfandrecht ist in der Weise bestellt, dass der Pfandgläubiger berechtigt ist, die Nutzungen des Pfandes zu ziehen (§ 1213 Abs. 1)";
    label en unofficial "the pledge is created so that the pledgee may take the fruits of the pledged thing (§ 1213 (1))";
}
pub relation von_natur_frucht_tragende_sache_im_alleinbesitz(pf: Pfandrecht) kind empirical {
    label de official "eine von Natur Frucht tragende Sache ist dem Pfandgläubiger zum Alleinbesitz übergeben (§ 1213 Abs. 2)";
    label en unofficial "a thing naturally bearing fruits has been handed over to the pledgee for sole possession (§ 1213 (2))";
}
pub relation abweichende_bestimmung_ueber_die_nutzungen(pf: Pfandrecht) kind empirical {
    label de official "über die Anrechnung des Reinertrags ist ein anderes bestimmt (§ 1214 Abs. 3)";
    label en unofficial "a different provision on crediting the net proceeds has been made (§ 1214 (3))";
}
pub relation reinertrag_der_nutzungen(pf: Pfandrecht, betrag: Money) kind empirical {
    key(pf);
    label de official "Reinertrag der von dem Pfandgläubiger gezogenen Nutzungen (§ 1214 Abs. 2)";
    label en unofficial "net proceeds of the fruits taken by the pledgee (§ 1214 (2))";
}
pub relation verwendung_auf_das_pfand_gemacht(pf: Pfandrecht) kind empirical {
    label de official "der Pfandgläubiger hat Verwendungen auf das Pfand gemacht (§ 1216 Satz 1)";
    label en unofficial "the pledgee has made outlays on the pledged thing (§ 1216 sentence 1)";
}
pub relation einrichtung_angebracht(pf: Pfandrecht) kind empirical {
    label de official "der Pfandgläubiger hat das Pfand mit einer Einrichtung versehen (§ 1216 Satz 2)";
    label en unofficial "the pledgee has fitted the thing with an installation (§ 1216 sentence 2)";
}
pub relation abmahnung_des_verpfaenders(pf: Pfandrecht) kind empirical {
    label de official "der Verpfänder hat den Pfandgläubiger abgemahnt und dieser setzt das verletzende Verhalten fort (§ 1217 Abs. 1)";
    label en unofficial "the pledgor has warned the pledgee, who continues the infringing conduct (§ 1217 (1))";
}
pub relation pfand_eignet_sich_nicht_zur_hinterlegung(pf: Pfandrecht) kind empirical {
    label de official "das Pfand eignet sich nicht zur Hinterlegung (§ 1217 Abs. 1)";
    label en unofficial "the pledged thing is not suitable for deposit (§ 1217 (1))";
}
pub relation anderweitige_sicherheit_geleistet(pf: Pfandrecht) kind empirical {
    label de official "der Verpfänder hat anderweitige Sicherheit geleistet; Sicherheitsleistung durch Bürgen ist ausgeschlossen (§ 1218 Abs. 1)";
    label en unofficial "the pledgor has furnished other security; security by a surety is excluded (§ 1218 (1))";
}
pub relation anzeige_untunlich(pf: Pfandrecht) kind empirical {
    label de official "die Anzeige oder Benachrichtigung ist untunlich (§ 1218 Abs. 2, § 1220 Abs. 3, § 1234 Abs. 1 Satz 2, § 1237 Satz 2, § 1241)";
    label en unofficial "the notice or notification is impracticable (§ 1218 (2), § 1220 (3), § 1234 (1) sentence 2, § 1237 sentence 2, § 1241)";
}
pub relation versteigerung_angedroht_am(pf: Pfandrecht, tag: Date) kind empirical {
    key(pf);
    label de official "Tag, an dem dem Verpfänder die Versteigerung angedroht worden ist (§ 1220 Abs. 1)";
    label en unofficial "day on which the auction was threatened to the pledgor (§ 1220 (1))";
}
pub relation boersen_oder_marktpreis(pf: Pfandrecht) kind empirical {
    label de official "das Pfand hat einen Börsen- oder Marktpreis (§ 1221, § 1235 Abs. 2, § 1259, § 1295)";
    label en unofficial "the pledged thing has a stock-exchange or market price (§ 1221, § 1235 (2), § 1259, § 1295)";
}
pub relation forderung_ganz_oder_zum_teil_faellig(pf: Pfandrecht) kind empirical {
    label de official "die gesicherte Forderung ist ganz oder zum Teil fällig (§ 1228 Abs. 2 Satz 1)";
    label en unofficial "the secured claim is due in whole or in part (§ 1228 (2) sentence 1)";
}
pub relation geschuldeter_gegenstand_nicht_geld(pf: Pfandrecht) kind empirical {
    label de official "der geschuldete Gegenstand besteht nicht in Geld (§ 1228 Abs. 2 Satz 2)";
    label en unofficial "the object owed does not consist in money (§ 1228 (2) sentence 2)";
}
pub relation forderung_in_geldforderung_uebergegangen(pf: Pfandrecht) kind empirical {
    label de official "die Forderung ist in eine Geldforderung übergegangen (§ 1228 Abs. 2 Satz 2)";
    label en unofficial "the claim has turned into a monetary claim (§ 1228 (2) sentence 2)";
}
pub relation verfallvereinbarung_vor_der_verkaufsberechtigung(pf: Pfandrecht) kind empirical {
    label de official "vor dem Eintritt der Verkaufsberechtigung getroffene Vereinbarung, nach welcher dem Pfandgläubiger das Eigentum zufallen oder übertragen werden soll (§ 1229)";
    label en unofficial "agreement made before the right of sale arises that ownership is to pass to the pledgee (§ 1229)";
}
pub relation verkaufsandrohungsfrist(pf: Pfandrecht, f: Frist) kind empirical {
    key(pf);
    label de official "Monatsfrist des § 1234 Abs. 2, vor deren Ablauf der Verkauf nicht erfolgen darf";
    label en unofficial "one-month period of § 1234 (2) before whose expiry the sale may not take place";
}
pub relation verkaufsberechtigung_eingetreten_am(pf: Pfandrecht, tag: Date) kind empirical {
    key(pf);
    label de official "Tag des Eintritts der Verkaufsberechtigung; er zählt statt der Androhung, wenn diese untunlich ist (§ 1234 Abs. 2 Satz 2)";
    label en unofficial "day on which the right of sale arose; it replaces the threat where the latter is impracticable (§ 1234 (2) sentence 2)";
}
pub relation verkauf_erfolgt_am(pf: Pfandrecht, tag: Date) kind empirical {
    key(pf);
    label de official "Tag, an dem das Pfand verkauft worden ist (§ 1234 Abs. 2, § 1242 Abs. 1)";
    label en unofficial "day on which the pledged thing was sold (§ 1234 (2), § 1242 (1))";
}
pub relation oeffentliche_versteigerung_durchgefuehrt(pf: Pfandrecht) kind empirical {
    label de official "der Verkauf ist im Wege öffentlicher Versteigerung bewirkt worden (§ 1235 Abs. 1)";
    label en unofficial "the sale was effected by public auction (§ 1235 (1))";
}
pub relation oeffentlich_bekannt_gemacht(pf: Pfandrecht) kind empirical {
    label de official "die Versteigerung ist nach § 383 Abs. 3 öffentlich bekannt gemacht worden (§ 1237 Satz 1)";
    label en unofficial "the auction was publicly announced under § 383 (3) (§ 1237 sentence 1)";
}
pub relation sofortige_kaufpreiszahlung_bestimmt(pf: Pfandrecht) kind empirical {
    label de official "das Pfand ist mit der Bestimmung verkauft worden, dass der Käufer den Kaufpreis sofort zu entrichten hat (§ 1238 Abs. 1)";
    label en unofficial "the thing was sold on the term that the buyer must pay the price immediately (§ 1238 (1))";
}
pub relation gold_oder_silbersache(pf: Pfandrecht) kind empirical {
    label de official "das Pfand ist eine Gold- oder Silbersache (§ 1240 Abs. 1)";
    label en unofficial "the pledged thing is an article of gold or silver (§ 1240 (1))";
}
pub relation zuschlag_unter_dem_edelmetallwert(pf: Pfandrecht) kind empirical {
    label de official "der Zuschlag ist unter dem Gold- oder Silberwert erfolgt (§ 1240 Abs. 1)";
    label en unofficial "the knock-down was below the gold or silver value (§ 1240 (1))";
}
pub relation nur_so_viele_pfaender_verkauft_wie_erforderlich(pf: Pfandrecht) kind empirical {
    label de official "es sind nur so viele Pfänder zum Verkauf gebracht worden, als zur Befriedigung erforderlich sind (§ 1230 Satz 2)";
    label en unofficial "only as many pledged things were sold as were necessary for satisfaction (§ 1230 sentence 2)";
}
pub relation erloes_aus_dem_pfand(pf: Pfandrecht, betrag: Money) kind empirical {
    key(pf);
    label de official "Erlös aus dem Pfande (§ 1219 Abs. 2, § 1247)";
    label en unofficial "proceeds of the pledged thing (§ 1219 (2), § 1247)";
}
pub relation forderungsbetrag(pf: Pfandrecht, betrag: Money) kind empirical {
    key(pf);
    label de official "Betrag der gesicherten Forderung in ihrem jeweiligen Bestand (§ 1210 Abs. 1 Satz 1, § 1247 Satz 1)";
    label en unofficial "amount of the secured claim in its current state (§ 1210 (1) sentence 1, § 1247 sentence 1)";
}
pub relation pfand_zurueckgegeben(pf: Pfandrecht) kind empirical {
    label de official "der Pfandgläubiger hat das Pfand dem Verpfänder oder dem Eigentümer zurückgegeben (§ 1253 Abs. 1)";
    label en unofficial "the pledgee has returned the pledged thing to the pledgor or the owner (§ 1253 (1))";
}
pub relation pfand_im_besitz_des_verpfaenders_oder_eigentuemers(pf: Pfandrecht) kind empirical {
    label de official "das Pfand ist im Besitz des Verpfänders oder des Eigentümers, oder eines Dritten, der den Besitz nach der Entstehung des Pfandrechts von ihnen erlangt hat (§ 1253 Abs. 2)";
    label en unofficial "the thing is in the possession of the pledgor or owner, or of a third party who obtained it from them after the pledge arose (§ 1253 (2))";
}
pub relation rueckgabe_widerlegt(pf: Pfandrecht) kind empirical {
    label de official "es ist festgestellt, dass eine Rückgabe nicht erfolgt ist — Widerlegung der Vermutung des § 1253 Abs. 2";
    label en unofficial "it is established that no return took place — rebuttal of the presumption of § 1253 (2)";
}
pub relation aufhebungserklaerung_des_pfandglaeubigers(pf: Pfandrecht) kind empirical {
    label de official "Erklärung des Pfandgläubigers gegenüber dem Verpfänder oder dem Eigentümer, dass er das Pfandrecht aufgebe (§ 1255 Abs. 1)";
    label en unofficial "declaration of the pledgee to the pledgor or the owner that they surrender the pledge (§ 1255 (1))";
}
pub relation pfandrecht_mit_dem_recht_eines_dritten_belastet(pf: Pfandrecht, dritter: Person) kind empirical {
    label de official "das Pfandrecht ist mit dem Recht eines Dritten belastet (§ 1255 Abs. 2, § 1256 Abs. 1 Satz 2)";
    label en unofficial "the pledge is encumbered with a third party's right (§ 1255 (2), § 1256 (1) sentence 2)";
}
pub relation zustimmung_des_dritten_zur_aufhebung(pf: Pfandrecht, dritter: Person) kind empirical {
    label de official "Zustimmung des Dritten zur Aufhebung; sie ist unwiderruflich (§ 1255 Abs. 2)";
    label en unofficial "consent of the third party to the surrender; it is irrevocable (§ 1255 (2))";
}
pub relation pfandrecht_trifft_mit_dem_eigentum_zusammen(pf: Pfandrecht) kind empirical {
    label de official "das Pfandrecht trifft mit dem Eigentum in derselben Person zusammen (§ 1256 Abs. 1 Satz 1)";
    label en unofficial "the pledge coincides with ownership in the same person (§ 1256 (1) sentence 1)";
}
pub relation rechtliches_interesse_am_fortbestehen(pf: Pfandrecht) kind empirical {
    label de official "der Eigentümer hat ein rechtliches Interesse an dem Fortbestehen des Pfandrechts (§ 1256 Abs. 2)";
    label en unofficial "the owner has a legal interest in the continued existence of the pledge (§ 1256 (2))";
}
pub relation kraft_gesetzes_entstandenes_pfandrecht(pf: Pfandrecht) kind empirical {
    label de official "das Pfandrecht ist kraft Gesetzes entstanden (§ 1257)";
    label en unofficial "the pledge arose by operation of law (§ 1257)";
}
pub relation beide_unternehmer_oder_oeffentlich_rechtlich(pf: Pfandrecht) kind empirical {
    label de official "Eigentümer und Pfandgläubiger sind Unternehmer, juristische Personen des öffentlichen Rechts oder öffentlich-rechtliche Sondervermögen (§ 1259 Satz 1)";
    label en unofficial "owner and pledgee are entrepreneurs, public-law legal persons or public-law special funds (§ 1259 sentence 1)";
}
pub relation verwertungsabrede_bei_der_verpfaendung(pf: Pfandrecht) kind empirical {
    label de official "schon bei der Verpfändung ist vereinbart, dass der Pfandgläubiger freihändig zum laufenden Preis verkaufen kann oder ihm das Eigentum bei Fälligkeit zufällt (§ 1259 Satz 1)";
    label en unofficial "it was agreed already on pledging that the pledgee may sell at the current price or that ownership accrues to them on maturity (§ 1259 sentence 1)";
}
pub relation pfandrecht_am_miteigentumsanteil(pf: Pfandrecht) kind empirical {
    label de official "das Pfandrecht besteht an dem Anteil eines Miteigentümers (§ 1258 Abs. 1)";
    label en unofficial "the pledge exists on the share of a co-owner (§ 1258 (1))";
}

// --- Urteilskanäle (DECISION-0194) ----------------------------------------------------------------------

@source(BGB_P1217)
pub external judgment relation rechte_des_verpfaenders_erheblich_verletzt(pf: Pfandrecht) {
    authority Court;
    label de official "der Pfandgläubiger verletzt die Rechte des Verpfänders in erheblichem Maße (§ 1217 Abs. 1) — Wertung";
    label en unofficial "the pledgee infringes the pledgor's rights to a substantial degree (§ 1217 (1)) — evaluation";
}
@source(BGB_P1218)
pub external judgment relation verderb_oder_wesentliche_wertminderung_zu_besorgen(pf: Pfandrecht) {
    authority Court;
    label de official "der Verderb des Pfandes oder eine wesentliche Minderung des Wertes ist zu besorgen (§ 1218 Abs. 1, § 1219 Abs. 1) — Wertung";
    label en unofficial "spoilage of the pledged thing or a substantial reduction in its value is to be feared (§ 1218 (1), § 1219 (1)) — evaluation";
}
@source(BGB_P1219)
pub external judgment relation sicherheit_des_pfandglaeubigers_gefaehrdet(pf: Pfandrecht) {
    authority Court;
    label de official "durch den drohenden Verderb oder die zu besorgende Wertminderung ist die Sicherheit des Pfandgläubigers gefährdet (§ 1219 Abs. 1) — Wertung";
    label en unofficial "the pledgee's security is endangered by the imminent spoilage or reduction in value (§ 1219 (1)) — evaluation";
}
@source(BGB_P1220)
pub external judgment relation angemessene_frist_zur_sicherheitsleistung_bestimmt(pf: Pfandrecht) {
    authority Court;
    label de official "der Pfandgläubiger hat dem Verpfänder zur Leistung anderweitiger Sicherheit eine angemessene Frist bestimmt und diese ist verstrichen (§ 1220 Abs. 1 Satz 2) — die Angemessenheit ist eine Wertung";
    label en unofficial "the pledgee has set the pledgor a reasonable period to furnish other security and it has expired (§ 1220 (1) sentence 2) — reasonableness is an evaluation";
}
@source(BGB_P1246)
pub external judgment relation abweichende_verkaufsart_entspricht_billigem_ermessen(pf: Pfandrecht) {
    authority Court;
    label de official "eine von den §§ 1235 bis 1240 abweichende Art des Pfandverkaufs entspricht nach billigem Ermessen den Interessen der Beteiligten (§ 1246 Abs. 1) — Wertung";
    label en unofficial "a manner of sale deviating from §§ 1235 to 1240 corresponds, in equitable discretion, to the interests of those involved (§ 1246 (1)) — evaluation";
}
@source(BGB_P1243)
pub external judgment relation verschulden_des_pfandglaeubigers(pf: Pfandrecht) {
    authority Court;
    label de official "dem Pfandgläubiger fällt ein Verschulden zur Last (§ 1243 Abs. 2) — Wertung";
    label en unofficial "the pledgee is at fault (§ 1243 (2)) — evaluation";
}

// --- Abgeleitete Köpfe -----------------------------------------------------------------------------------

pub relation pfandrecht_entstanden(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "das Pfandrecht ist entstanden (§ 1205, § 1206, § 1207)";
    label en unofficial "the pledge has arisen (§ 1205, § 1206, § 1207)";
}
pub relation befriedigung_aus_der_sache_zulaessig(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "der Gläubiger ist berechtigt, Befriedigung aus der Sache zu suchen (§ 1204 Abs. 1)";
    label en unofficial "the creditor is entitled to seek satisfaction from the thing (§ 1204 (1))";
}
pub relation guter_glaube_des_pfandglaeubigers(pf: Pfandrecht) kind derived {
    label de official "der Pfandgläubiger ist in gutem Glauben: weder Kenntnis vom fehlenden Eigentum noch Abhandenkommen (§ 1207 über § 932 Abs. 2, § 935)";
    label en unofficial "the pledgee is in good faith: neither knowledge of the lack of ownership nor loss of possession (§ 1207 via § 932 (2), § 935)";
}
pub relation gutglaeubiger_pfandrechtserwerb_ausgeschlossen(pf: Pfandrecht) kind derived {
    label de official "der gutgläubige Erwerb des Pfandrechts ist ausgeschlossen: Kenntnis oder Abhandenkommen (§ 1207 über § 932 Abs. 2, § 935)";
    label en unofficial "good-faith acquisition of the pledge is excluded: knowledge or loss of possession (§ 1207 via § 932 (2), § 935)";
}
pub relation pfandrecht_geht_dem_recht_des_dritten_vor(pf: Pfandrecht, dritter: Person) kind derived {
    label de official "das Pfandrecht geht dem Recht des Dritten vor (§ 1208 Satz 1)";
    label en unofficial "the pledge ranks ahead of the third party's right (§ 1208 sentence 1)";
}
pub relation pfandrang_vor(frueher: Pfandrecht, spaeter: Pfandrecht) kind derived {
    label de official "für den Rang des Pfandrechts ist die Zeit der Bestellung maßgebend, auch bei künftiger oder bedingter Forderung (§ 1209)";
    label en unofficial "the time of creation governs the rank of the pledge, including for a future or conditional claim (§ 1209)";
}
pub relation pfand_haftet_fuer_kosten_und_verwendungen(pf: Pfandrecht) kind derived {
    label de official "das Pfand haftet für die Ansprüche auf Ersatz von Verwendungen, für die Kosten der Kündigung und der Rechtsverfolgung sowie für die Kosten des Pfandverkaufs (§ 1210 Abs. 2)";
    label en unofficial "the pledge is liable for claims to reimbursement of outlays and for the costs of termination, of enforcement and of the sale (§ 1210 (2))";
}
pub relation haftung_nicht_erweitert(pf: Pfandrecht) kind derived {
    label de official "ist der persönliche Schuldner nicht der Eigentümer, so wird die Haftung durch ein nach der Verpfändung vorgenommenes Rechtsgeschäft des Schuldners nicht erweitert (§ 1210 Abs. 1 Satz 2)";
    label en unofficial "where the personal debtor is not the owner, a transaction of the debtor after the pledging does not extend the liability (§ 1210 (1) sentence 2)";
}
pub relation einrede_gegen_das_pfandrecht_geltend_zu_machen(e: Einrede, pf: Pfandrecht, p: Person) kind derived {
    label de official "der Verpfänder kann dem Pfandgläubiger gegenüber die Einreden des persönlichen Schuldners geltend machen (§ 1211 Abs. 1, Abs. 2)";
    label en unofficial "the pledgor may raise the personal debtor's defences against the pledgee (§ 1211 (1), (2))";
}
pub relation fruchtbezugsrecht_vermutet(pf: Pfandrecht) kind derived {
    label de official "ist eine von Natur Frucht tragende Sache dem Pfandgläubiger zum Alleinbesitz übergeben, so ist im Zweifel anzunehmen, dass er zum Fruchtbezug berechtigt sein soll (§ 1213 Abs. 2)";
    label en unofficial "where a thing naturally bearing fruits is handed over for sole possession, it is presumed that the pledgee may take the fruits (§ 1213 (2))";
}
pub relation reinertrag_anzurechnen(pf: Pfandrecht, betrag: Money) kind derived {
    key(pf);
    label de official "der Reinertrag der Nutzungen wird auf die geschuldete Leistung und zunächst auf Kosten und Zinsen angerechnet (§ 1214 Abs. 2)";
    label en unofficial "the net proceeds are credited against the performance owed, first against costs and interest (§ 1214 (2))";
}
pub relation verwahrungspflicht(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "der Pfandgläubiger ist zur Verwahrung des Pfandes verpflichtet (§ 1215)";
    label en unofficial "the pledgee is obliged to keep the pledged thing safe (§ 1215)";
}
pub relation wegnahmerecht_der_einrichtung(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "der Pfandgläubiger ist berechtigt, eine Einrichtung, mit der er das Pfand versehen hat, wegzunehmen (§ 1216 Satz 2)";
    label en unofficial "the pledgee may remove an installation with which they fitted the thing (§ 1216 sentence 2)";
}
pub relation anspruch_auf_hinterlegung_oder_ablieferung(pf: Pfandrecht, verpfaender: Person) kind derived {
    label de official "der Verpfänder kann verlangen, dass das Pfand auf Kosten des Pfandgläubigers hinterlegt oder an einen gerichtlich zu bestellenden Verwahrer abgeliefert wird (§ 1217 Abs. 1)";
    label en unofficial "the pledgor may demand that the thing be deposited at the pledgee's cost or delivered to a court-appointed custodian (§ 1217 (1))";
}
pub relation anspruch_auf_rueckgabe_gegen_sicherheitsleistung(pf: Pfandrecht, verpfaender: Person) kind derived {
    label de official "der Verpfänder kann die Rückgabe des Pfandes gegen anderweitige Sicherheitsleistung verlangen; Sicherheitsleistung durch Bürgen ist ausgeschlossen (§ 1218 Abs. 1)";
    label en unofficial "the pledgor may demand return of the thing against other security; security by a surety is excluded (§ 1218 (1))";
}
pub relation anzeigepflicht_bei_drohendem_verderb(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "der Pfandgläubiger hat dem Verpfänder von dem drohenden Verderb unverzüglich Anzeige zu machen, sofern die Anzeige nicht untunlich ist (§ 1218 Abs. 2)";
    label en unofficial "the pledgee must notify the pledgor of the imminent spoilage without undue delay unless notification is impracticable (§ 1218 (2))";
}
pub relation oeffentliche_versteigerung_bei_verderb_zulaessig(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "der Pfandgläubiger kann das Pfand öffentlich versteigern lassen; der Erlös tritt an die Stelle des Pfandes (§ 1219)";
    label en unofficial "the pledgee may have the thing publicly auctioned; the proceeds take its place (§ 1219)";
}
pub relation verkaufsberechtigung(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "der Pfandgläubiger ist zum Verkauf berechtigt (§ 1228 Abs. 2)";
    label en unofficial "the pledgee is entitled to sell (§ 1228 (2))";
}
pub relation verfallvereinbarung_nichtig(pf: Pfandrecht) kind derived {
    label de official "die vor dem Eintritt der Verkaufsberechtigung getroffene Verfallvereinbarung ist nichtig (§ 1229)";
    label en unofficial "the forfeiture agreement made before the right of sale arises is void (§ 1229)";
}
pub relation verkauf_fruehestens_am(pf: Pfandrecht, tag: Date) kind derived {
    key(pf);
    label de official "Tag, vor dessen Ablauf der Verkauf nicht erfolgen darf (§ 1234 Abs. 2) — Monat nach der Androhung, bei untunlicher Androhung nach dem Eintritt der Verkaufsberechtigung";
    label en unofficial "day before whose end the sale may not take place (§ 1234 (2)) — one month after the threat, or after the right of sale arose where the threat is impracticable";
}
pub relation verkauf_zu_frueh(pf: Pfandrecht) kind derived {
    label de official "der Verkauf ist vor dem Ablauf der Monatsfrist erfolgt und damit unzulässig (§ 1234 Abs. 2)";
    label en unofficial "the sale took place before the one-month period expired and is therefore inadmissible (§ 1234 (2))";
}
pub relation freihaendiger_verkauf_zulaessig(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "hat das Pfand einen Börsen- oder Marktpreis, so kann der Pfandgläubiger den Verkauf aus freier Hand zum laufenden Preis bewirken (§ 1221, § 1235 Abs. 2)";
    label en unofficial "where the thing has a stock-exchange or market price, the pledgee may effect a private sale at the current price (§ 1221, § 1235 (2))";
}
pub relation jedes_pfand_haftet_fuer_die_ganze_forderung(pf: Pfandrecht) kind derived {
    label de official "besteht das Pfandrecht an mehreren Sachen, so haftet jede für die ganze Forderung (§ 1222)";
    label en unofficial "where the pledge exists on several things, each is liable for the whole claim (§ 1222)";
}
pub relation rueckgabepflicht_nach_erloeschen(pf: Pfandrecht, glaeubiger: Person, verpfaender: Person) kind derived {
    label de official "der Pfandgläubiger ist verpflichtet, das Pfand nach dem Erlöschen des Pfandrechts dem Verpfänder zurückzugeben (§ 1223 Abs. 1)";
    label en unofficial "the pledgee must return the thing to the pledgor once the pledge is extinguished (§ 1223 (1))";
}
pub relation einloesungsrecht_des_verpfaenders(pf: Pfandrecht, verpfaender: Person) kind derived {
    label de official "der Verpfänder kann die Rückgabe gegen Befriedigung des Pfandgläubigers verlangen, sobald der Schuldner zur Leistung berechtigt ist (§ 1223 Abs. 2)";
    label en unofficial "the pledgor may demand return against satisfaction of the pledgee once the debtor is entitled to perform (§ 1223 (2))";
}
pub relation forderung_auf_den_verpfaender_uebergegangen(pf: Pfandrecht, verpfaender: Person) kind derived {
    label de official "ist der Verpfänder nicht der persönliche Schuldner, so geht, soweit er den Pfandgläubiger befriedigt, die Forderung auf ihn über (§ 1225 Satz 1)";
    label en unofficial "where the pledgor is not the personal debtor, the claim passes to them in so far as they satisfy the pledgee (§ 1225 sentence 1)";
}
pub relation veraeusserung_nicht_rechtmaessig(pf: Pfandrecht) kind derived {
    label de official "die Veräußerung des Pfandes ist nicht rechtmäßig (§ 1243 Abs. 1)";
    label en unofficial "the disposal of the pledged thing is not lawful (§ 1243 (1))";
}
pub relation veraeusserung_rechtmaessig(pf: Pfandrecht) kind derived {
    label de official "die Veräußerung des Pfandes ist rechtmäßig: Verkaufsberechtigung, Monatsfrist, öffentliche Versteigerung, Bekanntmachung und Edelmetallwert sind gewahrt (§ 1242 Abs. 1, § 1243 Abs. 1 im Gegenschluss)";
    label en unofficial "the disposal is lawful: right of sale, one-month period, public auction, announcement and precious-metal value have been observed (§ 1242 (1), § 1243 (1) a contrario)";
}
pub relation erwerber_erlangt_die_rechte_wie_vom_eigentuemer(pf: Pfandrecht) kind derived {
    label de official "durch die rechtmäßige Veräußerung erlangt der Erwerber die gleichen Rechte, wie wenn er die Sache von dem Eigentümer erworben hätte; Pfandrechte an der Sache erlöschen (§ 1242)";
    label en unofficial "through the lawful disposal the acquirer obtains the same rights as if they had acquired from the owner; pledges on the thing are extinguished (§ 1242)";
}
pub relation schadensersatzpflicht_des_pfandglaeubigers(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "verletzt der Pfandgläubiger eine andere für den Verkauf geltende Vorschrift, so ist er zum Schadensersatz verpflichtet, wenn ihm ein Verschulden zur Last fällt (§ 1243 Abs. 2, § 1220 Abs. 2)";
    label en unofficial "if the pledgee infringes another rule governing the sale, they must pay damages if at fault (§ 1243 (2), § 1220 (2))";
}
pub relation erloes_gebuehrt_dem_pfandglaeubiger(pf: Pfandrecht, betrag: Money) kind derived {
    key(pf);
    label de official "Betrag, der dem Pfandgläubiger aus dem Erlös zu seiner Befriedigung gebührt (§ 1247 Satz 1)";
    label en unofficial "amount of the proceeds accruing to the pledgee for their satisfaction (§ 1247 sentence 1)";
}
pub relation forderung_gilt_als_berichtigt(pf: Pfandrecht, betrag: Money) kind derived {
    key(pf);
    label de official "soweit der Erlös dem Pfandgläubiger zu seiner Befriedigung gebührt, gilt die Forderung als von dem Eigentümer berichtigt (§ 1247 Satz 1, § 1259 Satz 2)";
    label en unofficial "in so far as the proceeds accrue to the pledgee, the claim counts as settled by the owner (§ 1247 sentence 1, § 1259 sentence 2)";
}
pub relation ueberschuss_tritt_an_die_stelle_des_pfandes(pf: Pfandrecht, betrag: Money) kind derived {
    key(pf);
    label de official "im Übrigen tritt der Erlös an die Stelle des Pfandes (§ 1247 Satz 2, § 1219 Abs. 2 Satz 1)";
    label en unofficial "for the rest the proceeds take the place of the pledged thing (§ 1247 sentence 2, § 1219 (2) sentence 1)";
}
pub relation verpfaender_gilt_als_eigentuemer(pf: Pfandrecht, verpfaender: Person) kind derived {
    label de official "bei dem Verkauf gilt zugunsten des Pfandgläubigers der Verpfänder als der Eigentümer, es sei denn, dass der Pfandgläubiger weiß, dass er es nicht ist (§ 1248)";
    label en unofficial "on the sale the pledgor is deemed the owner in favour of the pledgee unless the pledgee knows otherwise (§ 1248)";
}
pub relation abloesungsrecht_des_rechtsverlierers(pf: Pfandrecht, dritter: Person) kind derived {
    label de official "wer durch die Veräußerung ein Recht an dem Pfande verlieren würde, kann den Pfandgläubiger befriedigen, sobald der Schuldner zur Leistung berechtigt ist (§ 1249)";
    label en unofficial "a person who would lose a right in the thing through the disposal may satisfy the pledgee once the debtor is entitled to perform (§ 1249)";
}
pub relation pfandrecht_erloschen(pf: Pfandrecht) kind derived {
    label de official "das Pfandrecht ist erloschen (§ 1250 Abs. 2, § 1252, § 1253 Abs. 1, § 1255, § 1256 Abs. 1)";
    label en unofficial "the pledge is extinguished (§ 1250 (2), § 1252, § 1253 (1), § 1255, § 1256 (1))";
}
pub relation rueckgabe_vermutet(pf: Pfandrecht) kind derived {
    label de official "ist das Pfand im Besitz des Verpfänders oder des Eigentümers, so wird vermutet, dass es ihm zurückgegeben worden sei (§ 1253 Abs. 2)";
    label en unofficial "where the thing is in the pledgor's or owner's possession, it is presumed to have been returned (§ 1253 (2))";
}
pub relation anspruch_auf_rueckgabe_bei_dauernder_einrede(pf: Pfandrecht, verpfaender: Person) kind derived {
    label de official "steht dem Pfandrecht eine Einrede entgegen, durch welche die Geltendmachung dauernd ausgeschlossen wird, so kann der Verpfänder die Rückgabe verlangen (§ 1254)";
    label en unofficial "where a defence permanently bars assertion of the pledge, the pledgor may demand the thing back (§ 1254)";
}
pub relation pfandrecht_gilt_als_nicht_erloschen(pf: Pfandrecht) kind derived {
    label de official "das Pfandrecht gilt als nicht erloschen, soweit der Eigentümer ein rechtliches Interesse an seinem Fortbestehen hat (§ 1256 Abs. 2)";
    label en unofficial "the pledge is deemed not extinguished in so far as the owner has a legal interest in its continuance (§ 1256 (2))";
}
pub relation vorschriften_ueber_das_vertragspfand_anwendbar(pf: Pfandrecht) kind derived {
    label de official "die Vorschriften über das durch Rechtsgeschäft bestellte Pfandrecht finden auf ein kraft Gesetzes entstandenes Pfandrecht entsprechende Anwendung (§ 1257)";
    label en unofficial "the rules on the contractual pledge apply accordingly to a pledge arising by operation of law (§ 1257)";
}
pub relation gewerbliche_verwertung_zulaessig(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "Eigentümer und Pfandgläubiger können die freihändige Verwertung oder den Eigentumsübergang bei Fälligkeit vereinbaren; §§ 1229 und 1233 bis 1239 finden keine Anwendung (§ 1259)";
    label en unofficial "owner and pledgee may agree on private realisation or transfer of ownership on maturity; §§ 1229 and 1233 to 1239 do not apply (§ 1259)";
}
pub relation aufhebung_der_gemeinschaft_verlangbar(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "nach dem Eintritt der Verkaufsberechtigung kann der Pfandgläubiger die Aufhebung der Gemeinschaft verlangen, ohne dass es der Zustimmung des Miteigentümers bedarf (§ 1258 Abs. 2 Satz 2)";
    label en unofficial "once the right of sale has arisen the pledgee may demand dissolution of the co-ownership without the co-owner's consent (§ 1258 (2) sentence 2)";
}

// --- §§ 1204–1209: Inhalt, Bestellung, gutgläubiger Erwerb, Rang -------------------------------------------

@source(BGB_P1204) {
    rule BefriedigungAusDerSache(pf: Pfandrecht, s: Sache, glaeubiger: Person, a: Anspruch) strict {
        label de official "Eine bewegliche Sache kann zur Sicherung einer Forderung in der Weise belastet werden, dass der Gläubiger berechtigt ist, Befriedigung aus der Sache zu suchen (Pfandrecht) (§ 1204 Abs. 1)";
        label en unofficial "A movable thing may be encumbered to secure a claim so that the creditor may seek satisfaction from it (pledge) (§ 1204 (1))";
        when belastungsgegenstand_sache(pf, s) and de.bgb.besitz_eigentum::bewegliche_sache(s)
            and pfandglaeubiger(pf, glaeubiger) and gesicherte_forderung(pf, a) and pfandrecht_entstanden(pf, glaeubiger);
        then befriedigung_aus_der_sache_zulaessig(pf, glaeubiger);
    }
    rule PfandrechtFuerKuenftigeForderung(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Das Pfandrecht kann auch für eine künftige oder eine bedingte Forderung bestellt werden (§ 1204 Abs. 2)";
        label en unofficial "The pledge may also be created for a future or conditional claim (§ 1204 (2))";
        when pfandrecht_entstanden(pf, glaeubiger) and kuenftige_oder_bedingte_forderung_des_pfandes(pf);
        then befriedigung_aus_der_sache_zulaessig(pf, glaeubiger);
    }
}

@source(BGB_P1205) {
    rule BestellungDurchUebergabeUndEinigung(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Zur Bestellung des Pfandrechts ist erforderlich, dass der Eigentümer die Sache dem Gläubiger übergibt und beide darüber einig sind, dass dem Gläubiger das Pfandrecht zustehen soll (§ 1205 Abs. 1 Satz 1)";
        label en unofficial "Creation of the pledge requires that the owner hands the thing over to the creditor and both agree that the pledge is to belong to the creditor (§ 1205 (1) sentence 1)";
        when pfandglaeubiger(pf, glaeubiger) and einigung_ueber_das_pfandrecht(pf) and sache_dem_glaeubiger_uebergeben(pf)
            and not sache_gehoert_dem_verpfaender_nicht(pf);
        then pfandrecht_entstanden(pf, glaeubiger);
    }
    rule EinigungGenuegtBeiBestehendemBesitz(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Ist der Gläubiger im Besitz der Sache, so genügt die Einigung über die Entstehung des Pfandrechts (§ 1205 Abs. 1 Satz 2)";
        label en unofficial "If the creditor is in possession of the thing, the agreement on the creation of the pledge suffices (§ 1205 (1) sentence 2)";
        when pfandglaeubiger(pf, glaeubiger) and einigung_ueber_das_pfandrecht(pf) and glaeubiger_bereits_im_besitz(pf)
            and not sache_gehoert_dem_verpfaender_nicht(pf);
        then pfandrecht_entstanden(pf, glaeubiger);
    }
    rule UebergabeersatzDurchMittelbarenBesitzUndAnzeige(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Die Übergabe einer im mittelbaren Besitz des Eigentümers befindlichen Sache kann dadurch ersetzt werden, dass der Eigentümer den mittelbaren Besitz auf den Pfandgläubiger überträgt und die Verpfändung dem Besitzer anzeigt (§ 1205 Abs. 2)";
        label en unofficial "Handing over a thing in the owner's indirect possession may be replaced by transferring indirect possession to the pledgee and notifying the possessor (§ 1205 (2))";
        when pfandglaeubiger(pf, glaeubiger) and einigung_ueber_das_pfandrecht(pf)
            and mittelbarer_besitz_uebertragen_und_verpfaendung_angezeigt(pf)
            and not sache_gehoert_dem_verpfaender_nicht(pf);
        then pfandrecht_entstanden(pf, glaeubiger);
    }
}

@source(BGB_P1206)
rule UebergabeersatzDurchMitbesitz(pf: Pfandrecht, glaeubiger: Person) strict {
    label de official "Anstelle der Übergabe der Sache genügt die Einräumung des Mitbesitzes, wenn sich die Sache unter dem Mitverschluss des Gläubigers befindet oder, falls sie im Besitz eines Dritten ist, die Herausgabe nur an den Eigentümer und den Gläubiger gemeinschaftlich erfolgen kann (§ 1206)";
    label en unofficial "Instead of handing over, granting co-possession suffices where the thing is under the creditor's joint lock or, if held by a third party, may be released only jointly (§ 1206)";
    when pfandglaeubiger(pf, glaeubiger) and einigung_ueber_das_pfandrecht(pf)
        and mitbesitz_eingeraeumt_unter_mitverschluss(pf) and not sache_gehoert_dem_verpfaender_nicht(pf);
    then pfandrecht_entstanden(pf, glaeubiger);
}

@source(BGB_P1207) {
    rule GutglaeubigerErwerbAusgeschlossenDurchKenntnis(pf: Pfandrecht) strict {
        label de official "Gehört die Sache nicht dem Verpfänder, so finden die §§ 932, 934, 935 entsprechende Anwendung (§ 1207); bei Kenntnis des Pfandgläubigers ist der Erwerb ausgeschlossen (§ 932 Abs. 2)";
        label en unofficial "Where the thing does not belong to the pledgor, §§ 932, 934, 935 apply accordingly (§ 1207); knowledge of the pledgee excludes acquisition (§ 932 (2))";
        when sache_gehoert_dem_verpfaender_nicht(pf) and kenntnis_vom_fehlenden_eigentum_des_verpfaenders(pf);
        then gutglaeubiger_pfandrechtserwerb_ausgeschlossen(pf);
    }
    rule GutglaeubigerErwerbAusgeschlossenBeiAbhandenkommen(pf: Pfandrecht) strict {
        label de official "Ist die Sache dem Eigentümer abhanden gekommen, so ist der gutgläubige Erwerb ausgeschlossen (§ 1207 über § 935)";
        label en unofficial "Where the thing was lost by the owner, good-faith acquisition is excluded (§ 1207 via § 935)";
        when sache_gehoert_dem_verpfaender_nicht(pf) and pfandsache_abhanden_gekommen(pf);
        then gutglaeubiger_pfandrechtserwerb_ausgeschlossen(pf);
    }
    rule GuterGlaubeDesPfandglaeubigers(pf: Pfandrecht) strict {
        label de official "Der gute Glaube des Pfandgläubigers ist die AUSDRÜCKLICHE Verneinung beider Ausschlussgründe: weder Kenntnis (§ 932 Abs. 2) noch Abhandenkommen (§ 935). Ein `not` über den abgeleiteten Ausschlusskopf allein hätte nie gegriffen, weil klassische Verneinung einen festgestellten negativen Literal verlangt";
        label en unofficial "The pledgee's good faith is the EXPLICIT denial of both grounds of exclusion: neither knowledge (§ 932 (2)) nor loss of possession (§ 935). A `not` over the derived exclusion head alone would never fire, since classical negation requires an established negative literal";
        when sache_gehoert_dem_verpfaender_nicht(pf) and not kenntnis_vom_fehlenden_eigentum_des_verpfaenders(pf)
            and not pfandsache_abhanden_gekommen(pf);
        then guter_glaube_des_pfandglaeubigers(pf);
    }
    rule GutglaeubigerErwerbDesPfandrechts(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Gehört die Sache nicht dem Verpfänder, so erwirbt der gutgläubige Pfandgläubiger das Pfandrecht gleichwohl (§ 1207 über § 932)";
        label en unofficial "Where the thing does not belong to the pledgor, a pledgee in good faith nevertheless acquires the pledge (§ 1207 via § 932)";
        when pfandglaeubiger(pf, glaeubiger) and einigung_ueber_das_pfandrecht(pf) and sache_dem_glaeubiger_uebergeben(pf)
            and guter_glaube_des_pfandglaeubigers(pf);
        then pfandrecht_entstanden(pf, glaeubiger);
    }
}

@source(BGB_P1208)
rule PfandrechtGehtDemRechtDesDrittenVor(pf: Pfandrecht, dritter: Person, glaeubiger: Person) strict {
    label de official "Ist die Sache mit dem Recht eines Dritten belastet, so geht das Pfandrecht dem Recht vor, es sei denn, dass der Pfandgläubiger zur Zeit des Erwerbs in Ansehung des Rechts nicht in gutem Glauben ist (§ 1208 Satz 1)";
    label en unofficial "Where the thing is encumbered with a third party's right, the pledge ranks ahead of it unless the pledgee was not in good faith as to that right at the time of acquisition (§ 1208 sentence 1)";
    when pfandrecht_entstanden(pf, glaeubiger) and recht_eines_dritten_an_der_pfandsache(pf, dritter)
        and not nicht_in_gutem_glauben_hinsichtlich_des_rechts(pf, dritter) and not pfandsache_abhanden_gekommen(pf);
    then pfandrecht_geht_dem_recht_des_dritten_vor(pf, dritter);
}

@source(BGB_P1208)
pub external judgment relation nicht_in_gutem_glauben_hinsichtlich_des_rechts(pf: Pfandrecht, dritter: Person) {
    authority Court;
    label de official "der Pfandgläubiger ist zur Zeit des Erwerbs des Pfandrechts in Ansehung des Rechts des Dritten nicht in gutem Glauben (§ 1208 Satz 1) — Wertung, wie bei § 932 Abs. 2";
    label en unofficial "the pledgee was not in good faith as to the third party's right at the time of acquisition (§ 1208 sentence 1) — evaluation, as under § 932 (2)";
}

@source(BGB_P1209)
rule RangNachDerZeitDerBestellung(frueher: Pfandrecht, spaeter: Pfandrecht, s: Sache, tf: Date, ts: Date) strict {
    label de official "Für den Rang des Pfandrechts ist die Zeit der Bestellung auch dann maßgebend, wenn es für eine künftige oder eine bedingte Forderung bestellt ist (§ 1209)";
    label en unofficial "The time of creation governs the rank of the pledge even where it is created for a future or conditional claim (§ 1209)";
    when belastungsgegenstand_sache(frueher, s) and belastungsgegenstand_sache(spaeter, s)
        and bestellt_am(frueher, tf) and bestellt_am(spaeter, ts) and tf < ts;
    then pfandrang_vor(frueher, spaeter);
}

// --- §§ 1210–1216: Umfang, Einreden, Nutzungen, Verwahrung ------------------------------------------------

@source(BGB_P1210) {
    rule PfandHaftetFuerKostenUndVerwendungen(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Das Pfand haftet für die Ansprüche des Pfandgläubigers auf Ersatz von Verwendungen, für die Kosten der Kündigung und der Rechtsverfolgung sowie für die Kosten des Pfandverkaufs (§ 1210 Abs. 2)";
        label en unofficial "The pledge is liable for the pledgee's claims to reimbursement of outlays and for the costs of termination, enforcement and sale (§ 1210 (2))";
        when pfandrecht_entstanden(pf, glaeubiger);
        then pfand_haftet_fuer_kosten_und_verwendungen(pf);
    }
    rule HaftungWirdNichtErweitert(pf: Pfandrecht, glaeubiger: Person, schuldner: Person) strict {
        label de official "Ist der persönliche Schuldner nicht der Eigentümer des Pfandes, so wird durch ein Rechtsgeschäft, das der Schuldner nach der Verpfändung vornimmt, die Haftung nicht erweitert (§ 1210 Abs. 1 Satz 2)";
        label en unofficial "Where the personal debtor is not the owner of the pledged thing, a transaction of the debtor after the pledging does not extend the liability (§ 1210 (1) sentence 2)";
        when pfandrecht_entstanden(pf, glaeubiger) and persoenlicher_schuldner(pf, schuldner)
            and verpfaender_ist_nicht_persoenlicher_schuldner(pf);
        then haftung_nicht_erweitert(pf);
    }
}

pub relation verpfaender_ist_nicht_persoenlicher_schuldner(pf: Pfandrecht) kind empirical {
    label de official "der Verpfänder ist nicht der persönliche Schuldner (§ 1210 Abs. 1 Satz 2, § 1211 Abs. 2, § 1225 Satz 1) — ausdrückliche Eingabe des Falls";
    label en unofficial "the pledgor is not the personal debtor (§ 1210 (1) sentence 2, § 1211 (2), § 1225 sentence 1) — explicit case input";
}

@source(BGB_P1211) {
    rule EinredenDesSchuldnersGegenDasPfandrecht(e: Einrede, pf: Pfandrecht, p: Person) strict {
        label de official "Der Verpfänder kann dem Pfandgläubiger gegenüber die dem persönlichen Schuldner gegen die Forderung sowie die nach § 770 einem Bürgen zustehenden Einreden geltend machen (§ 1211 Abs. 1 Satz 1)";
        label en unofficial "The pledgor may raise against the pledgee the defences of the personal debtor and those of a surety under § 770 (§ 1211 (1) sentence 1)";
        when verpfaender(pf, p) and einrede_des_persoenlichen_schuldners(e, pf);
        then einrede_gegen_das_pfandrecht_geltend_zu_machen(e, pf, p);
    }
    rule VerzichtDesSchuldnersSchadetDemVerpfaenderNicht(e: Einrede, pf: Pfandrecht, p: Person) strict {
        label de official "Ist der Verpfänder nicht der persönliche Schuldner, so verliert er eine Einrede nicht dadurch, dass dieser auf sie verzichtet (§ 1211 Abs. 2)";
        label en unofficial "Where the pledgor is not the personal debtor, they do not lose a defence because the debtor waives it (§ 1211 (2))";
        when verpfaender(pf, p) and einrede_des_persoenlichen_schuldners(e, pf)
            and verpfaender_ist_nicht_persoenlicher_schuldner(pf) and persoenlicher_schuldner_hat_verzichtet(e);
        then einrede_gegen_das_pfandrecht_geltend_zu_machen(e, pf, p);
    }
}

@source(BGB_P1213)
presumption VermutungDesFruchtbezugsrechts(pf: Pfandrecht) {
    label de official "Ist eine von Natur Frucht tragende Sache dem Pfandgläubiger zum Alleinbesitz übergeben, so ist im Zweifel anzunehmen, dass der Pfandgläubiger zum Fruchtbezug berechtigt sein soll (§ 1213 Abs. 2)";
    label en unofficial "Where a thing naturally bearing fruits is handed over to the pledgee for sole possession, it is presumed that the pledgee is entitled to take the fruits (§ 1213 (2))";
    when von_natur_frucht_tragende_sache_im_alleinbesitz(pf);
    presume fruchtbezugsrecht_vermutet(pf);
    unless von_natur_frucht_tragende_sache_im_alleinbesitz(pf) and abweichende_bestimmung_ueber_die_nutzungen(pf) then not fruchtbezugsrecht_vermutet(pf);
}

@source(BGB_P1214)
rule ReinertragWirdAngerechnet(pf: Pfandrecht, betrag: Money) strict {
    label de official "Der Reinertrag der Nutzungen wird auf die geschuldete Leistung und, wenn Kosten und Zinsen zu entrichten sind, zunächst auf diese angerechnet; abweichende Bestimmungen sind zulässig (§ 1214 Abs. 2, Abs. 3)";
    label en unofficial "The net proceeds are credited against the performance owed and, where costs and interest are payable, first against these; deviating provisions are admissible (§ 1214 (2), (3))";
    when nutzungspfand_vereinbart(pf) and reinertrag_der_nutzungen(pf, betrag)
        and not abweichende_bestimmung_ueber_die_nutzungen(pf);
    then reinertrag_anzurechnen(pf, betrag);
}

@source(BGB_P1215)
rule VerwahrungspflichtDesPfandglaeubigers(pf: Pfandrecht, glaeubiger: Person) strict {
    label de official "Der Pfandgläubiger ist zur Verwahrung des Pfandes verpflichtet (§ 1215)";
    label en unofficial "The pledgee is obliged to keep the pledged thing safe (§ 1215)";
    when pfandrecht_entstanden(pf, glaeubiger);
    then verwahrungspflicht(pf, glaeubiger);
}

@source(BGB_P1216)
rule WegnahmerechtDerEinrichtung(pf: Pfandrecht, glaeubiger: Person) strict {
    label de official "Der Pfandgläubiger ist berechtigt, eine Einrichtung, mit der er das Pfand versehen hat, wegzunehmen (§ 1216 Satz 2)";
    label en unofficial "The pledgee is entitled to remove an installation with which they fitted the thing (§ 1216 sentence 2)";
    when pfandrecht_entstanden(pf, glaeubiger) and einrichtung_angebracht(pf);
    then wegnahmerecht_der_einrichtung(pf, glaeubiger);
}

// --- §§ 1217–1222: Rechtsverletzung, drohender Verderb, Verkaufsvorbereitung ------------------------------

@source(BGB_P1217) {
    rule HinterlegungBeiErheblicherRechtsverletzung(pf: Pfandrecht, verpfaender: Person) strict {
        label de official "Verletzt der Pfandgläubiger die Rechte des Verpfänders in erheblichem Maße und setzt er das verletzende Verhalten ungeachtet einer Abmahnung fort, so kann der Verpfänder verlangen, dass das Pfand auf Kosten des Pfandgläubigers hinterlegt wird (§ 1217 Abs. 1)";
        label en unofficial "If the pledgee substantially infringes the pledgor's rights and continues despite a warning, the pledgor may demand deposit of the thing at the pledgee's cost (§ 1217 (1))";
        when verpfaender(pf, verpfaender) and rechte_des_verpfaenders_erheblich_verletzt(pf) and abmahnung_des_verpfaenders(pf)
            and not pfand_eignet_sich_nicht_zur_hinterlegung(pf);
        then anspruch_auf_hinterlegung_oder_ablieferung(pf, verpfaender);
    }
    rule AblieferungAnEinenVerwahrer(pf: Pfandrecht, verpfaender: Person) strict {
        label de official "Eignet sich das Pfand nicht zur Hinterlegung, so ist es an einen gerichtlich zu bestellenden Verwahrer abzuliefern (§ 1217 Abs. 1)";
        label en unofficial "If the thing is not suitable for deposit, it is to be delivered to a court-appointed custodian (§ 1217 (1))";
        when verpfaender(pf, verpfaender) and rechte_des_verpfaenders_erheblich_verletzt(pf) and abmahnung_des_verpfaenders(pf)
            and pfand_eignet_sich_nicht_zur_hinterlegung(pf);
        then anspruch_auf_hinterlegung_oder_ablieferung(pf, verpfaender);
    }
}

@source(BGB_P1218) {
    rule RueckgabeGegenAnderweitigeSicherheit(pf: Pfandrecht, verpfaender: Person) strict {
        label de official "Ist der Verderb des Pfandes oder eine wesentliche Minderung des Wertes zu besorgen, so kann der Verpfänder die Rückgabe des Pfandes gegen anderweitige Sicherheitsleistung verlangen (§ 1218 Abs. 1)";
        label en unofficial "If spoilage or a substantial reduction in value is to be feared, the pledgor may demand return of the thing against other security (§ 1218 (1))";
        when verpfaender(pf, verpfaender) and verderb_oder_wesentliche_wertminderung_zu_besorgen(pf)
            and anderweitige_sicherheit_geleistet(pf);
        then anspruch_auf_rueckgabe_gegen_sicherheitsleistung(pf, verpfaender);
    }
    rule AnzeigepflichtBeiDrohendemVerderb(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Der Pfandgläubiger hat dem Verpfänder von dem drohenden Verderb unverzüglich Anzeige zu machen, sofern nicht die Anzeige untunlich ist (§ 1218 Abs. 2)";
        label en unofficial "The pledgee must notify the pledgor of the imminent spoilage without undue delay unless the notice is impracticable (§ 1218 (2))";
        when pfandglaeubiger(pf, glaeubiger) and verderb_oder_wesentliche_wertminderung_zu_besorgen(pf)
            and not anzeige_untunlich(pf);
        then anzeigepflicht_bei_drohendem_verderb(pf, glaeubiger);
    }
}

@source(BGB_P1219) {
    rule OeffentlicheVersteigerungBeiGefaehrdung(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Wird durch den drohenden Verderb oder eine zu besorgende wesentliche Minderung des Wertes die Sicherheit des Pfandgläubigers gefährdet, so kann dieser das Pfand öffentlich versteigern lassen (§ 1219 Abs. 1)";
        label en unofficial "If the pledgee's security is endangered by imminent spoilage or a substantial reduction in value, they may have the thing publicly auctioned (§ 1219 (1))";
        when pfandglaeubiger(pf, glaeubiger) and verderb_oder_wesentliche_wertminderung_zu_besorgen(pf)
            and sicherheit_des_pfandglaeubigers_gefaehrdet(pf);
        then oeffentliche_versteigerung_bei_verderb_zulaessig(pf, glaeubiger);
    }
    rule ErloesTrittAnDieStelleDesPfandes(pf: Pfandrecht, glaeubiger: Person, betrag: Money) strict {
        label de official "Der Erlös tritt an die Stelle des Pfandes; auf Verlangen des Verpfänders ist er zu hinterlegen (§ 1219 Abs. 2)";
        label en unofficial "The proceeds take the place of the pledged thing; at the pledgor's request they are to be deposited (§ 1219 (2))";
        when oeffentliche_versteigerung_bei_verderb_zulaessig(pf, glaeubiger) and erloes_aus_dem_pfand(pf, betrag);
        then ueberschuss_tritt_an_die_stelle_des_pfandes(pf, betrag);
    }
}

@source(BGB_P1220) {
    rule SchadensersatzBeiUnterlassenerBenachrichtigung(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Der Pfandgläubiger hat den Verpfänder von der Versteigerung unverzüglich zu benachrichtigen; im Falle der Unterlassung ist er zum Schadensersatz verpflichtet (§ 1220 Abs. 2)";
        label en unofficial "The pledgee must notify the pledgor of the auction without undue delay; on failure to do so they must pay damages (§ 1220 (2))";
        when oeffentliche_versteigerung_bei_verderb_zulaessig(pf, glaeubiger) and benachrichtigung_unterblieben(pf)
            and not anzeige_untunlich(pf);
        then schadensersatzpflicht_des_pfandglaeubigers(pf, glaeubiger);
    }
    rule VersteigerungBeiWertminderungBrauchtFristablauf(pf: Pfandrecht, glaeubiger: Person, ta: Date) strict {
        label de official "Im Falle der Wertminderung ist außer der Androhung erforderlich, dass der Pfandgläubiger dem Verpfänder zur Leistung anderweitiger Sicherheit eine angemessene Frist bestimmt hat und diese verstrichen ist (§ 1220 Abs. 1 Satz 2)";
        label en unofficial "In case of a reduction in value, besides the threat it is required that the pledgee set the pledgor a reasonable period to furnish other security and that it has expired (§ 1220 (1) sentence 2)";
        when pfandglaeubiger(pf, glaeubiger) and sicherheit_des_pfandglaeubigers_gefaehrdet(pf)
            and versteigerung_angedroht_am(pf, ta) and angemessene_frist_zur_sicherheitsleistung_bestimmt(pf);
        then oeffentliche_versteigerung_bei_verderb_zulaessig(pf, glaeubiger);
    }
}

pub relation benachrichtigung_unterblieben(pf: Pfandrecht) kind empirical {
    label de official "die Benachrichtigung des Verpfänders von der Versteigerung ist unterblieben (§ 1220 Abs. 2)";
    label en unofficial "notification of the pledgor about the auction has been omitted (§ 1220 (2))";
}

@source(BGB_P1221)
rule FreihaendigerVerkaufBeiBoersenpreis(pf: Pfandrecht, glaeubiger: Person) strict {
    label de official "Hat das Pfand einen Börsen- oder Marktpreis, so kann der Pfandgläubiger den Verkauf aus freier Hand durch einen öffentlich ermächtigten Handelsmakler oder eine zur öffentlichen Versteigerung befugte Person zum laufenden Preis bewirken (§ 1221)";
    label en unofficial "Where the thing has a stock-exchange or market price, the pledgee may effect a private sale at the current price through an authorised broker or auctioneer (§ 1221)";
    when verkaufsberechtigung(pf, glaeubiger) and boersen_oder_marktpreis(pf);
    then freihaendiger_verkauf_zulaessig(pf, glaeubiger);
}

@source(BGB_P1222)
rule JedesPfandHaftetFuerDieGanzeForderung(pf: Pfandrecht, glaeubiger: Person) strict {
    label de official "Besteht das Pfandrecht an mehreren Sachen, so haftet jede für die ganze Forderung (§ 1222)";
    label en unofficial "Where the pledge exists on several things, each is liable for the whole claim (§ 1222)";
    when pfandrecht_entstanden(pf, glaeubiger);
    then jedes_pfand_haftet_fuer_die_ganze_forderung(pf);
}

// --- §§ 1223–1227: Rückgabe, Einlösung, Übergang, Verjährung, Schutz ---------------------------------------

@source(BGB_P1223) {
    rule RueckgabepflichtNachErloeschen(pf: Pfandrecht, glaeubiger: Person, verpfaender: Person) strict {
        label de official "Der Pfandgläubiger ist verpflichtet, das Pfand nach dem Erlöschen des Pfandrechts dem Verpfänder zurückzugeben (§ 1223 Abs. 1)";
        label en unofficial "The pledgee must return the thing to the pledgor after the pledge is extinguished (§ 1223 (1))";
        when pfandglaeubiger(pf, glaeubiger) and verpfaender(pf, verpfaender) and pfandrecht_erloschen(pf);
        then rueckgabepflicht_nach_erloeschen(pf, glaeubiger, verpfaender);
    }
    rule EinloesungsrechtDesVerpfaenders(pf: Pfandrecht, verpfaender: Person) strict {
        label de official "Der Verpfänder kann die Rückgabe des Pfandes gegen Befriedigung des Pfandgläubigers verlangen, sobald der Schuldner zur Leistung berechtigt ist (§ 1223 Abs. 2)";
        label en unofficial "The pledgor may demand return of the thing against satisfaction of the pledgee once the debtor is entitled to perform (§ 1223 (2))";
        when verpfaender(pf, verpfaender) and schuldner_zur_leistung_berechtigt(pf);
        then einloesungsrecht_des_verpfaenders(pf, verpfaender);
    }
}

pub relation schuldner_zur_leistung_berechtigt(pf: Pfandrecht) kind empirical {
    label de official "der Schuldner ist zur Leistung berechtigt (§ 1223 Abs. 2, § 1249 Satz 1)";
    label en unofficial "the debtor is entitled to perform (§ 1223 (2), § 1249 sentence 1)";
}
pub relation befriedigung_durch_den_verpfaender(pf: Pfandrecht, betrag: Money) kind empirical {
    key(pf);
    label de official "Betrag, mit dem der Verpfänder den Pfandgläubiger befriedigt hat, auch durch Hinterlegung oder Aufrechnung (§ 1224, § 1225)";
    label en unofficial "amount with which the pledgor satisfied the pledgee, including by deposit or set-off (§ 1224, § 1225)";
}

@source(BGB_P1225)
rule ForderungsuebergangAufDenVerpfaender(pf: Pfandrecht, verpfaender: Person, betrag: Money) strict {
    label de official "Ist der Verpfänder nicht der persönliche Schuldner, so geht, soweit er den Pfandgläubiger befriedigt, die Forderung auf ihn über; § 774 findet entsprechende Anwendung (§ 1225)";
    label en unofficial "Where the pledgor is not the personal debtor, the claim passes to them in so far as they satisfy the pledgee; § 774 applies accordingly (§ 1225)";
    when verpfaender(pf, verpfaender) and verpfaender_ist_nicht_persoenlicher_schuldner(pf)
        and befriedigung_durch_den_verpfaender(pf, betrag);
    then forderung_auf_den_verpfaender_uebergegangen(pf, verpfaender);
}

// --- §§ 1228–1248: Pfandverkauf --------------------------------------------------------------------------

@source(BGB_P1228) {
    rule VerkaufsberechtigungBeiFaelligkeit(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Der Pfandgläubiger ist zum Verkauf berechtigt, sobald die Forderung ganz oder zum Teil fällig ist (§ 1228 Abs. 2 Satz 1)";
        label en unofficial "The pledgee is entitled to sell as soon as the claim is due in whole or in part (§ 1228 (2) sentence 1)";
        when pfandglaeubiger(pf, glaeubiger) and befriedigung_aus_der_sache_zulaessig(pf, glaeubiger)
            and forderung_ganz_oder_zum_teil_faellig(pf) and not geschuldeter_gegenstand_nicht_geld(pf);
        then verkaufsberechtigung(pf, glaeubiger);
    }
    rule VerkaufErstNachUebergangInEineGeldforderung(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Besteht der geschuldete Gegenstand nicht in Geld, so ist der Verkauf erst zulässig, wenn die Forderung in eine Geldforderung übergegangen ist (§ 1228 Abs. 2 Satz 2)";
        label en unofficial "Where the object owed does not consist in money, sale is admissible only once the claim has turned into a monetary claim (§ 1228 (2) sentence 2)";
        when pfandglaeubiger(pf, glaeubiger) and befriedigung_aus_der_sache_zulaessig(pf, glaeubiger)
            and forderung_ganz_oder_zum_teil_faellig(pf) and geschuldeter_gegenstand_nicht_geld(pf)
            and forderung_in_geldforderung_uebergegangen(pf);
        then verkaufsberechtigung(pf, glaeubiger);
    }
}

@source(BGB_P1229)
rule VerfallvereinbarungNichtig(pf: Pfandrecht) strict {
    label de official "Eine vor dem Eintritt der Verkaufsberechtigung getroffene Vereinbarung, nach welcher dem Pfandgläubiger das Eigentum an der Sache zufallen oder übertragen werden soll, ist nichtig (§ 1229)";
    label en unofficial "An agreement made before the right of sale arises, under which ownership is to accrue or be transferred to the pledgee, is void (§ 1229)";
    when verfallvereinbarung_vor_der_verkaufsberechtigung(pf) and not gewerbliche_verwertung_vereinbart(pf);
    then verfallvereinbarung_nichtig(pf);
}

pub relation gewerbliche_verwertung_vereinbart(pf: Pfandrecht) kind derived {
    label de official "die Verwertungsabrede des § 1259 ist getroffen; §§ 1229 und 1233 bis 1239 finden dann keine Anwendung (§ 1259 Satz 3)";
    label en unofficial "the realisation agreement of § 1259 has been made; §§ 1229 and 1233 to 1239 then do not apply (§ 1259 sentence 3)";
}

@source(BGB_P1234) {
    rule VerkaufsfristEreignisAndrohung(pf: Pfandrecht, f: Frist, ta: Date) strict {
        label de official "Der Verkauf darf nicht vor dem Ablauf eines Monats nach der Androhung erfolgen (§ 1234 Abs. 2 Satz 1); der Tag der Androhung wird nicht mitgerechnet (§ 187 Abs. 1)";
        label en unofficial "The sale may not take place before one month has passed since the threat (§ 1234 (2) sentence 1); the day of the threat is not counted (§ 187 (1))";
        when verkaufsandrohungsfrist(pf, f) and versteigerung_angedroht_am(pf, ta) and not anzeige_untunlich(pf);
        then de.bgb.fristen::frist_ereignis(f, ta);
    }
    rule VerkaufsfristEreignisVerkaufsberechtigung(pf: Pfandrecht, f: Frist, tv: Date) strict {
        label de official "Ist die Androhung untunlich, so wird der Monat von dem Eintritt der Verkaufsberechtigung an berechnet (§ 1234 Abs. 2 Satz 2)";
        label en unofficial "Where the threat is impracticable, the month is computed from the day the right of sale arose (§ 1234 (2) sentence 2)";
        when verkaufsandrohungsfrist(pf, f) and verkaufsberechtigung_eingetreten_am(pf, tv) and anzeige_untunlich(pf);
        then de.bgb.fristen::frist_ereignis(f, tv);
    }
    rule VerkaufsfristEinMonat(pf: Pfandrecht, f: Frist) strict {
        label de official "Die Frist des § 1234 Abs. 2 beträgt einen Monat — Monatsschritt nach § 188 Abs. 2, 3";
        label en unofficial "The period of § 1234 (2) is one month — month step under § 188 (2), (3)";
        when verkaufsandrohungsfrist(pf, f);
        then de.bgb.fristen::frist_dauer_kalender(f, 1 calendar_month);
    }
    rule VerkaufFruehestensNachAblaufDerMonatsfrist(pf: Pfandrecht, f: Frist, ende: Date) strict {
        label de official "Der Verkauf darf nicht vor dem Ablauf eines Monats erfolgen (§ 1234 Abs. 2) — WARTEFRIST MIT ADRESSATEN: innerhalb ihrer darf der Verpfänder noch befriedigen (§ 1223 Abs. 2), deshalb gilt die Verlegung des § 193 (Ledger D-11-04)";
        label en unofficial "The sale may not take place before one month has passed (§ 1234 (2)) — a waiting period with an addressee: within it the pledgor may still satisfy the pledgee (§ 1223 (2)), so § 193 applies";
        when verkaufsandrohungsfrist(pf, f) and de.bgb.fristen::frist_ende(f, ende);
        then verkauf_fruehestens_am(pf, ende);
    }
    rule VerkaufVorAblaufIstUnzulaessig(pf: Pfandrecht, ende: Date, tv: Date) strict {
        label de official "Erfolgt der Verkauf vor dem Ablauf der Monatsfrist, so verstößt er gegen § 1234 Abs. 2";
        label en unofficial "A sale before the one-month period has run infringes § 1234 (2)";
        when verkauf_fruehestens_am(pf, ende) and verkauf_erfolgt_am(pf, tv) and tv <= ende;
        then verkauf_zu_frueh(pf);
    }
}

@source(BGB_P1243) {
    rule VeraeusserungNichtRechtmaessigOhneVerkaufsberechtigung(pf: Pfandrecht, glaeubiger: Person, tv: Date) strict {
        label de official "Die Veräußerung des Pfandes ist nicht rechtmäßig, wenn gegen § 1228 Abs. 2 verstoßen wird (§ 1243 Abs. 1)";
        label en unofficial "The disposal is unlawful if § 1228 (2) is infringed (§ 1243 (1))";
        when pfandglaeubiger(pf, glaeubiger) and verkauf_erfolgt_am(pf, tv) and not verkaufsberechtigung(pf, glaeubiger);
        then veraeusserung_nicht_rechtmaessig(pf);
    }
    rule VeraeusserungNichtRechtmaessigOhneOeffentlicheVersteigerung(pf: Pfandrecht, tv: Date) strict {
        label de official "Die Veräußerung ist nicht rechtmäßig, wenn gegen § 1235 verstoßen wird (§ 1243 Abs. 1)";
        label en unofficial "The disposal is unlawful if § 1235 is infringed (§ 1243 (1))";
        when verkauf_erfolgt_am(pf, tv) and not oeffentliche_versteigerung_durchgefuehrt(pf) and not boersen_oder_marktpreis(pf);
        then veraeusserung_nicht_rechtmaessig(pf);
    }
    rule VeraeusserungNichtRechtmaessigOhneBekanntmachung(pf: Pfandrecht, tv: Date) strict {
        label de official "Die Veräußerung ist nicht rechtmäßig, wenn gegen § 1237 Satz 1 verstoßen wird (§ 1243 Abs. 1)";
        label en unofficial "The disposal is unlawful if § 1237 sentence 1 is infringed (§ 1243 (1))";
        when verkauf_erfolgt_am(pf, tv) and oeffentliche_versteigerung_durchgefuehrt(pf) and not oeffentlich_bekannt_gemacht(pf);
        then veraeusserung_nicht_rechtmaessig(pf);
    }
    rule VeraeusserungNichtRechtmaessigUnterDemEdelmetallwert(pf: Pfandrecht, tv: Date) strict {
        label de official "Die Veräußerung ist nicht rechtmäßig, wenn gegen § 1240 verstoßen wird: Gold- und Silbersachen dürfen nicht unter dem Gold- oder Silberwert zugeschlagen werden (§ 1243 Abs. 1)";
        label en unofficial "The disposal is unlawful if § 1240 is infringed: articles of gold or silver may not be knocked down below their metal value (§ 1243 (1))";
        when verkauf_erfolgt_am(pf, tv) and gold_oder_silbersache(pf) and zuschlag_unter_dem_edelmetallwert(pf);
        then veraeusserung_nicht_rechtmaessig(pf);
    }
    rule VeraeusserungNichtRechtmaessigZuVielePfaender(pf: Pfandrecht, tv: Date) strict {
        label de official "Die Veräußerung ist nicht rechtmäßig, wenn gegen § 1230 Satz 2 verstoßen wird: es dürfen nur so viele Pfänder zum Verkauf gebracht werden, als zur Befriedigung erforderlich sind (§ 1243 Abs. 1)";
        label en unofficial "The disposal is unlawful if § 1230 sentence 2 is infringed: only as many things may be sold as are necessary for satisfaction (§ 1243 (1))";
        when verkauf_erfolgt_am(pf, tv) and not nur_so_viele_pfaender_verkauft_wie_erforderlich(pf);
        then veraeusserung_nicht_rechtmaessig(pf);
    }
    rule SchadensersatzBeiVerletzungAndererVorschriften(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Verletzt der Pfandgläubiger eine andere für den Verkauf geltende Vorschrift, so ist er zum Schadensersatz verpflichtet, wenn ihm ein Verschulden zur Last fällt (§ 1243 Abs. 2)";
        label en unofficial "If the pledgee infringes another rule governing the sale, they must pay damages if at fault (§ 1243 (2))";
        when pfandglaeubiger(pf, glaeubiger) and verkauf_zu_frueh(pf) and verschulden_des_pfandglaeubigers(pf);
        then schadensersatzpflicht_des_pfandglaeubigers(pf, glaeubiger);
    }
}

@source(BGB_P1242) {
    rule VeraeusserungIstRechtmaessig(pf: Pfandrecht, glaeubiger: Person, ende: Date, tv: Date) strict {
        label de official "Rechtmäßig ist die Veräußerung, wenn Verkaufsberechtigung, Monatsfrist, öffentliche Versteigerung, Bekanntmachung und der Edelmetallwert gewahrt sind (§ 1242 Abs. 1, § 1243 Abs. 1 im Gegenschluss)";
        label en unofficial "The disposal is lawful where the right of sale, the one-month period, public auction, announcement and the precious-metal value have been observed (§ 1242 (1), § 1243 (1) a contrario)";
        when verkaufsberechtigung(pf, glaeubiger) and verkauf_fruehestens_am(pf, ende) and verkauf_erfolgt_am(pf, tv) and tv > ende
            and oeffentliche_versteigerung_durchgefuehrt(pf) and oeffentlich_bekannt_gemacht(pf)
            and nur_so_viele_pfaender_verkauft_wie_erforderlich(pf) and not zuschlag_unter_dem_edelmetallwert(pf);
        then veraeusserung_rechtmaessig(pf);
    }
    rule ErwerberErlangtDieRechteWieVomEigentuemer(pf: Pfandrecht) strict {
        label de official "Durch die rechtmäßige Veräußerung des Pfandes erlangt der Erwerber die gleichen Rechte, wie wenn er die Sache von dem Eigentümer erworben hätte; Pfandrechte an der Sache erlöschen, auch wenn sie dem Erwerber bekannt waren (§ 1242)";
        label en unofficial "Through the lawful disposal the acquirer obtains the same rights as if acquiring from the owner; pledges on the thing are extinguished even if known to them (§ 1242)";
        when veraeusserung_rechtmaessig(pf);
        then erwerber_erlangt_die_rechte_wie_vom_eigentuemer(pf);
    }
}

@source(BGB_P1247) {
    rule ErloesGebuehrtDemPfandglaeubigerInHoeheDerForderung(pf: Pfandrecht, erloes: Money, forderung: Money) strict {
        label de official "Soweit der Erlös aus dem Pfande dem Pfandgläubiger zu seiner Befriedigung gebührt, gilt die Forderung als von dem Eigentümer berichtigt (§ 1247 Satz 1) — reicht der Erlös, so gebührt ihm der Forderungsbetrag";
        label en unofficial "In so far as the proceeds accrue to the pledgee, the claim counts as settled by the owner (§ 1247 sentence 1) — where the proceeds suffice, the amount of the claim accrues to them";
        when veraeusserung_rechtmaessig(pf) and erloes_aus_dem_pfand(pf, erloes) and forderungsbetrag(pf, forderung)
            and erloes >= forderung;
        then erloes_gebuehrt_dem_pfandglaeubiger(pf, forderung);
    }
    rule ErloesReichtNichtAus(pf: Pfandrecht, erloes: Money, forderung: Money) strict {
        label de official "Reicht der Erlös nicht aus, so gebührt dem Pfandgläubiger der ganze Erlös und die Forderung gilt nur insoweit als berichtigt (§ 1247 Satz 1)";
        label en unofficial "Where the proceeds do not suffice, the whole proceeds accrue to the pledgee and the claim counts as settled only to that extent (§ 1247 sentence 1)";
        when veraeusserung_rechtmaessig(pf) and erloes_aus_dem_pfand(pf, erloes) and forderungsbetrag(pf, forderung)
            and erloes < forderung;
        then erloes_gebuehrt_dem_pfandglaeubiger(pf, erloes);
    }
    rule ForderungGiltAlsBerichtigt(pf: Pfandrecht, betrag: Money) strict {
        label de official "Soweit der Erlös dem Pfandgläubiger gebührt, gilt die Forderung als von dem Eigentümer berichtigt (§ 1247 Satz 1)";
        label en unofficial "In so far as the proceeds accrue to the pledgee, the claim counts as settled by the owner (§ 1247 sentence 1)";
        when erloes_gebuehrt_dem_pfandglaeubiger(pf, betrag);
        then forderung_gilt_als_berichtigt(pf, betrag);
    }
    rule UeberschussTrittAnDieStelleDesPfandes(pf: Pfandrecht, erloes: Money, forderung: Money) strict {
        label de official "Im Übrigen tritt der Erlös an die Stelle des Pfandes (§ 1247 Satz 2)";
        label en unofficial "For the rest the proceeds take the place of the pledged thing (§ 1247 sentence 2)";
        when veraeusserung_rechtmaessig(pf) and erloes_aus_dem_pfand(pf, erloes) and forderungsbetrag(pf, forderung)
            and erloes > forderung;
        then ueberschuss_tritt_an_die_stelle_des_pfandes(pf, erloes - forderung);
    }
}

@source(BGB_P1248)
presumption VermutungDesEigentumsDesVerpfaenders(pf: Pfandrecht, verpfaender: Person) {
    label de official "Bei dem Verkauf des Pfandes gilt zugunsten des Pfandgläubigers der Verpfänder als der Eigentümer, es sei denn, dass der Pfandgläubiger weiß, dass der Verpfänder nicht der Eigentümer ist (§ 1248)";
    label en unofficial "On the sale the pledgor is deemed the owner in favour of the pledgee unless the pledgee knows that they are not (§ 1248)";
    when verpfaender(pf, verpfaender);
    presume verpfaender_gilt_als_eigentuemer(pf, verpfaender);
    unless verpfaender(pf, verpfaender) and kenntnis_vom_fehlenden_eigentum_des_verpfaenders(pf) then not verpfaender_gilt_als_eigentuemer(pf, verpfaender);
}

@source(BGB_P1249)
rule AbloesungsrechtDesRechtsverlierers(pf: Pfandrecht, dritter: Person) strict {
    label de official "Wer durch die Veräußerung des Pfandes ein Recht an dem Pfande verlieren würde, kann den Pfandgläubiger befriedigen, sobald der Schuldner zur Leistung berechtigt ist (§ 1249 Satz 1)";
    label en unofficial "A person who would lose a right in the thing through the disposal may satisfy the pledgee once the debtor is entitled to perform (§ 1249 sentence 1)";
    when recht_eines_dritten_an_der_pfandsache(pf, dritter) and schuldner_zur_leistung_berechtigt(pf);
    then abloesungsrecht_des_rechtsverlierers(pf, dritter);
}

// --- §§ 1250–1259: Übertragung, Erlöschen, gesetzliches und gewerbliches Pfand ------------------------------

pub relation forderung_uebertragen_mit_ausschluss_des_pfandrechts(pf: Pfandrecht) kind empirical {
    label de official "bei der Übertragung der Forderung ist der Übergang des Pfandrechts ausgeschlossen worden (§ 1250 Abs. 2)";
    label en unofficial "on the assignment of the claim the transfer of the pledge was excluded (§ 1250 (2))";
}
pub relation gesicherte_forderung_erloschen(pf: Pfandrecht) kind empirical {
    label de official "die Forderung, für die das Pfandrecht besteht, ist erloschen (§ 1252)";
    label en unofficial "the claim for which the pledge exists is extinguished (§ 1252)";
}
pub relation dauernde_einrede_gegen_das_pfandrecht(pf: Pfandrecht) kind empirical {
    label de official "dem Pfandrecht steht eine Einrede entgegen, durch welche die Geltendmachung dauernd ausgeschlossen wird (§ 1254 Satz 1)";
    label en unofficial "a defence permanently barring assertion of the pledge is available against it (§ 1254 sentence 1)";
}

@source(BGB_P1250)
rule PfandrechtErlischtBeiAusgeschlossenemUebergang(pf: Pfandrecht) strict {
    label de official "Wird bei der Übertragung der Forderung der Übergang des Pfandrechts ausgeschlossen, so erlischt das Pfandrecht (§ 1250 Abs. 2)";
    label en unofficial "If the transfer of the pledge is excluded on assignment of the claim, the pledge is extinguished (§ 1250 (2))";
    when forderung_uebertragen_mit_ausschluss_des_pfandrechts(pf);
    then pfandrecht_erloschen(pf);
}

@source(BGB_P1252)
rule PfandrechtErlischtMitDerForderung(pf: Pfandrecht) strict {
    label de official "Das Pfandrecht erlischt mit der Forderung, für die es besteht (§ 1252)";
    label en unofficial "The pledge is extinguished together with the claim for which it exists (§ 1252)";
    when gesicherte_forderung_erloschen(pf);
    then pfandrecht_erloschen(pf);
}

@source(BGB_P1253)
rule PfandrechtErlischtDurchRueckgabe(pf: Pfandrecht) strict {
    label de official "Das Pfandrecht erlischt, wenn der Pfandgläubiger das Pfand dem Verpfänder oder dem Eigentümer zurückgibt; der Vorbehalt der Fortdauer ist unwirksam (§ 1253 Abs. 1)";
    label en unofficial "The pledge is extinguished if the pledgee returns the thing to the pledgor or owner; a reservation of continuance is ineffective (§ 1253 (1))";
    when pfand_zurueckgegeben(pf);
    then pfandrecht_erloschen(pf);
}

@source(BGB_P1253)
presumption VermutungDerRueckgabe(pf: Pfandrecht) {
    label de official "Ist das Pfand im Besitz des Verpfänders oder des Eigentümers, so wird vermutet, dass es ihm von dem Pfandgläubiger zurückgegeben worden sei; das gilt auch bei einem Dritten, der den Besitz nach der Entstehung des Pfandrechts von ihnen erlangt hat (§ 1253 Abs. 2)";
    label en unofficial "Where the thing is in the pledgor's or owner's possession, it is presumed to have been returned by the pledgee; the same applies to a third party who obtained possession from them after the pledge arose (§ 1253 (2))";
    when pfand_im_besitz_des_verpfaenders_oder_eigentuemers(pf);
    presume rueckgabe_vermutet(pf);
    unless pfand_im_besitz_des_verpfaenders_oder_eigentuemers(pf) and rueckgabe_widerlegt(pf) then not rueckgabe_vermutet(pf);
}

@source(BGB_P1254)
rule AnspruchAufRueckgabeBeiDauernderEinrede(pf: Pfandrecht, verpfaender: Person) strict {
    label de official "Steht dem Pfandrecht eine Einrede entgegen, durch welche die Geltendmachung des Pfandrechts dauernd ausgeschlossen wird, so kann der Verpfänder die Rückgabe des Pfandes verlangen; das gleiche Recht hat der Eigentümer (§ 1254)";
    label en unofficial "Where a defence permanently bars assertion of the pledge, the pledgor may demand return of the thing; the owner has the same right (§ 1254)";
    when verpfaender(pf, verpfaender) and dauernde_einrede_gegen_das_pfandrecht(pf);
    then anspruch_auf_rueckgabe_bei_dauernder_einrede(pf, verpfaender);
}

@source(BGB_P1255) {
    rule AufhebungDurchErklaerung(pf: Pfandrecht) strict {
        label de official "Zur Aufhebung des Pfandrechts durch Rechtsgeschäft genügt die Erklärung des Pfandgläubigers gegenüber dem Verpfänder oder dem Eigentümer, dass er das Pfandrecht aufgebe (§ 1255 Abs. 1)";
        label en unofficial "For surrender of the pledge by legal transaction the pledgee's declaration to the pledgor or owner suffices (§ 1255 (1))";
        when aufhebungserklaerung_des_pfandglaeubigers(pf) and not pfandrecht_mit_fremdem_recht_belastet(pf);
        then pfandrecht_erloschen(pf);
    }
    rule AufhebungBrauchtZustimmungDesDritten(pf: Pfandrecht, dritter: Person) strict {
        label de official "Ist das Pfandrecht mit dem Recht eines Dritten belastet, so ist die Zustimmung des Dritten erforderlich; sie ist unwiderruflich (§ 1255 Abs. 2)";
        label en unofficial "Where the pledge is encumbered with a third party's right, that party's consent is required; it is irrevocable (§ 1255 (2))";
        when aufhebungserklaerung_des_pfandglaeubigers(pf) and pfandrecht_mit_dem_recht_eines_dritten_belastet(pf, dritter)
            and zustimmung_des_dritten_zur_aufhebung(pf, dritter);
        then pfandrecht_erloschen(pf);
    }
}

pub relation pfandrecht_mit_fremdem_recht_belastet(pf: Pfandrecht) kind empirical {
    label de official "das Pfandrecht ist mit dem Recht eines Dritten belastet (§ 1255 Abs. 2, § 1256 Abs. 1 Satz 2) — ausdrückliche Eingabe des Falls";
    label en unofficial "the pledge is encumbered with a third party's right (§ 1255 (2), § 1256 (1) sentence 2) — explicit case input";
}

@source(BGB_P1256) {
    rule PfandrechtErlischtBeiZusammentreffenMitDemEigentum(pf: Pfandrecht) strict {
        label de official "Das Pfandrecht erlischt, wenn es mit dem Eigentum in derselben Person zusammentrifft; das Erlöschen tritt nicht ein, solange die Forderung mit dem Recht eines Dritten belastet ist (§ 1256 Abs. 1)";
        label en unofficial "The pledge is extinguished where it coincides with ownership in the same person; not, however, while the claim is encumbered with a third party's right (§ 1256 (1))";
        when pfandrecht_trifft_mit_dem_eigentum_zusammen(pf) and not pfandrecht_mit_fremdem_recht_belastet(pf)
            and not rechtliches_interesse_am_fortbestehen(pf);
        then pfandrecht_erloschen(pf);
    }
    rule PfandrechtGiltAlsNichtErloschen(pf: Pfandrecht) strict {
        label de official "Das Pfandrecht gilt als nicht erloschen, soweit der Eigentümer ein rechtliches Interesse an dem Fortbestehen des Pfandrechts hat (§ 1256 Abs. 2)";
        label en unofficial "The pledge is deemed not extinguished in so far as the owner has a legal interest in its continuance (§ 1256 (2))";
        when pfandrecht_trifft_mit_dem_eigentum_zusammen(pf) and rechtliches_interesse_am_fortbestehen(pf);
        then pfandrecht_gilt_als_nicht_erloschen(pf);
    }
}

@source(BGB_P1257)
rule VorschriftenGeltenAuchFuerDasGesetzlichePfandrecht(pf: Pfandrecht) strict {
    label de official "Die Vorschriften über das durch Rechtsgeschäft bestellte Pfandrecht finden auf ein kraft Gesetzes entstandenes Pfandrecht entsprechende Anwendung (§ 1257)";
    label en unofficial "The rules on the contractual pledge apply accordingly to a pledge arising by operation of law (§ 1257)";
    when kraft_gesetzes_entstandenes_pfandrecht(pf);
    then vorschriften_ueber_das_vertragspfand_anwendbar(pf);
}

@source(BGB_P1258)
rule AufhebungDerGemeinschaftNachVerkaufsberechtigung(pf: Pfandrecht, glaeubiger: Person) strict {
    label de official "Nach dem Eintritt der Verkaufsberechtigung kann der Pfandgläubiger die Aufhebung der Gemeinschaft verlangen, ohne dass es der Zustimmung des Miteigentümers bedarf (§ 1258 Abs. 2 Satz 2)";
    label en unofficial "Once the right of sale has arisen the pledgee may demand dissolution of the co-ownership without the co-owner's consent (§ 1258 (2) sentence 2)";
    when pfandrecht_am_miteigentumsanteil(pf) and verkaufsberechtigung(pf, glaeubiger);
    then aufhebung_der_gemeinschaft_verlangbar(pf, glaeubiger);
}

@source(BGB_P1259) {
    rule GewerblicheVerwertungVereinbart(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Sind Eigentümer und Pfandgläubiger Unternehmer oder juristische Personen des öffentlichen Rechts, so können sie für die Verwertung des Pfandes mit Börsen- oder Marktpreis schon bei der Verpfändung den freihändigen Verkauf oder den Eigentumsübergang bei Fälligkeit vereinbaren (§ 1259 Satz 1)";
        label en unofficial "Where owner and pledgee are entrepreneurs or public-law legal persons, they may agree already on pledging on a private sale or transfer of ownership on maturity for a thing with a market price (§ 1259 sentence 1)";
        when pfandglaeubiger(pf, glaeubiger) and beide_unternehmer_oder_oeffentlich_rechtlich(pf)
            and boersen_oder_marktpreis(pf) and verwertungsabrede_bei_der_verpfaendung(pf);
        then gewerbliche_verwertung_zulaessig(pf, glaeubiger);
    }
    rule VerwertungsabredeSchaltetDenVerfallverbotAus(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "In diesem Fall finden die §§ 1229 und 1233 bis 1239 keine Anwendung (§ 1259 Satz 3)";
        label en unofficial "In that case §§ 1229 and 1233 to 1239 do not apply (§ 1259 sentence 3)";
        when gewerbliche_verwertung_zulaessig(pf, glaeubiger);
        then gewerbliche_verwertung_vereinbart(pf);
    }
    rule ForderungGiltZumMarktpreisAlsBerichtigt(pf: Pfandrecht, glaeubiger: Person, preis: Money) strict {
        label de official "In diesem Fall gilt die Forderung in Höhe des am Tag der Fälligkeit geltenden Börsen- oder Marktpreises als von dem Eigentümer berichtigt (§ 1259 Satz 2)";
        label en unofficial "In that case the claim counts as settled by the owner in the amount of the market price applying on the maturity date (§ 1259 sentence 2)";
        when gewerbliche_verwertung_zulaessig(pf, glaeubiger) and marktpreis_am_faelligkeitstag(pf, preis);
        then forderung_gilt_als_berichtigt(pf, preis);
    }
}

pub relation marktpreis_am_faelligkeitstag(pf: Pfandrecht, preis: Money) kind empirical {
    key(pf);
    label de official "am Tag der Fälligkeit geltender Börsen- oder Marktpreis des Pfandes (§ 1259 Satz 2) — festgestellte Tatsache";
    label en unofficial "stock-exchange or market price of the pledged thing applying on the maturity date (§ 1259 sentence 2) — established fact";
}
