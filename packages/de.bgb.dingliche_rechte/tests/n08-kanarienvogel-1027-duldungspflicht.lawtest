language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Kanarienvogel zu n07: ohne die ausdrückliche Eingabe „nicht zur Duldung verpflichtet“ ergibt sich der Beseitigungsanspruch nicht — das Schweigen des Falls ist keine Verneinung der Duldungspflicht.
test "Kanarienvogel § 1027: ohne die Eingabe der fehlenden Duldungspflicht kein Beseitigungsanspruch" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": berechtigter(entity_ref("urn:de:bgb:dr:n08:gd"), entity_ref("urn:de:bgb:dr:n08:berechtigter")) { origin case_input; }
        assert "f2": grunddienstbarkeit_beeintraechtigt_durch(entity_ref("urn:de:bgb:dr:n08:gd"), entity_ref("urn:de:bgb:dr:n08:stoerer")) { origin adjudicated; }
    }
    evaluate truth(dienstbarkeit_beseitigungsanspruch(entity_ref("urn:de:bgb:dr:n08:gd"), entity_ref("urn:de:bgb:dr:n08:berechtigter"), entity_ref("urn:de:bgb:dr:n08:stoerer")));
    expect truth_status == NEITHER;
}
