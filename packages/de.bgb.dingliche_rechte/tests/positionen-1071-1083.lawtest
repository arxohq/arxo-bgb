language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

test "§§ 1071, 1082, 1083: Nießbrauch aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1071(entity_ref("urn:dr:n1071"), entity_ref("urn:dr:p1071"), entity_ref("urn:dr:q1071"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1082(entity_ref("urn:dr:n1082"), entity_ref("urn:dr:p1082"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1083(entity_ref("urn:dr:n1083"), entity_ref("urn:dr:p1083"), entity_ref("urn:dr:q1083"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Zustimmung1071, ACTIVE); expect position(Hinterlegung1082, ACTIVE); expect position(Mitwirkung1083, ACTIVE);
}

test "§§ 1071, 1082, 1083: Nießbrauch erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1071(entity_ref("urn:dr:n1071"), entity_ref("urn:dr:p1071"), entity_ref("urn:dr:q1071"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1082(entity_ref("urn:dr:n1082"), entity_ref("urn:dr:p1082"), @2026-01-01) { origin case_input; }
 assert "bg": hinterlegung_1082_geschuldet(entity_ref("urn:dr:n1082")) { origin case_input; }
 assert "c": position_trigger_1083(entity_ref("urn:dr:n1083"), entity_ref("urn:dr:p1083"), entity_ref("urn:dr:q1083"), @2026-01-01) { origin case_input; }
 assert "cg": mitwirkung_1083_geschuldet(entity_ref("urn:dr:n1083"), entity_ref("urn:dr:p1083"), entity_ref("urn:dr:q1083")) { origin case_input; } }
 evaluate positions();
 expect position(Zustimmung1071, ACTIVE); expect position(Hinterlegung1082, SATISFIED); expect position(Mitwirkung1083, SATISFIED);
}
