language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1029: der Besitzer hat das eingetragene Wegerecht zuletzt am 01.02.2025 ausgeübt; die Störung erfolgt am 20.01.2026 — innerhalb eines Jahres.
test "§ 1029: Besitzschutz bei Störung innerhalb eines Jahres seit der letzten Ausübung" {
    given {
        context { legal_time @2026-01-25; decision_time @2026-01-25T09:00:00Z; knowledge_time @2026-01-25T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": dienstbarkeit_im_grundbuch_fuer_den_eigentuemer_eingetragen(entity_ref("urn:de:bgb:dr:n11:gd")) { origin adjudicated; }
        assert "f2": ausuebung_zuletzt_am(entity_ref("urn:de:bgb:dr:n11:gd"), @2025-02-01) { origin adjudicated; }
        assert "f3": stoerung_der_ausuebung_am(entity_ref("urn:de:bgb:dr:n11:gd"), entity_ref("urn:de:bgb:dr:n11:stoerer"), @2026-01-20) { origin adjudicated; }
    }
    evaluate truth(dienstbarkeitsbesitzschutz_anwendbar(entity_ref("urn:de:bgb:dr:n11:gd"), entity_ref("urn:de:bgb:dr:n11:stoerer")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
