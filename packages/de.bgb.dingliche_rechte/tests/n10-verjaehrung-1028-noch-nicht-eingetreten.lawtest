language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu n09: dieselbe Garage und derselbe Beseitigungsanspruch, aber ohne die ausdrückliche Feststellung, dass keine Hemmung vorliegt (§§ 203 ff.) — das Schweigen des Falls ist keine Verneinung der Hemmung, und die Verjährung bleibt unfestgestellt.
test "§ 1028 Abs. 1 Satz 2: ohne Feststellung der fehlenden Hemmung kein Erlöschen" {
    given {
        context { legal_time @2024-01-15; decision_time @2024-01-15T09:00:00Z; knowledge_time @2024-01-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": anlage_die_die_dienstbarkeit_beeintraechtigt_errichtet(entity_ref("urn:de:bgb:dr:n10:gd")) { origin adjudicated; }
        assert "f2": beseitigungsanspruch_wegen_der_anlage_ist(entity_ref("urn:de:bgb:dr:n10:gd"), entity_ref("urn:de:bgb:dr:n10:anspruch")) { origin case_input; }
        assert "f3": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:dr:n10:anspruch"), @2020-03-10) { origin adjudicated; }
        assert "f4": de.bgb.fristen::kenntnis_erlangt_am(entity_ref("urn:de:bgb:dr:n10:anspruch"), @2020-03-10) { origin adjudicated; }
    }
    evaluate truth(grunddienstbarkeit_erloschen_soweit_die_anlage_entgegensteht(entity_ref("urn:de:bgb:dr:n10:gd")));
    expect truth_status == NEITHER;
}
