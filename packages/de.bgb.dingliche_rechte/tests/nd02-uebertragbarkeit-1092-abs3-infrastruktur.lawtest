language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1092 Abs. 3 Satz 1 Nr. 3: eine Energieversorgungs-GmbH hält eine beschränkte persönliche Dienstbarkeit für eine Gasleitung — übertragbar, aber ohne Teilungsbefugnis.
test "§ 1092 Abs. 3 Satz 1, 2: Übertragbarkeit bei Leitungsanlage ohne Teilungsbefugnis" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": bpd_juristischer_person_zustehend(entity_ref("urn:de:bgb:dr:nd02:bpd")) { origin adjudicated; }
        assert "f2": bpd_dient_infrastrukturzweck(entity_ref("urn:de:bgb:dr:nd02:bpd"), LeitungsanlageFuerVersorgung) { origin case_input; }
    }
    evaluate truth(bpd_bei_juristischer_person_uebertragbar(entity_ref("urn:de:bgb:dr:nd02:bpd")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(bpd_keine_teilungsbefugnis_bei_uebertragung(entity_ref("urn:de:bgb:dr:nd02:bpd")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
