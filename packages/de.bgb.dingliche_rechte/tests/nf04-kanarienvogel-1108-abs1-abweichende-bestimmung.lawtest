language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nf03: dieselbe Fälligkeit, aber es ist ausdrücklich ein anderes über die persönliche Haftung bestimmt (§ 1108 Abs. 1 Halbsatz 2).
test "Kanarienvogel § 1108 Abs. 1: keine persönliche Haftung bei abweichender Bestimmung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": rl_leistung_faellig_waehrend_eigentumsdauer(entity_ref("urn:de:bgb:dr:nf04:rl"), entity_ref("urn:de:bgb:dr:nf04:eigentuemer")) { origin adjudicated; }
        assert "f2": rl_abweichende_bestimmung_zur_persoenlichen_haftung(entity_ref("urn:de:bgb:dr:nf04:rl")) { origin case_input; }
    }
    evaluate truth(rl_eigentuemer_haftet_persoenlich(entity_ref("urn:de:bgb:dr:nf04:rl"), entity_ref("urn:de:bgb:dr:nf04:eigentuemer")));
    expect truth_status == FALSE_ONLY;
}
