language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1059: der Nießbrauch selbst ist nicht übertragbar, seine Ausübung kann einem anderen überlassen werden.
test "§ 1059: Unübertragbarkeit des Nießbrauchs, Überlassbarkeit der Ausübung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": berechtigter(entity_ref("urn:de:bgb:dr:nb13:nb"), entity_ref("urn:de:bgb:dr:nb13:niessbraucher")) { origin case_input; }
    }
    evaluate truth(niessbrauch_nicht_uebertragbar(entity_ref("urn:de:bgb:dr:nb13:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ausuebung_kann_ueberlassen_werden(entity_ref("urn:de:bgb:dr:nb13:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
