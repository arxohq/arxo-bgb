language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nc04: dasselbe Wertpapier, aber ohne die Einräumung des Mitbesitzes — die Bestellung nach § 1081 Abs. 2 ist nicht festgestellt.
test "Kanarienvogel § 1081 Abs. 2: ohne Mitbesitzeinräumung keine Bestellung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_wertpapier(entity_ref("urn:de:bgb:dr:nc05:nb"), entity_ref("urn:de:bgb:dr:nc05:papier")) { origin case_input; }
    }
    evaluate truth(niessbrauch_an_wertpapier_bestellt(entity_ref("urn:de:bgb:dr:nc05:nb")));
    expect truth_status == NEITHER;
}
