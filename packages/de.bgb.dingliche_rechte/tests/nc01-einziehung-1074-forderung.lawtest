language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1074 Satz 1, 3: der Nießbraucher einer Darlehensforderung ist zur Einziehung berechtigt, aber zu anderen Verfügungen (z. B. Abtretung) nicht.
test "§ 1074 Satz 1, 3: Einziehungsberechtigung ohne weitere Verfügungsbefugnis" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_forderung(entity_ref("urn:de:bgb:dr:nc01:nb"), entity_ref("urn:de:bgb:dr:nc01:forderung")) { origin case_input; }
        assert "f2": berechtigter(entity_ref("urn:de:bgb:dr:nc01:nb"), entity_ref("urn:de:bgb:dr:nc01:niessbraucher")) { origin case_input; }
    }
    evaluate truth(niessbraucher_zur_einziehung_berechtigt(entity_ref("urn:de:bgb:dr:nc01:nb"), entity_ref("urn:de:bgb:dr:nc01:niessbraucher")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(keine_befugnis_zu_anderen_verfuegungen(entity_ref("urn:de:bgb:dr:nc01:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
