language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1170 Abs. 1 Satz 1: letzte Eintragung am 15.03.2016; die Zehnjahresfrist endet kalendarisch (ohne § 193) am 15.03.2026, ohne dass der Gläubiger sein Recht anerkannt hätte — Ausschluss im Aufgebotsverfahren zulässig.
test "§ 1170 Abs. 1 Satz 1: Ausschluss nach zehn Jahren ohne Anerkenntnis zulässig" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": glaeubiger_unbekannt(entity_ref("urn:de:bgb:dr:w03:hyp")) { origin adjudicated; }
        assert "f2": ausschlussfrist_des_1170(entity_ref("urn:de:bgb:dr:w03:hyp"), entity_ref("urn:de:bgb:dr:w03:frist")) { origin case_input; }
        assert "f3": letzte_eintragung_zur_hypothek_am(entity_ref("urn:de:bgb:dr:w03:hyp"), @2016-03-15) { origin adjudicated; }
        assert "f3b": keine_kalenderbestimmte_zahlungszeit(entity_ref("urn:de:bgb:dr:w03:hyp")) { origin case_input; }
        assert "f4": kein_anerkenntnis(entity_ref("urn:de:bgb:dr:w03:hyp")) { origin adjudicated; }
    }
    evaluate truth(ausschluss_des_unbekannten_glaeubigers_zulaessig(entity_ref("urn:de:bgb:dr:w03:hyp")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
