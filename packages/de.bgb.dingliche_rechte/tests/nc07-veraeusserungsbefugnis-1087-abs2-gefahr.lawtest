language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1087 Abs. 2 Satz 2: der geschuldete Gegenstand gehört nicht zum Vermögen; das Gericht stellt fest, dass die Befriedigung durch den Besteller nicht ohne Gefahr abgewartet werden kann — der Nießbraucher darf einen Vermögensgegenstand veräußern.
test "§ 1087 Abs. 2 Satz 2: Veräußerungsbefugnis des Nießbrauchers bei Gefahr im Verzug" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": vermoegensniessbrauch(entity_ref("urn:de:bgb:dr:nc07:nb"), entity_ref("urn:de:bgb:dr:nc07:besteller")) { origin case_input; }
        assert "f2": geschuldeter_gegenstand_nicht_im_vermoegen(entity_ref("urn:de:bgb:dr:nc07:nb")) { origin adjudicated; }
        assert "f3": befriedigung_durch_besteller_nicht_ohne_gefahr_abwartbar(entity_ref("urn:de:bgb:dr:nc07:nb")) { origin adjudicated; }
        assert "f4": berechtigter(entity_ref("urn:de:bgb:dr:nc07:nb"), entity_ref("urn:de:bgb:dr:nc07:niessbraucher")) { origin case_input; }
    }
    evaluate truth(niessbraucher_darf_gegenstand_veraeussern(entity_ref("urn:de:bgb:dr:nc07:nb"), entity_ref("urn:de:bgb:dr:nc07:niessbraucher")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
