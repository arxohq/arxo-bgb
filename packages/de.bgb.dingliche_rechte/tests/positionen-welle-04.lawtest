   assert "a": position_trigger_1183(entity_ref("urn:dr:h1183"), entity_ref("urn:dr:p1183"), @2026-01-01) { origin case_input; }
   assert "b": position_trigger_1189(entity_ref("urn:dr:h1189"), entity_ref("urn:dr:p1189"), @2026-01-01) { origin case_input; }
   assert "c": position_trigger_1201(entity_ref("urn:dr:h1201"), entity_ref("urn:dr:p1201"), @2026-01-01) { origin case_input; }
