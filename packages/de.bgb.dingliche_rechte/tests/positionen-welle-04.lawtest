   assert "g": position_trigger_1237(entity_ref("urn:dr:pf1237"), entity_ref("urn:dr:p1237"), @2026-01-01) { origin case_input; }
   assert "h": position_trigger_1238(entity_ref("urn:dr:pf1238"), entity_ref("urn:dr:p1238"), @2026-01-01) { origin case_input; }
   assert "i": position_trigger_1239(entity_ref("urn:dr:pf1239"), entity_ref("urn:dr:p1239"), @2026-01-01) { origin case_input; }
   assert "j": position_trigger_1240(entity_ref("urn:dr:pf1240"), entity_ref("urn:dr:p1240"), @2026-01-01) { origin case_input; }
   assert "k": position_trigger_1255(entity_ref("urn:dr:pf1255"), entity_ref("urn:dr:p1255"), @2026-01-01) { origin case_input; }
   assert "l": position_trigger_1276(entity_ref("urn:dr:r1276"), entity_ref("urn:dr:p1276"), @2026-01-01) { origin case_input; }
   assert "m": position_trigger_1278(entity_ref("urn:dr:r1278"), entity_ref("urn:dr:p1278"), @2026-01-01) { origin case_input; }
   assert "n": position_trigger_1281(entity_ref("urn:dr:r1281"), entity_ref("urn:dr:p1281"), entity_ref("urn:dr:q1281"), @2026-01-01) { origin case_input; }
   assert "o": hinterlegung_1219_geschuldet(entity_ref("urn:dr:pf1219"), entity_ref("urn:dr:p1219")) { origin case_input; }
   assert "p": verkauf_1233_geschuldet(entity_ref("urn:dr:pf1233"), entity_ref("urn:dr:p1233")) { origin case_input; }
   assert "q": versteigerung_1235_geschuldet(entity_ref("urn:dr:pf1235"), entity_ref("urn:dr:p1235")) { origin case_input; }
   assert "r": bekanntmachung_1237_geschuldet(entity_ref("urn:dr:pf1237"), entity_ref("urn:dr:p1237")) { origin case_input; }
   assert "s": verkaufsbedingung_1238_geschuldet(entity_ref("urn:dr:pf1238"), entity_ref("urn:dr:p1238")) { origin case_input; }
   assert "t": mindestpreis_1240_unzulaessig(entity_ref("urn:dr:pf1240")) { origin case_input; }
   assert "u": rueckgabe_1278_geschuldet(entity_ref("urn:dr:r1278"), entity_ref("urn:dr:p1278")) { origin case_input; }
   assert "v": gemeinschaftliche_leistung_1281_geschuldet(entity_ref("urn:dr:r1281"), entity_ref("urn:dr:p1281"), entity_ref("urn:dr:q1281")) { origin case_input; }
 }
 evaluate positions();
 expect position(Zustimmung1183, ACTIVE);
 expect position(Verfuegung1189, ACTIVE);
 expect position(Abloesung1201, ACTIVE);
 expect position(Hinterlegung1219, SATISFIED);
 expect position(Verkauf1233, SATISFIED);
 expect position(Versteigerung1235, SATISFIED);
 expect position(Bekanntmachung1237, SATISFIED);
 expect position(Verkaufsbedingung1238, SATISFIED);
 expect position(Gebot1239, ACTIVE);
 expect position(Mindestpreis1240, VIOLATED);
 expect position(MaintenanceMindestpreis1240Duty, VIOLATED);
 expect position(Zustimmung1255, ACTIVE);
 expect position(Zustimmung1276, ACTIVE);
 expect position(Rueckgabe1278, SATISFIED);
 expect position(GemeinschaftlicheLeistung1281, SATISFIED);
}

