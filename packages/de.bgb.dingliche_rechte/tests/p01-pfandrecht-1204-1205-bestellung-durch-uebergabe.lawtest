language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1205 Abs. 1 Satz 1: Einigung und Übergabe der beweglichen Sache lassen das Pfandrecht entstehen; § 1204 Abs. 1: der Gläubiger darf Befriedigung aus der Sache suchen. § 1215: er ist zur Verwahrung verpflichtet.
test "§ 1204 Abs. 1, § 1205 Abs. 1: Bestellung durch Einigung und Übergabe" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_sache(entity_ref("urn:de:bgb:dr:p01:pfand"), entity_ref("urn:de:bgb:dr:p01:uhr")) { origin case_input; }
        assert "f2": de.bgb.besitz_eigentum::bewegliche_sache(entity_ref("urn:de:bgb:dr:p01:uhr")) { origin case_input; }
        assert "f3": pfandglaeubiger(entity_ref("urn:de:bgb:dr:p01:pfand"), entity_ref("urn:de:bgb:dr:p01:bank")) { origin case_input; }
        assert "f4": gesicherte_forderung(entity_ref("urn:de:bgb:dr:p01:pfand"), entity_ref("urn:de:bgb:dr:p01:forderung")) { origin case_input; }
        assert "f5": einigung_ueber_das_pfandrecht(entity_ref("urn:de:bgb:dr:p01:pfand")) { origin adjudicated; }
        assert "f6": sache_dem_glaeubiger_uebergeben(entity_ref("urn:de:bgb:dr:p01:pfand")) { origin adjudicated; }
        assert "f7": not sache_gehoert_dem_verpfaender_nicht(entity_ref("urn:de:bgb:dr:p01:pfand")) { origin adjudicated; }
    }
    evaluate truth(pfandrecht_entstanden(entity_ref("urn:de:bgb:dr:p01:pfand"), entity_ref("urn:de:bgb:dr:p01:bank")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(befriedigung_aus_der_sache_zulaessig(entity_ref("urn:de:bgb:dr:p01:pfand"), entity_ref("urn:de:bgb:dr:p01:bank")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verwahrungspflicht(entity_ref("urn:de:bgb:dr:p01:pfand"), entity_ref("urn:de:bgb:dr:p01:bank")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
