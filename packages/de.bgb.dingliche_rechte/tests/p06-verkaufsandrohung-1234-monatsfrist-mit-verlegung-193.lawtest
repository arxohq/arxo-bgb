language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1228 Abs. 2, § 1234 Abs. 2: Die Forderung ist fällig, der Verkauf am 15.02.2026 angedroht. Der Monat endet kalendarisch mit dem Ablauf des 15.03.2026, einem Sonntag; die Frist ist eine WARTEFRIST MIT ADRESSATEN — innerhalb ihrer darf der Verpfänder noch befriedigen (§ 1223 Abs. 2) — und § 193 verlegt das Ende auf Montag, den 16.03.2026. Ein Verkauf an diesem Tag ist noch zu früh. Dritter Zeuge zu Ledger D-11-04 auf demselben Sonntag wie tests/f01 und tests/f04.
test "§ 1234 Abs. 2: Verkauf am verlegten Fristende ist noch zu früh" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "b1": belastungsgegenstand_sache(entity_ref("urn:de:bgb:dr:p06:pfand"), entity_ref("urn:de:bgb:dr:p06:uhr")) { origin case_input; }
        assert "b2": de.bgb.besitz_eigentum::bewegliche_sache(entity_ref("urn:de:bgb:dr:p06:uhr")) { origin case_input; }
        assert "b3": pfandglaeubiger(entity_ref("urn:de:bgb:dr:p06:pfand"), entity_ref("urn:de:bgb:dr:p06:bank")) { origin case_input; }
        assert "b3a": gesicherte_forderung(entity_ref("urn:de:bgb:dr:p06:pfand"), entity_ref("urn:de:bgb:dr:p06:forderung")) { origin case_input; }
        assert "b4": einigung_ueber_das_pfandrecht(entity_ref("urn:de:bgb:dr:p06:pfand")) { origin adjudicated; }
        assert "b5": sache_dem_glaeubiger_uebergeben(entity_ref("urn:de:bgb:dr:p06:pfand")) { origin adjudicated; }
        assert "b6": not sache_gehoert_dem_verpfaender_nicht(entity_ref("urn:de:bgb:dr:p06:pfand")) { origin adjudicated; }
        assert "b7": forderung_ganz_oder_zum_teil_faellig(entity_ref("urn:de:bgb:dr:p06:pfand")) { origin adjudicated; }
        assert "b8": not geschuldeter_gegenstand_nicht_geld(entity_ref("urn:de:bgb:dr:p06:pfand")) { origin adjudicated; }
        assert "b9": verkaufsandrohungsfrist(entity_ref("urn:de:bgb:dr:p06:pfand"), entity_ref("urn:de:bgb:dr:p06:frist")) { origin case_input; }
        assert "b10": versteigerung_angedroht_am(entity_ref("urn:de:bgb:dr:p06:pfand"), @2026-02-15) { origin adjudicated; }
        assert "b11": not anzeige_untunlich(entity_ref("urn:de:bgb:dr:p06:pfand")) { origin adjudicated; }
        assert "f1": verkauf_erfolgt_am(entity_ref("urn:de:bgb:dr:p06:pfand"), @2026-03-16) { origin adjudicated; }
    }
    evaluate truth(verkauf_fruehestens_am(entity_ref("urn:de:bgb:dr:p06:pfand"), @2026-03-16));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(verkauf_zu_frueh(entity_ref("urn:de:bgb:dr:p06:pfand")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
