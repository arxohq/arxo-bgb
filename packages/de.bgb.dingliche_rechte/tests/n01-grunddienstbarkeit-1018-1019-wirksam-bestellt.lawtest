language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1018: Wegerecht zugunsten des jeweiligen Eigentümers des herrschenden Grundstücks; § 1019 Satz 1: die Belastung bietet Vorteil für dessen Benutzung.
test "§ 1018, § 1019 Satz 1: Grunddienstbarkeit wirksam bestellt" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_grundstueck(entity_ref("urn:de:bgb:dr:n01:gd"), entity_ref("urn:de:bgb:dr:n01:belastet")) { origin case_input; }
        assert "f2": herrschendes_grundstueck(entity_ref("urn:de:bgb:dr:n01:gd"), entity_ref("urn:de:bgb:dr:n01:herrschend")) { origin case_input; }
        assert "f3": berechtigter(entity_ref("urn:de:bgb:dr:n01:gd"), entity_ref("urn:de:bgb:dr:n01:eigentuemer_h")) { origin case_input; }
        assert "f4": inhalt_der_grunddienstbarkeit(entity_ref("urn:de:bgb:dr:n01:gd"), Nutzungsrecht) { origin case_input; }
        assert "f5": vorteil_fuer_die_benutzung_des_herrschenden_grundstuecks(entity_ref("urn:de:bgb:dr:n01:gd")) { origin adjudicated; }
    }
    evaluate truth(grunddienstbarkeit_wirksam_bestellt(entity_ref("urn:de:bgb:dr:n01:gd")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
