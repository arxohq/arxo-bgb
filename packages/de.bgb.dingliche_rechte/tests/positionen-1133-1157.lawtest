language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

test "§§ 1133, 1147, 1157: Hypothekenrechte aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1133(entity_ref("urn:dr:h1133"), entity_ref("urn:dr:p1133"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1147(entity_ref("urn:dr:h1147"), entity_ref("urn:dr:p1147"), entity_ref("urn:dr:g1147"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1157(entity_ref("urn:dr:h1157"), entity_ref("urn:dr:e1157"), entity_ref("urn:dr:p1157"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Befriedigung1133, ACTIVE); expect position(Zwangsvollstreckung1147, ACTIVE); expect position(Einrede1157, ACTIVE);
}

test "§§ 1133, 1147, 1157: Hypothekenrechte ausgeübt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1133(entity_ref("urn:dr:h1133"), entity_ref("urn:dr:p1133"), @2026-01-01) { origin case_input; }
 assert "ag": befriedigung_1133_ausuebbar(entity_ref("urn:dr:h1133"), entity_ref("urn:dr:p1133")) { origin case_input; }
 assert "b": position_trigger_1147(entity_ref("urn:dr:h1147"), entity_ref("urn:dr:p1147"), entity_ref("urn:dr:g1147"), @2026-01-01) { origin case_input; }
 assert "bg": befriedigung_1147_ausuebbar(entity_ref("urn:dr:h1147"), entity_ref("urn:dr:p1147")) { origin case_input; }
 assert "c": position_trigger_1157(entity_ref("urn:dr:h1157"), entity_ref("urn:dr:e1157"), entity_ref("urn:dr:p1157"), @2026-01-01) { origin case_input; }
 assert "cg": einrede_1157_geschuetzt(entity_ref("urn:dr:e1157"), entity_ref("urn:dr:h1157"), entity_ref("urn:dr:p1157")) { origin case_input; } }
 evaluate positions();
 expect position(Befriedigung1133, ACTIVE); expect position(Zwangsvollstreckung1147, ACTIVE); expect position(Einrede1157, ACTIVE);
}
