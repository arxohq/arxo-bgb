language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1192 Abs. 1a Satz 1: Die Grundschuld ist zur Sicherung eines Anspruchs verschafft; die Einrede aus dem Sicherungsvertrag mit dem bisherigen Gläubiger kann auch dem Erwerber entgegengesetzt werden. § 1157 Satz 2 findet insoweit keine Anwendung.
test "§ 1192 Abs. 1a: Einrede aus dem Sicherungsvertrag auch gegen den Erwerber der Grundschuld" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": art_des_grundpfandrechts(entity_ref("urn:de:bgb:dr:g04:gs"), Sicherungsgrundschuld) { origin case_input; }
        assert "f2": grundschuld_zur_sicherung_eines_anspruchs_verschafft(entity_ref("urn:de:bgb:dr:g04:gs")) { origin case_input; }
        assert "f3": einrede_aus_dem_sicherungsvertrag(entity_ref("urn:de:bgb:dr:g04:einrede"), entity_ref("urn:de:bgb:dr:g04:gs")) { origin case_input; }
        assert "f4": erwerber_der_grundschuld(entity_ref("urn:de:bgb:dr:g04:gs"), entity_ref("urn:de:bgb:dr:g04:erwerber")) { origin case_input; }
    }
    evaluate truth(einrede_auch_gegen_jeden_erwerber(entity_ref("urn:de:bgb:dr:g04:einrede"), entity_ref("urn:de:bgb:dr:g04:gs"), entity_ref("urn:de:bgb:dr:g04:erwerber")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
