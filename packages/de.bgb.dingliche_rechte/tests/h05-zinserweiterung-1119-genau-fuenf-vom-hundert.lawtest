language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1119 Abs. 1 — andere Seite der Grenze: Der Zinssatz beträgt genau fünf vom Hundert. Er ist nicht „niedriger als fünf vom Hundert“, die Erweiterung ohne Zustimmung ist nicht eröffnet.
test "§ 1119 Abs. 1: Zinssatz genau fünf vom Hundert — keine Erweiterung ohne Zustimmung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": geldsumme(entity_ref("urn:de:bgb:dr:h05:hyp"), 200000.00 EUR) { origin adjudicated; }
        assert "f2": forderung_verzinslich_mit(entity_ref("urn:de:bgb:dr:h05:hyp"), 5.0) { origin adjudicated; }
    }
    evaluate truth(erweiterung_der_zinshaftung_ohne_zustimmung_zulaessig(entity_ref("urn:de:bgb:dr:h05:hyp")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
