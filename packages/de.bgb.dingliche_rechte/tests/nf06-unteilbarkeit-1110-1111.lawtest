language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1110: eine subjektiv-dingliche Reallast ist untrennbar vom Eigentum des herrschenden Grundstücks. § 1111 Abs. 1: eine subjektiv-persönliche Reallast kann nicht mit Grundeigentum verbunden werden.
test "§ 1110, § 1111 Abs. 1: Unteilbarkeit subjektiv-dinglicher und -persönlicher Reallast" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": rl_herrschendes_grundstueck(entity_ref("urn:de:bgb:dr:nf06:rl_dinglich"), entity_ref("urn:de:bgb:dr:nf06:herrschend")) { origin case_input; }
        assert "f2": berechtigter(entity_ref("urn:de:bgb:dr:nf06:rl_persoenlich"), entity_ref("urn:de:bgb:dr:nf06:berechtigter")) { origin case_input; }
        assert "f3": rl_subjektiv_persoenlich(entity_ref("urn:de:bgb:dr:nf06:rl_persoenlich")) { origin case_input; }
    }
    evaluate truth(rl_subjektiv_dinglich_untrennbar(entity_ref("urn:de:bgb:dr:nf06:rl_dinglich")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(rl_subjektiv_persoenlich_nicht_verbindbar(entity_ref("urn:de:bgb:dr:nf06:rl_persoenlich")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
