language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1107: die einzelne Leistung der Reallast (Anspruch auf jährliches Altenteilsgeld) ist gesicherte Forderung im Sinne des gemeinsamen Belastungsprädikats — die für Hypothekenzinsen geltenden Vorschriften finden entsprechende Anwendung.
test "§ 1107: Einzelleistung wie Hypothekenzinsen behandelt" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_grundstueck(entity_ref("urn:de:bgb:dr:nf02:rl"), entity_ref("urn:de:bgb:dr:nf02:grundstueck")) { origin case_input; }
        assert "f2": berechtigter(entity_ref("urn:de:bgb:dr:nf02:rl"), entity_ref("urn:de:bgb:dr:nf02:berechtigter")) { origin case_input; }
        assert "f3": gesicherte_forderung(entity_ref("urn:de:bgb:dr:nf02:rl"), entity_ref("urn:de:bgb:dr:nf02:anspruch")) { origin case_input; }
    }
    evaluate truth(rl_einzelleistung(entity_ref("urn:de:bgb:dr:nf02:rl"), entity_ref("urn:de:bgb:dr:nf02:anspruch")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
