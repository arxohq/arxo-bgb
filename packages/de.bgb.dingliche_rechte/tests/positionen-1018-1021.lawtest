language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

test "§§ 1018, 1020, 1021: Grunddienstbarkeiten aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1018(entity_ref("urn:dr:d1018"), entity_ref("urn:dr:p1018"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1020(entity_ref("urn:dr:d1020"), entity_ref("urn:dr:p1020"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1021(entity_ref("urn:dr:d1021"), entity_ref("urn:dr:p1021"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Bestellung1018, ACTIVE); expect position(Schonung1020, ACTIVE); expect position(Unterhaltung1021, ACTIVE);
}

test "§§ 1018, 1020, 1021: Grunddienstbarkeiten erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1018(entity_ref("urn:dr:d1018"), entity_ref("urn:dr:p1018"), @2026-01-01) { origin case_input; }
 assert "ag": grunddienstbarkeit_1018_geschuldet(entity_ref("urn:dr:d1018")) { origin case_input; }
 assert "b": position_trigger_1020(entity_ref("urn:dr:d1020"), entity_ref("urn:dr:p1020"), @2026-01-01) { origin case_input; }
 assert "bg": schonung_1020_geschuldet(entity_ref("urn:dr:d1020")) { origin case_input; }
 assert "c": position_trigger_1021(entity_ref("urn:dr:d1021"), entity_ref("urn:dr:p1021"), @2026-01-01) { origin case_input; }
 assert "cg": unterhaltung_1021_geschuldet(entity_ref("urn:dr:d1021")) { origin case_input; } }
 evaluate positions();
 expect position(Bestellung1018, SATISFIED); expect position(Schonung1020, SATISFIED); expect position(Unterhaltung1021, SATISFIED);
}
