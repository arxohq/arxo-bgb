language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Kanarienvogel zu n01: ohne den Vorteil des § 1019 Satz 1 fehlt eine Voraussetzung der wirksamen Bestellung.
test "Kanarienvogel § 1019 Satz 1: ohne Vorteil keine wirksame Bestellung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_grundstueck(entity_ref("urn:de:bgb:dr:n02:gd"), entity_ref("urn:de:bgb:dr:n02:belastet")) { origin case_input; }
        assert "f2": herrschendes_grundstueck(entity_ref("urn:de:bgb:dr:n02:gd"), entity_ref("urn:de:bgb:dr:n02:herrschend")) { origin case_input; }
        assert "f3": berechtigter(entity_ref("urn:de:bgb:dr:n02:gd"), entity_ref("urn:de:bgb:dr:n02:eigentuemer_h")) { origin case_input; }
        assert "f4": inhalt_der_grunddienstbarkeit(entity_ref("urn:de:bgb:dr:n02:gd"), Nutzungsrecht) { origin case_input; }
    }
    evaluate truth(grunddienstbarkeit_wirksam_bestellt(entity_ref("urn:de:bgb:dr:n02:gd")));
    expect truth_status == NEITHER;
}
