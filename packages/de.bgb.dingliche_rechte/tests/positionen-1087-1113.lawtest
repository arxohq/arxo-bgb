language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

test "§§ 1087, 1088, 1113: Zahlungspositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1087(entity_ref("urn:dr:n1087"), entity_ref("urn:dr:p1087"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1088(entity_ref("urn:dr:n1088"), entity_ref("urn:dr:p1088"), entity_ref("urn:dr:q1088"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1113(entity_ref("urn:dr:h1113"), entity_ref("urn:dr:p1113"), entity_ref("urn:dr:q1113"), 1000.00 EUR, @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Leistung1087, ACTIVE); expect position(Zinsen1088, ACTIVE); expect position(Zahlung1113, ACTIVE);
}

test "§§ 1087, 1088, 1113: Zahlungspositionen erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1087(entity_ref("urn:dr:n1087"), entity_ref("urn:dr:p1087"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1088(entity_ref("urn:dr:n1088"), entity_ref("urn:dr:p1088"), entity_ref("urn:dr:q1088"), @2026-01-01) { origin case_input; }
 assert "bg": zinsen_1088_geschuldet(entity_ref("urn:dr:n1088"), entity_ref("urn:dr:p1088"), entity_ref("urn:dr:q1088")) { origin case_input; }
 assert "c": position_trigger_1113(entity_ref("urn:dr:h1113"), entity_ref("urn:dr:p1113"), entity_ref("urn:dr:q1113"), 1000.00 EUR, @2026-01-01) { origin case_input; }
 assert "cg": zahlung_1113_geschuldet(entity_ref("urn:dr:h1113"), entity_ref("urn:dr:q1113"), 1000.00 EUR) { origin case_input; } }
 evaluate positions();
 expect position(Leistung1087, ACTIVE); expect position(Zinsen1088, SATISFIED); expect position(Zahlung1113, SATISFIED);
}
