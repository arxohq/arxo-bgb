language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1243 Abs. 1: Der Verstoß gegen § 1237 Satz 1 — die öffentliche Bekanntmachung fehlt — macht die Veräußerung UNRECHTMÄSSIG, obwohl alles Übrige gewahrt ist. Gegenstück zu tests/p07.
test "§ 1243 Abs. 1: fehlende öffentliche Bekanntmachung macht die Veräußerung unrechtmäßig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "b1": belastungsgegenstand_sache(entity_ref("urn:de:bgb:dr:p08:pfand"), entity_ref("urn:de:bgb:dr:p08:uhr")) { origin case_input; }
        assert "b2": de.bgb.besitz_eigentum::bewegliche_sache(entity_ref("urn:de:bgb:dr:p08:uhr")) { origin case_input; }
        assert "b3": pfandglaeubiger(entity_ref("urn:de:bgb:dr:p08:pfand"), entity_ref("urn:de:bgb:dr:p08:bank")) { origin case_input; }
        assert "b3a": gesicherte_forderung(entity_ref("urn:de:bgb:dr:p08:pfand"), entity_ref("urn:de:bgb:dr:p08:forderung")) { origin case_input; }
        assert "b4": einigung_ueber_das_pfandrecht(entity_ref("urn:de:bgb:dr:p08:pfand")) { origin adjudicated; }
        assert "b5": sache_dem_glaeubiger_uebergeben(entity_ref("urn:de:bgb:dr:p08:pfand")) { origin adjudicated; }
        assert "b6": not sache_gehoert_dem_verpfaender_nicht(entity_ref("urn:de:bgb:dr:p08:pfand")) { origin adjudicated; }
        assert "b7": forderung_ganz_oder_zum_teil_faellig(entity_ref("urn:de:bgb:dr:p08:pfand")) { origin adjudicated; }
        assert "b8": not geschuldeter_gegenstand_nicht_geld(entity_ref("urn:de:bgb:dr:p08:pfand")) { origin adjudicated; }
        assert "b9": verkaufsandrohungsfrist(entity_ref("urn:de:bgb:dr:p08:pfand"), entity_ref("urn:de:bgb:dr:p08:frist")) { origin case_input; }
        assert "b10": versteigerung_angedroht_am(entity_ref("urn:de:bgb:dr:p08:pfand"), @2026-02-15) { origin adjudicated; }
        assert "b11": not anzeige_untunlich(entity_ref("urn:de:bgb:dr:p08:pfand")) { origin adjudicated; }
        assert "f1": verkauf_erfolgt_am(entity_ref("urn:de:bgb:dr:p08:pfand"), @2026-03-17) { origin adjudicated; }
        assert "f2": oeffentliche_versteigerung_durchgefuehrt(entity_ref("urn:de:bgb:dr:p08:pfand")) { origin adjudicated; }
        assert "f3": not oeffentlich_bekannt_gemacht(entity_ref("urn:de:bgb:dr:p08:pfand")) { origin adjudicated; }
        assert "f4": nur_so_viele_pfaender_verkauft_wie_erforderlich(entity_ref("urn:de:bgb:dr:p08:pfand")) { origin adjudicated; }
    }
    evaluate truth(veraeusserung_nicht_rechtmaessig(entity_ref("urn:de:bgb:dr:p08:pfand")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(veraeusserung_rechtmaessig(entity_ref("urn:de:bgb:dr:p08:pfand")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
