language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1123 Abs. 2 Satz 1: Die Miete wird am 15.03.2025 fällig; ein Jahr später, mit dem Ablauf des 15.03.2026, wird sie von der Haftung frei (§§ 187 Abs. 1, 188 Abs. 2). Der 15.03.2026 ist ein Sonntag — eine ENTHAFTUNGSFRIST kennt die Verlegung des § 193 NICHT (Ledger D-11-04). Gegenstück: tests/f04 (§ 1128, Handlungsfrist, derselbe Sonntag wird verlegt).
test "§ 1123 Abs. 2 Satz 1: Enthaftung nach einem Jahr, Ende am Sonntag ohne Verlegung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_grundstueck(entity_ref("urn:de:bgb:dr:f01:hyp"), entity_ref("urn:de:bgb:dr:f01:grundstueck")) { origin case_input; }
        assert "f2": grundstueck_vermietet_oder_verpachtet(entity_ref("urn:de:bgb:dr:f01:grundstueck")) { origin case_input; }
        assert "f3": gegenstand_des_grundstuecks(entity_ref("urn:de:bgb:dr:f01:miete"), entity_ref("urn:de:bgb:dr:f01:grundstueck")) { origin case_input; }
        assert "f4": miet_oder_pachtforderung(entity_ref("urn:de:bgb:dr:f01:miete")) { origin case_input; }
        assert "f5": faellig_geworden_am(entity_ref("urn:de:bgb:dr:f01:miete"), @2025-03-15) { origin adjudicated; }
        assert "f6": enthaftungsfrist(entity_ref("urn:de:bgb:dr:f01:miete"), entity_ref("urn:de:bgb:dr:f01:frist")) { origin case_input; }
        assert "f7": keine_beschlagnahme(entity_ref("urn:de:bgb:dr:f01:miete")) { origin case_input; }
    }
    evaluate truth(enthaftung_eingetreten_am(entity_ref("urn:de:bgb:dr:f01:miete"), @2026-03-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
