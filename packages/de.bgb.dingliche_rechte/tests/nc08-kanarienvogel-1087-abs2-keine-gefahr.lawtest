language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nc07: derselbe Vermögensnießbrauch, aber ohne die gerichtliche Feststellung der Gefahr — keine Veräußerungsbefugnis.
test "Kanarienvogel § 1087 Abs. 2 Satz 2: ohne Feststellung der Gefahr keine Veräußerungsbefugnis" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": vermoegensniessbrauch(entity_ref("urn:de:bgb:dr:nc08:nb"), entity_ref("urn:de:bgb:dr:nc08:besteller")) { origin case_input; }
        assert "f2": geschuldeter_gegenstand_nicht_im_vermoegen(entity_ref("urn:de:bgb:dr:nc08:nb")) { origin adjudicated; }
        assert "f4": berechtigter(entity_ref("urn:de:bgb:dr:nc08:nb"), entity_ref("urn:de:bgb:dr:nc08:niessbraucher")) { origin case_input; }
    }
    evaluate truth(niessbraucher_darf_gegenstand_veraeussern(entity_ref("urn:de:bgb:dr:nc08:nb"), entity_ref("urn:de:bgb:dr:nc08:niessbraucher")));
    expect truth_status == NEITHER;
}
