language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1104 Abs. 1: der Berechtigte eines subjektiv-persönlichen Vorkaufsrechts ist unbekannt; die Voraussetzungen des § 1170 liegen vor, und der Ausschließungsbeschluss ist rechtskräftig — das Vorkaufsrecht erlischt.
test "§ 1104 Abs. 1: Erlöschen durch rechtskräftigen Ausschließungsbeschluss" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": vk_berechtigter_unbekannt(entity_ref("urn:de:bgb:dr:ne07:vk")) { origin adjudicated; }
        assert "f2": vk_voraussetzungen_des_1170_erfuellt(entity_ref("urn:de:bgb:dr:ne07:vk")) { origin adjudicated; }
        assert "f3": vk_ausschliessungsbeschluss_rechtskraeftig(entity_ref("urn:de:bgb:dr:ne07:vk")) { origin adjudicated; }
        assert "f4": vk_subjektiv_persoenlich(entity_ref("urn:de:bgb:dr:ne07:vk")) { origin case_input; }
    }
    evaluate truth(vk_erloschen_durch_ausschliessungsbeschluss(entity_ref("urn:de:bgb:dr:ne07:vk")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
