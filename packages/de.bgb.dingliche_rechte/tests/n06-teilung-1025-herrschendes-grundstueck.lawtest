language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1025: das herrschende Grundstück wird in zwei Teile geteilt; die Dienstbarkeit gereicht nur dem ersten Teil zum Vorteil (Wegerecht zu einem dort belegenen Gebäude) und erlischt für den zweiten.
test "§ 1025 Satz 1, 2: Fortbestand für den begünstigten Teil, Erlöschen für den anderen" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": herrschendes_grundstueck(entity_ref("urn:de:bgb:dr:n06:gd"), entity_ref("urn:de:bgb:dr:n06:alt")) { origin case_input; }
        assert "f2": herrschendes_grundstueck_geteilt_in(entity_ref("urn:de:bgb:dr:n06:alt"), entity_ref("urn:de:bgb:dr:n06:teil1")) { origin adjudicated; }
        assert "f3": herrschendes_grundstueck_geteilt_in(entity_ref("urn:de:bgb:dr:n06:alt"), entity_ref("urn:de:bgb:dr:n06:teil2")) { origin adjudicated; }
        assert "f4": dient_nur_diesem_teil_zum_vorteil(entity_ref("urn:de:bgb:dr:n06:gd"), entity_ref("urn:de:bgb:dr:n06:teil1")) { origin case_input; }
    }
    evaluate truth(grunddienstbarkeit_besteht_fuer_teil(entity_ref("urn:de:bgb:dr:n06:gd"), entity_ref("urn:de:bgb:dr:n06:teil1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(grunddienstbarkeit_erloschen_fuer_teil(entity_ref("urn:de:bgb:dr:n06:gd"), entity_ref("urn:de:bgb:dr:n06:teil2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
