language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1045 Abs. 1: das Gericht stellt fest, dass die Versicherung eines Lagerhauses gegen Brandschaden ordnungsmäßiger Wirtschaft entspricht.
test "§ 1045 Abs. 1 Satz 1: Versicherungspflicht des Nießbrauchers" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_sache(entity_ref("urn:de:bgb:dr:nb05:nb"), entity_ref("urn:de:bgb:dr:nb05:lagerhaus")) { origin case_input; }
        assert "f2": versicherung_entspricht_ordnungsmaessiger_wirtschaft(entity_ref("urn:de:bgb:dr:nb05:nb")) { origin adjudicated; }
    }
    evaluate truth(versicherungspflicht_des_niessbrauchers(entity_ref("urn:de:bgb:dr:nb05:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
