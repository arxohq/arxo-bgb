language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

test "§§ 1030, 1041, 1052: Nießbrauch aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1030(entity_ref("urn:dr:n1030"), entity_ref("urn:dr:p1030"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1041(entity_ref("urn:dr:n1041"), entity_ref("urn:dr:p1041"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1052(entity_ref("urn:dr:n1052"), entity_ref("urn:dr:p1052"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Nutzung1030, ACTIVE); expect position(Erhaltung1041, ACTIVE); expect position(Verwaltung1052, ACTIVE);
}

test "§§ 1030, 1041, 1052: Nießbrauch ausgeübt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1030(entity_ref("urn:dr:n1030"), entity_ref("urn:dr:p1030"), @2026-01-01) { origin case_input; }
 assert "ag": nutzung_1030_ausgeuebt(entity_ref("urn:dr:n1030"), entity_ref("urn:dr:p1030")) { origin case_input; }
 assert "b": position_trigger_1041(entity_ref("urn:dr:n1041"), entity_ref("urn:dr:p1041"), @2026-01-01) { origin case_input; }
 assert "bg": erhaltung_1041_geschuldet(entity_ref("urn:dr:n1041")) { origin case_input; }
 assert "c": position_trigger_1052(entity_ref("urn:dr:n1052"), entity_ref("urn:dr:p1052"), @2026-01-01) { origin case_input; }
 assert "cg": verwaltung_1052_ausuebbar(entity_ref("urn:dr:n1052"), entity_ref("urn:dr:p1052")) { origin case_input; } }
 evaluate positions();
 expect position(Nutzung1030, ACTIVE); expect position(Erhaltung1041, SATISFIED); expect position(Verwaltung1052, ACTIVE);
}
