language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1028 Abs. 1: eine Garage wurde am 10.03.2020 errichtet und beeinträchtigt seither das Wegerecht; der Berechtigte erlangte an diesem Tag Kenntnis. Die regelmäßige Verjährung (§§ 195, 199) endet mit Ablauf des 31.12.2023; die Dienstbarkeit erlischt insoweit.
test "§ 1028 Abs. 1 Satz 2: Erlöschen der Dienstbarkeit mit der Verjährung des Beseitigungsanspruchs" {
    given {
        context { legal_time @2024-01-15; decision_time @2024-01-15T09:00:00Z; knowledge_time @2024-01-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": anlage_die_die_dienstbarkeit_beeintraechtigt_errichtet(entity_ref("urn:de:bgb:dr:n09:gd")) { origin adjudicated; }
        assert "f2": beseitigungsanspruch_wegen_der_anlage_ist(entity_ref("urn:de:bgb:dr:n09:gd"), entity_ref("urn:de:bgb:dr:n09:anspruch")) { origin case_input; }
        assert "f3": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:dr:n09:anspruch"), @2020-03-10) { origin adjudicated; }
        assert "f4": de.bgb.fristen::kenntnis_erlangt_am(entity_ref("urn:de:bgb:dr:n09:anspruch"), @2020-03-10) { origin adjudicated; }
        assert "f5": de.bgb.fristen::keine_hemmung(entity_ref("urn:de:bgb:dr:n09:anspruch")) { origin case_input; }
    }
    evaluate truth(grunddienstbarkeit_erloschen_soweit_die_anlage_entgegensteht(entity_ref("urn:de:bgb:dr:n09:gd")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
