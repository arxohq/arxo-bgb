language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1108 Abs. 1: eine Leistung wird während der Eigentumsdauer des Eigentümers fällig, ohne abweichende Bestimmung — er haftet auch persönlich.
test "§ 1108 Abs. 1: persönliche Haftung des Eigentümers als Regelfall" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": rl_leistung_faellig_waehrend_eigentumsdauer(entity_ref("urn:de:bgb:dr:nf03:rl"), entity_ref("urn:de:bgb:dr:nf03:eigentuemer")) { origin adjudicated; }
    }
    evaluate truth(rl_eigentuemer_haftet_persoenlich(entity_ref("urn:de:bgb:dr:nf03:rl"), entity_ref("urn:de:bgb:dr:nf03:eigentuemer")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
