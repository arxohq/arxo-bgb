language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nb07: dieselbe Wertminderung, aber ohne die gerichtliche Feststellung, dass sie durch ordnungsmäßige Ausübung herbeigeführt wurde.
test "Kanarienvogel § 1050: ohne Feststellung ordnungsmäßiger Ausübung keine Freistellung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": veraenderung_oder_verschlechterung(entity_ref("urn:de:bgb:dr:nb08:nb")) { origin adjudicated; }
    }
    evaluate truth(keine_verantwortlichkeit_des_niessbrauchers(entity_ref("urn:de:bgb:dr:nb08:nb")));
    expect truth_status == NEITHER;
}
