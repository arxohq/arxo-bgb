language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1024, § 879 Abs. 1 Satz 2 (Nachbarpaket): zwei Grunddienstbarkeiten an demselben Grundstück, in verschiedenen Abteilungen unter demselben Tag eingetragen — gleicher Rang; sie können nicht vollständig nebeneinander ausgeübt werden.
test "§ 1024: Anspruch auf Regelung nach billigem Ermessen bei gleichem Rang" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": berechtigter(entity_ref("urn:de:bgb:dr:n05:gd1"), entity_ref("urn:de:bgb:dr:n05:eigentuemer_h1")) { origin case_input; }
        assert "f2": rechte_koennen_nicht_nebeneinander_vollstaendig_ausgeuebt_werden(entity_ref("urn:de:bgb:dr:n05:gd1"), entity_ref("urn:de:bgb:dr:n05:gd2")) { origin case_input; }
        assert "r1": de.bgb.besitz_eigentum::recht_am_grundstueck(entity_ref("urn:de:bgb:dr:n05:gd1"), entity_ref("urn:de:bgb:dr:n05:grundstueck")) { origin adjudicated; }
        assert "r2": de.bgb.besitz_eigentum::recht_am_grundstueck(entity_ref("urn:de:bgb:dr:n05:gd2"), entity_ref("urn:de:bgb:dr:n05:grundstueck")) { origin adjudicated; }
        assert "r3": de.bgb.besitz_eigentum::eingetragen_in_abteilung(entity_ref("urn:de:bgb:dr:n05:gd1"), 2) { origin adjudicated; }
        assert "r4": de.bgb.besitz_eigentum::eingetragen_in_abteilung(entity_ref("urn:de:bgb:dr:n05:gd2"), 3) { origin adjudicated; }
        assert "r5": de.bgb.besitz_eigentum::eingetragen_am(entity_ref("urn:de:bgb:dr:n05:gd1"), @2020-01-10) { origin adjudicated; }
        assert "r6": de.bgb.besitz_eigentum::eingetragen_am(entity_ref("urn:de:bgb:dr:n05:gd2"), @2020-01-10) { origin adjudicated; }
    }
    evaluate truth(anspruch_auf_regelung_nach_billigem_ermessen(entity_ref("urn:de:bgb:dr:n05:gd1"), entity_ref("urn:de:bgb:dr:n05:gd2"), entity_ref("urn:de:bgb:dr:n05:eigentuemer_h1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
