language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1081 Abs. 1: eine Inhaberschuldverschreibung ist Gegenstand des Nießbrauchs; Besitz des Papiers gemeinschaftlich, Zinsscheine allein beim Nießbraucher; Abs. 2: Bestellung durch Mitbesitzeinräumung statt Übergabe.
test "§ 1081 Abs. 1, 2: gemeinschaftlicher Mitbesitz, Zinsscheine, Bestellung durch Mitbesitz" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_wertpapier(entity_ref("urn:de:bgb:dr:nc04:nb"), entity_ref("urn:de:bgb:dr:nc04:papier")) { origin case_input; }
        assert "f2": berechtigter(entity_ref("urn:de:bgb:dr:nc04:nb"), entity_ref("urn:de:bgb:dr:nc04:niessbraucher")) { origin case_input; }
        assert "f3": mitbesitz_eingeraeumt(entity_ref("urn:de:bgb:dr:nc04:nb")) { origin adjudicated; }
    }
    evaluate truth(mitbesitz_am_papier_gemeinschaftlich(entity_ref("urn:de:bgb:dr:nc04:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(besitz_der_zinsscheine_beim_niessbraucher(entity_ref("urn:de:bgb:dr:nc04:nb"), entity_ref("urn:de:bgb:dr:nc04:niessbraucher")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(niessbrauch_an_wertpapier_bestellt(entity_ref("urn:de:bgb:dr:nc04:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
