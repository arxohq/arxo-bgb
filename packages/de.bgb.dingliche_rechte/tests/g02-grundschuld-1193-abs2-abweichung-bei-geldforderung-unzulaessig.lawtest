language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1193 Abs. 2 Satz 2: Dient die Grundschuld der Sicherung einer Geldforderung, so ist eine von Absatz 1 abweichende Bestimmung über die Kündigungsfrist nicht zulässig — hier eine Frist von drei Monaten.
test "§ 1193 Abs. 2 Satz 2: abweichende Kündigungsfrist bei Sicherung einer Geldforderung ist unzulässig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": art_des_grundpfandrechts(entity_ref("urn:de:bgb:dr:g02:gs"), Sicherungsgrundschuld) { origin case_input; }
        assert "f2": abweichende_bestimmung_ueber_die_kuendigungsfrist(entity_ref("urn:de:bgb:dr:g02:gs"), 3 calendar_month) { origin case_input; }
        assert "f3": grundschuld_sichert_eine_geldforderung(entity_ref("urn:de:bgb:dr:g02:gs")) { origin case_input; }
    }
    evaluate truth(abweichende_bestimmung_unzulaessig(entity_ref("urn:de:bgb:dr:g02:gs")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
