language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nb11: derselbe Anspruch, aber ohne den Tag der Rückgabe — ohne Ereignis läuft die Frist des § 187 Abs. 1 nicht an, und die Verjährung ist nicht festgestellt.
test "Kanarienvogel § 1057 Satz 1: ohne Rückgabetag keine Verjährung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": ersatzanspruch_wegen_veraenderung_oder_verschlechterung(entity_ref("urn:de:bgb:dr:nb12:nb"), entity_ref("urn:de:bgb:dr:nb12:anspruch")) { origin case_input; }
        assert "f3": ersatzanspruch_1057_frist(entity_ref("urn:de:bgb:dr:nb12:nb"), entity_ref("urn:de:bgb:dr:nb12:frist")) { origin case_input; }
    }
    evaluate truth(ersatzanspruch_1057_verjaehrt(entity_ref("urn:de:bgb:dr:nb12:nb")));
    expect truth_status == NEITHER;
}
