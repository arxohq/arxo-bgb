language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu ne07: dieselben Voraussetzungen, aber das Vorkaufsrecht besteht subjektiv-dinglich zugunsten des jeweiligen Eigentümers — § 1104 Abs. 2 schließt die Anwendung des Aufgebotsverfahrens aus.
test "Kanarienvogel § 1104 Abs. 2: kein Erlöschen bei subjektiv-dinglichem Vorkaufsrecht" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": vk_berechtigter_unbekannt(entity_ref("urn:de:bgb:dr:ne08:vk")) { origin adjudicated; }
        assert "f2": vk_voraussetzungen_des_1170_erfuellt(entity_ref("urn:de:bgb:dr:ne08:vk")) { origin adjudicated; }
        assert "f3": vk_ausschliessungsbeschluss_rechtskraeftig(entity_ref("urn:de:bgb:dr:ne08:vk")) { origin adjudicated; }
    }
    evaluate truth(vk_erloschen_durch_ausschliessungsbeschluss(entity_ref("urn:de:bgb:dr:ne08:vk")));
    expect truth_status == NEITHER;
}
