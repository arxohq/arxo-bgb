language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

test "§§ 1061, 1123, 1170, 1193: Restpositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1061(entity_ref("urn:dr:n1061"), entity_ref("urn:dr:p1061"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1123(entity_ref("urn:dr:x1123"), entity_ref("urn:dr:p1123"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1170(entity_ref("urn:dr:h1170"), entity_ref("urn:dr:p1170"), @2026-01-01) { origin case_input; }
 assert "d": position_trigger_1193(entity_ref("urn:dr:h1193"), entity_ref("urn:dr:p1193"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Erloeschen1061, ACTIVE); expect position(Enthaftung1123, ACTIVE); expect position(Ausschluss1170, ACTIVE); expect position(Kuendigung1193, ACTIVE);
}

test "§§ 1061, 1123, 1170, 1193: Restpositionen erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1061(entity_ref("urn:dr:n1061"), entity_ref("urn:dr:p1061"), @2026-01-01) { origin case_input; }
 assert "ag": erloeschen_1061_geschuldet(entity_ref("urn:dr:n1061")) { origin case_input; }
 assert "b": position_trigger_1123(entity_ref("urn:dr:x1123"), entity_ref("urn:dr:p1123"), @2026-01-01) { origin case_input; }
 assert "bg": enthaftung_1123_geschuldet(entity_ref("urn:dr:x1123")) { origin case_input; }
 assert "c": position_trigger_1170(entity_ref("urn:dr:h1170"), entity_ref("urn:dr:p1170"), @2026-01-01) { origin case_input; }
 assert "cg": ausschluss_1170_ausuebbar(entity_ref("urn:dr:h1170"), entity_ref("urn:dr:p1170")) { origin case_input; }
 assert "d": position_trigger_1193(entity_ref("urn:dr:h1193"), entity_ref("urn:dr:p1193"), @2026-01-01) { origin case_input; }
 assert "dg": kuendigung_1193_ausuebbar(entity_ref("urn:dr:h1193"), entity_ref("urn:dr:p1193")) { origin case_input; } }
 evaluate positions();
 expect position(Erloeschen1061, SATISFIED); expect position(Enthaftung1123, SATISFIED); expect position(Ausschluss1170, ACTIVE); expect position(Kuendigung1193, ACTIVE);
}
