language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1253 Abs. 2: Ist das Pfand im Besitz des Verpfänders oder des Eigentümers, so wird vermutet, dass es ihm zurückgegeben worden sei. Der Fall stellt das Gegenteil nicht fest — die Vermutung hält.
test "§ 1253 Abs. 2: Besitz des Verpfänders — die Rückgabe wird vermutet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": pfand_im_besitz_des_verpfaenders_oder_eigentuemers(entity_ref("urn:de:bgb:dr:p10:pfand")) { origin adjudicated; }
    }
    evaluate truth(rueckgabe_vermutet(entity_ref("urn:de:bgb:dr:p10:pfand")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
