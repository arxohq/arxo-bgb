language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1100 Satz 1: der Käufer, nunmehr neuer Eigentümer, hat einen berichtigten Kaufpreis von 250 000 € gezahlt; er kann die Zustimmung zur Eintragung und die Herausgabe verweigern, bis ihm dieser Betrag erstattet wird.
test "§ 1100 Satz 1: Zurückbehaltungsrecht des Käufers bis zur Kaufpreiserstattung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": neuer_eigentuemer_ist_kaeufer_oder_rechtsnachfolger(entity_ref("urn:de:bgb:dr:ne04:vk"), entity_ref("urn:de:bgb:dr:ne04:kaeufer")) { origin adjudicated; }
        assert "f2": berichtigter_kaufpreis(entity_ref("urn:de:bgb:dr:ne04:vk"), 250000.00 EUR) { origin adjudicated; }
    }
    evaluate truth(kaeufer_kann_zustimmung_und_herausgabe_verweigern(entity_ref("urn:de:bgb:dr:ne04:vk"), entity_ref("urn:de:bgb:dr:ne04:kaeufer"), 250000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
