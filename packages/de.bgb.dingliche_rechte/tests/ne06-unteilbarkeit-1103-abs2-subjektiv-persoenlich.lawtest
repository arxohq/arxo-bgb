language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu ne05: ein zugunsten einer bestimmten Person (nicht des jeweiligen Eigentümers eines herrschenden Grundstücks) bestehendes Vorkaufsrecht kann nicht mit Grundeigentum verbunden werden.
test "§ 1103 Abs. 2: subjektiv-persönliches Vorkaufsrecht nicht mit Grundeigentum verbindbar" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": berechtigter(entity_ref("urn:de:bgb:dr:ne06:vk"), entity_ref("urn:de:bgb:dr:ne06:berechtigter")) { origin case_input; }
        assert "f2": vk_subjektiv_persoenlich(entity_ref("urn:de:bgb:dr:ne06:vk")) { origin case_input; }
    }
    evaluate truth(vk_subjektiv_persoenlich_nicht_verbindbar(entity_ref("urn:de:bgb:dr:ne06:vk")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
