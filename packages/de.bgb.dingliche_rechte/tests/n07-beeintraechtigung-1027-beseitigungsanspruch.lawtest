language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1027 i.V.m. § 1004 Abs. 1: der Eigentümer des belasteten Grundstücks errichtet einen Zaun, der den Weg zum herrschenden Grundstück versperrt; der Berechtigte ist nicht zur Duldung verpflichtet.
test "§ 1027, § 1004 Abs. 1 Satz 1: Beseitigungsanspruch bei Beeinträchtigung der Grunddienstbarkeit" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": berechtigter(entity_ref("urn:de:bgb:dr:n07:gd"), entity_ref("urn:de:bgb:dr:n07:berechtigter")) { origin case_input; }
        assert "f2": grunddienstbarkeit_beeintraechtigt_durch(entity_ref("urn:de:bgb:dr:n07:gd"), entity_ref("urn:de:bgb:dr:n07:stoerer")) { origin adjudicated; }
        assert "f3": berechtigter_nicht_zur_duldung_verpflichtet(entity_ref("urn:de:bgb:dr:n07:gd")) { origin case_input; }
        assert "f4": weitere_beeintraechtigung_der_dienstbarkeit_zu_besorgen(entity_ref("urn:de:bgb:dr:n07:gd")) { origin adjudicated; }
    }
    evaluate truth(dienstbarkeit_beseitigungsanspruch(entity_ref("urn:de:bgb:dr:n07:gd"), entity_ref("urn:de:bgb:dr:n07:berechtigter"), entity_ref("urn:de:bgb:dr:n07:stoerer")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(dienstbarkeit_unterlassungsanspruch(entity_ref("urn:de:bgb:dr:n07:gd"), entity_ref("urn:de:bgb:dr:n07:berechtigter"), entity_ref("urn:de:bgb:dr:n07:stoerer")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
