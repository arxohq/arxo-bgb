language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1113 Abs. 1: Grundstück mit einer Hypothek über 200 000 € zugunsten der Bank belastet; aus dem Grundstück ist diese Geldsumme an sie zu zahlen. § 1115 Abs. 1: Gläubiger, Geldbetrag und Zinssatz sind eingetragen, die Forderung damit bezeichnet.
test "§ 1113 Abs. 1, § 1115 Abs. 1: Zahlung aus dem Grundstück und vollständige Bezeichnung der Forderung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_grundstueck(entity_ref("urn:de:bgb:dr:h01:hyp"), entity_ref("urn:de:bgb:dr:h01:grundstueck")) { origin case_input; }
        assert "f2": berechtigter(entity_ref("urn:de:bgb:dr:h01:hyp"), entity_ref("urn:de:bgb:dr:h01:bank")) { origin case_input; }
        assert "f3": geldsumme(entity_ref("urn:de:bgb:dr:h01:hyp"), 200000.00 EUR) { origin adjudicated; }
        assert "f4": art_des_grundpfandrechts(entity_ref("urn:de:bgb:dr:h01:hyp"), Hypothek) { origin case_input; }
        assert "f5": glaeubiger_im_grundbuch_angegeben(entity_ref("urn:de:bgb:dr:h01:hyp"), entity_ref("urn:de:bgb:dr:h01:bank")) { origin adjudicated; }
        assert "f6": geldbetrag_im_grundbuch_angegeben(entity_ref("urn:de:bgb:dr:h01:hyp")) { origin adjudicated; }
        assert "f7": forderung_verzinslich_mit(entity_ref("urn:de:bgb:dr:h01:hyp"), 3.5) { origin adjudicated; }
    }
    evaluate truth(zahlung_aus_dem_grundstueck_geschuldet(entity_ref("urn:de:bgb:dr:h01:hyp"), entity_ref("urn:de:bgb:dr:h01:bank"), 200000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(eintragung_bezeichnet_die_forderung(entity_ref("urn:de:bgb:dr:h01:hyp")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
