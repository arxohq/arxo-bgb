language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

test "§§ 1074, 1078, 1079: Nießbrauchpositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1074(entity_ref("urn:dr:r1074"), entity_ref("urn:dr:n1074"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1078(entity_ref("urn:dr:r1078"), entity_ref("urn:dr:n1078"), entity_ref("urn:dr:g1078"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1079(entity_ref("urn:dr:r1079"), entity_ref("urn:dr:n1079"), entity_ref("urn:dr:g1079"), @2026-01-01) { origin case_input; } }
 evaluate positions();
 expect position(Einziehung1074, ACTIVE); expect position(Mitwirkung1078, ACTIVE); expect position(Anlage1079, ACTIVE);
}

test "§§ 1074, 1078, 1079: Nießbrauchpositionen erfüllt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1074(entity_ref("urn:dr:r1074"), entity_ref("urn:dr:n1074"), @2026-01-01) { origin case_input; }
 assert "ae": einziehung_1074_ausuebbar(entity_ref("urn:dr:r1074"), entity_ref("urn:dr:n1074")) { origin case_input; }
 assert "b": position_trigger_1078(entity_ref("urn:dr:r1078"), entity_ref("urn:dr:n1078"), entity_ref("urn:dr:g1078"), @2026-01-01) { origin case_input; }
 assert "be": mitwirkung_1078_geschuldet(entity_ref("urn:dr:r1078"), entity_ref("urn:dr:n1078"), entity_ref("urn:dr:g1078")) { origin case_input; }
 assert "c": position_trigger_1079(entity_ref("urn:dr:r1079"), entity_ref("urn:dr:n1079"), entity_ref("urn:dr:g1079"), @2026-01-01) { origin case_input; }
 assert "ce": anlage_1079_geschuldet(entity_ref("urn:dr:r1079"), entity_ref("urn:dr:n1079"), entity_ref("urn:dr:g1079")) { origin case_input; } }
 evaluate positions();
 expect position(Einziehung1074, ACTIVE); expect position(Mitwirkung1078, SATISFIED); expect position(Anlage1079, SATISFIED);
}
