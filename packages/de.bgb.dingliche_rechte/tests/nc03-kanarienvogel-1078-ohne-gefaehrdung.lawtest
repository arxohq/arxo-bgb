language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nc02: dieselbe Ausgangslage, aber ohne die gerichtliche Feststellung der Gefährdung.
test "Kanarienvogel § 1078 Satz 2: ohne Feststellung der Gefährdung keine Kündigungsmitwirkungspflicht" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": forderung_verzinslich_ausstehend(entity_ref("urn:de:bgb:dr:nc03:nb")) { origin case_input; }
        assert "f2": niessbrauch_faelligkeit_haengt_von_kuendigung_ab(entity_ref("urn:de:bgb:dr:nc03:nb")) { origin case_input; }
    }
    evaluate truth(mitwirkungspflicht_zur_kuendigung(entity_ref("urn:de:bgb:dr:nc03:nb")));
    expect truth_status == NEITHER;
}
