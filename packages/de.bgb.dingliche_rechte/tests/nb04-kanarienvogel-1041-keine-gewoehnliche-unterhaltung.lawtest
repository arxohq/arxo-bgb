language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nb03: dieselbe erforderliche Maßnahme, aber das Gericht stellt sie NICHT als gewöhnliche Unterhaltung fest — außergewöhnliche Erneuerung, § 1041 Satz 2 trifft nicht zu.
test "Kanarienvogel § 1041 Satz 2: ohne Feststellung gewöhnlicher Unterhaltung keine Ausbesserungspflicht" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_sache(entity_ref("urn:de:bgb:dr:nb04:nb"), entity_ref("urn:de:bgb:dr:nb04:haus")) { origin case_input; }
        assert "f2": ausbesserung_oder_erneuerung_erforderlich(entity_ref("urn:de:bgb:dr:nb04:nb")) { origin adjudicated; }
    }
    evaluate truth(ausbesserungspflicht_des_niessbrauchers(entity_ref("urn:de:bgb:dr:nb04:nb")));
    expect truth_status == NEITHER;
}
