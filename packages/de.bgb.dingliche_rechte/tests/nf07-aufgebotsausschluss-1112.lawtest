language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1112 i.V.m. § 1104: der Berechtigte einer subjektiv-persönlichen Reallast ist unbekannt; die Voraussetzungen des § 1170 liegen vor, der Ausschließungsbeschluss ist rechtskräftig — die Reallast erlischt.
test "§ 1112: Erlöschen der Reallast durch rechtskräftigen Ausschließungsbeschluss" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": rl_berechtigter_unbekannt(entity_ref("urn:de:bgb:dr:nf07:rl")) { origin adjudicated; }
        assert "f2": rl_voraussetzungen_des_1170_erfuellt(entity_ref("urn:de:bgb:dr:nf07:rl")) { origin adjudicated; }
        assert "f3": rl_ausschliessungsbeschluss_rechtskraeftig(entity_ref("urn:de:bgb:dr:nf07:rl")) { origin adjudicated; }
        assert "f4": rl_subjektiv_persoenlich(entity_ref("urn:de:bgb:dr:nf07:rl")) { origin case_input; }
    }
    evaluate truth(rl_erloschen_durch_ausschliessungsbeschluss(entity_ref("urn:de:bgb:dr:nf07:rl")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
