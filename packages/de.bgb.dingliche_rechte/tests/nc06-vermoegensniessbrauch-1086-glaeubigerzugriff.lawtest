language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1086 Satz 1: ein Gläubiger des Bestellers hat eine vor der Bestellung des Vermögensnießbrauchs entstandene Forderung über 12 000 € und kann ohne Rücksicht auf den Nießbrauch Befriedigung verlangen.
test "§ 1086 Satz 1: Gläubiger des Bestellers greift ohne Rücksicht auf den Nießbrauch durch" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": vermoegensniessbrauch(entity_ref("urn:de:bgb:dr:nc06:nb"), entity_ref("urn:de:bgb:dr:nc06:besteller")) { origin case_input; }
        assert "f2": glaeubigerforderung_vor_bestellung_entstanden(entity_ref("urn:de:bgb:dr:nc06:nb"), entity_ref("urn:de:bgb:dr:nc06:glaeubiger"), 12000.00 EUR) { origin adjudicated; }
    }
    evaluate truth(glaeubiger_kann_befriedigung_ohne_ruecksicht_verlangen(entity_ref("urn:de:bgb:dr:nc06:nb"), entity_ref("urn:de:bgb:dr:nc06:glaeubiger"), 12000.00 EUR));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
