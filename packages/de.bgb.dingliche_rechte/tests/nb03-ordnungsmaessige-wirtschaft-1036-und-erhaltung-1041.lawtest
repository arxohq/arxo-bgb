language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1036 Abs. 2: Pflicht zu ordnungsmäßiger Wirtschaft besteht unmittelbar mit dem Bestand des Nießbrauchs; § 1041 Satz 2: eine erforderliche Ausbesserung gehört nach Feststellung des Gerichts zur gewöhnlichen Unterhaltung.
test "§ 1036 Abs. 2, § 1041: Wirtschaftspflicht und Ausbesserungspflicht bei gewöhnlicher Unterhaltung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_sache(entity_ref("urn:de:bgb:dr:nb03:nb"), entity_ref("urn:de:bgb:dr:nb03:haus")) { origin case_input; }
        assert "f2": ausbesserung_oder_erneuerung_erforderlich(entity_ref("urn:de:bgb:dr:nb03:nb")) { origin adjudicated; }
        assert "f3": gehoert_zur_gewoehnlichen_unterhaltung(entity_ref("urn:de:bgb:dr:nb03:nb")) { origin adjudicated; }
    }
    evaluate truth(pflicht_ordnungsmaessiger_wirtschaft(entity_ref("urn:de:bgb:dr:nb03:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ausbesserungspflicht_des_niessbrauchers(entity_ref("urn:de:bgb:dr:nb03:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
