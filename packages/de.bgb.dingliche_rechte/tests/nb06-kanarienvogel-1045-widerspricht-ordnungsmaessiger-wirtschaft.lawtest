language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nb05: dieselbe Sache, aber ohne die gerichtliche Feststellung, dass die Versicherung ordnungsmäßiger Wirtschaft entspricht.
test "Kanarienvogel § 1045 Abs. 1: ohne Feststellung keine Versicherungspflicht" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_sache(entity_ref("urn:de:bgb:dr:nb06:nb"), entity_ref("urn:de:bgb:dr:nb06:lagerhaus")) { origin case_input; }
    }
    evaluate truth(versicherungspflicht_des_niessbrauchers(entity_ref("urn:de:bgb:dr:nb06:nb")));
    expect truth_status == NEITHER;
}
