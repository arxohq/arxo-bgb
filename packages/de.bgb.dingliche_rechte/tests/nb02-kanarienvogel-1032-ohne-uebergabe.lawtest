language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Kanarienvogel zu nb01: Einigkeit allein genügt nicht; ohne Übergabe fehlt eine Voraussetzung des § 1032 Satz 1.
test "Kanarienvogel § 1032 Satz 1: ohne Übergabe keine Bestellung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_sache(entity_ref("urn:de:bgb:dr:nb02:nb"), entity_ref("urn:de:bgb:dr:nb02:gemaelde")) { origin case_input; }
        assert "f3": einigkeit_ueber_den_niessbrauch(entity_ref("urn:de:bgb:dr:nb02:nb")) { origin case_input; }
    }
    evaluate truth(niessbrauch_an_beweglicher_sache_bestellt(entity_ref("urn:de:bgb:dr:nb02:nb")));
    expect truth_status == NEITHER;
}
