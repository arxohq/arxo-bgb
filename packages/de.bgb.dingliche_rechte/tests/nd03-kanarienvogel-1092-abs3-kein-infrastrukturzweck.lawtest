language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nd02: dieselbe juristische Person, aber ohne den Infrastrukturzweck des § 1092 Abs. 3 Satz 1 — es bleibt bei der Unübertragbarkeit des § 1092 Abs. 1.
test "Kanarienvogel § 1092 Abs. 3: ohne Infrastrukturzweck keine Übertragbarkeit nach Abs. 3" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": bpd_juristischer_person_zustehend(entity_ref("urn:de:bgb:dr:nd03:bpd")) { origin adjudicated; }
    }
    evaluate truth(bpd_bei_juristischer_person_uebertragbar(entity_ref("urn:de:bgb:dr:nd03:bpd")));
    expect truth_status == NEITHER;
}
