language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nb09: derselbe Fristbeginn und dieselbe Dauer, aber der Prüfungstag liegt vor dem Fristende (20.02.2026 statt 10.03.2026) — die Frist ist noch nicht verstrichen.
test "Kanarienvogel § 1052 Abs. 1: keine Anordnung vor Fristablauf" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": rechtskraeftig_zur_sicherheitsleistung_verurteilt(entity_ref("urn:de:bgb:dr:nb10:nb")) { origin adjudicated; }
        assert "f2": besteller(entity_ref("urn:de:bgb:dr:nb10:nb"), entity_ref("urn:de:bgb:dr:nb10:eigentuemer")) { origin case_input; }
        assert "f3": sicherheitsleistungsfrist(entity_ref("urn:de:bgb:dr:nb10:nb"), entity_ref("urn:de:bgb:dr:nb10:frist")) { origin case_input; }
        assert "f4": de.bgb.fristen::frist_ereignis(entity_ref("urn:de:bgb:dr:nb10:frist"), @2026-02-01) { origin adjudicated; }
        assert "f5": de.bgb.fristen::frist_dauer_kalender(entity_ref("urn:de:bgb:dr:nb10:frist"), 1 calendar_month) { origin adjudicated; }
        assert "f6": pruefungstag_der_sicherheitsleistung(entity_ref("urn:de:bgb:dr:nb10:nb"), @2026-02-20) { origin adjudicated; }
    }
    evaluate truth(anordnung_der_verwaltung_zulaessig(entity_ref("urn:de:bgb:dr:nb10:nb"), entity_ref("urn:de:bgb:dr:nb10:eigentuemer")));
    expect truth_status == NEITHER;
}
