language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1061 Satz 1: der Nießbraucher einer beweglichen Sache stirbt — der Nießbrauch erlischt; § 1063 Abs. 1: an einer anderen Sache treffen Nießbrauch und Eigentum in derselben Person zusammen, ohne rechtliches Interesse am Fortbestand — Konsolidation.
test "§ 1061 Satz 1, § 1063 Abs. 1: Erlöschen durch Tod und durch Konsolidation" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": niessbraucher_verstorben(entity_ref("urn:de:bgb:dr:nb14:nb1")) { origin adjudicated; }
        assert "f2": belastungsgegenstand_sache(entity_ref("urn:de:bgb:dr:nb14:nb2"), entity_ref("urn:de:bgb:dr:nb14:fahrrad")) { origin case_input; }
        assert "f3": niessbrauch_und_eigentum_in_derselben_person(entity_ref("urn:de:bgb:dr:nb14:nb2")) { origin adjudicated; }
    }
    evaluate truth(niessbrauch_erloschen_1061(entity_ref("urn:de:bgb:dr:nb14:nb1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(niessbrauch_erloschen_1063(entity_ref("urn:de:bgb:dr:nb14:nb2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
