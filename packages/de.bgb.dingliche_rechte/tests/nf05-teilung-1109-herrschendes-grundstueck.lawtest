language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1109 Abs. 3: das herrschende Grundstück wird geteilt; die Reallast (Wegunterhaltslast zugunsten des Nachbargrundstücks) gereicht nur einem der beiden Teile zum Vorteil und bleibt allein mit diesem verbunden.
test "§ 1109 Abs. 1, 3: Fortbestand und alleinige Verbindung mit dem Vorteilsteil" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": rl_herrschendes_grundstueck(entity_ref("urn:de:bgb:dr:nf05:rl"), entity_ref("urn:de:bgb:dr:nf05:alt")) { origin case_input; }
        assert "f2": rl_herrschendes_grundstueck_geteilt_in(entity_ref("urn:de:bgb:dr:nf05:alt"), entity_ref("urn:de:bgb:dr:nf05:teil1")) { origin adjudicated; }
        assert "f3": rl_dient_nur_diesem_teil_zum_vorteil(entity_ref("urn:de:bgb:dr:nf05:rl"), entity_ref("urn:de:bgb:dr:nf05:teil1")) { origin adjudicated; }
    }
    evaluate truth(rl_besteht_fuer_teil_fort(entity_ref("urn:de:bgb:dr:nf05:rl"), entity_ref("urn:de:bgb:dr:nf05:teil1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(rl_bleibt_allein_mit_vorteilsteil_verbunden(entity_ref("urn:de:bgb:dr:nf05:rl"), entity_ref("urn:de:bgb:dr:nf05:teil1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
