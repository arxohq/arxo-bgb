language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1226 Satz 1: Die Ersatzansprüche verjähren in sechs Monaten von der Rückgabe des Pfandes (§ 548 Abs. 1 Satz 2 entsprechend). Rückgabe am 15.09.2025, Ablauf mit dem 15.03.2026 — einem Sonntag. Die VERJÄHRUNGSFRIST kennt die Verlegung des § 193 nicht; ein am 16.03.2026 geltend gemachter Anspruch ist verspätet.
test "§ 1226: sechs Monate ab Rückgabe, Ende am Sonntag ohne Verlegung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": ersatzanspruchsfrist(entity_ref("urn:de:bgb:dr:p09:pfand"), entity_ref("urn:de:bgb:dr:p09:frist")) { origin case_input; }
        assert "f2": pfand_zurueckgegeben_am(entity_ref("urn:de:bgb:dr:p09:pfand"), @2025-09-15) { origin adjudicated; }
        assert "f3": ersatzanspruch_geltend_gemacht_am(entity_ref("urn:de:bgb:dr:p09:pfand"), @2026-03-16) { origin adjudicated; }
    }
    evaluate truth(ersatzanspruch_verjaehrt_am(entity_ref("urn:de:bgb:dr:p09:pfand"), @2026-03-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(ersatzanspruch_rechtzeitig_geltend_gemacht(entity_ref("urn:de:bgb:dr:p09:pfand")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
