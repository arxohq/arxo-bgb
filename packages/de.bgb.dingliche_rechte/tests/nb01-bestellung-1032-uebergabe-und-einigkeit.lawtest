language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1032 Satz 1: der Eigentümer eines Gemäldes übergibt es dem Erwerber und beide sind einig, dass diesem der Nießbrauch zustehen soll.
test "§ 1032 Satz 1: Nießbrauch an beweglicher Sache durch Übergabe und Einigkeit bestellt" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_sache(entity_ref("urn:de:bgb:dr:nb01:nb"), entity_ref("urn:de:bgb:dr:nb01:gemaelde")) { origin case_input; }
        assert "f2": sache_dem_erwerber_uebergeben(entity_ref("urn:de:bgb:dr:nb01:nb")) { origin adjudicated; }
        assert "f3": einigkeit_ueber_den_niessbrauch(entity_ref("urn:de:bgb:dr:nb01:nb")) { origin case_input; }
    }
    evaluate truth(niessbrauch_an_beweglicher_sache_bestellt(entity_ref("urn:de:bgb:dr:nb01:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
