language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nd04: dasselbe Wohnungsrecht, aber es erstreckt sich auf das GANZE Gebäude — § 1093 Abs. 3 (Mitbenutzung gemeinschaftlicher Anlagen) setzt gerade die Beschränkung auf einen Gebäudeteil voraus.
test "Kanarienvogel § 1093 Abs. 3: ohne Beschränkung auf einen Gebäudeteil keine Mitbenutzung nach Abs. 3" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": ist_wohnungsrecht(entity_ref("urn:de:bgb:dr:nd05:bpd")) { origin case_input; }
        assert "f2": berechtigter(entity_ref("urn:de:bgb:dr:nd05:bpd"), entity_ref("urn:de:bgb:dr:nd05:berechtigte")) { origin case_input; }
    }
    evaluate truth(berechtigter_darf_gemeinschaftliche_anlagen_mitbenutzen(entity_ref("urn:de:bgb:dr:nd05:bpd"), entity_ref("urn:de:bgb:dr:nd05:berechtigte")));
    expect truth_status == NEITHER;
}
