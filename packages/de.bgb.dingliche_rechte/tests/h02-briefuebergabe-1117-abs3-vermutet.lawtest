language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1117 Abs. 3: Der Gläubiger ist im Besitz des Briefes; die Übergabe wird vermutet. Der Fall stellt das Gegenteil nicht fest, die Vermutung hält.
test "§ 1117 Abs. 3: Besitz des Briefes — die Übergabe wird vermutet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": glaeubiger_im_besitz_des_briefes(entity_ref("urn:de:bgb:dr:h02:hyp")) { origin adjudicated; }
    }
    evaluate truth(uebergabe_des_briefes_vermutet(entity_ref("urn:de:bgb:dr:h02:hyp")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
