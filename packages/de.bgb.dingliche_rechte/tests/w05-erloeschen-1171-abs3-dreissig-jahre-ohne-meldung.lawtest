language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1171 Abs. 3: der Ausschließungsbeschluss wird am 15.03.1996 rechtskräftig; die Dreißigjahresfrist endet am 15.03.2026, ohne dass sich der Gläubiger bei der Hinterlegungsstelle gemeldet hätte — sein Recht auf den hinterlegten Betrag erlischt.
test "§ 1171 Abs. 3: Erlöschen des Rechts auf den hinterlegten Betrag nach dreißig Jahren ohne Meldung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": erloeschensfrist_des_hinterlegten_betrags(entity_ref("urn:de:bgb:dr:w05:hyp"), entity_ref("urn:de:bgb:dr:w05:frist")) { origin case_input; }
        assert "f2": ausschliessungsbeschluss_rechtskraeftig_am(entity_ref("urn:de:bgb:dr:w05:hyp"), @1996-03-15) { origin adjudicated; }
        assert "f3": keine_meldung_bei_der_hinterlegungsstelle(entity_ref("urn:de:bgb:dr:w05:hyp")) { origin adjudicated; }
    }
    evaluate truth(recht_auf_den_hinterlegten_betrag_erloschen_am(entity_ref("urn:de:bgb:dr:w05:hyp"), @2026-03-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
