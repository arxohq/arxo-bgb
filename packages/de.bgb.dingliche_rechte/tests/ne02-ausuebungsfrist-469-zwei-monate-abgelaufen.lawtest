language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1098 Abs. 1 i.V.m. § 469 Abs. 2 Satz 1: die Mitteilung über den Drittkaufvertrag geht am 01.02.2026 zu; die zweimonatige Frist endet am 01.04.2026, ohne dass der Berechtigte ausgeübt hat.
test "§ 469 Abs. 2 Satz 1: Ausübungsfrist von zwei Monaten ohne Ausübung abgelaufen" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": vk_469_frist(entity_ref("urn:de:bgb:dr:ne02:vk"), entity_ref("urn:de:bgb:dr:ne02:frist")) { origin case_input; }
        assert "f2": vk_469_mitteilung_empfangen_am(entity_ref("urn:de:bgb:dr:ne02:vk"), @2026-02-01) { origin adjudicated; }
        assert "f3": vk_keine_ausuebung_erfolgt(entity_ref("urn:de:bgb:dr:ne02:vk")) { origin case_input; }
    }
    evaluate truth(vk_469_ausuebungsfrist_abgelaufen(entity_ref("urn:de:bgb:dr:ne02:vk")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
