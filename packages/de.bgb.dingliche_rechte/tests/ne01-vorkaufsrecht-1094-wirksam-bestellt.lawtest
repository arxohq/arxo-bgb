language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1094 Abs. 1: ein dingliches Vorkaufsrecht zugunsten einer bestimmten Person wird an einem Grundstück bestellt.
test "§ 1094 Abs. 1: dingliches Vorkaufsrecht wirksam bestellt" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_grundstueck(entity_ref("urn:de:bgb:dr:ne01:vk"), entity_ref("urn:de:bgb:dr:ne01:grundstueck")) { origin case_input; }
        assert "f2": berechtigter(entity_ref("urn:de:bgb:dr:ne01:vk"), entity_ref("urn:de:bgb:dr:ne01:berechtigter")) { origin case_input; }
    }
    evaluate truth(vk_wirksam_bestellt(entity_ref("urn:de:bgb:dr:ne01:vk")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
