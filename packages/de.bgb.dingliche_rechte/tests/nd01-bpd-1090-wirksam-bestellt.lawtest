language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1090 Abs. 1: ein Fischereirecht zugunsten einer bestimmten Person wird als beschränkte persönliche Dienstbarkeit bestellt.
test "§ 1090 Abs. 1: beschränkte persönliche Dienstbarkeit wirksam bestellt" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_grundstueck(entity_ref("urn:de:bgb:dr:nd01:bpd"), entity_ref("urn:de:bgb:dr:nd01:grundstueck")) { origin case_input; }
        assert "f2": berechtigter(entity_ref("urn:de:bgb:dr:nd01:bpd"), entity_ref("urn:de:bgb:dr:nd01:berechtigter")) { origin case_input; }
        assert "f3": bpd_befugnis_grunddienstbarkeitsfaehig(entity_ref("urn:de:bgb:dr:nd01:bpd")) { origin adjudicated; }
    }
    evaluate truth(bpd_wirksam_bestellt(entity_ref("urn:de:bgb:dr:nd01:bpd")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(bpd_sachvorschriften_der_grunddienstbarkeit_gelten(entity_ref("urn:de:bgb:dr:nd01:bpd")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
