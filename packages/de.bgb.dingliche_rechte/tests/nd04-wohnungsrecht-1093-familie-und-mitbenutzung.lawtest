language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1093 Abs. 1-3: ein Wohnungsrecht an der oberen Etage eines Hauses ist bestellt; die Berechtigte darf ihre Familie aufnehmen und Treppenhaus und Waschküche mitbenutzen, da das Recht auf einen Gebäudeteil beschränkt ist.
test "§ 1093 Abs. 2, 3: Aufnahme der Familie und Mitbenutzung gemeinschaftlicher Anlagen" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": ist_wohnungsrecht(entity_ref("urn:de:bgb:dr:nd04:bpd")) { origin case_input; }
        assert "f2": berechtigter(entity_ref("urn:de:bgb:dr:nd04:bpd"), entity_ref("urn:de:bgb:dr:nd04:berechtigte")) { origin case_input; }
        assert "f3": wohnungsrecht_auf_gebaeudeteil_beschraenkt(entity_ref("urn:de:bgb:dr:nd04:bpd")) { origin adjudicated; }
    }
    evaluate truth(berechtigter_darf_familie_und_pflegepersonal_aufnehmen(entity_ref("urn:de:bgb:dr:nd04:bpd"), entity_ref("urn:de:bgb:dr:nd04:berechtigte")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(berechtigter_darf_gemeinschaftliche_anlagen_mitbenutzen(entity_ref("urn:de:bgb:dr:nd04:bpd"), entity_ref("urn:de:bgb:dr:nd04:berechtigte")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
