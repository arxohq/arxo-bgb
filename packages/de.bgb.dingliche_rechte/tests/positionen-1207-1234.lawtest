language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

test "§§ 1207, 1218, 1234: Pfandpositionen aktiv" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1207(entity_ref("urn:dr:pf1207"), entity_ref("urn:dr:p1207"), @2026-01-01) { origin case_input; }
 assert "b": position_trigger_1218(entity_ref("urn:dr:pf1218"), entity_ref("urn:dr:p1218"), @2026-01-01) { origin case_input; }
 assert "c": position_trigger_1234(entity_ref("urn:dr:pf1234"), entity_ref("urn:dr:p1234"), @2026-01-01) { origin case_input; }
 assert "cg": verkauf_1234_vorfristig(entity_ref("urn:dr:pf1234")) { origin case_input; } }
 evaluate positions();
 expect position(Gutglaeubiger1207, ACTIVE); expect position(Rueckgabe1218, ACTIVE); expect position(Verkaufswartefrist1234, SATISFIED);
}

test "§§ 1207, 1218, 1234: Pfandpositionen ausgeübt" {
 given { context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
 assert "a": position_trigger_1207(entity_ref("urn:dr:pf1207"), entity_ref("urn:dr:p1207"), @2026-01-01) { origin case_input; }
 assert "ag": erwerb_1207_unwirksam(entity_ref("urn:dr:pf1207")) { origin case_input; }
 assert "b": position_trigger_1218(entity_ref("urn:dr:pf1218"), entity_ref("urn:dr:p1218"), @2026-01-01) { origin case_input; }
 assert "bg": rueckgabe_1218_ausuebbar(entity_ref("urn:dr:pf1218"), entity_ref("urn:dr:p1218")) { origin case_input; }
 assert "c": position_trigger_1234(entity_ref("urn:dr:pf1234"), entity_ref("urn:dr:p1234"), @2026-01-01) { origin case_input; }
 assert "cg": verkauf_1234_vorfristig(entity_ref("urn:dr:pf1234")) { origin case_input; } }
 evaluate positions();
 expect position(Gutglaeubiger1207, ACTIVE); expect position(Rueckgabe1218, ACTIVE); expect position(Verkaufswartefrist1234, SATISFIED);
}
