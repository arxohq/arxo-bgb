language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1020 Satz 2: der Berechtigte hält zur Ausübung eine Anlage; das Gericht stellt fest, dass das Eigentümerinteresse ihre Erhaltung erfordert.
test "§ 1020 Satz 1, 2: Schonungspflicht und Erhaltungspflicht der Anlage" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_grundstueck(entity_ref("urn:de:bgb:dr:n03:gd"), entity_ref("urn:de:bgb:dr:n03:belastet")) { origin case_input; }
        assert "f2": herrschendes_grundstueck(entity_ref("urn:de:bgb:dr:n03:gd"), entity_ref("urn:de:bgb:dr:n03:herrschend")) { origin case_input; }
        assert "f3": berechtigter(entity_ref("urn:de:bgb:dr:n03:gd"), entity_ref("urn:de:bgb:dr:n03:eigentuemer_h")) { origin case_input; }
        assert "f4": inhalt_der_grunddienstbarkeit(entity_ref("urn:de:bgb:dr:n03:gd"), Nutzungsrecht) { origin case_input; }
        assert "f5": vorteil_fuer_die_benutzung_des_herrschenden_grundstuecks(entity_ref("urn:de:bgb:dr:n03:gd")) { origin adjudicated; }
        assert "f6": anlage_zur_ausuebung_auf_dem_belasteten_grundstueck_gehalten(entity_ref("urn:de:bgb:dr:n03:gd")) { origin case_input; }
        assert "f7": eigentuemerinteresse_erfordert_erhaltung_der_anlage(entity_ref("urn:de:bgb:dr:n03:gd")) { origin adjudicated; }
    }
    evaluate truth(schonungspflicht_bei_der_ausuebung(entity_ref("urn:de:bgb:dr:n03:gd")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(erhaltungspflicht_der_anlage(entity_ref("urn:de:bgb:dr:n03:gd")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
