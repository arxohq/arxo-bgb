language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu nb14 (zweiter Teil): dieselbe Konsolidation, aber der Eigentümer hat ein rechtliches Interesse am Fortbestehen (§ 1063 Abs. 2) — der Nießbrauch gilt als nicht erloschen.
test "§ 1063 Abs. 2: Nießbrauch gilt bei rechtlichem Interesse als nicht erloschen" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": niessbrauch_und_eigentum_in_derselben_person(entity_ref("urn:de:bgb:dr:nb15:nb")) { origin adjudicated; }
        assert "f2": eigentuemer_hat_rechtliches_interesse_am_fortbestand(entity_ref("urn:de:bgb:dr:nb15:nb")) { origin adjudicated; }
    }
    evaluate truth(niessbrauch_gilt_als_nicht_erloschen(entity_ref("urn:de:bgb:dr:nb15:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
