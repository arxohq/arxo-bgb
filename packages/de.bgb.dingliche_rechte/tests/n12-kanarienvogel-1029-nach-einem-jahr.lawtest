language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Gegenstück zu n11: dieselbe letzte Ausübung am 01.02.2025, die Störung erfolgt aber erst am 05.02.2026 — mehr als ein Jahr danach.
test "Kanarienvogel § 1029: keine entsprechende Anwendung nach Ablauf eines Jahres seit der letzten Ausübung" {
    given {
        context { legal_time @2026-02-10; decision_time @2026-02-10T09:00:00Z; knowledge_time @2026-02-10T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": dienstbarkeit_im_grundbuch_fuer_den_eigentuemer_eingetragen(entity_ref("urn:de:bgb:dr:n12:gd")) { origin adjudicated; }
        assert "f2": ausuebung_zuletzt_am(entity_ref("urn:de:bgb:dr:n12:gd"), @2025-02-01) { origin adjudicated; }
        assert "f3": stoerung_der_ausuebung_am(entity_ref("urn:de:bgb:dr:n12:gd"), entity_ref("urn:de:bgb:dr:n12:stoerer"), @2026-02-05) { origin adjudicated; }
    }
    evaluate truth(dienstbarkeitsbesitzschutz_anwendbar(entity_ref("urn:de:bgb:dr:n12:gd"), entity_ref("urn:de:bgb:dr:n12:stoerer")));
    expect truth_status == NEITHER;
}
