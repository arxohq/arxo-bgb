language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// Kanarienvogel zu n03: ohne die gerichtliche Feststellung des Eigentümerinteresses fehlt die Erhaltungspflicht, obwohl eine Anlage gehalten wird.
test "Kanarienvogel § 1020 Satz 2: ohne Feststellung des Eigentümerinteresses keine Erhaltungspflicht" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": belastungsgegenstand_grundstueck(entity_ref("urn:de:bgb:dr:n04:gd"), entity_ref("urn:de:bgb:dr:n04:belastet")) { origin case_input; }
        assert "f2": herrschendes_grundstueck(entity_ref("urn:de:bgb:dr:n04:gd"), entity_ref("urn:de:bgb:dr:n04:herrschend")) { origin case_input; }
        assert "f3": berechtigter(entity_ref("urn:de:bgb:dr:n04:gd"), entity_ref("urn:de:bgb:dr:n04:eigentuemer_h")) { origin case_input; }
        assert "f4": inhalt_der_grunddienstbarkeit(entity_ref("urn:de:bgb:dr:n04:gd"), Nutzungsrecht) { origin case_input; }
        assert "f5": vorteil_fuer_die_benutzung_des_herrschenden_grundstuecks(entity_ref("urn:de:bgb:dr:n04:gd")) { origin adjudicated; }
        assert "f6": anlage_zur_ausuebung_auf_dem_belasteten_grundstueck_gehalten(entity_ref("urn:de:bgb:dr:n04:gd")) { origin case_input; }
    }
    evaluate truth(erhaltungspflicht_der_anlage(entity_ref("urn:de:bgb:dr:n04:gd")));
    expect truth_status == NEITHER;
}
