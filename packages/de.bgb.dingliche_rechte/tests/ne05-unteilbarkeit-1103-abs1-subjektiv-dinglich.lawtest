language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1103 Abs. 1: ein zugunsten des jeweiligen Eigentümers des herrschenden Grundstücks bestehendes Vorkaufsrecht kann nicht vom Eigentum daran getrennt werden.
test "§ 1103 Abs. 1: subjektiv-dingliches Vorkaufsrecht untrennbar vom Eigentum" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": vk_herrschendes_grundstueck(entity_ref("urn:de:bgb:dr:ne05:vk"), entity_ref("urn:de:bgb:dr:ne05:herrschend")) { origin case_input; }
    }
    evaluate truth(vk_subjektiv_dinglich_untrennbar(entity_ref("urn:de:bgb:dr:ne05:vk")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
