language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

test "Welle 2: Nießbrauch, Vorkaufsrecht und Hypothek" {
 given {
   context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
   assert "a": position_trigger_1045(entity_ref("urn:dr:n1045"), entity_ref("urn:dr:p1045"), @2026-01-01) { origin case_input; }
   assert "b": position_trigger_1077(entity_ref("urn:dr:n1077"), entity_ref("urn:dr:p1077"), entity_ref("urn:dr:g1077"), @2026-01-01) { origin case_input; }
   assert "c": position_trigger_1099(entity_ref("urn:dr:v1099"), entity_ref("urn:dr:p1099"), entity_ref("urn:dr:q1099"), @2026-01-01) { origin case_input; }
   assert "d": position_trigger_1115(entity_ref("urn:dr:h1115"), entity_ref("urn:dr:p1115"), @2026-01-01) { origin case_input; }
   assert "e": position_trigger_1214(entity_ref("urn:dr:pf1214"), entity_ref("urn:dr:p1214"), @2026-01-01) { origin case_input; }
   assert "f": position_trigger_1241(entity_ref("urn:dr:pf1241"), entity_ref("urn:dr:p1241"), @2026-01-01) { origin case_input; }
   assert "g": position_trigger_1285(entity_ref("urn:dr:pf1285"), entity_ref("urn:dr:p1285"), entity_ref("urn:dr:q1285"), @2026-01-01) { origin case_input; }
   assert "h": versicherungszahlung_1045_geschuldet(entity_ref("urn:dr:n1045"), entity_ref("urn:dr:p1045")) { origin case_input; }
   assert "i": gemeinschaftliche_leistung_1077_geschuldet(entity_ref("urn:dr:n1077"), entity_ref("urn:dr:p1077"), entity_ref("urn:dr:g1077")) { origin case_input; }
   assert "j": benachrichtigung_1099_geschuldet(entity_ref("urn:dr:v1099"), entity_ref("urn:dr:p1099"), entity_ref("urn:dr:q1099")) { origin case_input; }
   assert "k": eintragung_1115_geschuldet(entity_ref("urn:dr:h1115"), entity_ref("urn:dr:p1115")) { origin case_input; }
   assert "l": rechnungslegung_1214_geschuldet(entity_ref("urn:dr:pf1214"), entity_ref("urn:dr:p1214")) { origin case_input; }
   assert "m": benachrichtigung_1241_geschuldet(entity_ref("urn:dr:pf1241"), entity_ref("urn:dr:p1241")) { origin case_input; }
   assert "n": mitwirkung_1285_geschuldet(entity_ref("urn:dr:pf1285"), entity_ref("urn:dr:p1285"), entity_ref("urn:dr:q1285")) { origin case_input; }
 }
 evaluate positions();
 expect position(Versicherung1045, SATISFIED);
 expect position(GemeinschaftlicheLeistung1077, SATISFIED);
 expect position(Benachrichtigung1099, SATISFIED);
 expect position(Eintragung1115, SATISFIED);
 expect position(Rechnungslegung1214, SATISFIED);
 expect position(Benachrichtigung1241, SATISFIED);
 expect position(Mitwirkung1285, SATISFIED);
}

test "Welle 2: neue Positionen bleiben bei fehlender Ausübung offen" {
 given {
   context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00Z; knowledge_time @2026-06-15T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; }
   assert "a": position_trigger_1045(entity_ref("urn:dr:n1045-2"), entity_ref("urn:dr:p1045-2"), @2026-01-01) { origin case_input; }
   assert "b": position_trigger_1077(entity_ref("urn:dr:n1077-2"), entity_ref("urn:dr:p1077-2"), entity_ref("urn:dr:g1077-2"), @2026-01-01) { origin case_input; }
   assert "c": position_trigger_1099(entity_ref("urn:dr:v1099-2"), entity_ref("urn:dr:p1099-2"), entity_ref("urn:dr:q1099-2"), @2026-01-01) { origin case_input; }
   assert "d": position_trigger_1115(entity_ref("urn:dr:h1115-2"), entity_ref("urn:dr:p1115-2"), @2026-01-01) { origin case_input; }
   assert "e": position_trigger_1214(entity_ref("urn:dr:pf1214-2"), entity_ref("urn:dr:p1214-2"), @2026-01-01) { origin case_input; }
   assert "f": position_trigger_1241(entity_ref("urn:dr:pf1241-2"), entity_ref("urn:dr:p1241-2"), @2026-01-01) { origin case_input; }
   assert "g": position_trigger_1285(entity_ref("urn:dr:pf1285-2"), entity_ref("urn:dr:p1285-2"), entity_ref("urn:dr:q1285-2"), @2026-01-01) { origin case_input; }
 }
 evaluate positions();
 expect position(Versicherung1045, ACTIVE);
 expect position(GemeinschaftlicheLeistung1077, ACTIVE);
 expect position(Benachrichtigung1099, ACTIVE);
 expect position(Eintragung1115, ACTIVE);
 expect position(Rechnungslegung1214, ACTIVE);
 expect position(Benachrichtigung1241, ACTIVE);
 expect position(Mitwirkung1285, ACTIVE);
}
