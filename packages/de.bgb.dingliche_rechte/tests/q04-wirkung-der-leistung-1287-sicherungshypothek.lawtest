language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1287: Leistet der Schuldner in Gemäßheit des § 1281, so erwirbt der Gläubiger den geleisteten Gegenstand und der Pfandgläubiger ein Pfandrecht an ihm; besteht die Leistung in der Übertragung des Eigentums an einem Grundstück, so erwirbt der Pfandgläubiger eine SICHERUNGSHYPOTHEK (§ 1184, Abschnitt 7 desselben Pakets).
test "§ 1287: die Leistung eines Grundstücks verschafft dem Pfandgläubiger eine Sicherungshypothek" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": verpfaendetes_recht(entity_ref("urn:de:bgb:dr:q04:pfand"), entity_ref("urn:de:bgb:dr:q04:forderung")) { origin case_input; }
        assert "f2": recht_ist_eine_forderung(entity_ref("urn:de:bgb:dr:q04:forderung")) { origin case_input; }
        assert "f3": abtretungsvertrag_genuegt_zur_uebertragung(entity_ref("urn:de:bgb:dr:q04:forderung")) { origin case_input; }
        assert "f4": bestellung_nach_den_uebertragungsvorschriften(entity_ref("urn:de:bgb:dr:q04:pfand")) { origin adjudicated; }
        assert "f5": verpfaendung_dem_schuldner_angezeigt(entity_ref("urn:de:bgb:dr:q04:pfand")) { origin adjudicated; }
        assert "f6": not recht_nicht_uebertragbar(entity_ref("urn:de:bgb:dr:q04:forderung")) { origin adjudicated; }
        assert "f7": schuldner_der_verpfaendeten_forderung(entity_ref("urn:de:bgb:dr:q04:forderung"), entity_ref("urn:de:bgb:dr:q04:s")) { origin case_input; }
        assert "f8": pfandglaeubiger(entity_ref("urn:de:bgb:dr:q04:pfand"), entity_ref("urn:de:bgb:dr:q04:bank")) { origin case_input; }
        assert "f9": voraussetzungen_des_1228_abs2_noch_nicht_eingetreten(entity_ref("urn:de:bgb:dr:q04:pfand")) { origin case_input; }
        assert "f10": not abweichende_vereinbarung_ueber_die_einziehung(entity_ref("urn:de:bgb:dr:q04:pfand")) { origin adjudicated; }
        assert "f11": geleisteter_gegenstand(entity_ref("urn:de:bgb:dr:q04:pfand"), entity_ref("urn:de:bgb:dr:q04:grundstueck")) { origin adjudicated; }
        assert "f12": leistung_in_uebertragung_des_eigentums_am_grundstueck(entity_ref("urn:de:bgb:dr:q04:pfand"), entity_ref("urn:de:bgb:dr:q04:grundstueck")) { origin adjudicated; }
    }
    evaluate truth(glaeubiger_erwirbt_den_gegenstand(entity_ref("urn:de:bgb:dr:q04:pfand"), entity_ref("urn:de:bgb:dr:q04:grundstueck")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(sicherungshypothek_am_grundstueck_erworben(entity_ref("urn:de:bgb:dr:q04:pfand"), entity_ref("urn:de:bgb:dr:q04:grundstueck")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
