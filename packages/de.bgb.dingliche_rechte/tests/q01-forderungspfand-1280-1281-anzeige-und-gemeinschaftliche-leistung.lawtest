language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1280: Die Verpfändung einer durch Abtretungsvertrag übertragbaren Forderung wird erst mit der Anzeige an den Schuldner wirksam. § 1281: Vor dem Eintritt der Voraussetzungen des § 1228 Abs. 2 kann der Schuldner nur an Pfandgläubiger und Gläubiger GEMEINSCHAFTLICH leisten.
test "§ 1280, § 1281: Anzeige an den Schuldner und gemeinschaftliche Leistung vor der Pfandreife" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": verpfaendetes_recht(entity_ref("urn:de:bgb:dr:q01:pfand"), entity_ref("urn:de:bgb:dr:q01:forderung")) { origin case_input; }
        assert "f2": recht_ist_eine_forderung(entity_ref("urn:de:bgb:dr:q01:forderung")) { origin case_input; }
        assert "f3": abtretungsvertrag_genuegt_zur_uebertragung(entity_ref("urn:de:bgb:dr:q01:forderung")) { origin case_input; }
        assert "f4": bestellung_nach_den_uebertragungsvorschriften(entity_ref("urn:de:bgb:dr:q01:pfand")) { origin adjudicated; }
        assert "f5": verpfaendung_dem_schuldner_angezeigt(entity_ref("urn:de:bgb:dr:q01:pfand")) { origin adjudicated; }
        assert "f6": not recht_nicht_uebertragbar(entity_ref("urn:de:bgb:dr:q01:forderung")) { origin adjudicated; }
        assert "f7": schuldner_der_verpfaendeten_forderung(entity_ref("urn:de:bgb:dr:q01:forderung"), entity_ref("urn:de:bgb:dr:q01:s")) { origin case_input; }
        assert "f8": pfandglaeubiger(entity_ref("urn:de:bgb:dr:q01:pfand"), entity_ref("urn:de:bgb:dr:q01:bank")) { origin case_input; }
        assert "f9": voraussetzungen_des_1228_abs2_noch_nicht_eingetreten(entity_ref("urn:de:bgb:dr:q01:pfand")) { origin case_input; }
        assert "f10": not abweichende_vereinbarung_ueber_die_einziehung(entity_ref("urn:de:bgb:dr:q01:pfand")) { origin adjudicated; }
    }
    evaluate truth(pfandrecht_am_recht_entstanden(entity_ref("urn:de:bgb:dr:q01:pfand"), entity_ref("urn:de:bgb:dr:q01:forderung")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(leistung_nur_gemeinschaftlich(entity_ref("urn:de:bgb:dr:q01:pfand"), entity_ref("urn:de:bgb:dr:q01:s")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
