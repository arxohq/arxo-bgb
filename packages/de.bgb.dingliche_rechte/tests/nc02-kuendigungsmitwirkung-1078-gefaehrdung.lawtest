language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1078 Satz 2: die Fälligkeit einer verzinslichen Forderung hängt von einer Kündigung ab; das Gericht stellt fest, dass die Einziehung wegen Gefährdung ihrer Sicherheit nach ordnungsmäßiger Vermögensverwaltung geboten ist.
test "§ 1078 Satz 2: Mitwirkungspflicht zur Kündigung bei Gefährdung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": forderung_verzinslich_ausstehend(entity_ref("urn:de:bgb:dr:nc02:nb")) { origin case_input; }
        assert "f2": niessbrauch_faelligkeit_haengt_von_kuendigung_ab(entity_ref("urn:de:bgb:dr:nc02:nb")) { origin case_input; }
        assert "f3": kuendigungsmitwirkung_wegen_gefaehrdung_geboten(entity_ref("urn:de:bgb:dr:nc02:nb")) { origin adjudicated; }
    }
    evaluate truth(mitwirkungspflicht_zur_kuendigung(entity_ref("urn:de:bgb:dr:nc02:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
