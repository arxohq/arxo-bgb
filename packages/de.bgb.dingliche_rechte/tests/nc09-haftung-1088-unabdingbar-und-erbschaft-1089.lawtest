language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1088 Abs. 1, 2: ein Gläubiger mit schon bei Bestellung verzinslicher Forderung kann die Zinsen vom Nießbraucher verlangen; die Haftung ist unabdingbar. § 1089: dasselbe gilt entsprechend für den Nießbrauch an einer Erbschaft.
test "§ 1088 Abs. 1, 2, § 1089: Zinshaftung des Nießbrauchers, unabdingbar, auch bei Erbschaft" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": erbschaftsniessbrauch(entity_ref("urn:de:bgb:dr:nc09:nb"), entity_ref("urn:de:bgb:dr:nc09:besteller")) { origin case_input; }
        assert "f2": glaeubigerforderung_bei_bestellung_verzinslich(entity_ref("urn:de:bgb:dr:nc09:nb"), entity_ref("urn:de:bgb:dr:nc09:glaeubiger")) { origin adjudicated; }
    }
    evaluate truth(vermoegensniessbrauch(entity_ref("urn:de:bgb:dr:nc09:nb"), entity_ref("urn:de:bgb:dr:nc09:besteller")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(glaeubiger_kann_zinsen_vom_niessbraucher_verlangen(entity_ref("urn:de:bgb:dr:nc09:nb"), entity_ref("urn:de:bgb:dr:nc09:glaeubiger")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(haftung_unabdingbar(entity_ref("urn:de:bgb:dr:nc09:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
