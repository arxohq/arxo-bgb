language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1050: eine Wertminderung wird gerichtlich als Folge der ordnungsmäßigen Ausübung des Nießbrauchs festgestellt.
test "§ 1050: keine Verantwortlichkeit bei ordnungsmäßiger Ausübung" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": veraenderung_oder_verschlechterung(entity_ref("urn:de:bgb:dr:nb07:nb")) { origin adjudicated; }
        assert "f2": herbeigefuehrt_durch_ordnungsmaessige_ausuebung(entity_ref("urn:de:bgb:dr:nb07:nb")) { origin adjudicated; }
    }
    evaluate truth(keine_verantwortlichkeit_des_niessbrauchers(entity_ref("urn:de:bgb:dr:nb07:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
