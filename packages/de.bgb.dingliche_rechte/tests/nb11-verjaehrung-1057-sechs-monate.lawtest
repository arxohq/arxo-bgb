language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";
// § 1057 Satz 1: die Sache wurde am 10.03.2026 an den Eigentümer zurückgegeben; die sechsmonatige Verjährungsfrist des Ersatzanspruchs wegen Verschlechterung läuft ohne Verlegung des § 193 (wie § 1226, Ledger D-11-04).
test "§ 1057 Satz 1: Verjährung des Ersatzanspruchs nach sechs Monaten seit Rückgabe" {
    given {
        context { legal_time @2026-09-18; decision_time @2026-09-18T09:00:00Z; knowledge_time @2026-09-18T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dingliche_rechte::KALENDER_BUNDESWEIT; deadline_policy BGB_DINGLICHE_RECHTE_KALENDER; }
        assert "f1": ersatzanspruch_wegen_veraenderung_oder_verschlechterung(entity_ref("urn:de:bgb:dr:nb11:nb"), entity_ref("urn:de:bgb:dr:nb11:anspruch")) { origin case_input; }
        assert "f2": ruckgabe_der_sache_an_am(entity_ref("urn:de:bgb:dr:nb11:nb"), @2026-03-10) { origin adjudicated; }
        assert "f3": ersatzanspruch_1057_frist(entity_ref("urn:de:bgb:dr:nb11:nb"), entity_ref("urn:de:bgb:dr:nb11:frist")) { origin case_input; }
    }
    evaluate truth(ersatzanspruch_1057_verjaehrt(entity_ref("urn:de:bgb:dr:nb11:nb")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
