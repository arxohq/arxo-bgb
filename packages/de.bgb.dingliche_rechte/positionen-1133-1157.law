language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

pub relation position_trigger_1133(h: Grundpfandrecht, glaeubiger: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur sofortigen Befriedigung aus dem Grundstück (§ 1133)"; label en unofficial "case input for immediate satisfaction from the land (§ 1133)"; }
pub relation befriedigung_1133_ausuebbar(h: Grundpfandrecht, glaeubiger: Person) kind empirical { label de official "Der Hypothekengläubiger darf sofort Befriedigung suchen (§ 1133)"; label en unofficial "The mortgage creditor may seek immediate satisfaction (§ 1133)"; }
pub relation position_trigger_1147(h: Grundpfandrecht, glaeubiger: Person, g: Grundstueck, tag: Date) kind empirical { label de official "Eingang des Falls zur Zwangsvollstreckung (§ 1147)"; label en unofficial "case input for enforcement (§ 1147)"; }
pub relation befriedigung_1147_ausuebbar(h: Grundpfandrecht, glaeubiger: Person) kind empirical { label de official "Der Gläubiger darf Befriedigung im Wege der Zwangsvollstreckung suchen (§ 1147)"; label en unofficial "The creditor may seek satisfaction by enforcement (§ 1147)"; }
pub relation position_trigger_1157(h: Grundpfandrecht, e: Einrede, eigentuemer: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Geltendmachung einer Einrede gegenüber dem neuen Gläubiger (§ 1157)"; label en unofficial "case input for raising a defence against the new creditor (§ 1157)"; }
pub relation einrede_1157_geschuetzt(e: Einrede, h: Grundpfandrecht, eigentuemer: Person) kind empirical { label de official "Die Einrede kann auch dem neuen Gläubiger entgegengesetzt werden (§ 1157)"; label en unofficial "The defence may also be raised against the new creditor (§ 1157)"; }

@source(BGB_P1133)
rule PositionBefriedigung1133(h: Grundpfandrecht, glaeubiger: Person, tag: Date) strict { label de official "Der Hypothekengläubiger ist nach Fristablauf zur sofortigen Befriedigung berechtigt (§ 1133)"; label en unofficial "The mortgage creditor may seek immediate satisfaction after expiry of the period (§ 1133)"; when position_trigger_1133(h, glaeubiger, tag); then power Befriedigung1133 { holder glaeubiger; over h; exercise befriedigung_1133_ausuebbar(h, glaeubiger); valid_when befriedigung_1133_ausuebbar(h, glaeubiger); effect create(befriedigung_1133_ausuebbar(h, glaeubiger)); window [tag, infinity); }; }
@source(BGB_P1147)
rule PositionZwangsvollstreckung1147(h: Grundpfandrecht, glaeubiger: Person, g: Grundstueck, tag: Date) strict { label de official "Der Gläubiger darf Befriedigung aus dem Grundstück im Wege der Zwangsvollstreckung suchen (§ 1147)"; label en unofficial "The creditor may seek satisfaction from the land by enforcement (§ 1147)"; when position_trigger_1147(h, glaeubiger, g, tag); then power Zwangsvollstreckung1147 { holder glaeubiger; over h; exercise befriedigung_1147_ausuebbar(h, glaeubiger); valid_when befriedigung_1147_ausuebbar(h, glaeubiger); effect create(befriedigung_1147_ausuebbar(h, glaeubiger)); window [tag, infinity); }; }
@source(BGB_P1157)
rule PositionEinrede1157(h: Grundpfandrecht, e: Einrede, eigentuemer: Person, tag: Date) strict { label de official "Der Eigentümer ist gegen den neuen Gläubiger durch die Einrede geschützt (§ 1157)"; label en unofficial "The owner is protected against the new creditor by the defence (§ 1157)"; when position_trigger_1157(h, e, eigentuemer, tag); then immunity Einrede1157 { holder eigentuemer; against h; protected_effect einrede_1157_geschuetzt(e, h, eigentuemer); window [tag, infinity); }; }
