language "law.core" version "0.2";
package de.bgb.dingliche_rechte version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dingliche-rechte";

pub relation position_trigger_1018(d: Grunddienstbarkeit, p: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Bestellung der Grunddienstbarkeit (§ 1018)"; label en unofficial "case input for creation of the easement (§ 1018)"; }
pub relation grunddienstbarkeit_1018_geschuldet(d: Grunddienstbarkeit) kind empirical { label de official "Die Grunddienstbarkeit ist wirksam bestellt (§ 1018)"; label en unofficial "The easement is validly created (§ 1018)"; }
pub relation position_trigger_1020(d: Grunddienstbarkeit, p: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur schonenden Ausübung (§ 1020)"; label en unofficial "case input for considerate exercise (§ 1020)"; }
pub relation schonung_1020_geschuldet(d: Grunddienstbarkeit) kind empirical { label de official "Das Interesse des Eigentümers ist zu schonen (§ 1020)"; label en unofficial "The owner's interest must be spared (§ 1020)"; }
pub relation position_trigger_1021(d: Grunddienstbarkeit, p: Person, tag: Date) kind empirical { label de official "Eingang des Falls zur Unterhaltung der Anlage (§ 1021)"; label en unofficial "case input for maintenance of the installation (§ 1021)"; }
pub relation unterhaltung_1021_geschuldet(d: Grunddienstbarkeit) kind empirical { label de official "Die Anlage ist zu unterhalten (§ 1021)"; label en unofficial "The installation must be maintained (§ 1021)"; }

@source(BGB_P1018)
rule PositionBestellung1018(d: Grunddienstbarkeit, p: Person, tag: Date) strict { label de official "Die Grunddienstbarkeit ist wirksam zu bestellen (§ 1018)"; label en unofficial "The easement must be validly created (§ 1018)"; when position_trigger_1018(d, p, tag); then duty Bestellung1018 { bearer p; achieve grunddienstbarkeit_1018_geschuldet(d) during [tag, infinity); }; }
@source(BGB_P1020)
rule PositionSchonung1020(d: Grunddienstbarkeit, p: Person, tag: Date) strict { label de official "Der Berechtigte hat das Eigentümerinteresse zu schonen (§ 1020)"; label en unofficial "The entitled party must spare the owner's interest (§ 1020)"; when position_trigger_1020(d, p, tag); then duty Schonung1020 { bearer p; achieve schonung_1020_geschuldet(d) during [tag, infinity); }; }
@source(BGB_P1021)
rule PositionUnterhaltung1021(d: Grunddienstbarkeit, p: Person, tag: Date) strict { label de official "Die Anlage ist zu unterhalten (§ 1021)"; label en unofficial "The installation must be maintained (§ 1021)"; when position_trigger_1021(d, p, tag); then duty Unterhaltung1021 { bearer p; achieve unterhaltung_1021_geschuldet(d) during [tag, infinity); }; }
