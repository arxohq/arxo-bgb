// --- Buch 3 Abschnitt 7 Titel 1: Hypothek (§§ 1113–1190) -----------------------------------------
//
// EINE ENTITÄT, EINE ART. `Grundpfandrecht` trägt Hypothek, Sicherungshypothek,
// Höchstbetragshypothek, Grundschuld, Sicherungsgrundschuld und Rentenschuld;
// § 1192 Abs. 1 und § 1200 Abs. 1 ordnen die entsprechende Anwendung an
// (Ledger D-11-02). Das Grundpfandrecht ist ein `Recht` im Sinne des
// Nachbarpakets: Eintragung (§ 873), Rang (§ 879) und öffentlicher Glaube
// (§ 892) kommen von dort (D-11-01).
//
// FORDERUNG. Die gesicherte Forderung ist ein `Anspruch` der Nabe (§ 194
// Abs. 1) mit Betrag und Entstehungstag; die Akzessorietät der §§ 1153, 1163
// und 1181 wird an ihr abgelesen, nicht an einem zweiten Geldfeld.

pub enum Grundpfandrechtsart {
    label de official "Art des Grundpfandrechts, wie sie der Text unterscheidet (§ 1113, § 1184, § 1190, § 1191, § 1192 Abs. 1a, § 1199)";
    label en unofficial "kind of charge on land as distinguished by the text (§ 1113, § 1184, § 1190, § 1191, § 1192 (1a), § 1199)";
    Hypothek,
    Sicherungshypothek,
    Hoechstbetragshypothek,
    Grundschuld,
    Sicherungsgrundschuld,
    Rentenschuld
}

pub entity Grundpfandrecht : Belastung {
    label de official "Grundpfandrecht: Belastung eines Grundstücks in der Weise, dass eine bestimmte Geldsumme aus dem Grundstück zu zahlen ist (§ 1113 Abs. 1, § 1191 Abs. 1, § 1199 Abs. 1)";
    label en unofficial "charge on land: encumbrance under which a certain sum of money is to be paid out of the land (§ 1113 (1), § 1191 (1), § 1199 (1))";
}

// --- Eingaben des Falls ---------------------------------------------------------------------------

pub relation art_des_grundpfandrechts(h: Grundpfandrecht, art: Grundpfandrechtsart) kind empirical {
    key(h);
    label de official "Art des Grundpfandrechts, wie sie sich aus der Bestellung und dem Grundbuch ergibt (§ 1113, § 1184 Abs. 2, § 1190 Abs. 1 Satz 2, § 1191, § 1199)";
    label en unofficial "kind of the charge as it follows from its creation and from the register (§ 1113, § 1184 (2), § 1190 (1) sentence 2, § 1191, § 1199)";
}
pub relation geldsumme(h: Grundpfandrecht, betrag: Money) kind empirical {
    key(h);
    label de official "bestimmte Geldsumme, die aus dem Grundstück zu zahlen ist (§ 1113 Abs. 1, § 1191 Abs. 1); bei der Höchstbetragshypothek der Höchstbetrag (§ 1190 Abs. 1)";
    label en unofficial "certain sum of money to be paid out of the land (§ 1113 (1), § 1191 (1)); with a maximum-amount mortgage, the maximum amount (§ 1190 (1))";
}
pub relation gesicherte_forderung(b: Belastung, a: Anspruch) kind empirical {
    key(b);
    label de official "Forderung, wegen deren die Befriedigung aus dem Grundstück zu erfolgen hat (§ 1113 Abs. 1)";
    label en unofficial "claim for whose satisfaction payment is to be made out of the land (§ 1113 (1))";
}
pub relation kuenftige_oder_bedingte_forderung(h: Grundpfandrecht) kind empirical {
    label de official "die Hypothek ist für eine künftige oder eine bedingte Forderung bestellt (§ 1113 Abs. 2)";
    label en unofficial "the mortgage is created for a future or conditional claim (§ 1113 (2))";
}
pub relation forderung_nicht_zur_entstehung_gelangt(h: Grundpfandrecht) kind empirical {
    label de official "die Forderung, für welche die Hypothek bestellt ist, ist nicht zur Entstehung gelangt (§ 1163 Abs. 1 Satz 1)";
    label en unofficial "the claim for which the mortgage was created has not come into existence (§ 1163 (1) sentence 1)";
}
pub relation forderung_erloschen(h: Grundpfandrecht) kind empirical {
    label de official "die Forderung ist erloschen (§ 1163 Abs. 1 Satz 2)";
    label en unofficial "the claim has been extinguished (§ 1163 (1) sentence 2)";
}
pub relation forderung_verzinslich_mit(h: Grundpfandrecht, satz: Decimal) kind empirical {
    key(h);
    label de official "Zinssatz der Forderung in Hundertsteln, wie er nach § 1115 Abs. 1 im Grundbuch anzugeben ist";
    label en unofficial "interest rate of the claim in per cent as it must be entered under § 1115 (1)";
}
pub relation forderung_unverzinslich(h: Grundpfandrecht) kind empirical {
    label de official "die Forderung ist unverzinslich (§ 1119 Abs. 1, § 1133 Satz 3) — ausdrückliche Eingabe des Falls";
    label en unofficial "the claim bears no interest (§ 1119 (1), § 1133 sentence 3) — explicit case input";
}
pub relation nebenleistungen_im_grundbuch_angegeben(h: Grundpfandrecht, betrag: Money) kind empirical {
    key(h);
    label de official "Geldbetrag anderer zu entrichtender Nebenleistungen, im Grundbuch angegeben (§ 1115 Abs. 1)";
    label en unofficial "amount of other ancillary payments entered in the register (§ 1115 (1))";
}
pub relation glaeubiger_im_grundbuch_angegeben(h: Grundpfandrecht, p: Person) kind empirical {
    label de official "der Gläubiger ist bei der Eintragung der Hypothek im Grundbuch angegeben (§ 1115 Abs. 1)";
    label en unofficial "the creditor is named in the register upon registration of the mortgage (§ 1115 (1))";
}
pub relation geldbetrag_im_grundbuch_angegeben(h: Grundpfandrecht) kind empirical {
    label de official "der Geldbetrag der Forderung ist bei der Eintragung im Grundbuch angegeben (§ 1115 Abs. 1)";
    label en unofficial "the amount of the claim is entered in the register (§ 1115 (1))";
}
pub relation bezugnahme_auf_die_eintragungsbewilligung(h: Grundpfandrecht) kind empirical {
    label de official "zur Bezeichnung der Forderung ist im Übrigen auf die Eintragungsbewilligung Bezug genommen (§ 1115 Abs. 1 Halbsatz 2)";
    label en unofficial "for the rest, reference is made to the approval of registration to identify the claim (§ 1115 (1))";
}
pub relation darlehen_einer_kreditanstalt_mit_bekannt_gemachter_satzung(h: Grundpfandrecht) kind empirical {
    label de official "Hypothek für ein Darlehen einer Kreditanstalt, deren Satzung von der zuständigen Behörde öffentlich bekannt gemacht worden ist (§ 1115 Abs. 2)";
    label en unofficial "mortgage for a loan of a credit institution whose statutes have been published by the competent authority (§ 1115 (2))";
}
pub relation bezugnahme_auf_die_satzung(h: Grundpfandrecht) kind empirical {
    label de official "zur Bezeichnung der satzungsgemäßen Nebenleistungen ist auf die Satzung Bezug genommen (§ 1115 Abs. 2)";
    label en unofficial "reference is made to the statutes to identify the ancillary payments provided for in them (§ 1115 (2))";
}
pub relation brieferteilung_ausgeschlossen(h: Grundpfandrecht) kind empirical {
    label de official "die Erteilung des Hypothekenbriefs ist ausgeschlossen — Einigung des Gläubigers und des Eigentümers und Eintragung (§ 1116 Abs. 2)";
    label en unofficial "issue of the mortgage certificate is excluded — agreement of creditor and owner plus registration (§ 1116 (2))";
}
pub relation brieferteilung_nicht_ausgeschlossen(h: Grundpfandrecht) kind empirical {
    label de official "die Erteilung des Hypothekenbriefs ist nicht ausgeschlossen (§ 1116 Abs. 1) — ausdrückliche Eingabe des Falls; das Schweigen des Falls ist keine Verneinung";
    label en unofficial "issue of the mortgage certificate is not excluded (§ 1116 (1)) — explicit case input; silence of the case is no denial";
}
pub relation brief_dem_glaeubiger_uebergeben(h: Grundpfandrecht) kind empirical {
    label de official "der Hypothekenbrief ist dem Gläubiger von dem Eigentümer des Grundstücks übergeben worden (§ 1117 Abs. 1 Satz 1)";
    label en unofficial "the mortgage certificate has been handed over to the creditor by the owner (§ 1117 (1) sentence 1)";
}
pub relation vereinbarung_ueber_aushaendigung_durch_das_grundbuchamt(h: Grundpfandrecht) kind empirical {
    label de official "vereinbart ist, dass der Gläubiger berechtigt sein soll, sich den Brief von dem Grundbuchamt aushändigen zu lassen (§ 1117 Abs. 2)";
    label en unofficial "it is agreed that the creditor may have the certificate handed over by the land registry (§ 1117 (2))";
}
pub relation glaeubiger_im_besitz_des_briefes(h: Grundpfandrecht) kind empirical {
    label de official "der Gläubiger ist im Besitz des Briefes (§ 1117 Abs. 3)";
    label en unofficial "the creditor is in possession of the certificate (§ 1117 (3))";
}
pub relation uebergabe_widerlegt(h: Grundpfandrecht) kind empirical {
    label de official "es ist festgestellt, dass die Übergabe des Briefes nicht erfolgt ist — Widerlegung der Vermutung des § 1117 Abs. 3";
    label en unofficial "it is established that the certificate was not handed over — rebuttal of the presumption of § 1117 (3)";
}

// --- § 1113: Inhalt der Hypothek -------------------------------------------------------------------

pub relation zahlung_aus_dem_grundstueck_geschuldet(h: Grundpfandrecht, glaeubiger: Person, betrag: Money) kind derived {
    label de official "an den Berechtigten ist eine bestimmte Geldsumme aus dem Grundstück zu zahlen (§ 1113 Abs. 1, § 1191 Abs. 1)";
    label en unofficial "a certain sum of money is to be paid out of the land to the entitled person (§ 1113 (1), § 1191 (1))";
}
pub relation hypothek_ohne_bestehende_forderung_zulaessig(h: Grundpfandrecht) kind derived {
    label de official "die Hypothek ist auch ohne gegenwärtig bestehende Forderung zulässig: künftige oder bedingte Forderung (§ 1113 Abs. 2)";
    label en unofficial "the mortgage is admissible without a presently existing claim: future or conditional claim (§ 1113 (2))";
}

@source(BGB_P1113) {
    rule ZahlungAusDemGrundstueckWegenDerForderung(h: Grundpfandrecht, g: Grundstueck, glaeubiger: Person, betrag: Money) strict {
        label de official "Ein Grundstück kann in der Weise belastet werden, dass an denjenigen, zu dessen Gunsten die Belastung erfolgt, eine bestimmte Geldsumme zur Befriedigung wegen einer ihm zustehenden Forderung aus dem Grundstück zu zahlen ist (§ 1113 Abs. 1)";
        label en unofficial "Land may be encumbered so that a certain sum of money is to be paid out of the land to the beneficiary in satisfaction of a claim to which they are entitled (§ 1113 (1))";
        when belastungsgegenstand_grundstueck(h, g) and berechtigter(h, glaeubiger) and geldsumme(h, betrag)
            and art_des_grundpfandrechts(h, Hypothek);
        then zahlung_aus_dem_grundstueck_geschuldet(h, glaeubiger, betrag);
    }
    rule HypothekFuerKuenftigeOderBedingteForderung(h: Grundpfandrecht) strict {
        label de official "Die Hypothek kann auch für eine künftige oder eine bedingte Forderung bestellt werden (§ 1113 Abs. 2)";
        label en unofficial "The mortgage may also be created for a future or conditional claim (§ 1113 (2))";
        when kuenftige_oder_bedingte_forderung(h);
        then hypothek_ohne_bestehende_forderung_zulaessig(h);
    }
}

// --- § 1114: Belastung eines Bruchteils --------------------------------------------------------------

pub relation bruchteil_eines_grundstuecks_belastet(h: Grundpfandrecht) kind empirical {
    label de official "belastet ist ein Bruchteil eines Grundstücks (§ 1114)";
    label en unofficial "a fractional share of land is encumbered (§ 1114)";
}
pub relation bruchteil_ist_anteil_eines_miteigentuemers(h: Grundpfandrecht) kind empirical {
    label de official "der Bruchteil besteht in dem Anteil eines Miteigentümers (§ 1114)";
    label en unofficial "the fractional share consists in the share of a co-owner (§ 1114)";
}
pub relation fall_des_paragraphen_3_absatz_6_gbo(h: Grundpfandrecht) kind empirical {
    label de official "einer der in § 3 Abs. 6 der Grundbuchordnung bezeichneten Fälle liegt vor (§ 1114) — äußeres Register, festgestellte Tatsache";
    label en unofficial "one of the cases named in § 3 (6) of the Land Register Code applies (§ 1114) — external register, established fact";
}
pub relation belastung_des_bruchteils_zulaessig(h: Grundpfandrecht) kind derived {
    label de official "die Belastung des Bruchteils mit einer Hypothek ist zulässig (§ 1114)";
    label en unofficial "the encumbrance of the fractional share with a mortgage is admissible (§ 1114)";
}

@source(BGB_P1114) {
    rule BruchteilAlsMiteigentumsanteilBelastbar(h: Grundpfandrecht) strict {
        label de official "Ein Bruchteil eines Grundstücks kann mit einer Hypothek belastet werden, wenn er in dem Anteil eines Miteigentümers besteht (§ 1114)";
        label en unofficial "A fractional share of land may be encumbered with a mortgage if it consists in a co-owner's share (§ 1114)";
        when bruchteil_eines_grundstuecks_belastet(h) and bruchteil_ist_anteil_eines_miteigentuemers(h);
        then belastung_des_bruchteils_zulaessig(h);
    }
    rule BruchteilInDenFaellenDerGrundbuchordnung(h: Grundpfandrecht) strict {
        label de official "Außerdem ist die Belastung in den in § 3 Abs. 6 der Grundbuchordnung bezeichneten Fällen zulässig (§ 1114)";
        label en unofficial "Beyond that the encumbrance is admissible in the cases named in § 3 (6) of the Land Register Code (§ 1114)";
        when bruchteil_eines_grundstuecks_belastet(h) and fall_des_paragraphen_3_absatz_6_gbo(h);
        then belastung_des_bruchteils_zulaessig(h);
    }
}

// --- § 1115: Eintragung ------------------------------------------------------------------------------

pub relation eintragung_bezeichnet_die_forderung(h: Grundpfandrecht) kind derived {
    label de official "die Eintragung bezeichnet die Forderung vollständig: Gläubiger, Geldbetrag, Zinssatz und Nebenleistungen (§ 1115 Abs. 1)";
    label en unofficial "the registration identifies the claim completely: creditor, amount, interest rate and ancillary payments (§ 1115 (1))";
}

@source(BGB_P1115) {
    rule EintragungMitZinssatz(h: Grundpfandrecht, p: Person, satz: Decimal) strict {
        label de official "Bei der Eintragung der Hypothek müssen der Gläubiger, der Geldbetrag der Forderung und, wenn die Forderung verzinslich ist, der Zinssatz im Grundbuch angegeben werden (§ 1115 Abs. 1)";
        label en unofficial "On registration the creditor, the amount of the claim and, if the claim bears interest, the interest rate must be entered (§ 1115 (1))";
        when glaeubiger_im_grundbuch_angegeben(h, p) and geldbetrag_im_grundbuch_angegeben(h)
            and forderung_verzinslich_mit(h, satz);
        then eintragung_bezeichnet_die_forderung(h);
    }
    rule EintragungOhneZinssatzBeiUnverzinslicherForderung(h: Grundpfandrecht, p: Person) strict {
        label de official "Ist die Forderung unverzinslich, so genügen Gläubiger und Geldbetrag der Forderung (§ 1115 Abs. 1)";
        label en unofficial "If the claim bears no interest, creditor and amount of the claim suffice (§ 1115 (1))";
        when glaeubiger_im_grundbuch_angegeben(h, p) and geldbetrag_im_grundbuch_angegeben(h)
            and forderung_unverzinslich(h);
        then eintragung_bezeichnet_die_forderung(h);
    }
    rule BezugnahmeAufDieSatzungGenuegt(h: Grundpfandrecht, p: Person) strict {
        label de official "Bei der Eintragung der Hypothek für ein Darlehen einer Kreditanstalt, deren Satzung öffentlich bekannt gemacht worden ist, genügt zur Bezeichnung der satzungsgemäß zu entrichtenden Nebenleistungen die Bezugnahme auf die Satzung (§ 1115 Abs. 2)";
        label en unofficial "For a mortgage securing a loan of a credit institution whose statutes have been published, reference to the statutes suffices for the ancillary payments provided for in them (§ 1115 (2))";
        when glaeubiger_im_grundbuch_angegeben(h, p) and geldbetrag_im_grundbuch_angegeben(h)
            and darlehen_einer_kreditanstalt_mit_bekannt_gemachter_satzung(h) and bezugnahme_auf_die_satzung(h);
        then eintragung_bezeichnet_die_forderung(h);
    }
}

// --- §§ 1116, 1117: Brief- und Buchhypothek ---------------------------------------------------------

pub relation briefhypothek(h: Grundpfandrecht) kind derived {
    label de official "über die Hypothek wird ein Hypothekenbrief erteilt (§ 1116 Abs. 1)";
    label en unofficial "a mortgage certificate is issued for the mortgage (§ 1116 (1))";
}
pub relation buchhypothek(h: Grundpfandrecht) kind derived {
    label de official "die Erteilung des Briefes ist ausgeschlossen: Buchhypothek (§ 1116 Abs. 2)";
    label en unofficial "issue of the certificate is excluded: register mortgage (§ 1116 (2))";
}
pub relation hypothek_vom_glaeubiger_erworben(h: Grundpfandrecht, glaeubiger: Person) kind derived {
    label de official "der Gläubiger hat die Hypothek erworben (§ 1117 Abs. 1, Abs. 2; § 1163 Abs. 2 im Gegenschluss)";
    label en unofficial "the creditor has acquired the mortgage (§ 1117 (1), (2); § 1163 (2) a contrario)";
}
pub relation uebergabe_des_briefes_vermutet(h: Grundpfandrecht) kind derived {
    label de official "es wird vermutet, dass die Übergabe des Briefes erfolgt sei (§ 1117 Abs. 3)";
    label en unofficial "it is presumed that the certificate was handed over (§ 1117 (3))";
}

@source(BGB_P1116) {
    rule BriefhypothekOhneAusschluss(h: Grundpfandrecht, g: Grundstueck) strict {
        label de official "Über die Hypothek wird ein Hypothekenbrief erteilt (§ 1116 Abs. 1); nur die Ausschließung nach Absatz 2 macht sie zur Buchhypothek";
        label en unofficial "A mortgage certificate is issued for the mortgage (§ 1116 (1)); only exclusion under subsection (2) makes it a register mortgage";
        when belastungsgegenstand_grundstueck(h, g) and brieferteilung_nicht_ausgeschlossen(h);
        then briefhypothek(h);
    }
    rule BuchhypothekBeiAusschluss(h: Grundpfandrecht) strict {
        label de official "Die Erteilung des Briefes kann ausgeschlossen werden; zu der Ausschließung ist die Einigung des Gläubigers und des Eigentümers sowie die Eintragung in das Grundbuch erforderlich (§ 1116 Abs. 2)";
        label en unofficial "Issue of the certificate may be excluded; exclusion requires the agreement of creditor and owner and registration (§ 1116 (2))";
        when brieferteilung_ausgeschlossen(h);
        then buchhypothek(h);
    }
}

@source(BGB_P1117) {
    rule ErwerbDerBriefhypothekDurchUebergabe(h: Grundpfandrecht, glaeubiger: Person) strict {
        label de official "Der Gläubiger erwirbt, sofern nicht die Erteilung des Hypothekenbriefs ausgeschlossen ist, die Hypothek erst, wenn ihm der Brief von dem Eigentümer des Grundstücks übergeben wird (§ 1117 Abs. 1 Satz 1)";
        label en unofficial "Unless issue of the certificate is excluded, the creditor acquires the mortgage only when the certificate is handed over to them by the owner (§ 1117 (1) sentence 1)";
        when briefhypothek(h) and glaeubiger_im_grundbuch_angegeben(h, glaeubiger) and brief_dem_glaeubiger_uebergeben(h);
        then hypothek_vom_glaeubiger_erworben(h, glaeubiger);
    }
    rule ErwerbDerBriefhypothekDurchVereinbarung(h: Grundpfandrecht, glaeubiger: Person) strict {
        label de official "Die Übergabe des Briefes kann durch die Vereinbarung ersetzt werden, dass der Gläubiger berechtigt sein soll, sich den Brief von dem Grundbuchamt aushändigen zu lassen (§ 1117 Abs. 2)";
        label en unofficial "Handing over may be replaced by an agreement that the creditor may have the certificate handed over by the land registry (§ 1117 (2))";
        when briefhypothek(h) and glaeubiger_im_grundbuch_angegeben(h, glaeubiger)
            and vereinbarung_ueber_aushaendigung_durch_das_grundbuchamt(h);
        then hypothek_vom_glaeubiger_erworben(h, glaeubiger);
    }
    rule ErwerbDerBuchhypothekMitDerEintragung(h: Grundpfandrecht, glaeubiger: Person) strict {
        label de official "Ist die Erteilung des Briefes ausgeschlossen, so bedarf der Erwerb keiner Übergabe (§ 1117 Abs. 1 Satz 1 im Gegenschluss, § 1116 Abs. 2)";
        label en unofficial "Where issue of the certificate is excluded, acquisition requires no handing over (§ 1117 (1) sentence 1 a contrario, § 1116 (2))";
        when buchhypothek(h) and glaeubiger_im_grundbuch_angegeben(h, glaeubiger);
        then hypothek_vom_glaeubiger_erworben(h, glaeubiger);
    }
}

@source(BGB_P1117)
presumption VermutungDerUebergabeDesBriefes(h: Grundpfandrecht) {
    label de official "Ist der Gläubiger im Besitz des Briefes, so wird vermutet, dass die Übergabe erfolgt sei (§ 1117 Abs. 3)";
    label en unofficial "If the creditor is in possession of the certificate, it is presumed that it was handed over (§ 1117 (3))";
    when glaeubiger_im_besitz_des_briefes(h);
    presume uebergabe_des_briefes_vermutet(h);
    unless glaeubiger_im_besitz_des_briefes(h) and uebergabe_widerlegt(h) then not uebergabe_des_briefes_vermutet(h);
}
