// --- Buch 3 Abschnitt 8: Durchführung des Pfandverkaufs und Restnormen
//     (§§ 1212, 1224, 1226, 1227, 1230–1241, 1244, 1245, 1251, 1275, 1279, 1284, 1293) ---------------
//
// DIE VERKAUFSVORSCHRIFTEN SIND VORAUSSETZUNGEN DER RECHTMÄSSIGKEIT. § 1243
// Abs. 1 zählt auf, welcher Verstoß die Veräußerung unrechtmäßig macht
// (§ 1228 Abs. 2, § 1230 Satz 2, § 1235, § 1237 Satz 1, § 1240); die übrigen
// Vorschriften der §§ 1230–1241 begründen nur Schadensersatz (§ 1243 Abs. 2).
// Die Regeln dieses Abschnitts nennen jede Voraussetzung mit eigenem Kopf,
// damit ein Fall zeigen kann, WELCHE verletzt ist.
//
// § 1226 IST EINE VERJÄHRUNG (sechs Monate von der Rückgabe); ihr Ende liest
// `frist_ende_kalender` ohne die Verlegung des § 193 (Ledger D-11-04).
// § 1236 und § 1237 Satz 1 verweisen auf § 383 (Paket de.bgb.schuldrecht_at) —
// Durchführung und Bekanntmachung sind FESTGESTELLTE TATSACHEN des Falls.

pub relation getrenntes_erzeugnis_des_pfandes(pf: Pfandrecht, s: Sache) kind empirical {
    label de official "Erzeugnis, das von dem Pfande getrennt worden ist (§ 1212)";
    label en unofficial "product separated from the pledged thing (§ 1212)";
}
pub relation hinterlegung_oder_aufrechnung_durch_den_verpfaender(pf: Pfandrecht) kind empirical {
    label de official "die Befriedigung des Pfandgläubigers durch den Verpfänder ist durch Hinterlegung oder Aufrechnung erfolgt (§ 1224)";
    label en unofficial "the pledgee was satisfied by the pledgor through deposit or set-off (§ 1224)";
}
pub relation pfand_zurueckgegeben_am(pf: Pfandrecht, tag: Date) kind empirical {
    key(pf);
    label de official "Tag der Rückgabe des Pfandes; von ihm läuft die sechsmonatige Frist des § 1226 (über § 548 Abs. 1 Satz 2)";
    label en unofficial "day of return of the pledged thing; the six-month period of § 1226 runs from it (via § 548 (1) sentence 2)";
}
pub relation ersatzanspruchsfrist(pf: Pfandrecht, f: Frist) kind empirical {
    key(pf);
    label de official "sechsmonatige Verjährungsfrist der Ersatzansprüche (§ 1226 Satz 1)";
    label en unofficial "six-month limitation period for claims to reimbursement (§ 1226 sentence 1)";
}
pub relation ersatzanspruch_geltend_gemacht_am(pf: Pfandrecht, tag: Date) kind empirical {
    key(pf);
    label de official "Tag, an dem der Ersatzanspruch geltend gemacht worden ist (§ 1226)";
    label en unofficial "day on which the claim to reimbursement was asserted (§ 1226)";
}
pub relation recht_des_pfandglaeubigers_beeintraechtigt(pf: Pfandrecht) kind empirical {
    label de official "das Recht des Pfandgläubigers ist beeinträchtigt (§ 1227)";
    label en unofficial "the pledgee's right is impaired (§ 1227)";
}
pub relation mehrere_pfaender(pf: Pfandrecht) kind empirical {
    label de official "das Pfandrecht besteht an mehreren Sachen (§ 1222, § 1230 Satz 1)";
    label en unofficial "the pledge exists on several things (§ 1222, § 1230 sentence 1)";
}
pub relation andere_auswahl_bestimmt(pf: Pfandrecht) kind empirical {
    label de official "über die Auswahl der zu verkaufenden Pfänder ist ein anderes bestimmt (§ 1230 Satz 1)";
    label en unofficial "a different provision has been made on the selection of the things to be sold (§ 1230 sentence 1)";
}
pub relation pfandglaeubiger_nicht_im_alleinbesitz(pf: Pfandrecht) kind empirical {
    label de official "der Pfandgläubiger ist nicht im Alleinbesitz des Pfandes (§ 1231 Satz 1)";
    label en unofficial "the pledgee is not in sole possession of the pledged thing (§ 1231 sentence 1)";
}
pub relation ablieferung_an_gemeinschaftlichen_verwahrer_verlangt(pf: Pfandrecht) kind empirical {
    label de official "der Verpfänder verlangt statt der Herausgabe die Ablieferung an einen gemeinschaftlichen Verwahrer (§ 1231 Satz 2)";
    label en unofficial "the pledgor demands delivery to a joint custodian instead of release (§ 1231 sentence 2)";
}
pub relation nachstehender_pfandglaeubiger(nachrangig: Pfandrecht, vorrangig: Pfandrecht) kind empirical {
    label de official "das eine Pfandrecht steht dem anderen im Range nach (§ 1232)";
    label en unofficial "one pledge ranks after the other (§ 1232)";
}
pub relation vorrangiger_betreibt_den_verkauf_selbst(pf: Pfandrecht) kind empirical {
    label de official "der vorrangige Pfandgläubiger betreibt den Verkauf selbst (§ 1232 Satz 2)";
    label en unofficial "the prior-ranking pledgee is conducting the sale themselves (§ 1232 sentence 2)";
}
pub relation vollstreckbarer_titel_gegen_den_eigentuemer(pf: Pfandrecht) kind empirical {
    label de official "der Pfandgläubiger hat für sein Recht zum Verkauf einen vollstreckbaren Titel gegen den Eigentümer erlangt (§ 1233 Abs. 2)";
    label en unofficial "the pledgee has obtained an enforceable title against the owner for their right to sell (§ 1233 (2))";
}
pub relation versteigerung_nach_383_durchgefuehrt(pf: Pfandrecht) kind empirical {
    label de official "die Versteigerung ist nach § 383 Abs. 2 Satz 2 und 3 durchgeführt worden (§ 1236) — festgestellte Tatsache";
    label en unofficial "the auction was conducted under § 383 (2) sentences 2 and 3 (§ 1236) — established fact";
}
pub relation eigentuemer_und_dritte_besonders_benachrichtigt(pf: Pfandrecht) kind empirical {
    label de official "der Eigentümer und Dritte, denen Rechte an dem Pfande zustehen, sind besonders benachrichtigt worden (§ 1237 Satz 2)";
    label en unofficial "the owner and third parties holding rights in the thing were specially notified (§ 1237 sentence 2)";
}
pub relation kaufpreis_sofort_entrichtet(pf: Pfandrecht) kind empirical {
    label de official "der Käufer hat den Kaufpreis sofort entrichtet (§ 1238 Abs. 2)";
    label en unofficial "the buyer paid the price immediately (§ 1238 (2))";
}
pub relation vorbehalt_der_rechtsverwirkung_geltend_gemacht(pf: Pfandrecht) kind empirical {
    label de official "vor dem Schluss des Versteigerungstermins ist von dem Vorbehalt der Rechtsverwirkung Gebrauch gemacht worden (§ 1238 Abs. 2 Satz 2)";
    label en unofficial "the reservation of forfeiture was invoked before the close of the auction (§ 1238 (2) sentence 2)";
}
pub relation zuschlag_an_den_pfandglaeubiger(pf: Pfandrecht) kind empirical {
    label de official "der Pfandgläubiger hat bei der Versteigerung den Zuschlag erhalten (§ 1239 Abs. 1 Satz 2, § 1242 Abs. 1 Satz 2)";
    label en unofficial "the pledgee was awarded the knock-down at the auction (§ 1239 (1) sentence 2, § 1242 (1) sentence 2)";
}
pub relation gebot_des_eigentuemers_ohne_bereitgestellten_betrag(pf: Pfandrecht) kind empirical {
    label de official "das Gebot des Eigentümers oder des Schuldners ist ohne Bereitstellung des Betrags abgegeben worden (§ 1239 Abs. 2)";
    label en unofficial "the owner's or debtor's bid was made without providing the amount (§ 1239 (2))";
}
pub relation genuegendes_gebot_nicht_abgegeben(pf: Pfandrecht) kind empirical {
    label de official "ein den Gold- oder Silberwert erreichendes Gebot ist nicht abgegeben worden (§ 1240 Abs. 2)";
    label en unofficial "no bid reaching the gold or silver value was made (§ 1240 (2))";
}
pub relation eigentuemer_vom_verkauf_benachrichtigt(pf: Pfandrecht) kind empirical {
    label de official "der Eigentümer ist von dem Verkauf und dem Ergebnis unverzüglich benachrichtigt worden (§ 1241)";
    label en unofficial "the owner was notified of the sale and its outcome without undue delay (§ 1241)";
}
pub relation veraeusserer_ohne_pfandrecht(pf: Pfandrecht) kind empirical {
    label de official "dem Veräußerer steht ein Pfandrecht nicht zu oder den Erfordernissen der Rechtmäßigkeit ist nicht genügt (§ 1244)";
    label en unofficial "the seller holds no pledge, or the requirements of lawfulness are not met (§ 1244)";
}
pub relation abweichende_verkaufsart_vereinbart(pf: Pfandrecht) kind empirical {
    label de official "Eigentümer und Pfandgläubiger haben eine von den §§ 1234 bis 1240 abweichende Art des Pfandverkaufs vereinbart (§ 1245 Abs. 1 Satz 1)";
    label en unofficial "owner and pledgee agreed on a manner of sale deviating from §§ 1234 to 1240 (§ 1245 (1) sentence 1)";
}
pub relation recht_des_dritten_erlischt_durch_die_veraeusserung(pf: Pfandrecht, dritter: Person) kind empirical {
    label de official "einem Dritten steht an dem Pfande ein Recht zu, das durch die Veräußerung erlischt (§ 1245 Abs. 1 Satz 2)";
    label en unofficial "a third party holds a right in the thing that is extinguished by the disposal (§ 1245 (1) sentence 2)";
}
pub relation verzicht_vor_der_verkaufsberechtigung(pf: Pfandrecht) kind empirical {
    label de official "auf die Beobachtung der §§ 1235, 1237 Satz 1 und 1240 ist vor dem Eintritt der Verkaufsberechtigung verzichtet worden (§ 1245 Abs. 2)";
    label en unofficial "compliance with §§ 1235, 1237 sentence 1 and 1240 was waived before the right of sale arose (§ 1245 (2))";
}
pub relation neuer_pfandglaeubiger(pf: Pfandrecht, p: Person) kind empirical {
    label de official "neuer Pfandgläubiger nach dem Übergang des Pfandrechts (§ 1251 Abs. 1)";
    label en unofficial "new pledgee after the transfer of the pledge (§ 1251 (1))";
}
pub relation neuer_pfandglaeubiger_hat_den_besitz_erlangt(pf: Pfandrecht) kind empirical {
    label de official "der neue Pfandgläubiger hat den Besitz des Pfandes erlangt (§ 1251 Abs. 2 Satz 1)";
    label en unofficial "the new pledgee has obtained possession of the thing (§ 1251 (2) sentence 1)";
}
pub relation recht_auf_leistung(r: VerpfaendetesRecht) kind empirical {
    label de official "das verpfändete Recht ist ein Recht, kraft dessen eine Leistung gefordert werden kann (§ 1275)";
    label en unofficial "the pledged right is one by virtue of which performance may be demanded (§ 1275)";
}

// --- Abgeleitete Köpfe ------------------------------------------------------------------------------------

pub relation pfandrecht_erstreckt_sich_auf_das_erzeugnis(pf: Pfandrecht, s: Sache) kind derived {
    label de official "das Pfandrecht erstreckt sich auf die Erzeugnisse, die von dem Pfande getrennt werden (§ 1212)";
    label en unofficial "the pledge extends to products separated from the pledged thing (§ 1212)";
}
pub relation ersatzanspruch_verjaehrt_am(pf: Pfandrecht, tag: Date) kind derived {
    key(pf);
    label de official "Tag, mit dessen Ablauf die Ersatzansprüche des Verpfänders und des Pfandgläubigers verjähren (§ 1226 Satz 1)";
    label en unofficial "day at whose end the claims to reimbursement of pledgor and pledgee become time-barred (§ 1226 sentence 1)";
}
pub relation ersatzanspruch_rechtzeitig_geltend_gemacht(pf: Pfandrecht) kind derived {
    label de official "der Ersatzanspruch ist vor dem Ablauf der sechsmonatigen Frist geltend gemacht worden (§ 1226)";
    label en unofficial "the claim to reimbursement was asserted before the six-month period expired (§ 1226)";
}
pub relation eigentumsansprueche_entsprechend_anwendbar(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "wird das Recht des Pfandgläubigers beeinträchtigt, so finden auf seine Ansprüche die für die Ansprüche aus dem Eigentum geltenden Vorschriften entsprechende Anwendung (§ 1227)";
    label en unofficial "where the pledgee's right is impaired, the rules on claims arising from ownership apply accordingly (§ 1227)";
}
pub relation auswahlrecht_des_pfandglaeubigers(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "unter mehreren Pfändern kann der Pfandgläubiger diejenigen auswählen, welche verkauft werden sollen (§ 1230 Satz 1)";
    label en unofficial "among several pledged things the pledgee may select those to be sold (§ 1230 sentence 1)";
}
pub relation herausgabe_zum_verkauf_forderbar(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "ist der Pfandgläubiger nicht im Alleinbesitz, so kann er nach dem Eintritt der Verkaufsberechtigung die Herausgabe zum Zwecke des Verkaufs fordern (§ 1231 Satz 1)";
    label en unofficial "where the pledgee is not in sole possession, they may demand release for the purpose of sale once the right of sale has arisen (§ 1231 sentence 1)";
}
pub relation ablieferung_an_verwahrer_statt_herausgabe(pf: Pfandrecht) kind derived {
    label de official "auf Verlangen des Verpfänders hat anstelle der Herausgabe die Ablieferung an einen gemeinschaftlichen Verwahrer zu erfolgen (§ 1231 Satz 2)";
    label en unofficial "at the pledgor's request delivery to a joint custodian replaces release (§ 1231 sentence 2)";
}
pub relation keine_herausgabepflicht_an_den_nachstehenden(vorrangig: Pfandrecht, nachrangig: Pfandrecht) kind derived {
    label de official "der Pfandgläubiger ist nicht verpflichtet, einem ihm im Range nachstehenden Pfandgläubiger das Pfand zum Zwecke des Verkaufs herauszugeben (§ 1232 Satz 1)";
    label en unofficial "the pledgee need not release the thing to a subsequent-ranking pledgee for the purpose of sale (§ 1232 sentence 1)";
}
pub relation kein_widerspruch_gegen_den_verkauf_durch_den_nachstehenden(vorrangig: Pfandrecht, nachrangig: Pfandrecht) kind derived {
    label de official "ist der vorrangige Pfandgläubiger nicht im Besitz des Pfandes, so kann er, sofern er nicht selbst den Verkauf betreibt, dem Verkauf durch einen nachstehenden Pfandgläubiger nicht widersprechen (§ 1232 Satz 2)";
    label en unofficial "where the prior-ranking pledgee is not in possession and is not conducting the sale, they may not object to a sale by a subsequent-ranking pledgee (§ 1232 sentence 2)";
}
pub relation verkauf_nach_den_vollstreckungsvorschriften_zulaessig(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "hat der Pfandgläubiger einen vollstreckbaren Titel gegen den Eigentümer erlangt, so kann er den Verkauf auch nach den für den Verkauf einer gepfändeten Sache geltenden Vorschriften bewirken lassen (§ 1233 Abs. 2)";
    label en unofficial "where the pledgee has an enforceable title against the owner, they may also have the sale effected under the rules for the sale of an attached thing (§ 1233 (2))";
}
pub relation verkaufsbedingung_gewahrt(pf: Pfandrecht) kind derived {
    label de official "das Pfand ist mit der Bestimmung verkauft worden, dass der Käufer den Kaufpreis sofort zu entrichten hat (§ 1238 Abs. 1)";
    label en unofficial "the thing was sold on the term that the buyer must pay immediately (§ 1238 (1))";
}
pub relation kaufpreis_gilt_als_empfangen(pf: Pfandrecht) kind derived {
    label de official "erfolgt der Verkauf ohne die Bestimmung des § 1238 Abs. 1 oder unterbleibt die sofortige Entrichtung ohne Gebrauch des Vorbehalts, so ist der Kaufpreis als von dem Pfandgläubiger empfangen anzusehen (§ 1238 Abs. 2, § 1239 Abs. 1 Satz 2)";
    label en unofficial "where the sale occurs without the term of § 1238 (1), or immediate payment fails without invoking the reservation, the price counts as received by the pledgee (§ 1238 (2), § 1239 (1) sentence 2)";
}
pub relation gebot_zurueckweisbar(pf: Pfandrecht) kind derived {
    label de official "das Gebot des Eigentümers oder des Schuldners darf zurückgewiesen werden, wenn nicht der Betrag mit dem Gebot zur Verfügung gestellt wird (§ 1239 Abs. 2)";
    label en unofficial "the owner's or debtor's bid may be rejected unless the amount is provided with the bid (§ 1239 (2))";
}
pub relation freihaendiger_verkauf_zum_edelmetallwert(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "wird ein genügendes Gebot nicht abgegeben, so kann der Verkauf durch eine zur öffentlichen Versteigerung befugte Person aus freier Hand zu einem den Gold- oder Silberwert erreichenden Preis erfolgen (§ 1240 Abs. 2)";
    label en unofficial "where no sufficient bid is made, the sale may be effected privately by an authorised auctioneer at a price reaching the metal value (§ 1240 (2))";
}
pub relation benachrichtigungspflicht_ueber_den_verkauf(pf: Pfandrecht, glaeubiger: Person) kind derived {
    label de official "der Pfandgläubiger hat den Eigentümer von dem Verkauf des Pfandes und dem Ergebnis unverzüglich zu benachrichtigen, sofern die Benachrichtigung nicht untunlich ist (§ 1241)";
    label en unofficial "the pledgee must notify the owner of the sale and its outcome without undue delay unless notification is impracticable (§ 1241)";
}
pub relation gutglaeubiger_erwerb_vom_veraeusserer_moeglich(pf: Pfandrecht) kind derived {
    label de official "wird eine Sache als Pfand veräußert, ohne dass dem Veräußerer ein Pfandrecht zusteht oder den Erfordernissen genügt wird, so finden die §§ 932 bis 934, 936 entsprechende Anwendung, wenn die Veräußerung nach § 1233 Abs. 2 erfolgt ist oder die §§ 1235, 1240 Abs. 2 beachtet worden sind (§ 1244)";
    label en unofficial "where a thing is disposed of as a pledge without the seller holding a pledge or meeting the requirements, §§ 932 to 934, 936 apply where the sale followed § 1233 (2) or §§ 1235, 1240 (2) were observed (§ 1244)";
}
pub relation abweichende_verkaufsart_wirksam(pf: Pfandrecht) kind derived {
    label de official "die von den §§ 1234 bis 1240 abweichende Art des Pfandverkaufs ist wirksam vereinbart (§ 1245 Abs. 1)";
    label en unofficial "the manner of sale deviating from §§ 1234 to 1240 has been validly agreed (§ 1245 (1))";
}
pub relation verzicht_unwirksam(pf: Pfandrecht) kind derived {
    label de official "auf die Beobachtung der §§ 1235, 1237 Satz 1 und 1240 kann nicht vor dem Eintritt der Verkaufsberechtigung verzichtet werden (§ 1245 Abs. 2)";
    label en unofficial "compliance with §§ 1235, 1237 sentence 1 and 1240 may not be waived before the right of sale arises (§ 1245 (2))";
}
pub relation abweichende_verkaufsart_gerichtlich_verlangbar(pf: Pfandrecht) kind derived {
    label de official "entspricht eine abweichende Art des Pfandverkaufs nach billigem Ermessen den Interessen der Beteiligten, so kann jeder von ihnen verlangen, dass der Verkauf in dieser Art erfolgt; kommt eine Einigung nicht zustande, entscheidet das Gericht (§ 1246)";
    label en unofficial "where a deviating manner of sale corresponds in equitable discretion to the interests of those involved, each may demand it; failing agreement the court decides (§ 1246)";
}
pub relation herausgabeanspruch_des_neuen_pfandglaeubigers(pf: Pfandrecht, neuer: Person) kind derived {
    label de official "der neue Pfandgläubiger kann von dem bisherigen die Herausgabe des Pfandes verlangen (§ 1251 Abs. 1)";
    label en unofficial "the new pledgee may demand release of the thing from the former pledgee (§ 1251 (1))";
}
pub relation neuer_pfandglaeubiger_tritt_in_die_pflichten_ein(pf: Pfandrecht, neuer: Person) kind derived {
    label de official "mit der Erlangung des Besitzes tritt der neue Pfandgläubiger anstelle des bisherigen in die mit dem Pfandrecht verbundenen Verpflichtungen gegen den Verpfänder ein (§ 1251 Abs. 2 Satz 1)";
    label en unofficial "on obtaining possession the new pledgee takes the former's place in the duties towards the pledgor connected with the pledge (§ 1251 (2) sentence 1)";
}
pub relation uebertragungsvorschriften_fuer_das_rechtsverhaeltnis(pf: Pfandrecht) kind derived {
    label de official "ist ein Recht auf Leistung Gegenstand des Pfandrechts, so gelten für das Verhältnis zwischen Pfandgläubiger und Verpflichtetem die Vorschriften, die im Falle der Übertragung des Rechts gelten (§ 1275)";
    label en unofficial "where a right to performance is the object of the pledge, the rules applying on transfer of the right govern the relationship between pledgee and obligor (§ 1275)";
}
pub relation besondere_vorschriften_der_forderungsverpfaendung(pf: Pfandrecht) kind derived {
    label de official "für das Pfandrecht an einer Forderung gelten die besonderen Vorschriften der §§ 1280 bis 1290; hat die Forderung einen Börsen- oder Marktpreis, so gilt § 1259 entsprechend (§ 1279)";
    label en unofficial "the special rules of §§ 1280 to 1290 govern a pledge on a claim; where it has a market price, § 1259 applies accordingly (§ 1279)";
}
pub relation abweichende_vereinbarung_verdraengt_1281_bis_1283(pf: Pfandrecht) kind derived {
    label de official "die Vorschriften der §§ 1281 bis 1283 finden keine Anwendung, soweit der Pfandgläubiger und der Gläubiger ein anderes vereinbaren (§ 1284)";
    label en unofficial "§§ 1281 to 1283 do not apply in so far as pledgee and creditor agree otherwise (§ 1284)";
}
pub relation sachpfandvorschriften_fuer_inhaberpapiere(pf: Pfandrecht) kind derived {
    label de official "für das Pfandrecht an einem Inhaberpapier gelten die Vorschriften über das Pfandrecht an beweglichen Sachen (§ 1293)";
    label en unofficial "the rules on pledges of movables govern a pledge on a bearer instrument (§ 1293)";
}

// --- Regeln ------------------------------------------------------------------------------------------------

@source(BGB_P1212)
rule ErstreckungAufGetrennteErzeugnisse(pf: Pfandrecht, s: Sache, glaeubiger: Person) strict {
    label de official "Das Pfandrecht erstreckt sich auf die Erzeugnisse, die von dem Pfande getrennt werden (§ 1212)";
    label en unofficial "The pledge extends to the products separated from the pledged thing (§ 1212)";
    when pfandrecht_entstanden(pf, glaeubiger) and getrenntes_erzeugnis_des_pfandes(pf, s);
    then pfandrecht_erstreckt_sich_auf_das_erzeugnis(pf, s);
}

@source(BGB_P1224)
rule BefriedigungDurchHinterlegungOderAufrechnung(pf: Pfandrecht, verpfaender: Person, betrag: Money) strict {
    label de official "Die Befriedigung des Pfandgläubigers durch den Verpfänder kann auch durch Hinterlegung oder durch Aufrechnung erfolgen (§ 1224)";
    label en unofficial "The pledgee may also be satisfied by the pledgor through deposit or set-off (§ 1224)";
    when verpfaender(pf, verpfaender) and hinterlegung_oder_aufrechnung_durch_den_verpfaender(pf)
        and befriedigung_durch_den_verpfaender(pf, betrag) and verpfaender_ist_nicht_persoenlicher_schuldner(pf);
    then forderung_auf_den_verpfaender_uebergegangen(pf, verpfaender);
}

@source(BGB_P1226) {
    rule ErsatzanspruchsfristEreignis(pf: Pfandrecht, f: Frist, e: Date) strict {
        label de official "Die sechsmonatige Frist des § 1226 läuft von der Rückgabe des Pfandes an (§ 548 Abs. 1 Satz 2 entsprechend; § 187 Abs. 1)";
        label en unofficial "The six-month period of § 1226 runs from the return of the pledged thing (§ 548 (1) sentence 2 accordingly; § 187 (1))";
        when ersatzanspruchsfrist(pf, f) and pfand_zurueckgegeben_am(pf, e);
        then de.bgb.fristen::frist_ereignis(f, e);
    }
    rule ErsatzanspruchsfristSechsMonate(pf: Pfandrecht, f: Frist) strict {
        label de official "Die Ersatzansprüche des Verpfänders wegen Veränderungen oder Verschlechterungen des Pfandes sowie die Ansprüche des Pfandgläubigers auf Ersatz von Verwendungen verjähren in sechs Monaten (§ 1226 Satz 1) — Monatsschritt nach § 188 Abs. 2, 3";
        label en unofficial "Claims of the pledgor for changes or deterioration and of the pledgee for outlays become time-barred in six months (§ 1226 sentence 1) — month step under § 188 (2), (3)";
        when ersatzanspruchsfrist(pf, f);
        then de.bgb.fristen::frist_dauer_kalender(f, 6 calendar_month);
    }
    rule ErsatzanspruchVerjaehrtAm(pf: Pfandrecht, f: Frist, k: Date) strict {
        label de official "Mit dem Ablauf der sechs Monate sind die Ersatzansprüche verjährt (§ 1226 Satz 1) — VERJÄHRUNGSFRIST ohne die Verlegung des § 193 (Ledger D-11-04)";
        label en unofficial "With the expiry of the six months the claims to reimbursement are time-barred (§ 1226 sentence 1) — limitation period without the transfer of § 193";
        when ersatzanspruchsfrist(pf, f) and de.bgb.fristen::frist_ende_kalender(f, k);
        then ersatzanspruch_verjaehrt_am(pf, k);
    }
    rule ErsatzanspruchRechtzeitigGeltendGemacht(pf: Pfandrecht, k: Date, tg: Date) strict {
        label de official "Wird der Ersatzanspruch vor dem Ablauf der sechs Monate geltend gemacht, so ist er nicht verjährt (§ 1226 Satz 1)";
        label en unofficial "Where the claim is asserted before the six months have run, it is not time-barred (§ 1226 sentence 1)";
        when ersatzanspruch_verjaehrt_am(pf, k) and ersatzanspruch_geltend_gemacht_am(pf, tg) and tg <= k;
        then ersatzanspruch_rechtzeitig_geltend_gemacht(pf);
    }
}

@source(BGB_P1227)
rule EigentumsanspruecheEntsprechendAnwendbar(pf: Pfandrecht, glaeubiger: Person) strict {
    label de official "Wird das Recht des Pfandgläubigers beeinträchtigt, so finden auf die Ansprüche des Pfandgläubigers die für die Ansprüche aus dem Eigentum geltenden Vorschriften entsprechende Anwendung (§ 1227)";
    label en unofficial "Where the pledgee's right is impaired, the rules on claims arising from ownership apply accordingly (§ 1227)";
    when pfandglaeubiger(pf, glaeubiger) and recht_des_pfandglaeubigers_beeintraechtigt(pf);
    then eigentumsansprueche_entsprechend_anwendbar(pf, glaeubiger);
}

@source(BGB_P1230)
rule AuswahlrechtUnterMehrerenPfaendern(pf: Pfandrecht, glaeubiger: Person) strict {
    label de official "Unter mehreren Pfändern kann der Pfandgläubiger, soweit nicht ein anderes bestimmt ist, diejenigen auswählen, welche verkauft werden sollen; er kann nur so viele Pfänder zum Verkauf bringen, als zu seiner Befriedigung erforderlich sind (§ 1230)";
    label en unofficial "Among several pledged things the pledgee may, unless otherwise provided, select those to be sold; only as many may be sold as are necessary for their satisfaction (§ 1230)";
    when verkaufsberechtigung(pf, glaeubiger) and mehrere_pfaender(pf) and not andere_auswahl_bestimmt(pf);
    then auswahlrecht_des_pfandglaeubigers(pf, glaeubiger);
}

@source(BGB_P1231) {
    rule HerausgabeZumVerkaufForderbar(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Ist der Pfandgläubiger nicht im Alleinbesitz des Pfandes, so kann er nach dem Eintritt der Verkaufsberechtigung die Herausgabe des Pfandes zum Zwecke des Verkaufs fordern (§ 1231 Satz 1)";
        label en unofficial "Where the pledgee is not in sole possession, they may demand release of the thing for the purpose of sale once the right of sale has arisen (§ 1231 sentence 1)";
        when verkaufsberechtigung(pf, glaeubiger) and pfandglaeubiger_nicht_im_alleinbesitz(pf)
            and not ablieferung_an_gemeinschaftlichen_verwahrer_verlangt(pf);
        then herausgabe_zum_verkauf_forderbar(pf, glaeubiger);
    }
    rule AblieferungAnGemeinschaftlichenVerwahrer(pf: Pfandrecht, glaeubiger: Person) strict {
        label de official "Auf Verlangen des Verpfänders hat anstelle der Herausgabe die Ablieferung an einen gemeinschaftlichen Verwahrer zu erfolgen; der Verwahrer hat sich zu verpflichten, das Pfand zum Verkauf bereitzustellen (§ 1231 Satz 2)";
        label en unofficial "At the pledgor's request delivery to a joint custodian replaces release; the custodian must undertake to make the thing available for sale (§ 1231 sentence 2)";
        when verkaufsberechtigung(pf, glaeubiger) and pfandglaeubiger_nicht_im_alleinbesitz(pf)
            and ablieferung_an_gemeinschaftlichen_verwahrer_verlangt(pf);
        then ablieferung_an_verwahrer_statt_herausgabe(pf);
    }
}

@source(BGB_P1232) {
    rule KeineHerausgabepflichtAnDenNachstehenden(vorrangig: Pfandrecht, nachrangig: Pfandrecht) strict {
        label de official "Der Pfandgläubiger ist nicht verpflichtet, einem ihm im Range nachstehenden Pfandgläubiger das Pfand zum Zwecke des Verkaufs herauszugeben (§ 1232 Satz 1)";
        label en unofficial "The pledgee need not release the thing to a subsequent-ranking pledgee for the purpose of sale (§ 1232 sentence 1)";
        when nachstehender_pfandglaeubiger(nachrangig, vorrangig);
        then keine_herausgabepflicht_an_den_nachstehenden(vorrangig, nachrangig);
    }
    rule KeinWiderspruchGegenDenVerkaufDurchDenNachstehenden(vorrangig: Pfandrecht, nachrangig: Pfandrecht) strict {
        label de official "Ist der vorrangige Pfandgläubiger nicht im Besitz des Pfandes, so kann er, sofern er nicht selbst den Verkauf betreibt, dem Verkauf durch einen nachstehenden Pfandgläubiger nicht widersprechen (§ 1232 Satz 2)";
        label en unofficial "Where the prior-ranking pledgee is not in possession and does not conduct the sale themselves, they may not object to a sale by a subsequent-ranking pledgee (§ 1232 sentence 2)";
        when nachstehender_pfandglaeubiger(nachrangig, vorrangig) and pfandglaeubiger_nicht_im_alleinbesitz(vorrangig)
            and not vorrangiger_betreibt_den_verkauf_selbst(vorrangig);
        then kein_widerspruch_gegen_den_verkauf_durch_den_nachstehenden(vorrangig, nachrangig);
    }
}

@source(BGB_P1233)
rule VerkaufNachDenVollstreckungsvorschriften(pf: Pfandrecht, glaeubiger: Person) strict {
    label de official "Hat der Pfandgläubiger für sein Recht zum Verkauf einen vollstreckbaren Titel gegen den Eigentümer erlangt, so kann er den Verkauf auch nach den für den Verkauf einer gepfändeten Sache geltenden Vorschriften bewirken lassen (§ 1233 Abs. 2)";
    label en unofficial "Where the pledgee has obtained an enforceable title against the owner, they may also have the sale effected under the rules for the sale of an attached thing (§ 1233 (2))";
    when verkaufsberechtigung(pf, glaeubiger) and vollstreckbarer_titel_gegen_den_eigentuemer(pf);
    then verkauf_nach_den_vollstreckungsvorschriften_zulaessig(pf, glaeubiger);
}

@source(BGB_P1235)
rule VerkaufImWegeOeffentlicherVersteigerung(pf: Pfandrecht, glaeubiger: Person, tv: Date) strict {
    label de official "Der Verkauf des Pfandes ist im Wege öffentlicher Versteigerung zu bewirken; hat das Pfand einen Börsen- oder Marktpreis, so findet § 1221 Anwendung (§ 1235)";
    label en unofficial "The sale of the pledged thing is to be effected by public auction; where the thing has a market price, § 1221 applies (§ 1235)";
    when verkaufsberechtigung(pf, glaeubiger) and verkauf_erfolgt_am(pf, tv) and oeffentliche_versteigerung_durchgefuehrt(pf)
        and versteigerung_nach_383_durchgefuehrt(pf);
    then verkaufsbedingung_gewahrt(pf);
}

@source(BGB_P1236)
rule DurchfuehrungNach383(pf: Pfandrecht, tv: Date) strict {
    label de official "Für die Durchführung der Versteigerung ist § 383 Absatz 2 Satz 2 und 3 anzuwenden (§ 1236)";
    label en unofficial "§ 383 (2) sentences 2 and 3 apply to the conduct of the auction (§ 1236)";
    when verkauf_erfolgt_am(pf, tv) and oeffentliche_versteigerung_durchgefuehrt(pf) and not versteigerung_nach_383_durchgefuehrt(pf);
    then veraeusserung_nicht_rechtmaessig(pf);
}

@source(BGB_P1237)
rule BesondereBenachrichtigungDerBerechtigten(pf: Pfandrecht, tv: Date) strict {
    label de official "Der Eigentümer und Dritte, denen Rechte an dem Pfande zustehen, sind besonders zu benachrichtigen; die Benachrichtigung darf unterbleiben, wenn sie untunlich ist (§ 1237 Satz 2)";
    label en unofficial "The owner and third parties holding rights in the thing must be specially notified; notification may be omitted where impracticable (§ 1237 sentence 2)";
    when verkauf_erfolgt_am(pf, tv) and oeffentlich_bekannt_gemacht(pf)
        and not eigentuemer_und_dritte_besonders_benachrichtigt(pf) and not anzeige_untunlich(pf);
    then schadensersatzpflicht_des_pfandglaeubigers_wegen_benachrichtigung(pf);
}

pub relation schadensersatzpflicht_des_pfandglaeubigers_wegen_benachrichtigung(pf: Pfandrecht) kind derived {
    label de official "die unterlassene besondere Benachrichtigung ist keine Voraussetzung der Rechtmäßigkeit (§ 1243 Abs. 1 nennt nur § 1237 Satz 1), sondern begründet Schadensersatz (§ 1243 Abs. 2)";
    label en unofficial "the omitted special notification is not a condition of lawfulness (§ 1243 (1) names only § 1237 sentence 1) but gives rise to damages (§ 1243 (2))";
}

@source(BGB_P1238) {
    rule VerkaufsbedingungDerSofortigenZahlung(pf: Pfandrecht, tv: Date) strict {
        label de official "Das Pfand darf nur mit der Bestimmung verkauft werden, dass der Käufer den Kaufpreis sofort zu entrichten hat und seiner Rechte verlustig sein soll, wenn dies nicht geschieht (§ 1238 Abs. 1)";
        label en unofficial "The thing may be sold only on the term that the buyer must pay immediately and forfeits their rights otherwise (§ 1238 (1))";
        when verkauf_erfolgt_am(pf, tv) and sofortige_kaufpreiszahlung_bestimmt(pf) and kaufpreis_sofort_entrichtet(pf);
        then verkaufsbedingung_gewahrt(pf);
    }
    rule KaufpreisGiltAlsEmpfangenOhneBestimmung(pf: Pfandrecht, tv: Date) strict {
        label de official "Erfolgt der Verkauf ohne diese Bestimmung, so ist der Kaufpreis als von dem Pfandgläubiger empfangen anzusehen (§ 1238 Abs. 2 Satz 1)";
        label en unofficial "Where the sale occurs without that term, the price counts as received by the pledgee (§ 1238 (2) sentence 1)";
        when verkauf_erfolgt_am(pf, tv) and not sofortige_kaufpreiszahlung_bestimmt(pf);
        then kaufpreis_gilt_als_empfangen(pf);
    }
    rule KaufpreisGiltAlsEmpfangenOhneVorbehalt(pf: Pfandrecht, tv: Date) strict {
        label de official "Unterbleibt die sofortige Entrichtung des Kaufpreises, so gilt das Gleiche, wenn nicht vor dem Schluss des Versteigerungstermins von dem Vorbehalt der Rechtsverwirkung Gebrauch gemacht wird (§ 1238 Abs. 2 Satz 2)";
        label en unofficial "Where immediate payment fails, the same applies unless the reservation of forfeiture is invoked before the close of the auction (§ 1238 (2) sentence 2)";
        when verkauf_erfolgt_am(pf, tv) and sofortige_kaufpreiszahlung_bestimmt(pf) and not kaufpreis_sofort_entrichtet(pf)
            and not vorbehalt_der_rechtsverwirkung_geltend_gemacht(pf);
        then kaufpreis_gilt_als_empfangen(pf);
    }
}

@source(BGB_P1239) {
    rule ZuschlagAnDenPfandglaeubiger(pf: Pfandrecht) strict {
        label de official "Der Pfandgläubiger und der Eigentümer können bei der Versteigerung mitbieten; erhält der Pfandgläubiger den Zuschlag, so ist der Kaufpreis als von ihm empfangen anzusehen (§ 1239 Abs. 1)";
        label en unofficial "Pledgee and owner may bid at the auction; where the pledgee is awarded the knock-down, the price counts as received by them (§ 1239 (1))";
        when zuschlag_an_den_pfandglaeubiger(pf);
        then kaufpreis_gilt_als_empfangen(pf);
    }
    rule GebotDesEigentuemersZurueckweisbar(pf: Pfandrecht) strict {
        label de official "Das Gebot des Eigentümers darf zurückgewiesen werden, wenn nicht der Betrag mit dem Gebot zur Verfügung gestellt wird; das Gleiche gilt von dem Gebot des Schuldners, wenn das Pfand für eine fremde Schuld haftet (§ 1239 Abs. 2)";
        label en unofficial "The owner's bid may be rejected unless the amount is provided with it; the same applies to the debtor's bid where the thing secures another's debt (§ 1239 (2))";
        when gebot_des_eigentuemers_ohne_bereitgestellten_betrag(pf);
        then gebot_zurueckweisbar(pf);
    }
}

@source(BGB_P1240)
rule FreihaendigerVerkaufZumEdelmetallwert(pf: Pfandrecht, glaeubiger: Person) strict {
    label de official "Wird ein genügendes Gebot nicht abgegeben, so kann der Verkauf durch eine zur öffentlichen Versteigerung befugte Person aus freier Hand zu einem den Gold- oder Silberwert erreichenden Preis erfolgen (§ 1240 Abs. 2)";
    label en unofficial "Where no sufficient bid is made, the sale may be effected privately by an authorised auctioneer at a price reaching the metal value (§ 1240 (2))";
    when verkaufsberechtigung(pf, glaeubiger) and gold_oder_silbersache(pf) and genuegendes_gebot_nicht_abgegeben(pf);
    then freihaendiger_verkauf_zum_edelmetallwert(pf, glaeubiger);
}

@source(BGB_P1241)
rule BenachrichtigungUeberDenVerkauf(pf: Pfandrecht, glaeubiger: Person, tv: Date) strict {
    label de official "Der Pfandgläubiger hat den Eigentümer von dem Verkauf des Pfandes und dem Ergebnis unverzüglich zu benachrichtigen, sofern nicht die Benachrichtigung untunlich ist (§ 1241)";
    label en unofficial "The pledgee must notify the owner of the sale and its outcome without undue delay unless notification is impracticable (§ 1241)";
    when pfandglaeubiger(pf, glaeubiger) and verkauf_erfolgt_am(pf, tv) and not anzeige_untunlich(pf)
        and eigentuemer_vom_verkauf_benachrichtigt(pf);
    then benachrichtigungspflicht_ueber_den_verkauf(pf, glaeubiger);
}

@source(BGB_P1244)
rule GutglaeubigerErwerbBeiEingehaltenenVorschriften(pf: Pfandrecht, tv: Date) strict {
    label de official "Wird eine Sache als Pfand veräußert, ohne dass dem Veräußerer ein Pfandrecht zusteht oder den Erfordernissen genügt wird, so finden die §§ 932 bis 934, 936 entsprechende Anwendung, wenn die Veräußerung nach § 1233 Abs. 2 erfolgt ist oder die Vorschriften des § 1235 oder des § 1240 Abs. 2 beobachtet worden sind (§ 1244)";
    label en unofficial "Where a thing is disposed of as a pledge without the seller holding a pledge or meeting the requirements, §§ 932 to 934, 936 apply where the sale followed § 1233 (2) or §§ 1235, 1240 (2) were observed (§ 1244)";
    when verkauf_erfolgt_am(pf, tv) and veraeusserer_ohne_pfandrecht(pf)
        and oeffentliche_versteigerung_durchgefuehrt(pf) and versteigerung_nach_383_durchgefuehrt(pf);
    then gutglaeubiger_erwerb_vom_veraeusserer_moeglich(pf);
}

@source(BGB_P1245) {
    rule AbweichendeVerkaufsartOhneDrittrecht(pf: Pfandrecht) strict {
        label de official "Der Eigentümer und der Pfandgläubiger können eine von den Vorschriften der §§ 1234 bis 1240 abweichende Art des Pfandverkaufs vereinbaren (§ 1245 Abs. 1 Satz 1)";
        label en unofficial "Owner and pledgee may agree on a manner of sale deviating from §§ 1234 to 1240 (§ 1245 (1) sentence 1)";
        when abweichende_verkaufsart_vereinbart(pf) and not verzicht_vor_der_verkaufsberechtigung(pf)
            and not drittrecht_erlischt(pf);
        then abweichende_verkaufsart_wirksam(pf);
    }
    rule AbweichendeVerkaufsartMitZustimmungDesDritten(pf: Pfandrecht, dritter: Person) strict {
        label de official "Steht einem Dritten an dem Pfande ein Recht zu, das durch die Veräußerung erlischt, so ist die Zustimmung des Dritten erforderlich; sie ist unwiderruflich (§ 1245 Abs. 1 Sätze 2, 3)";
        label en unofficial "Where a third party holds a right extinguished by the disposal, that party's consent is required; it is irrevocable (§ 1245 (1) sentences 2, 3)";
        when abweichende_verkaufsart_vereinbart(pf) and recht_des_dritten_erlischt_durch_die_veraeusserung(pf, dritter)
            and zustimmung_des_dritten_zur_aufhebung(pf, dritter) and not verzicht_vor_der_verkaufsberechtigung(pf);
        then abweichende_verkaufsart_wirksam(pf);
    }
    rule VerzichtVorDerVerkaufsberechtigungUnwirksam(pf: Pfandrecht) strict {
        label de official "Auf die Beobachtung der Vorschriften des § 1235, des § 1237 Satz 1 und des § 1240 kann nicht vor dem Eintritt der Verkaufsberechtigung verzichtet werden (§ 1245 Abs. 2)";
        label en unofficial "Compliance with §§ 1235, 1237 sentence 1 and 1240 may not be waived before the right of sale arises (§ 1245 (2))";
        when verzicht_vor_der_verkaufsberechtigung(pf);
        then verzicht_unwirksam(pf);
    }
}

pub relation drittrecht_erlischt(pf: Pfandrecht) kind empirical {
    label de official "einem Dritten steht an dem Pfande ein Recht zu, das durch die Veräußerung erlischt (§ 1245 Abs. 1 Satz 2) — ausdrückliche Eingabe des Falls";
    label en unofficial "a third party holds a right in the thing extinguished by the disposal (§ 1245 (1) sentence 2) — explicit case input";
}

@source(BGB_P1246)
rule AbweichendeVerkaufsartNachBilligemErmessen(pf: Pfandrecht) strict {
    label de official "Entspricht eine von den Vorschriften der §§ 1235 bis 1240 abweichende Art des Pfandverkaufs nach billigem Ermessen den Interessen der Beteiligten, so kann jeder von ihnen verlangen, dass der Verkauf in dieser Art erfolgt; kommt eine Einigung nicht zustande, so entscheidet das Gericht (§ 1246)";
    label en unofficial "Where a manner of sale deviating from §§ 1235 to 1240 corresponds in equitable discretion to the interests of those involved, each may demand it; failing agreement the court decides (§ 1246)";
    when abweichende_verkaufsart_entspricht_billigem_ermessen(pf);
    then abweichende_verkaufsart_gerichtlich_verlangbar(pf);
}

@source(BGB_P1251) {
    rule HerausgabeanspruchDesNeuenPfandglaeubigers(pf: Pfandrecht, neuer: Person) strict {
        label de official "Der neue Pfandgläubiger kann von dem bisherigen Pfandgläubiger die Herausgabe des Pfandes verlangen (§ 1251 Abs. 1)";
        label en unofficial "The new pledgee may demand release of the thing from the former pledgee (§ 1251 (1))";
        when neuer_pfandglaeubiger(pf, neuer);
        then herausgabeanspruch_des_neuen_pfandglaeubigers(pf, neuer);
    }
    rule EintrittInDiePflichtenMitDemBesitz(pf: Pfandrecht, neuer: Person) strict {
        label de official "Mit der Erlangung des Besitzes tritt der neue Pfandgläubiger anstelle des bisherigen in die mit dem Pfandrecht verbundenen Verpflichtungen gegen den Verpfänder ein (§ 1251 Abs. 2 Satz 1)";
        label en unofficial "On obtaining possession the new pledgee takes the former's place in the duties towards the pledgor connected with the pledge (§ 1251 (2) sentence 1)";
        when neuer_pfandglaeubiger(pf, neuer) and neuer_pfandglaeubiger_hat_den_besitz_erlangt(pf);
        then neuer_pfandglaeubiger_tritt_in_die_pflichten_ein(pf, neuer);
    }
}

@source(BGB_P1275)
rule UebertragungsvorschriftenFuerDasRechtsverhaeltnis(pf: Pfandrecht, r: VerpfaendetesRecht) strict {
    label de official "Ist ein Recht, kraft dessen eine Leistung gefordert werden kann, Gegenstand des Pfandrechts, so finden auf das Rechtsverhältnis zwischen dem Pfandgläubiger und dem Verpflichteten die Vorschriften Anwendung, welche im Falle der Übertragung des Rechts für das Rechtsverhältnis zwischen dem Erwerber und dem Verpflichteten gelten (§ 1275)";
    label en unofficial "Where a right to demand performance is the object of the pledge, the rules governing the relationship between acquirer and obligor on transfer of the right apply to the relationship between pledgee and obligor (§ 1275)";
    when pfandrecht_am_recht_entstanden(pf, r) and recht_auf_leistung(r);
    then uebertragungsvorschriften_fuer_das_rechtsverhaeltnis(pf);
}

@source(BGB_P1279)
rule BesondereVorschriftenDerForderungsverpfaendung(pf: Pfandrecht, r: VerpfaendetesRecht) strict {
    label de official "Für das Pfandrecht an einer Forderung gelten die besonderen Vorschriften der §§ 1280 bis 1290; soweit eine Forderung einen Börsen- oder Marktpreis hat, findet § 1259 entsprechende Anwendung (§ 1279)";
    label en unofficial "The special rules of §§ 1280 to 1290 govern a pledge on a claim; where a claim has a market price, § 1259 applies accordingly (§ 1279)";
    when verpfaendetes_recht(pf, r) and recht_ist_eine_forderung(r);
    then besondere_vorschriften_der_forderungsverpfaendung(pf);
}

@source(BGB_P1284)
rule AbweichendeVereinbarungVerdraengt1281Bis1283(pf: Pfandrecht) strict {
    label de official "Die Vorschriften der §§ 1281 bis 1283 finden keine Anwendung, soweit der Pfandgläubiger und der Gläubiger ein anderes vereinbaren (§ 1284)";
    label en unofficial "§§ 1281 to 1283 do not apply in so far as pledgee and creditor agree otherwise (§ 1284)";
    when abweichende_vereinbarung_ueber_die_einziehung(pf);
    then abweichende_vereinbarung_verdraengt_1281_bis_1283(pf);
}

@source(BGB_P1293)
rule SachpfandvorschriftenFuerInhaberpapiere(pf: Pfandrecht, r: VerpfaendetesRecht) strict {
    label de official "Für das Pfandrecht an einem Inhaberpapier gelten die Vorschriften über das Pfandrecht an beweglichen Sachen (§ 1293)";
    label en unofficial "The rules on pledges of movables govern a pledge on a bearer instrument (§ 1293)";
    when verpfaendetes_recht(pf, r) and inhaberpapier(r);
    then sachpfandvorschriften_fuer_inhaberpapiere(pf);
}
