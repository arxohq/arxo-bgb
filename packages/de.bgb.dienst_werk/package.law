// BÜRGERLICHES GESETZBUCH — DIENSTVERTRAG, BEHANDLUNGSVERTRAG, WERKVERTRAG (BG-07)
//
// Buch 2 Abschnitt 8 Titel 8–9, §§ 611–651y — VOLLSTÄNDIG abgesenkt: Titel 8
// Untertitel 1 Dienstvertrag (§§ 611–630), Untertitel 2 Behandlungsvertrag
// (§§ 630a–630h), Titel 9 Untertitel 1 Werkvertrag mit Bauvertrag und
// Verbraucherbauvertrag (§§ 631–650o), Untertitel 2 Architekten- und
// Ingenieurvertrag sowie Bauträgervertrag (§§ 650p–651) und Untertitel 3
// Pauschalreisevertrag (§§ 651a–651y). Tiefe §33.1: 103 EXECUTABLE von 106;
// SOURCE_ONLY bleiben nur §§ 611b und 641a (weggefallen) und § 651
// (Fundstellenangabe „jetzt § 650“). Quellen: sources.law, erzeugt aus dem
// Register DOKNR (docs/foundations/de-bgb/registry/), Stand 2026-09-17.
//
// DATEIEN. untertitel-01-dienstvertrag.law, untertitel-02-behandlungsvertrag.law,
// untertitel-03-a-werkvertrag.law, untertitel-03-b-bauvertrag.law,
// untertitel-03-c-verbraucherbauvertrag.law,
// untertitel-04-architekt-und-bautraeger.law, untertitel-05-pauschalreise.law.
// Jede Datei trägt ihren eigenen Kopf mit Grenzen, Wertungskanälen, Fristen
// und Geldpolitik; dieser Kopf beschreibt nur den Untertitel 1 weiter.
//
// KORRIDORE 2018 (Ledger D-07-08). Die §§ 650a–650v gelten nach Art. 229 § 39
// EGBGB für Schuldverhältnisse ab dem 1. Januar 2018, die §§ 651a–651y nach
// Art. 229 § 42 EGBGB für Reiseverträge ab dem 1. Juli 2018; jede Regel
// dieser Abschnitte trägt das entsprechende `effective`-Fenster.
//
// GELD. Der Untertitel 1 führt keine Geldrechnung außer zwei Subtraktionen
// (Ledger D-07-03); die Untertitel 3 bis 5 rechnen Anteile mit EINER Division
// je Größe, gerundet auf den Cent (Ledger D-07-07).
//
// WAS DER UNTERTITEL 1 IST. Er senkt den Dienstvertrag als Schuldverhältnis
// ab (§ 611), den Arbeitsvertrag als seine besondere Art (§ 611a), die
// Vergütung (§§ 612, 614, 615, 616), die Fürsorgepflichten (§§ 617–619a), die
// Beendigung durch Zeitablauf und Kündigung mit ihren gestaffelten Fristen
// (§§ 620–625), die außerordentliche Kündigung (§§ 626–628) und die
// Nachwirkungen der Beendigung (§§ 629, 630).
//
// WAS DIESES PAKET NICHT TUT (Grenzen aus dem Text, nicht aus dem
// Arbeitsumfang):
//
// 1. § 613a (Betriebsübergang) wird nur in seinem INSTITUTIONELLEN Kern
//    abgesenkt (Eintritt in die Rechte und Pflichten, Unwirksamkeit der
//    Übergangskündigung, Widerspruchsfrist). Die inhaltliche Fortgeltung von
//    Tarifvertrags- und Betriebsvereinbarungsnormen (Abs. 1 Satz 2–4) und die
//    anteilige Nachhaftung (Abs. 2 Satz 2) bleiben Tatsachenfeststellung ohne
//    eigene Regel: der Text liefert keinen Bemessungsschlüssel, den dieses
//    Paket erfinden dürfte.
// 2. Das Kündigungsschutzgesetz, das Betriebsverfassungsgesetz, Tarifverträge
//    und das Teilzeit- und Befristungsgesetz (§ 620 Abs. 3) sind fremde
//    Gesetze und kommen, wo der Text auf sie verweist, nur als benannte
//    Grenze vor (SOURCES.json, external) — sie werden nicht formalisiert.
// 3. § 613a Abs. 5 (Unterrichtungspflicht) und § 630 Satz 4 (§ 109
//    GewO-Verweisung) sind institutionelle Pflichten ohne eigene
//    Schlussfolgerungskette: der Text zählt ihren Inhalt auf, ohne eine
//    Bedingung zu stellen, die eine Regel prüfen könnte.
// 4. Digitale Verbraucherverträge (§ 620 Abs. 4, §§ 327c, 327m, 327r) liegen
//    beim Nachbarpaket, das den Abschnitt 3 Titel 2a absenkt; dieses Paket
//    stellt nur fest, dass der Verweis besteht.
//
// BEWERTENDE MERKMALE (DECISION-0194). Jeder Fall ist nach dem WORTLAUT des
// Paragraphen einem der drei Kanäle zugeordnet:
//
//   WERTUNG (external judgment relation … { authority Court; }) — die
//     Gesamtbetrachtung aller Umstände beim Arbeitsvertrag (§ 611a Abs. 1
//     Satz 5), der wichtige Grund der außerordentlichen Kündigung (§ 626
//     Abs. 1, § 627 Abs. 2 Satz 1), die Dienste höherer Art auf Grund
//     besonderen Vertrauens (§ 627 Abs. 1), die angemessene Zeit zur
//     Stellungssuche (§ 629), die verhältnismäßig nicht erhebliche Zeit der
//     Verhinderung (§ 616), die grobe Fahrlässigkeit (§ 617 Abs. 1).
//   FESTGESTELLTE TATSACHE (relation kind empirical, im Fall origin
//     adjudicated) — der Tag der Kenntniserlangung von den kündigungs-
//     erheblichen Tatsachen (§ 626 Abs. 2 Satz 2), der Tag des
//     Betriebsübergangs (§ 613a Abs. 1 Satz 1), der Beginn der Beschäftigung
//     im Betrieb (§ 622 Abs. 2 Satz 1).
//   LESARTEN (interpretation … any_of) — in diesem Untertitel nicht
//     gebraucht: der Text stellt keine konkurrierende Auslegung zur
//     Formalisierung.
//
// Ein flacher Fall-Fakt ist verboten (Lint evaluative-fact-without-producer).
//
// ABWESENHEIT IST KEINE VERNEINUNG. „Unverzüglich widerspricht“ (§ 625),
// „ohne sein Verschulden“ (§ 616) und ähnliche Merkmale sind AUSDRÜCKLICHE
// Eingaben des Falls; ihr Fehlen im Fall bedeutet nicht ihre Verneinung.
//
// FRISTEN. § 613a Abs. 6 (ein Monat), § 622 Abs. 1 (vier Wochen zum
// Fünfzehnten oder Monatsende), § 622 Abs. 2 (ein bis sieben Monate zum
// Monatsende, gestaffelt nach Betriebszugehörigkeit), § 622 Abs. 3
// (zwei Wochen in der Probezeit), § 624 (sechs Monate), § 626 Abs. 2
// (zwei Wochen ab Kenntnis) rechnen mit den Kalenderschritten der §§ 187 f.
// Die Politik dieses Pakets trägt denselben Feldsatz wie BGB_FRISTEN_TAG und
// BGB_FRISTEN_KALENDER (Ledger D-07-01). Zeilen: DEADLINES.json, Abschnitt
// BG-07. § 621 (Kündigungsfristen bei Dienstverhältnissen, die kein
// Arbeitsverhältnis sind) rechnet nach demselben Muster ohne eigene
// deadline-policy-Deklaration, weil seine Endtermine (Tagesende, Sonnabend,
// Monatsschluss, Quartalsschluss) unmittelbar aus dem Text folgen und keine
// der beiden Politiken unverändert passt (Ledger D-07-02).
//
// GELD. Dieser Untertitel führt keine eigene Geldrechnung: § 612 Abs. 2
// (übliche oder taxmäßige Vergütung) und § 628 Abs. 1 (Teilvergütung) nennen
// keinen Bemessungsschlüssel, den der Text selbst gäbe — die Höhe bleibt
// Eingabe des Falls (Ledger D-07-03).
//
// SPRACHE. Nur Deutsch und Englisch (DECISION-0319, Р7).

language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

import de.bgb.core version "0.1.0";
import de.bgb.fristen version "0.1.0";

type Person = de.bgb.core::Person;
type Anspruch = de.bgb.core::Anspruch;

source FEIERTAGE_BUND {
    kind statute;
    jurisdiction DE;
    number "Feiertagsgesetze der Länder (bundesweit anerkannte Feiertage)";
    label de official "Gesetzliche Feiertage, die in allen Ländern anerkannt sind";
    label en unofficial "Public holidays recognised nationwide";
}
edition FEIERTAGE_BUND_1991_2070 of FEIERTAGE_BUND {
    language de;
    officiality official;
    materialization_status ABSTRACT_ONLY;
    in_force [@1991-01-01, @2071-01-01);
}
calendar KALENDER_BUNDESWEIT {
    timezone "Europe/Berlin";
    timezone_db "iana-tzdb@2026a";
    period [@1991-01-01, @2071-01-01);
    source FEIERTAGE_BUND;
    resource "artifact:corpus/clir/de-feiertage-bundesweit.calendar.json";
    format "law.calendar/0.1";
    content_hash "sha256:aa310583279c7f05aa491307648663f4a7c9f8f90910541876118bfb6d6e3204";
}

// Eine einzige Politik für das ganze Paket (§ 168.2): jede Frist aller
// fünf Untertitel — Tage (§ 621 Nr. 1), Wochen (§§ 621 Nr. 5, 622 Abs. 1, 3,
// 626 Abs. 2), Monate (§§ 613a Abs. 6, 622 Abs. 2, 624) und Jahre (§§ 622
// Abs. 2, 624) — wird mit `add_calendar_period` und `month_end_of` auf den
// Tag genau gerechnet (§ 188 Abs. 2, 3); der Feldsatz entspricht
// BGB_FRISTEN_KALENDER (Ledger D-07-01). § 193 wird in diesem Untertitel
// nirgends ausdrücklich gerechnet: die Kündigungstermine der §§ 613a, 621,
// 622, 624, 626 werden durch bloßen Zeitablauf wirksam, nicht durch eine
// innerhalb der Frist abzugebende Erklärung am Fristende selbst.
deadline policy BGB_DIENST_WERK_KALENDER {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

// --- Gemeinsamer Träger des Untertitels -----------------------------------------------------------

pub entity Dienstverhaeltnis {
    label de official "Dienstverhältnis, durch das Dienste jeder Art versprochen werden (§ 611); der Arbeitsvertrag ist seine besondere Art (§ 611a)";
    label en unofficial "service relationship under which services of any kind are promised (§ 611); the employment contract is its particular species (§ 611a)";
}
