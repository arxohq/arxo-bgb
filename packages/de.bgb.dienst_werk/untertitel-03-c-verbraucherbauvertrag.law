// --- Untertitel 3 Kapitel 3 Verbraucherbauvertrag (§§ 650i–650o) ---------------------------------------
//
// KORRIDOR 2018 (Ledger D-07-08): wie Kapitel 2 gilt auch dieses Kapitel
// nach Art. 229 § 39 EGBGB für Schuldverhältnisse ab dem 1. Januar 2018;
// jede Regel trägt `effective [@2018-01-01, infinity)`.
//
// GELD. § 650m Abs. 1 (höchstens 90 Prozent der vereinbarten Gesamtvergütung),
// Abs. 2 Satz 1 (Sicherheit von 5 Prozent), Satz 2 (Erhöhung um mehr als
// 10 Prozent, weitere Sicherheit von 5 Prozent) und Abs. 4 (20 Prozent)
// rechnen je EINE Division, gerundet auf den Cent (Ledger D-07-07).
//
// WAS DIESES KAPITEL NICHT TUT:
// 1. § 650j verweist auf Artikel 249 EGBGB, § 650l Satz 2 auf Artikel 249
//    § 3 EGBGB — ein fremdes Gesetz, das dieses Paket nur benennt.
// 2. § 650l Satz 1 räumt das Widerrufsrecht „gemäß § 355" ein. Die Mechanik
//    des Widerrufs (Frist, Erklärung, Rechtsfolgen) gehört dem Nachbarpaket
//    `de.bgb.schuldrecht_at` und läuft dort über dessen eigenen Träger
//    `Vertrag`; dieses Kapitel senkt nur den institutionellen Schluss ab,
//    DASS dem Verbraucher das Widerrufsrecht zusteht, und die Belehrungs-
//    pflicht (Ledger D-07-10). Ein Brückenprädikat, das den hiesigen Träger
//    auf den fremden abbildet, wird NICHT gebaut.
// 3. § 650k Abs. 2 ordnet eine Auslegungsregel an; die Auslegung selbst ist
//    keine Rechtsfolge, die eine Regel prüfen könnte — der Schluss lautet
//    nur, dass Zweifel zu Lasten des Unternehmers gehen.

language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// --- § 650i Verbraucherbauvertrag -----------------------------------------------------------------------

pub relation verbraucher_als_besteller_650i(w: Werkvertrag, p: Person) kind empirical {
    key(w);
    label de official "der Besteller ist ein Verbraucher (§ 650i Abs. 1)";
    label en unofficial "the customer is a consumer (§ 650i (1))";
}
pub relation bau_eines_neuen_gebaeudes_650i(w: Werkvertrag) kind empirical {
    label de official "der Unternehmer wird zum Bau eines neuen Gebäudes verpflichtet (§ 650i Abs. 1)";
    label en unofficial "the contractor is obliged to build a new building (§ 650i (1))";
}
pub relation erhebliche_umbaumassnahmen_650i(w: Werkvertrag) kind empirical {
    label de official "der Unternehmer wird zu erheblichen Umbaumaßnahmen an einem bestehenden Gebäude verpflichtet (§ 650i Abs. 1)";
    label en unofficial "the contractor is obliged to carry out substantial conversion measures on an existing building (§ 650i (1))";
}
pub relation vertrag_in_textform_650i(w: Werkvertrag) kind empirical {
    label de official "der Vertrag ist in Textform geschlossen (§ 650i Abs. 2)";
    label en unofficial "the contract was concluded in text form (§ 650i (2))";
}
pub relation vertrag_nicht_in_textform_650i(w: Werkvertrag) kind empirical {
    label de official "der Vertrag ist nicht in Textform geschlossen (§ 650i Abs. 2) — ausdrückliche Angabe des Falls";
    label en unofficial "the contract was not concluded in text form (§ 650i (2)) — express statement of the case";
}
pub relation verbraucherbauvertrag_650i(w: Werkvertrag) kind institutional {
    key(w);
    label de official "der Vertrag ist ein Verbraucherbauvertrag; für ihn gelten ergänzend die Vorschriften des Kapitels 3 (§ 650i Abs. 1, 3)";
    label en unofficial "the contract is a consumer construction contract; the provisions of Chapter 3 apply to it in addition (§ 650i (1), (3))";
}
pub relation textform_650i_gewahrt(w: Werkvertrag) kind institutional {
    key(w);
    label de official "der Verbraucherbauvertrag wahrt die Textform (§ 650i Abs. 2)";
    label en unofficial "the consumer construction contract observes the text form (§ 650i (2))";
}
pub relation textform_650i_nicht_gewahrt(w: Werkvertrag) kind institutional {
    key(w);
    label de official "der Verbraucherbauvertrag wahrt die Textform nicht (§ 650i Abs. 2)";
    label en unofficial "the consumer construction contract does not observe the text form (§ 650i (2))";
}

@source(BGB_P650i)
rule Verbraucherbauvertrag650iNeubau(w: Werkvertrag, v: Person) strict {
    label de official "Verbraucherbauverträge sind Verträge, durch die der Unternehmer von einem Verbraucher zum Bau eines neuen Gebäudes verpflichtet wird (§ 650i Abs. 1)";
    label en unofficial "Consumer construction contracts are contracts by which a consumer obliges the contractor to build a new building (§ 650i (1))";
    effective [@2018-01-01, infinity);
    when verbraucher_als_besteller_650i(w, v);
    when bau_eines_neuen_gebaeudes_650i(w);
    then verbraucherbauvertrag_650i(w);
}

@source(BGB_P650i)
rule Verbraucherbauvertrag650iUmbau(w: Werkvertrag, v: Person) strict {
    label de official "Verbraucherbauverträge sind auch Verträge, durch die der Unternehmer von einem Verbraucher zu erheblichen Umbaumaßnahmen an einem bestehenden Gebäude verpflichtet wird (§ 650i Abs. 1)";
    label en unofficial "Consumer construction contracts are also contracts by which a consumer obliges the contractor to carry out substantial conversion measures on an existing building (§ 650i (1))";
    effective [@2018-01-01, infinity);
    when verbraucher_als_besteller_650i(w, v);
    when erhebliche_umbaumassnahmen_650i(w);
    then verbraucherbauvertrag_650i(w);
}

@source(BGB_P650i)
rule Textform650iAbs2Gewahrt(w: Werkvertrag) strict {
    label de official "Der Verbraucherbauvertrag bedarf der Textform (§ 650i Abs. 2)";
    label en unofficial "The consumer construction contract requires text form (§ 650i (2))";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when vertrag_in_textform_650i(w);
    then textform_650i_gewahrt(w);
}

@source(BGB_P650i)
rule Textform650iAbs2NichtGewahrt(w: Werkvertrag) strict {
    label de official "Ein nicht in Textform geschlossener Verbraucherbauvertrag wahrt das Formerfordernis des § 650i Abs. 2 nicht";
    label en unofficial "A consumer construction contract not concluded in text form does not observe the form requirement of § 650i (2)";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when vertrag_nicht_in_textform_650i(w);
    then textform_650i_nicht_gewahrt(w);
}

// --- § 650j Baubeschreibung -------------------------------------------------------------------------------

pub relation wesentliche_planungsvorgaben_vom_verbraucher_650j(w: Werkvertrag) kind empirical {
    label de official "der Verbraucher oder ein von ihm Beauftragter macht die wesentlichen Planungsvorgaben (§§ 650j, 650n Abs. 1 Satz 2)";
    label en unofficial "the consumer or a person commissioned by them makes the essential planning specifications (§§ 650j, 650n (1) sentence 2)";
}
pub relation planungsvorgaben_nicht_vom_verbraucher_650j(w: Werkvertrag) kind empirical {
    label de official "die wesentlichen Planungsvorgaben stammen nicht vom Verbraucher oder einem von ihm Beauftragten (§ 650j) — ausdrückliche Angabe des Falls";
    label en unofficial "the essential planning specifications do not come from the consumer or a person commissioned by them (§ 650j) — express statement of the case";
}
pub relation ueber_baubeschreibung_unterrichtet_650j(w: Werkvertrag) kind empirical {
    label de official "der Verbraucher wurde über die sich aus Artikel 249 EGBGB ergebenden Einzelheiten in der dort vorgesehenen Form unterrichtet (§ 650j)";
    label en unofficial "the consumer was informed of the particulars arising from Article 249 of the Introductory Act to the Civil Code, in the form provided for there (§ 650j)";
}

@source(BGB_P650j)
rule Baubeschreibungspflicht650j(w: Werkvertrag, u: Person, schluss: Date) strict {
    label de official "Der Unternehmer hat den Verbraucher über die sich aus Artikel 249 des Einführungsgesetzes zum Bürgerlichen Gesetzbuche ergebenden Einzelheiten in der dort vorgesehenen Form zu unterrichten, es sei denn, der Verbraucher oder ein von ihm Beauftragter macht die wesentlichen Planungsvorgaben (§ 650j)";
    label en unofficial "The contractor must inform the consumer of the particulars arising from Article 249 of the Introductory Act to the Civil Code, in the form provided for there, unless the consumer or a person commissioned by them makes the essential planning specifications (§ 650j)";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when unternehmer(w, u);
    when werkvertrag_geschlossen_am(w, schluss);
    when planungsvorgaben_nicht_vom_verbraucher_650j(w);
    then duty BaubeschreibungUnterrichten650j {
        bearer u;
        achieve ueber_baubeschreibung_unterrichtet_650j(w) during [schluss, infinity);
    };
}

@source(BGB_P650j)
rule PositionBaubeschreibungspflicht650j(w: Werkvertrag, u: Person, schluss: Date) strict {
    label de official "Der Unternehmer muss den Verbraucher über die Baubeschreibung unterrichten (§ 650j) — normative Position";
    label en unofficial "the contractor must inform the consumer about the building description (§ 650j) — normative position";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when unternehmer(w, u);
    when werkvertrag_geschlossen_am(w, schluss);
    when planungsvorgaben_nicht_vom_verbraucher_650j(w);
    then duty BaubeschreibungUnterrichten650jPosition {
        bearer u;
        achieve ueber_baubeschreibung_unterrichtet_650j(w) during [schluss, infinity);
    };
}

// --- § 650k Inhalt des Vertrags ------------------------------------------------------------------------------

pub relation baubeschreibung_vorvertraglich_zur_verfuegung_gestellt_650k(w: Werkvertrag) kind empirical {
    label de official "eine Baubeschreibung wurde vorvertraglich zur Verfügung gestellt (§ 650k Abs. 1)";
    label en unofficial "a construction description was made available before the contract (§ 650k (1))";
}
pub relation abweichende_ausdrueckliche_vereinbarung_650k(w: Werkvertrag) kind empirical {
    label de official "die Vertragsparteien haben ausdrücklich etwas anderes vereinbart (§ 650k Abs. 1 Halbsatz 2)";
    label en unofficial "the parties have expressly agreed otherwise (§ 650k (1) second half-sentence)";
}
pub relation keine_abweichende_ausdrueckliche_vereinbarung_650k(w: Werkvertrag) kind empirical {
    label de official "die Vertragsparteien haben nichts anderes ausdrücklich vereinbart (§ 650k Abs. 1 Halbsatz 2) — ausdrückliche Angabe des Falls";
    label en unofficial "the parties have not expressly agreed otherwise (§ 650k (1) second half-sentence) — express statement of the case";
}
pub relation baubeschreibung_wird_vertragsinhalt_650k(w: Werkvertrag) kind institutional {
    key(w);
    label de official "die Angaben der vorvertraglich zur Verfügung gestellten Baubeschreibung in Bezug auf die Bauausführung werden Inhalt des Vertrags (§ 650k Abs. 1)";
    label en unofficial "the particulars of the construction description made available before the contract, relating to the execution of the works, become part of the contract (§ 650k (1))";
}
pub relation baubeschreibung_unvollstaendig_oder_unklar_650k(w: Werkvertrag) kind empirical {
    label de official "die Baubeschreibung ist unvollständig oder unklar (§ 650k Abs. 2 Satz 1)";
    label en unofficial "the construction description is incomplete or unclear (§ 650k (2) sentence 1)";
}
pub relation zweifel_zu_lasten_des_unternehmers_650k(w: Werkvertrag) kind institutional {
    key(w);
    label de official "Zweifel bei der Auslegung des Vertrags bezüglich der vom Unternehmer geschuldeten Leistung gehen zu dessen Lasten (§ 650k Abs. 2 Satz 2)";
    label en unofficial "doubts in the interpretation of the contract regarding the performance owed by the contractor are resolved against them (§ 650k (2) sentence 2)";
}
pub relation verbindliche_angabe_zur_fertigstellung_650k(w: Werkvertrag) kind empirical {
    label de official "der Bauvertrag enthält verbindliche Angaben zum Zeitpunkt der Fertigstellung des Werks oder zur Dauer der Bauausführung (§ 650k Abs. 3 Satz 1)";
    label en unofficial "the construction contract contains binding particulars on the time of completion of the work or on the duration of the works (§ 650k (3) sentence 1)";
}
pub relation keine_verbindliche_angabe_zur_fertigstellung_650k(w: Werkvertrag) kind empirical {
    label de official "der Bauvertrag enthält keine verbindlichen Angaben zum Zeitpunkt der Fertigstellung oder zur Dauer der Bauausführung (§ 650k Abs. 3 Satz 2) — ausdrückliche Angabe des Falls";
    label en unofficial "the construction contract contains no binding particulars on the time of completion or on the duration of the works (§ 650k (3) sentence 2) — express statement of the case";
}
pub relation vorvertragliche_fertigstellungsangabe_wird_vertragsinhalt_650k(w: Werkvertrag) kind institutional {
    key(w);
    label de official "die vorvertraglich in der Baubeschreibung übermittelten Angaben zum Zeitpunkt der Fertigstellung oder zur Dauer der Bauausführung werden Inhalt des Vertrags (§ 650k Abs. 3 Satz 2)";
    label en unofficial "the particulars on the time of completion or the duration of the works communicated in the construction description before the contract become part of the contract (§ 650k (3) sentence 2)";
}

pub relation fertigstellungsangabe_uebernommen_650k(w: Werkvertrag) kind empirical {
    label de official "die vorvertragliche Fertigstellungsangabe wurde als Vertragsinhalt übernommen (§ 650k Abs. 3)";
    label en unofficial "the pre-contract completion statement was adopted as contract content (§ 650k (3))";
}

@source(BGB_P650k)
rule BaubeschreibungVertragsinhalt650kAbs1(w: Werkvertrag) strict {
    label de official "Die Angaben der vorvertraglich zur Verfügung gestellten Baubeschreibung in Bezug auf die Bauausführung werden Inhalt des Vertrags, es sei denn, die Vertragsparteien haben ausdrücklich etwas anderes vereinbart (§ 650k Abs. 1)";
    label en unofficial "The particulars of the construction description made available before the contract, relating to the execution of the works, become part of the contract unless the parties have expressly agreed otherwise (§ 650k (1))";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when baubeschreibung_vorvertraglich_zur_verfuegung_gestellt_650k(w);
    when keine_abweichende_ausdrueckliche_vereinbarung_650k(w);
    then baubeschreibung_wird_vertragsinhalt_650k(w);
}

@source(BGB_P650k)
rule ZweifelZuLastenDesUnternehmers650kAbs2(w: Werkvertrag) strict {
    label de official "Soweit die Baubeschreibung unvollständig oder unklar ist, gehen Zweifel bei der Auslegung des Vertrags bezüglich der vom Unternehmer geschuldeten Leistung zu dessen Lasten (§ 650k Abs. 2)";
    label en unofficial "In so far as the construction description is incomplete or unclear, doubts in the interpretation of the contract regarding the performance owed by the contractor are resolved against them (§ 650k (2))";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when baubeschreibung_unvollstaendig_oder_unklar_650k(w);
    then zweifel_zu_lasten_des_unternehmers_650k(w);
}

@source(BGB_P650k)
rule FertigstellungsangabeVertragsinhalt650kAbs3(w: Werkvertrag) strict {
    label de official "Enthält der Vertrag keine verbindlichen Angaben zum Zeitpunkt der Fertigstellung des Werks oder zur Dauer der Bauausführung, werden die vorvertraglich in der Baubeschreibung übermittelten Angaben Inhalt des Vertrags (§ 650k Abs. 3 Satz 2)";
    label en unofficial "Where the contract contains no binding particulars on the time of completion of the work or on the duration of the works, the particulars communicated in the construction description before the contract become part of the contract (§ 650k (3) sentence 2)";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when baubeschreibung_vorvertraglich_zur_verfuegung_gestellt_650k(w);
    when keine_verbindliche_angabe_zur_fertigstellung_650k(w);
    then vorvertragliche_fertigstellungsangabe_wird_vertragsinhalt_650k(w);
}

@source(BGB_P650k)
rule PositionFertigstellungsangabeVertragsinhalt650kAbs3(w: Werkvertrag, u: Person, schluss: Date) strict {
    label de official "Die Fertigstellungsangabe wird nach § 650k Absatz 3 Satz 2 Vertragsinhalt — normative Position";
    label en unofficial "the completion statement becomes contract content under § 650k (3) sentence 2 — normative position";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when unternehmer(w, u);
    when werkvertrag_geschlossen_am(w, schluss);
    when baubeschreibung_vorvertraglich_zur_verfuegung_gestellt_650k(w);
    when keine_verbindliche_angabe_zur_fertigstellung_650k(w);
    then liberty FertigstellungsangabeVertragsinhalt650kAbs3Position {
        holder u;
        action fertigstellungsangabe_uebernommen_650k(w);
        window [schluss, infinity);
    };
}

// --- § 650l Widerrufsrecht -----------------------------------------------------------------------------------

pub relation vertrag_notariell_beurkundet_650l(w: Werkvertrag) kind empirical {
    label de official "der Vertrag wurde notariell beurkundet (§ 650l Satz 1 Halbsatz 2)";
    label en unofficial "the contract was recorded by a notary (§ 650l sentence 1 second half-sentence)";
}
pub relation vertrag_nicht_notariell_beurkundet_650l(w: Werkvertrag) kind empirical {
    label de official "der Vertrag wurde nicht notariell beurkundet (§ 650l Satz 1) — ausdrückliche Angabe des Falls";
    label en unofficial "the contract was not recorded by a notary (§ 650l sentence 1) — express statement of the case";
}
pub relation widerrufsrecht_650l(w: Werkvertrag, verbraucher: Person) kind institutional {
    key(w);
    label de official "dem Verbraucher steht ein Widerrufsrecht gemäß § 355 zu (§ 650l Satz 1) — die Mechanik des Widerrufs gehört de.bgb.schuldrecht_at";
    label en unofficial "the consumer has a right of withdrawal under § 355 (§ 650l sentence 1) — the mechanics of withdrawal belong to de.bgb.schuldrecht_at";
}
pub relation ueber_widerrufsrecht_belehrt_650l(w: Werkvertrag) kind empirical {
    label de official "der Verbraucher wurde nach Maßgabe des Artikels 249 § 3 EGBGB über sein Widerrufsrecht belehrt (§ 650l Satz 2)";
    label en unofficial "the consumer was instructed about their right of withdrawal in accordance with Article 249 § 3 of the Introductory Act to the Civil Code (§ 650l sentence 2)";
}

@source(BGB_P650l)
rule Widerrufsrecht650lSatz1(w: Werkvertrag, v: Person) strict {
    label de official "Dem Verbraucher steht ein Widerrufsrecht gemäß § 355 zu, es sei denn, der Vertrag wurde notariell beurkundet (§ 650l Satz 1)";
    label en unofficial "The consumer has a right of withdrawal under § 355, unless the contract was recorded by a notary (§ 650l sentence 1)";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when verbraucher_als_besteller_650i(w, v);
    when vertrag_nicht_notariell_beurkundet_650l(w);
    then widerrufsrecht_650l(w, v);
}

@source(BGB_P650l)
rule Widerrufsbelehrungspflicht650lSatz2(w: Werkvertrag, u: Person, v: Person, schluss: Date) strict {
    label de official "Der Unternehmer ist verpflichtet, den Verbraucher nach Maßgabe des Artikels 249 § 3 EGBGB über sein Widerrufsrecht zu belehren (§ 650l Satz 2)";
    label en unofficial "The contractor must instruct the consumer about their right of withdrawal in accordance with Article 249 § 3 of the Introductory Act to the Civil Code (§ 650l sentence 2)";
    effective [@2018-01-01, infinity);
    when widerrufsrecht_650l(w, v);
    when unternehmer(w, u);
    when werkvertrag_geschlossen_am(w, schluss);
    then duty WiderrufsbelehrungErteilen650l {
        bearer u;
        achieve ueber_widerrufsrecht_belehrt_650l(w) during [schluss, infinity);
    };
}

@source(BGB_P650l)
rule PositionWiderrufsbelehrungspflicht650lSatz2(w: Werkvertrag, u: Person, v: Person, schluss: Date) strict {
    label de official "Der Unternehmer muss den Verbraucher über sein Widerrufsrecht belehren (§ 650l Satz 2) — normative Position";
    label en unofficial "the contractor must instruct the consumer about withdrawal (§ 650l sentence 2) — normative position";
    effective [@2018-01-01, infinity);
    when widerrufsrecht_650l(w, v);
    when unternehmer(w, u);
    when werkvertrag_geschlossen_am(w, schluss);
    then duty Widerrufsbelehrung650lSatz2Position {
        bearer u;
        beneficiary v;
        achieve ueber_widerrufsrecht_belehrt_650l(w) during [schluss, infinity);
    };
}

// --- § 650m Abschlagszahlungen; Absicherung des Vergütungsanspruchs ----------------------------------------------

pub relation vereinbarte_gesamtverguetung_650m(w: Werkvertrag, betrag: Money) kind empirical {
    key(w);
    label de official "die vereinbarte Gesamtvergütung einschließlich der Vergütung für Nachtragsleistungen nach § 650c (§ 650m Abs. 1)";
    label en unofficial "the agreed total compensation including the compensation for supplementary services under § 650c (§ 650m (1))";
}
pub relation abschlagszahlungen_verlangt_650m(w: Werkvertrag) kind empirical {
    label de official "der Unternehmer verlangt Abschlagszahlungen nach § 632a (§ 650m Abs. 1, 4)";
    label en unofficial "the contractor demands interim payments under § 632a (§ 650m (1), (4))";
}
pub relation hoechstbetrag_der_abschlagszahlungen_650m(w: Werkvertrag, betrag: Money) kind institutional {
    key(w);
    label de official "Höchstbetrag aller Abschlagszahlungen — 90 Prozent der vereinbarten Gesamtvergütung (§ 650m Abs. 1)";
    label en unofficial "maximum total of all interim payments — 90 per cent of the agreed total compensation (§ 650m (1))";
}
pub relation sicherheit_fuer_rechtzeitige_herstellung_650m(w: Werkvertrag, betrag: Money) kind institutional {
    key(w);
    label de official "Höhe der bei der ersten Abschlagszahlung zu leistenden Sicherheit — 5 Prozent der vereinbarten Gesamtvergütung (§ 650m Abs. 2 Satz 1)";
    label en unofficial "amount of the security to be provided with the first interim payment — 5 per cent of the agreed total compensation (§ 650m (2) sentence 1)";
}
pub relation hoechstbetrag_der_verbrauchersicherheit_650m(w: Werkvertrag, betrag: Money) kind institutional {
    key(w);
    label de official "Höchstmaß der vom Verbraucher geschuldeten Sicherheit für die vereinbarte Vergütung — 20 Prozent der vereinbarten Vergütung (§ 650m Abs. 4 Satz 1)";
    label en unofficial "maximum security owed by the consumer for the agreed compensation — 20 per cent of the agreed compensation (§ 650m (4) sentence 1)";
}

@source(BGB_P650m)
rule HoechstbetragAbschlaege650mAbs1(w: Werkvertrag, gesamt: Money) strict {
    label de official "Verlangt der Unternehmer Abschlagszahlungen nach § 632a, darf der Gesamtbetrag der Abschlagszahlungen 90 Prozent der vereinbarten Gesamtvergütung einschließlich der Vergütung für Nachtragsleistungen nach § 650c nicht übersteigen (§ 650m Abs. 1) — eine Division, gerundet auf den Cent (Ledger D-07-07)";
    label en unofficial "Where the contractor demands interim payments under § 632a, their total must not exceed 90 per cent of the agreed total compensation including the compensation for supplementary services under § 650c (§ 650m (1)) — one division, rounded to the cent (ledger D-07-07)";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when abschlagszahlungen_verlangt_650m(w);
    when vereinbarte_gesamtverguetung_650m(w, gesamt);
    then hoechstbetrag_der_abschlagszahlungen_650m(w, div_round(gesamt * 90, 100 * 1.0, 2, "HALF_UP"));
}

@source(BGB_P650m)
rule Sicherheit650mAbs2Satz1(w: Werkvertrag, gesamt: Money) strict {
    label de official "Dem Verbraucher ist bei der ersten Abschlagszahlung eine Sicherheit für die rechtzeitige Herstellung des Werks ohne wesentliche Mängel in Höhe von 5 Prozent der vereinbarten Gesamtvergütung zu leisten (§ 650m Abs. 2 Satz 1) — eine Division, gerundet auf den Cent (Ledger D-07-07)";
    label en unofficial "With the first interim payment, security for the timely production of the work without substantial defects amounting to 5 per cent of the agreed total compensation must be provided to the consumer (§ 650m (2) sentence 1) — one division, rounded to the cent (ledger D-07-07)";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when abschlagszahlungen_verlangt_650m(w);
    when vereinbarte_gesamtverguetung_650m(w, gesamt);
    then sicherheit_fuer_rechtzeitige_herstellung_650m(w, div_round(gesamt * 5, 100 * 1.0, 2, "HALF_UP"));
}

pub relation zusaetzlicher_verguetungsanspruch_650m(w: Werkvertrag, betrag: Money) kind empirical {
    key(w);
    label de official "Betrag, um den sich der Vergütungsanspruch infolge einer Anordnung nach den §§ 650b, 650c oder infolge sonstiger Änderungen erhöht (§ 650m Abs. 2 Satz 2)";
    label en unofficial "amount by which the claim to compensation increases as a result of an order under §§ 650b, 650c or of other changes (§ 650m (2) sentence 2)";
}
pub relation erhoehungsgrenze_650m(w: Werkvertrag, betrag: Money) kind institutional {
    key(w);
    label de official "Schwelle, ab der eine weitere Sicherheit zu leisten ist — Erhöhung um mehr als 10 Prozent der vereinbarten Gesamtvergütung (§ 650m Abs. 2 Satz 2)";
    label en unofficial "threshold above which further security must be provided — an increase of more than 10 per cent of the agreed total compensation (§ 650m (2) sentence 2)";
}
pub relation weitere_sicherheit_650m(w: Werkvertrag, betrag: Money) kind institutional {
    key(w);
    label de official "Höhe der weiteren Sicherheit — 5 Prozent des zusätzlichen Vergütungsanspruchs (§ 650m Abs. 2 Satz 2)";
    label en unofficial "amount of the further security — 5 per cent of the additional claim to compensation (§ 650m (2) sentence 2)";
}

@source(BGB_P650m)
rule Erhoehungsgrenze650mAbs2Satz2(w: Werkvertrag, gesamt: Money) strict {
    label de official "Die weitere Sicherheit ist zu leisten, wenn sich der Vergütungsanspruch um mehr als 10 Prozent erhöht (§ 650m Abs. 2 Satz 2) — die Schwelle rechnet eine Division, gerundet auf den Cent (Ledger D-07-07)";
    label en unofficial "The further security must be provided where the claim to compensation increases by more than 10 per cent (§ 650m (2) sentence 2) — the threshold is one division, rounded to the cent (ledger D-07-07)";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when vereinbarte_gesamtverguetung_650m(w, gesamt);
    then erhoehungsgrenze_650m(w, div_round(gesamt * 10, 100 * 1.0, 2, "HALF_UP"));
}

@source(BGB_P650m)
rule WeitereSicherheit650mAbs2Satz2(w: Werkvertrag, zusatz: Money, grenze: Money) strict {
    label de official "Erhöht sich der Vergütungsanspruch um mehr als 10 Prozent, ist dem Verbraucher bei der nächsten Abschlagszahlung eine weitere Sicherheit in Höhe von 5 Prozent des zusätzlichen Vergütungsanspruchs zu leisten (§ 650m Abs. 2 Satz 2)";
    label en unofficial "Where the claim to compensation increases by more than 10 per cent, further security amounting to 5 per cent of the additional claim must be provided to the consumer with the next interim payment (§ 650m (2) sentence 2)";
    effective [@2018-01-01, infinity);
    when zusaetzlicher_verguetungsanspruch_650m(w, zusatz);
    when erhoehungsgrenze_650m(w, grenze);
    when zusatz > grenze;
    then weitere_sicherheit_650m(w, div_round(zusatz * 5, 100 * 1.0, 2, "HALF_UP"));
}

pub relation weitere_sicherheit_geleistet_650m(w: Werkvertrag, betrag: Money) kind empirical {
    label de official "die weitere Sicherheit wurde dem Verbraucher geleistet (§ 650m Abs. 2 Satz 2)";
    label en unofficial "the further security was provided to the consumer (§ 650m (2) sentence 2)";
}

@source(BGB_P650m)
rule PositionWeitereSicherheit650mAbs2Satz2(w: Werkvertrag, u: Person, v: Person, zusatz: Money, grenze: Money, schluss: Date) strict {
    label de official "Der Unternehmer muss weitere Sicherheit leisten (§ 650m Abs. 2 Satz 2) — normative Position";
    label en unofficial "the contractor must provide further security (§ 650m (2) sentence 2) — normative position";
    effective [@2018-01-01, infinity);
    when unternehmer(w, u);
    when verbraucher_als_besteller_650i(w, v);
    when werkvertrag_geschlossen_am(w, schluss);
    when zusaetzlicher_verguetungsanspruch_650m(w, zusatz);
    when erhoehungsgrenze_650m(w, grenze);
    when zusatz > grenze;
    then duty WeitereSicherheit650mAbs2Satz2Position {
        bearer u;
        beneficiary v;
        achieve weitere_sicherheit_geleistet_650m(w, div_round(zusatz * 5, 100 * 1.0, 2, "HALF_UP")) during [schluss, infinity);
    };
}

@source(BGB_P650m)
rule HoechstbetragVerbrauchersicherheit650mAbs4(w: Werkvertrag, gesamt: Money) strict {
    label de official "Eine Vereinbarung, die den Verbraucher zu einer Sicherheitsleistung für die vereinbarte Vergütung verpflichtet, die die nächste Abschlagszahlung oder 20 Prozent der vereinbarten Vergütung übersteigt, ist unwirksam (§ 650m Abs. 4 Satz 1)";
    label en unofficial "An agreement obliging the consumer to provide security for the agreed compensation exceeding the next interim payment or 20 per cent of the agreed compensation is void (§ 650m (4) sentence 1)";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when abschlagszahlungen_verlangt_650m(w);
    when vereinbarte_gesamtverguetung_650m(w, gesamt);
    then hoechstbetrag_der_verbrauchersicherheit_650m(w, div_round(gesamt * 20, 100 * 1.0, 2, "HALF_UP"));
}

// --- § 650n Erstellung und Herausgabe von Unterlagen -----------------------------------------------------------

pub relation planungsunterlagen_herausgegeben_650n(w: Werkvertrag) kind empirical {
    label de official "die für den behördlichen Nachweis benötigten Planungsunterlagen wurden erstellt und dem Verbraucher herausgegeben (§ 650n Abs. 1 Satz 1)";
    label en unofficial "the planning documents needed for proof to the authorities have been prepared and handed over to the consumer (§ 650n (1) sentence 1)";
}
pub relation nachweisunterlagen_herausgegeben_650n(w: Werkvertrag) kind empirical {
    label de official "die Unterlagen für den Nachweis der ausgeführten Leistung wurden erstellt und dem Verbraucher herausgegeben (§ 650n Abs. 2)";
    label en unofficial "the documents evidencing the works carried out have been prepared and handed over to the consumer (§ 650n (2))";
}

@source(BGB_P650n)
rule Planungsunterlagen650nAbs1(w: Werkvertrag, u: Person, schluss: Date) strict {
    label de official "Rechtzeitig vor Beginn der Ausführung einer geschuldeten Leistung hat der Unternehmer diejenigen Planungsunterlagen zu erstellen und dem Verbraucher herauszugeben, die dieser benötigt, um gegenüber Behörden den Nachweis führen zu können, dass die Leistung unter Einhaltung der einschlägigen öffentlich-rechtlichen Vorschriften ausgeführt werden wird; die Pflicht besteht nicht, soweit der Verbraucher die wesentlichen Planungsvorgaben erstellt (§ 650n Abs. 1)";
    label en unofficial "In good time before the start of the works owed, the contractor must prepare and hand over to the consumer those planning documents the consumer needs to prove to the authorities that the works will be carried out in compliance with the relevant public-law provisions; the duty does not exist in so far as the consumer prepares the essential planning specifications (§ 650n (1))";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when unternehmer(w, u);
    when werkvertrag_geschlossen_am(w, schluss);
    when planungsvorgaben_nicht_vom_verbraucher_650j(w);
    then duty PlanungsunterlagenHerausgeben650n {
        bearer u;
        achieve planungsunterlagen_herausgegeben_650n(w) during [schluss, infinity);
    };
}

@source(BGB_P650n)
rule Nachweisunterlagen650nAbs2(w: Werkvertrag, u: Person, schluss: Date) strict {
    label de official "Spätestens mit der Fertigstellung des Werks hat der Unternehmer diejenigen Unterlagen zu erstellen und dem Verbraucher herauszugeben, die dieser benötigt, um gegenüber Behörden den Nachweis führen zu können, dass die Leistung unter Einhaltung der einschlägigen öffentlich-rechtlichen Vorschriften ausgeführt worden ist (§ 650n Abs. 2)";
    label en unofficial "At the latest upon completion of the work, the contractor must prepare and hand over to the consumer those documents the consumer needs to prove to the authorities that the works were carried out in compliance with the relevant public-law provisions (§ 650n (2))";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when unternehmer(w, u);
    when werkvertrag_geschlossen_am(w, schluss);
    then duty NachweisunterlagenHerausgeben650n {
        bearer u;
        achieve nachweisunterlagen_herausgegeben_650n(w) during [schluss, infinity);
    };
}

// --- § 650o Abweichende Vereinbarungen ---------------------------------------------------------------------------

pub relation abweichung_zum_nachteil_des_verbrauchers_650o(w: Werkvertrag) kind empirical {
    label de official "von § 640 Abs. 2 Satz 2, den §§ 650i bis 650l und 650n ist zum Nachteil des Verbrauchers abgewichen worden, auch durch anderweitige Gestaltungen (§ 650o)";
    label en unofficial "there is a deviation to the consumer's detriment from § 640 (2) sentence 2, §§ 650i to 650l and 650n, including by other arrangements (§ 650o)";
}
pub relation abweichung_650o_unwirksam(w: Werkvertrag) kind institutional {
    key(w);
    label de official "die Abweichung zum Nachteil des Verbrauchers ist unbeachtlich (§ 650o)";
    label en unofficial "the deviation to the consumer's detriment is of no effect (§ 650o)";
}

@source(BGB_P650o)
rule AbweichendeVereinbarungen650o(w: Werkvertrag) strict {
    label de official "Von § 640 Abs. 2 Satz 2, den §§ 650i bis 650l und 650n kann nicht zum Nachteil des Verbrauchers abgewichen werden; diese Vorschriften finden auch Anwendung, wenn sie durch anderweitige Gestaltungen umgangen werden (§ 650o)";
    label en unofficial "There may be no deviation to the consumer's detriment from § 640 (2) sentence 2, §§ 650i to 650l and 650n; these provisions also apply where they are circumvented by other arrangements (§ 650o)";
    effective [@2018-01-01, infinity);
    when verbraucherbauvertrag_650i(w);
    when abweichung_zum_nachteil_des_verbrauchers_650o(w);
    then abweichung_650o_unwirksam(w);
}
