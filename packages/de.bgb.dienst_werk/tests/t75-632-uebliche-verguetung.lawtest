language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 632 Abs. 2: ohne Taxe gilt die übliche Vergütung als vereinbart.

test "urn:query:bgb-dw-t75-632-uebliche-verguetung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": hoehe_der_werkverguetung_nicht_bestimmt(entity_ref("urn:de:bgb:dw:t75")) { origin case_input; }
        assert "f2": keine_werktaxe_vorhanden(entity_ref("urn:de:bgb:dw:t75")) { origin case_input; }
        assert "f3": uebliche_werkverguetung(entity_ref("urn:de:bgb:dw:t75"), 4500 EUR) { origin case_input; }
    }
    evaluate truth(werkverguetung_hoehe_bestimmt(entity_ref("urn:de:bgb:dw:t75"), 4500 EUR));
    expect truth_status == TRUE_ONLY;
}
