language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630h Abs. 5 Satz 2: die unterlassene Befunderhebung steht dem groben Behandlungsfehler gleich.

test "urn:query:bgb-dw-t73-630h-abs5-befunderhebung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": gebotener_befund_nicht_erhoben_630h(entity_ref("urn:de:bgb:dw:t73")) { origin case_input; }
        assert "f2": befund_haette_weitere_massnahmen_veranlasst_630h(entity_ref("urn:de:bgb:dw:t73")) { origin adjudicated; }
        assert "f3": verletzung_leben_koerper_gesundheit_630h(entity_ref("urn:de:bgb:dw:t73")) { origin case_input; }
    }
    evaluate truth(behandlungsfehler_ursaechlich_630h(entity_ref("urn:de:bgb:dw:t73")));
    expect truth_status == TRUE_ONLY;
}
