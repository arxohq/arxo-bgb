language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651w Abs. 1, 4: wer getrennt ausgewählte und getrennt bezahlte Leistungen bei einem einzigen Kontakt vermittelt, ist Vermittler verbundener Reiseleistungen; erfüllt er seine Pflichten nicht, gilt das Reisevertragsrecht entsprechend.

test "urn:query:bgb-dw-t145-651w-verbundene-reiseleistungen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": reisevermittler_651v(entity_ref("urn:de:bgb:dw:t145"), entity_ref("urn:de:bgb:dw:t145:M")) { origin case_input; }
        assert "f2": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:t145"), @2026-05-01) { origin case_input; }
        assert "f3": keine_pauschalreise_bei_verbundenen_leistungen_651w(entity_ref("urn:de:bgb:dw:t145")) { origin case_input; }
        assert "f4": getrennte_auswahl_und_zahlung_651w(entity_ref("urn:de:bgb:dw:t145")) { origin case_input; }
        assert "f5": pflichten_651w_nicht_erfuellt(entity_ref("urn:de:bgb:dw:t145")) { origin case_input; }
    }
    evaluate truth(vermittler_verbundener_reiseleistungen_651w(entity_ref("urn:de:bgb:dw:t145"), entity_ref("urn:de:bgb:dw:t145:M")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(reisevertragsrecht_anwendbar_651w(entity_ref("urn:de:bgb:dw:t145")));
    expect truth_status == TRUE_ONLY;
}
