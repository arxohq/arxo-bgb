language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650l Satz 1 Halbsatz 2 Gegenprobe: der notariell beurkundete Vertrag trägt kein Widerrufsrecht. Boundary zu t108.

test "urn:query:bgb-dw-t108a-650l-notarielle-beurkundung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:t108a"), entity_ref("urn:de:bgb:dw:t108a:V")) { origin case_input; }
        assert "f2": bau_eines_neuen_gebaeudes_650i(entity_ref("urn:de:bgb:dw:t108a")) { origin case_input; }
        assert "f3": vertrag_notariell_beurkundet_650l(entity_ref("urn:de:bgb:dw:t108a")) { origin case_input; }
    }
    evaluate truth(widerrufsrecht_650l(entity_ref("urn:de:bgb:dw:t108a"), entity_ref("urn:de:bgb:dw:t108a:V")));
    expect truth_status == NEITHER;
}
