language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 626 Abs. 2: Erklärung einen Tag nach Ablauf der Zweiwochenfrist ist
// nicht mehr rechtzeitig. Boundary zu t41.

test "urn:query:bgb-dw-t42-626-frist-verspaetet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": kenntnis_erlangt_am_626(entity_ref("urn:de:bgb:dw:t42"), entity_ref("urn:de:bgb:dw:t42:K"), @2026-03-01) { origin case_input; }
        assert "f2": kuendigungserklaerung_am_626(entity_ref("urn:de:bgb:dw:t42"), entity_ref("urn:de:bgb:dw:t42:K"), @2026-03-16) { origin case_input; }
    }
    evaluate truth(kuendigung_626_innerhalb_der_frist(entity_ref("urn:de:bgb:dw:t42"), entity_ref("urn:de:bgb:dw:t42:K")));
    expect truth_status == NEITHER;
}
