language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 645 Abs. 1 Satz 1: Untergang infolge des vom Besteller gelieferten Stoffes — Teilvergütung.

test "urn:query:bgb-dw-t82-645-stoffmangel" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": untergang_infolge_stoffmangel_oder_anweisung_645(entity_ref("urn:de:bgb:dw:t82")) { origin case_input; }
        assert "f2": kein_vom_unternehmer_zu_vertretender_umstand_645(entity_ref("urn:de:bgb:dw:t82")) { origin case_input; }
        assert "f3": geleisteter_arbeit_entsprechender_teil_645(entity_ref("urn:de:bgb:dw:t82"), 3200 EUR) { origin case_input; }
    }
    evaluate truth(teilverguetungsanspruch_645(entity_ref("urn:de:bgb:dw:t82"), 3200 EUR));
    expect truth_status == TRUE_ONLY;
}
