language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 630a Abs. 1 und 630e Abs. 4.

test "urn:query:bgb-dw-positions-630a-630e-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:positions-630ae"), entity_ref("urn:de:bgb:dw:positions-630ae:A")) { origin case_input; }
        assert "f2": patient(entity_ref("urn:de:bgb:dw:positions-630ae"), entity_ref("urn:de:bgb:dw:positions-630ae:P")) { origin case_input; }
        assert "f3": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630ae"), @2026-02-01) { origin case_input; }
        assert "f4": kein_dritter_zur_zahlung_verpflichtet_630a(entity_ref("urn:de:bgb:dw:positions-630ae")) { origin case_input; }
        assert "f5": dritter_zur_zahlung_verpflichtet_630a(entity_ref("urn:de:bgb:dw:positions-630ae"), entity_ref("urn:de:bgb:dw:positions-630ae:D")) { origin case_input; }
        assert "f6": einwilligung_des_berechtigten_einzuholen_630d(entity_ref("urn:de:bgb:dw:positions-630ae"), entity_ref("urn:de:bgb:dw:positions-630ae:B")) { origin case_input; }
        assert "f7": medizinische_massnahme_geplant_630d(entity_ref("urn:de:bgb:dw:positions-630ae")) { origin case_input; }
        assert "f8": patient_einwilligungsunfaehig_630d(entity_ref("urn:de:bgb:dw:positions-630ae")) { origin case_input; }
        assert "f9": einwilligungsberechtigter_630d(entity_ref("urn:de:bgb:dw:positions-630ae"), entity_ref("urn:de:bgb:dw:positions-630ae:B")) { origin case_input; }
        assert "f10": keine_patientenverfuegung_630d(entity_ref("urn:de:bgb:dw:positions-630ae")) { origin case_input; }
    }
    evaluate positions();
    expect position(BehandlungsPflicht630a, ACTIVE);
    expect position(BehandlungsPflicht630aPosition, ACTIVE);
    expect position(BehandlungsVerguetungsPflicht630a, ACTIVE);
    expect position(BehandlungsVerguetungsPflicht630aPosition, ACTIVE);
    expect position(BehandlungsVerguetungsPflichtDritter630a, ACTIVE);
    expect position(AufklaerungDesBerechtigten630e, ACTIVE);
    expect position(AufklaerungDesBerechtigten630ePosition, ACTIVE);
    expect position(EinwilligungBerechtigter630dAbs1Satz2Position, ACTIVE);
}

test "urn:query:bgb-dw-positions-630a-630e-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied"), entity_ref("urn:de:bgb:dw:positions-630ae-satisfied:A")) { origin case_input; }
        assert "f2": patient(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied"), entity_ref("urn:de:bgb:dw:positions-630ae-satisfied:P")) { origin case_input; }
        assert "f3": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied"), @2026-02-01) { origin case_input; }
        assert "f4": kein_dritter_zur_zahlung_verpflichtet_630a(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied")) { origin case_input; }
        assert "f5": dritter_zur_zahlung_verpflichtet_630a(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied"), entity_ref("urn:de:bgb:dw:positions-630ae-satisfied:D")) { origin case_input; }
        assert "f6": einwilligung_des_berechtigten_einzuholen_630d(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied"), entity_ref("urn:de:bgb:dw:positions-630ae-satisfied:B")) { origin case_input; }
        assert "f7": medizinische_massnahme_geplant_630d(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied")) { origin case_input; }
        assert "f8": patient_einwilligungsunfaehig_630d(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied")) { origin case_input; }
        assert "f9": einwilligungsberechtigter_630d(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied"), entity_ref("urn:de:bgb:dw:positions-630ae-satisfied:B")) { origin case_input; }
        assert "f10": keine_patientenverfuegung_630d(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied")) { origin case_input; }
        assert "f11": behandlung_erbracht(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied")) { origin case_input; }
        assert "f12": behandlungsverguetung_gewaehrt(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied")) { origin case_input; }
        assert "f13": berechtigter_aufgeklaert_630e(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied"), entity_ref("urn:de:bgb:dw:positions-630ae-satisfied:B")) { origin case_input; }
        assert "f14": einwilligung_berechtigter_eingeholt_630d(entity_ref("urn:de:bgb:dw:positions-630ae-satisfied"), entity_ref("urn:de:bgb:dw:positions-630ae-satisfied:B")) { origin case_input; }
    }
    evaluate positions();
    expect position(BehandlungsPflicht630a, SATISFIED);
    expect position(BehandlungsPflicht630aPosition, SATISFIED);
    expect position(BehandlungsVerguetungsPflicht630a, SATISFIED);
    expect position(BehandlungsVerguetungsPflicht630aPosition, SATISFIED);
    expect position(BehandlungsVerguetungsPflichtDritter630a, SATISFIED);
    expect position(AufklaerungDesBerechtigten630e, SATISFIED);
    expect position(AufklaerungDesBerechtigten630ePosition, SATISFIED);
    expect position(EinwilligungBerechtigter630dAbs1Satz2Position, SATISFIED);
}
