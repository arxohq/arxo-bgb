language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 650p Abs. 1–2 und 651a Abs. 1.

test "urn:query:bgb-dw-positions-650p-651a-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": architekten_oder_ingenieurvertrag_650p(entity_ref("urn:de:bgb:dw:positions-650p")) { origin case_input; }
        assert "f2": planungs_und_ueberwachungsziele_vereinbart_650p(entity_ref("urn:de:bgb:dw:positions-650p")) { origin case_input; }
        assert "f3": planungs_und_ueberwachungsziele_nicht_vereinbart_650p(entity_ref("urn:de:bgb:dw:positions-650p")) { origin case_input; }
        assert "f4": unternehmer(entity_ref("urn:de:bgb:dw:positions-650p"), entity_ref("urn:de:bgb:dw:positions-650p:U")) { origin case_input; }
        assert "f5": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650p"), @2026-01-10) { origin case_input; }
        assert "f6": pauschalreise_651a(entity_ref("urn:de:bgb:dw:positions-651a")) { origin case_input; }
        assert "f7": reiseveranstalter(entity_ref("urn:de:bgb:dw:positions-651a"), entity_ref("urn:de:bgb:dw:positions-651a:V")) { origin case_input; }
        assert "f8": reisender(entity_ref("urn:de:bgb:dw:positions-651a"), entity_ref("urn:de:bgb:dw:positions-651a:P")) { origin case_input; }
        assert "f9": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651a"), @2026-01-10) { origin case_input; }
    }
    evaluate positions();
    expect position(ErforderlicheLeistungenErbringen650p, ACTIVE);
    expect position(PlanungsgrundlageVorlegen650p, ACTIVE);
    expect position(PauschalreiseVerschaffen651a, ACTIVE);
    expect position(ReisepreisZahlen651a, ACTIVE);
}

test "urn:query:bgb-dw-positions-650p-651a-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": architekten_oder_ingenieurvertrag_650p(entity_ref("urn:de:bgb:dw:positions-650p-satisfied")) { origin case_input; }
        assert "f2": planungs_und_ueberwachungsziele_vereinbart_650p(entity_ref("urn:de:bgb:dw:positions-650p-satisfied")) { origin case_input; }
        assert "f3": planungs_und_ueberwachungsziele_nicht_vereinbart_650p(entity_ref("urn:de:bgb:dw:positions-650p-satisfied")) { origin case_input; }
        assert "f4": unternehmer(entity_ref("urn:de:bgb:dw:positions-650p-satisfied"), entity_ref("urn:de:bgb:dw:positions-650p-satisfied:U")) { origin case_input; }
        assert "f5": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650p-satisfied"), @2026-01-10) { origin case_input; }
        assert "f6": pauschalreise_651a(entity_ref("urn:de:bgb:dw:positions-651a-satisfied")) { origin case_input; }
        assert "f7": reiseveranstalter(entity_ref("urn:de:bgb:dw:positions-651a-satisfied"), entity_ref("urn:de:bgb:dw:positions-651a-satisfied:V")) { origin case_input; }
        assert "f8": reisender(entity_ref("urn:de:bgb:dw:positions-651a-satisfied"), entity_ref("urn:de:bgb:dw:positions-651a-satisfied:P")) { origin case_input; }
        assert "f9": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651a-satisfied"), @2026-01-10) { origin case_input; }
        assert "f10": erforderliche_leistungen_erbracht_650p(entity_ref("urn:de:bgb:dw:positions-650p-satisfied")) { origin case_input; }
        assert "f11": planungsgrundlage_mit_kosteneinschaetzung_vorgelegt_650p(entity_ref("urn:de:bgb:dw:positions-650p-satisfied")) { origin case_input; }
        assert "f12": pauschalreise_verschafft(entity_ref("urn:de:bgb:dw:positions-651a-satisfied")) { origin case_input; }
        assert "f13": reisepreis_gezahlt(entity_ref("urn:de:bgb:dw:positions-651a-satisfied")) { origin case_input; }
    }
    evaluate positions();
    expect position(ErforderlicheLeistungenErbringen650p, SATISFIED);
    expect position(PlanungsgrundlageVorlegen650p, SATISFIED);
    expect position(PauschalreiseVerschaffen651a, SATISFIED);
    expect position(ReisepreisZahlen651a, SATISFIED);
}
