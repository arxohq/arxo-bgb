language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 611a Abs. 1, 2: das Gericht bejaht die Gesamtbetrachtung — Arbeitsvertrag,
// Arbeitnehmer und Arbeitgeber werden zugeordnet.

test "urn:query:bgb-dw-t03-611a-bejaht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverpflichteter(entity_ref("urn:de:bgb:dw:t03"), entity_ref("urn:de:bgb:dw:t03:AN")) { origin case_input; }
        assert "f2": dienstberechtigter(entity_ref("urn:de:bgb:dw:t03"), entity_ref("urn:de:bgb:dw:t03:AG")) { origin case_input; }
        assert "f3": arbeitsvertrag_gesamtbetrachtung(entity_ref("urn:de:bgb:dw:t03")) { origin adjudicated; }
    }
    evaluate truth(arbeitsverhaeltnis(entity_ref("urn:de:bgb:dw:t03")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(arbeitnehmer(entity_ref("urn:de:bgb:dw:t03"), entity_ref("urn:de:bgb:dw:t03:AN")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(arbeitgeber(entity_ref("urn:de:bgb:dw:t03"), entity_ref("urn:de:bgb:dw:t03:AG")));
    expect truth_status == TRUE_ONLY;
}
