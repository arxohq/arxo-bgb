language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650f Abs. 5 Satz 3: nach der Kündigung wegen fehlender Sicherheit werden 5 Prozent des nicht erbrachten Teils vermutet — 40 000 EUR ergeben 2 000,00 EUR.

test "urn:query:bgb-dw-t103-650f-fuenf-prozent" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": kuendigung_wegen_fehlender_sicherheit_650f(entity_ref("urn:de:bgb:dw:t103")) { origin case_input; }
        assert "f2": verguetung_fuer_nicht_erbrachten_teil_648(entity_ref("urn:de:bgb:dw:t103"), 40000 EUR) { origin case_input; }
    }
    evaluate truth(verguetungsanspruch_nach_kuendigung_650f(entity_ref("urn:de:bgb:dw:t103"), 2000.00 EUR));
    expect truth_status == TRUE_ONLY;
}
