language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630h Abs. 1 Gegenbeweis: der Behandelnde beweist, dass ihm kein Fehler unterlaufen ist. Boundary zu t65.

test "urn:query:bgb-dw-t66-630h-abs1-gegenbeweis" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": allgemeines_behandlungsrisiko_verwirklicht_630h(entity_ref("urn:de:bgb:dw:t66")) { origin case_input; }
        assert "f2": risiko_voll_beherrschbar_630h(entity_ref("urn:de:bgb:dw:t66")) { origin adjudicated; }
        assert "f3": verletzung_leben_koerper_gesundheit_630h(entity_ref("urn:de:bgb:dw:t66")) { origin case_input; }
        assert "f4": gegenbeweis_kein_behandlungsfehler_630h(entity_ref("urn:de:bgb:dw:t66")) { origin case_input; }
    }
    evaluate truth(behandlungsfehler(entity_ref("urn:de:bgb:dw:t66")));
    expect truth_status == FALSE_ONLY;
}
