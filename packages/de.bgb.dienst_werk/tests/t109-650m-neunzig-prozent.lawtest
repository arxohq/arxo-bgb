language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650m Abs. 1, 2 Satz 1, Abs. 4: Gesamtvergütung 300 000 EUR — Abschläge höchstens 270 000,00 EUR, Sicherheit 15 000,00 EUR, Verbrauchersicherheit höchstens 60 000,00 EUR.

test "urn:query:bgb-dw-t109-650m-neunzig-prozent" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:t109"), entity_ref("urn:de:bgb:dw:t109:V")) { origin case_input; }
        assert "f2": bau_eines_neuen_gebaeudes_650i(entity_ref("urn:de:bgb:dw:t109")) { origin case_input; }
        assert "f3": abschlagszahlungen_verlangt_650m(entity_ref("urn:de:bgb:dw:t109")) { origin case_input; }
        assert "f4": vereinbarte_gesamtverguetung_650m(entity_ref("urn:de:bgb:dw:t109"), 300000 EUR) { origin case_input; }
    }
    evaluate truth(hoechstbetrag_der_abschlagszahlungen_650m(entity_ref("urn:de:bgb:dw:t109"), 270000.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(sicherheit_fuer_rechtzeitige_herstellung_650m(entity_ref("urn:de:bgb:dw:t109"), 15000.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(hoechstbetrag_der_verbrauchersicherheit_650m(entity_ref("urn:de:bgb:dw:t109"), 60000.00 EUR));
    expect truth_status == TRUE_ONLY;
}
