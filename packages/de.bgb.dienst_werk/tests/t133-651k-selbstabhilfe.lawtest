language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651k Abs. 2: bleibt die Abhilfe innerhalb der angemessenen Frist aus, kann der Reisende selbst Abhilfe schaffen und Ersatz der Aufwendungen verlangen.

test "urn:query:bgb-dw-t133-651k-selbstabhilfe" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t133")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t133")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t133")) { origin case_input; }
        assert "f4": not vereinbarte_beschaffenheit_der_reise_651i(entity_ref("urn:de:bgb:dw:t133")) { origin case_input; }
        assert "f5": abhilfefrist_ablauf_651k(entity_ref("urn:de:bgb:dw:t133"), @2026-06-25) { origin case_input; }
        assert "f6": abhilfefrist_angemessen_651k(entity_ref("urn:de:bgb:dw:t133")) { origin adjudicated; }
        assert "f7": abhilfe_bis_fristablauf_ausgeblieben_651k(entity_ref("urn:de:bgb:dw:t133")) { origin case_input; }
        assert "f8": abhilfe_nicht_verweigerbar_651k(entity_ref("urn:de:bgb:dw:t133")) { origin case_input; }
    }
    evaluate truth(selbstabhilferecht_651k(entity_ref("urn:de:bgb:dw:t133")));
    expect truth_status == TRUE_ONLY;
}
