language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// Korridor 2018 (Art. 229 § 39 EGBGB): vor dem 1. Januar 2018 schweigt das Kapitel 2 — derselbe Sachverhalt wie t99 mit legal_time 31. Dezember 2017. Boundary zu t99.

test "urn:query:bgb-dw-t99a-650a-korridor-2017" {
    given {
        context { legal_time @2017-12-31; decision_time @2017-12-31T09:00:00Z; knowledge_time @2017-12-31T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:t99a")) { origin case_input; }
    }
    evaluate truth(bauvertrag_650a(entity_ref("urn:de:bgb:dw:t99a")));
    expect truth_status == NEITHER;
}
