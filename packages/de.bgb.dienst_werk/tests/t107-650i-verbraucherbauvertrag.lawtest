language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650i Abs. 1, 2: Bau eines neuen Gebäudes für einen Verbraucher, in Textform geschlossen.

test "urn:query:bgb-dw-t107-650i-verbraucherbauvertrag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:t107"), entity_ref("urn:de:bgb:dw:t107:V")) { origin case_input; }
        assert "f2": bau_eines_neuen_gebaeudes_650i(entity_ref("urn:de:bgb:dw:t107")) { origin case_input; }
        assert "f3": vertrag_in_textform_650i(entity_ref("urn:de:bgb:dw:t107")) { origin case_input; }
    }
    evaluate truth(verbraucherbauvertrag_650i(entity_ref("urn:de:bgb:dw:t107")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(textform_650i_gewahrt(entity_ref("urn:de:bgb:dw:t107")));
    expect truth_status == TRUE_ONLY;
}
