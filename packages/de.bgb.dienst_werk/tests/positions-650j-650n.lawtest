language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 650j, 650n: Baubeschreibung und Herausgabe der Planungs- und Nachweisunterlagen.

test "urn:query:bgb-dw-positions-650j-650n-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:positions-650j-650n"), entity_ref("urn:de:bgb:dw:positions-650j-650n:V")) { origin case_input; }
        assert "f2": bau_eines_neuen_gebaeudes_650i(entity_ref("urn:de:bgb:dw:positions-650j-650n")) { origin case_input; }
        assert "f3": vertrag_in_textform_650i(entity_ref("urn:de:bgb:dw:positions-650j-650n")) { origin case_input; }
        assert "f4": unternehmer(entity_ref("urn:de:bgb:dw:positions-650j-650n"), entity_ref("urn:de:bgb:dw:positions-650j-650n:U")) { origin case_input; }
        assert "f5": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650j-650n"), @2026-02-01) { origin case_input; }
        assert "f6": planungsvorgaben_nicht_vom_verbraucher_650j(entity_ref("urn:de:bgb:dw:positions-650j-650n")) { origin case_input; }
        assert "f7": baubeschreibung_vorvertraglich_zur_verfuegung_gestellt_650k(entity_ref("urn:de:bgb:dw:positions-650j-650n")) { origin case_input; }
        assert "f8": keine_verbindliche_angabe_zur_fertigstellung_650k(entity_ref("urn:de:bgb:dw:positions-650j-650n")) { origin case_input; }
    }
    evaluate positions();
    expect position(BaubeschreibungUnterrichten650j, ACTIVE);
    expect position(BaubeschreibungUnterrichten650jPosition, ACTIVE);
    expect position(FertigstellungsangabeVertragsinhalt650kAbs3Position, ACTIVE);
    expect position(PlanungsunterlagenHerausgeben650n, ACTIVE);
    expect position(NachweisunterlagenHerausgeben650n, ACTIVE);
}

test "urn:query:bgb-dw-positions-650j-650n-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied"), entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied:V")) { origin case_input; }
        assert "f2": bau_eines_neuen_gebaeudes_650i(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied")) { origin case_input; }
        assert "f3": vertrag_in_textform_650i(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied")) { origin case_input; }
        assert "f4": unternehmer(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied"), entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied:U")) { origin case_input; }
        assert "f5": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied"), @2026-02-01) { origin case_input; }
        assert "f6": planungsvorgaben_nicht_vom_verbraucher_650j(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied")) { origin case_input; }
        assert "f7": ueber_baubeschreibung_unterrichtet_650j(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied")) { origin case_input; }
        assert "f8": planungsunterlagen_herausgegeben_650n(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied")) { origin case_input; }
        assert "f9": nachweisunterlagen_herausgegeben_650n(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied")) { origin case_input; }
        assert "f10": baubeschreibung_vorvertraglich_zur_verfuegung_gestellt_650k(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied")) { origin case_input; }
        assert "f11": keine_verbindliche_angabe_zur_fertigstellung_650k(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied")) { origin case_input; }
        assert "f12": fertigstellungsangabe_uebernommen_650k(entity_ref("urn:de:bgb:dw:positions-650j-650n-satisfied")) { origin case_input; }
    }
    evaluate positions();
    expect position(BaubeschreibungUnterrichten650j, SATISFIED);
    expect position(BaubeschreibungUnterrichten650jPosition, SATISFIED);
    expect position(FertigstellungsangabeVertragsinhalt650kAbs3Position, ACTIVE);
    expect position(PlanungsunterlagenHerausgeben650n, SATISFIED);
    expect position(NachweisunterlagenHerausgeben650n, SATISFIED);
}
