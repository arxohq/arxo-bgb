language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650l Satz 1, 2: ohne notarielle Beurkundung steht dem Verbraucher das Widerrufsrecht gemäß § 355 zu; der Unternehmer hat zu belehren.

test "urn:query:bgb-dw-t108-650l-widerrufsrecht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:t108"), entity_ref("urn:de:bgb:dw:t108:V")) { origin case_input; }
        assert "f2": bau_eines_neuen_gebaeudes_650i(entity_ref("urn:de:bgb:dw:t108")) { origin case_input; }
        assert "f3": vertrag_nicht_notariell_beurkundet_650l(entity_ref("urn:de:bgb:dw:t108")) { origin case_input; }
        assert "f4": unternehmer(entity_ref("urn:de:bgb:dw:t108"), entity_ref("urn:de:bgb:dw:t108:U")) { origin case_input; }
        assert "f5": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:t108"), @2026-02-01) { origin case_input; }
    }
    evaluate truth(widerrufsrecht_650l(entity_ref("urn:de:bgb:dw:t108"), entity_ref("urn:de:bgb:dw:t108:V")));
    expect truth_status == TRUE_ONLY;
    evaluate positions();
    expect position(WiderrufsbelehrungErteilen650l, ACTIVE);
    expect position(Widerrufsbelehrung650lSatz2Position, ACTIVE);
}
