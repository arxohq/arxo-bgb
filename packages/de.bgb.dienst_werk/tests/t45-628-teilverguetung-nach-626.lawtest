language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 628 Abs. 1 Satz 1: Teilvergütung nach fristloser Kündigung gemäß § 626.

test "urn:query:bgb-dw-t45-628-teilverguetung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstleistung_begonnen_628(entity_ref("urn:de:bgb:dw:t45")) { origin case_input; }
        assert "f2": wichtiger_grund_626(entity_ref("urn:de:bgb:dw:t45"), entity_ref("urn:de:bgb:dw:t45:K")) { origin adjudicated; }
        assert "f3": bisherige_leistungen_anteil(entity_ref("urn:de:bgb:dw:t45"), 1500 EUR) { origin case_input; }
    }
    evaluate truth(teilverguetungsanspruch_628(entity_ref("urn:de:bgb:dw:t45"), 1500 EUR));
    expect truth_status == TRUE_ONLY;
}
