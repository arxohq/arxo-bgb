language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651k Abs. 4: ist die Rückbeförderung aufgrund unvermeidbarer, außergewöhnlicher Umstände nicht möglich, trägt der Veranstalter die Beherbergungskosten für höchstens drei Nächte.

test "urn:query:bgb-dw-t134-651k-drei-naechte" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": rueckbefoerderung_wegen_umstaenden_unmoeglich_651k(entity_ref("urn:de:bgb:dw:t134")) { origin case_input; }
        assert "f2": kein_fall_des_651k_abs5(entity_ref("urn:de:bgb:dw:t134")) { origin case_input; }
    }
    evaluate truth(kostentragung_beherbergung_drei_naechte_651k(entity_ref("urn:de:bgb:dw:t134")));
    expect truth_status == TRUE_ONLY;
}
