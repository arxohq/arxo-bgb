language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 620 Abs. 1: das befristete Dienstverhältnis endet mit Zeitablauf.

test "urn:query:bgb-dw-t23-620-befristung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverhaeltnis_befristet(entity_ref("urn:de:bgb:dw:t23")) { origin case_input; }
        assert "f2": befristung_ablauf_am(entity_ref("urn:de:bgb:dw:t23"), @2026-12-31) { origin case_input; }
    }
    evaluate truth(dienstverhaeltnis_beendet_am(entity_ref("urn:de:bgb:dw:t23"), @2026-12-31));
    expect truth_status == TRUE_ONLY;
}
