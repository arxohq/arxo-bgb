language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650b Abs. 2 Satz 1 Gegenprobe: eine Anordnung am letzten Tag der Frist ist noch nicht zulässig. Boundary zu t100.

test "urn:query:bgb-dw-t100a-650b-anordnung-zu-frueh" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:t100a")) { origin case_input; }
        assert "f2": aenderungsbegehren_zugegangen_am_650b(entity_ref("urn:de:bgb:dw:t100a"), @2026-02-02) { origin case_input; }
        assert "f3": keine_einigung_bis_fristablauf_650b(entity_ref("urn:de:bgb:dw:t100a")) { origin case_input; }
        assert "f4": anordnung_in_textform_650b(entity_ref("urn:de:bgb:dw:t100a"), @2026-03-04) { origin case_input; }
    }
    evaluate truth(anordnungsrecht_650b(entity_ref("urn:de:bgb:dw:t100a")));
    expect truth_status == NEITHER;
}
