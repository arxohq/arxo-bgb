language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 619a: der Arbeitnehmer haftet nur, wenn er die Pflichtverletzung zu
// vertreten hat.

test "urn:query:bgb-dw-t22-619a-ersatzpflicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverpflichteter(entity_ref("urn:de:bgb:dw:t22"), entity_ref("urn:de:bgb:dw:t22:AN")) { origin case_input; }
        assert "f2": dienstberechtigter(entity_ref("urn:de:bgb:dw:t22"), entity_ref("urn:de:bgb:dw:t22:AG")) { origin case_input; }
        assert "f3": arbeitsvertrag_gesamtbetrachtung(entity_ref("urn:de:bgb:dw:t22")) { origin adjudicated; }
        assert "f4": pflichtverletzung_durch_arbeitnehmer(entity_ref("urn:de:bgb:dw:t22"), entity_ref("urn:de:bgb:dw:t22:AN")) { origin adjudicated; }
        assert "f5": vertretenmuessen_der_pflichtverletzung(entity_ref("urn:de:bgb:dw:t22"), entity_ref("urn:de:bgb:dw:t22:AN")) { origin adjudicated; }
    }
    evaluate truth(ersatzpflicht_619a(entity_ref("urn:de:bgb:dw:t22"), entity_ref("urn:de:bgb:dw:t22:AN")));
    expect truth_status == TRUE_ONLY;
}
