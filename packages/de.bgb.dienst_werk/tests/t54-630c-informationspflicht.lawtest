language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630c Abs. 2 Satz 1: Erläuterung sämtlicher wesentlicher Umstände; die Information ist nicht entbehrlich.

test "urn:query:bgb-dw-t54-630c-informationspflicht" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:t54"), entity_ref("urn:de:bgb:dw:t54:A")) { origin case_input; }
        assert "f2": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:t54"), @2026-01-10) { origin case_input; }
        assert "f3": informationspflicht_nicht_entbehrlich_630c(entity_ref("urn:de:bgb:dw:t54")) { origin case_input; }
    }
    evaluate positions();
    expect position(InformationsPflicht630c, ACTIVE);
}
