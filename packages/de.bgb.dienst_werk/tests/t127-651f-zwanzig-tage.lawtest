language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651f Abs. 1: Unterrichtung über die Preiserhöhung am 20. Mai 2026, Reisebeginn am 20. Juni — der zwanzigste Tag (9. Juni) liegt vor dem Reisebeginn, die Erhöhung ist wirksam.

test "urn:query:bgb-dw-t127-651f-zwanzig-tage" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": preiserhoehungsvorbehalt_im_vertrag_651f(entity_ref("urn:de:bgb:dw:t127")) { origin case_input; }
        assert "f2": erhoehungsgrund_651f(entity_ref("urn:de:bgb:dw:t127")) { origin case_input; }
        assert "f3": unterrichtung_ueber_preiserhoehung_am_651f(entity_ref("urn:de:bgb:dw:t127"), @2026-05-20) { origin case_input; }
        assert "f4": reisebeginn_am(entity_ref("urn:de:bgb:dw:t127"), @2026-06-20) { origin case_input; }
    }
    evaluate truth(unterrichtung_plus_zwanzig_tage_651f(entity_ref("urn:de:bgb:dw:t127"), @2026-06-09));
    expect truth_status == TRUE_ONLY;
    evaluate truth(preiserhoehung_wirksam_651f(entity_ref("urn:de:bgb:dw:t127")));
    expect truth_status == TRUE_ONLY;
}
