language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651r Abs. 1, 4 und § 651t: im Fall der Zahlungsunfähigkeit hat der Reisende einen unmittelbaren Anspruch gegen den Absicherer; benannt ist er auch Voraussetzung der Vorauszahlung.

test "urn:query:bgb-dw-t141-651r-insolvenzsicherung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t141")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t141")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t141")) { origin case_input; }
        assert "f4": zahlungsunfaehigkeit_des_veranstalters_651r(entity_ref("urn:de:bgb:dw:t141")) { origin case_input; }
        assert "f5": reiseleistungen_fallen_aus_651r(entity_ref("urn:de:bgb:dw:t141")) { origin case_input; }
        assert "f6": absicherungsvertrag_besteht_651r(entity_ref("urn:de:bgb:dw:t141")) { origin case_input; }
        assert "f7": absicherer_benannt_651t(entity_ref("urn:de:bgb:dw:t141")) { origin case_input; }
    }
    evaluate truth(erstattungsanspruch_gegen_absicherer_651r(entity_ref("urn:de:bgb:dw:t141")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vorauszahlung_zulaessig_651t(entity_ref("urn:de:bgb:dw:t141")));
    expect truth_status == TRUE_ONLY;
}
