language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 632 Abs. 3: ein Kostenanschlag ist im Zweifel nicht zu vergüten.

test "urn:query:bgb-dw-t76-632-kostenanschlag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": kostenanschlag_erstellt(entity_ref("urn:de:bgb:dw:t76")) { origin case_input; }
        assert "f2": keine_abweichende_vereinbarung_632(entity_ref("urn:de:bgb:dw:t76")) { origin case_input; }
    }
    evaluate truth(kostenanschlag_nicht_zu_verguetenden(entity_ref("urn:de:bgb:dw:t76")));
    expect truth_status == TRUE_ONLY;
}
