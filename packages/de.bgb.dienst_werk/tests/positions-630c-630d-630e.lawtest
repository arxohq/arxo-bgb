language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 630c Abs. 3, 630d Abs. 1 und 630e Abs. 2 Satz 2.

test "urn:query:bgb-dw-positions-630c-630d-630e-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:positions-630cde"), entity_ref("urn:de:bgb:dw:positions-630cde:A")) { origin case_input; }
        assert "f2": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630cde"), @2026-02-01) { origin case_input; }
        assert "f3": behandlungsvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-630cde"), @2026-01-10) { origin case_input; }
        assert "f4": kostenuebernahme_durch_dritten_nicht_gesichert_630c(entity_ref("urn:de:bgb:dw:positions-630cde")) { origin case_input; }
        assert "f5": hinreichende_anhaltspunkte_fuer_ungesicherte_kostenuebernahme_630c(entity_ref("urn:de:bgb:dw:positions-630cde")) { origin case_input; }
        assert "f6": medizinische_massnahme_geplant_630d(entity_ref("urn:de:bgb:dw:positions-630cde")) { origin case_input; }
        assert "f7": patient_einwilligungsfaehig_630d(entity_ref("urn:de:bgb:dw:positions-630cde")) { origin case_input; }
        assert "f8": unterlagen_unterzeichnet_630e(entity_ref("urn:de:bgb:dw:positions-630cde")) { origin case_input; }
    }
    evaluate positions();
    expect position(KosteninformationsPflicht630c, ACTIVE);
    expect position(KosteninformationsPflichtAnhaltspunkte630c, ACTIVE);
    expect position(EinwilligungEinholen630d, ACTIVE);
    expect position(AbschriftenAushaendigen630e, ACTIVE);
}

test "urn:query:bgb-dw-positions-630c-630d-630e-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:positions-630cde-satisfied"), entity_ref("urn:de:bgb:dw:positions-630cde-satisfied:A")) { origin case_input; }
        assert "f2": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630cde-satisfied"), @2026-02-01) { origin case_input; }
        assert "f3": behandlungsvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-630cde-satisfied"), @2026-01-10) { origin case_input; }
        assert "f4": kostenuebernahme_durch_dritten_nicht_gesichert_630c(entity_ref("urn:de:bgb:dw:positions-630cde-satisfied")) { origin case_input; }
        assert "f5": hinreichende_anhaltspunkte_fuer_ungesicherte_kostenuebernahme_630c(entity_ref("urn:de:bgb:dw:positions-630cde-satisfied")) { origin case_input; }
        assert "f6": medizinische_massnahme_geplant_630d(entity_ref("urn:de:bgb:dw:positions-630cde-satisfied")) { origin case_input; }
        assert "f7": patient_einwilligungsfaehig_630d(entity_ref("urn:de:bgb:dw:positions-630cde-satisfied")) { origin case_input; }
        assert "f8": unterlagen_unterzeichnet_630e(entity_ref("urn:de:bgb:dw:positions-630cde-satisfied")) { origin case_input; }
        assert "f9": ueber_voraussichtliche_kosten_in_textform_informiert_630c(entity_ref("urn:de:bgb:dw:positions-630cde-satisfied")) { origin case_input; }
        assert "f10": einwilligung_eingeholt_630d(entity_ref("urn:de:bgb:dw:positions-630cde-satisfied")) { origin case_input; }
        assert "f11": abschriften_ausgehaendigt_630e(entity_ref("urn:de:bgb:dw:positions-630cde-satisfied")) { origin case_input; }
    }
    evaluate positions();
    expect position(KosteninformationsPflicht630c, SATISFIED);
    expect position(KosteninformationsPflichtAnhaltspunkte630c, SATISFIED);
    expect position(EinwilligungEinholen630d, SATISFIED);
    expect position(AbschriftenAushaendigen630e, SATISFIED);
}
