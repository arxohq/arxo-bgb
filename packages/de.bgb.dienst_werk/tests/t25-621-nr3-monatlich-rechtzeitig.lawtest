language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 621 Nr. 3: Kündigung am 15. für den Schluss desselben Kalendermonats.
// Boundary zu t26 (einen Tag später).

test "urn:query:bgb-dw-t25-621-monatlich-rechtzeitig" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f0": kein_arbeitsverhaeltnis_im_sinne_des_622(entity_ref("urn:de:bgb:dw:t25")) { origin case_input; }
        assert "f1": dienstverhaeltnis_unbestimmte_dauer(entity_ref("urn:de:bgb:dw:t25")) { origin case_input; }
        assert "f2": verguetung_nach_monaten_bemessen_621(entity_ref("urn:de:bgb:dw:t25")) { origin case_input; }
        assert "f3": kuendigungserklaerung_am(entity_ref("urn:de:bgb:dw:t25"), @2026-03-15) { origin case_input; }
    }
    evaluate truth(kuendigungstermin_621(entity_ref("urn:de:bgb:dw:t25"), @2026-03-31));
    expect truth_status == TRUE_ONLY;
}
