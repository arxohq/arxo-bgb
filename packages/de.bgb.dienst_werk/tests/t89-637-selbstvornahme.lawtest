language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 637 Abs. 1, 3: nach erfolglosem Ablauf der angemessenen Nacherfüllungsfrist kann der Besteller selbst beseitigen und Vorschuss verlangen.

test "urn:query:bgb-dw-t89-637-selbstvornahme" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": beschaffenheit_vereinbart_633(entity_ref("urn:de:bgb:dw:t89")) { origin case_input; }
        assert "f2": not vereinbarte_beschaffenheit_erfuellt_633(entity_ref("urn:de:bgb:dw:t89")) { origin case_input; }
        assert "f3": nacherfuellungsfrist_ablauf_637(entity_ref("urn:de:bgb:dw:t89"), @2026-05-31) { origin case_input; }
        assert "f4": nacherfuellungsfrist_angemessen_637(entity_ref("urn:de:bgb:dw:t89")) { origin adjudicated; }
        assert "f5": nacherfuellung_bis_fristablauf_ausgeblieben_637(entity_ref("urn:de:bgb:dw:t89")) { origin case_input; }
        assert "f6": nacherfuellung_nicht_zu_recht_verweigert_637(entity_ref("urn:de:bgb:dw:t89")) { origin case_input; }
    }
    evaluate truth(selbstvornahmerecht_637(entity_ref("urn:de:bgb:dw:t89")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vorschussanspruch_637(entity_ref("urn:de:bgb:dw:t89")));
    expect truth_status == TRUE_ONLY;
}
