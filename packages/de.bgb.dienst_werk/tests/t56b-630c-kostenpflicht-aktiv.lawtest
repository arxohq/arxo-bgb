language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630c Abs. 3 Satz 1: weiß der Behandelnde um die ungesicherte Kostenübernahme, trifft ihn die Informationspflicht in Textform.

test "urn:query:bgb-dw-t56b-630c-kostenpflicht-aktiv" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:t56b"), entity_ref("urn:de:bgb:dw:t56b:A")) { origin case_input; }
        assert "f2": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:t56b"), @2026-01-10) { origin case_input; }
        assert "f3": behandlungsvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:t56b"), @2026-01-02) { origin case_input; }
        assert "f4": kostenuebernahme_durch_dritten_nicht_gesichert_630c(entity_ref("urn:de:bgb:dw:t56b")) { origin adjudicated; }
    }
    evaluate positions();
    expect position(KosteninformationsPflicht630c, ACTIVE);
}
