language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 613: im Zweifel persönliche Leistungspflicht und Unübertragbarkeit des
// Anspruchs.

test "urn:query:bgb-dw-t09-613-unuebertragbar" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": keine_abweichende_vereinbarung_613(entity_ref("urn:de:bgb:dw:t09")) { origin case_input; }
        assert "f2": dienstverpflichteter(entity_ref("urn:de:bgb:dw:t09"), entity_ref("urn:de:bgb:dw:t09:V")) { origin case_input; }
        assert "f3": dienstberechtigter(entity_ref("urn:de:bgb:dw:t09"), entity_ref("urn:de:bgb:dw:t09:B")) { origin case_input; }
        assert "f4": dienstbeginn_am(entity_ref("urn:de:bgb:dw:t09"), @2026-01-01) { origin case_input; }
    }
    evaluate truth(persoenliche_leistungspflicht(entity_ref("urn:de:bgb:dw:t09")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anspruch_auf_dienste_unuebertragbar(entity_ref("urn:de:bgb:dw:t09")));
    expect truth_status == TRUE_ONLY;
    evaluate positions();
    expect position(Unuebertragbarkeit613Satz2Position, ACTIVE);
}

test "urn:query:bgb-dw-t09-613-unuebertragbar-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": keine_abweichende_vereinbarung_613(entity_ref("urn:de:bgb:dw:t09-satisfied")) { origin case_input; }
        assert "f2": dienstverpflichteter(entity_ref("urn:de:bgb:dw:t09-satisfied"), entity_ref("urn:de:bgb:dw:t09-satisfied:V")) { origin case_input; }
        assert "f3": dienstberechtigter(entity_ref("urn:de:bgb:dw:t09-satisfied"), entity_ref("urn:de:bgb:dw:t09-satisfied:B")) { origin case_input; }
        assert "f4": dienstbeginn_am(entity_ref("urn:de:bgb:dw:t09-satisfied"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(Unuebertragbarkeit613Satz2Position, ACTIVE);
}

test "urn:query:bgb-dw-t09-613-unuebertragbar-violated" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": keine_abweichende_vereinbarung_613(entity_ref("urn:de:bgb:dw:t09-violated")) { origin case_input; }
        assert "f2": dienstverpflichteter(entity_ref("urn:de:bgb:dw:t09-violated"), entity_ref("urn:de:bgb:dw:t09-violated:V")) { origin case_input; }
        assert "f3": dienstberechtigter(entity_ref("urn:de:bgb:dw:t09-violated"), entity_ref("urn:de:bgb:dw:t09-violated:B")) { origin case_input; }
        assert "f4": dienstbeginn_am(entity_ref("urn:de:bgb:dw:t09-violated"), @2026-01-01) { origin case_input; }
        assert "f5": anspruch_auf_dienste_uebertragen_613(entity_ref("urn:de:bgb:dw:t09-violated"), entity_ref("urn:de:bgb:dw:t09-violated:B"), entity_ref("urn:de:bgb:dw:t09-violated:V")) { origin case_input; }
    }
    evaluate positions();
    expect position(Unuebertragbarkeit613Satz2Position, VIOLATED);
}
