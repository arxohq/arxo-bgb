language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630f Abs. 3 Gegenprobe: der Tag davor ist nicht der letzte Tag der Zehnjahresfrist. Boundary zu t60.

test "urn:query:bgb-dw-t61-630f-aufbewahrung-grenze" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandlung_abgeschlossen_am_630f(entity_ref("urn:de:bgb:dw:t61"), @2026-03-15) { origin case_input; }
        assert "f2": keine_andere_aufbewahrungsfrist_630f(entity_ref("urn:de:bgb:dw:t61")) { origin case_input; }
    }
    evaluate truth(aufbewahrungsfrist_ende_630f(entity_ref("urn:de:bgb:dw:t61"), @2036-03-14));
    expect truth_status == NEITHER;
}
