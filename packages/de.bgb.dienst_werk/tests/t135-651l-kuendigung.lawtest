language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651l Abs. 1, 3: bei erheblicher Beeinträchtigung und fruchtlosem Fristablauf kann der Reisende kündigen; die Mehrkosten der Rückbeförderung fallen dem Veranstalter zur Last.

test "urn:query:bgb-dw-t135-651l-kuendigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t135")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t135")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t135")) { origin case_input; }
        assert "f4": not vereinbarte_beschaffenheit_der_reise_651i(entity_ref("urn:de:bgb:dw:t135")) { origin case_input; }
        assert "f5": reise_erheblich_beeintraechtigt_651l(entity_ref("urn:de:bgb:dw:t135")) { origin adjudicated; }
        assert "f6": abhilfefrist_ablauf_651k(entity_ref("urn:de:bgb:dw:t135"), @2026-06-25) { origin case_input; }
        assert "f7": abhilfefrist_angemessen_651k(entity_ref("urn:de:bgb:dw:t135")) { origin adjudicated; }
        assert "f8": abhilfe_bis_fristablauf_ausgeblieben_651k(entity_ref("urn:de:bgb:dw:t135")) { origin case_input; }
        assert "f9": reisevertrag_gekuendigt_651l(entity_ref("urn:de:bgb:dw:t135")) { origin case_input; }
    }
    evaluate truth(kuendigung_651l_zulaessig(entity_ref("urn:de:bgb:dw:t135")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(mehrkosten_der_rueckbefoerderung_beim_veranstalter_651l(entity_ref("urn:de:bgb:dw:t135")));
    expect truth_status == TRUE_ONLY;
}
