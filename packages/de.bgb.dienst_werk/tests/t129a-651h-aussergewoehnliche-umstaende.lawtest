language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651h Abs. 3: bei unvermeidbaren, außergewöhnlichen Umständen am Bestimmungsort kann der Veranstalter keine Entschädigung verlangen. Boundary zu t129.

test "urn:query:bgb-dw-t129a-651h-aussergewoehnliche-umstaende" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t129a")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t129a")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t129a")) { origin case_input; }
        assert "f4": ruecktritt_des_reisenden_am_651h(entity_ref("urn:de:bgb:dw:t129a"), @2026-06-01) { origin case_input; }
        assert "f5": reisebeginn_am(entity_ref("urn:de:bgb:dw:t129a"), @2026-06-20) { origin case_input; }
        assert "f6": unvermeidbare_aussergewoehnliche_umstaende_651h(entity_ref("urn:de:bgb:dw:t129a")) { origin adjudicated; }
    }
    evaluate truth(kein_entschaedigungsanspruch_651h(entity_ref("urn:de:bgb:dw:t129a")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(entschaedigungsanspruch_651h(entity_ref("urn:de:bgb:dw:t129a")));
    expect truth_status == NEITHER;
}
