language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 634a Abs. 1 Nr. 1, Abs. 2: zwei Jahre ab Abnahme bei einem sachbezogenen Werk — Abnahme am 15. März 2024, Ablauf mit dem 15. März 2026.

test "urn:query:bgb-dw-t96-634a-zwei-jahre" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": werkmaengelanspruch(entity_ref("urn:de:bgb:dw:t96:A"), entity_ref("urn:de:bgb:dw:t96")) { origin case_input; }
        assert "f2": werk_ist_sachbezogen_634a(entity_ref("urn:de:bgb:dw:t96")) { origin case_input; }
        assert "f3": not werk_ist_bauwerksbezogen_634a(entity_ref("urn:de:bgb:dw:t96")) { origin case_input; }
        assert "f4": abnahme_am(entity_ref("urn:de:bgb:dw:t96"), @2024-03-15) { origin case_input; }
        assert "f5": kein_arglistiges_verschweigen_634a(entity_ref("urn:de:bgb:dw:t96")) { origin case_input; }
    }
    evaluate truth(frist_ende_634a(entity_ref("urn:de:bgb:dw:t96:A"), @2026-03-15));
    expect truth_status == TRUE_ONLY;
    evaluate truth(frist_ende_634a(entity_ref("urn:de:bgb:dw:t96:A"), @2029-03-15));
    expect truth_status == NEITHER;
}
