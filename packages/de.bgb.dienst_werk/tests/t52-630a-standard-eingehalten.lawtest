language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630a Abs. 2 Gegenprobe: der Standard ist eingehalten — kein Behandlungsfehler. Boundary zu t51.

test "urn:query:bgb-dw-t52-630a-standard-eingehalten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": keine_abweichende_standardvereinbarung_630a(entity_ref("urn:de:bgb:dw:t52")) { origin case_input; }
        assert "f2": behandlung_entspricht_anerkanntem_standard(entity_ref("urn:de:bgb:dw:t52")) { origin adjudicated; }
    }
    evaluate truth(behandlungsfehler(entity_ref("urn:de:bgb:dw:t52")));
    expect truth_status == NEITHER;
}
