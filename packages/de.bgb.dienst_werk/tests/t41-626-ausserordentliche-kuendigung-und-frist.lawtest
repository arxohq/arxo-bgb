language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 626 Abs. 1, 2: wichtiger Grund erlaubt die fristlose Kündigung; die
// Erklärung am letzten Tag der Zweiwochenfrist ist noch rechtzeitig.

test "urn:query:bgb-dw-t41-626-frist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": wichtiger_grund_626(entity_ref("urn:de:bgb:dw:t41"), entity_ref("urn:de:bgb:dw:t41:K")) { origin adjudicated; }
        assert "f2": kenntnis_erlangt_am_626(entity_ref("urn:de:bgb:dw:t41"), entity_ref("urn:de:bgb:dw:t41:K"), @2026-03-01) { origin case_input; }
        assert "f3": kuendigungserklaerung_am_626(entity_ref("urn:de:bgb:dw:t41"), entity_ref("urn:de:bgb:dw:t41:K"), @2026-03-15) { origin case_input; }
    }
    evaluate truth(ausserordentliche_kuendigung_zulaessig_626(entity_ref("urn:de:bgb:dw:t41"), entity_ref("urn:de:bgb:dw:t41:K")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kuendigung_626_innerhalb_der_frist(entity_ref("urn:de:bgb:dw:t41"), entity_ref("urn:de:bgb:dw:t41:K")));
    expect truth_status == TRUE_ONLY;
}
