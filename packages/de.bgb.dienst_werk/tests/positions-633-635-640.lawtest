language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 633, 635, 640: mangelfreie Verschaffung, Nacherfüllungsaufwendungen und Abnahme.

test "urn:query:bgb-dw-positions-633-635-640-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": unternehmer(entity_ref("urn:de:bgb:dw:positions-633-635-640"), entity_ref("urn:de:bgb:dw:positions-633-635-640:U")) { origin case_input; }
        assert "f2": besteller(entity_ref("urn:de:bgb:dw:positions-633-635-640"), entity_ref("urn:de:bgb:dw:positions-633-635-640:B")) { origin case_input; }
        assert "f3": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-633-635-640"), @2026-02-01) { origin case_input; }
        assert "f4": beschaffenheit_vereinbart_633(entity_ref("urn:de:bgb:dw:positions-633-635-640")) { origin case_input; }
        assert "f5": not vereinbarte_beschaffenheit_erfuellt_633(entity_ref("urn:de:bgb:dw:positions-633-635-640")) { origin case_input; }
        assert "f6": nacherfuellung_verlangt_635(entity_ref("urn:de:bgb:dw:positions-633-635-640")) { origin case_input; }
        assert "f7": werk_vertragsmaessig_hergestellt_640(entity_ref("urn:de:bgb:dw:positions-633-635-640")) { origin case_input; }
        assert "f8": abnahme_nicht_ausgeschlossen_640(entity_ref("urn:de:bgb:dw:positions-633-635-640")) { origin case_input; }
    }
    evaluate positions();
    expect position(MangelfreieVerschaffung633, ACTIVE);
    expect position(NacherfuellungsaufwendungenTragen635, ACTIVE);
    expect position(Nacherfuellungsaufwendungen635Abs2Position, ACTIVE);
    expect position(AbnahmePflicht640, ACTIVE);
}

test "urn:query:bgb-dw-positions-633-635-640-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": unternehmer(entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied"), entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied:U")) { origin case_input; }
        assert "f2": besteller(entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied"), entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied:B")) { origin case_input; }
        assert "f3": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied"), @2026-02-01) { origin case_input; }
        assert "f4": beschaffenheit_vereinbart_633(entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied")) { origin case_input; }
        assert "f5": not vereinbarte_beschaffenheit_erfuellt_633(entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied")) { origin case_input; }
        assert "f6": nacherfuellung_verlangt_635(entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied")) { origin case_input; }
        assert "f7": werk_vertragsmaessig_hergestellt_640(entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied")) { origin case_input; }
        assert "f8": abnahme_nicht_ausgeschlossen_640(entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied")) { origin case_input; }
        assert "f9": werk_verschafft(entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied")) { origin case_input; }
        assert "f10": nacherfuellungsaufwendungen_getragen_635(entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied")) { origin case_input; }
        assert "f11": werk_abgenommen(entity_ref("urn:de:bgb:dw:positions-633-635-640-satisfied")) { origin case_input; }
    }
    evaluate positions();
    expect position(MangelfreieVerschaffung633, SATISFIED);
    expect position(NacherfuellungsaufwendungenTragen635, SATISFIED);
    expect position(Nacherfuellungsaufwendungen635Abs2Position, SATISFIED);
    expect position(AbnahmePflicht640, SATISFIED);
}
