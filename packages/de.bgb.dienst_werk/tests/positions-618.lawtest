language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 618 Abs. 1: Schutzmaßnahmen als bestehende POSITION.

test "urn:query:bgb-dw-positions-618-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverpflichteter(entity_ref("urn:de:bgb:dw:positions-618"), entity_ref("urn:de:bgb:dw:positions-618:V")) { origin case_input; }
        assert "f2": dienstberechtigter(entity_ref("urn:de:bgb:dw:positions-618"), entity_ref("urn:de:bgb:dw:positions-618:B")) { origin case_input; }
        assert "f3": dienstbeginn_am(entity_ref("urn:de:bgb:dw:positions-618"), @2026-01-01) { origin case_input; }
        assert "f4": schutzpflicht_618_nicht_erfuellt(entity_ref("urn:de:bgb:dw:positions-618")) { origin adjudicated; }
    }
    evaluate positions();
    expect position(SchutzmassnahmenGewaehren618, ACTIVE);
}

test "urn:query:bgb-dw-positions-618-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverpflichteter(entity_ref("urn:de:bgb:dw:positions-618-satisfied"), entity_ref("urn:de:bgb:dw:positions-618-satisfied:V")) { origin case_input; }
        assert "f2": dienstberechtigter(entity_ref("urn:de:bgb:dw:positions-618-satisfied"), entity_ref("urn:de:bgb:dw:positions-618-satisfied:B")) { origin case_input; }
        assert "f3": dienstbeginn_am(entity_ref("urn:de:bgb:dw:positions-618-satisfied"), @2026-01-01) { origin case_input; }
        assert "f4": schutzpflicht_618_nicht_erfuellt(entity_ref("urn:de:bgb:dw:positions-618-satisfied")) { origin adjudicated; }
        assert "f5": raeume_und_gerraetschaften_gefahrfrei_eingerichtet(entity_ref("urn:de:bgb:dw:positions-618-satisfied")) { origin case_input; }
    }
    evaluate positions();
    expect position(SchutzmassnahmenGewaehren618, SATISFIED);
}
