language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 649, 650b, 650g: Anzeige der Kostenüberschreitung, Änderungsangebot und Zustandsfeststellung.

test "urn:query:bgb-dw-positions-649-650b-650g-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:positions-650b-1")) { origin case_input; }
        assert "f2": unternehmer(entity_ref("urn:de:bgb:dw:positions-650b-1"), entity_ref("urn:de:bgb:dw:positions-650b-1:U")) { origin case_input; }
        assert "f3": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650b-1"), @2026-02-01) { origin case_input; }
        assert "f4": aenderung_des_werkerfolgs_begehrt_650b(entity_ref("urn:de:bgb:dw:positions-650b-1")) { origin case_input; }
        assert "f5": ausfuehrung_der_aenderung_zumutbar_650b(entity_ref("urn:de:bgb:dw:positions-650b-1")) { origin adjudicated; }
        assert "f6": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:positions-650b-2")) { origin case_input; }
        assert "f7": unternehmer(entity_ref("urn:de:bgb:dw:positions-650b-2"), entity_ref("urn:de:bgb:dw:positions-650b-2:U")) { origin case_input; }
        assert "f8": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650b-2"), @2026-02-01) { origin case_input; }
        assert "f9": notwendige_aenderung_begehrt_650b(entity_ref("urn:de:bgb:dw:positions-650b-2")) { origin case_input; }
        assert "f10": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:positions-650g")) { origin case_input; }
        assert "f11": besteller(entity_ref("urn:de:bgb:dw:positions-650g"), entity_ref("urn:de:bgb:dw:positions-650g:B")) { origin case_input; }
        assert "f12": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650g"), @2026-02-01) { origin case_input; }
        assert "f13": abnahme_unter_mangelangabe_verweigert_650g(entity_ref("urn:de:bgb:dw:positions-650g")) { origin case_input; }
        assert "f14": zustandsfeststellung_verlangt_650g(entity_ref("urn:de:bgb:dw:positions-650g")) { origin case_input; }
        assert "f15": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:positions-649")) { origin case_input; }
        assert "f16": unternehmer(entity_ref("urn:de:bgb:dw:positions-649"), entity_ref("urn:de:bgb:dw:positions-649:U")) { origin case_input; }
        assert "f17": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-649"), @2026-02-01) { origin case_input; }
        assert "f18": kostenanschlag_ohne_gewaehr_649(entity_ref("urn:de:bgb:dw:positions-649")) { origin case_input; }
        assert "f19": wesentliche_ueberschreitung_des_anschlags_649(entity_ref("urn:de:bgb:dw:positions-649")) { origin adjudicated; }
    }
    evaluate positions();
    expect position(AngebotUeberMehrverguetung650b, ACTIVE);
    expect position(AngebotUeberMehrverguetungNotwendig650b, ACTIVE);
    expect position(ZustandsfeststellungMitwirken650g, ACTIVE);
    expect position(UeberschreitungAnzeigen649, ACTIVE);
}

test "urn:query:bgb-dw-positions-649-650b-650g-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:positions-650b-1-satisfied")) { origin case_input; }
