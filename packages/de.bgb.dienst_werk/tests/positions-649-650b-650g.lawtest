        assert "f18": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:positions-649-satisfied")) { origin case_input; }
        assert "f19": unternehmer(entity_ref("urn:de:bgb:dw:positions-649-satisfied"), entity_ref("urn:de:bgb:dw:positions-649-satisfied:U")) { origin case_input; }
