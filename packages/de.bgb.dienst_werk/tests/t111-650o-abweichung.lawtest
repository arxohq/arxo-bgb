language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650o: die Abweichung zum Nachteil des Verbrauchers ist unbeachtlich.

test "urn:query:bgb-dw-t111-650o-abweichung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:t111"), entity_ref("urn:de:bgb:dw:t111:V")) { origin case_input; }
        assert "f2": bau_eines_neuen_gebaeudes_650i(entity_ref("urn:de:bgb:dw:t111")) { origin case_input; }
        assert "f3": abweichung_zum_nachteil_des_verbrauchers_650o(entity_ref("urn:de:bgb:dw:t111")) { origin case_input; }
    }
    evaluate truth(abweichung_650o_unwirksam(entity_ref("urn:de:bgb:dw:t111")));
    expect truth_status == TRUE_ONLY;
}
