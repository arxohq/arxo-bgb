language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630e Abs. 2 Satz 1 Nr. 3: minus ein Merkmal — die Aufklärung war nicht verständlich, also nicht ordnungsgemäß. Boundary zu t58.

test "urn:query:bgb-dw-t59-630e-nicht-verstaendlich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": ueber_wesentliche_umstaende_aufgeklaert_630e(entity_ref("urn:de:bgb:dw:t59")) { origin case_input; }
        assert "f2": aufklaerung_muendlich_630e(entity_ref("urn:de:bgb:dw:t59")) { origin case_input; }
        assert "f3": aufklaerung_rechtzeitig_630e(entity_ref("urn:de:bgb:dw:t59")) { origin adjudicated; }
        assert "f4": not aufklaerung_verstaendlich_630e(entity_ref("urn:de:bgb:dw:t59")) { origin adjudicated; }
    }
    evaluate truth(aufklaerung_ordnungsgemaess_630e(entity_ref("urn:de:bgb:dw:t59")));
    expect truth_status == NEITHER;
}
