language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 611a Abs. 1: die Gesamtbetrachtung aller Umstände ist eine Wertung
// (DECISION-0194); ohne Antwort des Gerichts bleibt das Dokument bei der
// Frage nach dem Arbeitsverhältnis REQUIRES_JUDGMENT — kein stilles ACTIVE.

test "urn:query:bgb-dw-t02-611a-ohne-antwort" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverpflichteter(entity_ref("urn:de:bgb:dw:t02"), entity_ref("urn:de:bgb:dw:t02:AN")) { origin case_input; }
        assert "f2": dienstberechtigter(entity_ref("urn:de:bgb:dw:t02"), entity_ref("urn:de:bgb:dw:t02:AG")) { origin case_input; }
    }
    evaluate truth(arbeitsverhaeltnis(entity_ref("urn:de:bgb:dw:t02")));
    expect evaluation_status == REQUIRES_JUDGMENT;
}
