language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650g Abs. 4 Satz 3 Gegenprobe zu t105: fällt das kalendarische Ende auf einen Werktag (Mittwoch, den 4. März 2026), so bleibt es dabei — § 193 verschiebt nichts.

test "urn:query:bgb-dw-t105a-650g-frist-ohne-verlegung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:t105a")) { origin case_input; }
        assert "f2": schlussrechnung_zugegangen_am_650g(entity_ref("urn:de:bgb:dw:t105a"), @2026-02-02) { origin case_input; }
    }
    evaluate truth(einwendungsfrist_kalenderende_650g(entity_ref("urn:de:bgb:dw:t105a"), @2026-03-04));
    expect truth_status == TRUE_ONLY;
    evaluate truth(einwendungsfrist_ende_650g(entity_ref("urn:de:bgb:dw:t105a"), @2026-03-04));
    expect truth_status == TRUE_ONLY;
}
