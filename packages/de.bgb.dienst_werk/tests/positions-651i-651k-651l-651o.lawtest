language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 651i, 651k, 651l, 651o: mangelfreie Reise, Abhilfe, Rückbeförderung und Mängelanzeige.

test "urn:query:bgb-dw-positions-651i-651k-651l-651o-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o")) { origin case_input; }
        assert "f4": reiseveranstalter(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o"), entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o:V")) { origin case_input; }
        assert "f5": reisender(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o"), entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o:R")) { origin case_input; }
        assert "f6": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o"), @2026-05-01) { origin case_input; }
        assert "f7": not vereinbarte_beschaffenheit_der_reise_651i(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o")) { origin case_input; }
        assert "f8": abhilfe_verlangt_651k(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o")) { origin case_input; }
        assert "f9": reisevertrag_gekuendigt_651l(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o")) { origin case_input; }
    }
    evaluate positions();
    expect position(MangelfreieReiseVerschaffen651i, ACTIVE);
    expect position(ReisemangelBeseitigen651k, ACTIVE);
    expect position(RueckbefoerderungBesorgen651l, ACTIVE);
    expect position(ReisemangelAnzeigen651o, ACTIVE);
}

test "urn:query:bgb-dw-positions-651i-651k-651l-651o-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied")) { origin case_input; }
        assert "f4": reiseveranstalter(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied"), entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied:V")) { origin case_input; }
        assert "f5": reisender(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied"), entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied:R")) { origin case_input; }
        assert "f6": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied"), @2026-05-01) { origin case_input; }
        assert "f7": not vereinbarte_beschaffenheit_der_reise_651i(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied")) { origin case_input; }
        assert "f8": abhilfe_verlangt_651k(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied")) { origin case_input; }
        assert "f9": reisevertrag_gekuendigt_651l(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied")) { origin case_input; }
        assert "f10": reise_frei_von_reisemaengeln_651i(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied")) { origin case_input; }
        assert "f11": rueckbefoerderung_besorgt_651l(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied")) { origin case_input; }
        assert "f12": mangel_angezeigt_651o(entity_ref("urn:de:bgb:dw:positions-651i-651k-651l-651o-satisfied")) { origin case_input; }
    }
    evaluate positions();
    expect position(MangelfreieReiseVerschaffen651i, SATISFIED);
    expect position(ReisemangelBeseitigen651k, SATISFIED);
    expect position(RueckbefoerderungBesorgen651l, SATISFIED);
    expect position(ReisemangelAnzeigen651o, SATISFIED);
}
