language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651n Abs. 1, 2: ohne Ausschlussgrund kann der Reisende Schadensersatz und, bei erheblicher Beeinträchtigung, eine Entschädigung für nutzlos aufgewendete Urlaubszeit verlangen.

test "urn:query:bgb-dw-t137-651n-urlaubszeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t137")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t137")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t137")) { origin case_input; }
        assert "f4": not vereinbarte_beschaffenheit_der_reise_651i(entity_ref("urn:de:bgb:dw:t137")) { origin case_input; }
        assert "f5": kein_haftungsausschluss_651n(entity_ref("urn:de:bgb:dw:t137")) { origin case_input; }
        assert "f6": reise_vereitelt_oder_erheblich_beeintraechtigt_651n(entity_ref("urn:de:bgb:dw:t137")) { origin adjudicated; }
    }
    evaluate truth(schadensersatzanspruch_651n(entity_ref("urn:de:bgb:dw:t137")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(entschaedigung_fuer_urlaubszeit_651n(entity_ref("urn:de:bgb:dw:t137")));
    expect truth_status == TRUE_ONLY;
}
