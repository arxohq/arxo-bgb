language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630h Abs. 2 Satz 2: bei unzureichender Aufklärung kann sich der Behandelnde auf die hypothetische Einwilligung berufen.

test "urn:query:bgb-dw-t69-630h-abs2-hypothetische-einwilligung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": aufklaerung_genuegt_den_anforderungen_nicht_630h(entity_ref("urn:de:bgb:dw:t69")) { origin case_input; }
        assert "f2": hypothetische_einwilligung_630h(entity_ref("urn:de:bgb:dw:t69")) { origin adjudicated; }
    }
    evaluate truth(berufung_auf_hypothetische_einwilligung_630h(entity_ref("urn:de:bgb:dw:t69")));
    expect truth_status == TRUE_ONLY;
}
