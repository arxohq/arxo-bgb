language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650r Abs. 1 Satz 2: ohne die Unterrichtung in Textform erlischt das Kündigungsrecht des Verbrauchers nicht mit dem Fristablauf — die Kündigung am 20. März bleibt wirksam. Boundary zu t116.

test "urn:query:bgb-dw-t116a-650r-verbraucher-ohne-unterrichtung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": architekten_oder_ingenieurvertrag_650p(entity_ref("urn:de:bgb:dw:t116a")) { origin case_input; }
        assert "f2": unterlagen_vorgelegt_am_650p(entity_ref("urn:de:bgb:dw:t116a"), @2026-02-28) { origin case_input; }
        assert "f3": sonderkuendigung_erklaert_am_650r(entity_ref("urn:de:bgb:dw:t116a"), @2026-03-20) { origin case_input; }
        assert "f4": besteller_ist_verbraucher_650r(entity_ref("urn:de:bgb:dw:t116a")) { origin case_input; }
        assert "f5": not unterrichtung_ueber_kuendigungsrecht_in_textform_650r(entity_ref("urn:de:bgb:dw:t116a")) { origin case_input; }
    }
    evaluate truth(sonderkuendigung_650r_wirksam(entity_ref("urn:de:bgb:dw:t116a")));
    expect truth_status == TRUE_ONLY;
}
