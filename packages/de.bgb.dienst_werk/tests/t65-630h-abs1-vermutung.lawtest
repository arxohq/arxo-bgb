language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630h Abs. 1: voll beherrschbares Risiko hat zur Verletzung geführt — der Fehler wird vermutet.

test "urn:query:bgb-dw-t65-630h-abs1-vermutung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": allgemeines_behandlungsrisiko_verwirklicht_630h(entity_ref("urn:de:bgb:dw:t65")) { origin case_input; }
        assert "f2": risiko_voll_beherrschbar_630h(entity_ref("urn:de:bgb:dw:t65")) { origin adjudicated; }
        assert "f3": verletzung_leben_koerper_gesundheit_630h(entity_ref("urn:de:bgb:dw:t65")) { origin case_input; }
    }
    evaluate truth(behandlungsfehler(entity_ref("urn:de:bgb:dw:t65")));
    expect truth_status == TRUE_ONLY;
}
