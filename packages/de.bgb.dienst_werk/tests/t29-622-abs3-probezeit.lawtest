language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 622 Abs. 3: während der Probezeit gilt eine Frist von zwei Wochen.

test "urn:query:bgb-dw-t29-622-probezeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": arbeitsvertrag_gesamtbetrachtung(entity_ref("urn:de:bgb:dw:t29")) { origin adjudicated; }
        assert "f2": in_probezeit(entity_ref("urn:de:bgb:dw:t29")) { origin case_input; }
        assert "f3": kuendigungserklaerung_am(entity_ref("urn:de:bgb:dw:t29"), @2026-03-10) { origin case_input; }
    }
    evaluate truth(kuendigungstermin_622(entity_ref("urn:de:bgb:dw:t29"), @2026-03-24));
    expect truth_status == TRUE_ONLY;
}
