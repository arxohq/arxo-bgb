language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651a Abs. 1, 2: mindestens zwei verschiedene Arten von Reiseleistungen für dieselbe Reise — Pauschalreise; beide Grundpflichten stehen offen.

test "urn:query:bgb-dw-t121-651a-pauschalreise" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t121")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t121")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t121")) { origin case_input; }
        assert "f4": reiseveranstalter(entity_ref("urn:de:bgb:dw:t121"), entity_ref("urn:de:bgb:dw:t121:V")) { origin case_input; }
        assert "f5": reisender(entity_ref("urn:de:bgb:dw:t121"), entity_ref("urn:de:bgb:dw:t121:R")) { origin case_input; }
        assert "f6": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:t121"), @2026-05-01) { origin case_input; }
    }
    evaluate truth(pauschalreise_651a(entity_ref("urn:de:bgb:dw:t121")));
    expect truth_status == TRUE_ONLY;
    evaluate positions();
    expect position(PauschalreiseVerschaffen651a, ACTIVE);
    expect position(ReisepreisZahlen651a, ACTIVE);
}
