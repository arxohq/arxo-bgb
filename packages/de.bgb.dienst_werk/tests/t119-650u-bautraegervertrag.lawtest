language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650u Abs. 1, 2: der Bauträgervertrag verbindet Errichtung und Eigentumsübertragung; für die Übertragung gilt Kaufrecht, die §§ 648, 648a, 650b bis 650e, 650k Abs. 1, 650l und 650m Abs. 1 finden keine Anwendung.

test "urn:query:bgb-dw-t119-650u-bautraegervertrag" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": errichtung_oder_umbau_eines_hauses_650u(entity_ref("urn:de:bgb:dw:t119")) { origin case_input; }
        assert "f2": pflicht_zur_eigentums_oder_erbbaurechtsuebertragung_650u(entity_ref("urn:de:bgb:dw:t119")) { origin case_input; }
    }
    evaluate truth(bautraegervertrag_650u(entity_ref("urn:de:bgb:dw:t119")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kaufrecht_fuer_grundstuecksuebertragung_650u(entity_ref("urn:de:bgb:dw:t119")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(vorschriften_648_bis_650m_ausgeschlossen_650u(entity_ref("urn:de:bgb:dw:t119")));
    expect truth_status == TRUE_ONLY;
}
