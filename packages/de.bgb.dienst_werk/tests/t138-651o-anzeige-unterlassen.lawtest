language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651o Abs. 2: konnte der Veranstalter infolge der schuldhaft unterlassenen Anzeige keine Abhilfe schaffen, sind Minderung und Schadensersatz gesperrt.

test "urn:query:bgb-dw-t138-651o-anzeige-unterlassen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t138")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t138")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t138")) { origin case_input; }
        assert "f4": not vereinbarte_beschaffenheit_der_reise_651i(entity_ref("urn:de:bgb:dw:t138")) { origin case_input; }
        assert "f5": schuldhaft_unterlassene_anzeige_651o(entity_ref("urn:de:bgb:dw:t138")) { origin case_input; }
    }
    evaluate truth(maengelrechte_651o_gesperrt(entity_ref("urn:de:bgb:dw:t138")));
    expect truth_status == TRUE_ONLY;
}
