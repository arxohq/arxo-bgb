language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 639: auf den vereinbarten Haftungsausschluss kann sich der Unternehmer nicht berufen, wenn er den Mangel arglistig verschwiegen hat.

test "urn:query:bgb-dw-t91-639-arglist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": haftungsausschluss_vereinbart_639(entity_ref("urn:de:bgb:dw:t91")) { origin case_input; }
        assert "f2": mangel_arglistig_verschwiegen_634a(entity_ref("urn:de:bgb:dw:t91")) { origin adjudicated; }
    }
    evaluate truth(berufung_auf_haftungsausschluss_versperrt_639(entity_ref("urn:de:bgb:dw:t91")));
    expect truth_status == TRUE_ONLY;
}
