language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630 Satz 1: bei Beendigung eines dauernden Dienstverhältnisses kann auf
// Verlangen ein schriftliches Zeugnis gefordert werden.

test "urn:query:bgb-dw-t48-630-zeugnis" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverpflichteter(entity_ref("urn:de:bgb:dw:t48"), entity_ref("urn:de:bgb:dw:t48:V")) { origin case_input; }
        assert "f2": dienstberechtigter(entity_ref("urn:de:bgb:dw:t48"), entity_ref("urn:de:bgb:dw:t48:B")) { origin case_input; }
        assert "f3": dauerndes_dienstverhaeltnis(entity_ref("urn:de:bgb:dw:t48")) { origin case_input; }
        assert "f4a": dienstverhaeltnis_befristet(entity_ref("urn:de:bgb:dw:t48")) { origin case_input; }
        assert "f4b": befristung_ablauf_am(entity_ref("urn:de:bgb:dw:t48"), @2026-06-30) { origin case_input; }
        assert "f5": zeugnisverlangen_gestellt_630(entity_ref("urn:de:bgb:dw:t48")) { origin case_input; }
    }
    evaluate positions();
    expect position(ZeugniserteilungPflicht630, ACTIVE);
}
