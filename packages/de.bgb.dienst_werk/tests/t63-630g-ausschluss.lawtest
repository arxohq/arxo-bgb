language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630g Abs. 2: erhebliche therapeutische Gründe schließen das Einsichtsrecht aus; die Ablehnung ist zu begründen. Boundary zu t62.

test "urn:query:bgb-dw-t63-630g-ausschluss" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:t63"), entity_ref("urn:de:bgb:dw:t63:A")) { origin case_input; }
        assert "f2": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:t63"), @2026-01-10) { origin case_input; }
        assert "f3": erhebliche_therapeutische_gruende_630g(entity_ref("urn:de:bgb:dw:t63")) { origin adjudicated; }
    }
    evaluate positions();
    expect position(AblehnungBegruenden630g, ACTIVE);
}
