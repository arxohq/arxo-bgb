language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651t Gegenprobe: ohne Absicherungsvertrag ist die Vorauszahlung auf den Reisepreis nicht zulässig. Boundary zu t141.

test "urn:query:bgb-dw-t141a-651t-ohne-absicherung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t141a")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t141a")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t141a")) { origin case_input; }
        assert "f4": absicherer_benannt_651t(entity_ref("urn:de:bgb:dw:t141a")) { origin case_input; }
    }
    evaluate truth(vorauszahlung_zulaessig_651t(entity_ref("urn:de:bgb:dw:t141a")));
    expect truth_status == NEITHER;
}
