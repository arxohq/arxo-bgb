language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 617 Abs. 1: keine Krankenfürsorgepflicht, wenn die Erkrankung
// vorsätzlich herbeigeführt wurde. Boundary zu t18.

test "urn:query:bgb-dw-t19-617-vorsaetzlich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dauerndes_dienstverhaeltnis(entity_ref("urn:de:bgb:dw:t19")) { origin case_input; }
        assert "f2": haeusliche_gemeinschaft(entity_ref("urn:de:bgb:dw:t19")) { origin case_input; }
        assert "f3": erkrankung_am_617(entity_ref("urn:de:bgb:dw:t19"), @2026-03-01) { origin case_input; }
        assert "f4": kein_krankenversicherung_oder_oeffentliche_krankenpflege_vorgesorgt(entity_ref("urn:de:bgb:dw:t19")) { origin case_input; }
        assert "f5": erkrankung_vorsaetzlich_oder_grob_fahrlaessig_herbeigefuehrt(entity_ref("urn:de:bgb:dw:t19")) { origin adjudicated; }
    }
    evaluate truth(pflicht_krankenfuersorge_617(entity_ref("urn:de:bgb:dw:t19")));
    expect truth_status == NEITHER;
}
