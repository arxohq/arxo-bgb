language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 638 Abs. 1, 3: Vergütung 10 000 EUR, Wert ohne Mangel 100, wirklicher Wert 80 — die geminderte Vergütung beträgt 8 000,00 EUR (eine Division, HALF_UP).

test "urn:query:bgb-dw-t90-638-minderung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": beschaffenheit_vereinbart_633(entity_ref("urn:de:bgb:dw:t90")) { origin case_input; }
        assert "f2": not vereinbarte_beschaffenheit_erfuellt_633(entity_ref("urn:de:bgb:dw:t90")) { origin case_input; }
        assert "f3": minderung_erklaert_638(entity_ref("urn:de:bgb:dw:t90")) { origin case_input; }
        assert "f4": ein_beteiligter_je_seite_638(entity_ref("urn:de:bgb:dw:t90")) { origin case_input; }
        assert "f5": vereinbarte_werkverguetung(entity_ref("urn:de:bgb:dw:t90"), 10000 EUR) { origin case_input; }
        assert "f6": wert_ohne_mangel_638(entity_ref("urn:de:bgb:dw:t90"), 100) { origin case_input; }
        assert "f7": wirklicher_wert_638(entity_ref("urn:de:bgb:dw:t90"), 80) { origin case_input; }
    }
    evaluate truth(geminderte_werkverguetung_638(entity_ref("urn:de:bgb:dw:t90"), 8000.00 EUR));
    expect truth_status == TRUE_ONLY;
}
