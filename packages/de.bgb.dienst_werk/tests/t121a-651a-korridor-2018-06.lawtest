language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// Korridor 2018 (Art. 229 § 42 EGBGB): vor dem 1. Juli 2018 schweigt der Untertitel 5 — derselbe Sachverhalt wie t121 mit legal_time 30. Juni 2018. Boundary zu t121b.

test "urn:query:bgb-dw-t121a-651a-korridor-2018-06" {
    given {
        context { legal_time @2018-06-30; decision_time @2018-06-30T09:00:00Z; knowledge_time @2018-06-30T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t121a")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t121a")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t121a")) { origin case_input; }
    }
    evaluate truth(pauschalreise_651a(entity_ref("urn:de:bgb:dw:t121a")));
    expect truth_status == NEITHER;
}
