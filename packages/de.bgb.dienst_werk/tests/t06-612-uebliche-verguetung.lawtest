language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 612 Abs. 2: Höhe nicht bestimmt, keine Taxe — die übliche Vergütung gilt
// als vereinbart. Boundary zu t05: derselbe Fall ohne Taxe.

test "urn:query:bgb-dw-t06-612-ueblich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": hoehe_der_verguetung_nicht_bestimmt(entity_ref("urn:de:bgb:dw:t06")) { origin case_input; }
        assert "f2": kein_taxe_vorhanden(entity_ref("urn:de:bgb:dw:t06")) { origin case_input; }
        assert "f3": uebliche_verguetung_hoehe(entity_ref("urn:de:bgb:dw:t06"), 950 EUR) { origin case_input; }
    }
    evaluate truth(verguetung_hoehe_bestimmt(entity_ref("urn:de:bgb:dw:t06"), 950 EUR));
    expect truth_status == TRUE_ONLY;
}
