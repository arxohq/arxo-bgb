language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651p Abs. 1: die Haftung für nicht schuldhaft herbeigeführte Nichtkörperschäden kann auf den dreifachen Reisepreis beschränkt werden — 2 000 EUR ergeben 6 000 EUR.

test "urn:query:bgb-dw-t139-651p-dreifacher-reisepreis" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": haftungsbeschraenkung_vereinbart_651p(entity_ref("urn:de:bgb:dw:t139")) { origin case_input; }
        assert "f2": schaden_ohne_koerperschaden_und_ohne_verschulden_651p(entity_ref("urn:de:bgb:dw:t139")) { origin case_input; }
        assert "f3": reisepreis(entity_ref("urn:de:bgb:dw:t139"), 2000 EUR) { origin case_input; }
    }
    evaluate truth(haftungshoechstbetrag_651p(entity_ref("urn:de:bgb:dw:t139"), 6000 EUR));
    expect truth_status == TRUE_ONLY;
}
