language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 635 Abs. 3 und § 636: die Nacherfüllung ist nur mit unverhältnismäßigen Kosten möglich — der Unternehmer kann sie verweigern, einer Fristsetzung bedarf es nicht.

test "urn:query:bgb-dw-t88-635-636-verweigerung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": nacherfuellung_nur_mit_unverhaeltnismaessigen_kosten_635(entity_ref("urn:de:bgb:dw:t88")) { origin adjudicated; }
    }
    evaluate truth(nacherfuellung_verweigert_635(entity_ref("urn:de:bgb:dw:t88")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(fristsetzung_entbehrlich_636(entity_ref("urn:de:bgb:dw:t88")));
    expect truth_status == TRUE_ONLY;
}
