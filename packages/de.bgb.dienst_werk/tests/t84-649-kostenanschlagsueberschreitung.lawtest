language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 649 Abs. 1: kündigt der Besteller wegen der wesentlichen Überschreitung des Kostenanschlags, steht dem Unternehmer nur der Anspruch des § 645 Abs. 1 zu.

test "urn:query:bgb-dw-t84-649-kostenanschlagsueberschreitung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": kostenanschlag_ohne_gewaehr_649(entity_ref("urn:de:bgb:dw:t84")) { origin case_input; }
        assert "f2": wesentliche_ueberschreitung_des_anschlags_649(entity_ref("urn:de:bgb:dw:t84")) { origin adjudicated; }
        assert "f3": kuendigung_wegen_ueberschreitung_649(entity_ref("urn:de:bgb:dw:t84")) { origin case_input; }
        assert "f4": geleisteter_arbeit_entsprechender_teil_645(entity_ref("urn:de:bgb:dw:t84"), 2100 EUR) { origin case_input; }
    }
    evaluate truth(nur_teilverguetungsanspruch_649(entity_ref("urn:de:bgb:dw:t84"), 2100 EUR));
    expect truth_status == TRUE_ONLY;
}
