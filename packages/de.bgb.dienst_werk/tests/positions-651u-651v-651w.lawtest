language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 651u, 651v, 651w: Gastschulaufenthalt und verbundene Reiseleistungen.

test "urn:query:bgb-dw-positions-651u-651v-651w-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": gastschulvertrag_651u(entity_ref("urn:de:bgb:dw:positions-651u")) { origin case_input; }
        assert "f2": reiseveranstalter(entity_ref("urn:de:bgb:dw:positions-651u"), entity_ref("urn:de:bgb:dw:positions-651u:V")) { origin case_input; }
        assert "f3": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651u"), @2026-05-01) { origin case_input; }
        assert "f4": reisevermittler_651v(entity_ref("urn:de:bgb:dw:positions-651v"), entity_ref("urn:de:bgb:dw:positions-651v:M")) { origin case_input; }
        assert "f5": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651v"), @2026-05-01) { origin case_input; }
        assert "f6": vermittler_verbundener_reiseleistungen_651w(entity_ref("urn:de:bgb:dw:positions-651w"), entity_ref("urn:de:bgb:dw:positions-651w:M")) { origin case_input; }
        assert "f7": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651w"), @2026-05-01) { origin case_input; }
    }
    evaluate positions();
    expect position(UnterkunftUndBetreuung651u, ACTIVE);
    expect position(SchulbesuchErmoeglichen651u, ACTIVE);
    expect position(VermittlerInformieren651v, ACTIVE);
    expect position(VerbundeneLeistungenInformieren651w, ACTIVE);
    expect position(ZahlungenAbsichern651w, ACTIVE);
}

test "urn:query:bgb-dw-positions-651u-651v-651w-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": gastschulvertrag_651u(entity_ref("urn:de:bgb:dw:positions-651u-satisfied")) { origin case_input; }
        assert "f2": reiseveranstalter(entity_ref("urn:de:bgb:dw:positions-651u-satisfied"), entity_ref("urn:de:bgb:dw:positions-651u-satisfied:V")) { origin case_input; }
        assert "f3": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651u-satisfied"), @2026-05-01) { origin case_input; }
        assert "f4": unterkunft_und_betreuung_gesorgt_651u(entity_ref("urn:de:bgb:dw:positions-651u-satisfied")) { origin case_input; }
        assert "f5": voraussetzungen_fuer_schulbesuch_geschaffen_651u(entity_ref("urn:de:bgb:dw:positions-651u-satisfied")) { origin case_input; }
        assert "f6": reisevermittler_651v(entity_ref("urn:de:bgb:dw:positions-651v-satisfied"), entity_ref("urn:de:bgb:dw:positions-651v-satisfied:M")) { origin case_input; }
        assert "f7": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651v-satisfied"), @2026-05-01) { origin case_input; }
        assert "f8": vermittler_informiert_651v(entity_ref("urn:de:bgb:dw:positions-651v-satisfied")) { origin case_input; }
        assert "f9": vermittler_verbundener_reiseleistungen_651w(entity_ref("urn:de:bgb:dw:positions-651w-satisfied"), entity_ref("urn:de:bgb:dw:positions-651w-satisfied:M")) { origin case_input; }
        assert "f10": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651w-satisfied"), @2026-05-01) { origin case_input; }
        assert "f11": verbundene_leistungen_information_erteilt_651w(entity_ref("urn:de:bgb:dw:positions-651w-satisfied")) { origin case_input; }
        assert "f12": absicherung_der_zahlungen_651w(entity_ref("urn:de:bgb:dw:positions-651w-satisfied")) { origin case_input; }
    }
    evaluate positions();
    expect position(UnterkunftUndBetreuung651u, SATISFIED);
    expect position(SchulbesuchErmoeglichen651u, SATISFIED);
    expect position(VermittlerInformieren651v, SATISFIED);
    expect position(VerbundeneLeistungenInformieren651w, SATISFIED);
    expect position(ZahlungenAbsichern651w, SATISFIED);
}
