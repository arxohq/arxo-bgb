language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 611, 629 und 630: vier duty-heads.

test "urn:query:bgb-dw-positions-611-618-629-630-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverpflichteter(entity_ref("urn:de:bgb:dw:positions-611-618-629-630"), entity_ref("urn:de:bgb:dw:positions-611-618-629-630:V")) { origin case_input; }
        assert "f2": dienstberechtigter(entity_ref("urn:de:bgb:dw:positions-611-618-629-630"), entity_ref("urn:de:bgb:dw:positions-611-618-629-630:B")) { origin case_input; }
        assert "f3": dienstbeginn_am(entity_ref("urn:de:bgb:dw:positions-611-618-629-630"), @2026-01-10) { origin case_input; }
        assert "f4": dauerndes_dienstverhaeltnis(entity_ref("urn:de:bgb:dw:positions-611-618-629-630")) { origin case_input; }
        assert "f5": kuendigung_erklaert_629(entity_ref("urn:de:bgb:dw:positions-611-618-629-630")) { origin case_input; }
        assert "f6": freizeit_verlangt_629(entity_ref("urn:de:bgb:dw:positions-611-618-629-630")) { origin case_input; }
        assert "f7": dienstverhaeltnis_beendet_am(entity_ref("urn:de:bgb:dw:positions-611-618-629-630"), @2026-09-01) { origin case_input; }
        assert "f8": zeugnisverlangen_gestellt_630(entity_ref("urn:de:bgb:dw:positions-611-618-629-630")) { origin case_input; }
    }
    evaluate positions();
    expect position(DienstePflicht611, ACTIVE);
    expect position(DienstePflicht611Position, ACTIVE);
    expect position(VerguetungsPflicht611, ACTIVE);
    expect position(FreizeitGewaehren629, ACTIVE);
    expect position(FreizeitGewaehren629Position, ACTIVE);
    expect position(ZeugniserteilungPflicht630, ACTIVE);
    expect position(Zeugniserteilungspflicht630Position, ACTIVE);
}

test "urn:query:bgb-dw-positions-611-618-629-630-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverpflichteter(entity_ref("urn:de:bgb:dw:positions-611-618-629-630-satisfied"), entity_ref("urn:de:bgb:dw:positions-611-618-629-630-satisfied:V")) { origin case_input; }
        assert "f2": dienstberechtigter(entity_ref("urn:de:bgb:dw:positions-611-618-629-630-satisfied"), entity_ref("urn:de:bgb:dw:positions-611-618-629-630-satisfied:B")) { origin case_input; }
