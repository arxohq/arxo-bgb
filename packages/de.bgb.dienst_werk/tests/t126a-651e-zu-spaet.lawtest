language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651e Abs. 1 Satz 2 Gegenprobe: Zugang am 15. Juni, Reisebeginn am 20. Juni — der siebente Tag (22. Juni) liegt nach dem Reisebeginn. Boundary zu t126.

test "urn:query:bgb-dw-t126a-651e-zu-spaet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": uebertragungserklaerung_zugegangen_am_651e(entity_ref("urn:de:bgb:dw:t126a"), @2026-06-15) { origin case_input; }
        assert "f2": reisebeginn_am(entity_ref("urn:de:bgb:dw:t126a"), @2026-06-20) { origin case_input; }
    }
    evaluate truth(uebertragungserklaerung_rechtzeitig_651e(entity_ref("urn:de:bgb:dw:t126a")));
    expect truth_status == NEITHER;
}
