language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 615 Satz 1, 2: bei Annahmeverzug bleibt der Vergütungsanspruch, gemindert
// um den ersparten Wert.

test "urn:query:bgb-dw-t16-615-annahmeverzug" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": annahmeverzug_des_dienstberechtigten(entity_ref("urn:de:bgb:dw:t16")) { origin case_input; }
        assert "f2": vereinbarte_verguetung(entity_ref("urn:de:bgb:dw:t16"), 3000 EUR) { origin case_input; }
        assert "f3": ersparter_wert(entity_ref("urn:de:bgb:dw:t16"), 200 EUR) { origin case_input; }
    }
    evaluate truth(verguetungsanspruch_615(entity_ref("urn:de:bgb:dw:t16"), 2800 EUR));
    expect truth_status == TRUE_ONLY;
}
