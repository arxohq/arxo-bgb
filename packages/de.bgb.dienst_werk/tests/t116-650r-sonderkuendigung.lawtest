language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650r Abs. 1 mit § 193: Vorlage der Unterlagen am Sonnabend, dem 28. Februar 2026; das kalendarische Ende der zwei Wochen fällt auf Sonnabend, den 14. März, und wird auf Montag, den 16. März verlegt. Die Kündigung des nicht verbrauchenden Bestellers am 16. März ist rechtzeitig.

test "urn:query:bgb-dw-t116-650r-sonderkuendigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": architekten_oder_ingenieurvertrag_650p(entity_ref("urn:de:bgb:dw:t116")) { origin case_input; }
        assert "f2": unterlagen_vorgelegt_am_650p(entity_ref("urn:de:bgb:dw:t116"), @2026-02-28) { origin case_input; }
        assert "f3": sonderkuendigung_erklaert_am_650r(entity_ref("urn:de:bgb:dw:t116"), @2026-03-16) { origin case_input; }
        assert "f4": besteller_ist_kein_verbraucher_650r(entity_ref("urn:de:bgb:dw:t116")) { origin case_input; }
    }
    evaluate truth(sonderkuendigungsfrist_kalenderende_650r(entity_ref("urn:de:bgb:dw:t116"), @2026-03-14));
    expect truth_status == TRUE_ONLY;
    evaluate truth(sonderkuendigungsfrist_ende_650r(entity_ref("urn:de:bgb:dw:t116"), @2026-03-16));
    expect truth_status == TRUE_ONLY;
    evaluate truth(sonderkuendigung_650r_wirksam(entity_ref("urn:de:bgb:dw:t116")));
    expect truth_status == TRUE_ONLY;
}
