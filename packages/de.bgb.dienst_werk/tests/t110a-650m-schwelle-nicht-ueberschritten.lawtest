language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650m Abs. 2 Satz 2 Gegenprobe: eine Erhöhung genau in Höhe der Schwelle von 30 000,00 EUR löst keine weitere Sicherheit aus. Boundary zu t110.

test "urn:query:bgb-dw-t110a-650m-schwelle-nicht-ueberschritten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:t110a"), entity_ref("urn:de:bgb:dw:t110a:V")) { origin case_input; }
        assert "f2": bau_eines_neuen_gebaeudes_650i(entity_ref("urn:de:bgb:dw:t110a")) { origin case_input; }
        assert "f3": vereinbarte_gesamtverguetung_650m(entity_ref("urn:de:bgb:dw:t110a"), 300000 EUR) { origin case_input; }
        assert "f4": zusaetzlicher_verguetungsanspruch_650m(entity_ref("urn:de:bgb:dw:t110a"), 30000 EUR) { origin case_input; }
    }
    evaluate truth(weitere_sicherheit_650m(entity_ref("urn:de:bgb:dw:t110a"), 1500.00 EUR));
    expect truth_status == NEITHER;
}
