language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651h Abs. 4 Satz 1 Nr. 1 Buchst. a: bei mehr als sechs Tagen Reisedauer ist der Rücktritt des Veranstalters spätestens 20 Tage vor Reisebeginn zu erklären — die Erklärung am 20. Mai 2026 ist rechtzeitig (9. Juni vor dem 20. Juni).

test "urn:query:bgb-dw-t130-651h-abs4-mindestteilnehmer" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t130")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t130")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t130")) { origin case_input; }
        assert "f4": mindestteilnehmerzahl_nicht_erreicht_651h(entity_ref("urn:de:bgb:dw:t130")) { origin case_input; }
        assert "f5": reisedauer_mehr_als_sechs_tage_651h(entity_ref("urn:de:bgb:dw:t130")) { origin case_input; }
        assert "f6": veranstalterruecktritt_erklaert_am_651h(entity_ref("urn:de:bgb:dw:t130"), @2026-05-20) { origin case_input; }
        assert "f7": reisebeginn_am(entity_ref("urn:de:bgb:dw:t130"), @2026-06-20) { origin case_input; }
    }
    evaluate truth(veranstalterruecktritt_rechtzeitig_651h(entity_ref("urn:de:bgb:dw:t130")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anspruch_auf_reisepreis_entfallen_651h(entity_ref("urn:de:bgb:dw:t130")));
    expect truth_status == TRUE_ONLY;
}
