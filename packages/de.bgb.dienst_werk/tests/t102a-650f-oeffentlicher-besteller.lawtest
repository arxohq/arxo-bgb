language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650f Abs. 6 Satz 1 Nr. 1: gegenüber der insolvenzfesten juristischen Person des öffentlichen Rechts ist die Bauhandwerkersicherung ausgeschlossen. Boundary zu t102.

test "urn:query:bgb-dw-t102a-650f-oeffentlicher-besteller" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:t102a")) { origin case_input; }
        assert "f2": besteller_ist_juristische_person_des_oeffentlichen_rechts_650f(entity_ref("urn:de:bgb:dw:t102a")) { origin case_input; }
    }
    evaluate truth(sicherung_650f_ausgeschlossen(entity_ref("urn:de:bgb:dw:t102a")));
    expect truth_status == TRUE_ONLY;
}
