language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630c: Zusammenwirken und Information über erkennbare Behandlungsfehler.

test "urn:query:bgb-dw-positions-630c-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:positions-630c"), entity_ref("urn:de:bgb:dw:positions-630c:A")) { origin case_input; }
        assert "f2": patient(entity_ref("urn:de:bgb:dw:positions-630c"), entity_ref("urn:de:bgb:dw:positions-630c:P")) { origin case_input; }
        assert "f3": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630c"), @2026-01-10) { origin case_input; }
        assert "f4": umstaende_fuer_behandlungsfehler_erkennbar_630c(entity_ref("urn:de:bgb:dw:positions-630c")) { origin case_input; }
        assert "f5": nachfrage_des_patienten_630c(entity_ref("urn:de:bgb:dw:positions-630c")) { origin case_input; }
        assert "f6": abwendung_gesundheitlicher_gefahren_erforderlich_630c(entity_ref("urn:de:bgb:dw:positions-630c")) { origin case_input; }
    }
    evaluate positions();
    expect position(MitwirkungBehandelnder630c, ACTIVE);
    expect position(MitwirkungPatient630c, ACTIVE);
    expect position(MitwirkungPatient630cPosition, ACTIVE);
    expect position(FehlerinformationsPflicht630c, ACTIVE);
    expect position(FehlerinformationsPflichtGefahr630c, ACTIVE);
}

test "urn:query:bgb-dw-positions-630c-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:positions-630c-satisfied"), entity_ref("urn:de:bgb:dw:positions-630c-satisfied:A")) { origin case_input; }
        assert "f2": patient(entity_ref("urn:de:bgb:dw:positions-630c-satisfied"), entity_ref("urn:de:bgb:dw:positions-630c-satisfied:P")) { origin case_input; }
        assert "f3": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630c-satisfied"), @2026-01-10) { origin case_input; }
        assert "f4": umstaende_fuer_behandlungsfehler_erkennbar_630c(entity_ref("urn:de:bgb:dw:positions-630c-satisfied")) { origin case_input; }
        assert "f5": nachfrage_des_patienten_630c(entity_ref("urn:de:bgb:dw:positions-630c-satisfied")) { origin case_input; }
        assert "f6": abwendung_gesundheitlicher_gefahren_erforderlich_630c(entity_ref("urn:de:bgb:dw:positions-630c-satisfied")) { origin case_input; }
        assert "f7": zusammenwirken_zur_durchfuehrung(entity_ref("urn:de:bgb:dw:positions-630c-satisfied")) { origin case_input; }
        assert "f8": ueber_behandlungsfehler_informiert_630c(entity_ref("urn:de:bgb:dw:positions-630c-satisfied")) { origin case_input; }
    }
    evaluate positions();
    expect position(MitwirkungBehandelnder630c, SATISFIED);
    expect position(MitwirkungPatient630c, SATISFIED);
    expect position(MitwirkungPatient630cPosition, SATISFIED);
    expect position(FehlerinformationsPflicht630c, SATISFIED);
    expect position(FehlerinformationsPflichtGefahr630c, SATISFIED);
}
