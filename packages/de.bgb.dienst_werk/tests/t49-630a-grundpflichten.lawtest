language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630a Abs. 1: Behandlungs- und Vergütungspflicht; kein Dritter zahlt.

test "urn:query:bgb-dw-t49-630a-grundpflichten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:t49"), entity_ref("urn:de:bgb:dw:t49:A")) { origin case_input; }
        assert "f2": patient(entity_ref("urn:de:bgb:dw:t49"), entity_ref("urn:de:bgb:dw:t49:P")) { origin case_input; }
        assert "f3": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:t49"), @2026-01-10) { origin case_input; }
        assert "f4": kein_dritter_zur_zahlung_verpflichtet_630a(entity_ref("urn:de:bgb:dw:t49")) { origin case_input; }
        assert "f5": behandlung_erbracht(entity_ref("urn:de:bgb:dw:t49")) { origin case_input; }
    }
    evaluate positions();
    expect position(BehandlungsPflicht630a, SATISFIED);
    expect position(BehandlungsVerguetungsPflicht630a, ACTIVE);
}
