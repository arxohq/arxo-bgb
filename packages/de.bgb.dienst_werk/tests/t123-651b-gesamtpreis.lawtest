language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651b Abs. 1 Satz 2 Nr. 2, Satz 3: wer die Reiseleistungen zu einem Gesamtpreis anbietet, ist Reiseveranstalter.

test "urn:query:bgb-dw-t123-651b-gesamtpreis" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": zwei_arten_von_leistungen_sollen_erbracht_werden_651b(entity_ref("urn:de:bgb:dw:t123")) { origin case_input; }
        assert "f2": gesamtpreis_angeboten_651b(entity_ref("urn:de:bgb:dw:t123")) { origin case_input; }
    }
    evaluate truth(unternehmer_ist_reiseveranstalter_651b(entity_ref("urn:de:bgb:dw:t123")));
    expect truth_status == TRUE_ONLY;
}
