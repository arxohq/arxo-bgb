language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 633 Abs. 2 Satz 2 Nr. 2: ohne Beschaffenheitsvereinbarung und ohne vorausgesetzte Verwendung ist das Werk frei von Sachmängeln, wenn es sich für die gewöhnliche Verwendung eignet und die übliche Beschaffenheit aufweist.

test "urn:query:bgb-dw-t87-633-gewoehnliche-verwendung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": beschaffenheit_nicht_vereinbart_633(entity_ref("urn:de:bgb:dw:t87")) { origin case_input; }
        assert "f2": keine_vertraglich_vorausgesetzte_verwendung_633(entity_ref("urn:de:bgb:dw:t87")) { origin case_input; }
        assert "f3": eignung_fuer_gewoehnliche_verwendung_633(entity_ref("urn:de:bgb:dw:t87")) { origin case_input; }
        assert "f4": uebliche_beschaffenheit_633(entity_ref("urn:de:bgb:dw:t87")) { origin adjudicated; }
    }
    evaluate truth(werk_frei_von_sachmaengeln(entity_ref("urn:de:bgb:dw:t87")));
    expect truth_status == TRUE_ONLY;
}
