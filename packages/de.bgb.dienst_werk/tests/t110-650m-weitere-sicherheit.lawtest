language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650m Abs. 2 Satz 2: die Erhöhung um 40 000 EUR übersteigt die Schwelle von 30 000,00 EUR — weitere Sicherheit von 2 000,00 EUR.

test "urn:query:bgb-dw-t110-650m-weitere-sicherheit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:t110"), entity_ref("urn:de:bgb:dw:t110:V")) { origin case_input; }
        assert "f2": bau_eines_neuen_gebaeudes_650i(entity_ref("urn:de:bgb:dw:t110")) { origin case_input; }
        assert "f3": vereinbarte_gesamtverguetung_650m(entity_ref("urn:de:bgb:dw:t110"), 300000 EUR) { origin case_input; }
        assert "f4": zusaetzlicher_verguetungsanspruch_650m(entity_ref("urn:de:bgb:dw:t110"), 40000 EUR) { origin case_input; }
    }
    evaluate truth(erhoehungsgrenze_650m(entity_ref("urn:de:bgb:dw:t110"), 30000.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(weitere_sicherheit_650m(entity_ref("urn:de:bgb:dw:t110"), 2000.00 EUR));
    expect truth_status == TRUE_ONLY;
}
