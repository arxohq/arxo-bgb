language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 612a: ohne Benachteiligung bleibt das Verbot ACTIVE (der Arbeitgeber
// beachtet es). Boundary zu t08: dieselbe Konstellation mit Benachteiligung.

test "urn:query:bgb-dw-t07-612a-aktiv" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverpflichteter(entity_ref("urn:de:bgb:dw:t07"), entity_ref("urn:de:bgb:dw:t07:AN")) { origin case_input; }
        assert "f2": dienstberechtigter(entity_ref("urn:de:bgb:dw:t07"), entity_ref("urn:de:bgb:dw:t07:AG")) { origin case_input; }
        assert "f3": dienstbeginn_am(entity_ref("urn:de:bgb:dw:t07"), @2026-01-01) { origin case_input; }
        assert "f4": arbeitsvertrag_gesamtbetrachtung(entity_ref("urn:de:bgb:dw:t07")) { origin adjudicated; }
    }
    evaluate positions();
    expect position(RechtsausuebungOhneBenachteiligung612a, ACTIVE);
}
