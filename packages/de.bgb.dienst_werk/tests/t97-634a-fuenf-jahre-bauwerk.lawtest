language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 634a Abs. 1 Nr. 2: fünf Jahre ab Abnahme bei einem Bauwerk — Abnahme am 15. März 2024, Ablauf mit dem 15. März 2029.

test "urn:query:bgb-dw-t97-634a-fuenf-jahre-bauwerk" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": werkmaengelanspruch(entity_ref("urn:de:bgb:dw:t97:A"), entity_ref("urn:de:bgb:dw:t97")) { origin case_input; }
        assert "f2": werk_ist_bauwerksbezogen_634a(entity_ref("urn:de:bgb:dw:t97")) { origin case_input; }
        assert "f3": abnahme_am(entity_ref("urn:de:bgb:dw:t97"), @2024-03-15) { origin case_input; }
        assert "f4": kein_arglistiges_verschweigen_634a(entity_ref("urn:de:bgb:dw:t97")) { origin case_input; }
    }
    evaluate truth(frist_ende_634a(entity_ref("urn:de:bgb:dw:t97:A"), @2029-03-15));
    expect truth_status == TRUE_ONLY;
}
