language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// Korridor 2018: am ersten Tag des Korridors gilt der Untertitel 5 — derselbe Sachverhalt mit legal_time 1. Juli 2018.

test "urn:query:bgb-dw-t121b-651a-korridor-2018-07" {
    given {
        context { legal_time @2018-07-01; decision_time @2018-07-01T09:00:00Z; knowledge_time @2018-07-01T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t121b")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t121b")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t121b")) { origin case_input; }
    }
    evaluate truth(pauschalreise_651a(entity_ref("urn:de:bgb:dw:t121b")));
    expect truth_status == TRUE_ONLY;
}
