language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 650p, 651d, 651e: erforderliche Architektenleistungen und Reiseunterlagen.

test "urn:query:bgb-dw-positions-650p-651d-651e-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": architekten_oder_ingenieurvertrag_650p(entity_ref("urn:de:bgb:dw:positions-650p")) { origin case_input; }
        assert "f2": planungs_und_ueberwachungsziele_vereinbart_650p(entity_ref("urn:de:bgb:dw:positions-650p")) { origin case_input; }
        assert "f3": unternehmer(entity_ref("urn:de:bgb:dw:positions-650p"), entity_ref("urn:de:bgb:dw:positions-650p:U")) { origin case_input; }
        assert "f4": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650p"), @2026-02-01) { origin case_input; }
        assert "f5": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:positions-651d-651e")) { origin case_input; }
        assert "f6": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:positions-651d-651e")) { origin case_input; }
        assert "f7": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:positions-651d-651e")) { origin case_input; }
        assert "f8": reiseveranstalter(entity_ref("urn:de:bgb:dw:positions-651d-651e"), entity_ref("urn:de:bgb:dw:positions-651d-651e:V")) { origin case_input; }
        assert "f9": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651d-651e"), @2026-05-01) { origin case_input; }
        assert "f10": dritter_eingetreten_651e(entity_ref("urn:de:bgb:dw:positions-651d-651e"), entity_ref("urn:de:bgb:dw:positions-651d-651e:D")) { origin case_input; }
    }
    evaluate positions();
    expect position(ErforderlicheLeistungenErbringen650p, ACTIVE);
    expect position(VorvertraglichInformieren651d, ACTIVE);
    expect position(VertragsabschriftBereitstellen651d, ACTIVE);
    expect position(MehrkostenNachweisen651e, ACTIVE);
}

test "urn:query:bgb-dw-positions-650p-651d-651e-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": architekten_oder_ingenieurvertrag_650p(entity_ref("urn:de:bgb:dw:positions-650p-satisfied")) { origin case_input; }
        assert "f2": planungs_und_ueberwachungsziele_vereinbart_650p(entity_ref("urn:de:bgb:dw:positions-650p-satisfied")) { origin case_input; }
        assert "f3": unternehmer(entity_ref("urn:de:bgb:dw:positions-650p-satisfied"), entity_ref("urn:de:bgb:dw:positions-650p-satisfied:U")) { origin case_input; }
        assert "f4": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650p-satisfied"), @2026-02-01) { origin case_input; }
        assert "f5": erforderliche_leistungen_erbracht_650p(entity_ref("urn:de:bgb:dw:positions-650p-satisfied")) { origin case_input; }
        assert "f6": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:positions-651d-651e-satisfied")) { origin case_input; }
        assert "f7": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:positions-651d-651e-satisfied")) { origin case_input; }
        assert "f8": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:positions-651d-651e-satisfied")) { origin case_input; }
        assert "f9": reiseveranstalter(entity_ref("urn:de:bgb:dw:positions-651d-651e-satisfied"), entity_ref("urn:de:bgb:dw:positions-651d-651e-satisfied:V")) { origin case_input; }
        assert "f10": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651d-651e-satisfied"), @2026-05-01) { origin case_input; }
        assert "f11": dritter_eingetreten_651e(entity_ref("urn:de:bgb:dw:positions-651d-651e-satisfied"), entity_ref("urn:de:bgb:dw:positions-651d-651e-satisfied:D")) { origin case_input; }
        assert "f12": vorvertraglich_informiert_651d(entity_ref("urn:de:bgb:dw:positions-651d-651e-satisfied")) { origin case_input; }
        assert "f13": vertragsabschrift_zur_verfuegung_gestellt_651d(entity_ref("urn:de:bgb:dw:positions-651d-651e-satisfied")) { origin case_input; }
        assert "f14": nachweis_der_mehrkosten_erteilt_651e(entity_ref("urn:de:bgb:dw:positions-651d-651e-satisfied")) { origin case_input; }
    }
    evaluate positions();
    expect position(ErforderlicheLeistungenErbringen650p, SATISFIED);
    expect position(VorvertraglichInformieren651d, SATISFIED);
    expect position(VertragsabschriftBereitstellen651d, SATISFIED);
    expect position(MehrkostenNachweisen651e, SATISFIED);
}
