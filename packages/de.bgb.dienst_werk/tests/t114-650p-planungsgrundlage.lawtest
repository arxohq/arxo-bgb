language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650p Abs. 2: sind wesentliche Planungs- und Überwachungsziele noch nicht vereinbart, hat der Unternehmer zunächst eine Planungsgrundlage mit Kosteneinschätzung vorzulegen.

test "urn:query:bgb-dw-t114-650p-planungsgrundlage" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": architekten_oder_ingenieurvertrag_650p(entity_ref("urn:de:bgb:dw:t114")) { origin case_input; }
        assert "f2": planungs_und_ueberwachungsziele_nicht_vereinbart_650p(entity_ref("urn:de:bgb:dw:t114")) { origin case_input; }
        assert "f3": unternehmer(entity_ref("urn:de:bgb:dw:t114"), entity_ref("urn:de:bgb:dw:t114:U")) { origin case_input; }
        assert "f4": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:t114"), @2026-02-01) { origin case_input; }
    }
    evaluate positions();
    expect position(PlanungsgrundlageVorlegen650p, ACTIVE);
}
