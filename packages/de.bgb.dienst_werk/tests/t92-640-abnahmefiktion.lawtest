language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 640 Abs. 2 Satz 1: der Besteller ist kein Verbraucher und hat die Abnahme nicht unter Angabe eines Mangels verweigert — das Werk gilt als abgenommen.

test "urn:query:bgb-dw-t92-640-abnahmefiktion" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": abnahmefrist_ablauf_640(entity_ref("urn:de:bgb:dw:t92"), @2026-06-15) { origin case_input; }
        assert "f2": abnahmefrist_angemessen_640(entity_ref("urn:de:bgb:dw:t92")) { origin adjudicated; }
        assert "f3": abnahme_nicht_unter_mangelangabe_verweigert_640(entity_ref("urn:de:bgb:dw:t92")) { origin case_input; }
        assert "f4": besteller_ist_kein_verbraucher_640(entity_ref("urn:de:bgb:dw:t92")) { origin case_input; }
    }
    evaluate truth(werk_gilt_als_abgenommen_640(entity_ref("urn:de:bgb:dw:t92")));
    expect truth_status == TRUE_ONLY;
}
