language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 621 Nr. 2 Gegenprobe: eine Kündigung am Dienstag ist nicht mehr am ersten Werktag der Woche erklärt. Boundary zu t112.

test "urn:query:bgb-dw-t112a-621-nr2-zu-spaet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": kein_arbeitsverhaeltnis_im_sinne_des_622(entity_ref("urn:de:bgb:dw:t112a")) { origin case_input; }
        assert "f2": dienstverhaeltnis_unbestimmte_dauer(entity_ref("urn:de:bgb:dw:t112a")) { origin case_input; }
        assert "f3": verguetung_nach_wochen_bemessen_621(entity_ref("urn:de:bgb:dw:t112a")) { origin case_input; }
        assert "f4": wochenbeginn_621(entity_ref("urn:de:bgb:dw:t112a"), @2026-03-02) { origin case_input; }
        assert "f5": kuendigungserklaerung_am(entity_ref("urn:de:bgb:dw:t112a"), @2026-03-03) { origin case_input; }
    }
    evaluate truth(kuendigungstermin_621(entity_ref("urn:de:bgb:dw:t112a"), @2026-03-07));
    expect truth_status == NEITHER;
}
