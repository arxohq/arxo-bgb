language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630h Abs. 4: die mangelnde Befähigung wird als ursächlich vermutet.

test "urn:query:bgb-dw-t71-630h-abs4-befaehigung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder_nicht_befaehigt_630h(entity_ref("urn:de:bgb:dw:t71")) { origin adjudicated; }
        assert "f2": verletzung_leben_koerper_gesundheit_630h(entity_ref("urn:de:bgb:dw:t71")) { origin case_input; }
    }
    evaluate truth(mangelnde_befaehigung_ursaechlich_630h(entity_ref("urn:de:bgb:dw:t71")));
    expect truth_status == TRUE_ONLY;
}
