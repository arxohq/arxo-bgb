language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630b: auf das Behandlungsverhältnis sind die Vorschriften über das Dienstverhältnis anzuwenden.

test "urn:query:bgb-dw-t53-630b-verweisung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:t53"), entity_ref("urn:de:bgb:dw:t53:A")) { origin case_input; }
        assert "f2": keine_abweichende_bestimmung_untertitel_2(entity_ref("urn:de:bgb:dw:t53")) { origin case_input; }
    }
    evaluate truth(dienstvertragsrecht_anwendbar_630b(entity_ref("urn:de:bgb:dw:t53")));
    expect truth_status == TRUE_ONLY;
}
