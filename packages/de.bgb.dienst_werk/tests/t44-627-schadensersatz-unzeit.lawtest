language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 627 Abs. 2: Kündigung zur Unzeit ohne wichtigen Grund verpflichtet zum
// Schadensersatz.

test "urn:query:bgb-dw-t44-627-schadensersatz" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": kuendigung_zur_unzeit_627(entity_ref("urn:de:bgb:dw:t44")) { origin case_input; }
        assert "f2": not wichtiger_grund_fuer_unzeitige_kuendigung_627(entity_ref("urn:de:bgb:dw:t44")) { origin adjudicated; }
    }
    evaluate truth(schadensersatzpflicht_627(entity_ref("urn:de:bgb:dw:t44")));
    expect truth_status == TRUE_ONLY;
}
