language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650b Abs. 2 Satz 1: Zugang des Änderungsbegehrens am 2. Februar 2026, dreißig Tage enden am 4. März 2026; die Anordnung am 5. März ist zulässig.

test "urn:query:bgb-dw-t100-650b-dreissig-tage" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:t100")) { origin case_input; }
        assert "f2": aenderungsbegehren_zugegangen_am_650b(entity_ref("urn:de:bgb:dw:t100"), @2026-02-02) { origin case_input; }
        assert "f3": keine_einigung_bis_fristablauf_650b(entity_ref("urn:de:bgb:dw:t100")) { origin case_input; }
        assert "f4": anordnung_in_textform_650b(entity_ref("urn:de:bgb:dw:t100"), @2026-03-05) { origin case_input; }
    }
    evaluate truth(einigungsfrist_ende_650b(entity_ref("urn:de:bgb:dw:t100"), @2026-03-04));
    expect truth_status == TRUE_ONLY;
    evaluate truth(anordnungsrecht_650b(entity_ref("urn:de:bgb:dw:t100")));
    expect truth_status == TRUE_ONLY;
}
