language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630d Abs. 1 Satz 4: unaufschiebbare Maßnahme, Einwilligung nicht rechtzeitig einholbar, mutmaßlicher Wille bejaht.

test "urn:query:bgb-dw-t57-630d-mutmasslicher-wille" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandlung_unaufschiebbar(entity_ref("urn:de:bgb:dw:t57")) { origin case_input; }
        assert "f2": einwilligung_nicht_rechtzeitig_einholbar_630d(entity_ref("urn:de:bgb:dw:t57")) { origin case_input; }
        assert "f3": massnahme_entspricht_mutmasslichem_willen_630d(entity_ref("urn:de:bgb:dw:t57")) { origin adjudicated; }
    }
    evaluate truth(massnahme_ohne_einwilligung_zulaessig_630d(entity_ref("urn:de:bgb:dw:t57")));
    expect truth_status == TRUE_ONLY;
}
