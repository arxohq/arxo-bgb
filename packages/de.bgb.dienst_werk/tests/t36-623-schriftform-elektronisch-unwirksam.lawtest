language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 623: die elektronische Form ist ausdrücklich ausgeschlossen. Boundary
// zu t35.

test "urn:query:bgb-dw-t36-623-elektronisch" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": arbeitsvertrag_gesamtbetrachtung(entity_ref("urn:de:bgb:dw:t36")) { origin adjudicated; }
        assert "f2": kuendigung_elektronisch_erklaert(entity_ref("urn:de:bgb:dw:t36")) { origin case_input; }
    }
    evaluate truth(kuendigung_623_unwirksam(entity_ref("urn:de:bgb:dw:t36")));
    expect truth_status == TRUE_ONLY;
}
