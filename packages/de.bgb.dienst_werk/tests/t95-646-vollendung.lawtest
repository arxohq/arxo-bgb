language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 646 mit § 641 Abs. 1: ist die Abnahme nach der Beschaffenheit ausgeschlossen, tritt die Vollendung an ihre Stelle — die Vergütung wird mit ihr fällig.

test "urn:query:bgb-dw-t95-646-vollendung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": abnahme_nach_beschaffenheit_ausgeschlossen_640(entity_ref("urn:de:bgb:dw:t95")) { origin case_input; }
        assert "f2": werk_vollendet_am_646(entity_ref("urn:de:bgb:dw:t95"), @2026-07-01) { origin case_input; }
    }
    evaluate truth(werkverguetung_faellig_am(entity_ref("urn:de:bgb:dw:t95"), @2026-07-01));
    expect truth_status == TRUE_ONLY;
}
