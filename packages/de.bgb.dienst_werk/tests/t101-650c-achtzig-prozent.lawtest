language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650c Abs. 3 Satz 1: 80 Prozent der angebotenen Mehrvergütung von 50 000 EUR sind 40 000,00 EUR.

test "urn:query:bgb-dw-t101-650c-achtzig-prozent" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": angebotene_mehrverguetung_650c(entity_ref("urn:de:bgb:dw:t101"), 50000 EUR) { origin case_input; }
        assert "f2": keine_einigung_ueber_hoehe_650c(entity_ref("urn:de:bgb:dw:t101")) { origin case_input; }
    }
    evaluate truth(abschlagsansatz_650c(entity_ref("urn:de:bgb:dw:t101"), 40000.00 EUR));
    expect truth_status == TRUE_ONLY;
}
