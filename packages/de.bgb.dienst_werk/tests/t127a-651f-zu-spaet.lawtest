language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651f Abs. 1 Satz 3 Gegenprobe: Unterrichtung am 5. Juni — der zwanzigste Tag (25. Juni) liegt nach dem Reisebeginn, die Erhöhung ist unwirksam. Boundary zu t127.

test "urn:query:bgb-dw-t127a-651f-zu-spaet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": preiserhoehungsvorbehalt_im_vertrag_651f(entity_ref("urn:de:bgb:dw:t127a")) { origin case_input; }
        assert "f2": erhoehungsgrund_651f(entity_ref("urn:de:bgb:dw:t127a")) { origin case_input; }
        assert "f3": unterrichtung_ueber_preiserhoehung_am_651f(entity_ref("urn:de:bgb:dw:t127a"), @2026-06-05) { origin case_input; }
        assert "f4": reisebeginn_am(entity_ref("urn:de:bgb:dw:t127a"), @2026-06-20) { origin case_input; }
    }
    evaluate truth(preiserhoehung_wirksam_651f(entity_ref("urn:de:bgb:dw:t127a")));
    expect truth_status == NEITHER;
}
