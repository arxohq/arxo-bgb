language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 614 Satz 1: Vergütung ist nach Leistung der Dienste zu entrichten (keine
// Zeitabschnitte). Boundary zu t15 (Zeitabschnitte).

test "urn:query:bgb-dw-t14-614-allgemein" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verguetung_nicht_nach_zeitabschnitten_bemessen(entity_ref("urn:de:bgb:dw:t14")) { origin case_input; }
        assert "f2": dienstleistung_erbracht_am(entity_ref("urn:de:bgb:dw:t14"), @2026-03-05) { origin case_input; }
    }
    evaluate truth(verguetung_faellig_am(entity_ref("urn:de:bgb:dw:t14"), @2026-03-05));
    expect truth_status == TRUE_ONLY;
}
