language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 613 Satz 1: persönliche Leistung bei fehlender abweichender Vereinbarung.

test "urn:query:bgb-dw-positions-613-persoenliche-leistung-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": keine_abweichende_vereinbarung_613(entity_ref("urn:de:bgb:dw:positions-613-active")) { origin case_input; }
        assert "f2": dienstverpflichteter(entity_ref("urn:de:bgb:dw:positions-613-active"), entity_ref("urn:de:bgb:dw:positions-613-active:V")) { origin case_input; }
        assert "f3": dienstbeginn_am(entity_ref("urn:de:bgb:dw:positions-613-active"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(PersoenlicheLeistung613Satz1Position, ACTIVE);
}

test "urn:query:bgb-dw-positions-613-persoenliche-leistung-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": keine_abweichende_vereinbarung_613(entity_ref("urn:de:bgb:dw:positions-613-satisfied")) { origin case_input; }
        assert "f2": dienstverpflichteter(entity_ref("urn:de:bgb:dw:positions-613-satisfied"), entity_ref("urn:de:bgb:dw:positions-613-satisfied:V")) { origin case_input; }
        assert "f3": dienstbeginn_am(entity_ref("urn:de:bgb:dw:positions-613-satisfied"), @2026-01-01) { origin case_input; }
        assert "f4": persoenliche_leistung_erbracht_613(entity_ref("urn:de:bgb:dw:positions-613-satisfied")) { origin case_input; }
    }
    evaluate positions();
    expect position(PersoenlicheLeistung613Satz1Position, SATISFIED);
}
