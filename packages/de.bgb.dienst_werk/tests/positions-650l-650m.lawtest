language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

test "urn:query:bgb-dw-positions-650l-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:positions-650l"), entity_ref("urn:de:bgb:dw:positions-650l:V")) { origin case_input; }
        assert "f2": bau_eines_neuen_gebaeudes_650i(entity_ref("urn:de:bgb:dw:positions-650l")) { origin case_input; }
        assert "f3": vertrag_nicht_notariell_beurkundet_650l(entity_ref("urn:de:bgb:dw:positions-650l")) { origin case_input; }
        assert "f4": unternehmer(entity_ref("urn:de:bgb:dw:positions-650l"), entity_ref("urn:de:bgb:dw:positions-650l:U")) { origin case_input; }
        assert "f5": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650l"), @2026-02-01) { origin case_input; }
        assert "f6": ueber_widerrufsrecht_belehrt_650l(entity_ref("urn:de:bgb:dw:positions-650l")) { origin case_input; }
    }
    evaluate positions();
    expect position(Widerrufsbelehrung650lSatz2Position, SATISFIED);
}

test "urn:query:bgb-dw-positions-650m-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:positions-650m"), entity_ref("urn:de:bgb:dw:positions-650m:V")) { origin case_input; }
        assert "f2": unternehmer(entity_ref("urn:de:bgb:dw:positions-650m"), entity_ref("urn:de:bgb:dw:positions-650m:U")) { origin case_input; }
        assert "f3": zusaetzlicher_verguetungsanspruch_650m(entity_ref("urn:de:bgb:dw:positions-650m"), 40000 EUR) { origin case_input; }
        assert "f4": erhoehungsgrenze_650m(entity_ref("urn:de:bgb:dw:positions-650m"), 30000 EUR) { origin case_input; }
        assert "f5": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650m"), @2026-02-01) { origin case_input; }
    }
    evaluate positions();
    expect position(WeitereSicherheit650mAbs2Satz2Position, ACTIVE);
}

