    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:positions-650m-satisfied"), entity_ref("urn:de:bgb:dw:positions-650m-satisfied:V")) { origin case_input; }
        assert "f2": unternehmer(entity_ref("urn:de:bgb:dw:positions-650m-satisfied"), entity_ref("urn:de:bgb:dw:positions-650m-satisfied:U")) { origin case_input; }
        assert "f3": zusaetzlicher_verguetungsanspruch_650m(entity_ref("urn:de:bgb:dw:positions-650m-satisfied"), 40000 EUR) { origin case_input; }
