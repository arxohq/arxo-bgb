language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 614 Satz 2: bei Vergütung nach Zeitabschnitten ist nach Ablauf des
// einzelnen Zeitabschnitts zu entrichten. Boundary zu t14.

test "urn:query:bgb-dw-t15-614-zeitabschnitt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": verguetung_nach_zeitabschnitten_bemessen(entity_ref("urn:de:bgb:dw:t15")) { origin case_input; }
        assert "f2": verguetungszeitabschnitt_ablauf_am(entity_ref("urn:de:bgb:dw:t15"), @2026-03-31) { origin case_input; }
    }
    evaluate truth(verguetung_faellig_am(entity_ref("urn:de:bgb:dw:t15"), @2026-03-31));
    expect truth_status == TRUE_ONLY;
}
