language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 621 Nr. 5 Halbsatz 2: nimmt das Dienstverhältnis die Erwerbstätigkeit
// voll oder hauptsächlich in Anspruch, gilt eine Frist von zwei Wochen.
// Boundary zu t27.

test "urn:query:bgb-dw-t28-621-zwei-wochen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f0": kein_arbeitsverhaeltnis_im_sinne_des_622(entity_ref("urn:de:bgb:dw:t28")) { origin case_input; }
        assert "f1": dienstverhaeltnis_unbestimmte_dauer(entity_ref("urn:de:bgb:dw:t28")) { origin case_input; }
        assert "f2": verguetung_nicht_nach_zeitabschnitten_bemessen_621(entity_ref("urn:de:bgb:dw:t28")) { origin case_input; }
        assert "f3": erwerbstaetigkeit_voll_oder_hauptsaechlich_beansprucht_621(entity_ref("urn:de:bgb:dw:t28")) { origin case_input; }
        assert "f4": kuendigungserklaerung_am(entity_ref("urn:de:bgb:dw:t28"), @2026-03-10) { origin case_input; }
    }
    evaluate truth(kuendigungstermin_621(entity_ref("urn:de:bgb:dw:t28"), @2026-03-24));
    expect truth_status == TRUE_ONLY;
}
