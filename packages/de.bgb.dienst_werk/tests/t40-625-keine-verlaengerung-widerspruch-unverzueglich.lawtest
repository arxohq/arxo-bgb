language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 625: unverzüglicher Widerspruch — keine stillschweigende Verlängerung.
// Boundary zu t39 (derselbe Widerspruch, nicht unverzüglich).

test "urn:query:bgb-dw-t40-625-unverzueglich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverhaeltnis_nach_ablauf_fortgesetzt(entity_ref("urn:de:bgb:dw:t40")) { origin case_input; }
        assert "f2": widerspruch_erklaert_625(entity_ref("urn:de:bgb:dw:t40")) { origin case_input; }
        assert "f3": widerspruch_625_unverzueglich(entity_ref("urn:de:bgb:dw:t40")) { origin adjudicated; }
    }
    evaluate truth(dienstverhaeltnis_verlaengert_625(entity_ref("urn:de:bgb:dw:t40")));
    expect truth_status == NEITHER;
}
