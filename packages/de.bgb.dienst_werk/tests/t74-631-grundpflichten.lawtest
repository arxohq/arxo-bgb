language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 631 Abs. 1: Herstellungs- und Vergütungspflicht des Werkvertrags.

test "urn:query:bgb-dw-t74-631-grundpflichten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": unternehmer(entity_ref("urn:de:bgb:dw:t74"), entity_ref("urn:de:bgb:dw:t74:U")) { origin case_input; }
        assert "f2": besteller(entity_ref("urn:de:bgb:dw:t74"), entity_ref("urn:de:bgb:dw:t74:B")) { origin case_input; }
        assert "f3": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:t74"), @2026-01-05) { origin case_input; }
        assert "f4": werk_hergestellt(entity_ref("urn:de:bgb:dw:t74")) { origin case_input; }
    }
    evaluate positions();
    expect position(HerstellungsPflicht631, SATISFIED);
    expect position(HerstellungsPflicht631Position, SATISFIED);
    expect position(WerkVerguetungsPflicht631, ACTIVE);
}

test "urn:query:bgb-dw-t74-631-herstellung-active-position" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": unternehmer(entity_ref("urn:de:bgb:dw:t74-active"), entity_ref("urn:de:bgb:dw:t74-active:U")) { origin case_input; }
        assert "f2": besteller(entity_ref("urn:de:bgb:dw:t74-active"), entity_ref("urn:de:bgb:dw:t74-active:B")) { origin case_input; }
        assert "f3": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:t74-active"), @2026-01-05) { origin case_input; }
    }
    evaluate positions();
    expect position(HerstellungsPflicht631Position, ACTIVE);
}
