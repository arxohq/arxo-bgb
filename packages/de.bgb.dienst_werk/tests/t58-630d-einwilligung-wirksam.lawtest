language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630d Abs. 2 in Verbindung mit § 630e Abs. 2: die Einwilligung ist wirksam, weil ordnungsgemäß aufgeklärt wurde.

test "urn:query:bgb-dw-t58-630d-einwilligung-wirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": einwilligung_eingeholt_630d(entity_ref("urn:de:bgb:dw:t58")) { origin case_input; }
        assert "f2": ueber_wesentliche_umstaende_aufgeklaert_630e(entity_ref("urn:de:bgb:dw:t58")) { origin case_input; }
        assert "f3": aufklaerung_muendlich_630e(entity_ref("urn:de:bgb:dw:t58")) { origin case_input; }
        assert "f4": aufklaerung_rechtzeitig_630e(entity_ref("urn:de:bgb:dw:t58")) { origin adjudicated; }
        assert "f5": aufklaerung_verstaendlich_630e(entity_ref("urn:de:bgb:dw:t58")) { origin adjudicated; }
    }
    evaluate truth(einwilligung_wirksam_630d(entity_ref("urn:de:bgb:dw:t58")));
    expect truth_status == TRUE_ONLY;
}
