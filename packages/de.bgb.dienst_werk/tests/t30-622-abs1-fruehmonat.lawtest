language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 622 Abs. 1: vier Wochen zum Fünfzehnten — die Vierwochenfrist endet
// genau am 15. März. Boundary zu t31 (einen Tag später).

test "urn:query:bgb-dw-t30-622-fruehmonat" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": arbeitsvertrag_gesamtbetrachtung(entity_ref("urn:de:bgb:dw:t30")) { origin adjudicated; }
        assert "f1a": arbeitnehmerkuendigung(entity_ref("urn:de:bgb:dw:t30")) { origin case_input; }
        assert "f1b": nicht_in_probezeit_622(entity_ref("urn:de:bgb:dw:t30")) { origin case_input; }
        assert "f2": kuendigungserklaerung_am(entity_ref("urn:de:bgb:dw:t30"), @2026-02-15) { origin case_input; }
    }
    evaluate truth(kuendigungstermin_622(entity_ref("urn:de:bgb:dw:t30"), @2026-03-15));
    expect truth_status == TRUE_ONLY;
}
