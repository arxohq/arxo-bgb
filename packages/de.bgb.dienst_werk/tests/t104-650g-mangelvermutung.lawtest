language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650g Abs. 3 Satz 1: der offenkundige, in der Zustandsfeststellung nicht angegebene Mangel gilt als nach ihr entstanden und vom Besteller zu vertreten.

test "urn:query:bgb-dw-t104-650g-mangelvermutung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": werk_dem_besteller_verschafft_650g(entity_ref("urn:de:bgb:dw:t104")) { origin case_input; }
        assert "f2": offenkundiger_mangel_nicht_angegeben_650g(entity_ref("urn:de:bgb:dw:t104")) { origin case_input; }
    }
    evaluate truth(mangel_nach_zustandsfeststellung_entstanden_650g(entity_ref("urn:de:bgb:dw:t104")));
    expect truth_status == TRUE_ONLY;
}
