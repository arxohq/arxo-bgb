language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 648a Abs. 1, 5: Kündigung aus wichtigem Grund; der Unternehmer kann nur die auf den erbrachten Teil entfallende Vergütung verlangen.

test "urn:query:bgb-dw-t80-648a-wichtiger-grund" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": wichtiger_grund_648a(entity_ref("urn:de:bgb:dw:t80"), entity_ref("urn:de:bgb:dw:t80:U")) { origin adjudicated; }
        assert "f2": verguetung_fuer_erbrachten_teil_648a(entity_ref("urn:de:bgb:dw:t80"), 7500 EUR) { origin case_input; }
    }
    evaluate truth(verguetungsanspruch_nach_648a(entity_ref("urn:de:bgb:dw:t80"), 7500 EUR));
    expect truth_status == TRUE_ONLY;
}
