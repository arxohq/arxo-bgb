language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650v: der Bauträger kann Abschlagszahlungen nur verlangen, soweit sie gemäß einer Verordnung auf Grund von Artikel 244 EGBGB vereinbart sind.

test "urn:query:bgb-dw-t120-650v-abschlagszahlungen" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": errichtung_oder_umbau_eines_hauses_650u(entity_ref("urn:de:bgb:dw:t120")) { origin case_input; }
        assert "f2": pflicht_zur_eigentums_oder_erbbaurechtsuebertragung_650u(entity_ref("urn:de:bgb:dw:t120")) { origin case_input; }
        assert "f3": abschlagszahlungen_nach_verordnung_vereinbart_650v(entity_ref("urn:de:bgb:dw:t120")) { origin case_input; }
    }
    evaluate truth(abschlagszahlungsanspruch_650v(entity_ref("urn:de:bgb:dw:t120")));
    expect truth_status == TRUE_ONLY;
}
