language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651q Abs. 1, 2: dem in Schwierigkeiten geratenen Reisenden ist unverzüglich Beistand zu gewähren; hat er die Umstände schuldhaft selbst herbeigeführt, kann der Veranstalter Aufwendungsersatz verlangen.

test "urn:query:bgb-dw-t140-651q-beistand" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t140")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t140")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t140")) { origin case_input; }
        assert "f4": reisender_in_schwierigkeiten_651q(entity_ref("urn:de:bgb:dw:t140")) { origin case_input; }
        assert "f5": reiseveranstalter(entity_ref("urn:de:bgb:dw:t140"), entity_ref("urn:de:bgb:dw:t140:V")) { origin case_input; }
        assert "f6": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:t140"), @2026-05-01) { origin case_input; }
        assert "f7": schwierigkeiten_selbst_herbeigefuehrt_651q(entity_ref("urn:de:bgb:dw:t140")) { origin case_input; }
    }
    evaluate positions();
    expect position(BeistandGewaehren651q, ACTIVE);
    evaluate truth(aufwendungsersatzanspruch_651q(entity_ref("urn:de:bgb:dw:t140")));
    expect truth_status == TRUE_ONLY;
}
