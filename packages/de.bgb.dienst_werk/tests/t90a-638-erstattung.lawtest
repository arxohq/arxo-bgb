language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 638 Abs. 4 Satz 1: der Besteller hat 10 000 EUR gezahlt, geschuldet sind nach der Minderung 8 000,00 EUR — 2 000,00 EUR sind zu erstatten.

test "urn:query:bgb-dw-t90a-638-erstattung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": beschaffenheit_vereinbart_633(entity_ref("urn:de:bgb:dw:t90a")) { origin case_input; }
        assert "f2": not vereinbarte_beschaffenheit_erfuellt_633(entity_ref("urn:de:bgb:dw:t90a")) { origin case_input; }
        assert "f3": minderung_erklaert_638(entity_ref("urn:de:bgb:dw:t90a")) { origin case_input; }
        assert "f4": ein_beteiligter_je_seite_638(entity_ref("urn:de:bgb:dw:t90a")) { origin case_input; }
        assert "f5": vereinbarte_werkverguetung(entity_ref("urn:de:bgb:dw:t90a"), 10000 EUR) { origin case_input; }
        assert "f6": wert_ohne_mangel_638(entity_ref("urn:de:bgb:dw:t90a"), 100) { origin case_input; }
        assert "f7": wirklicher_wert_638(entity_ref("urn:de:bgb:dw:t90a"), 80) { origin case_input; }
        assert "f8": mehr_als_geminderte_verguetung_gezahlt_638(entity_ref("urn:de:bgb:dw:t90a"), 10000 EUR) { origin case_input; }
    }
    evaluate truth(erstattungsanspruch_638(entity_ref("urn:de:bgb:dw:t90a"), 2000.00 EUR));
    expect truth_status == TRUE_ONLY;
}
