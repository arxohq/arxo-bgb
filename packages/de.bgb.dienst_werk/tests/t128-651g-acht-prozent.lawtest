language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651g Abs. 1: Reisepreis 2 000 EUR — die Grenze der einseitigen Erhöhung sind 160,00 EUR; eine vorbehaltene Erhöhung von 200 EUR übersteigt sie.

test "urn:query:bgb-dw-t128-651g-acht-prozent" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t128")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t128")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t128")) { origin case_input; }
        assert "f4": reisepreis(entity_ref("urn:de:bgb:dw:t128"), 2000 EUR) { origin case_input; }
        assert "f5": vorbehaltene_preiserhoehung_651g(entity_ref("urn:de:bgb:dw:t128"), 200 EUR) { origin case_input; }
    }
    evaluate truth(acht_prozent_grenze_651g(entity_ref("urn:de:bgb:dw:t128"), 160.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(einseitige_erhoehung_ausgeschlossen_651g(entity_ref("urn:de:bgb:dw:t128")));
    expect truth_status == TRUE_ONLY;
}
