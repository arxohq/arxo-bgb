language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630c Abs. 3 Satz 1: die Kosteninformation erfolgte am 5. Januar, die Behandlung begann am 10. Januar — rechtzeitig.

test "urn:query:bgb-dw-t56-630c-kosteninformation" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:t56"), @2026-01-10) { origin case_input; }
        assert "f2": kosteninformation_erfolgt_am_630c(entity_ref("urn:de:bgb:dw:t56"), @2026-01-05) { origin case_input; }
    }
    evaluate truth(kosteninformation_rechtzeitig_630c(entity_ref("urn:de:bgb:dw:t56")));
    expect truth_status == TRUE_ONLY;
}
