language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650g Abs. 4 Satz 3 mit § 193: Zugang der Schlussrechnung am 30. Januar 2026, kalendarisches Ende der Dreißigtagefrist am 1. März 2026 (Sonntag), Ende nach der Verlegung am Montag, dem 2. März; ohne Einwendungen gilt die Rechnung als prüffähig und die Vergütung ist zu entrichten.

test "urn:query:bgb-dw-t105-650g-schlussrechnung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:t105")) { origin case_input; }
        assert "f2": schlussrechnung_zugegangen_am_650g(entity_ref("urn:de:bgb:dw:t105"), @2026-01-30) { origin case_input; }
        assert "f3": keine_begruendeten_einwendungen_650g(entity_ref("urn:de:bgb:dw:t105")) { origin case_input; }
        assert "f4": abnahme_am(entity_ref("urn:de:bgb:dw:t105"), @2026-03-10) { origin case_input; }
    }
    evaluate truth(einwendungsfrist_kalenderende_650g(entity_ref("urn:de:bgb:dw:t105"), @2026-03-01));
    expect truth_status == TRUE_ONLY;
    evaluate truth(einwendungsfrist_ende_650g(entity_ref("urn:de:bgb:dw:t105"), @2026-03-02));
    expect truth_status == TRUE_ONLY;
    evaluate truth(bauverguetung_faellig_650g(entity_ref("urn:de:bgb:dw:t105")));
    expect truth_status == TRUE_ONLY;
}
