language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630f Abs. 3: zehn Jahre Aufbewahrung ab Abschluss der Behandlung — Abschluss 15. März 2026, Ende 15. März 2036.

test "urn:query:bgb-dw-t60-630f-aufbewahrung-zehn-jahre" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandlung_abgeschlossen_am_630f(entity_ref("urn:de:bgb:dw:t60"), @2026-03-15) { origin case_input; }
        assert "f2": keine_andere_aufbewahrungsfrist_630f(entity_ref("urn:de:bgb:dw:t60")) { origin case_input; }
    }
    evaluate truth(aufbewahrungsfrist_ende_630f(entity_ref("urn:de:bgb:dw:t60"), @2036-03-15));
    expect truth_status == TRUE_ONLY;
}
