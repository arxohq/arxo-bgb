language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// Korridor 2018: am ersten Tag des Korridors gilt das Kapitel 2 — derselbe Sachverhalt mit legal_time 1. Januar 2018.

test "urn:query:bgb-dw-t99b-650a-korridor-2018" {
    given {
        context { legal_time @2018-01-01; decision_time @2018-01-01T09:00:00Z; knowledge_time @2018-01-01T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:t99b")) { origin case_input; }
    }
    evaluate truth(bauvertrag_650a(entity_ref("urn:de:bgb:dw:t99b")));
    expect truth_status == TRUE_ONLY;
}
