language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 627 Abs. 1: Dienste höherer Art ohne dauerndes Dienstverhältnis mit
// festen Bezügen erlauben die Kündigung auch ohne § 626-Voraussetzung.

test "urn:query:bgb-dw-t43-627-vertrauensstellung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": kein_arbeitsverhaeltnis_im_sinne_des_622(entity_ref("urn:de:bgb:dw:t43")) { origin case_input; }
        assert "f2": kein_dauerndes_dienstverhaeltnis_mit_festen_bezuegen(entity_ref("urn:de:bgb:dw:t43")) { origin case_input; }
        assert "f3": dienste_hoeherer_art_auf_grund_besonderen_vertrauens(entity_ref("urn:de:bgb:dw:t43")) { origin adjudicated; }
    }
    evaluate truth(ausserordentliche_kuendigung_zulaessig_627(entity_ref("urn:de:bgb:dw:t43")));
    expect truth_status == TRUE_ONLY;
}
