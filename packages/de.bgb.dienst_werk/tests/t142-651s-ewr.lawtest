language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651s: der im Europäischen Wirtschaftsraum niedergelassene Veranstalter genügt seiner Pflicht zur Insolvenzsicherung auch durch die dortige Sicherheit.

test "urn:query:bgb-dw-t142-651s-ewr" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": mindestens_zwei_arten_von_reiseleistungen_651a(entity_ref("urn:de:bgb:dw:t142")) { origin case_input; }
        assert "f2": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t142")) { origin case_input; }
        assert "f3": kein_ausschlussfall_651a_abs5(entity_ref("urn:de:bgb:dw:t142")) { origin case_input; }
        assert "f4": niederlassung_im_ewr_651s(entity_ref("urn:de:bgb:dw:t142")) { origin case_input; }
    }
    evaluate truth(insolvenzsicherung_genuegt_651s(entity_ref("urn:de:bgb:dw:t142")));
    expect truth_status == TRUE_ONLY;
}
