language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651x Nr. 2: der Fehler während des Buchungsvorgangs begründet den Schadensersatzanspruch, wenn er weder vom Reisenden verschuldet noch durch außergewöhnliche Umstände verursacht ist.

test "urn:query:bgb-dw-t146-651x-buchungsfehler" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": fehler_waehrend_des_buchungsvorgangs_651x(entity_ref("urn:de:bgb:dw:t146")) { origin case_input; }
        assert "f2": kein_ausschluss_651x_nr2(entity_ref("urn:de:bgb:dw:t146")) { origin case_input; }
    }
    evaluate truth(schadensersatzanspruch_651x(entity_ref("urn:de:bgb:dw:t146")));
    expect truth_status == TRUE_ONLY;
}
