language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651a Abs. 4: eine Art von Reiseleistung mit touristischen Leistungen von 20 Prozent des Gesamtwertes — keine Pauschalreise.

test "urn:query:bgb-dw-t122-651a-abs4-fuenfundzwanzig-prozent" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": nur_eine_art_mit_touristischen_leistungen_651a(entity_ref("urn:de:bgb:dw:t122")) { origin case_input; }
        assert "f2": touristische_leistungen_anteil_651a(entity_ref("urn:de:bgb:dw:t122"), 20) { origin case_input; }
    }
    evaluate truth(keine_pauschalreise_651a(entity_ref("urn:de:bgb:dw:t122")));
    expect truth_status == TRUE_ONLY;
}
