language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 622 Abs. 1: liegt der 15. vor dem Ende der Vierwochenfrist, ist frühester
// Termin das Monatsende. Boundary zu t30 (einen Tag früher).

test "urn:query:bgb-dw-t31-622-monatsende" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": arbeitsvertrag_gesamtbetrachtung(entity_ref("urn:de:bgb:dw:t31")) { origin adjudicated; }
        assert "f1a": arbeitnehmerkuendigung(entity_ref("urn:de:bgb:dw:t31")) { origin case_input; }
        assert "f1b": nicht_in_probezeit_622(entity_ref("urn:de:bgb:dw:t31")) { origin case_input; }
        assert "f2": kuendigungserklaerung_am(entity_ref("urn:de:bgb:dw:t31"), @2026-02-16) { origin case_input; }
    }
    evaluate truth(kuendigungstermin_622(entity_ref("urn:de:bgb:dw:t31"), @2026-03-31));
    expect truth_status == TRUE_ONLY;
}
