language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 621 Nr. 4 Gegenprobe: die Kündigung vom 25. Mai wahrt die Sechswochenfrist zum 30. Juni nicht (6. Juli). Boundary zu t113.

test "urn:query:bgb-dw-t113a-621-nr4-frist-verfehlt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": kein_arbeitsverhaeltnis_im_sinne_des_622(entity_ref("urn:de:bgb:dw:t113a")) { origin case_input; }
        assert "f2": dienstverhaeltnis_unbestimmte_dauer(entity_ref("urn:de:bgb:dw:t113a")) { origin case_input; }
        assert "f3": verguetung_nach_vierteljahren_bemessen_621(entity_ref("urn:de:bgb:dw:t113a")) { origin case_input; }
        assert "f4": kalendervierteljahr_beginn_621(entity_ref("urn:de:bgb:dw:t113a"), @2026-04-01) { origin case_input; }
        assert "f5": kuendigungserklaerung_am(entity_ref("urn:de:bgb:dw:t113a"), @2026-05-25) { origin case_input; }
    }
    evaluate truth(kuendigungstermin_621(entity_ref("urn:de:bgb:dw:t113a"), @2026-06-30));
    expect truth_status == NEITHER;
}
