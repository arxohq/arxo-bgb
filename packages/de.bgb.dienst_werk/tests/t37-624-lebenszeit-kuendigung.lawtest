language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 624: nach fünf Jahren kann das auf Lebenszeit eingegangene
// Dienstverhältnis mit sechs Monaten Frist gekündigt werden.

test "urn:query:bgb-dw-t37-624-lebenszeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverhaeltnis_auf_lebenszeit(entity_ref("urn:de:bgb:dw:t37")) { origin case_input; }
        assert "f2": dienstbeginn_am(entity_ref("urn:de:bgb:dw:t37"), @2021-01-10) { origin case_input; }
        assert "f3": kuendigungserklaerung_am(entity_ref("urn:de:bgb:dw:t37"), @2026-01-10) { origin case_input; }
    }
    evaluate truth(kuendigungstermin_624(entity_ref("urn:de:bgb:dw:t37"), @2026-07-10));
    expect truth_status == TRUE_ONLY;
}
