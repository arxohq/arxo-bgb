language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 613a Abs. 1 Satz 1: der neue Inhaber tritt in die Rechte und Pflichten
// des Arbeitsverhältnisses ein.

test "urn:query:bgb-dw-t10-613a-eintritt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": betriebsuebergang(entity_ref("urn:de:bgb:dw:t10"), entity_ref("urn:de:bgb:dw:t10:alt"), entity_ref("urn:de:bgb:dw:t10:neu"), @2026-03-01) { origin case_input; }
    }
    evaluate truth(rechte_und_pflichten_eintritt_613a(entity_ref("urn:de:bgb:dw:t10"), entity_ref("urn:de:bgb:dw:t10:neu")));
    expect truth_status == TRUE_ONLY;
}
