language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630h Abs. 2 Satz 1 Gegenbeweis: der Behandelnde beweist Einwilligung und ordnungsgemäße Aufklärung. Boundary zu t67.

test "urn:query:bgb-dw-t68-630h-abs2-beweis-gefuehrt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": massnahme_durchgefuehrt_630h(entity_ref("urn:de:bgb:dw:t68")) { origin case_input; }
        assert "f2": beweis_der_einwilligung_und_aufklaerung_gefuehrt_630h(entity_ref("urn:de:bgb:dw:t68")) { origin case_input; }
    }
    evaluate truth(einwilligung_oder_aufklaerung_nicht_nachgewiesen_630h(entity_ref("urn:de:bgb:dw:t68")));
    expect truth_status == FALSE_ONLY;
}
