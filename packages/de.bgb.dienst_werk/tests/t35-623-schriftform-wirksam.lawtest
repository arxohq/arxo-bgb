language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 623: die schriftliche Kündigung erfüllt das Formerfordernis. Boundary
// zu t36 (elektronische Form).

test "urn:query:bgb-dw-t35-623-wirksam" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": arbeitsvertrag_gesamtbetrachtung(entity_ref("urn:de:bgb:dw:t35")) { origin adjudicated; }
        assert "f2": kuendigung_in_schriftform(entity_ref("urn:de:bgb:dw:t35")) { origin case_input; }
    }
    evaluate truth(kuendigung_623_wirksam(entity_ref("urn:de:bgb:dw:t35")));
    expect truth_status == TRUE_ONLY;
}
