language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650f Abs. 1 Satz 1: Sicherheit für 100 000 EUR Vergütung zuzüglich 10 Prozent Nebenforderungen — 110 000,00 EUR.

test "urn:query:bgb-dw-t102-650f-zehn-prozent" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": herstellung_oder_umbau_eines_bauwerks_650a(entity_ref("urn:de:bgb:dw:t102")) { origin case_input; }
        assert "f2": nicht_gezahlte_verguetung_650f(entity_ref("urn:de:bgb:dw:t102"), 100000 EUR) { origin case_input; }
        assert "f3": kein_ausnahmefall_650f_abs6(entity_ref("urn:de:bgb:dw:t102")) { origin case_input; }
    }
    evaluate truth(sicherheitsbetrag_650f(entity_ref("urn:de:bgb:dw:t102"), 110000.00 EUR));
    expect truth_status == TRUE_ONLY;
    evaluate truth(sicherheitsanspruch_650f(entity_ref("urn:de:bgb:dw:t102")));
    expect truth_status == TRUE_ONLY;
}
