language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650g Abs. 3 Satz 2: kann der Mangel nach seiner Art nicht vom Besteller verursacht worden sein, greift die Vermutung nicht. Boundary zu t104.

test "urn:query:bgb-dw-t104a-650g-mangelvermutung-widerlegt" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": werk_dem_besteller_verschafft_650g(entity_ref("urn:de:bgb:dw:t104a")) { origin case_input; }
        assert "f2": offenkundiger_mangel_nicht_angegeben_650g(entity_ref("urn:de:bgb:dw:t104a")) { origin case_input; }
        assert "f3": mangel_nach_art_nicht_vom_besteller_verursachbar_650g(entity_ref("urn:de:bgb:dw:t104a")) { origin case_input; }
    }
    evaluate truth(mangel_nach_zustandsfeststellung_entstanden_650g(entity_ref("urn:de:bgb:dw:t104a")));
    expect truth_status == FALSE_ONLY;
}
