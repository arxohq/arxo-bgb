language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650r Abs. 3: nach der Sonderkündigung kann der Unternehmer nur die auf die erbrachten Leistungen entfallende Vergütung verlangen.

test "urn:query:bgb-dw-t117-650r-abs3-verguetung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": architekten_oder_ingenieurvertrag_650p(entity_ref("urn:de:bgb:dw:t117")) { origin case_input; }
        assert "f2": unterlagen_vorgelegt_am_650p(entity_ref("urn:de:bgb:dw:t117"), @2026-03-02) { origin case_input; }
        assert "f3": sonderkuendigung_erklaert_am_650r(entity_ref("urn:de:bgb:dw:t117"), @2026-03-16) { origin case_input; }
        assert "f4": besteller_ist_kein_verbraucher_650r(entity_ref("urn:de:bgb:dw:t117")) { origin case_input; }
        assert "f5": verguetung_fuer_erbrachte_leistungen_650r(entity_ref("urn:de:bgb:dw:t117"), 4200 EUR) { origin case_input; }
    }
    evaluate truth(verguetungsanspruch_nach_650r(entity_ref("urn:de:bgb:dw:t117"), 4200 EUR));
    expect truth_status == TRUE_ONLY;
}
