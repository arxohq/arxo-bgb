language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630g Abs. 1 Satz 1: Einsicht auf Verlangen, unverzüglich gewährt.

test "urn:query:bgb-dw-t62-630g-einsicht-unverzueglich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:t62"), entity_ref("urn:de:bgb:dw:t62:A")) { origin case_input; }
        assert "f2": patient(entity_ref("urn:de:bgb:dw:t62"), entity_ref("urn:de:bgb:dw:t62:P")) { origin case_input; }
        assert "f3": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:t62"), @2026-01-10) { origin case_input; }
        assert "f4": einsichtsverlangen_630g(entity_ref("urn:de:bgb:dw:t62"), entity_ref("urn:de:bgb:dw:t62:P")) { origin case_input; }
        assert "f5": kein_ausschlussgrund_630g(entity_ref("urn:de:bgb:dw:t62")) { origin case_input; }
        assert "f6": einsicht_gewaehrt_630g(entity_ref("urn:de:bgb:dw:t62"), entity_ref("urn:de:bgb:dw:t62:P")) { origin case_input; }
        assert "f7": einsichtgewaehrung_unverzueglich_630g(entity_ref("urn:de:bgb:dw:t62")) { origin adjudicated; }
    }
    evaluate truth(einsichtsrecht_630g_erfuellt(entity_ref("urn:de:bgb:dw:t62"), entity_ref("urn:de:bgb:dw:t62:P")));
    expect truth_status == TRUE_ONLY;
}
