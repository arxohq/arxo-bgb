language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 629: nach der Kündigung eines dauernden Dienstverhältnisses ist auf
// Verlangen angemessene Zeit zur Stellungssuche zu gewähren.

test "urn:query:bgb-dw-t47-629-freizeit" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverpflichteter(entity_ref("urn:de:bgb:dw:t47"), entity_ref("urn:de:bgb:dw:t47:V")) { origin case_input; }
        assert "f2": dienstberechtigter(entity_ref("urn:de:bgb:dw:t47"), entity_ref("urn:de:bgb:dw:t47:B")) { origin case_input; }
        assert "f3": dienstbeginn_am(entity_ref("urn:de:bgb:dw:t47"), @2026-01-01) { origin case_input; }
        assert "f4": dauerndes_dienstverhaeltnis(entity_ref("urn:de:bgb:dw:t47")) { origin case_input; }
        assert "f5": kuendigung_erklaert_629(entity_ref("urn:de:bgb:dw:t47")) { origin case_input; }
        assert "f6": freizeit_verlangt_629(entity_ref("urn:de:bgb:dw:t47")) { origin case_input; }
    }
    evaluate positions();
    expect position(FreizeitGewaehren629, ACTIVE);
}
