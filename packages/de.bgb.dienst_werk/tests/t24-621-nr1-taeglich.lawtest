language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 621 Nr. 1: Vergütung nach Tagen — Kündigung an jedem Tag für den Ablauf
// des folgenden Tages.

test "urn:query:bgb-dw-t24-621-taeglich" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f0": kein_arbeitsverhaeltnis_im_sinne_des_622(entity_ref("urn:de:bgb:dw:t24")) { origin case_input; }
        assert "f1": dienstverhaeltnis_unbestimmte_dauer(entity_ref("urn:de:bgb:dw:t24")) { origin case_input; }
        assert "f2": verguetung_nach_tagen_bemessen_621(entity_ref("urn:de:bgb:dw:t24")) { origin case_input; }
        assert "f3": kuendigungserklaerung_am(entity_ref("urn:de:bgb:dw:t24"), @2026-03-10) { origin case_input; }
    }
    evaluate truth(kuendigungstermin_621(entity_ref("urn:de:bgb:dw:t24"), @2026-03-11));
    expect truth_status == TRUE_ONLY;
}
