language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 634a Abs. 3 Satz 1: bei arglistigem Verschweigen gilt statt der Zweijahresfrist die regelmäßige Verjährungsfrist, die de.bgb.fristen vom Schluss des Jahres rechnet — Abnahme und Kenntnis 2024, Ablauf mit dem 31. Dezember 2027.

test "urn:query:bgb-dw-t98-634a-arglist-regelfrist" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": werkmaengelanspruch(entity_ref("urn:de:bgb:dw:t98:A"), entity_ref("urn:de:bgb:dw:t98")) { origin case_input; }
        assert "f2": werk_ist_sachbezogen_634a(entity_ref("urn:de:bgb:dw:t98")) { origin case_input; }
        assert "f3": not werk_ist_bauwerksbezogen_634a(entity_ref("urn:de:bgb:dw:t98")) { origin case_input; }
        assert "f4": abnahme_am(entity_ref("urn:de:bgb:dw:t98"), @2024-03-15) { origin case_input; }
        assert "f5": mangel_arglistig_verschwiegen_634a(entity_ref("urn:de:bgb:dw:t98")) { origin adjudicated; }
        assert "f6": de.bgb.core::anspruch_entstanden_am(entity_ref("urn:de:bgb:dw:t98:A"), @2024-03-15) { origin case_input; }
        assert "f7": de.bgb.fristen::kenntnis_erlangt_am(entity_ref("urn:de:bgb:dw:t98:A"), @2024-03-15) { origin adjudicated; }
    }
    evaluate truth(regelfrist_ende_634a(entity_ref("urn:de:bgb:dw:t98:A"), @2026-03-15));
    expect truth_status == TRUE_ONLY;
    evaluate truth(frist_ende_634a(entity_ref("urn:de:bgb:dw:t98:A"), @2027-12-31));
    expect truth_status == TRUE_ONLY;
}
