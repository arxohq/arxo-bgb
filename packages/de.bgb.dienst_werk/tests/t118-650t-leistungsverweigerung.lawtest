language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 650t: der Architekt kann die Leistung verweigern, solange der Besteller dem bauausführenden Unternehmer keine erfolglose Nacherfüllungsfrist gesetzt hat.

test "urn:query:bgb-dw-t118-650t-leistungsverweigerung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": inanspruchnahme_wegen_ueberwachungsfehlers_650t(entity_ref("urn:de:bgb:dw:t118")) { origin case_input; }
        assert "f2": bauausfuehrender_haftet_ebenfalls_650t(entity_ref("urn:de:bgb:dw:t118")) { origin case_input; }
        assert "f3": keine_erfolglose_nacherfuellungsfrist_gegen_bauausfuehrenden_650t(entity_ref("urn:de:bgb:dw:t118")) { origin case_input; }
    }
    evaluate truth(leistungsverweigerungsrecht_650t(entity_ref("urn:de:bgb:dw:t118")));
    expect truth_status == TRUE_ONLY;
}
