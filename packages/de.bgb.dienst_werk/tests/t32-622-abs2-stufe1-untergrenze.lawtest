language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 622 Abs. 2 Satz 1 Nr. 1: nach zwei Jahren Bestand ein Monat zum
// Monatsende. Genau zwei Jahre Bestand genügt. Boundary zu t33 (kurz davor,
// noch Grundfrist).

test "urn:query:bgb-dw-t32-622-stufe1" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": arbeitsvertrag_gesamtbetrachtung(entity_ref("urn:de:bgb:dw:t32")) { origin adjudicated; }
        assert "f2": arbeitgeberkuendigung(entity_ref("urn:de:bgb:dw:t32")) { origin case_input; }
        assert "f3": beschaeftigt_seit(entity_ref("urn:de:bgb:dw:t32"), @2024-03-10) { origin case_input; }
        assert "f4": kuendigungserklaerung_am(entity_ref("urn:de:bgb:dw:t32"), @2026-03-10) { origin case_input; }
    }
    evaluate truth(kuendigungstermin_622(entity_ref("urn:de:bgb:dw:t32"), @2026-04-30));
    expect truth_status == TRUE_ONLY;
}
