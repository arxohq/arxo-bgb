language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 611: Grundpflichten des Dienstvertrags. Die Dienstepflicht des Verpflichteten
// ist erfüllt (die Dienste wurden geleistet); die Vergütungspflicht des
// Berechtigten ist noch offen.

test "urn:query:bgb-dw-t01-611-pflichten" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstverpflichteter(entity_ref("urn:de:bgb:dw:t01"), entity_ref("urn:de:bgb:dw:t01:V")) { origin case_input; }
        assert "f2": dienstberechtigter(entity_ref("urn:de:bgb:dw:t01"), entity_ref("urn:de:bgb:dw:t01:B")) { origin case_input; }
        assert "f3": dienstbeginn_am(entity_ref("urn:de:bgb:dw:t01"), @2026-01-01) { origin case_input; }
        assert "f4": dienstleistung_erbracht_am(entity_ref("urn:de:bgb:dw:t01"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(DienstePflicht611, SATISFIED);
    expect position(VerguetungsPflicht611, ACTIVE);
}
