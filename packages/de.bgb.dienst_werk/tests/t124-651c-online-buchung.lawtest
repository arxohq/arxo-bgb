language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 651c Abs. 1, 2: das verbundene Online-Buchungsverfahren macht den Unternehmer zum Reiseveranstalter; die Verträge gelten zusammen als ein Pauschalreisevertrag.

test "urn:query:bgb-dw-t124-651c-online-buchung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": online_buchungsverfahren_vertrag_651c(entity_ref("urn:de:bgb:dw:t124")) { origin case_input; }
        assert "f2": zugriff_auf_fremdes_buchungsverfahren_651c(entity_ref("urn:de:bgb:dw:t124")) { origin case_input; }
        assert "f3": daten_uebermittelt_651c(entity_ref("urn:de:bgb:dw:t124")) { origin case_input; }
        assert "f4": weiterer_vertrag_binnen_24_stunden_651c(entity_ref("urn:de:bgb:dw:t124")) { origin case_input; }
        assert "f5": kein_ausschlussfall_651a_abs4(entity_ref("urn:de:bgb:dw:t124")) { origin case_input; }
    }
    evaluate truth(als_reiseveranstalter_anzusehen_651c(entity_ref("urn:de:bgb:dw:t124")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(pauschalreise_651a(entity_ref("urn:de:bgb:dw:t124")));
    expect truth_status == TRUE_ONLY;
}
