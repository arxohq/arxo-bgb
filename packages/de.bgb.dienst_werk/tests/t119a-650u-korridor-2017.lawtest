language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// Korridor 2018 (Art. 229 § 39 EGBGB): vor dem 1. Januar 2018 schweigt der Untertitel 4 — derselbe Sachverhalt wie t119 mit legal_time 31. Dezember 2017. Boundary zu t119.

test "urn:query:bgb-dw-t119a-650u-korridor-2017" {
    given {
        context { legal_time @2017-12-31; decision_time @2017-12-31T09:00:00Z; knowledge_time @2017-12-31T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": errichtung_oder_umbau_eines_hauses_650u(entity_ref("urn:de:bgb:dw:t119a")) { origin case_input; }
        assert "f2": pflicht_zur_eigentums_oder_erbbaurechtsuebertragung_650u(entity_ref("urn:de:bgb:dw:t119a")) { origin case_input; }
    }
    evaluate truth(bautraegervertrag_650u(entity_ref("urn:de:bgb:dw:t119a")));
    expect truth_status == NEITHER;
}
