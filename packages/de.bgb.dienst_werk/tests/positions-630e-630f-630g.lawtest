language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 630e, 630f, 630g: Aufklärung, Behandlungsakte und Einsicht.

test "urn:query:bgb-dw-positions-630e-630f-630g-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:positions-630e"), entity_ref("urn:de:bgb:dw:positions-630e:A")) { origin case_input; }
        assert "f2": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630e"), @2026-01-10) { origin case_input; }
        assert "f3": medizinische_massnahme_geplant_630d(entity_ref("urn:de:bgb:dw:positions-630e")) { origin case_input; }
        assert "f4": aufklaerung_nicht_entbehrlich_630e(entity_ref("urn:de:bgb:dw:positions-630e")) { origin case_input; }
        assert "f5": behandelnder(entity_ref("urn:de:bgb:dw:positions-630f"), entity_ref("urn:de:bgb:dw:positions-630f:A")) { origin case_input; }
        assert "f6": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630f"), @2026-01-10) { origin case_input; }
        assert "f7": behandelnder(entity_ref("urn:de:bgb:dw:positions-630g"), entity_ref("urn:de:bgb:dw:positions-630g:A")) { origin case_input; }
        assert "f8": patient(entity_ref("urn:de:bgb:dw:positions-630g"), entity_ref("urn:de:bgb:dw:positions-630g:P")) { origin case_input; }
        assert "f9": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630g"), @2026-01-10) { origin case_input; }
        assert "f10": einsichtsverlangen_630g(entity_ref("urn:de:bgb:dw:positions-630g"), entity_ref("urn:de:bgb:dw:positions-630g:P")) { origin case_input; }
        assert "f11": kein_ausschlussgrund_630g(entity_ref("urn:de:bgb:dw:positions-630g")) { origin case_input; }
    }
    evaluate positions();
    expect position(AufklaerungsPflicht630e, ACTIVE);
    expect position(BehandlungsakteFuehren630f, ACTIVE);
    expect position(MassnahmenAufzeichnen630f, ACTIVE);
    expect position(EinsichtGewaehren630g, ACTIVE);
}

test "urn:query:bgb-dw-positions-630e-630f-630g-satisfied" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:positions-630e-satisfied"), entity_ref("urn:de:bgb:dw:positions-630e-satisfied:A")) { origin case_input; }
        assert "f2": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630e-satisfied"), @2026-01-10) { origin case_input; }
        assert "f3": medizinische_massnahme_geplant_630d(entity_ref("urn:de:bgb:dw:positions-630e-satisfied")) { origin case_input; }
        assert "f4": aufklaerung_nicht_entbehrlich_630e(entity_ref("urn:de:bgb:dw:positions-630e-satisfied")) { origin case_input; }
        assert "f5": ueber_wesentliche_umstaende_aufgeklaert_630e(entity_ref("urn:de:bgb:dw:positions-630e-satisfied")) { origin case_input; }
        assert "f6": behandelnder(entity_ref("urn:de:bgb:dw:positions-630f-satisfied"), entity_ref("urn:de:bgb:dw:positions-630f-satisfied:A")) { origin case_input; }
        assert "f7": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630f-satisfied"), @2026-01-10) { origin case_input; }
        assert "f8": behandlungsakte_gefuehrt_630f(entity_ref("urn:de:bgb:dw:positions-630f-satisfied")) { origin case_input; }
        assert "f9": wesentliche_massnahmen_aufgezeichnet_630f(entity_ref("urn:de:bgb:dw:positions-630f-satisfied")) { origin case_input; }
        assert "f10": behandelnder(entity_ref("urn:de:bgb:dw:positions-630g-satisfied"), entity_ref("urn:de:bgb:dw:positions-630g-satisfied:A")) { origin case_input; }
        assert "f11": patient(entity_ref("urn:de:bgb:dw:positions-630g-satisfied"), entity_ref("urn:de:bgb:dw:positions-630g-satisfied:P")) { origin case_input; }
        assert "f12": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630g-satisfied"), @2026-01-10) { origin case_input; }
        assert "f13": einsichtsverlangen_630g(entity_ref("urn:de:bgb:dw:positions-630g-satisfied"), entity_ref("urn:de:bgb:dw:positions-630g-satisfied:P")) { origin case_input; }
        assert "f14": kein_ausschlussgrund_630g(entity_ref("urn:de:bgb:dw:positions-630g-satisfied")) { origin case_input; }
        assert "f15": einsicht_gewaehrt_630g(entity_ref("urn:de:bgb:dw:positions-630g-satisfied"), entity_ref("urn:de:bgb:dw:positions-630g-satisfied:P")) { origin case_input; }
    }
    evaluate positions();
    expect position(AufklaerungsPflicht630e, SATISFIED);
    expect position(BehandlungsakteFuehren630f, SATISFIED);
    expect position(MassnahmenAufzeichnen630f, SATISFIED);
    expect position(EinsichtGewaehren630g, SATISFIED);
}
