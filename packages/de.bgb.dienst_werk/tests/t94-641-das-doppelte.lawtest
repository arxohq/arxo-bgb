language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 641 Abs. 3: angemessen ist in der Regel das Doppelte der Mängelbeseitigungskosten — 1 200 EUR ergeben 2 400 EUR.

test "urn:query:bgb-dw-t94-641-das-doppelte" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": beschaffenheit_vereinbart_633(entity_ref("urn:de:bgb:dw:t94")) { origin case_input; }
        assert "f2": not vereinbarte_beschaffenheit_erfuellt_633(entity_ref("urn:de:bgb:dw:t94")) { origin case_input; }
        assert "f3": maengelbeseitigungskosten_641(entity_ref("urn:de:bgb:dw:t94"), 1200 EUR) { origin case_input; }
    }
    evaluate truth(zurueckbehaltungsbetrag_641(entity_ref("urn:de:bgb:dw:t94"), 2400 EUR));
    expect truth_status == TRUE_ONLY;
}
