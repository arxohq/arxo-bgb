language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// §§ 630e Abs. 5, 630g Abs. 2 Satz 2, 650l Satz 2 und 651q Abs. 1.

test "urn:query:bgb-dw-positions-630e-630g-650l-651q-active" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": behandelnder(entity_ref("urn:de:bgb:dw:positions-630eg"), entity_ref("urn:de:bgb:dw:positions-630eg:A")) { origin case_input; }
        assert "f2": behandlungsbeginn_am(entity_ref("urn:de:bgb:dw:positions-630eg"), @2026-02-01) { origin case_input; }
        assert "f3": einwilligung_des_berechtigten_einzuholen_630d(entity_ref("urn:de:bgb:dw:positions-630eg"), entity_ref("urn:de:bgb:dw:positions-630eg:B")) { origin case_input; }
        assert "f4": patient_zur_aufnahme_der_erlaeuterung_in_der_lage_630e(entity_ref("urn:de:bgb:dw:positions-630eg")) { origin case_input; }
        assert "f5": behandelnder(entity_ref("urn:de:bgb:dw:positions-630eg"), entity_ref("urn:de:bgb:dw:positions-630eg:A")) { origin case_input; }
        assert "f6": patient(entity_ref("urn:de:bgb:dw:positions-630eg"), entity_ref("urn:de:bgb:dw:positions-630eg:P")) { origin case_input; }
        assert "f7": erhebliche_therapeutische_gruende_630g(entity_ref("urn:de:bgb:dw:positions-630eg")) { origin case_input; }
        assert "f8": einsichtsverlangen_630g(entity_ref("urn:de:bgb:dw:positions-630eg"), entity_ref("urn:de:bgb:dw:positions-630eg:P")) { origin case_input; }
        assert "f9": verbraucherbauvertrag_650i(entity_ref("urn:de:bgb:dw:positions-650l")) { origin case_input; }
        assert "f10": verbraucher_als_besteller_650i(entity_ref("urn:de:bgb:dw:positions-650l"), entity_ref("urn:de:bgb:dw:positions-650l:V")) { origin case_input; }
        assert "f11": vertrag_nicht_notariell_beurkundet_650l(entity_ref("urn:de:bgb:dw:positions-650l")) { origin case_input; }
        assert "f12": unternehmer(entity_ref("urn:de:bgb:dw:positions-650l"), entity_ref("urn:de:bgb:dw:positions-650l:U")) { origin case_input; }
        assert "f13": werkvertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-650l"), @2026-01-10) { origin case_input; }
        assert "f14": pauschalreise_651a(entity_ref("urn:de:bgb:dw:positions-651q")) { origin case_input; }
        assert "f15": reisender_in_schwierigkeiten_651q(entity_ref("urn:de:bgb:dw:positions-651q")) { origin case_input; }
        assert "f16": reiseveranstalter(entity_ref("urn:de:bgb:dw:positions-651q"), entity_ref("urn:de:bgb:dw:positions-651q:V")) { origin case_input; }
        assert "f17": reisevertrag_geschlossen_am(entity_ref("urn:de:bgb:dw:positions-651q"), @2026-01-10) { origin case_input; }
    }
    evaluate positions();
    expect position(ErlaeuterungGegenueberPatient630e, ACTIVE);
    expect position(AblehnungBegruenden630g, ACTIVE);
    expect position(WiderrufsbelehrungErteilen650l, ACTIVE);
    expect position(BeistandGewaehren651q, ACTIVE);
}

