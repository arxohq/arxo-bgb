language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 621 Nr. 3: Kündigung nach dem 15. gilt für den Schluss des FOLGENDEN
// Kalendermonats. Boundary zu t25.

test "urn:query:bgb-dw-t26-621-monatlich-verspaetet" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f0": kein_arbeitsverhaeltnis_im_sinne_des_622(entity_ref("urn:de:bgb:dw:t26")) { origin case_input; }
        assert "f1": dienstverhaeltnis_unbestimmte_dauer(entity_ref("urn:de:bgb:dw:t26")) { origin case_input; }
        assert "f2": verguetung_nach_monaten_bemessen_621(entity_ref("urn:de:bgb:dw:t26")) { origin case_input; }
        assert "f3": kuendigungserklaerung_am(entity_ref("urn:de:bgb:dw:t26"), @2026-03-16) { origin case_input; }
    }
    evaluate truth(kuendigungstermin_621(entity_ref("urn:de:bgb:dw:t26"), @2026-04-30));
    expect truth_status == TRUE_ONLY;
}
