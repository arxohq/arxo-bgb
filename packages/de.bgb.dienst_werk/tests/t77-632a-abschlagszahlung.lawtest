language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 632a Abs. 1 Satz 1, 5: Abschlagszahlung in Höhe des Wertes der erbrachten Leistungen, nachgewiesen durch eine Aufstellung.

test "urn:query:bgb-dw-t77-632a-abschlagszahlung" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": wert_der_erbrachten_leistungen(entity_ref("urn:de:bgb:dw:t77"), 12000 EUR) { origin case_input; }
        assert "f2": aufstellung_der_leistungen_vorgelegt(entity_ref("urn:de:bgb:dw:t77")) { origin case_input; }
    }
    evaluate truth(abschlagszahlungsanspruch_632a(entity_ref("urn:de:bgb:dw:t77"), 12000 EUR));
    expect truth_status == TRUE_ONLY;
}
