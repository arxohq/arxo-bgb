language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 612 Abs. 1: die Erwartung, dass Dienste nur gegen Vergütung geleistet
// werden, ist eine Wertung nach den Umständen (DECISION-0194).

test "urn:query:bgb-dw-t04-612-stillschweigend" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": dienstleistung_nur_gegen_verguetung_zu_erwarten(entity_ref("urn:de:bgb:dw:t04")) { origin adjudicated; }
    }
    evaluate truth(verguetung_stillschweigend_vereinbart(entity_ref("urn:de:bgb:dw:t04")));
    expect truth_status == TRUE_ONLY;
}
