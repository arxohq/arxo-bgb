language "law.core" version "0.2";
package de.bgb.dienst_werk version "0.1.0";
namespace "urn:de:corpus:clir:bgb-dienst-werk";

// § 630g Abs. 3 Satz 1: nach dem Tod des Patienten steht das Einsichtsrecht dem Erben zu.

test "urn:query:bgb-dw-t64-630g-erbe" {
    given {
        context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Berlin"; calendar de.bgb.dienst_werk::KALENDER_BUNDESWEIT; deadline_policy BGB_DIENST_WERK_KALENDER; }
        assert "f1": patient_verstorben_630g(entity_ref("urn:de:bgb:dw:t64")) { origin case_input; }
        assert "f2": erbe_des_patienten_630g(entity_ref("urn:de:bgb:dw:t64"), entity_ref("urn:de:bgb:dw:t64:E")) { origin case_input; }
        assert "f3": kein_entgegenstehender_wille_630g(entity_ref("urn:de:bgb:dw:t64")) { origin case_input; }
    }
    evaluate truth(einsichtsrecht_des_dritten_630g(entity_ref("urn:de:bgb:dw:t64"), entity_ref("urn:de:bgb:dw:t64:E")));
    expect truth_status == TRUE_ONLY;
}
